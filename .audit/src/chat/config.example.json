{
  "env": "development",
  "http": {
    "listen": "127.0.0.1:19501",
    "internal_listen": "127.0.0.1:19502"
  },
  "shutdown_timeout": "10s",
  "log_level": "info",
  "provider_mode": "disabled",
  "dependencies": {
    "operation_timeout": "500ms",
    "probe_interval": "10s",
    "external_concurrency": 4,
    "mysql": {
      "enabled": false,
      "address": "127.0.0.1:3306",
      "database": "",
      "username": "",
      "password_env": "CHAT_MYSQL_PASSWORD",
      "max_open_serve": 4,
      "max_open_worker": 2,
      "max_idle": 1
    },
    "redis": {
      "enabled": false,
      "address": "127.0.0.1:6379",
      "key_prefix": "bxchat:development:",
      "password_env": "",
      "pool_serve": 2,
      "pool_worker": 1
    }
  },
  "auth": {
    "enabled": false,
    "public_keys": {}
  },
  "conversations": {
    "enabled": false
  },
  "av": {
    "enabled": false,
    "audio": false,
    "video": false,
    "python_binary": "",
    "python_script": "",
    "ffmpeg_binary": "",
    "ffprobe_binary": "",
    "temp_root": "",
