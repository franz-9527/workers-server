  "safety": {
    "enabled": false,
    "app_id": "",
    "credential_file": "",
    "rejection_directory": ""
  },
  "images": {
    "enabled": false,
    "mode": "manual_precheck",
    "private_bucket": true,
    "bucket": "",
    "access_key_env": "CHAT_QINIU_ACCESS_KEY",
    "secret_key_env": "CHAT_QINIU_SECRET_KEY",
    "download_origin": "",
