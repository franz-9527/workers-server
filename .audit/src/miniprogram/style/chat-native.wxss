/* Shared native chat controls. Original vector paths; no icon font/network dependency. */
.chat-icon{display:inline-block;flex:none;width:44rpx;height:44rpx;vertical-align:middle;background-size:contain;background-position:center;background-repeat:no-repeat}
.chat-icon-button{display:flex;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx;padding:0;margin:0;background:transparent;color:inherit;border:0;line-height:1.3}
.chat-icon-button::after{border:0}
.chat-icon-button:active{background:rgba(0,0,0,.06)}
