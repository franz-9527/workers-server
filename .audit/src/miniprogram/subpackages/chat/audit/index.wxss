.audit-page{padding:28rpx;background:#f5f6f8;min-height:100vh}.audit-intro{font-size:34rpx;font-weight:600}.audit-note,.audit-meta{font-size:24rpx;color:#717987;line-height:1.7;margin:16rpx 0}.audit-card{background:#fff;border-radius:20rpx;padding:24rpx;margin:20rpx 0}.audit-text{white-space:pre-wrap;word-break:break-all;line-height:1.7}.audit-error{color:#b33535;padding:20rpx}.audit-photo{position:fixed;inset:0;background:#111;z-index:30;padding:30rpx}.audit-photo image{width:100%;height:85vh}.audit-page button{font-size:26rpx;margin:12rpx 0}