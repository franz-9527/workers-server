@import "../../../style/chat-native.wxss";
.call-page{min-height:100vh;background:#18212c;color:#fff;padding:64rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));box-sizing:border-box;text-align:center}.call-title{font-size:40rpx;font-weight:600}.call-status{margin:30rpx 0;font-size:30rpx}.call-notice,.call-hint{margin:24rpx;color:#e6d1a8}.call-stage{position:relative;height:55vh}.call-stage live-player{width:100%;height:100%}.local-video{position:absolute;right:10rpx;top:10rpx;width:180rpx;height:240rpx}.audio-pusher{position:absolute;left:-10px;top:-10px;width:1px;height:1px;opacity:0}.call-controls{display:flex;flex-wrap:wrap;justify-content:center;gap:20rpx;margin-top:32rpx}.call-controls button{font-size:28rpx;margin:0}.call-controls .hangup{background:#dc4545;color:white}
.history-row{text-align:left;padding:24rpx 0;border-bottom:1px solid #405060}.history-row text{font-size:24rpx;color:#ccd5df}

.call-page{display:flex;flex-direction:column;min-height:100vh;background:#242c32;padding:64rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));color:#fff}
.call-page .call-person{padding-top:28rpx}.call-page .call-avatar{width:160rpx;height:160rpx;border-radius:22rpx;margin-bottom:24rpx;background:#dbe3e5}
.call-page .call-title{font-size:40rpx;line-height:1.5;overflow-wrap:anywhere}
.call-page .call-kind{font-size:26rpx;color:#d0d6d9;line-height:1.5;margin-top:10rpx}
.call-page .call-status{font-size:30rpx;line-height:1.6;margin:24rpx 0}
.call-page .call-notice,.call-page .call-hint{font-size:26rpx;line-height:1.6;color:#f1d6ab;margin:16rpx 0}
.call-page .call-stage.is-audio{flex:1;min-height:120rpx;height:auto}
.call-page .call-stage.is-video{height:40vh;min-height:300rpx}
.call-page .call-controls{margin-top:auto;padding-top:44rpx;gap:28rpx;align-items:flex-start}
.call-page .call-controls .call-control{flex:0 0 136rpx;display:flex;align-items:center;flex-direction:column;gap:18rpx;padding:8rpx 0;margin:0;min-height:160rpx;background:transparent;color:#fff;font-size:26rpx;line-height:1.5}
.call-page .call-control::after{border:0}.call-page .call-control-icon{display:flex;align-items:center;justify-content:center;width:108rpx;height:108rpx;border-radius:50%;background:#465057}
.call-page .call-control .chat-icon{width:52rpx;height:52rpx;filter:invert(1)}
.call-page .call-control.is-selected .call-control-icon{outline:3rpx solid #d1edf1;background:#566c77}
.call-page .hangup .call-control-icon{background:#d63e45}.call-page .hangup .chat-icon{transform:rotate(135deg)}
.call-page .accept .call-control-icon{background:#16895d}
.call-page.call-history-page{background:#ededed;color:#202526;text-align:left;padding:28rpx 24rpx calc(36rpx + env(safe-area-inset-bottom))}
.call-history-page .history-row{padding:26rpx;background:#fff;border-bottom:1rpx solid #ddd;line-height:1.6;font-size:28rpx}
.call-history-page .history-row text{font-size:24rpx;color:#667075}
@media(prefers-color-scheme:dark){.call-page.call-history-page{background:#111;color:#e8e8e8}.call-history-page .history-row{background:#191919;border-color:#333}.call-history-page .history-row text{color:#b2b8bb}}
