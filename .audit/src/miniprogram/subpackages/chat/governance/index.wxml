<view class="audit-page"><view class="audit-intro">举报与申诉</view><view class="audit-note">禁聊期间仍可查看合法历史、在时限内撤回及处理订单、退款和售后。处理结果不会自动补发旧消息。</view>
<view wx:if="{{!enabled}}" class="audit-card">订单聊天尚未开放</view>
<block wx:else><button bindtap="refresh" disabled="{{busy}}">刷新本人状态与案件</button>
<view wx:if="{{error}}" class="audit-error" role="alert">{{error}}</view><view wx:if="{{diagnostic}}" class="audit-note">{{diagnostic}}</view>
<view wx:if="{{status}}" class="audit-card"><view>{{status.blocked ? (status.permanent ? '当前永久禁聊' : '禁聊至 ' + status.untilLabel) : '当前可正常发送'}}</view><view>已确认风险：{{status.confirmed_risks}}</view><button wx:if="{{status.blocked}}" bindtap="appealBan" disabled="{{busy}}">对禁聊提出申诉</button></view>
<view wx:if="{{report || target}}" class="audit-card"><view>{{report ? '举报所选消息' : '提交申诉'}}</view><textarea value="{{reason}}" maxlength="200" bindinput="input" placeholder="请说明具体原因，至少2字"/><button bindtap="submit" disabled="{{busy}}" loading="{{busy}}">提交{{report ? '举报' : '申诉'}}</button><button bindtap="cancel" disabled="{{busy}}">取消</button></view>
<view wx:for="{{cases}}" wx:key="case_id" class="audit-card"><view>案件 {{item.case_id}} · {{item.kindLabel}} · {{item.stateLabel}}</view><view class="audit-text">{{item.reason}}</view><view>{{item.resolution || '等待平台处理'}}</view><button wx:if="{{item.kind === 'review' && item.target_type === 'risk'}}" data-id="{{item.case_id}}" bindtap="appealCase" disabled="{{busy}}">对此次检查提出申诉</button></view>
<button wx:if="{{hasMore}}" bindtap="more" disabled="{{busy}}">后续案件</button></block></view>
