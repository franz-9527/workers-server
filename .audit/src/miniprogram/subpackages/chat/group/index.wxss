.group-page{padding:24rpx;padding-bottom:calc(36rpx + env(safe-area-inset-bottom));background:var(--page-bg,#f5f5f5);min-height:100vh;color:var(--text-primary,#222)}.card{padding:28rpx;margin-bottom:24rpx;border-radius:16rpx;background:var(--card-bg,#fff)}.title{font-size:36rpx;font-weight:600;display:block;margin-bottom:20rpx}.card text{display:block;line-height:1.7;word-break:break-all}.member{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #ddd}.member image{width:72rpx;height:72rpx;flex-shrink:0}.member>view{flex:1;min-width:0}.hint{font-size:26rpx;color:var(--text-secondary,#666)}.selector{padding:24rpx 0}.poster{width:100%}.poster-canvas{position:fixed;left:-2000px;top:-2000px}.event{font-size:26rpx;line-height:1.8}.notice{padding:24rpx;background:#fff3cd;color:#604800}.group-page button{margin:20rpx 0;white-space:normal;font-size:30rpx}@media(prefers-color-scheme:dark){.group-page{background:#101114;color:#eee}.card{background:#202126}.hint{color:#bfc2c7}.member{border-color:#444}.notice{background:#3c3217;color:#ffe29a}}

.group-page{padding:24rpx 0 calc(36rpx + env(safe-area-inset-bottom));background:#ededed}
.group-page .card{padding:0 28rpx;margin:0 0 20rpx;border-radius:0;background:#fff}
.group-page .title{font-size:32rpx;font-weight:500;padding-top:24rpx}.group-page .member{padding:20rpx 0;min-height:88rpx;border-color:#e8e8e8}
.group-page .member image{width:88rpx;height:88rpx;border-radius:12rpx}
.group-page .member button{flex:none;margin:0 0 0 12rpx;min-height:88rpx;background:transparent;color:#a33636;font-size:26rpx}
.group-page .card>button{font-size:30rpx;min-height:88rpx;margin:0;padding:26rpx 0;line-height:1.5;background:transparent;border-top:1rpx solid #e8e8e8;text-align:left;border-radius:0;color:#007381}
.group-page button::after{border:0}.group-page .hint{padding-bottom:16rpx;font-size:24rpx}
.group-page .selector{font-size:30rpx;border-bottom:1rpx solid #e8e8e8}
@media(prefers-color-scheme:dark){.group-page{background:#111}.group-page .card{background:#191919}.group-page .member,.group-page .card>button,.group-page .selector{border-color:#333}.group-page .card>button{color:#8bdce5}.group-page .member button{color:#ffacb0}}
