<view class="chat-inbox">
  <view class="inbox-header">
    <view>
      <view class="inbox-title">消息</view>
      <view class="inbox-caption">订单沟通与业务提醒</view>
    </view>
    <view class="settings-trigger" bindtap="openNotificationSettings" aria-label="通知设置">
      <text class="cuIcon-settings"></text>
    </view>
  </view>

  <!-- The original notification/todo workflow remains in its own page. -->
  <view class="quick-entry">
    <view class="quick-item" bindtap="openTodo">
      <view class="quick-symbol todo-symbol"><text class="cuIcon-form"></text></view>
      <view class="quick-details">
        <view class="quick-title">待办 <text wx:if="{{summaryReady && todoCount > 0}}" class="quick-counter">{{todoCount > 99 ? '99+' : todoCount}}</text></view>
        <view class="quick-desc">{{summaryError && !summaryReady ? '暂不可用，点击重试' : !summaryReady ? '加载中' : todoCount > 0 ? '有订单事项待处理' : '查看订单待办'}}</view>
      </view>
      <text class="cuIcon-right quick-arrow"></text>
    </view>
    <view class="quick-separator"></view>
    <view class="quick-item" bindtap="openNotices">
      <view class="quick-symbol notice-symbol"><text class="cuIcon-notice"></text></view>
      <view class="quick-details">
        <view class="quick-title">通知 <text wx:if="{{summaryReady && noticeUnreadCount > 0}}" class="quick-counter">{{noticeUnreadCount > 99 ? '99+' : noticeUnreadCount}}</text></view>
        <view class="quick-desc">{{summaryError && !summaryReady ? '暂不可用，点击重试' : !summaryReady ? '加载中' : noticeUnreadCount > 0 ? '有未读业务通知' : '查看通知记录'}}</view>
      </view>
      <text class="cuIcon-right quick-arrow"></text>
    </view>
  </view>

  <view wx:if="{{summaryReady && todoCount > 0 && topTodoText}}" class="priority-strip" bindtap="openTodo">
    <text class="cuIcon-timefill priority-icon"></text>
    <view class="priority-copy">
      <text class="priority-tag">优先处理</text>
      <text class="priority-text">{{topTodoRole}} · {{topTodoText}}</text>
    </view>
    <text class="cuIcon-right priority-arrow"></text>
  </view>

  <view class="conversation-header">
    <view class="conversation-heading">订单沟通</view>
    <text class="conversation-hint">仅展示本人有权限的会话</text>
  </view>

  <view wx:if="{{checkingLogin}}" class="inbox-placeholder">
    <text class="cuIcon-loading2 cuIconfont-spin placeholder-icon"></text>
    <view class="placeholder-title">正在确认登录状态</view>
  </view>
  <view wx:elif="{{!isLoggedIn}}" class="inbox-placeholder">
    <view class="placeholder-circle"><text class="cuIcon-people"></text></view>
    <view class="placeholder-title">登录后查看订单沟通</view>
    <view class="placeholder-desc">通知与待办仍可从上方入口打开，登录后会自动更新</view>
  </view>
  <view wx:elif="{{!chatEnabled}}" class="inbox-placeholder">
    <view class="placeholder-circle"><text class="cuIcon-comment"></text></view>
    <view class="placeholder-title">订单聊天即将开放</view>
    <view class="placeholder-desc">当前可继续使用通知与待办处理订单，不影响现有业务</view>
  </view>
  <block wx:else>
    <view wx:if="{{chatStatus === 'unavailable'}}" class="chat-connection-warning">
      <text class="cuIcon-warn"></text> 沟通连接暂不可用，保留已验证的会话摘要。请下拉重试
    </view>
    <view class="chat-filter">
      <view class="filter-option {{chatFilter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="selectChatFilter">全部</view>
      <view class="filter-option {{chatFilter === 'unread' ? 'selected' : ''}}" data-filter="unread" bindtap="selectChatFilter">未读</view>
    </view>
    <view wx:for="{{visibleChatRows}}" wx:key="conversationId" class="conversation-row" data-id="{{item.conversationId}}" bindtap="openConversation">
      <view class="conversation-avatar"><text class="cuIcon-commentfill"></text></view>
      <view class="conversation-body">
        <view class="conversation-main">
          <text class="conversation-title">{{item.title}}</text>
          <text class="conversation-id">{{item.subtitle}}</text>
        </view>
        <view class="conversation-preview">{{item.lastText}}</view>
      </view>
      <view wx:if="{{item.unreadCount > 0}}" class="conversation-unread">{{item.unreadLabel}}</view>
      <text wx:else class="cuIcon-right conversation-chevron"></text>
    </view>
    <view wx:if="{{chatLoading && !chatRows.length}}" class="inbox-placeholder slim">
      <text class="cuIcon-loading2 cuIconfont-spin placeholder-icon"></text>
      <view class="placeholder-title">正在同步订单会话</view>
    </view>
    <view wx:elif="{{!chatLoading && !visibleChatRows.length}}" class="inbox-placeholder slim">
      <view class="placeholder-circle"><text class="cuIcon-comment"></text></view>
      <view class="placeholder-title">{{chatFilter === 'unread' ? '暂无未读沟通' : '暂无订单会话'}}</view>
      <view class="placeholder-desc">{{chatFilter === 'unread' ? '已读不影响订单待办和通知' : '有权限的订单会话将在这里出现'}}</view>
    </view>
    <view wx:if="{{chatHasMore}}" class="sync-hint">正在分批核对更多会话</view>
  </block>
  <view class="bottom-clearance"></view>
</view>
