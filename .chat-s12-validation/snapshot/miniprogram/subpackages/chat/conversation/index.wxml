<view class="conversation-page">
  <view class="conversation-context">
    <view class="conversation-context-main">订单沟通</view>
    <view class="conversation-context-sub">会话 {{conversationId}}</view>
  </view>
  <view wx:if="{{invalid}}" class="conversation-empty">
    <text class="cuIcon-warn"></text>
    <view>会话编号无效</view>
  </view>
  <view wx:elif="{{!enabled}}" class="conversation-empty">
    <text class="cuIcon-comment"></text>
    <view>订单聊天尚未开放</view>
    <view class="muted">可先通过订单详情或通知与待办联系相关人员</view>
  </view>
  <block wx:else>
    <view wx:if="{{status === 'denied'}}" class="conversation-warning">当前无权继续查看此会话，原有内容已清理</view>
    <view wx:elif="{{status === 'unavailable'}}" class="conversation-warning">连接暂不可用，已加载内容可能不是最新；下拉可重试</view>
    <view wx:for="{{messages}}" wx:key="messageId" class="message-item {{item.isPlaceholder ? 'is-placeholder' : ''}}">
      <view class="message-text">{{item.body}}</view>
      <view class="message-time">{{item.createdAt}}</view>
    </view>
    <view wx:if="{{loading}}" class="conversation-empty compact"><text class="cuIcon-loading2 cuIconfont-spin"></text> 正在同步会话</view>
    <view wx:elif="{{!messages.length && status !== 'denied'}}" class="conversation-empty compact"><text class="cuIcon-comment"></text> 暂无可查看的消息</view>
    <view class="composer-closed">发送功能将在完成安全验收后开放</view>
  </block>
</view>
