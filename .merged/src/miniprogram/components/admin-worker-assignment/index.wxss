.assignment-trigger{margin:0;border:0;border-radius:16rpx;min-height:72rpx;padding:0 24rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;background:#eef9fa;color:#008d99;font-size:26rpx;font-weight:600;line-height:1.2}.assignment-trigger::after{border:0}.assignment-trigger.footer{background:transparent;color:#58666a;min-height:92rpx;padding:0 12rpx;flex-direction:column;gap:4rpx;font-size:22rpx;font-weight:500}.assignment-trigger.footer .cuIcon-friendaddfill{font-size:34rpx;color:#00aebd}.assignment-trigger.button{background:#00aebd;color:#fff}.assignment-mask{position:fixed;z-index:1200;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.48);display:flex;align-items:flex-end;justify-content:center;padding:28rpx}.assignment-modal{width:100%;max-width:720rpx;box-sizing:border-box;background:#fff;border-radius:28rpx;padding:30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-shadow:0 24rpx 70rpx rgba(0,0,0,.18)}.assignment-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.assignment-title{font-size:34rpx;font-weight:700;color:#172426}.assignment-sub{margin-top:8rpx;color:#7b8b8f;font-size:23rpx}.assignment-close{font-size:34rpx;color:#869499;padding:8rpx}.assignment-tip{margin-top:24rpx;padding:20rpx;border-radius:18rpx;background:#f4fbfc;color:#4b6267;font-size:24rpx;line-height:1.65;display:flex;gap:12rpx}.assignment-tip>.cuIcon-infofill{color:#00aebd;margin-top:3rpx}.assignment-fields{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:24rpx}.assignment-field{display:flex;flex-direction:column;gap:12rpx}.assignment-field text{font-size:24rpx;color:#4e5b5e}.assignment-field input{height:76rpx;border:1rpx solid #dfe8ea;border-radius:14rpx;padding:0 18rpx;background:#fbfdfd;font-size:28rpx;color:#172426}.assignment-note{margin-top:18rpx;color:#8b989b;font-size:22rpx;line-height:1.55}.assignment-result{margin-top:24rpx;text-align:center}.assignment-code{width:340rpx;height:340rpx;border-radius:20rpx;background:#f7fafa}.assignment-code-error{padding:36rpx 24rpx;border-radius:18rpx;background:#f7f9fa;color:#7a878a;font-size:24rpx;line-height:1.6}.assignment-expire{margin-top:16rpx;font-size:25rpx;color:#324347}.assignment-hint{margin-top:8rpx;font-size:22rpx;color:#8a979a}.assignment-actions{display:flex;gap:18rpx;margin-top:28rpx}.assignment-actions button{flex:1;margin:0;min-height:78rpx;border-radius:39rpx;font-size:27rpx}.assignment-actions button::after{border:0}.assignment-secondary{background:#f3f6f7;color:#536266}.assignment-primary{background:#00aebd;color:#fff}@media (prefers-color-scheme:dark){.assignment-modal{background:#172022}.assignment-title{color:#f2f7f8}.assignment-sub,.assignment-note,.assignment-hint{color:#91a0a4}.assignment-tip{background:#1d2c2f;color:#bdcacc}.assignment-field text{color:#bdcacc}.assignment-field input{background:#11191b;border-color:#334247;color:#eef4f5}.assignment-code-error,.assignment-secondary{background:#222d30;color:#bfcacc}.assignment-expire{color:#dce6e8}}@media (max-width:360px){.assignment-fields{grid-template-columns:1fr}.assignment-modal{padding-left:22rpx;padding-right:22rpx}}

.assignment-mask{box-sizing:border-box}
.assignment-modal{max-height:calc(100vh - 56rpx);overflow-y:auto}
.assignment-actions button{display:flex;align-items:center;justify-content:center;min-width:0;min-height:88rpx;padding:18rpx 16rpx;line-height:1.45;white-space:normal}
@media (prefers-color-scheme:dark){
  .assignment-trigger{background:#12383d;color:#80e7ee}
  .assignment-trigger.footer{background:transparent;color:#cad7d9}
  .assignment-trigger.footer .cuIcon-friendaddfill{color:#80e7ee}
  .assignment-trigger.button,.assignment-primary{background:#00aebd;color:#061d20}
}
