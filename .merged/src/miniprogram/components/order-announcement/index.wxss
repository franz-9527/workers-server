.notice{display:flex;align-items:center;gap:14rpx;margin:0 24rpx 20rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#fff8dc;color:#6f5311;box-shadow:0 6rpx 20rpx rgba(95,72,16,.08);font-size:26rpx;line-height:1.5}.notice__icon{flex:none;padding:4rpx 12rpx;border-radius:8rpx;background:#f7b928;color:#fff;font-size:22rpx;font-weight:700}.notice__text{flex:1;min-width:0}.notice__arrow{flex:none;color:#aa7b09;font-size:40rpx;line-height:1}
@media (prefers-color-scheme:dark){.notice{background:#332d18;color:#f6df96;box-shadow:none}.notice__icon{background:#d8940b}.notice__arrow{color:#f0bd42}}
