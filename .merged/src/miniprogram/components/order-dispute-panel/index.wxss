.panel{margin:24rpx;padding:28rpx;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(15,23,42,.06)}
.head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.title{display:flex;align-items:center;gap:10rpx;font-size:30rpx;font-weight:600;color:#1f2937}.title text{color:#e54d42}.status{flex:none;padding:7rpx 16rpx;border-radius:999rpx;font-size:22rpx;background:#fff7ed;color:#d97706}.status.resolved{background:#ecfdf5;color:#059669}.status.open,.status.pending,.status.processing{background:#fff1f2;color:#e11d48}
.description{margin-top:18rpx;font-size:27rpx;line-height:1.65;color:#374151;word-break:break-all}.images{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:18rpx}.images image{width:150rpx;height:150rpx;border-radius:14rpx;background:#f3f4f6}.resolution{margin-top:18rpx;padding:18rpx 20rpx;border-radius:14rpx;background:#f8fafc;font-size:25rpx;line-height:1.55;color:#475569}.hint{display:flex;gap:12rpx;margin-top:20rpx;padding:18rpx 20rpx;border-radius:14rpx;background:#fffaf0;font-size:24rpx;line-height:1.6;color:#7c5b18}.hint>text{margin-top:3rpx;color:#f59e0b}.hint.resolved{background:#f0fdf4;color:#166534}.hint.resolved>text{color:#16a34a}.actions{display:flex;gap:18rpx;margin-top:22rpx}.actions button{flex:1;margin:0;border-radius:999rpx;font-size:26rpx;line-height:76rpx;height:76rpx}.actions button::after{border:0}.resolve{background:#ecfeff;color:#0891b2}.escalate{background:#fff7ed;color:#c2410c}
