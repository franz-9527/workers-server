<!-- 2026-10-08：协商入口统一，等待阶段不显示平台介入。 -->
<view wx:if="{{cases.length}}" class="panel">
  <view class="heading">协商处理</view>
  <view class="intro">先沟通，再确认方案；拒绝或超时未解决后可申请平台介入。</view>
  <view wx:for="{{cases}}" wx:key="reference" class="case">
    <view class="head"><text class="title">{{item.title}}</text><text class="status {{item.status}}">{{item.status_text}}</text></view>
    <view class="description">{{item.description}}</view>
    <view wx:if="{{item.kind === 'refund' || item.kind === 'change'}}" class="amount">方案金额 ¥{{item.amount_cents / 100}}</view>

    <block wx:if="{{workerMode && item.kind === 'repair'}}">
      <view wx:if="{{item.status === 'pending'}}" class="hint">第 1 步 · 先回应申请。接受后再联系客户并记录预约；拒绝后由客户决定是否继续协商或申请平台介入。</view>
      <view wx:elif="{{item.status === 'accepted_processing' && !repairAppointment}}" class="hint">第 2 步 · 已接受处理，请先联系客户并记录维修/售后预约。记录预约不会自动完成维修。</view>
      <view wx:elif="{{item.status === 'accepted_processing' && repairAppointment}}" class="hint">第 3 步 · 已记录联系/预约；实际处理完成后再提交结果。修改预约不会自动完成维修。</view>
      <view wx:elif="{{item.status === 'rejected'}}" class="hint">你已拒绝本次处理，当前等待客户继续协商或申请平台介入。</view>
      <view wx:elif="{{item.status === 'escalated'}}" class="hint">该事项已申请平台介入，等待平台处理。</view>
      <view wx:if="{{item.status === 'accepted_processing' && repairAppointment}}" class="hint">当前联系/预约：{{repairAppointment.wait_customer_notice ? '等待客户另行通知' : (repairAppointment.appointment_at || '时间待定')}}{{repairAppointment.note ? ' · ' + repairAppointment.note : ''}}</view>
    </block>

    <view wx:if="{{item.status === 'pending' && !item.can_escalate && !(workerMode && item.kind === 'repair')}}" class="hint">等待对方处理，48小时仍未解决后开放平台介入。</view>
    <view class="actions">
      <button wx:if="{{item.can_respond}}" class="accept" data-index="{{index}}" data-decision="accepted" bindtap="respond" disabled="{{submitting}}">{{item.kind === 'refund' ? '接受方案' : (item.kind === 'repair' ? '接受处理' : '接受处理')}}</button>
      <button wx:if="{{item.can_respond || item.can_reject_only}}" data-index="{{index}}" data-decision="rejected" bindtap="respond" disabled="{{submitting}}">{{item.kind === 'measurement' ? '无法补测' : (item.kind === 'repair' ? '拒绝处理' : '拒绝')}}</button>
      <button wx:if="{{workerMode && item.kind === 'repair' && item.status === 'accepted_processing'}}" class="{{repairAppointment ? '' : 'accept'}}" data-index="{{index}}" bindtap="openRepairAppointment" disabled="{{submitting}}">{{repairAppointment ? '修改联系/预约' : '记录联系/预约'}}</button>
      <button wx:if="{{workerMode && item.kind === 'repair' && item.status === 'accepted_processing' && repairAppointment}}" class="accept" data-index="{{index}}" bindtap="completeRepair" disabled="{{submitting}}">提交处理完成</button>
      <button wx:if="{{item.can_propose}}" class="accept" data-index="{{index}}" bindtap="propose" disabled="{{submitting}}">重新提出方案</button>
      <button wx:if="{{item.can_withdraw}}" data-index="{{index}}" bindtap="withdraw" disabled="{{submitting}}">撤回退款方案</button>
      <button wx:if="{{item.can_escalate}}" class="escalate" data-index="{{index}}" bindtap="escalate" disabled="{{submitting}}">申请平台介入</button>
    </view>
  </view>
</view>
<view wx:if="{{showProposal}}" class="mask" catchtouchmove="true"><view class="sheet">
  <view class="heading">提出退款方案</view>
  <input type="digit" value="{{amount}}" bindinput="inputAmount" placeholder="线上退款金额（元）"/>
  <textarea value="{{note}}" bindinput="inputNote" maxlength="1000" placeholder="方案说明（至少4个字）"></textarea>
  <view class="actions"><button bindtap="closeProposal" disabled="{{submitting}}">取消</button><button class="accept" bindtap="submitProposal" loading="{{submitting}}" disabled="{{submitting}}">提交方案</button></view>
</view></view>
