.product-field-control{width:100%}.input{width:100%;box-sizing:border-box;border:1rpx solid #d7e4e6;border-radius:14rpx;background:#f8fbfc;padding:22rpx 24rpx;min-height:84rpx;color:#243a3f}.input:focus{border-color:#00b9cb;background:#fff}.option-group{display:flex;flex-wrap:wrap;gap:20rpx 34rpx}.option{display:flex;align-items:center;min-height:62rpx;margin:0;color:#344b50}.option checkbox{margin-right:10rpx;transform:scale(.86)}.option-tappable{padding:4rpx 0}.option-tappable.disabled{opacity:.45}.single-option-check{margin-right:10rpx;color:#a4b3b6;font-size:31rpx}.option-tappable.selected .single-option-check{color:#00a6b5}.switch-line{display:flex;align-items:center;gap:18rpx;min-height:74rpx}.category-picker{padding:6rpx 0}.category-tip{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx;color:#7e9094;font-size:24rpx}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.category-choice{display:flex;align-items:center;justify-content:center;min-height:82rpx;padding:8rpx;border:2rpx solid #dbe6e8;border-radius:14rpx;background:#fafcfc;color:#43585d;font-size:27rpx;text-align:center;box-sizing:border-box}.category-choice.selected{border-color:#00b9cb;background:#e9fbfd;color:#008c9a;font-weight:700;box-shadow:0 6rpx 18rpx rgba(0,185,203,.12)}.category-other-input{margin-top:14rpx}.category-result{margin-top:18rpx;padding:16rpx 20rpx;border-radius:12rpx;background:#effafb;color:#317079;font-size:24rpx}@media(prefers-color-scheme:dark){.input{background:#162225;border-color:#334a4e;color:#fff}.category-choice{background:#1a292c;border-color:#3b5054;color:#d5e4e6}.category-choice.selected{background:#123b40;border-color:#00b9cb;color:#8cebf3}.category-result{background:#15383d;color:#bce9ed}.option{color:#dbe8ea}.single-option-check{color:#6f8285}.option-tappable.selected .single-option-check{color:#72dce5}}
