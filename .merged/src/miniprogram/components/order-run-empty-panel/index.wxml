<view wx:if="{{claim}}" class="panel">
  <view class="title"><text class="icon">!</text> 跑空费协商</view>
  <view class="row"><text>跑空费</text><text class="amount">{{claim.amount_text}}</text></view>
  <view class="row"><text>当前状态</text><text class="status">{{claim.status_text}}</text></view>
  <view class="description">{{claim.reason}}</view>
  <view wx:if="{{claim.user_note}}" class="note">你的说明：{{claim.user_note}}</view>
  <view wx:if="{{canDecide}}" class="actions">
    <button class="button reject" loading="{{submitting}}" disabled="{{submitting}}" bindtap="openReject">不同意，申请平台介入</button>
    <button class="button accept" loading="{{submitting}}" disabled="{{submitting}}" bindtap="accept">同意跑空费</button>
  </view>
  <view class="hint">同意后无需再次付款：跑空费从本单已支付预约费中结算给师傅，剩余可退预约费自动原路退款。不同意时请先与师傅沟通，仍无法解决再申请平台介入。</view>
</view>

<view wx:if="{{showReject}}" class="mask" catchtouchmove="true">
  <view class="modal">
    <view class="modal-title">不同意跑空费</view>
    <view class="warning">请说明不同意原因和已经沟通的情况。提交后才会升级平台处理。</view>
    <textarea class="textarea" maxlength="500" value="{{rejectNote}}" placeholder="请说明不同意原因和协商情况" bindinput="inputReject"></textarea>
    <view class="modal-actions">
      <button class="button neutral" disabled="{{submitting}}" bindtap="closeReject">继续协商</button>
      <button class="button danger" loading="{{submitting}}" disabled="{{submitting}}" bindtap="reject">申请平台介入</button>
    </view>
  </view>
</view>
