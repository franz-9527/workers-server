<!-- 平台承接单客户价格层：仅展示客户金额和项目明细，不混入师傅工费、平台收入款等内部结算字段。 -->
<view class="pop-card">
  <view class="pop-heading">
    <view class="pop-heading-text">
      <view class="pop-title">客户价格明细</view>
      <view class="pop-subtitle">客户应付与施工项目按当前约定独立展示</view>
    </view>
    <view class="pop-badge">平台单</view>
  </view>
  <view class="pop-primary">
    <view class="pop-primary-label">客户最终金额</view>
    <view class="pop-primary-amount">{{customerTotalText}}</view>
    <view class="pop-primary-meta"><text>{{bookingMetaText}}</text><text>{{customerTailLabel}} {{customerTailText}}</text></view>
  </view>
  <view wx:if="{{isItemized}}" class="pop-items">
    <view class="pop-items-title">
      <view><text>施工项目与实际数量</text><view class="pop-items-hint">按约定单价计算；新增施工项目请使用原加价申请</view></view>
      <button wx:if="{{canEdit && !editing}}" class="pop-edit-btn" bindtap="beginEdit">核对数量</button>
    </view>
    <view wx:for="{{rows}}" wx:key="key" class="pop-item">
      <view class="pop-item-head"><text class="pop-item-name">{{item.description}}</text><text wx:if="{{item.item_source === 'change'}}" class="pop-added">新增项目</text></view>
      <view wx:if="{{item.note}}" class="pop-item-note">{{item.note}}</view>
      <view class="pop-item-detail">
        <view class="pop-qty">
          <input wx:if="{{editing && item.editable}}" class="pop-quantity-input" type="digit" maxlength="16" value="{{item.draftQuantity}}" data-index="{{index}}" bindinput="quantityInput" />
          <text wx:else>{{item.quantity || '—'}}</text>
          <text class="pop-unit">{{item.unit}}</text>
          <text wx:if="{{item.unitPrice !== null}}" class="pop-unit-price">× {{item.unitPriceText}}</text>
        </view>
        <text class="pop-item-amount">{{item.amountText}}</text>
      </view>
    </view>
    <view wx:if="{{editing}}" class="pop-edit-area">
      <view class="pop-preview"><text>调整后的客户金额（预览）</text><text>{{previewText}}</text></view>
      <view class="pop-small">只调整原项目实际数量，不改变工费、项目单价或新增加价记录。</view>
      <view wx:if="{{quantityError}}" class="pop-error">{{quantityError}}</view>
      <view class="pop-edit-actions">
        <button class="pop-cancel" disabled="{{saving}}" bindtap="cancelEdit">取消</button>
        <button class="pop-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveQuantities">确认保存</button>
      </view>
    </view>
  </view>
  <view class="pop-price-note">{{priceNote}}</view>
</view>

<!-- 客户在平台测量转施工后继续看到只读测量成果；师傅详情已有完整测量组件，避免重复渲染。 -->
<measurement-order-archive wx:if="{{viewerMode === 'owner' && orderState && orderState.workflow_profile !== 'measurement'}}" order-id="{{orderId}}"></measurement-order-archive>

<!-- 成交师傅/管理员才会看到第二张独立卡片；客户侧组件内部自动保持隐藏。 -->
<platform-order-settlement pricing="{{pricing}}" order-state="{{orderState}}" viewer-mode="{{viewerMode}}"></platform-order-settlement>
