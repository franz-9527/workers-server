<view class="share-page">
  <fullscreen-nav title="分享订单" tone="dark" testing-title-only="{{true}}" testing-badge-with-title="{{true}}"></fullscreen-nav>

  <view class="share-tabs">
    <navigator class="share-tab" url="/pages/adminWorkbench/detail?id={{id}}" open-type="redirect">订单详情</navigator>
    <view class="share-tab active">分享订单</view>
    <view class="share-tag">平台单</view>
  </view>

  <view class="intro-card">
    <view class="intro-title">分享给客户查看或绑定</view>
    <view class="intro-desc">客户扫码后先看到脱敏订单和进度，不会立即要求登录。需要查看完整订单时再登录并核对预留手机号。</view>
    <view class="notice-row"><text class="cuIcon-info"></text><text>客户暂不绑定也不影响平台继续安排测量、施工和履约。</text></view>
  </view>

  <view class="setting-card">
    <view class="setting-row">
      <view>
        <view class="setting-title">分享有效期</view>
        <view class="setting-desc">重新生成后，旧客户分享会立即失效</view>
      </view>
      <view class="days-input"><input type="number" value="{{validDays}}" bindinput="validDaysInput"/><text>天</text></view>
    </view>
    <button wx:if="{{!share}}" class="primary-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="createCustomerShare">生成客户分享</button>
  </view>

  <view wx:if="{{share}}" class="code-card">
    <view class="code-head">
      <view>
        <view class="code-title">{{share.title || '平台服务订单'}}</view>
        <view class="code-no">{{share.order_no}}</view>
      </view>
      <view class="status-tag">{{share.customer_bound ? '客户已绑定' : '待客户绑定'}}</view>
    </view>

    <view class="flow-tags">
      <text>平台托管</text>
      <text>{{share.fulfillment_mode === 'measure_then_install' ? '先测量后施工' : '直接施工'}}</text>
    </view>

    <view class="qr-wrap">
      <image class="qr-image" src="{{qrFile}}" mode="aspectFit"></image>
      <view class="qr-tip">微信扫码查看订单</view>
    </view>

    <view class="expire-text">有效至 {{share.expires_at}}</view>

    <view class="share-actions">
      <button class="primary-btn half" loading="{{saving}}" disabled="{{saving}}" bindtap="savePoster">保存分享图</button>
      <button class="secondary-btn half" open-type="share">微信分享</button>
    </view>
    <button class="secondary-btn full" bindtap="copyPath">复制小程序路径</button>
    <button class="text-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="createCustomerShare">重新生成</button>
  </view>

  <view class="security-card">
    <view class="security-title">绑定安全</view>
    <view class="security-item"><text class="num">1</text><text>小程序码只用于定位订单和查看脱敏预览。</text></view>
    <view class="security-item"><text class="num">2</text><text>客户登录后，仍要核对当前账号手机号与订单预留手机号。</text></view>
    <view class="security-item"><text class="num">3</text><text>手机号不一致时不能认领，由平台人工核实，不允许靠分享链接直接改订单归属。</text></view>
  </view>

  <canvas canvas-id="customerSharePoster" class="poster-canvas"></canvas>
</view>
