page { background: var(--page-bg, #f4f6f7); color: var(--text-primary, #202124); }
.share-page { min-height: 100vh; padding: 24rpx 28rpx 56rpx; box-sizing: border-box; }
.share-tabs { display: flex; align-items: center; gap: 16rpx; margin: 8rpx 0 22rpx; }
.share-tab { font-size: 34rpx; font-weight: 700; padding-bottom: 12rpx; }
.share-tab.active { color: #00aebd; border-bottom: 5rpx solid #00b9cb; }
.share-tag { padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(0,185,203,.10); color: #00a3b4; font-size: 22rpx; }
.intro-card,.setting-card,.code-card,.security-card { background: var(--card-bg, #fff); border-radius: 24rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 8rpx 26rpx rgba(25,34,40,.045); }
.intro-title,.security-title,.setting-title,.code-title { font-size: 31rpx; font-weight: 650; }
.intro-desc,.setting-desc { margin-top: 10rpx; color: var(--text-secondary, #70767a); font-size: 25rpx; line-height: 1.65; }
.notice-row { margin-top: 22rpx; padding: 18rpx 20rpx; display: flex; gap: 12rpx; background: rgba(0,185,203,.08); color: #34727a; border-radius: 16rpx; font-size: 24rpx; line-height: 1.55; }
.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.days-input { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; border-radius: 14rpx; background: var(--field-bg, #f5f7f8); }
.days-input input { width: 84rpx; text-align: right; font-size: 28rpx; }
.days-input text { color: var(--text-secondary, #70767a); font-size: 24rpx; }
.primary-btn,.secondary-btn { border-radius: 18rpx; min-height: 86rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.primary-btn { margin-top: 24rpx; background: #00b9cb; color: #fff; }
.secondary-btn { background: var(--field-bg, #f4f6f7); color: var(--text-primary, #202124); }
.primary-btn::after,.secondary-btn::after,.text-btn::after { border: none; }
.code-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.code-title { max-width: 430rpx; }
.code-no { margin-top: 8rpx; color: var(--text-secondary, #747a7e); font-size: 23rpx; }
.status-tag { flex: none; padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(255,166,52,.11); color: #a76000; font-size: 22rpx; }
.flow-tags { display: flex; gap: 12rpx; margin: 22rpx 0; }
.flow-tags text { padding: 7rpx 13rpx; border-radius: 10rpx; background: rgba(0,185,203,.09); color: #009dae; font-size: 22rpx; }
.qr-wrap { display: flex; flex-direction: column; align-items: center; padding: 22rpx 0 8rpx; }
.qr-image { width: 360rpx; height: 360rpx; border-radius: 20rpx; background: #fff; }
.qr-tip { margin-top: 14rpx; color: var(--text-secondary, #757b80); font-size: 24rpx; }
.expire-text { text-align: center; color: var(--text-tertiary, #91969a); font-size: 22rpx; margin: 8rpx 0 18rpx; }
.share-actions { display: flex; gap: 16rpx; }
.share-actions .half { flex: 1; margin-top: 0; }
.secondary-btn.full { margin-top: 16rpx; width: 100%; }
.text-btn { margin-top: 12rpx; background: transparent; color: #00a7b7; font-size: 25rpx; }
.security-title { margin-bottom: 18rpx; }
.security-item { display: flex; gap: 14rpx; align-items: flex-start; margin-top: 14rpx; color: var(--text-secondary, #697075); font-size: 25rpx; line-height: 1.6; }
.num { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(0,185,203,.10); color: #00a1b2; flex: none; font-size: 21rpx; }
.poster-canvas { position: fixed; left: -10000px; top: -10000px; width: 320px; height: 440px; pointer-events: none; }
@media (prefers-color-scheme: dark) {
  page { --page-bg: #111416; --card-bg: #1b1f22; --field-bg: #24292d; --text-primary: #f1f3f4; --text-secondary: #aeb4b8; --text-tertiary: #858b90; }
  .notice-row { color: #8fcbd2; }
  .status-tag { color: #e4a34b; }
}
