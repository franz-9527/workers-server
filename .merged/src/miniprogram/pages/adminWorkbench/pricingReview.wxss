page { background: #f4f7f8; color: #162126; }
.pricing-page { min-height: 100vh; padding-bottom: 40rpx; }
.pricing-hero { padding: 30rpx 30rpx 34rpx; background: linear-gradient(145deg, #073b43, #0b6770); color: #fff; }
.hero-kicker { font-size: 24rpx; opacity: .72; letter-spacing: 1rpx; }
.hero-title { margin-top: 10rpx; font-size: 40rpx; font-weight: 700; }
.hero-desc { margin-top: 14rpx; font-size: 26rpx; line-height: 1.65; opacity: .82; }
.section, .state-card, .rule-card { margin: 22rpx 24rpx 0; padding: 28rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(26,55,61,.05); }
.compact-section { padding-bottom: 20rpx; }
.section-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; }
.section-title { font-size: 31rpx; font-weight: 700; color: #132c31; }
.section-desc { margin-top: 8rpx; font-size: 24rpx; line-height: 1.55; color: #718086; }
.status-chip { padding: 8rpx 16rpx; border-radius: 999rpx; background: #e6f7f8; color: #087d87; font-size: 22rpx; white-space: nowrap; }
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24rpx; margin-top: 22rpx; }
.summary-grid view { padding: 18rpx 0; border-top: 1rpx solid #edf1f2; display: flex; flex-direction: column; gap: 6rpx; }
.summary-grid text:first-child { font-size: 22rpx; color: #8a969a; }
.summary-grid text:last-child { font-size: 27rpx; color: #21363a; font-weight: 600; }
.pricing-item { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #e6edef; border-radius: 18rpx; background: #fbfcfc; }
.item-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; }
.item-name { font-size: 28rpx; font-weight: 650; color: #193337; }
.item-note { margin-top: 6rpx; font-size: 22rpx; color: #8b9699; }
.item-price { font-size: 24rpx; color: #476066; white-space: nowrap; }
.quantity-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; margin-top: 22rpx; }
.quantity-field { flex: 1; }
.field-label { display: block; margin-bottom: 10rpx; font-size: 23rpx; color: #65767b; }
.input-with-unit { display: flex; align-items: center; min-height: 76rpx; padding: 0 18rpx; border: 1rpx solid #dbe5e7; border-radius: 14rpx; background: #fff; }
.input-with-unit input { flex: 1; min-width: 0; font-size: 29rpx; }
.input-with-unit text { margin-left: 12rpx; font-size: 24rpx; color: #7e8c90; }
.amount-preview { min-width: 180rpx; padding-bottom: 10rpx; display: flex; flex-direction: column; align-items: flex-end; }
.amount-preview text:first-child { font-size: 22rpx; color: #8a969a; }
.amount-preview text:last-child { margin-top: 6rpx; font-size: 29rpx; font-weight: 700; color: #087d87; }
.total-bar { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #e9eff0; display: flex; justify-content: space-between; align-items: center; font-size: 27rpx; }
.total-bar text:last-child { font-size: 34rpx; font-weight: 700; color: #087d87; }
.field { margin-top: 24rpx; }
.field input { box-sizing: border-box; width: 100%; min-height: 82rpx; padding: 0 20rpx; border: 1rpx solid #dbe5e7; border-radius: 14rpx; background: #fbfcfc; font-size: 29rpx; }
.note-field textarea { box-sizing: border-box; width: 100%; min-height: 170rpx; padding: 20rpx; border: 1rpx solid #dbe5e7; border-radius: 14rpx; background: #fbfcfc; font-size: 27rpx; line-height: 1.55; }
.placeholder { color: #a5afb2; }
.rule-card { font-size: 24rpx; line-height: 1.8; color: #66777c; background: #eef8f8; box-shadow: none; }
.rule-title { margin-bottom: 6rpx; font-size: 27rpx; font-weight: 700; color: #18575d; }
.state-card { text-align: center; color: #64757a; font-size: 27rpx; }
.error-card { color: #86423f; }
.spin { display: inline-block; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.bottom-space { height: 150rpx; }
.bottom-actions { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; gap: 18rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); border-top: 1rpx solid #e6ecee; backdrop-filter: blur(14rpx); }
.bottom-actions button { margin: 0; min-height: 84rpx; border-radius: 16rpx; font-size: 27rpx; }
.primary-button { flex: 1.8; background: #00aebd; color: #fff; }
.secondary-button { flex: 1; background: #edf3f4; color: #395156; }
button::after { border: none; }
@media (prefers-color-scheme: dark) {
  page { background: #0e1416; color: #e7edef; }
  .section, .state-card { background: #172023; box-shadow: none; }
  .section-title, .item-name { color: #edf4f5; }
  .section-desc, .field-label, .item-note { color: #95a5a9; }
  .summary-grid view, .total-bar { border-color: #293438; }
  .summary-grid text:last-child { color: #dce7e9; }
  .pricing-item, .field input, .note-field textarea, .input-with-unit { background: #11191b; border-color: #2a3a3d; color: #edf4f5; }
  .item-price { color: #aab8bb; }
  .rule-card { background: #123034; color: #a9c1c5; }
  .rule-title { color: #87dce2; }
  .bottom-actions { background: rgba(18,25,27,.96); border-color: #293438; }
  .secondary-button { background: #263236; color: #dbe6e8; }
}

.pricing-page .bottom-space{height:calc(150rpx + env(safe-area-inset-bottom))}
.pricing-page .bottom-actions button{display:flex;align-items:center;justify-content:center;min-width:0;box-sizing:border-box;padding:18rpx 16rpx;line-height:1.45;text-align:center;white-space:normal}
.pricing-page .quantity-field,.pricing-page .item-head>view:first-child{min-width:0;flex:1}
.pricing-page .item-name{overflow-wrap:anywhere}
@media (max-width:360px){.pricing-page .quantity-row{flex-wrap:wrap}.pricing-page .amount-preview{min-width:0}}
@media (prefers-color-scheme:dark){
  .pricing-page .status-chip{background:#12383d;color:#80e7ee}
  .pricing-page .amount-preview text:last-child,.pricing-page .total-bar text:last-child{color:#80e7ee}
  .pricing-page .error-card{color:#ffb5aa}
}
