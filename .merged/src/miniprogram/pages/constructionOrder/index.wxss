.adaptive-nav{position:fixed;left:0;right:0;top:0;z-index:40;box-sizing:border-box;color:#fff;transition:background .2s ease,color .2s ease,box-shadow .2s ease;pointer-events:none}.nav-inner{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;pointer-events:auto}.nav-back{position:absolute;left:22rpx;display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;background:rgba(18,67,56,.22);color:#fff;font-size:34rpx;backdrop-filter:blur(10px)}.nav-title{font-size:31rpx;font-weight:700;opacity:0;transform:translateY(-6rpx);transition:opacity .18s ease,transform .18s ease}.adaptive-nav.solid{background:rgba(255,255,255,.96);color:#24342f;box-shadow:0 1rpx 0 rgba(30,70,61,.08);backdrop-filter:blur(18px)}.adaptive-nav.solid .nav-back{background:transparent;color:#24342f}.adaptive-nav.solid .nav-title{opacity:1;transform:translateY(0)}
.construction-page{min-height:100vh;background:#f3f7f5;padding-bottom:48rpx;color:#24342f}.hero{display:flex;align-items:center;justify-content:space-between;padding:42rpx 34rpx 48rpx;color:#fff;background:linear-gradient(135deg,#0fb58f,#078e70);border-radius:0 0 34rpx 34rpx}.hero-title{font-size:42rpx;font-weight:700}.hero-subtitle{margin-top:10rpx;font-size:24rpx;opacity:.86}.hero-icon{font-size:76rpx;opacity:.25}.legacy-entry{display:flex;align-items:center;margin:-20rpx 24rpx 20rpx;padding:24rpx;background:#fff;border-radius:20rpx;box-shadow:0 10rpx 30rpx rgba(18,91,72,.1);position:relative;z-index:2}.legacy-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:18rpx;background:#e7f7f1;color:#079373;font-size:38rpx}.legacy-content{flex:1;margin-left:20rpx;font-size:30rpx;font-weight:600}.legacy-content text{display:block;margin-top:6rpx;color:#82918c;font-size:22rpx;font-weight:400}.legacy-entry>.cuIcon-right{color:#a0ada9}.status-scroll{white-space:nowrap;margin-bottom:20rpx}.status-tabs{display:flex;padding:0 24rpx}.status-tab{position:relative;min-width:164rpx;padding:20rpx 4rpx;text-align:center;color:#74827e;font-size:25rpx}.status-tab.active{color:#078d6e;font-weight:700}.status-tab.active:after{content:"";position:absolute;left:50%;bottom:4rpx;width:38rpx;height:5rpx;border-radius:5rpx;background:#0aa07d;transform:translateX(-50%)}.order-list{padding:0 24rpx}.order-card{margin-bottom:20rpx;padding:24rpx;background:#fff;border-radius:22rpx;box-shadow:0 8rpx 26rpx rgba(31,74,62,.07)}.card-main{display:flex}.cover{width:158rpx;height:140rpx;border-radius:16rpx;flex:none}.cover-placeholder{display:flex;align-items:center;justify-content:center;background:#edf3f0;color:#9eaaa6;font-size:50rpx}.card-content{flex:1;min-width:0;margin-left:20rpx}.title-line{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.order-title{max-width:290rpx;font-size:29rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status{padding:5rpx 12rpx;border-radius:20rpx;background:#e4f7f0;color:#078d6e;font-size:21rpx;white-space:nowrap}.order-no{margin-top:8rpx;color:#98a39f;font-size:21rpx}.order-tags{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:9rpx}.order-tag{display:inline-flex;align-items:center;padding:3rpx 10rpx;border-radius:8rpx;font-size:20rpx;line-height:1.45}.platform-tag{color:#087a61;background:#e7f7f1;border:1rpx solid #ccecdf}.invite-tag{color:#a56614;background:#fff5dd;border:1rpx solid #f4ddb1}.order-meta{display:flex;flex-direction:column;gap:5rpx;margin-top:10rpx;color:#5d6c67;font-size:23rpx}.visit-time{margin-top:7rpx;color:#82908c;font-size:22rpx}.card-footer{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #edf1ef;color:#7d8c87;font-size:23rpx}.income{color:#078d6e;font-weight:600}.empty{padding:100rpx 40rpx;text-align:center;color:#73827d}.empty-icon{display:block;margin-bottom:22rpx;color:#66b29d;font-size:90rpx}.empty-title{font-size:29rpx;font-weight:600;color:#40514b}.empty-subtitle{margin-top:10rpx;font-size:23rpx}.join-button,.retry-button{margin-top:28rpx;color:#fff;background:#0a9d7c}.loading,.finished{padding:28rpx;text-align:center;color:#82918c;font-size:23rpx}.spin{display:inline-block;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
/* 2026-09-20：测量单并入师傅订单，只保留弱紫色卡片与“测量”标签。 */
.measurement-card{border-left:6rpx solid rgba(102,87,217,.36);background:linear-gradient(90deg,rgba(102,87,217,.035),#fff 20%)}
.measurement-tag{color:#6657d9;background:#f4f2ff;border:1rpx solid #ddd8ff}

@media (prefers-color-scheme:dark){.construction-page{background:#101718;color:#e7f0f1}.adaptive-nav.solid{background:rgba(18,28,30,.96);color:#e7f0f1;box-shadow:0 1rpx 0 #263638}.adaptive-nav.solid .nav-back{color:#e7f0f1}.legacy-entry,.order-card{background:#192629;color:#e7f0f1;box-shadow:none}.legacy-icon{background:#173b34;color:#66d2b4}.legacy-content text,.order-no,.visit-time,.card-footer,.loading,.finished{color:#9fb0ac}.status-tab{color:#9baba7}.status-tab.active,.income{color:#67d3b6}.cover-placeholder{background:#223033;color:#91a09d}.status{background:#153b32;color:#72dabc}.order-meta{color:#b7c5c1}.platform-tag{background:#173b34;border-color:#28594d;color:#73d9bd}.invite-tag{background:#3d321e;border-color:#5f4c2c;color:#e9c37e}.measurement-card{background:linear-gradient(90deg,rgba(119,104,225,.10),#192629 24%)}.measurement-tag{background:#2a2744;border-color:#45406e;color:#b7aef4}.empty-title{color:#dce7e4}.empty{color:#9dacaa}}
