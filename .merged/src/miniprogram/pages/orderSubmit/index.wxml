<!-- 2026-08-23：步骤和业务字段均由后台动态表单驱动，视觉延续现有 ColorUI GA。 -->
<view class="submit-page" wx:if="{{!loading && !loadErrorText && !proxyCreatedOrderId}}">
  <order-announcement scene="order_submit"></order-announcement>
  <view wx:if="{{proxyMode}}" class="form-card bg-white"><view class="text-bold">代客户下单 · {{proxyCustomer.nickname}}</view><view class="help">{{proxyCustomer.mobile_masked}} · 资料完成后由客户本人核对、同意协议并支付 {{bookingFeeText}} 预约费。</view></view>
  <view wx:if="{{submissionPolicy.restricted && currentStep === 0}}" class="form-card bg-white">
    <view class="text-orange text-bold">暂时无法下单</view>
    <view class="help margin-top-sm">{{submissionPolicy.message}}</view>
    <button class="cu-btn margin-top-sm" bindtap="showSubmissionRestriction">联系客服核实解除</button>
  </view>
  <scroll-view scroll-x class="step-scroll bg-white">
    <view class="steps flex">
      <view wx:for="{{steps}}" wx:key="id" class="step {{currentStep === index ? 'active' : ''}} {{currentStep > index ? 'done' : ''}}">
        <view class="dot">{{currentStep > index ? '✓' : index + 1}}</view><view class="step-name">{{item.title}}</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{currentStep < steps.length - 1}}" class="form-card bg-white">
    <view class="form-heading-row" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;">
      <view class="form-heading-copy" style="min-width:0;flex:1;"><view class="text-xl text-bold">{{steps[currentStep].title}}</view><view class="text-grey text-sm margin-top-xs">{{steps[currentStep].description}}</view></view>
      <button wx:if="{{!proxyMode && currentStep === 0 && businessType === 'construction' && (merchant.verification_status === 'approved' || merchant.recognition_level === 'confirmed' || merchant.recognition_level === 'suspected')}}" class="cu-btn sm round line-cyan" style="flex:none;margin:0;padding:0 18rpx;height:56rpx;line-height:56rpx;font-size:22rpx;" bindtap="openProductTemplates">商品模板</button>
    </view>
    <!-- V2.5.0：高频商家直接使用最近商品；只复用商品类目/规格，客户、现场与费用继续本单确认。 -->
    <view wx:if="{{currentStep === 0 && businessType === 'construction' && merchantTemplates.length}}" class="margin-top-sm">
      <view class="flex justify-between align-center"><view><text class="text-bold">最近商品</text><text class="text-grey text-xs margin-left-xs">不带入地址、联系人、时间、现场图或费用</text></view><text class="text-cyan text-sm" bindtap="openProductTemplates">管理</text></view>
      <scroll-view scroll-x class="margin-top-sm" style="white-space:nowrap;">
        <block wx:for="{{merchantTemplates}}" wx:key="id">
          <navigator wx:if="{{index < 4}}" hover-class="none" class="cu-btn sm round line-cyan margin-right-sm" style="display:inline-block;max-width:300rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" url="/subpackages/orderTools/productTemplates/index?scope={{merchantTemplateScope}}&quick={{item.id}}">{{item.name}}</navigator>
        </block>
      </scroll-view>
    </view>
    <view wx:if="{{!proxyMode && currentStep === 0 && businessType === 'construction'}}" class="margin-top-sm">
      <button class="cu-btn sm round line-cyan" bindtap="openProductHistory">从历史订单选择商品</button>
      <view wx:if="{{reuseProductOrderId}}" class="help">已带入 {{reuseProductOrderId}} 的商品资料与商品图，请核对本次用量和现场。</view>
      <view wx:if="{{productHistoryOpen}}" class="history-products">
        <view class="flex justify-between"><text class="text-bold">已完成订单的商品</text><text class="text-cyan" bindtap="closeProductHistory">收起</text></view>
        <view class="help">仅带入商品类目、规格、链接和商品图片。</view>
        <view wx:for="{{productHistory}}" wx:key="id" class="history-product-row">
          <view class="help">{{item.id}} · {{item.label}}</view>
          <scroll-view wx:if="{{item.media.length}}" scroll-x class="history-images"><image wx:for="{{item.media}}" wx:for-item="photo" wx:key="id" src="{{photo.url}}" mode="aspectFill"></image></scroll-view>
          <button class="cu-btn sm round line-cyan" data-id="{{item.id}}" bindtap="applyHistoricalProduct">使用此商品</button>
        </view>
        <view wx:if="{{productHistoryError}}" class="help text-orange">{{productHistoryError}}</view>
        <view wx:if="{{!productHistoryLoading && !productHistoryError && !productHistory.length}}" class="help">暂无可复用的历史商品</view>
        <button wx:if="{{productHistoryLoading || productHistoryHasMore || productHistoryError}}" class="cu-btn sm" loading="{{productHistoryLoading}}" disabled="{{productHistoryLoading}}" bindtap="loadProductHistory">{{productHistoryError ? '重新加载' : '加载更多'}}</button>
      </view>
    </view>
    <!-- V2.2.9：施工/测量由后台可视化字段 workflow_profile 渲染，不再在页面硬编码第二套选择器。 -->
    <view wx:for="{{currentFields}}" wx:key="id" wx:if="{{!item.runtime_collapsed}}" class="field">
      <view class="label text-bold"><text wx:if="{{item.runtime_required}}" class="text-red">*</text>{{item.label}}<text wx:if="{{item.runtime_disabled}}" class="text-grey text-sm">（当前不可修改）</text></view>
      <view wx:if="{{item.help_text}}" class="help">{{item.help_text}}</view>

      <!-- 可复用商品字段与商品模板页共用同一套控件。类目仍保留本页联动逻辑。 -->
      <order-product-field
        wx:if="{{currentStep === 0 && item.component_type !== 'category_picker' && item.field_key !== 'workflow_profile' && item.field_key !== 'is_renovation' && item.field_key !== 'material_images' && item.field_key !== 'quantity' && item.field_key !== 'wall_images' && item.field_key !== 'wall_height' && item.field_key !== 'expected_fee' && item.field_key !== 'expected_fee_type' && (item.component_type === 'radio' || item.component_type === 'single' || item.component_type === 'boolean' || item.component_type === 'checkbox' || item.component_type === 'multiple' || item.field_key === 'product_link')}}"
        field="{{item}}"
        answers="{{answers}}"
        categories="{{categories}}"
        selected-category-ids="{{selectedCategoryIds}}"
        selected-category-name="{{selectedCategoryName}}"
        data-key="{{item.field_key}}"
        bind:valuechange="inputChange"
      ></order-product-field>

      <block wx:else>
      <view wx:if="{{item.component_type === 'category_picker'}}" class="category-picker">
        <view class="category-tip flex justify-between"><text>可多选；暂不确定和其他单独选择</text><text>{{selectedCategoryIds.length}}/6</text></view>
        <view class="category-grid">
          <view wx:for="{{categories}}" wx:for-item="category" wx:key="id" class="category-choice {{category.selected ? 'selected' : ''}}" data-id="{{category.id}}" data-disabled="{{item.runtime_disabled}}" bindtap="toggleCategory">{{category.name}}</view>
          <view class="category-choice category-choice-unknown {{answers.category_mode === 'unknown' ? 'selected' : ''}}" data-special="unknown" data-disabled="{{item.runtime_disabled}}" bindtap="toggleCategory">暂不确定</view>
          <view class="category-choice {{answers.category_mode === 'other' ? 'selected' : ''}}" data-special="other" data-disabled="{{item.runtime_disabled}}" bindtap="toggleCategory">其他</view>
        </view>
        <input wx:if="{{answers.category_mode === 'other'}}" class="input category-other-input" value="{{answers.category_other}}" maxlength="50" disabled="{{item.runtime_disabled}}" placeholder="请填写具体类目" bindinput="inputCategoryOther"/>
        <view class="category-result">当前：{{selectedCategoryName}}</view>
      </view>
      <view wx:elif="{{item.component_type === 'radio' || item.component_type === 'single' || (item.component_type === 'boolean' && item.runtime_options.length)}}" class="option-group">
        <view wx:for="{{item.runtime_options}}" wx:for-item="option" wx:key="option_key" class="option option-tappable {{option.checked ? 'selected' : ''}} {{item.runtime_disabled ? 'disabled' : ''}}" data-key="{{item.field_key}}" data-value="{{option.value_text}}" data-disabled="{{item.runtime_disabled ? 1 : 0}}" bindtap="toggleSingleOption"><text class="single-option-check cuIcon-{{option.checked ? 'roundcheckfill' : 'round'}}"></text><text>{{option.label}}</text></view>
      </view>
      <checkbox-group wx:elif="{{item.component_type === 'checkbox' || item.component_type === 'multiple'}}" data-key="{{item.field_key}}" bindchange="checkboxChange" class="option-group">
        <label wx:for="{{item.runtime_options}}" wx:for-item="option" wx:key="option_key" class="option"><checkbox disabled="{{item.runtime_disabled}}" value="{{option.value_text}}" checked="{{option.checked}}" color="#00b9cb"/>{{option.label}}</label>
      </checkbox-group>
      <view wx:elif="{{item.component_type === 'switch' || (item.component_type === 'boolean' && !item.runtime_options.length)}}" class="switch-line"><switch disabled="{{item.runtime_disabled}}" checked="{{item.runtime_value ? true : false}}" color="#00b9cb" data-key="{{item.field_key}}" bindchange="switchChange"/><text>{{item.runtime_value ? '是' : '否'}}</text></view>
      <view wx:elif="{{item.component_type === 'image_upload' || item.component_type === 'image'}}">
        <view class="image-rule-hint"><text wx:if="{{item.runtime_image_min > 0}}">至少{{item.runtime_image_min}}张，</text>最多{{item.runtime_image_max}}张 · 已选{{item.field_key === 'material_images' ? materialImages.length : wallImages.length}}张</view>
        <view class="image-grid">
          <view wx:for="{{item.field_key === 'material_images' ? materialImages : wallImages}}" wx:for-item="imagePath" wx:key="*this" class="image-cell">
            <image src="{{imagePath.url || imagePath}}" mode="aspectFill" data-purpose="{{item.field_key === 'material_images' ? 'product' : 'wall'}}" data-index="{{index}}" bindtap="previewImage"></image>
            <text class="remove cuIcon-close" data-purpose="{{item.field_key === 'material_images' ? 'product' : 'wall'}}" data-index="{{index}}" catchtap="removeImage"></text>
          </view>
          <view wx:if="{{!item.runtime_disabled && (item.field_key === 'material_images' ? materialImages.length < item.runtime_image_max : wallImages.length < item.runtime_image_max)}}" class="image-add flex flex-direction align-center justify-center" data-purpose="{{item.field_key === 'material_images' ? 'product' : 'wall'}}" bindtap="chooseImages"><text class="cuIcon-cameraadd text-xxl"></text><text class="text-sm">添加照片</text></view>
        </view>
      </view>
      <view wx:elif="{{item.component_type === 'wechat_address' || item.component_type === 'address' || item.component_type === 'map'}}" class="address-panel">
        <view class="address-actions">
          <button disabled="{{item.runtime_disabled}}" data-disabled="{{item.runtime_disabled}}" class="cu-btn address-primary" bindtap="chooseLocation"><text class="cuIcon-location"></text> {{address.lat !== undefined && address.lat !== null && address.lat !== '' ? '重新地图选点' : '腾讯地图选点'}}</button>
          <picker disabled="{{item.runtime_disabled}}" mode="region" value="{{[address.province,address.city,address.district]}}" bindchange="regionChange"><view class="cu-btn address-secondary"><text class="cuIcon-list"></text> 修正省市区</view></picker>
        </view>
        <view class="selected-region">{{address.province || '省份'}} / {{address.city || '城市'}} / {{address.district || '区县'}}</view>
        <view class="help margin-top-xs"><text class="{{address.lat !== undefined && address.lat !== null && address.lat !== '' ? 'text-cyan' : 'text-orange'}}">{{address.lat !== undefined && address.lat !== null && address.lat !== '' ? '地图位置：' + (address.map_name || address.map_address || '已选点') : '必须先地图选点，用于距离排序和接单范围判断'}}</text></view>
        <input disabled="{{item.runtime_disabled}}" class="input margin-top-sm" value="{{address.detail}}" maxlength="255" placeholder="地图选点后自动填入，可继续修改楼栋、单元和门牌" bindinput="addressDetailInput"/>
        <view class="help margin-top-xs">详细地址和地图点分开保存：修改文字地址不会移动地图点；如果修正到不同省市区，需要重新选点。</view>
      </view>
      <view wx:elif="{{item.component_type === 'date_picker' || item.component_type === 'date'}}">
        <picker disabled="{{item.runtime_disabled}}" mode="date" value="{{item.runtime_value}}" start="{{today}}" data-key="{{item.field_key}}" bindchange="dateChange"><view class="input">{{item.runtime_value || item.placeholder || '请选择日期'}}</view></picker>
        <view wx:if="{{item.field_key === 'expected_visit_date'}}" class="visit-periods">
          <view class="visit-period-title">期望时间段 <text>{{answers.expected_visit_date ? '请选择一个时间段' : '请先选择日期'}}</text></view>
          <view class="visit-period-options"><view wx:for="{{visitPeriods}}" wx:key="key" class="visit-period {{answers.expected_visit_period === item.key ? 'selected' : ''}} {{!answers.expected_visit_date ? 'disabled' : ''}}" data-key="{{item.key}}" bindtap="selectVisitPeriod">{{item.label}}</view></view>
          <view class="help visit-period-help">仅表达大致上门时间，具体时间由师傅接单后电话预约。</view>
        </view>
      </view>
      <view wx:elif="{{item.component_type === 'date_range'}}" class="date-range"><picker disabled="{{item.runtime_disabled}}" mode="date" value="{{item.runtime_range[0]}}" start="{{today}}" data-key="{{item.field_key}}" data-side="start" bindchange="dateRangeChange"><view class="input">{{item.runtime_range[0] || '开始日期'}}</view></picker><text>至</text><picker disabled="{{item.runtime_disabled}}" mode="date" value="{{item.runtime_range[1]}}" start="{{item.runtime_range[0] || today}}" data-key="{{item.field_key}}" data-side="end" bindchange="dateRangeChange"><view class="input">{{item.runtime_range[1] || '结束日期'}}</view></picker></view>
      <view wx:elif="{{item.field_key === 'expected_fee'}}" class="expected-fee-control">
        <view class="expected-fee-modes">
          <view class="expected-fee-mode {{answers.expected_fee_type === 'unit' ? '' : 'selected'}}" data-type="total" bindtap="selectExpectedFeeType">总价</view>
          <view class="expected-fee-mode {{answers.expected_fee_type === 'unit' ? 'selected' : ''}}" data-type="unit" bindtap="selectExpectedFeeType">单价</view>
        </view>
        <view wx:if="{{answers.expected_fee_type === 'unit'}}" class="expected-fee-unit-rows">
          <view wx:for="{{expectedFeeRows}}" wx:key="row_key" class="expected-fee-unit-row {{expectedFeeRows.length > 1 ? 'multi' : 'single'}}">
            <input disabled="{{item.runtime_disabled}}" class="expected-fee-line-input" value="{{item.text}}" maxlength="80" placeholder="{{item.material_name ? '在材料名后填写单价' : '填写材料名和单价'}}" data-index="{{index}}" bindinput="expectedFeeLineInput"/>
            <picker disabled="{{item.runtime_disabled}}" range="{{expectedFeeUnitOptions}}" value="{{item.unit_index}}" data-index="{{index}}" bindchange="expectedFeeUnitChange"><view class="expected-fee-unit-picker {{item.unit ? 'selected' : ''}}">{{item.unit || '选择单位'}} <text class="cuIcon-unfold"></text></view></picker>
          </view>
        </view>
        <view wx:else class="expected-fee-input"><text class="expected-fee-symbol">¥</text><input disabled="{{item.runtime_disabled}}" value="{{item.runtime_value}}" placeholder="填写期望总价" type="number" maxlength="7" data-key="{{item.field_key}}" bindinput="inputChange"/><text class="expected-fee-unit">元</text></view>
        <view class="expected-fee-hint">{{answers.expected_fee_type === 'unit' ? (selectedCategoryIds.length > 1 ? '已按所选材料分别生成一行，材料名可修改；单位可从预设项选择。单价仅作文字参考，不参与金额计算。' : '材料名已预填且可修改，单位可从预设项选择。单价仅作文字参考，不参与金额计算。') : '总价只填写整数元，不保留小数。抢单模式下，填写总价后可抢单即成交。'}}</view>
      </view>
      <textarea wx:elif="{{item.component_type === 'textarea'}}" disabled="{{item.runtime_disabled}}" class="textarea" value="{{item.runtime_value}}" placeholder="{{item.placeholder}}" data-key="{{item.field_key}}" bindinput="inputChange"></textarea>
      <input wx:else disabled="{{item.runtime_disabled}}" class="input" value="{{item.runtime_value}}" placeholder="{{item.component_type === 'phone' ? '11位手机号，虚拟号可填写“手机号-转拨号”' : item.placeholder}}" type="{{item.data_type === 'integer' && item.component_type !== 'phone' ? 'number' : (item.data_type === 'decimal' || item.component_type === 'number' || item.component_type === 'number_input' ? 'digit' : 'text')}}" maxlength="{{item.component_type === 'phone' ? 22 : (item.validation.max_length || -1)}}" data-key="{{item.field_key}}" bindinput="inputChange"/>
      </block>
    </view>
    <view wx:if="{{collapseOptionalByDefault && optionalFieldCount > 0}}" class="optional-fields-toggle" bindtap="toggleOptionalFields"><text wx:if="{{optionalExpanded}}">收起非必填资料</text><text wx:else>填写更多资料（{{optionalCollapsedCount}}项）</text><text class="cuIcon-{{optionalExpanded ? 'fold' : 'unfold'}}"></text></view>
    <view wx:if="{{currentStep === steps.length - 2}}" class="field"><view class="label text-bold"><text class="text-red">*</text>下单人电话</view><view class="flex justify-between align-center"><text>{{loginMobile || '尚未授权'}}</text><button class="cu-btn sm round line-cyan" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" disabled="{{phoneAuthorizing}}" loading="{{phoneAuthorizing}}">{{phoneAuthorizing ? '授权中' : '微信授权'}}</button></view><view class="help">仅用于订单联系，不会替代业主对接人电话</view></view>
  </view>

  <view wx:else class="form-card bg-white confirm">
    <view class="text-xl text-bold">请确认订单资料</view>
    <view wx:if="{{businessType === 'construction' && (merchant.verification_status === 'approved' || merchant.recognition_level === 'confirmed' || merchant.recognition_level === 'suspected')}}" class="merchant-order-notice"><text class="cuIcon-shop"></text><view><text>本单按商家订单处理</text><small>师傅仅联系实际业主，商家与师傅号码互相保护；完工后通过审核收款码付款。</small></view></view>
    <block wx:if="{{businessType === 'construction'}}">
    <view class="confirm-section-head"><text>服务类目</text><button class="confirm-edit" data-key="category_ids" bindtap="jumpToField">修改</button></view>
    <view class="summary"><text>已选类目</text><text>{{selectedCategoryName}}</text></view>
    <view class="summary"><text>购买数量</text><text>{{answers.quantity}}</text></view>
    <view class="summary"><text>期望费用</text><text class="{{answers.expected_fee ? 'text-orange text-bold right-text' : 'text-grey'}}">{{answers.expected_fee ? (answers.expected_fee_type === 'unit' ? '单价说明：' : '总价 ¥') + answers.expected_fee : '未填写'}}</text></view>
    <view class="summary"><text>期望上门</text><text>{{answers.expected_visit_date ? answers.expected_visit_date + ' ' + (answers.expected_visit_period === 'morning' ? '上午' : (answers.expected_visit_period === 'afternoon' ? '下午' : '晚上')) : '接单后电话预约'}}</text></view>
    <view class="summary"><text>施工地址</text><text class="right-text">{{address.city}}{{address.district}}{{address.detail}}</text></view>
    <view class="summary"><text>地图位置</text><text class="right-text text-cyan">{{address.map_name || address.map_address || '已选点'}}</text></view>
    <view class="confirm-section-head"><text>对接人</text><button class="confirm-edit" data-key="contact" bindtap="jumpToField">修改</button></view>
    <view class="summary"><text>联系人和电话</text><text>{{address.contact_name}} {{address.contact_mobile}}</text></view>
    <view class="dispatch-mode-panel">
      <view class="confirm-section-head dispatch-mode-head"><view class="dispatch-mode-title">接单模式 <text class="cuIcon-info dispatch-mode-help" catchtap="showDispatchModeHelp"></text></view></view>
      <view wx:if="{{selectedMeasurementId}}" class="dispatch-mode-locked"><text class="cuIcon-lock"></text><view><strong>已关联测量单</strong><small>由原测量师傅报价，不参与公开抢单。</small></view></view>
      <view wx:else class="dispatch-mode-options">
        <view class="dispatch-mode-option {{dispatchMode === 'multi_quote' ? 'selected' : ''}}" data-mode="multi_quote" bindtap="selectDispatchMode"><view class="dispatch-mode-check"><text class="{{dispatchMode === 'multi_quote' ? 'cuIcon-roundcheckfill' : 'cuIcon-round'}}"></text></view><view><strong>多师傅报价</strong><small>多位师傅先报价，你再比较并选择</small></view></view>
        <view class="dispatch-mode-option {{dispatchMode === 'single_grab' ? 'selected' : ''}}" data-mode="single_grab" bindtap="selectDispatchMode"><view class="dispatch-mode-check"><text class="{{dispatchMode === 'single_grab' ? 'cuIcon-roundcheckfill' : 'cuIcon-round'}}"></text></view><view><strong>单师傅抢单</strong><small>{{answers.expected_fee && answers.expected_fee_type !== 'unit' ? '首位师傅抢单即按期望总价成交' : (answers.expected_fee ? '单价说明仅参考，抢单后仍需报总价' : '师傅先抢单联系你，再报价直接进入施工')}}</small></view></view>
      </view>
    </view>
    <view class="confirm-section-head"><text>付款与成交</text></view>
    <view class="summary"><text>本次支付</text><text class="text-orange text-bold">{{bookingFeeText}} 预约费</text></view>
    <view class="summary"><text>后续价格</text><text class="right-text">{{selectedMeasurementId ? '由原测量师傅报价施工总价' : (dispatchMode === 'single_grab' ? (answers.expected_fee && answers.expected_fee_type !== 'unit' ? '按期望总价 ¥' + answers.expected_fee + ' 成交' : '抢单师傅沟通后提交施工总价') : '收到报价后比较并选择')}}</text></view>
    <view class="summary"><text>还需选师傅</text><text class="right-text">{{selectedMeasurementId ? '是，仅原测量师傅可报价' : (dispatchMode === 'single_grab' ? '否，首位成功抢单者锁定订单' : '是，由你比较报价后选择')}}</text></view>
    <view class="summary"><text>后续付款</text><text class="right-text">{{dispatchMode === 'single_grab' && answers.expected_fee && answers.expected_fee_type !== 'unit' && !selectedMeasurementId ? '预约费已计入成交总价，余款按该总价结算' : '预约费计入最终成交价，余款按最终成交价结算'}}</text></view>
    <view class="confirm-media-group"><view class="confirm-section-head"><text>商品图片 <small>{{materialImages.length}} 张</small></text><button class="confirm-edit" data-key="material_images" bindtap="jumpToField">修改</button></view><view wx:if="{{materialImages.length}}" class="confirm-thumbs"><image wx:for="{{materialImages}}" wx:key="*this" src="{{item.url || item.display_url || item}}" mode="aspectFill" data-purpose="product" data-index="{{index}}" bindtap="previewImage"></image></view><view wx:else class="confirm-empty">暂未上传</view></view>
    <view class="confirm-media-group"><view class="confirm-section-head"><text>现场环境/墙面图片 <small>{{wallImages.length}} 张</small></text><button class="confirm-edit" data-key="wall_images" bindtap="jumpToField">修改</button></view><view wx:if="{{wallImages.length}}" class="confirm-thumbs"><image wx:for="{{wallImages}}" wx:key="*this" src="{{item.url || item.display_url || item}}" mode="aspectFill" data-purpose="wall" data-index="{{index}}" bindtap="previewImage"></image></view><view wx:else class="confirm-empty">暂未上传</view></view>
    <view wx:if="{{measurementLinks.length}}" class="measurement-link-panel"><view class="confirm-section-head"><text>关联测量单（可选）</text></view><view class="measurement-link-hint">仅能选择同一地址、仍在冻结有效期且从未关联过施工的测量单。施工预约费支付成功后才正式占用这次一对一关联；优惠金额由原测量师傅在施工报价时填写。</view><view wx:for="{{measurementLinks}}" wx:key="id" class="measurement-link-choice {{selectedMeasurementId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectMeasurement"><text>{{item.id}} · {{item.worker_name}}</text><text>{{item.city}}{{item.district}}{{item.address_summary}} · 测量费 ¥{{item.measurement_amount_cents / 100}} · 有效至 {{item.hold_until}}</text></view></view>
    </block>
    <block wx:else>
      <view class="confirm-section-head"><text>服务方式</text></view>
      <view class="summary"><text>本次服务</text><text><text class="measurement-confirm-badge">测量</text> 上门量尺</text></view>
      <view class="summary"><text>期望上门</text><text>{{answers.expected_visit_date ? answers.expected_visit_date + ' ' + (answers.expected_visit_period === 'morning' ? '上午' : (answers.expected_visit_period === 'afternoon' ? '下午' : '晚上')) : '接单后电话预约'}}</text></view>
      <view class="summary"><text>服务地址</text><text class="right-text">{{address.city}}{{address.district}}{{address.detail}}</text></view>
      <view class="summary"><text>地图位置</text><text class="right-text text-cyan">{{address.map_name || address.map_address || '已选点'}}</text></view>
      <view class="confirm-section-head"><text>客户信息</text><button class="confirm-edit" data-key="contact" bindtap="jumpToField">修改</button></view>
      <view class="summary"><text>联系人和电话</text><text>{{address.contact_name}} {{address.contact_mobile}}</text></view>
    </block>
    <view wx:if="{{businessType === 'construction' && uploadingImages}}" class="upload-progress-card"><view class="upload-progress-head"><text>{{uploadLabel}}</text><text>{{uploadPercent}}%</text></view><view class="upload-progress-track"><view style="width:{{uploadPercent}}%"></view></view><text class="upload-progress-count">已完成 {{uploadedMaterial + uploadedWall}} / {{uploadTotal}} 张</text></view>
    <view wx:if="{{!proxyMode && businessType === 'construction'}}" class="notice"><text class="cuIcon-info text-cyan"></text> {{selectedMeasurementId ? '提交后支付 ' + bookingFeeText + ' 预约费；支付成功进入审核，之后仅原测量师傅可报价。' : (dispatchMode === 'single_grab' ? (answers.expected_fee && answers.expected_fee_type !== 'unit' ? '提交后支付 ' + bookingFeeText + ' 预约费；审核通过后首位成功抢单者按期望总价 ¥' + answers.expected_fee + ' 成交。后续加价仍需你确认。' : '提交后支付 ' + bookingFeeText + ' 预约费；审核通过后首位成功抢单者锁定订单，沟通后提交施工总价并进入施工。') : '提交后支付 ' + bookingFeeText + ' 预约费；审核通过后等待报价，由你比较并选择。无报价、未匹配师傅或到期取消时按规则原路退款。')}}</view>
    <view wx:if="{{!proxyMode && businessType === 'measurement'}}" class="notice measurement-submit-notice"><text class="cuIcon-info"></text> 测量下单同样先支付 {{bookingFeeText}} 预约费；收到师傅测量报价后，只补齐“测量总价－已付预约费”的差额，不重复收取预约费。</view>
    <view wx:if="{{confirmNotice}}" class="help text-grey text-xs margin-top-sm" style="white-space:pre-wrap">{{confirmNotice}}</view>
    <view wx:if="{{!proxyMode}}" class="agreement-card">
      <checkbox-group bindchange="agreementChange"><label class="agreement-check"><checkbox value="accepted" checked="{{agreementsAccepted}}" color="#00b9cb"/><text>我已阅读并同意以下规则</text></label></checkbox-group>
      <view class="agreement-links"><text wx:for="{{activeAgreements}}" wx:key="key" data-index="{{index}}" bindtap="viewAgreement">《{{item.title}}》<text wx:if="{{index < activeAgreements.length - 1}}">、</text></text></view>
      <view class="agreement-hint">返回修改订单资料后，需要重新确认。</view>
    </view>
  </view>

  <view class="bottom bg-white flex">
    <button class="cu-btn round line-grey" disabled="{{currentStep === 0 || submitting}}" bindtap="previous">上一步</button>
    <button class="cu-btn round bg-cyan text-white flex-sub margin-left" disabled="{{ordersPaused && currentStep === steps.length - 1}}" loading="{{submitting}}" bindtap="next">{{currentStep === steps.length - 1 ? (ordersPaused ? '暂停下单' : (proxyMode ? '提交资料，交给客户确认' : '提交并支付 ' + bookingFeeText)) : '下一步'}}</button>
  </view>
</view>

<view wx:if="{{loadErrorText}}" class="form-load-error text-center"><text class="cuIcon-warn text-orange"></text><view class="margin-top">{{loadErrorText}}</view><button class="cu-btn round bg-cyan text-white margin-top" bindtap="retryLoadForm">重新加载</button></view>
<view wx:if="{{loading}}" class="loading text-center text-grey"><text class="cuIcon-loading2 spin"></text> 正在加载下单表单</view>
<view wx:if="{{proxyCreatedOrderId}}" class="submit-page"><view class="form-card bg-white"><view class="text-xl text-bold">代下单资料已完成</view><view class="help margin-top-sm">{{proxyCreatedOrderId}}</view><view class="help margin-top-sm">客户：{{proxyCustomer.nickname}} {{proxyCustomer.mobile_masked}}。请将订单发给客户；由客户本人核对、确认协议并支付预约费。</view><button class="cu-btn round bg-cyan text-white margin-top" open-type="share">发给客户核对付款</button><button class="cu-btn round line-grey margin-top-sm" bindtap="openProxyOrder">查看管理员订单详情</button></view></view>
