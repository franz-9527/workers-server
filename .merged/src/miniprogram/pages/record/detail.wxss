.record-list{
  padding-top:102rpx; 
}
.content{
  padding: 20rpx 0;
  font-size: 30rpx;
  line-height: 60rpx;
}
/* 2026-08-30：服务器实名认证师傅在原详情页使用轻量标识，不改变原页面主配色。 */
.server-realname-tag {
  display: inline-flex;
  margin-left: 14rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #e8faf4;
  color: #159a68;
  font-size: 22rpx;
  line-height: 34rpx;
}
/* 微信客服 */
.img-qwkefu-style {  
  height: 130rpx;  
  width: 195rpx;  
  position: fixed;
  bottom: 400rpx;  
  right: 0rpx;
  opacity: 1
}  
/* 手机登录 */
.img-phone-style {  
  height: 130rpx;  
  width: 195rpx;  
  position: fixed;
  bottom: 300rpx;  
  right: 0rpx;
  opacity: 1
}  
/* 2026-09-02：师傅图片管理沿用原青绿色，不引入额外第三方组件。 */
.gallery-head,.gallery-save{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.gallery-head button{margin:0}.image-manager{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx}.managed-image{overflow:hidden;border-radius:16rpx;background:#f3f7f7}.managed-image image{display:block;width:100%;height:240rpx}.managed-actions{display:flex;justify-content:space-around;padding:16rpx 8rpx;font-size:34rpx;color:#00a8b8}.image-add{height:308rpx!important;margin:0!important;border:2rpx dashed #8edbe2!important;border-radius:16rpx!important;background:#f3fcfd!important;color:#009bac!important;font-size:25rpx!important}.image-add:after{border:0}.image-add text{display:block;font-size:58rpx}.gallery-save{gap:18rpx;margin-top:22rpx;margin-bottom:0}.gallery-save>text{flex:1}.gallery-save button{flex:none;margin:0}
/* 2026-09-28：全屏图片预览自己维护索引，关闭后主轮播停留在最后浏览图片。 */
.worker-image-preview{
  position:fixed;
  left:0;
  top:0;
  right:0;
  bottom:0;
  z-index:9999;
  background:#000;
  color:#fff;
}
.worker-image-preview__top{
  position:absolute;
  left:0;
  top:0;
  right:0;
  z-index:2;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:calc(24rpx + constant(safe-area-inset-top)) 28rpx 18rpx;
  padding:calc(24rpx + env(safe-area-inset-top)) 28rpx 18rpx;
  background:linear-gradient(180deg,rgba(0,0,0,.58),rgba(0,0,0,0));
}
.worker-image-preview__counter{font-size:26rpx;line-height:72rpx}
.worker-image-preview__close{
  display:flex;
  align-items:center;
  justify-content:center;
  width:72rpx;
  height:72rpx;
  border-radius:50%;
  font-size:30rpx;
  background:rgba(255,255,255,.14);
}
.worker-image-preview__swiper,
.worker-image-preview__slide{width:100%;height:100vh}
.worker-image-preview__slide{display:flex;align-items:center;justify-content:center}
.worker-image-preview__slide image{display:block;width:100%;height:100%}

/* 收费参考编辑：安装工费始终可改；历史存在 pay_fixed 时才额外显示开关。 */
.pricing-reference{flex:1;justify-content:flex-end;min-width:0}
.pricing-reference__editor{display:flex;flex-direction:column;gap:16rpx;flex:1;min-width:0}
.pricing-reference__row{display:flex;align-items:center;justify-content:flex-end;gap:16rpx;min-width:0}
.pricing-reference__input{
  width:300rpx;
  min-height:64rpx;
  padding:0 18rpx;
  border-radius:12rpx;
  text-align:right;
  background:#f5f8f9;
}

@media (prefers-color-scheme: dark) {
  .pricing-reference__input{color:#e7f0f1;background:#162225}
}

/* 2026-09-04：审核结果独立成轻量提示卡，驳回和暂停原因对本人清晰可见。 */
.worker-review-card{margin:20rpx 24rpx 8rpx;padding:22rpx 26rpx;border-radius:18rpx;background:#f4fbfc;border:1rpx solid rgba(0,185,203,.22);color:#148794}
.worker-review-card.approved{background:#effaf4;border-color:rgba(35,174,94,.22);color:#23864c}
.worker-review-card.rejected{background:#fff4f2;border-color:rgba(225,75,57,.2);color:#c84a3c}
.worker-review-card.suspended{background:#fff8e8;border-color:rgba(225,158,42,.25);color:#a56b05}
.worker-review-title{font-size:28rpx;font-weight:700;display:flex;align-items:center;gap:10rpx}
.worker-review-reason{font-size:25rpx;line-height:1.55;margin-top:10rpx;color:inherit;word-break:break-all}


/* V2.2.9：管理员审核按钮直接表达当前状态；短信累计次数仅管理员可见。 */
.admin-review-action{min-width:210rpx;color:#fff!important;font-weight:700;border:0!important}
.admin-review-action.review-action-pending{background:#d9a321!important;color:#fff!important}
.admin-review-action.review-action-approved{background:#28a862!important;color:#fff!important}
.admin-review-action.review-action-rejected{background:#d9534f!important;color:#fff!important}
.admin-review-action.review-action-suspended{background:#d97706!important;color:#fff!important}
.admin-sms-stat{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;flex-wrap:wrap}
.admin-sms-stat__count{font-weight:700;color:#148794}
.admin-sms-stat__count.is-limit{color:#c84a3c}
.admin-sms-stat__hint{padding:3rpx 10rpx;border-radius:999rpx;background:#fff1ee;color:#c84a3c;font-size:22rpx;line-height:32rpx}
.admin-record-identity{display:flex;flex-direction:column;align-items:flex-end;gap:6rpx;max-width:72%;font-size:23rpx;line-height:1.45;text-align:right;word-break:break-all}

/* 手机号查看：复用 ColorUI modal 与图标，业务层只补排版和品牌语义。 */
.phone-reveal-modal .phone-reveal-dialog{
  width:calc(100% - 88rpx);
  max-width:620rpx;
  overflow:hidden;
  border-radius:28rpx;
  background:#fff;
  color:#233238;
  box-shadow:0 26rpx 70rpx rgba(18,55,61,.18);
}
.phone-reveal-head{
  position:relative;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  padding:34rpx 34rpx 18rpx;
}
.phone-reveal-title{margin-left:-6rpx;font-size:34rpx;font-weight:700;line-height:1.35}
.phone-reveal-subtitle{margin-top:6rpx;color:#8a999d;font-size:23rpx;line-height:1.45}
.phone-reveal-close{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:none;
  width:68rpx;
  height:68rpx;
  margin:-10rpx -10rpx 0 20rpx;
  border-radius:50%;
  color:#738084;
  font-size:30rpx;
  background:#f3f7f8;
}
.phone-reveal-body{padding:12rpx 34rpx 28rpx}
.phone-reveal-label{color:#859499;font-size:23rpx;line-height:1.4}
.phone-reveal-number{
  margin-top:8rpx;
  color:#17282d;
  font-size:52rpx;
  font-weight:700;
  letter-spacing:3rpx;
  line-height:1.35;
  word-break:break-all;
}
.phone-reveal-notice{
  display:flex;
  align-items:flex-start;
  gap:12rpx;
  margin-top:24rpx;
  padding:18rpx 20rpx;
  border-radius:16rpx;
  color:#66777b;
  font-size:23rpx;
  line-height:1.55;
  background:#f4f8f9;
}
.phone-reveal-notice .cuIcon-safe{flex:none;margin-top:2rpx;color:#00aebd;font-size:27rpx}
.phone-reveal-actions{
  display:flex;
  gap:18rpx;
  padding:0 34rpx 34rpx;
}
.phone-reveal-action{
  display:flex!important;
  align-items:center;
  justify-content:center;
  gap:10rpx;
  flex:1;
  height:88rpx;
  margin:0!important;
  border-radius:18rpx!important;
  font-size:27rpx!important;
  font-weight:600;
}
.phone-reveal-action::after{border:0!important}
.phone-reveal-action--secondary{
  color:#168c99!important;
  background:#eef9fa!important;
}
.phone-reveal-action--primary{
  color:#fff!important;
  background:#00aebd!important;
  box-shadow:0 10rpx 24rpx rgba(0,174,189,.20);
}

@media (prefers-color-scheme: dark) {
  .phone-reveal-modal .phone-reveal-dialog{
    color:#e7f0f1;
    background:#192629;
    box-shadow:0 28rpx 72rpx rgba(0,0,0,.42);
  }
  .phone-reveal-title,.phone-reveal-number{color:#e7f0f1}
  .phone-reveal-subtitle,.phone-reveal-label{color:#9fb1b5}
  .phone-reveal-close{color:#c7d5d7;background:#243438}
  .phone-reveal-notice{color:#b5c5c8;background:#162225}
  .phone-reveal-action--secondary{color:#78d9e2!important;background:#203437!important}
  .phone-reveal-action--primary{color:#fff!important;background:#00aebd!important}
}


/* V2.5.0 师傅详情评价分页 */
.worker-detail-tabs{position:sticky;top:0;z-index:30;display:flex;height:86rpx;background:#fff;border-bottom:1rpx solid #edf1f2}.worker-detail-tab{position:relative;display:flex;align-items:center;justify-content:center;flex:1;color:#7b898d;font-size:27rpx;font-weight:600}.worker-detail-tab.active{color:#00a5b5}.worker-detail-tab.active:after{content:'';position:absolute;left:34%;right:34%;bottom:0;height:5rpx;border-radius:5rpx;background:#00b9cb}.worker-detail-pane,.worker-reviews-pane{min-height:calc(100vh - 86rpx)}.worker-reviews-pane{padding:22rpx 24rpx 48rpx;background:#f3f6f7}.worker-rating-summary{display:flex;gap:18rpx;padding:28rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(33,70,77,.06)}.worker-rating-overall{display:flex;flex-direction:column;align-items:center;justify-content:center;width:210rpx;border-right:1rpx solid #edf1f2}.worker-rating-overall strong{color:#e58820;font-size:64rpx;line-height:1}.worker-rating-overall text{margin-top:10rpx;color:#34474c;font-size:25rpx;font-weight:700}.worker-rating-overall small{margin-top:6rpx;color:#99a4a7;font-size:20rpx}.worker-rating-dimensions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;flex:1}.worker-rating-dimensions>view{display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:16rpx;background:#f7f9fa}.worker-rating-dimensions text{color:#69797d;font-size:22rpx}.worker-rating-dimensions strong{margin-top:4rpx;color:#00a5b5;font-size:36rpx}.worker-rating-dimensions small{margin-top:3rpx;color:#a0abad;font-size:18rpx}.worker-review-list{margin-top:18rpx}.worker-review-item{margin-bottom:16rpx;padding:24rpx 26rpx;border-radius:20rpx;background:#fff}.worker-review-meta{display:flex;align-items:center;justify-content:space-between;color:#9aa5a8;font-size:20rpx}.worker-reviewer{color:#405358;font-size:25rpx;font-weight:650}.worker-review-scores{display:flex;gap:20rpx;margin-top:14rpx;color:#758589;font-size:21rpx}.worker-review-scores strong{color:#e58a23}.worker-review-content{margin-top:15rpx;color:#34474c;font-size:26rpx;line-height:1.65;word-break:break-all}.worker-review-order{display:flex;align-items:center;gap:10rpx;margin-top:14rpx;color:#9aa5a8;font-size:19rpx}.worker-review-auto{padding:3rpx 9rpx;border-radius:8rpx;background:#f1f3f4;color:#7a878a}.worker-review-empty,.worker-review-loading{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:110rpx 20rpx;color:#94a0a3}.worker-review-empty>text{font-size:68rpx}.worker-review-empty>view{margin-top:18rpx;color:#53666b;font-size:27rpx;font-weight:650}.worker-review-empty small{margin-top:8rpx;font-size:21rpx}.worker-review-loading{flex-direction:row;gap:10rpx}.worker-review-more{padding:20rpx;text-align:center;color:#00a5b5;font-size:23rpx}@media (prefers-color-scheme:dark){.worker-detail-tabs,.worker-rating-summary,.worker-review-item{background:var(--lightGray)}.worker-detail-tabs{border-color:var(--darkDisable)}.worker-reviews-pane{background:var(--darkBlack)}.worker-rating-overall{border-color:var(--darkDisable)}.worker-rating-overall text,.worker-reviewer,.worker-review-content,.worker-review-empty>view{color:var(--darkTitle)}.worker-rating-dimensions>view{background:#162225}.worker-rating-dimensions text,.worker-rating-overall small,.worker-review-meta,.worker-review-order,.worker-review-empty,.worker-review-loading{color:var(--darkSecondaryText)}}
