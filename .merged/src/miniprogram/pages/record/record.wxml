<!-- 2026-08-31：师傅入驻页只保留师傅档案、审核入口和微信审核二维码；门店资料移至商家认证。 -->
<view class="onboard-page">
  <view class="adaptive-nav {{navSolid ? 'solid' : ''}}" style="height:{{navTotalHeight}}px;padding-top:{{statusBarHeight}}px;">
    <view class="nav-inner" style="height:{{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack"><text class="cuIcon-back"></text></view>
      <view class="nav-title">师傅入驻</view>
    </view>
  </view>

  <view class="onboard-hero" style="padding-top:{{navTotalHeight + 18}}px;">
    <view class="hero-glow hero-glow-one"></view><view class="hero-glow hero-glow-two"></view>
    <view class="hero-main">
      <view class="hero-icon"><text class="cuIcon-repairfill"></text></view>
      <view class="hero-copy"><text class="hero-kicker">专业施工服务</text><text class="hero-title">师傅入驻</text><text class="hero-subtitle">提交资料并通过平台审核后，即可参与报价接单</text></view>
    </view>
    <view class="process-row">
      <view class="process-item {{processStep === 1 ? 'active' : (processStep > 1 ? 'completed' : '')}}"><text>1</text><view>提交资料</view></view>
      <view class="process-line {{processStep > 1 ? 'completed' : ''}}"></view>
      <view class="process-item {{processStep === 2 ? 'active' : (processStep > 2 ? 'completed' : '')}}"><text>2</text><view>平台审核</view></view>
      <view class="process-line {{processStep > 2 ? 'completed' : ''}}"></view>
      <view class="process-item {{processStep === 3 ? 'active' : ''}}"><text>3</text><view>报价接单</view></view>
    </view>
  </view>

  <subscription-health-banner audience="worker_application" review-pending="{{reviewPending}}"></subscription-health-banner>

  <view class="profile-card">
    <view class="section-head"><view><text class="section-title">我的入驻资料</text><text class="section-subtitle">已有资料可修改后重新提交审核</text></view><text class="single-tag">{{dataList.length > 1 ? '含历史资料' : '一人一档'}}</text></view>
    <view wx:if="{{loading}}" class="profile-loading"><text class="cuIcon-loading2 spin"></text><text>正在读取资料</text></view>
    <block wx:elif="{{dataList.length}}">
      <view class="profile-item" wx:for="{{dataList}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDetail">
        <view class="profile-avatar"><text class="cuIcon-peoplefill"></text></view>
        <view class="profile-content">
          <view class="profile-name-row"><text class="profile-name">{{item.workerName || '待完善姓名'}}</text><text class="profile-status {{item.statusClass}}">{{item.statusText}}</text></view>
          <text class="profile-type">{{item.workerType || '施工师傅'}}</text><text wx:if="{{item.reviewReason && (item.statusClass === 'rejected' || item.statusClass === 'suspended')}}" class="profile-reason">处理说明：{{item.reviewReason}}</text><text class="profile-time">最近提交 {{item.time || '暂无时间'}}</text>
        </view>
        <text class="cuIcon-right profile-arrow"></text>
      </view>
    </block>
    <view wx:else class="profile-empty"><view class="empty-icon"><text class="cuIcon-profile"></text></view><text class="empty-title">尚未提交师傅资料</text><text class="empty-copy">填写施工类型、服务地区和师傅照片后提交审核</text></view>
    <button class="profile-action cu-btn" bindtap="goPlus"><text class="cuIcon-edit"></text>{{dataList.length ? '修改入驻资料' : '立即申请入驻'}}</button>
  </view>

  <view class="wechat-card">
    <view class="wechat-head">
      <view class="wechat-title-icon"><text class="cuIcon-weixin"></text></view>
      <view class="wechat-copy"><text class="wechat-title">加微信审核</text><text class="wechat-subtitle">提交资料后添加审核微信，方便核对资料与反馈结果</text></view><text class="wechat-badge">人工审核</text>
    </view>
    <view class="qr-shell" bindtap="previewQrCode"><image show-menu-by-longpress="{{true}}" src="{{qrCodeUrl}}" mode="widthFix"></image><view class="qr-corners"><view></view><view></view><view></view><view></view></view></view>
    <view class="qr-tip"><text class="cuIcon-scan"></text>点击放大，或长按二维码识别/保存</view>
  </view>
  <view class="privacy-tip"><text class="cuIcon-safe"></text>入驻资料仅用于平台审核和接单服务</view>
</view>

<!-- 2026-08-08：发布后订阅失效时提示重新开启审核结果通知。 -->
<view class="cu-modal {{showReviewSubscribeModal ? 'show' : ''}}"><view class="cu-dialog subscribe-dialog"><view class="cu-bar bg-white justify-end"><view class="content">审核结果通知</view><view class="action" catchtap="closeReviewSubscribeModal"><text class="cuIcon-close text-grey"></text></view></view><view class="padding-xl subscribe-dialog-copy">为及时收到师傅入驻审核结果，请重新开启一次订阅通知。</view><view class="cu-bar bg-white"><view class="action margin-0 flex-sub text-grey solid-left" catchtap="closeReviewSubscribeModal">暂不开启</view><view class="action margin-0 flex-sub text-green solid-left" catchtap="renewReviewSubscription">重新订阅</view></view></view></view>
