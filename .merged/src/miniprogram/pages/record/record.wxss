/* 2026-08-31：师傅入驻采用绿色专业服务主题，页面只保留入驻档案与微信审核。 */
page{background:#f2f6f4;color:#17352b}.onboard-page{box-sizing:border-box;min-height:100vh;padding:0 24rpx calc(70rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#eaf7f1 0,#f2f6f4 420rpx)}
.adaptive-nav{position:fixed;left:0;right:0;top:0;z-index:40;box-sizing:border-box;color:#fff;transition:background .2s ease,color .2s ease,box-shadow .2s ease;pointer-events:none}.nav-inner{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;pointer-events:auto}.nav-back{position:absolute;left:22rpx;display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;background:rgba(7,62,44,.24);color:#fff;font-size:34rpx;backdrop-filter:blur(10px)}.nav-title{font-size:31rpx;font-weight:700;opacity:0;transform:translateY(-6rpx);transition:opacity .18s ease,transform .18s ease}.adaptive-nav.solid{background:rgba(255,255,255,.96);color:#17352b;box-shadow:0 1rpx 0 rgba(24,69,54,.08);backdrop-filter:blur(18px)}.adaptive-nav.solid .nav-back{background:transparent;color:#17352b}.adaptive-nav.solid .nav-title{opacity:1;transform:translateY(0)}
.onboard-hero{position:relative;overflow:hidden;margin:0 -24rpx;padding:34rpx 54rpx 31rpx;border-radius:0 0 34rpx 34rpx;background:linear-gradient(138deg,#146e50 0,#15966a 58%,#24b27b 100%);color:#fff;box-shadow:0 20rpx 48rpx rgba(18,117,82,.24)}.hero-glow{position:absolute;border-radius:50%;background:rgba(255,255,255,.09)}.hero-glow-one{top:-80rpx;right:-42rpx;width:230rpx;height:230rpx}.hero-glow-two{right:112rpx;bottom:-110rpx;width:190rpx;height:190rpx}.hero-main{position:relative;z-index:1;display:flex;align-items:center}.hero-icon{display:flex;flex:none;align-items:center;justify-content:center;width:98rpx;height:98rpx;border:1rpx solid rgba(255,255,255,.32);border-radius:28rpx;background:rgba(255,255,255,.14);font-size:54rpx;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.22)}.hero-copy{min-width:0;margin-left:24rpx}.hero-kicker,.hero-title,.hero-subtitle{display:block}.hero-kicker{font-size:18rpx;letter-spacing:3rpx;opacity:.7}.hero-title{margin-top:5rpx;font-size:43rpx;font-weight:800;letter-spacing:2rpx}.hero-subtitle{margin-top:8rpx;font-size:22rpx;line-height:1.55;opacity:.86}.process-row{position:relative;z-index:1;display:flex;align-items:flex-start;margin-top:32rpx;padding-top:25rpx;border-top:1rpx solid rgba(255,255,255,.19)}.process-item{width:106rpx;color:rgba(255,255,255,.67);font-size:20rpx;text-align:center}.process-item text{display:block;width:38rpx;height:38rpx;margin:0 auto 7rpx;border:1rpx solid rgba(255,255,255,.4);border-radius:50%;line-height:38rpx;box-sizing:border-box}.process-item.active{color:#fff;font-weight:600}.process-item.active text{border-color:#fff;background:#fff;color:#16845e;font-weight:700}.process-item.completed{color:rgba(255,255,255,.86);font-weight:500}.process-item.completed text{border-color:rgba(255,255,255,.72);background:rgba(255,255,255,.24);color:#fff;font-weight:600}.process-line{flex:1;height:1rpx;margin:19rpx 2rpx 0;background:rgba(255,255,255,.28)}.process-line.completed{background:rgba(255,255,255,.58)}
.profile-card,.wechat-card{margin-top:22rpx;padding:28rpx;border:1rpx solid rgba(18,86,63,.05);border-radius:26rpx;background:#fff;box-shadow:0 10rpx 34rpx rgba(22,69,53,.07)}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.section-title,.section-subtitle{display:block}.section-title{font-size:31rpx;font-weight:800;color:#193b30}.section-subtitle{margin-top:7rpx;color:#86968f;font-size:21rpx}.single-tag{flex:none;padding:7rpx 15rpx;border-radius:20rpx;background:#e7f7ef;color:#168158;font-size:20rpx}.profile-loading{display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:190rpx;color:#83948d;font-size:23rpx}.spin{display:inline-block;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.profile-item{display:flex;align-items:center;margin-top:24rpx;padding:22rpx 0;border-top:1rpx solid #edf2ef}.profile-item+.profile-item{margin-top:0}.profile-avatar{display:flex;flex:none;align-items:center;justify-content:center;width:84rpx;height:84rpx;border-radius:24rpx;background:linear-gradient(145deg,#e2f7ed,#c9eddd);color:#14855e;font-size:43rpx}.profile-content{min-width:0;flex:1;margin-left:20rpx}.profile-name-row{display:flex;align-items:center;gap:12rpx}.profile-name{max-width:260rpx;overflow:hidden;color:#213b32;font-size:29rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.profile-status{padding:5rpx 11rpx;border-radius:15rpx;background:#fff2dd;color:#b46e0b;font-size:19rpx}.profile-status.approved{background:#e4f7ed;color:#16855c}.profile-status.rejected,.profile-status.suspended{background:#ffebe7;color:#c4523e}.profile-status.draft{background:#eef1f0;color:#718079}.profile-type,.profile-time{display:block;margin-top:6rpx;color:#667a72;font-size:22rpx}.profile-time{color:#9aa6a1;font-size:19rpx}.profile-arrow{flex:none;color:#abb6b1;font-size:28rpx}.profile-empty{display:flex;min-height:245rpx;flex-direction:column;align-items:center;justify-content:center;text-align:center}.empty-icon{display:flex;align-items:center;justify-content:center;width:105rpx;height:105rpx;border-radius:35rpx;background:#ecf7f2;color:#54a887;font-size:52rpx}.empty-title{margin-top:19rpx;color:#304a40;font-size:27rpx;font-weight:700}.empty-copy{max-width:470rpx;margin-top:8rpx;color:#98a49f;font-size:21rpx;line-height:1.55}.profile-action{display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;height:82rpx!important;margin:22rpx 0 0!important;border-radius:22rpx!important;background:linear-gradient(90deg,#16845e,#21a673)!important;color:#fff!important;font-size:27rpx!important;font-weight:700!important;box-shadow:0 12rpx 25rpx rgba(22,132,94,.18)}.profile-action:after{border:0!important}.profile-action text{margin-right:10rpx;font-size:31rpx}
.wechat-head{display:flex;align-items:center}.wechat-title-icon{display:flex;flex:none;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:24rpx;background:#e5f8ed;color:#18a45f;font-size:42rpx}.wechat-copy{min-width:0;flex:1;margin-left:18rpx}.wechat-title,.wechat-subtitle{display:block}.wechat-title{font-size:30rpx;font-weight:800;color:#1f3e33}.wechat-subtitle{margin-top:6rpx;color:#84938d;font-size:20rpx;line-height:1.5}.wechat-badge{flex:none;margin-left:12rpx;padding:6rpx 12rpx;border-radius:17rpx;background:#edf8f3;color:#25845f;font-size:19rpx}.qr-shell{position:relative;width:470rpx;max-width:100%;margin:28rpx auto 0;padding:22rpx;border:1rpx solid #dfebe5;border-radius:25rpx;background:#fbfdfc;box-shadow:inset 0 0 0 9rpx #f4f9f6}.qr-shell image{display:block;width:100%;border-radius:13rpx}.qr-corners>view{position:absolute;width:29rpx;height:29rpx;border-color:#20a16f}.qr-corners>view:nth-child(1){top:11rpx;left:11rpx;border-top:4rpx solid;border-left:4rpx solid}.qr-corners>view:nth-child(2){top:11rpx;right:11rpx;border-top:4rpx solid;border-right:4rpx solid}.qr-corners>view:nth-child(3){bottom:11rpx;left:11rpx;border-bottom:4rpx solid;border-left:4rpx solid}.qr-corners>view:nth-child(4){right:11rpx;bottom:11rpx;border-right:4rpx solid;border-bottom:4rpx solid}.qr-tip{margin-top:20rpx;color:#7c8e87;font-size:21rpx;text-align:center}.qr-tip text{margin-right:7rpx;color:#20956a}.privacy-tip{margin-top:26rpx;color:#91a099;font-size:20rpx;text-align:center}.privacy-tip text{margin-right:7rpx;color:#57a889}.subscribe-dialog{overflow:hidden;border-radius:24rpx}.subscribe-dialog-copy{background:#f1f7f4;color:#29493e;line-height:1.7;text-align:left}
@media (prefers-color-scheme:dark){page{background:#101a16;color:#e8f1ed}.onboard-page{background:linear-gradient(180deg,#12271f 0,#101a16 420rpx)}.adaptive-nav.solid{background:rgba(16,26,22,.96);color:#e8f1ed;box-shadow:0 1rpx 0 #294238}.adaptive-nav.solid .nav-back{color:#e8f1ed}.profile-card,.wechat-card{border-color:#294238;background:#192720;box-shadow:none}.section-title,.profile-name,.empty-title,.wechat-title{color:#e8f2ee}.section-subtitle,.profile-type,.wechat-subtitle,.qr-tip,.privacy-tip{color:#91a49b}.profile-item{border-color:#2b3d35}.qr-shell{border-color:#304b3f;background:#14201b;box-shadow:inset 0 0 0 9rpx #1d2d26}.subscribe-dialog-copy{background:#1c2a24;color:#dce9e3}}
.profile-reason{display:block;margin-top:6rpx;color:#d05a45;font-size:23rpx;line-height:1.45;word-break:break-all}