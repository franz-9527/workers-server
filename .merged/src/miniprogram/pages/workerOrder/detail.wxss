@media (prefers-color-scheme:dark){.quote-field>text{color:#c5d3d5}.quote-field input,.quote-field textarea{border-color:#3a4c4f;background:#1c282a;color:#e4eeee}.quote-field input::placeholder,.quote-field textarea::placeholder{color:#829396}}

