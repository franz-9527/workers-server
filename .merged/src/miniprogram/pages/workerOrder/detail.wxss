.grab-mode-notice,.grab-pending-notice{border-left:6rpx solid #e7a23a!important;background:#fff8e9!important;color:#795521!important}.grab-mode-notice>text:first-child,.grab-pending-notice>text:first-child{margin-right:8rpx;color:#d98919}.grab-action-panel{border-top:5rpx solid rgba(231,162,58,.68)}.grab-action-panel .bg-orange{background:#e7a23a!important}@media(prefers-color-scheme:dark){.grab-mode-notice,.grab-pending-notice{background:#362d1e!important;color:#e6c28a!important;border-color:#bd8030!important}.grab-action-panel{border-top-color:#9d6d2e}}
