x}.thumb-row{display:flex;flex-wrap:wrap;margin-top:16rpx}.thumb-row image{width:138rpx;height:138rpx;border-radius:12rpx;margin:0 12rpx 12rpx 0}.completion-textarea,.modal-body textarea{box-sizing:border-box;width:100%;height:150rpx;background:#f4f7f8;border-radius:14rpx;padding:20rpx;margin-top:18rpx}.safe-bottom{height:150rpx}.bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;align-items:center;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));box-shadow:0 -10rpx 35rpx rgba(25,50,56,.09)}.bottom-icon{background:transparent!important;font-size:22rpx;line-height:1.3;margin:0 18rpx;padding:0;color:#52666b}.bottom-icon:after{border:0}.bottom-icon text{font-size:40rpx;color:#00aabd}.bottom-bar>.cu-btn{height:76rpx;margin-left:12rpx}.bottom-modal .cu-dialog{border-radius:24rpx 24rpx 0 0}.modal-body{padding:26rpx 30rpx calc(34rpx + env(safe-area-inset-bottom))}.quote-reminder{padding:18rpx;background:#fff8e8;border-radius:12rpx;color:#8d6428}.amount-input{margin-top:22rpx;padding:18rpx 12rpx;border-bottom:2rpx solid #00b9cb}.amount-input input{font-size:44rpx;height:70rpx;margin-left:16rpx;flex:1}.picker-row{gap:18rpx}.picker-row picker{flex:1}.picker-box{background:#f4f7f8;border-radius:12rpx;padding:22rpx;text-align:center}.arrival-tags .cu-tag{margin-right:16rpx}

