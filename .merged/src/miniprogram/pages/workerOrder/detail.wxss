/* 2026-08-28：加价状态使用固定语义色，用户拒绝结果保持醒目且不与尾款延期混淆。 */
.fee-change-panel{border-top:7rpx solid #f0a23b}.fee-change-item{padding:22rpx 0;border-bottom:1rpx solid #edf1f2}.fee-change-item:last-child{padding-bottom:0;border-bottom:0}.fee-change-reason{margin:15rpx 0;padding:17rpx;border-radius:12rpx;background:#f7f9fa;color:#586c71;line-height:1.6}.change-status{flex:none;margin-left:14rpx;padding:5rpx 13rpx;border-radius:18rpx;font-size:21rpx}.change-status.pending{background:#fff1d8;color:#b66c00}.change-status.accepted{background:#e7f8f0;color:#19885a}.change-status.rejected{background:#ffeded;color:#cf4841}.change-result{margin-top:14rpx;padding:16rpx 18rpx;border-radius:12rpx;font-size:22rpx;line-height:1.6}.change-result.rejected{background:#fff0ef;color:#b94742}.change-result.accepted{background:#eaf8f2;color:#1c8059}.change-result>text{margin-right:7rpx}
