.detail-page .notice.quote-paused{background:#fff4e5;color:#8d5c1b;border-left:6rpx solid #e8a23d}.after-sales-item{padding:20rpx 0;border-bottom:1rpx solid #edf1f2}.after-sales-item:last-child{border-bottom:0;padding-bottom:0}.after-sales-status{flex:none;padding:6rpx 14rpx;border-radius:18rpx;background:#fff4df;color:#a56a10;font-size:21rpx}.after-sales-status.resolved,.after-sales-status.closed{background:#e9f8f1;color:#168254}.after-sales-status.rejected{background:#fff0ef;color:#bc4942}.after-sales-resolution{margin-top:14rpx;padding:16rpx;border-radius:12rpx;background:#eaf8f2;color:#237452;line-height:1.6}
