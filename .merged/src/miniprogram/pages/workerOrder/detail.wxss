.fulfillment-title{display:flex;align-items:center;justify-content:space-between}.stage-status{padding:6rpx 14rpx;border-radius:18rpx;background:#e9fbfd;color:#008b99;font-size:21rpx;font-weight:500}.work-stage-card{margin-top:18rpx;padding:20rpx;border:1rpx solid #e6eef0;border-radius:18rpx;background:#fbfdfd}.work-stage-card.is-done{background:#f5fbf8;border-color:#dcefe4}.work-stage-head{display:flex;align-items:center;gap:16rpx}.work-stage-index{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;flex:none;border-radius:16rpx;background:#eaf8fa;color:#0098a7;font-size:28rpx}.work-stage-card.is-done .work-stage-index{background:#e5f6ed;color:#1d9b67}.work-stage-main{min-width:0;flex:1}.work-stage-title{font-weight:700;color:#243a3f}.work-stage-summary{margin-top:6rpx;color:#7a8c90;font-size:22rpx;line-height:1.5}.work-stage-note{margin:14rpx 0 0 70rpx;padding:12rpx 16rpx;border-radius:12rpx;background:#f2f6f7;color:#64777b;font-size:22rpx}.stage-mini-action{flex:none!important;width:auto!important;min-width:104rpx!important;height:58rpx!important;min-height:58rpx!important;margin:0!important;padding:0 18rpx!important;border-radius:30rpx!important;background:#fff!important;color:#0096a5!important;font-size:22rpx!important;line-height:58rpx!important;box-shadow:inset 0 0 0 1rpx #bfe7eb!important}.stage-mini-action:after{border:0!important}.stage-mini-action.warning{color:#b9781f!important;box-shadow:inset 0 0 0 1rpx #f0d59f!important}.optional-tag{margin-left:8rpx;color:#94a3a6;font-size:20rpx;font-weight:400}.completion-editor{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #edf2f3}.completion-upload-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.submit-completion-btn{margin-top:20rpx!important}.stage-done-mark{flex:none;color:#239465;font-size:22rpx}.stage-done-mark>text{margin-right:6rpx}.compact-thumbs{margin-left:70rpx}.compact-thumbs image{width:104rpx;height:104rpx}.exception-entry{display:flex!important;align-items:center!important;justify-content:flex-start!important;width:100%!important;height:68rpx!important;min-height:68rpx!important;margin:18rpx 0 0!important;padding:0 18rpx!important;border-radius:14rpx!important;background:#fffaf1!important;color:#9b6a25!important;font-size:22rpx!important;line-height:68rpx!important;text-align:left!important}.exception-entry:after{border:0!important}.exception-entry>text:first-child{margin-right:10rpx}.exception-entry>text:last-child{margin-left:auto}.repair-priority-notice{font-weight:600;border-left:6rpx solid #f09b31}

