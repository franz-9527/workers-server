/* 2026年8月4日 17:22:23 居住地址页面布局 */
.address-page {
  min-height: 100vh;
  padding-top: 30rpx;
}

.address-card {
  margin: 0 30rpx;
  padding: 40rpx;
  border-radius: 24rpx;
}

.address-description {
  font-size: 32rpx;
  line-height: 1.7;
}

.address-row {
  display: flex;
  align-items: center;
  min-height: 150rpx;
  margin-top: 40rpx;
}

.address-label {
  flex: 0 0 180rpx;
  font-size: 36rpx;
}

.address-value {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
  font-size: 34rpx;
  font-weight: bold;
  text-align: right;
  word-break: break-all;
}

.location-bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx 50rpx calc(30rpx + env(safe-area-inset-bottom));
}
