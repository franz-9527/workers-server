/* 商家认证：沉浸式全屏 Hero，返回按钮直接融入头部，不再额外叠一条导航栏。 */
page{background:#f7f4ef}
.merchant-shell,.merchant-page,.merchant-loading-page{min-height:100vh}
.merchant-page{padding:0 0 80rpx;color:#382f27}
.merchant-hero{position:relative;padding:0 30rpx 32rpx;border-radius:0 0 34rpx 34rpx;background:linear-gradient(145deg,#ffb45f 0%,#f58b37 55%,#e96d25 100%);color:#fff;box-shadow:0 16rpx 38rpx rgba(194,91,25,.20);overflow:hidden}
.merchant-hero:after{content:"";position:absolute;right:-70rpx;top:60rpx;width:250rpx;height:250rpx;border-radius:50%;background:rgba(255,255,255,.09);pointer-events:none}
.merchant-hero-main{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:10rpx 4rpx 0}.merchant-hero-copy{display:flex;align-items:center;gap:18rpx;min-width:0;flex:1}.merchant-hero-copy>text{font-size:58rpx;flex:none}.merchant-hero small,.merchant-hero strong{display:block}.merchant-hero small{font-size:22rpx;opacity:.82}.merchant-hero strong{margin-top:5rpx;font-size:38rpx}.status{flex:none;padding:8rpx 17rpx;border-radius:24rpx;background:rgba(255,255,255,.18);border:1rpx solid rgba(255,255,255,.14);font-size:22rpx;backdrop-filter:blur(8px)}
.hero-note{position:relative;z-index:1;margin-top:25rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.24);font-size:23rpx;line-height:1.6}
.merchant-content{padding-top:4rpx}
.risk-card,.card,.rule-card{margin:20rpx 24rpx 0;padding:26rpx;border-radius:22rpx;background:#fff;box-shadow:0 7rpx 23rpx rgba(95,66,35,.06)}.risk-card{display:flex;align-items:center;justify-content:space-between}.risk-card>view:first-child{display:flex;align-items:center;gap:17rpx}.risk-card>view>text{font-size:42rpx;color:#ed8732}.risk-card strong,.risk-card small{display:block}.risk-card small{margin-top:7rpx;color:#9b8c7e;font-size:21rpx}.risk-card>text{padding:7rpx 13rpx;border-radius:20rpx;background:#fff2e4;color:#be691e;font-size:21rpx}.review-reason{margin:20rpx 24rpx 0;padding:20rpx;border-radius:17rpx;background:#fff1ea;color:#b94c32}.review-reason text{margin-right:8rpx}.card-title{font-size:31rpx;font-weight:700;margin-bottom:20rpx}.license-box{position:relative;height:330rpx;border:2rpx dashed #e8a15f;border-radius:20rpx;background:#fff9f2;overflow:hidden}.license-box image{width:100%;height:100%}.license-box>view{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#c5742d}.license-box>view>text{font-size:72rpx}.license-box strong,.license-box small{margin-top:12rpx}.license-box small{color:#a99583;font-size:22rpx}.change-license{display:block;margin:20rpx auto 0!important}.field{display:flex;align-items:center;min-height:96rpx;border-bottom:1rpx solid #f0e9e2}.field>text{width:210rpx;flex:none;color:#65594e}.field input{flex:1;text-align:right}.textarea-field{display:block;padding:24rpx 0}.textarea-field textarea{box-sizing:border-box;width:100%;height:150rpx;margin-top:15rpx;padding:18rpx;border-radius:14rpx;background:#faf7f3}.rule-card{color:#80664f;line-height:1.8;font-size:23rpx}.rule-card strong{display:block;margin-bottom:9rpx;color:#4a3828;font-size:28rpx}.submit{display:block;width:calc(100% - 48rpx);height:88rpx;margin:28rpx 24rpx 0!important;border-radius:44rpx!important;background:linear-gradient(90deg,#ffad4d,#f17b2e)!important;color:#fff!important;font-size:29rpx!important}.loading{text-align:center;padding-top:210rpx;color:#8c7c6d}.spin{display:inline-block;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-color-scheme:dark){page{background:#17120e}.merchant-page{color:#f5eee7}.risk-card,.card,.rule-card{background:#261e18}.field{border-color:#3b3028}.field input,.textarea-field textarea{color:#fff}.textarea-field textarea{background:#1b1511}.license-box{background:#2b2119}.rule-card strong{color:#f6e8db}.risk-card small{color:#b8a99b}.merchant-hero{background:linear-gradient(145deg,#6f3d1c 0%,#5a3019 58%,#432218 100%);box-shadow:none}}
.legacy-help{margin:-4rpx 0 14rpx;color:#9b8877;font-size:21rpx;line-height:1.55}.legacy-store-item{display:flex;align-items:center;padding:20rpx 0;border-top:1rpx solid #f0e7df}.legacy-icon{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:21rpx;background:#fff1e3;color:#e67c28;font-size:36rpx}.legacy-copy{min-width:0;flex:1;margin-left:17rpx}.legacy-copy strong,.legacy-copy small{display:block}.legacy-copy strong{overflow:hidden;color:#503c2c;font-size:26rpx;text-overflow:ellipsis;white-space:nowrap}.legacy-copy small{margin-top:6rpx;color:#a28f7e;font-size:20rpx}.legacy-store-item>.cuIcon-right{color:#b5a597}@media (prefers-color-scheme:dark){.legacy-store-item{border-color:#3b3028}.legacy-copy strong{color:#f2e6dc}.legacy-help,.legacy-copy small{color:#a99788}.legacy-icon{background:#3a291d}}
.submit-wrap{box-sizing:border-box;width:100%;padding:0 24rpx;margin-top:28rpx}.submit-wrap .submit{box-sizing:border-box;width:100%;margin:0!important;display:flex!important;align-items:center;justify-content:center}.form-submit-wrap{margin-top:22rpx;padding-top:22rpx;border-top:1rpx solid #f0e9e2}.form-submit-wrap .submit{box-sizing:border-box;width:100%;margin:0!important;display:flex!important;align-items:center;justify-content:center}
.card-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-bottom:20rpx}.card-title-row .card-title{margin-bottom:0}.ocr-help{margin-top:9rpx;color:#9b8877;font-size:21rpx;line-height:1.55}.ocr-source{flex:none;padding:7rpx 13rpx;border-radius:18rpx;background:#fff1e3;color:#d06d20;font-size:20rpx}.ocr-badge{position:absolute;right:16rpx;top:16rpx;padding:8rpx 14rpx;border-radius:22rpx;background:rgba(211,103,28,.92);color:#fff;font-size:21rpx}.ocr-badge text{margin-right:5rpx}.ocr-result{margin-top:18rpx;padding:8rpx 18rpx;border-radius:15rpx;background:#fff8f0}.ocr-result>view{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:12rpx 0}.ocr-result text{color:#8e7967;font-size:21rpx}.ocr-result strong{max-width:62%;text-align:right;word-break:break-all;color:#5a4230;font-size:23rpx}.form-tip{margin:-4rpx 0 8rpx;color:#947b67;font-size:21rpx;line-height:1.55}.form-tip text{margin-right:7rpx}@media (prefers-color-scheme:dark){.ocr-help,.form-tip{color:#b19c8a}.ocr-source{background:#3a291d;color:#f0a15f}.ocr-result{background:#211812}.ocr-result text{color:#aa9686}.ocr-result strong{color:#f1e2d5}.form-submit-wrap{border-color:#3b3028}}

/* 商家资料长名称不挤出表单；禁用、提示与审核原因沿用深色表面。 */
.merchant-page .field{gap:18rpx}
.merchant-page .field input{min-width:0}
.merchant-page .merchant-placeholder{color:#806c5b}
.merchant-page .form-submit-wrap .submit{line-height:1.45;padding:16rpx 24rpx;min-height:88rpx;height:auto}
@media (prefers-color-scheme:dark){
  .merchant-page .field>text,.merchant-page .rule-card{color:#c7b5a5}
  .merchant-page .merchant-placeholder,.merchant-loading-page .loading{color:#b8a99b}
  .merchant-page .review-reason{background:#3b2520;color:#ffb5a4}
  .merchant-page .license-box>view{color:#efb47f}
  .merchant-page .license-box small{color:#c7b5a5}
  .merchant-page .risk-card>text{background:#3a291d;color:#f0b879}
}
