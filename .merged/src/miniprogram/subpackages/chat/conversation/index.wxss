.conversation-page .send-button{min-height:88rpx;padding:18rpx 22rpx;line-height:44rpx;border-radius:10rpx;background:#007381;color:#fff;font-size:28rpx}
.conversation-page .voice-hold{flex:1;min-width:0;margin:0;min-height:88rpx;padding:16rpx 12rpx;line-height:48rpx;font-size:30rpx;background:#fff;border-radius:10rpx;color:#202526;font-weight:600}
.conversation-page .voice-hold::after{border:0}.conversation-page .voice-hold.is-recording{background:#d1edf1}
.conversation-page .recording-tip{font-size:22rpx;color:#667075;text-align:center;padding:6rpx 0}
.conversation-page .chat-tools{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18rpx 12rpx;padding:28rpx 8rpx 18rpx;border-top:1rpx solid #e1e3e3;margin-top:10rpx}
.conversation-page .chat-tool{background:transparent;margin:0;padding:8rpx 0;color:#59656b;font-size:24rpx;line-height:1.5;min-height:148rpx;display:flex;flex-direction:column;align-items:center;gap:12rpx}
.conversation-page .chat-tool::after{border:0}.conversation-page .chat-tool-icon{height:100rpx;width:100rpx;border-radius:20rpx;background:#fff;display:flex;align-items:center;justify-content:center}
.conversation-page .chat-tool .chat-icon{height:52rpx;width:52rpx}
.conversation-page .reading-actions{padding:0 20rpx;gap:8rpx;background:#f7f7f7}.conversation-page .reading-actions button{font-size:22rpx;min-height:88rpx;padding:12rpx;background:transparent;color:#007381}
.conversation-page .composer-reference,.conversation-page .composer-reedit{margin:0 12rpx 8rpx;padding:10rpx 0;font-size:24rpx}.conversation-page .composer-reference button,.conversation-page .composer-reedit button{padding:12rpx;min-height:88rpx}
.conversation-page .av-card button{display:flex;align-items:center;gap:16rpx;min-height:88rpx;padding:0;margin:0;background:transparent;color:inherit;font-size:30rpx;line-height:1.5}
.conversation-page .av-card button::after{border:0}.conversation-page .av-card .chat-icon{width:36rpx;height:36rpx}.conversation-page .is-mine .av-card{min-width:220rpx}
.conversation-page .image-grid{margin-top:8rpx}.conversation-page .conversation-warning{border-radius:0;margin:0;padding:12rpx 24rpx;font-size:24rpx;line-height:1.5}
@media(prefers-color-scheme:dark){
 .conversation-page{background:#111;color:#e8e8e8}.conversation-page .conversation-context,.conversation-page .composer,.conversation-page .reading-actions{background:#1e1e1e;border-color:#333}
 .conversation-page .conversation-context-sub,.conversation-page .message-divider,.conversation-page .message-sender,.conversation-page .recording-tip{color:#b2b8bb}
 .conversation-page .message-bubble{background:#2c2c2c}.conversation-page .message-item:not(.is-mine) .message-bubble:before{border-right-color:#2c2c2c}
