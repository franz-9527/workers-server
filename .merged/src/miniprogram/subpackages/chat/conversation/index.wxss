.conversation-page .av-transcript{color:#4c5c62;font-size:26rpx;line-height:1.65}
.composer-placeholder{color:#68747a}
@media(prefers-color-scheme:dark){.conversation-page .av-transcript{color:#c2c8ca}.composer-placeholder{color:#b2b8bb}}

/* Small invitation, explicit paid confirmation; no automatic interrupting modal. */
