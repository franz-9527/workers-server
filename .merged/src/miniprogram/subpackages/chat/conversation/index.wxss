.conversation-page .composer{margin:0;padding:8rpx 12rpx calc(8rpx + env(safe-area-inset-bottom));background:#f7f7f7;border-color:#d4d6d6}
.conversation-page .composer-row{display:flex;align-items:flex-end;gap:8rpx}
.conversation-page .composer-input{flex:1;width:0;min-height:88rpx;max-height:200rpx;padding:16rpx 18rpx;font-size:32rpx;line-height:48rpx;background:#fff;border-radius:10rpx;color:#1f2527}
.conversation-page .composer-mode,.conversation-page .composer-more{flex:0 0 88rpx;min-width:88rpx;min-height:88rpx}
