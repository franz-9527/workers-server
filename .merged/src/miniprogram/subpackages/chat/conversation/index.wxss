 .conversation-page .composer-input,.conversation-page .voice-hold,.conversation-page .chat-tool-icon{background:#2c2c2c;color:#e8e8e8}
 .conversation-page .voice-hold.is-recording{background:#16464e}.conversation-page .chat-tools{border-color:#363636}.conversation-page .chat-tool{color:#c2c8ca}
 .conversation-page .reading-actions button{color:#8bdce5}.conversation-page .is-placeholder .message-bubble{background:transparent;color:#b2b8bb}
