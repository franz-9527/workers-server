.wallet-page{min-height:100vh;padding:28rpx 24rpx 80rpx;background:#f2f7f8;color:#30484c;box-sizing:border-box}.wallet-hero{padding:36rpx 32rpx;border-radius:26rpx;background:linear-gradient(135deg,#00b9cb,#1497b1);color:#fff;box-shadow:0 16rpx 38rpx rgba(0,145,163,.18)}.wallet-label{font-size:24rpx;opacity:.86}.wallet-balance{margin-top:8rpx;font-size:64rpx;font-weight:800;letter-spacing:1rpx}.wallet-reserved{margin-top:12rpx;padding:10rpx 14rpx;border-radius:12rpx;background:rgba(255,255,255,.14);font-size:21rpx}.wallet-note{margin-top:20rpx;font-size:21rpx;line-height:1.65;opacity:.86}.wallet-card{margin-top:24rpx;padding:28rpx;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(37,71,79,.07)}.wallet-title{font-size:29rpx;font-weight:800}.preset-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:22rpx}.preset{display:flex;align-items:center;justify-content:center;height:84rpx;border:2rpx solid #dbe8ea;border-radius:16rpx;background:#f8fbfb;color:#38585f;font-size:29rpx;font-weight:700}.preset.active{border-color:#00b9cb;background:#e9f9fb;color:#008f9d}.custom-row{display:flex;align-items:center;margin-top:18rpx;padding:0 20rpx;height:86rpx;border:2rpx solid #dbe8ea;border-radius:16rpx;background:#f8fbfb}.custom-row>text{font-size:36rpx;font-weight:800}.custom-row input{flex:1;height:70rpx;margin-left:12rpx;font-size:30rpx}.recharge-button{margin-top:24rpx!important;border-radius:42rpx!important;background:#00b9cb!important;color:#fff!important;font-size:28rpx!important;font-weight:700!important}.recharge-button:after{border:0!important}.wallet-safe{margin-top:14rpx;color:#819095;font-size:21rpx;text-align:center}.ledger-card{padding-bottom:10rpx}.ledger-row{display:flex;align-items:center;gap:20rpx;padding:23rpx 0;border-bottom:1rpx solid #edf2f3}.ledger-row:last-child{border-bottom:0}.ledger-main{min-width:0;flex:1}.ledger-title,.ledger-desc,.ledger-time{display:block}.ledger-title{font-size:25rpx;font-weight:700}.ledger-desc{margin-top:5rpx;color:#73858a;font-size:21rpx;line-height:1.45}.ledger-time{margin-top:5rpx;color:#a0abad;font-size:19rpx}.ledger-amount{flex:none;color:#16885e;font-size:26rpx;font-weight:800}.ledger-amount.negative{color:#c45b50}.wallet-empty{padding:40rpx 0;color:#9ba6a8;text-align:center}.load-more{margin:20rpx auto!important;background:#edf8f9!important;color:#008f9d!important;font-size:23rpx!important}.confirming{position:fixed;left:50%;top:45%;z-index:80;transform:translate(-50%,-50%);padding:24rpx 30rpx;border-radius:18rpx;background:rgba(0,0,0,.78);color:#fff;white-space:nowrap}.spin{display:inline-block;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media (prefers-color-scheme:dark){.wallet-page{background:#101718;color:#dbe5e7}.wallet-card{background:#1b2426;box-shadow:none}.preset,.custom-row{border-color:#344649;background:#222d2f;color:#d4dfe1}.preset.active{border-color:#3bbeca;background:#16363a;color:#78dce4}.wallet-safe,.ledger-desc{color:#98aaae}.ledger-time,.wallet-empty{color:#74868a}.ledger-row{border-bottom-color:#2c393c}.load-more{background:#20383b!important;color:#70d7df!important}}