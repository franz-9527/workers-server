.dock-tool{font-size:21rpx}
.dock-tool>text{font-size:33rpx}
.dock-emoji{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI Emoji","Apple Color Emoji",sans-serif!important;font-size:34rpx!important;line-height:1}
.sheet-title{font-size:34rpx}
.sheet-subtitle{font-size:23rpx}
