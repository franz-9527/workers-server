.layer-name,.help-card-title,.setting-block-title{font-size:26rpx}
.layer-type,.help-card-text,.storage-label,.storage-meta{font-size:21rpx}
.shape-choice{height:136rpx;font-size:23rpx;line-height:1.25}
.shape-choice>text{font-size:41rpx}
.shape-grid.extended{grid-template-columns:repeat(3,1fr)}
.stroke-segment{display:flex;align-items:center;justify-content:center;gap:10rpx;min-width:112rpx;padding-left:14rpx;padding-right:14rpx}
.stroke-segment>text{font-size:23rpx}
.stroke-preview{width:42rpx;background:currentColor;border-radius:999rpx}
.stroke-preview.thin{height:2rpx}
.stroke-preview.normal{height:6rpx}
.stroke-preview.thick{height:11rpx}
.multi-measure-bar{position:absolute;left:12rpx;right:12rpx;bottom:12rpx;z-index:12;display:flex;align-items:center;gap:8rpx;padding:8rpx;background:rgba(255,255,255,.94);border:1rpx solid #dce8e0;border-radius:16rpx;box-shadow:0 4rpx 18rpx rgba(11,35,21,.10);backdrop-filter:blur(10px)}
.multi-measure-bar>text{flex:1;padding-left:8rpx;color:#52635a;font-size:22rpx}
.multi-measure-bar>view{display:flex;align-items:center;justify-content:center;height:48rpx;padding:0 15rpx;background:#f1f6f3;border-radius:12rpx;color:#516259;font-size:21rpx}
.multi-measure-bar .finish{background:#119d62;color:#fff;font-weight:700}
.multi-measure-bar .cancel{color:#c85c55;background:#fff1f0}
@media (prefers-color-scheme:dark){
  .multi-measure-bar{background:rgba(23,37,29,.94);border-color:#2b4034;box-shadow:none}
  .multi-measure-bar>text{color:#b5c2ba}
  .multi-measure-bar>view{background:#101b15;color:#dce8e0}
  .multi-measure-bar .finish{background:#119d62;color:#fff}
  .multi-measure-bar .cancel{background:#351d1b;color:#f08078}
  .stroke-preview{background:currentColor}
}


/* 2026-09-23：底部工具分组重构。图标统一为线性工具风格，不使用 Emoji。 */
.dock-icon-box{display:flex;align-items:center;justify-content:center;width:48rpx;height:38rpx;margin-bottom:5rpx;color:#4a5b52;font-size:32rpx;line-height:1}
.dock-tool.active .dock-icon-box{color:#119d62}
.measure-glyph{position:relative;display:block;width:38rpx;height:30rpx;color:currentColor;box-sizing:border-box}
.glyph-ruler{width:42rpx;height:19rpx;border:4rpx solid currentColor;border-radius:5rpx;transform:rotate(-3deg)}
.glyph-ruler:before,.glyph-ruler:after,.glyph-ruler .glyph-part:before,.glyph-ruler .glyph-part:after{content:"";position:absolute;top:0;width:3rpx;background:currentColor}
.glyph-ruler:before{left:7rpx;height:7rpx}.glyph-ruler:after{left:15rpx;height:11rpx}
.glyph-ruler .glyph-part:before{left:24rpx;height:7rpx}.glyph-ruler .glyph-part:after{left:32rpx;height:11rpx}
.glyph-leader{width:43rpx;height:31rpx}
.glyph-leader:before{content:"";position:absolute;left:3rpx;top:2rpx;width:26rpx;height:15rpx;border:3rpx solid currentColor;border-radius:3rpx}
.glyph-leader:after{content:"";position:absolute;left:26rpx;top:18rpx;width:20rpx;height:3rpx;background:currentColor;transform:rotate(135deg);transform-origin:left center}
.glyph-leader .glyph-part:before,.glyph-leader .glyph-part:after{content:"";position:absolute;background:currentColor}
.glyph-leader .glyph-part:before{left:35rpx;top:24rpx;width:3rpx;height:9rpx;transform:rotate(30deg)}
.glyph-leader .glyph-part:after{left:31rpx;top:27rpx;width:9rpx;height:3rpx;transform:rotate(30deg)}
.glyph-shape:before{content:"";position:absolute;left:2rpx;top:4rpx;width:19rpx;height:19rpx;border:3rpx solid currentColor;border-radius:3rpx}
.glyph-shape:after{content:"";position:absolute;right:1rpx;bottom:1rpx;width:19rpx;height:19rpx;border:3rpx solid currentColor;border-radius:50%;background:transparent}

.tool-choice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;padding:2rpx 0 10rpx}
.tool-choice{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:142rpx;padding:14rpx 8rpx;background:#f6f9f7;border:1rpx solid #e1e9e4;border-radius:18rpx;color:#4f6057;font-size:23rpx;text-align:center}
.tool-choice:active{background:#eaf7ef;border-color:#b9e1c9;color:#0b8d56}
.choice-icon{position:relative;display:flex;align-items:center;justify-content:center;width:58rpx;height:48rpx;margin-bottom:11rpx;color:#26352d;box-sizing:border-box}
.iconfont-choice text{font-size:45rpx;color:currentColor}
.css-line:before{content:"";position:absolute;left:5rpx;right:5rpx;top:23rpx;height:5rpx;border-radius:5rpx;background:currentColor;transform:rotate(-43deg)}
.css-arrow:before{content:"";position:absolute;left:5rpx;right:5rpx;top:23rpx;height:5rpx;border-radius:5rpx;background:currentColor;transform:rotate(-43deg)}
.css-arrow:after{content:"";position:absolute;right:3rpx;top:3rpx;width:15rpx;height:15rpx;border-top:5rpx solid currentColor;border-right:5rpx solid currentColor;transform:rotate(2deg)}
.css-rect:before{content:"";position:absolute;left:4rpx;right:4rpx;top:5rpx;bottom:5rpx;border:5rpx solid currentColor;border-radius:4rpx}
.css-ellipse:before{content:"";position:absolute;left:3rpx;right:3rpx;top:6rpx;bottom:6rpx;border:5rpx solid currentColor;border-radius:50%}
.css-area:before{content:"";position:absolute;left:4rpx;right:4rpx;top:5rpx;bottom:5rpx;border:4rpx dashed currentColor;border-radius:3rpx}
.css-area:after{content:"";position:absolute;left:12rpx;right:12rpx;top:22rpx;height:3rpx;background:currentColor;box-shadow:0 -9rpx 0 currentColor,0 9rpx 0 currentColor;opacity:.55}
.css-multi{transform:rotate(-42deg)}
.css-multi:before{content:"";position:absolute;left:5rpx;right:5rpx;top:23rpx;height:5rpx;border-radius:5rpx;background:currentColor}
.css-multi:after{content:"";position:absolute;left:12rpx;top:12rpx;width:4rpx;height:25rpx;background:currentColor;box-shadow:15rpx 0 0 currentColor,30rpx 0 0 currentColor}
.css-location{width:52rpx;height:52rpx;border:4rpx solid currentColor;border-radius:50%}
.css-location text{font-size:30rpx;color:currentColor}
.other-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
@media (prefers-color-scheme:dark){
  .dock-icon-box{color:#d9e5de}
  .dock-tool.active .dock-icon-box{color:#63cf92}
  .tool-choice{background:#101b15;border-color:#2d4235;color:#dce8e0}
  .tool-choice:active{background:#19382a;border-color:#356e4d;color:#63cf92}
  .choice-icon{color:#d9e5de}
}


/* 2026-09-23：图标回归 ColorUI / Lucide，二级弹窗恢复原尺寸。 */
.dock-public-icon{width:34rpx;height:34rpx;display:block;opacity:.82}
.dock-tool.active .dock-public-icon{opacity:1}
.shape-public-icon{width:39rpx;height:39rpx;margin-bottom:10rpx;display:block;opacity:.86}
.shape-public-icon.multi-icon{transform:rotate(-38deg)}
.shape-grid{grid-template-columns:repeat(3,1fr);gap:12rpx;padding:2rpx 0 8rpx}
.shape-choice{height:124rpx;min-height:0;padding:0;background:#f6f9f7;border:1rpx solid #e1e9e4;border-radius:18rpx;color:#4f6057;font-size:22rpx}
.shape-choice>text{margin-bottom:10rpx;color:#31473b;font-size:39rpx}
@media (prefers-color-scheme:dark){
  .dock-public-icon,.shape-public-icon{opacity:.9}
}


/* 本地图标与 ColorUI 一样处理暗黑模式；普通态变浅，选中态保持师傅绿。 */
.dock-public-icon{filter:none}
.dock-tool.active .dock-public-icon{filter:brightness(0) saturate(100%) invert(45%) sepia(45%) saturate(1050%) hue-rotate(103deg) brightness(91%) contrast(89%)}
@media (prefers-color-scheme:dark){
  .dock-public-icon,.shape-public-icon{filter:brightness(0) invert(1);opacity:.88}
  .dock-tool.active .dock-public-icon{filter:brightness(0) saturate(100%) invert(67%) sepia(33%) saturate(861%) hue-rotate(93deg) brightness(92%) contrast(88%);opacity:1}
}


/* 2026-09-23：图形/其他改用微信原生 page-container。
   这是专门用于页面级弹层的组件，避免普通 fixed view 与 2D Canvas 的触摸层级冲突。 */
.tool-picker-sheet{
  padding:0 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:#fff;
  border-radius:28rpx 28rpx 0 0;
}
@media (prefers-color-scheme:dark){
  .tool-picker-sheet{background:#17251d}
}


/* 2026-09-23：文字引线、多段尺寸输入与弹窗图标暗黑模式 */
.multi-segment-inputs{display:flex;flex-direction:column;gap:10rpx;padding:2rpx 0 6rpx}
.multi-segment-row{display:flex;align-items:center;gap:12rpx;padding:10rpx 12rpx;background:#f5f8f6;border:1rpx solid #dfe9e3;border-radius:16rpx}
.multi-segment-row.active{border-color:#9fd6b6;box-shadow:0 0 0 3rpx rgba(17,157,98,.08)}
.multi-segment-row>text{flex:none;width:86rpx;color:#687970;font-size:21rpx}
.multi-segment-row>input{flex:1;height:58rpx;min-width:0;color:#24362d;font-size:27rpx;font-weight:600}

.tool-picker-sheet .shape-choice .picker-icon{color:#31473b}
.tool-picker-sheet .shape-choice image.picker-icon{
  filter:brightness(0) saturate(100%) invert(22%) sepia(12%) saturate(763%) hue-rotate(93deg) brightness(93%) contrast(88%);
}
.tool-picker-sheet .shape-choice:active .picker-icon{color:#0b8d56}
.tool-picker-sheet .shape-choice:active image.picker-icon{
  filter:brightness(0) saturate(100%) invert(45%) sepia(47%) saturate(930%) hue-rotate(103deg) brightness(88%) contrast(91%);
}

@media (prefers-color-scheme:dark){
  .multi-segment-row{background:#101b15;border-color:#2d4235}
  .multi-segment-row.active{border-color:#356e4d;box-shadow:0 0 0 3rpx rgba(99,207,146,.08)}
  .multi-segment-row>text{color:#a9b7ae}
  .multi-segment-row>input{color:#edf6f0}
  .tool-picker-sheet .shape-choice .picker-icon{color:#d9e5de!important}
  .tool-picker-sheet .shape-choice image.picker-icon{
    filter:brightness(0) invert(1)!important;
    opacity:.88;
  }
  .tool-picker-sheet .shape-choice:active .picker-icon{color:#63cf92!important}
  .tool-picker-sheet .shape-choice:active image.picker-icon{
    filter:brightness(0) saturate(100%) invert(73%) sepia(24%) saturate(828%) hue-rotate(93deg) brightness(91%) contrast(88%)!important;
    opacity:1;
  }
}


