# 2026-08-14：完整宝塔 Nginx 站点示例；使用前核对证书路径、PHP Socket 和站点根目录。
server {
    listen 80;
    server_name worker.20m.cc;
    root /www/wwwroot/worker;

    # 2026-08-14：保留证书签发目录，其余 HTTP 请求强制跳转 HTTPS。
    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name worker.20m.cc;
    root /www/wwwroot/worker;
    index index.php index.html;
    server_tokens off;

    # 2026-08-14：宝塔证书默认路径示例，若面板实际路径不同必须同步修改。
    ssl_certificate /www/server/panel/vhost/cert/worker.20m.cc/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/worker.20m.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 2026-08-14：上传上限需与 PHP 7.4 的 upload_max_filesize 和 post_max_size 一并调整。
    client_max_body_size 12m;
    client_body_timeout 30s;

    # 2026-08-14：基础安全响应头不改变微信支付回调正文和状态码。
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # 2026-08-14：确认 HTTPS 全站稳定后可取消下一行注释启用 HSTS，不要添加 includeSubDomains 影响其他子域名。
    # 2026-08-14：add_header Strict-Transport-Security "max-age=15552000" always;

    # 2026-08-14：保留证书自动续期验证目录。
    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    # 2026-08-14：前端样式和脚本是唯一允许直接公开的项目资源目录。
    location = /assets {
        return 301 /assets/;
    }

    location /assets/ {
        try_files $uri =404;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # 2026-08-14：禁止访问 PHP 源码、配置、SQL、模板、运行数据、日志和命令行脚本目录。
    location ~* ^/(?:app|config|database|storage|views|bin)(?:/|$) {
        return 404;
    }

    # 2026-08-14：安装页可公开访问，令牌文件和安装服务源码不可公开。
    location ~* ^/install/(?:install-token\.php|Installer\.php)(?:/|$) {
        return 404;
    }

    # 2026-08-14：阻止根目录启动文件、版本文件和服务器配置被下载。
    location ~* ^/(?:bootstrap\.php|VERSION|README\.md|nginx\.worker\.conf\.example)$ {
        return 404;
    }

    # 2026-08-14：隐藏文件除证书验证目录外全部拒绝。
    location ~ (^|/)\.(?!well-known(?:/|$)) {
        return 404;
    }

    # 2026-08-14：拒绝数据库、日志、密钥配置、备份压缩包和服务器脚本等敏感扩展名。
    location ~* \.(?:sql|log|ini|conf|env|bak|backup|old|orig|save|swp|dist|md|lock|ya?ml|toml|sh|ps1|phar|zip|tar|gz)$ {
        return 404;
    }

    # 2026-08-14：物理目录入口支持 /admin、/api、/install 和 /adminapi/upgrade，其余请求回到站点入口。
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 2026-08-14：只执行五个前端控制器，后续 API 功能应继续通过 /api/index.php 分发。
    location ~ ^/(?:index|admin/index|api/index|install/index|adminapi/upgrade/index)\.php$ {
        try_files $uri =404;
        include fastcgi.conf;
        fastcgi_pass unix:/tmp/php-cgi-83.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }

    # 2026-08-14：拒绝执行任何未列入白名单的 PHP 文件，避免源码目录出现可调用脚本。
    location ~ \.php(?:/|$) {
        return 404;
    }

    # 2026-08-14：日志路径沿用宝塔站点约定，日志文件不位于网站目录。
    access_log /www/wwwlogs/worker.20m.cc.log;
    error_log /www/wwwlogs/worker.20m.cc.error.log;
}
