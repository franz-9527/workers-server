page {
  background: #f4f7f8;
  color: #203238;
}

.help-page {
  --brand: #00b9cb;
  --brand-deep: #008c9b;
  --bg: #f4f7f8;
  --surface: #ffffff;
  --text: #203238;
  --text-secondary: #63777c;
  --text-muted: #91a0a4;
  --border: #e2eaec;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  color: var(--text);
}

.help-scroll-nav {
  box-sizing: border-box;
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1000;
  border-bottom: 1rpx solid rgba(31,55,60,.08);
  background: rgba(255,255,255,.96);
  box-shadow: 0 6rpx 20rpx rgba(27,55,61,.05);
  opacity: 0;
  transform: translateY(-100%);
  pointer-events: none;
  transition: opacity .2s ease, transform .22s ease;
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
}

.help-scroll-nav.is-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.help-scroll-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 18rpx;
}

.help-nav-back {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #21383d;
  font-size: 34rpx;
}

.help-nav-title {
  position: absolute;
  right: 120rpx;
  left: 120rpx;
  overflow: hidden;
  color: #203238;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.help-nav-hover {
  background: rgba(0,0,0,.05);
}

.help-hero-back {
  position: absolute;
  left: 18rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
}

.help-hero-back-hover {
  background: rgba(255,255,255,.14);
}

.help-hero {
  position: relative;
  overflow: hidden;
  padding: 42rpx 30rpx 34rpx;
  background: linear-gradient(145deg, #039dad 0%, #00b9cb 52%, #26c7c8 100%);
  color: #fff;
}

.help-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 900rpx;
  margin: 0 auto;
}

.help-hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
}

.help-hero-glow-a {
  width: 260rpx;
  height: 260rpx;
  right: -90rpx;
  top: -110rpx;
}

.help-hero-glow-b {
  width: 180rpx;
  height: 180rpx;
  left: -70rpx;
  bottom: -90rpx;
}

.help-title {
  font-size: 46rpx;
  line-height: 1.18;
  font-weight: 700;
}

.help-subtitle {
  margin-top: 9rpx;
  color: rgba(255,255,255,.84);
  font-size: 25rpx;
  line-height: 1.45;
}

.help-search {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 94rpx;
  margin-top: 28rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,.98);
  box-shadow: 0 14rpx 36rpx rgba(0,93,104,.16);
}

.help-search input {
  flex: 1;
  height: 90rpx;
  color: #21373c;
  font-size: 28rpx;
}

.help-search-icon {
  flex: none;
  margin-right: 14rpx;
  color: #00a4b4;
  font-size: 32rpx;
}

.help-search-placeholder {
  color: #9aabad;
}

.help-search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  color: #8ea0a4;
  font-size: 28rpx;
}

.help-hot-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.help-hot-label {
  flex: none;
  color: rgba(255,255,255,.72);
  font-size: 21rpx;
}

.help-hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.help-hot-item {
  padding: 9rpx 17rpx;
  border: 1rpx solid rgba(255,255,255,.24);
  border-radius: 999rpx;
  background: rgba(255,255,255,.12);
  color: #fff;
  font-size: 21rpx;
}

.help-hero-hover,
.help-tap,
.help-scene-hover {
  opacity: .78;
}

.help-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #f0dfae;
  border-radius: 18rpx;
  background: #fff8e8;
  color: #836019;
  font-size: 22rpx;
  line-height: 1.55;
}

.help-notice.is-builtin {
  border-color: #bfe6e9;
  background: #eaf8f9;
  color: #35747a;
}

.help-body {
  padding: 24rpx 24rpx 0;
}

.help-role-section {
  margin-bottom: 30rpx;
}

.help-role-title {
  margin-bottom: 14rpx;
  color: var(--text);
  font-size: 25rpx;
  font-weight: 650;
}

.help-role-scroll {
  margin: 0 -24rpx;
  white-space: nowrap;
}

.help-role-row {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.help-role-chip {
  box-sizing: border-box;
  flex: none;
  min-width: 138rpx;
  min-height: 78rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dce6e8;
  border-radius: 20rpx;
  background: #fff;
  color: #546b70;
  font-size: 26rpx;
  font-weight: 550;
  line-height: 76rpx;
  text-align: center;
}

.help-role-chip.is-active {
  border-color: var(--brand);
  background: var(--brand);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0,156,171,.12);
}

.help-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.help-section-title {
  color: var(--text);
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
}

.help-section-sub {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.help-section-link {
  flex: none;
  min-height: 56rpx;
  padding-left: 18rpx;
  color: var(--brand-deep);
  font-size: 22rpx;
  line-height: 56rpx;
}

.help-question-section,
.help-search-section,
.help-scene-section,
.help-scene-results {
  margin-bottom: 30rpx;
}

.help-faq-card {
  overflow: hidden;
  position: relative;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(35,63,68,.035);
}

.help-faq-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 5rpx;
  content: "";
  background: #00b9cb;
}

.help-faq-card.is-open {
  box-shadow: 0 10rpx 30rpx rgba(32,79,86,.055);
}

.help-faq-head {
  display: flex;
  align-items: flex-start;
  min-height: 124rpx;
  padding: 23rpx 22rpx 23rpx 25rpx;
}

.help-faq-main {
  min-width: 0;
  flex: 1;
}

.help-faq-labels {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9rpx;
  margin-bottom: 11rpx;
}

.help-faq-tag,
.help-faq-featured {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.2;
}

.help-faq-featured {
  background: #fff1e4;
  color: #c36b1c;
}

.help-faq-question {
  color: var(--text);
  font-size: 29rpx;
  line-height: 1.46;
  font-weight: 650;
}

.help-faq-preview {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.58;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.help-faq-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  flex: none;
  margin: 4rpx -6rpx 0 14rpx;
  border-radius: 16rpx;
  background: #f4f8f9;
  color: #91a1a5;
  font-size: 25rpx;
  transition: transform .18s ease;
}

.help-faq-chevron.is-open {
  transform: rotate(90deg);
  background: #e9f8fa;
  color: var(--brand-deep);
}

.help-faq-answer {
  padding: 20rpx 22rpx 24rpx 25rpx;
  border-top: 1rpx solid #edf2f3;
}

.help-answer-text {
  display: block;
  color: #41585d;
  font-size: 25rpx;
  line-height: 1.78;
  white-space: pre-wrap;
}

.help-business-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 76rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border-radius: 15rpx;
  background: #edf9fa;
  color: #008e9e;
  font-size: 23rpx;
  font-weight: 600;
}

.help-related {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e9eff0;
}

.help-related-title {
  margin-bottom: 4rpx;
  color: var(--text);
  font-size: 22rpx;
  font-weight: 650;
}

.help-related-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 76rpx;
  color: #3d5960;
  font-size: 23rpx;
  line-height: 1.45;
}

.help-related-item + .help-related-item {
  border-top: 1rpx solid #edf2f3;
}

.help-related-item .cuIcon-right {
  flex: none;
  color: #9baaad;
}

.help-answer-meta {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: 19rpx;
}

.help-faq-card.tone-find::before,
.help-faq-card.tone-find .help-faq-tag {
  background: #e5f8fa;
  color: #008d9b;
}

.help-faq-card.tone-find::before {
  background: #19b8c5;
}

.help-faq-card.tone-order::before {
  background: #4b91db;
}

.help-faq-card.tone-order .help-faq-tag {
  background: #edf5ff;
  color: #397fc5;
}

.help-faq-card.tone-payment::before {
  background: #6578db;
}

.help-faq-card.tone-payment .help-faq-tag {
  background: #eef0ff;
  color: #5768bf;
}

.help-faq-card.tone-construction::before {
  background: #36a36e;
}

.help-faq-card.tone-construction .help-faq-tag {
  background: #eaf8f1;
  color: #258b60;
}

.help-faq-card.tone-measurement::before {
  background: #8a67cf;
}

.help-faq-card.tone-measurement .help-faq-tag {
  background: #f3edff;
  color: #7655b3;
}

.help-faq-card.tone-refund::before {
  background: #e58a35;
}

.help-faq-card.tone-refund .help-faq-tag {
  background: #fff3e6;
  color: #be6d22;
}

.help-faq-card.tone-aftersales::before {
  background: #d96861;
}

.help-faq-card.tone-aftersales .help-faq-tag {
  background: #fff0ef;
  color: #b9504b;
}

.help-faq-card.tone-account::before {
  background: #5898a6;
}

.help-faq-card.tone-account .help-faq-tag {
  background: #edf6f7;
  color: #477f89;
}

.help-faq-card.tone-finance::before {
  background: #9364c3;
}

.help-faq-card.tone-finance .help-faq-tag {
  background: #f5edfb;
  color: #7d53a6;
}

.help-scene-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -7rpx;
}

.help-scene-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: calc(50% - 14rpx);
  min-height: 128rpx;
  margin: 7rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(35,63,68,.035);
}

.help-scene-card.is-active {
  border-color: rgba(0,185,203,.4);
  box-shadow: 0 9rpx 26rpx rgba(0,145,160,.08);
}

.help-scene-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  border-radius: 19rpx;
  font-size: 32rpx;
}

.help-scene-copy {
  min-width: 0;
  flex: 1;
  margin-left: 14rpx;
}

.help-scene-name {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.35;
}

.help-scene-desc {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--text-muted);
  font-size: 19rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.help-scene-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
  height: 40rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #f1f5f6;
  color: #839397;
  font-size: 18rpx;
}

.help-scene-card.tone-find .help-scene-icon {
  background: #e5f8fa;
  color: #008d9b;
}

.help-scene-card.tone-order .help-scene-icon {
  background: #edf5ff;
  color: #397fc5;
}

.help-scene-card.tone-payment .help-scene-icon {
  background: #eef0ff;
  color: #5768bf;
}

.help-scene-card.tone-construction .help-scene-icon {
  background: #eaf8f1;
  color: #258b60;
}

.help-scene-card.tone-measurement .help-scene-icon {
  background: #f3edff;
  color: #7655b3;
}

.help-scene-card.tone-refund .help-scene-icon {
  background: #fff3e6;
  color: #be6d22;
}

.help-scene-card.tone-aftersales .help-scene-icon {
  background: #fff0ef;
  color: #b9504b;
}

.help-scene-card.tone-account .help-scene-icon {
  background: #edf6f7;
  color: #477f89;
}

.help-scene-card.tone-finance .help-scene-icon {
  background: #f5edfb;
  color: #7d53a6;
}

.help-contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 34rpx;
  padding: 24rpx;
  border: 1rpx solid #dce9eb;
  border-radius: 20rpx;
  background: #f8fbfc;
}

.help-contact-copy {
  min-width: 0;
  flex: 1;
}

.help-contact-title {
  color: #29464c;
  font-size: 25rpx;
  font-weight: 650;
}

.help-contact-desc {
  margin-top: 6rpx;
  color: #7a8e92;
  font-size: 20rpx;
  line-height: 1.5;
}

.help-contact-action {
  display: flex;
  align-items: center;
  gap: 7rpx;
  flex: none;
  color: var(--brand-deep);
  font-size: 22rpx;
}

.help-loading-card,
.help-state-card,
.help-empty-card {
  margin-bottom: 28rpx;
  padding: 34rpx 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  background: #fff;
}

.help-state-card,
.help-empty-card {
  text-align: center;
}

.help-state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  background: #fff0eb;
  color: #d96d48;
  font-size: 38rpx;
}

.help-state-icon.is-soft {
  background: #eaf8fa;
  color: var(--brand-deep);
}

.help-state-title {
  margin-top: 16rpx;
  color: var(--text);
  font-size: 29rpx;
  font-weight: 650;
}

.help-state-desc {
  max-width: 560rpx;
  margin: 10rpx auto 0;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.62;
}

.help-empty-link {
  margin-top: 18rpx;
  color: var(--brand-deep);
  font-size: 23rpx;
  font-weight: 600;
}

.help-btn {
  box-sizing: border-box;
  min-height: 82rpx;
  margin: 22rpx auto 0;
  padding: 0 28rpx;
  border: 1rpx solid #d8e3e5;
  border-radius: 15rpx;
  background: #fff;
  color: #456067;
  font-size: 23rpx;
  line-height: 80rpx;
}

.help-btn::after {
  border: 0;
}

.help-btn-primary {
  border-color: var(--brand);
  background: var(--brand);
  color: #fff;
}

.help-searching {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 130rpx;
  color: var(--text-muted);
  font-size: 23rpx;
}

.help-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(0,185,203,.18);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: help-spin .75s linear infinite;
}

@keyframes help-spin {
  to { transform: rotate(360deg); }
}

.help-skeleton {
  position: relative;
  overflow: hidden;
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 10rpx;
  background: #edf1f2;
}

.help-skeleton::after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -100%;
  width: 70%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.75), transparent);
  content: "";
  animation: help-shimmer 1.2s ease-in-out infinite;
}

.help-skeleton-title {
  width: 38%;
  height: 32rpx;
  margin-top: 0;
}

.help-skeleton-role {
  width: 100%;
  height: 78rpx;
  margin-top: 26rpx;
}

.help-skeleton-short {
  width: 62%;
}

@keyframes help-shimmer {
  to { left: 140%; }
}

.help-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  padding: 36rpx 22rpx 28rpx;
  color: #94a5a8;
  font-size: 19rpx;
}

@media (prefers-color-scheme: dark) {
  page {
    background: #0f1719;
    color: #edf6f7;
  }

  .help-page {
    --bg: #0f1719;
    --surface: #182427;
    --text: #edf6f7;
    --text-secondary: #a8babd;
    --text-muted: #7f9599;
    --border: #2a3c40;
    --brand: #43cbd5;
    --brand-deep: #72dce3;
  }

  .help-scroll-nav {
    border-bottom-color: rgba(255,255,255,.06);
    background: rgba(19,31,34,.96);
    box-shadow: 0 6rpx 20rpx rgba(0,0,0,.14);
  }

  .help-nav-back,
  .help-nav-title {
    color: #edf6f7;
  }

  .help-nav-hover {
    background: rgba(255,255,255,.08);
  }

  .help-hero {
    background: linear-gradient(145deg, #006f79 0%, #008b98 52%, #087f85 100%);
  }

  .help-notice {
    border-color: #5b4923;
    background: #332b1b;
    color: #efd68e;
  }

  .help-notice.is-builtin {
    border-color: #2c555b;
    background: #173337;
    color: #9ddde2;
  }

  .help-role-chip,
  .help-faq-card,
  .help-scene-card,
  .help-loading-card,
  .help-state-card,
  .help-empty-card,
  .help-btn {
    border-color: var(--border);
    background: #182427;
    box-shadow: none;
  }

  .help-role-chip {
    color: #b3c4c7;
  }

  .help-role-chip.is-active {
    border-color: #43cbd5;
    background: #087d88;
    color: #fff;
  }

  .help-faq-answer,
  .help-related,
  .help-related-item + .help-related-item {
    border-color: var(--border);
  }

  .help-answer-text,
  .help-related-item {
    color: #bfd0d3;
  }

  .help-faq-chevron {
    background: #203034;
    color: #81969a;
  }

  .help-faq-chevron.is-open {
    background: #173438;
    color: #76dce4;
  }

  .help-business-link {
    background: #173438;
    color: #8be0e6;
  }

  .help-contact-card {
    border-color: #294448;
    background: #142124;
  }

  .help-contact-title {
    color: #e6f0f1;
  }

  .help-contact-desc {
    color: #91a7ab;
  }

