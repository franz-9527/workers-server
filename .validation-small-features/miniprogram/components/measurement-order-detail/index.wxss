/* V2.2.9：测量成果是原订单详情中的模块，不再拥有独立详情页。 */
.measurement-module{box-sizing:border-box;margin:18rpx 0;color:#293a3f}
.module-card{box-sizing:border-box;margin-bottom:18rpx;padding:26rpx 28rpx;border:1rpx solid #e8eff1;border-radius:20rpx;background:#fff;box-shadow:0 5rpx 20rpx rgba(22,65,76,.04)}
.module-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.module-title{font-size:30rpx;font-weight:700;color:#283e42}
.module-subtitle{margin-top:8rpx;font-size:23rpx;line-height:1.55;color:#77888c}
.module-state{flex:none;padding:6rpx 16rpx;border-radius:24rpx;background:#eef9fa;color:#008d9d;font-size:22rpx;font-weight:700}
.module-tip{margin-top:18rpx;padding:16rpx 18rpx;border-radius:12rpx;background:#f5f8f9;color:#667a7f;font-size:23rpx;line-height:1.55}
.module-tip.success{background:#eef9f4;color:#287056}.module-tip.attention{background:#fff8e8;color:#8a6425}
.space-list{margin-top:18rpx}.space-card{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #edf1f2}
.space-head{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:700}
.text-button{margin:0;padding:0 8rpx;background:transparent;color:#009daf;font-size:23rpx}
.media-list{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:15rpx}
.media-item{position:relative;width:146rpx;text-align:center}
.media-item image{width:146rpx;height:146rpx;border-radius:12rpx;background:#edf2f3}
.media-label{margin-top:4rpx;color:#69797d;font-size:21rpx}
.media-delete{position:absolute;right:-5rpx;top:-8rpx;width:35rpx;height:35rpx;border-radius:50%;background:#db5560;color:#fff;line-height:32rpx;font-size:28rpx}
.annotate-button{box-sizing:border-box;width:100%;height:44rpx;margin:5rpx 0 0;padding:0 4rpx;border-radius:22rpx;background:#eaf8fa;color:#008d9e;font-size:20rpx;line-height:44rpx}
.media-actions{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}
.media-actions button{height:56rpx;margin:0;padding:0 14rpx;border-radius:28rpx;background:#eff9fa;color:#008d9d;font-size:22rpx;line-height:56rpx}
.local-box{margin-top:18rpx;padding:18rpx;border:2rpx dashed #9edfe5;border-radius:16rpx;background:#f7fbfb}
.local-title{display:flex;align-items:center;gap:10rpx;color:#24646c;font-size:24rpx;font-weight:700}
.local-title text{min-width:34rpx;height:34rpx;border-radius:17rpx;background:#00b9cb;color:#fff;line-height:34rpx;text-align:center;font-size:19rpx}
.local-item{display:flex;gap:16rpx;margin-top:15rpx;padding-top:15rpx;border-top:1rpx solid #e5efef}
.local-item image{width:120rpx;height:120rpx;flex:none;border-radius:12rpx;background:#e9eff0}
.local-copy{flex:1;min-width:0}.local-name{color:#d47b28;font-size:21rpx}
.local-actions{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:10rpx}
.local-actions button{height:48rpx;margin:0;padding:0 15rpx;border-radius:24rpx;background:#fff;color:#53656b;font-size:20rpx;line-height:48rpx}
.local-actions .primary-mini{background:#00b9cb;color:#fff}.local-actions .danger-mini{background:#fff1f1;color:#d84b4b}
.outline-button,.primary-button{box-sizing:border-box;height:70rpx;margin:18rpx 0 0;border-radius:36rpx;font-size:25rpx;line-height:70rpx}
.outline-button{border:1rpx solid #00b9cb;background:#fff;color:#008d9e}.primary-button{background:#00b9cb;color:#fff;font-weight:700}
.result-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.result-actions button{flex:1;min-width:210rpx;margin-top:0}
.empty-state{padding:38rpx 12rpx;color:#819093;text-align:center;font-size:23rpx}
.upload-progress{margin-top:16rpx;color:#00a6b9;font-size:23rpx}
.settlement-row{display:flex;justify-content:space-between;gap:18rpx;padding:17rpx 0;border-bottom:1rpx solid #eff3f4;color:#738084;font-size:25rpx}
.settlement-row text:last-child{max-width:66%;color:#30454a;text-align:right;word-break:break-all}
.pricing-summary{display:flex;align-items:center;gap:14rpx;margin-top:22rpx;padding:20rpx;border-radius:16rpx;background:#f7fafb}.pricing-cell{flex:1;min-width:0}.pricing-cell text{display:block;color:#7c8d91;font-size:22rpx}.pricing-cell strong{display:block;margin-top:6rpx;color:#364a4f;font-size:31rpx}.pricing-cell.emphasized strong{color:#008f9f}.pricing-arrow{flex:none;color:#9aacb0;font-size:30rpx}.price-delta.increase{color:#d07824!important}.price-delta.decrease{color:#288162!important}.price-delta.same{color:#687b80!important}.pricing-items{margin-top:18rpx;padding-top:4rpx}.pricing-items-title{margin-bottom:4rpx;color:#52686d;font-size:24rpx;font-weight:700}.pricing-item{padding:15rpx 0;border-bottom:1rpx solid #eff3f4}.pricing-item-head{display:flex;justify-content:space-between;gap:16rpx;color:#3c5257;font-size:24rpx}.pricing-item-head text:last-child{text-align:right;color:#65797e}.pricing-item-amount{margin-top:5rpx;color:#839195;font-size:21rpx;text-align:right}
.module-loading,.module-error{margin:18rpx 0;padding:34rpx 20rpx;border-radius:18rpx;background:#fff;color:#72858a;text-align:center;font-size:24rpx}.module-error{color:#c34b53}

/* 与项目暗黑规范一致：组件自身保证文字、卡片和按钮不会与背景同色。 */
@media (prefers-color-scheme: dark){
  .measurement-module{color:#e8eff0}
  .module-card,.module-loading,.module-error{border-color:#33484d;background:#1f2a2d;box-shadow:none}
  .module-title,.space-head{color:#f1f6f7}.module-subtitle,.empty-state{color:#9fb0b4}
  .module-state{background:#163b40;color:#72dbe5}.module-tip{background:#29373a;color:#bdc9cc}.module-tip.success{background:#203a31;color:#9fd7bd}.module-tip.attention{background:#443920;color:#e8ca86}
  .space-card{border-color:#344549}.media-item image{background:#2c3b3f}.media-label{color:#b4c1c4}
  .annotate-button,.media-actions button{background:#15383d;color:#7bdce5}
  .local-box{border-color:#37666c;background:#253437}.local-name{color:#f0b56f}.local-actions button{background:#314145;color:#dce7e9}
  .outline-button{border-color:#35c8d6;background:#1f2a2d;color:#77dfe7}.primary-button{background:#00a9ba;color:#fff}
  .settlement-row{border-color:#344549;color:#aebdc0}.settlement-row text:last-child{color:#e5edef}
  .pricing-summary{background:#253437}.pricing-cell text{color:#9fb0b4}.pricing-cell strong{color:#edf4f5}.pricing-cell.emphasized strong{color:#79dfe8}.pricing-arrow{color:#708489}.pricing-items-title,.pricing-item-head{color:#dbe5e7}.pricing-item,.pricing-item-head{border-color:#344549}.pricing-item-head text:last-child,.pricing-item-amount{color:#a7b6b9}
}
