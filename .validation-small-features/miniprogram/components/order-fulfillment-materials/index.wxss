.materials-card{margin:20rpx;padding:22rpx;border:1rpx solid var(--border,#e2eaec);border-radius:18rpx;background:var(--surface,#fff);color:var(--text,#293a3f)}
.materials-title{font-size:28rpx;font-weight:700;margin-bottom:16rpx}
.materials-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}
.materials-item{min-width:0;font-size:21rpx;line-height:1.5;color:var(--text-secondary,#738084);overflow-wrap:anywhere}
.materials-item image{width:100%;height:160rpx;border-radius:10rpx}
@media(prefers-color-scheme:dark){.materials-card{background:#192629;border-color:#2d4145;color:#e7f0f1}.materials-item{color:#a7b9bc}}
