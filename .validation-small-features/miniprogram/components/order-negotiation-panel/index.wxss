/* 2026-10-08：复用订单配色、轻量按钮与深色模式，底部编辑退款方案。 */
.panel{margin:24rpx;padding:26rpx;border-radius:20rpx;background:#fff;color:#273444}.heading{font-size:30rpx;font-weight:600}.intro,.hint{margin-top:12rpx;color:#7b8794;font-size:24rpx;line-height:1.6}.case{padding-top:24rpx;margin-top:22rpx;border-top:1rpx solid #edf0f3}.head{display:flex;justify-content:space-between;gap:16rpx;align-items:center}.title{font-size:28rpx;font-weight:500}.status{font-size:22rpx;color:#b16b20;max-width:65%;text-align:right}.status.escalated{color:#d35e40}.description{margin-top:16rpx;font-size:26rpx;line-height:1.6;word-break:break-all}.amount{margin-top:10rpx;font-size:27rpx}.actions{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:18rpx}.actions:empty{display:none}.actions button{margin:0;padding:0 24rpx;height:68rpx;line-height:68rpx;border-radius:999rpx;font-size:25rpx;background:#f1f4f6;color:#526171}.actions button::after{border:0}.actions .accept{background:#e5f7f7;color:#159a9d}.actions .escalate{background:#fff2e3;color:#ac671c}.mask{position:fixed;inset:0;background:rgba(0,0,0,.4);display:flex;align-items:flex-end;z-index:1100}.sheet{box-sizing:border-box;width:100%;padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:24rpx 24rpx 0 0;background:#fff}.sheet input,.sheet textarea{box-sizing:border-box;width:100%;margin-top:20rpx;padding:20rpx;border-radius:12rpx;background:#f4f6f8;font-size:28rpx}.sheet input{height:84rpx}.sheet textarea{height:180rpx}
@media(prefers-color-scheme:dark){.panel,.sheet{background:#1c242d;color:#e4eaf0}.case{border-color:#303c48}.intro,.hint{color:#9aaab8}.actions button,.sheet input,.sheet textarea{background:#2a3540;color:#dce5ed}.actions .accept{background:#173b3e;color:#63d2d0}.actions .escalate{background:#443322;color:#edbd79}}
