@import "./creationTheme.wxss";
page{background:#f4f7f8}
@media (prefers-color-scheme:dark){page{background:#101718}}
.create-page{min-height:100vh;background:var(--app-page-bg);color:var(--app-text);padding-bottom:calc(180rpx + env(safe-area-inset-bottom));font-size:28rpx}
.create-hero{padding:0 28rpx 30rpx;background:var(--app-primary-soft);border-bottom:1rpx solid var(--app-primary-border)}
.create-heading{font-size:38rpx;font-weight:700;line-height:1.4}.create-subtitle{margin-top:10rpx;font-size:25rpx;color:var(--app-text-secondary);line-height:1.6}
.create-steps{display:flex;gap:12rpx;margin-top:28rpx}.create-step{flex:1;min-width:0;color:var(--app-text-secondary);font-size:23rpx;text-align:center;line-height:1.5}.create-step>text{display:block;width:44rpx;line-height:44rpx;margin:0 auto 8rpx;border:1rpx solid var(--app-border-strong);border-radius:50%;background:var(--app-surface)}.create-step.current{color:var(--app-primary-text);font-weight:700}.create-step.current>text,.create-step.done>text{background:var(--app-primary);border-color:var(--app-primary);color:var(--app-primary-on-solid)}
.section,.state-card{margin:22rpx;padding:26rpx;background:var(--app-surface);border:1rpx solid var(--app-border);border-radius:22rpx}.state-card{text-align:center;line-height:1.7}.section-title{font-size:31rpx;font-weight:700;line-height:1.5;margin-bottom:14rpx}.optional{font-size:23rpx;font-weight:400;color:var(--app-text-secondary);margin-left:12rpx}.hint{margin-top:10rpx;font-size:24rpx;line-height:1.65;color:var(--app-text-secondary);overflow-wrap:anywhere}
.notice{margin:22rpx;padding:20rpx 24rpx;background:var(--app-info-soft);color:var(--app-info-text);border:1rpx solid var(--app-info-border);border-radius:16rpx;font-size:25rpx;line-height:1.7}.field{margin-top:24rpx}.field-label{display:block;margin-bottom:12rpx;font-size:27rpx;font-weight:600;line-height:1.5}.required{color:var(--app-danger-text);margin-left:6rpx}.spaced{margin-top:28rpx}
.field input,.field textarea,.picker-value,.search-row{box-sizing:border-box;width:100%;min-height:86rpx;padding:20rpx;border:1rpx solid var(--app-border-strong);border-radius:14rpx;background:var(--app-surface-muted);color:var(--app-text);font-size:27rpx;line-height:1.5}.field textarea{min-height:130rpx}.picker-value{display:flex;justify-content:space-between;gap:12rpx}.create-placeholder{color:var(--app-text-secondary)}.search-row{display:flex;gap:14rpx;align-items:center;margin-top:20rpx;padding:10rpx 14rpx}.search-row input{flex:1;min-width:0;height:70rpx;color:var(--app-text);font-size:25rpx}
.create-page button{margin:0;white-space:normal;font-size:27rpx;line-height:1.5;border-radius:14rpx;padding:21rpx 18rpx;min-height:84rpx;font-weight:600}.create-page button::after{border:0}.create-page .primary-btn{background:var(--app-primary);color:var(--app-primary-on-solid)}.create-page .secondary-btn{background:var(--app-surface-muted);color:var(--app-text);border:1rpx solid var(--app-border-strong)}.section>.secondary-btn,.state-card>button{margin-top:20rpx;width:100%}.create-page button[disabled]{background:var(--app-surface-muted);color:var(--app-text-secondary);border:1rpx solid var(--app-border)}.create-page .text-btn{background:transparent;color:var(--app-primary-text);min-height:70rpx;padding:14rpx;font-size:25rpx}.create-page .search-btn{background:var(--app-primary-soft);color:var(--app-primary-text);min-height:64rpx;font-size:25rpx;padding:14rpx;flex:none}
.choices{display:flex;gap:14rpx;margin-top:14rpx}.create-page .choice{flex:1;min-width:0;background:var(--app-surface-muted);color:var(--app-text);border:1rpx solid var(--app-border-strong);font-size:26rpx}.create-page .choice.active{background:var(--app-primary-soft);color:var(--app-primary-text);border:2rpx solid var(--app-primary-text);padding:20rpx 17rpx}
.selected-customer,.customer-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:16rpx;padding:18rpx;border:1rpx solid var(--app-border);border-radius:14rpx;background:var(--app-surface-muted);overflow-wrap:anywhere}.selected-customer>view,.customer-row>view{flex:1;min-width:0}.customer-row>text{color:var(--app-primary-text);flex:none}.map-result{margin-top:16rpx;padding:18rpx;background:var(--app-success-soft);color:var(--app-success-text);border-radius:14rpx;line-height:1.6}.map-result .hint{color:var(--app-success-text)}
.pricing-item{margin-top:20rpx;padding:20rpx;border:1rpx solid var(--app-border);border-radius:16rpx;background:var(--app-surface-muted)}.item-head{display:flex;justify-content:space-between;align-items:center;font-weight:700}.pair{display:flex;gap:16rpx}.pair>.field{flex:1;min-width:0}.money-row{display:flex;justify-content:space-between;gap:16rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid var(--app-border);font-size:27rpx;line-height:1.6}.money-row>text:last-child{font-weight:700;color:var(--app-primary-text);text-align:right;overflow-wrap:anywhere}.review-row{display:flex;justify-content:space-between;gap:22rpx;margin-top:20rpx;line-height:1.7}.review-row>text{flex:none;color:var(--app-text-secondary);max-width:42%}.review-row>view{flex:1;min-width:0;text-align:right;overflow-wrap:anywhere;white-space:pre-wrap}.review-item{margin-top:18rpx;padding:18rpx;background:var(--app-surface-muted);border-radius:12rpx;line-height:1.7;overflow-wrap:anywhere}.review-item>text{display:block;text-align:right;font-weight:700}
.error-text,.error-banner{margin-top:16rpx;color:var(--app-danger-text);font-size:26rpx;line-height:1.65;overflow-wrap:anywhere}.error-banner{margin:22rpx;padding:20rpx 24rpx;background:var(--app-danger-soft);border:1rpx solid var(--app-danger-border);border-radius:14rpx}.create-footer{position:fixed;z-index:20;bottom:0;left:0;right:0;display:flex;gap:16rpx;background:var(--app-surface);border-top:1rpx solid var(--app-border);padding:20rpx 24rpx;padding-bottom:calc(20rpx + constant(safe-area-inset-bottom));padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}.create-footer>button{flex:1;min-width:0}.success-icon{display:block;font-size:80rpx;color:var(--app-success-text);margin:12rpx 0}.order-id{margin:18rpx 0;overflow-wrap:anywhere;line-height:1.6}

.category-choices{display:flex;flex-wrap:wrap;gap:14rpx}.category-choices .choice{flex:none;min-width:150rpx;max-width:100%}.created-media-section{text-align:left;margin-top:22rpx}.created-media-rule{padding:22rpx 0;border-top:1rpx solid var(--app-border)}.created-media-rule button{margin-top:16rpx;width:100%}.pair>picker{flex:1;min-width:0}
.created-media-grid{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.created-media-grid image{width:140rpx;height:140rpx;border-radius:12rpx;background:var(--app-surface-muted)}
