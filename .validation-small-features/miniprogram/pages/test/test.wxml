<!--pages/test/test.wxml-->

<view class="page" data-weui-theme="{{theme}}">
  <view class="page__bd">
    <view class="weui-search-bar {{inputShowed ? 'weui-search-bar_focusing' : ''}}" id="searchBar">
      <form class="weui-search-bar__form">
        <view class="weui-search-bar__box">
          <i class="weui-icon-search"></i>
          <input type="text" class="weui-search-bar__input" placeholder="搜索" value="{{inputVal}}" focus="{{inputShowed}}" bindinput="inputTyping" />
          <span class="weui-icon-clear" wx:if="{{inputVal.length > 0}}" bindtap="clearInput"></span>
        </view>
        <label class="weui-search-bar__label" bindtap="showInput">
          <i class="weui-icon-search"></i>
          <span class="weui-search-bar__text">搜索</span>
        </label>
      </form>
      <view class="weui-search-bar__cancel-btn" bindtap="hideInput">取消</view>
    </view>
    <view class="weui-cells searchbar-result" wx:if="{{inputVal.length > 0}}" wx:key="{{search_list1}}">
      <navigator url="./book?whatbook={{item.sx}}" class="weui-cell" hover-class="weui-cell_active">
        <view class="weui-cell__bd">
          <view>师傅：{{item.name}}</view>
        </view>
      </navigator>
    </view>
  </view>
</view>

<view>
  <image src="cloud://worker-real.776f-worker-real-1301382302/public/qr/weixin.png" show-menu-by-longpress="true" mode="widthFix"/>
</view>

<view class="padding-lr margin-top-xl margin-bottom-sm text-grey text-sm">实验功能</view>
<view class="cu-list menu card-menu shadow-lg radius">
  <view class="cu-item arrow">
    <button class="cu-btn content" open-type="feedback">
      <text class="cuIcon-writefill text-cyan"></text>
      <text class="text-black" style="font-weight:normal;">意见反馈</text>
    </button>
  </view>
</view>

<view class="padding-lr margin-top-xl margin-bottom-sm text-grey text-sm">旧版功能</view>
<view class="cu-list menu card-menu margin-bottom-xl shadow-lg radius">
  <view class="cu-item arrow">
    <button class="cu-btn content" bindtap="goSizeMark2">
      <text class="cuIcon-pic text-green"></text>
      <text class="text-black" style="font-weight:normal;">图片标注工具</text>
    </button>
  </view>
  <view class="cu-item arrow">
    <button class="cu-btn content" bindtap="goPact">
      <text class="cuIcon-text text-grey"></text>
      <text class="text-black" style="font-weight:normal;">相关协议</text>
    </button>
  </view>
  <view class="cu-item arrow">
    <button class="cu-btn content" data-name="shareBtn" open-type="share">
      <text class="cuIcon-share text-green"></text>
      <text class="text-black" style="font-weight:normal;">分享好友</text>
    </button>
  </view>
  <view class="cu-item arrow">
    <button class="cu-btn content" open-type="contact" bindcontact="handleContact">
      <text class="cuIcon-servicefill text-orange"></text>
      <text class="text-black" style="font-weight:normal;">原生客服（禁用）</text>
    </button>
  </view>
</view>

