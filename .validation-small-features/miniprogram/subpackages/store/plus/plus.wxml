<form>
	<view class="cu-form-group">
		<view class="title">门店昵称</view>
		<input bindinput="bindKeyInput" data-key="StoreName" placeholder="请输入"></input>
	</view>
  <view class="cu-form-group">
		<view class="title">是否有店</view>
		<switch checked="{{hasStore}}" bindchange="hasStoreChange"></switch>
	</view>
  <view class="cu-form-group">
		<view class="title">墙布类型</view>
		<input bindinput="bindKeyInput" data-key="StoreType" placeholder="胶膜/网膜/淋膜热胶 3.6超高 进口墙纸等"></input>
	</view>
  <view class="cu-form-group">
    <view class="title">商品价位</view>
    <input bindinput="bindKeyInput" data-key="StorePaid" placeholder="请输入 主营商品（带上单位）"></input>
  </view>
  <view class="cu-form-group">
    <view class="title" bindtap="showToast">更多商品</view>
    <view class="cuIcon-info flex-twice margin-xs" bindtap="showToast"></view>
    <view class="page-section page-section-gap">
      <checkbox-group bindchange="doMore_Change">
        <view class="flex justify-end">
        <label><checkbox class="round green margin-sm" value="doEVA" checked="{{doEVA}}"></checkbox>有热胶</label>
        <label><checkbox class="round green margin-sm" value="doCurtain"  checked="{{doCurtain}}"></checkbox>窗帘</label>
        <label><checkbox class="round green margin-sm" value="doWallPaneling"  checked="{{doWallPaneling}}"></checkbox>软硬包</label>
        </view>
        <view class="flex justify-end">
        <label><checkbox class="round green margin-sm" value="dotArtpaint"  checked="{{dotArtpaint}}"></checkbox>艺术漆</label>
        <label><checkbox class="round green margin-sm" value="doPaint"  checked="{{doPaint}}"></checkbox>油漆</label>
        <label><checkbox class="round green margin-sm" value="doDecorPic"  checked="{{doDecorPic}}"></checkbox>装饰画</label>
        </view>
      </checkbox-group>
    </view>
	</view>
  <view class="cu-form-group">
		<view class="title">上门送样</view>
		<switch checked="{{getHome}}" bindchange="getHomeChange"></switch>
	</view>
  <view wx:if="{{getHome}}" class="cu-form-group">
		<view class="title">自送收费</view>
    <input bindinput="bindKeyInput" data-key="money" placeholder="请输入 报价或免费"></input>
	</view>
  <!-- 4.20 统一定价 -->
  <view class="cu-form-group">
    <navigator class="title text-orange" url="/pages/h5/h5?title=bbs51">平台帮售</navigator>
    <navigator class="cuIcon-info flex-twice margin-xs text-gray" url="/pages/h5/h5?title=bbs51"> 查看详情（必须同意）</navigator>
    <switch checked="{{platformSells}}" disabled="true"></switch>
  </view>


  <view class="cu-form-group  margin-top">
		<view class="title">开店日期</view>
		<picker mode="date" value="{{storeTime}}" bindchange="storeTimeChange">
      <view class="picker" wx:if="{{storeTime != StartDate}}">{{storeTime}}</view>
			<view class="picker" wx:else>
				请选择
			</view>
		</picker>
	</view>

  <view class="cu-form-group">
		<view class="title">发布日期</view>
			<view class="picker">
				{{StartDate}}
			</view>
		<!-- </picker> -->
	</view>

	<view class="cu-form-group" bindtap="chooseLocation">
		<view class="title">所在地址</view>
		<text class="text-orange "><text class="cuIcon-locationfill"></text>{{location.name || '点击选择地址'}}</text>
	</view>
  
	<view class="cu-form-group align-start">
		<view class="title">发布内容</view>
		<textarea maxlength="-1" bindinput="bindKeyInput" data-key="content" placeholder="请输入 能提供的服务、商品等（禁止手机号）"></textarea>
	</view>
	<view class="cu-bar bg-white solid-top">
	  <view class="action text-black">门面照/内部环境（手机号请打码）</view>
		<view class="action">
			{{imgList.length}}/3
		</view>
	</view>
	<view class="cu-form-group">
		<view class="grid col-3 grid-square flex-sub">
			<view class="bg-img" wx:for="{{imgList}}" wx:key="index" bindtap="ViewImage" data-url="{{imgList[index]}}">
				<image src='{{imgList[index]}}' mode='aspectFill'></image>
				<view class="cu-tag bg-red" catchtap="DelImg" data-index="{{index}}">
					<text class="cuIcon-close"></text>
				</view>
			</view>
			<view class="solids" bindtap="ChooseImage" wx:if="{{imgList.length<3}}">
				<text class="cuIcon-cameraadd"></text>
			</view>
		</view>
	</view>

	<view class="padding-xs bg-white">
    <view wx:for="{{PlusPrompt}}" wx:key="index">
      <view class="cuIcon-infofill padding-xs text-grey"> {{item.text}}
      </view>
    </view>
	</view>

	<button class='margin cu-btn bg-green shadow lg block' bindtap="tapPublish">发布</button>
</form>



<view class="weui-footer">
	<view class="text-gray padding-bottom">Powered By 壁选 © 2013-现在</view>
</view>
<!-- 自定义tab遮挡解决 -->
<view style="width: 100%;height: calc(150rpx + env(safe-area-inset-bottom) / 2);"></view>

<!-- 登录弹窗 -->
<auth is-show="{{isShowAuth}}" bind:onAuthEvent="onAuthEvent" bind:onAuthClose="onAuthClose"></auth>