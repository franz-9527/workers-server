:host{display:block;position:relative;z-index:55}
.fullscreen-nav-spacer{width:100%;pointer-events:none}
.fullscreen-nav{position:fixed;left:0;right:0;top:0;z-index:55;box-sizing:border-box;background:transparent;border-bottom:1rpx solid transparent;transition:background .18s ease,border-color .18s ease,box-shadow .18s ease;pointer-events:none}
.fullscreen-nav.is-solid{background:rgba(247,249,248,.96);border-bottom-color:rgba(210,220,216,.78);box-shadow:0 4rpx 18rpx rgba(33,58,47,.045);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.fullscreen-nav-inner{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:0 184rpx 0 92rpx;pointer-events:none}
.fullscreen-nav-back{position:absolute;left:16rpx;top:50%;display:flex;align-items:center;justify-content:center;width:68rpx;height:60rpx;border-radius:18rpx;transform:translateY(-50%);transition:background .15s ease,transform .15s ease,border-color .15s ease;pointer-events:auto}
.fullscreen-nav-back:active{transform:translateY(-50%) scale(.96)}
.fullscreen-nav-back-hover{background:rgba(255,255,255,.14)}
.fullscreen-nav-chevron{width:20rpx;height:20rpx;box-sizing:border-box;transform:rotate(45deg)}
.tone-dark .fullscreen-nav-back{background:rgba(255,255,255,.42);border:1rpx solid rgba(36,56,47,.08);box-shadow:0 4rpx 16rpx rgba(23,44,33,.06)}
.tone-dark .fullscreen-nav-chevron{border-left:4rpx solid #26382f;border-bottom:4rpx solid #26382f}
.tone-light .fullscreen-nav-back{background:rgba(255,255,255,.13);border:1rpx solid rgba(255,255,255,.20);box-shadow:0 4rpx 18rpx rgba(38,25,8,.08);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.tone-light .fullscreen-nav-chevron{border-left:4rpx solid #fff;border-bottom:4rpx solid #fff}
.fullscreen-nav.is-solid .fullscreen-nav-back{background:transparent;border-color:transparent;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none}
.fullscreen-nav.is-solid .fullscreen-nav-chevron{border-color:#26382f}
.fullscreen-nav.tone-light:not(.is-solid) .fullscreen-nav-title{color:#fff}
.fullscreen-nav-title{max-width:340rpx;color:#26382f;font-size:29rpx;font-weight:650;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}
@media (prefers-color-scheme:dark){
  .fullscreen-nav.is-solid{background:rgba(17,24,21,.96);border-bottom-color:rgba(73,91,82,.62);box-shadow:none}
  .tone-dark .fullscreen-nav-back{background:rgba(36,49,42,.78);border-color:rgba(255,255,255,.06);box-shadow:none}
  .tone-dark .fullscreen-nav-chevron,.fullscreen-nav.is-solid .fullscreen-nav-chevron{border-color:#eef4f0}
  .fullscreen-nav-title{color:#eef4f0}
}

.fullscreen-nav-test+.fullscreen-nav-title{margin-left:10rpx}
.fullscreen-nav-test{flex:none;padding:8rpx 14rpx;background:#fff0be;color:#765500;border:1rpx solid #d5a32b;border-radius:12rpx;font-size:22rpx;font-weight:700;line-height:1.3;pointer-events:none}

.fullscreen-nav-title{min-width:0;flex:1}
