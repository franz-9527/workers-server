<view class="product-field-control">
  <view wx:if="{{field.component_type === 'category_picker'}}" class="category-picker">
    <view class="category-tip"><text>可多选；暂不确定和其他单独选择</text><text>{{selectedCategoryIds.length}}/6</text></view>
    <view class="category-grid">
      <view wx:for="{{categories}}" wx:for-item="category" wx:key="id" class="category-choice {{category.selected ? 'selected' : ''}}" data-id="{{category.id}}" bindtap="toggleCategory">{{category.name}}</view>
      <view class="category-choice {{answers.category_mode === 'unknown' ? 'selected' : ''}}" data-special="unknown" bindtap="toggleCategory">暂不确定</view>
      <view class="category-choice {{answers.category_mode === 'other' ? 'selected' : ''}}" data-special="other" bindtap="toggleCategory">其他</view>
    </view>
    <input wx:if="{{answers.category_mode === 'other'}}" class="input category-other-input" value="{{answers.category_other}}" maxlength="50" disabled="{{field.runtime_disabled}}" placeholder="请填写具体类目" bindinput="inputCategoryOther"/>
    <view class="category-result">当前：{{selectedCategoryName}}</view>
  </view>

  <view wx:elif="{{field.component_type === 'radio' || field.component_type === 'single' || (field.component_type === 'boolean' && field.runtime_options.length)}}" class="option-group">
    <view wx:for="{{field.runtime_options}}" wx:for-item="option" wx:key="option_key" class="option option-tappable {{option.checked ? 'selected' : ''}} {{field.runtime_disabled ? 'disabled' : ''}}" data-value="{{option.value_text}}" bindtap="tapSingle"><text class="single-option-check cuIcon-{{option.checked ? 'roundcheckfill' : 'round'}}"></text><text>{{option.label}}</text></view>
  </view>

  <checkbox-group wx:elif="{{field.component_type === 'checkbox' || field.component_type === 'multiple'}}" bindchange="checkboxChange" class="option-group">
    <label wx:for="{{field.runtime_options}}" wx:for-item="option" wx:key="option_key" class="option"><checkbox disabled="{{field.runtime_disabled}}" value="{{option.value_text}}" checked="{{option.checked}}" color="#00b9cb"/>{{option.label}}</label>
  </checkbox-group>

  <view wx:elif="{{field.component_type === 'switch' || (field.component_type === 'boolean' && !field.runtime_options.length)}}" class="switch-line"><switch disabled="{{field.runtime_disabled}}" checked="{{field.runtime_value ? true : false}}" color="#00b9cb" bindchange="switchChange"/><text>{{field.runtime_value ? '是' : '否'}}</text></view>

  <input wx:else class="input" disabled="{{field.runtime_disabled}}" value="{{field.runtime_value}}" placeholder="{{field.placeholder || '请输入商品资料'}}" maxlength="{{field.validation.max_length || 500}}" bindinput="inputChange"/>
</view>
