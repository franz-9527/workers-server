page{background:#f4f7f8!important}.income-page{--bg:#f4f7f8;--surface:#fff;--surface-soft:#f6f9fa;--text:#293a3f;--muted:#748488;--border:#dde7e9;--primary:#00aebd;--primary-soft:#e8f8fa;--warning:#9a6818;--warning-soft:#fff6e7;min-height:100vh;box-sizing:border-box;padding:150rpx 22rpx calc(48rpx + env(safe-area-inset-bottom));background:var(--bg);color:var(--text)}.page-state,.state-card,.summary-card,.form-card{border:1rpx solid var(--border);border-radius:22rpx;background:var(--surface);box-shadow:0 8rpx 28rpx rgba(35,70,76,.06)}.page-state{padding:130rpx 24rpx;text-align:center;color:var(--muted)}.spin{display:inline-block;margin-right:8rpx;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.state-card{padding:70rpx 30rpx;text-align:center}.state-icon{display:block;color:var(--primary);font-size:74rpx}.state-title{margin-top:16rpx;font-size:31rpx;font-weight:700}.state-desc{margin-top:12rpx;color:var(--muted);font-size:23rpx;line-height:1.7}.summary-card{padding:26rpx}.summary-label{color:var(--muted);font-size:22rpx}.summary-value{margin-top:5rpx;font-size:26rpx;font-weight:700;overflow-wrap:anywhere}.mono{font-family:monospace}.summary-row{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--border);font-size:24rpx}.money{color:var(--primary);font-size:38rpx;font-weight:750}.summary-note{margin-top:18rpx;padding:16rpx;border-radius:14rpx;background:var(--primary-soft);color:#24727b;font-size:22rpx;line-height:1.65}.form-card{margin-top:18rpx;padding:26rpx}.field+.field{margin-top:26rpx}.field-label{font-size:24rpx;font-weight:700}.required{color:#d65049}.money-input,.text-input,.note-input{width:100%;box-sizing:border-box;margin-top:10rpx;border:1rpx solid var(--border);border-radius:15rpx;background:var(--surface-soft);color:var(--text);font-size:25rpx}.money-input{display:flex;align-items:center;height:86rpx;padding:0 18rpx}.money-input>text{margi