page{min-height:100%;background:#f3f7f8}.entry-page{min-height:100vh;box-sizing:border-box;padding:120rpx 32rpx 60rpx;display:flex;align-items:flex-start;justify-content:center}.entry-card{width:100%;max-width:680rpx;box-sizing:border-box;padding:52rpx 34rpx 38rpx;border-radius:28rpx;background:#fff;box-shadow:0 18rpx 55rpx rgba(31,72,80,.10);text-align:center}.entry-icon{font-size:78rpx;color:#00aebd}.entry-title{margin-top:20rpx;color:#23383d;font-size:36rpx;font-weight:750}.entry-status,.entry-error{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:30rpx;padding:20rpx;border-radius:18rpx;font-size:25rpx;line-height:1.55}.entry-status{background:#effafb;color:#26727a}.entry-status--ok{background:#edf9f2;color:#258354}.entry-error{align-items:flex-start;background:#fff2ef;color:#b45543;text-align:left}.entry-error>text{margin-top:4rpx}.entry-note{margin-top:26rpx;color:#829195;font-size:22rpx;line-height:1.7}.entry-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:30rpx}.entry-btn{display:flex!important;align-items:center;justify-content:center;min-height:82rpx;margin:0!important;border:0!important;border-radius:42rpx!important;background:#eef3f4!important;color:#53676b!important;font-size:25rpx!important}.entry-btn::after{border:0!important}.entry-btn--primary{background:#00aebd!important;color:#fff!important}.entry-spin{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media(prefers-color-scheme:dark){page{background:#101718}.entry-card{background:#1b2426;box-shadow:none}.entry-title{color:#eef5f6}.entry-status{background:#16383c;color:#8ce3e9}.entry-status--ok{background:#17382b;color:#8cddb0}.entry-error{background:#3a2421;color:#f0a89b}.entry-note{color:#91a1a5}.entry-btn{background:#273235!important;color:#c5d0d2!important}.entry-btn--primary{background:#008f9d!important;color:#fff!important}}