.kyc-page{min-height:100vh;background:#f4f7f8;padding:22rpx 24rpx 180rpx;color:#273437}.legal-tip{display:flex;gap:14rpx;padding:24rpx;border-radius:18rpx;background:#fff7ee;line-height:1.65;color:#654e3d}.legal-tip>text:first-child{font-size:34rpx;flex:none}.status-card,.form-card,.photo-card,.result-card{margin-top:22rpx;padding:30rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 25rpx rgba(45,72,78,.05)}.status-card{position:relative}.status{position:absolute;right:26rpx;top:30rpx;padding:10rpx 18rpx;border-radius:25rpx;background:#f0f4f5;color:#65777b}.status.approved{background:#e9f8f0;color:#168957}.status.pending{background:#fff3df;color:#c26b16}.reason,.orange-tip{margin-top:20rpx;padding:18rpx;border-radius:13rpx;background:#fff6ec;color:#c56b2b;line-height:1.65}.form-row{display:flex;align-items:center;min-height:108rpx;border-bottom:1rpx solid #edf1f2}.form-row:last-child{border-bottom:0}.form-row>text{width:190rpx;font-weight:700}.form-row input{flex:1}.id-photo{height:300rpx;margin:28rpx auto 10rpx;border:2rpx dashed #f1a05b;border-radius:22rpx;background:#fff9f3;overflow:hidden;display:flex;align-items:center;justify-content:center}.id-photo image{width:100%;height:100%}.id-photo>view{text-align:center;color:#e88536}.id-photo>view text{display:block}.id-photo>view small{display:block;margin-top:10rpx;font-size:22rpx;color:#7e9488}.id-photo .cuIcon-cameraadd{font-size:70rpx;margin-bottom:14rpx}.replace{font-size:24rpx;color:#df792c;background:transparent}.bottom{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:24rpx 44rpx calc(24rpx + env(safe-area-inset-bottom));z-index:10}.result-card{text-align:center;padding:80rpx 30rpx}.result-card>text:first-child{font-size:110rpx;display:block;margin-bottom:25rpx}@media (prefers-color-scheme:dark){.kyc-page{background:#101718;color:#ecf4f5}.status-card,.form-card,.photo-card,.result-card,.bottom{background:#192426}.form-row{border-color:#314044}.form-row input{color:#fff}.legal-tip{background:#2c251f;color:#f0d6bd}.id-photo{background:#2a241f}}

/* 实名认证属于师傅功能，统一采用绿色身份色。 */
.kyc-page{background:#f3faf6}.legal-tip{background:#eaf8f0;color:#276347}.reason,.orange-tip{background:#edf9f2;color:#278159}.id-photo{border-color:#6bc394;background:#f2fbf6}.id-photo>view,.replace{color:#168c59}.worker-primary{background:linear-gradient(135deg,#36bd7e,#118f5a)}
@media (prefers-color-scheme:dark){.legal-tip,.reason,.orange-tip{background:#173426;color:#b8ecd1}.id-photo{background:#163124;border-color:#377c58}.worker-primary{background:linear-gradient(135deg,#269963,#0b7045)}}
.id-photo{position:relative}.photo-replace{position:absolute;left:0;right:0;bottom:0;padding:14rpx;text-align:center;background:rgba(9,85,53,.76);color:#fff;font-size:23rpx}.ocr-badge{position:absolute;right:16rpx;top:16rpx;padding:8rpx 14rpx;border-radius:22rpx;background:rgba(13,126,80,.9);color:#fff;font-size:21rpx;z-index:2}.ocr-badge text{margin-right:5rpx}.card-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.ocr-source{flex:none;padding:7rpx 13rpx;border-radius:18rpx;background:#e6f6ed;color:#168c59;font-size:20rpx}.form-hint{margin:-4rpx 0 10rpx;color:#5c7e6c;font-size:22rpx;line-height:1.55}.form-hint text{margin-right:8rpx}.result-note{margin-top:20rpx;color:#74877d;font-size:23rpx;line-height:1.55}.reauth-btn{margin-top:26rpx;min-width:220rpx}.watermark-canvas{position:fixed;left:-200vw;top:0;width:300px;height:150px;opacity:.01;pointer-events:none}
@media (prefers-color-scheme:dark){.ocr-source{background:#173426;color:#b8ecd1}.form-hint{color:#9fc7b1}.result-note{color:#9db4a8}.id-photo>view small{color:#8fb09d}}
