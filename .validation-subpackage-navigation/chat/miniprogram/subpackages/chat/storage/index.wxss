page{background:var(--page-bg,#f4f5f7);color:var(--text-primary,#20252b)}.cache-page{padding:24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));font-size:28rpx}.cache-card{background:var(--card-bg,#fff);border-radius:20rpx;padding:28rpx;margin-bottom:24rpx}.cache-label,.cache-hint{color:var(--text-secondary,#68727d);font-size:24rpx;line-height:1.7}.cache-total{font-size:52rpx;font-weight:600;margin:16rpx 0}.cache-title{font-weight:600;margin-bottom:20rpx}.cache-options{display:flex;flex-wrap:wrap;gap:16rpx;margin-bottom:20rpx}.cache-choice{margin:0;font-size:26rpx;background:var(--page-bg,#f4f5f7);color:inherit;padding:0 24rpx}.cache-choice.selected,.cache-action{background:#00b9cb;color:#fff}.cache-action{margin-top:24rpx;font-size:28rpx}.cache-row{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-top:1rpx solid var(--border-color,#e9edf0)}.cache-copy{flex:1;min-width:0;overflow-wrap:anywhere}.cache-row button{flex-shrink:0;margin:0}@media(prefers-color-scheme:dark){page{--page-bg:#15191e;--card-bg:#222830;--text-primary:#edf2f7;--text-secondary:#aeb8c4;--border-color:#35404b}}

.cache-page{padding:24rpx 0 calc(36rpx + env(safe-area-inset-bottom));background:#ededed;color:#202526}
.cache-page .cache-card{margin:0 0 20rpx;padding:24rpx 28rpx;border-radius:0;background:#fff}
.cache-page .cache-label,.cache-page .cache-title{font-size:30rpx;font-weight:500;line-height:1.6}.cache-page .cache-hint{font-size:24rpx;line-height:1.6;color:#667075}
.cache-page .cache-options{display:flex;flex-direction:column;gap:0;margin:16rpx 0}.cache-page .cache-choice{min-height:88rpx;margin:0;padding:22rpx 0;background:transparent;text-align:left;line-height:1.5;font-size:30rpx;border-bottom:1rpx solid #e8e8e8;border-radius:0;color:#202526}
.cache-page .cache-choice.selected{background:transparent;color:#007381}.cache-page .cache-choice::after{border:0}
.cache-page .cache-action{background:#007381;color:#fff;min-height:88rpx;line-height:1.5;padding:22rpx;margin-top:24rpx;border-radius:12rpx}
.cache-page .cache-row{border-color:#e8e8e8;min-height:100rpx}.cache-page .cache-row button{background:transparent;color:#a33636;min-height:88rpx;font-size:26rpx;margin:0}
@media(prefers-color-scheme:dark){.cache-page{background:#111;color:#e8e8e8}.cache-page .cache-card{background:#191919}.cache-page .cache-hint{color:#b2b8bb}.cache-page .cache-choice{color:#e8e8e8;border-color:#333}.cache-page .cache-choice.selected{color:#8bdce5}.cache-page .cache-row{border-color:#333}.cache-page .cache-row button{color:#ffacb0}}

.cache-page{box-sizing:border-box;min-height:100vh}

.cache-page .cache-action{display:block;width:100%}.cache-page .cache-row button{min-width:88rpx}
