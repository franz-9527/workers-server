<view wx:if="{{visible}}" class="measurement-archive">
  <view class="archive-head">
    <view><view class="archive-title">前置测量成果</view><view class="archive-subtitle">测量阶段已结束，成果只读保留，供核价与施工复核。</view></view>
    <text class="archive-badge">只读</text>
  </view>
  <view wx:for="{{spaces}}" wx:key="id" class="archive-space">
    <view class="archive-space-name">{{item.name}}</view>
    <view class="archive-media">
      <view wx:for="{{item.media}}" wx:for-item="file" wx:key="id" class="archive-media-item">
        <image src="{{file.url}}" mode="aspectFill" data-space="{{item.id}}" data-url="{{file.url}}" bindtap="preview"></image>
        <text>{{file.purpose_text}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{!spaces.length}}" class="archive-empty">测量成果已归档，暂无可展示图片。</view>
</view>
