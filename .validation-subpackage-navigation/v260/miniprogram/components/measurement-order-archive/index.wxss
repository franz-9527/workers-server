.measurement-archive{margin-top:20rpx;padding:28rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(0,0,0,.05)}
.archive-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.archive-title{font-size:30rpx;font-weight:700;color:#222}.archive-subtitle{margin-top:8rpx;font-size:24rpx;line-height:1.6;color:#87909a}.archive-badge{flex:none;padding:6rpx 16rpx;border-radius:999rpx;background:#eef8f9;color:#00a8b8;font-size:22rpx}.archive-space{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #eef0f2}.archive-space-name{font-size:26rpx;font-weight:600;color:#333}.archive-media{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}.archive-media-item{width:180rpx}.archive-media-item image{display:block;width:180rpx;height:140rpx;border-radius:14rpx;background:#f4f5f6}.archive-media-item text{display:block;margin-top:8rpx;font-size:22rpx;color:#7b838c}.archive-empty{margin-top:20rpx;font-size:24rpx;color:#999}
