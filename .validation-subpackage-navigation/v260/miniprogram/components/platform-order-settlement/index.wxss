.pos-card{margin:24rpx;border-radius:24rpx;background:#fff;box-shadow:0 7rpx 32rpx rgba(32,81,99,.06);padding:28rpx 26rpx;color:#243646;overflow:hidden}
.pos-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:20rpx}
.pos-heading-text{min-width:0;flex:1}
.pos-title{font-size:32rpx;font-weight:650;line-height:1.45}
.pos-subtitle{margin-top:7rpx;color:#82909e;font-size:23rpx}
.pos-badge{border-radius:99rpx;background:#eef4ff;color:#416a9b;padding:9rpx 16rpx;font-size:22rpx;white-space:nowrap}
.pos-status{display:flex;align-items:center;gap:10rpx;border-radius:14rpx;padding:14rpx 16rpx;font-size:22rpx;line-height:1.5;background:#edf7fa;color:#28778b;margin-bottom:12rpx}
.pos-status.awaiting_platform_income{background:#fff4e6;color:#a66414}
.pos-status.settled{background:#e8f7f1;color:#167758}
.pos-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:14rpx 0;font-size:25rpx;color:#526371;border-bottom:1rpx solid #f1f3f5}
.pos-row text:last-child{color:#2c404c;font-variant-numeric:tabular-nums;text-align:right}
.pos-row:last-of-type{border-bottom:0}
.pos-mode{color:#179386!important;background:#f0f8f6;border-radius:12rpx;padding:8rpx 13rpx;font-weight:500;font-size:21rpx}
.pos-strong{font-size:29rpx!important;font-weight:650}
.pos-green{color:#128a6c!important}
.pos-note{line-height:1.65;font-size:22rpx;color:#7b8994;margin-top:14rpx}
.pos-income-note{color:#667a85}
.pos-muted{color:#99a3ab}
@media (prefers-color-scheme: dark){
.pos-card{background:#20272c;color:#e5edef;box-shadow:none}
.pos-subtitle,.pos-note{color:#9ca9b0}
.pos-badge{background:#303e52;color:#a9c9ef}
.pos-status{background:#25444b;color:#a7dbe6}
.pos-status.awaiting_platform_income{background:#4c3b28;color:#f0bf85}
.pos-status.settled{background:#25483a;color:#90dfb1}
.pos-row{color:#b4c8c5;border-color:#363f45}
.pos-row text:last-child{color:#e7eeef}
.pos-mode{background:#254e49;color:#94e6d9!important}
.pos-green{color:#73d8b2!important}
.pos-income-note{color:#bac9cd}
.pos-muted{color:#89979e}
}
