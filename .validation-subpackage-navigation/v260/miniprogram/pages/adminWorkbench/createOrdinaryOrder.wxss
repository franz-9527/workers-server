.proxy-create-page{padding:24rpx;min-height:100vh;background:#f5f7f8;box-sizing:border-box}.proxy-create-card{background:#fff;color:#24343e;padding:28rpx;border-radius:20rpx;margin-bottom:20rpx;overflow-wrap:anywhere}.proxy-create-title{font-size:32rpx;font-weight:600}.proxy-create-hint{font-size:25rpx;color:#657681;line-height:1.7;margin-top:14rpx}.proxy-create-search{display:flex;gap:16rpx;margin-top:24rpx;align-items:center}.proxy-create-search input{flex:1;min-width:0;font-size:28rpx}.proxy-create-search button{flex:none;margin:0;padding:0 24rpx;font-size:27rpx;background:#00a8b8;color:#fff}.proxy-create-error{color:#b85428;font-size:26rpx;margin-top:18rpx}.proxy-create-action{color:#008b9c;font-size:27rpx;margin-top:20rpx}@media(prefers-color-scheme:dark){.proxy-create-page{background:#11171c}.proxy-create-card{background:#1c252c;color:#e6eef2}.proxy-create-hint{color:#a3b3be}.proxy-create-action{color:#5bd5df}.proxy-create-error{color:#ffb080}}
