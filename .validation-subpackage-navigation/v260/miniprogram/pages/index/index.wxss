/* 搜索地址 */
.fake{
  padding:30rpx 25rpx 25rpx 25rpx;
  /* 并排2个 */
  display: flex;
  align-items: center;
}
.fakeSearchWrapper {
  width: 100%;
  /* background-color: #fff; */
  /* 并排2个 */
  display: flex;
  justify-content: space-between;
}
.fakeSearch {
  width: 700rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
  box-sizing: border-box;
  text-align: center;
  /* 并排2个 */
  flex-grow: 1; 
  margin: 0 5rpx;
}
.fakeSearch text {
  color: #808080;
  font-size: 32rpx;
  line-height: 80rpx;
}
/* 暗色模式样式覆盖 */
@media (prefers-color-scheme: dark) {
  .fakeSearch { /* 注意这里从ID选择器改回了类选择器 */
      background-color: rgb(24, 24, 24); /* 深色背景 */
  }
  .fakeSearch text { /* 同样，这里也应对应到类选择器下的文本 */
      color: rgb(122, 122, 122); /* 中灰文本颜色，以适应暗色背景 */
  }
}

/* 首页横向导航：露出下一项，并用轻微渐隐提示可继续滑动 */
.plate-section {
  position: relative;
  border-bottom: 1rpx solid #f0f3f3;
}
.plate-edge-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, .55));
  pointer-events: none;
}
.plate {
  width: 100%;
}
.plate-track {
  padding: 22rpx 24rpx 22rpx;
  white-space: nowrap;
}
.plate-item {
  display: inline-flex;
  vertical-align: top;
  flex-direction: column;
  align-items: center;
  width: 156rpx;
  margin-right: 12rpx;
}
.plate-item:last-child {
  margin-right: 0;
}
.plate-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 106rpx;
  height: 106rpx;
  border-radius: 26rpx;
  background: #f5f9f9;
}
.plate-img image {
  width: 86rpx;
  height: 86rpx;
}
.plate-info {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: #34474b;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (prefers-color-scheme: dark) {
  .plate-section.bg-white {
    background-color: #192629;
    border-bottom-color: #2d4145;
  }
  .plate-edge-fade {
    background: linear-gradient(90deg, rgba(25, 38, 41, 0), rgba(25, 38, 41, .55));
  }
  .plate-img {
    background-color: #26373a;
  }
  .plate-info {
    color: #e7f0f1;
  }
}
