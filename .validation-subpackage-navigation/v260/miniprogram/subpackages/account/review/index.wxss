/* 2026-08-08：固定审核类型与搜索区域，滚动记录时始终可以快速切换。 */
.audit-header {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 99;
}

/* 2026-08-08：双标签沿用 ColorUI 的轻量下划线导航风格。 */
.audit-tabs {
  display: flex;
  height: 88rpx;
}

.audit-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.audit-tab-active {
  font-weight: 600;
}

.audit-tab-active::after {
  position: absolute;
  right: 80rpx;
  bottom: 0;
  left: 80rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background-color: currentColor;
  content: '';
}

/* 2026-08-08：列表顶部避开固定的标签栏和搜索栏。 */
.record-list {
  padding-top: 190rpx;
}

/* 审核行右侧统一为两行右对齐：上方时间/状态，下方通知弱提示。 */
.audit-meta {
  display: flex !important;
  max-width: 340rpx;
  flex-direction: column;
  align-items: flex-end !important;
  justify-content: center;
  margin-left: auto;
  text-align: right;
}
.audit-meta-primary {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  gap: 6rpx;
  white-space: nowrap;
  text-align: right;
}
.review-notice-result {
  display: block;
  max-width: 340rpx;
  margin-top: 4rpx;
  color: #9aa6a1;
  font-weight: 400;
  line-height: 1.3;
  text-align: right;
  white-space: normal;
}

/* 2026-08-08：空数据及加载完成提示保持 ColorUI 的克制留白。 */
.audit-state {
  padding: 40rpx 30rpx;
  text-align: center;
}
