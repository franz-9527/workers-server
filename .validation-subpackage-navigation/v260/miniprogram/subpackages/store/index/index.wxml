<view id="home" class="home">
  <view style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
    <view class="location" bindtap="chooseLocation">
      <text class="cuIcon-location"></text>
      <text class="text-black">{{location.city || '选择城市'}}</text>
    </view>
  </view>
  <swiper class="card-swiper square-dot" indicator-dots="true" circular="true" autoplay="true" interval="5000" duration="500" bindchange="cardSwiper" indicator-color="#8799a3" indicator-active-color="#0081ff">
    <swiper-item wx:for="{{StoreBanner}}" wx:key="index" class="{{cardCur==index?'cur':''}}">
      <view class="swiper-item" bindtap="tapBanner" data-index="{{index}}">
        <image src="{{item.url}}" mode="aspectFill"></image>
      </view>
    </swiper-item>
  </swiper>

<official-account></official-account>

<!-- 滚动条 -->
<swiper class="tips-swiperitem" autoplay="true" vertical="true" circular="true" interval="2000" duration="1000">
  <block wx:for="{{StoreTips}}" wx:key="index">
    <swiper-item catchtouchmove='false' bindtap="tipsClick" data-index="{{index}}">
      <view class="radius-lg bg-orange light" src="{{item.url}}">
        <view class='padding-xs text-xl'>
          <text class='cuIcon-magic text-orange'></text>
          <text class="text-df"> {{item.title}}</text>
        </view>
      </view>
    </swiper-item>
  </block>
</swiper>

<view class="plate bg-white">
  <!-- 4.19 宫格导航增加小程序跳转 -->
  <block wx:for="{{StoreIconList}}" wx:key="index">
    <view class="plate-item" bindtap="handleItemClick" data-index="{{index}}">
      <view class="plate-img">
        <image src="{{item.img}}" mode="aspectFit"></image>
      </view>
      <text class="plate-info">{{item.name}}</text>
    </view>
  </block>
</view>


<!-- 最近门店 -->
  <view class="cu-bar bg-white solid-bottom">
    <view class="action">
      <text class="cuIcon-titles text-red"></text>
      <text class="text-lg text-bold"> 附近门店</text>
    </view>
  </view>

  <!-- 定位城市 -->
    <view class="cu-bar bg-white fake">
    <view class="fakeSearchWrapper">
      <view class="fakeSearch" bindtap="chooseLocation">
        <text>地图搜索</text>
      </view>
    </view>
  </view>

  <view class="cu-list menu-avatar bg-white">
    <view class="cu-item solid-bottom" bindtap="goDetail" data-id="{{item._id}}" wx:for="{{LastStore}}" wx:key="index">
      <view class="cu-avatar round lg" style="background-image:url({{item.image}});"></view>
      <view class="content">
        <view class="text-grey text-cut">【{{item.StoreName}}】{{item.location.district}}{{item.location.name}}</view>
        <view class="text-gray text-sm flex">
          <text class="text-cut">
							<text class="cuIcon-notification text-gray margin-right-xs"></text>{{item.content}}
          </text>
        </view>
      </view>
      <view class="action">
        <view class="text-grey text-xs">{{item.time}}</view>
        <view class="cu-tag round bg-grey sm"><text class="cuIcon-location"></text>{{item.distance}}</view>
      </view>
    </view>
  </view>


<!-- 地图展示 -->
  <view class="cu-bar bg-white solid-bottom">
    <view class="action" >
      <text class="cuIcon-titles text-blue"></text>
      <text class="text-lg text-bold"> 门店地图</text>
    </view>
  </view>
  <!-- joinCluster="true" 点聚合开发未成功-->
  <!-- app.wxss开启深色模式 layer-style：1深色2经典-->
  <map
    id="homeMap"
    style="width: 100%; height:800rpx;"
    latitude="{{location.latitude}}"
    longitude="{{location.longitude}}"
    scale="12"
    markers="{{markers}}"
    bindmarkertap="tapMarker"
    bindcallouttap="tapMarker"
    show-scale="true" 
    show-location="true"
    enable-poi="false"
    bindregionchange="mapRegionChange"
    enable-3D="true"
    subkey="32CBZ-FEPK6-POMSA-MCDE2-M2MIK-ZOBK2"
  >
    <view class="controls">
      <view class="controlsBtn" bindtap="getLocation">
        <image class="img" src="/images/maplocation.png" />
      </view>
    </view>
  </map>
</view>


<!-- 微信客服 -->
<view>  
  <image 
    src="/images/wxkf.png" 
    class="img-plus-style" 
    bindtap="toggleKefu" 
    style="transform: translateX({{isKefuVisible ? '0' : '36%'}}); transition: transform 0.3s;" 
  ></image>
</view>
<view wx:if="{{isKefuVisible}}" bindtap="qwkefu">
  <view style="padding: 10rpx; text-align: center;"></view>
</view>

<view class="weui-footer">
	<view class="text-gray">Powered By 壁选 © 2013-现在 </view>
</view>
<!-- 自定义tab遮挡解决 -->
<view style="width: 100%;height: calc(150rpx + env(safe-area-inset-bottom) / 2);"></view>