.agreement-page{min-height:100vh;padding:28rpx;background:var(--page-bg,#f5f6f8);box-sizing:border-box;color:var(--text-main,#222)}
.agreement-state{padding:160rpx 30rpx;text-align:center;color:#87909a;line-height:1.8}
.agreement-state>text{display:block;font-size:52rpx;margin-bottom:18rpx}
.agreement-hero{padding:18rpx 8rpx 22rpx}.agreement-hero-title{font-size:40rpx;font-weight:700}.agreement-hero-desc{margin-top:12rpx;font-size:25rpx;line-height:1.75;color:#7a828c}
.agreement-search{display:flex;align-items:center;gap:12rpx;margin-bottom:12rpx;padding:0 22rpx;height:82rpx;border:1rpx solid rgba(0,185,203,.16);border-radius:22rpx;background:var(--card-bg,#fff);box-shadow:0 6rpx 20rpx rgba(31,45,61,.035)}.agreement-search-icon{color:#88949a;font-size:28rpx}.agreement-search-input{min-width:0;flex:1;height:82rpx;font-size:26rpx;color:var(--text-main,#2d3438)}.agreement-search-clear{padding:12rpx;color:#a3acb2;font-size:28rpx}.agreement-search-summary{margin:0 6rpx 16rpx;color:#879198;font-size:22rpx}.agreement-search-empty{padding:60rpx 24rpx;text-align:center;color:#909aa1;font-size:24rpx;line-height:1.7}
.agreement-list{display:grid;gap:20rpx}.agreement-card{display:flex;align-items:center;gap:18rpx;padding:28rpx;border-radius:24rpx;background:var(--card-bg,#fff);box-shadow:0 8rpx 26rpx rgba(31,45,61,.05)}
.agreement-card-main{min-width:0;flex:1}.agreement-card-title-row{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap}.agreement-card-title{font-size:30rpx;font-weight:700;line-height:1.45}.agreement-type-tag{padding:3rpx 12rpx;border-radius:999rpx;background:rgba(0,185,203,.1);color:#0099a8;font-size:20rpx}.agreement-card-summary{margin-top:8rpx;font-size:24rpx;line-height:1.65;color:#66727b}.agreement-card-meta{margin-top:8rpx;font-size:23rpx;line-height:1.55;color:#8a9199}.agreement-arrow{font-size:30rpx;color:#a8afb7}.agreement-upcoming{display:inline-flex;align-items:center;gap:8rpx;margin-top:14rpx;padding:8rpx 14rpx;border-radius:12rpx;background:rgba(0,185,203,.1);color:#0099a8;font-size:22rpx}
.agreement-detail-head{padding:8rpx 8rpx 26rpx}.agreement-back{display:inline-flex;align-items:center;gap:6rpx;color:#00a7b8;font-size:25rpx;margin-bottom:24rpx}.agreement-detail-title{font-size:38rpx;font-weight:700;line-height:1.45}.agreement-detail-summary{margin-top:12rpx;font-size:25rpx;line-height:1.7;color:#68737b}.agreement-copy-btn{margin:18rpx 0 0;padding-left:24rpx;padding-right:24rpx}
.agreement-important{margin-bottom:22rpx;padding:24rpx;border:1px solid rgba(226,143,0,.24);border-radius:20rpx;background:rgba(255,173,31,.09)}.agreement-important-title{display:flex;align-items:center;gap:8rpx;font-size:27rpx;font-weight:700;color:#c97800}.agreement-important-text{margin-top:12rpx;font-size:25rpx;line-height:1.85;color:#5d5143;white-space:pre-wrap}
.agreement-content{padding:30rpx;border-radius:24rpx;background:var(--card-bg,#fff);font-size:27rpx;line-height:2;color:var(--text-main,#30343a);white-space:pre-wrap;word-break:break-word;box-shadow:0 8rpx 26rpx rgba(31,45,61,.04)}
.agreement-rich-text{display:block;white-space:normal}.agreement-rich-text h2{display:block;margin:36rpx 0 14rpx;font-size:31rpx;line-height:1.55;font-weight:700}.agreement-rich-text h2:first-child{margin-top:0}.agreement-rich-text h3{display:block;margin:28rpx 0 12rpx;font-size:28rpx;line-height:1.55;font-weight:700}.agreement-rich-text p{display:block;margin:14rpx 0;line-height:2}.agreement-rich-text strong,.agreement-rich-text b{font-weight:700}.agreement-rich-text ul,.agreement-rich-text ol{display:block;margin:14rpx 0;padding-left:42rpx}.agreement-rich-text li{display:list-item;margin:10rpx 0;line-height:1.9}.agreement-rich-text blockquote{display:block;margin:20rpx 0;padding:18rpx 20rpx;border-left:5rpx solid #00a7b8;border-radius:0 14rpx 14rpx 0;background:rgba(0,185,203,.07)}.agreement-rich-text hr{display:block;margin:28rpx 0;border:0;border-top:1rpx solid rgba(127,127,127,.16)}
.agreement-history{margin-top:26rpx;border-radius:22rpx;background:var(--card-bg,#fff);box-shadow:0 8rpx 26rpx rgba(31,45,61,.035);overflow:hidden}.agreement-history-toggle,.agreement-history-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:24rpx 28rpx}.agreement-history-arrow{flex:0 0 auto;color:#8f989f;font-size:28rpx}.agreement-history-body{border-top:1rpx solid rgba(127,127,127,.12)}.agreement-history-state{padding:28rpx;text-align:center;color:#8a9199;font-size:24rpx}.agreement-history-item+.agreement-history-item{border-top:1rpx solid rgba(127,127,127,.12)}.agreement-history-copy{min-width:0;flex:1}.agreement-history-version{font-size:27rpx;font-weight:700;line-height:1.5}.agreement-current-tag{display:inline-block;margin-left:10rpx;padding:2rpx 10rpx;border-radius:999rpx;background:rgba(0,185,203,.12);color:#0099a8;font-size:20rpx;font-weight:500;vertical-align:middle}.agreement-history-detail{padding:0 24rpx 26rpx}.agreement-history-copy-btn{margin:0 0 18rpx;padding-left:22rpx;padding-right:22rpx}.agreement-history-important{margin-top:0}.agreement-history-content{padding:24rpx;box-shadow:none;background:#f8f9fa;font-size:25rpx}
.agreement-next{margin-top:28rpx;padding-top:28rpx;border-top:1px solid rgba(127,127,127,.16)}.agreement-next-title{font-size:30rpx;font-weight:700}.agreement-important-next{margin-top:20rpx}.agreement-content-next{margin-top:20rpx}.agreement-reaccept-tag{display:inline-flex;margin-top:14rpx;padding:6rpx 14rpx;border-radius:999rpx;background:rgba(226,143,0,.1);color:#bd7300;font-size:21rpx}
.agreement-feedback{margin-top:20rpx;padding:22rpx 24rpx;border-radius:18rpx;background:rgba(0,185,203,.08)}.agreement-feedback-title{display:flex;align-items:center;gap:8rpx;color:#008f9d;font-size:25rpx;font-weight:700}.agreement-feedback-btn{margin:16rpx 0 0;padding-left:24rpx;padding-right:24rpx}
@media (prefers-color-scheme:dark){.agreement-page{background:#101214;color:#edf1f3}.agreement-card,.agreement-content,.agreement-history,.agreement-search{background:#191d20;box-shadow:none}.agreement-search{border-color:#2d464b}.agreement-search-input{color:#e7eef0}.agreement-search-summary,.agreement-search-empty,.agreement-card-meta,.agreement-card-summary,.agreement-detail-summary,.agreement-hero-desc,.agreement-history-state{color:#929ba4}.agreement-type-tag{background:rgba(0,185,203,.16);color:#4ed0dc}.agreement-important{background:rgba(255,173,31,.08);border-color:rgba(255,173,31,.22)}.agreement-important-text{color:#d8c9b8}.agreement-content{color:#e1e6e9}.agreement-rich-text blockquote{background:rgba(0,185,203,.1);border-left-color:#4ed0dc}.agreement-history-body,.agreement-history-item+.agreement-history-item{border-color:#2b3338}.agreement-history-content{background:#14181a}.agreement-current-tag{background:rgba(0,185,203,.16);color:#4ed0dc}.agreement-feedback{background:rgba(0,185,203,.1)}.agreement-feedback-title{color:#4ed0dc}.agreement-reaccept-tag{background:rgba(255,173,31,.12);color:#efb85e}}
