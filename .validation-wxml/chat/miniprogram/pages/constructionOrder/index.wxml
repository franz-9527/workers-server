<!-- 2026-10-06：我的接单合并普通承接与受邀订单；受邀仅作为卡片标签，不再单独导航。 -->
<view class="construction-page">
  <view class="adaptive-nav {{navSolid ? 'solid' : ''}}" style="height:{{navTotalHeight}}px;padding-top:{{statusBarHeight}}px;">
    <view class="nav-inner" style="height:{{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack"><text class="cuIcon-back"></text></view>
      <view class="nav-title">我的接单</view>
    </view>
  </view>

  <view class="hero" style="padding-top:{{navTotalHeight + 22}}px;">
    <view><view class="hero-title">我的接单</view><view class="hero-subtitle">施工、测量、平台单和受邀订单统一在这里处理</view></view>
    <text class="cuIcon-repair hero-icon"></text>
  </view>

  <subscription-health-banner audience="worker"></subscription-health-banner>

  <view class="legacy-entry" bindtap="openLegacyOrders">
    <view class="legacy-icon"><text class="cuIcon-link"></text></view>
    <view class="legacy-content"><view>旧版工单</view><text>查看原小程序中的历史安装工单</text></view>
    <text class="cuIcon-right"></text>
  </view>

  <scroll-view wx:if="{{identity.is_worker}}" scroll-x class="status-scroll">
    <view class="status-tabs"><view wx:for="{{statusTabs}}" wx:key="key" class="status-tab {{status === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectStatus">{{item.name}}</view></view>
  </scroll-view>

  <view wx:if="{{!loading && !identity.is_worker}}" class="empty">
    <text class="cuIcon-people empty-icon"></text><view class="empty-title">当前账号还不是师傅</view>
    <view class="empty-subtitle">提交入驻资料后，可在这里管理报价、抢单和受邀订单</view>
    <button class="cu-btn round join-button" bindtap="goJoin">师傅入驻</button>
  </view>
  <view wx:elif="{{errorText && !items.length}}" class="empty">
    <text class="cuIcon-warn empty-icon"></text><view class="empty-title">{{errorText}}</view>
    <button class="cu-btn round retry-button" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{!loading && identity.is_worker && !items.length}}" class="empty">
    <text class="cuIcon-form empty-icon"></text><view class="empty-title">当前筛选暂无接单记录</view>
    <view class="empty-subtitle">大厅报价、抢单或领取邀请后会统一显示在这里</view>
  </view>

  <view class="order-list">
    <view wx:for="{{items}}" wx:key="id" class="order-card {{item.business_type === 'measurement' ? 'measurement-card' : ''}} {{item.is_platform_order ? 'platform-card' : ''}}" data-index="{{index}}" bindtap="openOrder">
      <view class="card-main">
        <image wx:if="{{item.cover_display_url}}" class="cover" mode="aspectFill" src="{{item.cover_display_url}}" data-index="{{index}}" binderror="coverError"></image>
        <view wx:else class="cover cover-placeholder"><text class="cuIcon-pic"></text></view>
        <view class="card-content">
          <view class="title-line"><text class="order-title">{{item.title || item.category_name + '订单'}}</text><text class="status">{{item.status_text}}</text></view>
          <view class="order-no">{{item.id}}</view>
          <view class="order-tags" wx:if="{{item.is_platform_order || item.is_invited_order || item.business_type === 'measurement'}}">
            <text wx:if="{{item.is_platform_order}}" class="order-tag platform-tag">平台单</text>
            <text wx:if="{{item.is_invited_order}}" class="order-tag invite-tag">受邀</text>
            <text wx:if="{{item.business_type === 'measurement'}}" class="order-tag measurement-tag">测量</text>
          </view>
          <view class="order-meta">
            <text>{{item.category_name || '类目未确定'}}</text>
            <text>{{item.display_address || item.address}}</text>
          </view>
          <view wx:if="{{item.expected_visit_at}}" class="visit-time"><text class="cuIcon-time"></text> {{item.expected_visit_at}}</view>
        </view>
      </view>
      <view class="card-footer"><text>{{item.quote_count}} 份报价</text><text class="income">{{item.own_quote_text || item.action_text}} <text class="cuIcon-right"></text></text></view>
    </view>
  </view>
  <view wx:if="{{loading || loadingMore}}" class="loading"><text class="cuIcon-loading2 spin"></text> 加载订单</view>
  <view wx:if="{{!hasMore && items.length}}" class="finished">已经到底了</view>
</view>
