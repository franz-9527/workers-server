<!-- 2026-09-28：用户订单前端统一命名“我的下单”；一口价订单作为现行业务入口整合到本页。 -->
<view class="center-page">
  <view class="adaptive-nav {{navSolid ? 'solid' : ''}}" style="height:{{navTotalHeight}}px;padding-top:{{statusBarHeight}}px;">
    <view class="nav-inner" style="height:{{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack"><text class="cuIcon-back"></text></view>
      <view class="nav-title">我的下单</view>
    </view>
  </view>

  <view class="hero" style="padding-top:{{navTotalHeight + 22}}px;">
    <view><view class="hero-title">我的下单</view><view class="hero-subtitle">查看报价、测量、施工与售后进度</view></view>
    <text class="cuIcon-form hero-icon"></text>
  </view>

  <view class="legacy-entry" bindtap="openFixedPriceOrders">
    <view class="legacy-icon"><text class="cuIcon-order"></text></view>
    <view class="legacy-content"><view>一口价订单</view><text>进入一口价订单，查看和管理相关订单</text></view>
    <text class="cuIcon-right"></text>
  </view>

  <order-announcement scene="quote_orders"></order-announcement>

  <view class="order-search-wrap">
    <view class="order-search-box">
      <text class="cuIcon-search order-search-icon"></text>
      <input class="order-search-input" value="{{searchText}}" maxlength="80" confirm-type="search" placeholder="搜索订单号、地址、标题或类目" bindinput="inputSearch" bindconfirm="submitSearch" />
      <text wx:if="{{searchText}}" class="cuIcon-close order-search-clear" bindtap="clearSearch"></text>
      <view class="order-search-button" role="button" aria-label="搜索订单" bindtap="submitSearch">搜索</view>
    </view>
    <view wx:if="{{keyword}}" class="order-search-result"><text>{{loading ? '正在搜索' : '搜索关键词'}}“{{keyword}}”</text><text bindtap="clearSearch">清除</text></view>
  </view>

  <scroll-view scroll-x class="status-nav bg-white" enable-flex style="top:{{navTotalHeight}}px;">
    <view class="status-tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="status-tab {{status === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectTab">
        <text>{{item.name}}</text>
        <text wx:if="{{item.key === 'supplement' && supplementCount > 0}}" class="supplement-count-badge">{{supplementCount > 99 ? '99+' : supplementCount}}</text>
        <text wx:if="{{item.key === 'todo' && todoCount > 0}}" class="todo-count-badge">{{todoCount > 99 ? '99+' : todoCount}}</text>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{errorText && !items.length}}" class="empty text-center"><text class="cuIcon-warn text-orange icon"></text><view>{{errorText}}</view></view>
  <view wx:elif="{{!loading && !items.length}}" class="empty text-center">
    <text class="{{keyword ? 'cuIcon-search' : (status === 'todo' ? 'cuIcon-roundcheck' : 'cuIcon-form')}} text-grey icon"></text>
    <view class="text-bold">{{keyword ? '没有找到匹配订单' : (status === 'todo' ? '暂无待处理事项' : (status === 'supplement' ? '暂无待补资料订单' : (status === 'quoting' ? '暂无报价中的订单' : (status === 'progress' ? '暂无进行中的订单' : (status === 'completed' ? '暂无已完成订单' : (status === 'refunding' ? '暂无退款中的订单' : '还没有下单记录'))))))}}</view>
    <view class="text-sm text-grey margin-top-xs">{{keyword ? '可换订单号、地址关键词或切换状态后再搜索。' : (status === 'todo' ? '当前没有需要你操作的订单，可以放心等待后续进度。' : (status === 'all' ? '提交订单后，可在这里统一查看报价、施工、退款和售后进度。' : '当前筛选下没有订单，可切回全部订单查看其他进度。'))}}</view>
    <button wx:if="{{keyword}}" class="cu-btn round line-cyan margin-top" bindtap="clearSearch">清除搜索</button>
    <button wx:elif="{{status === 'all'}}" class="cu-btn round bg-cyan text-white margin-top" bindtap="goSubmit">我要下单</button>
    <button wx:else class="cu-btn round line-cyan margin-top" data-key="all" bindtap="selectTab">查看全部订单</button>
  </view>
  <view class="list">
    <view wx:for="{{items}}" wx:key="id" class="card bg-white {{item.repair_attention ? 'repair-card' : ''}} {{item.business_type === 'measurement' ? 'measurement-card' : ''}}" data-index="{{index}}" bindtap="open">
      <view class="flex">
        <image wx:if="{{item.cover_display_url}}" class="cover" mode="aspectFill" src="{{item.cover_display_url}}" data-index="{{index}}" binderror="coverError"></image>
        <view wx:else class="cover placeholder flex align-center justify-center"><text class="cuIcon-pic text-grey text-xxl"></text></view>
        <view class="content">
          <view class="order-card-head"><text class="text-bold order-card-title">{{item.title}}</text><text class="cu-tag sm round bg-cyan light order-card-status">{{item.status_text}}</text></view>
          <view class="text-sm text-grey margin-top-xs">{{item.id}}</view>
          <view class="text-sm margin-top-xs order-kind-line">
            <text wx:if="{{item.business_type === 'measurement'}}" class="cu-tag sm measurement-badge">测量</text>
            <text class="cu-tag sm line-cyan order-category-label">{{item.category_name}}</text>
            <text class="order-address">{{item.display_address || item.address}}</text>
          </view>
          <view class="text-sm text-grey margin-top-xs">{{item.expected_visit_at || '接单后电话预约'}}</view>
          <view wx:if="{{item.repair_attention}}" class="repair-alert"><text class="cuIcon-warnfill"></text> 维修中 · 已进入售后维修流程</view>
        </view>
      </view>
      <view class="footer flex justify-between">
        <text>{{item.worker_quote_count}} 人报价{{item.selected_quote_id ? ' · 已选择 1 份报价' : ''}}</text>
        <view class="footer-actions">
          <button wx:if="{{item.can_close_draft}}" class="draft-close-button" data-index="{{index}}" loading="{{closingDraftId === item.id}}" disabled="{{closingDraftId !== ''}}" catchtap="closeDraft">暂不下单</button>
          <text class="{{item.todo_action ? 'text-orange' : (item.own_quote_text ? 'text-orange' : 'text-cyan')}}">{{item.todo_action || item.own_quote_text || '查看详情'}} <text class="cuIcon-right"></text></text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{loading || loadingMore}}" class="padding text-center text-grey"><text class="cuIcon-loading2 spin"></text> 加载中</view>
</view>
