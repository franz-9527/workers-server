<view class="operations-card">
  <view class="operations-head">
    <view class="operations-title">订单运营操作</view>
    <view class="operations-desc">根据订单当前状态显示可用操作。</view>
  </view>

  <view class="operations-grid">
    <button wx:if="{{actions.can_review_platform_pricing}}" class="operation-button primary" data-action="pricing" bindtap="emit">平台核价</button>
    <button wx:if="{{actions.can_admin_invite_worker}}" class="operation-button primary" data-action="invite" bindtap="emit">安排/邀请师傅</button>
    <button wx:if="{{actions.can_admin_platform_quote}}" class="operation-button" data-action="quote" bindtap="emit">平台报价</button>
    <button wx:if="{{isPlatformOrder}}" class="operation-button" data-action="share" bindtap="emit">客户分享</button>
    <button wx:if="{{actions.can_admin_hide}}" class="operation-button" data-action="hide" bindtap="emit">下架订单</button>
    <button wx:if="{{actions.can_admin_reject}}" class="operation-button" data-action="reject" bindtap="emit">驳回订单</button>
    <button wx:if="{{actions.can_admin_cancel}}" class="operation-button" data-action="cancel" bindtap="emit">取消订单</button>
    <button class="operation-button" data-action="more" bindtap="emit">完整订单操作</button>
    <button wx:if="{{actions.is_admin && assistanceAvailable}}" class="operation-button" bindtap="openAssistance" loading="{{assistanceLoading}}" disabled="{{assistanceSaving || assistanceUploading}}">补录联系与履约资料</button>
  </view>

  <view wx:if="{{assistanceOpen}}" class="assistance-form">
    <view class="operations-title">协助提交履约资料</view>
    <view class="operations-note">用于代为记录已发生的联系、预约、测量或完工事实并补充图片；不会代替双方同意价格、接单或验收。时间均为北京时间。</view>
    <view wx:if="{{assistanceLoading}}" class="operations-note">正在读取当前师傅关系…</view>
    <block wx:elif="{{assistanceContext}}">
      <block wx:if="{{assistanceOptions.length}}">
        <picker range="{{assistanceOptions}}" range-key="label" value="{{assistanceIndex}}" data-field="assistanceIndex" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">事项：{{assistanceOptions[assistanceIndex].label}} ›</view></picker>
        <view class="operations-note">实际沟通时间</view>
        <view class="assistance-time">
          <picker mode="date" value="{{occurredDate}}" data-field="occurredDate" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">{{occurredDate}}</view></picker>
          <picker mode="time" value="{{occurredTime}}" data-field="occurredTime" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">{{occurredTime}}</view></picker>
        </view>
        <block wx:if="{{assistanceOptions[assistanceIndex].action === 'appointment'}}">
          <view class="assistance-wait">等待客户另行通知 <switch checked="{{waitCustomerNotice}}" data-field="waitCustomerNotice" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}" color="#00aebd" /></view>
          <block wx:if="{{!waitCustomerNotice}}">
            <view class="operations-note">约定上门时间</view>
            <view class="assistance-time">
              <picker mode="date" value="{{appointmentDate}}" data-field="appointmentDate" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">{{appointmentDate}}</view></picker>
              <picker mode="time" value="{{appointmentTime}}" data-field="appointmentTime" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">{{appointmentTime}}</view></picker>
            </view>
          </block>
        </block>
        <block wx:if="{{assistanceOptions[assistanceIndex].action === 'measurement_space'}}">
          <picker range="{{spaceOptions}}" range-key="name" value="{{spaceIndex}}" data-field="spaceIndex" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">{{spaceOptions[spaceIndex].name}} ›</view></picker>
          <input class="assistance-field" value="{{spaceName}}" data-field="spaceName" bindinput="assistanceInput" maxlength="120" placeholder="空间名称，如客厅、主卧" disabled="{{assistanceSaving || assistanceUploading}}" />
          <button wx:if="{{spaceOptions[spaceIndex].id}}" class="operation-button" bindtap="deleteAssistanceSpace" disabled="{{assistanceSaving || assistanceUploading}}">删除未提交空间</button>
        </block>
        <view wx:if="{{assistanceOptions[assistanceIndex].action === 'measurement_submit'}}" class="operations-note">请先在下方选择空间并上传成果；每个空间至少需要一张图片。</view>
        <view wx:if="{{assistanceOptions[assistanceIndex].action === 'completion_submit'}}" class="operations-note">请先上传完工照片。提交后等待客户验收，保留原有保障约定。</view>
        <view wx:if="{{assistanceOptions[assistanceIndex].action === 'repair_result'}}" class="operations-note">仅补录本次维修的实际处理结果；如有退款或赔付，请通过相应流程处理。</view>
        <textarea class="assistance-note" value="{{assistanceNote}}" data-field="assistanceNote" bindinput="assistanceInput" maxlength="500" placeholder="填写微信或电话沟通的实际情况" disabled="{{assistanceSaving || assistanceUploading}}" auto-height />
        <button class="operation-button primary" bindtap="saveAssistance" loading="{{assistanceSaving || assistanceUploading}}" disabled="{{assistanceSaving || assistanceUploading}}">{{assistanceOptions[assistanceIndex].action === 'completion_submit' ? '提交完工' : (assistanceOptions[assistanceIndex].action === 'measurement_submit' ? '提交测量成果' : (assistanceOptions[assistanceIndex].action === 'repair_result' ? '提交维修结果' : '保存补录'))}}</button>
      </block>
      <view wx:else class="operations-note">当前没有已接单的师傅可补录，或履约阶段已结束。</view>
      <view wx:if="{{mediaPurposes.length}}" class="assistance-materials">
        <view class="operations-title">履约图片与资料</view>
        <picker range="{{mediaPurposes}}" range-key="label" value="{{mediaPurposeIndex}}" data-field="mediaPurposeIndex" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">{{mediaPurposes[mediaPurposeIndex].label}} ›</view></picker>
        <picker wx:if="{{assistanceContext.can_edit_measurement}}" range="{{assistanceContext.spaces}}" range-key="name" value="{{uploadSpaceIndex}}" data-field="uploadSpaceIndex" bindchange="assistanceInput" disabled="{{assistanceSaving || assistanceUploading}}"><view class="assistance-field">成果空间：{{assistanceContext.spaces[uploadSpaceIndex].name || '请先添加测量空间'}} ›</view></picker>
        <button class="operation-button" bindtap="chooseAssistanceImages" disabled="{{assistanceSaving || assistanceUploading || uploadQueue.length >= 6}}">选择图片</button>
        <view wx:for="{{uploadQueue}}" wx:key="path" class="assistance-pending">
          <image src="{{item.path}}" mode="aspectFill" /><view class="assistance-pending-text">{{item.label}}<view>{{item.state}}</view></view>
          <button class="assistance-remove" data-index="{{index}}" bindtap="removePendingImage" disabled="{{assistanceUploading}}">移除</button>
        </view>
        <button wx:if="{{uploadQueue.length}}" class="operation-button primary" bindtap="uploadAssistanceImages" loading="{{assistanceUploading}}" disabled="{{assistanceSaving || assistanceUploading}}">上传 / 重试未完成图片</button>
      </view>
      <view class="assistance-images">
        <view wx:for="{{assistanceContext.media}}" wx:key="id" class="assistance-image-item">
          <image src="{{item.url}}" mode="aspectFill" data-index="{{index}}" bindtap="previewAssistanceImage" /><view>{{item.label}}</view>
          <button wx:if="{{item.can_delete}}" class="assistance-remove" data-index="{{index}}" bindtap="deleteAssistanceImage" disabled="{{assistanceSaving || assistanceUploading}}">移除</button>
        </view>
      </view>
      <view wx:for="{{assistanceRecords}}" wx:key="id" class="assistance-record">
        <view>{{item.title}} · 管理员 #{{item.operator}}</view>
        <view class="assistance-record-note">{{item.note}}</view>
        <view class="operations-note">实际沟通 {{item.actual}}</view>
        <view class="operations-note">系统录入 {{item.recorded}}</view>
      </view>
    </block>
    <button class="operation-button assistance-close" bindtap="closeAssistance" disabled="{{assistanceSaving || assistanceUploading}}">收起</button>
  </view>
</view>
