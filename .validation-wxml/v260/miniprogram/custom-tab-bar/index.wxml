<!-- 2026-08-23：发布选择层属于自定义 Tab 组件，不新增 Tab 或中转页面。 -->
<view wx:if="{{showPublishMenu}}" class="publish-mask" bindtap="hidePublishMenu">
  <view class="publish-menu" catchtap="noop">
    <view class="publish-choice" bindtap="createOrder"><view class="choice-icon order"><text class="cuIcon-formfill"></text></view><view><view class="choice-title">我要下单</view><view class="choice-desc">提交安装需求，等待平台和师傅报价</view></view></view>
    <view class="publish-choice" bindtap="publishWorker"><view class="choice-icon worker"><text class="cuIcon-peoplefill"></text></view><view><view class="choice-title">我是师傅</view><view class="choice-desc">进入原师傅发布与入驻页面</view></view></view>
  </view>
</view>
<view class="tabBar">
  <view class="cont">
    <block wx:for="{{list}}" wx:key="index" class="cont-item">
      <view data-path="{{item.pagePath}}" data-index="{{item.pagePath}}" bindtap="switchTab" class="{{item.plus?'plus':'item'}} {{selected === index || (item.plus && showPublishMenu) ? 'on' : 'off'}}">
        <image class="image-style" src="{{selected === index || (item.plus && showPublishMenu) ? item.selectedIconPath : item.iconPath}}"></image>
        <text wx:if="{{index === 4 && notificationBadgeCount > 0}}" class="tab-notice-badge {{notificationBadgeTone}}">{{notificationBadgeText}}</text>
        <view class="txt {{selected === index || (item.plus && showPublishMenu) ? 'selectedColor' : ''}}">{{item.text}}</view>
      </view>
    </block>
  </view>
</view>
