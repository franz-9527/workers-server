{"source_commit":"f7a38eb6b5c0f336a030387deb592d0da2e26a94","candidate":true,"files":{"chat/build.sh":"#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")\"\nexport GOTOOLCHAIN=local\nexport CGO_ENABLED=0\nrequired=\"go$(awk '$1 == \"go\" {print $2}' go.mod)\"\nif [ \"$(go env GOVERSION)\" != \"$required\" ]; then\n    printf '%s\\n' \"请使用go.mod锁定的工具链: $required\" >&2\n    exit 2\nfi\nrevision=$(git rev-parse --verify HEAD)\ndirty=false\nif [ -n \"$(git status --porcelain)\" ]; then dirty=true; fi\nmkdir -p bin\ngo mod verify\ngo build -mod=readonly -trimpath -buildvcs=false \\\n    -ldflags=\"-buildid= -X github.com/franz-9527/workers/chat/internal/bootstrap.sourceRevision=$revision -X github.com/franz-9527/workers/chat/internal/bootstrap.sourceDirty=$dirty\" \\\n    -o bin/chatd ./cmd/chatd\n","chat/cmd/chatd/main.go":"package main\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"os/signal\"\n\t\"syscall\"\n\n\t\"github.com/franz-9527/workers/chat/internal/bootstrap\"\n)\n\nfunc main() { os.Exit(run()) }\n\nfunc run() int {\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\treturn bootstrap.Run(ctx, os.Args[1:], os.Stdout, os.Stderr)\n}\n","chat/config.example.json":"{\n  \"env\": \"development\",\n  \"http\": {\n    \"listen\": \"127.0.0.1:19501\",\n    \"internal_listen\": \"127.0.0.1:19502\"\n  },\n  \"shutdown_timeout\": \"10s\",\n  \"log_level\": \"info\",\n  \"provider_mode\": \"disabled\",\n  \"dependencies\": {\n    \"operation_timeout\": \"500ms\",\n    \"probe_interval\": \"10s\",\n    \"external_concurrency\": 4,\n    \"mysql\": {\n      \"enabled\": false,\n      \"address\": \"127.0.0.1:3306\",\n      \"database\": \"\",\n      \"username\": \"\",\n      \"password_env\": \"CHAT_MYSQL_PASSWORD\",\n      \"max_open_serve\": 4,\n      \"max_open_worker\": 2,\n      \"max_idle\": 1\n    },\n    \"redis\": {\n      \"enabled\": false,\n      \"address\": \"127.0.0.1:6379\",\n      \"key_prefix\": \"bxchat:development:\",\n      \"password_env\": \"\",\n      \"pool_serve\": 2,\n      \"pool_worker\": 1\n    }\n  },\n  \"auth\": {\n    \"enabled\": false,\n    \"public_keys\": {}\n  },\n  \"conversations\": {\n    \"enabled\": false\n  },\n  \"av\": {\"enabled\":false,\"audio\":false,\"video\":false},\n  \"messages\": {\n    \"enabled\": false\n  },\n  \"socket\": {\n    \"enabled\": false\n  },\n  \"history\": {\n    \"enabled\": false,\n    \"cursor_key_env\": \"\"\n  },\n  \"safety\": {\n    \"enabled\": false,\n    \"app_id\": \"\",\n    \"credential_file\": \"\"\n  },\n  \"images\": {\n    \"enabled\": false,\n    \"mode\": \"manual_precheck\",\n    \"private_bucket\": true,\n    \"bucket\": \"\",\n    \"access_key_env\": \"CHAT_QINIU_ACCESS_KEY\",\n    \"secret_key_env\": \"CHAT_QINIU_SECRET_KEY\",\n    \"download_origin\": \"\",\n    \"upload_origin\": \"https://up-z2.qiniup.com\",\n    \"php_binary\": \"\",\n    \"python_binary\": \"\",\n    \"php_script\": \"\",\n    \"python_script\": \"\",\n    \"temp_root\": \"\",\n    \"max_file_bytes\": 1048576,\n    \"max_long_edge_px\": 1600\n  },\n  \"operations\": {\n    \"gate_file\": \"\",\n    \"epoch\": \"\"\n  },\n  \"retention\": {\n    \"enabled\": false,\n    \"body_days\": 365,\n    \"evidence_days\": 30,\n    \"change_days\": 90,\n    \"batch\": 20\n  },\n  \"release\": {\n    \"staging\": false,\n    \"file\": \"\",\n    \"key_env\": \"CHAT_RELEASE_KEY\"\n  },\n  \"reminders\": {\n    \"enabled\": false,\n    \"php_endpoint\": \"\",\n    \"key_id\": \"chat-internal-v1\",\n    \"key_env\": \"CHAT_INTERNAL_KEY\"\n  }\n}\n","chat/deploy/nginx.conf.example":"# Include these locations inside the EXISTING HTTPS PHP server.\n# Keep existing TLS, PHP handler and order routes; run nginx -t before reload.\nlocation = /chat/ws {\n    proxy_pass http://127.0.0.1:9501;\n    proxy_http_version 1.1;\n    proxy_set_header Upgrade $http_upgrade;\n    proxy_set_header Connection \"upgrade\";\n    proxy_set_header Host $host;\n    proxy_set_header X-Forwarded-Proto $scheme;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $remote_addr;\n    proxy_read_timeout 120s;\n    proxy_send_timeout 120s;\n    proxy_buffering off;\n}\nlocation ^~ /chat/api/v1/ {\n    proxy_pass http://127.0.0.1:9501;\n    proxy_http_version 1.1;\n    proxy_set_header Connection \"\";\n    proxy_set_header Host $host;\n    proxy_set_header X-Forwarded-Proto $scheme;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $remote_addr;\n    client_max_body_size 64k;\n    proxy_connect_timeout 3s;\n    proxy_read_timeout 30s;\n    proxy_send_timeout 30s;\n    proxy_buffering off;\n    proxy_cache off;\n}\n# Internal bridge is never exposed by this public PHP virtual host. Give it a\n# separate loopback TLS virtual host using the existing FPM pool and a certificate\n# matching the configured private HTTPS endpoint; do not expose 9502 or metrics.\nlocation = /chat-internal.php { return 404; }\nlocation ^~ /chat/ { return 404; }\nlocation ^~ /internal/ { return 404; }\n","chat/deploy/supervisor.conf.example":"[program:bixuan-chat]\ncommand=/www/server/bixuan-chat/current/chatd serve --config /www/server/bixuan-chat/shared/chat.json\ndirectory=/www/server/bixuan-chat/current\nuser=bxchat\nnumprocs=1\nautostart=true\nautorestart=true\nstartsecs=5\nstartretries=3\nstopsignal=TERM\nstopwaitsecs=45\nstopasgroup=true\nkillasgroup=true\numask=027\nredirect_stderr=true\nstdout_logfile=/www/wwwlogs/bixuan-chat/serve.log\nstdout_logfile_maxbytes=20MB\nstdout_logfile_backups=5\n\n[program:bixuan-chat-worker]\ncommand=/www/server/bixuan-chat/current/chatd worker --config /www/server/bixuan-chat/shared/chat.json\ndirectory=/www/server/bixuan-chat/current\nuser=bxchat\nnumprocs=1\nautostart=true\nautorestart=true\nstartsecs=5\nstartretries=3\nstopsignal=TERM\nstopwaitsecs=45\nstopasgroup=true\nkillasgroup=true\numask=027\nredirect_stderr=true\nstdout_logfile=/www/wwwlogs/bixuan-chat/worker.log\nstdout_logfile_maxbytes=20MB\nstdout_logfile_backups=5\n","chat/go.mod":"module github.com/franz-9527/workers/chat\n\ngo 1.27.3\n\nrequire (\n\tgithub.com/go-sql-driver/mysql v1.10.1\n\tgithub.com/gorilla/websocket v1.5.3\n\tgithub.com/redis/go-redis/v9 v9.23.0\n)\n\nrequire (\n\tfilippo.io/edwards25519 v1.2.0 // indirect\n\tgithub.com/cespare/xxhash/v2 v2.3.0 // indirect\n\tgo.uber.org/atomic v1.12.0 // indirect\n\tgolang.org/x/sys v0.48.0 // indirect\n)\n","chat/go.sum":"filippo.io/edwards25519 v1.2.0 h1:crnVqOiS4jqYleHd9vaKZ+HKtHfllngJIiOpNpoJsjo=\nfilippo.io/edwards25519 v1.2.0/go.mod h1:xzAOLCNug/yB62zG1bQ8uziwrIqIuxhctzJT18Q77mc=\ngithub.com/bsm/ginkgo/v2 v2.12.0 h1:Ny8MWAHyOepLGlLKYmXG4IEkioBysk6GpaRTLC8zwWs=\ngithub.com/bsm/ginkgo/v2 v2.12.0/go.mod h1:SwYbGRRDovPVboqFv0tPTcG1sN61LM1Z4ARdbAV9g4c=\ngithub.com/bsm/gomega v1.27.10 h1:yeMWxP2pV2fG3FgAODIY8EiRE3dy0aeFYt4l7wh6yKA=\ngithub.com/bsm/gomega v1.27.10/go.mod h1:JyEr/xRbxbtgWNi8tIEVPUYZ5Dzef52k01W3YH0H+O0=\ngithub.com/cespare/xxhash/v2 v2.3.0 h1:UL815xU9SqsFlibzuggzjXhog7bL6oX9BbNZnL2UFvs=\ngithub.com/cespare/xxhash/v2 v2.3.0/go.mod h1:VGX0DQ3Q6kWi7AoAeZDth3/j3BFtOZR5XLFGgcrjCOs=\ngithub.com/go-sql-driver/mysql v1.10.1 h1:arlSnNLq6a5yxGxV7qg9lF4j0C+KwD6NbQyKr9QL6ME=\ngithub.com/go-sql-driver/mysql v1.10.1/go.mod h1:M+cqaI7+xxXGG9swrdeUIoPG3Y3KCkF0pZej+SK+nWk=\ngithub.com/gorilla/websocket v1.5.3 h1:saDtZ6Pbx/0u+bgYQ3q96pZgCzfhKXGPqt7kZ72aNNg=\ngithub.com/gorilla/websocket v1.5.3/go.mod h1:YR8l580nyteQvAITg2hZ9XVh4b55+EU/adAjf1fMHhE=\ngithub.com/klauspost/cpuid/v2 v2.4.0 h1:S6Hrbc7+ywsr0r+RLapfGBHfyefhCTwEh3A0tV913Dw=\ngithub.com/klauspost/cpuid/v2 v2.4.0/go.mod h1:19jmZ9mjzoF//ddRSUsv0zfBTJWh3QJh9FNxZTMrGxU=\ngithub.com/redis/go-redis/v9 v9.23.0 h1:/TTVdJa8BRNsybwwGGnmiYktHNlUXtbOQxlWpHBPL3s=\ngithub.com/redis/go-redis/v9 v9.23.0/go.mod h1:EWP2UUk+XDaI1s5nQB5mablZN6vccXlmBQTyfnF87D0=\ngithub.com/stretchr/testify v1.12.1 h1:EuwCh5fleGS7H32xRwO3wRGT7DxrDhLAT6FF8MpWDWE=\ngithub.com/stretchr/testify v1.12.1/go.mod h1:MDEgiDPPsNp5cuIrHPPCyornHKgEVbtFUmoNlxoYthg=\ngithub.com/zeebo/xxh3 v1.1.0 h1:s7DLGDK45Dyfg7++yxI0khrfwq9661w9EN78eP/UZVs=\ngithub.com/zeebo/xxh3 v1.1.0/go.mod h1:IisAie1LELR4xhVinxWS5+zf1lA4p0MW4T+w+W07F5s=\ngo.uber.org/atomic v1.12.0 h1:BvcXdFKuviU4fTL/f+SxdQ5qJX/Jix8pAkgdUcb3XOE=\ngo.uber.org/atomic v1.12.0/go.mod h1:I6c4cg+6HCxRjfjSsYtApoFILnpc0CGUdGkXVqbYVNk=\ngo.yaml.in/yaml/v3 v3.0.5 h1:N6y/pJk8buWs9NY5ERU2HSMfm+IuD/OtfdAnq6kESPw=\ngo.yaml.in/yaml/v3 v3.0.5/go.mod h1:HVTZu1O7/Vkt2N+BFy8Zza+lnLsABggaTM2ZpNIGuKg=\ngolang.org/x/sys v0.48.0 h1:bbX/i/6MgT9BVLM9RT1thmxL04yeTAhbEz4SyadbXoo=\ngolang.org/x/sys v0.48.0/go.mod h1:hNLxWAXmnKAxqDtdwIYC4bM9oQPEecfsnNMuSxOs3og=\n","chat/helpers/images/inspect.py":"\"\"\"Fixed local image helper. No network, OCR, shell, user URL or model download.\"\"\"\nimport json, os, pathlib, resource, struct, sys, warnings\nresource.setrlimit(resource.RLIMIT_AS, (512 * 1024**2, 512 * 1024**2))\nresource.setrlimit(resource.RLIMIT_CPU, (20, 20))\nfrom PIL import Image, ImageOps\nImage.MAX_IMAGE_PIXELS = 20_000_000\nwarnings.simplefilter(\"error\", Image.DecompressionBombWarning)\n\ndef inspect(path):\n    with Image.open(path) as im:\n        if im.format not in (\"JPEG\", \"PNG\", \"WEBP\") or getattr(im, \"n_frames\", 1) != 1:\n            raise ValueError(\"unsupported image\")\n        if im.width * im.height > 20_000_000 or min(im.size) < 1:\n            raise ValueError(\"pixels\")\n        im.load()\n        return im.format, im.size\n\ndef strip(data, kind):\n    # Strip metadata containers without re-encoding image pixels.\n    if kind == \"JPEG\":\n        out, p = bytearray(data[:2]), 2\n        while p < len(data):\n            if data[p] != 255: raise ValueError(\"jpeg\")\n            marker = data[p+1]\n            if marker == 218: out.extend(data[p:]); return bytes(out)\n            length = int.from_bytes(data[p+2:p+4], \"big\")\n            if length < 2 or p+2+length > len(data): raise ValueError(\"jpeg\")\n            if marker not in (225, 237, 254): out.extend(data[p:p+2+length])\n            p += 2 + length\n        raise ValueError(\"jpeg\")\n    if kind == \"PNG\":\n        out, p = bytearray(data[:8]), 8\n        while p < len(data):\n            length = int.from_bytes(data[p:p+4], \"big\")\n            if p+12+length > len(data): raise ValueError(\"png\")\n            tag = data[p+4:p+8]\n            if tag not in (b\"eXIf\", b\"tEXt\", b\"zTXt\", b\"iTXt\", b\"tIME\"):\n                out.extend(data[p:p+12+length])\n            p += 12+length\n            if tag == b\"IEND\": break\n        return bytes(out)\n    out, p = bytearray(b\"WEBP\"), 12\n    while p < len(data):\n        tag = data[p:p+4]; length = int.from_bytes(data[p+4:p+8], \"little\")\n        end = p + 8 + length + length % 2\n        if end > len(data): raise ValueError(\"webp\")\n        chunk = bytearray(data[p:end])\n        if tag == b\"VP8X\": chunk[8] &= ~12\n        if tag not in (b\"EXIF\", b\"XMP \"): out.extend(chunk)\n        p = end\n    return b\"RIFF\" + struct.pack(\"<I\", len(out)) + out\n\ndef qr(path):\n    try:\n        import zxingcpp\n        with Image.open(path) as im:\n            # Full delivered image, with ZXing's bounded rotation/downscale.\n            codes = zxingcpp.read_barcodes(im)\n        decision = \"clear\"\n        for code in codes[:64]:\n            text = code.text[:4096].strip().lower()\n            # Only known personal social/payment schemas are decisive;\n            # normal material barcodes and arbitrary numbers are NOT violations.\n            if text.startswith((\"weixin://\", \"wxp://\", \"alipayqr://\")) or text.startswith((\"https://weixin.qq.com/r/\", \"https://u.wechat.com/\")):\n                return \"completed\", \"blocked\"\n            if \"://\" in text: decision = \"review\"\n        return \"completed\", decision\n    except Exception:\n        return \"unavailable\", \"review\"\n\ndef main():\n    job = pathlib.Path(sys.argv[2]).resolve()\n    if not job.is_dir() or not job.name.startswith(\"bxchat-image-\"): raise ValueError(\"job\")\n    if sys.argv[1] == \"sanitize\":\n        source = job / \"source\"\n        if source.stat().st_size > 8*1024**2: raise ValueError(\"bytes\")\n        kind, _ = inspect(source)\n        with Image.open(source) as im:\n            orientation = int(im.getexif().get(274, 1))\n            rotated = orientation in range(2, 9)\n            if rotated:\n                normalized = ImageOps.exif_transpose(im)\n                normalized.info.clear()\n                options = {\"quality\": 100} if kind == \"JPEG\" else {\"lossless\": True} if kind == \"WEBP\" else {}\n                normalized.save(job / \"clean.input\", format=kind, **options)\n            else:\n                (job / \"clean.input\").write_bytes(strip(source.read_bytes(), kind))\n        inspect(job / \"clean.input\")\n        print(json.dumps({\"ok\": True, \"orientation_normalized\": rotated}))\n    elif sys.argv[1] == \"inspect\":\n        kind, (width, height) = inspect(job / \"main\")\n        inspect(job / \"thumb\")\n        a, b = qr(job / \"main\"); c, d = qr(job / \"thumb\")\n        decision = \"blocked\" if \"blocked\" in (b,d) else \"review\" if \"review\" in (b,d) else \"clear\"\n        print(json.dumps({\"mime\": {\"JPEG\":\"image/jpeg\",\"PNG\":\"image/png\",\"WEBP\":\"image/webp\"}[kind],\n                          \"width\":width, \"height\":height,\n                          \"qr_status\":\"completed\" if a == c == \"completed\" else \"unavailable\",\n                          \"qr_decision\":decision, \"qr_version\":\"zxing-cpp-3.1.1\",\n                          \"ocr_status\":\"not_run\"}))\n    else: raise ValueError(\"mode\")\nif __name__ == \"__main__\":\n    try: main()\n    except Exception:\n        print('{\"code\":\"CHAT_IMAGE_CHECK_UNAVAILABLE\"}')\n        sys.exit(1)\n","chat/helpers/images/requirements.lock":"# CPython 3.11 / Linux x86_64. Offline production installation from verified wheels.\nPillow==13.0.0 --hash=sha256:a625df9a2a5597fa5e5266e01aefc82604bb85d291e3547981e863560d75da6c\nzxing-cpp==3.1.1 --hash=sha256:8a5b32d719a5448f1b2f474e04d2db6ce41cc6973fb5c705d47dbe899361e5f9\n","chat/helpers/media/inspect.py":"\"\"\"Bounded local media validation/remux. No network, cloud transcoding or model.\"\"\"\nimport importlib.util, json, math, os, pathlib, resource, subprocess, sys\nresource.setrlimit(resource.RLIMIT_AS, (512 * 1024**2, 512 * 1024**2))\nresource.setrlimit(resource.RLIMIT_CPU, (20, 20))\nresource.setrlimit(resource.RLIMIT_FSIZE, (24 * 1024**2, 24 * 1024**2))\nresource.setrlimit(resource.RLIMIT_NOFILE, (64, 64))\nMAX_BYTES = 20 * 1024**2\n\ndef command(binary, args, timeout=12):\n    result = subprocess.run([binary, \"-nostdin\", \"-hide_banner\", \"-loglevel\", \"error\"] + args,\n                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n                            timeout=timeout, check=False)\n    if result.returncode or len(result.stdout) > 2 * 1024**2 or len(result.stderr) > 65536:\n        raise ValueError(\"media operation\" + (\": \" + result.stderr.decode(errors=\"replace\")[:1500] if os.environ.get(\"CHAT_AV_HELPER_TEST\") == \"1\" else \"\"))\n    return result.stdout\n\ndef probe(binary, path):\n    # ffprobe has no -nostdin option; fixed fields omit arbitrary metadata.\n    args = [binary, \"-v\", \"error\", \"-protocol_whitelist\", \"file,pipe\",\n            \"-format_whitelist\", \"mov,mp3\", \"-show_entries\",\n            \"format=nb_streams,duration,size:stream=index,codec_type,codec_name,sample_rate,channels,width,height,r_frame_rate,duration:stream_side_data=rotation\",\n            \"-of\", \"json\", str(path)]\n    result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\n                            stderr=subprocess.PIPE, timeout=10, check=False)\n    if result.returncode or len(result.stdout) > 65536 or len(result.stderr) > 65536:\n        raise ValueError(\"media probe\")\n    info = json.loads(result.stdout)\n    streams = info.get(\"streams\", [])\n    if not 1 <= len(streams) <= 2 or int(info[\"format\"][\"nb_streams\"]) != len(streams):\n        raise ValueError(\"streams\")\n    duration = float(info[\"format\"][\"duration\"])\n    if not math.isfinite(duration) or duration <= 0 or duration > 121:\n        raise ValueError(\"duration\")\n    return info, duration\n\ndef qr_module():\n    path = pathlib.Path(__file__).resolve().parents[1] / \"images\" / \"inspect.py\"\n    spec = importlib.util.spec_from_file_location(\"chat_image_checks\", path)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\ndef main():\n    if len(sys.argv) != 6:\n        raise ValueError(\"arguments\")\n    root = pathlib.Path(sys.argv[1]).resolve()\n    source = sys.argv[2]\n    ffmpeg, ffprobe = sys.argv[3], sys.argv[4]\n    mode = sys.argv[5]\n    if not root.is_dir() or not root.name.startswith(\"bxchat-av-\") or source not in (\"voice\", \"camera\", \"album\") or mode != \"inspect\":\n        raise ValueError(\"job\")\n    for binary in (ffmpeg, ffprobe):\n        if not os.path.isabs(binary) or not pathlib.Path(binary).is_file():\n            raise ValueError(\"binary\")\n    path = root / \"input\"\n    limit = (1 if source == \"voice\" else 8 if source == \"camera\" else 20) * 1024**2\n    if not 1 <= path.stat().st_size <= limit:\n        raise ValueError(\"bytes\")\n    info, duration = probe(ffprobe, path)\n    streams = info[\"streams\"]\n    audio = [s for s in streams if s.get(\"codec_type\") == \"audio\"]\n    video = [s for s in streams if s.get(\"codec_type\") == \"video\"]\n    if len(audio) > 1 or len(video) > 1 or len(audio) + len(video) != len(streams):\n        raise ValueError(\"unsupported stream\")\n    maximum = 60 if source == \"voice\" else 30 if source == \"camera\" else 120\n    if duration > maximum + 0.25 or source == \"voice\" and duration < 1:\n        raise ValueError(\"duration limit\")\n    base = [\"-threads\", \"1\", \"-filter_threads\", \"1\", \"-protocol_whitelist\", \"file,pipe\",\n            \"-format_whitelist\", \"mov,mp3\", \"-i\", str(path), \"-threads\", \"1\", \"-map_metadata\", \"-1\", \"-map_chapters\", \"-1\", \"-y\"]\n    if source == \"voice\":\n        if video or len(audio) != 1 or audio[0][\"codec_name\"] != \"mp3\":\n            raise ValueError(\"voice codec\")\n        sample = int(audio[0].get(\"sample_rate\", 0)); channels = int(audio[0].get(\"channels\", 0))\n        if sample not in (8000, 16000) or channels != 1:\n            raise ValueError(\"voice profile\")\n        pcm = command(ffmpeg, base + [\"-t\", \"60.01\", \"-vn\", \"-map\", \"0:a:0\", \"-ar\", \"16000\", \"-ac\", \"1\", \"-f\", \"s16le\", \"pipe:1\"])\n        duration = len(pcm) / 32000\n        if not 1 <= duration <= 60:\n            raise ValueError(\"voice duration\")\n        encoding = [\"-c:a\", \"copy\"] if sample == 16000 else [\"-c:a\", \"libmp3lame\", \"-ar\", \"16000\", \"-ac\", \"1\", \"-b:a\", \"48k\"]\n        command(ffmpeg, base + [\"-vn\", \"-map\", \"0:a:0\"] + encoding + [\"-write_id3v1\", \"0\", \"-id3v2_version\", \"0\", str(root / \"main.mp3\")])\n        output = {\"kind\": \"audio\", \"mime\": \"audio/mpeg\", \"main\": \"main.mp3\", \"poster\": \"\", \"segments\": [\"main.mp3\"],\n                  \"duration_ms\": int(math.ceil(duration * 1000)), \"has_audio\": True, \"qr_decision\": \"clear\", \"frames\": []}\n        if (root / \"main.mp3\").stat().st_size > 1024**2:\n            raise ValueError(\"voice bytes\")\n    else:\n        if len(video) != 1 or video[0][\"codec_name\"] != \"h264\" or audio and audio[0][\"codec_name\"] != \"aac\":\n            raise ValueError(\"video codec\")\n        duration = float(video[0].get(\"duration\", duration))\n        if not math.isfinite(duration) or not 0 < duration <= maximum:\n            raise ValueError(\"video duration\")\n        width, height = int(video[0][\"width\"]), int(video[0][\"height\"])\n        if min(width, height) < 1 or min(width, height) > 720 or max(width, height) > 1280 or width * height > 921600:\n            raise ValueError(\"video profile\")\n        rate = str(video[0].get(\"r_frame_rate\", \"0/1\")).split(\"/\")\n        fps = float(rate[0]) / float(rate[1]) if len(rate) == 2 and float(rate[1]) else 0\n        if not 0 < fps <= 30:\n            raise ValueError(\"video rate\")\n        command(ffmpeg, base + [\"-t\", str(duration), \"-map\", \"0:v:0\", \"-map\", \"0:a:0?\", \"-c\", \"copy\", \"-movflags\", \"+faststart\", str(root / \"main.mp4\")])\n        checked, actual = probe(ffprobe, root / \"main.mp4\")\n        if actual > maximum + 0.25 or (root / \"main.mp4\").stat().st_size > limit:\n            raise ValueError(\"delivery size\")\n        command(ffmpeg, base + [\"-map\", \"0:v:0\", \"-frames:v\", \"1\", \"-vf\", \"scale=480:480:force_original_aspect_ratio=decrease\", \"-q:v\", \"5\", str(root / \"poster.jpg\")])\n        if (root / \"poster.jpg\").stat().st_size > 65536:\n            raise ValueError(\"poster size\")\n        segments = []\n        if audio:\n            for ordinal in range(int(math.ceil(duration / 60))):\n                name = \"check-\" + str(ordinal) + \".mp3\"\n                command(ffmpeg, [\"-ss\", str(ordinal * 60)] + base + [\"-t\", str(min(60, duration - ordinal * 60)),\n                        \"-vn\", \"-map\", \"0:a:0\", \"-c:a\", \"libmp3lame\", \"-ar\", \"16000\", \"-ac\", \"1\", \"-b:a\", \"48k\",\n                        \"-write_id3v1\", \"0\", \"-id3v2_version\", \"0\", str(root / name)])\n                if not 1 <= (root / name).stat().st_size <= 1024**2:\n                    raise ValueError(\"segment\")\n                segments.append(name)\n        checks = qr_module()\n        decisions = []\n        retained = []\n        # A bounded triage only. Full clip + audio human prereview is mandatory.\n        frame_count = min(8, max(1, int(math.ceil(duration / 15))))\n        for index in range(frame_count):\n            frame = root / (\"frame-\" + str(index) + \".jpg\")\n            second = min(max(0, duration - 0.1), index * duration / max(1, frame_count - 1))\n            command(ffmpeg, [\"-ss\", str(second)] + base + [\"-map\", \"0:v:0\", \"-frames:v\", \"1\",\n                    \"-vf\", \"scale=1280:720:force_original_aspect_ratio=decrease\", \"-q:v\", \"3\", str(frame)])\n            _, decision = checks.qr(frame); decisions.append(decision)\n            name = \"retained-\" + str(index) + \".jpg\"\n            with checks.Image.open(frame) as picture:\n                picture.thumbnail((480, 480))\n                picture.info.clear()\n                for quality in (70, 50, 35):\n                    picture.convert(\"RGB\").save(root / name, format=\"JPEG\", quality=quality)\n                    if (root / name).stat().st_size <= 65536:\n                        break\n                if (root / name).stat().st_size > 65536:\n                    raise ValueError(\"retained picture bytes\")\n            retained.append({\"file\": name, \"at_ms\": int(second * 1000)})\n            frame.unlink(missing_ok=True)\n        decision = \"blocked\" if \"blocked\" in decisions else \"review\" if \"review\" in decisions else \"clear\"\n        output = {\"kind\": \"video\", \"mime\": \"video/mp4\", \"main\": \"main.mp4\", \"poster\": \"poster.jpg\", \"segments\": segments,\n                  \"duration_ms\": int(math.ceil(duration * 1000)), \"has_audio\": bool(audio), \"qr_decision\": decision, \"frames\": retained}\n    print(json.dumps(output, separators=(\",\", \":\")))\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except Exception:\n        if os.environ.get(\"CHAT_AV_HELPER_TEST\") == \"1\":\n            import traceback\n            traceback.print_exc()\n        print('{\"code\":\"CHAT_AV_CHECK_UNAVAILABLE\"}')\n        sys.exit(1)\n","chat/internal/auth/auth_test.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype memoryStore struct {\n\tmu     sync.Mutex\n\tvalues map[string]string\n\tfail   bool\n}\n\nfunc (m *memoryStore) Put(_ context.Context, k, v string, _ time.Duration) (bool, error) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif m.fail {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tif _, ok := m.values[k]; ok {\n\t\treturn false, nil\n\t}\n\tm.values[k] = v\n\treturn true, nil\n}\nfunc (m *memoryStore) Take(_ context.Context, k string) (string, error) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif m.fail {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tv := m.values[k]\n\tdelete(m.values, k)\n\treturn v, nil\n}\n\ntype sourceFunc func(context.Context, Claims) error\n\nfunc (f sourceFunc) Validate(ctx context.Context, c Claims) error { return f(ctx, c) }\nfunc fixture(t *testing.T) (*Service, ed25519.PrivateKey, Claims, *memoryStore) {\n\tt.Helper()\n\tpub, priv, e := ed25519.GenerateKey(rand.Reader)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tv, e := NewVerifier(\"test\", map[string]ed25519.PublicKey{\"v1\": pub})\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tm := &memoryStore{values: map[string]string{}}\n\ts, e := NewService(v, sourceFunc(func(context.Context, Claims) error { return nil }), m, 2, 100*time.Millisecond)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tnow := time.Now().Unix()\n\tc := Claims{\"bixuan-php:test\", \"bixuan-chat\", \"18446744073709551615\", \"mini\", \"1\", strings.Repeat(\"a\", 64), strings.Repeat(\"b\", 64), \"test\", []string{\"chat:use\"}, now, now, now + 300, strings.Repeat(\"c\", 64)}\n\treturn s, priv, c, m\n}\nfunc sign(priv ed25519.PrivateKey, header, body string) string {\n\ta := base64.RawURLEncoding.EncodeToString([]byte(header)) + \".\" + base64.RawURLEncoding.EncodeToString([]byte(body))\n\treturn a + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(a)))\n}\nfunc token(priv ed25519.PrivateKey, c Claims) string {\n\tb, _ := json.Marshal(c)\n\treturn sign(priv, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, string(b))\n}\n\nfunc TestTokenBoundaries(t *testing.T) {\n\ts, priv, c, _ := fixture(t)\n\tnow := time.Now()\n\tgood := token(priv, c)\n\tif got, e := s.Check(context.Background(), good); e != nil || got.ActorID != c.ActorID {\n\t\tt.Fatal(got, e)\n\t}\n\tfor _, mutate := range []func(*Claims){func(c *Claims) { c.Environment = \"production\" }, func(c *Claims) { c.Audience = \"other\" }, func(c *Claims) { c.ActorID = \"0\" }, func(c *Claims) { c.ExpiresAt = c.IssuedAt + 301 }, func(c *Claims) { c.ExpiresAt = now.Unix() }, func(c *Claims) { c.IssuedAt = now.Unix() + 20; c.NotBefore = c.IssuedAt }, func(c *Claims) { c.Scopes = []string{\"chat:audit\"} }, func(c *Claims) { c.SessionID = \"old\" }, func(c *Claims) { c.Scopes = []string{\"chat:use\", \"chat:use\"} }} {\n\t\tbad := c\n\t\tmutate(&bad)\n\t\tif _, e := s.verifier.Verify(token(priv, bad), now); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"accepted invalid claims\", bad, e)\n\t\t}\n\t}\n\tb, _ := json.Marshal(c)\n\tfor _, h := range []string{`{\"alg\":\"none\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\",\"kid\":\"v1\"}`, `{\"ALG\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"missing\"}`, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\",\"jku\":\"https://invalid\"}`} {\n\t\tif _, e := s.verifier.Verify(sign(priv, h, string(b)), now); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"header accepted\", h)\n\t\t}\n\t}\n\tfor _, body := range []string{string(b[:len(b)-1]) + `,\"sub\":\"2\"}`, strings.Replace(string(b), `\"sub\":\"18446744073709551615\"`, `\"sub\":18446744073709551615`, 1), string(b) + ` {}`, strings.Replace(string(b), `\"env\"`, `\"ENV\"`, 1)} {\n\t\tif _, e := s.verifier.Verify(sign(priv, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, body), now); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"body accepted\")\n\t\t}\n\t}\n}\n\nfunc TestTicketConcurrentReplayAndRevocation(t *testing.T) {\n\ts, priv, c, m := fixture(t)\n\tticket, exp, e := s.IssueTicket(context.Background(), token(priv, c))\n\tif e != nil || time.Until(exp) > 30*time.Second {\n\t\tt.Fatal(e)\n\t}\n\tvar successes atomic.Int32\n\tvar wg sync.WaitGroup\n\tfor range 24 {\n\t\twg.Go(func() {\n\t\t\tif _, e := s.ConsumeTicket(context.Background(), ticket); e == nil {\n\t\t\t\tsuccesses.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif successes.Load() != 1 {\n\t\tt.Fatal(successes.Load())\n\t}\n\tticket, _, e = s.IssueTicket(context.Background(), token(priv, c))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return ErrUnauthorized })\n\tif _, e = s.ConsumeTicket(context.Background(), ticket); e != ErrUnauthorized {\n\t\tt.Fatal(\"revoked ticket\", e)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return nil })\n\tm.fail = true\n\tif _, _, e = s.IssueTicket(context.Background(), token(priv, c)); e != ports.ErrUnavailable {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = s.Check(context.Background(), token(priv, c)); e != nil {\n\t\tt.Fatal(\"Redis must not block access-token HTTP\", e)\n\t}\n}\n\nfunc TestSessionDeadlineBudgetAndSocketRefresh(t *testing.T) {\n\ts, priv, c, _ := fixture(t)\n\tsocket := NewSocketIdentity(c)\n\tfresh := c\n\tfresh.ExpiresAt--\n\tif e := socket.Refresh(context.Background(), s, token(priv, fresh)); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\tfresh = c\n\tfresh.ActorID = \"3\"\n\tif e := socket.Refresh(context.Background(), s, token(priv, fresh)); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\tif e := socket.Refresh(context.Background(), s, token(priv, c)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return ErrUnauthorized })\n\tif _, e := socket.Current(context.Background(), s); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\tentered := make(chan struct{}, 2)\n\ts.source = sourceFunc(func(ctx context.Context, _ Claims) error { entered <- struct{}{}; <-ctx.Done(); return ctx.Err() })\n\tvar wg sync.WaitGroup\n\tfor range 2 {\n\t\twg.Go(func() { s.Check(context.Background(), token(priv, c)) })\n\t}\n\t<-entered\n\t<-entered\n\tif _, e := s.Check(context.Background(), token(priv, c)); e != ports.ErrBusy {\n\t\tt.Fatal(e)\n\t}\n\twg.Wait()\n}\n\nfunc TestInternalSignatureBindsRequestAndNonce(t *testing.T) {\n\t_, _, _, m := fixture(t)\n\ta, e := NewInternal(\"test\", map[string][]byte{\"v1\": []byte(strings.Repeat(\"k\", 32))}, m, 100*time.Millisecond)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tbody := []byte(`{\"actor_id\":\"1\"}`)\n\tnow := time.Now()\n\tr := httptest.NewRequest(\"POST\", \"http://127.0.0.1/internal?a=%2F&b=1\", nil)\n\tr.RequestURI = r.URL.RequestURI()\n\tif e = a.Sign(r, body, \"v1\", now); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = a.Verify(context.Background(), r, []byte(`{}`), now); e != ErrUnauthorized {\n\t\tt.Fatal(\"body tamper\", e)\n\t}\n\tother := r.Clone(context.Background())\n\tother.RequestURI = \"/internal?b=1&a=%2F\"\n\tif e = a.Verify(context.Background(), other, body, now); e != ErrUnauthorized {\n\t\tt.Fatal(\"query reorder\", e)\n\t}\n\tvar wg sync.WaitGroup\n\tvar successes atomic.Int32\n\tfor range 20 {\n\t\twg.Go(func() {\n\t\t\tif a.Verify(context.Background(), r, body, now) == nil {\n\t\t\t\tsuccesses.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif successes.Load() != 1 {\n\t\tt.Fatal(successes.Load())\n\t}\n\ta.Sign(r, body, \"v1\", now.Add(-31*time.Second))\n\tif e = a.Verify(context.Background(), r, body, now); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\ta.Sign(r, body, \"v1\", now)\n\tr.Header.Add(\"X-Chat-Environment\", \"test\")\n\tif e = a.Verify(context.Background(), r, body, now); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\ta.Sign(r, body, \"v1\", now)\n\tm.fail = true\n\tif e = a.Verify(context.Background(), r, body, now); e != ports.ErrUnavailable {\n\t\tt.Fatal(e)\n\t}\n}\n","chat/internal/auth/config.go":"package auth\n\nimport (\n\t\"crypto/ed25519\"\n\t\"encoding/base64\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Config struct {\n\tEnabled    bool              `json:\"enabled\"`\n\tPublicKeys map[string]string `json:\"public_keys,omitempty\"`\n}\n\nfunc (c Config) Verifier(environment string) (*Verifier, error) {\n\tkeys := map[string]ed25519.PublicKey{}\n\tfor id, encoded := range c.PublicKeys {\n\t\tk, e := base64.StdEncoding.Strict().DecodeString(encoded)\n\t\tif e != nil || len(k) != 32 || base64.StdEncoding.EncodeToString(k) != encoded {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\tkeys[id] = ed25519.PublicKey(k)\n\t}\n\treturn NewVerifier(environment, keys)\n}\n","chat/internal/auth/governance.go":"package auth\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Scope-specific authority stays live under the caller's transaction. Audit\n// mini identities deliberately cannot enter the ordinary member authorizer.\nfunc (s *MySQLSource) ValidateAuditMiniLocked(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif p.Kind != \"mini_audit\" || len(p.Scopes) != 1 || p.Scopes[0] != \"chat:audit\" {\n\t\treturn ErrUnauthorized\n\t}\n\tvar hash string\n\terr := tx.QueryRowContext(ctx, `SELECT token_hash FROM login_sessions WHERE id=? LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&hash)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tmini := p\n\tmini.Kind = \"mini\"\n\tmini.Scopes = []string{\"chat:use\"}\n\tmini.SessionVersion = digest(\"mini-v1\\n\" + string(p.SourceID) + \"\\n\" + hash + \"\\n\" + string(p.ActorID))\n\tif err = s.ValidatePrincipalLocked(ctx, tx, mini); err != nil {\n\t\treturn err\n\t}\n\tvar version string\n\terr = tx.QueryRowContext(ctx, `SELECT authority_version FROM chat_mini_auditors WHERE user_id=? AND enabled=1 LOCK IN SHARE MODE`, string(p.ActorID)).Scan(&version)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !hex64.MatchString(version) || p.SessionVersion != digest(\"mini-audit-v1\\n\"+string(p.SourceID)+\"\\n\"+hash+\"\\n\"+string(p.ActorID)+\"\\n\"+version) {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\nfunc (s *MySQLSource) ValidateAdminLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, scope string) error {\n\tif scope == \"chat:audit\" && p.Kind == \"mini_audit\" {\n\t\treturn s.ValidateAuditMiniLocked(ctx, tx, p)\n\t}\n\tif tx == nil || p.Kind != \"admin\" || !p.ActorID.Valid() || p.ActorID == \"0\" || !p.SourceID.Valid() || p.SourceID == \"0\" || !validScopes(p.Kind, p.Scopes) || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\tfound := false\n\tfor _, v := range p.Scopes {\n\t\tif v == scope {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, sid, version, raw string\n\tvar expires int64\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(admin_id AS CHAR),session_hash,session_version,scopes_json,UNIX_TIMESTAMP(expires_at) FROM chat_admin_sessions WHERE id=? AND revoked_at IS NULL AND expires_at>UTC_TIMESTAMP() LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&actor, &sid, &version, &raw, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar scopes []string\n\tif json.Unmarshal([]byte(raw), &scopes) != nil || !validScopes(\"admin\", scopes) {\n\t\treturn ErrUnauthorized\n\t}\n\tfound = false\n\tfor _, v := range scopes {\n\t\tif v == scope {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found || actor != string(p.ActorID) || sid != p.SessionID || version != p.SessionVersion || p.ExpiresAt.Unix() > expires {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n","chat/internal/auth/http.go":"package auth\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Handler struct {\n\tservice *Service\n\tgate    chan struct{}\n}\n\nfunc NewHandler(service *Service, concurrency int) (*Handler, error) {\n\tif service == nil || concurrency < 1 || concurrency > 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Handler{service, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tid, e := randomID()\n\tif e != nil {\n\t\tid = \"unavailable\"\n\t}\n\tw.Header().Set(\"X-Request-ID\", id)\n\tfail := func(status int, code, message string, retryable bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"message\": message, \"retryable\": retryable, \"server_time\": time.Now().UTC().Format(time.RFC3339Nano)})\n\t\t}\n\t}\n\texpected := \"GET\"\n\tif r.URL.Path == \"/chat/api/v1/auth/socket-ticket\" {\n\t\texpected = \"POST\"\n\t} else if r.URL.Path != \"/chat/api/v1/auth/session\" {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", \"接口未开放\", false)\n\t\treturn\n\t}\n\tif r.Method != expected {\n\t\tw.Header().Set(\"Allow\", expected)\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", \"请求方法不支持\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"请求参数不正确\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, \"CHAT_RESOURCE_BUSY\", \"请求较多，请稍后重试\", true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效，请重新进入\", false)\n\t\treturn\n\t}\n\tcredential := strings.TrimPrefix(headers[0], \"Bearer \")\n\tcontroller := http.NewResponseController(w)\n\t_ = controller.SetReadDeadline(time.Now().Add(h.service.timeout))\n\tbody, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 256))\n\tif e != nil {\n\t\t// Leave an expired read deadline in place and close the connection;\n\t\t// net/http must not drain a stalled request body after the handler returns.\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar oversized *http.MaxBytesError\n\t\tif errors.As(e, &oversized) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", \"请求内容过大\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", \"请求未及时完成，请重试\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = controller.SetReadDeadline(time.Time{})\n\tif len(strings.TrimSpace(string(body))) > 0 && (expected == \"GET\" || strings.TrimSpace(string(body)) != \"{}\") {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"请求参数不正确\", false)\n\t\treturn\n\t}\n\tvar data any\n\tif expected == \"GET\" {\n\t\tvar c Claims\n\t\tc, e = h.service.Check(r.Context(), credential)\n\t\tif e == nil {\n\t\t\tdata = map[string]any{\"actor_id\": c.ActorID, \"kind\": c.Kind, \"env\": c.Environment, \"scopes\": c.Scopes, \"expires_at\": time.Unix(c.ExpiresAt, 0).UTC(), \"business_enabled\": false}\n\t\t}\n\t} else {\n\t\tvar ticket string\n\t\tvar expiry time.Time\n\t\tticket, expiry, e = h.service.IssueTicket(r.Context(), credential)\n\t\tif e == nil {\n\t\t\tdata = map[string]any{\"ticket\": ticket, \"expires_at\": expiry, \"business_enabled\": false}\n\t\t}\n\t}\n\tif e != nil {\n\t\tswitch e {\n\t\tcase ErrUnauthorized:\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效，请重新进入\", false)\n\t\tcase ports.ErrBusy:\n\t\t\tfail(429, \"CHAT_RESOURCE_BUSY\", \"请求较多，请稍后重试\", true)\n\t\tdefault:\n\t\t\tfail(503, \"CHAT_DEPENDENCY_UNAVAILABLE\", \"聊天身份暂不可用，请稍后重试\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"ok\": true, \"request_id\": id, \"data\": data, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/auth/http_test.go":"package auth\n\nimport (\n\t\"bufio\"\n\t\"context\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestAuthHTTPBoundary(t *testing.T) {\n\ts, priv, c, m := fixture(t)\n\th, e := NewHandler(s, 2)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcredential := token(priv, c)\n\tfor _, tc := range []struct {\n\t\tmethod, path, body, credential string\n\t\tstatus                         int\n\t}{\n\t\t{\"GET\", \"/chat/api/v1/auth/session\", \"\", credential, 200},\n\t\t{\"POST\", \"/chat/api/v1/auth/socket-ticket\", \"{}\", credential, 200},\n\t\t{\"GET\", \"/chat/api/v1/auth/socket-ticket\", \"\", credential, 405},\n\t\t{\"GET\", \"/chat/api/v1/auth/session?token=secret-input\", \"\", credential, 400},\n\t\t{\"GET\", \"/chat/api/v1/auth/session\", \"\", \"\", 401},\n\t\t{\"GET\", \"/chat/api/v1/auth/session\", \"\", \"bad\", 401},\n\t\t{\"POST\", \"/chat/api/v1/auth/socket-ticket\", `{\"actor_id\":\"3\"}`, credential, 400},\n\t\t{\"POST\", \"/chat/api/v1/auth/socket-ticket\", strings.Repeat(\"x\", 257), credential, 413},\n\t\t{\"GET\", \"/chat/api/v1/messages\", \"\", credential, 404},\n\t} {\n\t\tr := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))\n\t\tif tc.credential != \"\" {\n\t\t\tr.Header.Set(\"Authorization\", \"Bearer \"+tc.credential)\n\t\t}\n\t\tw := httptest.NewRecorder()\n\t\th.ServeHTTP(w, r)\n\t\tif w.Code != tc.status || w.Header().Get(\"Cache-Control\") != \"no-store\" || strings.Contains(w.Body.String(), credential) || strings.Contains(w.Body.String(), \"secret-input\") {\n\t\t\tt.Fatalf(\"%s expected %d got %d\", tc.path, tc.status, w.Code)\n\t\t}\n\t}\n\tm.fail = true\n\tr := httptest.NewRequest(\"POST\", \"/chat/api/v1/auth/socket-ticket\", nil)\n\tr.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\tw := httptest.NewRecorder()\n\th.ServeHTTP(w, r)\n\tif w.Code != 503 {\n\t\tt.Fatal(w.Code)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return ports.ErrUnavailable })\n\tr = httptest.NewRequest(\"GET\", \"/chat/api/v1/auth/session\", nil)\n\tr.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\tw = httptest.NewRecorder()\n\th.ServeHTTP(w, r)\n\tif w.Code != 503 {\n\t\tt.Fatal(w.Code)\n\t}\n}\n\nfunc TestAuthHTTPBodyDeadline(t *testing.T) {\n\ts, priv, c, _ := fixture(t)\n\th, _ := NewHandler(s, 2)\n\tserver := httptest.NewServer(h)\n\tdefer server.Close()\n\tconnection, e := net.DialTimeout(\"tcp\", strings.TrimPrefix(server.URL, \"http://\"), time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer connection.Close()\n\tconnection.SetDeadline(time.Now().Add(time.Second))\n\trequest := \"POST /chat/api/v1/auth/socket-ticket HTTP/1.1\\r\\nHost: fixture\\r\\nAuthorization: Bearer \" + token(priv, c) + \"\\r\\nContent-Length: 2\\r\\n\\r\\n{\"\n\tif _, e = connection.Write([]byte(request)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tresponse, e := http.ReadResponse(bufio.NewReader(connection), nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer response.Body.Close()\n\tif response.StatusCode != 408 {\n\t\tt.Fatal(response.StatusCode)\n\t}\n}\n","chat/internal/auth/internal.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"net/http\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// InternalAuth keys are independent from PHP's Ed25519 signing key. A verified\n// service request still needs an explicit route/purpose and actor authorization.\ntype InternalAuth struct {\n\tenvironment string\n\tkeys        map[string][]byte\n\tstore       OneTimeStore\n\ttimeout     time.Duration\n}\n\nfunc NewInternal(environment string, keys map[string][]byte, store OneTimeStore, timeout time.Duration) (*InternalAuth, error) {\n\tif !validEnvironment(environment) || len(keys) < 1 || len(keys) > 3 || store == nil || timeout < 50*time.Millisecond || timeout > 5*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ta := &InternalAuth{environment: environment, keys: map[string][]byte{}, store: store, timeout: timeout}\n\tfor id, k := range keys {\n\t\tif !keyID.MatchString(id) || len(k) != 32 {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\ta.keys[id] = append([]byte(nil), k...)\n\t}\n\treturn a, nil\n}\n\nfunc canonical(r *http.Request, body []byte, env, kid, stamp, nonce string) (string, error) {\n\turi := r.URL.RequestURI()\n\tif r.RequestURI != \"\" {\n\t\turi = r.RequestURI\n\t}\n\tif r.Method != \"POST\" || len(body) > 64<<10 || len(uri) > 2048 || !strings.HasPrefix(uri, \"/\") || strings.ContainsAny(uri, \"\\r\\n#\") {\n\t\treturn \"\", ErrUnauthorized\n\t}\n\th := sha256.Sum256(body)\n\treturn strings.Join([]string{\"chat-internal-v1\", r.Method, uri, hex.EncodeToString(h[:]), stamp, nonce, env, kid}, \"\\n\"), nil\n}\n\nfunc (a *InternalAuth) Sign(r *http.Request, body []byte, kid string, now time.Time) error {\n\tk := a.keys[kid]\n\tif len(k) != 32 {\n\t\treturn ports.ErrInvalid\n\t}\n\tnonce, e := randomID()\n\tif e != nil {\n\t\treturn e\n\t}\n\tstamp := strconv.FormatInt(now.Unix(), 10)\n\tc, e := canonical(r, body, a.environment, kid, stamp, nonce)\n\tif e != nil {\n\t\treturn e\n\t}\n\tmac := hmac.New(sha256.New, k)\n\t_, _ = mac.Write([]byte(c))\n\tfor key, value := range map[string]string{\"Environment\": a.environment, \"Key-ID\": kid, \"Timestamp\": stamp, \"Nonce\": nonce, \"Signature\": hex.EncodeToString(mac.Sum(nil))} {\n\t\tr.Header.Set(\"X-Chat-\"+key, value)\n\t}\n\treturn nil\n}\n\nfunc (a *InternalAuth) Verify(ctx context.Context, r *http.Request, body []byte, now time.Time) error {\n\tfields := map[string]string{}\n\tfor _, name := range []string{\"Environment\", \"Key-ID\", \"Timestamp\", \"Nonce\", \"Signature\"} {\n\t\tv := r.Header.Values(\"X-Chat-\" + name)\n\t\tif len(v) != 1 {\n\t\t\treturn ErrUnauthorized\n\t\t}\n\t\tfields[name] = v[0]\n\t}\n\tenv, kid, stamp, nonce := fields[\"Environment\"], fields[\"Key-ID\"], fields[\"Timestamp\"], fields[\"Nonce\"]\n\tts, e := strconv.ParseInt(stamp, 10, 64)\n\tif e != nil || strconv.FormatInt(ts, 10) != stamp || ts < now.Unix()-30 || ts > now.Unix()+30 || env != a.environment || !hex64.MatchString(nonce) || !hex64.MatchString(fields[\"Signature\"]) {\n\t\treturn ErrUnauthorized\n\t}\n\tk := a.keys[kid]\n\tif len(k) != 32 {\n\t\treturn ErrUnauthorized\n\t}\n\tc, e := canonical(r, body, env, kid, stamp, nonce)\n\tif e != nil {\n\t\treturn e\n\t}\n\tmac := hmac.New(sha256.New, k)\n\t_, _ = mac.Write([]byte(c))\n\tsig, _ := hex.DecodeString(fields[\"Signature\"])\n\tif !hmac.Equal(sig, mac.Sum(nil)) {\n\t\treturn ErrUnauthorized\n\t}\n\tctx, cancel := context.WithTimeout(ctx, a.timeout)\n\tdefer cancel()\n\tok, e := a.store.Put(ctx, \"nonce:\"+digest(kid+\":\"+nonce), \"1\", 61*time.Second)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !ok {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n","chat/internal/auth/mysql.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/subtle\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// MySQLSource is SELECT-only on PHP-owned identity tables. No last_seen writes.\ntype MySQLSource struct{ db *sql.DB }\n\nfunc NewMySQLSource(db *sql.DB) (*MySQLSource, error) {\n\tif db == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &MySQLSource{db}, nil\n}\nfunc (s *MySQLSource) Validate(ctx context.Context, c Claims) error {\n\tif c.Kind == \"mini_audit\" {\n\t\ttx, err := s.db.BeginTx(ctx, nil)\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tdefer tx.Rollback()\n\t\tp := ports.Principal{ActorID: c.ActorID, SourceID: c.SourceID, Kind: c.Kind, Scopes: c.Scopes, SessionID: c.SessionID, SessionVersion: c.Version, ExpiresAt: time.Unix(c.ExpiresAt, 0)}\n\t\tif err = s.ValidateAuditMiniLocked(ctx, tx, p); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tif c.Kind != \"mini\" {\n\t\tif c.Kind == \"admin\" {\n\t\t\treturn s.validateAdmin(ctx, c)\n\t\t}\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, hash string\n\tvar expires int64\n\terr := s.db.QueryRowContext(ctx, `SELECT CAST(s.user_id AS CHAR),s.token_hash,UNIX_TIMESTAMP(s.expires_at)\n FROM login_sessions s JOIN users u ON u.id=s.user_id AND u.status='active'\n WHERE s.id=? AND s.status='active' AND s.expires_at>UTC_TIMESTAMP()\n AND COALESCE(s.demo_actor_user_id,0)=0 AND COALESCE(s.test_actor_user_id,0)=0\n AND COALESCE(s.test_instance_id,0)=0 AND s.test_actor_expires_at IS NULL LIMIT 1`, string(c.SourceID)).Scan(&actor, &hash, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tsid := digest(\"mini\\n\" + string(c.SourceID) + \"\\n\" + hash)\n\tversion := digest(\"mini-v1\\n\" + string(c.SourceID) + \"\\n\" + hash + \"\\n\" + actor)\n\tif actor != string(c.ActorID) || !hex64.MatchString(hash) || subtle.ConstantTimeCompare([]byte(sid), []byte(c.SessionID)) != 1 || subtle.ConstantTimeCompare([]byte(version), []byte(c.Version)) != 1 || expires <= time.Now().Unix() || c.ExpiresAt > expires {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n\n// ValidatePrincipalLocked is the mini-session final check for a caller-owned\n// authorization/message transaction. PHP logout/disable cannot commit past it.\n// The Principal must already come from verification of a signed access token.\nfunc (s *MySQLSource) ValidatePrincipalLocked(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif tx == nil || p.Kind != \"mini\" || !p.ActorID.Valid() || p.ActorID == \"0\" || !p.SourceID.Valid() || p.SourceID == \"0\" ||\n\t\t!hex64.MatchString(p.SessionID) || !hex64.MatchString(p.SessionVersion) || !validScopes(p.Kind, p.Scopes) || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, hash string\n\tvar expires int64\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(s.user_id AS CHAR),s.token_hash,UNIX_TIMESTAMP(s.expires_at)\n\t\tFROM login_sessions s JOIN users u ON u.id=s.user_id AND u.status='active'\n\t\tWHERE s.id=? AND s.status='active' AND s.expires_at>UTC_TIMESTAMP()\n\t\tAND COALESCE(s.demo_actor_user_id,0)=0 AND COALESCE(s.test_actor_user_id,0)=0\n\t\tAND COALESCE(s.test_instance_id,0)=0 AND s.test_actor_expires_at IS NULL LIMIT 1 LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&actor, &hash, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif actor != string(p.ActorID) || !hex64.MatchString(hash) || p.SessionID != digest(\"mini\\n\"+string(p.SourceID)+\"\\n\"+hash) ||\n\t\tp.SessionVersion != digest(\"mini-v1\\n\"+string(p.SourceID)+\"\\n\"+hash+\"\\n\"+actor) || p.ExpiresAt.Unix() > expires || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n\nfunc (s *MySQLSource) validateAdmin(ctx context.Context, c Claims) error {\n\tvar actor, sid, version, scopesJSON string\n\tvar expires int64\n\terr := s.db.QueryRowContext(ctx, `SELECT CAST(s.admin_id AS CHAR),s.session_hash,s.session_version,s.scopes_json,UNIX_TIMESTAMP(s.expires_at)\n FROM chat_admin_sessions s\n WHERE s.id=? AND s.revoked_at IS NULL AND s.expires_at>UTC_TIMESTAMP()\n LIMIT 1`, string(c.SourceID)).Scan(&actor, &sid, &version, &scopesJSON, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif actor != string(c.ActorID) || sid != c.SessionID || version != c.Version || expires <= time.Now().Unix() || c.ExpiresAt > expires {\n\t\treturn ErrUnauthorized\n\t}\n\tvar scopes []string\n\tif json.Unmarshal([]byte(scopesJSON), &scopes) != nil || !validScopes(\"admin\", scopes) {\n\t\treturn ErrUnauthorized\n\t}\n\tfor _, wanted := range c.Scopes {\n\t\tfound := false\n\t\tfor _, allowed := range scopes {\n\t\t\tif wanted == allowed {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn ErrUnauthorized\n\t\t}\n\t}\n\treturn nil\n}\n\n// ValidateMediaAdminLocked is a distinct prereview permission. Session/role\n// changes revoke the persisted PHP-issued grant via the identity trigger.\nfunc (s *MySQLSource) ValidateMediaAdminLocked(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif p.Kind != \"admin\" || !p.ActorID.Valid() || !p.SourceID.Valid() || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\tallowed := false\n\tfor _, scope := range p.Scopes {\n\t\tif scope == \"chat:images\" {\n\t\t\tallowed = true\n\t\t}\n\t}\n\tif !allowed {\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, sid, version, scopes string\n\tvar expires int64\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(s.admin_id AS CHAR),s.session_hash,s.session_version,s.scopes_json,UNIX_TIMESTAMP(s.expires_at) FROM chat_admin_sessions s WHERE s.id=? AND s.revoked_at IS NULL AND s.expires_at>UTC_TIMESTAMP() LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&actor, &sid, &version, &scopes, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar list []string\n\tjson.Unmarshal([]byte(scopes), &list)\n\tmoderate := false\n\tfor _, v := range list {\n\t\tif v == \"chat:images\" {\n\t\t\tmoderate = true\n\t\t}\n\t}\n\tif !moderate || actor != string(p.ActorID) || sid != p.SessionID || version != p.SessionVersion || p.ExpiresAt.Unix() > expires {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n","chat/internal/auth/mysql_integration_test.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\nfunc TestMySQLAuthorityAndPHPIssuer(t *testing.T) {\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"isolated MySQL/PHP not provided\")\n\t}\n\taddress := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\thost, port, e := net.SplitHostPort(address)\n\tif e != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"explicit isolated endpoint required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)\n\tdefer cancel()\n\tconfig := mysql.NewConfig()\n\tconfig.Net = \"tcp\"\n\tconfig.Addr = address\n\tconfig.User = \"root\"\n\tconfig.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tconfig.Timeout = time.Second\n\tconfig.ReadTimeout = time.Second\n\tconfig.WriteTimeout = time.Second\n\tconfig.Params = map[string]string{\"time_zone\": \"'+00:00'\"}\n\tconnector, e := mysql.NewConnector(config)\n\tif e != nil {\n\t\tt.Fatal(\"fixture connector\")\n\t}\n\troot := sql.OpenDB(connector)\n\troot.SetMaxOpenConns(1)\n\tdefer root.Close()\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"invalid fixture host\")\n\t}\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tdatabase, user := \"bixuan_test_auth_\"+suffix, \"bxchat_test_\"+suffix\n\tpw, _ := randomID()\n\texecute := func(query string) {\n\t\tt.Helper()\n\t\tif _, e := root.ExecContext(ctx, query); e != nil {\n\t\t\tvar databaseError *mysql.MySQLError\n\t\t\tif errors.As(e, &databaseError) {\n\t\t\t\tt.Fatalf(\"isolated fixture MySQL code=%d\", databaseError.Number)\n\t\t\t}\n\t\t\tt.Fatal(\"isolated fixture query failed\")\n\t\t}\n\t}\n\texecute(\"CREATE DATABASE `\" + database + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tdefer root.Exec(\"DROP DATABASE IF EXISTS `\" + database + \"`\")\n\texecute(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY '\" + pw + \"'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"CREATE TABLE `\" + database + \"`.users(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB\")\n\texecute(\"CREATE TABLE `\" + database + \"`.login_sessions(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED,token_hash CHAR(64) CHARACTER SET ascii COLLATE ascii_bin UNIQUE,status VARCHAR(24),expires_at DATETIME,last_seen_at DATETIME NULL,demo_actor_user_id BIGINT UNSIGNED NULL,test_actor_user_id BIGINT UNSIGNED NULL,test_instance_id BIGINT UNSIGNED NULL,test_actor_expires_at DATETIME NULL) ENGINE=InnoDB\")\n\texecute(\"INSERT INTO `\" + database + \"`.users VALUES(18446744073709551615,'active')\")\n\tloginToken, _ := randomID()\n\thash := digest(loginToken)\n\texecute(\"INSERT INTO `\" + database + \"`.login_sessions(id,user_id,token_hash,status,expires_at) VALUES(7,18446744073709551615,'\" + hash + \"','active',UTC_TIMESTAMP()+INTERVAL 1 HOUR)\")\n\tfor _, table := range []string{\"users\", \"login_sessions\"} {\n\t\texecute(\"GRANT SELECT ON `\" + database + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\treadConfig := *config\n\treadConfig.User = user\n\treadConfig.Passwd = pw\n\treadConfig.DBName = database\n\tconnector, e = mysql.NewConnector(&readConfig)\n\tif e != nil {\n\t\tt.Fatal(\"source connector\")\n\t}\n\tdb := sql.OpenDB(connector)\n\tdb.SetMaxOpenConns(2)\n\tdefer db.Close()\n\tsource, _ := NewMySQLSource(db)\n\tvar seed [32]byte\n\tif _, e = rand.Read(seed[:]); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpriv := ed25519.NewKeyFromSeed(seed[:])\n\tv, _ := NewVerifier(\"test\", map[string]ed25519.PublicKey{\"chat-v1\": priv.Public().(ed25519.PublicKey)})\n\tservice, _ := NewService(v, source, nil, 2, 500*time.Millisecond)\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tt.Fatal(\"explicit PHP runtime required\")\n\t}\n\tpath, e := filepath.Abs(\"../../../server/tests/chat_identity_contract.php\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcmd := exec.CommandContext(ctx, php, path, \"--issue-mini\")\n\tcmd.Env = append(os.Environ(), \"CHAT_AUTH_TEST_MYSQL_HOST=127.0.0.1\", \"CHAT_AUTH_TEST_MYSQL_PORT=\"+port, \"CHAT_AUTH_TEST_MYSQL_DATABASE=\"+database, \"CHAT_AUTH_TEST_MYSQL_USER=\"+user, \"CHAT_AUTH_TEST_MYSQL_PASSWORD=\"+pw, \"CHAT_AUTH_TEST_LOGIN_TOKEN=\"+loginToken, \"CHAT_ACCESS_SEED=\"+base64.StdEncoding.EncodeToString(seed[:]))\n\toutput, e := cmd.Output()\n\tif e != nil {\n\t\tt.Fatal(\"PHP real exchange failed\")\n\t}\n\tvar result struct {\n\t\tToken string `json:\"access_token\"`\n\t}\n\tif json.Unmarshal(output, &result) != nil || result.Token == \"\" {\n\t\tt.Fatal(\"exchange envelope\")\n\t}\n\tc, e := service.Check(ctx, result.Token)\n\tif e != nil || c.ActorID != \"18446744073709551615\" || c.SourceID != \"7\" {\n\t\tt.Fatal(\"cross-language identity mismatch\", e)\n\t}\n\tvar lastSeen sql.NullString\n\tif db.QueryRowContext(ctx, \"SELECT last_seen_at FROM login_sessions WHERE id=7\").Scan(&lastSeen) != nil || lastSeen.Valid {\n\t\tt.Fatal(\"authentication wrote last_seen\")\n\t}\n\tfor _, tc := range []struct{ change, undo string }{\n\t\t{\"UPDATE login_sessions SET status='revoked' WHERE id=7\", \"UPDATE login_sessions SET status='active' WHERE id=7\"},\n\t\t{\"UPDATE users SET status='disabled'\", \"UPDATE users SET status='active'\"},\n\t\t{\"UPDATE login_sessions SET demo_actor_user_id=2\", \"UPDATE login_sessions SET demo_actor_user_id=NULL\"},\n\t\t{\"UPDATE login_sessions SET test_instance_id=2\", \"UPDATE login_sessions SET test_instance_id=NULL\"},\n\t\t{\"UPDATE login_sessions SET expires_at=UTC_TIMESTAMP()-INTERVAL 1 SECOND\", \"UPDATE login_sessions SET expires_at=UTC_TIMESTAMP()+INTERVAL 1 HOUR\"},\n\t\t{\"UPDATE login_sessions SET token_hash=REPEAT('f',64)\", \"UPDATE login_sessions SET token_hash='\" + hash + \"'\"},\n\t} {\n\t\tif _, e = root.ExecContext(ctx, \"USE `\"+database+\"`\"); e != nil {\n\t\t\tt.Fatal(\"select fixture\")\n\t\t}\n\t\texecute(tc.change)\n\t\tif e = service.Validate(ctx, c); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"revocation not observed\", e)\n\t\t}\n\t\texecute(tc.undo)\n\t\tif e = service.Validate(ctx, c); e != nil {\n\t\t\tt.Fatal(\"fixture recovery\", e)\n\t\t}\n\t}\n\tif _, e = db.ExecContext(ctx, \"UPDATE login_sessions SET last_seen_at=UTC_TIMESTAMP() WHERE id=7\"); e == nil {\n\t\tt.Fatal(\"Go identity unexpectedly has writes\")\n\t}\n\n\t// Admin exchange uses the existing PHP Session and a PHP-only write account.\n\tschemaPath, _ := filepath.Abs(\"../../../server/database/database.sql\")\n\tschema, e := os.ReadFile(schemaPath)\n\tif e != nil {\n\t\tt.Fatal(\"install schema fixture\")\n\t}\n\tstart := strings.Index(string(schema), \"CREATE TABLE `admin_users` (\")\n\tend := strings.Index(string(schema)[start:], \";\\n\")\n\tif start < 0 || end < 0 {\n\t\tt.Fatal(\"admin schema fixture\")\n\t}\n\texecute(string(schema)[start : start+end])\n\tmigrationPath, _ := filepath.Abs(\"../../../server/database/upgrades/2.7.0.sql\")\n\tmigration, e := os.ReadFile(migrationPath)\n\tif e != nil {\n\t\tt.Fatal(\"chat migration fixture\")\n\t}\n\tidentitySQL := strings.SplitN(string(migration), \"-- CHAT_SECTION identity\\n\", 2)\n\tif len(identitySQL) != 2 {\n\t\tt.Fatal(\"identity section missing\")\n\t}\n\tsection := strings.SplitN(identitySQL[1], \"-- CHAT_END identity\", 2)\n\tif len(section) != 2 {\n\t\tt.Fatal(\"identity section boundary missing\")\n\t}\n\tfor range 2 {\n\t\tfor _, statement := range strings.Split(section[0], \";\") {\n\t\t\tif strings.TrimSpace(statement) != \"\" {\n\t\t\t\texecute(statement)\n\t\t\t}\n\t\t}\n\t}\n\texecute(\"INSERT INTO admin_users(id,username,password_hash,real_name,role,status,must_change_password,created_at,updated_at) VALUES(2,'chat-fixture','fixture-password-hash','','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\")\n\tfor _, table := range []string{\"chat_admin_sessions\"} {\n\t\texecute(\"GRANT SELECT ON `\" + database + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tphpUser := \"bxphp_test_\" + suffix\n\tphpPassword, _ := randomID()\n\texecute(\"CREATE USER '\" + phpUser + \"'@'\" + fixtureHost + \"' IDENTIFIED BY '\" + phpPassword + \"'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + phpUser + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"GRANT SELECT ON `\" + database + \"`.admin_users TO '\" + phpUser + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"GRANT SELECT,INSERT,UPDATE ON `\" + database + \"`.chat_admin_sessions TO '\" + phpUser + \"'@'\" + fixtureHost + \"'\")\n\tsessionID, _ := randomID()\n\tsessionDir := t.TempDir()\n\tissueAdmin := func(mode string) string {\n\t\tt.Helper()\n\t\tcommand := exec.CommandContext(ctx, php, path, mode)\n\t\tcommand.Env = append(cmd.Env, \"CHAT_AUTH_TEST_MYSQL_USER=\"+phpUser, \"CHAT_AUTH_TEST_MYSQL_PASSWORD=\"+phpPassword, \"CHAT_AUTH_TEST_SESSION_DIR=\"+sessionDir, \"CHAT_AUTH_TEST_SESSION_ID=\"+sessionID)\n\t\tdata, err := command.Output()\n\t\tif err != nil {\n\t\t\tt.Fatal(\"PHP admin operation failed\")\n\t\t}\n\t\tvar r struct {\n\t\t\tToken string `json:\"access_token\"`\n\t\t}\n\t\tif json.Unmarshal(data, &r) != nil {\n\t\t\tt.Fatal(\"admin envelope\")\n\t\t}\n\t\treturn r.Token\n\t}\n\tadminToken := issueAdmin(\"--issue-admin\")\n\tadminClaims, e := service.Check(ctx, adminToken)\n\tif e != nil || adminClaims.Kind != \"admin\" || adminClaims.ActorID != \"2\" || len(adminClaims.Scopes) != 5 {\n\t\tt.Fatal(\"admin identity mismatch\", e)\n\t}\n\tevidenceScope := false\n\tfor _, scope := range adminClaims.Scopes {\n\t\tif scope == \"chat:evidence\" {\n\t\t\tevidenceScope = true\n\t\t}\n\t}\n\tif !evidenceScope {\n\t\tt.Fatal(\"super admin missing independently minted evidence scope\")\n\t}\n\tfresh := issueAdmin(\"--issue-admin\")\n\tfreshClaims, e := service.Check(ctx, fresh)\n\tif e != nil || freshClaims.Version != adminClaims.Version || freshClaims.SourceID != adminClaims.SourceID {\n\t\tt.Fatal(\"renewal rotated a valid session\")\n\t}\n\tfor _, tc := range []struct{ change, undo string }{\n\t\t{\"UPDATE admin_users SET role='viewer' WHERE id=2\", \"UPDATE admin_users SET role='super_admin' WHERE id=2\"},\n\t\t{\"UPDATE admin_users SET password_hash='changed' WHERE id=2\", \"UPDATE admin_users SET password_hash='fixture-password-hash' WHERE id=2\"},\n\t\t{\"UPDATE admin_users SET status='disabled' WHERE id=2\", \"UPDATE admin_users SET status='active' WHERE id=2\"},\n\t\t{\"UPDATE admin_users SET must_change_password=1 WHERE id=2\", \"UPDATE admin_users SET must_change_password=0 WHERE id=2\"},\n\t} {\n\t\texecute(tc.change)\n\t\tif e = service.Validate(ctx, adminClaims); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"admin revocation not observed\", e)\n\t\t}\n\t\texecute(tc.undo)\n\t\t// Re-authenticated PHP can issue a new version, never revive an old JWT.\n\t\tprevious := adminClaims.Version\n\t\tadminToken = issueAdmin(\"--issue-admin\")\n\t\tadminClaims, e = service.Check(ctx, adminToken)\n\t\tif e != nil || adminClaims.Version == previous {\n\t\t\tt.Fatal(\"revoked version was reused\", e)\n\t\t}\n\t}\n\tif _, err := db.QueryContext(ctx, \"SELECT password_hash FROM admin_users\"); err == nil {\n\t\tt.Fatal(\"Go can read admin passwords\")\n\t}\n\tif _, e = db.ExecContext(ctx, \"UPDATE chat_admin_sessions SET revoked_at=UTC_TIMESTAMP()\"); e == nil {\n\t\tt.Fatal(\"Go can write PHP admin sessions\")\n\t}\n\texecute(\"UPDATE admin_users SET role='finance' WHERE id=2\")\n\tfinanceToken := issueAdmin(\"--issue-admin\")\n\tfinanceClaims, e := service.Check(ctx, financeToken)\n\tif e != nil || len(financeClaims.Scopes) != 1 || financeClaims.Scopes[0] != \"chat:audit\" || financeClaims.Version == adminClaims.Version {\n\t\tt.Fatal(\"admin downscope mismatch\", e)\n\t}\n\tif e = service.Validate(ctx, adminClaims); e != ErrUnauthorized {\n\t\tt.Fatal(\"old admin version survived downgrade\", e)\n\t}\n\tissueAdmin(\"--logout-admin\")\n\tif e = service.Validate(ctx, financeClaims); e != ErrUnauthorized {\n\t\tt.Fatal(\"PHP logout did not revoke Go\", e)\n\t}\n\texecute(\"DROP TABLE `\" + database + \"`.login_sessions\")\n\tif _, e = service.Check(ctx, result.Token); e == nil || e == ErrUnauthorized {\n\t\tt.Fatal(\"database outage must be unavailable\")\n\t}\n}\n","chat/internal/auth/redis.go":"package auth\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\ntype RedisStore struct {\n\tclient *redis.Client\n\tprefix string\n}\n\nfunc NewRedisStore(client *redis.Client, environment, prefix string) (*RedisStore, error) {\n\tif client == nil || !validEnvironment(environment) || prefix != \"bxchat:\"+environment+\":\" {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &RedisStore{client, prefix + \"auth:\"}, nil\n}\nfunc (s *RedisStore) Put(ctx context.Context, key, value string, ttl time.Duration) (bool, error) {\n\tif ttl <= 0 || ttl > time.Minute+time.Second || len(value) > 4096 || !validStoreKey(key) {\n\t\treturn false, ports.ErrInvalid\n\t}\n\tok, e := s.client.SetNX(ctx, s.prefix+key, value, ttl).Result()\n\tif e != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn ok, nil\n}\nfunc (s *RedisStore) Take(ctx context.Context, key string) (string, error) {\n\tif !validStoreKey(key) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tv, e := s.client.GetDel(ctx, s.prefix+key).Result()\n\tif e == redis.Nil {\n\t\treturn \"\", nil\n\t}\n\tif e != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn v, nil\n}\nfunc validStoreKey(s string) bool {\n\tif len(s) == 71 && s[:7] == \"ticket:\" {\n\t\treturn hex64.MatchString(s[7:])\n\t}\n\treturn len(s) == 70 && s[:6] == \"nonce:\" && hex64.MatchString(s[6:])\n}\n","chat/internal/auth/redis_integration_test.go":"package auth\n\nimport (\n\t\"context\"\n\t\"net\"\n\t\"os\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/redis/go-redis/v9\"\n)\n\n// Explicit isolated endpoint only; never infer a production/default Redis.\nfunc TestRedisAtomicTicketAndNonce(t *testing.T) {\n\taddress := os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\")\n\tif address == \"\" {\n\t\tt.Skip(\"isolated Redis endpoint not provided\")\n\t}\n\th, _, e := net.SplitHostPort(address)\n\tif e != nil || net.ParseIP(h) == nil || !net.ParseIP(h).IsLoopback() {\n\t\tt.Fatal(\"isolated loopback required\")\n\t}\n\tclient := redis.NewClient(&redis.Options{Addr: address, PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, PipelinePoolSize: -1, DisableIdentity: true, Protocol: 2})\n\tdefer client.Close()\n\tstore, e := NewRedisStore(client, \"test\", \"bxchat:test:\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts, priv, c, _ := fixture(t)\n\ts.store = store\n\tctx := context.Background()\n\tticket, _, e := s.IssueTicket(ctx, token(priv, c))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tkey := \"bxchat:test:auth:ticket:\" + digest(ticket)\n\tttl := client.PTTL(ctx, key).Val()\n\tif ttl <= 0 || ttl > 30*time.Second {\n\t\tt.Fatal(ttl)\n\t}\n\tvar wg sync.WaitGroup\n\tvar count atomic.Int32\n\tfor range 32 {\n\t\twg.Go(func() {\n\t\t\tif _, e := s.ConsumeTicket(ctx, ticket); e == nil {\n\t\t\t\tcount.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif count.Load() != 1 {\n\t\tt.Fatal(count.Load())\n\t}\n\tif client.Exists(ctx, key).Val() != 0 {\n\t\tt.Fatal(\"consumed ticket survived\")\n\t}\n\tnonce, _ := randomID()\n\tnonceKey := \"nonce:\" + digest(nonce)\n\tdefer client.Del(ctx, \"bxchat:test:auth:\"+nonceKey)\n\tcount.Store(0)\n\tfor range 24 {\n\t\twg.Go(func() {\n\t\t\tif ok, e := store.Put(ctx, nonceKey, \"1\", 61*time.Second); e == nil && ok {\n\t\t\t\tcount.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif count.Load() != 1 {\n\t\tt.Fatal(\"nonce reservation\", count.Load())\n\t}\n\tttl = client.PTTL(ctx, \"bxchat:test:auth:\"+nonceKey).Val()\n\tif ttl < 60*time.Second || ttl > 61*time.Second {\n\t\tt.Fatal(ttl)\n\t}\n\tif _, e := NewRedisStore(client, \"production\", \"bxchat:test:\"); e == nil {\n\t\tt.Fatal(\"cross environment prefix\")\n\t}\n}\n","chat/internal/auth/service.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// OneTimeStore must implement linearizable put-if-absent and take-and-delete.\n// The key is already hashed/namespaced by its adapter; outages fail closed.\ntype OneTimeStore interface {\n\tPut(context.Context, string, string, time.Duration) (bool, error)\n\tTake(context.Context, string) (string, error)\n}\n\ntype Service struct {\n\tverifier *Verifier\n\tsource   SessionSource\n\tstore    OneTimeStore\n\tgate     chan struct{}\n\ttimeout  time.Duration\n}\n\nfunc NewService(v *Verifier, source SessionSource, store OneTimeStore, concurrency int, timeout time.Duration) (*Service, error) {\n\tif v == nil || source == nil || concurrency < 1 || concurrency > 32 || timeout < 50*time.Millisecond || timeout > 5*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Service{verifier: v, source: source, store: store, gate: make(chan struct{}, concurrency), timeout: timeout}, nil\n}\n\nfunc (s *Service) Authenticate(ctx context.Context, token string) (ports.Principal, error) {\n\tc, e := s.Check(ctx, token)\n\tif e != nil {\n\t\treturn ports.Principal{}, e\n\t}\n\treturn ports.Principal{ActorID: c.ActorID, SessionID: c.SessionID, Environment: c.Environment, Scopes: append([]string(nil), c.Scopes...), Kind: c.Kind, SourceID: c.SourceID, SessionVersion: c.Version, ExpiresAt: time.Unix(c.ExpiresAt, 0).UTC()}, nil\n}\n\nfunc (s *Service) Check(ctx context.Context, token string) (Claims, error) {\n\tc, e := s.verifier.Verify(token, time.Now())\n\tif e != nil {\n\t\treturn Claims{}, e\n\t}\n\tif e = s.Validate(ctx, c); e != nil {\n\t\treturn Claims{}, e\n\t}\n\treturn c, nil\n}\n\nfunc (s *Service) Validate(ctx context.Context, c Claims) error {\n\tif ctx.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif c.Environment != s.verifier.environment || c.ExpiresAt <= time.Now().Unix() {\n\t\treturn ErrUnauthorized\n\t}\n\tselect {\n\tcase s.gate <- struct{}{}:\n\t\tdefer func() { <-s.gate }()\n\tdefault:\n\t\treturn ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\terr := s.source.Validate(ctx, c)\n\tif err != nil {\n\t\tif err == ErrUnauthorized {\n\t\t\treturn err\n\t\t}\n\t\treturn ports.ErrUnavailable\n\t}\n\tif ctx.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif c.ExpiresAt <= time.Now().Unix() {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n\nfunc randomID() (string, error) {\n\tvar b [32]byte\n\tif _, e := rand.Read(b[:]); e != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn hex.EncodeToString(b[:]), nil\n}\nfunc digest(s string) string { h := sha256.Sum256([]byte(s)); return hex.EncodeToString(h[:]) }\n\nfunc (s *Service) IssueTicket(ctx context.Context, token string) (string, time.Time, error) {\n\tc, e := s.Check(ctx, token)\n\tif e != nil {\n\t\treturn \"\", time.Time{}, e\n\t}\n\tif s.store == nil {\n\t\treturn \"\", time.Time{}, ports.ErrUnavailable\n\t}\n\tticket, e := randomID()\n\tif e != nil {\n\t\treturn \"\", time.Time{}, e\n\t}\n\texp := time.Now().Add(30 * time.Second)\n\tif limit := time.Unix(c.ExpiresAt, 0); exp.After(limit) {\n\t\texp = limit\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tok, e := s.store.Put(ctx, \"ticket:\"+digest(ticket), token, time.Until(exp))\n\tif e != nil || !ok {\n\t\treturn \"\", time.Time{}, ports.ErrUnavailable\n\t}\n\treturn ticket, exp, nil\n}\n\nfunc (s *Service) ConsumeTicket(ctx context.Context, ticket string) (Claims, error) {\n\tif !hex64.MatchString(ticket) {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\tif s.store == nil {\n\t\treturn Claims{}, ports.ErrUnavailable\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttoken, e := s.store.Take(ctx, \"ticket:\"+digest(ticket))\n\tif e != nil {\n\t\treturn Claims{}, ports.ErrUnavailable\n\t}\n\tif token == \"\" {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\treturn s.Check(ctx, token)\n}\n\n// SocketIdentity is transport-independent; S10 must call Current before every\n// protected command/push and close on expiry. Refresh cannot switch principals.\ntype SocketIdentity struct {\n\tmu     sync.Mutex\n\tclaims Claims\n}\n\nfunc NewSocketIdentity(c Claims) *SocketIdentity {\n\tc.Scopes = append([]string(nil), c.Scopes...)\n\treturn &SocketIdentity{claims: c}\n}\nfunc (s *SocketIdentity) Current(ctx context.Context, auth *Service) (Claims, error) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tif e := auth.Validate(ctx, s.claims); e != nil {\n\t\treturn Claims{}, e\n\t}\n\tc := s.claims\n\tc.Scopes = append([]string(nil), c.Scopes...)\n\treturn c, nil\n}\nfunc (s *SocketIdentity) Refresh(ctx context.Context, auth *Service, token string) error {\n\tc, e := auth.Check(ctx, token)\n\tif e != nil {\n\t\treturn e\n\t}\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\told := s.claims\n\tif old.ExpiresAt <= time.Now().Unix() || c.ActorID != old.ActorID || c.Kind != old.Kind || c.SourceID != old.SourceID || c.SessionID != old.SessionID || c.Environment != old.Environment || c.Version != old.Version {\n\t\treturn ErrUnauthorized\n\t}\n\tfor _, scope := range c.Scopes {\n\t\tfound := false\n\t\tfor _, prior := range old.Scopes {\n\t\t\tif scope == prior {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn ErrUnauthorized\n\t\t}\n\t}\n\tif c.ExpiresAt < old.ExpiresAt {\n\t\treturn ErrUnauthorized\n\t}\n\ts.claims = c\n\treturn nil\n}\n","chat/internal/auth/token.go":"// Package auth verifies PHP-issued identities; it does not own accounts or roles.\npackage auth\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrUnauthorized = errors.New(\"CHAT_UNAUTHORIZED\")\nvar hex64 = regexp.MustCompile(`^[a-f0-9]{64}$`)\nvar keyID = regexp.MustCompile(`^[a-z0-9_-]{1,32}$`)\n\ntype Claims struct {\n\tIssuer      string   `json:\"iss\"`\n\tAudience    string   `json:\"aud\"`\n\tActorID     ports.ID `json:\"sub\"`\n\tKind        string   `json:\"kind\"`\n\tSourceID    ports.ID `json:\"source_id\"`\n\tSessionID   string   `json:\"session_id\"`\n\tVersion     string   `json:\"session_version\"`\n\tEnvironment string   `json:\"env\"`\n\tScopes      []string `json:\"scopes\"`\n\tIssuedAt    int64    `json:\"iat\"`\n\tNotBefore   int64    `json:\"nbf\"`\n\tExpiresAt   int64    `json:\"exp\"`\n\tJTI         string   `json:\"jti\"`\n}\n\n// SessionSource must read current persistent authority on every protected action.\n// A successful signature never replaces logout/disable/permission revocation.\ntype SessionSource interface {\n\tValidate(context.Context, Claims) error\n}\n\ntype Verifier struct {\n\tenvironment string\n\tkeys        map[string]ed25519.PublicKey\n}\n\nfunc NewVerifier(environment string, keys map[string]ed25519.PublicKey) (*Verifier, error) {\n\tif !validEnvironment(environment) || len(keys) < 1 || len(keys) > 3 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tv := &Verifier{environment: environment, keys: make(map[string]ed25519.PublicKey)}\n\tfor id, k := range keys {\n\t\tif !keyID.MatchString(id) || len(k) != ed25519.PublicKeySize {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\tv.keys[id] = append(ed25519.PublicKey(nil), k...)\n\t}\n\treturn v, nil\n}\n\nfunc validEnvironment(s string) bool { return s == \"development\" || s == \"test\" || s == \"production\" }\n\nfunc (v *Verifier) Verify(token string, now time.Time) (Claims, error) {\n\tvar c Claims\n\tif len(token) > 4096 {\n\t\treturn c, ErrUnauthorized\n\t}\n\tp := strings.Split(token, \".\")\n\tif len(p) != 3 {\n\t\treturn c, ErrUnauthorized\n\t}\n\th, err := base64.RawURLEncoding.Strict().DecodeString(p[0])\n\tif err != nil {\n\t\treturn c, ErrUnauthorized\n\t}\n\tvar header struct {\n\t\tAlgorithm string `json:\"alg\"`\n\t\tType      string `json:\"typ\"`\n\t\tKeyID     string `json:\"kid\"`\n\t}\n\tif !strictJSON(h, &header) || header.Algorithm != \"EdDSA\" || header.Type != \"JWT\" {\n\t\treturn c, ErrUnauthorized\n\t}\n\tk := v.keys[header.KeyID]\n\tif len(k) != ed25519.PublicKeySize {\n\t\treturn c, ErrUnauthorized\n\t}\n\tsig, err := base64.RawURLEncoding.Strict().DecodeString(p[2])\n\tif err != nil || !ed25519.Verify(k, []byte(p[0]+\".\"+p[1]), sig) {\n\t\treturn c, ErrUnauthorized\n\t}\n\tbody, err := base64.RawURLEncoding.Strict().DecodeString(p[1])\n\tif err != nil || !strictJSON(body, &c) {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\tt := now.Unix()\n\tif c.Issuer != \"bixuan-php:\"+v.environment || c.Audience != \"bixuan-chat\" || c.Environment != v.environment || !c.ActorID.Valid() || c.ActorID == \"0\" || !hex64.MatchString(c.SessionID) || !hex64.MatchString(c.Version) || !hex64.MatchString(c.JTI) ||\n\t\t(c.Kind != \"mini\" && c.Kind != \"admin\" && c.Kind != \"mini_audit\") || !c.SourceID.Valid() || c.SourceID == \"0\" || c.IssuedAt <= 0 || c.NotBefore != c.IssuedAt || c.IssuedAt > t+5 || c.ExpiresAt <= t || c.ExpiresAt <= c.IssuedAt || c.ExpiresAt-c.IssuedAt > 300 || !validScopes(c.Kind, c.Scopes) {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\treturn c, nil\n}\n\nfunc validScopes(kind string, scopes []string) bool {\n\tif len(scopes) < 1 || len(scopes) > 5 {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor _, s := range scopes {\n\t\tif seen[s] || !(s == \"chat:use\" && kind == \"mini\" || s == \"chat:audit\" && kind == \"mini_audit\" || kind == \"admin\" && (s == \"chat:audit\" || s == \"chat:moderate\" || s == \"chat:images\" || s == \"chat:evidence\" || s == \"chat:media\")) {\n\t\t\treturn false\n\t\t}\n\t\tseen[s] = true\n\t}\n\treturn true\n}\n\n// Reject duplicate/unknown/case-alias keys, trailing values and non-object roots.\nfunc strictJSON(data []byte, target any) bool {\n\tvar fields map[string]json.RawMessage\n\td := json.NewDecoder(bytes.NewReader(data))\n\tt, e := d.Token()\n\tif e != nil || t != json.Delim('{') {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tt, e = d.Token()\n\t\ts, ok := t.(string)\n\t\tif e != nil || !ok || seen[s] {\n\t\t\treturn false\n\t\t}\n\t\tseen[s] = true\n\t\tvar value json.RawMessage\n\t\tif d.Decode(&value) != nil {\n\t\t\treturn false\n\t\t}\n\t}\n\tif _, e = d.Token(); e != nil {\n\t\treturn false\n\t}\n\tif _, e = d.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\tif json.Unmarshal(data, &fields) != nil {\n\t\treturn false\n\t}\n\t// Re-encode after typed decoding to compare the exact accepted field names.\n\td = json.NewDecoder(bytes.NewReader(data))\n\td.DisallowUnknownFields()\n\tif d.Decode(target) != nil {\n\t\treturn false\n\t}\n\tencoded, e := json.Marshal(target)\n\tif e != nil {\n\t\treturn false\n\t}\n\tvar names map[string]json.RawMessage\n\tif json.Unmarshal(encoded, &names) != nil {\n\t\treturn false\n\t}\n\tfor name := range fields {\n\t\tif _, ok := names[name]; !ok {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n","chat/internal/avpipeline/config.go":"package avpipeline\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/imagepipeline\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/moderation\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"runtime\"\n)\n\ntype Config struct {\n\tEnabled          bool                `json:\"enabled\"`\n\tAudio            bool                `json:\"audio\"`\n\tVideo            bool                `json:\"video\"`\n\tPython           string              `json:\"python_binary\"`\n\tScript           string              `json:\"python_script\"`\n\tFFmpeg           string              `json:\"ffmpeg_binary\"`\n\tFFprobe          string              `json:\"ffprobe_binary\"`\n\tTempRoot         string              `json:\"temp_root\"`\n\tBucket           string              `json:\"bucket\"`\n\tPrivate          bool                `json:\"private_bucket\"`\n\tDownloadOrigin   string              `json:\"download_origin\"`\n\tUploadOrigin     string              `json:\"upload_origin\"`\n\tAccessKeyEnv     string              `json:\"access_key_env\"`\n\tSecretKeyEnv     string              `json:\"secret_key_env\"`\n\tASR              moderation.AVConfig `json:\"asr\"`\n\tDailyASR         int                 `json:\"daily_asr_budget\"`\n\tCallbackTokenEnv string              `json:\"callback_token_env\"`\n\tCallbackKeyEnv   string              `json:\"callback_key_env\"`\n}\n\nfunc (c Config) Validate() error {\n\tif !c.Enabled {\n\t\tif c.Audio || c.Video {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\treturn nil\n\t}\n\tnames := regexp.MustCompile(`^CHAT_[A-Z0-9_]{1,60}$`)\n\tif !c.Audio && !c.Video || runtime.GOOS != \"linux\" || !c.Private || c.DailyASR < 1 || c.DailyASR > 20000 {\n\t\treturn ports.ErrInvalid\n\t}\n\tfor _, name := range []string{c.AccessKeyEnv, c.SecretKeyEnv, c.CallbackTokenEnv, c.CallbackKeyEnv} {\n\t\tif !names.MatchString(name) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t}\n\tfor _, path := range []string{c.Python, c.Script, c.FFmpeg, c.FFprobe} {\n\t\tinfo, e := os.Stat(path)\n\t\tif !filepath.IsAbs(path) || e != nil || !info.Mode().IsRegular() {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t}\n\tinfo, e := os.Stat(c.TempRoot)\n\tif e != nil || !filepath.IsAbs(c.TempRoot) || !info.IsDir() || info.Mode().Perm()&0077 != 0 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\nfunc Build(c Config, env string, base *message.Service, safety *moderation.Service) (*message.AVService, *moderation.MediaCallback, error) {\n\tif c.Validate() != nil {\n\t\treturn nil, nil, ports.ErrInvalid\n\t}\n\tif !c.Enabled {\n\t\treturn nil, nil, nil\n\t}\n\tstorage, e := imagepipeline.NewQiniu(imagepipeline.QiniuConfig{Bucket: c.Bucket, Private: c.Private, AccessKey: os.Getenv(c.AccessKeyEnv), SecretKey: os.Getenv(c.SecretKeyEnv), DownloadOrigin: c.DownloadOrigin, UploadOrigin: c.UploadOrigin, Environment: env})\n\tif e != nil {\n\t\treturn nil, nil, e\n\t}\n\tinspector, e := moderation.NewAV(safety, c.ASR, nil)\n\tif e != nil {\n\t\treturn nil, nil, e\n\t}\n\traw, _ := json.Marshal(c)\n\thash := sha256.Sum256(raw)\n\thelper := &Helper{c.Python, c.Script, c.FFmpeg, c.FFprobe, c.TempRoot}\n\tservice, e := message.NewAVService(base, storage, helper, inspector, env, hex.EncodeToString(hash[:]), c.Audio, c.Video, c.DailyASR)\n\tif e != nil {\n\t\treturn nil, nil, e\n\t}\n\tcallback, e := moderation.NewMediaCallback(inspector.MediaAppID(), os.Getenv(c.CallbackTokenEnv), os.Getenv(c.CallbackKeyEnv), service)\n\tif e != nil {\n\t\treturn nil, nil, e\n\t}\n\treturn service, callback, nil\n}\n","chat/internal/avpipeline/helper.go":"package avpipeline\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"time\"\n)\n\ntype helperFailure struct{diagnostic string}\nfunc(e helperFailure)Error()string{return message.ErrCheck.Error()}\nfunc(e helperFailure)Unwrap()error{return message.ErrCheck}\n\ntype Helper struct{ Python, Script, FFmpeg, FFprobe, TempRoot string }\ntype boundedBuffer struct {\n\tbytes.Buffer\n\tlimit int\n}\n\nfunc (b *boundedBuffer) Write(v []byte) (int, error) {\n\tif b.Len()+len(v) > b.limit {\n\t\treturn 0, message.ErrMedia\n\t}\n\treturn b.Buffer.Write(v)\n}\nfunc (h *Helper) Process(ctx context.Context, raw []byte, kind, source string) (message.AVArtifact, error) {\n\tvar out message.AVArtifact\n\tlimit, duration := int64(message.MaxVideoBytes), 120000\n\tswitch source {\n\tcase \"voice\":\n\t\tlimit = message.MaxVoiceBytes\n\t\tduration = 60000\n\tcase \"camera\":\n\t\tlimit = message.MaxRecordingBytes\n\t\tduration = 30000\n\tcase \"album\":\n\tdefault:\n\t\treturn out, message.ErrMedia\n\t}\n\tif len(raw) < 1 || int64(len(raw)) > limit || kind != \"audio\" && kind != \"video\" || kind == \"audio\" && source != \"voice\" || kind == \"video\" && source == \"voice\" {\n\t\treturn out, message.ErrAVLimit\n\t}\n\troot, e := os.MkdirTemp(h.TempRoot, \"bxchat-av-\")\n\tif e != nil {\n\t\treturn out, message.ErrMedia\n\t}\n\tdefer os.RemoveAll(root)\n\tif e = os.Chmod(root, 0700); e != nil {\n\t\treturn out, message.ErrMedia\n\t}\n\tif e = os.WriteFile(filepath.Join(root, \"input\"), raw, 0600); e != nil {\n\t\treturn out, message.ErrMedia\n\t}\n\twork, cancel := context.WithTimeout(ctx, 45*time.Second)\n\tdefer cancel()\n\tcmd := exec.CommandContext(work, h.Python, h.Script, root, source, h.FFmpeg, h.FFprobe, \"inspect\")\n\tif configureMediaProcess(cmd) != nil {\n\t\treturn out, message.ErrMedia\n\t}\n\tstdout := &boundedBuffer{limit: 16384}\n\tstderr := &boundedBuffer{limit: 4096}\n\tcmd.Stdout = stdout\n\tcmd.Stderr = stderr\n\tif cmd.Run() != nil {\n\t\treturn out, helperFailure{diagnostic:stderr.String()}\n\t}\n\tvar meta struct {\n\t\tFrames []struct {\n\t\t\tFile string `json:\"file\"`\n\t\t\tAtMS int    `json:\"at_ms\"`\n\t\t} `json:\"frames\"`\n\t\tKind       string   `json:\"kind\"`\n\t\tMIME       string   `json:\"mime\"`\n\t\tMain       string   `json:\"main\"`\n\t\tPoster     string   `json:\"poster\"`\n\t\tSegments   []string `json:\"segments\"`\n\t\tDurationMS int      `json:\"duration_ms\"`\n\t\tHasAudio   bool     `json:\"has_audio\"`\n\t\tQRDecision string   `json:\"qr_decision\"`\n\t}\n\td := json.NewDecoder(bytes.NewReader(stdout.Bytes()))\n\td.DisallowUnknownFields()\n\tif d.Decode(&meta) != nil || d.Decode(new(any)) != io.EOF || meta.Kind != kind || meta.DurationMS < 1 || meta.DurationMS > duration || len(meta.Segments) > 2 || len(meta.Frames) > 8 || kind == \"audio\" && len(meta.Frames) > 0 || kind == \"video\" && len(meta.Frames) < 1 || (meta.QRDecision != \"clear\" && meta.QRDecision != \"review\" && meta.QRDecision != \"blocked\") {\n\t\treturn out, message.ErrCheck\n\t}\n\tread := func(name string, max int64) ([]byte, error) {\n\t\tretained := false\n\t\tfor i := 0; i < 8; i++ {\n\t\t\tif name == fmt.Sprintf(\"retained-%d.jpg\", i) {\n\t\t\t\tretained = true\n\t\t\t}\n\t\t}\n\t\tif !retained && name != \"main.mp3\" && name != \"main.mp4\" && name != \"poster.jpg\" && name != \"check-0.mp3\" && name != \"check-1.mp3\" {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t\tpath := filepath.Join(root, name)\n\t\tinfo, e := os.Lstat(path)\n\t\tif e != nil || !info.Mode().IsRegular() || info.Size() < 1 || info.Size() > max {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t\tfile, e := os.Open(path)\n\t\tif e != nil {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t\tdefer file.Close()\n\t\treturn io.ReadAll(io.LimitReader(file, max+1))\n\t}\n\texpectedMain, expectedMIME := \"main.mp4\", \"video/mp4\"\n\tif kind == \"audio\" {\n\t\texpectedMain = \"main.mp3\"\n\t\texpectedMIME = \"audio/mpeg\"\n\t}\n\tif meta.Main != expectedMain || meta.MIME != expectedMIME || kind == \"audio\" && (meta.DurationMS < 1000 || !meta.HasAudio || meta.Poster != \"\" || len(meta.Segments) != 1 || meta.Segments[0] != \"main.mp3\") || kind == \"video\" && meta.Poster != \"poster.jpg\" || kind == \"video\" && meta.HasAudio != (len(meta.Segments) > 0) {\n\t\treturn out, message.ErrCheck\n\t}\n\tout.Main, e = read(meta.Main, limit)\n\tif e != nil {\n\t\treturn out, e\n\t}\n\tif meta.Poster != \"\" {\n\t\tout.Poster, e = read(meta.Poster, 65536)\n\t\tif e != nil {\n\t\t\treturn out, e\n\t\t}\n\t}\n\tfor ordinal, name := range meta.Segments {\n\t\texpected := \"check-0.mp3\"\n\t\tif ordinal == 1 {\n\t\t\texpected = \"check-1.mp3\"\n\t\t}\n\t\tif kind == \"audio\" {\n\t\t\texpected = \"main.mp3\"\n\t\t}\n\t\tif name != expected {\n\t\t\treturn out, message.ErrCheck\n\t\t}\n\t\tif kind == \"audio\" {\n\t\t\tout.Segments = append(out.Segments, out.Main)\n\t\t} else {\n\t\t\tsegment, e := read(name, message.MaxVoiceBytes)\n\t\t\tif e != nil {\n\t\t\t\treturn out, e\n\t\t\t}\n\t\t\tout.Segments = append(out.Segments, segment)\n\t\t}\n\t}\n\tfor i, frame := range meta.Frames {\n\t\tif frame.File != fmt.Sprintf(\"retained-%d.jpg\", i) || frame.AtMS < 0 || frame.AtMS >= meta.DurationMS {\n\t\t\treturn out, message.ErrCheck\n\t\t}\n\t\tb, err := read(frame.File, 65536)\n\t\tif err != nil {\n\t\t\treturn out, err\n\t\t}\n\t\tout.Frames = append(out.Frames, message.AVFrameArtifact{Body: b, AtMS: frame.AtMS})\n\t}\n\tout.DurationMS = meta.DurationMS\n\tout.HasAudio = meta.HasAudio\n\tout.MIME = meta.MIME\n\tout.QRDecision = meta.QRDecision\n\treturn out, nil\n}\n","chat/internal/avpipeline/helper_test.go":"package avpipeline\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\nfunc TestOfflineMediaHelperRealFormatsAndLimits(t *testing.T) {\n\tif os.Getenv(\"CHAT_AV_HELPER_TEST\") != \"1\" {\n\t\tt.Skip(\"explicit offline helper fixture required\")\n\t}\n\tpython, e := exec.LookPath(\"python3\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tffmpeg, e := exec.LookPath(\"ffmpeg\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tffprobe, e := exec.LookPath(\"ffprobe\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tscript, _ := filepath.Abs(\"../../helpers/media/inspect.py\")\n\troot := t.TempDir()\n\th := &Helper{python, script, ffmpeg, ffprobe, root}\n\tmakeFile := func(name string, args ...string) []byte {\n\t\tt.Helper()\n\t\tpath := filepath.Join(root, name)\n\t\tcmd := exec.Command(ffmpeg, append([]string{\"-v\", \"error\", \"-nostdin\", \"-threads\", \"1\", \"-y\"}, append(args, path)...)...)\n\t\tif out, e := cmd.CombinedOutput(); e != nil {\n\t\t\tt.Fatalf(\"fixture %v %s\", e, out)\n\t\t}\n\t\traw, e := os.ReadFile(path)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\treturn raw\n\t}\n\tvoice := makeFile(\"voice.mp3\", \"-f\", \"lavfi\", \"-i\", \"sine=frequency=440:sample_rate=16000\", \"-t\", \"60\", \"-ac\", \"1\", \"-c:a\", \"libmp3lame\", \"-b:a\", \"48k\")\n\tout, e := h.Process(context.Background(), voice, \"audio\", \"voice\")\n\tif e != nil || out.DurationMS != 60000 || out.MIME != \"audio/mpeg\" || len(out.Segments) != 1 {\n\t\tt.Fatal(\"sixty second voice\", out.DurationMS, e)\n\t}\n\tlonger := makeFile(\"long.mp3\", \"-f\", \"lavfi\", \"-i\", \"sine=frequency=440:sample_rate=16000\", \"-t\", \"60.1\", \"-ac\", \"1\", \"-c:a\", \"libmp3lame\", \"-b:a\", \"48k\")\n\tif _, e = h.Process(context.Background(), longer, \"audio\", \"voice\"); e == nil {\n\t\tt.Fatal(\"voice duration bypass\")\n\t}\n\tfor _, source := range []string{\"camera\", \"album\"} {\n\t\tduration := \"30\"\n\t\tif source == \"album\" {\n\t\t\tduration = \"120\"\n\t\t}\n\t\tvideo := makeFile(source+\".mp4\", \"-f\", \"lavfi\", \"-i\", \"color=c=blue:s=320x240:r=24\", \"-t\", duration, \"-an\", \"-c:v\", \"libx264\", \"-threads\", \"1\", \"-pix_fmt\", \"yuv420p\", \"-movflags\", \"+faststart\")\n\t\tout, e = h.Process(context.Background(), video, \"video\", source)\n\t\tif e != nil || out.HasAudio || len(out.Segments) != 0 || len(out.Poster) == 0 {\n\t\t\tif diagnostic,ok:=e.(helperFailure);ok{t.Log(diagnostic.diagnostic)}\n   t.Fatal(source, e)\n\t\t}\n\t}\n\tif _, e = h.Process(context.Background(), []byte(\"fake.mp4\"), \"video\", \"album\"); e == nil {\n\t\tt.Fatal(\"forged file accepted\")\n\t}\n\tif _, e = h.Process(context.Background(), make([]byte, message.MaxVideoBytes+1), \"video\", \"album\"); e != message.ErrAVLimit {\n\t\tt.Fatal(\"size\", e)\n\t}\n}\n","chat/internal/avpipeline/process_linux.go":"package avpipeline\n\nimport (\n\t\"os\"\n\t\"os/exec\"\n\t\"syscall\"\n\t\"time\"\n)\n\nfunc configureMediaProcess(cmd *exec.Cmd) error {\n\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n\tcmd.Cancel = func() error {\n\t\tif cmd.Process == nil {\n\t\t\treturn nil\n\t\t}\n\t\te := syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)\n\t\tif e == syscall.ESRCH {\n\t\t\treturn os.ErrProcessDone\n\t\t}\n\t\treturn e\n\t}\n\tcmd.WaitDelay = 2 * time.Second\n\treturn nil\n}\n","chat/internal/avpipeline/process_other.go":"//go:build !linux\n\npackage avpipeline\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"os/exec\"\n)\n\nfunc configureMediaProcess(cmd *exec.Cmd) error { return message.ErrMedia }\n","chat/internal/bootstrap/app.go":"package bootstrap\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"flag\"\n\t\"io\"\n\t\"log/slog\"\n\t\"runtime\"\n\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n)\n\nvar (\n\tsourceRevision = \"unknown\"\n\tsourceDirty    = \"unknown\"\n)\n\nconst stage = \"S23\"\n\ntype versionInfo struct {\n\tStage           string `json:\"stage\"`\n\tGoVersion       string `json:\"go_version\"`\n\tSourceRevision  string `json:\"source_revision\"`\n\tSourceDirty     string `json:\"source_dirty\"`\n\tProtocolVersion int    `json:\"protocol_version\"`\n\tGOOS            string `json:\"goos\"`\n\tGOARCH          string `json:\"goarch\"`\n}\n\n// Run owns process composition and lifecycle; domain services own chat commands.\nfunc Run(ctx context.Context, args []string, stdout, stderr io.Writer) int {\n\tlogger := newLogger(stderr, slog.LevelInfo, \"cli\", \"unknown\")\n\tif len(args) == 0 {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"用法: chatd version | check-config/serve/worker --config 文件.json\", 2})\n\t}\n\tif args[0] == \"help\" || args[0] == \"--help\" || args[0] == \"-h\" {\n\t\t_, err := io.WriteString(stdout, \"chatd version\\nchatd check-config --config 文件.json [--probe]\\nchatd serve --config 文件.json\\nchatd worker --config 文件.json\\nS21～S23隔离回归、留存恢复与交付工具已接入，真实发布门禁仍关闭。\\n\")\n\t\tif err != nil {\n\t\t\treturn fail(logger, &Fault{\"CHAT_OUTPUT_FAILED\", \"无法写入命令输出\", 1})\n\t\t}\n\t\treturn 0\n\t}\n\tif args[0] == \"version\" {\n\t\tif len(args) != 1 {\n\t\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"version不接受额外参数\", 2})\n\t\t}\n\t\treturn output(logger, stdout, versionInfo{Stage: stage, GoVersion: runtime.Version(), SourceRevision: sourceRevision, SourceDirty: sourceDirty, ProtocolVersion: 1, GOOS: runtime.GOOS, GOARCH: runtime.GOARCH})\n\t}\n\tcommand := args[0]\n\tif command != \"check-config\" && command != \"serve\" && command != \"worker\" {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"未知命令，请运行chatd help\", 2})\n\t}\n\tflags := flag.NewFlagSet(command, flag.ContinueOnError)\n\tflags.SetOutput(io.Discard) // flag errors otherwise echo paths and values.\n\tpath := flags.String(\"config\", \"\", \"配置文件\")\n\tprobe := flags.Bool(\"probe\", false, \"只读探测依赖\")\n\tif err := flags.Parse(args[1:]); err != nil || flags.NArg() != 0 || *path == \"\" {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"请仅使用--config指定JSON配置文件\", 2})\n\t}\n\tif *probe && command != \"check-config\" {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"--probe仅供check-config使用\", 2})\n\t}\n\tcfg, fault := LoadConfig(*path)\n\tif fault != nil {\n\t\treturn fail(logger, fault)\n\t}\n\tlevel, _ := logLevel(cfg.LogLevel)\n\tlogger = newLogger(stderr, level, command, cfg.Environment)\n\tif command == \"check-config\" && !*probe {\n\t\treturn output(logger, stdout, struct {\n\t\t\tStatus string `json:\"status\"`\n\t\t\tStage  string `json:\"stage\"`\n\t\t\tScope  string `json:\"scope\"`\n\t\t}{\"ok\", stage, \"config_only\"})\n\t}\n\tif ctx.Err() != nil {\n\t\treturn 0\n\t}\n\trole := command\n\tif role == \"check-config\" {\n\t\trole = \"serve\"\n\t}\n\tdeps, err := dependencies.Open(cfg.Dependencies, cfg.Environment, role, cfg.ProviderMode)\n\tif err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_DEPENDENCY_CONFIG_INVALID\", \"依赖凭证或初始化配置不可用\", 2})\n\t}\n\tdefer deps.Close()\n\tdeps.ConfigureOperations(cfg.Operations)\n\tif err := deps.EnableRetention(cfg.Retention); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_RETENTION_INVALID\", \"留存适配不可用\", 2})\n\t}\n\tif err := deps.EnableIdentity(cfg.Auth); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_AUTH_INVALID\", \"身份适配配置不可用\", 2})\n\t}\n\tif err := deps.EnableConversations(cfg.Conversations); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_CONVERSATIONS_INVALID\", \"会话投影配置不可用\", 2})\n\t}\n\tif err := deps.EnableSafety(cfg.Safety); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_SAFETY_INVALID\", \"文本审核适配配置不可用\", 2})\n\t}\n\tif err := deps.EnableHistory(cfg.History); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_HISTORY_INVALID\", \"历史读取配置不可用\", 2})\n\t}\n\tif err := deps.EnableMessaging(cfg.Messages, cfg.Images, cfg.Reminders); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_MESSAGING_INVALID\", \"消息组合依赖不可用\", 2})\n\t}\n\tif err := deps.EnableAV(cfg.AV); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_AV_INVALID\", \"音视频组合依赖不可用\", 2})\n\t}\n\tif err := deps.EnableSocket(cfg.Socket); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_SOCKET_INVALID\", \"WSS连接配置不可用\", 2})\n\t}\n\tsnapshot := deps.Refresh(ctx)\n\tif command == \"check-config\" {\n\t\tif code := output(logger, stdout, snapshot); code != 0 {\n\t\t\treturn code\n\t\t}\n\t\tif !snapshot.InfrastructureReady {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\tmonitorCtx, stopMonitor := context.WithCancel(ctx)\n\tmonitorDone := make(chan struct{})\n\tgo func() { defer close(monitorDone); deps.Monitor(monitorCtx) }()\n\tdefer func() { stopMonitor(); <-monitorDone }()\n\tif command == \"worker\" {\n\t\tif deps.Messages != nil {\n\t\t\tdone := make(chan struct{})\n\t\t\tgo func() { defer close(done); deps.RunAV(ctx) }()\n\t\t\tdefer func() { <-done }()\n\t\t}\n\t\tif deps.Governance != nil {\n\t\t\tdone := make(chan struct{})\n\t\t\tgo func() { defer close(done); deps.RunMessaging(ctx, logger) }()\n\t\t\tdefer func() { <-done }()\n\t\t}\n\t\tif deps.Retention != nil {\n\t\t\tdone := make(chan struct{})\n\t\t\tgo func() { defer close(done); deps.MaintainRetention(ctx, logger) }()\n\t\t\tdefer func() { <-done }()\n\t\t}\n\t\tif deps.Moderation != nil {\n\t\t\tdone := make(chan struct{})\n\t\t\tgo func() { defer close(done); deps.Moderation.Maintain(ctx) }()\n\t\t\tdefer func() { <-done }()\n\t\t}\n\n\t\tif deps.Conversations != nil {\n\t\t\tlogger.Info(\"worker_started\", \"mode\", \"conversation_projection\", \"tasks_enabled\", true)\n\t\t\tdeps.RunProjection(ctx, logger)\n\t\t\tlogger.Info(\"worker_stopped\")\n\t\t\treturn 0\n\t\t}\n\t\tlogger.Info(\"worker_started\", \"mode\", \"idle\", \"tasks_enabled\", false)\n\t\t<-ctx.Done()\n\t\tlogger.Info(\"worker_stopped\")\n\t\treturn 0\n\t}\n\tif fault := serve(ctx, cfg, logger, deps); fault != nil {\n\t\treturn fail(logger, fault)\n\t}\n\treturn 0\n}\n\nfunc newLogger(w io.Writer, level slog.Level, process, environment string) *slog.Logger {\n\treturn slog.New(slog.NewJSONHandler(w, &slog.HandlerOptions{Level: level})).With(\n\t\t\"component\", \"chatd\", \"stage\", stage, \"process\", process, \"env\", environment)\n}\n\nfunc requestID() string {\n\tvar value [16]byte\n\tif _, err := rand.Read(value[:]); err != nil {\n\t\treturn \"unavailable\"\n\t}\n\treturn hex.EncodeToString(value[:])\n}\n\nfunc fail(logger *slog.Logger, fault *Fault) int {\n\tlogger.Error(fault.Message, \"code\", fault.Code, \"request_id\", requestID())\n\treturn fault.Exit\n}\n\nfunc output(logger *slog.Logger, w io.Writer, value any) int {\n\tif err := json.NewEncoder(w).Encode(value); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_OUTPUT_FAILED\", \"无法写入命令输出\", 1})\n\t}\n\treturn 0\n}\n","chat/internal/bootstrap/app_test.go":"package bootstrap\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\ntype capturedLogs struct {\n\tmu     sync.Mutex\n\tdata   bytes.Buffer\n\tevents chan map[string]any\n}\n\nfunc (c *capturedLogs) Write(p []byte) (int, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tn, err := c.data.Write(p)\n\tvar event map[string]any\n\tif json.Unmarshal(p, &event) == nil {\n\t\tselect {\n\t\tcase c.events <- event:\n\t\tdefault:\n\t\t}\n\t}\n\treturn n, err\n}\n\nfunc waitEvent(t *testing.T, logs *capturedLogs, message string) map[string]any {\n\tt.Helper()\n\ttimer := time.NewTimer(3 * time.Second)\n\tdefer timer.Stop()\n\tfor {\n\t\tselect {\n\t\tcase event := <-logs.events:\n\t\t\tif event[\"msg\"] == message {\n\t\t\t\treturn event\n\t\t\t}\n\t\tcase <-timer.C:\n\t\t\tt.Fatalf(\"did not observe %s\", message)\n\t\t}\n\t}\n}\n\nfunc TestCLICommandsAndSafeErrors(t *testing.T) {\n\tpath := configFile(t, encodedConfig(t, testConfig()))\n\tfor _, command := range []string{\"version\", \"check-config\"} {\n\t\tvar out, logs bytes.Buffer\n\t\targs := []string{command}\n\t\tif command == \"check-config\" {\n\t\t\targs = append(args, \"--config\", path)\n\t\t}\n\t\tif code := Run(context.Background(), args, &out, &logs); code != 0 {\n\t\t\tt.Fatalf(\"%s: exit=%d: %s\", command, code, logs.String())\n\t\t}\n\t\tvar value map[string]any\n\t\tif err := json.Unmarshal(out.Bytes(), &value); err != nil || value[\"stage\"] != stage || logs.Len() != 0 {\n\t\t\tt.Fatalf(\"unexpected output: %s / %s\", out.String(), logs.String())\n\t\t}\n\t\tif strings.Contains(out.String(), path) {\n\t\t\tt.Fatal(\"config path leaked\")\n\t\t}\n\t}\n\tbadConfig := configFile(t, `{\"password\":\"secret-input\",\"env\":\"development\"}`)\n\tfor _, args := range [][]string{\n\t\tnil, {\"secret-input\"}, {\"version\", \"secret-input\"}, {\"serve\"},\n\t\t{\"worker\", \"--secret-input=secret-input\"}, {\"check-config\", \"--config\", \"secret-input\"},\n\t\t{\"serve\", \"--config\", badConfig}, {\"serve\", \"--config\", path, \"secret-input\"},\n\t} {\n\t\tvar out, logs bytes.Buffer\n\t\tif code := Run(context.Background(), args, &out, &logs); code != 2 {\n\t\t\tt.Fatalf(\"expected usage/config exit=2, got %d\", code)\n\t\t}\n\t\tvar value map[string]any\n\t\tif err := json.Unmarshal(logs.Bytes(), &value); err != nil || value[\"code\"] == nil || value[\"request_id\"] == nil {\n\t\t\tt.Fatalf(\"not a structured error: %s\", logs.String())\n\t\t}\n\t\tif out.Len() != 0 || strings.Contains(logs.String(), \"secret-input\") || strings.Contains(logs.String(), badConfig) {\n\t\t\tt.Fatalf(\"sensitive input echoed: %s / %s\", out.String(), logs.String())\n\t\t}\n\t}\n}\n\ntype brokenWriter struct{}\n\nfunc (brokenWriter) Write([]byte) (int, error) { return 0, errors.New(\"secret-input\") }\n\nfunc TestOutputFailureIsSafe(t *testing.T) {\n\tvar logs bytes.Buffer\n\tif code := Run(context.Background(), []string{\"version\"}, brokenWriter{}, &logs); code != 1 || strings.Contains(logs.String(), \"secret-input\") {\n\t\tt.Fatalf(\"unsafe output failure: exit=%d %s\", code, logs.String())\n\t}\n}\n\nfunc TestDependencyProbeIsExplicitAndSafe(t *testing.T) {\n\tcfg := testConfig()\n\tpath := configFile(t, encodedConfig(t, cfg))\n\tvar out, logs bytes.Buffer\n\tif code := Run(context.Background(), []string{\"check-config\", \"--config\", path, \"--probe\"}, &out, &logs); code != 1 {\n\t\tt.Fatalf(\"disabled dependencies exit=%d\", code)\n\t}\n\tvar health map[string]any\n\tif json.Unmarshal(out.Bytes(), &health) != nil || health[\"scope\"] != \"infrastructure_only\" || health[\"infrastructure_ready\"] != false || health[\"business_enabled\"] != false {\n\t\tt.Fatal(\"probe falsely reported business ready\")\n\t}\n\tcfg.Dependencies.MySQL.Enabled = true\n\tcfg.Dependencies.MySQL.Database = \"bixuan_dev_s02\"\n\tcfg.Dependencies.MySQL.Username = \"bxchat_development_test\"\n\tcfg.Dependencies.MySQL.PasswordEnv = \"CHAT_S02_MISSING_PASSWORD\"\n\tt.Setenv(\"CHAT_S02_MISSING_PASSWORD\", \"\")\n\tpath = configFile(t, encodedConfig(t, cfg))\n\tout.Reset()\n\tlogs.Reset()\n\tif code := Run(context.Background(), []string{\"check-config\", \"--config\", path}, &out, &logs); code != 0 {\n\t\tt.Fatalf(\"offline validation unexpectedly probed credentials: %d\", code)\n\t}\n\tout.Reset()\n\tlogs.Reset()\n\tif code := Run(context.Background(), []string{\"check-config\", \"--config\", path, \"--probe\"}, &out, &logs); code != 2 {\n\t\tt.Fatalf(\"missing secret exit=%d\", code)\n\t}\n\tif strings.Contains(logs.String(), \"bixuan_dev_s02\") || strings.Contains(logs.String(), \"CHAT_S02_MISSING_PASSWORD\") || out.Len() != 0 {\n\t\tt.Fatal(\"dependency error echoed configuration\")\n\t}\n}\n\nfunc TestWorkerWaitsForCancellation(t *testing.T) {\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\tlogs := &capturedLogs{events: make(chan map[string]any, 16)}\n\tpath := configFile(t, encodedConfig(t, testConfig()))\n\tfinished := make(chan int, 1)\n\tgo func() { finished <- Run(ctx, []string{\"worker\", \"--config\", path}, io.Discard, logs) }()\n\tevent := waitEvent(t, logs, \"worker_started\")\n\tif event[\"mode\"] != \"idle\" || event[\"tasks_enabled\"] != false {\n\t\tt.Fatalf(\"worker incorrectly claims task processing: %#v\", event)\n\t}\n\tselect {\n\tcase <-finished:\n\t\tt.Fatal(\"worker exited before cancellation\")\n\tdefault:\n\t}\n\tcancel()\n\tselect {\n\tcase code := <-finished:\n\t\tif code != 0 {\n\t\t\tt.Fatalf(\"exit=%d\", code)\n\t\t}\n\tcase <-time.After(3 * time.Second):\n\t\tt.Fatal(\"worker did not stop\")\n\t}\n\twaitEvent(t, logs, \"worker_stopped\")\n}\n","chat/internal/bootstrap/config.go":"package bootstrap\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/avpipeline\"\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n\t\"github.com/franz-9527/workers/chat/internal/imagepipeline\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/moderation\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n)\n\nconst maxConfigBytes = 64 << 10\n\n// Config contains implemented lifecycle and dependency settings only.\ntype Config struct {\n\tAV          avpipeline.Config             `json:\"av\"`\n\tRelease     ReleaseConfig                 `json:\"release\"`\n\tReminders   dependencies.RemindersConfig  `json:\"reminders\"`\n\tOperations  dependencies.OperationsConfig `json:\"operations\"`\n\tRetention   message.RetentionConfig       `json:\"retention\"`\n\tEnvironment string                        `json:\"env\"`\n\tHTTP        struct {\n\t\tListen         string `json:\"listen\"`\n\t\tInternalListen string `json:\"internal_listen\"`\n\t} `json:\"http\"`\n\tShutdownTimeout string                `json:\"shutdown_timeout\"`\n\tLogLevel        string                `json:\"log_level\"`\n\tProviderMode    string                `json:\"provider_mode\"`\n\tDependencies    dependencies.Settings `json:\"dependencies\"`\n\tAuth            auth.Config           `json:\"auth\"`\n\tConversations   conversation.Config   `json:\"conversations\"`\n\tImages          imagepipeline.Config  `json:\"images\"`\n\tMessages        message.Config        `json:\"messages\"`\n\tSafety          moderation.Config     `json:\"safety\"`\n\tHistory         message.HistoryConfig `json:\"history\"`\n\tSocket          socket.Config         `json:\"socket\"`\n}\n\n// Fault deliberately never wraps input, filenames, decoder or network errors.\n// CLI diagnostics must not echo malformed config values or credentials.\ntype Fault struct {\n\tCode    string\n\tMessage string\n\tExit    int\n}\n\nfunc (f *Fault) Error() string { return f.Message }\n\nfunc configFault(code, message string) *Fault {\n\treturn &Fault{Code: code, Message: message, Exit: 2}\n}\n\nfunc LoadConfig(path string) (Config, *Fault) {\n\tcfg := Config{Retention: message.DefaultRetentionConfig(), ShutdownTimeout: \"10s\", LogLevel: \"info\", ProviderMode: \"disabled\", Dependencies: dependencies.Defaults()}\n\tinfo, err := os.Stat(path)\n\tif err != nil {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_READ_FAILED\", \"无法读取配置文件\")\n\t}\n\t// Reject devices/FIFOs before opening: opening a FIFO can otherwise block\n\t// check-config indefinitely. Deployment config paths are operator-controlled.\n\tif !info.Mode().IsRegular() || info.Size() > maxConfigBytes {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置必须是最多64KiB的普通JSON文件\")\n\t}\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_READ_FAILED\", \"无法读取配置文件\")\n\t}\n\tdefer f.Close()\n\tinfo, err = f.Stat()\n\tif err != nil || !info.Mode().IsRegular() || info.Size() > maxConfigBytes {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置必须是最多64KiB的普通JSON文件\")\n\t}\n\tdata, err := io.ReadAll(io.LimitReader(f, maxConfigBytes+1))\n\tif err != nil || len(data) > maxConfigBytes {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置读取失败或超过大小上限\")\n\t}\n\t// encoding/json accepts duplicate keys by default. Reject them before typed\n\t// decoding so a second security setting cannot silently override the first.\n\tpreflight := json.NewDecoder(strings.NewReader(string(data)))\n\tif !uniqueJSON(preflight, 0) {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"JSON格式错误、重复字段或嵌套过深\")\n\t}\n\tif _, err := preflight.Token(); err != io.EOF {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置只能包含一个JSON对象\")\n\t}\n\tdecoder := json.NewDecoder(strings.NewReader(string(data)))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&cfg); err != nil {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"JSON字段、类型或结构不符合当前配置\")\n\t}\n\tif fault := cfg.validate(); fault != nil {\n\t\treturn cfg, fault\n\t}\n\treturn cfg, nil\n}\n\nfunc uniqueJSON(d *json.Decoder, depth int) bool {\n\tif depth > 16 {\n\t\treturn false\n\t}\n\ttoken, err := d.Token()\n\tif err != nil || token == nil {\n\t\treturn false\n\t}\n\tdelimiter, compound := token.(json.Delim)\n\tif !compound {\n\t\treturn true\n\t}\n\tif delimiter != '{' && delimiter != '[' {\n\t\treturn false\n\t}\n\tkeys := make(map[string]bool)\n\tfor d.More() {\n\t\tif delimiter == '{' {\n\t\t\tkey, err := d.Token()\n\t\t\tname, ok := key.(string)\n\t\t\tif err != nil || !ok || name != strings.ToLower(name) || keys[name] {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tkeys[name] = true\n\t\t}\n\t\tif !uniqueJSON(d, depth+1) {\n\t\t\treturn false\n\t\t}\n\t}\n\tend, err := d.Token()\n\treturn err == nil && ((delimiter == '{' && end == json.Delim('}')) ||\n\t\t(delimiter == '[' && end == json.Delim(']')))\n}\n\nfunc (c Config) validate() *Fault {\n\tif c.Environment != \"development\" && c.Environment != \"test\" && c.Environment != \"production\" {\n\t\treturn configFault(\"CHAT_CONFIG_ENV_INVALID\", \"env须为development、test或production\")\n\t}\n\tif !validLoopback(c.HTTP.Listen, c.Environment) || !validLoopback(c.HTTP.InternalListen, c.Environment) {\n\t\treturn configFault(\"CHAT_CONFIG_LISTEN_INVALID\", \"HTTP与内部端口必须使用回环IP及合法端口\")\n\t}\n\t_, port, _ := net.SplitHostPort(c.HTTP.Listen)\n\tif c.HTTP.Listen == c.HTTP.InternalListen && port != \"0\" {\n\t\treturn configFault(\"CHAT_CONFIG_LISTEN_CONFLICT\", \"HTTP与内部监听地址不能相同\")\n\t}\n\tduration, err := time.ParseDuration(c.ShutdownTimeout)\n\tif err != nil || duration < time.Second || duration > 30*time.Second {\n\t\treturn configFault(\"CHAT_CONFIG_TIMEOUT_INVALID\", \"shutdown_timeout须在1秒至30秒之间\")\n\t}\n\tif _, ok := logLevel(c.LogLevel); !ok {\n\t\treturn configFault(\"CHAT_CONFIG_LOG_INVALID\", \"log_level须为debug、info、warn或error\")\n\t}\n\tif c.ProviderMode != \"disabled\" && c.ProviderMode != \"fake\" {\n\t\treturn configFault(\"CHAT_PROVIDER_NOT_IMPLEMENTED\", \"真实业务提供者尚未实现\")\n\t}\n\tif c.ProviderMode == \"fake\" && c.Environment == \"production\" {\n\t\treturn configFault(\"CHAT_CONFIG_FAKE_FORBIDDEN\", \"生产环境禁止测试提供者\")\n\t}\n\tif c.Dependencies.Validate(c.Environment) != nil {\n\t\treturn configFault(\"CHAT_CONFIG_DEPENDENCY_INVALID\", \"依赖配置、环境隔离或资源预算不符合要求\")\n\t}\n\tif c.Auth.Enabled {\n\t\tif !c.Dependencies.MySQL.Enabled || c.ProviderMode != \"disabled\" {\n\t\t\treturn configFault(\"CHAT_CONFIG_AUTH_INVALID\", \"真实身份需要独立MySQL权限且不能混用测试身份\")\n\t\t}\n\t\tif _, err := c.Auth.Verifier(c.Environment); err != nil {\n\t\t\treturn configFault(\"CHAT_CONFIG_AUTH_INVALID\", \"身份公钥配置不可用\")\n\t\t}\n\t}\n\tif c.Conversations.Enabled && (!c.Auth.Enabled || !c.Dependencies.MySQL.Enabled || c.ProviderMode != \"disabled\") {\n\t\treturn configFault(\"CHAT_CONFIG_CONVERSATIONS_INVALID\", \"会话投影需要真实身份和独立MySQL权限\")\n\t}\n\tif c.Safety.Validate() != nil || c.Safety.Enabled && (!c.Conversations.Enabled || !c.Auth.Enabled || c.ProviderMode != \"disabled\" || c.Dependencies.Timeout() < 100*time.Millisecond) {\n\t\treturn configFault(\"CHAT_CONFIG_SAFETY_INVALID\", \"真实审核需要真实身份、会话、独立数据库和可信凭证文件\")\n\t}\n\tif _, e := c.History.Key(); e != nil || c.History.Enabled && (!c.Conversations.Enabled || !c.Auth.Enabled || c.ProviderMode != \"disabled\" || c.Dependencies.Timeout() < 100*time.Millisecond) {\n\t\treturn configFault(\"CHAT_CONFIG_HISTORY_INVALID\", \"历史读取需要真实身份、会话、独立数据库和游标签名密钥\")\n\t}\n\tif !c.Operations.Validate(c.Environment == \"production\" && (c.Auth.Enabled || c.Conversations.Enabled || c.History.Enabled || c.Socket.Enabled || c.Retention.Enabled)) {\n\t\treturn configFault(\"CHAT_OPERATIONS_INVALID\", \"生产受保护动作需要独立恢复门禁与代次\")\n\t}\n\tif c.Retention.Validate() != nil || c.Retention.Enabled && (!c.Dependencies.MySQL.Enabled || c.ProviderMode != \"disabled\") {\n\t\treturn configFault(\"CHAT_RETENTION_INVALID\", \"留存配置或数据库边界不符合要求\")\n\t}\n\tif c.AV.Validate() != nil || c.AV.Enabled && (!c.Messages.Enabled || !c.Retention.Enabled) {\n\t\treturn configFault(\"CHAT_AV_NOT_READY\", \"音视频配置或组合依赖不完整\")\n\t}\n\tif c.AV.Enabled && !(c.Environment == \"test\" && c.Release.Staging) && (c.AV.Audio&&!c.Release.Verify(c.Environment,c.Operations.Epoch,sourceRevision,sourceDirty,\"audio\")||c.AV.Video&&!c.Release.Verify(c.Environment,c.Operations.Epoch,sourceRevision,sourceDirty,\"video\")) {\n\t\treturn configFault(\"CHAT_AV_NOT_READY\", \"音视频联合验收未完成\")\n\t}\n\tif c.Images.Enabled && !c.Messages.Enabled {\n\t\treturn configFault(\"CHAT_IMAGES_NOT_READY\", \"图片必须依附完整消息用例\")\n\t}\n\tif c.Reminders.Enabled && !c.Messages.Enabled {\n\t\treturn configFault(\"CHAT_MESSAGES_NOT_READY\", \"提醒必须依附完整消息用例\")\n\t}\n\tif c.Release.Staging && c.Environment != \"test\" {\n\t\treturn configFault(\"CHAT_STAGING_FORBIDDEN\", \"隔离验收组合仅允许独立test环境\")\n\t}\n\tif c.Messages.Enabled {\n\t\tstaged := c.Environment == \"test\" && c.Release.Staging && c.Operations.Validate(true)\n\t\tif !staged && !c.Release.Verify(c.Environment, c.Operations.Epoch, sourceRevision, sourceDirty, \"text\", \"governance\") {\n\t\t\treturn configFault(\"CHAT_MESSAGES_NOT_READY\", \"缺少本提交已授权的联合验收凭证\")\n\t\t}\n\t\tif c.Images.Enabled && !staged && !c.Release.Verify(c.Environment, c.Operations.Epoch, sourceRevision, sourceDirty, \"images\") {\n\t\t\treturn configFault(\"CHAT_IMAGES_NOT_READY\", \"图片联合验收未完成\")\n\t\t}\n\t\tif c.Reminders.Enabled && !staged && !c.Release.Verify(c.Environment, c.Operations.Epoch, sourceRevision, sourceDirty, \"reminders\") {\n\t\t\treturn configFault(\"CHAT_REMINDERS_NOT_READY\", \"实际提醒渠道联合验收未完成\")\n\t\t}\n\t\tif !c.Auth.Enabled || !c.Conversations.Enabled || !c.Safety.Enabled || !c.History.Enabled || !c.Dependencies.MySQL.Enabled || c.ProviderMode != \"disabled\" || c.Dependencies.Timeout() < 100*time.Millisecond {\n\t\t\treturn configFault(\"CHAT_MESSAGES_NOT_READY\", \"消息组合缺少真实身份、权限、审核或恢复依赖\")\n\t\t}\n\t\tif c.Reminders.Enabled && !c.Dependencies.Redis.Enabled {\n\t\t\treturn configFault(\"CHAT_REMINDERS_NOT_READY\", \"内部防重放依赖不可用\")\n\t\t}\n\t}\n\n\tif c.Socket.Enabled && (!c.Auth.Enabled || !c.Dependencies.MySQL.Enabled || !c.Dependencies.Redis.Enabled || c.ProviderMode != \"disabled\") {\n\t\treturn configFault(\"CHAT_CONFIG_SOCKET_INVALID\", \"WSS需要真实身份、MySQL和一次性票据Redis\")\n\t}\n\treturn nil\n}\n\nfunc validLoopback(address, environment string) bool {\n\thost, port, err := net.SplitHostPort(address)\n\tif err != nil {\n\t\treturn false\n\t}\n\tip := net.ParseIP(host)\n\tn, err := strconv.Atoi(port)\n\treturn err == nil && ip != nil && ip.IsLoopback() && n >= 0 && n <= 65535 &&\n\t\t(n != 0 || environment == \"development\")\n}\n\nfunc logLevel(value string) (slog.Level, bool) {\n\tlevels := map[string]slog.Level{\"debug\": slog.LevelDebug, \"info\": slog.LevelInfo, \"warn\": slog.LevelWarn, \"error\": slog.LevelError}\n\tlevel, ok := levels[value]\n\treturn level, ok\n}\n","chat/internal/bootstrap/config_test.go":"package bootstrap\n\nimport (\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n)\n\nfunc testConfig() Config {\n\tc := Config{Environment: \"development\", ShutdownTimeout: \"1s\", LogLevel: \"info\", ProviderMode: \"disabled\", Dependencies: dependencies.Defaults()}\n\tc.HTTP.Listen = \"127.0.0.1:0\"\n\tc.HTTP.InternalListen = \"127.0.0.1:0\"\n\treturn c\n}\n\nfunc configFile(t *testing.T, contents string) string {\n\tt.Helper()\n\tp := filepath.Join(t.TempDir(), \"chat.json\")\n\tif err := os.WriteFile(p, []byte(contents), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn p\n}\n\nfunc encodedConfig(t *testing.T, cfg Config) string {\n\tt.Helper()\n\tdata, err := json.Marshal(cfg)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn string(data)\n}\n\nfunc TestConfigValidation(t *testing.T) {\n\tvalid := encodedConfig(t, testConfig())\n\ttests := []struct{ name, data, code string }{\n\t\t{\"valid\", valid, \"\"},\n\t\t{\"malformed\", `{\"env\":\"secret-input`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"trailing_object\", valid + `{}`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"unknown_field\", strings.Replace(valid, `\"provider_mode\"`, `\"api_secret\"`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"duplicate_field\", strings.Replace(valid, `\"env\":`, `\"env\":\"test\",\"env\":`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"case_alias\", strings.Replace(valid, `\"env\":`, `\"ENV\":\"test\",\"env\":`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"null_mode\", strings.Replace(valid, `\"provider_mode\":\"disabled\"`, `\"provider_mode\":null`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"null_root\", `null`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"array\", `[]`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"oversized\", strings.Repeat(\" \", maxConfigBytes+1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"empty\", `{}`, \"CHAT_CONFIG_ENV_INVALID\"},\n\t\t{\"unknown_env\", strings.Replace(valid, \"development\", \"secret-input\", 1), \"CHAT_CONFIG_ENV_INVALID\"},\n\t\t{\"public_bind\", strings.ReplaceAll(valid, \"127.0.0.1\", \"0.0.0.0\"), \"CHAT_CONFIG_LISTEN_INVALID\"},\n\t\t{\"hostname\", strings.ReplaceAll(valid, \"127.0.0.1\", \"localhost\"), \"CHAT_CONFIG_LISTEN_INVALID\"},\n\t\t{\"production_ephemeral\", strings.Replace(valid, \"development\", \"production\", 1), \"CHAT_CONFIG_LISTEN_INVALID\"},\n\t\t{\"conflicting_ports\", strings.ReplaceAll(valid, \":0\", \":19501\"), \"CHAT_CONFIG_LISTEN_CONFLICT\"},\n\t\t{\"negative_timeout\", strings.Replace(valid, `\"1s\"`, `\"-1s\"`, 1), \"CHAT_CONFIG_TIMEOUT_INVALID\"},\n\t\t{\"long_timeout\", strings.Replace(valid, `\"1s\"`, `\"31s\"`, 1), \"CHAT_CONFIG_TIMEOUT_INVALID\"},\n\t\t{\"invalid_log_level\", strings.Replace(valid, `\"info\"`, `\"secret-input\"`, 1), \"CHAT_CONFIG_LOG_INVALID\"},\n\t\t{\"fake_provider\", strings.Replace(valid, `\"disabled\"`, `\"fake\"`, 1), \"\"},\n\t\t{\"real_provider\", strings.Replace(valid, `\"disabled\"`, `\"real\"`, 1), \"CHAT_PROVIDER_NOT_IMPLEMENTED\"},\n\t}\n\tfor _, test := range tests {\n\t\tt.Run(test.name, func(t *testing.T) {\n\t\t\t_, fault := LoadConfig(configFile(t, test.data))\n\t\t\tif test.code == \"\" {\n\t\t\t\tif fault != nil {\n\t\t\t\t\tt.Fatal(fault)\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif fault == nil || fault.Code != test.code || strings.Contains(fault.Error(), \"secret-input\") {\n\t\t\t\tt.Fatalf(\"expected safe fault %s, got %#v\", test.code, fault)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestConfigDefaultsAndReadFailure(t *testing.T) {\n\tproduction := testConfig()\n\tproduction.Environment = \"production\"\n\tproduction.ProviderMode = \"fake\"\n\tproduction.HTTP.Listen = \"127.0.0.1:9501\"\n\tproduction.HTTP.InternalListen = \"127.0.0.1:9502\"\n\tif _, fault := LoadConfig(configFile(t, encodedConfig(t, production))); fault == nil || fault.Code != \"CHAT_CONFIG_FAKE_FORBIDDEN\" {\n\t\tt.Fatal(\"production fixture mode accepted\")\n\t}\n\tcfg, fault := LoadConfig(configFile(t, `{\"env\":\"test\",\"http\":{\"listen\":\"127.0.0.1:19501\",\"internal_listen\":\"127.0.0.1:19502\"}}`))\n\tif fault != nil || cfg.ShutdownTimeout != \"10s\" || cfg.ProviderMode != \"disabled\" || cfg.LogLevel != \"info\" {\n\t\tt.Fatalf(\"unsafe defaults: %#v, %v\", cfg, fault)\n\t}\n\tfor _, path := range []string{t.TempDir(), filepath.Join(t.TempDir(), \"secret-input.json\")} {\n\t\t_, fault := LoadConfig(path)\n\t\tif fault == nil || strings.Contains(fault.Error(), path) {\n\t\t\tt.Fatalf(\"expected safe read fault, got %#v\", fault)\n\t\t}\n\t}\n}\n\nfunc TestRealIdentityConfiguration(t *testing.T) {\n\tc := testConfig()\n\tc.Auth.Enabled = true\n\tc.Auth.PublicKeys = map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}\n\tif c.validate() == nil {\n\t\tt.Fatal(\"identity requires SQL\")\n\t}\n\tc.Dependencies.MySQL.Enabled = true\n\tc.Dependencies.MySQL.Database = \"bixuan_dev_identity\"\n\tc.Dependencies.MySQL.Username = \"bxchat_development_identity\"\n\tif f := c.validate(); f != nil {\n\t\tt.Fatal(f)\n\t}\n\tc.ProviderMode = \"fake\"\n\tif c.validate() == nil {\n\t\tt.Fatal(\"mixed real/fake authority\")\n\t}\n\tc.ProviderMode = \"disabled\"\n\tc.Auth.PublicKeys[\"chat-v1\"] = \"bad-key\"\n\tif c.validate() == nil {\n\t\tt.Fatal(\"bad public key\")\n\t}\n}\n\nfunc TestConversationProjectionConfiguration(t *testing.T) {\n\tc := testConfig()\n\tc.Conversations.Enabled = true\n\tif c.validate() == nil {\n\t\tt.Fatal(\"projection must not mix disabled identity or test providers\")\n\t}\n\tc.Auth.Enabled = true\n\tc.Auth.PublicKeys = map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}\n\tc.Dependencies.MySQL.Enabled = true\n\tc.Dependencies.MySQL.Database = \"bixuan_dev_projection\"\n\tc.Dependencies.MySQL.Username = \"bxchat_development_projection\"\n\tif err := c.validate(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.ProviderMode = \"fake\"\n\tif c.validate() == nil {\n\t\tt.Fatal(\"fake projection accepted\")\n\t}\n}\n\nfunc TestS06CannotEnableSending(t *testing.T) {\n\tc := testConfig()\n\tc.Messages.Enabled = true\n\t_, fault := LoadConfig(configFile(t, encodedConfig(t, c)))\n\tif fault == nil || fault.Code != \"CHAT_MESSAGES_NOT_READY\" {\n\t\tt.Fatal(\"S06 send gate was bypassed\", fault)\n\t}\n}\n\nfunc TestS07SafetyCannotUseFakeOrUnboundIdentity(t *testing.T) {\n\tc := testConfig()\n\tc.Safety.Enabled = true\n\tc.Safety.AppID = \"wx_s07_fixture\"\n\tc.Safety.CredentialFile = \"/tmp/fixture-token.json\"\n\t_, fault := LoadConfig(configFile(t, encodedConfig(t, c)))\n\tif fault == nil || fault.Code != \"CHAT_CONFIG_SAFETY_INVALID\" {\n\t\tt.Fatal(\"unbound safety enabled\", fault)\n\t}\n\tc.Safety.Enabled = false\n\t_, fault = LoadConfig(configFile(t, encodedConfig(t, c)))\n\tif fault == nil || fault.Code != \"CHAT_CONFIG_SAFETY_INVALID\" {\n\t\tt.Fatal(\"disabled safety retained credential settings\", fault)\n\t}\n}\n\nfunc TestS08HistoryRequiresBoundIdentityAndPrivateCursorKey(t *testing.T) {\n\tc := testConfig()\n\tc.History.Enabled = true\n\tc.History.CursorKeyEnv = \"CHAT_S08_FIXTURE_CURSOR\"\n\tt.Setenv(c.History.CursorKeyEnv, strings.Repeat(\"ab\", 32))\n\tif c.validate() == nil {\n\t\tt.Fatal(\"unbound history enabled\")\n\t}\n\tc.Auth.Enabled = true\n\tc.Auth.PublicKeys = map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}\n\tc.Conversations.Enabled = true\n\tc.Dependencies.MySQL.Enabled = true\n\tc.Dependencies.MySQL.Database = \"bixuan_dev_history\"\n\tc.Dependencies.MySQL.Username = \"bxchat_development_history\"\n\tif e := c.validate(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Setenv(c.History.CursorKeyEnv, \"malformed\")\n\tif c.validate() == nil {\n\t\tt.Fatal(\"weak cursor key accepted\")\n\t}\n\tc.History.Enabled = false\n\tif c.validate() == nil {\n\t\tt.Fatal(\"disabled config retained key\")\n\t}\n}\n\nfunc TestImageReleaseGateRemainsClosed(t *testing.T){\n c:=testConfig();c.Images.Enabled=true\n if fault:=c.validate();fault==nil||fault.Code!=\"CHAT_IMAGES_NOT_READY\"{t.Fatal(\"image deployment gate opened\",fault)}\n}\n","chat/internal/bootstrap/release.go":"package bootstrap\n\nimport (\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"time\"\n)\n\ntype ReleaseConfig struct {\n\tStaging bool   `json:\"staging\"`\n\tFile    string `json:\"file\"`\n\tKeyEnv  string `json:\"key_env\"`\n}\n\nfunc (c ReleaseConfig) Verify(env, epoch, revision, dirty string, capabilities ...string) bool {\n\tif !regexp.MustCompile(\"^[0-9a-f]{40}$\").MatchString(revision) || dirty != \"false\" || !filepath.IsAbs(c.File) || !regexp.MustCompile(\"^CHAT_[A-Z0-9_]{1,60}$\").MatchString(c.KeyEnv) {\n\t\treturn false\n\t}\n\tinfo, err := os.Lstat(c.File)\n\tif err != nil || !info.Mode().IsRegular() || info.Size() > 8192 || info.Mode().Perm()&0022 != 0 {\n\t\treturn false\n\t}\n\tfile, err := os.Open(c.File)\n\tif err != nil {\n\t\treturn false\n\t}\n\tdefer file.Close()\n\traw, err := io.ReadAll(io.LimitReader(file, 8193))\n\tif err != nil || len(raw) > 8192 {\n\t\treturn false\n\t}\n\tvar envelope struct {\n\t\tPayload string `json:\"payload\"`\n\t\tMAC     string `json:\"mac\"`\n\t}\n\tif json.Unmarshal(raw, &envelope) != nil {\n\t\treturn false\n\t}\n\tbody, err := base64.StdEncoding.Strict().DecodeString(envelope.Payload)\n\tif err != nil || base64.StdEncoding.EncodeToString(body) != envelope.Payload {\n\t\treturn false\n\t}\n\tkeyText := os.Getenv(c.KeyEnv)\n\tkey, err := base64.StdEncoding.Strict().DecodeString(keyText)\n\tif err != nil || len(key) != 32 || base64.StdEncoding.EncodeToString(key) != keyText {\n\t\treturn false\n\t}\n\tgot, err := hex.DecodeString(envelope.MAC)\n\tif err != nil {\n\t\treturn false\n\t}\n\tmac := hmac.New(sha256.New, key)\n\t_, _ = mac.Write(body)\n\tif !hmac.Equal(got, mac.Sum(nil)) {\n\t\treturn false\n\t}\n\tvar p struct {\n\t\tSchema       int      `json:\"schema\"`\n\t\tEnvironment  string   `json:\"environment\"`\n\t\tEpoch        string   `json:\"epoch\"`\n\t\tRevision     string   `json:\"revision\"`\n\t\tExpires      int64    `json:\"expires_at\"`\n\t\tCapabilities []string `json:\"capabilities\"`\n\t}\n\tif json.Unmarshal(body, &p) != nil || p.Schema != 1 || p.Environment != env || p.Epoch != epoch || p.Revision != revision || p.Expires <= time.Now().Unix() || p.Expires > time.Now().Add(24*time.Hour).Unix() {\n\t\treturn false\n\t}\n\tfor _, required := range capabilities {\n\t\tfound := false\n\t\tfor _, cap := range p.Capabilities {\n\t\t\tif cap == required {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n","chat/internal/bootstrap/release_test.go":"package bootstrap\n\nimport (\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestS23ReleaseProofBindsExactSourceEnvironmentAndCapabilities(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"release.json\")\n\tkey := []byte(strings.Repeat(\"k\", 32))\n\tt.Setenv(\"CHAT_RELEASE_FIXTURE_KEY\", base64.StdEncoding.EncodeToString(key))\n\tc := ReleaseConfig{File: path, KeyEnv: \"CHAT_RELEASE_FIXTURE_KEY\"}\n\trevision := strings.Repeat(\"a\", 40)\n\tepoch := strings.Repeat(\"b\", 64)\n\tbody, _ := json.Marshal(map[string]any{\"schema\": 1, \"environment\": \"production\", \"epoch\": epoch, \"revision\": revision, \"expires_at\": time.Now().Add(time.Hour).Unix(), \"capabilities\": []string{\"text\", \"images\", \"governance\", \"reminders\"}})\n\tmac := hmac.New(sha256.New, key)\n\tmac.Write(body)\n\tenvelope, _ := json.Marshal(map[string]string{\"payload\": base64.StdEncoding.EncodeToString(body), \"mac\": hex.EncodeToString(mac.Sum(nil))})\n\tif os.WriteFile(path, envelope, 0640) != nil {\n\t\tt.Fatal(\"private file\")\n\t}\n\tif !c.Verify(\"production\", epoch, revision, \"false\", \"text\", \"images\") {\n\t\tt.Fatal(\"valid seal rejected\")\n\t}\n\tfor _, bad := range []struct{ env, epoch, revision, dirty string }{{\"test\", epoch, revision, \"false\"}, {\"production\", strings.Repeat(\"c\", 64), revision, \"false\"}, {\"production\", epoch, strings.Repeat(\"d\", 40), \"false\"}, {\"production\", epoch, revision, \"true\"}} {\n\t\tif c.Verify(bad.env, bad.epoch, bad.revision, bad.dirty, \"text\") {\n\t\t\tt.Fatal(\"seal crossed boundary\", bad)\n\t\t}\n\t}\n\tif c.Verify(\"production\", epoch, revision, \"false\", \"voice\") {\n\t\tt.Fatal(\"unaccepted capability\")\n\t}\n\tenvelope[len(envelope)-5] ^= 1\n\tos.WriteFile(path, envelope, 0640)\n\tif c.Verify(\"production\", epoch, revision, \"false\", \"text\") {\n\t\tt.Fatal(\"tampered seal\")\n\t}\n}\n","chat/internal/bootstrap/server.go":"package bootstrap\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"log\"\n\t\"log/slog\"\n\t\"net\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n)\n\nfunc serve(ctx context.Context, cfg Config, logger *slog.Logger, runtimes ...*dependencies.Runtime) *Fault {\n\tvar deps *dependencies.Runtime\n\tif len(runtimes) > 0 {\n\t\tdeps = runtimes[0]\n\t}\n\tvar listeners []net.Listener\n\tdefer func() {\n\t\tfor _, listener := range listeners {\n\t\t\t_ = listener.Close()\n\t\t}\n\t}()\n\tfor _, address := range []string{cfg.HTTP.Listen, cfg.HTTP.InternalListen} {\n\t\tlistener, err := (&net.ListenConfig{}).Listen(ctx, \"tcp\", address)\n\t\tif err != nil {\n\t\t\tif ctx.Err() != nil {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn &Fault{\"CHAT_LISTEN_FAILED\", \"监听启动失败，请检查端口及权限\", 1}\n\t\t}\n\t\tlisteners = append(listeners, listener)\n\t}\n\tservers := []*http.Server{newHTTPServer(false, logger, deps), newHTTPServer(true, logger, deps)}\n\tfinished := make(chan error, len(servers))\n\tfor i, server := range servers {\n\t\tlistener := listeners[i]\n\t\tgo func() { finished <- server.Serve(listener) }()\n\t}\n\tlogger.Info(\"serve_started\", \"public_address\", listeners[0].Addr().String(),\n\t\t\"internal_address\", listeners[1].Addr().String(), \"business_enabled\", cfg.Messages.Enabled)\n\tremaining := len(servers)\n\tvar fault *Fault\n\tselect {\n\tcase <-ctx.Done():\n\tcase err := <-finished:\n\t\tremaining--\n\t\tif !errors.Is(err, http.ErrServerClosed) {\n\t\t\tfault = &Fault{\"CHAT_HTTP_FAILED\", \"HTTP服务异常停止\", 1}\n\t\t}\n\t}\n\tlogger.Info(\"serve_stopping\")\n\tif deps != nil {\n\t\tdeps.Stop()\n\t}\n\ttimeout, _ := time.ParseDuration(cfg.ShutdownTimeout)\n\tshutdown, cancel := context.WithTimeout(context.Background(), timeout)\n\tdefer cancel()\n\tif deps != nil && deps.Socket != nil {\n\t\tif err := deps.Socket.Shutdown(shutdown); err != nil {\n\t\t\tlogger.Warn(\"socket_drain_timeout\", \"code\", \"CHAT_SHUTDOWN_FORCED\")\n\t\t\tfault = &Fault{\"CHAT_SHUTDOWN_FORCED\", \"WSS连接未在排空期限内关闭\", 1}\n\t\t}\n\t}\n\tfor _, server := range servers {\n\t\tif err := server.Shutdown(shutdown); err != nil {\n\t\t\t_ = server.Close()\n\t\t\tlogger.Warn(\"http_drain_timeout\", \"code\", \"CHAT_SHUTDOWN_FORCED\")\n\t\t\tif fault == nil {\n\t\t\t\tfault = &Fault{\"CHAT_SHUTDOWN_FORCED\", \"HTTP请求未在排空期限内完成\", 1}\n\t\t\t}\n\t\t}\n\t}\n\tfor range remaining {\n\t\t<-finished\n\t}\n\tlogger.Info(\"serve_stopped\")\n\treturn fault\n}\n\nfunc newHTTPServer(internal bool, logger *slog.Logger, deps *dependencies.Runtime) *http.Server {\n\treturn &http.Server{\n\t\tHandler:           healthHandler(internal, deps),\n\t\tReadHeaderTimeout: 5 * time.Second,\n\t\tReadTimeout:       10 * time.Second,\n\t\tWriteTimeout:      5 * time.Second,\n\t\tIdleTimeout:       60 * time.Second,\n\t\tMaxHeaderBytes:    16 << 10,\n\t\tErrorLog:          log.New(httpLogWriter{logger}, \"\", 0),\n\t}\n}\n\nfunc healthHandler(internal bool, runtimes ...*dependencies.Runtime) http.Handler {\n\tvar deps *dependencies.Runtime\n\tif len(runtimes) > 0 {\n\t\tdeps = runtimes[0]\n\t}\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\t\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\t\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\t\tif internal && deps != nil && r.URL.Path == \"/metrics\" {\n\t\t\tdeps.Metrics(w, r)\n\t\t\treturn\n\t\t}\n\t\tif !internal && deps != nil && (r.URL.Path == \"/chat/ws\" || len(r.URL.Path) >= 13 && r.URL.Path[:13] == \"/chat/api/v1/\") && !deps.OperationsReady() {\n\t\t\twriteError(w, r, 503, \"CHAT_RECOVERY_BLOCKED\", \"安全恢复尚未核验\", true)\n\t\t\treturn\n\t\t}\n\t\tif deps != nil {\n\t\t\tif internal && deps.ReminderHTTP != nil && r.URL.Path == \"/chat/internal/v1/reminders/eligible\" {\n\t\t\t\tif !deps.OperationsReady() {\n\t\t\t\t\twriteError(w, r, 503, \"CHAT_RECOVERY_BLOCKED\", \"安全恢复尚未核验\", true)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tdeps.ReminderHTTP.ServeHTTP(w, r)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif !internal && deps.MessageHTTP != nil && (r.URL.Path == \"/chat/api/v1/messages/send\" || r.URL.Path == \"/chat/api/v1/messages/result\" || r.URL.Path == \"/chat/api/v1/messages/recall\") {\n\t\t\t\tdeps.MessageHTTP.ServeHTTP(w, r)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif !internal && deps.AVCallback != nil && r.URL.Path == \"/chat/api/v1/av/callback\" {\n\t\t\t\tdeps.AVCallback.ServeHTTP(w, r)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif !internal && deps.AVHTTP != nil && strings.HasPrefix(r.URL.Path, \"/chat/api/v1/av/\") {\n\t\t\t\tdeps.AVHTTP.ServeHTTP(w, r)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif !internal && deps.MediaHTTP != nil && strings.HasPrefix(r.URL.Path, \"/chat/api/v1/media/\") {\n\t\t\t\tdeps.MediaHTTP.ServeHTTP(w, r)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif !internal && deps.GovernanceHTTP != nil && (strings.HasPrefix(r.URL.Path, \"/chat/api/v1/audit/\") || strings.HasPrefix(r.URL.Path, \"/chat/api/v1/governance/\")) {\n\t\t\t\tdeps.GovernanceHTTP.ServeHTTP(w, r)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tif !internal && deps != nil && deps.Socket != nil && r.URL.Path == \"/chat/ws\" {\n\t\t\tdeps.Socket.ServeHTTP(w, r)\n\t\t\treturn\n\t\t}\n\t\tif !internal && deps != nil && deps.IdentityHTTP != nil && (r.URL.Path == \"/chat/api/v1/auth/session\" || r.URL.Path == \"/chat/api/v1/auth/socket-ticket\") {\n\t\t\tdeps.IdentityHTTP.ServeHTTP(w, r)\n\t\t\treturn\n\t\t}\n\t\tif !internal && deps != nil && deps.HistoryHTTP != nil && (r.URL.Path == \"/chat/api/v1/conversations/bootstrap\" || r.URL.Path == \"/chat/api/v1/messages/history\" || r.URL.Path == \"/chat/api/v1/messages/sync\" || r.URL.Path == \"/chat/api/v1/messages/changes\" || r.URL.Path == \"/chat/api/v1/messages/locate\" || r.URL.Path == \"/chat/api/v1/conversations/unread\" || r.URL.Path == \"/chat/api/v1/conversations/read\" || r.URL.Path == \"/chat/api/v1/conversations/digests\" || r.URL.Path == \"/chat/api/v1/conversations/preferences\" || r.URL.Path == \"/chat/api/v1/conversations/preference\") {\n\t\t\tdeps.HistoryHTTP.ServeHTTP(w, r)\n\t\t\treturn\n\t\t}\n\t\tif r.URL.Path != \"/livez\" && !(internal && r.URL.Path == \"/readyz\") {\n\t\t\twriteError(w, r, http.StatusNotFound, \"CHAT_ROUTE_NOT_FOUND\", \"接口未开放\", false)\n\t\t\treturn\n\t\t}\n\t\tif r.Method != http.MethodGet && r.Method != http.MethodHead {\n\t\t\tw.Header().Set(\"Allow\", \"GET, HEAD\")\n\t\t\twriteError(w, r, http.StatusMethodNotAllowed, \"CHAT_METHOD_NOT_ALLOWED\", \"请求方法不支持\", false)\n\t\t\treturn\n\t\t}\n\t\tif r.URL.Path == \"/readyz\" {\n\t\t\tif deps == nil {\n\t\t\t\twriteError(w, r, http.StatusServiceUnavailable, \"CHAT_NOT_READY\", \"基础依赖未接入\", false)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tsnapshot := deps.Snapshot()\n\t\t\tstatus := http.StatusOK\n\t\t\tif !snapshot.InfrastructureReady || !deps.OperationsReady() {\n\t\t\t\tstatus = http.StatusServiceUnavailable\n\t\t\t}\n\t\t\tw.WriteHeader(status)\n\t\t\tif r.Method != http.MethodHead {\n\t\t\t\t_ = json.NewEncoder(w).Encode(snapshot)\n\t\t\t}\n\t\t\treturn\n\t\t}\n\t\tif r.Method != http.MethodHead {\n\t\t\tenabled := deps != nil && deps.Messages != nil && deps.OperationsReady()\n\t\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"status\": \"alive\", \"stage\": stage, \"business_enabled\": enabled})\n\t\t}\n\t})\n}\n\nfunc writeError(w http.ResponseWriter, r *http.Request, status int, code, message string, retryable bool) {\n\tid := requestID()\n\tw.Header().Set(\"X-Request-ID\", id)\n\tw.WriteHeader(status)\n\tif r.Method != http.MethodHead {\n\t\t_ = json.NewEncoder(w).Encode(struct {\n\t\t\tRequestID  string `json:\"request_id\"`\n\t\t\tCode       string `json:\"code\"`\n\t\t\tMessage    string `json:\"message\"`\n\t\t\tRetryable  bool   `json:\"retryable\"`\n\t\t\tServerTime string `json:\"server_time\"`\n\t\t}{id, code, message, retryable, time.Now().UTC().Format(time.RFC3339Nano)})\n\t}\n}\n\ntype httpLogWriter struct{ logger *slog.Logger }\n\nfunc (w httpLogWriter) Write(p []byte) (int, error) {\n\t// net/http's original diagnostics can contain attacker-controlled request\n\t// targets or panic values. Never forward that raw data into ordinary logs.\n\tw.logger.Error(\"http_runtime_error\", \"code\", \"CHAT_HTTP_RUNTIME_ERROR\")\n\treturn len(p), nil\n}\n","chat/internal/bootstrap/server_test.go":"package bootstrap\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestHealthAndClosedBusinessRoutes(t *testing.T) {\n\tfor _, internal := range []bool{false, true} {\n\t\tfor _, test := range []struct {\n\t\t\tmethod, path string\n\t\t\tstatus       int\n\t\t}{\n\t\t\t{\"GET\", \"/livez\", 200}, {\"HEAD\", \"/livez\", 200}, {\"POST\", \"/livez\", 405},\n\t\t\t{\"GET\", \"/chat/api/v1/messages?token=secret-input\", 404}, {\"GET\", \"/chat/ws\", 404},\n\t\t\t{\"GET\", \"/debug/pprof/\", 404}, {\"GET\", \"/metrics\", 404}, {\"GET\", \"/livez/\", 404},\n\t\t} {\n\t\t\tr := httptest.NewRequest(test.method, test.path, nil)\n\t\t\tw := httptest.NewRecorder()\n\t\t\thealthHandler(internal).ServeHTTP(w, r)\n\t\t\tif w.Code != test.status || w.Header().Get(\"Cache-Control\") != \"no-store\" || strings.Contains(w.Body.String(), \"secret-input\") {\n\t\t\t\tt.Fatalf(\"%s %s: %d %s\", test.method, test.path, w.Code, w.Body.String())\n\t\t\t}\n\t\t\tif test.method == \"HEAD\" && w.Body.Len() != 0 {\n\t\t\t\tt.Fatal(\"HEAD returned a body\")\n\t\t\t}\n\t\t\tif test.status >= 400 {\n\t\t\t\tvar body map[string]any\n\t\t\t\tif json.Unmarshal(w.Body.Bytes(), &body) != nil || body[\"request_id\"] != w.Header().Get(\"X-Request-ID\") {\n\t\t\t\t\tt.Fatalf(\"invalid error envelope: %s\", w.Body.String())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tw := httptest.NewRecorder()\n\t\thealthHandler(internal).ServeHTTP(w, httptest.NewRequest(\"GET\", \"/readyz\", nil))\n\t\texpected := 404\n\t\tif internal {\n\t\t\texpected = 503\n\t\t}\n\t\tif w.Code != expected {\n\t\t\tt.Fatalf(\"skeleton must never report business-ready: %d\", w.Code)\n\t\t}\n\t}\n}\n\nfunc TestServeLifecycleAndListenerCleanup(t *testing.T) {\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\tlogs := &capturedLogs{events: make(chan map[string]any, 16)}\n\tpath := configFile(t, encodedConfig(t, testConfig()))\n\tfinished := make(chan int, 1)\n\tgo func() { finished <- Run(ctx, []string{\"serve\", \"--config\", path}, io.Discard, logs) }()\n\tevent := waitEvent(t, logs, \"serve_started\")\n\tclient := &http.Client{Timeout: 2 * time.Second, Transport: &http.Transport{Proxy: nil}}\n\tdefer client.CloseIdleConnections()\n\tfor _, key := range []string{\"public_address\", \"internal_address\"} {\n\t\taddress, ok := event[key].(string)\n\t\tif !ok || address == \"\" {\n\t\t\tt.Fatalf(\"missing bound address: %#v\", event)\n\t\t}\n\t\tresponse, err := client.Get(\"http://\" + address + \"/livez\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t_, _ = io.Copy(io.Discard, response.Body)\n\t\t_ = response.Body.Close()\n\t\tif response.StatusCode != 200 {\n\t\t\tt.Fatal(response.Status)\n\t\t}\n\t}\n\tcancel()\n\tselect {\n\tcase code := <-finished:\n\t\tif code != 0 {\n\t\t\tt.Fatalf(\"exit=%d\", code)\n\t\t}\n\tcase <-time.After(3 * time.Second):\n\t\tt.Fatal(\"serve did not stop both listeners\")\n\t}\n\tfor _, key := range []string{\"public_address\", \"internal_address\"} {\n\t\tlistener, err := net.Listen(\"tcp\", event[key].(string))\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"listener was not released: %v\", err)\n\t\t}\n\t\t_ = listener.Close()\n\t}\n}\n\nfunc TestSecondListenFailureReleasesFirst(t *testing.T) {\n\toccupied, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer occupied.Close()\n\tfirst, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\taddress := first.Addr().String()\n\t_ = first.Close()\n\tcfg := testConfig()\n\tcfg.HTTP.Listen = address\n\tcfg.HTTP.InternalListen = occupied.Addr().String()\n\tfault := serve(context.Background(), cfg, newLogger(io.Discard, slog.LevelInfo, \"test\", \"test\"))\n\tif fault == nil || fault.Code != \"CHAT_LISTEN_FAILED\" {\n\t\tt.Fatalf(\"expected bind failure, got %#v\", fault)\n\t}\n\trebound, err := net.Listen(\"tcp\", address)\n\tif err != nil {\n\t\tt.Fatalf(\"partial startup leaked first listener: %v\", err)\n\t}\n\t_ = rebound.Close()\n}\n\nfunc TestHTTPRuntimeLogDoesNotEchoRequestOrPanic(t *testing.T) {\n\tvar logs bytes.Buffer\n\tw := httpLogWriter{newLogger(&logs, slog.LevelInfo, \"serve\", \"test\")}\n\t_, _ = w.Write([]byte(\"panic: secret-input /path?token=secret-input\"))\n\tif strings.Contains(logs.String(), \"secret-input\") || !strings.Contains(logs.String(), \"CHAT_HTTP_RUNTIME_ERROR\") {\n\t\tt.Fatalf(\"unsafe runtime log: %s\", logs.String())\n\t}\n}\n","chat/internal/bootstrap/socket_test.go":"package bootstrap\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"net/http/httptest\"\n\t\"testing\"\n)\n\nfunc TestS10SocketConfigRequiresRealDependencies(t *testing.T) {\n\tc := testConfig()\n\tc.Socket.Enabled = true\n\tif f := c.validate(); f == nil || f.Code != \"CHAT_CONFIG_SOCKET_INVALID\" {\n\t\tt.Fatal(\"WSS enabled without real identity/Redis\")\n\t}\n\tvar r dependencies.Runtime\n\tif e := r.EnableSocket(socket.Config{Enabled: true}); e == nil {\n\t\tt.Fatal(\"runtime accepted missing dependencies\")\n\t}\n\tif e := r.EnableSocket(socket.Config{}); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tc.Socket.Enabled = false\n\tc.Messages.Enabled = true\n\tif f := c.validate(); f == nil || f.Code != \"CHAT_MESSAGES_NOT_READY\" {\n\t\tt.Fatal(\"WSS bypassed send gate\")\n\t}\n}\nfunc TestS10InternalListenerNeverRegistersSocket(t *testing.T) {\n\t// A nonnil gateway must still never be invoked on the internal listener.\n\tdeps := &dependencies.Runtime{Socket: &socket.Gateway{}}\n\tfor _, path := range []string{\"/chat/ws\", \"/chat/ws?ticket=private\"} {\n\t\tw := httptest.NewRecorder()\n\t\thealthHandler(true, deps).ServeHTTP(w, httptest.NewRequest(\"GET\", path, nil))\n\t\tif w.Code != 404 {\n\t\t\tt.Fatal(w.Code)\n\t\t}\n\t}\n}\nfunc TestS10DefaultCommandsDoNotSend(t *testing.T) {\n\t_, _, err := (message.SocketCommands{}).Execute(context.Background(), ports.Principal{}, \"message.send\", json.RawMessage(`{}`))\n\tif err == nil || err.Error() != \"CHAT_MESSAGES_NOT_READY\" {\n\t\tt.Fatal(err)\n\t}\n}\n","chat/internal/conversation/consumer.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar eventIDPattern = regexp.MustCompile(`^[a-f0-9]{32}$`)\n\ntype Lease struct{ EventID, Owner, PayloadHash string }\ntype Batch struct{ Claimed, Applied, Deferred, Rejected int }\n\n// Claim writes only the Go receipt. The source is immutable PHP-owned data.\n// A durable lease survives a crash before the projection transaction begins.\nfunc (s *Store) Claim(ctx context.Context, eventID string) (Lease, error) {\n\tif !eventIDPattern.MatchString(eventID) {\n\t\treturn Lease{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tvar nonce [16]byte\n\tif _, err := rand.Read(nonce[:]); err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\towner := hex.EncodeToString(nonce[:])\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\t_, err = tx.ExecContext(ctx, `INSERT IGNORE INTO chat_event_receipts(event_id,aggregate_key,aggregate_version,payload_hash,status,attempts,next_attempt_at)\n\t\tSELECT event_id,aggregate_key,aggregate_version,SHA2(payload_json,256),'retry',0,UTC_TIMESTAMP(6) FROM chat_business_events WHERE event_id=?`, eventID)\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tvar hash string\n\terr = tx.QueryRowContext(ctx, `SELECT payload_hash FROM chat_event_receipts WHERE event_id=? FOR UPDATE`, eventID).Scan(&hash)\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tresult, err := tx.ExecContext(ctx, `UPDATE chat_event_receipts SET status='processing',lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,\n\t\tattempts=LEAST(attempts+1,1000000),error_code=NULL WHERE event_id=? AND\n\t\t((status='retry' AND next_attempt_at<=UTC_TIMESTAMP(6)) OR (status='processing' AND lease_until<=UTC_TIMESTAMP(6)))`, owner, eventID)\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tn, _ := result.RowsAffected()\n\tif n != 1 {\n\t\treturn Lease{}, ports.ErrBusy\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\treturn Lease{eventID, owner, hash}, nil\n}\n\n// Consume fences ownership again in the SAME transaction as intervals and the\n// applied version. A late old owner cannot commit after a replacement claimant.\nfunc (s *Store) Consume(ctx context.Context, lease Lease) error {\n\tif !eventIDPattern.MatchString(lease.EventID) || !eventIDPattern.MatchString(lease.Owner) || len(lease.PayloadHash) != 64 {\n\t\treturn ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar scope, kind string\n\tvar version ports.ID\n\tvar schema int\n\tvar body sql.NullString\n\terr = tx.QueryRowContext(ctx, `SELECT aggregate_key,CAST(aggregate_version AS CHAR),schema_version,event_type,\n\t\tCASE WHEN OCTET_LENGTH(payload_json)<=32768 THEN payload_json ELSE NULL END FROM chat_business_events WHERE event_id=?`, lease.EventID).Scan(&scope, &version, &schema, &kind, &body)\n\tif err == sql.ErrNoRows {\n\t\treturn policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif schema != 1 || kind != \"chat.policy.changed\" || !body.Valid {\n\t\treturn policy.ErrDenied\n\t}\n\tsum := sha256.Sum256([]byte(body.String))\n\tif hex.EncodeToString(sum[:]) != lease.PayloadHash {\n\t\treturn policy.ErrDenied\n\t}\n\tp, err := policy.DecodeEvent([]byte(body.String), scope, version)\n\tif err != nil {\n\t\treturn err\n\t}\n\tcurrent, err := s.reader.CurrentLocked(ctx, tx, scope)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif current.OrderID != p.OrderID || current.AssignmentID != p.AssignmentID {\n\t\treturn policy.ErrDenied\n\t}\n\tif compare(p.Version, current.Version) > 0 {\n\t\treturn ErrGap\n\t}\n\tif p.Version == current.Version && p.Hash != current.Hash {\n\t\treturn policy.ErrDenied\n\t}\n\tif err = s.apply(ctx, tx, p); err != nil {\n\t\treturn err\n\t}\n\tresult, err := tx.ExecContext(ctx, `UPDATE chat_event_receipts SET status='done',lease_owner=NULL,lease_until=NULL,error_code=NULL,completed_at=UTC_TIMESTAMP(6)\n\t\tWHERE event_id=? AND status='processing' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND payload_hash=?`, lease.EventID, lease.Owner, lease.PayloadHash)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := result.RowsAffected()\n\tif n != 1 {\n\t\treturn ErrLease\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\nfunc (s *Store) deferLease(ctx context.Context, lease Lease, cause error) error {\n\tstatus, code := \"retry\", \"CHAT_EVENT_RETRY\"\n\tif errors.Is(cause, policy.ErrDenied) {\n\t\tstatus, code = \"rejected\", \"CHAT_EVENT_INVALID\"\n\t}\n\tif errors.Is(cause, ErrGap) {\n\t\tcode = \"CHAT_EVENT_VERSION_GAP\"\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\t_, err := s.db.ExecContext(ctx, `UPDATE chat_event_receipts SET status=?,error_code=?,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 5 SECOND,lease_owner=NULL,lease_until=NULL\n\t\tWHERE event_id=? AND status='processing' AND lease_owner=?`, status, code, lease.EventID, lease.Owner)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\n// No MAX(id) or created_at watermark. The anti-join re-discovers a lower event\n// ID whose PHP transaction committed after a later event was already consumed.\n// Poll is authoritative; a lost Redis wake cannot lose any business event.\nfunc (s *Store) Poll(ctx context.Context, limit int) (Batch, error) {\n\tvar stats Batch\n\tif limit < 1 || limit > 100 {\n\t\treturn stats, ports.ErrInvalid\n\t}\n\tqueryCtx, cancel := context.WithTimeout(ctx, s.timeout)\n\trows, err := s.db.QueryContext(queryCtx, `SELECT e.event_id FROM chat_business_events e LEFT JOIN chat_event_receipts r ON r.event_id=e.event_id\n\t\tWHERE r.event_id IS NULL OR (r.status='retry' AND r.next_attempt_at<=UTC_TIMESTAMP(6))\n\t\tOR (r.status='processing' AND r.lease_until<=UTC_TIMESTAMP(6)) ORDER BY e.id LIMIT ?`, limit)\n\tif err != nil {\n\t\tcancel()\n\t\treturn stats, ports.ErrUnavailable\n\t}\n\tids := []string{}\n\tfor rows.Next() {\n\t\tvar id string\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\tcancel()\n\t\t\treturn stats, ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tcancel()\n\tif err != nil {\n\t\treturn stats, ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tif ctx.Err() != nil {\n\t\t\treturn stats, ctx.Err()\n\t\t}\n\t\tlease, e := s.Claim(ctx, id)\n\t\tif errors.Is(e, ports.ErrBusy) {\n\t\t\tcontinue\n\t\t}\n\t\tif e != nil {\n\t\t\treturn stats, e\n\t\t}\n\t\tstats.Claimed++\n\t\tif e = s.Consume(ctx, lease); e == nil {\n\t\t\tstats.Applied++\n\t\t\tcontinue\n\t\t}\n\t\tif err = s.deferLease(ctx, lease, e); err != nil {\n\t\t\treturn stats, err\n\t\t}\n\t\tif errors.Is(e, policy.ErrDenied) {\n\t\t\tstats.Rejected++\n\t\t} else {\n\t\t\tstats.Deferred++\n\t\t}\n\t}\n\treturn stats, nil\n}\n\nfunc (s *Store) Run(ctx context.Context, logger *slog.Logger) {\n\tticker := time.NewTicker(time.Second)\n\tdefer ticker.Stop()\n\tfor {\n\t\tstats, err := s.Poll(ctx, 100)\n\t\tif ctx.Err() != nil {\n\t\t\treturn\n\t\t}\n\t\tif err != nil {\n\t\t\tlogger.Warn(\"conversation_projection_retry\", \"code\", \"CHAT_EVENT_RETRY\")\n\t\t} else if stats.Claimed > 0 {\n\t\t\tlogger.Info(\"conversation_projection_batch\", \"claimed\", stats.Claimed, \"applied\", stats.Applied, \"deferred\", stats.Deferred, \"rejected\", stats.Rejected)\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n}\n","chat/internal/conversation/mysql_integration_test.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\ntype fixtureDB struct {\n\tt          *testing.T\n\tctx        context.Context\n\troot, goDB *sql.DB\n\tstore      *Store\n\tname       string\n\tuser       string\n}\n\nfunc digest(s string) string { v := sha256.Sum256([]byte(s)); return hex.EncodeToString(v[:]) }\nfunc newFixture(t *testing.T) *fixtureDB {\n\tt.Helper()\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated MySQL/PHP required\")\n\t}\n\thost, _, err := net.SplitHostPort(os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"))\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"loopback fixture required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 80*time.Second)\n\tt.Cleanup(cancel)\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ParseTime = true\n\tc.Params = map[string]string{\"time_zone\": \"'+00:00'\"}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tadmin := sql.OpenDB(connector)\n\tdefer admin.Close()\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname := \"bixuan_test_policy_platform_\" + suffix\n\tif _, err = admin.ExecContext(ctx, \"CREATE DATABASE `\"+name+\"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.DBName = name\n\tconnector, _ = mysql.NewConnector(c)\n\troot := sql.OpenDB(connector)\n\troot.SetMaxOpenConns(4)\n\tf := &fixtureDB{t: t, ctx: ctx, root: root, name: name}\n\tt.Cleanup(func() { root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\"); root.Close() })\n\tf.php(\"init\")\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\tuser := \"bxchat_test_s05_\" + suffix\n\tf.user = user\n\tf.exec(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY 's05-fixture-only'\")\n\tt.Cleanup(func() { root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\") })\n\tfor _, table := range []string{\"users\", \"login_sessions\", \"chat_policy_guards\", \"chat_business_events\", \"chat_staff_authority_versions\"} {\n\t\tf.exec(\"GRANT SELECT ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tfor _, table := range []string{\"chat_conversations\", \"chat_members\", \"chat_member_intervals\", \"chat_event_receipts\"} {\n\t\tf.exec(\"GRANT SELECT,INSERT,UPDATE,DELETE ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tc.User = user\n\tc.Passwd = \"s05-fixture-only\"\n\tconnector, _ = mysql.NewConnector(c)\n\tf.goDB = sql.OpenDB(connector)\n\tf.goDB.SetMaxOpenConns(4)\n\tt.Cleanup(func() { f.goDB.Close() })\n\tf.store, err = NewStore(f.goDB, \"test\", 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, actor := range []string{\"10201\", \"10202\", \"10203\"} {\n\t\tf.exec(`INSERT INTO login_sessions(id,user_id,token_hash,status,expires_at,created_at) VALUES(?,?,?,'active',UTC_TIMESTAMP()+INTERVAL 1 HOUR,UTC_TIMESTAMP())`, actor, actor, digest(\"login:\"+actor))\n\t}\n\treturn f\n}\nfunc (f *fixtureDB) exec(q string, args ...any) {\n\tf.t.Helper()\n\tif _, err := f.root.ExecContext(f.ctx, q, args...); err != nil {\n\t\tf.t.Fatal(\"fixture SQL\", err)\n\t}\n}\nfunc (f *fixtureDB) text(q string, args ...any) string {\n\tf.t.Helper()\n\tvar s string\n\tif err := f.root.QueryRowContext(f.ctx, q, args...).Scan(&s); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\treturn s\n}\nfunc (f *fixtureDB) php(action string, args ...string) {\n\tf.t.Helper()\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tf.t.Fatal(\"explicit PHP required\")\n\t}\n\tpath, _ := filepath.Abs(\"../../../server/tests/chat_platform_fixture.php\")\n\tcmd := exec.CommandContext(f.ctx, php, append([]string{path, action}, args...)...)\n\tcmd.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+f.name)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil || strings.TrimSpace(string(out)) != \"committed\" {\n\t\tf.t.Fatalf(\"real PHP %s: %s\", action, out)\n\t}\n}\nfunc principal(actor string) ports.Principal {\n\treturn ports.Principal{ActorID: ports.ID(actor), SourceID: ports.ID(actor), Kind: \"mini\", Environment: \"test\", Scopes: []string{\"chat:use\"}, SessionID: digest(\"mini\\n\" + actor + \"\\n\" + digest(\"login:\"+actor)), SessionVersion: digest(\"mini-v1\\n\" + actor + \"\\n\" + digest(\"login:\"+actor) + \"\\n\" + actor), ExpiresAt: time.Now().Add(time.Minute)}\n}\nfunc (f *fixtureDB) poll() Batch {\n\tf.t.Helper()\n\tb, err := f.store.Poll(f.ctx, 100)\n\tif err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\tif b.Rejected != 0 || b.Deferred != 0 {\n\t\tf.t.Fatalf(\"unexpected projection result %+v\", b)\n\t}\n\treturn b\n}\nfunc (f *fixtureDB) event(version string) string {\n\treturn f.text(\"SELECT event_id FROM chat_business_events WHERE aggregate_key='order:401:assignment:401' AND aggregate_version=?\", version)\n}\nfunc (f *fixtureDB) claim(v string) Lease {\n\tf.t.Helper()\n\tlease, err := f.store.Claim(f.ctx, f.event(v))\n\tif err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\treturn lease\n}\nfunc (f *fixtureDB) check(id ports.ID, actor, action string, allowed bool) {\n\tf.t.Helper()\n\tg, err := f.store.Authorize(f.ctx, ports.PolicyRequest{Actor: principal(actor), ConversationID: id, Action: action})\n\tif allowed && (err != nil || !g.CanRead) {\n\t\tf.t.Fatalf(\"authorized actor denied %s %s: %v\", actor, action, err)\n\t}\n\tif !allowed && err == nil {\n\t\tf.t.Fatal(\"stale/outsider authorization allowed\")\n\t}\n}\nfunc (f *fixtureDB) visible(id ports.ID, version string, want bool) {\n\tf.t.Helper()\n\ttx, err := f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\tdefer tx.Rollback()\n\tok, err := f.store.VisibleVersionLocked(f.ctx, tx, ports.PolicyRequest{Actor: principal(\"10203\"), ConversationID: id}, ports.ID(version))\n\tif err != nil || ok != want {\n\t\tf.t.Fatalf(\"history version %s: %v %v\", version, ok, err)\n\t}\n}\n\nfunc TestPHPProjectionLeaseIntervalsAndAuthorization(t *testing.T) {\n\tf := newFixture(t)\n\tif f.poll().Applied != 1 {\n\t\tt.Fatal(\"first PHP event not applied\")\n\t}\n\tid, err := f.store.FindOrder(f.ctx, principal(\"10203\"), \"401\", \"401\")\n\tif err != nil || id == \"401\" {\n\t\tt.Fatal(\"independent binding\", id, err)\n\t}\n\tf.check(id, \"10203\", \"send\", true)\n\tf.check(id, \"10202\", \"send\", true)\n\tf.check(id, \"10201\", \"read\", false)\n\tif f.poll().Claimed != 0 {\n\t\tt.Fatal(\"completed event replayed\")\n\t}\n\toldHistory, err := f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer oldHistory.Rollback()\n\tvar oldCount int\n\tif oldHistory.QueryRowContext(f.ctx, \"SELECT COUNT(*) FROM chat_member_intervals WHERE end_version IS NULL\").Scan(&oldCount) != nil {\n\t\tt.Fatal(\"history RR snapshot\")\n\t}\n\tif _, err = f.store.FindOrder(f.ctx, principal(\"10203\"), \"401\", \"402\"); err == nil {\n\t\tt.Fatal(\"wrong assignment binding accepted\")\n\t}\n\tf.exec(`UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'`)\n\tf.check(id, \"10203\", \"read\", false)\n\tf.check(id, \"10202\", \"send\", false) // Entire stale platform snapshot is fenced.\n\tf.check(id, \"10202\", \"read\", true)  // Another actor keeps legitimate history after staff revocation.\n\tf.php(\"sync\")\n\tf.check(id, \"10202\", \"read\", false) // Current PHP version has not been materialized yet.\n\tlease := f.claim(\"2\")\n\tf.exec(`CREATE TRIGGER fixture_projection_fail BEFORE UPDATE ON chat_conversations FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'`)\n\tif err = f.store.Consume(f.ctx, lease); err == nil {\n\t\tt.Fatal(\"injected failure ignored\")\n\t}\n\tif f.text(\"SELECT CAST(policy_version AS CHAR) FROM chat_conversations WHERE id=?\", string(id)) != \"1\" || f.text(\"SELECT COUNT(*) FROM chat_member_intervals WHERE end_version IS NOT NULL\") != \"0\" {\n\t\tt.Fatal(\"partial projection committed\")\n\t}\n\tf.exec(\"DROP TRIGGER fixture_projection_fail\")\n\tif err = f.store.Consume(f.ctx, lease); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.check(id, \"10202\", \"read\", true)\n\tf.check(id, \"10202\", \"send\", false)\n\tf.check(id, \"10203\", \"read\", false)\n\tf.exec(`UPDATE system_settings SET setting_value='[\"PlatformStaff\"]' WHERE setting_key='wechat.admin_openids'`)\n\tf.php(\"sync\")\n\told := f.claim(\"3\")\n\tf.exec(\"UPDATE chat_event_receipts SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND WHERE event_id=?\", old.EventID)\n\tnewOwner := f.claim(\"3\")\n\tif old.Owner == newOwner.Owner {\n\t\tt.Fatal(\"lease generation reused\")\n\t}\n\tif err = f.store.Consume(f.ctx, old); !errors.Is(err, ErrLease) {\n\t\tt.Fatal(\"old worker committed\", err)\n\t}\n\tif f.text(\"SELECT CAST(policy_version AS CHAR) FROM chat_conversations WHERE id=?\", string(id)) != \"2\" {\n\t\tt.Fatal(\"lost lease mutated projection\")\n\t}\n\tif err = f.store.Consume(f.ctx, newOwner); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.check(id, \"10203\", \"send\", true)\n\tf.visible(id, \"1\", true)\n\tf.visible(id, \"2\", false)\n\tf.visible(id, \"3\", true)\n\tvisible, err := f.store.VisibleVersionLocked(f.ctx, oldHistory, ports.PolicyRequest{Actor: principal(\"10203\"), ConversationID: id}, \"2\")\n\tif err != nil || visible {\n\t\tt.Fatal(\"old RR interval snapshot resurrected gap\", visible, err)\n\t}\n\toldHistory.Rollback()\n\tif f.text(\"SELECT COUNT(DISTINCT member_key) FROM chat_member_intervals WHERE actor_id=10203\") != \"2\" {\n\t\tt.Fatal(\"return reused revoked authority\")\n\t}\n\t// A higher version may be selected first, but never opens a gap in history.\n\tf.exec(\"UPDATE users SET status='disabled' WHERE id=10203\")\n\tf.php(\"sync\")\n\tf.exec(\"UPDATE users SET status='active' WHERE id=10203\")\n\tf.php(\"sync\")\n\thigh := f.claim(\"5\")\n\tif err = f.store.Consume(f.ctx, high); !errors.Is(err, ErrGap) {\n\t\tt.Fatal(\"out-of-order event skipped version\", err)\n\t}\n\tif err = f.store.deferLease(f.ctx, high, ErrGap); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlow := f.claim(\"4\")\n\tif err = f.store.Consume(f.ctx, low); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_event_receipts SET next_attempt_at=UTC_TIMESTAMP()-INTERVAL 1 SECOND WHERE event_id=?\", high.EventID)\n\tf.poll()\n\tf.visible(id, \"4\", false)\n\tf.visible(id, \"5\", true)\n\tf.visible(id, \"1\", true)\n\t// Session final check uses current locking reads even inside an old RR tx.\n\ttx, err := f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer tx.Rollback()\n\tvar status string\n\tif tx.QueryRowContext(f.ctx, \"SELECT status FROM login_sessions WHERE id=10202\").Scan(&status) != nil {\n\t\tt.Fatal(\"RR fixture\")\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, err = f.store.AuthorizeLocked(f.ctx, tx, ports.PolicyRequest{Actor: principal(\"10202\"), ConversationID: id, Action: \"read\"}); err == nil {\n\t\tt.Fatal(\"old identity snapshot granted\")\n\t}\n\ttx.Rollback()\n\tf.exec(\"UPDATE login_sessions SET status='active' WHERE id=10202\")\n\ttx, err = f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer tx.Rollback()\n\tif _, err = f.store.AuthorizeLocked(f.ctx, tx, ports.PolicyRequest{Actor: principal(\"10202\"), ConversationID: id, Action: \"read\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tconn, err := f.root.Conn(f.ctx)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = conn.ExecContext(f.ctx, \"SET SESSION innodb_lock_wait_timeout=1\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, err = conn.ExecContext(f.ctx, \"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tvar dbErr *mysql.MySQLError\n\tif !errors.As(err, &dbErr) || dbErr.Number != 1205 {\n\t\tt.Fatal(\"session shared lock not retained\", err)\n\t}\n\tconn.Close()\n\ttx.Rollback()\n\t// Source tables are SELECT-only to this worker.\n\tfor _, q := range []string{\"DELETE FROM chat_business_events\", \"UPDATE chat_policy_guards SET policy_version=1\", \"UPDATE orders SET lifecycle_status='completed'\"} {\n\t\tif _, err = f.goDB.ExecContext(f.ctx, q); err == nil {\n\t\t\tt.Fatal(\"worker changed PHP source\")\n\t\t}\n\t}\n\tf.php(\"close\")\n\tf.poll()\n\tf.check(id, \"10203\", \"read\", true)\n\tf.check(id, \"10203\", \"send\", false)\n\tserviceKey := f.text(\"SELECT member_key FROM chat_members WHERE conversation_id=? AND actor_id=10203\", string(id))\n\tf.php(\"repair\")\n\tf.poll()\n\tf.check(id, \"10203\", \"send\", true)\n\trepairKey := f.text(\"SELECT member_key FROM chat_members WHERE conversation_id=? AND actor_id=10203\", string(id))\n\tif serviceKey == repairKey || !strings.Contains(repairKey, \":repair:\") {\n\t\tt.Fatal(\"repair reused original membership episode\")\n\t}\n\tf.php(\"repair-close\")\n\tf.poll()\n\tf.check(id, \"10203\", \"send\", false)\n\t// Same order, same worker, new assignment: a separate immutable conversation.\n\tf.exec(`INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,\n\t\tbooking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,\n\t\testimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at)\n\t\tSELECT 778,REPEAT('N',26),order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,\n\t\tbooking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,\n\t\testimated_offline_collect_cents,estimated_net_income_cents,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM assignments WHERE id=401`)\n\tf.exec(\"UPDATE orders SET current_assignment_id=778,lifecycle_status='active',assignment_status='accepted' WHERE id=401\")\n\tf.php(\"sync\")\n\tf.poll()\n\tnewID, err := f.store.FindOrder(f.ctx, principal(\"10203\"), \"401\", \"778\")\n\tif err != nil || newID == id {\n\t\tt.Fatal(\"reassignment merged old conversation\", err)\n\t}\n\tf.check(id, \"10203\", \"send\", false)\n\tf.check(newID, \"10203\", \"send\", true)\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_intervals WHERE conversation_id=? AND start_version=1\", string(newID)) != \"2\" {\n\t\tt.Fatal(\"new scope inherited old intervals\")\n\t}\n\tt.Log(\"real PHP snapshots, version history gaps, lease takeover, rollback, S03 session/current guard locks passed\")\n}\n\nfunc TestLateCommitWithoutWakeAndConcurrentClaims(t *testing.T) {\n\tf := newFixture(t)\n\tf.poll()\n\tbody := f.text(\"SELECT snapshot_json FROM chat_policy_guards WHERE order_id=401\")\n\tvar snapshot map[string]any\n\tif json.Unmarshal([]byte(body), &snapshot) != nil {\n\t\tt.Fatal(\"snapshot\")\n\t}\n\t// Model an uncommitted PHP authority change without inferring order enums.\n\tsnapshot[\"state\"] = \"open\"\n\tfor _, m := range snapshot[\"members\"].([]any) {\n\t\tm.(map[string]any)[\"can_send\"] = false\n\t}\n\traw, err := json.Marshal(snapshot)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpayload := `{\"schema_version\":1,\"policy_version\":\"2\",\"snapshot\":` + string(raw) + `}`\n\tlate, err := f.root.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer late.Rollback()\n\t// Use the unique scope, not the order range index: the fixture must not gap\n\t// lock the independent scope that is meant to commit first.\n\tif _, err = late.ExecContext(f.ctx, `UPDATE chat_policy_guards SET policy_version=2,state='open',snapshot_json=?,snapshot_hash=? WHERE scope_key='order:401:assignment:401'`, string(raw), digest(string(raw))); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = late.ExecContext(f.ctx, `INSERT INTO chat_business_events(event_id,aggregate_key,aggregate_version,schema_version,event_type,payload_json,created_at)\n\t\tVALUES(?,'order:401:assignment:401',2,1,'chat.policy.changed',?,UTC_TIMESTAMP())`, strings.Repeat(\"a\", 32), payload); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.php(\"sync\", \"402\") // Higher ID, different scope, commits first.\n\tif f.poll().Applied != 1 {\n\t\tt.Fatal(\"independent higher committed event not applied\")\n\t}\n\tif err = late.Commit(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.poll().Applied != 1 || f.text(\"SELECT status FROM chat_event_receipts WHERE event_id=?\", strings.Repeat(\"a\", 32)) != \"done\" {\n\t\tt.Fatal(\"lower late commit was skipped\")\n\t}\n\tf.exec(`UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'`)\n\tf.php(\"sync\")\n\tevent := f.event(\"3\")\n\tvar wg sync.WaitGroup\n\tresults := make(chan error, 2)\n\tleases := make(chan Lease, 2)\n\tfor range 2 {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tl, e := f.store.Claim(f.ctx, event)\n\t\t\tresults <- e\n\t\t\tif e == nil {\n\t\t\t\tleases <- l\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\tclose(results)\n\tsuccess, busy := 0, 0\n\tfor e := range results {\n\t\tif e == nil {\n\t\t\tsuccess++\n\t\t} else if errors.Is(e, ports.ErrBusy) {\n\t\t\tbusy++\n\t\t} else {\n\t\t\tt.Fatal(e)\n\t\t}\n\t}\n\tif success != 1 || busy != 1 {\n\t\tt.Fatal(\"non-exclusive event lease\", success, busy)\n\t}\n\tlease := <-leases\n\t// The immutable source hash is checked before any projection mutation.\n\tf.exec(\"UPDATE chat_business_events SET payload_json=CONCAT(payload_json,' ') WHERE event_id=?\", event)\n\tif err = f.store.Consume(f.ctx, lease); !errors.Is(err, policy.ErrDenied) {\n\t\tt.Fatal(\"changed source accepted\", err)\n\t}\n\tif err = f.store.deferLease(f.ctx, lease, policy.ErrDenied); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT status FROM chat_event_receipts WHERE event_id=?\", event) != \"rejected\" {\n\t\tt.Fatal(\"poison event spins without quarantine\")\n\t}\n\tt.Log(\"lower-ID late commit discovered without Redis; concurrent lease exclusive; tampered source quarantined\")\n}\n\nfunc TestConfiguredProjectionWorkerLifecycle(t *testing.T) {\n\tf := newFixture(t)\n\tbinary, _ := filepath.Abs(\"../../bin/chatd\")\n\tif _, err := os.Stat(binary); err != nil {\n\t\tt.Fatal(\"build.sh must run before isolated worker lifecycle test\")\n\t}\n\tcfg := map[string]any{\"env\": \"test\", \"http\": map[string]string{\"listen\": \"127.0.0.1:19501\", \"internal_listen\": \"127.0.0.1:19502\"},\n\t\t\"dependencies\": map[string]any{\"operation_timeout\": \"3s\", \"mysql\": map[string]any{\"enabled\": true, \"address\": os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"), \"database\": f.name, \"username\": f.user, \"password_env\": \"CHAT_S05_MYSQL_PASSWORD\"}},\n\t\t\"auth\":         map[string]any{\"enabled\": true, \"public_keys\": map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}}, \"conversations\": map[string]bool{\"enabled\": true}}\n\tbody, err := json.Marshal(cfg)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpath := filepath.Join(t.TempDir(), \"worker.json\")\n\tif os.WriteFile(path, body, 0600) != nil {\n\t\tt.Fatal(\"config fixture\")\n\t}\n\tlogFile, err := os.CreateTemp(t.TempDir(), \"worker-log\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer logFile.Close()\n\tcmd := exec.CommandContext(f.ctx, binary, \"worker\", \"--config\", path)\n\tcmd.Env = append(os.Environ(), \"CHAT_S05_MYSQL_PASSWORD=s05-fixture-only\")\n\tcmd.Stdout = logFile\n\tcmd.Stderr = logFile\n\tif err = cmd.Start(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdone := make(chan error, 1)\n\tgo func() { done <- cmd.Wait() }()\n\tt.Cleanup(func() { cmd.Process.Kill() })\n\tdeadline := time.NewTimer(10 * time.Second)\n\tdefer deadline.Stop()\n\tticker := time.NewTicker(50 * time.Millisecond)\n\tdefer ticker.Stop()\n\tfor f.text(\"SELECT COUNT(*) FROM chat_event_receipts WHERE status='done'\") != \"1\" {\n\t\tselect {\n\t\tcase err = <-done:\n\t\t\tt.Fatal(\"worker exited before projecting\", err)\n\t\tcase <-deadline.C:\n\t\t\tt.Fatal(\"worker failed to consume without Redis\")\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n\tif err = cmd.Process.Signal(os.Interrupt); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tselect {\n\tcase err = <-done:\n\t\tif err != nil {\n\t\t\tt.Fatal(\"worker shutdown\", err)\n\t\t}\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"worker did not stop\")\n\t}\n\tlogFile.Sync()\n\tlogs, err := os.ReadFile(logFile.Name())\n\tif err != nil || !strings.Contains(string(logs), `\"mode\":\"conversation_projection\"`) || !strings.Contains(string(logs), \"worker_stopped\") {\n\t\tt.Fatal(\"configured worker lifecycle not observed\")\n\t}\n\tt.Log(\"actual chatd worker: independent table grants, configured projection without Redis, clean shutdown\")\n}\n","chat/internal/conversation/realtime.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Projections only select candidates. Every socket output rechecks the current\n// PHP guard, login, epochs and membership; this list never grants permission.\nfunc (s *Store) MemberCandidates(ctx context.Context, id ports.ID) ([]ports.ID, error) {\n\tif !positive(id) {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\trows, e := s.db.QueryContext(ctx, `SELECT CAST(actor_id AS CHAR) FROM chat_members WHERE conversation_id=? AND can_read=1 ORDER BY actor_id LIMIT 11`, string(id))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tdefer rows.Close()\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar actor ports.ID\n\t\tif rows.Scan(&actor) != nil || !positive(actor) {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, actor)\n\t}\n\tif rows.Err() != nil || len(ids) > 10 {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn ids, nil\n}\n","chat/internal/conversation/reminders.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Server-side only: not an impersonation API and never grants send permission.\nfunc (s *Store) RecipientLocked(ctx context.Context, tx *sql.Tx, cid, actor ports.ID) (ports.Grant, error) {\n\tif !positive(cid) || !positive(actor) {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tvar scope, kind string\n\tif tx.QueryRowContext(ctx, `SELECT scope_key,conversation_type FROM chat_conversations WHERE id=?`, string(cid)).Scan(&scope, &kind) != nil || kind != \"order\" {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tprojection, grant, err := s.reader.RecipientLocked(ctx, tx, scope, actor)\n\tif err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\tauthority := &Authority{tx: tx, request: ports.PolicyRequest{Actor: ports.Principal{ActorID: actor, ExpiresAt: time.Now().Add(s.timeout)}, ConversationID: cid, Action: \"read\"}, projection: projection, grant: grant}\n\treturn s.LockProjection(ctx, tx, authority)\n}\n","chat/internal/conversation/store.go":"// Package conversation materializes PHP authority; it never interprets orders.\npackage conversation\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrGap = errors.New(\"CHAT_POLICY_VERSION_GAP\")\nvar ErrLease = errors.New(\"CHAT_EVENT_LEASE_LOST\")\n\ntype Config struct {\n\tEnabled bool `json:\"enabled\"`\n}\ntype Store struct {\n\tdb       *sql.DB\n\treader   *policy.Reader\n\tidentity *auth.MySQLSource\n\ttimeout  time.Duration\n}\n\nfunc NewStore(db *sql.DB, environment string, timeout time.Duration) (*Store, error) {\n\tif db == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tr, err := policy.NewReader(environment, timeout)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\ti, err := auth.NewMySQLSource(db)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Store{db: db, reader: r, identity: i, timeout: timeout}, nil\n}\n\n// Authorize is for bounded metadata checks. A later send must NOT reuse its\n// result: call AuthorizeLocked and commit the message using that same tx.\nfunc (s *Store) Authorize(ctx context.Context, req ports.PolicyRequest) (ports.Grant, error) {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.AuthorizeLocked(ctx, tx, req)\n\tif err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\treturn g, nil\n}\n\n// ValidatePrincipal performs the account/session check without assuming that\n// the actor has any conversations. Account-wide listings must call this even\n// when their candidate set is empty; otherwise a revoked session can receive\n// a successful (empty) response without consulting the authoritative login.\nfunc (s *Store) ValidatePrincipal(ctx context.Context, p ports.Principal) error {\n ctx, cancel := context.WithTimeout(ctx, s.timeout)\n defer cancel()\n tx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n if err != nil {\n  return ports.ErrUnavailable\n }\n defer tx.Rollback()\n if err := s.identity.ValidatePrincipalLocked(ctx, tx, p); err != nil {\n  return err\n }\n if err := tx.Commit(); err != nil {\n  return ports.ErrUnavailable\n }\n return nil\n}\n\n// Authority binds PHP guard/session locks to this exact transaction and request.\n// Callers may lock a stable account restriction between authority and projection.\n// Its fields are private so no caller can invent or reuse a grant on another tx.\ntype Authority struct {\n\ttx         *sql.Tx\n\trequest    ports.PolicyRequest\n\tprojection policy.Projection\n\tgrant      ports.Grant\n}\n\nfunc (s *Store) AuthorizeLocked(ctx context.Context, tx *sql.Tx, req ports.PolicyRequest) (ports.Grant, error) {\n\ta, err := s.LockAuthority(ctx, tx, req)\n\tif err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\treturn s.LockProjection(ctx, tx, a)\n}\n\n// LockAuthority locks PHP guard, staff epochs, login and active account first.\nfunc (s *Store) LockAuthority(ctx context.Context, tx *sql.Tx, req ports.PolicyRequest) (*Authority, error) {\n\tif tx == nil || !positive(req.ConversationID) || (req.Action != \"read\" && req.Action != \"send\") {\n\t\treturn nil, policy.ErrDenied\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tvar scope, kind string\n\terr := tx.QueryRowContext(ctx, `SELECT scope_key,conversation_type FROM chat_conversations WHERE id=?`, string(req.ConversationID)).Scan(&scope, &kind)\n\tif err == sql.ErrNoRows {\n\t\treturn nil, policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tif kind != \"order\" {\n\t\treturn nil, policy.ErrDenied\n\t}\n\tp, err := s.reader.CurrentLocked(ctx, tx, scope)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tg, err := s.reader.AuthorizeLocked(ctx, tx, scope, p.Version, req.Actor, req.Action)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err = s.identity.ValidatePrincipalLocked(ctx, tx, req.Actor); err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Authority{tx: tx, request: req, projection: p, grant: g}, nil\n}\n\n// LockProjection must follow any stable account restriction lock used by send.\nfunc (s *Store) LockProjection(ctx context.Context, tx *sql.Tx, a *Authority) (ports.Grant, error) {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tif a == nil || tx == nil || a.tx != tx {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tvar version, hash, order, assignment, state string\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(policy_version AS CHAR),snapshot_hash,CAST(order_id AS CHAR),CAST(assignment_id AS CHAR),state\n\t\tFROM chat_conversations WHERE id=? AND scope_key=? AND conversation_type='order' FOR UPDATE`, string(a.request.ConversationID), a.grant.ScopeKey).Scan(&version, &hash, &order, &assignment, &state)\n\tif err == sql.ErrNoRows {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif version != string(a.projection.Version) || hash != a.projection.Hash || order != string(a.projection.OrderID) || assignment != string(a.projection.AssignmentID) || state != a.projection.State {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tvar key string\n\tvar read, send bool\n\terr = tx.QueryRowContext(ctx, `SELECT member_key,can_read,can_send FROM chat_members WHERE conversation_id=? AND actor_id=? AND actor_kind='mini' LOCK IN SHARE MODE`, string(a.request.ConversationID), string(a.request.Actor.ActorID)).Scan(&key, &read, &send)\n\tif err == sql.ErrNoRows {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif key != a.grant.MemberKey || !read || (a.request.Action == \"send\" && !send) || !time.Now().Before(a.request.Actor.ExpiresAt) {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\treturn a.grant, nil\n}\n\n// FindOrder only finds an already-projected binding. It cannot create members.\nfunc (s *Store) FindOrder(ctx context.Context, actor ports.Principal, order, assignment ports.ID) (ports.ID, error) {\n\tif !positive(order) || !positive(assignment) {\n\t\treturn \"\", policy.ErrDenied\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar id ports.ID\n\terr = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE conversation_type='order' AND order_id=? AND assignment_id=?`, string(order), string(assignment)).Scan(&id)\n\tif err == sql.ErrNoRows {\n\t\treturn \"\", policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif _, err = s.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: actor, ConversationID: id, Action: \"read\"}); err != nil {\n\t\treturn \"\", err\n\t}\n\tif tx.Commit() != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn id, nil\n}\n\n// VisibleVersionLocked is the S08 predicate contract. A message's policy_version\n// is immutable, not reconstructed from processing time, current seq or episode.\nfunc (s *Store) VisibleVersionLocked(ctx context.Context, tx *sql.Tx, req ports.PolicyRequest, version ports.ID) (bool, error) {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tif !positive(version) {\n\t\treturn false, policy.ErrDenied\n\t}\n\treq.Action = \"read\"\n\tg, err := s.AuthorizeLocked(ctx, tx, req)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif compare(version, g.Version) > 0 {\n\t\treturn false, policy.ErrDenied\n\t}\n\tvar start string\n\t// A plain EXISTS could reuse an older RR snapshot with an interval that has\n\t// since closed, resurrecting the returning member's unauthorized gap.\n\terr = tx.QueryRowContext(ctx, `SELECT CAST(start_version AS CHAR) FROM chat_member_intervals WHERE conversation_id=? AND actor_id=?\n\t\tAND start_version<=? AND (end_version IS NULL OR end_version>?) LIMIT 1 LOCK IN SHARE MODE`, string(req.ConversationID), string(req.Actor.ActorID), string(version), string(version)).Scan(&start)\n\tif err == sql.ErrNoRows {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn true, nil\n}\n\nfunc positive(id ports.ID) bool { return id.Valid() && id != \"0\" }\nfunc compare(a, b ports.ID) int {\n\tav, _ := strconv.ParseUint(string(a), 10, 64)\n\tbv, _ := strconv.ParseUint(string(b), 10, 64)\n\tif av < bv {\n\t\treturn -1\n\t}\n\tif av > bv {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// apply runs only inside a leased event transaction under the PHP guard lock.\n// Intervals are [start_version,end_version); message seq is never a join bound.\nfunc (s *Store) apply(ctx context.Context, tx *sql.Tx, p policy.Projection) error {\n\t_, err := tx.ExecContext(ctx, `INSERT INTO chat_conversations(conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at)\n\t\tVALUES('order',?,?,?,0,'','','pending',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE id=id`, p.Scope, string(p.OrderID), string(p.AssignmentID))\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar id, version ports.ID\n\tvar hash, order, assignment string\n\terr = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),CAST(policy_version AS CHAR),snapshot_hash,CAST(order_id AS CHAR),CAST(assignment_id AS CHAR)\n\t\tFROM chat_conversations WHERE conversation_type='order' AND scope_key=? FOR UPDATE`, p.Scope).Scan(&id, &version, &hash, &order, &assignment)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif order != string(p.OrderID) || assignment != string(p.AssignmentID) {\n\t\treturn policy.ErrDenied\n\t}\n\tif compare(p.Version, version) <= 0 {\n\t\tif p.Version == version && p.Hash != hash {\n\t\t\treturn policy.ErrDenied\n\t\t}\n\t\treturn nil\n\t}\n\tcurrent, _ := strconv.ParseUint(string(version), 10, 64)\n\tincoming, _ := strconv.ParseUint(string(p.Version), 10, 64)\n\tif current == ^uint64(0) || incoming != current+1 {\n\t\treturn ErrGap\n\t}\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(actor_id AS CHAR),member_key FROM chat_members WHERE conversation_id=? AND can_read=1 FOR UPDATE`, string(id))\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\told := map[ports.ID]string{}\n\tfor rows.Next() {\n\t\tvar actor ports.ID\n\t\tvar key string\n\t\tif rows.Scan(&actor, &key) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\told[actor] = key\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tnext := map[ports.ID]string{}\n\tfor _, m := range p.Members {\n\t\tnext[m.ActorID] = m.Grant.MemberKey\n\t}\n\tfor actor, key := range old {\n\t\tif next[actor] != key {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_member_intervals SET end_version=? WHERE conversation_id=? AND actor_id=? AND end_version IS NULL`, string(p.Version), string(id), string(actor)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_members SET can_read=0,can_send=0 WHERE conversation_id=?`, string(id)); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, m := range p.Members {\n\t\tg := m.Grant\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_members(conversation_id,actor_id,actor_kind,role,member_key,can_read,can_send)\n\t\t\tVALUES(?,?,'mini',?,?,?,?) ON DUPLICATE KEY UPDATE role=VALUES(role),member_key=VALUES(member_key),can_read=VALUES(can_read),can_send=VALUES(can_send)`, string(id), string(m.ActorID), m.Role, g.MemberKey, g.CanRead, g.CanSend); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif old[m.ActorID] != g.MemberKey {\n\t\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version) VALUES(?,?,?,?)`, string(id), string(m.ActorID), g.MemberKey, string(p.Version)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\t_, err = tx.ExecContext(ctx, `UPDATE chat_conversations SET policy_version=?,snapshot_hash=?,episode_key=?,state=?,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, string(p.Version), p.Hash, p.Episode, p.State, string(id))\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/dependencies/dependencies_test.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestSettingsAndOwnership(t *testing.T) {\n\tif Defaults().Validate(\"test\") != nil {\n\t\tt.Fatal(\"defaults invalid\")\n\t}\n\tfor _, mutate := range []func(*Settings){\n\t\tfunc(s *Settings) { s.MySQL.MaxOpenServe = 32 }, func(s *Settings) { s.Redis.PoolWorker = 16 }, func(s *Settings) { s.OperationTimeout = \"0s\" },\n\t\tfunc(s *Settings) { s.ExternalConcurrency = 0 }, func(s *Settings) { s.ProbeInterval = \"1ms\" },\n\t\tfunc(s *Settings) { s.MySQL.Enabled = true; s.MySQL.Username = \"root\" },\n\t\tfunc(s *Settings) { s.Redis.Enabled = true; s.Redis.KeyPrefix = \"bxchat:production:\" },\n\t\tfunc(s *Settings) {\n\t\t\ts.Redis.Enabled = true\n\t\t\ts.Redis.Address = \"8.8.8.8:6379\"\n\t\t\ts.Redis.KeyPrefix = \"bxchat:test:\"\n\t\t},\n\t} {\n\t\ts := Defaults()\n\t\tmutate(&s)\n\t\tif s.Validate(\"test\") == nil {\n\t\t\tt.Fatal(\"unsafe budget or environment accepted\")\n\t\t}\n\t}\n\tfor _, line := range []string{\n\t\t\"GRANT SELECT, INSERT, UPDATE, DELETE ON `bixuan_test_chat`.`chat_reminder_intents` TO 'u'@'h'\",\n\t\t\"GRANT SELECT, INSERT, UPDATE, DELETE ON `bixuan_test_chat`.`chat_image_uploads` TO 'u'@'h'\",\n\t\t\"GRANT SELECT, INSERT ON `bixuan_test_chat`.`chat_governance_audit` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`chat_mini_auditors` TO 'u'@'h'\",\n\t\t\"GRANT USAGE ON *.* TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`orders` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`chat_admin_sessions` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`chat_staff_authority_versions` TO 'u'@'h'\",\n\t\t\"GRANT SELECT, INSERT, UPDATE, DELETE ON `bixuan_test_chat`.`chat_messages` TO 'u'@'h'\",\n\t\t\"GRANT SELECT, INSERT, UPDATE, DELETE ON `bixuan_test_chat`.`chat_member_reads` TO 'u'@'h'\",\n\t} {\n\t\tif !safeGrant(line, \"bixuan_test_chat\", \"test\") {\n\t\t\tt.Fatal(\"valid grant refused\")\n\t\t}\n\t}\n\tfor _, line := range []string{\n\t\t\"GRANT DELETE ON `bixuan_test_chat`.`chat_governance_audit` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `bixuan_test_chat`.`chat_image_audit` TO 'u'@'h'\",\n\t\t\"GRANT ALL PRIVILEGES ON *.* TO 'u'@'h'\", \"GRANT UPDATE ON `bixuan_test_chat`.`orders` TO 'u'@'h'\",\n\t\t\"GRANT INSERT ON `bixuan_test_chat`.`chat_policy_guards` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `bixuan_test_chat`.`chat_staff_authority_versions` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `bixuan_test_chat`.`chat_calls` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`user_wallets` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`admin_users` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `bixuan_test_chat`.`chat_admin_sessions` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `other_db`.`chat_messages` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.* TO 'u'@'h'\", \"GRANT CREATE ON `bixuan_test_chat`.`chat_messages` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`orders` TO 'u'@'h' WITH GRANT OPTION\",\n\t} {\n\t\tif safeGrant(line, \"bixuan_test_chat\", \"test\") {\n\t\t\tt.Fatal(\"unsafe grant accepted\")\n\t\t}\n\t}\n}\nfunc fixture() Scenario {\n\treturn Scenario{Credential: \"test-token\", Principal: ports.Principal{ActorID: \"1\", SessionID: \"test-session\", Environment: \"test\", Scopes: []string{\"chat\"}},\n\t\tConversationID: \"2\", Grant: ports.Grant{CanRead: true, CanSend: true, ScopeKey: \"order:test:1\", Version: \"3\"},\n\t\tFingerprint: \"fixture-hash\", Text: \"施工尺寸12.5\", Safety: ports.SafetyResult{Decision: \"passed\", RuleVersion: \"test-rule\"},\n\t\tObjectKey: \"test/object\", Media: ports.MediaResult{Decision: \"passed\", ObjectVersion: \"v1\", ManifestHash: \"manifest\"},\n\t\tReminder: ports.Reminder{IntentID: \"1\", RecipientID: \"2\", TargetSeq: \"3\", ClusterVersion: \"4\", OperationID: \"operation-1\"},\n\t\tReceipt:  ports.Receipt{OperationID: \"operation-1\", State: \"accepted\"}}\n}\nfunc TestPortsAreExplicitAndFailClosed(t *testing.T) {\n\tctx := context.Background()\n\ts := fixture()\n\tp, err := NewProviders(\"test\", \"fake\", 2, time.Second, s)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ta, err := p.Identity.Authenticate(ctx, \"test-token\")\n\tif err != nil || a.ActorID != \"1\" {\n\t\tt.Fatal(\"fixture identity failed\")\n\t}\n\ta.Scopes[0] = \"tampered\"\n\tagain, _ := p.Identity.Authenticate(ctx, \"test-token\")\n\tif again.Scopes[0] != \"chat\" {\n\t\tt.Fatal(\"fixture alias\")\n\t}\n\tif _, err = p.Identity.Authenticate(ctx, \"forged\"); err == nil {\n\t\tt.Fatal(\"forged credential accepted\")\n\t}\n\tif _, err = p.Policy.Authorize(ctx, ports.PolicyRequest{Actor: again, ConversationID: \"2\", Action: \"send\"}); err != nil {\n\t\tt.Fatal(\"fixture grant failed\")\n\t}\n\tif _, err = p.Policy.Authorize(ctx, ports.PolicyRequest{Actor: again, ConversationID: \"99\", Action: \"send\"}); err == nil {\n\t\tt.Fatal(\"cross-conversation grant\")\n\t}\n\tif _, err = p.Safety.CheckText(ctx, ports.TextRequest{Actor: again, ConversationID: \"2\", Text: s.Text, Fingerprint: s.Fingerprint}); err != nil {\n\t\tt.Fatal(\"fixture safety failed\")\n\t}\n\tif _, err = p.Media.Inspect(ctx, ports.MediaRequest{Actor: again, ObjectKey: s.ObjectKey, ObjectVersion: \"v1\", ManifestHash: \"manifest\"}); err != nil {\n\t\tt.Fatal(\"fixture media failed\")\n\t}\n\tif _, err = p.Media.Inspect(ctx, ports.MediaRequest{Actor: again, ObjectKey: s.ObjectKey, ObjectVersion: \"v2\", ManifestHash: \"manifest\"}); err == nil {\n\t\tt.Fatal(\"wrong object version accepted\")\n\t}\n\tfor range 2 {\n\t\tif _, err = p.Notification.Submit(ctx, s.Reminder); err != nil {\n\t\t\tt.Fatal(\"same operation failed\")\n\t\t}\n\t}\n\tchanged := s.Reminder\n\tchanged.TargetSeq = \"99\"\n\tif _, err = p.Notification.Submit(ctx, changed); !errors.Is(err, ports.ErrInvalid) {\n\t\tt.Fatal(\"operation conflict accepted\")\n\t}\n\tif _, err = NewProviders(\"production\", \"fake\", 1, time.Second, s); err == nil {\n\t\tt.Fatal(\"production fake allowed\")\n\t}\n\tfor _, mode := range []string{\"disabled\", \"fake\"} {\n\t\tempty, _ := NewProviders(\"test\", mode, 1, time.Second, Scenario{})\n\t\tif _, err = empty.Identity.Authenticate(ctx, \"test-token\"); err == nil {\n\t\t\tt.Fatal(\"empty provider allowed identity\")\n\t\t}\n\t\tif _, err = empty.Safety.CheckText(ctx, ports.TextRequest{Fingerprint: \"x\"}); err == nil {\n\t\t\tt.Fatal(\"empty provider passed safety\")\n\t\t}\n\t}\n}\nfunc TestProviderDeadlineAndConcurrency(t *testing.T) {\n\ts := fixture()\n\ts.Delay = time.Second\n\tp, _ := NewProviders(\"test\", \"fake\", 1, 50*time.Millisecond, s)\n\tdone := make(chan error, 1)\n\tgo func() { _, err := p.Identity.Authenticate(context.Background(), s.Credential); done <- err }()\n\timpl := p.Identity.(*provider)\n\tdeadline := time.Now().Add(time.Second)\n\tfor len(impl.gate) == 0 && time.Now().Before(deadline) {\n\t\ttime.Sleep(time.Millisecond)\n\t}\n\tif _, err := p.Identity.Authenticate(context.Background(), s.Credential); !errors.Is(err, ports.ErrBusy) {\n\t\tt.Fatal(\"concurrency not bounded\")\n\t}\n\tif err := <-done; !errors.Is(err, context.DeadlineExceeded) {\n\t\tt.Fatal(\"deadline ignored\")\n\t}\n\tctx, cancel := context.WithCancel(context.Background())\n\tcancel()\n\tif _, err := p.Identity.Authenticate(ctx, s.Credential); !errors.Is(err, context.Canceled) {\n\t\tt.Fatal(\"cancel ignored\")\n\t}\n}\nfunc TestHTTPBudgetsAndNoRedirect(t *testing.T) {\n\tentered := make(chan struct{}, 1)\n\trelease := make(chan struct{})\n\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tswitch r.URL.Path {\n\t\tcase \"/slow\":\n\t\t\tentered <- struct{}{}\n\t\t\t<-release\n\t\tcase \"/large\":\n\t\t\t_, _ = io.WriteString(w, strings.Repeat(\"x\", 100))\n\t\tcase \"/redirect\":\n\t\t\thttp.Redirect(w, r, \"/forbidden\", 302)\n\t\tcase \"/forbidden\":\n\t\t\tt.Error(\"followed redirect\")\n\t\tdefault:\n\t\t\t_, _ = io.WriteString(w, \"ok\")\n\t\t}\n\t}))\n\tdefer server.Close()\n\tdefer func() {\n\t\tselect {\n\t\tcase <-release:\n\t\tdefault:\n\t\t\tclose(release)\n\t\t}\n\t}()\n\th, _ := NewHTTP(1, 80*time.Millisecond, 64)\n\tdefer h.Close()\n\trequest := func(path string) *http.Request { r, _ := http.NewRequest(\"GET\", server.URL+path, nil); return r }\n\tif _, status, err := h.Do(context.Background(), request(\"/redirect\")); err != nil || status != 302 {\n\t\tt.Fatal(\"redirect behavior\")\n\t}\n\tif _, _, err := h.Do(context.Background(), request(\"/large\")); !errors.Is(err, ports.ErrUnavailable) {\n\t\tt.Fatal(\"body limit ignored\")\n\t}\n\tdone := make(chan error, 1)\n\tgo func() { _, _, err := h.Do(context.Background(), request(\"/slow\")); done <- err }()\n\t<-entered\n\tif _, _, err := h.Do(context.Background(), request(\"/\")); !errors.Is(err, ports.ErrBusy) {\n\t\tt.Fatal(\"HTTP concurrency ignored\")\n\t}\n\terr := <-done\n\tclose(release)\n\tif !errors.Is(err, ports.ErrUnavailable) {\n\t\tt.Fatal(\"HTTP deadline ignored\")\n\t}\n}\nfunc TestDisabledReadinessAndStop(t *testing.T) {\n\tr, err := Open(Defaults(), \"test\", \"serve\", \"disabled\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer r.Close()\n\ts := r.Refresh(context.Background())\n\tif s.InfrastructureReady || s.BusinessEnabled || s.MySQL.State != \"disabled\" || s.MySQL.Required != true || s.Redis.Required {\n\t\tt.Fatal(\"false readiness\")\n\t}\n\tr.Stop()\n\tif r.Refresh(context.Background()).InfrastructureReady {\n\t\tt.Fatal(\"stopping became ready\")\n\t}\n}\n","chat/internal/dependencies/governance.go":"package dependencies\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http\"\n)\n\n// Explicit composition for the S21-S23 isolated/release composition root. No\n// call is made by the still-closed production bootstrap.\ntype Governance struct {\n\tService      *message.GovernanceService\n\tHTTP         http.Handler\n\tReminders    *message.ReminderService\n\tInternalHTTP http.Handler\n}\n\nfunc (r *Runtime) ComposeGovernance(base *message.Service, media *message.MediaService, n ports.Notification, internal *auth.InternalAuth) (*Governance, error) {\n\tif r.History == nil || r.Identity == nil || base == nil || n == nil || internal == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tg, err := message.NewGovernanceService(base, r.History, media, r.environment)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\th, err := message.NewGovernanceHandler(g, r.Identity, 8)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treminders, err := message.NewReminderService(base, n)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tih, err := message.NewReminderInternalHandler(reminders, internal)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Governance{g, h, reminders, ih}, nil\n}\n","chat/internal/dependencies/history.go":"package dependencies\n\nimport \"github.com/franz-9527/workers/chat/internal/message\"\nimport \"github.com/franz-9527/workers/chat/internal/ports\"\n\nfunc (r *Runtime) EnableHistory(c message.HistoryConfig) error {\n\tkey, e := c.Key()\n\tif e != nil {\n\t\treturn e\n\t}\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil || r.Conversations == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tr.History, e = message.NewHistoryService(r.sql, r.Conversations, r.environment, key, r.settings.Timeout())\n\tif e != nil {\n\t\treturn e\n\t}\n\tr.HistoryHTTP, e = message.NewHistoryHandler(r.History, r.Identity, 16)\n\treturn e\n}\n","chat/internal/dependencies/http.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// HTTP is reusable transport only. S03 supplies signed identity endpoints;\n// this stage never calls PHP or any supplier from a public request.\ntype HTTP struct {\n\tclient  *http.Client\n\tgate    chan struct{}\n\ttimeout time.Duration\n\tmaxBody int64\n}\n\nfunc NewHTTP(concurrency int, timeout time.Duration, maxBody int64) (*HTTP, error) {\n\tif concurrency < 1 || concurrency > 32 || timeout <= 0 || timeout > 5*time.Second || maxBody < 1 || maxBody > 1<<20 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttransport := &http.Transport{Proxy: nil, DialContext: (&net.Dialer{Timeout: timeout}).DialContext,\n\t\tMaxConnsPerHost: concurrency, MaxIdleConns: concurrency, MaxIdleConnsPerHost: concurrency,\n\t\tResponseHeaderTimeout: timeout, IdleConnTimeout: time.Minute, TLSHandshakeTimeout: timeout, MaxResponseHeaderBytes: 16 << 10}\n\treturn &HTTP{client: &http.Client{Transport: transport, Timeout: timeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}, gate: make(chan struct{}, concurrency), timeout: timeout, maxBody: maxBody}, nil\n}\nfunc (h *HTTP) Do(ctx context.Context, req *http.Request) ([]byte, int, error) {\n\tif req == nil || req.URL == nil || req.URL.User != nil || (req.URL.Scheme != \"http\" && req.URL.Scheme != \"https\") || req.ContentLength > 64<<10 {\n\t\treturn nil, 0, ports.ErrInvalid\n\t}\n\tif ctx.Err() != nil {\n\t\treturn nil, 0, ctx.Err()\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\treturn nil, 0, ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, h.timeout)\n\tdefer cancel()\n\tresponse, err := h.client.Do(req.Clone(ctx))\n\tif err != nil {\n\t\treturn nil, 0, ports.ErrUnavailable\n\t}\n\tdefer response.Body.Close()\n\tdata, err := io.ReadAll(io.LimitReader(response.Body, h.maxBody+1))\n\tif err != nil || int64(len(data)) > h.maxBody {\n\t\treturn nil, response.StatusCode, ports.ErrUnavailable\n\t}\n\treturn data, response.StatusCode, nil\n}\nfunc (h *HTTP) Close() { h.client.CloseIdleConnections() }\n","chat/internal/dependencies/identity.go":"package dependencies\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// EnableIdentity only enables identity exchange, never policy/message providers.\nfunc (r *Runtime) EnableIdentity(c auth.Config) error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tv, e := c.Verifier(r.environment)\n\tif e != nil {\n\t\treturn e\n\t}\n\tsource, e := auth.NewMySQLSource(r.sql)\n\tif e != nil {\n\t\treturn e\n\t}\n\tvar store auth.OneTimeStore\n\tif r.redis != nil {\n\t\tstore, e = auth.NewRedisStore(r.redis, r.environment, r.settings.Redis.KeyPrefix)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t}\n\tr.Identity, e = auth.NewService(v, source, store, r.settings.ExternalConcurrency, r.settings.Timeout())\n\tif e != nil {\n\t\treturn e\n\t}\n\tr.Ports.Identity = r.Identity\n\tr.IdentityHTTP, e = auth.NewHandler(r.Identity, r.settings.ExternalConcurrency)\n\treturn e\n}\n","chat/internal/dependencies/integration_test.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"syscall\"\n\t\"testing\"\n\t\"time\"\n\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\n// Explicit opt-in, loopback only, isolated fixture database/user. Never load a\n// production config or migrate the application schema from a test.\nfunc TestMySQL57RedisIntegration(t *testing.T) {\n\tif os.Getenv(\"CHAT_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"set CHAT_INTEGRATION=1 for isolated real services\")\n\t}\n\tma, ra := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"), os.Getenv(\"CHAT_INTEGRATION_REDIS_ADDR\")\n\tif !loopback(ma) || !loopback(ra) {\n\t\tt.Fatal(\"integration requires explicit loopback endpoints\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)\n\tdefer cancel()\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = ma\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ReadTimeout = time.Second\n\tc.WriteTimeout = time.Second\n\tc.Logger = silentMySQLLog{}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(\"admin connector failed\")\n\t}\n\tadmin := sql.OpenDB(connector)\n\tt.Cleanup(func() { _ = admin.Close() })\n\tif err := admin.PingContext(ctx); err != nil {\n\t\tvar dbError *mysql.MySQLError\n\t\tif errors.As(err, &dbError) {\n\t\t\tt.Fatalf(\"isolated MySQL admin error code=%d\", dbError.Number)\n\t\t}\n\t\tt.Fatalf(\"isolated MySQL unavailable: error type %T\", err)\n\t}\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tdatabase, user := \"bixuan_test_s02_\"+suffix, \"bxchat_test_\"+suffix\n\tvar b [16]byte\n\tif _, err = rand.Read(b[:]); err != nil {\n\t\tt.Fatal(\"fixture secret failed\")\n\t}\n\tpw := hex.EncodeToString(b[:])\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"isolated fixture host\")\n\t}\n\texec := func(query string) {\n\t\tt.Helper()\n\t\tif _, err := admin.ExecContext(ctx, query); err != nil {\n\t\t\tt.Fatal(\"isolated fixture operation failed\")\n\t\t}\n\t}\n\texec(\"CREATE DATABASE `\" + database + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tt.Cleanup(func() { _, _ = admin.Exec(\"DROP DATABASE IF EXISTS `\" + database + \"`\") })\n\texec(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY '\" + pw + \"'\")\n\tt.Cleanup(func() { _, _ = admin.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\") })\n\texec(\"CREATE TABLE `\" + database + \"`.chat_contract_probe(id BIGINT UNSIGNED PRIMARY KEY, body TEXT, created_at DATETIME(6)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci\")\n\texec(\"CREATE TABLE `\" + database + \"`.orders(id BIGINT PRIMARY KEY)\")\n\texec(\"INSERT INTO `\" + database + \"`.orders(id) VALUES(1)\")\n\texec(\"CREATE TABLE `\" + database + \"`.user_wallets(id BIGINT PRIMARY KEY)\")\n\texec(\"GRANT SELECT,INSERT,UPDATE,DELETE ON `\" + database + \"`.chat_contract_probe TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\texec(\"GRANT SELECT ON `\" + database + \"`.orders TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\tt.Setenv(\"CHAT_MYSQL_PASSWORD\", pw)\n\ts := Defaults()\n\ts.MySQL.Enabled = true\n\ts.MySQL.Address = ma\n\ts.MySQL.Database = database\n\ts.MySQL.Username = user\n\ts.MySQL.MaxOpenServe = 2\n\ts.Redis.Enabled = true\n\ts.Redis.Address = ra\n\ts.Redis.KeyPrefix = \"bxchat:test:\"\n\tr, err := Open(s, \"test\", \"serve\", \"disabled\")\n\tif err != nil {\n\t\tt.Fatal(\"resource open failed\")\n\t}\n\tdefer r.Close()\n\tif got := r.Refresh(ctx); !got.InfrastructureReady || got.Redis.State != \"ready\" || got.BusinessEnabled {\n\t\tt.Fatalf(\"real dependency contract failed: %#v\", got)\n\t}\n\tvar version string\n\tif r.sql.QueryRowContext(ctx, \"SELECT VERSION()\").Scan(&version) != nil {\n\t\tt.Fatal(\"version query failed\")\n\t}\n\tt.Log(\"MySQL verified:\", version)\n\tstamp := time.Date(2026, 10, 21, 1, 2, 3, 123456000, time.UTC)\n\tbody := \"墙纸🧱 尺寸12.5 金额100\"\n\tif _, err = r.sql.ExecContext(ctx, \"INSERT INTO chat_contract_probe(id,body,created_at) VALUES (?,?,?)\", \"18446744073709551615\", body, stamp); err != nil {\n\t\tt.Fatal(\"utf8mb4/bigint/time insert failed\")\n\t}\n\tvar gotID, gotBody string\n\tvar gotTime time.Time\n\tif r.sql.QueryRowContext(ctx, \"SELECT id,body,created_at FROM chat_contract_probe\").Scan(&gotID, &gotBody, &gotTime) != nil || gotID != \"18446744073709551615\" || gotBody != body || !gotTime.Equal(stamp) || gotTime.Location() != time.UTC {\n\t\tt.Fatal(\"cross-language data contract failed\")\n\t}\n\tfor _, query := range []string{\"UPDATE orders SET id=2\", \"UPDATE user_wallets SET id=2\", \"CREATE TABLE forbidden_ddl(id INT)\"} {\n\t\t_, err = r.sql.ExecContext(ctx, query)\n\t\tvar denied *mysql.MySQLError\n\t\tif !errors.As(err, &denied) || denied.Number != 1142 {\n\t\t\tt.Fatal(\"business write/DDL not denied by MySQL\")\n\t\t}\n\t}\n\ttx, err := r.sql.BeginTx(ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(\"read-lock transaction failed\")\n\t}\n\tvar orderID int\n\terr = tx.QueryRowContext(ctx, \"SELECT id FROM orders WHERE id=1 FOR UPDATE\").Scan(&orderID)\n\t_ = tx.Rollback()\n\tif err != nil || orderID != 1 {\n\t\tt.Fatal(\"SELECT-only permission cannot lock authority row\")\n\t}\n\tt.Run(\"pool_and_cancellation\", func(t *testing.T) {\n\t\tone, e := r.sql.Conn(ctx)\n\t\tif e != nil {\n\t\t\tt.Fatal(\"lease failed\")\n\t\t}\n\t\ttwo, e := r.sql.Conn(ctx)\n\t\tif e != nil {\n\t\t\tone.Close()\n\t\t\tt.Fatal(\"lease failed\")\n\t\t}\n\t\tshort, stop := context.WithTimeout(ctx, 40*time.Millisecond)\n\t\t_, e = r.sql.Conn(short)\n\t\tstop()\n\t\tone.Close()\n\t\ttwo.Close()\n\t\tif e == nil {\n\t\t\tt.Fatal(\"pool admission deadline ignored\")\n\t\t}\n\t\tvar wg sync.WaitGroup\n\t\tfor range 8 {\n\t\t\twg.Add(1)\n\t\t\tgo func() { defer wg.Done(); var n int; _ = r.sql.QueryRowContext(ctx, \"SELECT SLEEP(0.02)\").Scan(&n) }()\n\t\t}\n\t\twg.Wait()\n\t\tif r.sql.Stats().OpenConnections > 2 {\n\t\t\tt.Fatal(\"MySQL pool exceeded budget\")\n\t\t}\n\t\tshort, stop = context.WithTimeout(ctx, 40*time.Millisecond)\n\t\tdefer stop()\n\t\tvar n int\n\t\tif r.sql.QueryRowContext(short, \"SELECT SLEEP(1)\").Scan(&n) == nil {\n\t\t\tt.Fatal(\"query deadline ignored\")\n\t\t}\n\t})\n\tkey := s.Redis.KeyPrefix + \"s02:\" + suffix\n\tif r.redis.Set(ctx, key, \"临时票据\", time.Minute).Err() != nil {\n\t\tt.Fatal(\"Redis set failed\")\n\t}\n\tdefer r.redis.Del(context.Background(), key)\n\tif value, e := r.redis.GetDel(ctx, key).Result(); e != nil || value != \"临时票据\" {\n\t\tt.Fatal(\"Redis atomic consume failed\")\n\t}\n\tif r.redis.PoolStats().TotalConns > uint32(s.Redis.PoolServe) {\n\t\tt.Fatal(\"Redis pool exceeded cap\")\n\t}\n\tinfo, e := r.redis.Info(ctx, \"server\").Result()\n\tif e != nil {\n\t\tt.Fatal(\"Redis version query failed\")\n\t}\n\tfor _, line := range strings.Split(info, \"\\r\\n\") {\n\t\tif strings.HasPrefix(line, \"redis_version:\") {\n\t\t\tt.Log(line)\n\t\t}\n\t}\n\tdegraded := s\n\tdegraded.Redis.Address = \"127.0.0.1:1\"\n\td, e := Open(degraded, \"test\", \"serve\", \"disabled\")\n\tif e != nil {\n\t\tt.Fatal(\"degraded resource open failed\")\n\t}\n\tdefer d.Close()\n\tif got := d.Refresh(ctx); !got.InfrastructureReady || got.Redis.State != \"unavailable\" {\n\t\tt.Fatal(\"Redis failure blocked required dependency\")\n\t}\n\tfailed := s\n\tfailed.MySQL.Address = \"127.0.0.1:1\"\n\tf, e := Open(failed, \"test\", \"serve\", \"disabled\")\n\tif e != nil {\n\t\tt.Fatal(\"failed resource open failed\")\n\t}\n\tdefer f.Close()\n\tif got := f.Refresh(ctx); got.InfrastructureReady || got.MySQL.State != \"unavailable\" {\n\t\tt.Fatal(\"MySQL outage reported ready\")\n\t}\n\tif binary := os.Getenv(\"CHAT_INTEGRATION_CHATD_BIN\"); binary != \"\" {\n\t\ttestProcessReadiness(t, binary, s)\n\t}\n\texec(\"GRANT UPDATE ON `\" + database + \"`.orders TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\tif got := r.Refresh(ctx); got.InfrastructureReady || got.MySQL.Code != \"CHAT_DATABASE_CONTRACT_INVALID\" {\n\t\tt.Fatal(\"overprivileged account reported ready\")\n\t}\n}\n\nfunc testProcessReadiness(t *testing.T, binary string, s Settings) {\n\tt.Helper()\n\tif !filepath.IsAbs(binary) {\n\t\tt.Fatal(\"binary must have an absolute local path\")\n\t}\n\tfor _, test := range []struct {\n\t\tname         string\n\t\tmysql, redis bool\n\t\tstatus       int\n\t}{{\"healthy\", true, true, 200}, {\"redis_degraded\", true, false, 200}, {\"mysql_down\", false, true, 503}} {\n\t\tt.Run(\"process_\"+test.name, func(t *testing.T) {\n\t\t\tdeps := s\n\t\t\tif !test.mysql {\n\t\t\t\tdeps.MySQL.Address = \"127.0.0.1:1\"\n\t\t\t}\n\t\t\tif !test.redis {\n\t\t\t\tdeps.Redis.Address = \"127.0.0.1:1\"\n\t\t\t}\n\t\t\taddresses := []string{}\n\t\t\tfor range 2 {\n\t\t\t\tlistener, e := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\t\t\t\tif e != nil {\n\t\t\t\t\tt.Fatal(\"test port allocation failed\")\n\t\t\t\t}\n\t\t\t\taddresses = append(addresses, listener.Addr().String())\n\t\t\t\t_ = listener.Close()\n\t\t\t}\n\t\t\tcfg := map[string]any{\"env\": \"test\", \"http\": map[string]string{\"listen\": addresses[0], \"internal_listen\": addresses[1]}, \"shutdown_timeout\": \"1s\", \"log_level\": \"error\", \"provider_mode\": \"disabled\", \"dependencies\": deps}\n\t\t\tdata, _ := json.Marshal(cfg)\n\t\t\tpath := filepath.Join(t.TempDir(), \"chat.json\")\n\t\t\tif os.WriteFile(path, data, 0600) != nil {\n\t\t\t\tt.Fatal(\"process config write failed\")\n\t\t\t}\n\t\t\tcmd := exec.Command(binary, \"serve\", \"--config\", path)\n\t\t\tcmd.Stdout = io.Discard\n\t\t\tcmd.Stderr = io.Discard\n\t\t\tif cmd.Start() != nil {\n\t\t\t\tt.Fatal(\"process start failed\")\n\t\t\t}\n\t\t\tdone := make(chan error, 1)\n\t\t\tgo func() { done <- cmd.Wait() }()\n\t\t\tdefer func() {\n\t\t\t\t_ = cmd.Process.Signal(syscall.SIGTERM)\n\t\t\t\tselect {\n\t\t\t\tcase err := <-done:\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Error(\"process exited unsuccessfully\")\n\t\t\t\t\t}\n\t\t\t\tcase <-time.After(3 * time.Second):\n\t\t\t\t\t_ = cmd.Process.Kill()\n\t\t\t\t\t<-done\n\t\t\t\t\tt.Error(\"process shutdown timed out\")\n\t\t\t\t}\n\t\t\t}()\n\t\t\tclient := &http.Client{Timeout: time.Second, Transport: &http.Transport{Proxy: nil}}\n\t\t\tdefer client.CloseIdleConnections()\n\t\t\turl := \"http://\" + addresses[1] + \"/readyz\"\n\t\t\tvar response *http.Response\n\t\t\tvar err error\n\t\t\tdeadline := time.Now().Add(5 * time.Second)\n\t\t\tfor time.Now().Before(deadline) {\n\t\t\t\tresponse, err = client.Get(url)\n\t\t\t\tif err == nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\ttime.Sleep(10 * time.Millisecond)\n\t\t\t}\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(\"health endpoint unavailable\")\n\t\t\t}\n\t\t\tvar snapshot Snapshot\n\t\t\terr = json.NewDecoder(response.Body).Decode(&snapshot)\n\t\t\t_ = response.Body.Close()\n\t\t\tif err != nil || response.StatusCode != test.status || snapshot.BusinessEnabled || snapshot.Scope != \"infrastructure_only\" || snapshot.InfrastructureReady != test.mysql {\n\t\t\t\tt.Fatal(\"process readiness contract failed\")\n\t\t\t}\n\t\t\tif test.redis != (snapshot.Redis.State == \"ready\") {\n\t\t\t\tt.Fatal(\"Redis degraded state missing\")\n\t\t\t}\n\t\t\tfor _, path := range []string{\"/readyz\", \"/chat/api/v1/messages\", \"/chat/ws\"} {\n\t\t\t\tresp, e := client.Get(\"http://\" + addresses[0] + path)\n\t\t\t\tif e != nil {\n\t\t\t\t\tt.Fatal(\"public endpoint failed\")\n\t\t\t\t}\n\t\t\t\t_ = resp.Body.Close()\n\t\t\t\tif resp.StatusCode != 404 {\n\t\t\t\t\tt.Fatal(\"private/business endpoint exposed\")\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n","chat/internal/dependencies/messaging.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"encoding/base64\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/avpipeline\"\n\t\"github.com/franz-9527/workers/chat/internal/imagepipeline\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"regexp\"\n\t\"time\"\n)\n\ntype RemindersConfig struct {\n\tEnabled     bool   `json:\"enabled\"`\n\tPHPEndpoint string `json:\"php_endpoint\"`\n\tKeyID       string `json:\"key_id\"`\n\tKeyEnv      string `json:\"key_env\"`\n}\ntype publicationRelay struct{ runtime *Runtime }\n\nfunc (p publicationRelay) Committed(m ports.CommittedMessage) {\n\tif p.runtime.Socket != nil {\n\t\tp.runtime.Socket.Committed(m)\n\t}\n}\nfunc (p publicationRelay) Changed(m ports.CommittedMessage) {\n\tif p.runtime.Socket != nil {\n\t\tp.runtime.Socket.Changed(m)\n\t}\n}\n\n// The only process composition: HTTP/WSS share the exact same sender; media,\n// governance and reminders share its durable DB and current authority locks.\nfunc (r *Runtime) EnableMessaging(c message.Config, images imagepipeline.Config, reminders RemindersConfig) error {\n\tif !c.Enabled {\n\t\tif images.Enabled || reminders.Enabled {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil || r.Conversations == nil || r.Moderation == nil || r.History == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tbase, err := message.NewService(r.sql, r.Conversations, r.Moderation, min(r.settings.Timeout(), 3*time.Second))\n\tif err != nil {\n\t\treturn err\n\t}\n\tbase = base.WithPublisher(publicationRelay{r})\n\tmedia, err := imagepipeline.Build(images, r.environment, base)\n\tif err != nil {\n\t\treturn err\n\t}\n\tbase = base.WithMedia(media)\n\tr.Messages = base\n\tr.Media = media\n\tr.History.ConfigureMedia(media != nil, false, false)\n\tr.MessageHTTP, err = message.NewHandler(base, r.Identity, 16)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif media != nil {\n\t\tr.MediaHTTP, err = message.NewMediaHandler(media, r.Identity, 8)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tg, err := message.NewGovernanceService(base, r.History, media, r.environment)\n\tif err != nil {\n\t\treturn err\n\t}\n\tr.Governance = g\n\tr.GovernanceHTTP, err = message.NewGovernanceHandler(g, r.Identity, 8)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif reminders.Enabled {\n\t\tif r.redis == nil || !regexp.MustCompile(\"^CHAT_[A-Z0-9_]{1,60}$\").MatchString(reminders.KeyEnv) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tkeyText := os.Getenv(reminders.KeyEnv)\n\t\tkey, e := base64.StdEncoding.Strict().DecodeString(keyText)\n\t\tif e != nil || len(key) != 32 || base64.StdEncoding.EncodeToString(key) != keyText {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tstore, e := auth.NewRedisStore(r.redis, r.environment, r.settings.Redis.KeyPrefix)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tinternal, e := auth.NewInternal(r.environment, map[string][]byte{reminders.KeyID: key}, store, time.Second)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\th, e := NewHTTP(4, 3*time.Second, 8192)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tr.reminderTransport = h\n\t\tn, e := NewReminderHTTP(h, internal, reminders.PHPEndpoint, reminders.KeyID)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tr.Reminders, e = message.NewReminderService(base, n)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tr.ReminderHTTP, e = message.NewReminderInternalHandler(r.Reminders, internal)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *Runtime) RunMessaging(ctx context.Context, logger *slog.Logger) {\n\ttick := time.NewTicker(time.Second)\n\tdefer tick.Stop()\n\tfor {\n\t\tif r.OperationsReady() {\n\t\t\tpass, cancel := context.WithTimeout(ctx, 15*time.Second)\n\t\t\tif r.Media != nil {\n\t\t\t\tfor _, work := range []func(context.Context) error{r.Media.ProcessOne, r.Media.Advance, r.Media.CleanOne} {\n\t\t\t\t\tif err := work(pass); err != nil {\n\t\t\t\t\t\tlogger.Warn(\"media_pass_unavailable\", \"code\", \"CHAT_MEDIA_UNAVAILABLE\")\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif err := r.Governance.Maintain(pass, r.Reminders); err != nil {\n\t\t\t\tlogger.Warn(\"governance_pass_unavailable\", \"code\", \"CHAT_GOVERNANCE_UNAVAILABLE\")\n\t\t\t}\n\t\t\tcancel()\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t}\n\t}\n}\n\nvar _ http.Handler = (*message.GovernanceHandler)(nil)\n\nfunc (r *Runtime) EnableAV(c avpipeline.Config) error {\n\tif !c.Enabled {\n\t\treturn c.Validate()\n\t}\n\tif r.Messages == nil || r.Moderation == nil || r.History == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tservice, callback, e := avpipeline.Build(c, r.environment, r.Messages, r.Moderation)\n\tif e != nil {\n\t\treturn e\n\t}\n\tif e = r.Messages.AttachAV(service); e != nil {\n\t\treturn e\n\t}\n\thandler, e := message.NewAVHandler(service, r.Identity, 8)\n\tif e != nil {\n\t\treturn e\n\t}\n\tr.AV = service\n\tr.AVHTTP = handler\n\tr.AVCallback = callback\n\tr.History.ConfigureMedia(r.Media != nil, c.Audio, c.Video)\n\treturn nil\n}\nfunc (r *Runtime) RunAV(ctx context.Context) {\n\ttick := time.NewTicker(time.Second)\n\tdefer tick.Stop()\n\tfor {\n\t\tif ctx.Err() != nil {\n\t\t\treturn\n\t\t}\n\t\tif r.OperationsReady() {\n\t\t\tpass, cancel := context.WithTimeout(ctx, 80*time.Second)\n\t\t\tif r.AV != nil {\n\t\t\t\t_ = r.AV.ProcessOne(pass)\n\t\t\t\t_ = r.AV.CleanOne(pass)\n\t\t\t}\n\t\t\tif r.Messages != nil {\n\t\t\t\t_ = r.Messages.ApplyStorageOne(pass)\n\t\t\t\t_ = r.Messages.CleanCloudOne(pass)\n\t\t\t\tif time.Now().Unix()%60 == 0 {\n\t\t\t\t\t_ = r.Messages.TierOne(pass)\n\t\t\t\t}\n\t\t\t}\n\t\t\tcancel()\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t}\n\t}\n}\n","chat/internal/dependencies/mysql.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\ntype silentMySQLLog struct{}\n\nfunc (silentMySQLLog) Print(...any) {}\n\nfunc openMySQL(s Settings, role string) (*sql.DB, error) {\n\tpw, err := password(s.MySQL.PasswordEnv, true)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = s.MySQL.Address\n\tc.DBName = s.MySQL.Database\n\tc.User = s.MySQL.Username\n\tc.Passwd = pw\n\tc.Collation = \"utf8mb4_unicode_ci\"\n\tc.ParseTime = true\n\tc.Loc = time.UTC\n\tc.Timeout = s.Timeout()\n\tc.ReadTimeout = s.Timeout()\n\tc.WriteTimeout = s.Timeout()\n\tc.Logger = silentMySQLLog{}\n\tif err := c.Apply(mysql.Charset(\"utf8mb4\", \"utf8mb4_unicode_ci\")); err != nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tc.Params = map[string]string{\"time_zone\": \"'+00:00'\", \"sql_mode\": \"'STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'\"}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tdb := sql.OpenDB(connector)\n\tmax := s.MySQL.MaxOpenServe\n\tif role == \"worker\" {\n\t\tmax = s.MySQL.MaxOpenWorker\n\t}\n\tdb.SetMaxOpenConns(max)\n\tdb.SetMaxIdleConns(s.MySQL.MaxIdle)\n\tdb.SetConnMaxLifetime(3 * time.Minute)\n\tdb.SetConnMaxIdleTime(time.Minute)\n\treturn db, nil\n}\n\nvar mysql57 = regexp.MustCompile(`^5\\.7\\.[0-9]+(?:[-.].*)?$`)\n\nfunc checkMySQL(ctx context.Context, db *sql.DB, database, environment string) error {\n\t// One lease keeps session invariants and SHOW GRANTS on the same connection.\n\tconn, err := db.Conn(ctx)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer conn.Close()\n\tvar version, zone, collation, charset, mode, schemaCollation string\n\terr = conn.QueryRowContext(ctx, `SELECT VERSION(), @@session.time_zone, @@session.collation_connection, @@session.character_set_connection, @@session.sql_mode`).Scan(&version, &zone, &collation, &charset, &mode)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !mysql57.MatchString(version) || zone != \"+00:00\" || collation != \"utf8mb4_unicode_ci\" || charset != \"utf8mb4\" || !strings.Contains(mode, \"STRICT_TRANS_TABLES\") {\n\t\treturn ports.ErrInvalid\n\t}\n\tif conn.QueryRowContext(ctx, `SELECT DEFAULT_COLLATION_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = DATABASE()`).Scan(&schemaCollation) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif schemaCollation != \"utf8mb4_unicode_ci\" {\n\t\treturn ports.ErrInvalid\n\t}\n\trows, err := conn.QueryContext(ctx, \"SHOW GRANTS\")\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer rows.Close()\n\tcount := 0\n\tfor rows.Next() {\n\t\tvar grant string\n\t\tif rows.Scan(&grant) != nil || !safeGrant(grant, database, environment) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tcount++\n\t}\n\tif rows.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif count == 0 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\n// Exact table ownership, never a chat_* wildcard: PHP owns several chat_* tables.\nvar goOwned = map[string]bool{\n\t\"chat_av_uploads\": true, \"chat_av_parts\": true, \"chat_av_jobs\": true, \"chat_av_objects\": true, \"chat_av_items\": true, \"chat_av_listens\": true, \"chat_av_raw_receipts\": true, \"chat_av_asr_requests\": true, \"chat_av_budgets\": true,\n\n\t\"chat_storage_applications\": true, \"chat_storage_application_errors\": true,\n\t\"chat_conversations\": true, \"chat_members\": true, \"chat_member_intervals\": true, \"chat_member_reads\": true,\n\t\"chat_messages\": true, \"chat_message_changes\": true, \"chat_send_intents\": true, \"chat_preference_accounts\": true, \"chat_user_preferences\": true,\n\t\"chat_restrictions\": true, \"chat_text_checks\": true, \"chat_risk_events\": true, \"chat_event_receipts\": true,\n\t\"chat_image_uploads\": true, \"chat_image_bundles\": true, \"chat_image_items\": true, \"chat_image_objects\": true, \"chat_image_reports\": true,\n\t\"chat_audit_accounts\": true, \"chat_audit_snapshots\": true, \"chat_audit_snapshot_items\": true, \"chat_cases\": true,\n\t\"chat_reminder_events\": true, \"chat_reminder_clusters\": true, \"chat_reminder_budgets\": true, \"chat_reminder_intents\": true,\n}\nvar appendOwned = map[string]bool{\"chat_governance_audit\": true, \"chat_image_audit\": true}\nvar phpReadable = map[string]bool{\"chat_storage_policy\": true, \"chat_storage_policy_audit\": true, \"wechat_identities\": true, \"users\": true, \"login_sessions\": true, \"chat_admin_sessions\": true, \"chat_mini_auditors\": true, \"orders\": true, \"assignments\": true, \"after_sales\": true, \"chat_policy_guards\": true, \"chat_business_events\": true, \"chat_staff_authority_versions\": true}\n\nfunc safeGrant(grant, database, environment string) bool {\n\tif !strings.HasPrefix(grant, \"GRANT \") || strings.Contains(grant, \" WITH GRANT OPTION\") {\n\t\treturn false\n\t}\n\tafter, subject, ok := strings.Cut(strings.TrimPrefix(grant, \"GRANT \"), \" ON \")\n\tif !ok {\n\t\treturn false\n\t}\n\ttarget, _, ok := strings.Cut(subject, \" TO \")\n\tif !ok {\n\t\treturn false\n\t}\n\tif after == \"USAGE\" && target == \"*.*\" {\n\t\treturn true\n\t}\n\tparts := strings.Split(strings.ReplaceAll(target, \"`\", \"\"), \".\")\n\tif len(parts) != 2 || parts[0] != database || !identifier.MatchString(parts[1]) {\n\t\treturn false\n\t}\n\towned := goOwned[parts[1]] || (environment != \"production\" && parts[1] == \"chat_contract_probe\")\n\tfor _, privilege := range strings.Split(after, \", \") {\n\t\tif privilege == \"SELECT\" && (owned || appendOwned[parts[1]] || phpReadable[parts[1]]) {\n\t\t\tcontinue\n\t\t}\n\t\tif appendOwned[parts[1]] && privilege == \"INSERT\" {\n\t\t\tcontinue\n\t\t}\n\t\tif owned && (privilege == \"INSERT\" || privilege == \"UPDATE\" || privilege == \"DELETE\") {\n\t\t\tcontinue\n\t\t}\n\t\treturn false\n\t}\n\treturn true\n}\n","chat/internal/dependencies/operations.go":"package dependencies\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"runtime\"\n\t\"time\"\n)\n\ntype OperationsConfig struct {\n\tGateFile string `json:\"gate_file\"`\n\tEpoch    string `json:\"epoch\"`\n}\n\nvar recoveryEpoch = regexp.MustCompile(\"^[0-9a-f]{64}$\")\n\nfunc (c OperationsConfig) Validate(required bool) bool {\n\tif c.GateFile == \"\" && c.Epoch == \"\" {\n\t\treturn !required\n\t}\n\treturn filepath.IsAbs(c.GateFile) && recoveryEpoch.MatchString(c.Epoch)\n}\n\n// Gate belongs to independent recovery control, never a DB backup or release directory.\nfunc (c OperationsConfig) Ready(env string) bool {\n\tif c.GateFile == \"\" {\n\t\treturn c.Epoch == \"\"\n\t}\n\tinfo, err := os.Lstat(c.GateFile)\n\tif err != nil || !info.Mode().IsRegular() || info.Size() > 1024 || info.Mode().Perm()&0022 != 0 {\n\t\treturn false\n\t}\n\tfile, err := os.Open(c.GateFile)\n\tif err != nil {\n\t\treturn false\n\t}\n\tdefer file.Close()\n\traw, err := io.ReadAll(io.LimitReader(file, 1025))\n\tif err != nil || len(raw) > 1024 {\n\t\treturn false\n\t}\n\tvar mark struct {\n\t\tSchema      int    `json:\"schema\"`\n\t\tEnvironment string `json:\"environment\"`\n\t\tEpoch       string `json:\"epoch\"`\n\t\tState       string `json:\"state\"`\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\td.DisallowUnknownFields()\n\tif d.Decode(&mark) != nil {\n\t\treturn false\n\t}\n\tvar rest any\n\tif d.Decode(&rest) != io.EOF {\n\t\treturn false\n\t}\n\tcanonical, _ := json.Marshal(mark)\n\tvar compact bytes.Buffer\n\tif json.Compact(&compact, raw) != nil || !bytes.Equal(canonical, compact.Bytes()) {\n\t\treturn false\n\t}\n\treturn mark.Schema == 1 && mark.Environment == env && mark.Epoch == c.Epoch && mark.State == \"ready\"\n}\nfunc (r *Runtime) ConfigureOperations(c OperationsConfig) { r.operations = c }\nfunc (r *Runtime) OperationsReady() bool                  { return r.operations.Ready(r.environment) }\nfunc (r *Runtime) RunProjection(ctx context.Context, logger *slog.Logger) {\n\ttimer := time.NewTicker(time.Second)\n\tdefer timer.Stop()\n\tfor {\n\t\tif r.OperationsReady() {\n\t\t\tpass, cancel := context.WithTimeout(ctx, 5*time.Second)\n\t\t\tout, err := r.Conversations.Poll(pass, 100)\n\t\t\tcancel()\n\t\t\tif err != nil {\n\t\t\t\tlogger.Warn(\"projection_unavailable\", \"code\", \"CHAT_PROJECTION_UNAVAILABLE\")\n\t\t\t} else if out.Applied > 0 {\n\t\t\t\tlogger.Info(\"projection_pass\", \"applied\", out.Applied)\n\t\t\t}\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-timer.C:\n\t\t}\n\t}\n}\nfunc (r *Runtime) Metrics(w http.ResponseWriter, q *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"text/plain; version=0.0.4\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tif q.Method != http.MethodGet && q.Method != http.MethodHead {\n\t\tw.Header().Set(\"Allow\", \"GET, HEAD\")\n\t\tw.WriteHeader(405)\n\t\treturn\n\t}\n\tif q.Method == http.MethodHead {\n\t\treturn\n\t}\n\tready := 0\n\tif r.OperationsReady() {\n\t\tready = 1\n\t}\n\ts := r.Snapshot()\n\tmysqlReady, redisReady := 0, 0\n\tif s.MySQL.State == \"ready\" {\n\t\tmysqlReady = 1\n\t}\n\tif s.Redis.State == \"ready\" {\n\t\tredisReady = 1\n\t}\n\tvar m runtime.MemStats\n\truntime.ReadMemStats(&m)\n\t_, _ = fmt.Fprintf(w, \"chat_recovery_ready %d\\nchat_mysql_ready %d\\nchat_redis_ready %d\\nchat_goroutines %d\\nchat_heap_bytes %d\\n\", ready, mysqlReady, redisReady, runtime.NumGoroutine(), m.HeapAlloc)\n\tif r.sql != nil {\n\t\td := r.sql.Stats()\n\t\t_, _ = fmt.Fprintf(w, \"chat_db_open %d\\nchat_db_in_use %d\\nchat_db_wait_total %d\\n\", d.OpenConnections, d.InUse, d.WaitCount)\n\t}\n}\n\ntype recoveryError struct{}\n\nfunc (recoveryError) Error() string              { return \"CHAT_RECOVERY_BLOCKED\" }\nfunc (recoveryError) PublicCode() (string, bool) { return \"CHAT_RECOVERY_BLOCKED\", true }\n\ntype guardedCommands struct {\n\truntime *Runtime\n\tinner   socket.Commands\n}\n\nfunc (g guardedCommands) Execute(ctx context.Context, p ports.Principal, kind string, raw json.RawMessage) (string, any, error) {\n\tif !g.runtime.OperationsReady() {\n\t\treturn \"\", nil, recoveryError{}\n\t}\n\treturn g.inner.Execute(ctx, p, kind, raw)\n}\n\ntype guardedPolicy struct {\n\truntime *Runtime\n\tinner   ports.RealtimePolicy\n}\n\nfunc (g guardedPolicy) Authorize(ctx context.Context, q ports.PolicyRequest) (ports.Grant, error) {\n\tif !g.runtime.OperationsReady() {\n\t\treturn ports.Grant{}, recoveryError{}\n\t}\n\treturn g.inner.Authorize(ctx, q)\n}\nfunc (g guardedPolicy) MemberCandidates(ctx context.Context, id ports.ID) ([]ports.ID, error) {\n\tif !g.runtime.OperationsReady() {\n\t\treturn nil, recoveryError{}\n\t}\n\treturn g.inner.MemberCandidates(ctx, id)\n}\n","chat/internal/dependencies/operations_test.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestS22IndependentGateNeverAcceptsRestoredOrMalformedReady(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"gate.json\")\n\tepoch := strings.Repeat(\"a\", 64)\n\tc := OperationsConfig{path, epoch}\n\tif c.Ready(\"test\") || !c.Validate(true) || (OperationsConfig{}).Validate(true) {\n\t\tt.Fatal(\"missing recovery evidence\")\n\t}\n\twrite := func(raw string) {\n\t\tt.Helper()\n\t\tif os.WriteFile(path, []byte(raw), 0640) != nil {\n\t\t\tt.Fatal(\"gate write\")\n\t\t}\n\t}\n\tgood := `{\"schema\":1,\"environment\":\"test\",\"epoch\":\"` + epoch + `\",\"state\":\"ready\"}`\n\twrite(good)\n\tif !c.Ready(\"test\") || c.Ready(\"production\") {\n\t\tt.Fatal(\"environment isolation\")\n\t}\n\tfor _, raw := range []string{strings.Replace(good, \"ready\", \"blocked\", 1), strings.Replace(good, epoch, strings.Repeat(\"b\", 64), 1), good + \"{}\", strings.Replace(good, `\"state\":\"ready\"`, `\"state\":\"blocked\",\"state\":\"ready\"`, 1)} {\n\t\twrite(raw)\n\t\tif c.Ready(\"test\") {\n\t\t\tt.Fatal(\"invalid gate accepted\")\n\t\t}\n\t}\n\twrite(good)\n\tif os.Chmod(path, 0666) != nil {\n\t\tt.Fatal(\"chmod\")\n\t}\n\tif c.Ready(\"test\") {\n\t\tt.Fatal(\"world-writable ready accepted\")\n\t}\n}\n\ntype gateCommandFixture struct{ called bool }\n\nfunc (g *gateCommandFixture) Execute(context.Context, ports.Principal, string, json.RawMessage) (string, any, error) {\n\tg.called = true\n\treturn \"\", nil, nil\n}\nfunc TestS22GateProtectsAlreadyAuthenticatedWSSAndPrivateMetrics(t *testing.T) {\n\tr := &Runtime{environment: \"test\", operations: OperationsConfig{filepath.Join(t.TempDir(), \"missing.json\"), strings.Repeat(\"a\", 64)}}\n\tinner := &gateCommandFixture{}\n\tg := guardedCommands{r, inner}\n\tif _, _, err := g.Execute(context.Background(), ports.Principal{}, \"history.request\", nil); err == nil || inner.called {\n\t\tt.Fatal(\"old socket bypassed recovery\")\n\t}\n\tw := httptest.NewRecorder()\n\tr.Metrics(w, httptest.NewRequest(\"GET\", \"/metrics\", nil))\n\tif !strings.Contains(w.Body.String(), \"chat_recovery_ready 0\") || strings.Contains(w.Body.String(), \"missing.json\") {\n\t\tt.Fatal(\"metric privacy\")\n\t}\n}\n","chat/internal/dependencies/providers.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Scenario is an explicit isolated fixture, not a permissive fallback. The\n// runtime uses an empty scenario: no identity/permission/safety is fabricated.\ntype Scenario struct {\n\tCredential                   string\n\tPrincipal                    ports.Principal\n\tGrant                        ports.Grant\n\tSafety                       ports.SafetyResult\n\tMedia                        ports.MediaResult\n\tReceipt                      ports.Receipt\n\tDelay                        time.Duration\n\tFailure                      error\n\tConversationID               ports.ID\n\tFingerprint, Text, ObjectKey string\n\tReminder                     ports.Reminder\n}\ntype provider struct {\n\tscenario    Scenario\n\tmode        string\n\tgate        chan struct{}\n\ttimeout     time.Duration\n\tenvironment string\n}\n\nfunc NewProviders(environment, mode string, concurrency int, timeout time.Duration, s Scenario) (ports.Set, error) {\n\tif concurrency < 1 || concurrency > 32 || timeout <= 0 || timeout > 5*time.Second || (environment != \"development\" && environment != \"test\" && environment != \"production\") || (mode != \"disabled\" && mode != \"fake\") || (mode == \"fake\" && environment != \"development\" && environment != \"test\") {\n\t\treturn ports.Set{}, ports.ErrInvalid\n\t}\n\tif s.Safety.Finding != nil {\n\t\tcopy := *s.Safety.Finding\n\t\ts.Safety.Finding = &copy\n\t}\n\ts.Principal.Scopes = append([]string(nil), s.Principal.Scopes...)\n\tp := &provider{scenario: s, mode: mode, gate: make(chan struct{}, concurrency), timeout: timeout, environment: environment}\n\treturn ports.Set{Identity: p, Policy: p, Safety: p, Media: p, Notification: p}, nil\n}\nfunc (p *provider) call(ctx context.Context, fn func() error) error {\n\tif ctx.Err() != nil {\n\t\treturn ctx.Err()\n\t}\n\tif p.mode != \"fake\" {\n\t\treturn ports.ErrUnavailable\n\t}\n\tselect {\n\tcase p.gate <- struct{}{}:\n\t\tdefer func() { <-p.gate }()\n\tdefault:\n\t\treturn ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, p.timeout)\n\tdefer cancel()\n\tif p.scenario.Delay > 0 {\n\t\tt := time.NewTimer(p.scenario.Delay)\n\t\tdefer t.Stop()\n\t\tselect {\n\t\tcase <-t.C:\n\t\tcase <-ctx.Done():\n\t\t\treturn ctx.Err()\n\t\t}\n\t}\n\tif ctx.Err() != nil {\n\t\treturn ctx.Err()\n\t}\n\tif p.scenario.Failure != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn fn()\n}\nfunc (p *provider) Authenticate(ctx context.Context, credential string) (ports.Principal, error) {\n\tvar result ports.Principal\n\terr := p.call(ctx, func() error {\n\t\tif p.scenario.Credential == \"\" || credential != p.scenario.Credential || !p.actor(p.scenario.Principal) {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Principal\n\t\tresult.Scopes = append([]string(nil), result.Scopes...)\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) Authorize(ctx context.Context, q ports.PolicyRequest) (ports.Grant, error) {\n\tvar result ports.Grant\n\terr := p.call(ctx, func() error {\n\t\tif !p.actor(q.Actor) || q.ConversationID != p.scenario.ConversationID || !q.ConversationID.Valid() || !p.scenario.Grant.Version.Valid() || p.scenario.Grant.ScopeKey == \"\" {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Grant\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) CheckText(ctx context.Context, q ports.TextRequest) (ports.SafetyResult, error) {\n\tvar result ports.SafetyResult\n\terr := p.call(ctx, func() error {\n\t\tif !p.actor(q.Actor) || q.Fingerprint == \"\" || q.Fingerprint != p.scenario.Fingerprint || q.Text != p.scenario.Text || q.ConversationID != p.scenario.ConversationID || (p.scenario.Safety.Decision != \"passed\" && p.scenario.Safety.Decision != \"blocked\" && p.scenario.Safety.Decision != \"review\") || p.scenario.Safety.RuleVersion == \"\" {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Safety\n\t\tif result.Finding != nil {\n\t\t\tcopy := *result.Finding\n\t\t\tresult.Finding = &copy\n\t\t}\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) Inspect(ctx context.Context, q ports.MediaRequest) (ports.MediaResult, error) {\n\tvar result ports.MediaResult\n\terr := p.call(ctx, func() error {\n\t\ts := p.scenario.Media\n\t\tif !p.actor(q.Actor) || q.ObjectKey == \"\" || q.ObjectKey != p.scenario.ObjectKey || q.ObjectVersion == \"\" || q.ObjectVersion != s.ObjectVersion || q.ManifestHash == \"\" || q.ManifestHash != s.ManifestHash || (s.Decision != \"passed\" && s.Decision != \"blocked\") {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = s\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) Submit(ctx context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tvar result ports.Receipt\n\terr := p.call(ctx, func() error {\n\t\tif q != p.scenario.Reminder {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tif q.OperationID == \"\" || q.OperationID != p.scenario.Receipt.OperationID || (p.scenario.Receipt.State != \"accepted\" && p.scenario.Receipt.State != \"provider_unknown\") {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Receipt\n\t\treturn nil\n\t})\n\treturn result, err\n}\n\nfunc (p *provider) actor(a ports.Principal) bool {\n\tb := p.scenario.Principal\n\treturn a.ActorID.Valid() && a.ActorID != \"0\" && a.ActorID == b.ActorID && a.SessionID != \"\" && a.SessionID == b.SessionID && a.Environment == p.environment && a.Environment == b.Environment\n}\n","chat/internal/dependencies/redis.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\ntype silentRedisLog struct{}\n\nfunc (silentRedisLog) Printf(context.Context, string, ...interface{}) {}\nfunc init()                                                           { redis.SetLogger(silentRedisLog{}) }\n\nfunc openRedis(s Settings, role string) (*redis.Client, error) {\n\tpw, err := password(s.Redis.PasswordEnv, false)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmax := s.Redis.PoolServe\n\tif role == \"worker\" {\n\t\tmax = s.Redis.PoolWorker\n\t}\n\treturn redis.NewClient(&redis.Options{Addr: s.Redis.Address, Password: pw, Protocol: 2,\n\t\tPoolSize: max, MaxActiveConns: max, MaxConcurrentDials: max, MaxIdleConns: max, MinIdleConns: 0,\n\t\tPipelinePoolSize: -1, MaxRetries: -1, DialerRetries: 1, DisableIdentity: true,\n\t\tDialTimeout: s.Timeout(), ReadTimeout: s.Timeout(), WriteTimeout: s.Timeout(), PoolTimeout: s.Timeout(),\n\t\tContextTimeoutEnabled: true}), nil\n}\n","chat/internal/dependencies/reminders.go":"package dependencies\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"time\"\n)\n\ntype ReminderHTTP struct {\n\ttransport     *HTTP\n\tsigner        *auth.InternalAuth\n\tendpoint, kid string\n}\n\nfunc NewReminderHTTP(h *HTTP, signer *auth.InternalAuth, endpoint, kid string) (*ReminderHTTP, error) {\n\tu, err := url.Parse(endpoint)\n\tif err != nil || h == nil || signer == nil || u.Scheme != \"https\" || u.Host == \"\" || u.User != nil || u.RawQuery != \"\" || u.Fragment != \"\" || u.Path != \"/chat-internal.php\" {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderHTTP{h, signer, endpoint, kid}, nil\n}\nfunc (h *ReminderHTTP) call(ctx context.Context, q map[string]string) (ports.Receipt, error) {\n\traw, _ := json.Marshal(q)\n\treq, err := http.NewRequestWithContext(ctx, \"POST\", h.endpoint, bytes.NewReader(raw))\n\tif err != nil {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\tif err = h.signer.Sign(req, raw, h.kid, time.Now()); err != nil {\n\t\treturn ports.Receipt{}, err\n\t}\n\tbody, status, err := h.transport.Do(ctx, req)\n\tif err != nil || status != 200 {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tvar result struct {\n\t\tOperation  string `json:\"operation_id\"`\n\t\tState      string `json:\"state\"`\n\t\tDiagnostic string `json:\"diagnostic\"`\n\t}\n\tif json.Unmarshal(body, &result) != nil || result.Operation != q[\"operation_id\"] {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tswitch result.State {\n\tcase \"accepted\", \"sent\", \"suppressed\", \"channel_limited\", \"provider_unknown\":\n\tdefault:\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tif len(result.Diagnostic) > 64 {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\treturn ports.Receipt{OperationID: result.Operation, State: result.State, Diagnostic: result.Diagnostic}, nil\n}\nfunc (h *ReminderHTTP) Submit(ctx context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tif !q.IntentID.Valid() || !q.RecipientID.Valid() || !q.ConversationID.Valid() || !q.TargetSeq.Valid() || !q.ClusterVersion.Valid() || len(q.OperationID) != 64 {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treturn h.call(ctx, map[string]string{\"intent_id\": string(q.IntentID), \"recipient_id\": string(q.RecipientID), \"conversation_id\": string(q.ConversationID), \"target_seq\": string(q.TargetSeq), \"cluster_version\": string(q.ClusterVersion), \"operation_id\": q.OperationID})\n}\nfunc (h *ReminderHTTP) Status(ctx context.Context, op string) (ports.Receipt, error) {\n\tif len(op) != 64 {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treturn h.call(ctx, map[string]string{\"operation_id\": op})\n}\n","chat/internal/dependencies/retention.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"log/slog\"\n\t\"time\"\n)\n\nfunc (r *Runtime) EnableRetention(c message.RetentionConfig) error {\n\tif c.Validate() != nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar err error\n\tr.Retention, err = message.NewRetention(r.sql, r.environment, c)\n\treturn err\n}\nfunc (r *Runtime) MaintainRetention(ctx context.Context, logger *slog.Logger) {\n\tafter := ports.ID(\"0\")\n\tticker := time.NewTicker(time.Minute)\n\tdefer ticker.Stop()\n\tfor {\n\t\tif r.OperationsReady() {\n\t\t\tpass, cancel := context.WithTimeout(ctx, 10*time.Second)\n\t\t\tout, err := r.Retention.Pass(pass, after)\n\t\t\tcancel()\n\t\t\tif err != nil {\n\t\t\t\tlogger.Warn(\"retention_unavailable\", \"code\", \"CHAT_RETENTION_UNAVAILABLE\")\n\t\t\t} else {\n\t\t\t\tafter = out.Next\n\t\t\t\tlogger.Info(\"retention_pass\", \"conversations\", out.Conversations, \"messages\", out.Messages, \"changes\", out.Changes)\n\t\t\t}\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n}\n","chat/internal/dependencies/runtime.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"net/http\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/moderation\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\ntype Runtime struct {\n\tMessages                                             *message.Service\n\tMedia                                                *message.MediaService\n\tAV                                                   *message.AVService\n\tAVHTTP, AVCallback                                   http.Handler\n\tGovernance                                           *message.GovernanceService\n\tReminders                                            *message.ReminderService\n\tMessageHTTP, MediaHTTP, GovernanceHTTP, ReminderHTTP http.Handler\n\treminderTransport                                    *HTTP\n\toperations                                           OperationsConfig\n\tRetention                                            *message.Retention\n\tIdentity                                             *auth.Service\n\tIdentityHTTP                                         http.Handler\n\tConversations                                        *conversation.Store\n\tModeration                                           *moderation.Service\n\tHistory                                              *message.HistoryService\n\tHistoryHTTP                                          http.Handler\n\tSocket                                               *socket.Gateway\n\tsql                                                  *sql.DB\n\tredis                                                *redis.Client\n\tPorts                                                ports.Set\n\tsettings                                             Settings\n\tenvironment, mode                                    string\n\tmu                                                   sync.RWMutex\n\tsnapshot                                             Snapshot\n\tstopping                                             bool\n}\ntype DependencyState struct {\n\tState    string `json:\"state\"`\n\tRequired bool   `json:\"required\"`\n\tCode     string `json:\"code,omitempty\"`\n}\ntype Snapshot struct {\n\tStage               string          `json:\"stage\"`\n\tScope               string          `json:\"scope\"`\n\tInfrastructureReady bool            `json:\"infrastructure_ready\"`\n\tBusinessEnabled     bool            `json:\"business_enabled\"`\n\tProviderMode        string          `json:\"provider_mode\"`\n\tSimulated           bool            `json:\"simulated\"`\n\tCheckedAt           time.Time       `json:\"checked_at\"`\n\tMySQL               DependencyState `json:\"mysql\"`\n\tRedis               DependencyState `json:\"redis\"`\n}\n\nfunc Open(s Settings, environment, role, mode string) (*Runtime, error) {\n\tif s.Validate(environment) != nil || (role != \"serve\" && role != \"worker\") {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tp, err := NewProviders(environment, mode, s.ExternalConcurrency, s.Timeout(), Scenario{})\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tr := &Runtime{settings: s, environment: environment, mode: mode, Ports: p}\n\tif s.MySQL.Enabled {\n\t\tr.sql, err = openMySQL(s, role)\n\t\tif err != nil {\n\t\t\tr.Close()\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tif s.Redis.Enabled {\n\t\tr.redis, err = openRedis(s, role)\n\t\tif err != nil {\n\t\t\tr.Close()\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tr.snapshot = r.newSnapshot()\n\treturn r, nil\n}\nfunc (r *Runtime) newSnapshot() Snapshot {\n\tscope := \"infrastructure_only\"\n\tif r.Messages != nil {\n\t\tscope = \"business_dependencies\"\n\t}\n\treturn Snapshot{BusinessEnabled: r.Messages != nil && r.OperationsReady(), Stage: \"S23\", Scope: scope, ProviderMode: r.mode, Simulated: r.mode == \"fake\", MySQL: DependencyState{State: \"disabled\", Required: true}, Redis: DependencyState{State: \"disabled\", Required: false}}\n}\n\n// Projection enables internal order membership only. No public messages/routes.\nfunc (r *Runtime) EnableConversations(c conversation.Config) error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar err error\n\tr.Conversations, err = conversation.NewStore(r.sql, r.environment, r.settings.Timeout())\n\tif err == nil {\n\t\tr.Ports.Policy = r.Conversations\n\t}\n\treturn err\n}\n\n// Safety is independent from the still-closed message release gate.\nfunc (r *Runtime) EnableSafety(c moderation.Config) error {\n\tif c.Validate() != nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil || r.Conversations == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tservice, err := moderation.New(r.sql, r.environment, c, min(r.settings.ExternalConcurrency, 16), min(r.settings.Timeout(), 2*time.Second), nil)\n\tif err == nil {\n\t\tr.Moderation = service\n\t\tr.Ports.Safety = service\n\t}\n\treturn err\n}\nfunc (r *Runtime) Refresh(ctx context.Context) Snapshot {\n\ts := r.newSnapshot()\n\ts.CheckedAt = time.Now().UTC()\n\tif r.sql != nil {\n\t\tprobe, cancel := context.WithTimeout(ctx, r.settings.Timeout())\n\t\terr := checkMySQL(probe, r.sql, r.settings.MySQL.Database, r.environment)\n\t\tcancel()\n\t\ts.MySQL = state(err, true)\n\t\ts.InfrastructureReady = err == nil\n\t}\n\tif r.redis != nil {\n\t\tprobe, cancel := context.WithTimeout(ctx, r.settings.Timeout())\n\t\terr := r.redis.Ping(probe).Err()\n\t\tcancel()\n\t\ts.Redis = state(err, false)\n\t}\n\tif !r.OperationsReady() {\n\t\ts.InfrastructureReady = false\n\t}\n\tr.mu.Lock()\n\tif !r.stopping {\n\t\tr.snapshot = s\n\t}\n\tr.mu.Unlock()\n\treturn r.Snapshot()\n}\nfunc state(err error, required bool) DependencyState {\n\tif err == nil {\n\t\treturn DependencyState{State: \"ready\", Required: required}\n\t}\n\tcode := \"CHAT_DEPENDENCY_UNAVAILABLE\"\n\tif err == ports.ErrInvalid {\n\t\tcode = \"CHAT_DATABASE_CONTRACT_INVALID\"\n\t}\n\treturn DependencyState{State: \"unavailable\", Required: required, Code: code}\n}\nfunc (r *Runtime) Snapshot() Snapshot { r.mu.RLock(); defer r.mu.RUnlock(); return r.snapshot }\nfunc (r *Runtime) Monitor(ctx context.Context) {\n\tt := time.NewTicker(r.settings.Interval())\n\tdefer t.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-t.C:\n\t\t\tr.Refresh(ctx)\n\t\t}\n\t}\n}\nfunc (r *Runtime) Stop() {\n\tr.mu.Lock()\n\tdefer r.mu.Unlock()\n\tr.stopping = true\n\tr.snapshot.InfrastructureReady = false\n}\nfunc (r *Runtime) Close() {\n\tr.Stop()\n\tif r.Socket != nil {\n\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n\t\t_ = r.Socket.Shutdown(ctx)\n\t\tcancel()\n\t}\n\tif r.reminderTransport != nil {\n\t\tr.reminderTransport.Close()\n\t}\n\tif r.Moderation != nil {\n\t\tr.Moderation.Close()\n\t}\n\tif r.redis != nil {\n\t\t_ = r.redis.Close()\n\t}\n\tif r.sql != nil {\n\t\t_ = r.sql.Close()\n\t}\n}\n","chat/internal/dependencies/settings.go":"package dependencies\n\nimport (\n\t\"net\"\n\t\"os\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Settings struct {\n\tOperationTimeout    string        `json:\"operation_timeout\"`\n\tProbeInterval       string        `json:\"probe_interval\"`\n\tExternalConcurrency int           `json:\"external_concurrency\"`\n\tMySQL               MySQLSettings `json:\"mysql\"`\n\tRedis               RedisSettings `json:\"redis\"`\n}\ntype MySQLSettings struct {\n\tEnabled       bool   `json:\"enabled\"`\n\tAddress       string `json:\"address\"`\n\tDatabase      string `json:\"database\"`\n\tUsername      string `json:\"username\"`\n\tPasswordEnv   string `json:\"password_env\"`\n\tMaxOpenServe  int    `json:\"max_open_serve\"`\n\tMaxOpenWorker int    `json:\"max_open_worker\"`\n\tMaxIdle       int    `json:\"max_idle\"`\n}\ntype RedisSettings struct {\n\tEnabled     bool   `json:\"enabled\"`\n\tAddress     string `json:\"address\"`\n\tKeyPrefix   string `json:\"key_prefix\"`\n\tPasswordEnv string `json:\"password_env\"`\n\tPoolServe   int    `json:\"pool_serve\"`\n\tPoolWorker  int    `json:\"pool_worker\"`\n}\n\nfunc Defaults() Settings {\n\treturn Settings{OperationTimeout: \"500ms\", ProbeInterval: \"10s\", ExternalConcurrency: 4,\n\t\tMySQL: MySQLSettings{Address: \"127.0.0.1:3306\", PasswordEnv: \"CHAT_MYSQL_PASSWORD\", MaxOpenServe: 4, MaxOpenWorker: 2, MaxIdle: 1},\n\t\tRedis: RedisSettings{Address: \"127.0.0.1:6379\", PoolServe: 2, PoolWorker: 1}}\n}\n\nvar identifier = regexp.MustCompile(`^[a-zA-Z0-9_]{1,64}$`)\nvar secretName = regexp.MustCompile(`^CHAT_[A-Z0-9_]{1,60}$`)\n\nfunc (s Settings) Validate(environment string) error {\n\tif environment != \"development\" && environment != \"test\" && environment != \"production\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tt, e := time.ParseDuration(s.OperationTimeout)\n\ti, ie := time.ParseDuration(s.ProbeInterval)\n\tif e != nil || ie != nil || t < 50*time.Millisecond || t > 5*time.Second || i < time.Second || i > time.Minute || i < t || s.ExternalConcurrency < 1 || s.ExternalConcurrency > 32 {\n\t\treturn ports.ErrInvalid\n\t}\n\tm, r := s.MySQL, s.Redis\n\tif m.MaxOpenServe < 1 || m.MaxOpenWorker < 1 || m.MaxOpenServe+m.MaxOpenWorker > 32 || m.MaxIdle < 0 || m.MaxIdle > m.MaxOpenServe || m.MaxIdle > m.MaxOpenWorker {\n\t\treturn ports.ErrInvalid\n\t}\n\tif r.PoolServe < 1 || r.PoolWorker < 1 || r.PoolServe+r.PoolWorker > 16 {\n\t\treturn ports.ErrInvalid\n\t}\n\tif m.Enabled {\n\t\tprefix := map[string]string{\"development\": \"bixuan_dev_\", \"test\": \"bixuan_test_\"}[environment]\n\t\tif !loopback(m.Address) || !identifier.MatchString(m.Database) || !identifier.MatchString(m.Username) || len(m.Username) > 32 || !strings.HasPrefix(m.Username, \"bxchat_\"+environment+\"_\") || !secretName.MatchString(m.PasswordEnv) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tif prefix != \"\" && !strings.HasPrefix(m.Database, prefix) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tif environment == \"production\" && (strings.HasPrefix(m.Database, \"bixuan_dev_\") || strings.HasPrefix(m.Database, \"bixuan_test_\")) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t}\n\tif r.Enabled && (!loopback(r.Address) || r.KeyPrefix != \"bxchat:\"+environment+\":\" || (r.PasswordEnv != \"\" && !secretName.MatchString(r.PasswordEnv))) {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\nfunc loopback(address string) bool {\n\thost, p, e := net.SplitHostPort(address)\n\tn, ne := strconv.Atoi(p)\n\tip := net.ParseIP(host)\n\treturn e == nil && ne == nil && n > 0 && n <= 65535 && ip != nil && ip.IsLoopback()\n}\nfunc (s Settings) Timeout() time.Duration  { t, _ := time.ParseDuration(s.OperationTimeout); return t }\nfunc (s Settings) Interval() time.Duration { t, _ := time.ParseDuration(s.ProbeInterval); return t }\nfunc password(name string, required bool) (string, error) {\n\tif name == \"\" && !required {\n\t\treturn \"\", nil\n\t}\n\tvalue, ok := os.LookupEnv(name)\n\tif !ok || value == \"\" {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\treturn value, nil\n}\n","chat/internal/dependencies/socket.go":"package dependencies\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n)\n\nfunc (r *Runtime) EnableSocket(c socket.Config) error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.Identity == nil || r.redis == nil || r.sql == nil || r.mode != \"disabled\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar e error\n\tif r.Conversations != nil {\n\t\tr.Socket, e = socket.NewWithPolicy(r.Identity, guardedCommands{r, message.SocketCommands{Sender: r.Messages, History: r.History}}, guardedPolicy{r, r.Conversations})\n\t} else {\n\t\tr.Socket, e = socket.New(r.Identity, guardedCommands{r, message.SocketCommands{History: r.History}})\n\t}\n\treturn e\n}\n","chat/internal/imagepipeline/config.go":"package imagepipeline\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n)\n\ntype Config struct {\n\tEnabled        bool   `json:\"enabled\"`\n\tMode           string `json:\"mode\"`\n\tBucket         string `json:\"bucket\"`\n\tPrivate        bool   `json:\"private_bucket\"`\n\tAccessKeyEnv   string `json:\"access_key_env\"`\n\tSecretKeyEnv   string `json:\"secret_key_env\"`\n\tDownloadOrigin string `json:\"download_origin\"`\n\tUploadOrigin   string `json:\"upload_origin\"`\n\tPHP            string `json:\"php_binary\"`\n\tPython         string `json:\"python_binary\"`\n\tPHPScript      string `json:\"php_script\"`\n\tPythonScript   string `json:\"python_script\"`\n\tTempRoot       string `json:\"temp_root\"`\n\tMaxBytes       int    `json:\"max_file_bytes\"`\n\tMaxEdge        int    `json:\"max_long_edge_px\"`\n}\n\n// Build is used by explicit isolated composition roots. The application's\n// release gate still rejects images.enabled until S21/S22 deployment review.\nfunc Build(c Config, env string, base *message.Service) (*message.MediaService, error) {\n\tif !c.Enabled {\n\t\treturn nil, nil\n\t}\n\tnames := regexp.MustCompile(`^CHAT_[A-Z0-9_]{1,60}$`)\n\tif c.Mode != \"manual_precheck\" || !names.MatchString(c.AccessKeyEnv) || !names.MatchString(c.SecretKeyEnv) || !filepath.IsAbs(c.TempRoot) || c.MaxBytes < 10240 || c.MaxBytes > message.MaxImageBytes || c.MaxEdge < 800 || c.MaxEdge > 2400 {\n\t\treturn nil, message.ErrMedia\n\t}\n\tfor _, path := range []string{c.PHP, c.Python, c.PHPScript, c.PythonScript} {\n\t\tinfo, e := os.Stat(path)\n\t\tif !filepath.IsAbs(path) || e != nil || !info.Mode().IsRegular() {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t}\n\tinfo, e := os.Stat(c.TempRoot)\n\tif e != nil || !info.IsDir() {\n\t\treturn nil, message.ErrMedia\n\t}\n\tstorage, e := NewQiniu(QiniuConfig{Bucket: c.Bucket, AccessKey: os.Getenv(c.AccessKeyEnv), SecretKey: os.Getenv(c.SecretKeyEnv), Private: c.Private, DownloadOrigin: c.DownloadOrigin, UploadOrigin: c.UploadOrigin, Environment: env})\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\thelper := &Helper{PHP: c.PHP, Python: c.Python, PHPScript: c.PHPScript, PythonScript: c.PythonScript, TempRoot: c.TempRoot, MaxBytes: c.MaxBytes, MaxEdge: c.MaxEdge}\n\treturn message.NewMediaService(base, storage, helper, env)\n}\n","chat/internal/imagepipeline/helper.go":"// Package imagepipeline is an offline, bounded adapter to existing optimization\n// and local ZXing. It has no chat-table write authority or network OCR fallback.\npackage imagepipeline\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n)\n\ntype Helper struct {\n\tPHP, Python, PHPScript, PythonScript, TempRoot string\n\tMaxBytes, MaxEdge                              int\n}\ntype boundedOutput struct{ bytes.Buffer }\n\nfunc (b *boundedOutput) Write(p []byte) (int, error) {\n\tif b.Len()+len(p) > 8192 {\n\t\treturn 0, errors.New(\"helper output budget\")\n\t}\n\treturn b.Buffer.Write(p)\n}\nfunc (h *Helper) command(ctx context.Context, name string, args ...string) ([]byte, error) {\n\tif !filepath.IsAbs(name) {\n\t\treturn nil, message.ErrMedia\n\t}\n\tcmd := exec.CommandContext(ctx, name, args...)\n\tcmd.WaitDelay = time.Second\n\tcmd.Env = []string{\"PATH=\" + os.Getenv(\"PATH\"), \"LANG=C.UTF-8\", \"PYTHONNOUSERSITE=1\", \"OMP_NUM_THREADS=1\", \"OPENBLAS_NUM_THREADS=1\", \"CHAT_IMAGE_EDGE=\" + itoa(h.MaxEdge), \"CHAT_IMAGE_BYTES=\" + itoa(h.MaxBytes)}\n\tvar out boundedOutput\n\tcmd.Stdout = &out\n\tcmd.Stderr = io.Discard\n\tif cmd.Run() != nil {\n\t\treturn nil, message.ErrCheck\n\t}\n\treturn out.Bytes(), nil\n}\nfunc itoa(n int) string { b, _ := json.Marshal(n); return string(b) }\nfunc (h *Helper) Process(ctx context.Context, raw []byte) (message.ProcessedImage, error) {\n\tvar result message.ProcessedImage\n\tif len(raw) < 1 || len(raw) > message.MaxImageBytes || h.MaxBytes < 10240 || h.MaxBytes > message.MaxImageBytes || h.MaxEdge < 800 || h.MaxEdge > 2400 || !filepath.IsAbs(h.PHPScript) || !filepath.IsAbs(h.PythonScript) {\n\t\treturn result, message.ErrMedia\n\t}\n\tctx, cancel := context.WithTimeout(ctx, 45*time.Second)\n\tdefer cancel()\n\tjob, e := os.MkdirTemp(h.TempRoot, \"bxchat-image-\")\n\tif e != nil {\n\t\treturn result, message.ErrCheck\n\t}\n\tdefer os.RemoveAll(job)\n\tif e = os.WriteFile(filepath.Join(job, \"source\"), raw, 0600); e != nil {\n\t\treturn result, message.ErrCheck\n\t}\n\tsanitized, e := h.command(ctx, h.Python, h.PythonScript, \"sanitize\", job)\n\tif e != nil {\n\t\treturn result, e\n\t}\n\tvar sourceInfo struct {\n\t\tOrientation bool `json:\"orientation_normalized\"`\n\t}\n\tif json.Unmarshal(sanitized, &sourceInfo) != nil {\n\t\treturn result, message.ErrCheck\n\t}\n\toptimized, e := h.command(ctx, h.PHP, \"-d\", \"memory_limit=256M\", \"-d\", \"max_execution_time=20\", h.PHPScript, job)\n\tif e != nil {\n\t\treturn result, e\n\t}\n\tvar optimization struct{ Method string }\n\tif json.Unmarshal(optimized, &optimization) != nil || optimization.Method == \"\" {\n\t\treturn result, message.ErrCheck\n\t}\n\tinspected, e := h.command(ctx, h.Python, h.PythonScript, \"inspect\", job)\n\tif e != nil {\n\t\treturn result, e\n\t}\n\tvar info struct {\n\t\tMIME       string `json:\"mime\"`\n\t\tWidth      int    `json:\"width\"`\n\t\tHeight     int    `json:\"height\"`\n\t\tQRStatus   string `json:\"qr_status\"`\n\t\tQRDecision string `json:\"qr_decision\"`\n\t\tQRVersion  string `json:\"qr_version\"`\n\t\tOCRStatus  string `json:\"ocr_status\"`\n\t}\n\tif json.Unmarshal(inspected, &info) != nil {\n\t\treturn result, message.ErrCheck\n\t}\n\tfor _, name := range []string{\"main\", \"thumb\"} {\n\t\tp := filepath.Join(job, name)\n\t\tstat, err := os.Lstat(p)\n\t\tif err != nil || !stat.Mode().IsRegular() || stat.Size() > message.MaxImageBytes {\n\t\t\treturn result, message.ErrMedia\n\t\t}\n\t\tb, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn result, message.ErrMedia\n\t\t}\n\t\tif name == \"main\" {\n\t\t\tresult.Main = b\n\t\t} else {\n\t\t\tresult.Thumb = b\n\t\t}\n\t}\n\tresult.MIME = info.MIME\n\tresult.Width = info.Width\n\tresult.Height = info.Height\n\tresult.Method = optimization.Method\n\tif sourceInfo.Orientation {\n\t\tresult.Method = \"orientation-normalized-\" + result.Method\n\t}\n\tresult.QRStatus = info.QRStatus\n\tresult.QRDecision = info.QRDecision\n\tresult.QRVersion = info.QRVersion\n\tresult.OCRStatus = info.OCRStatus\n\treturn result, nil\n}\n","chat/internal/imagepipeline/helper_test.go":"package imagepipeline\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"image\"\n\t\"image/color\"\n\t\"image/png\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc helperFixture(t *testing.T) *Helper {\n\tt.Helper()\n\tif os.Getenv(\"CHAT_IMAGE_HELPER_TEST\") != \"1\" {\n\t\tt.Skip(\"explicit offline helper fixture\")\n\t}\n\tphp, e := exec.LookPath(\"php\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpython, e := exec.LookPath(\"python3\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ta, _ := filepath.Abs(\"../../../server/bin/chat-images.php\")\n\tb, _ := filepath.Abs(\"../../helpers/images/inspect.py\")\n\treturn &Helper{PHP: php, Python: python, PHPScript: a, PythonScript: b, TempRoot: t.TempDir(), MaxBytes: 1048576, MaxEdge: 1600}\n}\nfunc TestOfflineImagePipelineAndBudgets(t *testing.T) {\n\th := helperFixture(t)\n\tim := image.NewRGBA(image.Rect(0, 0, 800, 600))\n\tfor y := 0; y < 600; y++ {\n\t\tfor x := 0; x < 800; x++ {\n\t\t\tim.Set(x, y, color.RGBA{byte(x % 200), byte(y % 200), 150, 255})\n\t\t}\n\t}\n\tvar b bytes.Buffer\n\tpng.Encode(&b, im)\n\tout, e := h.Process(context.Background(), b.Bytes())\n\tif e != nil || out.QRStatus != \"completed\" || out.QRDecision != \"clear\" || out.OCRStatus != \"not_run\" || out.Width != 800 {\n\t\tt.Fatalf(\"real pipeline %+v %v\", out, e)\n\t}\n\tif _, e = h.Process(context.Background(), []byte(\"not an image\")); e == nil {\n\t\tt.Fatal(\"invalid bytes\")\n\t}\n\tctx, cancel := context.WithCancel(context.Background())\n\tcancel()\n\tif _, e = h.Process(ctx, b.Bytes()); e == nil {\n\t\tt.Fatal(\"cancel ignored\")\n\t}\n\tentries, _ := os.ReadDir(h.TempRoot)\n\tif len(entries) != 0 {\n\t\tt.Fatal(\"temporary files retained\")\n\t}\n\tt.Logf(\"offline processed main=%d thumb=%d method=%s QR=%s\", len(out.Main), len(out.Thumb), out.Method, out.QRVersion)\n}\nfunc TestOfflineQRClassificationMetadataAndNoCloud(t *testing.T) {\n\th := helperFixture(t)\n\tscript := `import io,sys,zxingcpp\nfrom PIL import Image\nim=Image.fromarray(zxingcpp.create_barcode(sys.argv[1],zxingcpp.BarcodeFormat.QRCode).to_image(scale=8))\nim.save(sys.stdout.buffer,format=\"PNG\")`\n\t// ZXing image implements the buffer protocol; Pillow can wrap via frombytes\n\t// without numpy, which is deliberately absent from the pinned dependency set.\n\n\tfor _, v := range []struct{ text, want string }{{\"weixin://private-friend\", \"blocked\"}, {\"wxp://private-payment\", \"blocked\"}, {\"6901234567890\", \"clear\"}, {\"https://materials.example.invalid/batch/123\", \"review\"}} {\n\t\traw, e := exec.Command(h.Python, \"-c\", script, v.text).Output()\n\t\tif e != nil {\n\t\t\tt.Fatal(\"QR fixture\", e)\n\t\t}\n\t\tout, e := h.Process(context.Background(), raw)\n\t\tif e != nil || out.QRDecision != v.want {\n\t\t\tt.Fatalf(\"QR %s => %s %v\", v.text, out.QRDecision, e)\n\t\t}\n\t}\n\t// EXIF description/GPS-related container is stripped without re-encoding JPEG.\n\tscript = `import sys\nfrom PIL import Image\nim=Image.new(\"RGB\",(640,480),\"white\")\nexif=Image.Exif();exif[270]=\"private location\"\nim.save(sys.stdout.buffer,format=\"JPEG\",exif=exif)`\n\traw, e := exec.Command(h.Python, \"-c\", script).Output()\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tstart := time.Now()\n\tout, e := h.Process(context.Background(), raw)\n\tif e != nil || bytes.Contains(out.Main, []byte(\"private location\")) || bytes.Contains(out.Main, []byte(\"Exif\")) {\n\t\tt.Fatal(\"metadata retained\", e)\n\t}\n\tt.Logf(\"metadata/QR full pipeline duration=%s\", time.Since(start))\n}\nfunc TestQiniuPrivateKeyPolicy(t *testing.T) {\n\tconfig := QiniuConfig{Private: true, Bucket: \"fixture-bucket\", AccessKey: \"fixture-ak\", SecretKey: \"fixture-sk\", Environment: \"test\", DownloadOrigin: \"https://private.example.invalid\", UploadOrigin: \"https://up-z2.qiniup.com\"}\n\tq, e := NewQiniu(config)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tkey := \"chat/test/123/\" + strings.Repeat(\"a\", 64) + \"/source\"\n\ttoken, _, e := q.Grant(context.Background(), key, 123)\n\tif e != nil || token == \"\" {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = q.Sign(context.Background(), key, 61*time.Second); e == nil {\n\t\tt.Fatal(\"long URL\")\n\t}\n\tfor _, key := range []string{\"https://localhost/a\", \"chat/production/123/\" + strings.Repeat(\"a\", 64) + \"/source\", \"../../etc/passwd\"} {\n\t\tif _, _, e = q.Grant(context.Background(), key, 123); e == nil {\n\t\t\tt.Fatal(\"foreign key\")\n\t\t}\n\t}\n\tconfig.Private = false\n\tif _, e = NewQiniu(config); e == nil {\n\t\tt.Fatal(\"public bucket\")\n\t}\n\tconfig.Private = true\n\tconfig.DownloadOrigin = \"https://127.0.0.1\"\n\tif _, e = NewQiniu(config); e == nil {\n\t\tt.Fatal(\"private URL\")\n\t}\n}\n\nfunc TestOfflineImageOrientationBeforeMetadataRemoval(t *testing.T) {\n\th := helperFixture(t)\n\tscript := `import sys\nfrom PIL import Image\nim=Image.new(\"RGB\",(640,480),\"white\")\nexif=Image.Exif();exif[274]=6;exif[270]=\"private location\"\nim.save(sys.stdout.buffer,format=\"JPEG\",exif=exif)`\n\traw, e := exec.Command(h.Python, \"-c\", script).Output()\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tout, e := h.Process(context.Background(), raw)\n\tif e != nil || out.Width != 480 || out.Height != 640 || !strings.HasPrefix(out.Method, \"orientation-normalized-\") || bytes.Contains(out.Main, []byte(\"Exif\")) {\n\t\tt.Fatalf(\"orientation/metadata width=%d height=%d method=%s error=%v\", out.Width, out.Height, out.Method, e)\n\t}\n}\n","chat/internal/imagepipeline/qiniu.go":"package imagepipeline\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/hmac\"\n\t\"crypto/sha1\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"mime/multipart\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n)\n\ntype QiniuConfig struct {\n\tBucket, AccessKey, SecretKey, DownloadOrigin, UploadOrigin, Environment string\n\tPrivate                                                                 bool\n}\ntype Qiniu struct {\n\tconfig QiniuConfig\n\tclient *http.Client\n}\n\nvar objectKey = regexp.MustCompile(`^chat/(test|development|production)/[1-9][0-9]{0,19}/[0-9a-f]{64}/(source|[0-9a-f]{64}/(main|thumb))$`)\n\nfunc publicImageOrigin(raw string) bool {\n\tu, e := url.Parse(raw)\n\treturn e == nil && u.Scheme == \"https\" && u.Hostname() != \"\" && net.ParseIP(u.Hostname()) == nil && u.User == nil && u.RawQuery == \"\" && u.Fragment == \"\" && (u.Path == \"\" || u.Path == \"/\") && (u.Port() == \"\" || u.Port() == \"443\")\n}\nfunc NewQiniu(c QiniuConfig) (*Qiniu, error) {\n\tupload, e := url.Parse(c.UploadOrigin)\n\tif !c.Private || !publicImageOrigin(c.DownloadOrigin) || !publicImageOrigin(c.UploadOrigin) || e != nil ||\n\t\t!(strings.HasSuffix(upload.Hostname(), \".qiniup.com\") || strings.HasSuffix(upload.Hostname(), \".qiniu.com\")) ||\n\t\t!regexp.MustCompile(`^[A-Za-z0-9_-]{1,63}$`).MatchString(c.Bucket) || c.AccessKey == \"\" || c.SecretKey == \"\" ||\n\t\t(c.Environment != \"production\" && c.Environment != \"development\" && c.Environment != \"test\") {\n\t\treturn nil, message.ErrMedia\n\t}\n\tdialer := &net.Dialer{Timeout: 5 * time.Second}\n\ttransport := &http.Transport{Proxy: nil, MaxIdleConns: 2, MaxConnsPerHost: 2, IdleConnTimeout: 30 * time.Second, TLSHandshakeTimeout: 5 * time.Second, ResponseHeaderTimeout: 10 * time.Second}\n\ttransport.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {\n\t\thost, port, e := net.SplitHostPort(address)\n\t\tif e != nil {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t\taddresses, e := net.DefaultResolver.LookupIPAddr(ctx, host)\n\t\tif e != nil || len(addresses) == 0 {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t\tfor _, ip := range addresses {\n\t\t\tif !ip.IP.IsGlobalUnicast() || ip.IP.IsPrivate() || ip.IP.IsLoopback() || ip.IP.IsLinkLocalUnicast() {\n\t\t\t\treturn nil, message.ErrMedia\n\t\t\t}\n\t\t}\n\t\treturn dialer.DialContext(ctx, network, net.JoinHostPort(addresses[0].IP.String(), port))\n\t}\n\treturn &Qiniu{c, &http.Client{Timeout: 20 * time.Second, Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return message.ErrMedia }}}, nil\n}\nfunc b64(b []byte) string { return base64.URLEncoding.EncodeToString(b) }\nfunc (q *Qiniu) signature(s string) string {\n\th := hmac.New(sha1.New, []byte(q.config.SecretKey))\n\th.Write([]byte(s))\n\treturn b64(h.Sum(nil))\n}\nfunc (q *Qiniu) valid(key string) bool {\n\treturn objectKey.MatchString(key) && strings.HasPrefix(key, \"chat/\"+q.config.Environment+\"/\") || avObjectKey.MatchString(key) && strings.HasPrefix(key, \"chatav/\"+q.config.Environment+\"/\")\n}\nfunc (q *Qiniu) Grant(ctx context.Context, key string, size int64) (string, string, error) {\n\tif !objectKey.MatchString(key) || !q.valid(key) || size < 1 || size > message.MaxImageBytes {\n\t\treturn \"\", \"\", message.ErrMedia\n\t}\n\tpolicy, _ := json.Marshal(map[string]any{\"scope\": q.config.Bucket + \":\" + key, \"deadline\": time.Now().Add(5 * time.Minute).Unix(), \"insertOnly\": 1, \"fsizeMin\": size, \"fsizeLimit\": size, \"detectMime\": 1, \"mimeLimit\": \"image/jpeg;image/png;image/webp\"})\n\tencoded := b64(policy)\n\treturn q.config.AccessKey + \":\" + q.signature(encoded) + \":\" + encoded, q.config.UploadOrigin, nil\n}\nfunc (q *Qiniu) Sign(ctx context.Context, key string, ttl time.Duration) (string, error) {\n\tif !q.valid(key) || ttl <= 0 || ttl > 60*time.Second {\n\t\treturn \"\", message.ErrMedia\n\t}\n\tu := strings.TrimRight(q.config.DownloadOrigin, \"/\") + \"/\" + key + \"?e=\" + itoa(int(time.Now().Add(ttl).Unix()))\n\treturn u + \"&token=\" + q.config.AccessKey + \":\" + q.signature(u), nil\n}\nfunc (q *Qiniu) Read(ctx context.Context, key string, limit int64) ([]byte, error) {\n\tif limit < 1 || limit > message.MaxVideoBytes {\n\t\treturn nil, message.ErrMedia\n\t}\n\tu, e := q.Sign(ctx, key, 60*time.Second)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\treq, _ := http.NewRequestWithContext(ctx, \"GET\", u, nil)\n\tres, e := q.client.Do(req)\n\tif e != nil {\n\t\treturn nil, message.ErrMedia\n\t}\n\tdefer res.Body.Close()\n\tif res.StatusCode != 200 || res.ContentLength > limit {\n\t\treturn nil, message.ErrMedia\n\t}\n\tb, e := io.ReadAll(io.LimitReader(res.Body, limit+1))\n\tif e != nil || int64(len(b)) > limit || len(b) == 0 {\n\t\treturn nil, message.ErrMedia\n\t}\n\treturn b, nil\n}\nfunc (q *Qiniu) Put(ctx context.Context, key string, b []byte, mime string) error {\n\ttoken, host, e := q.Grant(ctx, key, int64(len(b)))\n\tif e != nil {\n\t\treturn e\n\t}\n\treturn q.putForm(ctx, key, b, token, host, \"image\")\n}\nfunc (q *Qiniu) putForm(ctx context.Context, key string, b []byte, token, host, filename string) error {\n\tvar body bytes.Buffer\n\twriter := multipart.NewWriter(&body)\n\twriter.WriteField(\"token\", token)\n\twriter.WriteField(\"key\", key)\n\tpart, e := writer.CreateFormFile(\"file\", filename)\n\tif e != nil {\n\t\treturn message.ErrMedia\n\t}\n\tpart.Write(b)\n\twriter.Close()\n\treq, _ := http.NewRequestWithContext(ctx, \"POST\", host, &body)\n\treq.Header.Set(\"Content-Type\", writer.FormDataContentType())\n\tres, e := q.client.Do(req)\n\tif e != nil {\n\t\treturn message.ErrMedia\n\t}\n\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\tres.Body.Close()\n\tif res.StatusCode < 200 || res.StatusCode >= 300 {\n\t\t// insertOnly may report an existing object on retry. It is reusable only\n\t\t// after byte-for-byte verification, never by trusting provider etag.\n\t\texisting, err := q.Read(ctx, key, int64(len(b)))\n\t\tif err != nil || !bytes.Equal(existing, b) {\n\t\t\treturn message.ErrMedia\n\t\t}\n\t}\n\treturn nil\n}\nfunc (q *Qiniu) Delete(ctx context.Context, key string) error {\n\tif !q.valid(key) {\n\t\treturn message.ErrMedia\n\t}\n\tpath := \"/delete/\" + b64([]byte(q.config.Bucket+\":\"+key))\n\treq, _ := http.NewRequestWithContext(ctx, \"POST\", \"https://rs.qiniuapi.com\"+path, nil)\n\treq.Header.Set(\"Authorization\", \"QBox \"+q.config.AccessKey+\":\"+q.signature(path+\"\\n\"))\n\treq.Header.Set(\"Content-Type\", \"application/x-www-form-urlencoded\")\n\tres, e := q.client.Do(req)\n\tif e != nil {\n\t\treturn message.ErrMedia\n\t}\n\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\tres.Body.Close()\n\tif res.StatusCode >= 200 && res.StatusCode < 300 || res.StatusCode == 612 {\n\t\treturn nil\n\t}\n\treturn message.ErrMedia\n}\n","chat/internal/imagepipeline/qiniu_av.go":"package imagepipeline\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"io\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n)\n\nvar avObjectKey = regexp.MustCompile(`^chatav/(test|development|production)/[1-9][0-9]{0,19}/[0-9a-f]{64}/(part-[1-9][0-9]?|[0-9a-f]{64}/(main|poster|check-0|check-1|frame-[0-7]))$`)\n\nfunc (q *Qiniu) avKey(key string) bool { return avObjectKey.MatchString(key) && q.valid(key) }\nfunc (q *Qiniu) avGrant(key string, size int64, mime string, temporaryDays int) (string, string, error) {\n\tif !q.avKey(key) || size < 1 || size > message.MaxVideoBytes {\n\t\treturn \"\", \"\", message.ErrMedia\n\t}\n\tpolicy := map[string]any{\"scope\": q.config.Bucket + \":\" + key, \"deadline\": time.Now().Add(5 * time.Minute).Unix(), \"insertOnly\": 1, \"fsizeMin\": size, \"fsizeLimit\": size}\n\tif mime != \"\" {\n\t\tpolicy[\"detectMime\"] = 1\n\t\tpolicy[\"mimeLimit\"] = mime\n\t}\n\tif temporaryDays > 0 {\n\t\tpolicy[\"deleteAfterDays\"] = temporaryDays\n\t}\n\traw, _ := json.Marshal(policy)\n\tencoded := b64(raw)\n\treturn q.config.AccessKey + \":\" + q.signature(encoded) + \":\" + encoded, q.config.UploadOrigin, nil\n}\nfunc (q *Qiniu) GrantAVPart(ctx context.Context, key string, size int64) (string, string, error) {\n\tif !q.avKey(key) || !strings.Contains(key, \"/part-\") || size > 4<<20 {\n\t\treturn \"\", \"\", message.ErrMedia\n\t}\n\treturn q.avGrant(key, size, \"\", 1)\n}\nfunc (q *Qiniu) PutAV(ctx context.Context, key string, body []byte, mime string) error {\n\tlimit := int64(0)\n\tswitch mime {\n\tcase \"video/mp4\":\n\t\tlimit = message.MaxVideoBytes\n\tcase \"audio/mpeg\":\n\t\tlimit = message.MaxVoiceBytes\n\tcase \"image/jpeg\":\n\t\tlimit = 65536\n\t}\n\tif !q.avKey(key) || strings.Contains(key, \"/part-\") || limit == 0 || int64(len(body)) > limit {\n\t\treturn message.ErrMedia\n\t}\n\ttemporary := 0\n\tif strings.HasSuffix(key, \"/check-0\") || strings.HasSuffix(key, \"/check-1\") {\n\t\ttemporary = 1\n\t}\n\ttoken, host, e := q.avGrant(key, int64(len(body)), mime, temporary)\n\tif e != nil {\n\t\treturn e\n\t}\n\tif e = q.putForm(ctx, key, body, token, host, \"media\"); e != nil {\n\t\treturn e\n\t}\n\tif temporary == 0 {\n\t\treturn q.Keep(ctx, key)\n\t}\n\treturn nil\n}\nfunc (q *Qiniu) StatAV(ctx context.Context, key string) (int64, error) {\n\tif !q.avKey(key) {\n\t\treturn 0, message.ErrMedia\n\t}\n\tres, e := q.manage(ctx, \"/stat/\"+b64([]byte(q.config.Bucket+\":\"+key)))\n\tif e != nil {\n\t\treturn 0, e\n\t}\n\tdefer res.Body.Close()\n\traw, e := io.ReadAll(io.LimitReader(res.Body, 8193))\n\tif e != nil || len(raw) > 8192 {\n\t\treturn 0, message.ErrMedia\n\t}\n\tvar result struct {\n\t\tSize *int64 `json:\"fsize\"`\n\t}\n\tif json.Unmarshal(raw, &result) != nil || result.Size == nil || *result.Size < 1 || *result.Size > message.MaxVideoBytes {\n\t\treturn 0, message.ErrMedia\n\t}\n\treturn *result.Size, nil\n}\nfunc (q *Qiniu) InspectionURL(ctx context.Context, key string) (string, error) {\n\tif !q.avKey(key) || strings.Contains(key, \"/part-\") || strings.HasSuffix(key, \"/poster\") {\n\t\treturn \"\", message.ErrMedia\n\t}\n\tu := strings.TrimRight(q.config.DownloadOrigin, \"/\") + \"/\" + key + \"?e=\" + itoa(int(time.Now().Add(5*time.Minute).Unix()))\n\treturn u + \"&token=\" + q.config.AccessKey + \":\" + q.signature(u), nil\n}\n","chat/internal/imagepipeline/qiniu_lifecycle.go":"package imagepipeline\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"net/http\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n)\n\n// Management requests use Qiniu v2 canonical signing; only validated object\n// keys from the configured private bucket may reach the fixed HTTPS endpoint.\nfunc (q *Qiniu) manage(ctx context.Context, path string) (*http.Response, error) {\n\treq, e := http.NewRequestWithContext(ctx, \"POST\", \"https://rs.qiniuapi.com\"+path, nil)\n\tif e != nil {\n\t\treturn nil, message.ErrMedia\n\t}\n\treq.Header.Set(\"Content-Type\", \"application/x-www-form-urlencoded\")\n\tcanonical := \"POST \" + req.URL.Path + \"\\nHost: \" + req.Host + \"\\nContent-Type: application/x-www-form-urlencoded\\n\\n\"\n\treq.Header.Set(\"Authorization\", \"Qiniu \"+q.config.AccessKey+\":\"+q.signature(canonical))\n\tres, e := q.client.Do(req)\n\tif e != nil {\n\t\treturn nil, message.ErrMedia\n\t}\n\tif res.StatusCode == 612 {\n\t\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\t\tres.Body.Close()\n\t\treturn nil, message.ErrObjectMissing\n\t}\n\tif res.StatusCode < 200 || res.StatusCode >= 300 {\n\t\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\t\tres.Body.Close()\n\t\treturn nil, message.ErrMedia\n\t}\n\treturn res, nil\n}\nfunc (q *Qiniu) Keep(ctx context.Context, key string) error {\n\tif !q.valid(key) {\n\t\treturn message.ErrMedia\n\t}\n\tres, e := q.manage(ctx, \"/deleteAfterDays/\"+b64([]byte(q.config.Bucket+\":\"+key))+\"/0\")\n\tif e != nil {\n\t\treturn e\n\t}\n\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\tres.Body.Close()\n\treturn nil\n}\nfunc (q *Qiniu) LowFrequency(ctx context.Context, key string) error {\n\tif !q.valid(key) || strings.HasSuffix(key, \"/source\") || strings.Contains(key, \"/part-\") || strings.Contains(key, \"/check-\") {\n\t\treturn message.ErrMedia\n\t}\n\tres, e := q.manage(ctx, \"/chtype/\"+b64([]byte(q.config.Bucket+\":\"+key))+\"/type/\"+strconv.Itoa(1))\n\tif e != nil {\n\t\treturn e\n\t}\n\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\tres.Body.Close()\n\treturn nil\n}\n","chat/internal/message/audit_history.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Audit history has its own scope and cursor namespace. It never invokes\n// member bootstrap, read acknowledgements, presence or personal preferences.\nfunc (g *GovernanceService) AuditHistory(ctx context.Context, p ports.Principal, q HistoryRequest) (HistoryPage, error) {\n\tif !validID(q.ConversationID) || q.Limit < 0 || q.Limit > 50 || q.TargetID != \"\" && !validID(q.TargetID) || q.TargetID != \"\" && q.Cursor != \"\" {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, g.base.timeout)\n\tdefer cancel()\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tvar seq, change, floor uint64\n\tvar version ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq,sync_floor_seq,CAST(policy_version AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`, string(q.ConversationID)).Scan(&seq, &change, &floor, &version) != nil {\n\t\treturn HistoryPage{}, ErrResync\n\t}\n\tc := historyCursor{Schema: 1, Mode: \"audit.history\", Binding: bindingFor(g.environment, p), Conversation: q.ConversationID, Policy: version, Member: \"audit\", Seq: decimal(seq), Change: decimal(change), Position: decimal(seq), Issued: time.Now().Unix(), Expiry: time.Now().Add(cursorTTL).Unix()}\n\tif q.Cursor != \"\" {\n\t\tc, err = g.history.parse(q.Cursor, \"audit.history\")\n\t\tif err != nil || c.Binding != bindingFor(g.environment, p) || c.Conversation != q.ConversationID || number(c.Seq) > seq || number(c.Position) < floor {\n\t\t\treturn HistoryPage{}, ErrResync\n\t\t}\n\t}\n\tlimit := q.Limit\n\tif limit == 0 {\n\t\tlimit = 30\n\t}\n\tout := HistoryPage{MemberRole: \"audit\", CanSend: false, ViewerID: p.ActorID, Messages: []MessageView{}, Changes: []ChangeView{}, PolicyVersion: version, SnapshotMaxSeq: c.Seq, SnapshotMaxChange: c.Change, ExpiresAt: c.Expiry}\n\tquery := `SELECT ` + viewColumns + `,1 FROM chat_messages m WHERE m.conversation_id=? AND m.seq>? AND m.seq<=? AND m.seq<=? ORDER BY m.seq DESC LIMIT ?`\n\tpos := number(c.Position)\n\tif q.TargetID != \"\" {\n\t\tvar target uint64\n\t\tif tx.QueryRowContext(ctx, `SELECT seq FROM chat_messages WHERE conversation_id=? AND id=? AND seq>? AND seq<=?`, string(q.ConversationID), string(q.TargetID), floor, seq).Scan(&target) != nil {\n\t\t\treturn HistoryPage{}, ErrResync\n\t\t}\n\t\tpos = target + uint64(limit/2)\n\t\tif pos > seq {\n\t\t\tpos = seq\n\t\t}\n\t}\n\trows, err := tx.QueryContext(ctx, query, string(q.ConversationID), floor, string(c.Seq), pos, limit+1)\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tfor rows.Next() {\n\t\tv, e := scanCandidate(rows, false)\n\t\tif e != nil {\n\t\t\trows.Close()\n\t\t\treturn out, e\n\t\t}\n\t\tout.Messages = append(out.Messages, v.view)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif len(out.Messages) > limit {\n\t\tout.HasMore = true\n\t\tout.Messages = out.Messages[:limit]\n\t\tc.Position = decimal(number(out.Messages[len(out.Messages)-1].Seq) - 1)\n\t\tout.HistoryCursor = g.history.sign(c)\n\t}\n\tfor i, j := 0, len(out.Messages)-1; i < j; i, j = i+1, j-1 {\n\t\tout.Messages[i], out.Messages[j] = out.Messages[j], out.Messages[i]\n\t}\n\tviews := make([]*MessageView, 0, len(out.Messages))\n\tfor i := range out.Messages {\n\t\tviews = append(views, &out.Messages[i])\n\t}\n\tif err = hydrateAV(ctx, tx, p, views); err != nil {\n\t\treturn out, err\n\t}\n\tif err = hydrateImages(ctx, tx, views); err != nil {\n\t\treturn out, err\n\t}\n\tif err = hydrateReferenceScope(ctx, tx, p, ports.Grant{}, q.ConversationID, views, true); err != nil {\n\t\treturn out, err\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.history\", q.ConversationID, q.TargetID, \"\", version, \"\"); err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) AuditImage(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, thumb bool) (string, error) {\n\tif g.media == nil || !validID(cid) || !validID(mid) || !validID(item) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn \"\", err\n\t}\n\tvar id ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`, string(cid)).Scan(&id) != nil {\n\t\treturn \"\", ErrResync\n\t}\n\tcol := \"u.main_key\"\n\tif thumb {\n\t\tcol = \"u.thumb_key\"\n\t}\n\tvar key string\n\tvar expiry sql.NullTime\n\tvar version ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT `+col+`,m.expires_at,CAST(m.state_version AS CHAR) FROM chat_messages m JOIN chat_image_items i ON i.message_id=m.id JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE m.conversation_id=? AND m.id=? AND i.item_id=? AND m.state='published' AND `+retainedTarget, string(cid), string(mid), string(item)).Scan(&key, &expiry, &version) != nil || key == \"\" {\n\t\treturn \"\", ErrMedia\n\t}\n\tttl := mediaReadTTL(p, expiry)\n\tif ttl <= 0 {\n\t\treturn \"\", ErrMedia\n\t}\n\turl, err := g.media.storage.Sign(ctx, key, ttl)\n\tif err != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.image\", cid, mid, item, version, \"\"); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn url, nil\n}\n","chat/internal/message/audit_list.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc (g *GovernanceService) encodeAuditCursor(p ports.Principal, c auditCursor) (string, error) {\n\ta, err := g.history.digestAEAD()\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\traw, _ := json.Marshal(c)\n\tnonce := make([]byte, a.NonceSize())\n\tif _, err = rand.Read(nonce); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn base64.RawURLEncoding.EncodeToString(append(nonce, a.Seal(nil, nonce, raw, []byte(\"audit:\"+bindingFor(g.environment, p)))...)), nil\n}\nfunc (g *GovernanceService) decodeAuditCursor(token string, p ports.Principal, c *auditCursor) error {\n\tif len(token) > 1024 {\n\t\treturn ErrResync\n\t}\n\tb, err := base64.RawURLEncoding.Strict().DecodeString(token)\n\tif err != nil {\n\t\treturn ErrResync\n\t}\n\ta, err := g.history.digestAEAD()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif len(b) < a.NonceSize()+a.Overhead() {\n\t\treturn ErrResync\n\t}\n\traw, err := a.Open(nil, b[:a.NonceSize()], b[a.NonceSize():], []byte(\"audit:\"+bindingFor(g.environment, p)))\n\tif err != nil || json.Unmarshal(raw, c) != nil || len(c.Snapshot) != 64 || !validID(c.After) || c.At.IsZero() {\n\t\treturn ErrResync\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) auditListPage(ctx context.Context, tx *sql.Tx, p ports.Principal, token string, limit int, c auditCursor) (AuditList, error) {\n\tvar live bool\n\tif tx.QueryRowContext(ctx, `SELECT expires_at>UTC_TIMESTAMP(6) FROM chat_audit_snapshots WHERE id=? AND binding=? LOCK IN SHARE MODE`, c.Snapshot, bindingFor(g.environment, p)).Scan(&live) != nil || !live {\n\t\treturn AuditList{}, ErrResync\n\t}\n\tquery := `SELECT CAST(conversation_id AS CHAR),CAST(order_id AS CHAR),activity_at FROM chat_audit_snapshot_items WHERE snapshot_id=?`\n\targs := []any{c.Snapshot}\n\tif token != \"\" {\n\t\tquery += ` AND (activity_at<? OR (activity_at=? AND conversation_id<?))`\n\t\targs = append(args, c.At, c.At, string(c.After))\n\t}\n\tquery += ` ORDER BY activity_at DESC,conversation_id DESC LIMIT ?`\n\targs = append(args, limit+1)\n\trows, err := tx.QueryContext(ctx, query, args...)\n\tif err != nil {\n\t\treturn AuditList{}, ports.ErrUnavailable\n\t}\n\tout := AuditList{Items: []AuditConversation{}}\n\tfor rows.Next() {\n\t\tvar item AuditConversation\n\t\tif rows.Scan(&item.ID, &item.OrderID, &item.Activity) != nil {\n\t\t\trows.Close()\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tout.Items = append(out.Items, item)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn AuditList{}, ports.ErrUnavailable\n\t}\n\tif len(out.Items) > limit {\n\t\tout.More = true\n\t\tout.Items = out.Items[:limit]\n\t\tlast := out.Items[len(out.Items)-1]\n\t\tc.At = last.Activity\n\t\tc.After = last.ID\n\t\tout.Cursor, err = g.encodeAuditCursor(p, c)\n\t\tif err != nil {\n\t\t\treturn AuditList{}, err\n\t\t}\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.list\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\treturn out, nil\n}\n\n// Explicit bounded maintenance; snapshot expiration never reorders a live page.\nfunc (g *GovernanceService) CleanupSnapshots(ctx context.Context) error {\n\t_, err := g.base.db.ExecContext(ctx, `DELETE FROM chat_audit_snapshots WHERE expires_at<=UTC_TIMESTAMP(6) ORDER BY expires_at LIMIT 10`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/av.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/md5\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\nconst AVRule = \"av-message-v1\"\nconst AVPartBytes = 2 << 20\nconst MaxVideoBytes = 20 << 20\nconst MaxRecordingBytes = 8 << 20\nconst MaxVoiceBytes = 1 << 20\n\nvar ErrAVLimit = errors.New(\"CHAT_AV_LIMIT_EXCEEDED\")\nvar ErrAVUnknown = errors.New(\"CHAT_AV_CHECK_RESULT_UNKNOWN\")\n\ntype AVStorage interface {\n\tObjectKeeper\n\tRead(context.Context, string, int64) ([]byte, error)\n\tSign(context.Context, string, time.Duration) (string, error)\n\tInspectionURL(context.Context, string) (string, error)\n\tDelete(context.Context, string) error\n\tGrantAVPart(context.Context, string, int64) (string, string, error)\n\tPutAV(context.Context, string, []byte, string) error\n\tStatAV(context.Context, string) (int64, error)\n}\ntype AVFrameArtifact struct {\n\tBody []byte\n\tAtMS int\n}\ntype avFrameRecord struct {\n\tKey  string `json:\"key\"`\n\tHash string `json:\"hash\"`\n\tAtMS int    `json:\"at_ms\"`\n}\ntype AVFrameView struct {\n\tOrdinal int `json:\"ordinal\"`\n\tAtMS    int `json:\"at_ms\"`\n}\ntype AVArtifact struct {\n\tFrames           []AVFrameArtifact\n\tMain, Poster     []byte\n\tSegments         [][]byte\n\tDurationMS       int\n\tHasAudio         bool\n\tMIME, QRDecision string\n}\ntype AVProcessor interface {\n\tProcess(context.Context, []byte, string, string) (AVArtifact, error)\n}\ntype AVService struct {\n\tbase                       *Service\n\tstorage                    AVStorage\n\tprocessor                  AVProcessor\n\tinspector                  ports.AVInspector\n\tenvironment, configuration string\n\taudio, video               bool\n\tdailyASR                   int\n}\ntype AVUpload struct {\n\tAttachmentID  ports.ID  `json:\"attachment_id\"`\n\tObjectVersion string    `json:\"object_version\"`\n\tState         string    `json:\"state\"`\n\tPartCount     int       `json:\"part_count\"`\n\tPartBytes     int       `json:\"part_bytes\"`\n\tExpiresAt     time.Time `json:\"expires_at\"`\n}\ntype AVPartGrant struct {\n\tUploadGrant\n\tOrdinal int   `json:\"ordinal\"`\n\tSize    int64 `json:\"size_bytes\"`\n}\ntype AVView struct {\n\tFrames       []AVFrameView `json:\"frames,omitempty\"`\n\tAttachmentID ports.ID      `json:\"attachment_id\"`\n\tDurationMS   int           `json:\"duration_ms\"`\n\tTranscript   *string       `json:\"transcript,omitempty\"`\n\tHeard        bool          `json:\"heard\"`\n\tHasAudio     bool          `json:\"has_audio\"`\n}\ntype AVStatus struct {\n\tIntentID      ports.ID `json:\"intent_id,omitempty\"`\n\tReviewVersion ports.ID `json:\"review_version,omitempty\"`\n\tResult\n\tPhase         string    `json:\"phase\"`\n\tPartCount     int       `json:\"part_count\"`\n\tUploaded      []int     `json:\"uploaded_parts\"`\n\tAttachmentID  ports.ID  `json:\"attachment_id,omitempty\"`\n\tObjectVersion string    `json:\"object_version,omitempty\"`\n\tExpiresAt     time.Time `json:\"expires_at\"`\n}\n\nfunc NewAVService(base *Service, storage AVStorage, processor AVProcessor, inspector ports.AVInspector, env, configuration string, audio, video bool, dailyASR int) (*AVService, error) {\n\tif base == nil || storage == nil || processor == nil || inspector == nil || (!audio && !video) || !isMediaHash(configuration) || (env != \"production\" && env != \"test\" && env != \"development\") || dailyASR < 1 || dailyASR > 20000 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &AVService{base, storage, processor, inspector, env, configuration, audio, video, dailyASR}, nil\n}\nfunc (s *Service) AttachAV(a *AVService) error {\n\tif a == nil || s.av != nil {\n\t\treturn ports.ErrInvalid\n\t}\n\ts.av = a\n\treturn nil\n}\nfunc isMediaHash(v string) bool {\n\tif len(v) != 64 {\n\t\treturn false\n\t}\n\tb, e := hex.DecodeString(v)\n\treturn e == nil && len(b) == 32 && v == hex.EncodeToString(b)\n}\nfunc fileMD5(b []byte) string { v := md5.Sum(b); return hex.EncodeToString(v[:]) }\nfunc avKind(source string) string {\n\tif source == \"voice\" {\n\t\treturn \"audio\"\n\t}\n\treturn \"video\"\n}\nfunc avLimits(source string) (int64, int) {\n\tswitch source {\n\tcase \"voice\":\n\t\treturn MaxVoiceBytes, 60000\n\tcase \"camera\":\n\t\treturn MaxRecordingBytes, 30000\n\tcase \"album\":\n\t\treturn MaxVideoBytes, 120000\n\t}\n\treturn 0, 0\n}\nfunc avParts(size int64) int {\n\tif size <= 4<<20 {\n\t\treturn 1\n\t}\n\treturn int((size + AVPartBytes - 1) / AVPartBytes)\n}\nfunc avPartSize(size int64, ordinal int) int64 {\n\tn := avParts(size)\n\tif ordinal < 1 || ordinal > n {\n\t\treturn 0\n\t}\n\tif n == 1 {\n\t\treturn size\n\t}\n\treturn min(AVPartBytes, size-int64(ordinal-1)*AVPartBytes)\n}\nfunc avFingerprint(q Request) (string, error) {\n\tif !validID(q.ConversationID) || !validClient(q.ClientMessageID) || q.Text != \"\" || q.EditedFrom != \"\" || q.Revision < 1 || q.Revision > 10000 || len(q.Items) != 1 || (q.MessageType != \"audio\" && q.MessageType != \"video\") || q.ReplyTo != \"\" && !validID(q.ReplyTo) || q.ReplyItem != \"\" && (!validID(q.ReplyItem) || q.ReplyTo == \"\") {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tv := q.Items[0]\n\tif !validID(v.AttachmentID) || !isMediaHash(v.ObjectVersion) || v.Ordinal != 0 || v.ItemID != \"\" {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\traw, _ := json.Marshal(struct {\n\t\tSchema           int\n\t\tType             string\n\t\tRevision         int\n\t\tItems            []MediaItem\n\t\tReply, ReplyItem string\n\t}{4, q.MessageType, q.Revision, q.Items, string(q.ReplyTo), string(q.ReplyItem)})\n\treturn mediaHash(raw), nil\n}\nfunc (a *AVService) enabled(kind string) bool {\n\treturn kind == \"audio\" && a.audio || kind == \"video\" && a.video\n}\nfunc (s *Service) keepAVObjects(ctx context.Context, id ports.ID, kind string) error {\n\tif s.av == nil {\n\t\treturn ErrMedia\n\t}\n\trows, e := s.db.QueryContext(ctx, `SELECT u.main_key,u.poster_key FROM chat_av_items i JOIN chat_av_uploads u ON u.id=i.upload_id AND u.object_version=i.object_version WHERE i.message_id=?`, string(id))\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tkeys := []string{}\n\tfor rows.Next() {\n\t\tvar main string\n\t\tvar poster sql.NullString\n\t\tif rows.Scan(&main, &poster) != nil {\n\t\t\trows.Close()\n\t\t\treturn ErrMedia\n\t\t}\n\t\tkeys = append(keys, main)\n\t\tif poster.Valid && poster.String != \"\" {\n\t\t\tkeys = append(keys, poster.String)\n\t\t}\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif len(keys) == 0 {\n\t\treturn ErrObjectMissing\n\t}\n\tfor _, key := range keys {\n\t\tif e = s.av.storage.Keep(ctx, key); e != nil {\n\t\t\treturn e\n\t\t}\n\t}\n\treturn nil\n}\n","chat/internal/message/av_cleanup.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Cleanup holds the upload lock shared with publication and evidence changes.\n// Failed deletes retain their ledger and retry on the next maintenance pass.\nfunc (a *AVService) CleanOne(ctx context.Context) error {\n\tif e := a.sweepExpired(ctx); e != nil {\n\t\treturn e\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tvar id ports.ID\n\tvar key, role string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(u.id AS CHAR),o.object_key,o.role FROM chat_av_objects o JOIN chat_av_uploads u ON u.id=o.upload_id WHERE u.legal_hold=0 AND NOT EXISTS(SELECT 1 FROM chat_av_jobs j WHERE j.upload_id=u.id AND j.lease_until>UTC_TIMESTAMP(6)) AND ((o.role IN ('check-0','check-1') AND (o.created_at<UTC_TIMESTAMP(6)-INTERVAL 1 DAY OR EXISTS(SELECT 1 FROM chat_av_jobs j WHERE j.upload_id=u.id AND j.phase IN ('published','failed')))) OR (o.created_at<UTC_TIMESTAMP(6)-INTERVAL 1 DAY AND u.expires_at<=UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_av_items i WHERE i.upload_id=u.id))) ORDER BY o.created_at LIMIT 1`).Scan(&id, &key, &role)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif e == nil {\n\t\tvar hold bool\n\t\tif tx.QueryRowContext(ctx, `SELECT legal_hold FROM chat_av_uploads WHERE id=? FOR UPDATE`, string(id)).Scan(&hold) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif hold {\n\t\t\treturn nil\n\t\t}\n\t\tvar eligible bool\n\t\tif tx.QueryRowContext(ctx, `SELECT legal_hold=0 AND NOT EXISTS(SELECT 1 FROM chat_av_jobs j WHERE j.upload_id=u.id AND j.lease_until>UTC_TIMESTAMP(6)) AND (? IN ('check-0','check-1') OR (expires_at<=UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_av_items i WHERE i.upload_id=u.id))) FROM chat_av_uploads u WHERE id=?`, role, string(id)).Scan(&eligible) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif !eligible {\n\t\t\treturn nil\n\t\t}\n\t\tif e = a.storage.Delete(ctx, key); e != nil {\n\t\t\treturn e\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `DELETE FROM chat_av_objects WHERE object_key=?`, key); e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t} else {\n\t\tvar ordinal int\n\t\te = tx.QueryRowContext(ctx, `SELECT CAST(u.id AS CHAR),p.object_key,p.ordinal FROM chat_av_parts p JOIN chat_av_uploads u ON u.id=p.upload_id WHERE p.state<>'cleaned' AND (p.grant_until IS NULL OR p.grant_until<UTC_TIMESTAMP(6)) AND (u.state IN ('prepared','published','canceled','cleaned') OR u.expires_at<=UTC_TIMESTAMP(6)) ORDER BY u.id,p.ordinal LIMIT 1`).Scan(&id, &key, &ordinal)\n\t\tif e == sql.ErrNoRows {\n\t\t\treturn nil\n\t\t}\n\t\tif e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tvar state string\n\t\tif tx.QueryRowContext(ctx, `SELECT state FROM chat_av_uploads WHERE id=? FOR UPDATE`, string(id)).Scan(&state) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tvar eligible bool\n\t\tif tx.QueryRowContext(ctx, `SELECT (u.state IN ('prepared','published','canceled','cleaned') OR u.expires_at<=UTC_TIMESTAMP(6)) AND (p.grant_until IS NULL OR p.grant_until<UTC_TIMESTAMP(6)) FROM chat_av_parts p JOIN chat_av_uploads u ON u.id=p.upload_id WHERE u.id=? AND p.ordinal=?`, string(id), ordinal).Scan(&eligible) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif !eligible {\n\t\t\treturn nil\n\t\t}\n\t\tif e = a.storage.Delete(ctx, key); e != nil {\n\t\t\treturn e\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_parts SET state='cleaned' WHERE upload_id=? AND ordinal=?`, string(id), ordinal); e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (a *AVService) sweepExpired(ctx context.Context) error {\n\tvar e error\n\tif _, e = a.base.db.ExecContext(ctx, `UPDATE chat_send_intents i JOIN chat_av_jobs j ON j.intent_id=i.id SET i.state='rejected',i.error_code='CHAT_ACTION_EXPIRED',i.lease_owner=NULL,i.lease_until=NULL,i.updated_at=UTC_TIMESTAMP(6) WHERE j.expires_at<=UTC_TIMESTAMP(6) AND i.state IN ('checking','review_pending','retryable')`); e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\t// Remove duplicate recognition text as soon as the uncommitted action expires.\n\t_, e = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET transcript=NULL,principal_json='{}',segments_json=NULL,phase=IF(phase='published',phase,'failed'),error_code=IF(phase='published',error_code,'CHAT_ACTION_EXPIRED') WHERE expires_at<=UTC_TIMESTAMP(6) AND (transcript IS NOT NULL OR principal_json<>'{}' OR segments_json IS NOT NULL) LIMIT 20`)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_asr_requests r JOIN chat_av_jobs j ON j.intent_id=r.intent_id SET r.text_result=NULL WHERE j.expires_at<=UTC_TIMESTAMP(6)`)\n\t_, _ = a.base.db.ExecContext(ctx, `DELETE FROM chat_av_raw_receipts WHERE created_at<UTC_TIMESTAMP(6)-INTERVAL 2 DAY ORDER BY created_at LIMIT 100`)\n\treturn nil\n}\nfunc purgeAVReference(ctx context.Context, tx *sql.Tx, id ports.ID) error {\n\tif _, e := tx.ExecContext(ctx, `UPDATE chat_av_uploads u JOIN chat_av_items i ON i.upload_id=u.id SET u.transcript=NULL WHERE i.message_id=? AND u.legal_hold=0`, string(id)); e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, e := tx.ExecContext(ctx, `DELETE FROM chat_av_items WHERE message_id=?`, string(id)); e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/av_delivery.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"time\"\n)\n\nfunc hydrateAV(ctx context.Context, tx *sql.Tx, p ports.Principal, views []*MessageView) error {\n\tmarks := []string{}\n\targs := []any{string(p.ActorID)}\n\tbyID := map[ports.ID][]*MessageView{}\n\tfor _, v := range views {\n\t\tv.AV = nil\n\t\tif v.State == \"published\" && (v.Type == \"audio\" || v.Type == \"video\") {\n\t\t\tif len(byID[v.ID]) == 0 {\n\t\t\t\tmarks = append(marks, \"?\")\n\t\t\t\targs = append(args, string(v.ID))\n\t\t\t}\n\t\t\tbyID[v.ID] = append(byID[v.ID], v)\n\t\t}\n\t}\n\tif len(marks) == 0 {\n\t\treturn nil\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(i.message_id AS CHAR),CAST(i.upload_id AS CHAR),u.duration_ms,u.transcript,u.has_audio,COALESCE(u.frames_json,'[]'),EXISTS(SELECT 1 FROM chat_av_listens l WHERE l.actor_id=? AND l.message_id=i.message_id) FROM chat_av_items i JOIN chat_av_uploads u ON u.id=i.upload_id AND u.object_version=i.object_version WHERE i.message_id IN (`+strings.Join(marks, \",\")+`)`, args...)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer rows.Close()\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tvar v AVView\n\t\tvar transcript sql.NullString\n\t\tvar frameJSON string\n\t\tif rows.Scan(&id, &v.AttachmentID, &v.DurationMS, &transcript, &v.HasAudio, &frameJSON, &v.Heard) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tvar frames []avFrameRecord\n\t\tif json.Unmarshal([]byte(frameJSON), &frames) != nil || len(frames) > 8 {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tfor i, frame := range frames {\n\t\t\tv.Frames = append(v.Frames, AVFrameView{Ordinal: i, AtMS: frame.AtMS})\n\t\t}\n\t\tif p.Kind != \"mini\" {\n\t\t\tv.Heard = false\n\t\t}\n\t\tif transcript.Valid {\n\t\t\tv.Transcript = &transcript.String\n\t\t}\n\t\tfor _, parent := range byID[id] {\n\t\t\tcopy := v\n\t\t\tparent.AV = &copy\n\t\t}\n\t}\n\tif rows.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (a *AVService) URL(ctx context.Context, p ports.Principal, cid, mid ports.ID, poster bool, frame ...int) (MediaAccess, error) {\n\tif !validID(cid) || !validID(mid) {\n\t\treturn MediaAccess{}, ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := a.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tcolumn, hashColumn := \"u.main_key\", \"u.main_sha256\"\n\tif poster {\n\t\tcolumn, hashColumn = \"u.poster_key\", \"u.poster_sha256\"\n\t}\n\tvar key, hash, mode, mime, frameJSON string\n\tvar expiry sql.NullTime\n\tvar version ports.ID\n\te = tx.QueryRowContext(ctx, `SELECT `+column+`,`+hashColumn+`,m.retention_mode,m.expires_at,CAST(m.state_version AS CHAR),u.mime_type,COALESCE(u.frames_json,'[]') FROM chat_messages m JOIN chat_av_items i ON i.message_id=m.id JOIN chat_av_uploads u ON u.id=i.upload_id AND u.object_version=i.object_version WHERE m.id=? AND m.conversation_id=? AND m.state='published' AND `+retainedTarget+` AND `+visibleColumn, string(mid), string(cid), string(g.Version), string(p.ActorID)).Scan(&key, &hash, &mode, &expiry, &version, &mime, &frameJSON)\n\tif e != nil || key == \"\" {\n\t\treturn MediaAccess{}, ErrMedia\n\t}\n\tif len(frame) > 1 {\n\t\treturn MediaAccess{}, ports.ErrInvalid\n\t}\n\tif len(frame) == 1 {\n\t\tvar frames []avFrameRecord\n\t\tif frame[0] < 0 || frame[0] >= 8 || json.Unmarshal([]byte(frameJSON), &frames) != nil || frame[0] >= len(frames) {\n\t\t\treturn MediaAccess{}, ErrMedia\n\t\t}\n\t\tkey, hash = frames[frame[0]].Key, frames[frame[0]].Hash\n\t\tposter = true\n\t}\n\tvar exists bool\n\tif tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM chat_av_objects WHERE object_key=? AND deleted_at IS NULL)`, key).Scan(&exists) != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\tavailable := exists && (poster || !expiry.Valid || expiry.Time.After(time.Now()))\n\taccessExpiry := expiry\n\tif poster || !available {\n\t\taccessExpiry = sql.NullTime{}\n\t}\n\tttl := mediaReadTTL(p, accessExpiry)\n\tif ttl < time.Second {\n\t\treturn MediaAccess{}, ErrExpired\n\t}\n\turl := \"\"\n\tif available {\n\t\turl, e = a.storage.Sign(ctx, key, ttl)\n\t\tif e != nil {\n\t\t\treturn MediaAccess{}, e\n\t\t}\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_objects SET last_access_at=UTC_TIMESTAMP(6) WHERE object_key=?`, key); e != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\tif poster {\n\t\tmime = \"image/jpeg\"\n\t}\n\tout := MediaAccess{CloudAvailable: available, URL: url, ExpiresAt: time.Now().Add(ttl).Unix(), ObjectHash: hash, RetentionMode: mode, StateVersion: version, MIME: mime, ServerTime: time.Now().UTC()}\n\tif expiry.Valid {\n\t\tout.MessageExpiresAt = &expiry.Time\n\t}\n\treturn out, nil\n}\nfunc (a *AVService) Listened(ctx context.Context, p ports.Principal, cid, mid ports.ID) error {\n\tif !validID(cid) || !validID(mid) {\n\t\treturn ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tg, e := a.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif e != nil {\n\t\treturn e\n\t}\n\tvar id ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR) FROM chat_messages m JOIN chat_av_items i ON i.message_id=m.id WHERE m.id=? AND m.conversation_id=? AND m.message_type='audio' AND m.state='published' AND `+retainedTarget+` AND `+visibleColumn, string(mid), string(cid), string(g.Version), string(p.ActorID)).Scan(&id) != nil {\n\t\treturn ErrMedia\n\t}\n\tif _, e = tx.ExecContext(ctx, `INSERT IGNORE INTO chat_av_listens(actor_id,message_id,first_listened_at) VALUES(?,?,UTC_TIMESTAMP(6))`, string(p.ActorID), string(mid)); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (a *AVService) Status(ctx context.Context, p ports.Principal, cid ports.ID, client string, cancel bool) (AVStatus, error) {\n\tout := AVStatus{Uploaded: []int{}}\n\tif !validID(cid) || !validClient(client) {\n\t\treturn out, ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn out, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = a.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"}); e != nil {\n\t\treturn out, e\n\t}\n\ti, e := a.base.lookup(ctx, tx, p, cid, client)\n\tif e != nil {\n\t\treturn out, e\n\t}\n\tif i == nil && cancel {\n\t\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,attempts,action_expires_at,retain_until,error_code,created_at,updated_at) VALUES(?,?,?,'','canceled',0,?,?,'CHAT_ACTION_CANCELED',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(cid), client, expires(client), expires(client).Add(MinimumRetention))\n\t\tif e != nil || tx.Commit() != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t\tout.Result = Result{ClientMessageID: client, State: \"canceled\", Code: \"CHAT_ACTION_CANCELED\"}\n\t\treturn out, nil\n\t}\n\tif i == nil {\n\t\treturn out, ErrUnknown\n\t}\n\tout.Result = i.result\n\tout.IntentID = i.id\n\tif err := tx.QueryRowContext(ctx, `SELECT CAST(review_version AS CHAR) FROM chat_av_jobs WHERE intent_id=?`, string(i.id)).Scan(&out.ReviewVersion); err != nil && !(err == sql.ErrNoRows && out.State == \"canceled\") {\n\t\treturn out, ErrMedia\n\t}\n\te = tx.QueryRowContext(ctx, `SELECT j.phase,CAST(u.id AS CHAR),u.object_version,u.part_count,j.expires_at FROM chat_av_jobs j JOIN chat_av_uploads u ON u.id=j.upload_id WHERE j.intent_id=? FOR UPDATE`, string(i.id)).Scan(&out.Phase, &out.AttachmentID, &out.ObjectVersion, &out.PartCount, &out.ExpiresAt)\n\tif e == sql.ErrNoRows && out.State == \"canceled\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tif e != nil {\n\t\treturn out, ErrMedia\n\t}\n\tif cancel && out.State != \"accepted\" && out.State != \"rejected\" && out.State != \"canceled\" {\n\t\tout.State = \"canceled\"\n\t\tout.Code = \"CHAT_ACTION_CANCELED\"\n\t}\n\tif !time.Now().Before(out.ExpiresAt) && out.State != \"accepted\" && out.State != \"canceled\" && out.State != \"rejected\" {\n\t\tout.State = \"rejected\"\n\t\tout.Code = ErrExpired.Error()\n\t}\n\tif out.State != i.result.State {\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, out.State, out.Code, string(i.id)); e != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='failed',lease_owner=NULL WHERE intent_id=?`, string(i.id)); e != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_uploads SET state='canceled',expires_at=LEAST(expires_at,UTC_TIMESTAMP(6)) WHERE id=?`, string(out.AttachmentID)); e != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT ordinal FROM chat_av_parts WHERE upload_id=? AND state='present' ORDER BY ordinal`, string(out.AttachmentID))\n\tif e != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tfor rows.Next() {\n\t\tvar n int\n\t\tif rows.Scan(&n) != nil {\n\t\t\trows.Close()\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t\tout.Uploaded = append(out.Uploaded, n)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil || tx.Commit() != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\nfunc (a *AVService) Pending(ctx context.Context, p ports.Principal, cid ports.ID) ([]AVStatus, error) {\n\tif _, e := a.base.conversations.Authorize(ctx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"}); e != nil {\n\t\treturn nil, e\n\t}\n\trows, e := a.base.db.QueryContext(ctx, `SELECT i.client_message_id FROM chat_send_intents i JOIN chat_av_jobs j ON j.intent_id=i.id WHERE i.sender_id=? AND i.conversation_id=? AND i.state IN ('checking','review_pending') AND j.expires_at>UTC_TIMESTAMP(6) ORDER BY i.id DESC LIMIT 20`, string(p.ActorID), string(cid))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tclients := []string{}\n\tfor rows.Next() {\n\t\tvar client string\n\t\tif rows.Scan(&client) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tclients = append(clients, client)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tout := []AVStatus{}\n\tfor _, client := range clients {\n\t\tv, e := a.Status(ctx, p, cid, client, false)\n\t\tif e != nil {\n\t\t\treturn nil, e\n\t\t}\n\t\tout = append(out, v)\n\t}\n\treturn out, nil\n}\n","chat/internal/message/av_evidence.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype AVEvidence struct {\n\tItemID     ports.ID `json:\"item_id\"`\n\tKind       string   `json:\"message_type\"`\n\tDurationMS int      `json:\"duration_ms\"`\n\tTranscript *string  `json:\"transcript,omitempty\"`\n}\n\nfunc caseAV(ctx context.Context, tx *sql.Tx, c Case) (*AVEvidence, string, error) {\n\tvar out AVEvidence\n\tvar key string\n\tvar transcript sql.NullString\n\tquery := `SELECT CAST(u.id AS CHAR),u.kind,u.duration_ms,COALESCE(u.transcript,j.transcript),COALESCE(u.main_key,'') FROM chat_av_uploads u JOIN chat_av_jobs j ON j.upload_id=u.id `\n\tvar args []any\n\tswitch c.TargetType {\n\tcase \"message\":\n\t\tquery += `JOIN chat_av_items ai ON ai.upload_id=u.id AND ai.object_version=u.object_version WHERE ai.message_id=? AND u.legal_hold=1`\n\t\targs = []any{string(c.Target)}\n\tcase \"media_intent\":\n\t\tquery += `WHERE j.intent_id=? AND j.manifest_hash=? AND u.legal_hold=1`\n\t\targs = []any{string(c.Target), c.Fingerprint}\n\tcase \"risk\":\n\t\tquery += `JOIN chat_risk_events r ON r.intent_id=j.intent_id WHERE r.id=? AND r.content_fingerprint=? AND r.retain_until>UTC_TIMESTAMP(6) AND u.legal_hold=1`\n\t\targs = []any{string(c.Target), c.Fingerprint}\n\tdefault:\n\t\treturn nil, \"\", nil\n\t}\n\te := tx.QueryRowContext(ctx, query, args...).Scan(&out.ItemID, &out.Kind, &out.DurationMS, &transcript, &key)\n\tif e == sql.ErrNoRows {\n\t\treturn nil, \"\", nil\n\t}\n\tif e != nil {\n\t\treturn nil, \"\", ports.ErrUnavailable\n\t}\n\tif transcript.Valid {\n\t\tout.Transcript = &transcript.String\n\t}\n\treturn &out, key, nil\n}\nfunc (g *GovernanceService) avEvidenceURL(ctx context.Context, tx *sql.Tx, p ports.Principal, c Case, item ports.ID) (*AVEvidence, string, error) {\n\tout, key, e := caseAV(ctx, tx, c)\n\tif e != nil {\n\t\treturn nil, \"\", e\n\t}\n\tif out == nil {\n\t\treturn nil, \"\", nil\n\t}\n\tif item == \"\" {\n\t\treturn out, \"\", nil\n\t}\n\tif item != out.ItemID || g.base.av == nil || key == \"\" {\n\t\treturn nil, \"\", ErrMedia\n\t}\n\tvar expires time.Time\n\tif tx.QueryRowContext(ctx, `SELECT retain_until FROM chat_cases WHERE id=?`, string(c.ID)).Scan(&expires) != nil {\n\t\treturn nil, \"\", ErrMedia\n\t}\n\tttl := min(60*time.Second, time.Until(expires), time.Until(p.ExpiresAt))\n\tif ttl < time.Second {\n\t\treturn nil, \"\", ErrExpired\n\t}\n\turl, e := g.base.av.storage.Sign(ctx, key, ttl)\n\treturn out, url, e\n}\nfunc releaseAVHolds(ctx context.Context, tx *sql.Tx) error {\n\t_, e := tx.ExecContext(ctx, `UPDATE chat_av_uploads u SET legal_hold=0 WHERE u.legal_hold=1 AND NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_av_items i ON c.target_type='message' AND c.target_id=i.message_id WHERE i.upload_id=u.id AND c.retain_until>UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_av_jobs j ON c.target_type='media_intent' AND c.target_id=j.intent_id WHERE j.upload_id=u.id AND c.retain_until>UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_risk_events r JOIN chat_av_jobs j ON j.intent_id=r.intent_id WHERE j.upload_id=u.id AND (r.retain_until>UTC_TIMESTAMP(6) OR EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='risk' AND c.target_id=r.id AND c.retain_until>UTC_TIMESTAMP(6))))`)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\nfunc (g *GovernanceService) AuditAV(ctx context.Context, p ports.Principal, cid, mid ports.ID) (MediaAccess, error) {\n\tif g.base.av == nil || !validID(cid) || !validID(mid) {\n\t\treturn MediaAccess{}, ports.ErrInvalid\n\t}\n\ttx, e := g.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tdefer tx.Rollback()\n\tif e = g.admin(ctx, tx, p, \"chat:audit\"); e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tvar found ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`, string(cid)).Scan(&found) != nil {\n\t\treturn MediaAccess{}, ErrResync\n\t}\n\tvar key, hash, mode, mime string\n\tvar expiry sql.NullTime\n\tvar version ports.ID\n\te = tx.QueryRowContext(ctx, `SELECT u.main_key,u.main_sha256,m.retention_mode,m.expires_at,CAST(m.state_version AS CHAR),u.mime_type FROM chat_messages m JOIN chat_av_items ai ON ai.message_id=m.id JOIN chat_av_uploads u ON u.id=ai.upload_id AND u.object_version=ai.object_version WHERE m.id=? AND m.conversation_id=? AND m.state='published' AND `+retainedTarget, string(mid), string(cid)).Scan(&key, &hash, &mode, &expiry, &version, &mime)\n\tif e != nil || key == \"\" {\n\t\treturn MediaAccess{}, ErrMedia\n\t}\n\tvar exists bool\n\tif tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM chat_av_objects WHERE object_key=? AND deleted_at IS NULL)`, key).Scan(&exists) != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\tavailable := exists && (!expiry.Valid || expiry.Time.After(time.Now()))\n\taccessExpiry := expiry\n\tif !available {\n\t\taccessExpiry = sql.NullTime{}\n\t}\n\tttl := mediaReadTTL(p, accessExpiry)\n\tif ttl < time.Second {\n\t\treturn MediaAccess{}, ErrExpired\n\t}\n\turl := \"\"\n\tif available {\n\t\turl, e = g.base.av.storage.Sign(ctx, key, ttl)\n\t\tif e != nil {\n\t\t\treturn MediaAccess{}, e\n\t\t}\n\t}\n\tif e = governanceLog(ctx, tx, p, \"audit.av\", cid, mid, \"\", version, \"\"); e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tif e = g.commit(tx, p); e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tout := MediaAccess{CloudAvailable: available, URL: url, ExpiresAt: time.Now().Add(ttl).Unix(), MIME: mime, ObjectHash: hash, StateVersion: version, RetentionMode: mode, ServerTime: time.Now().UTC()}\n\tif expiry.Valid {\n\t\tout.MessageExpiresAt = &expiry.Time\n\t}\n\treturn out, nil\n}\n","chat/internal/message/av_http.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n)\n\ntype avAction struct {\n\tFrame *int `json:\"frame_ordinal,omitempty\"`\n\timageAction\n\tSource  string `json:\"source,omitempty\"`\n\tMD5     string `json:\"source_md5,omitempty\"`\n\tOrdinal int    `json:\"ordinal,omitempty\"`\n\tConfirm bool   `json:\"confirm,omitempty\"`\n}\ntype AVHandler struct {\n\tservice  *AVService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewAVHandler(m *AVService, identity ports.Identity, concurrency int) (*AVHandler, error) {\n\tif m == nil || identity == nil || concurrency < 1 || concurrency > 16 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &AVHandler{m, identity, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *AVHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tfail := func(status int, code string) {\n\t\tw.WriteHeader(status)\n\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"code\": code, \"message\": \"音视频操作未完成，请刷新状态后重试\", \"retryable\": status >= 500, \"server_time\": time.Now().UTC()})\n\t}\n\troute := strings.TrimPrefix(r.URL.Path, \"/chat/api/v1/av/\")\n\tfields := map[string]string{\n\t\t\"upload\":   \"conversation_id upload_id source size_bytes source_md5\",\n\t\t\"part\":     \"conversation_id attachment_id ordinal confirm\",\n\t\t\"complete\": \"conversation_id attachment_id\",\n\t\t\"status\":   \"conversation_id client_message_id\", \"cancel\": \"conversation_id client_message_id\", \"pending\": \"conversation_id\",\n\t\t\"url\": \"conversation_id message_id thumbnail frame_ordinal\", \"listened\": \"conversation_id message_id\",\n\t\t\"review/list\": \"after\", \"review/decide\": \"intent_id expected_version action reason general_safety_confirmed group_confirmed\",\n\t\t\"review/url\": \"intent_id expected_version\",\n\t}\n\tallowed, ok := fields[route]\n\tif !ok || r.URL.Path != \"/chat/api/v1/av/\"+route {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tcontent, _, err := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif err != nil || content != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\")\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error())\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)\n\tdefer cancel()\n\tbody, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 16<<10))\n\tif err != nil {\n\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\")\n\t\treturn\n\t}\n\tvar q avAction\n\tif !strictImageJSON(body, &q) {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tvar keys map[string]json.RawMessage\n\tjson.Unmarshal(body, &keys)\n\tfor key := range keys {\n\t\tif !strings.Contains(\" \"+allowed+\" \", \" \"+key+\" \") {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\t\treturn\n\t\t}\n\t}\n\tp, err := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif err != nil {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tvar result any\n\tswitch route {\n\tcase \"upload\":\n\t\tresult, err = h.service.Upload(ctx, p, q.ConversationID, q.UploadID, q.Source, q.Size, q.MD5)\n\tcase \"part\":\n\t\tresult, err = h.service.Part(ctx, p, q.ConversationID, q.AttachmentID, q.Ordinal, q.Confirm)\n\tcase \"complete\":\n\t\terr = h.service.Complete(ctx, p, q.ConversationID, q.AttachmentID)\n\t\tresult = map[string]bool{\"submitted\": err == nil}\n\tcase \"status\", \"cancel\":\n\t\tresult, err = h.service.Status(ctx, p, q.ConversationID, q.ClientID, route == \"cancel\")\n\tcase \"pending\":\n\t\tresult, err = h.service.Pending(ctx, p, q.ConversationID)\n\tcase \"url\":\n\t\tif q.Frame == nil {\n\t\t\tresult, err = h.service.URL(ctx, p, q.ConversationID, q.MessageID, q.Thumbnail)\n\t\t} else {\n\t\t\tresult, err = h.service.URL(ctx, p, q.ConversationID, q.MessageID, q.Thumbnail, *q.Frame)\n\t\t}\n\tcase \"listened\":\n\t\terr = h.service.Listened(ctx, p, q.ConversationID, q.MessageID)\n\t\tresult = map[string]bool{\"heard\": err == nil}\n\tcase \"review/list\":\n\t\tresult, err = h.service.Reviews(ctx, p, q.After)\n\tcase \"review/decide\":\n\t\tresult, err = h.service.Review(ctx, p, q.IntentID, q.Expected, q.Action, q.Reason, q.General, q.Group)\n\tcase \"review/url\":\n\t\tresult, err = h.service.ReviewURL(ctx, p, q.IntentID, q.Expected)\n\t}\n\tif err != nil {\n\t\tstatus := 409\n\t\tcode := err.Error()\n\t\tif err == ports.ErrInvalid {\n\t\t\tstatus = 400\n\t\t} else if err == auth.ErrUnauthorized {\n\t\t\tstatus = 403\n\t\t} else if err == ports.ErrBusy {\n\t\t\tstatus = 429\n\t\t} else if err == ports.ErrUnavailable || err == ErrCheck {\n\t\t\tstatus = 503\n\t\t}\n\t\tfail(status, code)\n\t\treturn\n\t}\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"ok\": true, \"data\": result, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/av_inspection.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\nfunc (a *AVService) recognize(ctx context.Context, v avJob) error {\n\tif v.Ordinal >= len(v.Segments) {\n\t\treturn a.advance(ctx, v, \"text_ready\")\n\t}\n\tsegment := v.Segments[v.Ordinal]\n\turl, e := a.storage.InspectionURL(ctx, segment.Key)\n\tif e != nil {\n\t\treturn e\n\t}\n\tkey := mediaHash([]byte(string(v.ID) + \"\\n\" + v.Hash + \"\\n\" + strconv.Itoa(v.Ordinal) + \"\\n\" + segment.Hash + \"\\n\" + a.configuration))\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\t// All actors share row zero; deterministic order prevents cross-account budget races.\n\tfor _, actor := range []ports.ID{\"0\", v.Principal.ActorID} {\n\t\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_av_budgets(actor_id,day_start,asr_reserved) VALUES(?,UTC_DATE(),0) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(actor)); e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tvar count int\n\t\tvar current bool\n\t\tif tx.QueryRowContext(ctx, `SELECT asr_reserved,day_start=UTC_DATE() FROM chat_av_budgets WHERE actor_id=? FOR UPDATE`, string(actor)).Scan(&count, &current) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif !current {\n\t\t\tcount = 0\n\t\t}\n\t\tlimit := 200\n\t\tif actor == \"0\" {\n\t\t\tlimit = a.dailyASR\n\t\t}\n\t\tif count >= limit {\n\t\t\treturn ports.ErrBusy\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_budgets SET day_start=UTC_DATE(),asr_reserved=? WHERE actor_id=?`, count+1, string(actor)); e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_av_asr_requests(intent_id,ordinal,request_key,state,created_at) VALUES(?,?,?,'started',UTC_TIMESTAMP(6))`, string(v.ID), v.Ordinal, key); e != nil {\n\t\treturn ErrAVUnknown\n\t}\n\tr, e := tx.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='asr_started' WHERE intent_id=? AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, string(v.ID), v.Owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := r.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tresult, e := a.inspector.Recognize(ctx, ports.AudioInspectionRequest{Actor: v.Principal, ConversationID: v.Request.ConversationID, IntentID: v.ID, ObjectHash: segment.Hash, URL: url, Segment: v.Ordinal, UserAudioKey: key})\n\tif e != nil {\n\t\tif result.Known && result.Retryable {\n\t\t\ttx, e = a.base.begin(ctx)\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tdefer tx.Rollback()\n\t\t\tif _, e = tx.ExecContext(ctx, `DELETE FROM chat_av_asr_requests WHERE intent_id=? AND ordinal=? AND state='started'`, string(v.ID), v.Ordinal); e != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\tif !result.Dispatched {\n\t\t\t\tfor _, actor := range []ports.ID{\"0\", v.Principal.ActorID} {\n\t\t\t\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_budgets SET asr_reserved=GREATEST(asr_reserved,1)-1 WHERE actor_id=? AND day_start=UTC_DATE()`, string(actor)); e != nil {\n\t\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='asr_ready',next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND lease_owner=?`, string(v.ID), v.Owner); e != nil || tx.Commit() != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\treturn ErrCheck\n\t\t}\n\t\tif result.Known {\n\t\t\ta.fail(ctx, v.ID, v.Owner, ErrCheck.Error())\n\t\t\treturn ErrCheck\n\t\t}\n\t\treturn a.unknown(ctx, v)\n\t}\n\tif !result.Known || !isMediaHash(result.AuthorityProof) || v.Proof != \"\" && v.Proof != result.AuthorityProof || result.RequestID == \"\" {\n\t\treturn a.unknown(ctx, v)\n\t}\n\ttranscript := strings.TrimSpace(v.Transcript + \" \" + result.Text)\n\tif len([]rune(transcript)) > 2000 || len(transcript) > 4000 {\n\t\ta.fail(ctx, v.ID, v.Owner, \"CHAT_AUDIO_TRANSCRIPT_TOO_LONG\")\n\t\treturn ErrCheck\n\t}\n\tmeta, _ := json.Marshal(map[string]string{\"service\": result.ServiceID, \"api\": result.APIName, \"engine\": result.Engine, \"request_id\": result.RequestID})\n\ttx, e = a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tr, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET transcript=?,source_proof=?,asr_ordinal=asr_ordinal+1,phase='asr_ready',lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND phase='asr_started' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, transcript, result.AuthorityProof, string(v.ID), v.Owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ = r.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_asr_requests SET state='completed',provider_request_id=?,text_result=?,source_proof=?,metadata_json=? WHERE intent_id=? AND ordinal=? AND state='started'`, result.RequestID, result.Text, result.AuthorityProof, string(meta), string(v.ID), v.Ordinal); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (a *AVService) unknown(ctx context.Context, v avJob) error {\n\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='unknown',error_code=?,lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND lease_owner=?`, ErrAVUnknown.Error(), string(v.ID), v.Owner)\n\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_send_intents SET error_code=? WHERE id=? AND state='checking'`, ErrAVUnknown.Error(), string(v.ID))\n\treturn ErrAVUnknown\n}\nfunc (a *AVService) submitRaw(ctx context.Context, v avJob) error {\n\turl, e := a.storage.InspectionURL(ctx, v.Main)\n\tif e != nil {\n\t\treturn e\n\t}\n\tif e = a.advanceStarted(ctx, v, \"raw_started\"); e != nil {\n\t\treturn e\n\t}\n\tkey := mediaHash([]byte(string(v.ID) + \"\\n\" + v.MainHash + \"\\nraw\"))\n\tresult, e := a.inspector.SubmitAudio(ctx, ports.AudioInspectionRequest{Actor: v.Principal, ConversationID: v.Request.ConversationID, IntentID: v.ID, ObjectHash: v.MainHash, URL: url, Segment: 0, UserAudioKey: key})\n\tif e != nil {\n\t\tif result.Known && result.Retryable {\n\t\t\treturn a.advance(ctx, v, \"raw_ready\")\n\t\t}\n\t\tif result.Known {\n\t\t\ta.fail(ctx, v.ID, v.Owner, ErrCheck.Error())\n\t\t\treturn ErrCheck\n\t\t}\n\t\treturn a.unknown(ctx, v)\n\t}\n\tif !result.Known || result.TraceID == \"\" || result.AuthorityProof != v.Proof {\n\t\treturn a.unknown(ctx, v)\n\t}\n\t_, e = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET raw_trace_id=?,phase='raw_wait',lease_owner=NULL,lease_until=NULL,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 5 SECOND WHERE intent_id=? AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, result.TraceID, string(v.ID), v.Owner)\n\treturn e\n}\nfunc (a *AVService) advanceStarted(ctx context.Context, v avJob, phase string) error {\n\tr, e := a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET phase=? WHERE intent_id=? AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, phase, string(v.ID), v.Owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := r.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\treturn nil\n}\nfunc (a *AVService) ReceiveAudio(ctx context.Context, v ports.AudioReceipt) error {\n\tif v.AppID != a.inspector.MediaAppID() || !riskTracePattern.MatchString(v.TraceID) || v.TraceID == \"\" || !isMediaHash(v.Fingerprint) || (v.Decision != \"pass\" && v.Decision != \"risky\" && v.Decision != \"review\" && v.Decision != \"error\") {\n\t\treturn ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tvar existing string\n\te = tx.QueryRowContext(ctx, `SELECT fingerprint FROM chat_av_raw_receipts WHERE trace_id=? FOR UPDATE`, v.TraceID).Scan(&existing)\n\tif e == nil {\n\t\tif existing != v.Fingerprint {\n\t\t\t_, _ = tx.ExecContext(ctx, `UPDATE chat_av_raw_receipts SET decision='error',code='conflicting_receipt' WHERE trace_id=?`, v.TraceID)\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tif e != sql.ErrNoRows {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar pending int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_av_jobs WHERE phase IN ('raw_started','raw_wait') AND expires_at>UTC_TIMESTAMP(6)`).Scan(&pending) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif pending == 0 {\n\t\treturn nil\n\t}\n\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_av_raw_receipts(trace_id,app_id,decision,code,fingerprint,created_at) VALUES(?,?,?,?,?,UTC_TIMESTAMP(6))`, v.TraceID, v.AppID, v.Decision, v.Code, v.Fingerprint); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (a *AVService) rawResult(ctx context.Context, v avJob) error {\n\tvar decision string\n\te := a.base.db.QueryRowContext(ctx, `SELECT decision FROM chat_av_raw_receipts WHERE trace_id=? AND app_id=?`, v.RawTrace, a.inspector.MediaAppID()).Scan(&decision)\n\tif e == sql.ErrNoRows {\n\t\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET lease_owner=NULL,lease_until=NULL,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 15 SECOND WHERE intent_id=? AND lease_owner=?`, string(v.ID), v.Owner)\n\t\treturn nil\n\t}\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, e = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET raw_decision=? WHERE intent_id=? AND lease_owner=?`, decision, string(v.ID), v.Owner); e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tswitch decision {\n\tcase \"pass\":\n\t\treturn a.advance(ctx, v, \"ready\")\n\tcase \"review\":\n\t\treturn a.reviewPending(ctx, v)\n\tcase \"risky\":\n\t\tq := v.Request\n\t\tq.Text = v.Transcript\n\t\tchecked := ports.SafetyResult{Decision: \"blocked\", RuleVersion: v.TextRule, AuthorityProof: v.Proof, Finding: &ports.SafetyFinding{Provider: \"wechat.media_check_async.v2\", Code: \"official_risky\", TraceID: v.RawTrace, Level: 2, Confirmed: true}}\n\t\t_, e = a.base.reject(ctx, v.Principal, q, v.Hash, v.ID, v.Owner, checked)\n\t\tif e == nil {\n\t\t\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_uploads SET legal_hold=1 WHERE id=?`, string(v.Upload))\n\t\t\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='failed',lease_owner=NULL,lease_until=NULL WHERE intent_id=?`, string(v.ID))\n\t\t}\n\t\treturn e\n\tdefault:\n\t\ta.fail(ctx, v.ID, v.Owner, ErrCheck.Error())\n\t\treturn ErrCheck\n\t}\n}\n\nvar _ = time.Second\n","chat/internal/message/av_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\ntype avMemory struct{ *imageMemory }\n\nfunc (s avMemory) Keep(ctx context.Context, key string) error {\n\t_, e := s.Read(ctx, key, MaxVideoBytes)\n\treturn e\n}\nfunc (s avMemory) GrantAVPart(ctx context.Context, key string, size int64) (string, string, error) {\n\treturn s.Grant(ctx, key, size)\n}\nfunc (s avMemory) PutAV(ctx context.Context, key string, b []byte, mime string) error {\n\treturn s.Put(ctx, key, b, mime)\n}\nfunc (s avMemory) StatAV(ctx context.Context, key string) (int64, error) {\n\tb, e := s.Read(ctx, key, MaxVideoBytes)\n\treturn int64(len(b)), e\n}\nfunc (s avMemory) InspectionURL(ctx context.Context, key string) (string, error) {\n\treturn \"https://private.fixture.invalid/\" + key, nil\n}\n\ntype avProcessorFunc func(context.Context, []byte, string, string) (AVArtifact, error)\n\nfunc (f avProcessorFunc) Process(c context.Context, b []byte, k, s string) (AVArtifact, error) {\n\treturn f(c, b, k, s)\n}\n\ntype avInspectorFixture struct {\n\tasrCalls, rawCalls atomic.Int32\n\tunknown            bool\n}\n\nfunc (f *avInspectorFixture) MediaAppID() string { return \"wx0123456789abcdef\" }\nfunc (f *avInspectorFixture) Recognize(context.Context, ports.AudioInspectionRequest) (ports.Transcription, error) {\n\tf.asrCalls.Add(1)\n\tif f.unknown {\n\t\treturn ports.Transcription{Dispatched: true}, ErrCheck\n\t}\n\treturn ports.Transcription{Text: \"正在施工\", RequestID: \"request-1\", AuthorityProof: strings.Repeat(\"a\", 64), ServiceID: \"fixture\", APIName: \"verified_api\", Engine: \"16k_zh\", Known: true, Dispatched: true}, nil\n}\nfunc (f *avInspectorFixture) SubmitAudio(context.Context, ports.AudioInspectionRequest) (ports.AudioTicket, error) {\n\tf.rawCalls.Add(1)\n\treturn ports.AudioTicket{TraceID: \"fixture-trace\", AuthorityProof: strings.Repeat(\"a\", 64), Known: true, Dispatched: true}, nil\n}\nfunc avFixture(t *testing.T, kind string) (*fixtureDB, *Service, *AVService, avMemory, *avInspectorFixture, Request) {\n\tf, s, q := setupMessage(t, safetyFunc(func(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\t\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: \"av-text-fixture\", AuthorityProof: strings.Repeat(\"a\", 64)}, nil\n\t}))\n\tstorage := avMemory{&imageMemory{objects: map[string][]byte{}}}\n\tinspector := &avInspectorFixture{}\n\ta, e := NewAVService(s, storage, avProcessorFunc(func(ctx context.Context, b []byte, kind, source string) (AVArtifact, error) {\n\t\tout := AVArtifact{Main: []byte(\"canonical:\" + string(b)), DurationMS: 1500, HasAudio: true, QRDecision: \"clear\", MIME: \"audio/mpeg\"}\n\t\tout.Segments = [][]byte{out.Main}\n\t\tif kind == \"video\" {\n\t\t\tout.MIME = \"video/mp4\"\n\t\t\tout.Poster = []byte(\"poster\")\n\t\t\tout.Frames = []AVFrameArtifact{{Body: []byte(\"sample\"), AtMS: 0}}\n\t\t\tout.Segments = [][]byte{[]byte(\"full-audio\")}\n\t\t\tout.DurationMS = 120000\n\t\t}\n\t\treturn out, nil\n\t}), inspector, \"test\", strings.Repeat(\"c\", 64), true, true, 2000)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = s.AttachAV(a); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tq.Text = \"\"\n\tq.MessageType = kind\n\tq.Revision = 1\n\treturn f, s, a, storage, inspector, q\n}\nfunc avSubmit(t *testing.T, a *AVService, storage avMemory, q Request) Request {\n\tt.Helper()\n\tctx := context.Background()\n\tsource := \"voice\"\n\tif q.MessageType == \"video\" {\n\t\tsource = \"album\"\n\t}\n\tbody := []byte(\"source\")\n\tu, e := a.Upload(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID, source, int64(len(body)), fileMD5(body))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tq.Items = []MediaItem{{AttachmentID: u.AttachmentID, ObjectVersion: u.ObjectVersion}}\n\tif _, e = a.Send(ctx, principal(\"10202\"), q); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tg, e := a.Part(ctx, principal(\"10202\"), q.ConversationID, u.AttachmentID, 1, false)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = storage.Put(ctx, g.Key, body, \"application/octet-stream\"); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = a.Part(ctx, principal(\"10202\"), q.ConversationID, u.AttachmentID, 1, true); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = a.Complete(ctx, principal(\"10202\"), q.ConversationID, u.AttachmentID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\treturn q\n}\nfunc avSteps(t *testing.T, a *AVService, n int) {\n\tt.Helper()\n\tfor i := 0; i < n; i++ {\n\t\tif e := a.ProcessOne(context.Background()); e != nil {\n\t\t\tt.Fatal(\"process\", i, e)\n\t\t}\n\t}\n}\nfunc TestMySQLAVAudioReceiptPublicationCacheRecall(t *testing.T) {\n\tf, s, a, storage, inspector, q := avFixture(t, \"audio\")\n\tctx := context.Background()\n\tq = avSubmit(t, a, storage, q)\n\tnoMessages(t, f)\n\tavSteps(t, a, 5)\n\tif inspector.asrCalls.Load() != 1 || inspector.rawCalls.Load() != 1 {\n\t\tt.Fatal(\"duplicate or omitted checks\")\n\t}\n\tif f.text(\"SELECT phase FROM chat_av_jobs\") != \"raw_wait\" {\n\t\tt.Fatal(\"missing callback published\")\n\t}\n\tif e := a.ReceiveAudio(ctx, ports.AudioReceipt{AppID: inspector.MediaAppID(), TraceID: \"fixture-trace\", Decision: \"pass\", Code: \"official_pass\", Fingerprint: strings.Repeat(\"e\", 64)}); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tf.exec(\"UPDATE chat_av_jobs SET next_attempt_at=UTC_TIMESTAMP(6)\")\n\tavSteps(t, a, 2)\n\tr, e := s.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif e != nil || r.State != \"accepted\" {\n\t\tt.Fatal(r, e)\n\t}\n\tif f.text(\"SELECT retention_mode FROM chat_messages\") != \"permanent\" || f.text(\"SELECT COUNT(*) FROM chat_messages WHERE expires_at IS NOT NULL\") != \"0\" {\n\t\tt.Fatal(\"audio not permanent\")\n\t}\n\tagain, e := s.Send(ctx, principal(\"10202\"), q)\n\tif e != nil || again.MessageID != r.MessageID || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"not idempotent\", e)\n\t}\n\taccess, e := a.URL(ctx, principal(\"10203\"), q.ConversationID, r.MessageID, false)\n\tif e != nil || access.RetentionMode != \"permanent\" || access.ObjectHash == \"\" {\n\t\tt.Fatal(access, e)\n\t}\n\tif e = a.Listened(ctx, principal(\"10203\"), q.ConversationID, r.MessageID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads WHERE read_seq>0\") != \"0\" {\n\t\tt.Fatal(\"playback advanced read\")\n\t}\n\tif _, e = s.Recall(ctx, principal(\"10202\"), q.ConversationID, r.MessageID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = a.URL(ctx, principal(\"10203\"), q.ConversationID, r.MessageID, false); e == nil {\n\t\tt.Fatal(\"recalled media accessible\")\n\t}\n}\nfunc TestMySQLAVUnknownRecognitionNeverBlindlyResubmits(t *testing.T) {\n\tf, _, a, storage, inspector, q := avFixture(t, \"audio\")\n\tinspector.unknown = true\n\tavSubmit(t, a, storage, q)\n\tavSteps(t, a, 1)\n\tif e := a.ProcessOne(context.Background()); e != ErrAVUnknown {\n\t\tt.Fatal(e)\n\t}\n\tf.exec(\"UPDATE chat_av_jobs SET next_attempt_at=UTC_TIMESTAMP(6),lease_until=NULL\")\n\tavSteps(t, a, 3)\n\tif inspector.asrCalls.Load() != 1 || f.text(\"SELECT phase FROM chat_av_jobs\") != \"unknown\" {\n\t\tt.Fatal(\"unknown external request resubmitted\")\n\t}\n\tnoMessages(t, f)\n}\nfunc TestMySQLAVVideoFullPrereviewAndCancellationWin(t *testing.T) {\n\tf, _, a, storage, _, q := avFixture(t, \"video\")\n\tq = avSubmit(t, a, storage, q)\n\tavSteps(t, a, 4)\n\tnoMessages(t, f)\n\tif f.text(\"SELECT phase FROM chat_av_jobs\") != \"review_pending\" {\n\t\tt.Fatal(\"video bypassed review\")\n\t}\n\tif _, e := a.Status(context.Background(), principal(\"10202\"), q.ConversationID, q.ClientMessageID, true); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tf.exec(\"UPDATE chat_av_jobs SET phase='ready',review_state='approved',general_confirmed=1,group_confirmed=1\")\n\tif r, e := a.Publish(context.Background(), ports.ID(f.text(\"SELECT CAST(intent_id AS CHAR) FROM chat_av_jobs\"))); e == nil && r.State == \"accepted\" {\n\t\tt.Fatal(\"cancel overridden\")\n\t}\n\tnoMessages(t, f)\n}\nfunc TestMySQLAVQuotaAndUnconfirmedUploadNeverPublishes(t *testing.T) {\n\tf, _, a, _, _, q := avFixture(t, \"video\")\n\tfor i := 0; i < 4; i++ {\n\t\tif _, e := a.Upload(context.Background(), principal(\"10202\"), q.ConversationID, client(500+i), \"album\", 20<<20, strings.Repeat(\"a\", 32)); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t}\n\tif _, e := a.Upload(context.Background(), principal(\"10202\"), q.ConversationID, client(600), \"album\", 20<<20, strings.Repeat(\"a\", 32)); e != ports.ErrBusy {\n\t\tt.Fatal(\"active upload bound\", e)\n\t}\n\tif _, e := a.Upload(context.Background(), principal(\"10202\"), q.ConversationID, client(601), \"album\", (20<<20)+1, strings.Repeat(\"a\", 32)); e != ErrAVLimit {\n\t\tt.Fatal(\"byte limit\", e)\n\t}\n\tavSteps(t, a, 2)\n\tnoMessages(t, f)\n}\n\nvar _ = time.Second\n\nfunc TestMySQLAVVideoCloudExpiryKeepsMessagePosterAndFrames(t *testing.T) {\n\tf, service, a, storage, _, q := avFixture(t, \"video\")\n\tctx := context.Background()\n\tq = avSubmit(t, a, storage, q)\n\tavSteps(t, a, 4)\n\tf.exec(\"INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(90001,'av-review-fixture','fixture','operations','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\")\n\tf.exec(`INSERT INTO chat_admin_sessions(id,admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(90001,90001,REPEAT('a',64),REPEAT('b',64),REPEAT('c',64),'[\"chat:audit\",\"chat:moderate\",\"chat:media\",\"chat:evidence\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())`)\n\tadmin := mediaAdmin()\n\tadmin.Scopes = []string{\"chat:audit\", \"chat:moderate\", \"chat:media\", \"chat:evidence\"}\n\tlist, e := a.Reviews(ctx, admin, \"0\")\n\tif e != nil || len(list) != 1 {\n\t\tt.Fatal(list, e)\n\t}\n\tv, e := a.Review(ctx, admin, list[0].IntentID, list[0].Version, \"claim\", \"完整音视频预审\", false, false)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = a.Review(ctx, admin, v.IntentID, v.Version, \"approve\", \"未打开媒体\", true, true); e != ErrMedia {\n\t\tt.Fatal(\"unseen approval\", e)\n\t}\n\tif _, e = a.ReviewURL(ctx, admin, v.IntentID, v.Version); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = a.Review(ctx, admin, v.IntentID, v.Version, \"approve\", \"完整画面及原声与引流检查通过\", true, true); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tavSteps(t, a, 1)\n\tresult, e := service.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif e != nil || result.State != \"accepted\" {\n\t\tt.Fatal(result, e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 61 DAY,expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 DAY WHERE id=?\", string(result.MessageID))\n\taccess, e := a.URL(ctx, principal(\"10203\"), q.ConversationID, result.MessageID, false)\n\tif e != nil || access.CloudAvailable || access.URL != \"\" || access.ObjectHash == \"\" {\n\t\tt.Fatal(\"cache authorization after deadline\", access, e)\n\t}\n\tif e = service.CleanCloudOne(ctx); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tmain := f.text(\"SELECT main_key FROM chat_av_uploads\")\n\tposter := f.text(\"SELECT poster_key FROM chat_av_uploads\")\n\tstorage.mu.Lock()\n\t_, mainExists := storage.objects[main]\n\t_, posterExists := storage.objects[poster]\n\tstorage.mu.Unlock()\n\tif mainExists || !posterExists {\n\t\tt.Fatal(\"cloud video or poster cleanup\")\n\t}\n\tcover, e := a.URL(ctx, principal(\"10203\"), q.ConversationID, result.MessageID, true)\n\tif e != nil || !cover.CloudAvailable || cover.URL == \"\" {\n\t\tt.Fatal(\"poster lost\", e)\n\t}\n\tframe, e := a.URL(ctx, principal(\"10203\"), q.ConversationID, result.MessageID, false, 0)\n\tif e != nil || !frame.CloudAvailable || frame.MIME != \"image/jpeg\" {\n\t\tt.Fatal(\"sample picture lost\", frame, e)\n\t}\n\tif f.text(\"SELECT state FROM chat_messages\") != \"published\" || f.text(\"SELECT CAST(state_version AS CHAR) FROM chat_messages\") != \"1\" || f.text(\"SELECT COUNT(*) FROM chat_av_items\") != \"1\" {\n\t\tt.Fatal(\"cloud expiry changed message authority\")\n\t}\n\tif _, e = a.URL(ctx, principal(\"10203\"), q.ConversationID, result.MessageID, false); e != nil {\n\t\tt.Fatal(\"cloud deletion denied cached access\", e)\n\t}\n\tif _, e = service.Recall(ctx, principal(\"10202\"), q.ConversationID, result.MessageID); e != ErrRecallWindow {\n\t\tt.Fatal(\"cloud expiry changed recall window\", e)\n\t}\n}\n","chat/internal/message/av_publish.go":"package message\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/storagepolicy\"\n\t\"strings\"\n\t\"time\"\n)\n\nfunc (a *AVService) Publish(ctx context.Context, id ports.ID) (Result, error) {\n\tv, e := a.job(ctx, id)\n\tp, q := v.Principal, v.Request\n\tif e != nil {\n\t\tif e == policy.ErrDenied {\n\t\t\ta.rejectAV(ctx, id, e.Error())\n\t\t}\n\t\treturn Result{}, e\n\t}\n\tfp, e := avFingerprint(q)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Immutable delivery bytes are checked again before the final business transaction.\n\tfor _, object := range []struct{ key, hash string }{{v.Main, v.MainHash}, {v.Poster, v.PosterHash}} {\n\t\tif object.key == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tb, err := a.storage.Read(ctx, object.key, MaxVideoBytes)\n\t\tif err != nil || mediaHash(b) != object.hash || a.storage.Keep(ctx, object.key) != nil {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t}\n\tchecked := ports.SafetyResult{Decision: \"passed\", RuleVersion: v.TextRule, AuthorityProof: v.TextProof}\n\tif strings.TrimSpace(v.Transcript) == \"\" {\n\t\tchecked.Decision = \"media_identity\"\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := a.base.authorize(ctx, tx, p, q.ConversationID, checked)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\tif e == ErrRestricted || e == policy.ErrDenied {\n\t\t\ta.rejectAV(ctx, id, e.Error())\n\t\t}\n\t\treturn Result{}, e\n\t}\n\ti, e := a.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif i == nil || i.id != id || i.fingerprint != fp {\n\t\treturn Result{}, ErrConflict\n\t}\n\tif i.result.State == \"accepted\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn i.result, nil\n\t}\n\tif i.result.State == \"rejected\" || i.result.State == \"canceled\" {\n\t\treturn i.result, nil\n\t}\n\tvar hash, review, rule, phase, configuration, raw string\n\tvar general, anti, live bool\n\te = tx.QueryRowContext(ctx, `SELECT manifest_hash,review_state,rule_version,phase,configuration_hash,COALESCE(raw_decision,''),general_confirmed,group_confirmed,expires_at>UTC_TIMESTAMP(6) FROM chat_av_jobs WHERE intent_id=? FOR UPDATE`, string(id)).Scan(&hash, &review, &rule, &phase, &configuration, &raw, &general, &anti, &live)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif !live || !active(q.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tapproved := review == \"approved\" && general && anti\n\tif hash != fp || rule != AVRule || configuration != a.configuration || phase != \"ready\" || q.MessageType == \"video\" && !approved || q.MessageType == \"audio\" && (raw != \"pass\" && !(raw == \"review\" && approved)) {\n\t\treturn Result{}, ErrMedia\n\t}\n\tif v.TextProof != v.Proof || !isMediaHash(v.Proof) {\n\t\treturn Result{}, ErrMedia\n\t}\n\tif q.MessageType == \"audio\" {\n\t\tvar actual string\n\t\tif tx.QueryRowContext(ctx, `SELECT decision FROM chat_av_raw_receipts WHERE trace_id=? AND app_id=? LOCK IN SHARE MODE`, v.RawTrace, a.inspector.MediaAppID()).Scan(&actual) != nil || actual != raw {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t}\n\tif _, e = validateReferences(ctx, tx, p, q, g); e != nil {\n\t\ttx.Rollback()\n\t\ta.rejectAV(ctx, id, e.Error())\n\t\treturn Result{}, e\n\t}\n\tvar uploadVersion, state string\n\tif tx.QueryRowContext(ctx, `SELECT object_version,state FROM chat_av_uploads WHERE id=? AND actor_id=? AND conversation_id=? LOCK IN SHARE MODE`, string(v.Upload), string(p.ActorID), string(q.ConversationID)).Scan(&uploadVersion, &state) != nil || uploadVersion != v.Version || state != \"prepared\" {\n\t\treturn Result{}, ErrMedia\n\t}\n\tvar seq, change uint64\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=?`, string(q.ConversationID)).Scan(&seq, &change) != nil || seq == ^uint64(0) || change == ^uint64(0) {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tseq++\n\tchange++\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_messages(conversation_id,seq,sender_id,client_message_id,policy_version,message_type,state,state_version,safety_rule_version,created_at,reply_to_message_id,reply_to_item_id) VALUES(?,?,?,?,?,?,'published',1,?,UTC_TIMESTAMP(6),?,?)`, string(q.ConversationID), seq, string(p.ActorID), q.ClientMessageID, string(g.Version), q.MessageType, AVRule, nullableID(q.ReplyTo), nullableID(q.ReplyItem))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tmid, e := res.LastInsertId()\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif e = storagepolicy.Stamp(ctx, tx, mid, q.MessageType); e != nil {\n\t\treturn Result{}, e\n\t}\n\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_av_items(message_id,upload_id,object_version) VALUES(?,?,?)`, mid, string(v.Upload), v.Version); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_uploads SET state='published',transcript=? WHERE id=?`, v.Transcript, string(v.Upload)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='published',transcript=NULL,principal_json='{}',lease_owner=NULL,lease_until=NULL WHERE intent_id=?`, string(id)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_asr_requests SET text_result=NULL WHERE intent_id=?`, string(id)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\n\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,1,'message.accepted',UTC_TIMESTAMP(6))`, string(q.ConversationID), change, mid); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_seq=?,last_change_seq=?,last_message_id=?,last_message_at=UTC_TIMESTAMP(6) WHERE id=?`, seq, change, mid, string(q.ConversationID)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='accepted',message_id=?,error_code=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, mid, string(id)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif e = reminderEvent(ctx, tx, q.ConversationID, seq); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar liveCommit bool\n\tif tx.QueryRowContext(ctx, `SELECT expires_at>UTC_TIMESTAMP(6) FROM chat_av_jobs WHERE intent_id=?`, string(id)).Scan(&liveCommit) != nil || !liveCommit || !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif a.base.publisher != nil {\n\t\ta.base.publisher.Committed(ports.CommittedMessage{ConversationID: q.ConversationID, Seq: decimal(seq), PolicyVersion: g.Version})\n\t}\n\treturn Result{ClientMessageID: q.ClientMessageID, State: \"accepted\", MessageID: ports.ID(fmt.Sprint(mid)), Seq: decimal(seq), PolicyVersion: g.Version, StateVersion: \"1\", MessageState: \"published\"}, nil\n}\n\nfunc (a *AVService) rejectAV(ctx context.Context, id ports.ID, code string) {\n\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state IN ('checking','review_pending')`, code, string(id))\n}\n","chat/internal/message/av_review.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n\t\"unicode/utf8\"\n)\n\ntype AVReview struct {\n\tIntentID   ports.ID  `json:\"intent_id\"`\n\tVersion    ports.ID  `json:\"expected_version\"`\n\tHash       string    `json:\"manifest_hash\"`\n\tKind       string    `json:\"message_type\"`\n\tDurationMS int       `json:\"duration_ms\"`\n\tTranscript string    `json:\"transcript\"`\n\tHasAudio   bool      `json:\"has_audio\"`\n\tState      string    `json:\"review_state\"`\n\tExpiresAt  time.Time `json:\"expires_at\"`\n}\n\nfunc (a *AVService) admin(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif p.Environment != a.environment {\n\t\treturn auth.ErrUnauthorized\n\t}\n\tsource, e := auth.NewMySQLSource(a.base.db)\n\tif e != nil {\n\t\treturn e\n\t}\n\treturn source.ValidateAdminLocked(ctx, tx, p, \"chat:media\")\n}\nfunc avAudit(ctx context.Context, tx *sql.Tx, p ports.Principal, id, version ports.ID, action, reason string) error {\n\t_, e := tx.ExecContext(ctx, `INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,target_id,target_version,reason,created_at) VALUES(?,?,?,?,?,?,?,UTC_TIMESTAMP(6))`, p.Kind, string(p.ActorID), p.SessionID, \"av.\"+action, string(id), string(version), reason)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (a *AVService) Reviews(ctx context.Context, p ports.Principal, after ports.ID) ([]AVReview, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tdefer tx.Rollback()\n\tif e = a.admin(ctx, tx, p); e != nil {\n\t\treturn nil, e\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(j.intent_id AS CHAR),CAST(j.review_version AS CHAR),j.manifest_hash,u.kind,u.duration_ms,COALESCE(j.transcript,''),u.has_audio,j.review_state,j.expires_at FROM chat_av_jobs j JOIN chat_av_uploads u ON u.id=j.upload_id JOIN chat_send_intents i ON i.id=j.intent_id WHERE j.intent_id>? AND j.phase='review_pending' AND j.review_state IN ('pending','claimed') AND i.state='review_pending' AND j.expires_at>UTC_TIMESTAMP(6) ORDER BY j.intent_id LIMIT 20`, string(after))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tout := []AVReview{}\n\tfor rows.Next() {\n\t\tvar v AVReview\n\t\tif rows.Scan(&v.IntentID, &v.Version, &v.Hash, &v.Kind, &v.DurationMS, &v.Transcript, &v.HasAudio, &v.State, &v.ExpiresAt) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tout = append(out, v)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil || tx.Commit() != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\nfunc (a *AVService) Review(ctx context.Context, p ports.Principal, id, expected ports.ID, action, reason string, general, group bool) (AVReview, error) {\n\tvar out AVReview\n\tif !validID(id) || !validID(expected) || (action != \"claim\" && action != \"approve\" && action != \"reject\") || utf8.RuneCountInString(reason) < 2 || utf8.RuneCountInString(reason) > 200 {\n\t\treturn out, ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn out, e\n\t}\n\tdefer tx.Rollback()\n\tif e = a.admin(ctx, tx, p); e != nil {\n\t\treturn out, e\n\t}\n\tvar version ports.ID\n\tvar state, hash string\n\tvar reviewer sql.NullString\n\tvar lease bool\n\te = tx.QueryRowContext(ctx, `SELECT CAST(j.review_version AS CHAR),j.review_state,j.manifest_hash,CAST(j.reviewer_id AS CHAR),COALESCE(j.review_lease_until>UTC_TIMESTAMP(6),0) FROM chat_send_intents i JOIN chat_av_jobs j ON j.intent_id=i.id WHERE i.id=? AND i.state='review_pending' AND j.phase='review_pending' AND j.expires_at>UTC_TIMESTAMP(6) AND j.rule_version=? AND j.configuration_hash=? FOR UPDATE`, string(id), AVRule, a.configuration).Scan(&version, &state, &hash, &reviewer, &lease)\n\tif e != nil || version != expected {\n\t\treturn out, ErrMediaVersion\n\t}\n\tif action == \"claim\" {\n\t\tif state != \"pending\" && !(state == \"claimed\" && (!lease || reviewer.String == string(p.ActorID))) {\n\t\t\treturn out, ErrMediaVersion\n\t\t}\n\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET review_state='claimed',reviewer_id=?,review_lease_until=UTC_TIMESTAMP(6)+INTERVAL 5 MINUTE,review_version=review_version+1 WHERE intent_id=?`, string(p.ActorID), string(id))\n\t\tstate = \"claimed\"\n\t} else {\n\t\tif state != \"claimed\" || !lease || reviewer.String != string(p.ActorID) {\n\t\t\treturn out, ErrMediaVersion\n\t\t}\n\t\tif action == \"approve\" {\n\t\t\tvar viewed int\n\t\t\tif !general || !group || tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE action='av.view' AND actor_id=? AND target_id=? AND target_version=? AND session_binding=?`, string(p.ActorID), string(id), string(expected), p.SessionID).Scan(&viewed) != nil || viewed == 0 {\n\t\t\t\treturn out, ErrMedia\n\t\t\t}\n\t\t\tstate = \"approved\"\n\t\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET review_state='approved',general_confirmed=1,group_confirmed=1,review_version=review_version+1,review_lease_until=NULL,phase='ready',next_attempt_at=UTC_TIMESTAMP(6) WHERE intent_id=?`, string(id))\n\t\t} else {\n\t\t\tstate = \"rejected\"\n\t\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET review_state='rejected',review_version=review_version+1,review_lease_until=NULL,phase='failed',error_code=? WHERE intent_id=?`, ErrBlocked.Error(), string(id))\n\t\t\tif e == nil {\n\t\t\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, ErrBlocked.Error(), string(id))\n\t\t\t}\n\t\t}\n\t}\n\tif e != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif e = avAudit(ctx, tx, p, id, expected, action, reason); e != nil {\n\t\treturn out, e\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn AVReview{IntentID: id, Version: decimal(number(version) + 1), Hash: hash, State: state}, nil\n}\nfunc (a *AVService) ReviewURL(ctx context.Context, p ports.Principal, id, version ports.ID) (MediaAccess, error) {\n\tif !validID(id) || !validID(version) {\n\t\treturn MediaAccess{}, ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tdefer tx.Rollback()\n\tif e = a.admin(ctx, tx, p); e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tvar key, hash, mime string\n\tvar expiry time.Time\n\te = tx.QueryRowContext(ctx, `SELECT u.main_key,u.main_sha256,u.mime_type,j.expires_at FROM chat_send_intents i JOIN chat_av_jobs j ON j.intent_id=i.id JOIN chat_av_uploads u ON u.id=j.upload_id WHERE i.id=? AND i.state='review_pending' AND j.phase='review_pending' AND j.review_state='claimed' AND j.reviewer_id=? AND j.review_version=? AND j.review_lease_until>UTC_TIMESTAMP(6) AND j.expires_at>UTC_TIMESTAMP(6) AND j.rule_version=? AND j.configuration_hash=? FOR UPDATE`, string(id), string(p.ActorID), string(version), AVRule, a.configuration).Scan(&key, &hash, &mime, &expiry)\n\tif e != nil {\n\t\treturn MediaAccess{}, ErrMediaVersion\n\t}\n\tttl := min(60*time.Second, time.Until(expiry), time.Until(p.ExpiresAt))\n\tif ttl < time.Second {\n\t\treturn MediaAccess{}, ErrExpired\n\t}\n\turl, e := a.storage.Sign(ctx, key, ttl)\n\tif e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tif e = avAudit(ctx, tx, p, id, version, \"view\", \"已领取预审媒体临时访问\"); e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tif tx.Commit() != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\treturn MediaAccess{CloudAvailable: true, URL: url, ExpiresAt: time.Now().Add(ttl).Unix(), MIME: mime, ObjectHash: hash, StateVersion: version, ServerTime: time.Now().UTC()}, nil\n}\n","chat/internal/message/av_test.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestAVLimitsAndImmutableIdentity(t *testing.T) {\n\tfor _, v := range []struct {\n\t\tsource   string\n\t\tsize     int64\n\t\tduration int\n\t}{{\"voice\", 1 << 20, 60000}, {\"camera\", 8 << 20, 30000}, {\"album\", 20 << 20, 120000}, {\"other\", 0, 0}} {\n\t\tsize, d := avLimits(v.source)\n\t\tif size != v.size || d != v.duration {\n\t\t\tt.Fatal(v.source)\n\t\t}\n\t}\n\tfor _, size := range []int64{1, 4 << 20, (4 << 20) + 1, 20 << 20} {\n\t\tvar sum int64\n\t\tfor i := 1; i <= avParts(size); i++ {\n\t\t\tn := avPartSize(size, i)\n\t\t\tif n < 1 || n > 4<<20 {\n\t\t\t\tt.Fatal(size, i, n)\n\t\t\t}\n\t\t\tsum += n\n\t\t}\n\t\tif sum != size {\n\t\t\tt.Fatal(\"part sum\")\n\t\t}\n\t}\n\tq := Request{ConversationID: \"3\", ClientMessageID: client(400), MessageType: \"video\", Revision: 1, Items: []MediaItem{{AttachmentID: \"8\", ObjectVersion: strings.Repeat(\"a\", 64)}}}\n\tfp, e := avFingerprint(q)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tq.ReplyTo = \"7\"\n\tchanged, _ := avFingerprint(q)\n\tif changed == fp {\n\t\tt.Fatal(\"reply not bound\")\n\t}\n\tq.Items[0].ObjectVersion = strings.Repeat(\"b\", 64)\n\tnext, _ := avFingerprint(q)\n\tif next == changed {\n\t\tt.Fatal(\"version not bound\")\n\t}\n\tq.Items[0].Ordinal = 1\n\tif _, e = avFingerprint(q); e == nil {\n\t\tt.Fatal(\"invalid ordinal\")\n\t}\n\tq.Items[0].Ordinal = 0\n\tq.Text = \"client transcript\"\n\tif _, e = avFingerprint(q); e == nil {\n\t\tt.Fatal(\"untrusted transcript\")\n\t}\n}\nfunc TestAVWireDecode(t *testing.T) {\n\tq := Request{ConversationID: \"3\", ClientMessageID: client(401), MessageType: \"audio\", Revision: 1, Items: []MediaItem{{AttachmentID: \"8\", ObjectVersion: strings.Repeat(\"a\", 64)}}}\n\traw, _ := json.Marshal(q)\n\tif _, e := decode(raw, false); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tbad := strings.Replace(string(raw), `\"ordinal\":0`, `\"ordinal\":0,\"ordinal\":0`, 1)\n\tif _, e := decode([]byte(bad), false); e == nil {\n\t\tt.Fatal(\"duplicate ordinal accepted\")\n\t}\n\tif _, e := decode([]byte(strings.Replace(string(raw), `\"revision\":1`, `\"revision\":0`, 1)), false); e == nil {\n\t\tt.Fatal(\"zero revision\")\n\t}\n}\n\nvar _ = time.Second\n","chat/internal/message/av_upload.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/storagepolicy\"\n\t\"strconv\"\n\t\"time\"\n)\n\nfunc validFileMD5(v string) bool {\n\tb, e := hex.DecodeString(v)\n\treturn e == nil && len(b) == 16 && v == hex.EncodeToString(b)\n}\nfunc (a *AVService) Upload(ctx context.Context, p ports.Principal, cid ports.ID, client, source string, size int64, digest string) (AVUpload, error) {\n\tlimit, _ := avLimits(source)\n\tkind := avKind(source)\n\tif !validID(cid) || !validClient(client) || !active(client, time.Now()) || !validFileMD5(digest) || limit == 0 || size < 1 || size > limit || !a.enabled(kind) {\n\t\treturn AVUpload{}, ErrAVLimit\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn AVUpload{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = a.base.authorize(ctx, tx, p, cid); e != nil {\n\t\treturn AVUpload{}, e\n\t}\n\tvar u AVUpload\n\tvar declared int64\n\tvar oldSource, oldMD5 string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),object_version,state,part_count,expires_at,declared_bytes,source,source_md5 FROM chat_av_uploads WHERE actor_id=? AND conversation_id=? AND upload_id=? FOR UPDATE`, string(p.ActorID), string(cid), client).Scan(&u.AttachmentID, &u.ObjectVersion, &u.State, &u.PartCount, &u.ExpiresAt, &declared, &oldSource, &oldMD5)\n\tif e == sql.ErrNoRows {\n\t\tvar pending, count int\n\t\tvar bytes int64\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_av_uploads WHERE actor_id=? AND state IN ('uploading','uploaded','preparing') AND expires_at>UTC_TIMESTAMP(6)`, string(p.ActorID)).Scan(&pending) != nil || pending >= 4 {\n\t\t\treturn AVUpload{}, ports.ErrBusy\n\t\t}\n\t\tsettings, err := storagepolicy.Load(ctx, tx)\n\t\tif err != nil {\n\t\t\treturn AVUpload{}, ports.ErrUnavailable\n\t\t}\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*),COALESCE(SUM(declared_bytes),0) FROM chat_av_uploads u WHERE actor_id=? AND kind=? AND created_at>UTC_TIMESTAMP(6)-INTERVAL 1 DAY AND (state<>'canceled' OR EXISTS(SELECT 1 FROM chat_av_parts p WHERE p.upload_id=u.id AND p.grant_until IS NOT NULL))`, string(p.ActorID), kind).Scan(&count, &bytes) != nil {\n\t\t\treturn AVUpload{}, ports.ErrUnavailable\n\t\t}\n\t\tif kind == \"video\" && (count >= settings.Policy.Quota.VideoCount || bytes+size > settings.Policy.Quota.VideoBytes) || kind == \"audio\" && (count >= 200 || bytes+size > 200<<20) {\n\t\t\treturn AVUpload{}, ports.ErrBusy\n\t\t}\n\t\tu.ObjectVersion = randomMedia()\n\t\tif u.ObjectVersion == \"\" {\n\t\t\treturn AVUpload{}, ports.ErrUnavailable\n\t\t}\n\t\tu.State = \"uploading\"\n\t\tu.PartCount = avParts(size)\n\t\tu.ExpiresAt = minTime(time.Now().UTC().Add(MediaTTL), expires(client))\n\t\tresult, err := tx.ExecContext(ctx, `INSERT INTO chat_av_uploads(actor_id,conversation_id,upload_id,object_version,kind,source,declared_bytes,source_md5,part_count,state,expires_at,created_at) VALUES(?,?,?,?,?,?,?,?,?,'uploading',?,UTC_TIMESTAMP(6))`, string(p.ActorID), string(cid), client, u.ObjectVersion, kind, source, size, digest, u.PartCount, u.ExpiresAt)\n\t\tif err != nil {\n\t\t\treturn AVUpload{}, ports.ErrUnavailable\n\t\t}\n\t\tn, err := result.LastInsertId()\n\t\tif err != nil || n <= 0 {\n\t\t\treturn AVUpload{}, ports.ErrUnavailable\n\t\t}\n\t\tu.AttachmentID = ports.ID(fmt.Sprint(n))\n\t\tfor i := 1; i <= u.PartCount; i++ {\n\t\t\tkey := \"chatav/\" + a.environment + \"/\" + string(p.ActorID) + \"/\" + u.ObjectVersion + \"/part-\" + strconv.Itoa(i)\n\t\t\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_av_parts(upload_id,ordinal,object_key,size_bytes,state,created_at) VALUES(?,?,?,?,'allocated',UTC_TIMESTAMP(6))`, string(u.AttachmentID), i, key, avPartSize(size, i)); e != nil {\n\t\t\t\treturn AVUpload{}, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t} else if e != nil {\n\t\treturn AVUpload{}, ports.ErrUnavailable\n\t} else if declared != size || oldSource != source || oldMD5 != digest {\n\t\treturn AVUpload{}, ErrConflict\n\t} else if !time.Now().Before(u.ExpiresAt) || u.State == \"canceled\" {\n\t\treturn AVUpload{}, ErrExpired\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn AVUpload{}, ports.ErrUnavailable\n\t}\n\tu.PartBytes = AVPartBytes\n\treturn u, nil\n}\nfunc minTime(a, b time.Time) time.Time {\n\tif a.Before(b) {\n\t\treturn a\n\t}\n\treturn b\n}\nfunc (a *AVService) Send(ctx context.Context, p ports.Principal, q Request) (Result, error) {\n\tfp, e := avFingerprint(q)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = a.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"}); e != nil {\n\t\treturn Result{}, e\n\t}\n\tprevious, e := a.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif previous != nil {\n\t\tif previous.result.State != \"canceled\" && previous.fingerprint != fp {\n\t\t\treturn Result{}, ErrConflict\n\t\t}\n\t\tif !active(q.ClientMessageID, time.Now()) && !terminal(previous.result.State) {\n\t\t\treturn Result{}, ErrExpired\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn previous.result, nil\n\t}\n\ttx.Rollback()\n\tif !a.enabled(q.MessageType) || !active(q.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\ttx, e = a.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := a.base.authorize(ctx, tx, p, q.ConversationID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tprevious, e = a.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif previous != nil {\n\t\tif previous.result.State != \"canceled\" && previous.fingerprint != fp {\n\t\t\treturn Result{}, ErrConflict\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn previous.result, nil\n\t}\n\titem := q.Items[0]\n\tvar kind, version, state, uploadNonce string\n\tvar live bool\n\tif tx.QueryRowContext(ctx, `SELECT kind,object_version,state,upload_id,expires_at>UTC_TIMESTAMP(6) FROM chat_av_uploads WHERE id=? AND actor_id=? AND conversation_id=? FOR UPDATE`, string(item.AttachmentID), string(p.ActorID), string(q.ConversationID)).Scan(&kind, &version, &state, &uploadNonce, &live) != nil {\n\t\treturn Result{}, ErrMedia\n\t}\n\tif !live || kind != q.MessageType || version != item.ObjectVersion || state != \"uploading\" || uploadNonce != q.ClientMessageID {\n\t\treturn Result{}, ErrMediaVersion\n\t}\n\tif _, e = validateReferences(ctx, tx, p, q, g); e != nil {\n\t\treturn Result{}, e\n\t}\n\tprincipal, _ := json.Marshal(p)\n\tmanifest, _ := json.Marshal(q)\n\tdeadline := expires(q.ClientMessageID)\n\tresult, e := tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,attempts,action_expires_at,retain_until,created_at,updated_at) VALUES(?,?,?,?,'checking',0,?,?,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(q.ConversationID), q.ClientMessageID, fp, deadline, deadline.Add(MinimumRetention))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tn, e := result.LastInsertId()\n\tif e != nil || n <= 0 {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_av_jobs(intent_id,upload_id,principal_json,manifest_json,manifest_hash,rule_version,configuration_hash,phase,next_attempt_at,expires_at,submitted_at) VALUES(?,?,?,?,?,?,?,'uploading',UTC_TIMESTAMP(6),?,UTC_TIMESTAMP(6))`, n, string(item.AttachmentID), string(principal), string(manifest), fp, AVRule, a.configuration, deadline); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_uploads SET expires_at=? WHERE id=?`, deadline, string(item.AttachmentID)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif !active(q.ClientMessageID, time.Now()) || !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\treturn Result{ClientMessageID: q.ClientMessageID, State: \"checking\"}, nil\n}\nfunc (a *AVService) Part(ctx context.Context, p ports.Principal, cid, upload ports.ID, ordinal int, confirm bool) (AVPartGrant, error) {\n\tif !validID(cid) || !validID(upload) || ordinal < 1 || ordinal > 10 {\n\t\treturn AVPartGrant{}, ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn AVPartGrant{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = a.base.authorize(ctx, tx, p, cid); e != nil {\n\t\treturn AVPartGrant{}, e\n\t}\n\tvar key, version, state string\n\tvar size int64\n\tvar deadline time.Time\n\te = tx.QueryRowContext(ctx, `SELECT v.object_key,v.size_bytes,u.object_version,v.state,u.expires_at FROM chat_av_parts v JOIN chat_av_uploads u ON u.id=v.upload_id JOIN chat_av_jobs j ON j.upload_id=u.id JOIN chat_send_intents i ON i.id=j.intent_id WHERE u.id=? AND u.actor_id=? AND u.conversation_id=? AND v.ordinal=? AND u.state='uploading' AND u.expires_at>UTC_TIMESTAMP(6) AND j.phase='uploading' AND j.expires_at>UTC_TIMESTAMP(6) AND i.state='checking' FOR UPDATE`, string(upload), string(p.ActorID), string(cid), ordinal).Scan(&key, &size, &version, &state, &deadline)\n\tif e != nil {\n\t\treturn AVPartGrant{}, ErrMediaVersion\n\t}\n\tif state == \"present\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn AVPartGrant{}, ports.ErrUnavailable\n\t\t}\n\t\treturn AVPartGrant{UploadGrant: UploadGrant{AttachmentID: upload, ObjectVersion: version, State: \"present\"}, Ordinal: ordinal, Size: size}, nil\n\t}\n\tif !confirm {\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_parts SET state='issued',grant_until=UTC_TIMESTAMP(6)+INTERVAL 5 MINUTE WHERE upload_id=? AND ordinal=?`, string(upload), ordinal); e != nil {\n\t\t\treturn AVPartGrant{}, ports.ErrUnavailable\n\t\t}\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn AVPartGrant{}, ports.ErrUnavailable\n\t}\n\tif !confirm && state == \"issued\" {\n\t\tactual, err := a.storage.StatAV(ctx, key)\n\t\tif err == nil && actual == size {\n\t\t\treturn a.Part(ctx, p, cid, upload, ordinal, true)\n\t\t}\n\t\tif err == nil {\n\t\t\treturn AVPartGrant{}, ErrMedia\n\t\t}\n\t}\n\tif confirm {\n\t\tactual, err := a.storage.StatAV(ctx, key)\n\t\tif err != nil || actual != size {\n\t\t\treturn AVPartGrant{}, ErrMedia\n\t\t}\n\t\ttx, e = a.base.begin(ctx)\n\t\tif e != nil {\n\t\t\treturn AVPartGrant{}, e\n\t\t}\n\t\tdefer tx.Rollback()\n\t\tif _, e = a.base.authorize(ctx, tx, p, cid); e != nil {\n\t\t\treturn AVPartGrant{}, e\n\t\t}\n\t\tresult, err := tx.ExecContext(ctx, `UPDATE chat_av_parts v JOIN chat_av_uploads u ON u.id=v.upload_id JOIN chat_av_jobs j ON j.upload_id=u.id JOIN chat_send_intents i ON i.id=j.intent_id SET v.state='present' WHERE u.id=? AND v.ordinal=? AND u.actor_id=? AND u.conversation_id=? AND u.state='uploading' AND j.phase='uploading' AND j.expires_at>UTC_TIMESTAMP(6) AND i.state='checking'`, string(upload), ordinal, string(p.ActorID), string(cid))\n\t\tif err != nil {\n\t\t\treturn AVPartGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tn, _ := result.RowsAffected()\n\t\tif n != 1 {\n\t\t\treturn AVPartGrant{}, ErrMediaVersion\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn AVPartGrant{}, ports.ErrUnavailable\n\t\t}\n\t\treturn AVPartGrant{UploadGrant: UploadGrant{AttachmentID: upload, ObjectVersion: version, State: \"present\"}, Ordinal: ordinal, Size: size}, nil\n\t}\n\ttoken, host, e := a.storage.GrantAVPart(ctx, key, size)\n\tif e != nil {\n\t\treturn AVPartGrant{}, e\n\t}\n\treturn AVPartGrant{UploadGrant: UploadGrant{AttachmentID: upload, ObjectVersion: version, Key: key, Token: token, Host: host, ExpiresAt: time.Now().Add(5 * time.Minute).Unix(), State: \"issued\"}, Ordinal: ordinal, Size: size}, nil\n}\nfunc (a *AVService) Complete(ctx context.Context, p ports.Principal, cid, upload ports.ID) error {\n\tif !validID(cid) || !validID(upload) {\n\t\treturn ports.ErrInvalid\n\t}\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = a.base.authorize(ctx, tx, p, cid); e != nil {\n\t\treturn e\n\t}\n\tvar state string\n\tvar count int\n\tif tx.QueryRowContext(ctx, `SELECT state,part_count FROM chat_av_uploads WHERE id=? AND actor_id=? AND conversation_id=? AND expires_at>UTC_TIMESTAMP(6) FOR UPDATE`, string(upload), string(p.ActorID), string(cid)).Scan(&state, &count) != nil {\n\t\treturn ErrMedia\n\t}\n\tif state == \"uploaded\" || state == \"prepared\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn nil\n\t}\n\tvar ready int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_av_parts WHERE upload_id=? AND state='present'`, string(upload)).Scan(&ready) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif ready != count || state != \"uploading\" {\n\t\treturn ErrMedia\n\t}\n\tresult, e := tx.ExecContext(ctx, `UPDATE chat_av_jobs j JOIN chat_send_intents i ON i.id=j.intent_id SET j.phase='prepare',j.next_attempt_at=UTC_TIMESTAMP(6) WHERE j.upload_id=? AND j.phase='uploading' AND j.expires_at>UTC_TIMESTAMP(6) AND i.state='checking'`, string(upload))\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := result.RowsAffected()\n\tif n != 1 {\n\t\treturn ErrMedia\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_uploads SET state='uploaded' WHERE id=?`, string(upload)); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/av_worker.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"time\"\n)\n\ntype avSegment struct {\n\tKey  string `json:\"key\"`\n\tHash string `json:\"hash\"`\n}\ntype avJob struct {\n\tID, Upload                                                                                                                ports.ID\n\tPrincipal                                                                                                                 ports.Principal\n\tRequest                                                                                                                   Request\n\tHash, Phase, Owner, Source, Version, Transcript, Proof, TextRule, TextProof, RawTrace, RawDecision, Review, Configuration string\n\tSegments                                                                                                                  []avSegment\n\tOrdinal                                                                                                                   int\n\tMain, MainHash, Poster, PosterHash, MIME                                                                                  string\n\tSize                                                                                                                      int64\n\tDuration                                                                                                                  int\n\tHasAudio                                                                                                                  bool\n}\n\nfunc (a *AVService) job(ctx context.Context, id ports.ID) (avJob, error) {\n\tv := avJob{ID: id}\n\tvar principal, manifest, segments string\n\te := a.base.db.QueryRowContext(ctx, `SELECT CAST(j.upload_id AS CHAR),j.principal_json,j.manifest_json,j.manifest_hash,j.phase,COALESCE(j.lease_owner,''),u.source,u.object_version,COALESCE(j.transcript,''),COALESCE(j.source_proof,''),COALESCE(j.text_rule,''),COALESCE(j.text_proof,''),COALESCE(j.raw_trace_id,''),COALESCE(j.raw_decision,''),j.review_state,j.configuration_hash,COALESCE(j.segments_json,'[]'),j.asr_ordinal,COALESCE(u.main_key,''),COALESCE(u.main_sha256,''),COALESCE(u.poster_key,''),COALESCE(u.poster_sha256,''),COALESCE(u.mime_type,''),u.declared_bytes,u.duration_ms,u.has_audio FROM chat_av_jobs j JOIN chat_av_uploads u ON u.id=j.upload_id WHERE j.intent_id=?`, string(id)).Scan(&v.Upload, &principal, &manifest, &v.Hash, &v.Phase, &v.Owner, &v.Source, &v.Version, &v.Transcript, &v.Proof, &v.TextRule, &v.TextProof, &v.RawTrace, &v.RawDecision, &v.Review, &v.Configuration, &segments, &v.Ordinal, &v.Main, &v.MainHash, &v.Poster, &v.PosterHash, &v.MIME, &v.Size, &v.Duration, &v.HasAudio)\n\tif e != nil || json.Unmarshal([]byte(principal), &v.Principal) != nil || json.Unmarshal([]byte(manifest), &v.Request) != nil || json.Unmarshal([]byte(segments), &v.Segments) != nil || v.Principal.Kind != \"mini\" || v.Principal.Environment != a.environment {\n\t\treturn v, ErrMedia\n\t}\n\tvar expiry int64\n\tif a.base.db.QueryRowContext(ctx, `SELECT UNIX_TIMESTAMP(expires_at) FROM login_sessions WHERE id=? AND user_id=? AND status='active'`, string(v.Principal.SourceID), string(v.Principal.ActorID)).Scan(&expiry) != nil {\n\t\treturn v, ErrRestricted\n\t}\n\tv.Principal.ExpiresAt = time.Unix(expiry, 0)\n\treturn v, nil\n}\nfunc (a *AVService) Run(ctx context.Context) {\n\ttick := time.NewTicker(time.Second)\n\tdefer tick.Stop()\n\tfor {\n\t\tif ctx.Err() != nil {\n\t\t\treturn\n\t\t}\n\t\tpass,cancel:=context.WithTimeout(ctx,80*time.Second)\n  _ = a.ProcessOne(pass)\n  _ = a.CleanOne(pass)\n  cancel()\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t}\n\t}\n}\nfunc (a *AVService) ProcessOne(ctx context.Context) error {\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tvar id ports.ID\n\tvar phase string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(j.intent_id AS CHAR),j.phase FROM chat_av_jobs j JOIN chat_send_intents i ON i.id=j.intent_id WHERE i.state IN ('checking','review_pending') AND j.phase NOT IN ('uploading','review_pending','failed','published','unknown') AND j.expires_at>UTC_TIMESTAMP(6) AND j.next_attempt_at<=UTC_TIMESTAMP(6) AND (j.lease_until IS NULL OR j.lease_until<UTC_TIMESTAMP(6)) ORDER BY j.intent_id LIMIT 1 FOR UPDATE`).Scan(&id, &phase)\n\tif e == sql.ErrNoRows {\n\t\treturn nil\n\t}\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\towner := randomMedia()\n\tif owner == \"\" {\n\t\treturn ports.ErrUnavailable\n\t}\n\towner = owner[:32]\n\tif phase == \"asr_started\" || phase == \"raw_started\" {\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='unknown',error_code=?,lease_owner=NULL,lease_until=NULL WHERE intent_id=?`, ErrAVUnknown.Error(), string(id)); e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, ErrAVUnknown.Error(), string(id))\n\t\tif e != nil || tx.Commit() != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn ErrAVUnknown\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_jobs SET lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 90 SECOND,attempts=LEAST(attempts+1,255) WHERE intent_id=?`, owner, string(id)); e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 90 SECOND WHERE id=?`, owner, string(id)); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tv, e := a.job(ctx, id)\n\tif e != nil {\n\t\ta.fail(ctx, id, owner, e.Error())\n\t\treturn e\n\t}\n\tif v.Owner != owner || v.Configuration != a.configuration {\n\t\ta.fail(ctx, id, owner, ErrMediaVersion.Error())\n\t\treturn ErrMediaVersion\n\t}\n\tauth, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\t_, e = a.base.authorize(ctx, auth, v.Principal, v.Request.ConversationID)\n\tauth.Rollback()\n\tif e != nil {\n\t\ta.fail(ctx, id, owner, e.Error())\n\t\treturn e\n\t}\n\tswitch phase {\n\tcase \"prepare\":\n\t\te = a.prepare(ctx, v)\n\tcase \"asr_ready\":\n\t\te = a.recognize(ctx, v)\n\tcase \"text_ready\":\n\t\te = a.checkText(ctx, v)\n\tcase \"raw_ready\":\n\t\te = a.submitRaw(ctx, v)\n\tcase \"raw_wait\":\n\t\te = a.rawResult(ctx, v)\n\tcase \"ready\":\n\t\t_, e = a.Publish(ctx, id)\n\tdefault:\n\t\te = ErrMedia\n\t}\n\tif e != nil && e != ErrAVUnknown && e != ErrBlocked {\n\t\t// Local/provider failures release only the lease. Durable started phases\n\t\t// stay started, so a process loss cannot silently repeat a billable call.\n\t\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET error_code=?,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND lease_owner=?`, ErrCheck.Error(), string(id), owner)\n\t}\n\treturn e\n}\nfunc (a *AVService) fail(ctx context.Context, id ports.ID, owner, code string) {\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn\n\t}\n\tdefer tx.Rollback()\n\tr, e := tx.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='failed',error_code=?,lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, code, string(id), owner)\n\tif e != nil {\n\t\treturn\n\t}\n\tn, _ := r.RowsAffected()\n\tif n != 1 {\n\t\treturn\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state IN ('checking','review_pending')`, code, string(id)); e == nil {\n\t\ttx.Commit()\n\t}\n}\nfunc (a *AVService) advance(ctx context.Context, v avJob, phase string) error {\n\tr, e := a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET phase=?,error_code=NULL,next_attempt_at=UTC_TIMESTAMP(6),lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, phase, string(v.ID), v.Owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := r.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\treturn nil\n}\nfunc (a *AVService) prepare(ctx context.Context, v avJob) error {\n\trows, e := a.base.db.QueryContext(ctx, `SELECT object_key,size_bytes FROM chat_av_parts WHERE upload_id=? AND state='present' ORDER BY ordinal`, string(v.Upload))\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tkeys := []string{}\n\tsizes := []int64{}\n\tfor rows.Next() {\n\t\tvar key string\n\t\tvar size int64\n\t\tif rows.Scan(&key, &size) != nil {\n\t\t\trows.Close()\n\t\t\treturn ErrMedia\n\t\t}\n\t\tkeys = append(keys, key)\n\t\tsizes = append(sizes, size)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil || len(keys) != avParts(v.Size) {\n\t\treturn ErrMedia\n\t}\n\traw := make([]byte, 0, v.Size)\n\tfor i, key := range keys {\n\t\tb, e := a.storage.Read(ctx, key, sizes[i])\n\t\tif e != nil || int64(len(b)) != sizes[i] {\n\t\t\treturn ErrMedia\n\t\t}\n\t\traw = append(raw, b...)\n\t}\n\tvar digest string\n\tif a.base.db.QueryRowContext(ctx, `SELECT source_md5 FROM chat_av_uploads WHERE id=?`, string(v.Upload)).Scan(&digest) != nil || fileMD5(raw) != digest {\n\t\ta.fail(ctx, v.ID, v.Owner, ErrMediaVersion.Error())\n\t\treturn ErrMediaVersion\n\t}\n\tout, e := a.processor.Process(ctx, raw, v.Request.MessageType, v.Source)\n\tif e != nil {\n\t\ta.fail(ctx, v.ID, v.Owner, ErrCheck.Error())\n\t\treturn e\n\t}\n\tif out.QRDecision == \"blocked\" {\n\t\ta.fail(ctx, v.ID, v.Owner, ErrBlocked.Error())\n\t\treturn ErrBlocked\n\t}\n\tprefix := \"chatav/\" + a.environment + \"/\" + string(v.Principal.ActorID) + \"/\" + v.Version + \"/\"\n\tput := func(bytes []byte, role, mime string) (string, string, error) {\n\t\thash := mediaHash(bytes)\n\t\tkey := prefix + hash + \"/\" + role\n\t\tif _, e := a.base.db.ExecContext(ctx, `INSERT INTO chat_av_objects(object_key,upload_id,sha256,size_bytes,role,created_at) VALUES(?,?,?,?,?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE object_key=object_key`, key, string(v.Upload), hash, len(bytes), role); e != nil {\n\t\t\treturn \"\", \"\", ports.ErrUnavailable\n\t\t}\n\t\te := a.storage.PutAV(ctx, key, bytes, mime)\n\t\treturn key, hash, e\n\t}\n\tmain, mh, e := put(out.Main, \"main\", out.MIME)\n\tif e != nil {\n\t\treturn e\n\t}\n\tposter, ph := \"\", \"\"\n\tif len(out.Poster) > 0 {\n\t\tposter, ph, e = put(out.Poster, \"poster\", \"image/jpeg\")\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t}\n\tframes := []avFrameRecord{}\n\tfor i, frame := range out.Frames {\n\t\tif i >= 8 || len(frame.Body) > 65536 || frame.AtMS < 0 || frame.AtMS >= out.DurationMS {\n\t\t\treturn ErrMedia\n\t\t}\n\t\tkey, hash, err := put(frame.Body, fmt.Sprintf(\"frame-%d\", i), \"image/jpeg\")\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tframes = append(frames, avFrameRecord{Key: key, Hash: hash, AtMS: frame.AtMS})\n\t}\n\tframeJSON, _ := json.Marshal(frames)\n\tsegments := []avSegment{}\n\tfor i, b := range out.Segments {\n\t\tkey, hash := main, mh\n\t\tif v.Request.MessageType != \"audio\" {\n\t\t\tkey, hash, e = put(b, fmt.Sprintf(\"check-%d\", i), \"audio/mpeg\")\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t}\n\t\tsegments = append(segments, avSegment{key, hash})\n\t}\n\tencoded, _ := json.Marshal(segments)\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tr, e := tx.ExecContext(ctx, `UPDATE chat_av_jobs SET segments_json=?,phase='asr_ready',lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND phase='prepare' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, string(encoded), string(v.ID), v.Owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := r.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_av_uploads SET state='prepared',main_key=?,main_sha256=?,poster_key=NULLIF(?,''),poster_sha256=NULLIF(?,''),mime_type=?,duration_ms=?,has_audio=?,frames_json=? WHERE id=?`, main, mh, poster, ph, out.MIME, out.DurationMS, out.HasAudio, string(frameJSON), string(v.Upload)); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, key := range keys {\n\t\t_ = a.storage.Delete(ctx, key)\n\t}\n\treturn nil\n}\nfunc (a *AVService) reviewPending(ctx context.Context, v avJob) error {\n\ttx, e := a.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tr, e := tx.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='review_pending',review_state='pending',review_version=review_version+1,lease_owner=NULL,lease_until=NULL WHERE intent_id=? AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, string(v.ID), v.Owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := r.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='review_pending',lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state='checking'`, string(v.ID)); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (a *AVService) checkText(ctx context.Context, v avJob) error {\n\tvar checked ports.SafetyResult\n\tvar e error\n\tif strings.TrimSpace(v.Transcript) == \"\" {\n\t\tif v.Request.MessageType == \"audio\" {\n\t\t\ta.fail(ctx, v.ID, v.Owner, \"CHAT_AUDIO_NO_RECOGNIZABLE_TEXT\")\n\t\t\treturn ErrCheck\n\t\t}\n\t\tproof, ok := a.base.safety.(interface {\n\t\t\tMediaProof(context.Context, ports.Principal) (ports.SafetyResult, error)\n\t\t})\n\t\tif !ok {\n\t\t\treturn ErrCheck\n\t\t}\n\t\tchecked, e = proof.MediaProof(ctx, v.Principal)\n\t} else {\n\t\tchecked, e = a.base.safety.CheckText(ctx, ports.TextRequest{Actor: v.Principal, IntentID: v.ID, ConversationID: v.Request.ConversationID, Fingerprint: v.Hash, Text: v.Transcript})\n\t}\n\tif e != nil {\n\t\treturn e\n\t}\n\tif v.Proof != \"\" && checked.AuthorityProof != v.Proof {\n\t\ta.fail(ctx, v.ID, v.Owner, ErrMediaVersion.Error())\n\t\treturn ErrMediaVersion\n\t}\n\tif checked.Decision == \"blocked\" || checked.Decision == \"review\" {\n\t\tq := v.Request\n\t\tq.Text = v.Transcript\n\t\t_, e = a.base.reject(ctx, v.Principal, q, v.Hash, v.ID, v.Owner, checked)\n\t\tif e == nil {\n\t\t\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_uploads SET legal_hold=1 WHERE id=?`, string(v.Upload))\n\t\t\t_, _ = a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET phase='failed',lease_owner=NULL,lease_until=NULL WHERE intent_id=?`, string(v.ID))\n\t\t}\n\t\treturn e\n\t}\n\tif checked.Decision != \"passed\" && checked.Decision != \"media_identity\" {\n\t\treturn ErrCheck\n\t}\n\tr, e := a.base.db.ExecContext(ctx, `UPDATE chat_av_jobs SET text_rule=?,text_proof=?,source_proof=?,error_code=NULL WHERE intent_id=? AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, checked.RuleVersion, checked.AuthorityProof, checked.AuthorityProof, string(v.ID), v.Owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := r.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\tif v.Request.MessageType == \"video\" {\n\t\treturn a.reviewPending(ctx, v)\n\t}\n\treturn a.advance(ctx, v, \"raw_ready\")\n}\n","chat/internal/message/case_review.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Evidence struct {\n\tAV          *AVEvidence `json:\"av,omitempty\"`\n\tCase        Case        `json:\"case\"`\n\tText        *string     `json:\"text,omitempty\"`\n\tContext     *string     `json:\"context,omitempty\"`\n\tItems       []ImageView `json:\"items\"`\n\tUnavailable bool        `json:\"unavailable\"`\n\tURL         string      `json:\"url,omitempty\"`\n}\n\nfunc (g *GovernanceService) caseLock(ctx context.Context, tx *sql.Tx, id ports.ID) (Case, error) {\n\tvar cid, subject ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),CAST(subject_id AS CHAR) FROM chat_cases WHERE id=?`, string(id)).Scan(&cid, &subject) != nil {\n\t\treturn Case{}, ErrResync\n\t}\n\t// Same actor -> conversation order used by send, ban and publication.\n\tif _, err := restrictionLocked(ctx, tx, subject); err != nil {\n\t\treturn Case{}, err\n\t}\n\tif cid != \"0\" {\n\t\tvar found ports.ID\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? FOR UPDATE`, string(cid)).Scan(&found) != nil {\n\t\t\treturn Case{}, ErrResync\n\t\t}\n\t}\n\treturn scanCase(tx.QueryRowContext(ctx, `SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(id)))\n}\nfunc caseImageItems(ctx context.Context, tx *sql.Tx, c Case) ([]ImageView, error) {\n\titems := []ImageView{}\n\tif c.TargetType == \"message\" {\n\t\tquery := `SELECT CAST(i.item_id AS CHAR),i.ordinal,u.width_px,u.height_px FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=?`\n\t\targs := []any{string(c.Target)}\n\t\tif c.Item != \"0\" {\n\t\t\tquery += ` AND i.item_id=?`\n\t\t\targs = append(args, string(c.Item))\n\t\t}\n\t\tquery += ` ORDER BY i.ordinal LIMIT 9`\n\t\trows, err := tx.QueryContext(ctx, query, args...)\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tfor rows.Next() {\n\t\t\tvar v ImageView\n\t\t\tif rows.Scan(&v.ItemID, &v.Ordinal, &v.Width, &v.Height) != nil {\n\t\t\t\trows.Close()\n\t\t\t\treturn nil, ports.ErrUnavailable\n\t\t\t}\n\t\t\titems = append(items, v)\n\t\t}\n\t\terr = rows.Err()\n\t\trows.Close()\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t} else if c.TargetType == \"image_intent\" {\n\t\tvar raw, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT manifest_json,manifest_hash FROM chat_image_bundles WHERE intent_id=?`, string(c.Target)).Scan(&raw, &fp) != nil || fp != c.Fingerprint {\n\t\t\treturn nil, ErrMediaVersion\n\t\t}\n\t\tvar q Request\n\t\tif json.Unmarshal([]byte(raw), &q) != nil || len(q.Items) < 1 || len(q.Items) > 9 {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tfor _, v := range q.Items {\n\t\t\titems = append(items, ImageView{ItemID: v.AttachmentID, Ordinal: v.Ordinal})\n\t\t}\n\t}\n\treturn items, nil\n}\nfunc (g *GovernanceService) Evidence(ctx context.Context, p ports.Principal, id, expected, item ports.ID, reason string) (Evidence, error) {\n\tif !validID(id) || !validID(expected) || item != \"\" && !validID(item) || !reasonValid(reason) {\n\t\treturn Evidence{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:evidence\"); err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tc, err := g.caseLock(ctx, tx, id)\n\tif err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tif c.Version != expected {\n\t\treturn Evidence{}, ErrMediaVersion\n\t}\n\tout := Evidence{Case: c, Items: []ImageView{}}\n\tswitch c.TargetType {\n\tcase \"risk\":\n\t\tvar text, context, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT text_evidence,context_evidence,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6)`, string(c.Target)).Scan(&text, &context, &fp) != nil || fp != c.Fingerprint {\n\t\t\tout.Unavailable = true\n\t\t} else {\n\t\t\tout.Text = &text\n\t\t\tout.Context = &context\n\t\t}\n\tcase \"message\":\n\t\tvar text sql.NullString\n\t\tvar fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT m.text_body,SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.id=? AND m.conversation_id=? `, string(c.Target), string(c.Conversation)).Scan(&text, &fp) != nil || fp != c.Fingerprint {\n\t\t\tout.Unavailable = true\n\t\t} else if text.Valid {\n\t\t\tout.Text = &text.String\n\t\t}\n\tcase \"restriction\":\n\t\tout.Unavailable = false\n\tcase \"image_intent\", \"media_intent\":\n\tdefault:\n\t\treturn out, ports.ErrInvalid\n\t}\n\tout.Items, err = caseImageItems(ctx, tx, c)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tav, mediaURL, e := g.avEvidenceURL(ctx, tx, p, c, item)\n\tif e != nil {\n\t\treturn out, e\n\t}\n\tout.AV = av\n\tif mediaURL != \"\" {\n\t\tout.URL = mediaURL\n\t}\n\tif item != \"\" && av == nil {\n\t\tfound := false\n\t\tfor _, v := range out.Items {\n\t\t\tif v.ItemID == item {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found || g.media == nil {\n\t\t\treturn out, ErrMedia\n\t\t}\n\t\tvar key string\n\t\tif c.TargetType == \"message\" {\n\t\t\terr = tx.QueryRowContext(ctx, `SELECT u.main_key FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=? AND i.item_id=?`, string(c.Target), string(item)).Scan(&key)\n\t\t} else {\n\t\t\tvar raw string\n\t\t\tif tx.QueryRowContext(ctx, `SELECT manifest_json FROM chat_image_bundles WHERE intent_id=?`, string(c.Target)).Scan(&raw) != nil {\n\t\t\t\treturn out, ErrMedia\n\t\t\t}\n\t\t\tvar q Request\n\t\t\tjson.Unmarshal([]byte(raw), &q)\n\t\t\tversion := \"\"\n\t\t\tfor _, v := range q.Items {\n\t\t\t\tif v.AttachmentID == item {\n\t\t\t\t\tversion = v.ObjectVersion\n\t\t\t\t}\n\t\t\t}\n\t\t\terr = tx.QueryRowContext(ctx, `SELECT main_key FROM chat_image_uploads WHERE id=? AND object_version=? AND legal_hold=1`, string(item), version).Scan(&key)\n\t\t}\n\t\tif err != nil || key == \"\" {\n\t\t\tout.Unavailable = true\n\t\t} else {\n\t\t\tout.URL, err = g.media.storage.Sign(ctx, key, 60*time.Second)\n\t\t\tif err != nil {\n\t\t\t\treturn out, ErrMedia\n\t\t\t}\n\t\t}\n\t}\n\taction := \"case.evidence\"\n\tif out.Unavailable {\n\t\taction = \"evidence.unavailable\"\n\t}\n\tif item != \"\" && out.URL == \"\" {\n\t\taction = \"evidence.unavailable\"\n\t}\n\tif err = governanceLog(ctx, tx, p, action, c.Conversation, c.ID, item, c.Version, reason); err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n\ntype CaseDecision struct {\n\tID       ports.ID `json:\"case_id\"`\n\tExpected ports.ID `json:\"expected_version\"`\n\tAction   string   `json:\"action\"`\n\tReason   string   `json:\"reason\"`\n}\n\nfunc (g *GovernanceService) Decide(ctx context.Context, p ports.Principal, q CaseDecision) (Case, error) {\n\tif !validID(q.ID) || !validID(q.Expected) || !reasonValid(q.Reason) || q.Action != \"confirm\" && q.Action != \"correct\" && q.Action != \"dismiss\" && q.Action != \"block\" {\n\t\treturn Case{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Case{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:moderate\"); err != nil {\n\t\treturn Case{}, err\n\t}\n\tc, err := g.caseLock(ctx, tx, q.ID)\n\tif err != nil {\n\t\treturn c, err\n\t}\n\tif c.Version != q.Expected || c.State != \"pending\" {\n\t\treturn c, ErrMediaVersion\n\t}\n\tvar n int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id IS NULL AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`, p.Kind, string(p.ActorID), bindingFor(g.environment, p), string(c.ID), string(c.Version)).Scan(&n) != nil || n == 0 {\n\t\treturn c, ErrMedia\n\t}\n\t// A visible metadata list or thumbnail cannot satisfy full image evidence.\n\titems, err := caseImageItems(ctx, tx, c)\n\tif err != nil {\n\t\treturn c, err\n\t}\n\tfor _, v := range items {\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id=? AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`, p.Kind, string(p.ActorID), bindingFor(g.environment, p), string(c.ID), string(c.Version), string(v.ItemID)).Scan(&n) != nil || n == 0 {\n\t\t\treturn c, ErrMedia\n\t\t}\n\t}\n\tav, _, avErr := caseAV(ctx, tx, c)\n\tif avErr != nil {\n\t\treturn c, avErr\n\t}\n\tif av != nil {\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id=? AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`, p.Kind, string(p.ActorID), bindingFor(g.environment, p), string(c.ID), string(c.Version), string(av.ItemID)).Scan(&n) != nil || n == 0 {\n\t\t\treturn c, ErrMedia\n\t\t}\n\t}\n\tswitch c.TargetType {\n\tcase \"risk\":\n\t\tvar riskState, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT review_state,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(c.Target)).Scan(&riskState, &fp) != nil || fp != c.Fingerprint {\n\t\t\treturn c, ErrResync\n\t\t}\n\t\tif riskState == \"corrected\" && q.Action == \"confirm\" {\n\t\t\treturn c, ErrMediaVersion\n\t\t}\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\tif q.Action == \"correct\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET confirmed=0,review_state='corrected' WHERE id=? AND content_fingerprint=?`, string(c.Target), c.Fingerprint); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t} else if q.Action == \"confirm\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET confirmed=1,review_state='confirmed' WHERE id=? AND content_fingerprint=? AND review_state<>'corrected'`, string(c.Target), c.Fingerprint); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tif q.Action == \"correct\" || q.Action == \"confirm\" {\n\t\t\tcode := \"CHAT_CONTENT_BLOCKED\"\n\t\t\tif q.Action == \"correct\" {\n\t\t\t\tcode = \"CHAT_REVIEW_CORRECTED\"\n\t\t\t}\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE risk_event_id=? AND state IN ('review_pending','rejected')`, code, string(c.Target)); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\t// No send-intent or message is resurrected by a successful appeal.\n\tcase \"restriction\":\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\tif q.Action == \"correct\" {\n\t\t\tr, err := restrictionLocked(ctx, tx, c.Subject)\n\t\t\tif err != nil {\n\t\t\t\treturn c, err\n\t\t\t}\n\t\t\tif r.Version != c.TargetVersion {\n\t\t\t\treturn c, ErrMediaVersion\n\t\t\t}\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET permanent=0,blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(c.Subject)); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\tcase \"message\":\n\t\tif q.Action == \"block\" {\n\t\t\tvar state string\n\t\t\tvar version, seq uint64\n\t\t\tif tx.QueryRowContext(ctx, `SELECT state,state_version,seq FROM chat_messages WHERE id=? AND conversation_id=? FOR UPDATE`, string(c.Target), string(c.Conversation)).Scan(&state, &version, &seq) != nil {\n\t\t\t\treturn c, ErrResync\n\t\t\t}\n\t\t\tif state == \"published\" {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_change_seq=last_change_seq+1 WHERE id=?`, string(c.Conversation)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_messages SET state='blocked',state_version=state_version+1 WHERE id=?`, string(c.Target)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT id,last_change_seq,?,?, 'message.blocked',UTC_TIMESTAMP(6) FROM chat_conversations WHERE id=?`, string(c.Target), version+1, string(c.Conversation)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\tcase \"image_intent\", \"media_intent\":\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\t// Only the governance result changes. Old rejected manifests stay rejected.\n\tdefault:\n\t\treturn c, ports.ErrInvalid\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_cases SET state=?,version=version+1,resolution=?,reviewer_id=?,decided_at=UTC_TIMESTAMP(6) WHERE id=?`, q.Action, q.Reason, string(p.ActorID), string(c.ID)); err != nil {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.\"+q.Action, c.Conversation, c.ID, c.Item, decimal(number(c.Version)+1), q.Reason); err != nil {\n\t\treturn c, err\n\t}\n\tc.State = q.Action\n\tc.Resolution = q.Reason\n\tc.Version = decimal(number(c.Version) + 1)\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn c, err\n\t}\n\tif q.Action == \"block\" && g.base.publisher != nil {\n\t\tg.base.publisher.Committed(ports.CommittedMessage{ConversationID: c.Conversation})\n\t}\n\treturn c, nil\n}\n","chat/internal/message/cases.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Case struct {\n\tID            ports.ID  `json:\"case_id\"`\n\tKind          string    `json:\"kind\"`\n\tTargetType    string    `json:\"target_type\"`\n\tTarget        ports.ID  `json:\"target_id\"`\n\tItem          ports.ID  `json:\"item_id\"`\n\tConversation  ports.ID  `json:\"conversation_id\"`\n\tReporter      ports.ID  `json:\"reporter_id\"`\n\tSubject       ports.ID  `json:\"subject_id\"`\n\tVersion       ports.ID  `json:\"version\"`\n\tState         string    `json:\"state\"`\n\tReason        string    `json:\"reason\"`\n\tResolution    string    `json:\"resolution\"`\n\tCreated       time.Time `json:\"created_at\"`\n\tFingerprint   string    `json:\"fingerprint\"`\n\tTargetVersion ports.ID  `json:\"target_version\"`\n}\n\nconst caseColumns = `CAST(id AS CHAR),kind,target_type,CAST(target_id AS CHAR),CAST(item_id AS CHAR),CAST(conversation_id AS CHAR),CAST(reporter_id AS CHAR),CAST(subject_id AS CHAR),CAST(version AS CHAR),state,reason,COALESCE(resolution,''),created_at,fingerprint,CAST(target_version AS CHAR)`\n\ntype CasePage struct {\n\tItems []Case   `json:\"items\"`\n\tAfter ports.ID `json:\"next_after\"`\n\tMore  bool     `json:\"has_more\"`\n}\n\nfunc scanCase(row interface{ Scan(...any) error }) (Case, error) {\n\tvar c Case\n\terr := row.Scan(&c.ID, &c.Kind, &c.TargetType, &c.Target, &c.Item, &c.Conversation, &c.Reporter, &c.Subject, &c.Version, &c.State, &c.Reason, &c.Resolution, &c.Created, &c.Fingerprint, &c.TargetVersion)\n\tif err != nil {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\treturn c, nil\n}\nfunc createCase(ctx context.Context, tx *sql.Tx, kind, targetType string, target, item, cid, reporter, subject, version ports.ID, fp, reason string) (ports.ID, error) {\n\tvar id ports.ID\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_cases WHERE kind=? AND target_type=? AND target_id=? AND item_id=? AND reporter_id=? AND (kind<>'appeal' OR target_version=?)`, kind, targetType, string(target), string(item), string(reporter), string(version)).Scan(&id)\n\tif err == nil {\n\t\treturn id, nil\n\t}\n\tif err != sql.ErrNoRows {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tvar n int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_cases WHERE reporter_id=? AND kind<>'review' AND created_at>UTC_TIMESTAMP()-INTERVAL 1 DAY`, string(reporter)).Scan(&n) != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif n >= 20 && kind != \"review\" {\n\t\treturn \"\", ports.ErrBusy\n\t}\n\tr, err := tx.ExecContext(ctx, `INSERT INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,'pending',1,UTC_TIMESTAMP(6)+INTERVAL 30 DAY,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE id=LAST_INSERT_ID(id)`, kind, targetType, string(target), string(item), string(cid), string(reporter), string(subject), string(version), fp, reason)\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tn64, err := r.LastInsertId()\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn decimal(uint64(n64)), nil\n}\nfunc (g *GovernanceService) Report(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, reason string) (ports.ID, error) {\n\tif !validID(cid) || !validID(mid) || item != \"\" && !validID(item) || !reasonValid(reason) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tif item == \"\" {\n\t\titem = \"0\"\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tauthority, err := g.base.conversations.LockAuthority(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif _, err = restrictionLocked(ctx, tx, p.ActorID); err != nil {\n\t\treturn \"\", err\n\t}\n\tgrant, err := g.base.conversations.LockProjection(ctx, tx, authority)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tvar subject, version ports.ID\n\tvar fp string\n\tif tx.QueryRowContext(ctx, `SELECT CAST(m.sender_id AS CHAR),CAST(m.state_version AS CHAR),SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn, string(cid), string(mid), string(grant.Version), string(p.ActorID)).Scan(&subject, &version, &fp) != nil {\n\t\treturn \"\", ErrResync\n\t}\n\tif item != \"0\" {\n\t\tvar n int\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_image_items WHERE message_id=? AND item_id=?`, string(mid), string(item)).Scan(&n) != nil || n != 1 {\n\t\t\treturn \"\", ErrMedia\n\t\t}\n\t}\n\tid, err := createCase(ctx, tx, \"report\", \"message\", mid, item, cid, p.ActorID, subject, version, fp, reason)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads u JOIN chat_image_items i ON i.item_id=u.id SET u.legal_hold=1 WHERE i.message_id=?`, string(mid)); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_av_uploads u JOIN chat_av_items i ON i.upload_id=u.id SET u.legal_hold=1 WHERE i.message_id=?`, string(mid)); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.report\", cid, id, item, version, reason); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn id, nil\n}\nfunc (g *GovernanceService) Appeal(ctx context.Context, p ports.Principal, targetType string, target, expected ports.ID, reason string) (ports.ID, error) {\n\tif !validID(target) || !expected.Valid() || !reasonValid(reason) || targetType != \"risk\" && targetType != \"image_intent\" && targetType != \"media_intent\" && targetType != \"restriction\" || p.Environment != g.environment {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.source.ValidatePrincipalLocked(ctx, tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\tstatus, err := restrictionLocked(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tcid, subject, version, fp := ports.ID(\"0\"), p.ActorID, ports.ID(\"1\"), \"\"\n\tswitch targetType {\n\tcase \"risk\":\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),content_fingerprint FROM chat_risk_events WHERE id=? AND sender_id=? AND retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`, string(target), string(p.ActorID)).Scan(&cid, &fp) != nil {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\tcase \"image_intent\":\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(i.conversation_id AS CHAR),b.manifest_hash,CAST(b.review_version AS CHAR) FROM chat_send_intents i JOIN chat_image_bundles b ON b.intent_id=i.id WHERE i.id=? AND i.sender_id=? AND i.state='rejected' AND i.retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`, string(target), string(p.ActorID)).Scan(&cid, &fp, &version) != nil {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\tcase \"media_intent\":\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(i.conversation_id AS CHAR),j.manifest_hash,CAST(j.review_version AS CHAR) FROM chat_send_intents i JOIN chat_av_jobs j ON j.intent_id=i.id WHERE i.id=? AND i.sender_id=? AND i.state='rejected' AND i.retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`, string(target), string(p.ActorID)).Scan(&cid, &fp, &version) != nil {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\tcase \"restriction\":\n\t\tif target != p.ActorID || status.Version != expected || !status.Blocked {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\t\tversion = status.Version\n\t\tfp = memberHash(string(p.ActorID) + \":\" + string(version))\n\t}\n\tif targetType != \"restriction\" && version != expected {\n\t\treturn \"\", ErrResync\n\t}\n\tid, err := createCase(ctx, tx, \"appeal\", targetType, target, \"0\", cid, p.ActorID, subject, version, fp, reason)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif targetType == \"risk\" {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET retain_until=GREATEST(retain_until,UTC_TIMESTAMP(6)+INTERVAL 30 DAY) WHERE id=?`, string(target)); err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t}\n\tif targetType == \"image_intent\" {\n\t\titems, e := caseImageItems(ctx, tx, Case{TargetType: targetType, Target: target, Fingerprint: fp})\n\t\tif e != nil {\n\t\t\treturn \"\", e\n\t\t}\n\t\tfor _, v := range items {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET legal_hold=1 WHERE id=? AND actor_id=? AND conversation_id=?`, string(v.ItemID), string(p.ActorID), string(cid)); err != nil {\n\t\t\t\treturn \"\", ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\tif targetType == \"media_intent\" {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_av_uploads u JOIN chat_av_jobs j ON j.upload_id=u.id SET u.legal_hold=1 WHERE j.intent_id=? AND u.actor_id=?`, string(target), string(p.ActorID)); err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.appeal\", cid, id, \"\", version, reason); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn id, nil\n}\nfunc (g *GovernanceService) Cases(ctx context.Context, p ports.Principal, after ports.ID, admin bool) (CasePage, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn CasePage{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn CasePage{}, err\n\t}\n\tdefer tx.Rollback()\n\tif admin {\n\t\terr = g.admin(ctx, tx, p, \"chat:moderate\")\n\t} else if p.Environment == g.environment {\n\t\terr = g.source.ValidatePrincipalLocked(ctx, tx, p)\n\t} else {\n\t\terr = ports.ErrInvalid\n\t}\n\tif err != nil {\n\t\treturn CasePage{}, err\n\t}\n\tquery := `SELECT ` + caseColumns + ` FROM chat_cases WHERE id>?`\n\targs := []any{string(after)}\n\tif !admin {\n\t\tquery += ` AND reporter_id=?`\n\t\targs = append(args, string(p.ActorID))\n\t}\n\tquery += ` ORDER BY id LIMIT 21`\n\trows, err := tx.QueryContext(ctx, query, args...)\n\tif err != nil {\n\t\treturn CasePage{}, ports.ErrUnavailable\n\t}\n\tout := CasePage{Items: []Case{}, After: after}\n\tfor rows.Next() {\n\t\tc, e := scanCase(rows)\n\t\tif e != nil {\n\t\t\trows.Close()\n\t\t\treturn out, e\n\t\t}\n\t\tif !admin {\n\t\t\tc.Fingerprint = \"\"\n\t\t\tc.Subject = \"0\"\n\t\t}\n\t\tout.Items = append(out.Items, c)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif len(out.Items) > 20 {\n\t\tout.More = true\n\t\tout.Items = out.Items[:20]\n\t}\n\tif len(out.Items) > 0 {\n\t\tout.After = out.Items[len(out.Items)-1].ID\n\t}\n\tif admin {\n\t\tif err = governanceLog(ctx, tx, p, \"case.list\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\t\treturn out, err\n\t\t}\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n","chat/internal/message/cloud_retention.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Published references/hash metadata remain stable for permanent device caches.\n// Only cloud bytes are removed; video posters and sampled frames are retained.\nfunc (s *Service) CleanCloudOne(ctx context.Context) error {\n\tfor _, av := range []bool{false, true} {\n\t\tif !av && s.media == nil || av && s.av == nil {\n\t\t\tcontinue\n\t\t}\n\t\tif e := s.cleanCloudObject(ctx, av); e != nil {\n\t\t\treturn e\n\t\t}\n\t}\n\treturn nil\n}\nfunc (s *Service) cleanCloudObject(ctx context.Context, av bool) error {\n\tobjects, uploads, items, join, role := \"chat_image_objects\", \"chat_image_uploads\", \"chat_image_items\", \"i.item_id=u.id\", \"\"\n\treference := \"kept.item_id=u.id\"\n\tif av {\n\t\treference = \"kept.upload_id=u.id\"\n\t}\n\tvar deleteObject func(context.Context, string) error\n\tif av {\n\t\tobjects, uploads, items, join, role = \"chat_av_objects\", \"chat_av_uploads\", \"chat_av_items\", \"i.upload_id=u.id\", \" AND o.role='main'\"\n\t\tdeleteObject = s.av.storage.Delete\n\t} else {\n\t\tdeleteObject = s.media.storage.Delete\n\t}\n\tvar cid, mid, upload ports.ID\n\tvar key string\n\tquery := \"SELECT CAST(m.conversation_id AS CHAR),CAST(m.id AS CHAR),CAST(u.id AS CHAR),o.object_key FROM \" + objects + \" o JOIN \" + uploads + \" u ON u.id=o.upload_id JOIN \" + items + \" i ON \" + join + \" JOIN chat_messages m ON m.id=i.message_id WHERE o.deleted_at IS NULL AND u.legal_hold=0 AND m.state='published' AND m.retention_mode='days' AND m.expires_at<=UTC_TIMESTAMP(6)\" + role + \" AND NOT EXISTS(SELECT 1 FROM \" + items + \" kept JOIN chat_messages live ON live.id=kept.message_id WHERE \" + reference + \" AND live.state='published' AND (live.retention_mode='permanent' AND live.expires_at IS NULL OR live.expires_at>UTC_TIMESTAMP(6))) ORDER BY m.expires_at,m.id LIMIT 1\"\n\te := s.db.QueryRowContext(ctx, query).Scan(&cid, &mid, &upload, &key)\n\tif e == sql.ErrNoRows {\n\t\treturn nil\n\t}\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tvar found int\n\tif tx.QueryRowContext(ctx, `SELECT 1 FROM chat_conversations WHERE id=? FOR UPDATE`, string(cid)).Scan(&found) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar due bool\n\tif tx.QueryRowContext(ctx, `SELECT state='published' AND retention_mode='days' AND expires_at<=UTC_TIMESTAMP(6) FROM chat_messages WHERE id=? FOR UPDATE`, string(mid)).Scan(&due) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !due {\n\t\treturn nil\n\t}\n\tvar retained bool\n\tif tx.QueryRowContext(ctx, \"SELECT EXISTS(SELECT 1 FROM \"+items+\" kept JOIN chat_messages live ON live.id=kept.message_id WHERE \"+reference+\" AND live.state='published' AND (live.retention_mode='permanent' AND live.expires_at IS NULL OR live.expires_at>UTC_TIMESTAMP(6))) FROM \"+uploads+\" u WHERE u.id=?\", string(upload)).Scan(&retained) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif retained {\n\t\treturn nil\n\t}\n\tvar hold bool\n\tif tx.QueryRowContext(ctx, \"SELECT legal_hold FROM \"+uploads+\" WHERE id=? FOR UPDATE\", string(upload)).Scan(&hold) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif hold {\n\t\treturn nil\n\t}\n\tvar deleted sql.NullTime\n\tif tx.QueryRowContext(ctx, \"SELECT deleted_at FROM \"+objects+\" WHERE object_key=? FOR UPDATE\", key).Scan(&deleted) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif deleted.Valid {\n\t\treturn nil\n\t}\n\twork, cancel := context.WithTimeout(ctx, 3*time.Second)\n\tdefer cancel()\n\tif e = deleteObject(work, key); e != nil {\n\t\treturn e\n\t}\n\tif _, e = tx.ExecContext(ctx, \"UPDATE \"+objects+\" SET deleted_at=UTC_TIMESTAMP(6) WHERE object_key=?\", key); e != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc missingCloudReferences(ctx context.Context, tx *sql.Tx, id ports.ID, kind string) (bool, error) {\n\tvar missing bool\n\tvar query string\n\tswitch kind {\n\tcase \"text\":\n\t\tquery = `SELECT text_body IS NULL FROM chat_messages WHERE id=?`\n\tcase \"image\", \"image_album\":\n\t\tquery = `SELECT EXISTS(SELECT 1 FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id WHERE i.message_id=? AND (NOT EXISTS(SELECT 1 FROM chat_image_objects o WHERE o.object_key=u.main_key AND o.deleted_at IS NULL) OR NOT EXISTS(SELECT 1 FROM chat_image_objects o WHERE o.object_key=u.thumb_key AND o.deleted_at IS NULL)))`\n\tcase \"audio\", \"video\":\n\t\tquery = `SELECT EXISTS(SELECT 1 FROM chat_av_items i JOIN chat_av_uploads u ON u.id=i.upload_id WHERE i.message_id=? AND NOT EXISTS(SELECT 1 FROM chat_av_objects o WHERE o.object_key=u.main_key AND o.deleted_at IS NULL))`\n\tdefault:\n\t\treturn true, nil\n\t}\n\tif tx.QueryRowContext(ctx, query, string(id)).Scan(&missing) != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn missing, nil\n}\n","chat/internal/message/digests.go":"package message\n\nimport (\n \"context\"\n \"errors\"\n \"crypto/aes\"\n \"crypto/cipher\"\n \"crypto/rand\"\n \"crypto/sha256\"\n \"encoding/base64\"\n \"encoding/json\"\n \"strconv\"\n  \"time\"\n\n \"github.com/franz-9527/workers/chat/internal/policy\"\n \"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype ConversationDigest struct {\n ConversationID ports.ID `json:\"conversation_id\"`\n Unread UnreadWindow `json:\"unread\"`\n}\ntype DigestPage struct {\n BadgeCount *uint64 `json:\"badge_count,omitempty\"` // C only, emitted after the complete server scan\n PreferenceRevision ports.ID `json:\"preference_revision\"`\n Items []ConversationDigest `json:\"items\"`\n NextAfter ports.ID `json:\"-\"` // internal resume key; no unauthorized candidate IDs on the wire\n NextCursor string `json:\"next_cursor,omitempty\"`\n HasMore bool `json:\"has_more\"`\n}\ntype digestCursor struct {\n Version int `json:\"v\"`\n Attention uint64 `json:\"attention\"`\n PreferenceRevision ports.ID `json:\"preference_revision\"`\n Binding string `json:\"binding\"`\n After ports.ID `json:\"after\"`\n Upper ports.ID `json:\"upper\"`\n Expires int64 `json:\"expires\"`\n}\n\n// Account cursors are authenticated AND encrypted: an otherwise valid member\n// projection is only a candidate, so even its upper conversation ID is private.\nfunc(s *HistoryService) digestAEAD() (cipher.AEAD,error){\n h:=sha256.New()\n h.Write([]byte(\"chat/digests/aes256gcm/v1\"))\n h.Write(s.key)\n key:=h.Sum(nil)\n block,e:=aes.NewCipher(key)\n if e!=nil{return nil,e}\n return cipher.NewGCM(block)\n}\nfunc (s *HistoryService) encodeDigestCursor(c digestCursor) (string,error) {\n raw,e:=json.Marshal(c);if e!=nil{return \"\",ports.ErrUnavailable}\n aead,e:=s.digestAEAD();if e!=nil{return \"\",ports.ErrUnavailable}\n nonce:=make([]byte,aead.NonceSize())\n if _,e=rand.Read(nonce);e!=nil{return \"\",ports.ErrUnavailable}\n sealed:=aead.Seal(nil,nonce,raw,[]byte(\"chat/digests/v1\"))\n return base64.RawURLEncoding.EncodeToString(append(nonce,sealed...)),nil\n}\nfunc (s *HistoryService) decodeDigestCursor(token string,p ports.Principal)(digestCursor,error){\n var c digestCursor\n if len(token)>1024{return c,ErrResync}\n payload,e:=base64.RawURLEncoding.Strict().DecodeString(token)\n if e!=nil{return c,ErrResync}\n aead,e:=s.digestAEAD();if e!=nil{return c,ports.ErrUnavailable}\n if len(payload)<aead.NonceSize()+aead.Overhead(){return c,ErrResync}\n raw,e:=aead.Open(nil,payload[:aead.NonceSize()],payload[aead.NonceSize():],[]byte(\"chat/digests/v1\"))\n if e!=nil{return c,ErrResync}\n if json.Unmarshal(raw,&c)!=nil||c.Version!=2||!c.PreferenceRevision.Valid()||c.Binding!=bindingFor(s.environment,p)||!c.After.Valid()||!c.Upper.Valid()||number(c.After)>number(c.Upper)||c.Expires<=time.Now().Unix()||c.Expires>time.Now().Add(cursorTTL).Unix()+5{return digestCursor{},ErrResync}\n return c,nil\n}\nfunc (s *HistoryService) Digests(ctx context.Context,p ports.Principal,after ports.ID,limit int)(DigestPage,error){\n if !after.Valid()||after!=\"0\"{return DigestPage{},ports.ErrInvalid}\n return s.DigestsCursor(ctx,p,\"\",limit)\n}\n// DigestsCursor fixes the account candidate upper ID across pages and signs\n// progression for the authenticated session. Reauthorization remains live.\nfunc (s *HistoryService) DigestsCursor(ctx context.Context,p ports.Principal,token string,limit int)(DigestPage,error){\n if !p.ActorID.Valid()||p.Environment!=s.environment||limit<1||limit>20{return DigestPage{},ports.ErrInvalid}\n if !time.Now().Before(p.ExpiresAt){return DigestPage{},policy.ErrDenied}\n ctx,cancel:=context.WithTimeout(ctx,3*s.timeout);defer cancel()\n if err:=s.conversations.ValidatePrincipal(ctx,p);err!=nil{return DigestPage{},err}\n revision,err:=accountRevision(ctx,s.db,p.ActorID);if err!=nil{return DigestPage{},err}\n var c digestCursor\n if token!=\"\"{\n  var e error;c,e=s.decodeDigestCursor(token,p);if e!=nil{return DigestPage{},e};if c.PreferenceRevision!=revision{return DigestPage{},ErrResync}\n }else{\n  var upper uint64\n  if e:=s.db.QueryRowContext(ctx,`SELECT COALESCE(MAX(conversation_id),0) FROM chat_members WHERE actor_id=? AND can_read=1`,string(p.ActorID)).Scan(&upper);e!=nil{return DigestPage{},ports.ErrUnavailable}\n  c=digestCursor{Version:2,PreferenceRevision:revision,Binding:bindingFor(s.environment,p),After:\"0\",Upper:ports.ID(strconv.FormatUint(upper,10)),Expires:time.Now().Add(cursorTTL).Unix()}\n }\n page:=DigestPage{PreferenceRevision:revision,Items:[]ConversationDigest{},NextAfter:c.After}\n const maxCandidates=100\n rows,e:=s.db.QueryContext(ctx,`SELECT CAST(conversation_id AS CHAR) FROM chat_members WHERE actor_id=? AND can_read=1 AND conversation_id>? AND conversation_id<=? ORDER BY conversation_id LIMIT ?`,string(p.ActorID),string(c.After),string(c.Upper),maxCandidates+1)\n if e!=nil{return DigestPage{},ports.ErrUnavailable}\n ids:=make([]ports.ID,0,maxCandidates+1)\n for rows.Next(){var id ports.ID;if rows.Scan(&id)!=nil||!validID(id){rows.Close();return DigestPage{},ports.ErrUnavailable};ids=append(ids,id)}\n e=rows.Err();rows.Close();if e!=nil{return DigestPage{},ports.ErrUnavailable}\n for i,id:=range ids{\n  if len(page.Items)==limit||i==maxCandidates{page.HasMore=true;break}\n  page.NextAfter=id\n  u,err:=s.Unread(ctx,p,id)\n  if err != nil {\n   // Only loss of this conversation's current membership may be skipped.\n   // Revoked login, identity mismatch, policy errors, SQL errors or timeout\n   // must fail the entire response rather than returning a partial snapshot.\n   if errors.Is(err, policy.ErrDenied) {\n    continue\n   }\n   return DigestPage{}, err\n  }\n  u.Preferences.AccountRevision=revision\n  if u.Count>0 || u.Preferences!=nil && u.Preferences.Later { c.Attention++ }\n  page.Items=append(page.Items,ConversationDigest{ConversationID:id,Unread:u})\n }\n if !page.HasMore { total:=c.Attention;page.BadgeCount=&total }\n if page.HasMore{\n  c.After=page.NextAfter\n  next,e:=s.encodeDigestCursor(c)\n  if e!=nil{return DigestPage{},e}\n  page.NextCursor=next\n }\n // Recheck at the response boundary, including empty/fully-filtered pages.\n // A logout that committed while scanning is not a successful empty list.\n if err:=s.conversations.ValidatePrincipal(ctx,p);err!=nil{return DigestPage{},err}\n latest,err:=accountRevision(ctx,s.db,p.ActorID);if err!=nil{return DigestPage{},err};if latest!=revision{return DigestPage{},ErrResync}\n if !time.Now().Before(p.ExpiresAt){return DigestPage{},policy.ErrDenied}\n return page,nil\n}","chat/internal/message/governance.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n\t\"unicode/utf8\"\n)\n\ntype GovernanceService struct {\n\tbase        *Service\n\thistory     *HistoryService\n\tmedia       *MediaService\n\tsource      *auth.MySQLSource\n\tenvironment string\n}\n\nfunc NewGovernanceService(base *Service, h *HistoryService, m *MediaService, env string) (*GovernanceService, error) {\n\tif base == nil || h == nil || base.db != h.db || env != h.environment {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tsource, err := auth.NewMySQLSource(base.db)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &GovernanceService{base, h, m, source, env}, nil\n}\nfunc (g *GovernanceService) admin(ctx context.Context, tx *sql.Tx, p ports.Principal, scope string) error {\n\tif p.Environment != g.environment {\n\t\treturn auth.ErrUnauthorized\n\t}\n\treturn g.source.ValidateAdminLocked(ctx, tx, p, scope)\n}\nfunc reasonValid(s string) bool {\n\treturn utf8.ValidString(s) && utf8.RuneCountInString(s) >= 2 && utf8.RuneCountInString(s) <= 200\n}\nfunc governanceLog(ctx context.Context, tx *sql.Tx, p ports.Principal, action string, cid, target, item ports.ID, version ports.ID, reason string) error {\n\t_, err := tx.ExecContext(ctx, `INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,conversation_id,target_id,item_id,target_version,reason,created_at) VALUES(?,?,?,?,?,?,?,?,?,UTC_TIMESTAMP(6))`, p.Kind, string(p.ActorID), bindingFor(p.Environment, p), action, nullableID(cid), nullableID(target), nullableID(item), nullableID(version), reason)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) commit(tx *sql.Tx, p ports.Principal) error {\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn auth.ErrUnauthorized\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\ntype AuditConversation struct {\n\tID       ports.ID  `json:\"conversation_id\"`\n\tOrderID  ports.ID  `json:\"order_id\"`\n\tActivity time.Time `json:\"activity_at\"`\n}\ntype AuditList struct {\n\tItems  []AuditConversation `json:\"items\"`\n\tCursor string              `json:\"next_cursor,omitempty\"`\n\tMore   bool                `json:\"has_more\"`\n}\ntype auditCursor struct {\n\tSnapshot string    `json:\"snapshot\"`\n\tAt       time.Time `json:\"at\"`\n\tAfter    ports.ID  `json:\"after\"`\n}\n\n// Materialize only IDs/activity in one DB statement, never message history.\n// Subsequent message activity cannot move a row across snapshot pages.\nfunc (g *GovernanceService) AuditList(ctx context.Context, p ports.Principal, token string, limit int) (AuditList, error) {\n\tif limit == 0 {\n\t\tlimit = 20\n\t}\n\tif limit < 1 || limit > 50 {\n\t\treturn AuditList{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, 3*g.base.timeout)\n\tdefer cancel()\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn AuditList{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\tvar c auditCursor\n\tbinding := bindingFor(g.environment, p)\n\tif token == \"\" {\n\t\t// Serialize snapshot quota by live source authority, without member state.\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_audit_accounts(binding,updated_at) VALUES(?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE updated_at=VALUES(updated_at)`, binding); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tvar n int\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_audit_snapshots WHERE binding=? AND expires_at>UTC_TIMESTAMP(6)`, binding).Scan(&n) != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tif n >= 3 {\n\t\t\treturn AuditList{}, ports.ErrBusy\n\t\t}\n\t\tvar b [32]byte\n\t\tif _, err = rand.Read(b[:]); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tc.Snapshot = hex.EncodeToString(b[:])\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_audit_snapshots(id,binding,expires_at) VALUES(?,?,UTC_TIMESTAMP(6)+INTERVAL 10 MINUTE)`, c.Snapshot, binding); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_audit_snapshot_items(snapshot_id,conversation_id,order_id,activity_at) SELECT ?,id,order_id,COALESCE(last_message_at,created_at) FROM chat_conversations WHERE conversation_type='order'`, c.Snapshot); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t} else {\n\t\tif err = g.decodeAuditCursor(token, p, &c); err != nil {\n\t\t\treturn AuditList{}, err\n\t\t}\n\t}\n\t_ = c\n\treturn g.auditListPage(ctx, tx, p, token, limit, c)\n}\n\ntype ReminderSummary struct {\n\tID           ports.ID  `json:\"cluster_id\"`\n\tConversation ports.ID  `json:\"conversation_id\"`\n\tRecipient    ports.ID  `json:\"recipient_id\"`\n\tFirstDue     time.Time `json:\"first_due_at\"`\n\tTarget       ports.ID  `json:\"target_seq\"`\n\tLastNotified ports.ID  `json:\"last_notified_seq\"`\n\tRounds       int       `json:\"successful_rounds\"`\n\tState        string    `json:\"state\"`\n\tDiagnostic   string    `json:\"diagnostic\"`\n}\n\nfunc (g *GovernanceService) ReminderSummaries(ctx context.Context, p ports.Principal, after ports.ID) ([]ReminderSummary, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn nil, err\n\t}\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(c.id AS CHAR),CAST(c.conversation_id AS CHAR),CAST(c.recipient_id AS CHAR),c.first_due_at,CAST(c.target_seq AS CHAR),CAST(c.last_notified_seq AS CHAR),c.rounds,c.state,COALESCE(c.blocked_reason,(SELECT i.diagnostic FROM chat_reminder_intents i WHERE i.cluster_id=c.id AND i.round_version=c.round_version ORDER BY i.id DESC LIMIT 1),'') FROM chat_reminder_clusters c WHERE c.id>? AND c.first_due_at<=UTC_TIMESTAMP(6) ORDER BY c.id LIMIT 20`, string(after))\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tout := []ReminderSummary{}\n\tfor rows.Next() {\n\t\tvar v ReminderSummary\n\t\tif rows.Scan(&v.ID, &v.Conversation, &v.Recipient, &v.FirstDue, &v.Target, &v.LastNotified, &v.Rounds, &v.State, &v.Diagnostic) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tout = append(out, v)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"reminders.summary\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\treturn nil, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn nil, err\n\t}\n\treturn out, nil\n}\n","chat/internal/message/governance_http.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n)\n\ntype governanceAction struct {\n\tConversation ports.ID `json:\"conversation_id,omitempty\"`\n\tMessage      ports.ID `json:\"message_id,omitempty\"`\n\tItem         ports.ID `json:\"item_id,omitempty\"`\n\tCase         ports.ID `json:\"case_id,omitempty\"`\n\tTarget       ports.ID `json:\"target_id,omitempty\"`\n\tActor        ports.ID `json:\"actor_id,omitempty\"`\n\tExpected     ports.ID `json:\"expected_version,omitempty\"`\n\tCursor       string   `json:\"cursor,omitempty\"`\n\tAfter        ports.ID `json:\"after,omitempty\"`\n\tLimit        int      `json:\"limit,omitempty\"`\n\tSeconds      int      `json:\"seconds,omitempty\"`\n\tReason       string   `json:\"reason,omitempty\"`\n\tAction       string   `json:\"action,omitempty\"`\n\tTargetType   string   `json:\"target_type,omitempty\"`\n\tThumbnail    bool     `json:\"thumbnail,omitempty\"`\n}\ntype GovernanceHandler struct {\n\tservice  *GovernanceService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewGovernanceHandler(g *GovernanceService, id ports.Identity, concurrency int) (*GovernanceHandler, error) {\n\tif g == nil || id == nil || concurrency < 1 || concurrency > 16 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &GovernanceHandler{g, id, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *GovernanceHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tfail := func(status int, code string) {\n\t\tw.WriteHeader(status)\n\t\tjson.NewEncoder(w).Encode(map[string]any{\"code\": code, \"message\": \"操作未完成，请刷新状态后重试\", \"retryable\": status >= 500})\n\t}\n\troutes := map[string]string{\n\t\t\"audit/av\":   \"conversation_id message_id\",\n\t\t\"audit/list\": \"cursor limit\", \"audit/history\": \"conversation_id cursor message_id limit\", \"audit/url\": \"conversation_id message_id item_id thumbnail\",\n\t\t\"governance/reminders\": \"after\", \"governance/status\": \"actor_id\", \"governance/restrict\": \"actor_id expected_version action seconds reason\", \"governance/report\": \"conversation_id message_id item_id reason\",\n\t\t\"governance/appeal\": \"target_type target_id expected_version reason\", \"governance/cases\": \"after\", \"governance/queue\": \"after\",\n\t\t\"governance/evidence\": \"case_id expected_version item_id reason\", \"governance/decide\": \"case_id expected_version action reason\",\n\t}\n\troute := strings.TrimPrefix(r.URL.Path, \"/chat/api/v1/\")\n\tfields, ok := routes[route]\n\tif !ok || r.URL.Path != \"/chat/api/v1/\"+route {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\tcontent, _, err := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif err != nil || content != \"application/json\" || r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error())\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tp, err := h.identity.Authenticate(r.Context(), strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif err != nil {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\traw, err := io.ReadAll(io.LimitReader(r.Body, 8193))\n\tif err != nil || len(raw) > 8192 {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tvar q governanceAction\n\tvar keys map[string]json.RawMessage\n\tif !strictImageJSON(raw, &q) || json.Unmarshal(raw, &keys) != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tallowed := map[string]bool{}\n\tfor _, v := range strings.Fields(fields) {\n\t\tallowed[v] = true\n\t}\n\tfor k, v := range keys {\n\t\tif !allowed[k] || string(v) == \"null\" {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\t\treturn\n\t\t}\n\t}\n\tvar data any\n\tswitch route {\n\tcase \"audit/list\":\n\t\tdata, err = h.service.AuditList(r.Context(), p, q.Cursor, q.Limit)\n\tcase \"audit/history\":\n\t\tdata, err = h.service.AuditHistory(r.Context(), p, HistoryRequest{ConversationID: q.Conversation, Cursor: q.Cursor, TargetID: q.Message, Limit: q.Limit})\n\tcase \"audit/av\":\n\t\tdata, err = h.service.AuditAV(r.Context(), p, q.Conversation, q.Message)\n\tcase \"audit/url\":\n\t\tvar url string\n\t\turl, err = h.service.AuditImage(r.Context(), p, q.Conversation, q.Message, q.Item, q.Thumbnail)\n\t\tdata = map[string]any{\"url\": url, \"expires_in\": 60}\n\tcase \"governance/reminders\":\n\t\tdata, err = h.service.ReminderSummaries(r.Context(), p, q.After)\n\tcase \"governance/status\":\n\t\tif q.Actor == \"\" {\n\t\t\tq.Actor = p.ActorID\n\t\t}\n\t\tdata, err = h.service.Restriction(r.Context(), p, q.Actor)\n\tcase \"governance/restrict\":\n\t\tdata, err = h.service.Restrict(r.Context(), p, RestrictionRequest{Actor: q.Actor, Expected: q.Expected, Action: q.Action, Seconds: q.Seconds, Reason: q.Reason})\n\tcase \"governance/report\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Report(r.Context(), p, q.Conversation, q.Message, q.Item, q.Reason)\n\t\tdata = map[string]any{\"case_id\": id}\n\tcase \"governance/appeal\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Appeal(r.Context(), p, q.TargetType, q.Target, q.Expected, q.Reason)\n\t\tdata = map[string]any{\"case_id\": id}\n\tcase \"governance/cases\", \"governance/queue\":\n\t\tdata, err = h.service.Cases(r.Context(), p, q.After, route == \"governance/queue\")\n\tcase \"governance/evidence\":\n\t\tdata, err = h.service.Evidence(r.Context(), p, q.Case, q.Expected, q.Item, q.Reason)\n\tcase \"governance/decide\":\n\t\tdata, err = h.service.Decide(r.Context(), p, CaseDecision{ID: q.Case, Expected: q.Expected, Action: q.Action, Reason: q.Reason})\n\t}\n\tif err != nil {\n\t\tstatus := 503\n\t\tswitch {\n\t\tcase errors.Is(err, auth.ErrUnauthorized):\n\t\t\tstatus = 401\n\t\tcase errors.Is(err, policy.ErrDenied):\n\t\t\tstatus = 403\n\t\tcase errors.Is(err, ports.ErrInvalid):\n\t\t\tstatus = 400\n\t\tcase errors.Is(err, ports.ErrBusy):\n\t\t\tstatus = 429\n\t\tcase errors.Is(err, ErrResync), errors.Is(err, ErrMediaVersion), errors.Is(err, ErrPreferenceConflict), errors.Is(err, ErrMedia):\n\t\t\tstatus = 409\n\t\t}\n\t\tfail(status, err.Error())\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]any{\"data\": data, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/governance_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc governanceFixture(t *testing.T, f *fixtureDB, s *Service, m *MediaService) (*GovernanceService, ports.Principal) {\n\tt.Helper()\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"k\", 32)), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tg, err := NewGovernanceService(s, h, m, \"test\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(`INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(91001,'governance-fixture','fixture','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tf.exec(`INSERT INTO chat_admin_sessions(id,admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(91001,91001,REPEAT('d',64),REPEAT('e',64),REPEAT('f',64),'[\"chat:audit\",\"chat:moderate\",\"chat:images\",\"chat:evidence\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())`)\n\tp := ports.Principal{ActorID: \"91001\", Kind: \"admin\", SourceID: \"91001\", SessionID: strings.Repeat(\"d\", 64), SessionVersion: strings.Repeat(\"e\", 64), Environment: \"test\", Scopes: []string{\"chat:audit\", \"chat:moderate\", \"chat:images\", \"chat:evidence\"}, ExpiresAt: time.Now().Add(time.Minute)}\n\treturn g, p\n}\nfunc TestMySQLS18AuditSnapshotIsolationAndRevocation(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tfirst := accepted(t, s, q)\n\tfor i := 0; i < 5; i++ {\n\t\tf.exec(`INSERT INTO chat_conversations(conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at) VALUES('order',CONCAT('fixture-audit:',?),?, ?,1,REPEAT('a',64),'fixture','readonly',UTC_TIMESTAMP(6)-INTERVAL 1 DAY,UTC_TIMESTAMP(6))`, i, 600+i, 600+i)\n\t}\n\tpage, err := g.AuditList(ctx, admin, \"\", 2)\n\tif err != nil || len(page.Items) != 2 || !page.More {\n\t\tt.Fatal(page, err)\n\t}\n\ttotal := f.text(\"SELECT COUNT(*) FROM chat_conversations\")\n\tseen := map[ports.ID]bool{}\n\tfor _, item := range page.Items {\n\t\tseen[item.ID] = true\n\t}\n\t// Move an unseen row to the top after the snapshot was created.\n\tf.exec(`UPDATE chat_conversations SET last_message_at=UTC_TIMESTAMP(6)+INTERVAL 1 DAY WHERE scope_key='fixture-audit:4'`)\n\tfor page.More {\n\t\tpage, err = g.AuditList(ctx, admin, page.Cursor, 2)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tfor _, item := range page.Items {\n\t\t\tif seen[item.ID] {\n\t\t\t\tt.Fatal(\"activity change duplicated snapshot row\")\n\t\t\t}\n\t\t\tseen[item.ID] = true\n\t\t}\n\t}\n\tif decimal(uint64(len(seen))) != ports.ID(total) {\n\t\tt.Fatal(\"snapshot lost conversations\", len(seen), total)\n\t}\n\tif _, err = g.AuditList(ctx, principal(\"10203\"), \"\", 20); err == nil {\n\t\tt.Fatal(\"platform staff inherited audit\")\n\t}\n\tmini := principal(\"10203\")\n\tmini.Kind = \"mini_audit\"\n\tmini.Scopes = []string{\"chat:audit\"}\n\tif _, err = g.AuditList(ctx, mini, \"\", 20); err == nil {\n\t\tt.Fatal(\"ungranted mini audit\")\n\t}\n\tf.exec(`INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(10203,1,REPEAT('f',64),91001,'独立抽检测试',UTC_TIMESTAMP(6))`)\n\tmini.SessionVersion = digest(\"mini-audit-v1\\n10203\\n\" + digest(\"login:10203\") + \"\\n10203\\n\" + strings.Repeat(\"f\", 64))\n\tif _, err = g.AuditList(ctx, mini, \"\", 20); err != nil {\n\t\tt.Fatal(\"independent grant\", err)\n\t}\n\tif _, err = f.store.Authorize(ctx, ports.PolicyRequest{Actor: mini, ConversationID: q.ConversationID, Action: \"send\"}); err == nil {\n\t\tt.Fatal(\"audit identity used ordinary member path\")\n\t}\n\tbefore := f.text(\"SELECT COUNT(*) FROM chat_member_reads\")\n\tdetail, err := g.AuditHistory(ctx, admin, HistoryRequest{ConversationID: q.ConversationID})\n\tif err != nil || len(detail.Messages) != 1 || detail.Messages[0].Text == nil {\n\t\tt.Fatal(detail, err)\n\t}\n\tif _, err = s.Recall(ctx, principal(\"10202\"), q.ConversationID, first.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdetail, err = g.AuditHistory(ctx, admin, HistoryRequest{ConversationID: q.ConversationID, TargetID: first.MessageID})\n\tif err != nil || detail.Messages[0].Text != nil || detail.Messages[0].State != \"recalled\" {\n\t\tt.Fatal(\"audit leaked recall\", detail, err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != before {\n\t\tt.Fatal(\"audit marked read\")\n\t}\n\tf.exec(\"UPDATE chat_mini_auditors SET enabled=0 WHERE user_id=10203\")\n\tif _, err = g.AuditHistory(ctx, mini, HistoryRequest{ConversationID: q.ConversationID}); err == nil {\n\t\tt.Fatal(\"revoked mini audit\")\n\t}\n\tf.exec(\"UPDATE chat_mini_auditors SET enabled=1,authority_version=REPEAT('a',64) WHERE user_id=10203\")\n\tif _, err = g.AuditHistory(ctx, mini, HistoryRequest{ConversationID: q.ConversationID}); err == nil {\n\t\tt.Fatal(\"old revoked grant revived after regrant\")\n\t}\n\tf.exec(\"UPDATE admin_users SET role='viewer' WHERE id=91001\")\n\tif _, err = g.AuditList(ctx, admin, \"\", 20); err == nil {\n\t\tt.Fatal(\"revoked admin\")\n\t}\n\tif _, err = f.goDB.ExecContext(ctx, \"UPDATE chat_governance_audit SET reason='tamper'\"); err == nil {\n\t\tt.Fatal(\"audit table mutable by Go\")\n\t}\n}\nfunc TestMySQLS19BanSerializesPendingSendAndKeepsReadRecallAppeal(t *testing.T) {\n\tstarted, resume := make(chan struct{}), make(chan struct{})\n\tvar once sync.Once\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tfirst := accepted(t, s, q)\n\ts.safety = safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\tonce.Do(func() { close(started) })\n\t\t<-resume\n\t\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: \"s19-fixture\"}, nil\n\t})\n\tq.ClientMessageID = client(22)\n\tdone := make(chan error, 1)\n\tgo func() { _, err := s.Send(ctx, principal(\"10202\"), q); done <- err }()\n\t<-started\n\tblocked, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"0\", Action: \"permanent\", Reason: \"并发禁聊测试\"})\n\tif err != nil || !blocked.Blocked {\n\t\tt.Fatal(blocked, err)\n\t}\n\tclose(resume)\n\tif err = <-done; err != ErrRestricted {\n\t\tt.Fatal(\"in-flight send bypassed restriction\", err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"late publish\")\n\t}\n\tif _, err = g.history.Read(ctx, principal(\"10202\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\"); err != nil {\n\t\tt.Fatal(\"ban blocked legal read\", err)\n\t}\n\tif _, err = s.Recall(ctx, principal(\"10202\"), q.ConversationID, first.MessageID); err != nil {\n\t\tt.Fatal(\"ban blocked recall\", err)\n\t}\n\tid, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", blocked.Version, \"对此次禁聊提出申诉\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Evidence(ctx, admin, id, \"1\", \"\", \"核对禁聊依据\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: id, Expected: \"1\", Action: \"correct\", Reason: \"核查后解除限制\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstatus, err := g.Restriction(ctx, principal(\"10202\"), \"10202\")\n\tif err != nil || status.Blocked || status.Version != \"2\" {\n\t\tt.Fatal(status, err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"appeal resent old action\")\n\t}\n\ttimed, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"2\", Action: \"timed\", Seconds: 60, Reason: \"限时到期测试\"})\n\tif err != nil || !timed.Blocked {\n\t\tt.Fatal(timed, err)\n\t}\n\tf.exec(\"UPDATE chat_restrictions SET blocked_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND WHERE actor_id=10202\")\n\tif err = g.ExpireRestrictions(ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstatus, err = g.Restriction(ctx, principal(\"10202\"), \"10202\")\n\tif err != nil || status.Blocked || status.Version != \"4\" {\n\t\tt.Fatal(status, err)\n\t}\n\tbannedAgain, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"4\", Action: \"permanent\", Reason: \"独立第二次禁聊\"})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsecond, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", bannedAgain.Version, \"第二次禁聊独立申诉\")\n\tif err != nil || second == id {\n\t\tt.Fatal(\"new restriction generation reused old case\", second, err)\n\t}\n\tagain, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", bannedAgain.Version, \"重复提交同一申诉\")\n\tif err != nil || again != second {\n\t\tt.Fatal(\"same generation duplicated appeal\", again, err)\n\t}\n}\nfunc TestMySQLS19ReportsScopeEvidenceAndFalsePositiveCorrection(t *testing.T) {\n\tsafety := safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: \"s19-fixture\", Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: \"fixture_risk\", Level: 2, Confirmed: true}}, nil\n\t})\n\tf, s, q := setupMessage(t, safety)\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tresult, err := s.Send(ctx, principal(\"10202\"), q)\n\tif err != nil || result.RiskEventID == \"\" {\n\t\tt.Fatal(result, err)\n\t}\n\tid, err := g.Appeal(ctx, principal(\"10202\"), \"risk\", result.RiskEventID, \"1\", \"认为此内容存在误判\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Appeal(ctx, principal(\"10203\"), \"risk\", result.RiskEventID, \"1\", \"不能申诉他人内容\"); err == nil {\n\t\tt.Fatal(\"foreign evidence appeal\")\n\t}\n\tweak := admin\n\tweak.Scopes = []string{\"chat:audit\", \"chat:moderate\"}\n\tif _, err = g.Evidence(ctx, weak, id, \"1\", \"\", \"普通权限不能读原文\"); err == nil {\n\t\tt.Fatal(\"missing distinct evidence scope\")\n\t}\n\tevidence, err := g.Evidence(ctx, admin, id, \"1\", \"\", \"核对原文及上下文\")\n\tif err != nil || evidence.Text == nil || *evidence.Text != q.Text {\n\t\tt.Fatal(evidence, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: id, Expected: \"1\", Action: \"correct\", Reason: \"原内容确认为误判\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE confirmed=1\") != \"0\" {\n\t\tt.Fatal(\"false positive still counted\")\n\t}\n\tagain, err := s.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif err != nil || again.State != \"rejected\" {\n\t\tt.Fatal(\"corrected old intent resurrected\", again, err)\n\t}\n\tnoMessages(t, f)\n\ts.safety = safetyFunc(pass)\n\tq.ClientMessageID = client(29)\n\tmessage := accepted(t, s, q)\n\treport, err := g.Report(ctx, principal(\"10203\"), q.ConversationID, message.MessageID, \"\", \"此消息需要平台核查\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tduplicate, err := g.Report(ctx, principal(\"10203\"), q.ConversationID, message.MessageID, \"\", \"重复举报合并\")\n\tif err != nil || duplicate != report {\n\t\tt.Fatal(\"duplicate case\", duplicate, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"block\", Reason: \"尚未查看证据\"}); err == nil {\n\t\tt.Fatal(\"decision without evidence\")\n\t}\n\tif _, err = g.Evidence(ctx, admin, report, \"1\", \"\", \"查看被举报原消息\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"block\", Reason: \"确认需要屏蔽\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpage, err := g.history.Read(ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif err != nil || len(page.Messages) != 1 || page.Messages[0].Text != nil || page.Messages[0].State != \"blocked\" {\n\t\tt.Fatal(\"block projection\", page, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"dismiss\", Reason: \"旧版本不能覆盖\"}); err == nil {\n\t\tt.Fatal(\"stale decision\")\n\t}\n}\n","chat/internal/message/governance_maintenance.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// One bounded pass. S22 owns wider archive/backup policy; this pass expires\n// governance evidence holds only after every linked case's retention ends.\nfunc (g *GovernanceService) ExpireEvidence(ctx context.Context) error {\n\treturn expireGovernanceEvidence(ctx, g.base.db, g.environment)\n}\nfunc expireGovernanceEvidence(ctx context.Context, db *sql.DB, environment string) error {\n\t// Risk TTL may be later than its original review case (action cutoff +30d).\n\t// Revisit due risk evidence independently, even after that case was expired.\n\tif _, err := db.ExecContext(ctx, `UPDATE chat_risk_events SET text_evidence='',context_evidence='' WHERE retain_until<=UTC_TIMESTAMP(6) AND (text_evidence<>'' OR context_evidence<>'') AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='risk' AND c.target_id=chat_risk_events.id AND c.retain_until>UTC_TIMESTAMP(6)) ORDER BY retain_until,id LIMIT 30`); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\trows, err := db.QueryContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_cases WHERE retain_until<=UTC_TIMESTAMP(6) AND state<>'expired' ORDER BY retain_until,id LIMIT 30`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\ttx, err := db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// Expired cases cannot be opened through caseLock; lock in the same order.\n\t\tvar subject, cid ports.ID\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(subject_id AS CHAR),CAST(conversation_id AS CHAR) FROM chat_cases WHERE id=?`, string(id)).Scan(&subject, &cid) != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = restrictionLocked(ctx, tx, subject); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif cid != \"0\" {\n\t\t\tvar n int\n\t\t\tif tx.QueryRowContext(ctx, `SELECT 1 FROM chat_conversations WHERE id=? FOR UPDATE`, string(cid)).Scan(&n) != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tc, err := scanCase(tx.QueryRowContext(ctx, `SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) FOR UPDATE`, string(id)))\n\t\tif err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif c.State == \"expired\" {\n\t\t\ttx.Rollback()\n\t\t\tcontinue\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_cases SET resolution=CONCAT('expired:',state),reason='',state='expired',version=version+1 WHERE id=?`, string(id)); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif c.TargetType == \"risk\" {\n\t\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET text_evidence='',context_evidence='' WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='risk' AND c.target_id=chat_risk_events.id AND c.retain_until>UTC_TIMESTAMP(6))`, string(c.Target))\n\t\t}\n\t\tif err == nil && (c.TargetType == \"message\" || c.TargetType == \"image_intent\") {\n\t\t\titems, e := caseImageItems(ctx, tx, c)\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tfor _, item := range items {\n\t\t\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads u SET legal_hold=0 WHERE u.id=? AND NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_image_items i ON c.target_type='message' AND c.target_id=i.message_id WHERE i.item_id=u.id AND c.retain_until>UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='image_intent' AND c.subject_id=u.actor_id AND c.conversation_id=u.conversation_id AND c.retain_until>UTC_TIMESTAMP(6))`, string(item.ItemID))\n\t\t\t\tif err != nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif err == nil {\n\t\t\terr = releaseAVHolds(ctx, tx)\n\t\t}\n\t\tif err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tsys := ports.Principal{Kind: \"system\", ActorID: \"0\", Environment: environment}\n\t\tif err = governanceLog(ctx, tx, sys, \"evidence.expire\", c.Conversation, c.ID, c.Item, decimal(number(c.Version)+1), \"治理证据保留期结束\"); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\ttx, e := db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tif e = releaseAVHolds(ctx, tx); e != nil {\n\t\treturn e\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) Maintain(ctx context.Context, reminders *ReminderService) error {\n\tif err := g.ExpireRestrictions(ctx); err != nil {\n\t\treturn err\n\t}\n\tif err := g.CleanupSnapshots(ctx); err != nil {\n\t\treturn err\n\t}\n\tif err := g.ExpireEvidence(ctx); err != nil {\n\t\treturn err\n\t}\n\tif reminders != nil {\n\t\tif err := reminders.Reconcile(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := reminders.DrainEvents(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := reminders.Prepare(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn reminders.SubmitPending(ctx)\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) Run(ctx context.Context, reminders *ReminderService) {\n\tticker := time.NewTicker(time.Second)\n\tdefer ticker.Stop()\n\tfor {\n\t\tpass, cancel := context.WithTimeout(ctx, 10*time.Second)\n\t\t_ = g.Maintain(pass, reminders)\n\t\tcancel()\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n}\n\nfunc (r *ReminderService) Reconcile(ctx context.Context) error {\n\treader, ok := r.notification.(reminderReceipts)\n\tif !ok {\n\t\treturn nil\n\t}\n\trows, err := r.base.db.QueryContext(ctx, `SELECT operation_id FROM chat_reminder_intents WHERE (state IN ('submitted','provider_unknown') OR (state='retryable' AND attempts>=8)) AND (next_receipt_at IS NULL OR next_receipt_at<=UTC_TIMESTAMP(6)) ORDER BY next_receipt_at,id LIMIT 20`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tops := []string{}\n\tfor rows.Next() {\n\t\tvar op string\n\t\tif rows.Scan(&op) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tops = append(ops, op)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, op := range ops {\n\t\tif _, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET next_receipt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND WHERE operation_id=?`, op); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treceipt, e := reader.Status(ctx, op)\n\t\tif e != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif receipt.OperationID != op {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif receipt.State != \"accepted\" {\n\t\t\tif e = r.reconcileOne(ctx, op, receipt); e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t} else {\n\t\t\tif _, e = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='submitted' WHERE operation_id=? AND state='retryable'`, op); e != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) reconcileOne(ctx context.Context, op string, receipt ports.Receipt) error {\n\tif receipt.State != \"sent\" && receipt.State != \"suppressed\" && receipt.State != \"channel_limited\" && receipt.State != \"provider_unknown\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar c reminderCluster\n\tif r.base.db.QueryRowContext(ctx, `SELECT CAST(cluster_id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_intents WHERE operation_id=?`, op).Scan(&c.ID, &c.CID, &c.Actor, &c.Hash) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\t// Current PHP guard/account -> conversation -> cluster -> intent -> budget.\n\tw, windowErr := r.window(ctx, tx, c.CID, c.Actor, ^uint64(0))\n\terr = windowErr\n\tif err != nil && err != policy.ErrDenied {\n\t\treturn err\n\t}\n\tvar currentVersion uint64\n\tif tx.QueryRowContext(ctx, `SELECT round_version,rounds FROM chat_reminder_clusters WHERE id=? FOR UPDATE`, string(c.ID)).Scan(&currentVersion, &c.Round) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar version, target uint64\n\tvar round int\n\tvar state string\n\tvar created time.Time\n\tvar released bool\n\tif tx.QueryRowContext(ctx, `SELECT round_version,round_no,target_seq,state,created_at,budget_released FROM chat_reminder_intents WHERE operation_id=? FOR UPDATE`, op).Scan(&version, &round, &target, &state, &created, &released) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif state == \"sent\" || state == \"suppressed\" || state == \"channel_limited\" {\n\t\treturn nil\n\t}\n\tif receipt.State == \"suppressed\" || receipt.State == \"channel_limited\" {\n\t\tif !released {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_budgets SET hour_count=GREATEST(0,CAST(hour_count AS SIGNED)-IF(hour_start<=?,1,0)),day_count=GREATEST(0,CAST(day_count AS SIGNED)-IF(day_start=DATE(?),1,0)) WHERE recipient_id IN (0,?)`, created, created, string(c.Actor)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\treleased = true\n\t\t}\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_intents SET state=?,diagnostic=?,budget_released=? WHERE operation_id=?`, receipt.State, receipt.Diagnostic, released, op); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif version == currentVersion {\n\t\tif receipt.State == \"sent\" && round == c.Round+1 {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET rounds=?,last_notified_seq=GREATEST(last_notified_seq,?),first_notified_at=COALESCE(first_notified_at,UTC_TIMESTAMP(6)),next_due=TIMESTAMPADD(MINUTE,?,COALESCE(first_notified_at,UTC_TIMESTAMP(6))),state=IF(? >= 3,'exhausted','open'),blocked_reason=NULL WHERE id=?`, round, target, 5+(round-1)*10, round, string(c.ID)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t} else if receipt.State == \"channel_limited\" || receipt.State == \"provider_unknown\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state=?,blocked_reason=? WHERE id=?`, receipt.State, receipt.Diagnostic, string(c.ID)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t} else if receipt.State == \"suppressed\" {\n\t\t\tif windowErr == nil && w.First > 0 && w.Read >= target {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET round_version=round_version+1,first_seq=?,target_seq=?,first_due_at=TIMESTAMPADD(SECOND,?,?),next_due=TIMESTAMPADD(SECOND,?,?),first_notified_at=NULL,rounds=0,state='open',blocked_reason=NULL WHERE id=?`, w.First, w.Target, r.config.FirstDelaySeconds, w.At, r.config.FirstDelaySeconds, w.At, string(c.ID)); err != nil {\n\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state=IF(target_seq<=?,'closed',state),blocked_reason=? WHERE id=?`, target, receipt.Diagnostic, string(c.ID)); err != nil {\n\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/history.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// HistoryService is shared by HTTP and future WSS. All reads are bounded and\n// hold current authority and the same conversation commit lock as publication.\ntype HistoryService struct {\n\tdb            *sql.DB\n\tconversations *conversation.Store\n\tenvironment   string\n\tkey           []byte\n\ttimeout       time.Duration\n\tcapabilities  MessageCapabilities\n}\n\nfunc NewHistoryService(db *sql.DB, c *conversation.Store, env string, key []byte, timeout time.Duration) (*HistoryService, error) {\n\tif db == nil || c == nil || len(key) != 32 || (env != \"test\" && env != \"development\" && env != \"production\") || timeout < 100*time.Millisecond || timeout > 3*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &HistoryService{db: db, conversations: c, environment: env, key: append([]byte(nil), key...), timeout: timeout, capabilities: MessageCapabilities{Cache: true}}, nil\n}\n\ntype HistoryRequest struct {\n\tConversationID ports.ID `json:\"conversation_id\"`\n\tCursor         string   `json:\"cursor,omitempty\"`\n\tTargetID       ports.ID `json:\"message_id,omitempty\"`\n\tLimit          int      `json:\"limit,omitempty\"`\n}\ntype MessageView struct {\n\tAV            *AVView        `json:\"av,omitempty\"`\n\tRetentionMode string         `json:\"retention_mode\"`\n\tExpiresAt     *time.Time     `json:\"cloud_expires_at,omitempty\"`\n\tImageCount    int            `json:\"image_count,omitempty\"`\n\tImages        []ImageView    `json:\"images,omitempty\"`\n\tReplyItem     ports.ID       `json:\"-\"`\n\tID            ports.ID       `json:\"message_id\"`\n\tSeq           ports.ID       `json:\"seq\"`\n\tSenderID      ports.ID       `json:\"sender_id\"`\n\tPolicyVersion ports.ID       `json:\"policy_version\"`\n\tType          string         `json:\"message_type\"`\n\tState         string         `json:\"state\"`\n\tStateVersion  ports.ID       `json:\"state_version\"`\n\tText          *string        `json:\"text,omitempty\"`\n\tCreatedAt     time.Time      `json:\"created_at\"`\n\tReplyTo       ports.ID       `json:\"-\"`\n\tEditedFrom    ports.ID       `json:\"-\"`\n\tReply         *ReferenceView `json:\"reply,omitempty\"`\n\tEditedSource  *ReferenceView `json:\"edited_from,omitempty\"`\n}\ntype ChangeView struct {\n\tSeq     ports.ID    `json:\"change_seq\"`\n\tType    string      `json:\"change_type\"`\n\tMessage MessageView `json:\"message\"`\n}\ntype MessageCapabilities struct {\n\tCache  bool `json:\"cache\"`\n\tImages bool `json:\"images\"`\n\tAudio  bool `json:\"audio\"`\n\tVideo  bool `json:\"video\"`\n}\n\nfunc (s *HistoryService) ConfigureMedia(images, audio, video bool) {\n\ts.capabilities = MessageCapabilities{Cache: true, Images: images, Audio: audio, Video: video}\n}\n\ntype HistoryPage struct {\n\tCapabilities      *MessageCapabilities `json:\"capabilities,omitempty\"`\n\tOrderContext      *ports.OrderContext  `json:\"order_context,omitempty\"`\n\tMemberRole        string               `json:\"member_role\"`\n\tCanSend           bool                 `json:\"can_send\"`\n\tViewerID          ports.ID             `json:\"viewer_actor_id,omitempty\"`\n\tMessages          []MessageView        `json:\"messages\"`\n\tChanges           []ChangeView         `json:\"changes\"`\n\tPolicyVersion     ports.ID             `json:\"policy_version\"`\n\tSnapshotMaxSeq    ports.ID             `json:\"snapshot_max_seq\"`\n\tSnapshotMaxChange ports.ID             `json:\"snapshot_max_change_seq\"`\n\tNextSync          ports.ID             `json:\"next_sync_cursor,omitempty\"`\n\tNextChange        ports.ID             `json:\"next_change_cursor,omitempty\"`\n\tSyncCursor        string               `json:\"sync_cursor,omitempty\"`\n\tChangeCursor      string               `json:\"change_cursor,omitempty\"`\n\tHistoryCursor     string               `json:\"history_cursor,omitempty\"`\n\tHasMore           bool                 `json:\"has_more\"`\n\tExpiresAt         int64                `json:\"expires_at\"`\n}\ntype historyRead struct {\n\tactor                              ports.ID\n\ttx                                 *sql.Tx\n\tgrant                              ports.Grant\n\tcursor                             historyCursor\n\tseq, change, floorSeq, floorChange uint64\n}\n\nfunc (s *HistoryService) open(ctx context.Context, p ports.Principal, q HistoryRequest, mode string) (*historyRead, error) {\n\tif !validID(q.ConversationID) || p.Environment != s.environment || q.Limit < 0 || q.Limit > 50 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tvar c historyCursor\n\tvar e error\n\tif mode != \"bootstrap\" && mode != \"locate\" {\n\t\tc, e = s.parse(q.Cursor, mode)\n\t\tif e != nil {\n\t\t\treturn nil, e\n\t\t}\n\t\tif c.Binding != bindingFor(s.environment, p) || c.Conversation != q.ConversationID {\n\t\t\treturn nil, ErrResync\n\t\t}\n\t} else if q.Cursor != \"\" {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tfail := func(e error) (*historyRead, error) { tx.Rollback(); return nil, e }\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"})\n\tif e != nil {\n\t\treturn fail(e)\n\t}\n\tr := &historyRead{tx: tx, grant: g, actor: p.ActorID}\n\tif e = tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq,sync_floor_seq,change_floor_seq FROM chat_conversations WHERE id=?`, string(q.ConversationID)).Scan(&r.seq, &r.change, &r.floorSeq, &r.floorChange); e != nil {\n\t\treturn fail(ports.ErrUnavailable)\n\t}\n\tif r.floorSeq > r.seq || r.floorChange > r.change {\n\t\treturn fail(ports.ErrUnavailable)\n\t}\n\tif mode == \"bootstrap\" || mode == \"locate\" {\n\t\tnow := time.Now().Unix()\n\t\tc = historyCursor{Schema: 1, Binding: bindingFor(s.environment, p), Conversation: q.ConversationID, Policy: g.Version, Member: g.MemberKey, Seq: decimal(r.seq), Change: decimal(r.change), Issued: now, Expiry: now + int64(cursorTTL/time.Second)}\n\t} else {\n\t\tif c.Policy != g.Version || c.Member != g.MemberKey || number(c.Seq) > r.seq || number(c.Change) > r.change {\n\t\t\treturn fail(ErrResync)\n\t\t}\n\t\tupper := number(c.Seq)\n\t\tfloor := r.floorSeq\n\t\tif mode == \"changes\" {\n\t\t\tupper = number(c.Change)\n\t\t\tfloor = r.floorChange\n\t\t}\n\t\tif number(c.Position) > upper || number(c.Position) < floor {\n\t\t\treturn fail(ErrResync)\n\t\t}\n\t\tif mode != \"history\" && !c.Pending {\n\t\t\tc.Seq = decimal(r.seq)\n\t\t\tc.Change = decimal(r.change)\n\t\t\tc.Issued = time.Now().Unix()\n\t\t\tc.Expiry = c.Issued + int64(cursorTTL/time.Second)\n\t\t}\n\t}\n\tr.cursor = c\n\treturn r, nil\n}\nfunc emptyPage(r *historyRead) HistoryPage {\n\treturn HistoryPage{OrderContext: r.grant.OrderContext, MemberRole: r.grant.MemberRole, CanSend: r.grant.CanSend, ViewerID: r.actor, Messages: []MessageView{}, Changes: []ChangeView{}, PolicyVersion: r.grant.Version, SnapshotMaxSeq: r.cursor.Seq, SnapshotMaxChange: r.cursor.Change, ExpiresAt: r.cursor.Expiry}\n}\n\n// Projection is safe in SQL too: hidden bodies never cross the DB boundary.\nconst viewColumns = `CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),CAST(m.policy_version AS CHAR),m.message_type,m.state,CAST(m.state_version AS CHAR),CASE WHEN m.state='published' AND m.message_type='text' THEN m.text_body ELSE NULL END,m.created_at,CAST(m.reply_to_message_id AS CHAR),CAST(m.edited_from_recalled_message_id AS CHAR),CAST(m.reply_to_item_id AS CHAR),m.retention_mode,m.expires_at`\nconst visibleColumn = `(m.policy_version<=? AND EXISTS(SELECT 1 FROM chat_member_intervals i WHERE i.conversation_id=m.conversation_id AND i.actor_id=? AND i.start_version<=m.policy_version AND (i.end_version IS NULL OR i.end_version>m.policy_version)))`\n\ntype candidate struct {\n\tview    MessageView\n\tvisible bool\n\tchange  ports.ID\n\tkind    string\n}\n\nfunc scanCandidate(rows *sql.Rows, changes bool) (candidate, error) {\n\tvar c candidate\n\tvar text, reply, edited, replyItem sql.NullString\n\targs := []any{&c.view.ID, &c.view.Seq, &c.view.SenderID, &c.view.PolicyVersion, &c.view.Type, &c.view.State, &c.view.StateVersion, &text, &c.view.CreatedAt, &reply, &edited, &replyItem, &c.view.RetentionMode, &c.view.ExpiresAt, &c.visible}\n\tif changes {\n\t\targs = append(args, &c.change, &c.kind)\n\t}\n\tif rows.Scan(args...) != nil || !validID(c.view.ID) || !validID(c.view.Seq) || !validID(c.view.StateVersion) {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\tif replyItem.Valid {\n\t\tc.view.ReplyItem = ports.ID(replyItem.String)\n\t}\n\tif reply.Valid {\n\t\tc.view.ReplyTo = ports.ID(reply.String)\n\t}\n\tif edited.Valid {\n\t\tc.view.EditedFrom = ports.ID(edited.String)\n\t}\n\tif c.view.State == \"published\" && c.view.Type == \"text\" && text.Valid {\n\t\tv := text.String\n\t\tc.view.Text = &v\n\t} else if c.view.State == \"published\" && (c.view.Type==\"text\"||c.view.Type == \"image\" || c.view.Type == \"image_album\" || c.view.Type==\"audio\" || c.view.Type==\"video\") {\n\t\tc.view.Text = nil\n\t} else {\n\t\tc.view.Text = nil\n\t\tif c.view.State != \"recalled\" && c.view.State != \"blocked\" && c.view.State != \"expired\" {\n\t\t\tc.view.State = \"unavailable\"\n\t\t}\n\t}\n\treturn c, nil\n}\nfunc limitFor(q HistoryRequest) int {\n\tif q.Limit == 0 {\n\t\treturn 30\n\t}\n\treturn q.Limit\n}\nfunc (s *HistoryService) finish(ctx context.Context, p ports.Principal, r *historyRead, page HistoryPage) (HistoryPage, error) {\n\tcaps := s.capabilities\n\tpage.Capabilities = &caps\n\tviews := make([]*MessageView, 0, len(page.Messages)+len(page.Changes))\n\tfor i := range page.Messages {\n\t\tviews = append(views, &page.Messages[i])\n\t}\n\tfor i := range page.Changes {\n\t\tviews = append(views, &page.Changes[i].Message)\n\t}\n\tif err := hydrateImages(ctx, r.tx, views); err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tif err := hydrateAV(ctx, r.tx, p, views); err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tif err := hydrateReferences(ctx, r.tx, p, r.grant, r.cursor.Conversation, views); err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn HistoryPage{}, policy.ErrDenied\n\t}\n\tif r.tx.Commit() != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\treturn page, nil\n}\nfunc (s *HistoryService) Read(ctx context.Context, p ports.Principal, q HistoryRequest, mode string) (HistoryPage, error) {\n\tif mode != \"bootstrap\" && mode != \"history\" && mode != \"sync\" && mode != \"changes\" && mode != \"locate\" {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tif mode == \"locate\" {\n\t\treturn s.locate(ctx, p, q)\n\t}\n\tif q.TargetID != \"\" {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tr, e := s.open(ctx, p, q, mode)\n\tif e != nil {\n\t\treturn HistoryPage{}, e\n\t}\n\tdefer r.tx.Rollback()\n\tpage := emptyPage(r)\n\tc := r.cursor\n\tlimit := limitFor(q)\n\tposition := number(c.Position)\n\tupper := number(c.Seq)\n\tfloor := r.floorSeq\n\tdescending := mode == \"bootstrap\" || mode == \"history\"\n\tchanges := mode == \"changes\"\n\tif mode == \"bootstrap\" {\n\t\tposition = upper\n\t}\n\tif changes {\n\t\tupper = number(c.Change)\n\t\tfloor = r.floorChange\n\t}\n\ttable := `chat_messages m`\n\tindex := `m.seq`\n\textra := ``\n\tif changes {\n\t\ttable = `chat_message_changes ch STRAIGHT_JOIN chat_messages m ON m.id=ch.message_id AND m.conversation_id=ch.conversation_id`\n\t\tindex = `ch.change_seq`\n\t\textra = `,CAST(ch.change_seq AS CHAR),ch.change_type`\n\t}\n\tpredicate := index + `>? AND ` + index + `<=?`\n\tstart, end := position, upper\n\torder := ` ASC`\n\tif descending {\n\t\tpredicate = index + `>? AND ` + index + `<=?`\n\t\tstart, end = floor, position\n\t\torder = ` DESC`\n\t}\n\tscopeColumn := \"m.conversation_id\"\n\tif changes {\n\t\tscopeColumn = \"ch.conversation_id\"\n\t}\n\tquery := `SELECT ` + viewColumns + `,` + visibleColumn + extra + ` FROM ` + table + ` WHERE ` + scopeColumn + `=? AND ` + predicate + ` ORDER BY ` + index + order + ` LIMIT ?`\n\trows, e := r.tx.QueryContext(ctx, query, string(r.grant.Version), string(p.ActorID), string(q.ConversationID), start, end, limit+1)\n\tif e != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tcandidates := make([]candidate, 0, limit+1)\n\tfor rows.Next() {\n\t\tv, err := scanCandidate(rows, changes)\n\t\tif err != nil {\n\t\t\trows.Close()\n\t\t\treturn HistoryPage{}, err\n\t\t}\n\t\tcandidates = append(candidates, v)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tpage.HasMore = len(candidates) > limit\n\tif page.HasMore {\n\t\tcandidates = candidates[:limit]\n\t}\n\tnext := upper\n\tif descending {\n\t\tnext = floor\n\t}\n\tif len(candidates) > 0 && (page.HasMore || descending) {\n\t\tlast := candidates[len(candidates)-1]\n\t\tnext = number(last.view.Seq)\n\t\tif changes {\n\t\t\tnext = number(last.change)\n\t\t}\n\t\tif descending {\n\t\t\tnext--\n\t\t}\n\t}\n\tfor _, v := range candidates {\n\t\tif !v.visible {\n\t\t\tcontinue\n\t\t}\n\t\tif changes {\n\t\t\tpage.Changes = append(page.Changes, ChangeView{v.change, v.kind, v.view})\n\t\t} else {\n\t\t\tpage.Messages = append(page.Messages, v.view)\n\t\t}\n\t}\n\tif descending {\n\t\tfor i, j := 0, len(page.Messages)-1; i < j; i, j = i+1, j-1 {\n\t\t\tpage.Messages[i], page.Messages[j] = page.Messages[j], page.Messages[i]\n\t\t}\n\t\th := c\n\t\th.Mode = \"history\"\n\t\th.Position = decimal(next)\n\t\th.Pending = true\n\t\tif page.HasMore {\n\t\t\tpage.HistoryCursor = s.sign(h)\n\t\t}\n\t\tif mode == \"bootstrap\" {\n\t\t\tpage.NextSync = c.Seq\n\t\t\tpage.NextChange = c.Change\n\t\t\tsc := c\n\t\t\tsc.Mode = \"sync\"\n\t\t\tsc.Position = c.Seq\n\t\t\tsc.Pending = false\n\t\t\tpage.SyncCursor = s.sign(sc)\n\t\t\tsc.Mode = \"changes\"\n\t\t\tsc.Position = c.Change\n\t\t\tpage.ChangeCursor = s.sign(sc)\n\t\t} else {\n\t\t\tpage.NextSync = \"\"\n\t\t\tpage.NextChange = \"\"\n\t\t}\n\t} else {\n\t\tc.Mode = mode\n\t\tc.Position = decimal(next)\n\t\tc.Pending = page.HasMore\n\t\tif changes {\n\t\t\tpage.NextChange = c.Position\n\t\t\tpage.ChangeCursor = s.sign(c)\n\t\t} else {\n\t\t\tpage.NextSync = c.Position\n\t\t\tpage.SyncCursor = s.sign(c)\n\t\t}\n\t}\n\treturn s.finish(ctx, p, r, page)\n}\n","chat/internal/message/history_cursor.go":"package message\n\nimport (\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"os\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrResync = errors.New(\"CHAT_RESYNC_REQUIRED\")\n\nconst cursorTTL = 10 * time.Minute\n\ntype HistoryConfig struct {\n\tEnabled      bool   `json:\"enabled\"`\n\tCursorKeyEnv string `json:\"cursor_key_env\"`\n}\n\nvar cursorEnv = regexp.MustCompile(`^CHAT_[A-Z0-9_]{1,58}$`)\n\nfunc (c HistoryConfig) Key() ([]byte, error) {\n\tif !c.Enabled {\n\t\tif c.CursorKeyEnv != \"\" {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\treturn nil, nil\n\t}\n\tif !cursorEnv.MatchString(c.CursorKeyEnv) {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tkey, e := hex.DecodeString(os.Getenv(c.CursorKeyEnv))\n\tif e != nil || len(key) != 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn key, nil\n}\n\ntype historyCursor struct {\n\tSchema       int      `json:\"v\"`\n\tMode         string   `json:\"mode\"`\n\tBinding      string   `json:\"binding\"`\n\tConversation ports.ID `json:\"conversation\"`\n\tPolicy       ports.ID `json:\"policy\"`\n\tMember       string   `json:\"member\"`\n\tSeq          ports.ID `json:\"seq\"`\n\tChange       ports.ID `json:\"change\"`\n\tPosition     ports.ID `json:\"position\"`\n\tPending      bool     `json:\"pending\"`\n\tIssued       int64    `json:\"issued\"`\n\tExpiry       int64    `json:\"expiry\"`\n}\n\nfunc bindingFor(env string, p ports.Principal) string {\n\tsum := sha256.Sum256([]byte(strings.Join([]string{env, string(p.ActorID), p.Kind, string(p.SourceID), p.SessionID, p.SessionVersion}, \"\\n\")))\n\treturn hex.EncodeToString(sum[:])\n}\nfunc number(id ports.ID) uint64 { n, _ := strconv.ParseUint(string(id), 10, 64); return n }\nfunc decimal(n uint64) ports.ID { return ports.ID(strconv.FormatUint(n, 10)) }\nfunc (s *HistoryService) sign(c historyCursor) string {\n\tbody, _ := json.Marshal(c)\n\tmac := hmac.New(sha256.New, s.key)\n\tmac.Write(body)\n\treturn base64.RawURLEncoding.EncodeToString(body) + \".\" + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))\n}\nfunc (s *HistoryService) parse(token, mode string) (historyCursor, error) {\n\tvar c historyCursor\n\tif len(token) > 2048 {\n\t\treturn c, ErrResync\n\t}\n\tparts := strings.Split(token, \".\")\n\tif len(parts) != 2 {\n\t\treturn c, ErrResync\n\t}\n\tbody, e := base64.RawURLEncoding.Strict().DecodeString(parts[0])\n\tif e != nil {\n\t\treturn c, ErrResync\n\t}\n\tsignature, e := base64.RawURLEncoding.Strict().DecodeString(parts[1])\n\tif e != nil {\n\t\treturn c, ErrResync\n\t}\n\tmac := hmac.New(sha256.New, s.key)\n\tmac.Write(body)\n\tif !hmac.Equal(signature, mac.Sum(nil)) {\n\t\treturn c, ErrResync\n\t}\n\tif json.Unmarshal(body, &c) != nil || c.Schema != 1 || c.Mode != mode || !validID(c.Conversation) || !validID(c.Policy) || !c.Seq.Valid() || !c.Change.Valid() || !c.Position.Valid() || c.Member == \"\" || c.Expiry-c.Issued != int64(cursorTTL/time.Second) || c.Issued > time.Now().Unix()+5 || c.Expiry <= time.Now().Unix() {\n\t\treturn c, ErrResync\n\t}\n\treturn c, nil\n}\n","chat/internal/message/history_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype HistoryHandler struct {\n\tservice  *HistoryService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewHistoryHandler(s *HistoryService, identity ports.Identity, concurrency int) (*HistoryHandler, error) {\n\tif s == nil || identity == nil || concurrency < 1 || concurrency > 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &HistoryHandler{s, identity, make(chan struct{}, concurrency)}, nil\n}\nfunc historyMode(path string) string {\n\tswitch path {\n\tcase \"/chat/api/v1/conversations/bootstrap\":\n\t\treturn \"bootstrap\"\n\tcase \"/chat/api/v1/messages/history\":\n\t\treturn \"history\"\n\tcase \"/chat/api/v1/messages/sync\":\n\t\treturn \"sync\"\n\tcase \"/chat/api/v1/messages/changes\":\n\t\treturn \"changes\"\n\tcase \"/chat/api/v1/messages/locate\":\n\t\treturn \"locate\"\n\t}\n\treturn \"\"\n}\nfunc decodeHistory(body []byte) (HistoryRequest, error) {\n\tvar q HistoryRequest\n\tif !utf8.Valid(body) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(body))\n\tt, e := d.Token()\n\tif e != nil || t != json.Delim('{') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tt, e = d.Token()\n\t\tk, ok := t.(string)\n\t\tif e != nil || !ok || seen[k] {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tseen[k] = true\n\t\tvar raw json.RawMessage\n\t\tif d.Decode(&raw) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tif k == \"limit\" {\n\t\t\tif len(raw) == 0 || raw[0] < '0' || raw[0] > '9' || json.Unmarshal(raw, &q.Limit) != nil || q.Limit < 1 || q.Limit > 50 {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar v string\n\t\tif len(raw) < 2 || raw[0] != '\"' || !validSurrogates(raw) || json.Unmarshal(raw, &v) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tswitch k {\n\t\tcase \"conversation_id\":\n\t\t\tq.ConversationID = ports.ID(v)\n\t\tcase \"cursor\":\n\t\t\tq.Cursor = v\n\t\tcase \"message_id\":\n\t\t\tq.TargetID = ports.ID(v)\n\t\tdefault:\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\tt, e = d.Token()\n\tif e != nil || t != json.Delim('}') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif _, e = d.Token(); e != io.EOF || !validID(q.ConversationID) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\nfunc (h *HistoryHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tvar nonce [16]byte\n\trand.Read(nonce[:])\n\tid := hex.EncodeToString(nonce[:])\n\tw.Header().Set(\"X-Request-ID\", id)\n\tfail := func(status int, code string, retry bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\tjson.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"retryable\": retry, \"server_time\": time.Now().UTC()})\n\t\t}\n\t}\n\tmode := historyMode(r.URL.Path)\n    if r.URL.Path==\"/chat/api/v1/conversations/unread\" || r.URL.Path==\"/chat/api/v1/conversations/read\" || r.URL.Path==\"/chat/api/v1/conversations/digests\" || r.URL.Path==\"/chat/api/v1/conversations/preferences\" || r.URL.Path==\"/chat/api/v1/conversations/preference\" { h.serveS09(w,r);return }\n\tif mode == \"\" {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", false)\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tcontent, _, e := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif e != nil || content != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error(), true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), h.service.timeout)\n\tdefer cancel()\n\tcontroller := http.NewResponseController(w)\n\tcontroller.SetReadDeadline(time.Now().Add(h.service.timeout))\n\tbody, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 4096))\n\tif e != nil {\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar large *http.MaxBytesError\n\t\tif errors.As(e, &large) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", true)\n\t\t}\n\t\treturn\n\t}\n\tcontroller.SetReadDeadline(time.Time{})\n\tq, e := decodeHistory(body)\n\tif e != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tp, e := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif e != nil {\n\t\tif errors.Is(e, auth.ErrUnauthorized) {\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\t} else {\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\tpage, e := h.service.Read(ctx, p, q, mode)\n\tif e != nil {\n\t\tswitch {\n\t\tcase errors.Is(e, ports.ErrInvalid):\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\tcase errors.Is(e, ErrResync):\n\t\t\tfail(409, ErrResync.Error(), false)\n\t\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\t\tfail(403, \"CHAT_PERMISSION_DENIED\", false)\n\t\tdefault:\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": \"OK\", \"data\": page, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/history_http_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype historyFixtureIdentity struct{}\n\nfunc (historyFixtureIdentity) Authenticate(ctx context.Context, token string) (ports.Principal, error) {\n\tif token != \"fixture-only\" {\n\t\treturn ports.Principal{}, auth.ErrUnauthorized\n\t}\n\treturn principal(\"10202\"), nil\n}\nfunc TestMySQLS08HTTPReadBoundary(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 31)\n\thandler, e := NewHistoryHandler(h, historyFixtureIdentity{}, 4)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tserver := httptest.NewServer(handler)\n\tdefer server.Close()\n\tcall := func(path, body, credential string, status int) []byte {\n\t\tt.Helper()\n\t\treq, _ := http.NewRequest(\"POST\", server.URL+path, strings.NewReader(body))\n\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n\t\tif credential != \"\" {\n\t\t\treq.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\t\t}\n\t\tres, e := server.Client().Do(req)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer res.Body.Close()\n\t\traw, _ := io.ReadAll(res.Body)\n\t\tif res.StatusCode != status {\n\t\t\tt.Fatalf(\"HTTP %d want %d: %s\", res.StatusCode, status, raw)\n\t\t}\n\t\tif res.Header.Get(\"Cache-Control\") != \"no-store\" || res.Header.Get(\"X-Request-ID\") == \"\" {\n\t\t\tt.Fatal(\"privacy headers\")\n\t\t}\n\t\treturn raw\n\t}\n\tbody := `{\"conversation_id\":\"` + string(r.ConversationID) + `\"}`\n\tcall(\"/chat/api/v1/conversations/bootstrap\", body, \"\", 401)\n\tcall(\"/chat/api/v1/conversations/bootstrap\", body, \"bad\", 401)\n\traw := call(\"/chat/api/v1/conversations/bootstrap\", body, \"fixture-only\", 200)\n\tvar out struct {\n\t\tData HistoryPage `json:\"data\"`\n\t}\n\tif json.Unmarshal(raw, &out) != nil || len(out.Data.Messages) != 30 {\n\t\tt.Fatal(\"bootstrap HTTP\")\n\t}\n\tcall(\"/chat/api/v1/messages/history\", `{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"`+out.Data.HistoryCursor+`\"}`, \"fixture-only\", 200)\n\tcall(\"/chat/api/v1/messages/sync\", `{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"invalid\"}`, \"fixture-only\", 409)\n\tcall(\"/chat/api/v1/messages/sync\", `{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"after_seq\":\"103\"}`, \"fixture-only\", 400)\n\tcall(\"/chat/api/v1/conversations/bootstrap?actor=10203\", body, \"fixture-only\", 400)\n\tcall(\"/chat/api/v1/conversations/bootstrap\", strings.Repeat(\"a\", 4097), \"fixture-only\", 413)\n\tf.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n\tcall(\"/chat/api/v1/conversations/bootstrap\", body, \"fixture-only\", 403)\n}\n","chat/internal/message/history_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc historyFixture(t *testing.T, n int) (*fixtureDB, *Service, *HistoryService, Request) {\n\tt.Helper()\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\th, e := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"s\", 32)), 3*time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tseedHistory(t, f, q, n)\n\treturn f, s, h, q\n}\nfunc readPage(t *testing.T, h *HistoryService, q HistoryRequest, mode string) HistoryPage {\n\tt.Helper()\n\tp, e := h.Read(context.Background(), principal(\"10202\"), q, mode)\n\tif e != nil {\n\t\tt.Fatalf(\"read %s: %v\", mode, e)\n\t}\n\treturn p\n}\nfunc TestMySQLS08FixedSnapshotsGapsAndChanges(t *testing.T) {\n\tf, s, h, r := historyFixture(t, 100)\n\tq := HistoryRequest{ConversationID: r.ConversationID}\n\tboot := readPage(t, h, q, \"bootstrap\")\n\tif len(boot.Messages) != 30 || boot.Messages[0].Seq != \"71\" || boot.NextSync != \"100\" || boot.NextChange != \"100\" || boot.HistoryCursor == \"\" {\n\t\tt.Fatal(\"bootstrap\", boot)\n\t}\n\tfor i := 1; i <= 3; i++ {\n\t\tr.ClientMessageID = client(i)\n\t\taccepted(t, s, r)\n\t} // A real-time observer may see 103 first; the signed confirmed cursor remains 100.\n\tq.Cursor = boot.SyncCursor\n\tq.Limit = 1\n\tp := readPage(t, h, q, \"sync\")\n\tif p.NextChange != \"\" {\n\t\tt.Fatal(\"sync certified unconsumed changes\")\n\t}\n\tif p.NextSync != \"101\" || p.SnapshotMaxSeq != \"103\" || !p.HasMore {\n\t\tt.Fatal(\"skipped 101\", p)\n\t}\n\tr.ClientMessageID = client(4)\n\taccepted(t, s, r)\n\tfor _, seq := range []ports.ID{\"102\", \"103\"} {\n\t\tq.Cursor = p.SyncCursor\n\t\tp = readPage(t, h, q, \"sync\")\n\t\tif p.NextSync != seq || p.SnapshotMaxSeq != \"103\" {\n\t\t\tt.Fatal(\"snapshot moved\", p)\n\t\t}\n\t}\n\tif p.HasMore {\n\t\tt.Fatal(\"snapshot did not finish\")\n\t}\n\tq.Cursor = p.SyncCursor\n\tp = readPage(t, h, q, \"sync\")\n\tif p.NextSync != \"104\" || p.HasMore {\n\t\tt.Fatal(\"next round\", p)\n\t}\n\t// S15-style writer fixture: same commit lock and atomic state/change; no product recall API is enabled here.\n\ttx, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\tvar upper uint64\n\ttx.QueryRow(`SELECT last_change_seq FROM chat_conversations WHERE id=? FOR UPDATE`, string(r.ConversationID)).Scan(&upper)\n\tif _, e = tx.Exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=20`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = tx.Exec(`INSERT INTO chat_message_changes SELECT conversation_id,?,id,2,'message.recalled',UTC_TIMESTAMP(6) FROM chat_messages WHERE conversation_id=? AND seq=20`, upper+1, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\ttx.Exec(`UPDATE chat_conversations SET last_change_seq=? WHERE id=?`, upper+1, string(r.ConversationID))\n\tif tx.Commit() != nil {\n\t\tt.Fatal(\"recall commit\")\n\t}\n\tq.Cursor = boot.ChangeCursor\n\tq.Limit = 2\n\tvar changes []ChangeView\n\tfor i := 0; i < 4; i++ {\n\t\tp = readPage(t, h, q, \"changes\")\n\t\tchanges = append(changes, p.Changes...)\n\t\tq.Cursor = p.ChangeCursor\n\t\tif !p.HasMore {\n\t\t\tbreak\n\t\t}\n\t}\n\tif p.NextSync != \"\" {\n\t\tt.Fatal(\"change page certified messages\")\n\t}\n\tlast := changes[len(changes)-1]\n\tif len(changes) != 5 || last.Message.Seq != \"20\" || last.Message.Text != nil || last.Message.StateVersion != \"2\" || p.NextChange != \"105\" {\n\t\tt.Fatal(\"old-state recovery\", p)\n\t}\n\t// The old history snapshot re-reads safe current states, never original evidence.\n\tq.Cursor = boot.HistoryCursor\n\tq.Limit = 50\n\told := readPage(t, h, q, \"history\")\n\tif old.SyncCursor != \"\" || old.ChangeCursor != \"\" {\n\t\tt.Fatal(\"history replaced recovery cursors\")\n\t}\n\tfor _, m := range old.Messages {\n\t\tif m.Seq == \"20\" && (m.Text != nil || m.StateVersion != \"2\") {\n\t\t\tt.Fatal(\"old body resurrected\")\n\t\t}\n\t}\n\tq.Cursor = old.HistoryCursor\n\tolder := readPage(t, h, q, \"history\")\n\tseenRecall := false\n\tfor _, m := range older.Messages {\n\t\tif m.Seq == \"20\" {\n\t\t\tseenRecall = true\n\t\t\tif m.Text != nil || m.StateVersion != \"2\" {\n\t\t\t\tt.Fatal(\"historical body resurrected\")\n\t\t\t}\n\t\t}\n\t}\n\tif !seenRecall {\n\t\tt.Fatal(\"recall fixture not enumerated\")\n\t}\n\tq.Cursor = boot.SyncCursor\n\tif _, e := h.Read(f.ctx, principal(\"10203\"), q, \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"cross-actor cursor reused\", e)\n\t}\n\t// Closed ranges may contain a legal hole. Enumeration can certify the upper bound.\n\tf.exec(`UPDATE chat_conversations SET last_seq=106 WHERE id=?`, string(r.ConversationID))\n\tq.Cursor = p.ChangeCursor // deliberately a change cursor must be rejected by sync\n\tif _, e = h.Read(f.ctx, principal(\"10202\"), q, \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"stream reuse\", e)\n\t}\n\tq.Cursor = boot.SyncCursor\n\tq.Limit = 50\n\tp = readPage(t, h, q, \"sync\")\n\tif p.NextSync != \"106\" || p.HasMore || len(p.Messages) != 4 {\n\t\tt.Fatal(\"legal hole\", p)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM notifications\") != \"0\" {\n\t\tt.Fatal(\"read created notification\")\n\t}\n}\nfunc TestMySQLS08PermissionIntervalsLocateAndRetention(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 90)\n\tq := HistoryRequest{ConversationID: r.ConversationID}\n\tboot := readPage(t, h, q, \"bootstrap\")\n\tf.php(\"close\")\n\tf.store.Poll(f.ctx, 100)\n\tf.php(\"repair\")\n\tf.store.Poll(f.ctx, 100)\n\t// Returning identity has two legal ranges; version 2 is an explicit gap.\n\tf.exec(`DELETE FROM chat_member_intervals WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version,end_version) SELECT conversation_id,actor_id,member_key,1,2 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version) SELECT conversation_id,actor_id,member_key,3 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET policy_version=2 WHERE seq BETWEEN 40 AND 70 AND conversation_id=?`, string(r.ConversationID))\n\tq.Cursor = boot.SyncCursor\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"old policy cursor\", e)\n\t}\n\tq.Cursor = \"\"\n\tfresh := readPage(t, h, q, \"bootstrap\")\n\tfor _, m := range fresh.Messages {\n\t\tif m.PolicyVersion == \"2\" {\n\t\t\tt.Fatal(\"unauthorized gap\")\n\t\t}\n\t}\n\tq.Cursor = \"\"\n\tq.TargetID = ports.ID(f.text(`SELECT id FROM chat_messages WHERE conversation_id=? AND seq=55`, string(r.ConversationID)))\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"locate\"); e != policy.ErrDenied {\n\t\tt.Fatal(\"gap target\", e)\n\t}\n\tq.TargetID = ports.ID(f.text(`SELECT id FROM chat_messages WHERE conversation_id=? AND seq=30`, string(r.ConversationID)))\n\tlocated := readPage(t, h, q, \"locate\")\n\tif len(located.Messages) > 30 || located.SyncCursor != \"\" {\n\t\tt.Fatal(\"unbounded locate\")\n\t}\n\tq.TargetID = \"\"\n\tq.Cursor = fresh.HistoryCursor\n\tf.exec(`UPDATE chat_conversations SET sync_floor_seq=80 WHERE id=?`, string(r.ConversationID))\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"history\"); e != ErrResync {\n\t\tt.Fatal(\"retained floor\", e)\n\t}\n\tq.Cursor = fresh.ChangeCursor\n\tf.exec(`UPDATE chat_conversations SET change_floor_seq=90 WHERE id=?`, string(r.ConversationID))\n\tc, _ := h.parse(fresh.ChangeCursor, \"changes\")\n\tc.Position = \"89\"\n\tq.Cursor = h.sign(c)\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"changes\"); e != ErrResync {\n\t\tt.Fatal(\"change floor\", e)\n\t}\n\tq.Cursor = \"\"\n\tf.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"bootstrap\"); e == nil {\n\t\tt.Fatal(\"revoked login read\")\n\t}\n}\nfunc TestMySQLS08LargeHistoryAndCommitSerialization(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 100000)\n\tq := HistoryRequest{ConversationID: r.ConversationID, Limit: 50}\n\tp := readPage(t, h, q, \"bootstrap\")\n\tif len(p.Messages) != 50 || p.Messages[0].Seq != \"99951\" {\n\t\tt.Fatal(\"large bounded page\")\n\t}\n\tencoded, _ := json.Marshal(p)\n\tif len(encoded) > 100000 {\n\t\tt.Fatal(\"unbounded response\")\n\t}\n\t// A pending low-number change cannot fall behind a certified watermark.\n\ttx, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\ttx.Exec(`UPDATE chat_conversations SET last_change_seq=100001 WHERE id=?`, string(r.ConversationID))\n\tdone := make(chan error, 1)\n\tgo func() { _, e := h.Read(f.ctx, principal(\"10202\"), q, \"bootstrap\"); done <- e }()\n\tselect {\n\tcase e := <-done:\n\t\tt.Fatal(\"snapshot crossed pending commit\", e)\n\tcase <-time.After(100 * time.Millisecond):\n\t}\n\ttx.Rollback()\n\tif e = <-done; e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcommitting, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer committing.Rollback()\n\tif _, e = committing.Exec(`UPDATE chat_conversations SET last_change_seq=100001 WHERE id=?`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = committing.Exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=1`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = committing.Exec(`INSERT INTO chat_message_changes SELECT conversation_id,100001,id,2,'message.recalled',UTC_TIMESTAMP(6) FROM chat_messages WHERE conversation_id=? AND seq=1`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tresult := make(chan HistoryPage, 1)\n\tgo func() {\n\t\tpage, e := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: r.ConversationID, Cursor: p.ChangeCursor}, \"changes\")\n\t\tif e != nil {\n\t\t\tdone <- e\n\t\t\treturn\n\t\t}\n\t\tresult <- page\n\t}()\n\tselect {\n\tcase page := <-result:\n\t\tt.Fatal(\"change crossed uncommitted state\", page)\n\tcase e := <-done:\n\t\tt.Fatal(e)\n\tcase <-time.After(100 * time.Millisecond):\n\t}\n\tif e = committing.Commit(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tselect {\n\tcase page := <-result:\n\t\tif page.SnapshotMaxChange != \"100001\" || len(page.Changes) != 1 || page.Changes[0].Message.Text != nil || page.Changes[0].Message.StateVersion != \"2\" {\n\t\t\tt.Fatal(\"snapshot missed committed safety state\", page)\n\t\t}\n\tcase e := <-done:\n\t\tt.Fatal(e)\n\tcase <-time.After(4 * time.Second):\n\t\tt.Fatal(\"change reader did not resume\")\n\t}\n\t// Reads are allowed under a send-only ban, but never as a different actor.\n\tf.exec(`INSERT INTO chat_restrictions(actor_id,permanent,version,updated_at) VALUES(10202,1,1,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE permanent=1`)\n\treadPage(t, h, q, \"bootstrap\")\n\tif _, e = h.Read(f.ctx, principal(\"10201\"), q, \"bootstrap\"); e == nil {\n\t\tt.Fatal(\"outsider read\")\n\t}\n}\n\nfunc TestMySQLS15ReferencesRecallAndReedit(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 0)\n\tauthor := principal(\"10202\")\n\tother := principal(\"10203\")\n\toriginal := accepted(t, s, q)\n\tq.ClientMessageID = client(1501)\n\tq.Text = \"回复内容\"\n\tq.ReplyTo = original.MessageID\n\treply, e := s.Send(f.ctx, other, q)\n\tif e != nil || reply.State != \"accepted\" {\n\t\tt.Fatal(reply, e)\n\t}\n\tpage, e := h.Read(f.ctx, other, HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tquoted := page.Messages[1].Reply\n\tif quoted == nil || quoted.ID != original.MessageID || quoted.Text == nil || quoted.State != \"published\" {\n\t\tt.Fatal(\"missing safe quote\", quoted)\n\t}\n\tbefore, e := h.Unread(f.ctx, other, q.ConversationID)\n\tif e != nil || before.Count != 1 {\n\t\tt.Fatal(before, e)\n\t}\n\trecalled, e := s.Recall(f.ctx, author, q.ConversationID, original.MessageID)\n\tif e != nil || recalled.State != \"recalled\" || recalled.Text != nil || recalled.StateVersion != \"2\" {\n\t\tt.Fatal(recalled, e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 121 SECOND WHERE id=?\", string(original.MessageID))\n\trecalledAt := f.text(\"SELECT CAST(recalled_at AS CHAR) FROM chat_messages WHERE id=?\", string(original.MessageID))\n\t// Original ID/seq and activity time survive, and duplicate requests add no change.\n\tif again, e := s.Recall(f.ctx, author, q.ConversationID, original.MessageID); e != nil || again.StateVersion != \"2\" {\n\t\tt.Fatal(again, e)\n\t}\n\tif f.text(\"SELECT CAST(recalled_at AS CHAR) FROM chat_messages WHERE id=?\", string(original.MessageID)) != recalledAt {\n\t\tt.Fatal(\"duplicate recall changed its timestamp\")\n\t}\n\tif f.text(\"SELECT last_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"2\" || f.text(\"SELECT last_change_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"3\" {\n\t\tt.Fatal(\"recall allocated seq or duplicate change\")\n\t}\n\tafter, e := h.Unread(f.ctx, other, q.ConversationID)\n\tif e != nil || after.Count != 0 || before.ReadSeq != after.ReadSeq {\n\t\tt.Fatal(\"recall count/read boundary\", after, e)\n\t}\n\tchanges, e := h.Read(f.ctx, other, HistoryRequest{ConversationID: q.ConversationID, Cursor: page.ChangeCursor}, \"changes\")\n\tif e != nil || len(changes.Changes) != 1 || changes.Changes[0].Message.Text != nil {\n\t\tt.Fatal(changes, e)\n\t}\n\tpage, e = h.Read(f.ctx, other, HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif page.Messages[0].Text != nil || page.Messages[1].Reply == nil || page.Messages[1].Reply.Text != nil || page.Messages[1].Reply.State != \"recalled\" {\n\t\tt.Fatal(\"recall leaked into history/quote\", page)\n\t}\n\tif result, e := s.Query(f.ctx, author, q.ConversationID, original.ClientMessageID); e != nil || result.MessageState != \"recalled\" {\n\t\tt.Fatal(result, e)\n\t}\n\tq.ClientMessageID = client(1502)\n\tif _, e := s.Send(f.ctx, other, q); e != ErrReference {\n\t\tt.Fatal(\"new reply to recalled target\", e)\n\t}\n\tq.ReplyTo = \"\"\n\tq.EditedFrom = original.MessageID\n\tq.Text = \"修改后的正文\"\n\tq.ClientMessageID = client(1503)\n\tif _, e := s.Send(f.ctx, other, q); e != ErrReference {\n\t\tt.Fatal(\"forged author source\", e)\n\t}\n\trewritten := accepted(t, s, q)\n\tif rewritten.MessageID == original.MessageID || rewritten.Seq != \"3\" {\n\t\tt.Fatal(\"rewrite replaced original\", rewritten)\n\t}\n\tif f.text(\"SELECT CAST(edited_from_recalled_message_id AS CHAR) FROM chat_messages WHERE id=?\", string(rewritten.MessageID)) != string(original.MessageID) {\n\t\tt.Fatal(\"source omitted\")\n\t}\n\tpage = readPage(t, h, HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif v := page.Messages[2]; v.EditedSource == nil || v.EditedSource.ID != original.MessageID || v.EditedSource.Text != nil {\n\t\tt.Fatal(\"safe source marker missing\", v)\n\t}\n\t// Changed source conflicts under the original client ID, even with identical text.\n\tq.EditedFrom = reply.MessageID\n\tif _, e := s.Send(f.ctx, author, q); e != ErrConflict {\n\t\tt.Fatal(\"source absent from fingerprint\", e)\n\t}\n}\nfunc TestMySQLS15RecallTimeWindowOwnershipBanClosureAndRevocation(t *testing.T) {\n\tf, s, _, q := historyFixture(t, 0)\n\ta := accepted(t, s, q)\n\tif _, e := s.Recall(f.ctx, principal(\"10203\"), q.ConversationID, a.MessageID); e != ErrRecall {\n\t\tt.Fatal(\"non-author recall\", e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET message_type='order_card' WHERE id=?\", string(a.MessageID))\n\tif _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, a.MessageID); e != ErrRecall {\n\t\tt.Fatal(\"user recalled immutable business card\", e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET message_type='text',state='blocked' WHERE id=?\", string(a.MessageID))\n\tif _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, a.MessageID); e != ErrRecall {\n\t\tt.Fatal(\"blocked content became a reedit source\", e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET state='published',created_at=UTC_TIMESTAMP(6)-INTERVAL 121 SECOND WHERE id=?\", string(a.MessageID))\n\tif _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, a.MessageID); e != ErrRecallWindow {\n\t\tt.Fatal(\"late recall\", e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 119 SECOND WHERE id=?\", string(a.MessageID))\n\tf.exec(\"UPDATE chat_restrictions SET permanent=1 WHERE actor_id=10202\")\n\tf.php(\"close\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, a.MessageID); e != nil {\n\t\tt.Fatal(\"ban/readonly blocked lawful recall\", e)\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, a.MessageID); e == nil {\n\t\tt.Fatal(\"revoked identity recalls\")\n\t}\n}\nfunc TestMySQLS15FinalReferenceRecheckAndBoundedSourceChain(t *testing.T) {\n\tf, s, _, q := historyFixture(t, 0)\n\ta := accepted(t, s, q)\n\t// Inspection happens outside the commit lock; a recall committed during it\n\t// must invalidate a new reply, rather than publishing a stale quote.\n\traceSafety := safetyFunc(func(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\t\t_, e := s.Recall(ctx, principal(\"10202\"), q.ConversationID, a.MessageID)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\treturn pass(ctx, r)\n\t})\n\traced, _ := NewService(f.goDB, f.store, raceSafety, 3*time.Second)\n\tq.ClientMessageID = client(1510)\n\tq.ReplyTo = a.MessageID\n\tif _, e := raced.Send(f.ctx, principal(\"10202\"), q); e != ErrReference {\n\t\tt.Fatal(\"recall/send race published\", e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"failed quote occupied a seq\")\n\t}\n\tq.ReplyTo = \"\"\n\tq.EditedFrom = a.MessageID\n\tfor n := 1; n <= maxReeditDepth; n++ {\n\t\tq.ClientMessageID = client(1520 + n)\n\t\tnext := accepted(t, s, q)\n\t\tif _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, next.MessageID); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tq.EditedFrom = next.MessageID\n\t}\n\tq.ClientMessageID = client(1540)\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), q); e != ErrReeditLimit {\n\t\tt.Fatal(\"unbounded reedit chain\", e)\n\t}\n}\nfunc TestMySQLS15ReferenceVisibilityAndCrossConversation(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 0)\n\ta := accepted(t, s, q)\n\tf.php(\"sync\", \"402\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tother, e := f.store.FindOrder(f.ctx, principal(\"10202\"), \"402\", \"402\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tq.ConversationID = other\n\tq.ClientMessageID = client(1550)\n\tq.ReplyTo = a.MessageID\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), q); e != ErrReference {\n\t\tt.Fatal(\"cross conversation reference\", e)\n\t}\n\tq.ConversationID = aConversation(f, a.MessageID)\n\tq.ClientMessageID = client(1551)\n\tf.exec(\"UPDATE chat_messages SET seq=999 WHERE id=?\", string(a.MessageID))\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), q); e != ErrReference {\n\t\tt.Fatal(\"source newer than committed high water\", e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET seq=1 WHERE id=?\", string(a.MessageID))\n\tb := accepted(t, s, q)\n\t// A newer member interval cannot be used to read an older quote target.\n\tf.exec(\"UPDATE chat_messages SET policy_version=2 WHERE id=?\", string(b.MessageID))\n\tf.exec(\"UPDATE chat_member_intervals SET start_version=2 WHERE conversation_id=? AND actor_id=10203\", string(q.ConversationID))\n\tg := ports.Grant{Version: \"2\"}\n\ttx, e := f.goDB.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\tviews := []*MessageView{{ID: b.MessageID, Seq: b.Seq, State: \"published\", ReplyTo: a.MessageID}}\n\tif e := hydrateReferences(f.ctx, tx, principal(\"10203\"), g, q.ConversationID, views); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif views[0].Reply == nil || views[0].Reply.ID != \"\" || views[0].Reply.Text != nil {\n\t\tt.Fatal(\"quote leaked absence interval\", views[0].Reply)\n\t}\n\ttx.Rollback()\n\t_ = h\n}\nfunc aConversation(f *fixtureDB, id ports.ID) ports.ID {\n\treturn ports.ID(f.text(\"SELECT CAST(conversation_id AS CHAR) FROM chat_messages WHERE id=?\", string(id)))\n}\nfunc TestMySQLS15ConcurrentRecallIsIdempotentAndTransactional(t *testing.T) {\n\tf, s, _, q := historyFixture(t, 0)\n\ta := accepted(t, s, q)\n\tresults := make(chan error, 2)\n\tfor range 2 {\n\t\tgo func() { _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, a.MessageID); results <- e }()\n\t}\n\tfor range 2 {\n\t\tif e := <-results; e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_message_changes WHERE change_type='message.recalled'\") != \"1\" {\n\t\tt.Fatal(\"duplicate recall change\")\n\t}\n\tq.ClientMessageID = client(1560)\n\tb := accepted(t, s, q)\n\t// Expiry while waiting for the shared conversation commit lock rolls back.\n\tholder, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = holder.ExecContext(f.ctx, \"SELECT id FROM chat_conversations WHERE id=? FOR UPDATE\", string(q.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\texpiring := principal(\"10202\")\n\texpiring.ExpiresAt = time.Now().Add(100 * time.Millisecond)\n\twaiting := make(chan error, 1)\n\tgo func() { _, e := s.Recall(f.ctx, expiring, q.ConversationID, b.MessageID); waiting <- e }()\n\ttime.Sleep(200 * time.Millisecond)\n\tif e := holder.Commit(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e := <-waiting; e == nil {\n\t\tt.Fatal(\"recall with expired credential committed\")\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(b.MessageID)) != \"published\" {\n\t\tt.Fatal(\"expiry committed recall\")\n\t}\n\tf.exec(\"CREATE TRIGGER s15_change_rollback BEFORE INSERT ON chat_message_changes FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='rollback-fixture'\")\n\tif _, e := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, b.MessageID); e == nil {\n\t\tt.Fatal(\"recall reported success after change failure\")\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(b.MessageID)) != \"published\" {\n\t\tt.Fatal(\"partial recall committed\")\n\t}\n}\n\nfunc seedHistory(t *testing.T, f *fixtureDB, q Request, n int) {\n\tt.Helper()\n\tif n > 0 {\n\t\tdigits := `(SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9)`\n\t\tfrom := []string{}\n\t\tterms := []string{}\n\t\tscale := 1\n\t\tfor i := 0; i < 5; i++ {\n\t\t\tfrom = append(from, fmt.Sprintf(\"%s d%d\", digits, i))\n\t\t\tterms = append(terms, fmt.Sprintf(\"d%d.n*%d\", i, scale))\n\t\t\tscale *= 10\n\t\t}\n\t\tgenerator := `(SELECT ` + strings.Join(terms, \"+\") + `+1 seq FROM ` + strings.Join(from, \" CROSS JOIN \") + `) nums`\n\t\tf.exec(`INSERT INTO chat_messages(conversation_id,seq,sender_id,client_message_id,policy_version,message_type,text_body,state,state_version,safety_rule_version,created_at) SELECT ?,seq,10202,CONCAT('1700000000.',LPAD(seq,32,'0')),1,'text',CONCAT('fixture-',seq),'published',1,'s08-fixture',UTC_TIMESTAMP(6) FROM `+generator+` WHERE seq<=? ORDER BY seq`, string(q.ConversationID), n)\n\t\tf.exec(`INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT conversation_id,seq,id,1,'message.accepted',UTC_TIMESTAMP(6) FROM chat_messages WHERE conversation_id=?`, string(q.ConversationID))\n\t\tf.exec(`UPDATE chat_conversations SET last_seq=?,last_change_seq=? WHERE id=?`, n, n, string(q.ConversationID))\n\t}\n}\n","chat/internal/message/history_locate.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Locate is a bounded index seek, not repeated history-page traversal. It is\n// also the basis for S15 references/S09 unread anchors; it never marks read.\nfunc (s *HistoryService) locate(ctx context.Context, p ports.Principal, q HistoryRequest) (HistoryPage, error) {\n\tif !validID(q.TargetID) {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tr, e := s.open(ctx, p, q, \"locate\")\n\tif e != nil {\n\t\treturn HistoryPage{}, e\n\t}\n\tdefer r.tx.Rollback()\n\tselectSQL := `SELECT ` + viewColumns + `,` + visibleColumn + ` FROM chat_messages m WHERE m.conversation_id=? AND `\n\targs := []any{string(r.grant.Version), string(p.ActorID), string(q.ConversationID), string(q.TargetID), r.floorSeq, r.seq}\n\trows, e := r.tx.QueryContext(ctx, selectSQL+`m.id=? AND m.seq>? AND m.seq<=? LIMIT 1`, args...)\n\tif e != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tvar target candidate\n\tfound := rows.Next()\n\tif found {\n\t\ttarget, e = scanCandidate(rows, false)\n\t}\n\trowError := rows.Err()\n\trows.Close()\n\tif e != nil || rowError != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tif !found || !target.visible {\n\t\treturn HistoryPage{}, policy.ErrDenied\n\t}\n\tpage := emptyPage(r)\n\tlimit := limitFor(q)\n\tbefore := (limit - 1) / 2\n\tafter := limit - before - 1\n\tfetch := func(pre bool, n int) ([]candidate, error) {\n\t\tcmp := `m.seq>? AND m.seq<=? ORDER BY m.seq ASC`\n\t\tlo, hi := number(target.view.Seq), r.seq\n\t\tif pre {\n\t\t\tcmp = `m.seq>? AND m.seq<? ORDER BY m.seq DESC`\n\t\t\tlo, hi = r.floorSeq, number(target.view.Seq)\n\t\t}\n\t\trows, err := r.tx.QueryContext(ctx, selectSQL+cmp+` LIMIT ?`, string(r.grant.Version), string(p.ActorID), string(q.ConversationID), lo, hi, n)\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tout := make([]candidate, 0, n)\n\t\tfor rows.Next() {\n\t\t\tv, err := scanCandidate(rows, false)\n\t\t\tif err != nil {\n\t\t\t\trows.Close()\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tout = append(out, v)\n\t\t}\n\t\terr = rows.Err()\n\t\trows.Close()\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tprior, e := fetch(true, before+1)\n\tif e != nil {\n\t\treturn HistoryPage{}, e\n\t}\n\tpage.HasMore = len(prior) > before\n\tif page.HasMore {\n\t\tprior = prior[:before]\n\t}\n\tnext := number(target.view.Seq) - 1\n\tif len(prior) > 0 {\n\t\tnext = number(prior[len(prior)-1].view.Seq) - 1\n\t}\n\tfor i := len(prior) - 1; i >= 0; i-- {\n\t\tif prior[i].visible {\n\t\t\tpage.Messages = append(page.Messages, prior[i].view)\n\t\t}\n\t}\n\tpage.Messages = append(page.Messages, target.view)\n\tif after > 0 {\n\t\tfollowing, e := fetch(false, after)\n\t\tif e != nil {\n\t\t\treturn HistoryPage{}, e\n\t\t}\n\t\tfor _, v := range following {\n\t\t\tif v.visible {\n\t\t\t\tpage.Messages = append(page.Messages, v.view)\n\t\t\t}\n\t\t}\n\t}\n\tc := r.cursor\n\tif page.HasMore {\n\t\tc.Mode = \"history\"\n\t\tc.Position = decimal(next)\n\t\tc.Pending = true\n\t\tpage.HistoryCursor = s.sign(c)\n\t}\n\t// Locate is not bootstrap: it must not certify that newer messages were\n\t// consumed. The caller retains its existing independent sync/change cursors.\n\tpage.NextSync = \"\"\n\tpage.NextChange = \"\"\n\treturn s.finish(ctx,p, r, page)\n}\n","chat/internal/message/history_test.go":"package message\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestS08CursorBindingTamperingAndExpiry(t *testing.T) {\n\ts := &HistoryService{key: []byte(strings.Repeat(\"k\", 32)), environment: \"test\"}\n\tnow := time.Now().Unix()\n\tc := historyCursor{Schema: 1, Mode: \"sync\", Binding: bindingFor(\"test\", principal(\"10202\")), Conversation: \"1\", Policy: \"1\", Member: \"fixture\", Seq: \"18446744073709551615\", Change: \"0\", Position: \"100\", Issued: now, Expiry: now + 600}\n\ttoken := s.sign(c)\n\tif got, e := s.parse(token, \"sync\"); e != nil || got.Seq != c.Seq {\n\t\tt.Fatal(\"valid large cursor\", e)\n\t}\n\tfor _, v := range []string{\"\", token + \"a\", strings.Repeat(\"x\", 2049), strings.Replace(token, \".\", \"..\", 1)} {\n\t\tif _, e := s.parse(v, \"sync\"); e != ErrResync {\n\t\t\tt.Fatal(\"forged cursor\")\n\t\t}\n\t}\n\tif _, e := s.parse(token, \"changes\"); e != ErrResync {\n\t\tt.Fatal(\"cross-stream cursor\")\n\t}\n\tc.Issued -= 601\n\tc.Expiry -= 601\n\tif _, e := s.parse(s.sign(c), \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"expired snapshot\")\n\t}\n\tif bindingFor(\"production\", principal(\"10202\")) == c.Binding || bindingFor(\"test\", principal(\"10203\")) == c.Binding {\n\t\tt.Fatal(\"identity collision\")\n\t}\n}\nfunc TestS08StrictReadRequest(t *testing.T) {\n\tfor _, body := range []string{`{\"conversation_id\":1}`, `{\"conversation_id\":\"1\",\"conversation_id\":\"1\"}`, `{\"Conversation_ID\":\"1\"}`, `{\"conversation_id\":\"1\",\"limit\":null}`, `{\"conversation_id\":\"1\",\"limit\":51}`, `{\"conversation_id\":\"1\",\"limit\":1.5}`, `{\"conversation_id\":\"1\",\"after_seq\":\"103\"}`, `{\"conversation_id\":\"1\",\"cursor\":\"\\ud800\"}`, `{\"conversation_id\":\"01\"}`, `{\"conversation_id\":\"1\"}{}`} {\n\t\tif _, e := decodeHistory([]byte(body)); e != ports.ErrInvalid {\n\t\t\tt.Fatal(\"accepted malformed request\", body)\n\t\t}\n\t}\n\tif q, e := decodeHistory([]byte(`{\"conversation_id\":\"1\",\"limit\":50}`)); e != nil || q.Limit != 50 {\n\t\tt.Fatal(e)\n\t}\n}\n","chat/internal/message/http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Handler is explicitly constructed by isolated fixtures in S06. Runtime\n// admits messages only through the safety and signed release/staging composition.\ntype Handler struct {\n\tservice  *Service\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewHandler(s *Service, identity ports.Identity, concurrency int) (*Handler, error) {\n\tif s == nil || identity == nil || concurrency < 1 || concurrency > 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Handler{s, identity, make(chan struct{}, concurrency)}, nil\n}\nfunc validSurrogates(raw []byte) bool {\n\tfor i := 1; i < len(raw)-1; i++ {\n\t\tif raw[i] != '\\\\' {\n\t\t\tcontinue\n\t\t}\n\t\ti++\n\t\tif i >= len(raw)-1 {\n\t\t\treturn false\n\t\t}\n\t\tif raw[i] != 'u' {\n\t\t\tcontinue\n\t\t}\n\t\tif i+4 >= len(raw) {\n\t\t\treturn false\n\t\t}\n\t\tn, e := strconv.ParseUint(string(raw[i+1:i+5]), 16, 16)\n\t\tif e != nil {\n\t\t\treturn false\n\t\t}\n\t\ti += 4\n\t\tif n >= 0xdc00 && n <= 0xdfff {\n\t\t\treturn false\n\t\t}\n\t\tif n >= 0xd800 && n <= 0xdbff {\n\t\t\tif i+6 >= len(raw) || raw[i+1] != '\\\\' || raw[i+2] != 'u' {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tlow, e := strconv.ParseUint(string(raw[i+3:i+7]), 16, 16)\n\t\t\tif e != nil || low < 0xdc00 || low > 0xdfff {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\ti += 6\n\t\t}\n\t}\n\treturn true\n}\n\nfunc decode(body []byte, result bool) (Request, error) {\n\tvar r Request\n\tif !result {\n\t\tvar peek map[string]json.RawMessage\n\t\tif json.Unmarshal(body, &peek) == nil {\n\t\t\tvar kind string\n\t\t\tjson.Unmarshal(peek[\"message_type\"], &kind)\n\t\t\tif kind == \"image\" || kind == \"image_album\" || kind == \"audio\" || kind == \"video\" {\n\t\t\t\treturn decodeMediaSend(body)\n\t\t\t}\n\t\t}\n\t}\n\tif !utf8.Valid(body) {\n\t\treturn r, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(body))\n\ttoken, e := d.Token()\n\tif e != nil || token != json.Delim('{') {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\ttoken, e = d.Token()\n\t\tkey, ok := token.(string)\n\t\tif e != nil || !ok || seen[key] {\n\t\t\treturn r, ports.ErrInvalid\n\t\t}\n\t\tseen[key] = true\n\t\tvar value string\n\t\tvar raw json.RawMessage\n\t\tif d.Decode(&raw) != nil || len(raw) < 2 || raw[0] != '\"' || json.Unmarshal(raw, &value) != nil || !validSurrogates(raw) {\n\t\t\treturn r, ports.ErrInvalid\n\t\t}\n\t\tswitch key {\n\t\tcase \"conversation_id\":\n\t\t\tr.ConversationID = ports.ID(value)\n\t\tcase \"client_message_id\":\n\t\t\tr.ClientMessageID = value\n\t\tcase \"message_type\":\n\t\t\tif result {\n\t\t\t\treturn r, ports.ErrInvalid\n\t\t\t}\n\t\t\tr.MessageType = value\n\t\tcase \"reply_to_message_id\", \"edited_from_recalled_message_id\", \"reply_to_item_id\":\n\t\t\tif result || !validID(ports.ID(value)) {\n\t\t\t\treturn r, ports.ErrInvalid\n\t\t\t}\n\t\t\tif key == \"reply_to_item_id\" {\n\t\t\t\tr.ReplyItem = ports.ID(value)\n\t\t\t} else if key == \"reply_to_message_id\" {\n\t\t\t\tr.ReplyTo = ports.ID(value)\n\t\t\t} else {\n\t\t\t\tr.EditedFrom = ports.ID(value)\n\t\t\t}\n\t\tcase \"text\":\n\t\t\tif result {\n\t\t\t\treturn r, ports.ErrInvalid\n\t\t\t}\n\t\t\tr.Text = value\n\t\tdefault:\n\t\t\treturn r, ports.ErrInvalid\n\t\t}\n\t}\n\tif token, e = d.Token(); e != nil || token != json.Delim('}') {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tif _, e = d.Token(); e != io.EOF {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tif !validID(r.ConversationID) || !validClient(r.ClientMessageID) {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tif !result {\n\t\t_, e = fingerprint(r)\n\t\tif e != nil {\n\t\t\treturn r, e\n\t\t}\n\t}\n\treturn r, nil\n}\nfunc (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tvar nonce [16]byte\n\t_, _ = rand.Read(nonce[:])\n\tid := hex.EncodeToString(nonce[:])\n\tw.Header().Set(\"X-Request-ID\", id)\n\tfail := func(status int, code, message string, retry bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"message\": message, \"retryable\": retry, \"server_time\": time.Now().UTC()})\n\t\t}\n\t}\n\trecall := r.URL.Path == \"/chat/api/v1/messages/recall\"\n\tresult := r.URL.Path == \"/chat/api/v1/messages/result\"\n\tif !recall && !result && r.URL.Path != \"/chat/api/v1/messages/send\" {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", \"接口未开放\", false)\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", \"请求方法不支持\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"请求参数不正确\", false)\n\t\treturn\n\t}\n\tcontent, _, e := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif e != nil || content != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\", \"请使用JSON请求\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error(), \"请求较多，请稍后重试\", true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效\", false)\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), h.service.timeout)\n\tdefer cancel()\n\tcontroller := http.NewResponseController(w)\n\t_ = controller.SetReadDeadline(time.Now().Add(h.service.timeout))\n\tbody, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 32<<10))\n\tif e != nil {\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar large *http.MaxBytesError\n\t\tif errors.As(e, &large) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", \"请求内容过大\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", \"请求未及时完成\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = controller.SetReadDeadline(time.Time{})\n\tvar req Request\n\tvar target HistoryRequest\n\tif recall {\n\t\ttarget, e = decodeRecall(body)\n\t} else {\n\t\treq, e = decode(body, result)\n\t}\n\tif e != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"消息格式不正确\", false)\n\t\treturn\n\t}\n\tp, e := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif e != nil {\n\t\tif errors.Is(e, auth.ErrUnauthorized) {\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效\", false)\n\t\t} else {\n\t\t\tfail(503, ports.ErrUnavailable.Error(), \"身份服务暂不可用\", true)\n\t\t}\n\t\treturn\n\t}\n\tvar data any\n\tif recall {\n\t\tdata, e = h.service.Recall(ctx, p, target.ConversationID, target.TargetID)\n\t} else if result {\n\t\tdata, e = h.service.Query(ctx, p, req.ConversationID, req.ClientMessageID)\n\t} else {\n\t\tdata, e = h.service.Send(ctx, p, req)\n\t}\n\tif e != nil {\n\t\tswitch {\n\t\tcase errors.Is(e, ports.ErrInvalid):\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"消息格式不正确\", false)\n\t\tcase errors.Is(e, ErrReference), errors.Is(e, ErrReeditLimit), errors.Is(e, ErrRecall):\n\t\t\tfail(409, e.Error(), \"消息来源或操作已不可用，请刷新后核对\", false)\n\t\tcase errors.Is(e, ErrRecallWindow):\n\t\t\tfail(410, e.Error(), \"已超过两分钟撤回窗口\", false)\n\t\tcase errors.Is(e, ErrConflict):\n\t\t\tfail(409, e.Error(), \"同一消息ID的内容不能更改\", false)\n\t\tcase errors.Is(e, ErrExpired):\n\t\t\tfail(410, e.Error(), \"发送动作已过有效期，请先核对原结果\", false)\n\t\tcase errors.Is(e, ErrUnknown):\n\t\t\tfail(409, e.Error(), \"暂未确认发送结果，请沿用原ID核验\", true)\n\t\tcase errors.Is(e, ErrRestricted):\n\t\t\tfail(403, e.Error(), \"当前账号暂不能发送聊天消息\", false)\n\t\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\t\tfail(403, \"CHAT_PERMISSION_DENIED\", \"当前无法访问或发送此会话\", false)\n\t\tcase errors.Is(e, ports.ErrBusy):\n\t\t\tfail(429, e.Error(), \"消息正在处理，请用原ID查询\", true)\n\t\tcase errors.Is(e, ErrCheck):\n\t\t\tfail(503, e.Error(), \"内容检查暂不可用，请沿用原ID重试\", true)\n\t\tdefault:\n\t\t\tfail(503, ports.ErrUnavailable.Error(), \"结果暂未确认，请用原ID查询\", true)\n\t\t}\n\t\treturn\n\t}\n\tstatus := 200\n\tif outcome, ok := data.(Result); ok && (outcome.State == \"checking\" || outcome.State == \"retryable\" || outcome.State == \"review_pending\") {\n\t\tstatus = 202\n\t}\n\tw.WriteHeader(status)\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"ok\": true, \"request_id\": id, \"data\": data, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/http_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n \"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n)\n\nfunc TestMySQLHTTPUsesVerifiedIdentityAndSharedSend(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tpublic, private, e := ed25519.GenerateKey(rand.Reader)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tverifier, e := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"fixture\": public})\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tsource, e := auth.NewMySQLSource(f.goDB)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tidentity, e := auth.NewService(verifier, source, nil, 4, time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\thandler, e := NewHandler(s, identity, 4)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tserver := httptest.NewServer(handler)\n\tdefer server.Close()\n\ttoken := func(actor string) string {\n\t\tp := principal(actor)\n\t\tnow := time.Now().Unix()\n\t\tclaims := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: \"test\", Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 60, JTI: digest(\"fixture-jti\")}\n\t\tpayload, _ := json.Marshal(claims)\n\t\theader := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"fixture\"}`))\n\t\tdata := header + \".\" + base64.RawURLEncoding.EncodeToString(payload)\n\t\treturn data + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(private, []byte(data)))\n\t}\n\tcredential := token(\"10202\")\n\tcall := func(method, path, body, credential string, status int) []byte {\n\t\tt.Helper()\n\t\treq, _ := http.NewRequest(method, server.URL+path, strings.NewReader(body))\n\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n\t\tif credential != \"\" {\n\t\t\treq.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\t\t}\n\t\tres, e := server.Client().Do(req)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer res.Body.Close()\n\t\tout, _ := io.ReadAll(res.Body)\n\t\tif res.StatusCode != status {\n\t\t\tt.Fatalf(\"HTTP %d expected %d: %s\", res.StatusCode, status, out)\n\t\t}\n\t\tif res.Header.Get(\"Cache-Control\") != \"no-store\" || res.Header.Get(\"X-Request-ID\") == \"\" {\n\t\t\tt.Fatal(\"response privacy headers\")\n\t\t}\n\t\treturn out\n\t}\n\tbody, _ := json.Marshal(r)\n\tcall(\"GET\", \"/chat/api/v1/messages/send\", string(body), credential, 405)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", string(body), \"\", 401)\n\tcall(\"POST\", \"/chat/api/v1/messages/send?sender=10203\", string(body), credential, 400)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", strings.Repeat(\"a\", (32<<10)+1), credential, 413)\n\tbad := strings.Replace(string(body), `\"text\":`, `\"sender_id\":\"10203\",\"text\":`, 1)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", bad, credential, 400)\n\tout := call(\"POST\", \"/chat/api/v1/messages/send\", string(body), credential, 200)\n\tif strings.Contains(string(out), r.Text) || !strings.Contains(string(out), `\"state\":\"accepted\"`) {\n\t\tt.Fatal(\"unsafe result body\", string(out))\n\t}\n\tif again, e := s.Send(context.Background(), principal(\"10202\"), r); e != nil || again.Seq != \"1\" {\n\t\tt.Fatalf(\"transport idempotency %+v %v\", again, e)\n\t}\n\tr.Text += \" changed\"\n\tchanged, _ := json.Marshal(r)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", string(changed), credential, 409)\n\tquery, _ := json.Marshal(map[string]any{\"conversation_id\": r.ConversationID, \"client_message_id\": r.ClientMessageID})\n\tcall(\"POST\", \"/chat/api/v1/messages/result\", string(query), token(\"10203\"), 409)\n\tf.exec(\"UPDATE chat_restrictions SET permanent=1 WHERE actor_id=10202\")\n\tcall(\"POST\", \"/chat/api/v1/messages/result\", string(query), credential, 200)\n\trecallBody:=fmt.Sprintf(`{\"conversation_id\":%q,\"message_id\":%q}`,r.ConversationID,f.text(\"SELECT CAST(id AS CHAR) FROM chat_messages WHERE conversation_id=?\",string(r.ConversationID)))\n    recalled:=call(\"POST\",\"/chat/api/v1/messages/recall\",recallBody,credential,200)\n    if strings.Contains(string(recalled),\"施工\")||!strings.Contains(string(recalled),`\"state\":\"recalled\"`){t.Fatal(\"unsafe HTTP recall\",string(recalled))}\n    call(\"POST\",\"/chat/api/v1/messages/recall\",recallBody,credential,200)\n    call(\"POST\",\"/chat/api/v1/messages/recall\",strings.TrimSuffix(recallBody,\"}\")+`,\"text\":\"fake\"}`,credential,400)\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tcall(\"POST\", \"/chat/api/v1/messages/result\", string(query), credential, 401)\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"HTTP retries duplicated\")\n\t}\n}\n","chat/internal/message/load_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/gorilla/websocket\"\n\t\"github.com/redis/go-redis/v9\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestMySQLRedisS23MixedLoad(t *testing.T) {\n\tfor _, profile := range []struct{ connections, history int }{{30, 1000}, {100, 10000}, {300, 100000}} {\n\t\tt.Run(fmt.Sprintf(\"%d_connections_%d_history\", profile.connections, profile.history), func(t *testing.T) {\n\t\t\tf, s, m, storage, q := mediaFixture(t)\n\t\t\tctx, cancel := context.WithTimeout(context.Background(), 150*time.Second)\n\t\t\tdefer cancel()\n\t\t\tf.ctx = ctx\n\t\t\tseedHistory(t, f, q, profile.history)\n\t\t\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"h\", 32)), 3*time.Second)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\taddress := os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\")\n\t\t\tif address == \"\" {\n\t\t\t\tt.Fatal(\"isolated Redis required\")\n\t\t\t}\n\t\t\trc := redis.NewClient(&redis.Options{Addr: address, PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, DisableIdentity: true, Protocol: 2})\n\t\t\tdefer rc.Close()\n\t\t\ttickets, err := auth.NewRedisStore(rc, \"test\", \"bxchat:test:\")\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\t\t\tverifier, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"load\": pub})\n\t\t\tsource, _ := auth.NewMySQLSource(f.goDB)\n\t\t\tidentity, err := auth.NewService(verifier, source, tickets, 8, time.Second)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tp := principal(\"10202\")\n\t\t\tnow := time.Now().Unix()\n\t\t\tclaims := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: \"test\", Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\t\t\tbody, _ := json.Marshal(claims)\n\t\t\tunsigned := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"load\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(body)\n\t\t\ttoken := unsigned + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(unsigned)))\n\t\t\tgateway, err := socket.NewWithPolicy(identity, SocketCommands{Sender: s, History: h}, f.store)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tdefer func() {\n\t\t\t\tshutdown, stop := context.WithTimeout(context.Background(), 3*time.Second)\n\t\t\t\tdefer stop()\n\t\t\t\tif gateway.Shutdown(shutdown) != nil {\n\t\t\t\t\tt.Error(\"drain\")\n\t\t\t\t}\n\t\t\t}()\n\t\t\treadHTTP, _ := NewHistoryHandler(h, identity, 16)\n\t\t\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\t\t\tif r.URL.Path == \"/chat/ws\" {\n\t\t\t\t\tgateway.ServeHTTP(w, r)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tif r.URL.Path == \"/fixture/order\" {\n\t\t\t\t\tvar state string\n\t\t\t\t\terr := f.root.QueryRowContext(r.Context(), \"SELECT lifecycle_status FROM orders WHERE id=401\").Scan(&state)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tw.WriteHeader(503)\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\t_, _ = io.WriteString(w, state)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\treadHTTP.ServeHTTP(w, r)\n\t\t\t}))\n\t\t\tdefer server.Close()\n\t\t\tclients := []*websocket.Conn{}\n\t\t\tdefer func() {\n\t\t\t\tfor _, ws := range clients {\n\t\t\t\t\tws.Close()\n\t\t\t\t}\n\t\t\t}()\n\t\t\tfor i := 0; i < profile.connections; i++ {\n\t\t\t\tticket, _, err := identity.IssueTicket(ctx, token)\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(\"ticket\", err)\n\t\t\t\t}\n\t\t\t\tws, _, err := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\tclients = append(clients, ws)\n\t\t\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\t\t\tif ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"load-auth\", \"type\": \"auth\", \"payload\": map[string]string{\"ticket\": ticket}}) != nil {\n\t\t\t\t\tt.Fatal(\"auth write\")\n\t\t\t\t}\n\t\t\t\tvar response struct {\n\t\t\t\t\tType string `json:\"type\"`\n\t\t\t\t}\n\t\t\t\tif ws.ReadJSON(&response) != nil || response.Type != \"auth.ok\" {\n\t\t\t\t\tt.Fatal(\"authenticated connection\", response)\n\t\t\t\t}\n\t\t\t}\n\t\t\t// Verify the hard connection cap rather than relying on unbounded goroutines.\n\t\t\tif profile.connections == 300 {\n\t\t\t\textra, _, e := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\t\t\t\tif e == nil {\n\t\t\t\t\textra.Close()\n\t\t\t\t\tt.Fatal(\"connection 301 admitted\")\n\t\t\t\t}\n\t\t\t}\n\t\t\tvar mu sync.Mutex\n\t\t\torderTimes, chatTimes := []int64{}, []int64{}\n\t\t\tfailures := []string{}\n\t\t\trecord := func(kind string, start time.Time, err error) {\n\t\t\t\tmu.Lock()\n\t\t\t\tdefer mu.Unlock()\n\t\t\t\tif err != nil {\n\t\t\t\t\tif len(failures) < 20 {\n\t\t\t\t\t\tfailures = append(failures, kind+\":\"+err.Error())\n\t\t\t\t\t}\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tms := time.Since(start).Microseconds()\n\t\t\t\tif kind == \"order\" {\n\t\t\t\t\torderTimes = append(orderTimes, ms)\n\t\t\t\t} else {\n\t\t\t\t\tchatTimes = append(chatTimes, ms)\n\t\t\t\t}\n\t\t\t}\n\t\t\torderProbe := func() {\n\t\t\t\tstart := time.Now()\n\t\t\t\tresponse, err := server.Client().Get(server.URL + \"/fixture/order\")\n\t\t\t\tif err == nil {\n\t\t\t\t\tio.Copy(io.Discard, response.Body)\n\t\t\t\t\tresponse.Body.Close()\n\t\t\t\t\tif response.StatusCode != 200 {\n\t\t\t\t\t\terr = fmt.Errorf(\"order status\")\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\trecord(\"order\", start, err)\n\t\t\t}\n\t\t\tfor i := 0; i < 20; i++ {\n\t\t\t\torderProbe()\n\t\t\t}\n\t\t\tbaseline := append([]int64(nil), orderTimes...)\n\t\t\torderTimes = nil\n\t\t\tvar wg sync.WaitGroup\n\t\t\tjobs := make(chan *websocket.Conn, profile.connections)\n\t\t\tfor _, ws := range clients {\n\t\t\t\tjobs <- ws\n\t\t\t}\n\t\t\tclose(jobs)\n\t\t\tfor i := 0; i < 8; i++ {\n\t\t\t\twg.Add(1)\n\t\t\t\tgo func() {\n\t\t\t\t\tdefer wg.Done()\n\t\t\t\t\tfor ws := range jobs {\n\t\t\t\t\t\tstart := time.Now()\n\t\t\t\t\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\t\t\t\t\terr := ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"load-history\", \"type\": \"conversation.bootstrap\", \"payload\": map[string]string{\"conversation_id\": string(q.ConversationID)}})\n\t\t\t\t\t\tvar response struct {\n\t\t\t\t\t\t\tType    string      `json:\"type\"`\n\t\t\t\t\t\t\tPayload HistoryPage `json:\"payload\"`\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif err == nil {\n\t\t\t\t\t\t\terr = ws.ReadJSON(&response)\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif err == nil && (response.Type != \"conversation.bootstrap.result\" || len(response.Payload.Messages) > 30) {\n\t\t\t\t\t\t\terr = fmt.Errorf(\"bounded page\")\n\t\t\t\t\t\t}\n\t\t\t\t\t\trecord(\"chat\", start, err)\n\t\t\t\t\t\torderProbe()\n\t\t\t\t\t}\n\t\t\t\t}()\n\t\t\t}\n\t\t\twg.Add(1)\n\t\t\tgo func() {\n\t\t\t\tdefer wg.Done()\n\t\t\t\tfor i := 0; i < 10; i++ {\n\t\t\t\t\ttext := request(2300 + i)\n\t\t\t\t\ttext.ConversationID = q.ConversationID\n\t\t\t\t\t_, err := s.Send(ctx, principal(\"10202\"), text)\n\t\t\t\t\trecord(\"send\", time.Now(), err)\n\t\t\t\t}\n\t\t\t}()\n\t\t\t// Real media state machine with simulated private storage / local processor.\n\t\t\tq.MessageType = \"image_album\"\n\t\t\tq.Items = nil\n\t\t\tfor i := 0; i < 9; i++ {\n\t\t\t\tv := mediaAdd(t, m, storage, q.ConversationID, 100+i, \"load-construction\")\n\t\t\t\tv.Ordinal = i\n\t\t\t\tq.Items = append(q.Items, v)\n\t\t\t}\n\t\t\tmediaProcess(t, m, 9)\n\t\t\tif _, err := s.Send(ctx, principal(\"10202\"), q); err != nil {\n\t\t\t\tt.Fatal(\"mixed album\", err)\n\t\t\t}\n\t\t\tif err := m.Advance(ctx); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tmediaApprove(t, m)\n\t\t\treminders, _ := NewReminderService(s, &reminderCapture{})\n\t\t\tif err := reminders.DrainEvents(ctx); err != nil {\n\t\t\t\tt.Fatal(\"mixed reminder\", err)\n\t\t\t}\n\t\t\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\t\t\tif err := reminders.Prepare(ctx); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif err := reminders.SubmitPending(ctx); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\twg.Wait()\n\t\t\tif len(failures) > 0 {\n\t\t\t\tt.Fatal(\"mixed isolated failures\", failures)\n\t\t\t}\n\t\t\tp95 := func(v []int64) int64 {\n\t\t\t\tsort.Slice(v, func(i, j int) bool { return v[i] < v[j] })\n\t\t\t\tif len(v) == 0 {\n\t\t\t\t\treturn 0\n\t\t\t\t}\n\t\t\t\treturn v[(len(v)-1)*95/100]\n\t\t\t}\n\t\t\tt.Logf(\"S23_CAPACITY {\\\"environment\\\":\\\"isolated_runner\\\",\\\"connections\\\":%d,\\\"history\\\":%d,\\\"order_probe_baseline_p95_us\\\":%d,\\\"order_probe_mixed_p95_us\\\":%d,\\\"chat_p95_us\\\":%d,\\\"real_order_api\\\":false,\\\"real_media_channel\\\":false}\", profile.connections, profile.history, p95(baseline), p95(orderTimes), p95(chatTimes))\n\t\t})\n\t}\n}\n","chat/internal/message/media.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrMedia = errors.New(\"CHAT_MEDIA_UNAVAILABLE\")\nvar ErrMediaVersion = errors.New(\"CHAT_MEDIA_VERSION_CONFLICT\")\n\nconst ImageRule = \"images-manual-v1\"\nconst MediaTTL = time.Hour\nconst MaxImageBytes = 8 << 20\nconst MaxImagePixels = 20000000\n\n// Storage keys are generated here, never supplied by a caller or callback.\ntype UploadGrant struct {\n\tAttachmentID  ports.ID `json:\"attachment_id\"`\n\tObjectVersion string   `json:\"object_version\"`\n\tKey           string   `json:\"key\"`\n\tToken         string   `json:\"token\"`\n\tHost          string   `json:\"host\"`\n\tExpiresAt     int64    `json:\"expires_at\"`\n\tState         string   `json:\"state\"`\n}\ntype ImageStorage interface {\n\tGrant(context.Context, string, int64) (string, string, error)\n\tRead(context.Context, string, int64) ([]byte, error)\n\tPut(context.Context, string, []byte, string) error\n\tSign(context.Context, string, time.Duration) (string, error)\n\tDelete(context.Context, string) error\n}\ntype ProcessedImage struct {\n\tMain, Thumb                                              []byte\n\tMIME, Method, QRStatus, QRDecision, QRVersion, OCRStatus string\n\tWidth, Height                                            int\n}\ntype ImageProcessor interface {\n\tProcess(context.Context, []byte) (ProcessedImage, error)\n}\ntype MediaItem struct {\n\tAttachmentID  ports.ID `json:\"attachment_id\"`\n\tObjectVersion string   `json:\"object_version\"`\n\tOrdinal       int      `json:\"ordinal\"`\n\tItemID        ports.ID `json:\"item_id,omitempty\"`\n}\ntype ImageView struct {\n\tItemID  ports.ID `json:\"item_id\"`\n\tOrdinal int      `json:\"ordinal\"`\n\tWidth   int      `json:\"width\"`\n\tHeight  int      `json:\"height\"`\n}\ntype MediaStatus struct {\n\tIntentID      ports.ID `json:\"intent_id,omitempty\"`\n\tReviewVersion ports.ID `json:\"review_version,omitempty\"`\n\tResult\n\tRevision     int               `json:\"revision\"`\n\tManifestHash string            `json:\"manifest_hash\"`\n\tItems        []MediaItemStatus `json:\"items\"`\n\tExpiresAt    time.Time         `json:\"expires_at\"`\n}\ntype MediaItemStatus struct {\n\tMediaItem\n\tState string `json:\"state\"`\n\tCode  string `json:\"code,omitempty\"`\n}\ntype MediaService struct {\n\tbase        *Service\n\tstorage     ImageStorage\n\tprocessor   ImageProcessor\n\tenvironment string\n}\n\nfunc NewMediaService(base *Service, storage ImageStorage, processor ImageProcessor, env string) (*MediaService, error) {\n\tif base == nil || storage == nil || processor == nil || (env != \"test\" && env != \"development\" && env != \"production\") {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &MediaService{base, storage, processor, env}, nil\n}\nfunc (s *Service) WithMedia(m *MediaService) *Service { copy := *s; copy.media = m; return &copy }\nfunc randomMedia() string {\n\tvar b [32]byte\n\tif _, e := rand.Read(b[:]); e != nil {\n\t\treturn \"\"\n\t}\n\treturn hex.EncodeToString(b[:])\n}\nfunc mediaHash(b []byte) string { v := sha256.Sum256(b); return hex.EncodeToString(v[:]) }\nfunc mediaFingerprint(q Request) (string, error) {\n\tif !validID(q.ConversationID) || !validClient(q.ClientMessageID) || q.Text != \"\" || q.EditedFrom != \"\" || q.Revision < 1 || q.Revision > 10000 || len(q.Items) < 1 || len(q.Items) > 9 ||\n\t\t(len(q.Items) == 1 && q.MessageType != \"image\") || (len(q.Items) > 1 && q.MessageType != \"image_album\") || q.ReplyTo != \"\" && !validID(q.ReplyTo) || q.ReplyItem != \"\" && (!validID(q.ReplyItem) || q.ReplyTo == \"\") {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tseen := map[ports.ID]bool{}\n\tfor i, v := range q.Items {\n\t\tif !validID(v.AttachmentID) || len(v.ObjectVersion) != 64 || v.Ordinal != i || v.ItemID != \"\" || seen[v.AttachmentID] {\n\t\t\treturn \"\", ports.ErrInvalid\n\t\t}\n\t\tif _, e := hex.DecodeString(v.ObjectVersion); e != nil {\n\t\t\treturn \"\", ports.ErrInvalid\n\t\t}\n\t\tseen[v.AttachmentID] = true\n\t}\n\tb, err := json.Marshal(struct {\n\t\tSchema    int\n\t\tType      string\n\t\tRevision  int\n\t\tItems     []MediaItem\n\t\tReply     ports.ID `json:\"reply,omitempty\"`\n\t\tReplyItem ports.ID `json:\"reply_item,omitempty\"`\n\t}{3, q.MessageType, q.Revision, q.Items, q.ReplyTo, q.ReplyItem})\n\tif err != nil {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\treturn mediaHash(b), nil\n}\n\n// Allocation is idempotent by a timestamped upload action. No allocation or\n// upload implies a send. Per-actor quota is serialized by the restriction row.\nfunc (m *MediaService) Upload(ctx context.Context, p ports.Principal, cid ports.ID, uploadID string, size int64) (UploadGrant, error) {\n\tif !validID(cid) || !validClient(uploadID) || !active(uploadID, time.Now()) || size < 1 || size > MaxImageBytes {\n\t\treturn UploadGrant{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn UploadGrant{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.authorize(ctx, tx, p, cid); e != nil {\n\t\treturn UploadGrant{}, e\n\t}\n\tvar id ports.ID\n\tvar version, key string\n\tvar declared int64\n\tvar live bool\n\tvar state string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),object_version,source_key,declared_bytes,state,expires_at>UTC_TIMESTAMP(6) FROM chat_image_uploads WHERE actor_id=? AND conversation_id=? AND upload_id=? FOR UPDATE`, string(p.ActorID), string(cid), uploadID).Scan(&id, &version, &key, &declared, &state, &live)\n\tif e == sql.ErrNoRows {\n\t\tvar count int\n\t\tvar bytes int64\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*),COALESCE(SUM(declared_bytes),0) FROM chat_image_uploads WHERE actor_id=? AND expires_at>UTC_TIMESTAMP(6)`, string(p.ActorID)).Scan(&count, &bytes) != nil {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tif count >= 18 || bytes+size > 72<<20 {\n\t\t\treturn UploadGrant{}, ports.ErrBusy\n\t\t}\n\t\tversion = randomMedia()\n\t\tif version == \"\" {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tkey = \"chat/\" + m.environment + \"/\" + string(p.ActorID) + \"/\" + version + \"/source\"\n\t\tres, err := tx.ExecContext(ctx, `INSERT INTO chat_image_uploads(actor_id,conversation_id,upload_id,object_version,source_key,declared_bytes,state,expires_at,created_at) VALUES(?,?,?,?,?,?,'uploading',?,UTC_TIMESTAMP(6))`, string(p.ActorID), string(cid), uploadID, version, key, size, expires(uploadID))\n\t\tif err != nil {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tn, err := res.LastInsertId()\n\t\tif err != nil {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tid = ports.ID(fmt.Sprint(n))\n\t} else if e != nil {\n\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t} else if !live {\n\t\treturn UploadGrant{}, ErrExpired\n\t} else if declared != size {\n\t\treturn UploadGrant{}, ErrConflict\n\t}\n\tif tx.Commit() != nil {\n\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t}\n\tif state == \"processed\" || state == \"blocked\" {\n\t\treturn UploadGrant{AttachmentID: id, ObjectVersion: version, State: state}, nil\n\t}\n\ttoken, host, e := m.storage.Grant(ctx, key, size)\n\tif e != nil {\n\t\treturn UploadGrant{}, ErrMedia\n\t}\n\treturn UploadGrant{AttachmentID: id, ObjectVersion: version, Key: key, Token: token, Host: host, ExpiresAt: time.Now().Add(5 * time.Minute).Unix(), State: \"uploading\"}, nil\n}\nfunc (m *MediaService) Uploaded(ctx context.Context, p ports.Principal, cid, id ports.ID) (MediaItemStatus, error) {\n\tif !validID(cid) || !validID(id) {\n\t\treturn MediaItemStatus{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaItemStatus{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.authorize(ctx, tx, p, cid); e != nil {\n\t\treturn MediaItemStatus{}, e\n\t}\n\tvar v MediaItemStatus\n\tv.AttachmentID = id\n\tvar live bool\n\tvar attempts int\n\te = tx.QueryRowContext(ctx, `SELECT object_version,state,expires_at>UTC_TIMESTAMP(6),attempts FROM chat_image_uploads WHERE id=? AND actor_id=? AND conversation_id=? FOR UPDATE`, string(id), string(p.ActorID), string(cid)).Scan(&v.ObjectVersion, &v.State, &live, &attempts)\n\tif e != nil {\n\t\treturn v, ErrMedia\n\t}\n\tif !live {\n\t\treturn v, ErrExpired\n\t}\n\tif v.State == \"uploading\" || v.State == \"check_unavailable\" {\n\t\tif attempts >= 8 {\n\t\t\treturn v, ErrCheck\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET state='queued',error_code=NULL WHERE id=?`, string(id)); e != nil {\n\t\t\treturn v, ports.ErrUnavailable\n\t\t}\n\t\tv.State = \"queued\"\n\t}\n\tif tx.Commit() != nil {\n\t\treturn v, ports.ErrUnavailable\n\t}\n\treturn v, nil\n}\nfunc (m *MediaService) Send(ctx context.Context, p ports.Principal, q Request) (Result, error) {\n\tfp, e := mediaFingerprint(q)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Same source ID cannot collide with a text action, even after ban or expiry.\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"}); e != nil {\n\t\treturn Result{}, e\n\t}\n\told, e := m.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif old != nil {\n\t\tif old.result.State == \"canceled\" {\n\t\t\tif tx.Commit() != nil {\n\t\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t\t}\n\t\t\treturn old.result, nil\n\t\t}\n\t\tif old.fingerprint != fp {\n\t\t\treturn Result{}, ErrConflict\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn old.result, nil\n\t}\n\ttx.Rollback()\n\tif !active(q.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\ttx, e = m.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := m.base.authorize(ctx, tx, p, q.ConversationID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\told, e = m.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif old != nil {\n\t\tif old.fingerprint != fp {\n\t\t\treturn Result{}, ErrConflict\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn old.result, nil\n\t}\n\tif _, e = validateReferences(ctx, tx, p, q, g); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar pending int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_send_intents WHERE sender_id=? AND state IN ('checking','review_pending','retryable') AND action_expires_at>UTC_TIMESTAMP(6)`, string(p.ActorID)).Scan(&pending) != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif pending >= 4 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tearliest := time.Now().UTC().Add(MediaTTL)\n\tfor _, v := range q.Items {\n\t\tvar version, state string\n\t\tvar live bool\n\t\tvar expiry time.Time\n\t\te = tx.QueryRowContext(ctx, `SELECT object_version,state,expires_at>UTC_TIMESTAMP(6),expires_at FROM chat_image_uploads WHERE id=? AND actor_id=? AND conversation_id=? LOCK IN SHARE MODE`, string(v.AttachmentID), string(p.ActorID), string(q.ConversationID)).Scan(&version, &state, &live, &expiry)\n\t\tif e != nil || !live || version != v.ObjectVersion {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t\tif state == \"blocked\" {\n\t\t\treturn Result{}, ErrBlocked\n\t\t}\n\t\tif expiry.Before(earliest) {\n\t\t\tearliest = expiry\n\t\t}\n\t}\n\tdeadline := earliest\n\tif end := expires(q.ClientMessageID); end.Before(deadline) {\n\t\tdeadline = end\n\t}\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,action_expires_at,retain_until,created_at,updated_at) VALUES(?,?,?,?,'checking',?,?,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(q.ConversationID), q.ClientMessageID, fp, deadline, expires(q.ClientMessageID).Add(MinimumRetention))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tn, e := res.LastInsertId()\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tprincipal, _ := json.Marshal(p)\n\tmanifest, _ := json.Marshal(q)\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_image_bundles(intent_id,principal_json,manifest_json,manifest_hash,revision,rule_version,review_state,review_version,submitted_at,expires_at) VALUES(?,?,?,?,?,?,'waiting',1,UTC_TIMESTAMP(6),?)`, n, string(principal), string(manifest), fp, q.Revision, ImageRule, deadline)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\treturn Result{ClientMessageID: q.ClientMessageID, State: \"checking\"}, nil\n}\n","chat/internal/message/media_cleanup.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Deletion is serialized with the upload row used by final publication and\n// evidence holds. A failed remote delete keeps the ledger for a later retry.\nfunc (m *MediaService) CleanOne(ctx context.Context) error {\n\tfor _, kind := range []string{\"object\", \"processed_source\", \"expired_source\"} {\n\t\tif err := m.cleanPart(ctx, kind); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\nfunc (m *MediaService) cleanPart(ctx context.Context, kind string) error {\n\tctx, cancel := context.WithTimeout(ctx, 3*time.Second)\n\tdefer cancel()\n\ttx, err := m.base.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar id ports.ID\n\tvar key string\n\tswitch kind {\n\tcase \"object\":\n\t\terr = tx.QueryRowContext(ctx, `SELECT CAST(o.upload_id AS CHAR),o.object_key FROM chat_image_objects o JOIN chat_image_uploads u ON u.id=o.upload_id WHERE o.created_at<UTC_TIMESTAMP(6)-INTERVAL 1 DAY AND u.legal_hold=0 AND (u.lease_until IS NULL OR u.lease_until<UTC_TIMESTAMP(6)) AND ((o.object_key<>COALESCE(u.main_key,'') AND o.object_key<>COALESCE(u.thumb_key,'')) OR (u.expires_at<UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_image_items i WHERE i.item_id=u.id))) ORDER BY o.created_at LIMIT 1`).Scan(&id, &key)\n\tcase \"processed_source\":\n\t\terr = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),source_key FROM chat_image_uploads WHERE state IN ('processed','blocked') AND source_cleaned=0 AND legal_hold=0 ORDER BY id LIMIT 1`).Scan(&id, &key)\n\tcase \"expired_source\":\n\t\terr = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),source_key FROM chat_image_uploads u WHERE expires_at<UTC_TIMESTAMP(6) AND legal_hold=0 AND state<>'cleaned' AND (lease_until IS NULL OR lease_until<UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_image_items i WHERE i.item_id=u.id) AND NOT EXISTS(SELECT 1 FROM chat_image_objects o WHERE o.upload_id=u.id) ORDER BY id LIMIT 1`).Scan(&id, &key)\n\tdefault:\n\t\treturn ports.ErrInvalid\n\t}\n\tif err == sql.ErrNoRows {\n\t\treturn nil\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar hold bool\n\tif tx.QueryRowContext(ctx, `SELECT legal_hold FROM chat_image_uploads WHERE id=? FOR UPDATE`, string(id)).Scan(&hold) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif hold {\n\t\treturn nil\n\t}\n\tvar eligible bool\n\tswitch kind {\n\tcase \"object\":\n\t\terr = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM chat_image_objects o JOIN chat_image_uploads u ON u.id=o.upload_id WHERE o.upload_id=? AND o.object_key=? AND o.created_at<UTC_TIMESTAMP(6)-INTERVAL 1 DAY AND u.legal_hold=0 AND (u.lease_until IS NULL OR u.lease_until<UTC_TIMESTAMP(6)) AND ((o.object_key<>COALESCE(u.main_key,'') AND o.object_key<>COALESCE(u.thumb_key,'')) OR (u.expires_at<UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_image_items i WHERE i.item_id=u.id))))`, string(id), key).Scan(&eligible)\n\tcase \"processed_source\":\n\t\terr = tx.QueryRowContext(ctx, `SELECT state IN ('processed','blocked') AND source_cleaned=0 AND legal_hold=0 AND source_key=? FROM chat_image_uploads WHERE id=?`, key, string(id)).Scan(&eligible)\n\tcase \"expired_source\":\n\t\terr = tx.QueryRowContext(ctx, `SELECT expires_at<UTC_TIMESTAMP(6) AND legal_hold=0 AND state<>'cleaned' AND source_key=? AND (lease_until IS NULL OR lease_until<UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_image_items i WHERE i.item_id=u.id) AND NOT EXISTS(SELECT 1 FROM chat_image_objects o WHERE o.upload_id=u.id) FROM chat_image_uploads u WHERE id=?`, key, string(id)).Scan(&eligible)\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !eligible {\n\t\treturn nil\n\t}\n\tif m.storage.Delete(ctx, key) != nil {\n\t\treturn ErrMedia\n\t}\n\tswitch kind {\n\tcase \"object\":\n\t\t_, err = tx.ExecContext(ctx, `DELETE FROM chat_image_objects WHERE object_key=? AND upload_id=?`, key, string(id))\n\tcase \"processed_source\":\n\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET source_cleaned=1 WHERE id=?`, string(id))\n\tcase \"expired_source\":\n\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET state='cleaned',source_cleaned=1,source_sha256=NULL WHERE id=?`, string(id))\n\t}\n\tif err != nil || tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/media_delivery.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype MediaAccess struct {\n\tCloudAvailable   bool       `json:\"cloud_available\"`\n\tURL              string     `json:\"url\"`\n\tExpiresAt        int64      `json:\"expires_at\"`\n\tObjectHash       string     `json:\"object_hash\"`\n\tRetentionMode    string     `json:\"retention_mode\"`\n\tMessageExpiresAt *time.Time `json:\"cloud_expires_at,omitempty\"`\n\tStateVersion     ports.ID   `json:\"state_version\"`\n\tMIME             string     `json:\"mime_type\"`\n\tServerTime       time.Time  `json:\"server_time\"`\n}\n\nfunc hydrateImages(ctx context.Context, tx *sql.Tx, views []*MessageView) error {\n\tids := []string{}\n\targs := []any{}\n\tbyID := map[ports.ID][]*MessageView{}\n\tfor _, v := range views {\n\t\tv.Images = nil\n\t\tif v.State == \"published\" && (v.Type == \"image\" || v.Type == \"image_album\") {\n\t\t\tif len(byID[v.ID]) == 0 {\n\t\t\t\tids = append(ids, \"?\")\n\t\t\t\targs = append(args, string(v.ID))\n\t\t\t}\n\t\t\tbyID[v.ID] = append(byID[v.ID], v)\n\t\t}\n\t}\n\tif len(ids) == 0 {\n\t\treturn nil\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(i.message_id AS CHAR),CAST(i.item_id AS CHAR),i.ordinal,u.width_px,u.height_px FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id IN (`+strings.Join(ids, \",\")+`) ORDER BY i.message_id,i.ordinal`, args...)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer rows.Close()\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tvar v ImageView\n\t\tif rows.Scan(&id, &v.ItemID, &v.Ordinal, &v.Width, &v.Height) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tfor _, parent := range byID[id] {\n\t\t\tif len(parent.Images) >= 9 {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\tparent.Images = append(parent.Images, v)\n\t\t\tparent.ImageCount = len(parent.Images)\n\t\t}\n\t}\n\tif rows.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (m *MediaService) URL(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, thumb bool) (string, error) {\n\taccess, e := m.URLInfo(ctx, p, cid, mid, item, thumb)\n\treturn access.URL, e\n}\nfunc (m *MediaService) URLInfo(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, thumb bool) (MediaAccess, error) {\n\tif !validID(cid) || !validID(mid) || !validID(item) {\n\t\treturn MediaAccess{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := m.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif e != nil {\n\t\treturn MediaAccess{}, e\n\t}\n\tvar key string\n\tvar expiry sql.NullTime\n\tvar hash, mode, mime string\n\tvar version ports.ID\n\tcolumn := \"u.main_key\"\n\thashColumn := \"u.main_sha256\"\n\tif thumb {\n\t\tcolumn = \"u.thumb_key\"\n\t\thashColumn = \"u.thumb_sha256\"\n\t}\n\te = tx.QueryRowContext(ctx, `SELECT `+column+`,m.expires_at,`+hashColumn+`,m.retention_mode,CAST(m.state_version AS CHAR),u.mime_type FROM chat_messages m JOIN chat_image_items i ON i.message_id=m.id JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE m.conversation_id=? AND m.id=? AND i.item_id=? AND m.state='published' AND m.message_type IN ('image','image_album') AND `+retainedTarget+` AND `+visibleColumn, string(cid), string(mid), string(item), string(g.Version), string(p.ActorID)).Scan(&key, &expiry, &hash, &mode, &version, &mime)\n\tif e != nil || key == \"\" {\n\t\treturn MediaAccess{}, ErrMedia\n\t}\n\tvar exists bool\n\tif tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM chat_image_objects WHERE object_key=? AND deleted_at IS NULL)`, key).Scan(&exists) != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\tavailable := exists && (!expiry.Valid || expiry.Time.After(time.Now()))\n\taccessExpiry := expiry\n\tif !available {\n\t\taccessExpiry = sql.NullTime{}\n\t}\n\tttl := mediaReadTTL(p, accessExpiry)\n\tif ttl < time.Second {\n\t\treturn MediaAccess{}, ErrMedia\n\t}\n\turl := \"\"\n\tif available {\n\t\turl, e = m.storage.Sign(ctx, key, ttl)\n\t\tif e != nil {\n\t\t\treturn MediaAccess{}, ErrMedia\n\t\t}\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_image_objects SET last_access_at=UTC_TIMESTAMP(6) WHERE object_key=?`, key); e != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn MediaAccess{}, ports.ErrUnavailable\n\t}\n\tif thumb {\n\t\tmime = \"image/jpeg\"\n\t}\n\taccess := MediaAccess{CloudAvailable: available, URL: url, ExpiresAt: time.Now().Add(ttl).Unix(), ObjectHash: hash, RetentionMode: mode, StateVersion: version, MIME: mime, ServerTime: time.Now().UTC()}\n\tif expiry.Valid {\n\t\taccess.MessageExpiresAt = &expiry.Time\n\t}\n\treturn access, nil\n}\nfunc (m *MediaService) ReviewURL(ctx context.Context, p ports.Principal, id, version, item ports.ID) (string, error) {\n\tif !validID(id) || !validID(version) || !validID(item) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tdefer tx.Rollback()\n\tif e = m.admin(ctx, tx, p); e != nil {\n\t\treturn \"\", e\n\t}\n\tvar raw, hash string\n\te = tx.QueryRowContext(ctx, `SELECT manifest_json,manifest_hash FROM chat_image_bundles WHERE intent_id=? AND review_version=? AND reviewer_id=? AND review_state='claimed' AND review_lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6) AND rule_version=? AND EXISTS(SELECT 1 FROM chat_send_intents i WHERE i.id=chat_image_bundles.intent_id AND i.state='review_pending') FOR UPDATE`, string(id), string(version), string(p.ActorID), ImageRule).Scan(&raw, &hash)\n\tif e != nil {\n\t\treturn \"\", ErrMediaVersion\n\t}\n\tvar q Request\n\tif json.Unmarshal([]byte(raw), &q) != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tfound := \"\"\n\tfor _, v := range q.Items {\n\t\tif v.AttachmentID == item {\n\t\t\tfound = v.ObjectVersion\n\t\t}\n\t}\n\tif found == \"\" {\n\t\treturn \"\", ErrMedia\n\t}\n\tvar key string\n\tif tx.QueryRowContext(ctx, `SELECT main_key FROM chat_image_uploads WHERE id=? AND object_version=? AND state='processed' AND rule_version=?`, string(item), found, ImageRule).Scan(&key) != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\turl, e := m.storage.Sign(ctx, key, 60*time.Second)\n\tif e != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tif e = imageAudit(ctx, tx, id, p, \"view\", \"发布前完整图片检查\", hash, version, item); e != nil {\n\t\treturn \"\", e\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn url, nil\n}\nfunc (m *MediaService) Status(ctx context.Context, p ports.Principal, cid ports.ID, client string, cancel bool) (MediaStatus, error) {\n\tif !validID(cid) || !validClient(client) {\n\t\treturn MediaStatus{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaStatus{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"}); e != nil {\n\t\treturn MediaStatus{}, e\n\t}\n\ti, e := m.base.lookup(ctx, tx, p, cid, client)\n\tif e != nil {\n\t\treturn MediaStatus{}, e\n\t}\n\t// A cancellation tombstone serializes against first submit via the\n\t// conversation lock. An unknown action can never be resurrected afterward.\n\tif i == nil && cancel {\n\t\tif !active(client, time.Now()) {\n\t\t\treturn MediaStatus{}, ErrExpired\n\t\t}\n\t\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,error_code,action_expires_at,retain_until,created_at,updated_at) VALUES(?,?,?,?,'canceled','CHAT_ACTION_CANCELED',?,?,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(cid), client, strings.Repeat(\"0\", 64), expires(client), expires(client).Add(MinimumRetention))\n\t\tif e != nil || tx.Commit() != nil {\n\t\t\treturn MediaStatus{}, ports.ErrUnavailable\n\t\t}\n\t\treturn MediaStatus{Result: Result{ClientMessageID: client, State: \"canceled\", Code: \"CHAT_ACTION_CANCELED\"}}, nil\n\t}\n\tif i == nil {\n\t\treturn MediaStatus{}, ErrUnknown\n\t}\n\tresult := MediaStatus{Result: i.result, IntentID: i.id, Items: []MediaItemStatus{}}\n\tvar reviewVersion ports.ID\n\tif err := tx.QueryRowContext(ctx, `SELECT CAST(review_version AS CHAR) FROM chat_image_bundles WHERE intent_id=?`, string(i.id)).Scan(&reviewVersion); err == nil {\n\t\tresult.ReviewVersion = reviewVersion\n\t} else if err != sql.ErrNoRows {\n\t\treturn result, ports.ErrUnavailable\n\t}\n\tif i.result.State == \"accepted\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t\treturn result, nil\n\t}\n\tvar raw, review string\n\tvar live bool\n\te = tx.QueryRowContext(ctx, `SELECT manifest_json,revision,manifest_hash,expires_at,review_state,expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles WHERE intent_id=? FOR UPDATE`, string(i.id)).Scan(&raw, &result.Revision, &result.ManifestHash, &result.ExpiresAt, &review, &live)\n\tif e == sql.ErrNoRows && i.result.State == \"canceled\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t\treturn result, nil\n\t}\n\tif e != nil {\n\t\treturn result, ErrMedia\n\t}\n\tif cancel && i.result.State != \"rejected\" && i.result.State != \"canceled\" {\n\t\tresult.State = \"canceled\"\n\t\tresult.Code = \"CHAT_ACTION_CANCELED\"\n\t}\n\tif !live && result.State != \"canceled\" && result.State != \"rejected\" {\n\t\tresult.State = \"rejected\"\n\t\tresult.Code = ErrExpired.Error()\n\t}\n\tif result.State != i.result.State {\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, result.State, result.Code, string(i.id)); e != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t}\n\tvar q Request\n\tif json.Unmarshal([]byte(raw), &q) != nil {\n\t\treturn result, ports.ErrUnavailable\n\t}\n\tfor _, v := range q.Items {\n\t\tvar row MediaItemStatus\n\t\trow.MediaItem = v\n\t\trow.ItemID = v.AttachmentID\n\t\tif tx.QueryRowContext(ctx, `SELECT state,COALESCE(error_code,'') FROM chat_image_uploads WHERE id=?`, string(v.AttachmentID)).Scan(&row.State, &row.Code) != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t\tresult.Items = append(result.Items, row)\n\t}\n\tif tx.Commit() != nil {\n\t\treturn result, ports.ErrUnavailable\n\t}\n\treturn result, nil\n}\nfunc (m *MediaService) Pending(ctx context.Context, p ports.Principal, cid ports.ID) ([]MediaStatus, error) {\n\tif _, e := m.base.conversations.Authorize(ctx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"}); e != nil {\n\t\treturn nil, e\n\t}\n\trows, e := m.base.db.QueryContext(ctx, `SELECT i.client_message_id FROM chat_send_intents i JOIN chat_image_bundles b ON b.intent_id=i.id WHERE i.sender_id=? AND i.conversation_id=? AND i.state IN ('checking','review_pending','retryable') AND b.expires_at>UTC_TIMESTAMP(6) ORDER BY i.id DESC LIMIT 20`, string(p.ActorID), string(cid))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tclients := []string{}\n\tfor rows.Next() {\n\t\tvar client string\n\t\tif rows.Scan(&client) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tclients = append(clients, client)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tout := []MediaStatus{}\n\tfor _, client := range clients {\n\t\tv, err := m.Status(ctx, p, cid, client, false)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tout = append(out, v)\n\t}\n\treturn out, nil\n}\n\nfunc mediaReadTTL(p ports.Principal, expiry sql.NullTime) time.Duration {\n\tttl := min(60*time.Second, time.Until(p.ExpiresAt))\n\tif expiry.Valid {\n\t\tttl = min(ttl, time.Until(expiry.Time))\n\t}\n\treturn ttl\n}\n","chat/internal/message/media_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Reject duplicate keys at EVERY depth; DisallowUnknownFields alone accepts\n// duplicate nested keys, which cannot define an immutable ordered manifest.\nfunc uniqueImageJSON(d *json.Decoder, depth int) bool {\n\tif depth > 12 {\n\t\treturn false\n\t}\n\tt, e := d.Token()\n\tif e != nil {\n\t\treturn false\n\t}\n\tswitch t {\n\tcase json.Delim('{'):\n\t\tseen := map[string]bool{}\n\t\tfor d.More() {\n\t\t\tv, e := d.Token()\n\t\t\tkey, ok := v.(string)\n\t\t\tif e != nil || !ok || seen[key] {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tseen[key] = true\n\t\t\tif !uniqueImageJSON(d, depth+1) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\tv, e := d.Token()\n\t\treturn e == nil && v == json.Delim('}')\n\tcase json.Delim('['):\n\t\tn := 0\n\t\tfor d.More() {\n\t\t\tn++\n\t\t\tif n > 50 || !uniqueImageJSON(d, depth+1) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\tv, e := d.Token()\n\t\treturn e == nil && v == json.Delim(']')\n\t}\n\treturn true\n}\nfunc strictImageJSON(raw []byte, target any) bool {\n\tif !utf8.Valid(raw) || len(raw) == 0 || raw[0] != '{' || !validSurrogates(raw) {\n\t\treturn false\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\tif !uniqueImageJSON(d, 0) {\n\t\treturn false\n\t}\n\tif _, e := d.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\td = json.NewDecoder(bytes.NewReader(raw))\n\td.DisallowUnknownFields()\n\treturn d.Decode(target) == nil\n}\nfunc decodeMediaSend(raw []byte) (Request, error) {\n\tvar q Request\n\tif !strictImageJSON(raw, &q) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tvar fields map[string]json.RawMessage\n\tjson.Unmarshal(raw, &fields)\n\tvar items []map[string]json.RawMessage\n\tif json.Unmarshal(fields[\"items\"], &items) != nil {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tfor _, item := range items {\n\t\tvalue := item[\"ordinal\"]\n\t\tif len(item) != 3 || len(value) == 0 || value[0] < '0' || value[0] > '9' {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\tvar e error\n\tif q.MessageType == \"audio\" || q.MessageType == \"video\" {\n\t\t_, e = avFingerprint(q)\n\t} else {\n\t\t_, e = mediaFingerprint(q)\n\t}\n\treturn q, e\n}\n\ntype imageAction struct {\n\tConversationID ports.ID `json:\"conversation_id,omitempty\"`\n\tUploadID       string   `json:\"upload_id,omitempty\"`\n\tSize           int64    `json:\"size_bytes,omitempty\"`\n\tAttachmentID   ports.ID `json:\"attachment_id,omitempty\"`\n\tClientID       string   `json:\"client_message_id,omitempty\"`\n\tMessageID      ports.ID `json:\"message_id,omitempty\"`\n\tItemID         ports.ID `json:\"item_id,omitempty\"`\n\tThumbnail      bool     `json:\"thumbnail,omitempty\"`\n\tIntentID       ports.ID `json:\"intent_id,omitempty\"`\n\tExpected       ports.ID `json:\"expected_version,omitempty\"`\n\tAction         string   `json:\"action,omitempty\"`\n\tReason         string   `json:\"reason,omitempty\"`\n\tGeneral        bool     `json:\"general_safety_confirmed,omitempty\"`\n\tGroup          bool     `json:\"group_confirmed,omitempty\"`\n\tAfter          ports.ID `json:\"after,omitempty\"`\n}\ntype MediaHandler struct {\n\tservice  *MediaService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewMediaHandler(m *MediaService, identity ports.Identity, concurrency int) (*MediaHandler, error) {\n\tif m == nil || identity == nil || concurrency < 1 || concurrency > 16 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &MediaHandler{m, identity, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *MediaHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tfail := func(status int, code string) {\n\t\tw.WriteHeader(status)\n\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"code\": code, \"message\": \"图片操作未完成，请刷新状态后重试\", \"retryable\": status >= 500, \"server_time\": time.Now().UTC()})\n\t}\n\troute := strings.TrimPrefix(r.URL.Path, \"/chat/api/v1/media/\")\n\tfields := map[string]string{\n\t\t\"upload\": \"conversation_id upload_id size_bytes\", \"uploaded\": \"conversation_id attachment_id\",\n\t\t\"status\": \"conversation_id client_message_id\", \"cancel\": \"conversation_id client_message_id\", \"pending\": \"conversation_id\",\n\t\t\"report\": \"conversation_id message_id item_id reason\", \"url\": \"conversation_id message_id item_id thumbnail\", \"review/list\": \"after\",\n\t\t\"review/decide\": \"intent_id expected_version action reason general_safety_confirmed group_confirmed\", \"review/url\": \"intent_id expected_version item_id\",\n\t}\n\tallowed, ok := fields[route]\n\tif !ok || r.URL.Path != \"/chat/api/v1/media/\"+route {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tcontent, _, err := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif err != nil || content != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\")\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error())\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)\n\tdefer cancel()\n\tbody, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 16<<10))\n\tif err != nil {\n\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\")\n\t\treturn\n\t}\n\tvar q imageAction\n\tif !strictImageJSON(body, &q) {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tvar keys map[string]json.RawMessage\n\tjson.Unmarshal(body, &keys)\n\tfor key := range keys {\n\t\tif !strings.Contains(\" \"+allowed+\" \", \" \"+key+\" \") {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\t\treturn\n\t\t}\n\t}\n\tp, err := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif err != nil {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tvar result any\n\tswitch route {\n\tcase \"upload\":\n\t\tresult, err = h.service.Upload(ctx, p, q.ConversationID, q.UploadID, q.Size)\n\tcase \"uploaded\":\n\t\tresult, err = h.service.Uploaded(ctx, p, q.ConversationID, q.AttachmentID)\n\tcase \"status\", \"cancel\":\n\t\tresult, err = h.service.Status(ctx, p, q.ConversationID, q.ClientID, route == \"cancel\")\n\tcase \"pending\":\n\t\tresult, err = h.service.Pending(ctx, p, q.ConversationID)\n\tcase \"report\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Report(ctx, p, q.ConversationID, q.MessageID, q.ItemID, q.Reason)\n\t\tresult = map[string]any{\"report_id\": id, \"state\": \"pending\"}\n\tcase \"url\":\n\t\tresult, err = h.service.URLInfo(ctx, p, q.ConversationID, q.MessageID, q.ItemID, q.Thumbnail)\n\tcase \"review/list\":\n\t\tresult, err = h.service.Reviews(ctx, p, q.After)\n\tcase \"review/decide\":\n\t\tresult, err = h.service.Review(ctx, p, q.IntentID, q.Expected, q.Action, q.Reason, q.General, q.Group)\n\tcase \"review/url\":\n\t\tvar url string\n\t\turl, err = h.service.ReviewURL(ctx, p, q.IntentID, q.Expected, q.ItemID)\n\t\tresult = map[string]any{\"url\": url, \"expires_at\": time.Now().Add(60 * time.Second).Unix()}\n\t}\n\tif err != nil {\n\t\tstatus := 409\n\t\tcode := err.Error()\n\t\tif err == ports.ErrInvalid {\n\t\t\tstatus = 400\n\t\t} else if err == auth.ErrUnauthorized {\n\t\t\tstatus = 403\n\t\t} else if err == ports.ErrUnavailable || err == ErrCheck {\n\t\t\tstatus = 503\n\t\t}\n\t\tfail(status, code)\n\t\treturn\n\t}\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"ok\": true, \"data\": result, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/media_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype imageMemory struct {\n\tmu      sync.Mutex\n\tobjects map[string][]byte\n}\n\nfunc (s *imageMemory) Grant(context.Context, string, int64) (string, string, error) {\n\treturn \"test-token\", \"https://upload.fixture.invalid\", nil\n}\nfunc (s *imageMemory) Read(ctx context.Context, key string, limit int64) ([]byte, error) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tb, ok := s.objects[key]\n\tif !ok || int64(len(b)) > limit {\n\t\treturn nil, ErrMedia\n\t}\n\treturn append([]byte(nil), b...), nil\n}\nfunc (s *imageMemory) Put(ctx context.Context, key string, b []byte, mime string) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tif old, ok := s.objects[key]; ok && string(old) != string(b) {\n\t\treturn ErrMedia\n\t}\n\ts.objects[key] = append([]byte(nil), b...)\n\treturn nil\n}\nfunc (s *imageMemory) Sign(ctx context.Context, key string, ttl time.Duration) (string, error) {\n\tif ttl > 60*time.Second {\n\t\treturn \"\", ErrMedia\n\t}\n\treturn \"https://private.fixture.invalid/\" + key + \"?e=short\", nil\n}\nfunc (s *imageMemory) Delete(ctx context.Context, key string) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tdelete(s.objects, key)\n\treturn nil\n}\n\ntype imageProcessorFunc func(context.Context, []byte) (ProcessedImage, error)\n\nfunc (fn imageProcessorFunc) Process(ctx context.Context, b []byte) (ProcessedImage, error) {\n\treturn fn(ctx, b)\n}\nfunc mediaFixture(t *testing.T) (*fixtureDB, *Service, *MediaService, *imageMemory, Request) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tstorage := &imageMemory{objects: map[string][]byte{}}\n\tm, e := NewMediaService(s, storage, imageProcessorFunc(func(ctx context.Context, b []byte) (ProcessedImage, error) {\n\t\tif string(b) == \"fail\" {\n\t\t\treturn ProcessedImage{}, ErrCheck\n\t\t}\n\t\tdecision := \"clear\"\n\t\tif string(b) == \"personal\" {\n\t\t\tdecision = \"blocked\"\n\t\t}\n\t\treturn ProcessedImage{Main: append([]byte(\"main:\"), b...), Thumb: append([]byte(\"thumb:\"), b...), MIME: \"image/jpeg\", Method: \"original\", Width: 100, Height: 100, QRStatus: \"completed\", QRDecision: decision, QRVersion: \"fixture-v1\", OCRStatus: \"not_run\"}, nil\n\t}), \"test\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts = s.WithMedia(m)\n\tf.exec(`INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(90001,'image-review-fixture','fixture','operations','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tf.exec(`INSERT INTO chat_admin_sessions(id,admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(90001,90001,REPEAT('a',64),REPEAT('b',64),REPEAT('c',64),'[\"chat:audit\",\"chat:moderate\",\"chat:images\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())`)\n\tq.Text = \"\"\n\tq.MessageType = \"image\"\n\tq.Revision = 1\n\tq.Items = nil\n\treturn f, s, m, storage, q\n}\nfunc mediaAdmin() ports.Principal {\n\treturn ports.Principal{ActorID: \"90001\", Kind: \"admin\", SourceID: \"90001\", SessionID: strings.Repeat(\"a\", 64), SessionVersion: strings.Repeat(\"b\", 64), Environment: \"test\", Scopes: []string{\"chat:audit\", \"chat:moderate\", \"chat:images\"}, ExpiresAt: time.Now().Add(time.Minute)}\n}\nfunc mediaAdd(t *testing.T, m *MediaService, storage *imageMemory, cid ports.ID, n int, body string) MediaItem {\n\tt.Helper()\n\tctx := context.Background()\n\tg, e := m.Upload(ctx, principal(\"10202\"), cid, client(500+n), int64(len(body)))\n\tif e != nil {\n\t\tt.Fatal(\"upload\", e)\n\t}\n\tstorage.Put(ctx, g.Key, []byte(body), \"image/jpeg\")\n\tif _, e = m.Uploaded(ctx, principal(\"10202\"), cid, g.AttachmentID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\treturn MediaItem{AttachmentID: g.AttachmentID, ObjectVersion: g.ObjectVersion}\n}\nfunc mediaProcess(t *testing.T, m *MediaService, n int) {\n\tt.Helper()\n\tfor i := 0; i < n; i++ {\n\t\tif e := m.ProcessOne(context.Background()); e != nil {\n\t\t\tt.Fatal(\"process\", e)\n\t\t}\n\t}\n\tif e := m.Advance(context.Background()); e != nil {\n\t\tt.Fatal(\"advance\", e)\n\t}\n}\nfunc mediaApprove(t *testing.T, m *MediaService) ports.ID {\n\tt.Helper()\n\tctx := context.Background()\n\tlist, e := m.Reviews(ctx, mediaAdmin(), \"0\")\n\tif e != nil || len(list) != 1 {\n\t\tt.Fatal(\"reviews\", list, e)\n\t}\n\tv, e := m.Review(ctx, mediaAdmin(), list[0].IntentID, list[0].Version, \"claim\", \"逐图检查\", false, false)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor _, item := range list[0].Items {\n\t\tif _, e = m.ReviewURL(ctx, mediaAdmin(), v.IntentID, v.Version, item.AttachmentID); e != nil {\n\t\t\tt.Fatal(\"review URL\", e)\n\t\t}\n\t}\n\tif _, e = m.Review(ctx, mediaAdmin(), v.IntentID, v.Version, \"approve\", \"全部图片一般安全及整组导流检查通过\", true, true); e != nil {\n\t\tt.Fatal(\"approve\", e)\n\t}\n\tif e := m.Advance(ctx); e != nil {\n\t\tt.Fatal(\"publish\", e)\n\t}\n\treturn v.IntentID\n}\nfunc TestMySQLS16ImageExplicitSubmitReviewAndRecall(t *testing.T) {\n\tf, s, m, storage, q := mediaFixture(t)\n\tctx := context.Background()\n\tq.Items = []MediaItem{mediaAdd(t, m, storage, q.ConversationID, 1, \"construction\")}\n\tmediaProcess(t, m, 1)\n\tvar count int\n\tf.root.QueryRow(\"SELECT COUNT(*) FROM chat_messages\").Scan(&count)\n\tif count != 0 {\n\t\tt.Fatal(\"upload published\")\n\t}\n\tlist, e := m.Reviews(ctx, mediaAdmin(), \"0\")\n\tif e != nil || len(list) != 0 {\n\t\tt.Fatal(\"unsubmitted review\", list, e)\n\t}\n\tif _, e := s.Send(ctx, principal(\"10202\"), q); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e := m.Advance(ctx); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tlist, _ = m.Reviews(ctx, mediaAdmin(), \"0\")\n\tv, e := m.Review(ctx, mediaAdmin(), list[0].IntentID, list[0].Version, \"claim\", \"检查图片\", false, false)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = m.Review(ctx, mediaAdmin(), v.IntentID, v.Version, \"approve\", \"尚未取完整图片\", true, true); e != ErrMedia {\n\t\tt.Fatal(\"unseen approval\", e)\n\t}\n\tif _, e = m.ReviewURL(ctx,