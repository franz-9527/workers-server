 nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := m.base.authorize(ctx, tx, p, q.ConversationID)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\tif e == ErrRestricted || e == policy.ErrDenied {\n\t\t\tm.rejectMedia(ctx, id, e.Error())\n\t\t}\n\t\treturn Result{}, e\n\t}\n\ti, e := m.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif i == nil || i.id != id || i.fingerprint != fp {\n\t\treturn Result{}, ErrConflict\n\t}\n\tif i.result.State == \"accepted\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn i.result, nil\n\t}\n\tif i.result.State == \"rejected\" || i.result.State == \"canceled\" {\n\t\treturn i.result, nil\n\t}\n\tvar hash, review, rule, general, anti string\n\tvar live bool\n\te = tx.QueryRowContext(ctx, `SELECT manifest_hash,review_state,rule_version,COALESCE(general_safety_result,''),COALESCE(anti_diversion_result,''),submitted_at IS NOT NULL AND expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles WHERE intent_id=? FOR UPDATE`, string(id)).Scan(&hash, &review, &rule, &general, &anti, &live)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif !live || !active(q.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif hash != fp || rule != ImageRule || review != \"approved\" || general != \"passed\" || anti != \"passed\" {\n\t\treturn Result{}, ErrMedia\n\t}\n\tif _, e = validateReferences(ctx, tx, p, q, g); e != nil {\n\t\ttx.Rollback()\n\t\tm.rejectMedia(ctx, id, e.Error())\n\t\treturn Result{}, e\n\t}\n\tfor _, v := range q.Items {\n\t\tvar version, state, rule string\n\t\tvar live bool\n\t\tif tx.QueryRowContext(ctx, `SELECT object_version,state,COALESCE(rule_version,''),expires_at>UTC_TIMESTAMP(6) FROM chat_image_uploads WHERE id=? AND actor_id=? AND conversation_id=? LOCK IN SHARE MODE`, string(v.AttachmentID), string(p.ActorID), string(q.ConversationID)).Scan(&version, &state, &rule, &live) != nil || !live || version != v.ObjectVersion || state != \"processed\" || rule != ImageRule {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t}\n\tvar seq, change uint64\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=?`, string(q.ConversationID)).Scan(&seq, &change) != nil || seq == ^uint64(0) || change == ^uint64(0) {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tseq++\n\tchange++\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_messages(conversation_id,seq,sender_id,client_message_id,policy_version,message_type,state,state_version,safety_rule_version,created_at,reply_to_message_id,reply_to_item_id) VALUES(?,?,?,?,?,?,'published',1,?,UTC_TIMESTAMP(6),?,?)`, string(q.ConversationID), seq, string(p.ActorID), q.ClientMessageID, string(g.Version), q.MessageType, ImageRule, nullableID(q.ReplyTo), nullableID(q.ReplyItem))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tmid, e := res.LastInsertId()\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif e = storagepolicy.Stamp(ctx,tx,mid,q.MessageType); e != nil {return Result{},e}\n\tfor _, v := range q.Items {\n\t\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_image_items(message_id,item_id,ordinal,object_version) VALUES(?,?,?,?)`, mid, string(v.AttachmentID), v.Ordinal, v.ObjectVersion); e != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t}\n\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,1,'message.accepted',UTC_TIMESTAMP(6))`, string(q.ConversationID), change, mid); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_seq=?,last_change_seq=?,last_message_id=?,last_message_at=UTC_TIMESTAMP(6) WHERE id=?`, seq, change, mid, string(q.ConversationID)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='accepted',message_id=?,error_code=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, mid, string(id)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif e = reminderEvent(ctx, tx, q.ConversationID, seq); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar liveCommit bool\n\tif tx.QueryRowContext(ctx, `SELECT expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles WHERE intent_id=?`, string(id)).Scan(&liveCommit) != nil || !liveCommit || !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif m.base.publisher != nil {\n\t\tm.base.publisher.Committed(ports.CommittedMessage{ConversationID: q.ConversationID, Seq: decimal(seq), PolicyVersion: g.Version})\n\t}\n\treturn Result{ClientMessageID: q.ClientMessageID, State: \"accepted\", MessageID: ports.ID(fmt.Sprint(mid)), Seq: decimal(seq), PolicyVersion: g.Version, StateVersion: \"1\", MessageState: \"published\"}, nil\n}\n\nfunc (m *MediaService) rejectMedia(ctx context.Context, id ports.ID, code string) {\n\t_, _ = m.base.db.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state IN ('checking','retryable','review_pending')`, code, string(id))\n}\n","chat/internal/message/moderation_integration_test.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"net/url\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/moderation\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype moderationHTTP func(*http.Request) (*http.Response, error)\n\nfunc (f moderationHTTP) Do(r *http.Request) (*http.Response, error) { return f(r) }\nfunc moderated(t *testing.T, respond func(*fixtureDB, http.ResponseWriter, *http.Request)) (*fixtureDB, *Service, *moderation.Service, Request, *atomic.Int32) {\n\tt.Helper()\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tf.exec(`INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10202,'chat-platform-app','oS07Worker_abcdefghijklmnopqrstuv','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tdirectory, e := os.MkdirTemp(\"\", \"bixuan-s07-\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Cleanup(func() { os.RemoveAll(directory) })\n\tpath, _ := filepath.Abs(\"../../../server/tests/chat_text_security_contract.php\")\n\tcmd := exec.CommandContext(f.ctx, os.Getenv(\"CHAT_AUTH_TEST_PHP\"), path, \"--export\", directory)\n\tcmd.Env = os.Environ()\n\tout, e := cmd.CombinedOutput()\n\tif e != nil || strings.TrimSpace(string(out)) != \"exported\" {\n\t\tt.Fatalf(\"real PHP credential exporter: %s\", out)\n\t}\n\tcount := &atomic.Int32{}\n\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) { count.Add(1); respond(f, w, req) }))\n\tt.Cleanup(server.Close)\n\taddress, _ := url.Parse(server.URL)\n\tclient := moderationHTTP(func(req *http.Request) (*http.Response, error) {\n\t\tif req.URL.Scheme != \"https\" || req.URL.Host != \"api.weixin.qq.com\" || req.URL.Path != \"/wxa/msg_sec_check\" || req.URL.Query().Get(\"access_token\") != \"s07_fixture_official_token\" {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\tcopy := req.Clone(req.Context())\n\t\ttarget := *req.URL\n\t\tcopy.URL = &target\n\t\tcopy.URL.Host = address.Host\n\t\tcopy.URL.Scheme = address.Scheme\n\t\treturn server.Client().Do(copy)\n\t})\n\texport := filepath.Join(directory, \"export\", \"test-\"+digest(\"chat-platform-app\")+\".json\")\n\tf.credentialFile = export\n\tsafety, e := moderation.New(f.goDB, \"test\", moderation.Config{Enabled: true, AppID: \"chat-platform-app\", CredentialFile: export}, 4, 2*time.Second, client)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Cleanup(safety.Close)\n\ts.safety = safety\n\treturn f, s, safety, r, count\n}\nfunc officialPass(_ *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tvar body struct {\n\t\tContent string `json:\"content\"`\n\t\tOpenID  string `json:\"openid\"`\n\t\tScene   int    `json:\"scene\"`\n\t\tVersion int    `json:\"version\"`\n\t}\n\tif json.NewDecoder(req.Body).Decode(&body) != nil || body.OpenID != \"oS07Worker_abcdefghijklmnopqrstuv\" || body.Scene != 1 || body.Version != 2 || body.Content == \"\" {\n\t\tw.WriteHeader(400)\n\t\treturn\n\t}\n\tio.WriteString(w, `{\"errcode\":0,\"trace_id\":\"s07-fixture\",\"result\":{\"suggest\":\"pass\",\"label\":100},\"detail\":[]}`)\n}\nfunc TestMySQLS07OfficialPassUsesPHPTokenAndBoundedCache(t *testing.T) {\n\tf, s, safety, r, count := moderated(t, officialPass)\n\tfirst := accepted(t, s, r)\n\tr.ClientMessageID = client(2)\n\tsecond := accepted(t, s, r)\n\tif first.Seq != \"1\" || second.Seq != \"2\" || count.Load() != 1 {\n\t\tt.Fatalf(\"cache or send order %s %s calls=%d\", first.Seq, second.Seq, count.Load())\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_text_checks\") != \"2\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\tt.Fatal(\"normal sends created risk or lost context\")\n\t}\n\tf.exec(\"UPDATE chat_text_checks SET created_at=UTC_TIMESTAMP()-INTERVAL 11 MINUTE,pass_until=UTC_TIMESTAMP()-INTERVAL 1 MINUTE\")\n\tif e := safety.Clean(f.ctx); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_text_checks\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_send_intents\") != \"2\" {\n\t\tt.Fatal(\"context cleanup removed idempotency facts\")\n\t}\n\tif got, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID); e != nil || got.MessageID != second.MessageID {\n\t\tt.Fatalf(\"cleanup lost accepted result %+v %v\", got, e)\n\t}\n}\nfunc TestMySQLS07OfficialRejectionReviewAndFaults(t *testing.T) {\n\tfor _, mode := range []string{\"risky\", \"review\", \"quota\", \"malformed\", \"timeout\"} {\n\t\tt.Run(mode, func(t *testing.T) {\n\t\t\tvar response atomic.Value\n\t\t\tresponse.Store(mode)\n\t\t\tf, s, _, r, count := moderated(t, func(f *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\t\t\t\tswitch response.Load().(string) {\n\t\t\t\tcase \"pass\":\n\t\t\t\t\tofficialPass(f, w, req)\n\t\t\t\tcase \"risky\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":0,\"trace_id\":\"s07-risk\",\"result\":{\"suggest\":\"risky\",\"label\":200}}`)\n\t\t\t\tcase \"review\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":0,\"trace_id\":\"s07-review\",\"result\":{\"suggest\":\"review\"}}`)\n\t\t\t\tcase \"quota\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":45009,\"errmsg\":\"fixture diagnostic never forwarded\"}`)\n\t\t\t\tcase \"malformed\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":0}`)\n\t\t\t\tcase \"timeout\":\n\t\t\t\t\t// Drain the POST body so net/http can observe a closed peer.\n\t\t\t\t\t// Bound the fixture too: server cleanup must not wait forever.\n\t\t\t\t\tio.Copy(io.Discard, req.Body)\n\t\t\t\t\tselect {\n\t\t\t\t\tcase <-req.Context().Done():\n\t\t\t\t\tcase <-time.After(3 * time.Second):\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t})\n\t\t\tout, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\t\tnoMessages(t, f)\n\t\t\tif mode == \"risky\" || mode == \"review\" {\n\t\t\t\twant := \"rejected\"\n\t\t\t\tconfirmed := \"1\"\n\t\t\t\tif mode == \"review\" {\n\t\t\t\t\twant = \"review_pending\"\n\t\t\t\t\tconfirmed = \"0\"\n\t\t\t\t}\n\t\t\t\tif e != nil || out.State != want || out.RiskEventID == \"\" {\n\t\t\t\t\tt.Fatalf(\"risk outcome %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t\tif f.text(\"SELECT CAST(confirmed AS CHAR) FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) != confirmed {\n\t\t\t\t\tt.Fatal(\"review incorrectly counted as violation\")\n\t\t\t\t}\n\t\t\t\tif f.text(\"SELECT text_evidence FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) != r.Text {\n\t\t\t\t\tt.Fatal(\"risk evidence is not original text\")\n\t\t\t\t}\n\t\t\t\tagain, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\t\t\tif e != nil || again.RiskEventID != out.RiskEventID || count.Load() != 1 || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"1\" {\n\t\t\t\t\tt.Fatalf(\"risk retry duplicated %+v %v\", again, e)\n\t\t\t\t}\n\t\t\t\tgot, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID)\n\t\t\t\tif e != nil || got.RiskEventID != out.RiskEventID {\n\t\t\t\t\tt.Fatalf(\"risk status query %+v %v\", got, e)\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif e != ErrCheck || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\t\t\t\tt.Fatalf(\"fault recorded a violation %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t\tresponse.Store(\"pass\")\n\t\t\t\t// A timeout may leave the checking lease until takeover; the same ID still\n\t\t\t\t// owns the fingerprint, never creates a second logical action.\n\t\t\t\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND WHERE state='checking'\")\n\t\t\t\taccepted(t, s, r)\n\t\t\t\tif f.text(\"SELECT COUNT(*) FROM chat_text_checks\") != \"1\" {\n\t\t\t\t\tt.Fatal(\"retry added another fragment\")\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestMySQLS07LocalAndSplitRules(t *testing.T) {\n\tf, s, _, r, count := moderated(t, officialPass)\n\tr.Text = \"电话138001\"\n\taccepted(t, s, r)\n\tnext := r\n\tnext.ClientMessageID = client(2)\n\tnext.Text = \"38000\"\n\tout, e := s.Send(f.ctx, principal(\"10202\"), next)\n\tif e != nil || out.State != \"rejected\" || out.RiskEventID == \"\" || count.Load() != 1 {\n\t\tt.Fatalf(\"split contact bypass %+v %v calls=%d\", out, e, count.Load())\n\t}\n\tif f.text(\"SELECT reason_code FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) != \"split_private_phone\" || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"wrong split disposition\")\n\t}\n\tif f.text(\"SELECT context_evidence FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) == \"\" {\n\t\tt.Fatal(\"split evidence lost contributing action snapshots\")\n\t}\n\tif again, e := s.Send(f.ctx, principal(\"10202\"), next); e != nil || again.RiskEventID != out.RiskEventID {\n\t\tt.Fatal(\"blocked action was re-counted\")\n\t}\n\t// Same person's other order has independent context; a naked numeric fragment\n\t// is not itself confirmed diversion evidence.\n\tf.php(\"sync\", \"402\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tid, e := f.store.FindOrder(f.ctx, principal(\"10202\"), \"402\", \"402\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tother := next\n\tother.ConversationID = id\n\tother.ClientMessageID = client(3)\n\taccepted(t, s, other)\n\t// Old context is ineligible, while minimum intent/risk facts remain.\n\tf.exec(\"UPDATE chat_text_checks SET created_at=UTC_TIMESTAMP()-INTERVAL 3 MINUTE WHERE conversation_id=?\", string(r.ConversationID))\n\tnext.ClientMessageID = client(4)\n\taccepted(t, s, next)\n\tdirect := r\n\tdirect.ClientMessageID = client(5)\n\tdirect.Text = \"加我 ＶＸ：abc_123456\"\n\tif out, e = s.Send(f.ctx, principal(\"10202\"), direct); e != nil || out.State != \"rejected\" {\n\t\tt.Fatalf(\"direct diversion %+v %v\", out, e)\n\t}\n}\nfunc TestMySQLS07RevalidatesAuthorityBeforeEveryFinalResult(t *testing.T) {\n\tfor _, mode := range []string{\"identity-version\", \"ban\", \"close\"} {\n\t\tfor _, decision := range []string{\"pass\", \"risky\", \"review\"} {\n\t\t\tt.Run(mode+\"/\"+decision, func(t *testing.T) {\n\t\t\t\tf, s, _, r, _ := moderated(t, func(f *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\t\t\t\t\t// These real writes complete during official inspection, proving no SQL\n\t\t\t\t\t// identity/authority lease spans network I/O.\n\t\t\t\t\tswitch mode {\n\t\t\t\t\tcase \"identity-version\":\n\t\t\t\t\t\tf.exec(\"UPDATE wechat_identities SET session_version=session_version+1 WHERE user_id=10202\")\n\t\t\t\t\tcase \"ban\":\n\t\t\t\t\t\tf.exec(\"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\t\t\t\t\tcase \"close\":\n\t\t\t\t\t\tf.php(\"close\")\n\t\t\t\t\t}\n\t\t\t\t\tif decision == \"pass\" {\n\t\t\t\t\t\tofficialPass(f, w, req)\n\t\t\t\t\t} else {\n\t\t\t\t\t\tio.WriteString(w, `{\"errcode\":0,\"result\":{\"suggest\":\"`+decision+`\"}}`)\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t\tif out, e := s.Send(f.ctx, principal(\"10202\"), r); e == nil {\n\t\t\t\t\tt.Fatalf(\"stale authority finalized: %+v\", out)\n\t\t\t\t}\n\t\t\t\tnoMessages(t, f)\n\t\t\t\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\t\t\t\tt.Fatal(\"authorization change counted as violation\")\n\t\t\t\t}\n\t\t\t})\n\t\t}\n\t}\n}\nfunc TestMySQLS07MissingOrAmbiguousOpenIDFailsClosed(t *testing.T) {\n\tf, s, _, r, count := moderated(t, officialPass)\n\tf.exec(\"UPDATE wechat_identities SET status='disabled' WHERE user_id=10202\")\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ErrCheck {\n\t\tt.Fatalf(\"missing real identity %v\", e)\n\t}\n\tnoMessages(t, f)\n\tf.exec(\"UPDATE wechat_identities SET status='active' WHERE user_id=10202\")\n\tf.exec(`INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10202,'chat-platform-app','oS07Other_abcdefghijklmnopqrstuv','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tr.ClientMessageID = client(2)\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ErrCheck {\n\t\tt.Fatalf(\"ambiguous identity %v\", e)\n\t}\n\tif count.Load() != 0 || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\tt.Fatal(\"untrusted identity used externally or recorded as violation\")\n\t}\n}\n\nfunc TestMySQLS07RiskCASAndEvidenceRollback(t *testing.T) {\n\tt.Run(\"stale-owner\", func(t *testing.T) {\n\t\tf, s, _, r, _ := moderated(t, func(f *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\t\t\tf.exec(\"UPDATE chat_send_intents SET lease_owner=REPEAT('f',32) WHERE sender_id=10202 AND state='checking'\")\n\t\t\tio.WriteString(w, `{\"errcode\":0,\"result\":{\"suggest\":\"risky\"}}`)\n\t\t})\n\t\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrBusy {\n\t\t\tt.Fatalf(\"old owner recorded risk %v\", e)\n\t\t}\n\t\tnoMessages(t, f)\n\t\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\t\tt.Fatal(\"old inspection created evidence/count\")\n\t\t}\n\t})\n\tt.Run(\"rollback\", func(t *testing.T) {\n\t\tf, s, _, r, _ := moderated(t, func(_ *fixtureDB, w http.ResponseWriter, _ *http.Request) {\n\t\t\tio.WriteString(w, `{\"errcode\":0,\"result\":{\"suggest\":\"risky\"}}`)\n\t\t})\n\t\tf.exec(\"CREATE TRIGGER s07_risk_failure BEFORE INSERT ON chat_risk_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='isolated risk rollback'\")\n\t\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrUnavailable {\n\t\t\tt.Fatalf(\"risk insert failure %v\", e)\n\t\t}\n\t\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_send_intents WHERE state='rejected'\") != \"0\" {\n\t\t\tt.Fatal(\"risk/evidence terminal transaction partially committed\")\n\t\t}\n\t\tf.exec(\"DROP TRIGGER s07_risk_failure\")\n\t\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND\")\n\t\tout, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\tif e != nil || out.RiskEventID == \"\" {\n\t\t\tt.Fatalf(\"same-ID recovery %+v %v\", out, e)\n\t\t}\n\t\tnoMessages(t, f)\n\t})\n}\nfunc TestMySQLS07ExpiredCredentialCannotUseCachedPass(t *testing.T) {\n\tf, s, _, r, count := moderated(t, officialPass)\n\taccepted(t, s, r)\n\tdata, e := os.ReadFile(f.credentialFile)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tvar envelope map[string]any\n\tjson.Unmarshal(data, &envelope)\n\tenvelope[\"expires_at\"] = time.Now().Unix() - 1\n\tbad, _ := json.Marshal(envelope)\n\tos.WriteFile(f.credentialFile, bad, 0640)\n\tr.ClientMessageID = client(2)\n\tif _, e = s.Send(f.ctx, principal(\"10202\"), r); e != ErrCheck {\n\t\tt.Fatalf(\"expired credential bypassed via pass cache %v\", e)\n\t}\n\tif count.Load() != 1 || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\tt.Fatal(\"expired credential published or recorded risk\")\n\t}\n\tos.WriteFile(f.credentialFile, data, 0640)\n\taccepted(t, s, r)\n}\n","chat/internal/message/mysql_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"fmt\"\n\n\t\"encoding/hex\"\n\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\ntype fixtureDB struct {\n\tt              *testing.T\n\tctx            context.Context\n\troot, goDB     *sql.DB\n\tstore          *conversation.Store\n\tname           string\n\tuser           string\n\tcredentialFile string\n}\n\nfunc digest(s string) string { v := sha256.Sum256([]byte(s)); return hex.EncodeToString(v[:]) }\nfunc newFixture(t *testing.T) *fixtureDB {\n\tt.Helper()\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated MySQL/PHP required\")\n\t}\n\thost, _, err := net.SplitHostPort(os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"))\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"loopback fixture required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 80*time.Second)\n\tt.Cleanup(cancel)\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ParseTime = true\n\tc.Apply(mysql.Charset(\"utf8mb4\", \"utf8mb4_unicode_ci\"))\n\tc.Params = map[string]string{\"time_zone\": \"'+00:00'\"}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tadmin := sql.OpenDB(connector)\n\tdefer admin.Close()\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname := \"bixuan_test_policy_platform_\" + suffix\n\tif _, err = admin.ExecContext(ctx, \"CREATE DATABASE `\"+name+\"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.DBName = name\n\tconnector, _ = mysql.NewConnector(c)\n\troot := sql.OpenDB(connector)\n\troot.SetMaxOpenConns(4)\n\tf := &fixtureDB{t: t, ctx: ctx, root: root, name: name}\n\tt.Cleanup(func() { root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\"); root.Close() })\n\tf.php(\"init\")\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\tuser := \"bxchat_test_s06_\" + suffix\n\tf.user = user\n\tf.exec(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY 's05-fixture-only'\")\n\tt.Cleanup(func() { root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\") })\n\tfor _, table := range []string{\"chat_storage_policy\",\"chat_storage_policy_audit\", \"users\", \"login_sessions\", \"chat_policy_guards\", \"chat_business_events\", \"chat_staff_authority_versions\", \"wechat_identities\", \"chat_admin_sessions\", \"chat_mini_auditors\"} {\n\t\tf.exec(\"GRANT SELECT ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tfor _, table := range []string{\"chat_av_uploads\",\"chat_av_parts\",\"chat_av_jobs\",\"chat_av_objects\",\"chat_av_items\",\"chat_av_listens\",\"chat_av_raw_receipts\",\"chat_av_asr_requests\",\"chat_av_budgets\",\"chat_storage_applications\",\"chat_storage_application_errors\", \"chat_conversations\", \"chat_members\", \"chat_member_intervals\", \"chat_event_receipts\", \"chat_restrictions\", \"chat_send_intents\", \"chat_messages\", \"chat_message_changes\", \"chat_text_checks\", \"chat_risk_events\", \"chat_member_reads\", \"chat_user_preferences\", \"chat_preference_accounts\", \"chat_image_uploads\", \"chat_image_bundles\", \"chat_image_items\", \"chat_image_objects\", \"chat_image_reports\", \"chat_audit_accounts\", \"chat_audit_snapshots\", \"chat_audit_snapshot_items\", \"chat_cases\", \"chat_reminder_events\", \"chat_reminder_clusters\", \"chat_reminder_budgets\", \"chat_reminder_intents\"} {\n\t\tf.exec(\"GRANT SELECT,INSERT,UPDATE,DELETE ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tf.exec(\"GRANT SELECT,INSERT ON `\" + name + \"`.chat_image_audit TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\tf.exec(\"GRANT SELECT,INSERT ON `\" + name + \"`.chat_governance_audit TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\tc.User = user\n\tc.Passwd = \"s05-fixture-only\"\n\tconnector, _ = mysql.NewConnector(c)\n\tf.goDB = sql.OpenDB(connector)\n\tf.goDB.SetMaxOpenConns(4)\n\tt.Cleanup(func() { f.goDB.Close() })\n\tf.store, err = conversation.NewStore(f.goDB, \"test\", 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, actor := range []string{\"10201\", \"10202\", \"10203\"} {\n\t\tf.exec(`INSERT INTO login_sessions(id,user_id,token_hash,status,expires_at,created_at) VALUES(?,?,?,'active',UTC_TIMESTAMP()+INTERVAL 1 HOUR,UTC_TIMESTAMP())`, actor, actor, digest(\"login:\"+actor))\n\t}\n\treturn f\n}\nfunc (f *fixtureDB) exec(q string, args ...any) {\n\tf.t.Helper()\n\tif _, err := f.root.ExecContext(f.ctx, q, args...); err != nil {\n\t\tf.t.Fatal(\"fixture SQL\", err)\n\t}\n}\nfunc (f *fixtureDB) text(q string, args ...any) string {\n\tf.t.Helper()\n\tvar s string\n\tif err := f.root.QueryRowContext(f.ctx, q, args...).Scan(&s); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\treturn s\n}\nfunc (f *fixtureDB) php(action string, args ...string) {\n\tf.t.Helper()\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tf.t.Fatal(\"explicit PHP required\")\n\t}\n\tpath, _ := filepath.Abs(\"../../../server/tests/chat_platform_fixture.php\")\n\tcmd := exec.CommandContext(f.ctx, php, append([]string{path, action}, args...)...)\n\tcmd.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+f.name)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil || strings.TrimSpace(string(out)) != \"committed\" {\n\t\tf.t.Fatalf(\"real PHP %s: %s\", action, out)\n\t}\n}\nfunc principal(actor string) ports.Principal {\n\treturn ports.Principal{ActorID: ports.ID(actor), SourceID: ports.ID(actor), Kind: \"mini\", Environment: \"test\", Scopes: []string{\"chat:use\"}, SessionID: digest(\"mini\\n\" + actor + \"\\n\" + digest(\"login:\"+actor)), SessionVersion: digest(\"mini-v1\\n\" + actor + \"\\n\" + digest(\"login:\"+actor) + \"\\n\" + actor), ExpiresAt: time.Now().Add(time.Minute)}\n}\n\ntype safetyFunc func(context.Context, ports.TextRequest) (ports.SafetyResult, error)\n\nfunc (f safetyFunc) CheckText(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\treturn f(ctx, r)\n}\nfunc pass(_ context.Context, _ ports.TextRequest) (ports.SafetyResult, error) {\n\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: \"s06-fixture-v1\"}, nil\n}\nfunc setupMessage(t *testing.T, safety ports.Safety) (*fixtureDB, *Service, Request) {\n\tt.Helper()\n\tf := newFixture(t)\n\tb, e := f.store.Poll(f.ctx, 100)\n\tif e != nil || b.Applied < 1 {\n\t\tt.Fatalf(\"projection %+v %v\", b, e)\n\t}\n\tid, e := f.store.FindOrder(f.ctx, principal(\"10202\"), \"401\", \"401\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts, e := NewService(f.goDB, f.store, safety, 3*time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tr := request(1)\n\tr.ConversationID = id\n\treturn f, s, r\n}\nfunc accepted(t *testing.T, s *Service, r Request) Result {\n\tt.Helper()\n\tout, e := s.Send(context.Background(), principal(\"10202\"), r)\n\tif e != nil || out.State != \"accepted\" {\n\t\tt.Fatalf(\"send %+v %v\", out, e)\n\t}\n\treturn out\n}\nfunc noMessages(t *testing.T, f *fixtureDB) {\n\tt.Helper()\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"0\" || f.text(\"SELECT SUM(last_seq+last_change_seq) FROM chat_conversations\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_message_changes\") != \"0\" {\n\t\tt.Fatal(\"rejected/checking action published state\")\n\t}\n}\nfunc TestMySQLSendIdempotencyAndSafeResult(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tout := accepted(t, s, r)\n\tif out.Seq != \"1\" || out.PolicyVersion != \"1\" {\n\t\tt.Fatalf(\"wrong seq/version %+v\", out)\n\t}\n\tagain := accepted(t, s, r)\n\tif again.MessageID != out.MessageID {\n\t\tt.Fatal(\"duplicate message\")\n\t}\n\taltered := r\n\taltered.Text += \" changed\"\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), altered); e != ErrConflict {\n\t\tt.Fatalf(\"conflict %v\", e)\n\t}\n\tif f.text(\"SELECT text_body FROM chat_messages WHERE id=?\", string(out.MessageID)) != r.Text {\n\t\tt.Fatal(\"body changed\")\n\t}\n\tf.exec(\"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\tif got, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID); e != nil || got.MessageID != out.MessageID {\n\t\tt.Fatalf(\"ban prevented original result %+v %v\", got, e)\n\t}\n\tif got := accepted(t, s, r); got.MessageID != out.MessageID {\n\t\tt.Fatal(\"ban retry re-sent\")\n\t}\n\tnewer := r\n\tnewer.ClientMessageID = client(2)\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), newer); e != ErrRestricted {\n\t\tt.Fatalf(\"ban bypass %v\", e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET state='recalled',state_version=2 WHERE id=?\", string(out.MessageID))\n\tgot, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID)\n\tif e != nil || got.MessageState != \"recalled\" || got.StateVersion != \"2\" {\n\t\tt.Fatalf(\"unsafe state %+v %v\", got, e)\n\t}\n\tf.php(\"close\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif got, e = s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID); e != nil || got.MessageID != out.MessageID {\n\t\tt.Fatalf(\"closure lost result %+v %v\", got, e)\n\t}\n\tif _, e = s.Query(f.ctx, principal(\"10203\"), r.ConversationID, r.ClientMessageID); e != ErrUnknown {\n\t\tt.Fatalf(\"other author result leaked %v\", e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"retries published again\")\n\t}\n}\nfunc TestMySQLUnavailableAndBlockedDoNotPublish(t *testing.T) {\n\tfor _, mode := range []string{\"unavailable\", \"blocked\", \"malformed\"} {\n\t\tt.Run(mode, func(t *testing.T) {\n\t\t\tf, s, r := setupMessage(t, safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\t\t\tif mode == \"unavailable\" {\n\t\t\t\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif mode == \"malformed\" {\n\t\t\t\t\treturn ports.SafetyResult{Decision: \"passed\"}, nil\n\t\t\t\t}\n\t\t\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: \"fixture\", Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: \"fixture_blocked\", Level: 2, Confirmed: true}}, nil\n\t\t\t}))\n\t\t\tout, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\t\tif mode == \"blocked\" {\n\t\t\t\tif e != nil || out.State != \"rejected\" || out.Code != ErrBlocked.Error() {\n\t\t\t\t\tt.Fatalf(\"blocked %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t} else if e != ErrCheck {\n\t\t\t\tt.Fatalf(\"fail-open %+v %v\", out, e)\n\t\t\t}\n\t\t\tnoMessages(t, f)\n\t\t\tgot, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID)\n\t\t\tif e != nil || got.State == \"accepted\" {\n\t\t\t\tt.Fatalf(\"result %+v %v\", got, e)\n\t\t\t}\n\t\t\tif f.text(\"SELECT COUNT(*) FROM chat_send_intents WHERE retain_until>=action_expires_at+INTERVAL 30 DAY\") != \"1\" {\n\t\t\t\tt.Fatal(\"retention\")\n\t\t\t}\n\t\t\tif mode != \"blocked\" {\n\t\t\t\ts.safety = safetyFunc(pass)\n\t\t\t\taccepted(t, s, r)\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestMySQLFinalRevalidationAndSequenceOrder(t *testing.T) {\n\tfor _, change := range []string{\"ban\", \"close\", \"logout\", \"user-inactive\", \"staff-revoke\"} {\n\t\tt.Run(change, func(t *testing.T) {\n\t\t\tvar f *fixtureDB\n\t\t\tsafety := safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\t\t\t// Every operation commits while the inspector is running, proving no\n\t\t\t\t// long authority/conversation transaction is held over external calls.\n\t\t\t\tswitch change {\n\t\t\t\tcase \"ban\":\n\t\t\t\t\tf.exec(\"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\t\t\t\tcase \"close\":\n\t\t\t\t\tf.php(\"close\")\n\t\t\t\tcase \"logout\":\n\t\t\t\t\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\t\t\t\tcase \"user-inactive\":\n\t\t\t\t\tf.exec(\"UPDATE users SET status='disabled' WHERE id=10202\")\n\t\t\t\tcase \"staff-revoke\":\n\t\t\t\t\tf.exec(\"UPDATE users SET status='disabled' WHERE id=10203\")\n\t\t\t\t}\n\t\t\t\treturn pass(context.Background(), ports.TextRequest{})\n\t\t\t})\n\t\t\tvar s *Service\n\t\t\tvar r Request\n\t\t\tf, s, r = setupMessage(t, safety)\n\t\t\tif out, e := s.Send(f.ctx, principal(\"10202\"), r); e == nil && out.State == \"accepted\" {\n\t\t\t\tt.Fatal(\"changed authority published\")\n\t\t\t}\n\t\t\tnoMessages(t, f)\n\t\t})\n\t}\n\t// A slow checked message does not reserve seq. A later fast message commits\n\t// first; a retry of the slow action observes its single accepted identity.\n\tentered := make(chan struct{})\n\trelease := make(chan struct{})\n\tf, s, r := setupMessage(t, safetyFunc(func(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\t\tif r.Text == \"slow\" {\n\t\t\tclose(entered)\n\t\t\tselect {\n\t\t\tcase <-release:\n\t\t\tcase <-ctx.Done():\n\t\t\t\treturn ports.SafetyResult{}, ctx.Err()\n\t\t\t}\n\t\t}\n\t\treturn pass(ctx, r)\n\t}))\n\tslow := r\n\tslow.Text = \"slow\"\n\tdone := make(chan Result, 1)\n\terrs := make(chan error, 1)\n\tgo func() { out, e := s.Send(f.ctx, principal(\"10202\"), slow); done <- out; errs <- e }()\n\t<-entered\n\tconcurrent, e := s.Send(f.ctx, principal(\"10202\"), slow)\n\tif e != nil || concurrent.State != \"checking\" {\n\t\tt.Fatalf(\"concurrent retry %+v %v\", concurrent, e)\n\t}\n\tfast := r\n\tfast.ClientMessageID = client(2)\n\tfast.Text = \"fast\"\n\tfirst := accepted(t, s, fast)\n\tif first.Seq != \"1\" {\n\t\tt.Fatal(\"slow reserved seq\")\n\t}\n\tclose(release)\n\tsecond := <-done\n\tif e := <-errs; e != nil || second.Seq != \"2\" {\n\t\tt.Fatalf(\"commit order %+v %v\", second, e)\n\t}\n\tif got := accepted(t, s, slow); got.MessageID != second.MessageID {\n\t\tt.Fatal(\"double-send\")\n\t}\n\tif f.text(\"SELECT CONCAT(last_seq,':',last_change_seq,':',last_message_id) FROM chat_conversations WHERE id=?\", string(r.ConversationID)) != \"2:2:\"+string(second.MessageID) {\n\t\tt.Fatal(\"summary not atomic\")\n\t}\n}\nfunc TestMySQLExpiredIDsAndLeaseOwner(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\texpired := r\n\texpired.ClientMessageID = fmt.Sprintf(\"%d.%032x\", time.Now().Add(-25*time.Hour).Unix(), 1)\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), expired); e != ErrExpired {\n\t\tt.Fatalf(\"expired ID accepted %v\", e)\n\t}\n\tif _, e := s.Query(f.ctx, principal(\"10202\"), expired.ConversationID, expired.ClientMessageID); e != ErrExpired {\n\t\tt.Fatalf(\"missing expired result %v\", e)\n\t}\n\tnoMessages(t, f)\n\t// Simulate takeover while old inspector is outstanding. Old token cannot\n\t// accept even though it obtained a positive safety result.\n\ts.safety = safetyFunc(func(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\t\tf.exec(\"UPDATE chat_send_intents SET lease_owner=REPEAT('f',32) WHERE id=?\", string(r.IntentID))\n\t\treturn pass(ctx, r)\n\t})\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrBusy {\n\t\tt.Fatalf(\"old lease published %v\", e)\n\t}\n\tnoMessages(t, f)\n\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND\")\n\ts.safety = safetyFunc(pass)\n\taccepted(t, s, r)\n}\n\nfunc TestMySQLPublicationRollbackAndStableRestrictionLock(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tf.exec(\"CREATE TRIGGER s06_reject_change BEFORE INSERT ON chat_message_changes FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='isolated rollback test'\")\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrUnavailable {\n\t\tt.Fatalf(\"forced rollback %v\", e)\n\t}\n\tnoMessages(t, f)\n\tf.exec(\"DROP TRIGGER s06_reject_change\")\n\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND\")\n\tif out := accepted(t, s, r); out.Seq != \"1\" {\n\t\tt.Fatal(\"rollback consumed seq\")\n\t}\n\t// Even an unrestricted actor has a stable row locked through commit. A\n\t// concurrent ban cannot commit until this final-authorization tx releases it.\n\ttx, e := s.begin(f.ctx)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\tif _, e = s.authorize(f.ctx, tx, principal(\"10202\"), r.ConversationID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tblocked := make(chan error, 1)\n\tgo func() {\n\t\t_, e := f.root.ExecContext(f.ctx, \"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\t\tblocked <- e\n\t}()\n\tselect {\n\tcase e := <-blocked:\n\t\tt.Fatalf(\"ban escaped stable row lock: %v\", e)\n\tcase <-time.After(100 * time.Millisecond):\n\t}\n\tif e = tx.Commit(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = <-blocked; e != nil {\n\t\tt.Fatal(e)\n\t}\n\tr.ClientMessageID = client(3)\n\tif _, e = s.Send(f.ctx, principal(\"10202\"), r); e != ErrRestricted {\n\t\tt.Fatalf(\"new ban not authoritative %v\", e)\n\t}\n}\n\nfunc TestMySQLResultDoesNotOutliveCredential(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\taccepted(t, s, r)\n\ttx, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\tif _, e = tx.ExecContext(f.ctx, \"UPDATE chat_send_intents SET updated_at=updated_at WHERE conversation_id=?\", string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tp := principal(\"10202\")\n\tp.ExpiresAt = time.Now().Add(300 * time.Millisecond)\n\tdone := make(chan error, 1)\n\tgo func() { _, e := s.Query(f.ctx, p, r.ConversationID, r.ClientMessageID); done <- e }()\n\ttimer := time.NewTimer(400 * time.Millisecond)\n\tdefer timer.Stop()\n\t<-timer.C\n\tif e = tx.Commit(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = <-done; e == nil {\n\t\tt.Fatal(\"result released after credential expired\")\n\t}\n\t// An old nonterminal intent can never remain actionable, even before cleanup.\n\told := fmt.Sprintf(\"%d.%032x\", time.Now().Add(-25*time.Hour).Unix(), 9)\n\tf.exec(\"INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,attempts,action_expires_at,retain_until,created_at,updated_at) VALUES(10202,?,?,REPEAT('a',64),'retryable',1,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()+INTERVAL 30 DAY,UTC_TIMESTAMP(),UTC_TIMESTAMP())\", string(r.ConversationID), old)\n\tout, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, old)\n\tif e != nil || out.State != \"rejected\" || out.Code != ErrExpired.Error() {\n\t\tt.Fatalf(\"expired nonterminal result %+v %v\", out, e)\n\t}\n}\n","chat/internal/message/preferences.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"math\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrPreferenceConflict = errors.New(\"CHAT_PREFERENCE_CONFLICT\")\nvar ErrPinLimit = errors.New(\"CHAT_PIN_LIMIT\")\n\ntype Preferences struct {\n\tMemberVersion   string   `json:\"member_version\"`\n\tPinned          bool     `json:\"pinned\"`\n\tPinnedVersion   ports.ID `json:\"pinned_version\"`\n\tLater           bool     `json:\"later\"`\n\tLaterVersion    ports.ID `json:\"later_version\"`\n\tAccountRevision ports.ID `json:\"account_revision\"`\n}\ntype PreferenceRequest struct {\n\tConversationID ports.ID\n\tMemberVersion  string\n\tField          string\n\tValue          bool\n\tExpected       ports.ID\n}\n\nfunc preferenceLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, id ports.ID, g ports.Grant) (Preferences, error) {\n\tout := Preferences{MemberVersion: memberHash(g.MemberKey), PinnedVersion: \"0\", LaterVersion: \"0\", AccountRevision: \"0\"}\n\tvar hash string\n\terr := tx.QueryRowContext(ctx, `SELECT member_key_hash,pinned,CAST(pinned_version AS CHAR),later,CAST(later_version AS CHAR) FROM chat_user_preferences WHERE conversation_id=? AND actor_id=?`, string(id), string(p.ActorID)).Scan(&hash, &out.Pinned, &out.PinnedVersion, &out.Later, &out.LaterVersion)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif hash != out.MemberVersion {\n\t\tout.Pinned = false\n\t\tout.Later = false\n\t\tout.PinnedVersion = \"0\"\n\t\tout.LaterVersion = \"0\"\n\t}\n\treturn out, nil\n}\nfunc accountRevision(ctx context.Context, db interface {\n\tQueryRowContext(context.Context, string, ...any) *sql.Row\n}, actor ports.ID) (ports.ID, error) {\n\tvar revision ports.ID\n\terr := db.QueryRowContext(ctx, `SELECT CAST(revision AS CHAR) FROM chat_preference_accounts WHERE actor_id=?`, string(actor)).Scan(&revision)\n\tif err == sql.ErrNoRows {\n\t\treturn \"0\", nil\n\t}\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn revision, nil\n}\nfunc (s *HistoryService) Preferences(ctx context.Context, p ports.Principal, id ports.ID) (Preferences, error) {\n\tif !validID(id) || p.Environment != s.environment {\n\t\treturn Preferences{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout, err := preferenceLocked(ctx, tx, p, id, g)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout.AccountRevision, err = accountRevision(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Preferences{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// SetPreference serializes this actor's preference writes after the existing\n// guard/login/conversation lock order. Independent fields never overwrite each\n// other. A retry may repeat only the immediate same-value version transition.\nfunc (s *HistoryService) SetPreference(ctx context.Context, p ports.Principal, q PreferenceRequest) (Preferences, error) {\n\tif !validID(q.ConversationID) || p.Environment != s.environment || !q.Expected.Valid() || !memberVersionPattern.MatchString(q.MemberVersion) || (q.Field != \"pinned\" && q.Field != \"later\") {\n\t\treturn Preferences{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"})\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tif memberHash(g.MemberKey) != q.MemberVersion {\n\t\treturn Preferences{}, ErrResync\n\t}\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_preference_accounts(actor_id,revision,updated_at) VALUES(?,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(p.ActorID))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\trevision, err := accountRevision(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout, err := preferenceLocked(ctx, tx, p, q.ConversationID, g)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout.AccountRevision = revision\n\tversion, value := out.PinnedVersion, out.Pinned\n\tif q.Field == \"later\" {\n\t\tversion, value = out.LaterVersion, out.Later\n\t}\n\tif q.Expected != version {\n\t\tif !(value == q.Value && number(version) > 0 && number(q.Expected) == number(version)-1) {\n\t\t\treturn out, ErrPreferenceConflict\n\t\t}\n\t\tif !time.Now().Before(p.ExpiresAt) {\n\t\t\treturn Preferences{}, policy.ErrDenied\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tif value == q.Value {\n\t\tif !time.Now().Before(p.ExpiresAt) {\n\t\t\treturn Preferences{}, policy.ErrDenied\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tif number(version) == math.MaxUint64 || number(revision) == math.MaxUint64 {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif q.Field == \"pinned\" && q.Value {\n\t\t// Only current projected generations consume a pin slot. PHP authorization\n\t\t// is still rechecked for every returned row; this count grants no access.\n\t\tvar count int\n\t\terr = tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM (SELECT p.conversation_id FROM chat_user_preferences p JOIN chat_members m ON m.conversation_id=p.conversation_id AND m.actor_id=p.actor_id WHERE p.actor_id=? AND p.pinned=1 AND m.actor_kind='mini' AND m.can_read=1 AND p.member_key_hash=SHA2(m.member_key,256) LIMIT 10) active_pins`, string(p.ActorID)).Scan(&count)\n\t\tif err != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\tif count >= 10 {\n\t\t\treturn out, ErrPinLimit\n\t\t}\n\t}\n\tif q.Field == \"pinned\" {\n\t\tout.Pinned = q.Value\n\t\tout.PinnedVersion = decimal(number(version) + 1)\n\t} else {\n\t\tout.Later = q.Value\n\t\tout.LaterVersion = decimal(number(version) + 1)\n\t}\n\tout.AccountRevision = decimal(number(revision) + 1)\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) VALUES(?,?,?,?,?,?,?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE member_key_hash=VALUES(member_key_hash),pinned=VALUES(pinned),pinned_version=VALUES(pinned_version),later=VALUES(later),later_version=VALUES(later_version),updated_at=VALUES(updated_at)`, string(q.ConversationID), string(p.ActorID), out.MemberVersion, out.Pinned, string(out.PinnedVersion), out.Later, string(out.LaterVersion))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\t_, err = tx.ExecContext(ctx, `UPDATE chat_preference_accounts SET revision=?,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(out.AccountRevision), string(p.ActorID))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Preferences{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n","chat/internal/message/preferences_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"regexp\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar memberVersionPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)\n\n// Both transports use the same closed schema. No account/role override,\n// muted/hidden flag, read_seq, batch object, duplicate key or null is accepted.\nfunc decodePreference(raw []byte, write bool) (PreferenceRequest, error) {\n\tvar q PreferenceRequest\n\tif len(raw) > 4096 || !utf8.Valid(raw) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\ttoken, err := d.Token()\n\tif err != nil || token != json.Delim('{') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\ttoken, err = d.Token()\n\t\tkey, ok := token.(string)\n\t\tif err != nil || !ok || seen[key] {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tseen[key] = true\n\t\tvar field json.RawMessage\n\t\tif d.Decode(&field) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tif key == \"value\" && write {\n\t\t\tif !bytes.Equal(field, []byte(\"true\")) && !bytes.Equal(field, []byte(\"false\")) {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Value = bytes.Equal(field, []byte(\"true\"))\n\t\t\tcontinue\n\t\t}\n\t\tvar value string\n\t\tif len(field) < 2 || field[0] != '\"' || !validSurrogates(field) || json.Unmarshal(field, &value) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tswitch key {\n\t\tcase \"conversation_id\":\n\t\t\tq.ConversationID = ports.ID(value)\n\t\tcase \"member_version\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.MemberVersion = value\n\t\tcase \"field\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Field = value\n\t\tcase \"expected_version\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Expected = ports.ID(value)\n\t\tdefault:\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\ttoken, err = d.Token()\n\tif err != nil || token != json.Delim('}') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif _, err = d.Token(); err != io.EOF || !validID(q.ConversationID) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif write && (len(seen) != 5 || !seen[\"value\"] || !memberVersionPattern.MatchString(q.MemberVersion) || !q.Expected.Valid() || (q.Field != \"pinned\" && q.Field != \"later\")) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif !write && len(seen) != 1 {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\n","chat/internal/message/preferences_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync\"\n\t\"testing\"\n)\n\nfunc prefRequest(id ports.ID, p Preferences, field string, value bool) PreferenceRequest {\n\tversion := p.PinnedVersion\n\tif field == \"later\" {\n\t\tversion = p.LaterVersion\n\t}\n\treturn PreferenceRequest{id, p.MemberVersion, field, value, version}\n}\nfunc TestMySQLS14IndependentFieldsRetryAndReadIsolation(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 4)\n\tp := principal(\"10202\")\n\tinitial, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || initial.Pinned || initial.Later || initial.AccountRevision != \"0\" {\n\t\tt.Fatal(initial, e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_user_preferences\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_preference_accounts\") != \"0\" {\n\t\tt.Fatal(\"read creates preferences\")\n\t}\n\tstart := make(chan struct{})\n\terrs := make(chan error, 2)\n\tfor _, field := range []string{\"pinned\", \"later\"} {\n\t\tgo func(field string) {\n\t\t\t<-start\n\t\t\t_, err := h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, field, true))\n\t\t\terrs <- err\n\t\t}(field)\n\t}\n\tclose(start)\n\tfor n := 0; n < 2; n++ {\n\t\tif err := <-errs; err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tcurrent, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || !current.Pinned || !current.Later || current.PinnedVersion != \"1\" || current.LaterVersion != \"1\" || current.AccountRevision != \"2\" {\n\t\tt.Fatal(current, e)\n\t}\n\trepeated, e := h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, \"pinned\", true))\n\tif e != nil || repeated.AccountRevision != \"2\" {\n\t\tt.Fatal(\"lost-response retry\", repeated, e)\n\t}\n\tconflict := prefRequest(r.ConversationID, initial, \"pinned\", false)\n\tif _, e = h.SetPreference(f.ctx, p, conflict); e != ErrPreferenceConflict {\n\t\tt.Fatal(\"stale overwrite\", e)\n\t}\n\t_, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"pinned\", false))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, \"pinned\", true)); e != ErrPreferenceConflict {\n\t\tt.Fatal(\"ABA retry\", e)\n\t}\n\tu, e := h.Unread(f.ctx, p, r.ConversationID)\n\tif e != nil || !u.Preferences.Later || u.Preferences.Pinned || u.Preferences.AccountRevision != \"3\" {\n\t\tt.Fatal(u, e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != \"0\" {\n\t\tt.Fatal(\"preference writes read seq\")\n\t}\n\tboot := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID}, \"bootstrap\")\n\tif _, e = h.Acknowledge(f.ctx, p, r.ConversationID, boot.SyncCursor); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcurrent, e = h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || !current.Later {\n\t\tt.Fatal(\"read cleared later\", current, e)\n\t}\n\tother, e := h.Preferences(f.ctx, principal(\"10203\"), r.ConversationID)\n\tif e != nil || other.Pinned || other.Later {\n\t\tt.Fatal(\"other actor inherited preference\", other, e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, principal(\"10201\"), prefRequest(r.ConversationID, current, \"later\", false)); e == nil {\n\t\tt.Fatal(\"outsider mutated\")\n\t}\n\tf.php(\"close\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\t// Readonly policy still permits changing one's own organizational preference.\n\tcurrent, e = h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"pinned\", true)); e != nil {\n\t\tt.Fatal(\"readonly blocked preference\", e)\n\t}\n\tf.php(\"repair\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tnext, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || next.Pinned || next.Later || next.MemberVersion == initial.MemberVersion {\n\t\tt.Fatal(\"generation inherited preference\", next, e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"later\", false)); e != ErrResync {\n\t\tt.Fatal(\"old generation updated new preference\", e)\n\t}\n}\nfunc TestMySQLS14DigestRevisionAndTransports(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 1)\n\tp := principal(\"10202\")\n\tf.php(\"sync\", \"402\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpage, e := h.DigestsCursor(f.ctx, p, \"\", 1)\n\tif e != nil || !page.HasMore || page.PreferenceRevision != \"0\" {\n\t\tt.Fatal(page, e)\n\t}\n\tinitial, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tbody := fmt.Sprintf(`{\"conversation_id\":\"%s\",\"member_version\":\"%s\",\"field\":\"later\",\"value\":true,\"expected_version\":\"0\"}`, r.ConversationID, initial.MemberVersion)\n\tcommands := SocketCommands{History: h}\n\t_, out, e := commands.Execute(f.ctx, p, \"conversation.preference\", json.RawMessage(body))\n\tif e != nil || !out.(Preferences).Later {\n\t\tt.Fatal(out, e)\n\t}\n\tif _, e = h.DigestsCursor(f.ctx, p, page.NextCursor, 1); e != ErrResync {\n\t\tt.Fatal(\"mixed preference cursor\", e)\n\t}\n\tpage, e = h.DigestsCursor(f.ctx, p, \"\", 20)\n\tif e != nil || page.PreferenceRevision != \"1\" {\n\t\tt.Fatal(page, e)\n\t}\n\tfound := false\n\tfor _, row := range page.Items {\n\t\tif row.ConversationID == r.ConversationID {\n\t\t\tfound = row.Unread.Preferences.Later && row.Unread.Preferences.AccountRevision == \"1\"\n\t\t}\n\t}\n\tif !found {\n\t\tt.Fatal(\"digest lost preference\")\n\t}\n\tfor _, key := range []string{\"muted\", \"hidden\", \"read_seq\", \"actor_id\"} {\n\t\traw := fmt.Sprintf(`{\"conversation_id\":\"%s\",\"%s\":true}`, r.ConversationID, key)\n\t\tif _, _, e = commands.Execute(f.ctx, p, \"conversation.preference\", json.RawMessage(raw)); e == nil {\n\t\t\tt.Fatal(\"forged socket field\", key)\n\t\t}\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, e = h.Preferences(f.ctx, p, r.ConversationID); e == nil {\n\t\tt.Fatal(\"revoked session read preferences\")\n\t}\n\tif _, _, e = commands.Execute(context.Background(), p, \"conversation.preference\", json.RawMessage(body)); e == nil {\n\t\tt.Fatal(\"revoked session updated\")\n\t}\n}\nfunc TestMySQLS14PinBudgetAcrossConversations(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 0)\n\tp := principal(\"10202\")\n\tf.php(\"sync\", \"402\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tsecond, e := f.store.FindOrder(f.ctx, p, \"402\", \"402\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor n := 1; n <= 9; n++ {\n\t\tid := 1000 + n\n\t\tkey := fmt.Sprintf(\"budget-member-%d\", n)\n\t\tf.exec(`INSERT INTO chat_conversations(id,conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at) VALUES(?,'order',?,?,?,1,REPEAT('a',64),'budget','open',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, id, fmt.Sprintf(\"budget:%d\", n), id, id)\n\t\tf.exec(`INSERT INTO chat_members(conversation_id,actor_id,actor_kind,role,member_key,can_read,can_send) VALUES(?,10202,'mini','worker',?,1,1)`, id, key)\n\t\tf.exec(`INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) VALUES(?,10202,?,1,1,0,0,UTC_TIMESTAMP(6))`, id, memberHash(key))\n\t}\n\tstart := make(chan struct{})\n\terrs := make(chan error, 2)\n\tvar wg sync.WaitGroup\n\tfor _, id := range []ports.ID{r.ConversationID, second} {\n\t\tinitial, e := h.Preferences(f.ctx, p, id)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\twg.Add(1)\n\t\tgo func(id ports.ID, initial Preferences) {\n\t\t\tdefer wg.Done()\n\t\t\t<-start\n\t\t\t_, err := h.SetPreference(f.ctx, p, prefRequest(id, initial, \"pinned\", true))\n\t\t\terrs <- err\n\t\t}(id, initial)\n\t}\n\tclose(start)\n\twg.Wait()\n\tclose(errs)\n\taccepted, limited := 0, 0\n\tfor err := range errs {\n\t\tif err == nil {\n\t\t\taccepted++\n\t\t} else if err == ErrPinLimit {\n\t\t\tlimited++\n\t\t} else {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif accepted != 1 || limited != 1 || f.text(\"SELECT COUNT(*) FROM chat_user_preferences WHERE pinned=1\") != \"10\" {\n\t\tt.Fatal(\"pin budget race\", accepted, limited)\n\t}\n\t// Removed projection generations no longer occupy usable pin capacity.\n\tf.exec(\"UPDATE chat_members SET can_read=0 WHERE conversation_id=1001\")\n\tfor _, id := range []ports.ID{r.ConversationID, second} {\n\t\tinitial, e := h.Preferences(f.ctx, p, id)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif !initial.Pinned {\n\t\t\tif _, e = h.SetPreference(f.ctx, p, prefRequest(id, initial, \"pinned\", true)); e != nil {\n\t\t\t\tt.Fatal(\"stale pin consumed capacity\", e)\n\t\t\t}\n\t\t}\n\t}\n}\n","chat/internal/message/read_progress.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"crypto/subtle\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc memberHash(key string) string {\n\tsum := sha256.Sum256([]byte(key))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// Acknowledge is the only read-watermark writer. A locate/history cursor, an\n// unfinished sync page, an expired token or a different login cannot mark read.\n// The token is a proof of an S08 server-committed contiguous sync position;\n// the UI must still call this only after explicitly reading to that position.\nfunc (s *HistoryService) Acknowledge(ctx context.Context, p ports.Principal, id ports.ID, cursor string) (ports.ID, error) {\n\tif !validID(id) || !p.ActorID.Valid() || p.Environment != s.environment {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tc, err := s.parse(cursor, \"sync\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif c.Binding != bindingFor(s.environment, p) || c.Conversation != id || c.Pending || c.Position != c.Seq {\n\t\treturn \"\", ErrResync\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\t// This must happen inside the same locked transaction as the actual write.\n\tif g.Version != c.Policy || g.MemberKey != c.Member {\n\t\treturn \"\", ErrResync\n\t}\n\tvar upper, floor uint64\n\tif err = tx.QueryRowContext(ctx, `SELECT last_seq,sync_floor_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&upper, &floor); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\ttarget := number(c.Seq)\n\tif target > upper || target < floor {\n\t\treturn \"\", ErrResync\n\t}\n\thash := memberHash(g.MemberKey)\n\t// A row is created only for an explicit acknowledgement, never for an\n\t// unread query or a conversation summary.\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_member_reads\n\t\t(conversation_id,actor_id,member_key_hash,read_seq,updated_at)\n\t\tVALUES(?,?,?,0,UTC_TIMESTAMP(6))\n\t\tON DUPLICATE KEY UPDATE actor_id=actor_id`, string(id), string(p.ActorID), hash)\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tvar storedHash string\n\tvar current uint64\n\terr = tx.QueryRowContext(ctx, `SELECT member_key_hash,read_seq FROM chat_member_reads\n\t\tWHERE conversation_id=? AND actor_id=? FOR UPDATE`, string(id), string(p.ActorID)).Scan(&storedHash, &current)\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif subtle.ConstantTimeCompare([]byte(storedHash), []byte(hash)) != 1 {\n\t\tcurrent = 0\n\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_member_reads SET member_key_hash=?,read_seq=0,updated_at=UTC_TIMESTAMP(6)\n\t\t\tWHERE conversation_id=? AND actor_id=?`, hash, string(id), string(p.ActorID))\n\t\tif err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t}\n\tif target > current {\n\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_member_reads SET read_seq=?,updated_at=UTC_TIMESTAMP(6)\n\t\t\tWHERE conversation_id=? AND actor_id=?`, target, string(id), string(p.ActorID))\n\t\tif err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t\tcurrent = target\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn \"\", policy.ErrDenied\n\t}\n\tif err = tx.Commit(); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn decimal(current), nil\n}\n","chat/internal/message/realtime_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\"fmt\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/gorilla/websocket\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\nfunc TestMySQLRedisS11PostCommitPushAndMissedHintRecovery(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 0)\n\trdb := redis.NewClient(&redis.Options{Addr: os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\"), PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, DisableIdentity: true, Protocol: 2})\n\tdefer rdb.Close()\n\tstore, e := auth.NewRedisStore(rdb, \"test\", \"bxchat:test:\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\tv, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"s11\": pub})\n\tsrc, _ := auth.NewMySQLSource(f.goDB)\n\tidentity, _ := auth.NewService(v, src, store, 4, time.Second)\n\tcommands := &SocketCommands{History: h}\n\tg, e := socket.NewWithPolicy(identity, commands, f.store)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcommands.Sender = s.WithPublisher(g)\n\tserver := httptest.NewServer(g)\n\tdefer server.Close()\n\tdefer func() {\n\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n\t\tdefer cancel()\n\t\tif e := g.Shutdown(ctx); e != nil {\n\t\t\tt.Error(e)\n\t\t}\n\t}()\n\tlogin := func(actor string) *websocket.Conn {\n\t\tt.Helper()\n\t\tp := principal(actor)\n\t\tnow := time.Now().Unix()\n\t\tc := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: p.Environment, Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\t\traw, _ := json.Marshal(c)\n\t\tunsigned := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"s11\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(raw)\n\t\ttoken := unsigned + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(unsigned)))\n\t\tticket, _, e := identity.IssueTicket(f.ctx, token)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tws, _, e := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tt.Cleanup(func() { ws.Close() })\n\t\tws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"auth\", \"type\": \"auth\", \"payload\": map[string]string{\"ticket\": ticket}})\n\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\tvar out map[string]any\n\t\tif e := ws.ReadJSON(&out); e != nil || out[\"type\"] != \"auth.ok\" {\n\t\t\tt.Fatalf(\"auth %v %v\", out, e)\n\t\t}\n\t\treturn ws\n\t}\n\trecipient := login(\"10203\")\n\tboot, e := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tresult, e := commands.Sender.Send(f.ctx, principal(\"10202\"), q)\n\tif e != nil || result.State != \"accepted\" {\n\t\tt.Fatal(result, e)\n\t}\n\tvar hint struct {\n\t\tType    string `json:\"type\"`\n\t\tPayload struct {\n\t\t\tConversationID ports.ID `json:\"conversation_id\"`\n\t\t\tSeq            ports.ID `json:\"highest_seq\"`\n\t\t} `json:\"payload\"`\n\t}\n\trecipient.SetReadDeadline(time.Now().Add(5 * time.Second))\n\tif e := recipient.ReadJSON(&hint); e != nil || hint.Type != \"message.new\" || hint.Payload.Seq != \"1\" {\n\t\tt.Fatalf(\"postcommit %v %+v\", e, hint)\n\t}\n\t// The row is already visible when the hint arrives; hints never invent seq.\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages WHERE id=?\", string(result.MessageID)) != \"1\" {\n\t\tt.Fatal(\"hint before commit\")\n\t}\n\trecipient.Close()\n\tq.ClientMessageID = client(2)\n\tsecond := accepted(t, commands.Sender, q)\n\t// No live connection observed the second hint. The original signed cursor\n\t// still recovers both messages and the independent changes stream.\n\tpage, e := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: boot.SyncCursor}, \"sync\")\n\tif e != nil || len(page.Messages) != 2 || page.Messages[1].ID != second.MessageID {\n\t\tt.Fatal(\"lost hint lost data\", e)\n\t}\n\tchanges, e := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: boot.ChangeCursor}, \"changes\")\n\tif e != nil || len(changes.Changes) != 2 {\n\t\tt.Fatal(\"change recovery\", e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != \"0\" {\n\t\tt.Fatal(\"delivery/sync automatically marked read\")\n\t}\n\t// Retries query/return the committed result and do not publish another row.\n\taccepted(t, commands.Sender, q)\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"2\" {\n\t\tt.Fatal(\"retry duplicated publication\")\n\t}\n\trecipient = login(\"10203\")\n\trecipient.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"focus\", \"type\": \"conversation.focus\", \"payload\": map[string]any{\"conversation_id\": q.ConversationID}})\n\tvar frame map[string]any\n\tfor {\n\t\tif e := recipient.ReadJSON(&frame); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif frame[\"request_id\"] == \"focus\" {\n\t\t\tbreak\n\t\t}\n\t}\n\t// A recall emits a body-free state wakeup and recovers through the same\n    // original change cursor even if this device misses that wakeup.\n    if _,e:=commands.Sender.Recall(f.ctx,principal(\"10202\"),q.ConversationID,result.MessageID);e!=nil{t.Fatal(e)}\n    for{\n        if e:=recipient.ReadJSON(&frame);e!=nil{t.Fatal(e)}\n        if frame[\"type\"]==\"message.changed\"{if strings.Contains(fmt.Sprint(frame),\"text-\"){t.Fatal(\"recall hint body\")};break}\n    }\n    recovered,e:=h.Read(f.ctx,principal(\"10203\"),HistoryRequest{ConversationID:q.ConversationID,Cursor:changes.ChangeCursor},\"changes\")\n    if e!=nil||len(recovered.Changes)!=1||recovered.Changes[0].Message.State!=\"recalled\"||recovered.Changes[0].Message.Text!=nil{t.Fatal(\"recall reconnect recovery\",recovered,e)}\n    // Drain the paired account wakeup before the stale-authorization barrier.\n    for{if e:=recipient.ReadJSON(&frame);e!=nil{t.Fatal(e)};if frame[\"type\"]==\"account.summary.changed\"{break}}\n\t// A stale projected membership is only a candidate, never permission.\n\tf.exec(\"UPDATE chat_policy_guards SET policy_version=policy_version+1 WHERE order_id=401\")\n\tg.Committed(ports.CommittedMessage{ConversationID: q.ConversationID, Seq: \"2\", PolicyVersion: \"1\"})\n\trecipient.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"barrier\", \"type\": \"ping\", \"payload\": map[string]string{\"nonce\": \"done\"}})\n\trecipient.SetReadDeadline(time.Now().Add(5 * time.Second))\n\tfor {\n\t\tif e := recipient.ReadJSON(&frame); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif frame[\"request_id\"] == \"server\" && frame[\"type\"] == \"presence.changed\" {\n\t\t\tcontinue\n\t\t}\n\t\tif frame[\"type\"] != \"pong\" {\n\t\t\tt.Fatal(\"stale membership leaked\", frame)\n\t\t}\n\t\tbreak\n\t}\n}\n","chat/internal/message/recovery_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestMySQLS21TestCenterInstance(t *testing.T) {\n\tpath := os.Getenv(\"CHAT_TEST_CENTER_FIXTURE\")\n\tif path == \"\" {\n\t\tt.Skip(\"test center fixture not requested\")\n\t}\n\traw, err := os.ReadFile(path)\n\tif err != nil || len(raw) > 4096 {\n\t\tt.Fatal(\"fixture input\")\n\t}\n\tvar fixture struct {\n\t\tSchema      int    `json:\"schema\"`\n\t\tInstance    string `json:\"instance\"`\n\t\tSuite       string `json:\"suite\"`\n\t\tEnvironment string `json:\"environment\"`\n\t\tProvider    string `json:\"provider\"`\n\t\tOrder       struct {\n\t\t\tWorkflow string `json:\"workflow\"`\n\t\t\tSource   string `json:\"source\"`\n\t\t\tDispatch string `json:\"dispatch\"`\n\t\t} `json:\"order\"`\n\t\tActors []string `json:\"actors\"`\n\t\tCounts []int    `json:\"image_counts\"`\n\t}\n\td := json.NewDecoder(strings.NewReader(string(raw)))\n\td.DisallowUnknownFields()\n\tif d.Decode(&fixture) != nil || fixture.Schema != 1 || fixture.Instance == \"\" || fixture.Environment != \"test\" || fixture.Provider != \"simulated\" {\n\t\tt.Fatal(\"isolated fixture\")\n\t}\n\tf := newFixture(t)\n\tf.php(\"test-center\", fixture.Order.Source, fixture.Order.Workflow, fixture.Order.Dispatch)\n\tif _, err = f.store.Poll(f.ctx, 100); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcid, err := f.store.FindOrder(f.ctx, principal(\"10202\"), \"401\", \"401\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ts, err := NewService(f.goDB, f.store, safetyFunc(pass), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tq := request(210)\n\tq.ConversationID = cid\n\tout := accepted(t, s, q)\n\t// Recompose actual services on the same durable DB, without presence or a Redis cache.\n\trestarted, err := NewService(f.goDB, f.store, safetyFunc(pass), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tagain, err := restarted.Send(f.ctx, principal(\"10202\"), q)\n\tif err != nil || again.MessageID != out.MessageID || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"restart replay\", again, err)\n\t}\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"k\", 32)), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tinitial, err := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: cid}, \"bootstrap\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = restarted.Recall(f.ctx, principal(\"10202\"), cid, out.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tchanges, err := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: cid, Cursor: initial.ChangeCursor}, \"changes\")\n\tif err != nil || len(changes.Changes) != 1 || changes.Changes[0].Message.Text != nil {\n\t\tt.Fatal(\"durable change cursor\", changes, err)\n\t}\n\t// Replaying PHP events never resets a committed seq or revives a recalled body.\n\tif _, err = f.store.Poll(f.ctx, 100); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(out.MessageID)) != \"recalled\" {\n\t\tt.Fatal(\"projection revived message\")\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, err = h.Read(context.Background(), principal(\"10202\"), HistoryRequest{ConversationID: cid}, \"bootstrap\"); err == nil {\n\t\tt.Fatal(\"old login restored read\")\n\t}\n}\n","chat/internal/message/references.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrReference = errors.New(\"CHAT_REFERENCE_UNAVAILABLE\")\nvar ErrReeditLimit = errors.New(\"CHAT_REEDIT_LIMIT\")\nvar ErrRecall = errors.New(\"CHAT_RECALL_NOT_ALLOWED\")\nvar ErrRecallWindow = errors.New(\"CHAT_RECALL_WINDOW_EXPIRED\")\n\nconst maxReeditDepth = 8\n\ntype ReferenceView struct {\n\tType     string   `json:\"message_type,omitempty\"`\n\tItemID   ports.ID `json:\"item_id,omitempty\"`\n\tOrdinal  int      `json:\"ordinal,omitempty\"`\n\tCount    int      `json:\"count,omitempty\"`\n\tID       ports.ID `json:\"message_id,omitempty\"`\n\tSenderID ports.ID `json:\"sender_id,omitempty\"`\n\tState    string   `json:\"state\"`\n\tVersion  ports.ID `json:\"state_version,omitempty\"`\n\tText     *string  `json:\"text,omitempty\"`\n}\n\nfunc nullableID(id ports.ID) any {\n\tif id == \"\" {\n\t\treturn nil\n\t}\n\treturn string(id)\n}\n\nconst liveMessage = `COALESCE((m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>UTC_TIMESTAMP(6)),0)`\n\nconst retainedTarget = liveMessage + ` AND m.seq>(SELECT sync_floor_seq FROM chat_conversations WHERE id=m.conversation_id) AND m.seq<=(SELECT last_seq FROM chat_conversations WHERE id=m.conversation_id)`\n\n// Called before inspection and again inside the final publication lock. No\n// client snapshot or remembered authorization can authorize a source.\nfunc validateReferences(ctx context.Context, tx *sql.Tx, p ports.Principal, q Request, g ports.Grant) (int, error) {\n\tdepth := 0\n\tfor _, ref := range []struct {\n\t\tid     ports.ID\n\t\tedited bool\n\t}{{q.ReplyTo, false}, {q.EditedFrom, true}} {\n\t\tif ref.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tvar state, kind, sender string\n\t\tvar previous int\n\t\terr := tx.QueryRowContext(ctx, `SELECT m.state,m.message_type,CAST(m.sender_id AS CHAR),m.reedit_depth FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn, string(q.ConversationID), string(ref.id), string(g.Version), string(p.ActorID)).Scan(&state, &kind, &sender, &previous)\n\t\tif err == sql.ErrNoRows {\n\t\t\treturn 0, ErrReference\n\t\t}\n\t\tif err != nil {\n\t\t\treturn 0, ports.ErrUnavailable\n\t\t}\n\t\tif ref.edited {\n\t\t\tif state != \"recalled\" || kind != \"text\" || sender != string(p.ActorID) {\n\t\t\t\treturn 0, ErrReference\n\t\t\t}\n\t\t\tif previous >= maxReeditDepth {\n\t\t\t\treturn 0, ErrReeditLimit\n\t\t\t}\n\t\t\tdepth = previous + 1\n\t\t} else if state != \"published\" {\n\t\t\treturn 0, ErrReference\n\t\t} else if q.ReplyItem != \"\" {\n\t\t\tif kind != \"image_album\" && kind != \"image\" {\n\t\t\t\treturn 0, ErrReference\n\t\t\t}\n\t\t\tvar count int\n\t\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_image_items WHERE message_id=? AND item_id=?`, string(ref.id), string(q.ReplyItem)).Scan(&count) != nil || count != 1 {\n\t\t\t\treturn 0, ErrReference\n\t\t\t}\n\t\t}\n\t}\n\treturn depth, nil\n}\n\n// Hydrates at most 100 distinct targets for one bounded page. No nested\n// references and no recalled/blocked text are selected, even for the author.\nfunc hydrateReferences(ctx context.Context, tx *sql.Tx, p ports.Principal, g ports.Grant, id ports.ID, views []*MessageView) error {\n\treturn hydrateReferenceScope(ctx, tx, p, g, id, views, false)\n}\nfunc hydrateReferenceScope(ctx context.Context, tx *sql.Tx, p ports.Principal, g ports.Grant, id ports.ID, views []*MessageView, audit bool) error {\n\tids := map[ports.ID]bool{}\n\tfor _, v := range views {\n\t\tif v.State == \"published\" {\n\t\t\tif v.ReplyTo != \"\" {\n\t\t\t\tids[v.ReplyTo] = true\n\t\t\t}\n\t\t\tif v.EditedFrom != \"\" {\n\t\t\t\tids[v.EditedFrom] = true\n\t\t\t}\n\t\t}\n\t}\n\tif len(ids) == 0 {\n\t\treturn nil\n\t}\n\tif len(ids) > 100 {\n\t\treturn ports.ErrInvalid\n\t}\n\tmarks := make([]string, 0, len(ids))\n\targs := []any{string(g.Version), string(p.ActorID), string(id)}\n\tvisibility := visibleColumn\n\tif audit {\n\t\tvisibility = \"1\"\n\t\targs = []any{string(id)}\n\t}\n\tfor target := range ids {\n\t\tmarks = append(marks, \"?\")\n\t\targs = append(args, string(target))\n\t}\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),m.state,CAST(m.state_version AS CHAR),m.message_type,(SELECT COUNT(*) FROM chat_image_items ci WHERE ci.message_id=m.id),CASE WHEN m.state='published' AND COALESCE((m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>UTC_TIMESTAMP(6)),0) AND m.message_type='text' THEN LEFT(m.text_body,160) ELSE NULL END,`+visibility+` FROM chat_messages m WHERE m.conversation_id=? AND `+retainedTarget+` AND m.id IN (`+strings.Join(marks, \",\")+`)`, args...)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttype target struct {\n\t\tref     ReferenceView\n\t\tseq     ports.ID\n\t\tvisible bool\n\t}\n\ttargets := map[ports.ID]target{}\n\tfor rows.Next() {\n\t\tvar t target\n\t\tvar text sql.NullString\n\t\tif rows.Scan(&t.ref.ID, &t.seq, &t.ref.SenderID, &t.ref.State, &t.ref.Version, &t.ref.Type, &t.ref.Count, &text, &t.visible) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif t.ref.State == \"published\" && (t.ref.Type == \"image\" || t.ref.Type == \"image_album\") {\n\t\t\tvalue := \"[图片]\"\n\t\t\tif t.ref.Type == \"image_album\" {\n\t\t\t\tvalue = \"[图片合集]\"\n\t\t\t}\n\t\t\tt.ref.Text = &value\n\t\t}\n\t\tif t.ref.State == \"published\" && text.Valid {\n\t\t\ts := text.String\n\t\t\tt.ref.Text = &s\n\t\t}\n\t\ttargets[t.ref.ID] = t\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\titemOrdinals := map[ports.ID]map[ports.ID]int{}\n\titemArgs := []any{}\n\tfor id := range ids {\n\t\titemArgs = append(itemArgs, string(id))\n\t}\n\titemRows, itemErr := tx.QueryContext(ctx, `SELECT CAST(message_id AS CHAR),CAST(item_id AS CHAR),ordinal FROM chat_image_items WHERE message_id IN (`+strings.Join(marks, \",\")+`)`, itemArgs...)\n\tif itemErr != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor itemRows.Next() {\n\t\tvar mid, item ports.ID\n\t\tvar ordinal int\n\t\tif itemRows.Scan(&mid, &item, &ordinal) != nil {\n\t\t\titemRows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif itemOrdinals[mid] == nil {\n\t\t\titemOrdinals[mid] = map[ports.ID]int{}\n\t\t}\n\t\titemOrdinals[mid][item] = ordinal\n\t}\n\titemErr = itemRows.Err()\n\titemRows.Close()\n\tif itemErr != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, v := range views {\n\t\tif v.State != \"published\" {\n\t\t\tv.Reply = nil\n\t\t\tv.EditedSource = nil\n\t\t\tcontinue\n\t\t}\n\t\tfor _, slot := range []struct {\n\t\t\tid     ports.ID\n\t\t\tout    **ReferenceView\n\t\t\tedited bool\n\t\t}{{v.ReplyTo, &v.Reply, false}, {v.EditedFrom, &v.EditedSource, true}} {\n\t\t\tif slot.id == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tref := ReferenceView{State: \"unavailable\"}\n\t\t\tt, ok := targets[slot.id]\n\t\t\tif ok && t.visible && number(t.seq) < number(v.Seq) {\n\t\t\t\tref = t.ref\n\t\t\t\tif ref.State != \"published\" {\n\t\t\t\t\tref.Text = nil\n\t\t\t\t}\n\t\t\t\tif ref.State != \"published\" && ref.State != \"recalled\" {\n\t\t\t\t\tref.State = \"unavailable\"\n\t\t\t\t\tref.Text = nil\n\t\t\t\t}\n\t\t\t\tif !slot.edited && v.ReplyItem != \"\" && ref.State == \"published\" {\n\t\t\t\t\tif ordinal, ok := itemOrdinals[slot.id][v.ReplyItem]; ok {\n\t\t\t\t\t\tref.ItemID = v.ReplyItem\n\t\t\t\t\t\tref.Ordinal = ordinal\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif slot.edited {\n\t\t\t\t\tref.Text = nil\n\t\t\t\t}\n\t\t\t}\n\t\t\t*slot.out = &ref\n\t\t}\n\t}\n\treturn nil\n}\nfunc decodeRecall(raw []byte) (HistoryRequest, error) {\n\tq, e := decodeHistory(raw)\n\tif e != nil {\n\t\treturn q, e\n\t}\n\tvar fields map[string]json.RawMessage\n\tif json.Unmarshal(raw, &fields) != nil || len(fields) != 2 || fields[\"conversation_id\"] == nil || fields[\"message_id\"] == nil || !validID(q.TargetID) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\n\n// Recall uses current READ authority and the conversation commit lock. It\n// never takes the send restriction gate or advances last_seq/read_seq.\nfunc (s *Service) Recall(ctx context.Context, p ports.Principal, id, target ports.ID) (MessageView, error) {\n\tif !validID(id) || !validID(target) {\n\t\treturn MessageView{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn MessageView{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif e != nil {\n\t\treturn MessageView{}, e\n\t}\n\tvar v MessageView\n\tvar allowed bool\n\te = tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),CAST(m.policy_version AS CHAR),m.message_type,m.state,CAST(m.state_version AS CHAR),m.created_at,TIMESTAMPDIFF(MICROSECOND,m.created_at,UTC_TIMESTAMP(6)) BETWEEN 0 AND 120000000 FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn, string(id), string(target), string(g.Version), string(p.ActorID)).Scan(&v.ID, &v.Seq, &v.SenderID, &v.PolicyVersion, &v.Type, &v.State, &v.StateVersion, &v.CreatedAt, &allowed)\n\tif e == sql.ErrNoRows {\n\t\treturn MessageView{}, ErrRecall\n\t}\n\tif e != nil {\n\t\treturn MessageView{}, ports.ErrUnavailable\n\t}\n\tif v.SenderID != p.ActorID || (v.Type != \"text\" && v.Type != \"image\" && v.Type != \"image_album\" && v.Type != \"audio\" && v.Type != \"video\") || (v.State != \"published\" && v.State != \"recalled\") {\n\t\treturn MessageView{}, ErrRecall\n\t}\n\tchanged := v.State == \"published\"\n\tif changed {\n\t\tif !allowed {\n\t\t\treturn MessageView{}, ErrRecallWindow\n\t\t}\n\t\tvar change uint64\n\t\tif tx.QueryRowContext(ctx, `SELECT last_change_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&change) != nil || change == ^uint64(0) || number(v.StateVersion) == ^uint64(0) {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tversion := number(v.StateVersion) + 1\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_messages SET state='recalled',state_version=?,recalled_at=UTC_TIMESTAMP(6) WHERE id=? AND conversation_id=?`, version, string(target), string(id)); e != nil {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,?,'message.recalled',UTC_TIMESTAMP(6))`, string(id), change+1, string(target), version); e != nil {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_change_seq=? WHERE id=?`, change+1, string(id)); e != nil {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tv.State = \"recalled\"\n\t\tv.StateVersion = decimal(version)\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn MessageView{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn MessageView{}, ports.ErrUnavailable\n\t}\n\tif changed && s.publisher != nil {\n\t\tevent := ports.CommittedMessage{ConversationID: id, Seq: v.Seq, PolicyVersion: g.Version}\n\t\tif publisher, ok := s.publisher.(interface{ Changed(ports.CommittedMessage) }); ok {\n\t\t\tpublisher.Changed(event)\n\t\t} else {\n\t\t\ts.publisher.Committed(event)\n\t\t}\n\t}\n\treturn v, nil\n}\n","chat/internal/message/reminder_http.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"io\"\n\t\"net/http\"\n\t\"time\"\n)\n\ntype ReminderInternalHandler struct {\n\tservice *ReminderService\n\tauth    *auth.InternalAuth\n\tgate    chan struct{}\n}\n\nfunc NewReminderInternalHandler(s *ReminderService, a *auth.InternalAuth) (*ReminderInternalHandler, error) {\n\tif s == nil || a == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderInternalHandler{s, a, make(chan struct{}, 8)}, nil\n}\nfunc (h *ReminderInternalHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tfail := func(status int) { w.WriteHeader(status); w.Write([]byte(\"{\\\"code\\\":\\\"CHAT_REMINDER_UNAVAILABLE\\\"}\")) }\n\tif r.Method != \"POST\" || r.URL.Path != \"/chat/internal/v1/reminders/eligible\" || r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(404)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429)\n\t\treturn\n\t}\n\traw, err := io.ReadAll(io.LimitReader(r.Body, 1025))\n\tif err != nil || len(raw) > 1024 {\n\t\tfail(400)\n\t\treturn\n\t}\n\tif err = h.auth.Verify(r.Context(), r, raw, time.Now()); err != nil {\n\t\tfail(401)\n\t\treturn\n\t}\n\tvar q struct {\n\t\tOperation string `json:\"operation_id\"`\n\t}\n\tif !strictImageJSON(raw, &q) || len(q.Operation) != 64 {\n\t\tfail(400)\n\t\treturn\n\t}\n\tallowed, err := h.service.Eligible(r.Context(), q.Operation)\n\tif err != nil {\n\t\tfail(503)\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]bool{\"eligible\": allowed})\n}\n","chat/internal/message/reminder_rounds.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype reminderCluster struct {\n\tID, CID, Actor ports.ID\n\tHash           string\n\tVersion        uint64\n\tRound          int\n\tTarget         uint64\n}\n\nfunc (r *ReminderService) Prepare(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_clusters WHERE state='open' AND next_due<=UTC_TIMESTAMP(6) ORDER BY next_due,id LIMIT 50`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tcandidates := []reminderCluster{}\n\tfor rows.Next() {\n\t\tvar c reminderCluster\n\t\tif rows.Scan(&c.ID, &c.CID, &c.Actor, &c.Hash) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tcandidates = append(candidates, c)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, c := range candidates {\n\t\tif err = r.prepareOne(ctx, c); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) reserveBudget(ctx context.Context, tx *sql.Tx, actor ports.ID) (bool, error) {\n\tnow := time.Now().UTC()\n\tfor _, id := range []ports.ID{\"0\", actor} {\n\t\tif _, err := tx.ExecContext(ctx, `INSERT INTO chat_reminder_budgets(recipient_id,hour_start,hour_count,day_start,day_count) VALUES(?,UTC_TIMESTAMP(),0,UTC_DATE(),0) ON DUPLICATE KEY UPDATE recipient_id=recipient_id`, string(id)); err != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t\tvar hourly, daily int\n\t\tvar hour, day time.Time\n\t\tif tx.QueryRowContext(ctx, `SELECT hour_start,hour_count,day_start,day_count FROM chat_reminder_budgets WHERE recipient_id=? FOR UPDATE`, string(id)).Scan(&hour, &hourly, &day, &daily) != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t\tif now.Sub(hour) >= time.Hour {\n\t\t\thour = now\n\t\t\thourly = 0\n\t\t}\n\t\tif day.Format(\"2006-01-02\") != now.Format(\"2006-01-02\") {\n\t\t\tday = now\n\t\t\tdaily = 0\n\t\t}\n\t\th, d := r.config.RecipientHourly, r.config.RecipientDaily\n\t\tif id == \"0\" {\n\t\t\th = r.config.PlatformHourly\n\t\t\td = r.config.PlatformDaily\n\t\t}\n\t\tif hourly >= h || daily >= d {\n\t\t\treturn false, nil\n\t\t}\n\t\tif _, err := tx.ExecContext(ctx, `UPDATE chat_reminder_budgets SET hour_start=?,hour_count=?,day_start=?,day_count=? WHERE recipient_id=?`, hour, hourly+1, day.Format(\"2006-01-02\"), daily+1, string(id)); err != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t}\n\treturn true, nil\n}\nfunc (r *ReminderService) prepareOne(ctx context.Context, c reminderCluster) error {\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\tw, err := r.window(ctx, tx, c.CID, c.Actor, ^uint64(0))\n\tif err != nil && !errors.Is(err, policy.ErrDenied) {\n\t\treturn err\n\t}\n\tdenied := errors.Is(err, policy.ErrDenied)\n\tvar state string\n\tvar due bool\n\tif tx.QueryRowContext(ctx, `SELECT round_version,rounds,target_seq,state,next_due<=UTC_TIMESTAMP(6) FROM chat_reminder_clusters WHERE id=? FOR UPDATE`, string(c.ID)).Scan(&c.Version, &c.Round, &c.Target, &state, &due) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif state != \"open\" || !due {\n\t\treturn nil\n\t}\n\tif denied || w.First == 0 || w.Hash != c.Hash {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state='closed' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tif c.Round >= 3 {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state='exhausted' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tvar exists int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_reminder_intents WHERE cluster_id=? AND round_version=? AND round_no=?`, string(c.ID), c.Version, c.Round+1).Scan(&exists) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif exists > 0 {\n\t\treturn nil\n\t} // One persisted attempt/outbox until a real outcome.\n\t// All reservations roll back together if either account/platform budget fails.\n\tif _, err = tx.ExecContext(ctx, \"SAVEPOINT reminder_budget\"); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tallowed, err := r.reserveBudget(ctx, tx, c.Actor)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !allowed {\n\t\tif _, err = tx.ExecContext(ctx, \"ROLLBACK TO SAVEPOINT reminder_budget\"); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,blocked_reason='channel_budget' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tvar b [32]byte\n\tif _, err = rand.Read(b[:]); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_reminder_intents(operation_id,cluster_id,round_version,round_no,conversation_id,recipient_id,member_hash,target_seq,state,attempts,next_attempt_at,created_at,expires_at) VALUES(?,?,?,?,?,?,?,?,'pending',0,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6),UTC_TIMESTAMP(6)+INTERVAL 1 DAY)`, hex.EncodeToString(b[:]), string(c.ID), c.Version, c.Round+1, string(c.CID), string(c.Actor), c.Hash, w.Target); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET blocked_reason=NULL WHERE id=?`, string(c.ID)); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) SubmitPending(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),operation_id,CAST(recipient_id AS CHAR),CAST(target_seq AS CHAR),CAST(round_version AS CHAR),CAST(conversation_id AS CHAR) FROM chat_reminder_intents WHERE state IN ('pending','retryable') AND attempts<8 AND next_attempt_at<=UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6) ORDER BY id LIMIT 20`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\twork := []ports.Reminder{}\n\tfor rows.Next() {\n\t\tvar q ports.Reminder\n\t\tif rows.Scan(&q.IntentID, &q.OperationID, &q.RecipientID, &q.TargetSeq, &q.ClusterVersion, &q.ConversationID) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\twork = append(work, q)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, q := range work {\n\t\tresult, err := r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='retryable',diagnostic='php_receipt_unconfirmed',attempts=attempts+1,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND WHERE id=? AND state IN ('pending','retryable') AND next_attempt_at<=UTC_TIMESTAMP(6) AND attempts<8`, string(q.IntentID))\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tn, _ := result.RowsAffected()\n\t\tif n != 1 {\n\t\t\tcontinue\n\t\t}\n\t\tallowed, err := r.Eligible(ctx, q.OperationID)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !allowed {\n\t\t\tif err = r.reconcileOne(ctx, q.OperationID, ports.Receipt{OperationID: q.OperationID, State: \"suppressed\", Diagnostic: \"read_or_permission_changed\"}); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\treceipt, err := r.notification.Submit(ctx, q)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif receipt.OperationID != q.OperationID {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tswitch receipt.State {\n\t\tcase \"accepted\":\n\t\t\t_, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='submitted' WHERE id=? AND state='retryable'`, string(q.IntentID))\n\t\tcase \"sent\", \"suppressed\", \"channel_limited\", \"provider_unknown\":\n\t\t\terr = r.reconcileOne(ctx, q.OperationID, receipt)\n\t\tdefault:\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) Eligible(ctx context.Context, op string) (bool, error) {\n\tif len(op) != 64 {\n\t\treturn false, ports.ErrInvalid\n\t}\n\tvar cid, actor, cluster ports.ID\n\tvar hash, state string\n\tvar target, version uint64\n\tvar live bool\n\terr := r.base.db.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),CAST(cluster_id AS CHAR),member_hash,target_seq,round_version,state,expires_at>UTC_TIMESTAMP(6) FROM chat_reminder_intents WHERE operation_id=?`, op).Scan(&cid, &actor, &cluster, &hash, &target, &version, &state, &live)\n\tif err == sql.ErrNoRows {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tif !live || state == \"suppressed\" || state == \"provider_unknown\" || state == \"channel_limited\" {\n\t\treturn false, nil\n\t}\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tdefer tx.Rollback()\n\tw, err := r.window(ctx, tx, cid, actor, target)\n\tif errors.Is(err, policy.ErrDenied) {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tvar current uint64\n\tif tx.QueryRowContext(ctx, `SELECT round_version FROM chat_reminder_clusters WHERE id=? LOCK IN SHARE MODE`, string(cluster)).Scan(&current) != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tvalid := w.First > 0 && w.Hash == hash && current == version\n\tif tx.Commit() != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn valid, nil\n}\n","chat/internal/message/reminders.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Publication persists only this wakeup; the worker may restart at any time.\nfunc reminderEvent(ctx context.Context, tx *sql.Tx, cid ports.ID, seq uint64) error {\n\t_, err := tx.ExecContext(ctx, `INSERT INTO chat_reminder_events(conversation_id,seq,created_at) VALUES(?,?,UTC_TIMESTAMP(6))`, string(cid), seq)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\ntype ReminderConfig struct {\n\tFirstDelaySeconds                                              int\n\tRecipientHourly, RecipientDaily, PlatformHourly, PlatformDaily int\n}\n\nfunc DefaultReminderConfig() ReminderConfig { return ReminderConfig{10, 3, 10, 1000, 10000} }\nfunc (c ReminderConfig) Validate() error {\n\tif c.FirstDelaySeconds < 1 || c.FirstDelaySeconds > 30 || c.RecipientHourly < 1 || c.RecipientHourly > 100 || c.RecipientDaily < c.RecipientHourly || c.RecipientDaily > 1000 || c.PlatformHourly < c.RecipientHourly || c.PlatformHourly > 100000 || c.PlatformDaily < c.PlatformHourly || c.PlatformDaily > 1000000 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\ntype ReminderService struct {\n\tbase         *Service\n\tnotification ports.Notification\n\tconfig       ReminderConfig\n}\ntype reminderReceipts interface {\n\tStatus(context.Context, string) (ports.Receipt, error)\n}\n\nfunc NewReminderService(base *Service, n ports.Notification) (*ReminderService, error) {\n\tif base == nil || n == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderService{base, n, DefaultReminderConfig()}, nil\n}\nfunc (r *ReminderService) WithConfig(c ReminderConfig) (*ReminderService, error) {\n\tif c.Validate() != nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tcopy := *r\n\tcopy.config = c\n\treturn &copy, nil\n}\n\ntype reminderWindow struct {\n\tGrant         ports.Grant\n\tHash          string\n\tFirst, Target uint64\n\tRead          uint64\n\tAt            time.Time\n}\n\nfunc (r *ReminderService) window(ctx context.Context, tx *sql.Tx, cid, actor ports.ID, target uint64) (reminderWindow, error) {\n\tgrant, err := r.base.conversations.RecipientLocked(ctx, tx, cid, actor)\n\tif err != nil {\n\t\treturn reminderWindow{}, err\n\t}\n\tout := reminderWindow{Grant: grant, Hash: memberHash(grant.MemberKey)}\n\tif target == ^uint64(0) {\n\t\tif tx.QueryRowContext(ctx, `SELECT last_seq FROM chat_conversations WHERE id=?`, string(cid)).Scan(&target) != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t}\n\tvar hash string\n\terr = tx.QueryRowContext(ctx, `SELECT member_key_hash,read_seq FROM chat_member_reads WHERE conversation_id=? AND actor_id=? LOCK IN SHARE MODE`, string(cid), string(actor)).Scan(&hash, &out.Read)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif hash != out.Hash {\n\t\tout.Read = 0\n\t}\n\tpredicate := `m.conversation_id=? AND m.sender_id<>? AND m.state='published' AND COALESCE((m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>UTC_TIMESTAMP(6)),0) AND m.seq>? AND m.seq<=? AND ` + retainedTarget + ` AND ` + visibleColumn\n\targs := []any{string(cid), string(actor), out.Read, target, string(grant.Version), string(actor)}\n\terr = tx.QueryRowContext(ctx, `SELECT m.seq,m.created_at FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq LIMIT 1`, args...).Scan(&out.First, &out.At)\n\tif err == sql.ErrNoRows {\n\t\treturn out, nil\n\t}\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif tx.QueryRowContext(ctx, `SELECT m.seq FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq DESC LIMIT 1`, args...).Scan(&out.Target) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// DrainEvents is bounded and replay-safe. First due comes from the first\n// still-unread message, never from the time this process happens to wake up.\nfunc (r *ReminderService) DrainEvents(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),seq FROM chat_reminder_events WHERE processed_at IS NULL ORDER BY id LIMIT 50`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttype event struct {\n\t\tid, cid ports.ID\n\t\tseq     uint64\n\t}\n\tevents := []event{}\n\tfor rows.Next() {\n\t\tvar v event\n\t\tif rows.Scan(&v.id, &v.cid, &v.seq) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tevents = append(events, v)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, event := range events {\n\t\tactors, e := r.base.conversations.MemberCandidates(ctx, event.cid)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tfor _, actor := range actors {\n\t\t\ttx, e := r.base.begin(ctx)\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tw, e := r.window(ctx, tx, event.cid, actor, event.seq)\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\tif errors.Is(e, policy.ErrDenied) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tif w.First > 0 {\n\t\t\t\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_reminder_clusters(conversation_id,recipient_id,member_hash,round_version,first_seq,target_seq,first_due_at,next_due,rounds,state,created_at) VALUES(?,?,?,1,?,?,TIMESTAMPADD(SECOND,?,?),TIMESTAMPADD(SECOND,?,?),0,'open',UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE round_version=IF(state='closed' OR ? >= target_seq,round_version+1,round_version),first_seq=IF(state='closed' OR ? >= target_seq,VALUES(first_seq),LEAST(first_seq,VALUES(first_seq))),first_due_at=IF(state='closed' OR ? >= target_seq,VALUES(first_due_at),first_due_at),first_notified_at=IF(state='closed' OR ? >= target_seq,NULL,first_notified_at),next_due=IF(state='closed' OR ? >= target_seq,VALUES(next_due),next_due),rounds=IF(state='closed' OR ? >= target_seq,0,rounds),target_seq=GREATEST(target_seq,VALUES(target_seq)),state=IF(state='exhausted' AND rounds>=3,'exhausted','open')`, string(event.cid), string(actor), w.Hash, w.First, w.Target, r.config.FirstDelaySeconds, w.At, r.config.FirstDelaySeconds, w.At, w.Read, w.Read, w.Read, w.Read, w.Read, w.Read)\n\t\t\t}\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\tif tx.Commit() != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tif _, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_events SET processed_at=UTC_TIMESTAMP(6) WHERE id=?`, string(event.id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\n","chat/internal/message/reminders_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync\"\n\t\"testing\"\n)\n\ntype reminderCapture struct {\n\tmu    sync.Mutex\n\tcalls []ports.Reminder\n\tlose  bool\n}\n\nfunc (c *reminderCapture) Submit(_ context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tc.calls = append(c.calls, q)\n\tif c.lose {\n\t\tc.lose = false\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\treturn ports.Receipt{OperationID: q.OperationID, State: \"accepted\"}, nil\n}\nfunc (c *reminderCapture) Status(_ context.Context, op string) (ports.Receipt, error) {\n\treturn ports.Receipt{OperationID: op, State: \"sent\", Diagnostic: \"sent\"}, nil\n}\nfunc TestMySQLS20DurableEventsFixedDueRetryAndReadSuppression(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{lose: true}\n\tr, err := NewReminderService(s, capture)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfirst := accepted(t, s, q)\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_events WHERE processed_at IS NULL\") != \"1\" {\n\t\tt.Fatal(\"publication lost durable event\")\n\t}\n\t// A new instance represents process death after message commit.\n\tr, _ = NewReminderService(s, capture)\n\tif err = r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdue := f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\")\n\tq.ClientMessageID = client(42)\n\taccepted(t, s, q)\n\tif err = r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\") != due {\n\t\tt.Fatal(\"new message postponed first reminder\")\n\t}\n\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err = r.Prepare(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"1\" {\n\t\tt.Fatal(\"not one aggregate round\")\n\t}\n\tif err = r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_reminder_intents SET next_attempt_at=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err = r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(capture.calls) != 2 || capture.calls[0].OperationID != capture.calls[1].OperationID {\n\t\tt.Fatal(\"ambiguous PHP result changed operation\")\n\t}\n\top := capture.calls[1].OperationID\n\tif allowed, err := r.Eligible(f.ctx, op); err != nil || !allowed {\n\t\tt.Fatal(\"online is not read\", allowed, err)\n\t}\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(\"12345678901234567890123456789012\"), s.timeout)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpage, err := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = h.Acknowledge(f.ctx, principal(\"10203\"), q.ConversationID, page.SyncCursor); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif allowed, err := r.Eligible(f.ctx, op); err != nil || allowed {\n\t\tt.Fatal(\"read did not suppress queued reminder\", allowed, err)\n\t}\n\tif first.MessageID == \"\" || f.text(\"SELECT COUNT(*) FROM notifications\") != \"0\" {\n\t\tt.Fatal(\"per-message business notices created\")\n\t}\n}\nfunc TestMySQLS20RoundsBudgetRecallAndPermissionRevocation(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{}\n\tr, _ := NewReminderService(s, capture)\n\tmsg := accepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor i := 0; i < 5; i++ {\n\t\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\t\tif err := r.Prepare(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := r.SubmitPending(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := r.Reconcile(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"3\" {\n\t\tt.Fatal(\"continued unread exceeded three rounds\")\n\t}\n\tif f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=10203\") != \"3\" {\n\t\tt.Fatal(\"chat-only budget mismatch\")\n\t}\n\tif err := r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(capture.calls) != 3 {\n\t\tt.Fatal(capture.calls)\n\t}\n\tif _, err := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, msg.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif ok, err := r.Eligible(f.ctx, capture.calls[0].OperationID); err != nil || ok {\n\t\tt.Fatal(\"recall still reminded\", ok, err)\n\t}\n\tq.ClientMessageID = client(49)\n\taccepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// The original member epoch is revoked in PHP before the worker projects it.\n\tf.exec(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n\tif ok, err := r.Eligible(f.ctx, capture.calls[1].OperationID); err != nil || ok {\n\t\tt.Fatal(\"revoked recipient reminded\", ok, err)\n\t}\n}\n\nfunc TestS20ReminderConfigBounds(t *testing.T) {\n\tc := DefaultReminderConfig()\n\tif c.FirstDelaySeconds != 10 || c.Validate() != nil {\n\t\tt.Fatal(\"default reminder policy\")\n\t}\n\tc.FirstDelaySeconds = 31\n\tif c.Validate() == nil {\n\t\tt.Fatal(\"first due exceeded 30-second policy\")\n\t}\n\tc = DefaultReminderConfig()\n\tc.PlatformHourly = 0\n\tif c.Validate() == nil {\n\t\tt.Fatal(\"unbounded platform budget\")\n\t}\n}\nfunc TestMySQLS20ChannelLimitsReleaseReservationsWithoutCountingSuccess(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{}\n\tr, _ := NewReminderService(s, capture)\n\taccepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err := r.Prepare(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\top := f.text(\"SELECT operation_id FROM chat_reminder_intents LIMIT 1\")\n\tif err := r.reconcileOne(f.ctx, op, ports.Receipt{OperationID: op, State: \"channel_limited\", Diagnostic: \"template_unavailable\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT rounds FROM chat_reminder_clusters\") != \"0\" || f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=10203\") != \"0\" || f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=0\") != \"0\" {\n\t\tt.Fatal(\"channel failure counted as successful reminder\")\n\t}\n\tif f.text(\"SELECT state FROM chat_reminder_clusters\") != \"channel_limited\" {\n\t\tt.Fatal(\"channel diagnostic lost\")\n\t}\n\tfor i := 0; i < 3; i++ {\n\t\tif err := r.Prepare(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"1\" {\n\t\tt.Fatal(\"channel limit created endless new rounds\")\n\t}\n}\n","chat/internal/message/restrictions.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Restriction struct {\n\tActor          ports.ID   `json:\"actor_id\"`\n\tVersion        ports.ID   `json:\"version\"`\n\tPermanent      bool       `json:\"permanent\"`\n\tUntil          *time.Time `json:\"blocked_until,omitempty\"`\n\tBlocked        bool       `json:\"blocked\"`\n\tConfirmedRisks uint64     `json:\"confirmed_risks\"`\n}\ntype RestrictionRequest struct {\n\tActor    ports.ID `json:\"actor_id\"`\n\tExpected ports.ID `json:\"expected_version\"`\n\tAction   string   `json:\"action\"`\n\tSeconds  int      `json:\"seconds,omitempty\"`\n\tReason   string   `json:\"reason\"`\n}\n\nfunc restrictionLocked(ctx context.Context, tx *sql.Tx, id ports.ID) (Restriction, error) {\n\tif _, err := tx.ExecContext(ctx, `INSERT INTO chat_restrictions(actor_id,version,updated_at) VALUES(?,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(id)); err != nil {\n\t\treturn Restriction{}, ports.ErrUnavailable\n\t}\n\tout := Restriction{Actor: id}\n\tvar until sql.NullTime\n\tif tx.QueryRowContext(ctx, `SELECT CAST(version AS CHAR),permanent,blocked_until,(permanent=1 OR blocked_until>UTC_TIMESTAMP(6)) IS TRUE FROM chat_restrictions WHERE actor_id=? FOR UPDATE`, string(id)).Scan(&out.Version, &out.Permanent, &until, &out.Blocked) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif until.Valid {\n\t\tv := until.Time\n\t\tout.Until = &v\n\t}\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_risk_events WHERE sender_id=? AND confirmed=1 AND review_state<>'corrected'`, string(id)).Scan(&out.ConfirmedRisks) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) Restriction(ctx context.Context, p ports.Principal, actor ports.ID) (Restriction, error) {\n\tif !validID(actor) {\n\t\treturn Restriction{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tdefer tx.Rollback()\n\tif p.Kind == \"mini\" && p.ActorID == actor && p.Environment == g.environment {\n\t\terr = g.source.ValidatePrincipalLocked(ctx, tx, p)\n\t} else {\n\t\terr = g.admin(ctx, tx, p, \"chat:moderate\")\n\t}\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tout, err := restrictionLocked(ctx, tx, actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) Restrict(ctx context.Context, p ports.Principal, q RestrictionRequest) (Restriction, error) {\n\tif !validID(q.Actor) || !q.Expected.Valid() || !reasonValid(q.Reason) || q.Action != \"unban\" && q.Action != \"permanent\" && q.Action != \"timed\" || q.Action == \"timed\" && (q.Seconds < 60 || q.Seconds > 30*86400) || q.Action != \"timed\" && q.Seconds != 0 {\n\t\treturn Restriction{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:moderate\"); err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tvar actor ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM users WHERE id=? LOCK IN SHARE MODE`, string(q.Actor)).Scan(&actor) != nil {\n\t\treturn Restriction{}, auth.ErrUnauthorized\n\t}\n\tout, err := restrictionLocked(ctx, tx, q.Actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif out.Version != q.Expected {\n\t\treturn out, ErrPreferenceConflict\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET permanent=?,blocked_until=IF(?='timed',TIMESTAMPADD(SECOND,?,UTC_TIMESTAMP(6)),NULL),version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, q.Action == \"permanent\", q.Action, q.Seconds, string(q.Actor)); err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"restriction.\"+q.Action, \"\", q.Actor, \"\", decimal(number(out.Version)+1), q.Reason); err != nil {\n\t\treturn out, err\n\t}\n\tout, err = restrictionLocked(ctx, tx, q.Actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n\n// Ban expiry uses the permanent stable row, exactly as send and manual unban.\nfunc (g *GovernanceService) ExpireRestrictions(ctx context.Context) error {\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(actor_id AS CHAR) FROM chat_restrictions WHERE permanent=0 AND blocked_until<=UTC_TIMESTAMP(6) ORDER BY actor_id LIMIT 50 FOR UPDATE`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,target_id,target_version,reason,created_at) SELECT 'system',0,REPEAT('0',64),'restriction.expire',actor_id,version+1,'限时禁聊到期',UTC_TIMESTAMP(6) FROM chat_restrictions WHERE actor_id=?`, string(id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/retention.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Minimal idempotency, authority versions, restriction rows and message tombstones\n// are not deleted by this worker. Their disaster-recovery window is independent.\ntype RetentionConfig struct {\n\tEnabled      bool `json:\"enabled\"`\n\tBodyDays     int  `json:\"body_days\"`\n\tEvidenceDays int  `json:\"evidence_days\"`\n\tChangeDays   int  `json:\"change_days\"`\n\tBatch        int  `json:\"batch\"`\n}\n\nfunc DefaultRetentionConfig() RetentionConfig { return RetentionConfig{false, 365, 30, 90, 20} }\nfunc (c RetentionConfig) Validate() error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif c.BodyDays < 90 || c.BodyDays > 3650 || c.EvidenceDays < 30 || c.EvidenceDays > c.BodyDays || c.ChangeDays < 1 || c.ChangeDays > 365 || c.Batch < 1 || c.Batch > 50 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\ntype Retention struct {\n\tdb          *sql.DB\n\tconfig      RetentionConfig\n\tenvironment string\n}\ntype RetentionResult struct {\n\tNext          ports.ID `json:\"next_after\"`\n\tConversations int      `json:\"conversations\"`\n\tMessages      int      `json:\"messages\"`\n\tChanges       int      `json:\"changes\"`\n}\n\nfunc NewRetention(db *sql.DB, environment string, c RetentionConfig) (*Retention, error) {\n\tif db == nil || c.Validate() != nil || !c.Enabled || (environment != \"test\" && environment != \"development\" && environment != \"production\") {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Retention{db, c, environment}, nil\n}\nfunc (r *Retention) Pass(ctx context.Context, after ports.ID) (RetentionResult, error) {\n\tctx, cancel := context.WithTimeout(ctx, 10*time.Second)\n\tdefer cancel()\n\tout := RetentionResult{Next: \"0\"}\n\tif err := expireGovernanceEvidence(ctx, r.db, r.environment); err != nil {\n\t\treturn out, err\n\t}\n\tif after != \"\" && after != \"0\" && !validID(after) {\n\t\treturn out, ports.ErrInvalid\n\t}\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\trows, err := r.db.QueryContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id>? ORDER BY id LIMIT ?`, string(after), r.config.Batch)\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tn, c, err := r.one(ctx, id)\n\t\tif err != nil {\n\t\t\treturn out, err\n\t\t}\n\t\tout.Conversations++\n\t\tout.Messages += n\n\t\tout.Changes += c\n\t\tout.Next = id\n\t}\n\tif len(ids) < r.config.Batch {\n\t\tout.Next = \"0\"\n\t}\n\treturn out, nil\n}\nfunc (r *Retention) one(ctx context.Context, id ports.ID) (int, int, error) {\n\tctx, cancel := context.WithTimeout(ctx, 3*time.Second)\n\tdefer cancel()\n\ttx, err := r.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar floor, change uint64\n\tif tx.QueryRowContext(ctx, `SELECT sync_floor_seq,last_change_seq FROM chat_conversations WHERE id=? FOR UPDATE`, string(id)).Scan(&floor, &change) != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\t// Existing live cases protect physical evidence while normal visibility\n // always follows per-message retention below.\n\tvar holds int\n\tif tx.QueryRowContext(ctx, `SELECT (SELECT COUNT(*) FROM chat_cases WHERE conversation_id=? AND retain_until>UTC_TIMESTAMP(6))+(SELECT COUNT(*) FROM chat_image_uploads WHERE conversation_id=? AND legal_hold=1)+(SELECT COUNT(*) FROM chat_av_uploads WHERE conversation_id=? AND legal_hold=1)`, string(id), string(id), string(id)).Scan(&holds) != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n n := 0\n // Evidence holds protect physical bytes, never ordinary visibility.\n rows,e:=tx.QueryContext(ctx,`SELECT CAST(id AS CHAR),seq FROM chat_messages WHERE conversation_id=? AND state='published' AND retention_mode='days' AND expires_at<=UTC_TIMESTAMP(6) ORDER BY expires_at,id LIMIT 50`,string(id))\n if e!=nil{return 0,0,ports.ErrUnavailable}\n type target struct{id ports.ID;seq uint64}\n targets:=[]target{}\n for rows.Next(){var v target;if rows.Scan(&v.id,&v.seq)!=nil{rows.Close();return 0,0,ports.ErrUnavailable};targets=append(targets,v)}\n e=rows.Err();rows.Close();if e!=nil{return 0,0,ports.ErrUnavailable}\n for _,v:=range targets{\n  if change==^uint64(0){return 0,0,ports.ErrUnavailable};change++\n  if _,e=tx.ExecContext(ctx,`UPDATE chat_messages SET text_body=IF(?=0,NULL,text_body),state='expired',state_version=state_version+1 WHERE id=?`,holds,string(v.id));e!=nil{return 0,0,ports.ErrUnavailable}\n  if _,e=tx.ExecContext(ctx,`INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT conversation_id,?,id,state_version,'message.expired',UTC_TIMESTAMP(6) FROM chat_messages WHERE id=?`,change,string(v.id));e!=nil{return 0,0,ports.ErrUnavailable}\n  if holds==0{\n   if e=purgeAVReference(ctx,tx,v.id);e!=nil{return 0,0,e}\n   if _,e=tx.ExecContext(ctx,`DELETE FROM chat_image_items WHERE message_id=?`,string(v.id));e!=nil{return 0,0,ports.ErrUnavailable}\n  }\n  n++\n }\n // Advance only a truly unavailable prefix. A permanent early message does\n // not prevent deletion of expired later videos and their references.\n var candidate uint64\n if tx.QueryRowContext(ctx,`SELECT COALESCE((SELECT MIN(seq)-1 FROM chat_messages WHERE conversation_id=? AND seq>? AND state<>'expired'),last_seq) FROM chat_conversations WHERE id=?`,string(id),floor,string(id)).Scan(&candidate)!=nil{return 0,0,ports.ErrUnavailable}\n if candidate>floor{floor=candidate}\n if holds==0{\n  rows,e=tx.QueryContext(ctx,`SELECT CAST(m.id AS CHAR) FROM chat_messages m WHERE m.conversation_id=? AND m.state IN ('recalled','blocked','expired') AND m.created_at<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_message_changes c WHERE c.message_id=m.id AND c.created_at>=TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6))) AND (m.text_body IS NOT NULL OR EXISTS(SELECT 1 FROM chat_image_items i WHERE i.message_id=m.id) OR EXISTS(SELECT 1 FROM chat_av_items i WHERE i.message_id=m.id)) ORDER BY m.seq LIMIT 50`,string(id),r.config.EvidenceDays,r.config.EvidenceDays)\n  if e!=nil{return 0,0,ports.ErrUnavailable}\n  evidence:=[]ports.ID{}\n  for rows.Next(){var mid ports.ID;if rows.Scan(&mid)!=nil{rows.Close();return 0,0,ports.ErrUnavailable};evidence=append(evidence,mid)}\n  e=rows.Err();rows.Close();if e!=nil{return 0,0,ports.ErrUnavailable}\n  for _,mid:=range evidence{\n   if e=purgeAVReference(ctx,tx,mid);e!=nil{return 0,0,e}\n   if _,e=tx.ExecContext(ctx,`UPDATE chat_messages SET text_body=NULL WHERE id=?`,string(mid));e!=nil{return 0,0,ports.ErrUnavailable}\n   if _,e=tx.ExecContext(ctx,`DELETE FROM chat_image_items WHERE message_id=?`,string(mid));e!=nil{return 0,0,ports.ErrUnavailable}\n  }\n }\n\t// Change retention always advances a contiguous prefix while holding the same\n\t// conversation lock as publish/recall. A cursor below the new floor must resync.\n\trows, err = tx.QueryContext(ctx, `SELECT change_seq,created_at<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) FROM chat_message_changes WHERE conversation_id=? ORDER BY change_seq LIMIT 100`, r.config.ChangeDays, string(id))\n\tif err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tchangeFloor := uint64(0)\n\tcount := 0\n\tfor rows.Next() {\n\t\tvar v uint64\n\t\tvar old bool\n\t\tif rows.Scan(&v, &old) != nil {\n\t\t\trows.Close()\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t\tif !old {\n\t\t\tbreak\n\t\t}\n\t\tchangeFloor = v\n\t\tcount++\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tif count > 0 {\n\t\tif _, err = tx.ExecContext(ctx, `DELETE FROM chat_message_changes WHERE conversation_id=? AND change_seq<=?`, string(id), changeFloor); err != nil {\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_conversations SET sync_floor_seq=GREATEST(sync_floor_seq,?),change_floor_seq=GREATEST(change_floor_seq,?),last_change_seq=? WHERE id=?`, floor, changeFloor, change, string(id)); err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\treturn n, count, nil\n}\n","chat/internal/message/retention_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"testing\"\n)\n\nfunc TestS22RetentionBounds(t *testing.T) {\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tif c.Validate() != nil {\n\t\tt.Fatal(\"default retention\")\n\t}\n\tfor _, bad := range []RetentionConfig{{true, 89, 30, 90, 20}, {true, 365, 29, 90, 20}, {true, 365, 30, 0, 20}, {true, 365, 30, 90, 51}} {\n\t\tif bad.Validate() == nil {\n\t\t\tt.Fatal(\"unsafe retention\", bad)\n\t\t}\n\t}\n}\nfunc TestMySQLS22RetentionFloorsEvidenceAndMinimalFacts(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 4)\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY,retention_mode='days',expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 DAY WHERE conversation_id=? AND seq<=2`, string(q.ConversationID))\n\tf.exec(`UPDATE chat_message_changes SET created_at=UTC_TIMESTAMP(6)-INTERVAL 100 DAY WHERE conversation_id=? AND change_seq<=2`, string(q.ConversationID))\n\tbefore := readPage(t, h, HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, err := NewRetention(f.goDB, \"test\", c)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, err := r.Pass(f.ctx, \"0\")\n\tif err != nil || result.Messages != 2 || result.Changes != 2 {\n\t\tt.Fatal(result, err)\n\t}\n\tif f.text(\"SELECT sync_floor_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"2\" || f.text(\"SELECT change_floor_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"2\" {\n\t\tt.Fatal(\"noncontiguous floors\")\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages WHERE seq<=2 AND text_body IS NOT NULL\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"4\" {\n\t\tt.Fatal(\"body or minimal fact loss\")\n\t}\n\tafter := readPage(t, h, HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif len(after.Messages) != 2 || after.Messages[0].Seq != \"3\" {\n\t\tt.Fatal(\"expired body visible\", after)\n\t}\n\tchanged, err := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: before.ChangeCursor}, \"changes\")\n\tif err != nil || len(changed.Changes) != 2 {\n\t\tt.Fatal(\"cache invalidation\", changed, err)\n\t}\n\tfor _, v := range changed.Changes {\n\t\tif v.Message.Text != nil || v.Type != \"message.expired\" {\n\t\t\tt.Fatal(\"expiration leaked\", v)\n\t\t}\n\t}\n\t// Current signed sync snapshot still resumes, but a signed old floor must resync.\n\told, err := h.parse(before.SyncCursor, \"sync\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\told.Position = \"0\"\n\tif _, err = h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: h.sign(old)}, \"sync\"); err != ErrResync {\n\t\tt.Fatal(\"old cursor did not resync\", err)\n\t}\n\t_ = s\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT last_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"4\" {\n\t\tt.Fatal(\"cleanup reset seq\")\n\t}\n}\nfunc TestMySQLS22LegalCaseProtectsBodyAndReleasedEvidenceExpires(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tout := accepted(t, s, q)\n\tg, _ := governanceFixture(t, f, s, nil)\n\t_, err := g.Report(f.ctx, principal(\"10203\"), q.ConversationID, out.MessageID, \"\", \"证据保留验证\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY,retention_mode='days',expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 DAY WHERE id=?`, string(out.MessageID))\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT sync_floor_seq FROM chat_conversations WHERE id=?\",string(q.ConversationID))!=\"1\"||f.text(\"SELECT text_body IS NOT NULL FROM chat_messages WHERE id=?\",string(out.MessageID))!=\"1\"{\n  t.Fatal(\"case must protect evidence without extending ordinary visibility\")\n }\n\tf.exec(`UPDATE chat_cases SET retain_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND`)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(out.MessageID)) != \"expired\" {\n\t\tt.Fatal(\"expired hold retained body\")\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_send_intents WHERE message_id=?\", string(out.MessageID)) != \"1\" {\n\t\tt.Fatal(\"minimum idempotency fact deleted\")\n\t}\n}\nfunc TestMySQLS22RecalledEvidenceExpiresWithoutRevivingOrSending(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tout := accepted(t, s, q)\n\tif _, err := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, out.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 40 DAY,recalled_at=UTC_TIMESTAMP(6)-INTERVAL 35 DAY WHERE id=?`, string(out.MessageID))\n\tf.exec(`UPDATE chat_message_changes SET created_at=UTC_TIMESTAMP(6)-INTERVAL 35 DAY WHERE message_id=?`, string(out.MessageID))\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err := r.Pass(context.Background(), \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(out.MessageID)) != \"recalled\" || f.text(\"SELECT COUNT(*) FROM chat_messages WHERE text_body IS NOT NULL\") != \"0\" {\n\t\tt.Fatal(\"evidence body retained\")\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_events\") != \"1\" {\n\t\tt.Fatal(\"cleanup re-enqueued reminder\")\n\t}\n}\n\ntype retryDeleteStorage struct {\n\t*imageMemory\n\tfail bool\n}\n\nfunc (s *retryDeleteStorage) Delete(ctx context.Context, key string) error {\n\tif s.fail {\n\t\treturn ErrMedia\n\t}\n\treturn s.imageMemory.Delete(ctx, key)\n}\nfunc TestMySQLS22SharedMediaSurvivesFirstExpiryAndDeletionRetries(t *testing.T) {\n\tf, s, m, storage, q := mediaFixture(t)\n\tq.Items = []MediaItem{mediaAdd(t, m, storage, q.ConversationID, 301, \"shared-construction\")}\n\tmediaProcess(t, m, 1)\n\tif _, err := s.Send(f.ctx, principal(\"10202\"), q); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tm.Advance(f.ctx)\n\tmediaApprove(t, m)\n\tfirst, err := s.Query(f.ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tq.ClientMessageID = client(223)\n\tif _, err = s.Send(f.ctx, principal(\"10202\"), q); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tm.Advance(f.ctx)\n\tmediaApprove(t, m)\n\tsecond, err := s.Query(f.ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmain := f.text(\"SELECT main_key FROM chat_image_uploads WHERE id=?\", string(q.Items[0].AttachmentID))\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY,retention_mode='days',expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 DAY WHERE id=?`, string(first.MessageID))\n\tf.exec(`UPDATE chat_image_uploads SET expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 DAY`)\n\tf.exec(`UPDATE chat_image_objects SET created_at=UTC_TIMESTAMP(6)-INTERVAL 2 DAY`)\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err = m.CleanOne(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstorage.mu.Lock()\n\t_, kept := storage.objects[main]\n\tstorage.mu.Unlock()\n\tif !kept || f.text(\"SELECT COUNT(*) FROM chat_image_items\") != \"1\" {\n\t\tt.Fatal(\"shared delivery object deleted\")\n\t}\n\tif _, err = m.URL(f.ctx, principal(\"10202\"), q.ConversationID, second.MessageID, q.Items[0].AttachmentID, false); err != nil {\n\t\tt.Fatal(\"remaining reference denied\", err)\n\t}\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY,retention_mode='days',expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 DAY WHERE id=?`, string(second.MessageID))\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = m.URL(f.ctx, principal(\"10202\"), q.ConversationID, second.MessageID, q.Items[0].AttachmentID, false); err == nil {\n\t\tt.Fatal(\"expired media still signed\")\n\t}\n\tfailed := &retryDeleteStorage{storage, true}\n\tm.storage = failed\n\tif err = m.CleanOne(f.ctx); err != ErrMedia || f.text(\"SELECT COUNT(*) FROM chat_image_objects\") != \"2\" {\n\t\tt.Fatal(\"failed deletion discarded ledger\", err)\n\t}\n\tfailed.fail = false\n\tfor i := 0; i < 3; i++ {\n\t\tif err = m.CleanOne(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_image_objects\") != \"0\" {\n\t\tt.Fatal(\"orphan objects not retried\")\n\t}\n}\nfunc TestMySQLS22DueRiskRevisitedAfterReviewAlreadyExpired(t *testing.T) {\n\tsafety := safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: \"s22-fixture\", Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: \"fixture_risk\", Level: 2, Confirmed: true}}, nil\n\t})\n\tf, s, q := setupMessage(t, safety)\n\tout, err := s.Send(f.ctx, principal(\"10202\"), q)\n\tif err != nil || out.RiskEventID == \"\" {\n\t\tt.Fatal(out, err)\n\t}\n\tf.exec(`UPDATE chat_cases SET retain_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND`)\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_cases WHERE state='expired' AND reason=''\") != \"1\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE text_evidence<>''\") != \"1\" {\n\t\tt.Fatal(\"separate case/risk TTL\")\n\t}\n\tf.exec(`UPDATE chat_risk_events SET retain_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND`)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE text_evidence<>'' OR context_evidence<>''\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE confirmed=1\") != \"1\" {\n\t\tt.Fatal(\"expired review stranded evidence or lost minimal count\")\n\t}\n}\n\nfunc TestMySQLStoragePermanentMessagesDoNotExpireWithLaterFiniteMessages(t *testing.T){\n f,_,h,q:=historyFixture(t,4)\n f.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 800 DAY WHERE conversation_id=?`,string(q.ConversationID))\n f.exec(`UPDATE chat_messages SET retention_mode='days',expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND WHERE conversation_id=? AND seq=2`,string(q.ConversationID))\n before:=readPage(t,h,HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\")\n if len(before.Messages)!=4||before.Messages[1].State!=\"expired\"||before.Messages[1].Text!=nil||before.Messages[0].Text==nil{t.Fatal(\"expiry projection before cleanup\",before)}\n c:=DefaultRetentionConfig();c.Enabled=true;r,e:=NewRetention(f.goDB,\"test\",c);if e!=nil{t.Fatal(e)}\n result,e:=r.Pass(f.ctx,\"0\");if e!=nil||result.Messages!=1{t.Fatal(result,e)}\n if f.text(\"SELECT sync_floor_seq FROM chat_conversations WHERE id=?\",string(q.ConversationID))!=\"0\"{t.Fatal(\"floor crossed permanent message\")}\n if f.text(\"SELECT COUNT(*) FROM chat_messages WHERE retention_mode='permanent' AND text_body IS NOT NULL\")!=\"3\"{t.Fatal(\"permanent body deleted\")}\n after:=readPage(t,h,HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\")\n if len(after.Messages)!=4||after.Messages[0].RetentionMode!=\"permanent\"||after.Messages[0].ExpiresAt!=nil{t.Fatal(after)}\n}\n","chat/internal/message/risk.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Optional real-safety finalizer: after PHP authority/current login, before\n// stable account restriction/conversation locks. It must never do network I/O.\ntype finalSafety interface {\n\tValidateTextLocked(context.Context, *sql.Tx, ports.Principal, ports.SafetyResult) error\n}\n\nvar riskCodePattern = regexp.MustCompile(`^[a-z][a-z0-9_]{1,47}$`)\nvar riskTracePattern = regexp.MustCompile(`^[A-Za-z0-9_-]{0,128}$`)\n\nfunc terminal(state string) bool {\n\treturn state == \"accepted\" || state == \"rejected\" || state == \"review_pending\"\n}\nfunc validFinding(r ports.SafetyResult) bool {\n\tf := r.Finding\n\treturn f != nil && (f.Provider == \"local.anti_diversion\" || f.Provider == \"wechat.msg_sec_check.v2\" || f.Provider == \"wechat.media_check_async.v2\") && riskCodePattern.MatchString(f.Code) && riskTracePattern.MatchString(f.TraceID) && len(f.ContextEvidence) <= 40<<10 && (f.ContextEvidence == \"\" || json.Valid([]byte(f.ContextEvidence))) &&\n\t\t((r.Decision == \"blocked\" && f.Level == 2 && f.Confirmed) || (r.Decision == \"review\" && f.Level == 1 && !f.Confirmed))\n}\n\n// Risk evidence and the author's terminal result commit atomically. A late\n// inspector/expired owner cannot create risk, increment counts or publish.\nfunc (s *Service) reject(ctx context.Context, p ports.Principal, r Request, fp string, id ports.ID, owner string, checked ports.SafetyResult) (Result, error) {\n\tif !validFinding(checked) || !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, ErrCheck\n\t}\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\t// Rejections also use the canonical authority -> identity -> restriction ->\n\t// conversation -> intent order. An inspection completed after revocation\n\t// must not create a confirmed violation under the old authority.\n\tif _, e = s.authorize(ctx, tx, p, r.ConversationID, checked); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar intent string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_send_intents WHERE id=? AND sender_id=? AND conversation_id=? AND fingerprint=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(id), string(p.ActorID), string(r.ConversationID), fp, owner).Scan(&intent)\n\tif e == sql.ErrNoRows {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tf := checked.Finding\n\tstate, code := \"rejected\", ErrBlocked.Error()\n\tif checked.Decision == \"review\" {\n\t\tstate, code = \"review_pending\", \"CHAT_REVIEW_PENDING\"\n\t}\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_risk_events(intent_id,sender_id,conversation_id,content_fingerprint,rule_version,provider,reason_code,provider_trace,risk_level,confirmed,disposition,review_state,text_evidence,context_evidence,retain_until,created_at)\n SELECT id,sender_id,conversation_id,fingerprint,?,?,?,?,?,?,?,'open',?,?,retain_until,UTC_TIMESTAMP(6) FROM chat_send_intents WHERE id=?`, checked.RuleVersion, f.Provider, f.Code, f.TraceID, f.Level, f.Confirmed, state, r.Text, f.ContextEvidence, intent)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tn, e := res.LastInsertId()\n\tif e != nil || n <= 0 {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\trisk := ports.ID(strconv.FormatInt(n, 10))\n\tif _, e = createCase(ctx, tx, \"review\", \"risk\", risk, \"0\", r.ConversationID, p.ActorID, p.ActorID, \"1\", fp, \"内容安全待复核\"); e != nil {\n\t\treturn Result{}, e\n\t}\n\tres, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=?,risk_event_id=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, state, code, string(risk), intent, owner)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tchanged, e := res.RowsAffected()\n\tif e != nil || changed != 1 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, ErrCheck\n\t}\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\treturn Result{ClientMessageID: r.ClientMessageID, State: state, Code: code, RiskEventID: risk}, nil\n}\n","chat/internal/message/s09_completion_integration_test.go":"package message\n\nimport (\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestMySQLS09LargeUnreadCapAndRealFirstAnchor(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 100000)\n\tf.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=?`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET sender_id=10202 WHERE conversation_id=? AND seq<=10`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=20`, string(r.ConversationID))\n\tu, e := h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 1000 || !u.CountCapped || u.FirstSeq != \"11\" {\n\t\tt.Fatalf(\"bounded unread %+v %v\", u, e)\n\t}\n\tlocated := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID, TargetID: u.FirstMessage}, \"locate\")\n\tif len(located.Messages) > 30 {\n\t\tt.Fatal(\"anchor expanded history\")\n\t}\n\tif f.text(`SELECT COUNT(*) FROM chat_member_reads`) != \"0\" {\n\t\tt.Fatal(\"unread/anchor wrote read receipt\")\n\t}\n\tboot := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID}, \"bootstrap\")\n\tproof, e := h.parse(boot.SyncCursor, \"sync\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tproof.Seq = \"99000\"\n\tproof.Position = \"99000\"\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, h.sign(proof)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tu, e = h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 1000 || u.CountCapped || u.FirstSeq != \"99001\" {\n\t\tt.Fatalf(\"exact count at cap %+v %v\", u, e)\n\t}\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, boot.SyncCursor); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tu, e = h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 0 || u.CountCapped || u.ReadSeq != \"100000\" {\n\t\tt.Fatal(u, e)\n\t}\n}\n\nfunc TestMySQLS09UnreadHistoryGapAndRetainedAcknowledgement(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 6)\n\tf.php(\"close\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tf.php(\"repair\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tf.exec(`DELETE FROM chat_member_intervals WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version,end_version) SELECT conversation_id,actor_id,member_key,1,2 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version) SELECT conversation_id,actor_id,member_key,3 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET sender_id=10203,policy_version=CASE WHEN seq IN(2,5) THEN 2 WHEN seq IN(4,6) THEN 3 ELSE 1 END WHERE conversation_id=?`, string(r.ConversationID))\n\tu, e := h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 4 || u.FirstSeq != \"1\" {\n\t\tt.Fatal(\"gap counted\", u, e)\n\t}\n\tboot := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID}, \"bootstrap\")\n\tproof, _ := h.parse(boot.SyncCursor, \"sync\")\n\tproof.Pending = true\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, h.sign(proof)); e != ErrResync {\n\t\tt.Fatal(\"unfinished sync acknowledged\", e)\n\t}\n\tproof.Pending = false\n\tproof.Seq = \"1\"\n\tproof.Position = \"1\"\n\tf.exec(`UPDATE chat_conversations SET sync_floor_seq=2 WHERE id=?`, string(r.ConversationID))\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, h.sign(proof)); e != ErrResync {\n\t\tt.Fatal(\"obsolete retained proof acknowledged\", e)\n\t}\n\tif f.text(`SELECT COUNT(*) FROM chat_member_reads`) != \"0\" {\n\t\tt.Fatal(\"invalid proof wrote read state\")\n\t}\n}\n\nfunc TestMySQLS09SlowBodyStopsWithinReadBudget(t *testing.T) {\n\t_, _, h, _ := historyFixture(t, 0)\n\th.timeout = 100 * time.Millisecond\n\thandler, e := NewHistoryHandler(h, historyFixtureIdentity{}, 2)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tserver := httptest.NewServer(handler)\n\tdefer server.Close()\n\treader, writer := io.Pipe()\n\tdefer reader.Close()\n\tdefer writer.Close()\n\trequest, _ := http.NewRequest(\"POST\", server.URL+\"/chat/api/v1/conversations/unread\", reader)\n\trequest.Header.Set(\"Authorization\", \"Bearer fixture-only\")\n\trequest.Header.Set(\"Content-Type\", \"application/json\")\n\tclient := server.Client()\n\tclient.Timeout = 2 * time.Second\n\tstart := time.Now()\n\tresponse, e := client.Do(request)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer response.Body.Close()\n\tif response.StatusCode != 408 || time.Since(start) > time.Second {\n\t\tt.Fatal(\"slow body exceeded budget\", response.StatusCode, time.Since(start))\n\t}\n}\n\nfunc TestMySQLS12DigestActivityUsesVisibleMessageTime(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 3)\n\tf.exec(`UPDATE chat_messages SET created_at=CASE seq WHEN 1 THEN '2026-10-01 10:00:00' WHEN 2 THEN '2026-10-01 11:00:00' ELSE '2026-10-01 12:00:00' END WHERE conversation_id=?`, string(r.ConversationID))\n\tu, e := h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.LastMessageAt == nil || u.LastMessageAt.Format(time.RFC3339) != \"2026-10-01T12:00:00Z\" || u.Count != 0 {\n\t\tt.Fatal(\"own/read messages still determine activity\", u, e)\n\t}\n\tif u.LastMessage==nil||u.LastMessage.Text==nil||*u.LastMessage.Text!=\"fixture-3\"||u.OrderContext==nil||u.OrderContext.PublicNo!=\"CHAT-PLATFORM-401\"||u.MemberRole!=\"worker\" {t.Fatal(\"untrusted or missing preview/context\",u)}\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n if boot.OrderContext==nil||boot.ViewerID!=\"10202\"||boot.MemberRole!=\"worker\"{t.Fatal(\"missing native page context\",boot)}\n f.exec(`UPDATE chat_messages SET state='recalled',text_body='must-not-leak' WHERE conversation_id=? AND seq=3`, string(r.ConversationID))\n\tpage, e := h.Digests(f.ctx, principal(\"10202\"), \"0\", 20)\n\tif e != nil || len(page.Items) != 1 || page.Items[0].Unread.LastMessageAt == nil || !page.Items[0].Unread.LastMessageAt.Equal(*u.LastMessageAt) {\n\t\tt.Fatal(\"digest exposes recall activity without a body\", page, e)\n\t}\n\tif page.Items[0].Unread.LastMessage==nil||page.Items[0].Unread.LastMessage.Text!=nil||page.Items[0].Unread.LastMessage.State!=\"recalled\"{t.Fatal(\"recall original leaked in preview\",page)}\n // A message outside every authorized membership interval cannot affect sorting.\n\tf.exec(`UPDATE chat_member_intervals SET end_version=1 WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tu, e = h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.LastMessageAt != nil || u.LastMessage != nil {\n\t\tt.Fatal(\"hidden activity leaked\", u, e)\n\t}\n\tif f.text(`SELECT COUNT(*) FROM chat_member_reads`) != \"0\" {\n\t\tt.Fatal(\"inbox ordering wrote a read receipt\")\n\t}\n}\n","chat/internal/message/s09_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype s09Request struct {\n\tConversationID ports.ID `json:\"conversation_id,omitempty\"`\n\tCursor         string   `json:\"cursor,omitempty\"`\n\tLimit          int      `json:\"limit,omitempty\"`\n}\n\nfunc decodeS09(raw []byte) (s09Request, error) {\n\tvar q s09Request\n\tif !utf8.Valid(raw) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\tt, e := d.Token()\n\tif e != nil || t != json.Delim('{') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tv, e := d.Token()\n\t\tkey, ok := v.(string)\n\t\tif e != nil || !ok || seen[key] {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tseen[key] = true\n\t\tvar field json.RawMessage\n\t\tif d.Decode(&field) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tswitch key {\n\t\tcase \"conversation_id\":\n\t\t\tif json.Unmarshal(field, &q.ConversationID) != nil {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\tcase \"cursor\":\n\t\t\tif len(field) < 2 || field[0] != '\"' || !validSurrogates(field) || json.Unmarshal(field, &q.Cursor) != nil || len(q.Cursor) > 2048 {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\tcase \"limit\":\n\t\t\tif len(field) == 0 || field[0] < '0' || field[0] > '9' || json.Unmarshal(field, &q.Limit) != nil {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\tdefault:\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\tt, e = d.Token()\n\tif e != nil || t != json.Delim('}') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif _, e = d.Token(); e != io.EOF {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\n\nfunc (h *HistoryHandler) serveS09(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tvar nonce [16]byte\n\t_, _ = rand.Read(nonce[:])\n\trequestID := hex.EncodeToString(nonce[:])\n\tw.Header().Set(\"X-Request-ID\", requestID)\n\tfail := func(status int, code string, retry bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": requestID, \"code\": code, \"retryable\": retry, \"server_time\": time.Now().UTC()})\n\t\t}\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tmedia, _, e := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif e != nil || media != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error(), true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\treturn\n\t}\n\t// Public HTTP WriteTimeout is 5s; terminate bounded digest scans first.\n\tctx, cancel := context.WithTimeout(r.Context(), min(3*h.service.timeout, 4*time.Second))\n\tdefer cancel()\n\tcontroller := http.NewResponseController(w)\n\t_ = controller.SetReadDeadline(time.Now().Add(min(3*h.service.timeout, 4*time.Second)))\n\tb, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 4096))\n\tif e != nil {\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar large *http.MaxBytesError\n\t\tif errors.As(e, &large) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = controller.SetReadDeadline(time.Time{})\n\tvar q s09Request\n var preference PreferenceRequest\n var decodeErr error\n isPreference:=r.URL.Path==\"/chat/api/v1/conversations/preferences\"||r.URL.Path==\"/chat/api/v1/conversations/preference\"\n if isPreference { preference,decodeErr=decodePreference(b,r.URL.Path==\"/chat/api/v1/conversations/preference\") } else {q,decodeErr=decodeS09(b)}\n\tif decodeErr != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tp, e := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif e != nil {\n\t\tif errors.Is(e, auth.ErrUnauthorized) {\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\t} else {\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\tvar out any\n\tswitch r.URL.Path {\n case \"/chat/api/v1/conversations/preferences\":\n  out,e=h.service.Preferences(ctx,p,preference.ConversationID)\n case \"/chat/api/v1/conversations/preference\":\n  out,e=h.service.SetPreference(ctx,p,preference)\n\tcase \"/chat/api/v1/conversations/unread\":\n\t\tif !validID(q.ConversationID) || q.Cursor != \"\" || q.Limit != 0 {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\t\treturn\n\t\t}\n\t\tout, e = h.service.Unread(ctx, p, q.ConversationID)\n\tcase \"/chat/api/v1/conversations/read\":\n\t\tif !validID(q.ConversationID) || q.Cursor == \"\" || q.Limit != 0 {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\t\treturn\n\t\t}\n\t\tout, e = h.service.Acknowledge(ctx, p, q.ConversationID, q.Cursor)\n\tcase \"/chat/api/v1/conversations/digests\":\n\t\tif q.ConversationID != \"\" || q.Limit < 1 || q.Limit > 20 {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\t\treturn\n\t\t}\n\t\tout, e = h.service.DigestsCursor(ctx, p, q.Cursor, q.Limit)\n\tdefault:\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", false)\n\t\treturn\n\t}\n\tif e != nil {\n\t\tswitch {\n\t\tcase errors.Is(e, ports.ErrInvalid):\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\tcase errors.Is(e, ErrPreferenceConflict),errors.Is(e,ErrPinLimit):\n   w.WriteHeader(409)\n   _=json.NewEncoder(w).Encode(map[string]any{\"request_id\":requestID,\"code\":e.Error(),\"retryable\":false,\"current\":out,\"server_time\":time.Now().UTC()})\n  case errors.Is(e, ErrResync):\n\t\t\tfail(409, ErrResync.Error(), false)\n\t\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\t\tfail(403, \"CHAT_PERMISSION_DENIED\", false)\n\t\tdefault:\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": requestID, \"code\": \"OK\", \"data\": out, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/s09_http_integration_test.go":"package message\n\nimport (\n \"encoding/json\"\n \"io\"\n \"net/http\"\n \"net/http/httptest\"\n \"strings\"\n \"testing\"\n)\n\nfunc TestMySQLS09HTTPAuthorizationAndRead(t *testing.T){\n f,_,h,r:=historyFixture(t,8)\n f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq IN(2,6)`,string(r.ConversationID))\n handler,e:=NewHistoryHandler(h,historyFixtureIdentity{},4);if e!=nil{t.Fatal(e)}\n server:=httptest.NewServer(handler);defer server.Close()\n call:=func(path,body,credential string,status int) []byte {\n  t.Helper()\n  req,e:=http.NewRequest(\"POST\",server.URL+path,strings.NewReader(body));if e!=nil{t.Fatal(e)}\n  req.Header.Set(\"Content-Type\",\"application/json\")\n  if credential!=\"\"{req.Header.Set(\"Authorization\",\"Bearer \"+credential)}\n  response,e:=server.Client().Do(req);if e!=nil{t.Fatal(e)};defer response.Body.Close()\n  raw,_:=io.ReadAll(response.Body)\n  if response.StatusCode!=status{t.Fatalf(\"%s: got %d want %d: %s\",path,response.StatusCode,status,raw)}\n  if response.Header.Get(\"Cache-Control\")!=\"no-store\"||response.Header.Get(\"X-Request-ID\")==\"\"{t.Fatal(\"missing safe headers\")}\n  return raw\n }\n base:=`{\"conversation_id\":\"`+string(r.ConversationID)+`\"}`\n call(\"/chat/api/v1/conversations/unread\",base,\"\",401)\n call(\"/chat/api/v1/conversations/unread\",base,\"bad\",401)\n call(\"/chat/api/v1/conversations/unread\",`{\"conversation_id\":\"1\",\"conversation_id\":\"2\"}`,\"fixture-only\",400)\n data:=call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",200)\n var unread struct{Data UnreadWindow `json:\"data\"`}\n if json.Unmarshal(data,&unread)!=nil||unread.Data.Count!=2||unread.Data.FirstSeq!=\"2\"{t.Fatal(\"unread\",string(data))}\n call(\"/chat/api/v1/conversations/read\",`{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"forged\"}`,\"fixture-only\",409)\n signed:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\").SyncCursor\n call(\"/chat/api/v1/conversations/read\",`{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"`+signed+`\"}`,\"fixture-only\",200)\n data=call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",200)\n if json.Unmarshal(data,&unread)!=nil||unread.Data.Count!=0||unread.Data.ReadSeq!=\"8\"{t.Fatal(\"not acknowledged\",string(data))}\n data=call(\"/chat/api/v1/conversations/digests\",`{\"limit\":20}`,\"fixture-only\",200)\n var dig struct{Data DigestPage `json:\"data\"`}\n if json.Unmarshal(data,&dig)!=nil||len(dig.Data.Items)==0{t.Fatal(\"digest\",string(data))}\n call(\"/chat/api/v1/conversations/digests\",`{\"limit\":20,\"cursor\":\"bad\"}`,\"fixture-only\",409)\n data=call(\"/chat/api/v1/conversations/preferences\",base,\"fixture-only\",200)\n var pref struct{Data Preferences `json:\"data\"`};if json.Unmarshal(data,&pref)!=nil||pref.Data.Later{t.Fatal(\"default preference\",string(data))}\n update:=`{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"member_version\":\"`+pref.Data.MemberVersion+`\",\"field\":\"later\",\"value\":true,\"expected_version\":\"0\"}`\n call(\"/chat/api/v1/conversations/preference\",update,\"fixture-only\",200)\n call(\"/chat/api/v1/conversations/preference\",update,\"fixture-only\",200)\n call(\"/chat/api/v1/conversations/preference\",strings.Replace(update,`\"value\":true`,`\"value\":false`,1),\"fixture-only\",409)\n call(\"/chat/api/v1/conversations/preferences\",`{\"conversation_id\":\"1\",\"hidden\":true}`,\"fixture-only\",400)\n data=call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",200)\n if json.Unmarshal(data,&unread)!=nil||unread.Data.Count!=0||!unread.Data.Preferences.Later{t.Fatal(\"preference/read isolation\",string(data))}\n f.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",403)\n}\n","chat/internal/message/s09_integration_test.go":"package message\n\nimport (\n \"context\"\n \"testing\"\n\n \"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestMySQLS09ReadProgressAndUnread(t *testing.T){\n f,_,h,r:=historyFixture(t,6)\n // Fixture actor authored all rows; incoming sender is a different actor.\n f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq IN(2,3,5)`,string(r.ConversationID))\n p:=principal(\"10202\")\n initial,e:=h.Unread(f.ctx,p,r.ConversationID)\n if e!=nil||initial.Count!=3||initial.FirstSeq!=\"2\"||initial.ReadSeq!=\"0\"{t.Fatalf(\"initial %+v %v\",initial,e)}\n if f.text(`SELECT COUNT(*) FROM chat_member_reads WHERE conversation_id=?`,string(r.ConversationID))!=\"0\"{t.Fatal(\"read-only unread query mutated state\")}\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n future,err:=h.parse(boot.SyncCursor,\"sync\")\n if err!=nil{t.Fatal(err)}\n future.Seq=\"7\";future.Position=\"7\"\n if _,e=h.Acknowledge(f.ctx,p,r.ConversationID,h.sign(future));e!=ErrResync{t.Fatal(\"future advanced\",e)}\n if _,e=h.Acknowledge(f.ctx,principal(\"10201\"),r.ConversationID,boot.SyncCursor);e==nil{t.Fatal(\"outsider acknowledged\")}\n if _,e=h.Acknowledge(f.ctx,p,r.ConversationID,\"invalid\");e!=ErrResync{t.Fatal(\"unsigned acknowledgement\",e)}\n if got,e:=h.Acknowledge(f.ctx,p,r.ConversationID,boot.SyncCursor);e!=nil||got!=\"6\"{t.Fatal(\"ack\",got,e)}\n if got,e:=h.Acknowledge(f.ctx,p,r.ConversationID,boot.SyncCursor);e!=nil||got!=\"6\"{t.Fatal(\"ack duplicate\",got,e)}\n if f.text(`SELECT COUNT(*) FROM chat_member_reads WHERE conversation_id=?`,string(r.ConversationID))!=\"1\"{t.Fatal(\"ack idempotence created extra read rows\")}\n older,err:=h.parse(boot.SyncCursor,\"sync\")\n if err!=nil{t.Fatal(err)}\n older.Seq=\"2\";older.Position=\"2\"\n if got,e:=h.Acknowledge(f.ctx,p,r.ConversationID,h.sign(older));e!=nil||got!=\"6\"{t.Fatal(\"watermark decreased\",got,e)}\n now,e:=h.Unread(f.ctx,p,r.ConversationID)\n if e!=nil||now.Count!=0||now.ReadSeq!=\"6\"{t.Fatal(\"post-ack\",now,e)}\n if _,e=h.Acknowledge(context.Background(),principal(\"10203\"),r.ConversationID,boot.SyncCursor);e==nil{t.Fatal(\"cross identity cursor accepted\")}\n // Changing the membership generation resets persisted progress.\n f.exec(`UPDATE chat_members SET member_key=CONCAT(member_key,'-new') WHERE conversation_id=? AND actor_id=10202`,string(r.ConversationID))\n if _,e=h.Unread(f.ctx,p,r.ConversationID);e==nil{t.Fatal(\"stale authority member accepted\")}\n}\n\nfunc TestMySQLS09DigestPageAndIsolation(t *testing.T){\n f,_,h,r:=historyFixture(t,3)\n p:=principal(\"10202\")\n out,e:=h.Digests(f.ctx,p,\"0\",10)\n if e!=nil||len(out.Items)!=1||out.Items[0].ConversationID!=r.ConversationID||out.HasMore{t.Fatal(out,e)}\n if _,e=h.Digests(f.ctx,p,\"0\",21);e!=ports.ErrInvalid{t.Fatal(\"limit\",e)}\n if _,e=h.Digests(f.ctx,principal(\"10201\"),\"0\",10);e!=nil{t.Fatal(\"outsider index unavailable\",e)}\n}\n\nfunc TestMySQLS09MembershipGenerationInvalidatesRead(t *testing.T){\n f,_,h,r:=historyFixture(t,6)\n actor:=principal(\"10202\")\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n if n,e:=h.Acknowledge(f.ctx,actor,r.ConversationID,boot.SyncCursor);e!=nil||n!=\"6\"{t.Fatal(n,e)}\n f.php(\"close\")\n if _,e:=f.store.Poll(f.ctx,100);e!=nil{t.Fatal(e)}\n f.php(\"repair\")\n if _,e:=f.store.Poll(f.ctx,100);e!=nil{t.Fatal(e)}\n if _,e:=h.Acknowledge(f.ctx,actor,r.ConversationID,boot.SyncCursor);e!=ErrResync{t.Fatal(\"prior authority generation accepted\",e)}\n u,e:=h.Unread(f.ctx,actor,r.ConversationID)\n if e!=nil||u.ReadSeq!=\"0\"{t.Fatal(\"stale membership watermark reused\",u,e)}\n}\n\nfunc TestMySQLS09ConcurrentReadHighWatermarkAndLaterMessage(t *testing.T) {\n f,s,h,r:=historyFixture(t,6)\n actor:=principal(\"10202\")\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n old,err:=h.parse(boot.SyncCursor,\"sync\")\n if err!=nil{t.Fatal(err)}\n old.Seq=\"2\";old.Position=\"2\"\n tokens:=[]string{h.sign(old),boot.SyncCursor}\n results:=make(chan error,len(tokens))\n for _,token:=range tokens{\n  tok:=token\n  go func(){_,e:=h.Acknowledge(f.ctx,actor,r.ConversationID,tok);results<-e}()\n }\n for range tokens{\n  if e:=<-results;e!=nil{t.Fatal(\"concurrent ack\",e)}\n }\n u,e:=h.Unread(f.ctx,actor,r.ConversationID)\n if e!=nil||u.ReadSeq!=\"6\"{t.Fatal(\"regressed waterline\",u,e)}\n // A message committed after the signed cursor must not be marked read.\n r.ClientMessageID=client(991)\n msg:=accepted(t,s,r)\n if msg.Seq!=\"7\"{t.Fatal(\"expected next committed sequence\",msg)}\n f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq=7`,string(r.ConversationID))\n u,e=h.Unread(f.ctx,actor,r.ConversationID)\n if e!=nil||u.ReadSeq!=\"6\"||u.Count!=1||u.FirstSeq!=\"7\"{\n  t.Fatal(\"post-ack message lost\",u,e)\n }\n}\n\nfunc TestMySQLS09AccountPaginationExcludesLaterConversations(t *testing.T) {\n f,_,h,_:=historyFixture(t,0)\n f.php(\"sync\",\"402\")\n if outcome,e:=f.store.Poll(f.ctx,100);e!=nil||outcome.Applied!=1{t.Fatal(\"second projection\",outcome,e)}\n actor:=principal(\"10202\")\n first,e:=h.DigestsCursor(f.ctx,actor,\"\",1)\n if e!=nil||len(first.Items)!=1||!first.HasMore||first.NextCursor==\"\"{t.Fatal(\"first\",first,e)}\n // A new conversation after the snapshot is not inserted into its later pages.\n f.php(\"sync\",\"403\")\n if outcome,e:=f.store.Poll(f.ctx,100);e!=nil||outcome.Applied!=1{t.Fatal(\"third projection\",outcome,e)}\n second,e:=h.DigestsCursor(f.ctx,actor,first.NextCursor,1)\n if e!=nil||len(second.Items)!=1||second.HasMore||second.NextCursor!=\"\"{t.Fatal(\"later candidate drift\",second,e)}\n if first.Items[0].ConversationID==second.Items[0].ConversationID{t.Fatal(\"duplicate candidate\")}\n fresh,e:=h.DigestsCursor(f.ctx,actor,\"\",20)\n if e!=nil||len(fresh.Items)!=3{t.Fatal(\"new snapshot lost new conversation\",fresh,e)}\n}\n\nfunc TestMySQLS09RevokedAccountDigestFailsClosed(t *testing.T) {\n f,_,h,_:=historyFixture(t,1)\n p:=principal(\"10202\")\n if out,e:=h.DigestsCursor(f.ctx,p,\"\",10);e!=nil||len(out.Items)!=1 {\n  t.Fatalf(\"pre-revocation digest: %+v %v\",out,e)\n }\n f.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n if out,e:=h.DigestsCursor(f.ctx,p,\"\",10);e==nil||len(out.Items)!=0 {\n  t.Fatalf(\"revoked login returned partial or empty success: %+v %v\",out,e)\n }\n}\n\nfunc TestMySQLS09EmptyDigestStillRechecksLogin(t *testing.T) {\n f,_,h,_:=historyFixture(t,0)\n p:=principal(\"10201\") // No projected membership in the initial unbound order.\n before,e:=h.DigestsCursor(f.ctx,p,\"\",10)\n if e!=nil||len(before.Items)!=0{t.Fatalf(\"valid empty account: %+v %v\",before,e)}\n f.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10201`)\n after,e:=h.DigestsCursor(f.ctx,p,\"\",10)\n if e==nil||len(after.Items)!=0{t.Fatalf(\"revoked empty account falsely succeeded: %+v %v\",after,e)}\n}\n\nfunc TestMySQLS14FullAccountAttentionBeyondClientWindow(t *testing.T){\n f,_,h,r:=historyFixture(t,3)\n f.php(\"attention-seed\")\n for {batch,e:=f.store.Poll(f.ctx,100);if e!=nil{t.Fatal(e)};if batch.Applied<100{break}}\n f.exec(`INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) SELECT conversation_id,actor_id,SHA2(member_key,256),0,0,1,1,UTC_TIMESTAMP(6) FROM chat_members WHERE actor_id=10202`)\n f.exec(\"UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=?\",string(r.ConversationID))\n cursor:=\"\";pages:=0\n for{\n  page,e:=h.DigestsCursor(f.ctx,principal(\"10202\"),cursor,20);if e!=nil{t.Fatal(e)};pages++\n  if page.HasMore {if page.BadgeCount!=nil{t.Fatal(\"partial page claims a global count\")};cursor=page.NextCursor;continue}\n  if page.BadgeCount==nil||*page.BadgeCount!=126||pages<7{t.Fatal(\"client-window truncated or unread/later double counted\",page.BadgeCount,pages)}\n  break\n }\n f.exec(\"UPDATE chat_user_preferences SET later=0 WHERE conversation_id=?\",string(r.ConversationID))\n page,e:=h.DigestsCursor(f.ctx,principal(\"10202\"),\"\",20);if e!=nil||!page.HasMore{t.Fatal(page,e)}\n // The caller cannot alter an authenticated partial attention accumulator.\n parsed,e:=h.decodeDigestCursor(page.NextCursor,principal(\"10202\"));if e!=nil||parsed.Attention!=20{t.Fatal(parsed,e)}\n if _,e=h.DigestsCursor(f.ctx,principal(\"10202\"),page.NextCursor+\"x\",20);e!=ErrResync{t.Fatal(\"tampered total accepted\",e)}\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n if _,e=h.Acknowledge(f.ctx,principal(\"10202\"),r.ConversationID,boot.SyncCursor);e!=nil{t.Fatal(e)}\n cursor=\"\"\n for{page,e=h.DigestsCursor(f.ctx,principal(\"10202\"),cursor,20);if e!=nil{t.Fatal(e)};if !page.HasMore{if page.BadgeCount==nil||*page.BadgeCount!=125{t.Fatal(\"read did not preserve other later items\",page.BadgeCount)};break};cursor=page.NextCursor}\n}\n","chat/internal/message/s09_test.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"testing\"\n \"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestS09StrictRequestDecoder(t *testing.T) {\n\tfor _, bad := range []string{\n\t\t`{\"cursor\":null}`,\n\t\t`{\"cursor\":\"\\ud800\"}`,\n\t\t\"{\\\"cursor\\\":\\\"\\xff\\\"}\",\n\t\t`{\"conversation_id\":\"1\",\"conversation_id\":\"2\"}`,\n\t\t`{\"limit\":5,\"limit\":6}`,\n\t\t`{\"conversation_id\":1}`,\n\t\t`{\"conversation_id\":\"01\"}`,\n\t\t`{\"limit\":2.5}`,\n\t\t`{\"limit\":-1}`,\n\t\t`{\"actor_id\":\"10203\"}`,\n\t\t`[]`,\n\t\t`{\"limit\":1} {}`,\n\t} {\n\t\tif _, err := decodeS09([]byte(bad)); err == nil {\n\t\t\tt.Fatalf(\"accepted %s\", bad)\n\t\t}\n\t}\n\tfor _, good := range []string{`{\"conversation_id\":\"1\"}`, `{\"conversation_id\":\"1\",\"cursor\":\"abc\"}`, `{\"limit\":20}`} {\n\t\tif _, err := decodeS09([]byte(good)); err != nil {\n\t\t\tt.Fatalf(\"rejected %s: %v\", good, err)\n\t\t}\n\t}\n}\n\nfunc TestS09DigestCursorBindingAndExpiry(t *testing.T) {\n\ts := &HistoryService{environment: \"test\", key: []byte(\"12345678901234567890123456789012\")}\n\tp := principal(\"10202\")\n\tc := digestCursor{Version: 2, PreferenceRevision: \"0\", Binding: bindingFor(\"test\", p), After: \"2\", Upper: \"99\", Expires: time.Now().Add(time.Minute).Unix()}\n\ttoken, e := s.encodeDigestCursor(c)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tgot, e := s.decodeDigestCursor(token, p)\n\tif e != nil || got.After != \"2\" {\n\t\tt.Fatal(\"round trip\", got, e)\n\t}\n\tif _, e = s.decodeDigestCursor(token, principal(\"10203\")); e != ErrResync {\n\t\tt.Fatal(\"cross account\", e)\n\t}\n\tif _, e = s.decodeDigestCursor(token+\"x\", p); e != ErrResync {\n\t\tt.Fatal(\"tampered token\", e)\n\t}\n\tc.Expires = time.Now().Add(-time.Second).Unix()\n\texpired, e := s.encodeDigestCursor(c)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = s.decodeDigestCursor(expired, p); e != ErrResync {\n\t\tt.Fatal(\"expired\", e)\n\t}\n}\n\nfunc TestS09ReadIDJSON(t *testing.T) {\n\tv := UnreadWindow{ReadSeq: \"0\", SnapshotSeq: \"12\", SnapshotChange: \"12\", PolicyVersion: \"1\", Count: 2}\n\traw, e := json.Marshal(v)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tvar decoded struct {\n\t\tReadSeq ports.ID `json:\"read_seq\"`\n\t}\n\tif e = json.Unmarshal(raw, &decoded); e != nil || decoded.ReadSeq != \"0\" {\n\t\tt.Fatal(decoded, e)\n\t}\n}\n\nfunc TestS14PreferenceClosedSchema(t *testing.T){\n hash:=\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"\n good:=`{\"conversation_id\":\"9\",\"member_version\":\"`+hash+`\",\"field\":\"pinned\",\"value\":true,\"expected_version\":\"0\"`+`}`\n q,e:=decodePreference([]byte(good),true);if e!=nil||q.Field!=\"pinned\"||!q.Value||q.Expected!=\"0\"{t.Fatal(q,e)}\n for _,raw:=range []string{\n  `{\"conversation_id\":\"9\",\"muted\":true}`, `{\"conversation_id\":\"9\",\"hidden\":true}`, `{\"conversation_id\":\"9\",\"actor_id\":\"1\"}`,\n  `{\"conversation_id\":\"9\",\"conversation_id\":\"10\"}`, `{\"conversation_id\":9}`, `{\"conversation_id\":\"09\"}`,\n  `{\"conversation_id\":\"9\",\"read_seq\":\"999\"}`, `{\"conversation_id\":\"9\",\"field\":\"pinned\",\"value\":null}`, `{\"conversation_id\":\"9\"} {}`,\n }{if _,e:=decodePreference([]byte(raw),true);e==nil{t.Fatal(\"accepted write\",raw)};if _,e:=decodePreference([]byte(raw),false);e==nil{t.Fatal(\"accepted read\",raw)}}\n if _,e:=decodePreference([]byte(`{\"conversation_id\":\"9\"}`),false);e!=nil{t.Fatal(e)}\n for _,change:=range []struct{old,new string}{{\"true\",\"null\"},{\"true\",`\"true\"`},{`\"pinned\"`,`\"muted\"`},{`\"0\"`,`\"00\"`},{hash,\"BAD\"},{`\"expected_version\":\"0\"`,`\"expected_version\":0`}}{\n  raw:=strings.Replace(good,change.old,change.new,1);if _,e:=decodePreference([]byte(raw),true);e==nil{t.Fatal(\"accepted\",raw)}\n }\n}","chat/internal/message/service.go":"// Package message owns the transport-independent, fail-closed text send use case.\n// HTTP and future WSS must call Send; neither transport may write messages.\npackage message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n \"github.com/franz-9527/workers/chat/internal/storagepolicy\"\n)\n\nvar (\n\tErrConflict   = errors.New(\"CHAT_CLIENT_MESSAGE_CONFLICT\")\n\tErrExpired    = errors.New(\"CHAT_ACTION_EXPIRED\")\n\tErrUnknown    = errors.New(\"CHAT_SEND_RESULT_UNKNOWN\")\n\tErrRestricted = errors.New(\"CHAT_SEND_RESTRICTED\")\n\tErrBlocked    = errors.New(\"CHAT_CONTENT_BLOCKED\")\n\tErrCheck      = errors.New(\"CHAT_CHECK_UNAVAILABLE\")\n)\n\nconst ActionWindow = 24 * time.Hour\nconst MinimumRetention = 30 * 24 * time.Hour\nconst leaseDuration = 10 * time.Second\n\nvar clientPattern = regexp.MustCompile(`^([1-9][0-9]{9})\\.([0-9a-f]{32})$`)\nvar rulePattern = regexp.MustCompile(`^[A-Za-z0-9_.:-]{1,64}$`)\n\ntype Config struct {\n\tEnabled bool `json:\"enabled\"`\n}\ntype Request struct {\n\tItems           []MediaItem `json:\"items,omitempty\"`\n\tRevision        int         `json:\"revision,omitempty\"`\n\tReplyItem       ports.ID    `json:\"reply_to_item_id,omitempty\"`\n\tConversationID  ports.ID    `json:\"conversation_id\"`\n\tClientMessageID string      `json:\"client_message_id\"`\n\tMessageType     string      `json:\"message_type\"`\n\tText            string      `json:\"text\"`\n\tReplyTo         ports.ID    `json:\"reply_to_message_id,omitempty\"`\n\tEditedFrom      ports.ID    `json:\"edited_from_recalled_message_id,omitempty\"`\n}\n\n// Result deliberately never returns stored text, including after recall/block.\n// State is checking/retryable/rejected/accepted; absence is never proof of failure.\ntype Result struct {\n\tRiskEventID     ports.ID `json:\"risk_event_id,omitempty\"`\n\tClientMessageID string   `json:\"client_message_id\"`\n\tState           string   `json:\"state\"`\n\tCode            string   `json:\"code,omitempty\"`\n\tMessageID       ports.ID `json:\"message_id,omitempty\"`\n\tSeq             ports.ID `json:\"seq,omitempty\"`\n\tPolicyVersion   ports.ID `json:\"policy_version,omitempty\"`\n\tStateVersion    ports.ID `json:\"state_version,omitempty\"`\n\tMessageState    string   `json:\"message_state,omitempty\"`\n}\ntype Service struct {\n\tmedia         *MediaService\n av *AVService\n\tdb            *sql.DB\n\tconversations *conversation.Store\n\tsafety        ports.Safety\n\ttimeout       time.Duration\n\tpublisher     ports.MessagePublisher\n}\n\n// WithPublisher returns an immutable configured copy, before serving requests.\nfunc (s *Service) WithPublisher(p ports.MessagePublisher) *Service {\n\tcopy := *s\n\tcopy.publisher = p\n\treturn &copy\n}\n\nfunc NewService(db *sql.DB, c *conversation.Store, safety ports.Safety, timeout time.Duration) (*Service, error) {\n\tif db == nil || c == nil || safety == nil || timeout < 100*time.Millisecond || timeout > 3*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Service{db: db, conversations: c, safety: safety, timeout: timeout}, nil\n}\nfunc validID(id ports.ID) bool   { return id.Valid() && id != \"0\" }\nfunc validClient(id string) bool { return clientPattern.MatchString(id) }\nfunc expires(id string) time.Time {\n\tseconds, _ := strconv.ParseInt(strings.SplitN(id, \".\", 2)[0], 10, 64)\n\treturn time.Unix(seconds, 0).UTC().Add(ActionWindow)\n}\nfunc active(id string, now time.Time) bool {\n\tend := expires(id)\n\treturn now.Before(end) && !now.Add(30*time.Second).Before(end.Add(-ActionWindow))\n}\nfunc fingerprint(r Request) (string, error) {\n\tif len(r.Items) > 0 || r.Revision != 0 || r.ReplyItem != \"\" && (!validID(r.ReplyItem) || r.ReplyTo == \"\") || (r.ReplyTo != \"\" && !validID(r.ReplyTo)) || (r.EditedFrom != \"\" && !validID(r.EditedFrom)) || !validID(r.ConversationID) || !validClient(r.ClientMessageID) || r.MessageType != \"text\" || !utf8.ValidString(r.Text) || len(r.Text) > 4000 || utf8.RuneCountInString(r.Text) > 2000 || strings.TrimSpace(r.Text) == \"\" || strings.ContainsRune(r.Text, 0) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\t// Versioned structural encoding: preserves every UTF-8 byte, whitespace and\n\t// line break. Future attachments/replies require a new explicit schema.\n\tdata, _ := json.Marshal(struct {\n\t\tSchema int    `json:\"schema\"`\n\t\tType   string `json:\"type\"`\n\t\tText   string `json:\"text\"`\n\t}{1, r.MessageType, r.Text})\n\tif r.ReplyTo != \"\" || r.EditedFrom != \"\" || r.ReplyItem != \"\" {\n\t\tdata, _ = json.Marshal(struct {\n\t\t\tSchema     int      `json:\"schema\"`\n\t\t\tType       string   `json:\"type\"`\n\t\t\tText       string   `json:\"text\"`\n\t\t\tReplyTo    ports.ID `json:\"reply_to_message_id,omitempty\"`\n\t\t\tEditedFrom ports.ID `json:\"edited_from_recalled_message_id,omitempty\"`\n\t\t\tReplyItem  ports.ID `json:\"reply_to_item_id,omitempty\"`\n\t\t}{2, r.MessageType, r.Text, r.ReplyTo, r.EditedFrom, r.ReplyItem})\n\t}\n\tsum := sha256.Sum256(data)\n\treturn hex.EncodeToString(sum[:]), nil\n}\nfunc (s *Service) begin(ctx context.Context) (*sql.Tx, error) {\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn tx, nil\n}\nfunc (s *Service) authorize(ctx context.Context, tx *sql.Tx, p ports.Principal, id ports.ID, final ...ports.SafetyResult) (ports.Grant, error) {\n\ta, e := s.conversations.LockAuthority(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"send\"})\n\tif e != nil {\n\t\treturn ports.Grant{}, e\n\t}\n\tif len(final) == 1 {\n\t\tif validator, ok := s.safety.(finalSafety); ok {\n\t\t\tif err := validator.ValidateTextLocked(ctx, tx, p, final[0]); err != nil {\n\t\t\t\treturn ports.Grant{}, err\n\t\t\t}\n\t\t}\n\t}\n\t// Never lock a possibly absent restriction via SELECT alone. Even an\n\t// unrestricted actor owns a permanent row; all future bans use this same row.\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_restrictions(actor_id,permanent,version,updated_at) VALUES(?,0,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(p.ActorID))\n\tif e != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tvar restricted bool\n\te = tx.QueryRowContext(ctx, `SELECT permanent=1 OR (blocked_until IS NOT NULL AND blocked_until>UTC_TIMESTAMP(6)) FROM chat_restrictions WHERE actor_id=? FOR UPDATE`, string(p.ActorID)).Scan(&restricted)\n\tif e != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif restricted {\n\t\treturn ports.Grant{}, ErrRestricted\n\t}\n\treturn s.conversations.LockProjection(ctx, tx, a)\n}\n\ntype intent struct {\n\tid                 ports.ID\n\tfingerprint, owner string\n\tresult             Result\n\tleased             bool\n\tattempts           int\n}\n\nfunc (s *Service) lookup(ctx context.Context, tx *sql.Tx, p ports.Principal, conversation ports.ID, client string) (*intent, error) {\n\tvar i intent\n\ti.result.ClientMessageID = client\n\tvar message, risk sql.NullString\n\te := tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),fingerprint,state,COALESCE(error_code,''),CAST(message_id AS CHAR),CAST(risk_event_id AS CHAR),COALESCE(lease_owner,''),COALESCE(lease_until>UTC_TIMESTAMP(6),0),attempts\n FROM chat_send_intents WHERE sender_id=? AND conversation_id=? AND client_message_id=? FOR UPDATE`, string(p.ActorID), string(conversation), client).Scan(&i.id, &i.fingerprint, &i.result.State, &i.result.Code, &message, &risk, &i.owner, &i.leased, &i.attempts)\n\tif e == sql.ErrNoRows {\n\t\treturn nil, nil\n\t}\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tif risk.Valid {\n\t\ti.result.RiskEventID = ports.ID(risk.String)\n\t}\n\tif i.result.State == \"accepted\" {\n\t\tif !message.Valid {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\ti.result.MessageID = ports.ID(message.String)\n\t\te = tx.QueryRowContext(ctx, `SELECT CAST(seq AS CHAR),CAST(policy_version AS CHAR),CAST(state_version AS CHAR),state FROM chat_messages WHERE id=? AND conversation_id=? AND sender_id=? LOCK IN SHARE MODE`, message.String, string(conversation), string(p.ActorID)).Scan(&i.result.Seq, &i.result.PolicyVersion, &i.result.StateVersion, &i.result.MessageState)\n\t\tif e != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\t// Current readable membership alone must not expose an absence-period send.\n\t\tvar start string\n\t\te = tx.QueryRowContext(ctx, `SELECT CAST(start_version AS CHAR) FROM chat_member_intervals WHERE conversation_id=? AND actor_id=? AND start_version<=? AND (end_version IS NULL OR end_version>?) LIMIT 1 LOCK IN SHARE MODE`, string(conversation), string(p.ActorID), string(i.result.PolicyVersion), string(i.result.PolicyVersion)).Scan(&start)\n\t\tif e == sql.ErrNoRows {\n\t\t\treturn nil, policy.ErrDenied\n\t\t}\n\t\tif e != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn nil, policy.ErrDenied\n\t}\n\treturn &i, nil\n}\n\n// Query uses read authority, never send authority or the ban gate. An accepted\n// action remains confirmable by its legitimate author after a send ban/closure.\nfunc (s *Service) Query(ctx context.Context, p ports.Principal, id ports.ID, client string) (Result, error) {\n\tif !validID(id) || !validClient(client) {\n\t\treturn Result{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"}); e != nil {\n\t\treturn Result{}, e\n\t}\n\ti, e := s.lookup(ctx, tx, p, id, client)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif i == nil {\n\t\tif !active(client, time.Now()) {\n\t\t\treturn Result{}, ErrExpired\n\t\t}\n\t\treturn Result{}, ErrUnknown\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif i.result.State != \"accepted\" && i.result.State != \"rejected\" && !active(client, time.Now()) {\n\t\ti.result.State = \"rejected\"\n\t\ti.result.Code = ErrExpired.Error()\n\t}\n\treturn i.result, nil\n}\n\nfunc (s *Service) Send(ctx context.Context, p ports.Principal, r Request) (Result, error) {\n\tif r.MessageType==\"audio\"||r.MessageType==\"video\"{\n  if s.av==nil{return Result{},ErrMedia};return s.av.Send(ctx,p,r)\n }\n if r.MessageType == \"image\" || r.MessageType == \"image_album\" {\n\t\tif s.media == nil {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t\treturn s.media.Send(ctx, p, r)\n\t}\n\tfp, e := fingerprint(r)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\t// Read-only result lookup precedes send restrictions, expiry and safety. It\n\t// never commits a new message, even if the original acknowledgement was lost.\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif _, e = s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: r.ConversationID, Action: \"read\"}); e != nil {\n\t\ttx.Rollback()\n\t\treturn Result{}, e\n\t}\n\tprevious, e := s.lookup(ctx, tx, p, r.ConversationID, r.ClientMessageID)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\treturn Result{}, e\n\t}\n\tif previous != nil && previous.fingerprint != fp {\n\t\ttx.Rollback()\n\t\treturn Result{}, ErrConflict\n\t}\n\tif previous != nil && terminal(previous.result.State) {\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn previous.result, nil\n\t}\n\ttx.Rollback()\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\ttx, e = s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tgrant, e := s.authorize(ctx, tx, p, r.ConversationID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Re-read under canonical guard -> restriction -> conversation -> intent order.\n\tcurrent, e := s.lookup(ctx, tx, p, r.ConversationID, r.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif current != nil && current.fingerprint != fp {\n\t\treturn Result{}, ErrConflict\n\t}\n\tif current != nil && terminal(current.result.State) {\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn current.result, nil\n\t}\n\tif current != nil && (current.leased || current.attempts >= 8) {\n\t\treturn current.result, nil\n\t}\n\tif _, e = validateReferences(ctx, tx, p, r, grant); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar pending int\n\tif e = tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_send_intents WHERE sender_id=? AND state='checking' AND lease_until>UTC_TIMESTAMP(6)`, string(p.ActorID)).Scan(&pending); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif pending >= 4 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tvar token [16]byte\n\tif _, e = rand.Read(token[:]); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\towner := hex.EncodeToString(token[:])\n\tif current == nil {\n\t\tres, err := tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,lease_owner,lease_until,attempts,action_expires_at,retain_until,created_at,updated_at) VALUES(?,?,?,?,'checking',?,UTC_TIMESTAMP(6)+INTERVAL 10 SECOND,1,?,?,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(r.ConversationID), r.ClientMessageID, fp, owner, expires(r.ClientMessageID), expires(r.ClientMessageID).Add(MinimumRetention))\n\t\tif err != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\tn, err := res.LastInsertId()\n\t\tif err != nil || n <= 0 {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\tcurrent = &intent{id: ports.ID(strconv.FormatInt(n, 10))}\n\t} else {\n\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='checking',error_code=NULL,lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 10 SECOND,attempts=attempts+1,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, owner, string(current.id))\n\t\tif e != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\t// No DB lease/transaction is held over network inspection. Exact text and\n\t// fingerprint are immutable on this stack and supplied together to safety.\n\tchecked, checkErr := s.safety.CheckText(ctx, ports.TextRequest{Actor: p, ConversationID: r.ConversationID, IntentID: current.id, Text: r.Text, Fingerprint: fp})\n\tif checkErr != nil || !rulePattern.MatchString(checked.RuleVersion) || (checked.Decision != \"passed\" && !validFinding(checked)) {\n\t\ts.settle(ctx, current.id, owner, \"retryable\", ErrCheck.Error())\n\t\treturn Result{}, ErrCheck\n\t}\n\tif checked.Decision != \"passed\" {\n\t\treturn s.reject(ctx, p, r, fp, current.id, owner, checked)\n\t}\n\treturn s.publish(ctx, p, r, fp, current.id, owner, checked)\n\n}\n\nfunc (s *Service) settle(ctx context.Context, id ports.ID, owner, state, code string) bool {\n\t// Intent-only CAS never acquires an earlier lock and cannot publish anything.\n\tres, e := s.db.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, state, code, string(id), owner)\n\tif e != nil {\n\t\treturn false\n\t}\n\tn, e := res.RowsAffected()\n\treturn e == nil && n == 1\n}\nfunc (s *Service) publish(ctx context.Context, p ports.Principal, r Request, fp string, id ports.ID, owner string, checked ports.SafetyResult) (Result, error) {\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tgrant, e := s.authorize(ctx, tx, p, r.ConversationID, checked)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\tif e == ErrRestricted || errors.Is(e, policy.ErrDenied) {\n\t\t\ts.settle(ctx, id, owner, \"rejected\", e.Error())\n\t\t}\n\t\treturn Result{}, e\n\t}\n\ti, e := s.lookup(ctx, tx, p, r.ConversationID, r.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif i == nil || i.id != id || i.owner != owner || !i.leased || i.result.State != \"checking\" || i.fingerprint != fp {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\ttx.Rollback()\n\t\ts.settle(ctx, id, owner, \"rejected\", ErrExpired.Error())\n\t\treturn Result{}, ErrExpired\n\t}\n\tdepth, e := validateReferences(ctx, tx, p, r, grant)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\ts.settle(ctx, id, owner, \"rejected\", e.Error())\n\t\treturn Result{}, e\n\t}\n\tvar seq, change uint64\n\te = tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=? FOR UPDATE`, string(r.ConversationID)).Scan(&seq, &change)\n\tif e != nil || seq == ^uint64(0) || change == ^uint64(0) {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tseq++\n\tchange++\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_messages(conversation_id,seq,sender_id,client_message_id,policy_version,message_type,text_body,state,state_version,safety_rule_version,created_at,reply_to_message_id,edited_from_recalled_message_id,reedit_depth,reply_to_item_id) VALUES(?,?,?,?,?,'text',?,'published',1,?,UTC_TIMESTAMP(6),?,?,?,?)`, string(r.ConversationID), seq, string(p.ActorID), r.ClientMessageID, string(grant.Version), r.Text, checked.RuleVersion, nullableID(r.ReplyTo), nullableID(r.EditedFrom), depth, nullableID(r.ReplyItem))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tmessageID, e := res.LastInsertId()\n\tif e != nil || messageID <= 0 {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif e = storagepolicy.Stamp(ctx,tx,messageID,\"text\"); e != nil {return Result{},e}\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,1,'message.accepted',UTC_TIMESTAMP(6))`, string(r.ConversationID), change, messageID)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\t_, e = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_seq=?,last_change_seq=?,last_message_id=?,last_message_at=UTC_TIMESTAMP(6) WHERE id=?`, seq, change, messageID, string(r.ConversationID))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tres, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='accepted',message_id=?,error_code=NULL,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, messageID, string(id), owner)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tn, e := res.RowsAffected()\n\tif e != nil || n != 1 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif e = reminderEvent(ctx, tx, r.ConversationID, seq); e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Credential validity is rechecked after any lock wait immediately at commit.\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, policy.ErrDenied\n\t}\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t} // UNKNOWN: query same ID.\n\tif s.publisher != nil {\n\t\ts.publisher.Committed(ports.CommittedMessage{ConversationID: r.ConversationID, Seq: ports.ID(fmt.Sprint(seq)), PolicyVersion: grant.Version})\n\t}\n\treturn Result{ClientMessageID: r.ClientMessageID, State: \"accepted\", MessageID: ports.ID(fmt.Sprint(messageID)), Seq: ports.ID(fmt.Sprint(seq)), PolicyVersion: grant.Version, StateVersion: \"1\", MessageState: \"published\"}, nil\n}\n","chat/internal/message/service_test.go":"package message\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc client(n int) string { return fmt.Sprintf(\"%d.%032x\", time.Now().Unix(), n) }\nfunc request(n int) Request {\n\treturn Request{ConversationID: \"1\", ClientMessageID: client(n), MessageType: \"text\", Text: \"施工尺寸 3.5m × 2m\\n明天见 🛠️\"}\n}\nfunc TestActionBoundaryAndFingerprint(t *testing.T) {\n\tnow := time.Now().Truncate(time.Second)\n\tid := fmt.Sprintf(\"%d.%032x\", now.Unix(), 1)\n\tif !active(id, now.Add(ActionWindow-time.Nanosecond)) || active(id, now.Add(ActionWindow)) || active(id, now.Add(-31*time.Second)) {\n\t\tt.Fatal(\"action window boundary\")\n\t}\n\tr := request(1)\n\tfp, e := fingerprint(r)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tr.Text += \" \"\n\tother, _ := fingerprint(r)\n\tif fp == other {\n\t\tt.Fatal(\"whitespace was normalized\")\n\t}\n\tr.Text = strings.Repeat(\"a\", 2001)\n\tif _, e = fingerprint(r); e == nil {\n\t\tt.Fatal(\"character limit\")\n\t}\n\tr.Text = strings.Repeat(\"中\", 1334)\n\tif _, e = fingerprint(r); e == nil {\n\t\tt.Fatal(\"UTF8 byte limit\")\n\t}\n\tfor _, id := range []string{\"1\", client(1) + \"0\", \"0000000000.\" + strings.Repeat(\"a\", 32), strings.ToUpper(client(255))} {\n\t\tr = request(1)\n\t\tr.ClientMessageID = id\n\t\tif _, e = fingerprint(r); e == nil {\n\t\t\tt.Fatalf(\"invalid client ID %s\", id)\n\t\t}\n\t}\n}\nfunc TestStrictJSON(t *testing.T) {\n\tfor _, v := range []string{`\"\\ud83d\\udee0\"`, `\"�\"`, `\"\\\\uD800\"`} {\n\t\tif !validSurrogates([]byte(v)) {\n\t\t\tt.Fatal(\"valid Unicode rejected\", v)\n\t\t}\n\t}\n\tfor _, v := range []string{`\"\\ud800\"`, `\"\\udc00\"`, `\"\\ud800\\u0041\"`} {\n\t\tif validSurrogates([]byte(v)) {\n\t\t\tt.Fatal(\"lossy Unicode accepted\", v)\n\t\t}\n\t}\n\n\tgood := fmt.Sprintf(`{\"conversation_id\":\"18446744073709551615\",\"client_message_id\":%q,\"message_type\":\"text\",\"text\":\"换行\\n🛠\"}`, client(1))\n\tif _, e := decode([]byte(good), false); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor _, body := range []string{strings.Replace(good, `\"text\":`, `\"text\":\"x\",\"text\":`, 1), strings.Replace(good, `\"text\":`, `\"Text\":`, 1), strings.Replace(good, `\"message_type\":\"text\"`, `\"message_type\":null`, 1), strings.Replace(good, `\"18446744073709551615\"`, `18446744073709551615`, 1), good + `{}`, strings.Replace(good, `换行\\n🛠`, `\\ud800`, 1), `[]`, strings.Replace(good, `\"text\":`, `\"sender_id\":\"42\",\"text\":`, 1)} {\n\t\tif _, e := decode([]byte(body), false); e == nil {\n\t\t\tt.Fatalf(\"accepted invalid body %s\", body)\n\t\t}\n\t}\n\tif _, e := decode([]byte(good), true); e == nil {\n\t\tt.Fatal(\"query accepted text\")\n\t}\n}\n\nfunc TestS15ReferenceFingerprintAndClosedPayloads(t *testing.T){\n q:=request(1501);base,_:=fingerprint(q);q.ReplyTo=\"1\";reply,_:=fingerprint(q)\n q.ReplyTo=\"\";q.EditedFrom=\"1\";edited,_:=fingerprint(q)\n if base==reply||reply==edited||base==edited{t.Fatal(\"source fingerprint collision\")}\n good:=fmt.Sprintf(`{\"conversation_id\":\"1\",\"client_message_id\":%q,\"message_type\":\"text\",\"text\":\"回复\",\"reply_to_message_id\":\"2\"}`,client(1502))\n if _,e:=decode([]byte(good),false);e!=nil{t.Fatal(e)}\n for _,bad:=range []string{strings.Replace(good,`\"2\"`,`2`,1),strings.Replace(good,`\"2\"`,`\"0\"`,1),strings.Replace(good,`\"2\"`,`null`,1),strings.Replace(good,`\"text\":`,`\"quote_text\":\"fake\",\"text\":`,1),strings.Replace(good,`\"reply_to_message_id\":\"2\"`,`\"reply_to_message_id\":\"2\",\"reply_to_message_id\":\"2\"`,1)}{if _,e:=decode([]byte(bad),false);e==nil{t.Fatal(\"malformed source\",bad)}}\n for _,bad:=range []string{`{\"conversation_id\":\"1\",\"message_id\":\"2\",\"cursor\":\"\"}`,`{\"conversation_id\":\"1\",\"message_id\":2}`,`{\"conversation_id\":\"1\",\"message_id\":\"2\",\"message_id\":\"2\"}`,`{\"conversation_id\":\"1\",\"message_id\":\"2\",\"sender_id\":\"1\"}`}{if _,e:=decodeRecall([]byte(bad));e==nil{t.Fatal(\"malformed recall\",bad)}}\n if _,e:=decodeRecall([]byte(`{\"conversation_id\":\"1\",\"message_id\":\"2\"}`));e!=nil{t.Fatal(e)}\n}\n","chat/internal/message/socket.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// SocketCommands adapts the exact HTTP payload decoders and application use\n// cases. Runtime supplies no sender until the independent release gate opens.\ntype SocketCommands struct {\n\tSender  *Service\n\tHistory *HistoryService\n}\ntype commandError struct {\n\tcode  string\n\tretry bool\n}\n\nfunc (e commandError) Error() string              { return e.code }\nfunc (e commandError) PublicCode() (string, bool) { return e.code, e.retry }\nfunc socketError(e error) error {\n\tif e == nil {\n\t\treturn nil\n\t}\n\tswitch {\n\tcase errors.Is(e, ports.ErrInvalid):\n\t\treturn commandError{\"CHAT_INVALID_REQUEST\", false}\n\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\treturn commandError{\"CHAT_PERMISSION_DENIED\", false}\n\tcase errors.Is(e,ErrReference),errors.Is(e,ErrReeditLimit),errors.Is(e,ErrRecall),errors.Is(e,ErrRecallWindow),errors.Is(e, ErrPreferenceConflict), errors.Is(e,ErrPinLimit), errors.Is(e, ErrConflict), errors.Is(e, ErrExpired), errors.Is(e, ErrRestricted), errors.Is(e, ErrResync):\n\t\treturn commandError{e.Error(), false}\n\tcase errors.Is(e, ErrUnknown), errors.Is(e, ErrCheck), errors.Is(e, ports.ErrBusy):\n\t\treturn commandError{e.Error(), true}\n\tdefault:\n\t\treturn commandError{ports.ErrUnavailable.Error(), true}\n\t}\n}\nfunc (s SocketCommands) Execute(ctx context.Context, p ports.Principal, typ string, raw json.RawMessage) (string, any, error) {\n\tif len(raw) > 4096 && typ != \"message.send\" && typ != \"message.status\" {\n\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t}\n\tvar out any\n\tvar e error\n\tresponse := typ + \".result\"\n\tswitch typ {\n\tcase \"message.recall\":\n        if s.Sender==nil{return \"\",nil,commandError{\"CHAT_MESSAGES_NOT_READY\",false}}\n        q,err:=decodeRecall(raw);if err!=nil{return \"\",nil,socketError(err)}\n        out,e=s.Sender.Recall(ctx,p,q.ConversationID,q.TargetID)\n\tcase \"message.send\", \"message.status\":\n\t\tif s.Sender == nil {\n\t\t\treturn \"\", nil, commandError{\"CHAT_MESSAGES_NOT_READY\", false}\n\t\t}\n\t\tq, err := decode(raw, typ == \"message.status\")\n\t\tif err != nil {\n\t\t\treturn \"\", nil, socketError(err)\n\t\t}\n\t\tif typ == \"message.send\" {\n\t\t\tout, e = s.Sender.Send(ctx, p, q)\n\t\t\tresponse = \"message.result\"\n\t\t\tif r, ok := out.(Result); ok && r.State == \"accepted\" {\n\t\t\t\tresponse = \"message.accepted\"\n\t\t\t}\n\t\t} else {\n\t\t\tout, e = s.Sender.Query(ctx, p, q.ConversationID, q.ClientMessageID)\n\t\t}\n\tcase \"conversation.bootstrap\", \"history.request\", \"sync.request\", \"changes.sync\", \"message.locate\":\n\t\tif s.History == nil {\n\t\t\treturn \"\", nil, commandError{\"CHAT_HISTORY_NOT_READY\", false}\n\t\t}\n\t\tmode := map[string]string{\"conversation.bootstrap\": \"bootstrap\", \"history.request\": \"history\", \"sync.request\": \"sync\", \"changes.sync\": \"changes\", \"message.locate\": \"locate\"}[typ]\n\t\tq, err := decodeHistory(raw)\n\t\tif err != nil {\n\t\t\treturn \"\", nil, socketError(err)\n\t\t}\n\t\tout, e = s.History.Read(ctx, p, q, mode)\n\t\tif typ == \"sync.request\" {\n\t\t\tresponse = \"sync.result\"\n\t\t}\n\tcase \"conversation.preferences\",\"conversation.preference\":\n  if s.History==nil{return \"\",nil,commandError{\"CHAT_HISTORY_NOT_READY\",false}}\n  q,err:=decodePreference(raw,typ==\"conversation.preference\");if err!=nil{return \"\",nil,socketError(err)}\n  if typ==\"conversation.preference\"{out,e=s.History.SetPreference(ctx,p,q)}else{out,e=s.History.Preferences(ctx,p,q.ConversationID)}\n case \"receipt.read\", \"conversation.unread\", \"account.digests\":\n\t\tif s.History == nil {\n\t\t\treturn \"\", nil, commandError{\"CHAT_HISTORY_NOT_READY\", false}\n\t\t}\n\t\tq, err := decodeS09(raw)\n\t\tif err != nil {\n\t\t\treturn \"\", nil, socketError(err)\n\t\t}\n\t\tswitch typ {\n\t\tcase \"receipt.read\":\n\t\t\tif !validID(q.ConversationID) || q.Cursor == \"\" || q.Limit != 0 {\n\t\t\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t\t\t}\n\t\t\tout, e = s.History.Acknowledge(ctx, p, q.ConversationID, q.Cursor)\n\t\tcase \"conversation.unread\":\n\t\t\tif !validID(q.ConversationID) || q.Cursor != \"\" || q.Limit != 0 {\n\t\t\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t\t\t}\n\t\t\tout, e = s.History.Unread(ctx, p, q.ConversationID)\n\t\tcase \"account.digests\":\n\t\t\tif q.ConversationID != \"\" || q.Limit < 1 || q.Limit > 20 {\n\t\t\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t\t\t}\n\t\t\tout, e = s.History.DigestsCursor(ctx, p, q.Cursor, q.Limit)\n\t\t}\n\tdefault:\n\t\treturn \"\", nil, commandError{\"CHAT_COMMAND_UNKNOWN\", false}\n\t}\n\treturn response, out, socketError(e)\n}\n","chat/internal/message/socket_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/gorilla/websocket\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\nfunc TestMySQLRedisS10HTTPAndWSSUseTheSameCommands(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 0)\n\taddress := os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\")\n\tif address == \"\" {\n\t\tt.Fatal(\"explicit isolated Redis required\")\n\t}\n\tredisClient := redis.NewClient(&redis.Options{Addr: address, PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, DisableIdentity: true, Protocol: 2})\n\tdefer redisClient.Close()\n\tticketStore, e := auth.NewRedisStore(redisClient, \"test\", \"bxchat:test:\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\tverifier, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"s10\": pub})\n\tsource, _ := auth.NewMySQLSource(f.goDB)\n\tidentity, e := auth.NewService(verifier, source, ticketStore, 4, time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tp := principal(\"10202\")\n\tnow := time.Now().Unix()\n\tclaims := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: p.Environment, Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\traw, _ := json.Marshal(claims)\n\tunsigned := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"s10\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(raw)\n\ttoken := unsigned + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(unsigned)))\n\tgateway, e := socket.New(identity, SocketCommands{Sender: s, History: h})\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tsendHTTP, _ := NewHandler(s, identity, 4)\n\treadHTTP, _ := NewHistoryHandler(h, identity, 4)\n\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tif r.URL.Path == \"/chat/ws\" {\n\t\t\tgateway.ServeHTTP(w, r)\n\t\t} else if strings.HasSuffix(r.URL.Path, \"/send\") {\n\t\t\tsendHTTP.ServeHTTP(w, r)\n\t\t} else {\n\t\t\treadHTTP.ServeHTTP(w, r)\n\t\t}\n\t}))\n\tdefer server.Close()\n\tdefer func() {\n\t\tctx, cancel := context.WithTimeout(context.Background(), time.Second)\n\t\tdefer cancel()\n\t\tif e := gateway.Shutdown(ctx); e != nil {\n\t\t\tt.Error(e)\n\t\t}\n\t}()\n\tws, _, e := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer ws.Close()\n\tcall := func(typ string, payload any) (string, json.RawMessage) {\n\t\tt.Helper()\n\t\tif e := ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"s10\", \"type\": typ, \"payload\": payload}); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\tvar out struct {\n\t\t\tType    string          `json:\"type\"`\n\t\t\tPayload json.RawMessage `json:\"payload\"`\n\t\t}\n\t\tif e := ws.ReadJSON(&out); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\treturn out.Type, out.Payload\n\t}\n\tticket, _, e := identity.IssueTicket(f.ctx, token)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ttyp, _ := call(\"auth\", map[string]string{\"ticket\": ticket})\n\tif typ != \"auth.ok\" {\n\t\tt.Fatal(typ)\n\t}\n\ttyp, body := call(\"message.send\", q)\n\tvar first Result\n\tif typ != \"message.accepted\" || json.Unmarshal(body, &first) != nil || first.Seq != \"1\" {\n\t\tt.Fatalf(\"send %s %s\", typ, body)\n\t}\n\thttpCall := func(path string, payload any) json.RawMessage {\n\t\tt.Helper()\n\t\tb, _ := json.Marshal(payload)\n\t\tr, _ := http.NewRequest(\"POST\", server.URL+path, strings.NewReader(string(b)))\n\t\tr.Header.Set(\"Authorization\", \"Bearer \"+token)\n\t\tr.Header.Set(\"Content-Type\", \"application/json\")\n\t\tres, e := server.Client().Do(r)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer res.Body.Close()\n\t\tb, _ = io.ReadAll(res.Body)\n\t\tif res.StatusCode != 200 {\n\t\t\tt.Fatalf(\"HTTP %d %s\", res.StatusCode, b)\n\t\t}\n\t\tvar out struct {\n\t\t\tData json.RawMessage `json:\"data\"`\n\t\t}\n\t\tif json.Unmarshal(b, &out) != nil {\n\t\t\tt.Fatal(\"HTTP data\")\n\t\t}\n\t\treturn out.Data\n\t}\n\tvar repeated Result\n\tjson.Unmarshal(httpCall(\"/chat/api/v1/messages/send\", q), &repeated)\n\tif repeated.MessageID != first.MessageID || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"HTTP retry duplicated WSS send\")\n\t}\n\ttyp, body = call(\"message.status\", map[string]string{\"conversation_id\": string(q.ConversationID), \"client_message_id\": q.ClientMessageID})\n\tjson.Unmarshal(body, &repeated)\n\tif typ != \"message.status.result\" || repeated.MessageID != first.MessageID {\n\t\tt.Fatal(\"WSS result lookup\")\n\t}\n\ttyp, body = call(\"conversation.bootstrap\", HistoryRequest{ConversationID: q.ConversationID})\n\tvar boot HistoryPage\n\tif typ != \"conversation.bootstrap.result\" || json.Unmarshal(body, &boot) != nil || len(boot.Messages) != 1 {\n\t\tt.Fatalf(\"bootstrap %s %s\", typ, body)\n\t}\n\t// Cross-transport opaque cursors are identical contracts, not numeric seqs.\n\tvar syncPage HistoryPage\n\tjson.Unmarshal(httpCall(\"/chat/api/v1/messages/sync\", HistoryRequest{ConversationID: q.ConversationID, Cursor: boot.SyncCursor}), &syncPage)\n\ttyp, body = call(\"receipt.read\", map[string]string{\"conversation_id\": string(q.ConversationID), \"cursor\": syncPage.SyncCursor})\n\tif typ != \"receipt.read.result\" {\n\t\tt.Fatalf(\"read %s %s\", typ, body)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != \"1\" {\n\t\tt.Fatal(\"explicit read did not commit\")\n\t}\n\t// Scope/policy checks are shared too. Revoking the PHP guard cannot be\n\t// bypassed through an already authenticated socket.\n\tf.exec(\"UPDATE chat_policy_guards SET policy_version=policy_version+1 WHERE order_id=401\")\n\ttyp, body = call(\"conversation.bootstrap\", HistoryRequest{ConversationID: q.ConversationID})\n\tif typ != \"error\" || !strings.Contains(string(body), \"CHAT_PERMISSION_DENIED\") {\n\t\tt.Fatalf(\"revoked policy %s %s\", typ, body)\n\t}\n\t// PHP logout invalidates an existing WSS identity before the next command;\n\t// there is no wait for an advisory Redis event or periodic idle check.\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif e = ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"logout\", \"type\": \"conversation.bootstrap\", \"payload\": HistoryRequest{ConversationID: q.ConversationID}}); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\tif _, _, e = ws.ReadMessage(); !websocket.IsCloseError(e, websocket.ClosePolicyViolation) {\n\t\tt.Fatalf(\"revoked PHP login kept socket usable: %v\", e)\n\t}\n}\n\nfunc TestMySQLS15SocketRecallUsesSameDecoderAndUseCase(t *testing.T){\n f,s,h,q:=historyFixture(t,0);m:=accepted(t,s,q)\n commands:=SocketCommands{Sender:s,History:h}\n raw,_:=json.Marshal(map[string]any{\"conversation_id\":q.ConversationID,\"message_id\":m.MessageID})\n typ,out,e:=commands.Execute(f.ctx,principal(\"10202\"),\"message.recall\",raw)\n if e!=nil||typ!=\"message.recall.result\"||out.(MessageView).Text!=nil||out.(MessageView).State!=\"recalled\"{t.Fatal(typ,out,e)}\n if _,_,e:=commands.Execute(f.ctx,principal(\"10202\"),\"message.recall\",append(raw[:len(raw)-1],[]byte(`,\"read_seq\":\"1\"}`)...));e==nil{t.Fatal(\"recall extra field\")}\n}\n","chat/internal/message/socket_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"testing\"\n)\n\nfunc TestS10RuntimeSocketReleaseGates(t *testing.T) {\n\tc := SocketCommands{}\n\tfor typ, want := range map[string]string{\"message.send\": \"CHAT_MESSAGES_NOT_READY\", \"message.status\": \"CHAT_MESSAGES_NOT_READY\", \"sync.request\": \"CHAT_HISTORY_NOT_READY\", \"receipt.read\": \"CHAT_HISTORY_NOT_READY\", \"typing.start\": \"CHAT_COMMAND_UNKNOWN\", \"method.inject\": \"CHAT_COMMAND_UNKNOWN\"} {\n\t\t_, _, err := c.Execute(context.Background(), ports.Principal{}, typ, json.RawMessage(`{}`))\n\t\tif err == nil || err.Error() != want {\n\t\t\tt.Fatalf(\"%s %v\", typ, err)\n\t\t}\n\t}\n}\n","chat/internal/message/storage_application.go":"package message\n\nimport (\n \"context\"\n \"database/sql\"\n \"errors\"\n \"time\"\n \"github.com/franz-9527/workers/chat/internal/ports\"\n \"github.com/franz-9527/workers/chat/internal/storagepolicy\"\n)\n\nvar ErrObjectMissing=errors.New(\"CHAT_MEDIA_OBJECT_MISSING\")\ntype ObjectKeeper interface{Keep(context.Context,string)error}\n\n// ApplyStorageOne consumes immutable PHP audit snapshots, oldest first. PHP can\n// change low-frequency settings without blocking behind a long history batch.\nfunc(s *Service) ApplyStorageOne(ctx context.Context)error{\n ctx,cancel:=context.WithTimeout(ctx,20*time.Second);defer cancel()\n var revision,through uint64;var raw []byte\n e:=s.db.QueryRowContext(ctx,`SELECT a.revision,a.policy_json,a.apply_through_id FROM chat_storage_policy_audit a LEFT JOIN chat_storage_applications j ON j.revision=a.revision WHERE a.apply_through_id>0 AND (j.revision IS NULL OR j.state NOT IN ('completed','completed_with_errors')) ORDER BY a.revision LIMIT 1`).Scan(&revision,&raw,&through)\n if e==sql.ErrNoRows{return nil};if e!=nil{return ports.ErrUnavailable}\n policy,e:=storagepolicy.Decode(raw);if e!=nil{return ports.ErrUnavailable}\n if _,e=s.db.ExecContext(ctx,`INSERT IGNORE INTO chat_storage_applications(revision,last_message_id,state,updated_at) VALUES(?,0,'pending',UTC_TIMESTAMP(6))`,revision);e!=nil{return ports.ErrUnavailable}\n tx,e:=s.begin(ctx);if e!=nil{return e};defer tx.Rollback()\n var last uint64;var live bool\n if tx.QueryRowContext(ctx,`SELECT last_message_id,COALESCE(lease_until>UTC_TIMESTAMP(6),0) FROM chat_storage_applications WHERE revision=? FOR UPDATE`,revision).Scan(&last,&live)!=nil{return ports.ErrUnavailable}\n if live{return nil}\n var m storageMessage\n e=tx.QueryRowContext(ctx,`SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),seq,CAST(policy_version AS CHAR),message_type,state,state_version,retention_policy_version FROM chat_messages WHERE id>? AND id<=? ORDER BY id LIMIT 1`,last,through).Scan(&m.id,&m.cid,&m.seq,&m.policyVersion,&m.kind,&m.state,&m.version,&m.retentionVersion)\n if e==sql.ErrNoRows{\n  if _,e=tx.ExecContext(ctx,`UPDATE chat_storage_applications SET state=IF(errors=0,'completed','completed_with_errors'),lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE revision=?`,revision);e!=nil||tx.Commit()!=nil{return ports.ErrUnavailable};return nil\n }\n if e!=nil{return ports.ErrUnavailable}\n owner:=randomMedia();if owner==\"\"{return ports.ErrUnavailable}\n if _,e=tx.ExecContext(ctx,`UPDATE chat_storage_applications SET state='running',lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 60 SECOND,updated_at=UTC_TIMESTAMP(6) WHERE revision=?`,owner,revision);e!=nil||tx.Commit()!=nil{return ports.ErrUnavailable}\n diagnostic:=\"\"\n if m.state==\"published\"&&m.retentionVersion<revision{\n  if _,e=policy.Rule(m.kind);e!=nil{diagnostic=\"CHAT_STORAGE_TYPE_UNSUPPORTED\"\n  }else if e=s.keepMessageObjects(ctx,m.id,m.kind);e!=nil{\n   if errors.Is(e,ErrObjectMissing){diagnostic=ErrObjectMissing.Error()\n   }else{\n    _,_=s.db.ExecContext(ctx,`UPDATE chat_storage_applications SET state='retrying',diagnostic='CHAT_MEDIA_UNAVAILABLE',lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE revision=? AND lease_owner=?`,revision,owner)\n    return e\n   }\n  }\n }\n return s.finishStorageApplication(ctx,revision,owner,policy,m,diagnostic)\n}\ntype storageMessage struct{\n id,cid ports.ID\n seq uint64\n policyVersion ports.ID\n kind,state string\n version,retentionVersion uint64\n}\nfunc(s *Service) keepMessageObjects(ctx context.Context,id ports.ID,kind string)error{\n if kind==\"text\"{return nil}\n if kind!=\"image\"&&kind!=\"image_album\"{return s.keepAVObjects(ctx,id,kind)}\n if s.media==nil{return ErrMedia}\n keeper,ok:=s.media.storage.(ObjectKeeper);if !ok{\n  if s.media.environment==\"test\"{return nil};return ErrMedia\n }\n rows,e:=s.db.QueryContext(ctx,`SELECT u.main_key,u.thumb_key FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=? ORDER BY i.ordinal`,string(id))\n if e!=nil{return ports.ErrUnavailable}\n keys:=[]string{}\n for rows.Next(){var main,thumb string;if rows.Scan(&main,&thumb)!=nil{rows.Close();return ErrMedia};keys=append(keys,main,thumb)}\n e=rows.Err();rows.Close();if e!=nil{return ports.ErrUnavailable};if len(keys)==0{return ErrObjectMissing}\n for _,key:=range keys{if key==\"\"{return ErrObjectMissing};if e=keeper.Keep(ctx,key);e!=nil{return e}}\n return nil\n}\nfunc(s *Service) finishStorageApplication(ctx context.Context,revision uint64,owner string,policy storagepolicy.Policy,m storageMessage,diagnostic string)error{\n tx,e:=s.begin(ctx);if e!=nil{return e};defer tx.Rollback()\n var valid bool\n if tx.QueryRowContext(ctx,`SELECT lease_owner=? AND lease_until>UTC_TIMESTAMP(6) FROM chat_storage_applications WHERE revision=? FOR UPDATE`,owner,revision).Scan(&valid)!=nil{return ports.ErrUnavailable};if !valid{return ports.ErrBusy}\n var change uint64\n if tx.QueryRowContext(ctx,`SELECT last_change_seq FROM chat_conversations WHERE id=? FOR UPDATE`,string(m.cid)).Scan(&change)!=nil{return ports.ErrUnavailable}\n var state string;var version,retention uint64\n if tx.QueryRowContext(ctx,`SELECT state,state_version,retention_policy_version FROM chat_messages WHERE id=? FOR UPDATE`,string(m.id)).Scan(&state,&version,&retention)!=nil{return ports.ErrUnavailable}\n changed:=false\n if diagnostic==\"\"&&state==\"published\"&&m.state==state&&version==m.version&&retention<revision{\n  rule,e:=policy.Rule(m.kind);if e!=nil{return ports.ErrUnavailable}\n  if change==^uint64(0)||version==^uint64(0){return ports.ErrUnavailable};change++\n  var days any;if rule.Mode==\"days\"{days=rule.Days}\n  if _,e=tx.ExecContext(ctx,`UPDATE chat_messages SET retention_policy_version=?,retention_mode=?,expires_at=IF(? IS NULL,NULL,TIMESTAMPADD(DAY,?,created_at)),state_version=state_version+1 WHERE id=?`,revision,rule.Mode,days,days,string(m.id));e!=nil{return ports.ErrUnavailable}\n  if _,e=tx.ExecContext(ctx,`INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,?, 'message.retention',UTC_TIMESTAMP(6))`,string(m.cid),change,string(m.id),version+1);e!=nil{return ports.ErrUnavailable}\n  if _,e=tx.ExecContext(ctx,`UPDATE chat_conversations SET last_change_seq=? WHERE id=?`,change,string(m.cid));e!=nil{return ports.ErrUnavailable};changed=true\n }\n if diagnostic!=\"\"{\n  if _,e=tx.ExecContext(ctx,`INSERT INTO chat_storage_application_errors(revision,message_id,code,created_at) VALUES(?,?,?,UTC_TIMESTAMP(6))`,revision,string(m.id),diagnostic);e!=nil{return ports.ErrUnavailable}\n }\n if _,e=tx.ExecContext(ctx,`UPDATE chat_storage_applications SET last_message_id=?,state='running',errors=errors+?,diagnostic=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE revision=? AND lease_owner=?`,string(m.id),boolInt(diagnostic!=\"\"),nullableString(diagnostic),revision,owner);e!=nil{return ports.ErrUnavailable}\n if tx.Commit()!=nil{return ports.ErrUnavailable}\n if changed&&s.publisher!=nil{s.publisher.Changed(ports.CommittedMessage{ConversationID:m.cid,Seq:decimal(m.seq),PolicyVersion:m.policyVersion})}\n return nil\n}\nfunc boolInt(v bool)int{if v{return 1};return 0}\nfunc nullableString(v string)any{if v==\"\"{return nil};return v}\n","chat/internal/message/storage_tiering.go":"package message\nimport(\n \"context\"\n \"database/sql\"\n \"time\"\n \"github.com/franz-9527/workers/chat/internal/ports\"\n \"github.com/franz-9527/workers/chat/internal/storagepolicy\"\n)\ntype objectTierer interface{LowFrequency(context.Context,string)error}\n// This operation never downloads or transcodes media. The disabled default\n// returns before contacting Qiniu. Ordinary access stamps last_access_at.\nfunc(s *Service)TierOne(ctx context.Context)error{\n tx,e:=s.begin(ctx);if e!=nil{return e};defer tx.Rollback()\n settings,e:=storagepolicy.Load(ctx,tx);if e!=nil{return e};t:=settings.Policy.Tiering;if !t.Enabled{return nil}\n type candidate struct{key string;upload ports.ID;av bool};var v candidate\n remaining:=int(t.RemainingDays);age,idle:=int(t.AgeDays),int(t.IdleDays)\n // Use only formal live references. Source parts, review chunks, evidence and\n // orphans are never tiered; finite objects need more than the minimum billing period.\n if t.Images&&s.media!=nil{\n  e=tx.QueryRowContext(ctx,`SELECT o.object_key,CAST(o.upload_id AS CHAR) FROM chat_image_objects o JOIN chat_image_uploads u ON u.id=o.upload_id WHERE o.storage_class=0 AND o.size_bytes>=? AND o.created_at<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) AND COALESCE(o.last_access_at,o.created_at)<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) AND u.legal_hold=0 AND EXISTS(SELECT 1 FROM chat_image_items i JOIN chat_messages m ON m.id=i.message_id WHERE i.item_id=u.id AND m.state='published' AND (m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>TIMESTAMPADD(DAY,?,UTC_TIMESTAMP(6)))) ORDER BY o.object_key LIMIT 1`,t.MinBytes,age,idle,remaining).Scan(&v.key,&v.upload)\n  if e!=nil&&e!=sql.ErrNoRows{return ports.ErrUnavailable}\n }\n if v.key==\"\"&&(t.Audio||t.Videos)&&s.av!=nil{\n  e=tx.QueryRowContext(ctx,`SELECT o.object_key,CAST(o.upload_id AS CHAR) FROM chat_av_objects o JOIN chat_av_uploads u ON u.id=o.upload_id WHERE o.storage_class=0 AND o.role='main' AND o.size_bytes>=? AND o.created_at<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) AND COALESCE(o.last_access_at,o.created_at)<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) AND u.legal_hold=0 AND (u.kind='audio' AND ?=1 OR u.kind='video' AND ?=1) AND EXISTS(SELECT 1 FROM chat_av_items i JOIN chat_messages m ON m.id=i.message_id WHERE i.upload_id=u.id AND m.state='published' AND (m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>TIMESTAMPADD(DAY,?,UTC_TIMESTAMP(6)))) ORDER BY o.object_key LIMIT 1`,t.MinBytes,age,idle,t.Audio,t.Videos,remaining).Scan(&v.key,&v.upload);v.av=true\n  if e!=nil&&e!=sql.ErrNoRows{return ports.ErrUnavailable}\n }\n if v.key==\"\"{return nil}\n table,uploads:=\"chat_image_objects\",\"chat_image_uploads\";var provider objectTierer\n if v.av{table,uploads=\"chat_av_objects\",\"chat_av_uploads\";provider,_=s.av.storage.(objectTierer)}else{provider,_=s.media.storage.(objectTierer)}\n if provider==nil{return ErrMedia}\n var hold bool\n if tx.QueryRowContext(ctx,\"SELECT legal_hold FROM \"+uploads+\" WHERE id=? FOR UPDATE\",string(v.upload)).Scan(&hold)!=nil{return ports.ErrUnavailable};if hold{return nil}\n var class int;var accessed sql.NullTime\n if tx.QueryRowContext(ctx,\"SELECT storage_class,last_access_at FROM \"+table+\" WHERE object_key=? FOR UPDATE\",v.key).Scan(&class,&accessed)!=nil{return ports.ErrUnavailable}\n if class!=0||accessed.Valid&&time.Since(accessed.Time)<time.Duration(t.IdleDays)*24*time.Hour{return nil}\n // Keep the shared policy lock until the bounded request completes; a\n // concurrent disable cannot commit while an old policy begins a cloud change.\n work,cancel:=context.WithTimeout(ctx,3*time.Second);defer cancel()\n if e=provider.LowFrequency(work,v.key);e!=nil{return e}\n if _,e=tx.ExecContext(ctx,\"UPDATE \"+table+\" SET storage_class=1 WHERE object_key=?\",v.key);e!=nil||tx.Commit()!=nil{return ports.ErrUnavailable}\n return nil\n}\n","chat/internal/message/unread.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nconst unreadCountLimit = 1000\n\ntype UnreadWindow struct {\n\tCountCapped    bool       `json:\"unread_count_capped\"`\n\tReadSeq        ports.ID   `json:\"read_seq\"`\n\tSnapshotSeq    ports.ID   `json:\"snapshot_max_seq\"`\n\tSnapshotChange ports.ID   `json:\"snapshot_max_change_seq\"`\n\tPolicyVersion  ports.ID   `json:\"policy_version\"`\n\tCount          uint64     `json:\"unread_count\"`\n\tFirstMessage   ports.ID   `json:\"first_unread_message_id,omitempty\"`\n\tFirstSeq       ports.ID   `json:\"first_unread_seq,omitempty\"`\n\tLastMessageAt  *time.Time `json:\"last_message_at,omitempty\"`\n LastMessage *MessageView `json:\"last_message,omitempty\"`\n OrderContext *ports.OrderContext `json:\"order_context,omitempty\"`\n MemberRole string `json:\"member_role\"`\n CanSend bool `json:\"can_send\"`\n ConversationState string `json:\"conversation_state\"`\n Preferences *Preferences `json:\"preferences,omitempty\"`\n}\n\n// unreadLocked counts actual currently eligible incoming published messages,\n// never the gap between sequence numbers. Call only under AuthorizeLocked.\nfunc unreadLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, id ports.ID, grant ports.Grant, read, upper, change uint64) (UnreadWindow, error) {\n\tif read > upper {\n\t\treturn UnreadWindow{}, ports.ErrInvalid\n\t}\n\tresult := UnreadWindow{ReadSeq: decimal(read), SnapshotSeq: decimal(upper), SnapshotChange: decimal(change), PolicyVersion: grant.Version, OrderContext: grant.OrderContext, MemberRole: grant.MemberRole, CanSend: grant.CanSend}\n\t// Activity belongs to the last message this member may see, including their\n\t// own messages and recall placeholders. Read acknowledgements never move it.\n\tvar preview MessageView\n var text sql.NullString\n err := tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),CAST(m.policy_version AS CHAR),m.message_type,CASE WHEN m.state='published' AND NOT COALESCE((m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>UTC_TIMESTAMP(6)),0) THEN 'expired' ELSE m.state END,CAST(m.state_version AS CHAR),CASE WHEN m.state='published' AND COALESCE((m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>UTC_TIMESTAMP(6)),0) AND m.message_type='text' THEN LEFT(m.text_body,160) ELSE NULL END,m.created_at,(SELECT COUNT(*) FROM chat_image_items ci WHERE ci.message_id=m.id),m.retention_mode,m.expires_at FROM chat_messages m WHERE m.conversation_id=? AND m.seq<=? AND m.policy_version<=? AND EXISTS (\n SELECT 1 FROM chat_member_intervals i WHERE i.conversation_id=m.conversation_id AND i.actor_id=?\n AND i.start_version<=m.policy_version AND (i.end_version IS NULL OR i.end_version>m.policy_version)) ORDER BY m.seq DESC LIMIT 1`, string(id), upper, string(grant.Version), string(p.ActorID)).Scan(&preview.ID,&preview.Seq,&preview.SenderID,&preview.PolicyVersion,&preview.Type,&preview.State,&preview.StateVersion,&text,&preview.CreatedAt,&preview.ImageCount,&preview.RetentionMode,&preview.ExpiresAt)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif err == nil {\n\t\tpreview.CreatedAt = preview.CreatedAt.UTC()\n  result.LastMessageAt = &preview.CreatedAt\n  if preview.State == \"published\" && preview.Type == \"text\" && text.Valid { value:=text.String; preview.Text=&value }\n  if preview.State != \"published\" && preview.State != \"recalled\" && preview.State != \"blocked\" && preview.State != \"expired\" { preview.State=\"unavailable\"; preview.Text=nil }\n  result.LastMessage = &preview\n\t}\n\tprefs, err := preferenceLocked(ctx,tx,p,id,grant)\n if err != nil { return UnreadWindow{},err }\n prefs.AccountRevision,err=accountRevision(ctx,tx,p.ActorID);if err!=nil{return UnreadWindow{},err};result.Preferences=&prefs\n if tx.QueryRowContext(ctx, `SELECT state FROM chat_conversations WHERE id=?`,string(id)).Scan(&result.ConversationState)!=nil{return UnreadWindow{},ports.ErrUnavailable}\n predicate := `m.conversation_id=? AND m.seq>? AND m.seq<=? AND m.state='published' AND COALESCE((m.retention_mode='permanent' AND m.expires_at IS NULL OR m.retention_mode='days' AND m.expires_at>UTC_TIMESTAMP(6)),0) AND m.sender_id<>? AND m.policy_version<=? AND EXISTS (\n SELECT 1 FROM chat_member_intervals i WHERE i.conversation_id=m.conversation_id AND i.actor_id=?\n AND i.start_version<=m.policy_version AND (i.end_version IS NULL OR i.end_version>m.policy_version))`\n\targs := []any{string(id), read, upper, string(p.ActorID), string(grant.Version), string(p.ActorID)}\n\tif err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM (SELECT m.id FROM chat_messages m FORCE INDEX (idx_chat_unread) WHERE `+predicate+` LIMIT 1001) unread_candidates`, args...).Scan(&result.Count); err != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif result.Count > unreadCountLimit {\n\t\tresult.Count = unreadCountLimit\n\t\tresult.CountCapped = true\n\t}\n\tvar first, seq string\n\te := tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR) FROM chat_messages m FORCE INDEX (idx_chat_unread) WHERE `+predicate+` ORDER BY m.seq ASC LIMIT 1`, args...).Scan(&first, &seq)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif e == nil {\n\t\tresult.FirstMessage = ports.ID(first)\n\t\tresult.FirstSeq = ports.ID(seq)\n\t}\n\treturn result, nil\n}\n\n// unreadSince is for trusted server-side preloaded watermarks and tests; HTTP\n// consumers must use Unread, which reads the watermark inside its own lock.\nfunc (s *HistoryService) unreadSince(ctx context.Context, p ports.Principal, id ports.ID, readSeq ports.ID) (UnreadWindow, error) {\n\tif !validID(id) || !readSeq.Valid() || p.Environment != s.environment {\n\t\treturn UnreadWindow{}, ports.ErrInvalid\n\t}\n\tread, _ := strconv.ParseUint(string(readSeq), 10, 64)\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tvar upper, change uint64\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&upper, &change) != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tout, e := unreadLocked(ctx, tx, p, id, g, read, upper, change)\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn UnreadWindow{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// Unread obtains authorization, committed max sequence, persisted watermark,\n// publication states and membership ranges in one transaction. No read\n// acknowledgement is created by opening an unread/digest endpoint.\nfunc (s *HistoryService) Unread(ctx context.Context, p ports.Principal, id ports.ID) (UnreadWindow, error) {\n\tif !validID(id) || !p.ActorID.Valid() || p.Environment != s.environment {\n\t\treturn UnreadWindow{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tvar upper, change, read uint64\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&upper, &change) != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tvar hash string\n\te = tx.QueryRowContext(ctx, `SELECT member_key_hash,read_seq FROM chat_member_reads WHERE conversation_id=? AND actor_id=?`, string(id), string(p.ActorID)).Scan(&hash, &read)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif e == sql.ErrNoRows || hash != memberHash(g.MemberKey) {\n\t\tread = 0\n\t}\n\tout, e := unreadLocked(ctx, tx, p, id, g, read, upper, change)\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn UnreadWindow{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n","chat/internal/message/unread_integration_test.go":"package message\n\nimport (\n    \"context\"\n    \"testing\"\n    \"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestMySQLS09UnreadEligibilityAndAnchor(t *testing.T) {\n    f, _, h, r := historyFixture(t, 6)\n    // S08 fixture sends as 10202. A sender's own published messages are never unread.\n    p, err := h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"0\")\n    if err != nil || p.Count != 0 || p.FirstMessage != \"\" || p.SnapshotSeq != \"6\" {\n        t.Fatalf(\"self messages counted: %+v, %v\", p, err)\n    }\n    f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq IN (2,3,5)`, string(r.ConversationID))\n    f.exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=3`, string(r.ConversationID))\n    p, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"1\")\n    if err != nil || p.Count != 2 || p.FirstSeq != \"2\" || p.FirstMessage == \"\" {\n        t.Fatalf(\"incorrect unread window: %+v, %v\", p, err)\n    }\n    p, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"2\")\n    if err != nil || p.Count != 1 || p.FirstSeq != \"5\" {\n        t.Fatalf(\"read through anchor: %+v, %v\", p, err)\n    }\n    if _, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"7\"); err != ports.ErrInvalid {\n        t.Fatalf(\"future watermark accepted: %v\", err)\n    }\n    if _, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"not-a-number\"); err != ports.ErrInvalid {\n        t.Fatalf(\"invalid watermark accepted: %v\", err)\n    }\n    f.exec(`UPDATE chat_messages SET policy_version=999 WHERE conversation_id=? AND seq=5`, string(r.ConversationID))\n    p, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"2\")\n    if err != nil || p.Count != 0 {\n        t.Fatalf(\"future policy visible: %+v, %v\", p, err)\n    }\n}\n","chat/internal/moderation/av.go":"package moderation\n\nimport(\n \"context\"\n \"bytes\"\n \"database/sql\"\n \"encoding/json\"\n \"io\"\n \"net\"\n \"net/http\"\n \"net/url\"\n \"regexp\"\n \"strings\"\n \"time\"\n \"unicode/utf8\"\n \"github.com/franz-9527/workers/chat/internal/ports\"\n)\nconst ASRServiceID=\"wxa8386175898e12c9\"\ntype AVConfig struct{APIName string `json:\"api_name\"`;DataEncoding string `json:\"data_encoding\"`}\ntype AV struct{s *Service;c AVConfig;client HTTPClient;gate chan struct{}}\nfunc NewAV(s *Service,c AVConfig,client HTTPClient)(*AV,error){\n if s==nil||!regexp.MustCompile(`^[A-Za-z0-9_]{1,128}$`).MatchString(c.APIName)||(c.DataEncoding!=\"object\"&&c.DataEncoding!=\"json_string\"){return nil,ports.ErrInvalid}\n if client==nil{client=&http.Client{Timeout:12*time.Second,CheckRedirect:func(*http.Request,[]*http.Request)error{return http.ErrUseLastResponse},Transport:&http.Transport{Proxy:nil,DialContext:(&net.Dialer{Timeout:3*time.Second}).DialContext,MaxConnsPerHost:1,ResponseHeaderTimeout:10*time.Second}}}\n return &AV{s,c,client,make(chan struct{},1)},nil\n}\nfunc(a *AV)MediaAppID()string{return a.s.appID}\nfunc(a *AV)binding(ctx context.Context,q ports.AudioInspectionRequest)(binding,Credential,error){\n if q.Actor.Kind!=\"mini\"||!validID(q.IntentID)||!validID(q.ConversationID)||!hexPattern.MatchString(q.ObjectHash)||q.Segment<0||q.Segment>1||!hexPattern.MatchString(q.UserAudioKey){return binding{},Credential{},ports.ErrInvalid}\n u,e:=url.Parse(q.URL);if e!=nil||u.Scheme!=\"https\"||u.Host==\"\"||u.User!=nil||u.Fragment!=\"\"{return binding{},Credential{},ports.ErrInvalid}\n identity,e:=a.s.identity(ctx,q.Actor,nil);if e!=nil{return binding{},Credential{},e}\n credential,e:=a.s.credentials.Get();return identity,credential,e\n}\nfunc(a *AV)call(ctx context.Context,path string,c Credential,body any)([]byte,bool,error){\n raw,e:=json.Marshal(body);if e!=nil{return nil,false,e}\n req,e:=http.NewRequestWithContext(ctx,\"POST\",\"https://api.weixin.qq.com\"+path+\"?\"+url.Values{\"access_token\":{c.Token}}.Encode(),strings.NewReader(string(raw)));if e!=nil{return nil,false,e}\n req.Header.Set(\"Content-Type\",\"application/json\");req.Header.Set(\"Accept\",\"application/json\")\n res,e:=a.client.Do(req);if e!=nil||res==nil||res.Body==nil{return nil,true,ports.ErrUnavailable}\n defer res.Body.Close();raw,e=io.ReadAll(io.LimitReader(res.Body,65537));if e!=nil||len(raw)>65536||res.StatusCode!=200{return nil,true,ports.ErrUnavailable}\n return raw,true,nil\n}\nfunc(a *AV)Recognize(ctx context.Context,q ports.AudioInspectionRequest)(ports.Transcription,error){\n out:=ports.Transcription{ServiceID:ASRServiceID,APIName:a.c.APIName,Engine:\"16k_zh\",Known:true,Retryable:true}\n select{case a.gate<-struct{}{}:defer func(){<-a.gate}();default:return out,ports.ErrBusy}\n identity,c,e:=a.binding(ctx,q);if e!=nil{return out,e}\n data:=any(map[string]any{\"Action\":\"SentenceRecognition\",\"Version\":\"2019-06-14\",\"ProjectId\":0,\"SubServiceType\":2,\"EngSerViceType\":\"16k_zh\",\"SourceType\":0,\"VoiceFormat\":\"mp3\",\"Url\":q.URL,\"UsrAudioKey\":q.UserAudioKey})\n if a.c.DataEncoding==\"json_string\"{raw,_:=json.Marshal(data);data=string(raw)}\n raw,dispatched,e:=a.call(ctx,\"/wxa/servicemarket\",c,map[string]any{\"service\":ASRServiceID,\"api\":a.c.APIName,\"client_msg_id\":q.UserAudioKey,\"data\":data})\n out.Dispatched=dispatched;out.Known=!dispatched;out.AuthorityProof=identity.proof\n if e!=nil{return out,e}\n var response struct{Code *int `json:\"errcode\"`;Data json.RawMessage `json:\"data\"`}\n if !avJSON(raw,&response)||response.Code==nil{return out,ports.ErrUnavailable}\n if *response.Code!=0{out.Known=true;out.Retryable=*response.Code==40001||*response.Code==40014||*response.Code==42001||*response.Code==-1;if out.Retryable{a.s.credentials.Reject(c.Generation)};return out,ports.ErrUnavailable}\n dataRaw:=response.Data\n var encoded string;if json.Unmarshal(dataRaw,&encoded)==nil{dataRaw=[]byte(encoded)}\n var result struct{Response *struct{Result *string `json:\"Result\"`;RequestID string `json:\"RequestId\"`;Error json.RawMessage `json:\"Error\"`} `json:\"Response\"`}\n if !avJSON(dataRaw,&result)||result.Response==nil||result.Response.Result==nil||len(result.Response.Error)>0&&string(result.Response.Error)!=\"null\"||result.Response.RequestID==\"\"||!tracePattern.MatchString(result.Response.RequestID)||!utf8.ValidString(*result.Response.Result)||utf8.RuneCountInString(*result.Response.Result)>1000{return out,ports.ErrUnavailable}\n out.Text=*result.Response.Result;out.RequestID=result.Response.RequestID;out.Known=true;out.Retryable=false;return out,nil\n}\nfunc(a *AV)SubmitAudio(ctx context.Context,q ports.AudioInspectionRequest)(ports.AudioTicket,error){\n out:=ports.AudioTicket{Known:true,Retryable:true}\n identity,c,e:=a.binding(ctx,q);if e!=nil{return out,e}\n raw,dispatched,e:=a.call(ctx,\"/wxa/media_check_async\",c,map[string]any{\"version\":2,\"scene\":1,\"openid\":identity.openid,\"media_url\":q.URL,\"media_type\":1})\n out.Dispatched=dispatched;out.Known=!dispatched;out.AuthorityProof=identity.proof\n if e!=nil{return out,e}\n var response struct{Code *int `json:\"errcode\"`;Trace string `json:\"trace_id\"`}\n if !avJSON(raw,&response)||response.Code==nil{return out,ports.ErrUnavailable}\n if *response.Code!=0{out.Known=true;out.Retryable=*response.Code==40001||*response.Code==40014||*response.Code==42001||*response.Code==-1;return out,ports.ErrUnavailable}\n if response.Trace==\"\"||!tracePattern.MatchString(response.Trace){return out,ports.ErrUnavailable}\n out.TraceID=response.Trace;out.Known=true;out.Retryable=false;return out,nil\n}\nfunc(s *Service)MediaProof(ctx context.Context,p ports.Principal)(ports.SafetyResult,error){\n v,e:=s.identity(ctx,p,nil);return ports.SafetyResult{Decision:\"media_identity\",RuleVersion:RuleVersion,AuthorityProof:v.proof},e\n}\nfunc(s *Service)ValidateMediaProofLocked(ctx context.Context,tx *sql.Tx,p ports.Principal,v ports.SafetyResult)error{\n if v.Decision!=\"media_identity\"{return ports.ErrInvalid};return s.ValidateTextLocked(ctx,tx,p,v)\n}\n\nfunc avJSON(raw []byte,target any)bool{\n d:=json.NewDecoder(bytes.NewReader(raw))\n var walk func(int)bool\n walk=func(depth int)bool{\n  if depth>12{return false};t,e:=d.Token();if e!=nil{return false}\n  switch t{\n  case json.Delim('{'):\n   seen:=map[string]bool{};for d.More(){k,e:=d.Token();name,ok:=k.(string);if e!=nil||!ok||seen[name]{return false};seen[name]=true;if !walk(depth+1){return false}};t,e=d.Token();return e==nil&&t==json.Delim('}')\n  case json.Delim('['):\n   n:=0;for d.More(){n++;if n>100||!walk(depth+1){return false}};t,e=d.Token();return e==nil&&t==json.Delim(']')\n  };return true\n }\n if !walk(0){return false};if _,e:=d.Token();e!=io.EOF{return false}\n return json.Unmarshal(raw,target)==nil\n}\n","chat/internal/moderation/media_callback.go":"package moderation\nimport(\n \"context\"\n \"crypto/aes\"\n \"crypto/cipher\"\n \"crypto/sha1\"\n \"crypto/subtle\"\n \"encoding/base64\"\n \"encoding/binary\"\n \"encoding/hex\"\n \"encoding/json\"\n \"encoding/xml\"\n \"io\"\n \"net/http\"\n \"sort\"\n \"strconv\"\n \"strings\"\n \"time\"\n \"github.com/franz-9527/workers/chat/internal/ports\"\n)\ntype AudioReceiver interface{ReceiveAudio(context.Context,ports.AudioReceipt)error}\ntype MediaCallback struct{AppID,Token string;Key []byte;Receiver AudioReceiver}\nfunc NewMediaCallback(appID,token,key string,r AudioReceiver)(*MediaCallback,error){\n raw,e:=base64.StdEncoding.DecodeString(key+\"=\")\n if !appPattern.MatchString(appID)||len(token)<16||len(token)>128||e!=nil||len(raw)!=32||r==nil{return nil,ports.ErrInvalid}\n return &MediaCallback{appID,token,raw,r},nil\n}\nfunc(h *MediaCallback)decrypt(signature,timestamp,nonce,encoded string,now time.Time)([]byte,error){\n stamp,e:=strconv.ParseInt(timestamp,10,64);if e!=nil||len(nonce)<1||len(nonce)>128||now.Unix()-stamp>300||stamp-now.Unix()>300{return nil,ports.ErrInvalid}\n parts:=[]string{h.Token,timestamp,nonce,encoded};sort.Strings(parts);sum:=sha1.Sum([]byte(strings.Join(parts,\"\")))\n if subtle.ConstantTimeCompare([]byte(signature),[]byte(hex.EncodeToString(sum[:])))!=1{return nil,ports.ErrInvalid}\n raw,e:=base64.StdEncoding.DecodeString(encoded);if e!=nil||len(raw)<32||len(raw)>65536||len(raw)%16!=0{return nil,ports.ErrInvalid}\n block,e:=aes.NewCipher(h.Key);if e!=nil{return nil,ports.ErrInvalid};plain:=make([]byte,len(raw));cipher.NewCBCDecrypter(block,h.Key[:16]).CryptBlocks(plain,raw)\n padding:=int(plain[len(plain)-1]);if padding<1||padding>32||padding>len(plain){return nil,ports.ErrInvalid}\n for _,v:=range plain[len(plain)-padding:]{if int(v)!=padding{return nil,ports.ErrInvalid}}\n plain=plain[:len(plain)-padding];if len(plain)<20{return nil,ports.ErrInvalid};size:=int(binary.BigEndian.Uint32(plain[16:20]))\n if size<1||size>len(plain)-20||string(plain[20+size:])!=h.AppID{return nil,ports.ErrInvalid}\n return plain[20:20+size],nil\n}\nfunc(h *MediaCallback)ServeHTTP(w http.ResponseWriter,r *http.Request){\n w.Header().Set(\"Cache-Control\",\"no-store\");w.Header().Set(\"Content-Type\",\"text/plain; charset=utf-8\")\n if r.Method!=\"POST\"&&r.Method!=\"GET\"{w.WriteHeader(405);return}\n q:=r.URL.Query();encrypted:=q.Get(\"echostr\")\n if r.Method==\"POST\"{\n  raw,e:=io.ReadAll(io.LimitReader(r.Body,65537));if e!=nil||len(raw)>65536{w.WriteHeader(400);return}\n  var wrapper struct{Encrypt string `json:\"Encrypt\" xml:\"Encrypt\"`}\n  if json.Unmarshal(raw,&wrapper)!=nil&&xml.Unmarshal(raw,&wrapper)!=nil{w.WriteHeader(400);return};encrypted=wrapper.Encrypt\n }\n raw,e:=h.decrypt(q.Get(\"msg_signature\"),q.Get(\"timestamp\"),q.Get(\"nonce\"),encrypted,time.Now());if e!=nil{w.WriteHeader(403);return}\n if r.Method==\"GET\"{w.Write(raw);return}\n var event struct{\n  AppID string `json:\"appid\" xml:\"appid\"`;Event string `json:\"Event\" xml:\"Event\"`;Trace string `json:\"trace_id\" xml:\"trace_id\"`;Version int `json:\"version\" xml:\"version\"`\n  Result struct{Suggest string `json:\"suggest\" xml:\"suggest\"`} `json:\"result\" xml:\"result\"`\n }\n if json.Unmarshal(raw,&event)!=nil&&xml.Unmarshal(raw,&event)!=nil{w.WriteHeader(400);return}\n if event.AppID!=h.AppID||event.Event!=\"wxa_media_check\"||event.Version!=2||event.Trace==\"\"||!tracePattern.MatchString(event.Trace){w.WriteHeader(400);return}\n decision:=event.Result.Suggest;if decision!=\"pass\"&&decision!=\"risky\"&&decision!=\"review\"{decision=\"error\"}\n receipt:=ports.AudioReceipt{AppID:h.AppID,TraceID:event.Trace,Decision:decision,Code:\"official_\"+decision,Fingerprint:hash(h.AppID+\"\\n\"+event.Trace+\"\\n\"+decision)}\n if h.Receiver.ReceiveAudio(r.Context(),receipt)!=nil{w.WriteHeader(503);return}\n io.WriteString(w,\"success\")\n}\n","chat/internal/moderation/media_callback_test.go":"package moderation\nimport(\n \"bytes\"\n \"crypto/aes\"\n \"crypto/cipher\"\n \"crypto/sha1\"\n \"encoding/base64\"\n \"encoding/binary\"\n \"encoding/hex\"\n \"sort\"\n \"strings\"\n \"testing\"\n \"time\"\n)\nfunc TestMediaCallbackAuthenticatedEnvelope(t *testing.T){\n h:=&MediaCallback{AppID:\"wx0123456789abcdef\",Token:strings.Repeat(\"t\",24),Key:bytes.Repeat([]byte(\"k\"),32)}\n now:=time.Unix(1800000000,0);body:=[]byte(`{\"Event\":\"wxa_media_check\"}`)\n plain:=append(bytes.Repeat([]byte(\"r\"),16),0,0,0,0);binary.BigEndian.PutUint32(plain[16:20],uint32(len(body)));plain=append(plain,body...);plain=append(plain,[]byte(h.AppID)...)\n padding:=32-len(plain)%32;plain=append(plain,bytes.Repeat([]byte{byte(padding)},padding)...)\n block,_:=aes.NewCipher(h.Key);encrypted:=make([]byte,len(plain));cipher.NewCBCEncrypter(block,h.Key[:16]).CryptBlocks(encrypted,plain)\n encoded:=base64.StdEncoding.EncodeToString(encrypted);parts:=[]string{h.Token,\"1800000000\",\"nonce\",encoded};sort.Strings(parts);sum:=sha1.Sum([]byte(strings.Join(parts,\"\")));sig:=hex.EncodeToString(sum[:])\n out,e:=h.decrypt(sig,\"1800000000\",\"nonce\",encoded,now);if e!=nil||!bytes.Equal(out,body){t.Fatal(e)}\n if _,e=h.decrypt(strings.Repeat(\"0\",40),\"1800000000\",\"nonce\",encoded,now);e==nil{t.Fatal(\"unsigned callback\")}\n if _,e=h.decrypt(sig,\"1800000000\",\"nonce\",encoded,now.Add(301*time.Second));e==nil{t.Fatal(\"replay window\")}\n h.AppID=\"wx1111111111111111\";if _,e=h.decrypt(sig,\"1800000000\",\"nonce\",encoded,now);e==nil{t.Fatal(\"other app accepted\")}\n}\nfunc TestAVProviderJSONRejectsDuplicatesAllowsDocumentedCase(t *testing.T){\n var out any\n if !avJSON([]byte(`{\"Response\":{\"Result\":\"\",\"RequestId\":\"id\"}}`),&out){t.Fatal(\"provider case rejected\")}\n for _,raw:=range []string{`{\"errcode\":0,\"errcode\":1}`,`{\"data\":{\"Result\":\"a\",\"Result\":\"b\"}}`,`{}{}`}{if avJSON([]byte(raw),&out){t.Fatal(raw)}}\n}\n","chat/internal/moderation/rules.go":"package moderation\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n)\n\nconst RuleVersion = \"wechat-v2.diversion-20261022.1\"\n\nvar appPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{1,64}$`)\nvar tokenPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{10,}$`)\nvar hexPattern = regexp.MustCompile(`^[a-f0-9]{64}$`)\nvar openIDPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{20,64}$`)\nvar clauses = regexp.MustCompile(`[，,。！？!?;；\\n]+`)\nvar negated = regexp.MustCompile(`(?:请勿|不要|禁止|不准|不能|别再|拒绝|不允许|不得)(?:私下|私自|绕过平台|发|发送|添加|加|提供|泄露|透露|联系|转账|走私单)`)\nvar mobile = regexp.MustCompile(`(?:^|[^0-9])(?:\\+?86)?(1[3-9][0-9]{9})(?:[^0-9]|$)`)\nvar contact = regexp.MustCompile(`(?:联系我|联系你|联系电话|手机号|手机号码|电话|打给我|致电|加我|拨打|给我打)`)\nvar wechatID = regexp.MustCompile(`(?:微信|weixin|vx|wx|v信|薇信)(?:号|是|为|号码|[:：])*([a-z][a-z0-9_-]{5,19})`)\nvar privateDeal = regexp.MustCompile(`(?:绕过平台|不要走平台|不走平台|别走平台|避开平台|私下接单|私下成交|私下交易|私下转账|私下做|私下付款|省掉服务费|绕过服务费|取消订单.{0,24}私下|私下.{0,24}取消订单)`)\nvar englishDigit = regexp.MustCompile(`\\b(zero|one|two|three|four|five|six|seven|eight|nine|ling|yao|yi|er|san|si|wu|liu|qi|ba|jiu)\\b`)\nvar digitWords = map[string]string{\"zero\": \"0\", \"one\": \"1\", \"two\": \"2\", \"three\": \"3\", \"four\": \"4\", \"five\": \"5\", \"six\": \"6\", \"seven\": \"7\", \"eight\": \"8\", \"nine\": \"9\", \"ling\": \"0\", \"yao\": \"1\", \"yi\": \"1\", \"er\": \"2\", \"san\": \"3\", \"si\": \"4\", \"wu\": \"5\", \"liu\": \"6\", \"qi\": \"7\", \"ba\": \"8\", \"jiu\": \"9\"}\n\nfunc validEnvironment(e string) bool { return e == \"production\" || e == \"development\" || e == \"test\" }\nfunc normalize(text string) string {\n\tvar b strings.Builder\n\tfor _, r := range strings.ToLower(text) {\n\t\tif r >= 0xff01 && r <= 0xff5e {\n\t\t\tr -= 0xfee0\n\t\t\tr = unicode.ToLower(r)\n\t\t}\n\t\tif unicode.Is(unicode.Cf, r) {\n\t\t\tcontinue\n\t\t}\n\t\tswitch r {\n\t\tcase '零', '〇', '洞':\n\t\t\tr = '0'\n\t\tcase '一', '壹', '幺':\n\t\t\tr = '1'\n\t\tcase '二', '贰', '两':\n\t\t\tr = '2'\n\t\tcase '三', '叁':\n\t\t\tr = '3'\n\t\tcase '四', '肆':\n\t\t\tr = '4'\n\t\tcase '五', '伍':\n\t\t\tr = '5'\n\t\tcase '六', '陆':\n\t\t\tr = '6'\n\t\tcase '七', '柒', '拐':\n\t\t\tr = '7'\n\t\tcase '八', '捌':\n\t\t\tr = '8'\n\t\tcase '九', '玖', '勾':\n\t\t\tr = '9'\n\t\t}\n\t\tb.WriteRune(r)\n\t}\n\treturn englishDigit.ReplaceAllStringFunc(b.String(), func(v string) string { return digitWords[v] })\n}\nfunc compact(text string) string {\n\treturn strings.Map(func(r rune) rune {\n\t\tif unicode.IsSpace(r) || r == '-' || r == '_' || r == '·' || r == '/' || r == '\\\\' || r == '(' || r == ')' || r == '（' || r == '）' {\n\t\t\treturn -1\n\t\t}\n\t\treturn r\n\t}, text)\n}\n\n// analyze requires contextual evidence. A bare 11-digit number, quote/size,\n// order number, approved order contact entry or a warning is not a violation.\n// Context contains at most five same-author/same-conversation logical actions.\nfunc analyze(text string, previous []string) string {\n\tclean := func(s string) string {\n\t\tparts := clauses.Split(normalize(s), -1)\n\t\tout := make([]string, 0, len(parts))\n\t\tfor _, p := range parts {\n\t\t\tif !negated.MatchString(p) {\n\t\t\t\tout = append(out, p)\n\t\t\t}\n\t\t}\n\t\treturn strings.Join(out, \"\")\n\t}\n\tcurrent := clean(text)\n\tif privateDeal.MatchString(compact(current)) {\n\t\treturn \"off_platform_deal\"\n\t}\n\tif strings.Contains(current, \"weixin://\") {\n\t\treturn \"private_contact_link\"\n\t}\n\tif wechatEvidence(compact(current)) {\n\t\treturn \"private_wechat\"\n\t}\n\tif contact.MatchString(current) && mobile.MatchString(compact(current)) {\n\t\treturn \"private_phone\"\n\t}\n\t// Never turn a currently negated instruction into evidence by concatenating\n\t// a previous fragment. Old lawful/blocked fragments are context, not new risk.\n\tif current == \"\" {\n\t\treturn \"\"\n\t}\n\tprior := \"\"\n\tfor _, p := range previous {\n\t\tprior += clean(p)\n\t}\n\tjoined := prior + current\n\tif contact.MatchString(joined) && mobile.MatchString(compact(joined)) && !(contact.MatchString(prior) && mobile.MatchString(compact(prior))) {\n\t\t// Require the current action to contribute at least one digit/contact cue;\n\t\t// an unrelated later greeting must not become a fresh violation.\n\t\tif strings.ContainsAny(compact(current), \"0123456789\") || contact.MatchString(current) {\n\t\t\treturn \"split_private_phone\"\n\t\t}\n\t}\n\tif !wechatEvidence(compact(prior)) && wechatEvidence(compact(joined)) && (strings.ContainsAny(current, \"abcdefghijklmnopqrstuvwxyz0123456789\") || strings.Contains(current, \"微信\")) {\n\t\treturn \"split_private_wechat\"\n\t}\n\treturn \"\"\n}\nfunc validText(s string) bool {\n\treturn utf8.ValidString(s) && len(s) > 0 && len(s) <= 4000 && utf8.RuneCountInString(s) <= 2000 && strings.TrimSpace(s) != \"\" && !strings.ContainsRune(s, 0)\n}\n\nvar wechatCue = regexp.MustCompile(`(?:加我|加你|添加|加好友|加微信|加vx|加wx|微信号|vx号|我的微信|我的vx|联系|私聊|好友|微信[:：]|vx[:：])`)\n\nfunc wechatEvidence(text string) bool {\n\tif !wechatID.MatchString(text) {\n\t\treturn false\n\t}\n\treturn wechatCue.MatchString(text) || strings.HasPrefix(text, \"微信\") || strings.HasPrefix(text, \"weixin\") || strings.HasPrefix(text, \"vx\") || strings.HasPrefix(text, \"wx\")\n}\n","chat/internal/moderation/rules_test.go":"package moderation\n\nimport \"testing\"\n\nfunc TestDiversionRulesAndConstructionNegatives(t *testing.T) {\n\tcases := []struct {\n\t\ttext     string\n\t\tprevious []string\n\t\tblocked  bool\n\t}{\n\t\t{\"电话 １３８ ００１３ ８０００\", nil, true},\n\t\t{\"联系我 一三八 零零一三 八零零零\", nil, true},\n\t\t{\"电话 one three eight zero zero one three eight zero zero zero\", nil, true},\n\t\t{\"电话 yao san ba ling ling yi san ba ling ling ling\", nil, true},\n\t\t{\"加我 ＶＸ：abc_123456\", nil, true},\n\t\t{\"加微信a\\u200bb\\u200cc123456\", nil, true},\n\t\t{\"weixin://contacts/profile/fixture\", nil, true},\n\t\t{\"取消订单后私下做，省掉服务费\", nil, true},\n\t\t{\"不走平台，这单私下做\", nil, true},\n\t\t{\"13800138000\", nil, false},\n\t\t{\"工单号13800138000，墙长12.5米，面积25平方米，报价1380元\", nil, false},\n\t\t{\"施工20261022138001，预约10:30，五楼二单元三零一\", nil, false},\n\t\t{\"不要私下加微信\", nil, false},\n\t\t{\"禁止绕过平台交易\", nil, false},\n\t\t{\"请勿发送电话13800138000\", nil, false},\n\t\t{\"售后电话请在订单页面查看\", nil, false},\n\t\t{\"请使用订单的联系师傅入口，尾款在原入口确认\", nil, false},\n\t\t{\"加微信\", nil, false},\n\t\t{\"型号VXabc123456，按图施工\", nil, false},\n\t\t{\"材料说明 https://brand.example.test/spec/13800138000\", nil, false},\n\t\t{\"不要私下加微信abc123，但加微信xyz789\", nil, true},\n\t\t{\"38000\", []string{\"电话138001\"}, true},\n\t\t{\"def456\", []string{\"微信abc\"}, true},\n\t\t{\"ok\", []string{\"请勿私下加微信abc123\"}, false},\n\t\t{\"ok\", []string{\"微信abc123456\"}, false},\n\t\t{\"你好\", []string{\"电话13800138000\"}, false},\n\t}\n\tfor _, c := range cases {\n\t\tt.Run(c.text, func(t *testing.T) {\n\t\t\tcode := analyze(c.text, c.previous)\n\t\t\tif (code != \"\") != c.blocked {\n\t\t\t\tt.Fatalf(\"decision %q expected blocked=%v\", code, c.blocked)\n\t\t\t}\n\t\t})\n\t}\n}\n","chat/internal/moderation/service.go":"package moderation\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Config struct {\n\tEnabled        bool   `json:\"enabled\"`\n\tAppID          string `json:\"app_id\"`\n\tCredentialFile string `json:\"credential_file\"`\n}\n\nfunc (c Config) Validate() error {\n\tif !c.Enabled {\n\t\tif c.AppID != \"\" || c.CredentialFile != \"\" {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\treturn nil\n\t}\n\tif !appPattern.MatchString(c.AppID) || !filepath.IsAbs(c.CredentialFile) {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\ntype HTTPClient interface {\n\tDo(*http.Request) (*http.Response, error)\n}\ntype Service struct {\n\tdb                 *sql.DB\n\tsource             *auth.MySQLSource\n\tcredentials        *Credentials\n\tenvironment, appID string\n\tclient             HTTPClient\n\tgate               chan struct{}\n\ttimeout            time.Duration\n}\n\nfunc New(db *sql.DB, environment string, c Config, concurrency int, timeout time.Duration, client HTTPClient) (*Service, error) {\n\tif db == nil || !c.Enabled || c.Validate() != nil || !validEnvironment(environment) || concurrency < 1 || concurrency > 16 || timeout < 100*time.Millisecond || timeout > 2*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tcredentials, e := NewCredentials(c.CredentialFile, environment, c.AppID)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tsource, e := auth.NewMySQLSource(db)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tif client == nil {\n\t\tclient = &http.Client{Timeout: timeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }, Transport: &http.Transport{Proxy: nil, DialContext: (&net.Dialer{Timeout: timeout / 2, KeepAlive: 30 * time.Second}).DialContext, MaxConnsPerHost: concurrency, MaxIdleConns: concurrency, MaxIdleConnsPerHost: concurrency, IdleConnTimeout: 30 * time.Second, ResponseHeaderTimeout: timeout}}\n\t}\n\treturn &Service{db, source, credentials, environment, c.AppID, client, make(chan struct{}, concurrency), timeout}, nil\n}\nfunc (s *Service) CheckText(ctx context.Context, q ports.TextRequest) (ports.SafetyResult, error) {\n\tif q.Actor.Environment != s.environment || q.Actor.Kind != \"mini\" || !validID(q.IntentID) || !validID(q.ConversationID) || !validText(q.Text) || !hexPattern.MatchString(q.Fingerprint) {\n\t\treturn ports.SafetyResult{}, ports.ErrInvalid\n\t}\n\tselect {\n\tcase s.gate <- struct{}{}:\n\t\tdefer func() { <-s.gate }()\n\tdefault:\n\t\treturn ports.SafetyResult{}, ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tidentity, e := s.identity(ctx, q.Actor, nil)\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tcontextItems, e := s.prepare(ctx, q)\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tprevious := make([]string, 0, len(contextItems))\n\tfor _, item := range contextItems {\n\t\tprevious = append(previous, item.NormalizedText)\n\t}\n\tif code := analyze(q.Text, previous); code != \"\" {\n\t\tevidence := \"\"\n\t\tif strings.HasPrefix(code, \"split_\") {\n\t\t\tsnapshot := append(contextItems, contextItem{IntentID: q.IntentID, Fingerprint: q.Fingerprint, NormalizedText: normalize(q.Text)})\n\t\t\traw, _ := json.Marshal(struct {\n\t\t\t\tSchema  int           `json:\"schema\"`\n\t\t\t\tActions []contextItem `json:\"actions\"`\n\t\t\t}{1, snapshot})\n\t\t\tevidence = string(raw)\n\t\t}\n\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: RuleVersion, AuthorityProof: identity.proof, Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: code, Level: 2, Confirmed: true, ContextEvidence: evidence}}, nil\n\t}\n\tcredential, e := s.credentials.Get()\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tkey := hash(strings.Join([]string{s.environment, s.appID, identity.proof, q.Actor.SessionVersion, \"scene:1\", RuleVersion, q.Fingerprint}, \"\\n\"))\n\tvar cached int\n\te = s.db.QueryRowContext(ctx, `SELECT 1 FROM chat_text_checks WHERE cache_key=? AND pass_until>UTC_TIMESTAMP(6) LIMIT 1`, key).Scan(&cached)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tif cached > 0 {\n\t\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: RuleVersion, AuthorityProof: identity.proof}, nil\n\t}\n\tresult, e := s.inspect(ctx, credential, identity.openid, q.Text)\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tresult.RuleVersion = RuleVersion\n\tresult.AuthorityProof = identity.proof\n\tif result.Decision == \"passed\" {\n\t\t// Only an explicit official pass is cached. Local contextual rules always\n\t\t// ran first and cannot be bypassed by a prior hash-only cache hit.\n\t\tif _, e = s.db.ExecContext(ctx, `UPDATE chat_text_checks SET cache_key=?,pass_until=UTC_TIMESTAMP(6)+INTERVAL 5 MINUTE WHERE intent_id=? AND fingerprint=?`, key, string(q.IntentID), q.Fingerprint); e != nil {\n\t\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t\t}\n\t}\n\treturn result, nil\n}\nfunc validID(id ports.ID) bool { return id.Valid() && id != \"0\" }\n\nvar tracePattern = regexp.MustCompile(`^[A-Za-z0-9_-]{0,128}$`)\n\nfunc (s *Service) inspect(ctx context.Context, c Credential, openid, text string) (ports.SafetyResult, error) {\n\tbody, e := json.Marshal(map[string]any{\"version\": 2, \"scene\": 1, \"openid\": openid, \"content\": text})\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tendpoint := \"https://api.weixin.qq.com/wxa/msg_sec_check?\" + url.Values{\"access_token\": []string{c.Token}}.Encode()\n\treq, e := http.NewRequestWithContext(ctx, \"POST\", endpoint, strings.NewReader(string(body)))\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\treq.Header.Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\treq.Header.Set(\"Accept\", \"application/json\")\n\tres, e := s.client.Do(req)\n\tif e != nil || res == nil || res.Body == nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tdefer res.Body.Close()\n\traw, e := io.ReadAll(io.LimitReader(res.Body, (32<<10)+1))\n\tif e != nil || len(raw) > 32<<10 || res.StatusCode != 200 {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tvar response struct {\n\t\tCode    *int   `json:\"errcode\"`\n\t\tMessage string `json:\"errmsg\"`\n\t\tTrace   string `json:\"trace_id\"`\n\t\tResult  *struct {\n\t\t\tSuggest string `json:\"suggest\"`\n\t\t\tLabel   *int   `json:\"label\"`\n\t\t} `json:\"result\"`\n\t\tDetail json.RawMessage `json:\"detail\"`\n\t}\n\tif !strictObject(raw, &response) || response.Code == nil || !tracePattern.MatchString(response.Trace) {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tif *response.Code == 40001 || *response.Code == 40014 || *response.Code == 42001 {\n\t\ts.credentials.Reject(c.Generation)\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tif *response.Code == 87014 {\n\t\treturn ports.SafetyResult{Decision: \"blocked\", Finding: &ports.SafetyFinding{Provider: \"wechat.msg_sec_check.v2\", Code: \"official_risky\", TraceID: response.Trace, Level: 2, Confirmed: true}}, nil\n\t}\n\tif *response.Code != 0 || response.Result == nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tswitch response.Result.Suggest {\n\tcase \"pass\":\n\t\treturn ports.SafetyResult{Decision: \"passed\"}, nil\n\tcase \"risky\":\n\t\treturn ports.SafetyResult{Decision: \"blocked\", Finding: &ports.SafetyFinding{Provider: \"wechat.msg_sec_check.v2\", Code: \"official_risky\", TraceID: response.Trace, Level: 2, Confirmed: true}}, nil\n\tcase \"review\":\n\t\treturn ports.SafetyResult{Decision: \"review\", Finding: &ports.SafetyFinding{Provider: \"wechat.msg_sec_check.v2\", Code: \"official_review\", TraceID: response.Trace, Level: 1, Confirmed: false}}, nil\n\tdefault:\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n}\n\ntype binding struct{ openid, proof string }\n\nfunc (s *Service) identity(ctx context.Context, p ports.Principal, tx *sql.Tx) (binding, error) {\n\towned := tx == nil\n\tif owned {\n\t\tvar e error\n\t\ttx, e = s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\t\tif e != nil {\n\t\t\treturn binding{}, ports.ErrUnavailable\n\t\t}\n\t\tdefer tx.Rollback()\n\t}\n\tif p.Environment != s.environment || p.Kind != \"mini\" {\n\t\treturn binding{}, ports.ErrInvalid\n\t}\n\tif e := s.source.ValidatePrincipalLocked(ctx, tx, p); e != nil {\n\t\treturn binding{}, e\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(id AS CHAR),openid,CAST(session_version AS CHAR) FROM wechat_identities WHERE user_id=? AND app_id=? AND status='active' ORDER BY id LIMIT 2 LOCK IN SHARE MODE`, string(p.ActorID), s.appID)\n\tif e != nil {\n\t\treturn binding{}, ports.ErrUnavailable\n\t}\n\tcount := 0\n\tvar id, openid, version string\n\tfor rows.Next() {\n\t\tif e = rows.Scan(&id, &openid, &version); e != nil {\n\t\t\tbreak\n\t\t}\n\t\tcount++\n\t}\n\tfailure := rows.Err()\n\trows.Close()\n\tif e != nil || failure != nil || count != 1 || !openIDPattern.MatchString(openid) || !ports.ID(version).Valid() || version == \"0\" {\n\t\treturn binding{}, ports.ErrUnavailable\n\t}\n\tproof := hash(strings.Join([]string{s.environment, s.appID, string(p.ActorID), id, version, openid}, \"\\n\"))\n\tif owned && tx.Commit() != nil {\n\t\treturn binding{}, ports.ErrUnavailable\n\t}\n\treturn binding{openid, proof}, nil\n}\n\n// ValidateTextLocked runs after PHP authority/current login and before the\n// stable restriction/conversation lock. No network call occurs in this tx.\nfunc (s *Service) ValidateTextLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, checked ports.SafetyResult) error {\n\tif checked.RuleVersion != RuleVersion || !hexPattern.MatchString(checked.AuthorityProof) {\n\t\treturn ports.ErrUnavailable\n\t}\n\tidentity, e := s.identity(ctx, p, tx)\n\tif e != nil || identity.proof != checked.AuthorityProof {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\ntype contextItem struct {\n\tIntentID       ports.ID `json:\"intent_id\"`\n\tFingerprint    string   `json:\"fingerprint\"`\n\tNormalizedText string   `json:\"normalized_text\"`\n}\n\nfunc (s *Service) prepare(ctx context.Context, q ports.TextRequest) ([]contextItem, error) {\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar actor string\n\tif e = tx.QueryRowContext(ctx, `SELECT CAST(actor_id AS CHAR) FROM chat_restrictions WHERE actor_id=? FOR UPDATE`, string(q.Actor.ActorID)).Scan(&actor); e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tvar intent string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_send_intents WHERE id=? AND sender_id=? AND conversation_id=? AND fingerprint=? AND state='checking' LOCK IN SHARE MODE`, string(q.IntentID), string(q.Actor.ActorID), string(q.ConversationID), q.Fingerprint).Scan(&intent)\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_text_checks(intent_id,sender_id,conversation_id,fingerprint,normalized_text,created_at) VALUES(?,?,?,?,?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE intent_id=intent_id`, intent, string(q.Actor.ActorID), string(q.ConversationID), q.Fingerprint, normalize(q.Text))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tvar fp string\n\tif e = tx.QueryRowContext(ctx, `SELECT fingerprint FROM chat_text_checks WHERE intent_id=? FOR UPDATE`, intent).Scan(&fp); e != nil || fp != q.Fingerprint {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(intent_id AS CHAR),fingerprint,normalized_text FROM chat_text_checks WHERE sender_id=? AND conversation_id=? AND intent_id<>? AND created_at>=UTC_TIMESTAMP(6)-INTERVAL 2 MINUTE ORDER BY created_at DESC,id DESC LIMIT 4 FOR UPDATE`, string(q.Actor.ActorID), string(q.ConversationID), intent)\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tprevious := []contextItem{}\n\tfor rows.Next() {\n\t\tvar item contextItem\n\t\tif e = rows.Scan(&item.IntentID, &item.Fingerprint, &item.NormalizedText); e != nil {\n\t\t\tbreak\n\t\t}\n\t\tprevious = append(previous, item)\n\t}\n\tfailure := rows.Err()\n\trows.Close()\n\tif e != nil || failure != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tfor i, j := 0, len(previous)-1; i < j; i, j = i+1, j-1 {\n\t\tprevious[i], previous[j] = previous[j], previous[i]\n\t}\n\tif tx.Commit() != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn previous, nil\n}\n\n// Context/cache data is ephemeral; minimal intents and risk evidence are not\n// deleted here. The worker sweeps at most 100 expired context rows per tick.\nfunc (s *Service) Clean(ctx context.Context) error {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\t_, e := s.db.ExecContext(ctx, `DELETE FROM chat_text_checks WHERE created_at<UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE ORDER BY created_at LIMIT 100`)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (s *Service) Maintain(ctx context.Context) {\n\ttimer := time.NewTicker(30 * time.Second)\n\tdefer timer.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-timer.C:\n\t\t\t_ = s.Clean(ctx)\n\t\t}\n\t}\n}\n\nvar _ ports.Safety = (*Service)(nil)\n\nfunc (s *Service) Close() {\n\tif c, ok := s.client.(interface{ CloseIdleConnections() }); ok {\n\t\tc.CloseIdleConnections()\n\t}\n}\n","chat/internal/moderation/service_test.go":"package moderation\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc credential(token string) Credential {\n\tnow := time.Now().Unix()\n\tv := Credential{Schema: 1, Environment: \"test\", AppID: \"wx_s07_fixture\", Token: token, IssuedAt: now, ExpiresAt: now + 3600}\n\tv.Generation = hash(v.Environment + \"\\n\" + v.AppID + \"\\n\" + v.Token)\n\treturn v\n}\nfunc putCredential(t *testing.T, path string, v Credential) {\n\tt.Helper()\n\tbody, _ := json.Marshal(v)\n\tif e := os.WriteFile(path, body, 0640); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\nfunc TestCredentialBoundariesAndFallback(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(root, \"credential.json\")\n\tv := credential(\"s07_fixture_token_one\")\n\tputCredential(t, path, v)\n\tc, e := NewCredentials(path, \"test\", v.AppID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif got, e := c.Get(); e != nil || got.Token != v.Token {\n\t\tt.Fatal(\"valid export refused\", e)\n\t}\n\tos.Remove(path)\n\tif _, e = c.Get(); e != nil {\n\t\tt.Fatal(\"still-valid cached credential could not bridge outage\")\n\t}\n\tputCredential(t, path, v)\n\tos.Chmod(path, 0644)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"insecure export bypassed via cache\")\n\t}\n\tos.Chmod(path, 0640)\n\twrong := v\n\twrong.Environment = \"production\"\n\tputCredential(t, path, wrong)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"cross-environment export\")\n\t}\n\tputCredential(t, path, v)\n\tc.Reject(v.Generation)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"rejected generation reused\")\n\t}\n\tnext := credential(\"s07_fixture_token_two\")\n\tputCredential(t, path, next)\n\tif _, e = c.Get(); e != nil {\n\t\tt.Fatal(\"rotation failed\", e)\n\t}\n\tc.Reject(next.Generation)\n\tputCredential(t, path, v)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"earlier rejected generation resurrected\")\n\t}\n\tc.cached = credential(\"s07_fixture_old_cache\")\n\tc.cached.ExpiresAt = time.Now().Unix() - 1\n\tos.Remove(path)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"expired fallback\")\n\t}\n\tputCredential(t, path, v)\n\tbody, _ := json.Marshal(v)\n\tos.WriteFile(path, []byte(strings.Replace(string(body), `\"env\":`, `\"env\":\"test\",\"env\":`, 1)), 0640)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"duplicate envelope key\")\n\t}\n}\n\ntype httpFunc func(*http.Request) (*http.Response, error)\n\nfunc (f httpFunc) Do(r *http.Request) (*http.Response, error) { return f(r) }\nfunc TestOfficialResponseContract(t *testing.T) {\n\tcases := []struct {\n\t\tname, body, decision string\n\t\tstatus               int\n\t\tunavailable          bool\n\t}{\n\t\t{\"pass\", `{\"errcode\":0,\"trace_id\":\"fixture-trace\",\"result\":{\"suggest\":\"pass\",\"label\":100},\"detail\":[]}`, \"passed\", 200, false},\n\t\t{\"risky\", `{\"errcode\":0,\"result\":{\"suggest\":\"risky\",\"label\":200}}`, \"blocked\", 200, false},\n\t\t{\"review\", `{\"errcode\":0,\"result\":{\"suggest\":\"review\"}}`, \"review\", 200, false},\n\t\t{\"blocked_code\", `{\"errcode\":87014}`, \"blocked\", 200, false},\n\t\t{\"empty\", `{}`, \"\", 200, true},\n\t\t{\"missing_result\", `{\"errcode\":0}`, \"\", 200, true},\n\t\t{\"missing_code\", `{\"result\":{\"suggest\":\"pass\"}}`, \"\", 200, true},\n\t\t{\"null\", `{\"errcode\":0,\"result\":null}`, \"\", 200, true},\n\t\t{\"unknown\", `{\"errcode\":0,\"result\":{\"suggest\":\"unknown\"}}`, \"\", 200, true},\n\t\t{\"duplicate\", `{\"errcode\":0,\"errcode\":0,\"result\":{\"suggest\":\"pass\"}}`, \"\", 200, true},\n\t\t{\"case_alias\", `{\"ERRCODE\":0,\"result\":{\"suggest\":\"pass\"}}`, \"\", 200, true},\n\t\t{\"quota\", `{\"errcode\":45009,\"errmsg\":\"sensitive-fixture\"}`, \"\", 200, true},\n\t\t{\"http_error\", `{\"errcode\":0,\"result\":{\"suggest\":\"pass\"}}`, \"\", 503, true},\n\t\t{\"oversized\", strings.Repeat(\"x\", (32<<10)+1), \"\", 200, true},\n\t}\n\tfor _, c := range cases {\n\t\tt.Run(c.name, func(t *testing.T) {\n\t\t\ts := &Service{client: httpFunc(func(r *http.Request) (*http.Response, error) {\n\t\t\t\tif r.URL.Host != \"api.weixin.qq.com\" || r.URL.Path != \"/wxa/msg_sec_check\" || r.URL.Scheme != \"https\" || r.Method != \"POST\" || r.URL.Query().Get(\"access_token\") != \"s07_fixture_token_one\" {\n\t\t\t\t\tt.Fatal(\"incorrect official request\")\n\t\t\t\t}\n\t\t\t\traw, _ := io.ReadAll(r.Body)\n\t\t\t\tvar body struct {\n\t\t\t\t\tContent, OpenID string\n\t\t\t\t\tVersion, Scene  int\n\t\t\t\t}\n\t\t\t\tif json.Unmarshal(raw, &body) != nil || body.Content != \"尺寸12.5米\\n🛠\" || body.OpenID != \"oS07_abcdefghijklmnopqrstuv\" || body.Version != 2 || body.Scene != 1 {\n\t\t\t\t\tt.Fatal(\"text identity or bytes changed\", string(raw))\n\t\t\t\t}\n\t\t\t\treturn &http.Response{StatusCode: c.status, Body: io.NopCloser(strings.NewReader(c.body))}, nil\n\t\t\t})}\n\t\t\tout, e := s.inspect(context.Background(), credential(\"s07_fixture_token_one\"), \"oS07_abcdefghijklmnopqrstuv\", \"尺寸12.5米\\n🛠\")\n\t\t\tif c.unavailable {\n\t\t\t\tif e != ports.ErrUnavailable {\n\t\t\t\t\tt.Fatalf(\"fail-open %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t} else if e != nil || out.Decision != c.decision {\n\t\t\t\tt.Fatalf(\"decision %+v %v\", out, e)\n\t\t\t}\n\t\t\tif c.decision == \"review\" && (out.Finding == nil || out.Finding.Confirmed) {\n\t\t\t\tt.Fatal(\"review counted as violation\")\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestExpiredOfficialCredentialIsQuarantined(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"credential.json\")\n\tv := credential(\"s07_fixture_token_one\")\n\tputCredential(t, path, v)\n\tc, _ := NewCredentials(path, \"test\", v.AppID)\n\ts := &Service{credentials: c, client: httpFunc(func(*http.Request) (*http.Response, error) {\n\t\treturn &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(`{\"errcode\":40001}`))}, nil\n\t})}\n\tif _, e := s.inspect(context.Background(), v, \"oS07_abcdefghijklmnopqrstuv\", \"fixture\"); e == nil {\n\t\tt.Fatal(\"invalid access token allowed\")\n\t}\n\tif _, e := c.Get(); e == nil {\n\t\tt.Fatal(\"bad generation remained usable\")\n\t}\n}\n","chat/internal/moderation/token.go":"// Package moderation implements official text checks and local diversion rules.\n// It never grants order authority or writes PHP-owned identity tables.\npackage moderation\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Credential struct {\n\tSchema      int    `json:\"schema_version\"`\n\tEnvironment string `json:\"env\"`\n\tAppID       string `json:\"app_id\"`\n\tToken       string `json:\"token\"`\n\tIssuedAt    int64  `json:\"issued_at\"`\n\tExpiresAt   int64  `json:\"expires_at\"`\n\tGeneration  string `json:\"generation\"`\n}\ntype Credentials struct {\n\tmu                       sync.Mutex\n\tpath, environment, appID string\n\tcached                   Credential\n\trejected                 map[string]int64\n}\n\nfunc NewCredentials(path, environment, appID string) (*Credentials, error) {\n\tif !filepath.IsAbs(path) || !validEnvironment(environment) || !appPattern.MatchString(appID) {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Credentials{path: path, environment: environment, appID: appID, rejected: map[string]int64{}}, nil\n}\nfunc hash(s string) string { v := sha256.Sum256([]byte(s)); return hex.EncodeToString(v[:]) }\nfunc (c *Credentials) valid(v Credential, now time.Time) bool {\n\treturn v.Schema == 1 && v.Environment == c.environment && v.AppID == c.appID && len(v.Token) <= 2048 && tokenPattern.MatchString(v.Token) && v.IssuedAt > 0 && v.IssuedAt <= now.Unix()+5 && v.ExpiresAt > now.Unix()+5 && v.ExpiresAt > v.IssuedAt && v.ExpiresAt-v.IssuedAt <= 7200 && v.Generation == hash(v.Environment+\"\\n\"+v.AppID+\"\\n\"+v.Token) && c.rejected[v.Generation] <= now.Unix() && len(c.rejected) < 32\n}\nfunc (c *Credentials) Get() (Credential, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tnow := time.Now()\n\tfor key, until := range c.rejected {\n\t\tif until <= now.Unix() {\n\t\t\tdelete(c.rejected, key)\n\t\t}\n\t}\n\t// Refresh the protected file on every check to observe revocations/rotation;\n\t// cache only bridges file/proxy outages while a known credential is valid.\n\tinfo, e := os.Lstat(c.path)\n\tif e == nil && info.Mode().IsRegular() && info.Mode().Perm()&0027 == 0 && info.Size() <= 4096 {\n\t\tparent, err := os.Stat(filepath.Dir(c.path))\n\t\tif err == nil && parent.IsDir() && parent.Mode().Perm()&0022 == 0 {\n\t\t\tf, err := os.Open(c.path)\n\t\t\tif err == nil {\n\t\t\t\tactual, err := f.Stat()\n\t\t\t\tvar body []byte\n\t\t\t\tif err == nil && os.SameFile(info, actual) {\n\t\t\t\t\tbody, err = io.ReadAll(io.LimitReader(f, 4097))\n\t\t\t\t}\n\t\t\t\tf.Close()\n\t\t\t\tvar v Credential\n\t\t\t\tif err == nil && len(body) <= 4096 && strictObject(body, &v) && c.valid(v, now) {\n\t\t\t\t\tc.cached = v\n\t\t\t\t\treturn v, nil\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif e != nil && (os.IsNotExist(e) || os.IsPermission(e)) && c.valid(c.cached, now) {\n\t\treturn c.cached, nil\n\t}\n\treturn Credential{}, ports.ErrUnavailable\n}\nfunc (c *Credentials) Reject(generation string) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif hexPattern.MatchString(generation) {\n\t\tuntil := time.Now().Add(2 * time.Hour).Unix()\n\t\tif c.cached.Generation == generation {\n\t\t\tuntil = c.cached.ExpiresAt\n\t\t}\n\t\tc.rejected[generation] = until\n\t\tif c.cached.Generation == generation {\n\t\t\tc.cached = Credential{}\n\t\t}\n\t}\n}\n\n// Duplicate/case/unknown keys are forbidden even on trusted on-disk envelopes.\nfunc strictObject(body []byte, value any) bool {\n\tvar raw map[string]json.RawMessage\n\tif json.Unmarshal(body, &raw) != nil || raw == nil {\n\t\treturn false\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(body))\n\ttoken, e := decoder.Token()\n\tif e != nil || token != json.Delim('{') {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor decoder.More() {\n\t\tk, e := decoder.Token()\n\t\tkey, ok := k.(string)\n\t\tif e != nil || !ok || seen[key] || key != strings.ToLower(key) {\n\t\t\treturn false\n\t\t}\n\t\tseen[key] = true\n\t\tvar v json.RawMessage\n\t\tif decoder.Decode(&v) != nil || string(v) == \"null\" {\n\t\t\treturn false\n\t\t}\n\t}\n\tif _, e = decoder.Token(); e != nil {\n\t\treturn false\n\t}\n\tif _, e = decoder.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\tdecoder = json.NewDecoder(bytes.NewReader(body))\n\tdecoder.DisallowUnknownFields()\n\treturn decoder.Decode(value) == nil\n}\n","chat/internal/policy/guard.go":"// Package policy reads PHP-owned authorization facts. It never interprets order states.\npackage policy\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrDenied = errors.New(\"CHAT_POLICY_DENIED\")\nvar hexVersion = regexp.MustCompile(`^[a-f0-9]{64}$`)\n\ntype member struct {\n\tActorID          ports.ID `json:\"actor_id\"`\n\tKind             string   `json:\"kind\"`\n\tRole             string   `json:\"role\"`\n\tCanRead          bool     `json:\"can_read\"`\n\tCanSend          bool     `json:\"can_send\"`\n\tAuthorityVersion ports.ID `json:\"authority_version,omitempty\"`\n}\n\nfunc (m *member) UnmarshalJSON(data []byte) error {\n\ttype plain member\n\tif object(data, (*plain)(m), \"actor_id\", \"kind\", \"role\", \"can_read\", \"can_send\") {\n\t\treturn nil\n\t}\n\tif object(data, (*plain)(m), \"actor_id\", \"kind\", \"role\", \"can_read\", \"can_send\", \"authority_version\") && m.Role == \"platform_staff\" {\n\t\treturn nil\n\t}\n\treturn ErrDenied\n}\n\ntype snapshot struct {\n\tOrderContext *ports.OrderContext `json:\"order_context,omitempty\"`\n\tSchema             int      `json:\"schema_version\"`\n\tScope              string   `json:\"scope_key\"`\n\tOrderID            ports.ID `json:\"order_id\"`\n\tAssignmentID       ports.ID `json:\"assignment_id\"`\n\tEpisode            string   `json:\"episode_key\"`\n\tState              string   `json:\"state\"`\n\tCanInvite          bool     `json:\"can_invite\"`\n\tMembers            []member `json:\"members\"`\n\tStaffConfigVersion ports.ID `json:\"staff_config_version,omitempty\"`\n}\n\ntype row struct{ scope, orderID, assignmentID, version, state, body, hash string }\n\n// Reader is deliberately not ports.Policy: S05 must resolve the conversation's\n// trusted binding first. A client-provided scope must never replace that binding.\ntype Reader struct {\n\tenvironment string\n\ttimeout     time.Duration\n}\n\nfunc NewReader(environment string, timeout time.Duration) (*Reader, error) {\n\tif (environment != \"development\" && environment != \"test\" && environment != \"production\") || timeout <= 0 || timeout > 5*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Reader{environment: environment, timeout: timeout}, nil\n}\n\n// AuthorizeLocked holds the PHP guard's shared lock in the caller's transaction.\n// S06 must commit the message using this SAME tx, never authorize then start a\n// second transaction. expectedVersion is the applied S05 membership version.\n// The caller must also revalidate the S03 session and account restrictions.\nfunc (r *Reader) AuthorizeLocked(ctx context.Context, tx *sql.Tx, scope string, expectedVersion ports.ID, actor ports.Principal, action string) (ports.Grant, error) {\n\tif tx == nil || len(scope) < 1 || len(scope) > 96 || !positive(expectedVersion) || (action != \"read\" && action != \"send\") {\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\tif !r.actor(actor, time.Now()) {\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\tctx, cancel := context.WithTimeout(ctx, r.timeout)\n\tdefer cancel()\n\tp, err := r.CurrentLocked(ctx, tx, scope)\n\tif err != nil || p.Version != expectedVersion {\n\t\tif err != nil {\n\t\t\treturn ports.Grant{}, err\n\t\t}\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\tif err = r.CheckEpochsLocked(ctx, tx, p, actor.ActorID, action); err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\tvar grant ports.Grant\n\tfor _, m := range p.Members {\n\t\tif m.ActorID == actor.ActorID {\n\t\t\tgrant = m.Grant\n\t\t}\n\t}\n\tif !grant.CanRead || (action == \"send\" && !grant.CanSend) || !r.actor(actor, time.Now()) {\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\treturn grant, nil\n}\n\nfunc (r *Reader) actor(a ports.Principal, now time.Time) bool {\n\treturn positive(a.ActorID) && positive(a.SourceID) && a.Kind == \"mini\" && a.Environment == r.environment &&\n\t\thexVersion.MatchString(a.SessionID) && hexVersion.MatchString(a.SessionVersion) && now.Before(a.ExpiresAt) &&\n\t\tlen(a.Scopes) == 1 && a.Scopes[0] == \"chat:use\"\n}\n\nfunc evaluate(value row, scope string, expectedVersion ports.ID, actor ports.ID, action string) (ports.Grant, error) {\n\tdeny := func() (ports.Grant, error) { return ports.Grant{}, ErrDenied }\n\tif !positive(actor) || !positive(expectedVersion) || value.version != string(expectedVersion) || value.scope != scope || len(value.body) > 16384 || !hexVersion.MatchString(value.hash) {\n\t\treturn deny()\n\t}\n\tdigest := sha256.Sum256([]byte(value.body))\n\tif hex.EncodeToString(digest[:]) != value.hash {\n\t\treturn deny()\n\t}\n\tvar s snapshot\n\tkeys := []string{\"schema_version\", \"scope_key\", \"order_id\", \"assignment_id\", \"episode_key\", \"state\", \"can_invite\", \"members\"}\n\tvar header struct {\n\t\tSchema int `json:\"schema_version\"`\n\t\tOrder json.RawMessage `json:\"order_context\"`\n\t}\n\tif json.Unmarshal([]byte(value.body), &header) != nil {\n\t\treturn deny()\n\t}\n\tif len(header.Order) > 0 {\n\t\tvar display ports.OrderContext\n\t\tif !object(header.Order, &display, \"public_no\", \"title\", \"workflow\") || !validOrderContext(display) { return deny() }\n\t\tkeys = append(keys, \"order_context\")\n\t}\n\tif header.Schema == 2 {\n\t\tkeys = append(keys, \"staff_config_version\")\n\t}\n\tif !object([]byte(value.body), &s, keys...) ||\n\t\t(s.Schema != 1 && s.Schema != 2) || (s.Schema == 2 && !positive(s.StaffConfigVersion)) || !positive(s.OrderID) || !positive(s.AssignmentID) || s.Scope != scope || s.Scope != \"order:\"+string(s.OrderID)+\":assignment:\"+string(s.AssignmentID) ||\n\t\tvalue.orderID != string(s.OrderID) || value.assignmentID != string(s.AssignmentID) || value.state != s.State || (s.State != \"open\" && s.State != \"readonly\") ||\n\t\t!validEpisode(s.Episode, s.AssignmentID) || s.CanInvite || len(s.Members) < 1 || len(s.Members) > 10 || (s.Schema == 1 && len(s.Members) != 2) {\n\t\treturn deny()\n\t}\n\tseen := map[ports.ID]bool{}\n\troles := map[string]bool{}\n\tvar found *member\n\tfor i := range s.Members {\n\t\tm := &s.Members[i]\n\t\tstaff := m.Role == \"platform_staff\"\n\t\tif !positive(m.ActorID) || seen[m.ActorID] || (roles[m.Role] && !staff) || m.Kind != \"mini\" || (m.Role != \"customer\" && m.Role != \"worker\" && !staff) || !m.CanRead || (s.State == \"readonly\" && m.CanSend) ||\n\t\t\t(staff && (s.Schema != 2 || !positive(m.AuthorityVersion))) || (!staff && m.AuthorityVersion != \"\") || (len(s.Members) == 1 && m.CanSend) {\n\t\t\treturn deny()\n\t\t}\n\t\tseen[m.ActorID] = true\n\t\troles[m.Role] = true\n\t\tif m.ActorID == actor {\n\t\t\tfound = m\n\t\t}\n\t}\n\tif !roles[\"worker\"] || (s.Schema == 1 && !roles[\"customer\"]) {\n\t\treturn deny()\n\t}\n\tif found == nil || (action != \"read\" && action != \"send\") || (action == \"send\" && (!found.CanSend || s.State != \"open\")) {\n\t\treturn deny()\n\t}\n\tgrant := ports.Grant{OrderContext: s.OrderContext, MemberRole: found.Role, CanRead: found.CanRead, CanSend: found.CanSend && s.State == \"open\", ScopeKey: s.Scope, Version: expectedVersion,\n\t\tMemberKey: s.Episode + \":mini:\" + string(actor) + \":\" + found.Role}\n\tif found.Role == \"platform_staff\" {\n\t\tgrant.StaffConfigVersion = s.StaffConfigVersion\n\t\tgrant.StaffUserVersion = found.AuthorityVersion\n\t\tgrant.MemberKey += \":config:\" + string(s.StaffConfigVersion) + \":user:\" + string(found.AuthorityVersion)\n\t}\n\treturn grant, nil\n}\n\nfunc positive(id ports.ID) bool { return id.Valid() && id != \"0\" }\n\n// The episode identity is supplied by PHP. Go does not infer repair eligibility.\nfunc validEpisode(episode string, assignment ports.ID) bool {\n\tprefix := \"assignment:\" + string(assignment)\n\tif episode == prefix+\":service\" {\n\t\treturn true\n\t}\n\tid, ok := strings.CutPrefix(episode, prefix+\":repair:\")\n\treturn ok && positive(ports.ID(id))\n}\n\n// Exact required keys, including nested members: reject duplicates, case aliases,\n// null fields, missing/unknown fields, non-object roots and trailing values.\nfunc object(data []byte, target any, keys ...string) bool {\n\tdecoder := json.NewDecoder(bytes.NewReader(data))\n\ttoken, err := decoder.Token()\n\tif err != nil || token != json.Delim('{') {\n\t\treturn false\n\t}\n\tallowed := map[string]bool{}\n\tfor _, key := range keys {\n\t\tallowed[key] = true\n\t}\n\tseen := map[string]bool{}\n\tfor decoder.More() {\n\t\ttoken, err = decoder.Token()\n\t\tkey, ok := token.(string)\n\t\tif err != nil || !ok || !allowed[key] || seen[key] {\n\t\t\treturn false\n\t\t}\n\t\tseen[key] = true\n\t\tvar raw json.RawMessage\n\t\tif decoder.Decode(&raw) != nil || bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\n\t\t\treturn false\n\t\t}\n\t}\n\tif token, err = decoder.Token(); err != nil || token != json.Delim('}') || len(seen) != len(allowed) {\n\t\treturn false\n\t}\n\tif _, err = decoder.Token(); err != io.EOF {\n\t\treturn false\n\t}\n\treturn json.Unmarshal(data, target) == nil\n}\n\n// Display metadata is optional for pre-S12 guards and cannot change authority.\nfunc validOrderContext(c ports.OrderContext) bool {\n if len(c.PublicNo) < 1 || len(c.PublicNo) > 80 || (c.Workflow != \"construction\" && c.Workflow != \"measurement\") || !utf8.ValidString(c.Title) || utf8.RuneCountInString(c.Title)>120 { return false }\n for _, r := range c.PublicNo { if !(r>='0'&&r<='9'||r>='A'&&r<='Z'||r>='a'&&r<='z'||r=='-'||r=='_') { return false } }\n for _, r := range c.Title { if unicode.IsControl(r) { return false } }\n return true\n}\n","chat/internal/policy/guard_test.go":"package policy\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nconst validSnapshot = `{\"schema_version\":1,\"scope_key\":\"order:77:assignment:100\",\"order_id\":\"77\",\"assignment_id\":\"100\",\"episode_key\":\"assignment:100:service\",\"state\":\"open\",\"can_invite\":false,\"members\":[{\"actor_id\":\"1\",\"kind\":\"mini\",\"role\":\"customer\",\"can_read\":true,\"can_send\":true},{\"actor_id\":\"18446744073709551615\",\"kind\":\"mini\",\"role\":\"worker\",\"can_read\":true,\"can_send\":true}]}`\n\nfunc fixture(body string) row {\n\tsum := sha256.Sum256([]byte(body))\n\treturn row{scope: \"order:77:assignment:100\", orderID: \"77\", assignmentID: \"100\", version: \"7\", state: \"open\", body: body, hash: hex.EncodeToString(sum[:])}\n}\n\nfunc TestGuardProtocolAndMembership(t *testing.T) {\n\tr := fixture(validSnapshot)\n\tfor _, id := range []ports.ID{\"1\", \"18446744073709551615\"} {\n\t\tg, e := evaluate(r, r.scope, \"7\", id, \"send\")\n\t\tif e != nil || !g.CanRead || !g.CanSend || g.Version != \"7\" {\n\t\t\tt.Fatal(\"PHP member lost\", g, e)\n\t\t}\n\t}\n\tfor _, id := range []ports.ID{\"0\", \"2\", \"01\", \"18446744073709551616\"} {\n\t\tif _, e := evaluate(r, r.scope, \"7\", id, \"read\"); e != ErrDenied {\n\t\t\tt.Fatal(\"outsider granted\", id, e)\n\t\t}\n\t}\n\tfor _, version := range []ports.ID{\"6\", \"8\", \"0\", \"07\"} {\n\t\tif _, e := evaluate(r, r.scope, version, \"1\", \"send\"); e != ErrDenied {\n\t\t\tt.Fatal(\"unapplied/stale version granted\", version, e)\n\t\t}\n\t}\n\tr.body = strings.ReplaceAll(strings.Replace(validSnapshot, `\"state\":\"open\"`, `\"state\":\"readonly\"`, 1), `\"can_send\":true`, `\"can_send\":false`)\n\tr = fixture(r.body)\n\tr.state = \"readonly\"\n\tgrant, e := evaluate(r, r.scope, \"7\", \"1\", \"read\")\n\tif e != nil || !grant.CanRead || grant.CanSend {\n\t\tt.Fatal(\"closed history\", grant, e)\n\t}\n\tif _, e = evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\tt.Fatal(\"closed send allowed\")\n\t}\n}\n\nfunc TestRepairEpisodeIdentity(t *testing.T) {\n\tfor _, id := range []string{\"1\", \"18446744073709551615\"} {\n\t\tr := fixture(strings.Replace(validSnapshot, \":service\", \":repair:\"+id, 1))\n\t\tif g, e := evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != nil || !g.CanSend {\n\t\t\tt.Fatal(\"explicit PHP repair episode\", e)\n\t\t}\n\t}\n\tfor _, id := range []string{\"0\", \"01\", \"\", \"18446744073709551616\", \"1:extra\"} {\n\t\tr := fixture(strings.Replace(validSnapshot, \":service\", \":repair:\"+id, 1))\n\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\t\tt.Fatal(\"invalid repair generation granted\", id, e)\n\t\t}\n\t}\n}\n\nfunc TestMalformedAuthorityNeverGrants(t *testing.T) {\n\tfor name, body := range map[string]string{\n\t\t\"duplicate root\":   strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":1,\"schema_version\":1`, 1),\n\t\t\"duplicate member\": strings.Replace(validSnapshot, `\"actor_id\":\"1\"`, `\"actor_id\":\"1\",\"actor_id\":\"2\"`, 1),\n\t\t\"case alias\":       strings.Replace(validSnapshot, `\"can_send\"`, `\"Can_Send\"`, 1),\n\t\t\"extra\":            strings.Replace(validSnapshot, `\"can_invite\":false`, `\"can_invite\":false,\"extra\":1`, 1),\n\t\t\"missing\":          strings.Replace(validSnapshot, `\"can_invite\":false,`, \"\", 1),\n\t\t\"null\":             strings.Replace(validSnapshot, `\"can_invite\":false`, `\"can_invite\":null`, 1),\n\t\t\"numeric ID\":       strings.Replace(validSnapshot, `\"order_id\":\"77\"`, `\"order_id\":77`, 1),\n\t\t\"scope mismatch\":   strings.Replace(validSnapshot, `\"order_id\":\"77\"`, `\"order_id\":\"78\"`, 1),\n\t\t\"unknown schema\":   strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2`, 1),\n\t\t\"unknown episode\":  strings.Replace(validSnapshot, `:service`, `:unapproved`, 1),\n\t\t\"unknown state\":    strings.Replace(validSnapshot, `\"state\":\"open\"`, `\"state\":\"unknown\"`, 1),\n\t\t\"invitation\":       strings.Replace(validSnapshot, `\"can_invite\":false`, `\"can_invite\":true`, 1),\n\t\t\"duplicate actor\":  strings.Replace(validSnapshot, `\"18446744073709551615\"`, `\"1\"`, 1),\n\t\t\"duplicate role\":   strings.Replace(validSnapshot, `\"role\":\"worker\"`, `\"role\":\"customer\"`, 1),\n\t\t\"admin peer\":       strings.Replace(validSnapshot, `\"kind\":\"mini\"`, `\"kind\":\"admin\"`, 1),\n\t\t\"trailing\":         validSnapshot + `{}`,\n\t\t\"array\":            \"[\" + validSnapshot + \"]\",\n\t\t\"oversized\":        strings.Repeat(\" \", 16385) + validSnapshot,\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tr := fixture(body)\n\t\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\t\t\tt.Fatal(\"bad fact granted\", e)\n\t\t\t}\n\t\t})\n\t}\n\tfor _, change := range []func(*row){\n\t\tfunc(r *row) { r.hash = strings.Repeat(\"a\", 64) }, func(r *row) { r.orderID = \"78\" }, func(r *row) { r.assignmentID = \"101\" }, func(r *row) { r.state = \"readonly\" },\n\t} {\n\t\tr := fixture(validSnapshot)\n\t\tchange(&r)\n\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", \"read\"); e != ErrDenied {\n\t\t\tt.Fatal(\"row/snapshot mismatch granted\", e)\n\t\t}\n\t}\n}\n\nfunc principal() ports.Principal {\n\treturn ports.Principal{ActorID: \"1\", Kind: \"mini\", SourceID: \"1\", Environment: \"test\", SessionID: strings.Repeat(\"a\", 64), SessionVersion: strings.Repeat(\"b\", 64), ExpiresAt: time.Now().Add(time.Minute), Scopes: []string{\"chat:use\"}}\n}\n\nfunc TestReaderIdentityBoundary(t *testing.T) {\n\tr, e := NewReader(\"test\", time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif !r.actor(principal(), time.Now()) {\n\t\tt.Fatal(\"valid principal\")\n\t}\n\tfor _, change := range []func(*ports.Principal){\n\t\tfunc(p *ports.Principal) { p.Kind = \"admin\" }, func(p *ports.Principal) { p.Environment = \"production\" }, func(p *ports.Principal) { p.SourceID = \"0\" },\n\t\tfunc(p *ports.Principal) { p.ExpiresAt = time.Now().Add(-time.Second) }, func(p *ports.Principal) { p.Scopes = []string{\"chat:audit\"} },\n\t\tfunc(p *ports.Principal) { p.SessionVersion = \"\" }, func(p *ports.Principal) { p.Scopes = append(p.Scopes, \"chat:moderate\") },\n\t} {\n\t\tp := principal()\n\t\tchange(&p)\n\t\tif r.actor(p, time.Now()) {\n\t\t\tt.Fatal(\"invalid identity accepted\")\n\t\t}\n\t}\n\tif _, e = r.AuthorizeLocked(context.Background(), nil, \"order:77:assignment:100\", \"1\", principal(), \"send\"); e != ErrDenied {\n\t\tt.Fatal(\"must own caller transaction\")\n\t}\n\tif _, e = NewReader(\"test\", 6*time.Second); e != ports.ErrInvalid {\n\t\tt.Fatal(\"unbounded timeout\")\n\t}\n}\n\n// Missing authority generations never become valid platform permissions.\nfunc TestPlatformMissingAuthorityRejected(t *testing.T) {\n\tfor _, body := range []string{\n\t\tstrings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2`, 1),\n\t\tstrings.Replace(strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2`, 1), `\"role\":\"customer\"`, `\"role\":\"platform_staff\"`, 1),\n\t\tstrings.Replace(validSnapshot, `\"role\":\"customer\"`, `\"role\":\"platform_staff\"`, 1),\n\t} {\n\t\tr := fixture(body)\n\t\tfor _, action := range []string{\"read\", \"send\"} {\n\t\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", action); e != ErrDenied {\n\t\t\t\tt.Fatal(\"unintegrated platform authority granted\", e)\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc TestEventEnvelopeAndProjection(t *testing.T) {\n\tbody := `{\"schema_version\":1,\"policy_version\":\"7\",\"snapshot\":` + validSnapshot + `}`\n\tp, err := DecodeEvent([]byte(body), \"order:77:assignment:100\", \"7\")\n\tif err != nil || len(p.Members) != 2 || p.Version != \"7\" || p.Members[0].Grant.MemberKey != \"assignment:100:service:mini:1:customer\" {\n\t\tt.Fatal(\"projection contract\", p, err)\n\t}\n\tfor _, bad := range []string{\n\t\tstrings.Replace(body, `\"policy_version\":\"7\"`, `\"policy_version\":\"8\"`, 1),\n\t\tstrings.Replace(body, `\"schema_version\":1`, `\"schema_version\":2`, 1),\n\t\tstrings.Replace(body, `\"policy_version\":\"7\"`, `\"policy_version\":\"7\",\"policy_version\":\"7\"`, 1),\n\t\tstrings.Replace(body, `\"snapshot\":`, `\"Snapshot\":`, 1), body + `{}`, `null`, strings.Repeat(\" \", 32769),\n\t} {\n\t\tif _, err = DecodeEvent([]byte(bad), \"order:77:assignment:100\", \"7\"); err != ErrDenied {\n\t\t\tt.Fatal(\"malformed event accepted\", err)\n\t\t}\n\t}\n}\n\nfunc TestPlatformStaffProtocolAndGenerations(t *testing.T) {\n\tbase := strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2,\"staff_config_version\":\"3\"`, 1)\n\tbase = strings.Replace(base, `\"role\":\"customer\"`, `\"role\":\"platform_staff\",\"authority_version\":\"5\"`, 1)\n\tr := fixture(base)\n\tfirst, e := evaluate(r, r.scope, \"7\", \"1\", \"send\")\n\tif e != nil || first.StaffConfigVersion != \"3\" || first.StaffUserVersion != \"5\" || first.MemberKey == \"\" {\n\t\tt.Fatal(\"staff generation missing\", e)\n\t}\n\tfor _, replacement := range []string{\n\t\tstrings.Replace(base, `\"staff_config_version\":\"3\"`, `\"staff_config_version\":\"4\"`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\"`, `\"authority_version\":\"6\"`, 1),\n\t} {\n\t\tnext := fixture(replacement)\n\t\tg, e := evaluate(next, next.scope, \"7\", \"1\", \"send\")\n\t\tif e != nil || g.MemberKey == first.MemberKey {\n\t\t\tt.Fatal(\"returning staff reused its old interval\", e)\n\t\t}\n\t}\n\tfor _, body := range []string{\n\t\tstrings.Replace(base, `\"staff_config_version\":\"3\"`, `\"staff_config_version\":\"0\"`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\"`, `\"authority_version\":\"0\"`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\"`, `\"authority_version\":5`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\",`, \"\", 1),\n\t\tstrings.Replace(validSnapshot, `\"role\":\"customer\"`, `\"role\":\"customer\",\"authority_version\":\"\"`, 1),\n\t} {\n\t\tbad := fixture(body)\n\t\tif _, e := evaluate(bad, bad.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\t\tt.Fatal(\"malformed staff authority accepted\", e)\n\t\t}\n\t}\n}\n\nfunc FuzzGuardSnapshot(f *testing.F) {\n\tf.Add(validSnapshot)\n\tf.Add(`null`)\n\tf.Add(`{\"members\":[{}]}`)\n\tf.Fuzz(func(t *testing.T, body string) {\n\t\tr := fixture(body)\n\t\tg, e := evaluate(r, r.scope, \"7\", \"1\", \"send\")\n\t\tif e == nil && (!g.CanRead || !g.CanSend || g.ScopeKey != r.scope || g.Version != \"7\") {\n\t\t\tt.Fatal(\"inconsistent grant\")\n\t\t}\n\t})\n}\n\nfunc TestS12OrderContextIsOptionalBoundedAndNotAuthority(t *testing.T) {\n display:=`\"order_context\":{\"public_no\":\"ORDER-77\",\"title\":\"墙布施工\",\"workflow\":\"construction\"},`\n body:=strings.Replace(validSnapshot,`\"members\":`,display+`\"members\":`,1)\n r:=fixture(body);g,e:=evaluate(r,r.scope,\"7\",\"1\",\"read\")\n if e!=nil||g.OrderContext==nil||g.OrderContext.PublicNo!=\"ORDER-77\"||g.MemberRole!=\"customer\" {t.Fatal(g,e)}\n if _,e=evaluate(r,r.scope,\"7\",\"2\",\"read\");e!=ErrDenied {t.Fatal(\"display metadata authorized outsider\",e)}\n for _,bad:=range []string{\n  strings.Replace(body,`\"ORDER-77\"`,`\"../77\"`,1),\n  strings.Replace(body,`\"construction\"`,`\"other\"`,1),\n  strings.Replace(body,`\"title\":\"墙布施工\"`,`\"title\":null`,1),\n  strings.Replace(body,`\"title\":\"墙布施工\"`,`\"title\":\"x\",\"title\":\"y\"`,1),\n  strings.Replace(body,`\"title\":\"墙布施工\"`,`\"title\":\"`+strings.Repeat(\"字\",121)+`\"`,1),\n } {v:=fixture(bad);if _,e=evaluate(v,v.scope,\"7\",\"1\",\"read\");e!=ErrDenied{t.Fatal(\"bad display accepted\",bad,e)}}\n legacy:=fixture(validSnapshot);g,e=evaluate(legacy,legacy.scope,\"7\",\"1\",\"read\")\n if e!=nil||g.OrderContext!=nil{t.Fatal(\"legacy authorization changed\",g,e)}\n}\n","chat/internal/policy/mysql_integration_test.go":"package policy\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\nfunc TestPHPGuardSharedLockAndVersions(t *testing.T) {\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated MySQL/PHP fixture not provided\")\n\t}\n\taddress := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\thost, _, err := net.SplitHostPort(address)\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"explicit loopback required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)\n\tdefer cancel()\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = address\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ReadTimeout = 3 * time.Second\n\tc.WriteTimeout = time.Second\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(\"fixture connector\")\n\t}\n\troot := sql.OpenDB(connector)\n\tdefer root.Close()\n\troot.SetMaxOpenConns(1)\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname, user := \"bixuan_test_policy_go_\"+suffix, \"bxchat_test_\"+suffix\n\tpw := strings.Repeat(\"a\", 32) + suffix\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\texecute := func(query string) {\n\t\tt.Helper()\n\t\tif _, e := root.ExecContext(ctx, query); e != nil {\n\t\t\tvar code *mysql.MySQLError\n\t\t\tif errors.As(e, &code) {\n\t\t\t\tt.Fatalf(\"fixture MySQL code=%d\", code.Number)\n\t\t\t}\n\t\t\tt.Fatal(\"fixture SQL failed\")\n\t\t}\n\t}\n\texecute(\"CREATE DATABASE `\" + name + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tdefer root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\")\n\texecute(\"USE `\" + name + \"`\")\n\tfor _, query := range []string{\n\t\t\"CREATE TABLE users(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB\",\n\t\t\"CREATE TABLE worker_profiles(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED) ENGINE=InnoDB\",\n\t\t\"CREATE TABLE assignments(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,worker_id BIGINT UNSIGNED,status VARCHAR(24),accepted_at DATETIME) ENGINE=InnoDB\",\n\t\t\"CREATE TABLE orders(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED,is_demo TINYINT,workflow_profile VARCHAR(24),order_source_type VARCHAR(24),lifecycle_status VARCHAR(40),payment_status VARCHAR(24),assignment_status VARCHAR(24),current_assignment_id BIGINT UNSIGNED,assigned_worker_id BIGINT UNSIGNED,public_no VARCHAR(80),title VARCHAR(180)) ENGINE=InnoDB\",\n\t\t\"INSERT INTO users VALUES(1,'active'),(2,'active')\", \"INSERT INTO worker_profiles VALUES(10,2)\",\n\t\t\"INSERT INTO assignments VALUES(100,77,10,'accepted',UTC_TIMESTAMP())\",\n\t\t\"INSERT INTO orders VALUES(77,1,0,'construction','consumer','active','paid','accepted',100,10,'POLICY-77','Policy fixture order')\",\n\t} {\n\t\texecute(query)\n\t}\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tt.Fatal(\"explicit PHP required\")\n\t}\n\tscript, err := filepath.Abs(\"../../../server/tests/chat_policy_fixture.php\")\n\tif err != nil {\n\t\tt.Fatal(\"fixture path\")\n\t}\n\tcallPHP := func(action, expected string) {\n\t\tt.Helper()\n\t\tcommand := exec.CommandContext(ctx, php, script, action)\n\t\tcommand.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+name)\n\t\toutput, e := command.Output()\n\t\tif e != nil || strings.TrimSpace(string(output)) != expected {\n\t\t\tt.Fatal(\"real PHP guard transaction failed\", action)\n\t\t}\n\t}\n\tcallPHP(\"init\", \"committed\")\n\texecute(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY '\" + pw + \"'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"GRANT SELECT ON `\" + name + \"`.chat_policy_guards TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\trc := *c\n\trc.DBName = name\n\trc.User = user\n\trc.Passwd = pw\n\tconnector, err = mysql.NewConnector(&rc)\n\tif err != nil {\n\t\tt.Fatal(\"read connector\")\n\t}\n\tdb := sql.OpenDB(connector)\n\tdefer db.Close()\n\tdb.SetMaxOpenConns(2)\n\tr, _ := NewReader(\"test\", 2*time.Second)\n\ttx, err := db.BeginTx(ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(\"guard transaction\")\n\t}\n\tdefer tx.Rollback()\n\tgrant, err := r.AuthorizeLocked(ctx, tx, \"order:77:assignment:100\", \"1\", principal(), \"send\")\n\tif err != nil || !grant.CanSend {\n\t\tt.Fatal(\"actual PHP snapshot not understood\", err)\n\t}\n\tif grant.OrderContext==nil||grant.OrderContext.PublicNo!=\"POLICY-77\" { t.Fatal(\"PHP display facts not preserved\",grant) }\n // PHP really attempts closure and times out on the Go reader's shared lock.\n\tcallPHP(\"close-blocked\", \"blocked\")\n\tvar lifecycle string\n\tif root.QueryRowContext(ctx, \"SELECT lifecycle_status FROM orders WHERE id=77\").Scan(&lifecycle) != nil || lifecycle != \"active\" {\n\t\tt.Fatal(\"blocked PHP close partially committed\")\n\t}\n\tif tx.Commit() != nil {\n\t\tt.Fatal(\"release guard lease\")\n\t}\n\tcallPHP(\"close\", \"committed\")\n\tcheck := func(version, action string, wantDenied bool, wantSend bool) {\n\t\tt.Helper()\n\t\ttransaction, e := db.BeginTx(ctx, nil)\n\t\tif e != nil {\n\t\t\tt.Fatal(\"check transaction\")\n\t\t}\n\t\tdefer transaction.Rollback()\n\t\tg, e := r.AuthorizeLocked(ctx, transaction, \"order:77:assignment:100\", ports.ID(version), principal(), action)\n\t\tif wantDenied {\n\t\t\tif e != ErrDenied {\n\t\t\t\tt.Fatal(\"revoked/stale policy granted\", e)\n\t\t\t}\n\t\t} else if e != nil || !g.CanRead || g.CanSend != wantSend {\n\t\t\tt.Fatal(\"closed history not bounded\", g, e)\n\t\t}\n\t}\n\tcheck(\"1\", \"read\", true, false)\n\tcheck(\"2\", \"send\", true, false)\n\tcheck(\"2\", \"read\", false, false)\n\tcallPHP(\"repair\", \"committed\")\n\tcheck(\"2\", \"read\", true, false)\n\tcheck(\"3\", \"send\", false, true)\n\tcallPHP(\"repair-close\", \"committed\")\n\tcheck(\"3\", \"send\", true, false)\n\tcheck(\"4\", \"send\", true, false)\n\tcheck(\"4\", \"read\", false, false)\n\tif _, err = db.ExecContext(ctx, \"UPDATE chat_policy_guards SET state='open'\"); err == nil {\n\t\tt.Fatal(\"Go read account can mutate PHP authority\")\n\t}\n\texecute(\"UPDATE chat_policy_guards SET snapshot_hash=REPEAT('f',64)\")\n\tcheck(\"4\", \"read\", true, false)\n\texecute(\"DELETE FROM chat_policy_guards\")\n\tcheck(\"4\", \"read\", true, false)\n}\n\n// Full PHP install/real source triggers: revocation is immediate even when no\n// new order event has reached Go. No order enum is interpreted in this adapter.\nfunc TestPlatformAuthorityGenerationsAndLocks(t *testing.T) {\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated services required\")\n\t}\n\taddress := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\thost, _, err := net.SplitHostPort(address)\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"loopback fixture required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 50*time.Second)\n\tdefer cancel()\n\tconfig := mysql.NewConfig()\n\tconfig.Net = \"tcp\"\n\tconfig.Addr = address\n\tconfig.User = \"root\"\n\tconfig.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tconfig.Timeout = time.Second\n\tconnector, err := mysql.NewConnector(config)\n\tif err != nil {\n\t\tt.Fatal(\"fixture connector\")\n\t}\n\troot := sql.OpenDB(connector)\n\tdefer root.Close()\n\troot.SetMaxOpenConns(1)\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname := \"bixuan_test_policy_platform_\" + suffix\n\tuser := \"bxchat_platform_\" + suffix\n\texecute := func(query string) {\n\t\tt.Helper()\n\t\tif _, e := root.ExecContext(ctx, query); e != nil {\n\t\t\tt.Fatal(\"platform fixture SQL\", e)\n\t\t}\n\t}\n\texecute(\"CREATE DATABASE `\" + name + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tdefer root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\")\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tt.Fatal(\"explicit PHP required\")\n\t}\n\tscript, _ := filepath.Abs(\"../../../server/tests/chat_platform_fixture.php\")\n\tcallPHP := func(action, expected string) {\n\t\tt.Helper()\n\t\tcommand := exec.CommandContext(ctx, php, script, action)\n\t\tcommand.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+name)\n\t\tout, e := command.CombinedOutput()\n\t\tif e != nil || strings.TrimSpace(string(out)) != expected {\n\t\t\tt.Fatalf(\"platform PHP %s: %s\", action, out)\n\t\t}\n\t}\n\tcallPHP(\"init\", \"committed\")\n\texecute(\"USE `\" + name + \"`\")\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\texecute(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY 'platform-fixture-only'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\")\n\tfor _, table := range []string{\"chat_policy_guards\", \"chat_staff_authority_versions\"} {\n\t\texecute(\"GRANT SELECT ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\treadConfig := *config\n\treadConfig.DBName = name\n\treadConfig.User = user\n\treadConfig.Passwd = \"platform-fixture-only\"\n\trc, e := mysql.NewConnector(&readConfig)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdb := sql.OpenDB(rc)\n\tdefer db.Close()\n\treader, _ := NewReader(\"test\", 2*time.Second)\n\tversion := func() ports.ID {\n\t\tt.Helper()\n\t\tvar v string\n\t\tif root.QueryRowContext(ctx, \"SELECT CAST(policy_version AS CHAR) FROM chat_policy_guards WHERE order_id=401\").Scan(&v) != nil {\n\t\t\tt.Fatal(\"guard version\")\n\t\t}\n\t\treturn ports.ID(v)\n\t}\n\tstaff := principal()\n\tstaff.ActorID = \"10203\"\n\tcheck := func(v ports.ID, actor ports.Principal, action string, denied bool) ports.Grant {\n\t\tt.Helper()\n\t\ttx, e := db.BeginTx(ctx, nil)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer tx.Rollback()\n\t\tg, e := reader.AuthorizeLocked(ctx, tx, \"order:401:assignment:401\", v, actor, action)\n\t\tif denied {\n\t\t\tif e != ErrDenied {\n\t\t\t\tt.Fatal(\"stale authority accepted\", e)\n\t\t\t}\n\t\t} else if e != nil {\n\t\t\tt.Fatal(\"valid platform authority denied\", e)\n\t\t}\n\t\treturn g\n\t}\n\tfirstVersion := version()\n\tfirst := check(firstVersion, staff, \"send\", false)\n\tif first.MemberKey == \"\" || first.StaffConfigVersion == \"\" || first.StaffUserVersion == \"\" {\n\t\tt.Fatal(\"missing authority generation binding\")\n\t}\n\texecute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n\tcheck(firstVersion, staff, \"read\", true)\n\tcheck(firstVersion, staff, \"send\", true)\n\tworker := staff\n\tworker.ActorID = \"10202\"\n\tcheck(firstVersion, worker, \"send\", true) // Prevent messages stamped with a stale roster during a staff gap.\n\texecute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\")\n\tcheck(firstVersion, staff, \"send\", true) // A -> B -> A must not resurrect cached authority.\n\tcallPHP(\"sync\", \"committed\")\n\tnextVersion := version()\n\tnext := check(nextVersion, staff, \"send\", false)\n\tif next.MemberKey == first.MemberKey {\n\t\tt.Fatal(\"configuration gap silently reopened\")\n\t}\n\tcheck(firstVersion, staff, \"send\", true)\n\texecute(\"UPDATE users SET status='disabled' WHERE id=10203\")\n\texecute(\"UPDATE users SET status='active' WHERE id=10203\")\n\tcheck(nextVersion, staff, \"read\", true)\n\tcallPHP(\"sync\", \"committed\")\n\tuserVersion := version()\n\tcurrent := check(userVersion, staff, \"send\", false)\n\tif current.MemberKey == next.MemberKey {\n\t\tt.Fatal(\"account gap silently reopened\")\n\t}\n\texecute(\"UPDATE wechat_identities SET status='revoked' WHERE user_id=10203\")\n\texecute(\"UPDATE wechat_identities SET status='active' WHERE user_id=10203\")\n\tcheck(userVersion, staff, \"send\", true)\n\tcallPHP(\"sync\", \"committed\")\n\tv := version()\n\tcurrent = check(v, staff, \"send\", false)\n\ttx, e := db.BeginTx(ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = reader.AuthorizeLocked(ctx, tx, \"order:401:assignment:401\", v, staff, \"send\"); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcallPHP(\"config-blocked\", \"blocked\")\n\tcallPHP(\"user-blocked\", \"blocked\")\n\tif tx.Commit() != nil {\n\t\tt.Fatal(\"release authority lock\")\n\t}\n\tcheck(v, staff, \"send\", false)\n\tadmin := staff\n\tadmin.Kind = \"admin\"\n\tadmin.Scopes = []string{\"chat:audit\"}\n\tcheck(v, admin, \"send\", true)\n\tif _, e = db.ExecContext(ctx, \"UPDATE chat_staff_authority_versions SET authority_version=1\"); e == nil {\n\t\tt.Fatal(\"Go may not write PHP authority\")\n\t}\n\tcallPHP(\"close\", \"committed\")\n\tv = version()\n\tg := check(v, staff, \"read\", false)\n\tif g.CanSend {\n\t\tt.Fatal(\"closed platform permits send\")\n\t}\n\tcheck(v, staff, \"send\", true)\n\texecute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n\tcheck(v, staff, \"read\", true)\n}\n","chat/internal/policy/projection.go":"package policy\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"sort\"\n\t\"strconv\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Projection is a validated PHP fact, not an interpretation of order status.\ntype Projection struct {\n\tScope, Episode, State, Hash    string\n\tOrderID, AssignmentID, Version ports.ID\n\tStaffConfigVersion             ports.ID\n\tMembers                        []ProjectedMember\n}\ntype ProjectedMember struct {\n\tActorID ports.ID\n\tRole    string\n\tGrant   ports.Grant\n}\n\nfunc DecodeEvent(body []byte, scope string, version ports.ID) (Projection, error) {\n\tvar event struct {\n\t\tSchema   int             `json:\"schema_version\"`\n\t\tVersion  ports.ID        `json:\"policy_version\"`\n\t\tSnapshot json.RawMessage `json:\"snapshot\"`\n\t}\n\tif len(body) > 32768 || !object(body, &event, \"schema_version\", \"policy_version\", \"snapshot\") || event.Schema != 1 || event.Version != version {\n\t\treturn Projection{}, ErrDenied\n\t}\n\treturn DecodeProjection(event.Snapshot, scope, version)\n}\n\nfunc DecodeProjection(body []byte, scope string, version ports.ID) (Projection, error) {\n\tvar s snapshot\n\tif len(body) > 16384 || json.Unmarshal(body, &s) != nil || len(s.Members) == 0 {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tsum := sha256.Sum256(body)\n\tv := row{scope: scope, orderID: string(s.OrderID), assignmentID: string(s.AssignmentID), version: string(version), state: s.State, body: string(body), hash: hex.EncodeToString(sum[:])}\n\tp := Projection{Scope: scope, Episode: s.Episode, State: s.State, Hash: v.hash, OrderID: s.OrderID, AssignmentID: s.AssignmentID, Version: version, StaffConfigVersion: s.StaffConfigVersion}\n\tfor _, m := range s.Members {\n\t\tg, err := evaluate(v, scope, version, m.ActorID, \"read\")\n\t\tif err != nil {\n\t\t\treturn Projection{}, err\n\t\t}\n\t\tp.Members = append(p.Members, ProjectedMember{m.ActorID, m.Role, g})\n\t}\n\treturn p, nil\n}\n\n// CurrentLocked always uses a current locking read, including in an older RR tx.\nfunc (r *Reader) CurrentLocked(ctx context.Context, tx *sql.Tx, scope string) (Projection, error) {\n\tif tx == nil || len(scope) < 1 || len(scope) > 96 {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tvar v row\n\tvar body sql.NullString\n\terr := tx.QueryRowContext(ctx, `SELECT scope_key,CAST(order_id AS CHAR),CAST(assignment_id AS CHAR),CAST(policy_version AS CHAR),state,\n\t\tCASE WHEN OCTET_LENGTH(snapshot_json)<=16384 THEN snapshot_json ELSE NULL END,snapshot_hash\n\t\tFROM chat_policy_guards WHERE scope_key=? LOCK IN SHARE MODE`, scope).Scan(&v.scope, &v.orderID, &v.assignmentID, &v.version, &v.state, &body, &v.hash)\n\tif err == sql.ErrNoRows {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tif err != nil {\n\t\treturn Projection{}, ports.ErrUnavailable\n\t}\n\tif !body.Valid {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tp, err := DecodeProjection([]byte(body.String), scope, ports.ID(v.version))\n\tif err != nil || p.Hash != v.hash || string(p.OrderID) != v.orderID || string(p.AssignmentID) != v.assignmentID || p.State != v.state {\n\t\treturn Projection{}, ErrDenied\n\t}\n\treturn p, nil\n}\n\n// Every platform participant must fence ALL staff epochs. Otherwise other peers\n// could send under an obsolete policy version during a staff member's absence,\n// making that gap indistinguishable from the member's old authorized history.\nfunc (r *Reader) CheckEpochsLocked(ctx context.Context, tx *sql.Tx, p Projection, actor ports.ID, action string) error {\n\t// A schema-2 snapshot may have no staff; its config epoch still fences joins.\n\tif p.StaffConfigVersion == \"\" {\n\t\treturn nil\n\t}\n\tversions := map[ports.ID]ports.ID{\"0\": p.StaffConfigVersion}\n\tisStaff := false\n\tfor _, m := range p.Members {\n\t\tif m.Role == \"platform_staff\" && (action == \"send\" || m.ActorID == actor) {\n\t\t\tversions[m.ActorID] = m.Grant.StaffUserVersion\n\t\t\tif m.ActorID == actor {\n\t\t\t\tisStaff = true\n\t\t\t}\n\t\t}\n\t}\n\t// Unaffected peers keep their authorized history, including closed scopes\n\t// whose historical staff roster intentionally never refreshes.\n\tif action == \"read\" && !isStaff {\n\t\treturn nil\n\t}\n\tids := make([]ports.ID, 0, len(versions))\n\tfor id := range versions {\n\t\tids = append(ids, id)\n\t}\n\tsort.Slice(ids, func(i, j int) bool {\n\t\ta, _ := strconv.ParseUint(string(ids[i]), 10, 64)\n\t\tb, _ := strconv.ParseUint(string(ids[j]), 10, 64)\n\t\treturn a < b\n\t})\n\tfor _, id := range ids {\n\t\tvar current string\n\t\terr := tx.QueryRowContext(ctx, `SELECT CAST(authority_version AS CHAR) FROM chat_staff_authority_versions WHERE user_id=? LOCK IN SHARE MODE`, string(id)).Scan(&current)\n\t\tif err == sql.ErrNoRows {\n\t\t\treturn ErrDenied\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif current != string(versions[id]) {\n\t\t\treturn ErrDenied\n\t\t}\n\t}\n\treturn nil\n}\n","chat/internal/policy/recipient.go":"package policy\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Internal notification eligibility uses current PHP business authority and\n// account status. It does not fabricate a logged-in user or online presence.\nfunc (r *Reader) RecipientLocked(ctx context.Context, tx *sql.Tx, scope string, actor ports.ID) (Projection, ports.Grant, error) {\n\tp, err := r.CurrentLocked(ctx, tx, scope)\n\tif err != nil {\n\t\treturn p, ports.Grant{}, err\n\t}\n\tif err = r.CheckEpochsLocked(ctx, tx, p, actor, \"read\"); err != nil {\n\t\treturn p, ports.Grant{}, err\n\t}\n\tvar active bool\n\terr = tx.QueryRowContext(ctx, `SELECT status='active' FROM users WHERE id=? LOCK IN SHARE MODE`, string(actor)).Scan(&active)\n\tif err == sql.ErrNoRows {\n\t\treturn p, ports.Grant{}, ErrDenied\n\t}\n\tif err != nil {\n\t\treturn p, ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif !active {\n\t\treturn p, ports.Grant{}, ErrDenied\n\t}\n\tfor _, m := range p.Members {\n\t\tif m.ActorID == actor && m.Grant.CanRead {\n\t\t\treturn p, m.Grant, nil\n\t\t}\n\t}\n\treturn p, ports.Grant{}, ErrDenied\n}\n","chat/internal/ports/contracts.go":"// Package ports defines service boundaries, not PHP order rules or SQL owners.\npackage ports\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"strconv\"\n\t\"time\"\n)\n\nvar (\n\tErrUnavailable = errors.New(\"CHAT_DEPENDENCY_UNAVAILABLE\")\n\tErrBusy        = errors.New(\"CHAT_RESOURCE_BUSY\")\n\tErrInvalid     = errors.New(\"CHAT_CONTRACT_INVALID\")\n)\n\n// ID is a canonical unsigned BIGINT carried as a decimal JSON string.\n// Cursor zero is allowed; an absent optional ID must use a pointer/omitempty.\ntype ID string\n\nfunc (id ID) Valid() bool {\n\tn, err := strconv.ParseUint(string(id), 10, 64)\n\treturn err == nil && strconv.FormatUint(n, 10) == string(id)\n}\n\nfunc (id ID) MarshalJSON() ([]byte, error) {\n\tif !id.Valid() {\n\t\treturn nil, ErrInvalid\n\t}\n\treturn json.Marshal(string(id))\n}\n\nfunc (id *ID) UnmarshalJSON(data []byte) error {\n\tvar value string\n\tif json.Unmarshal(data, &value) != nil || !ID(value).Valid() {\n\t\treturn ErrInvalid\n\t}\n\t*id = ID(value)\n\treturn nil\n}\n\ntype Principal struct {\n\tActorID                ID\n\tSessionID, Environment string\n\tScopes                 []string\n\tKind                   string\n\tSourceID               ID\n\tSessionVersion         string\n\tExpiresAt              time.Time\n}\ntype PolicyRequest struct {\n\tActor          Principal\n\tConversationID ID\n\tAction         string\n}\n\n// OrderContext is PHP-supplied display data, never an authorization input.\ntype OrderContext struct {\n\tPublicNo string `json:\"public_no\"`\n\tTitle    string `json:\"title\"`\n\tWorkflow string `json:\"workflow\"`\n}\n\ntype Grant struct {\n\tOrderContext     *OrderContext\n\tMemberRole       string\n\tCanRead, CanSend bool\n\tScopeKey         string\n\tVersion          ID\n\t// S05 must bind intervals to this immutable authority generation, not a\n\t// processing-time seq. Staff returning after revocation get a different key.\n\tMemberKey                            string\n\tStaffConfigVersion, StaffUserVersion ID\n}\ntype TextRequest struct {\n\tActor                    Principal\n\tConversationID, IntentID ID\n\tText, Fingerprint        string\n}\ntype SafetyResult struct {\n\tDecision, RuleVersion string\n\t// AuthorityProof binds the real AppID/OPENID generation; never client input.\n\tAuthorityProof string\n\tFinding        *SafetyFinding\n}\ntype SafetyFinding struct {\n\tProvider, Code, TraceID string\n\tContextEvidence         string\n\tLevel                   int\n\tConfirmed               bool\n}\ntype MediaRequest struct {\n\tActor                                  Principal\n\tIntentID                               ID\n\tObjectKey, ObjectVersion, ManifestHash string\n}\ntype MediaResult struct{ Decision, ObjectVersion, ManifestHash string }\ntype Reminder struct {\n\tIntentID, RecipientID, TargetSeq, ClusterVersion ID\n\tConversationID                                   ID\n\tOperationID                                      string\n}\ntype Receipt struct {\n\tOperationID, State string\n\tDiagnostic         string\n}\n\ntype Identity interface {\n\tAuthenticate(context.Context, string) (Principal, error)\n}\n\n// CommittedMessage is a best-effort wakeup, never a second message store.\ntype CommittedMessage struct{ ConversationID, Seq, PolicyVersion ID }\ntype MessagePublisher interface{ Committed(CommittedMessage) }\ntype RealtimePolicy interface {\n\tPolicy\n\tMemberCandidates(context.Context, ID) ([]ID, error)\n}\ntype Policy interface {\n\tAuthorize(context.Context, PolicyRequest) (Grant, error)\n}\ntype Safety interface {\n\tCheckText(context.Context, TextRequest) (SafetyResult, error)\n}\ntype Media interface {\n\tInspect(context.Context, MediaRequest) (MediaResult, error)\n}\ntype Notification interface {\n\tSubmit(context.Context, Reminder) (Receipt, error)\n}\ntype Set struct {\n\tIdentity     Identity\n\tPolicy       Policy\n\tSafety       Safety\n\tMedia        Media\n\tNotification Notification\n}\n\n// Audio cloud work is admitted only for a server-confirmed immutable media job.\ntype AudioInspectionRequest struct {\n Actor Principal\n ConversationID ID\n IntentID ID\n ObjectHash string\n URL string\n Segment int\n UserAudioKey string\n}\ntype Transcription struct {\n Text,RequestID,AuthorityProof,ServiceID,APIName,Engine string\n Dispatched,Known,Retryable bool\n}\ntype AudioTicket struct {TraceID,AuthorityProof string;Dispatched,Known,Retryable bool}\ntype AudioReceipt struct {AppID,TraceID,Decision,Code,Fingerprint string}\ntype AVInspector interface {\n Recognize(context.Context,AudioInspectionRequest)(Transcription,error)\n SubmitAudio(context.Context,AudioInspectionRequest)(AudioTicket,error)\n MediaAppID()string\n}\n","chat/internal/ports/contracts_test.go":"package ports\n\nimport (\n\t\"encoding/json\"\n\t\"testing\"\n)\n\nfunc TestBIGINTStringContract(t *testing.T) {\n\tfor _, v := range []ID{\"0\", \"9\", \"10\", \"9007199254740993\", \"18446744073709551615\"} {\n\t\tb, e := json.Marshal(v)\n\t\tif e != nil || string(b) != \"\\\"\"+string(v)+\"\\\"\" {\n\t\t\tt.Fatal(\"lost bigint precision\")\n\t\t}\n\t\tvar got ID\n\t\tif json.Unmarshal(b, &got) != nil || got != v {\n\t\t\tt.Fatal(\"roundtrip failed\")\n\t\t}\n\t}\n\tfor _, v := range []string{`1`, `null`, `\"\"`, `\"01\"`, `\"-1\"`, `\"1e3\"`, `\"18446744073709551616\"`} {\n\t\tvar got ID\n\t\tif json.Unmarshal([]byte(v), &got) == nil {\n\t\t\tt.Fatalf(\"invalid id accepted: %s\", v)\n\t\t}\n\t}\n}\n","chat/internal/socket/gateway.go":"package socket\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/gorilla/websocket\"\n)\n\ntype Config struct {\n\tEnabled bool `json:\"enabled\"`\n}\ntype Commands interface {\n\tExecute(context.Context, ports.Principal, string, json.RawMessage) (string, any, error)\n}\ntype Gateway struct {\n\tidentity    *auth.Service\n\tcommands    Commands\n\tgate        chan struct{}\n\tmu          sync.Mutex\n\tclients     map[*client]struct{}\n\tstopping    bool\n\tqueuedBytes atomic.Int64\n\twg          sync.WaitGroup\n\ttiming      timings\n\trealtime    *realtime\n}\ntype timings struct{ auth, write, ping, pong, idle, check, operation time.Duration }\n\nfunc New(identity *auth.Service, commands Commands) (*Gateway, error) {\n\tif identity == nil || commands == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Gateway{identity: identity, commands: commands, gate: make(chan struct{}, 16), clients: map[*client]struct{}{}, timing: timings{5 * time.Second, 2 * time.Second, 30 * time.Second, 10 * time.Second, 90 * time.Second, 5 * time.Second, 4 * time.Second}}, nil\n}\n\ntype outbound struct {\n\tframe        frame\n\tcontrol      int\n\tbytes        []byte\n\tprotected    bool\n\tepoch        uint64\n\tconversation ports.ID\n\ttypingSource *client\n\ttypingUntil  time.Time\n}\ntype client struct {\n\tg            *Gateway\n\tws           *websocket.Conn\n\ttransportMu  sync.Mutex\n\texpires      atomic.Int64\n\tauthUntil    time.Time\n\tctx          context.Context\n\tcancel       context.CancelFunc\n\tidentity     *auth.SocketIdentity\n\tactor        ports.ID\n\tkind         string\n\tout          chan outbound\n\tqueueMu      sync.Mutex\n\tstop         chan struct{}\n\tonce         sync.Once\n\tcode         atomic.Int32\n\tepoch        atomic.Uint64\n\tforeground   atomic.Bool\n\theartbeatMu  sync.Mutex\n\tchallenge    string\n\tpongUntil    time.Time\n\tlastActivity time.Time\n\tbudgetMu     sync.Mutex\n\tbudget       int\n\tbudgetAt     time.Time\n\tstateMu      sync.Mutex\n\tactive       ports.ID\n\tpresenceAt   time.Time\n\ttypingAt     time.Time\n\ttypingUntil  time.Time\n}\n\nfunc (g *Gateway) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tif r.URL.Path != \"/chat/ws\" {\n\t\tfailHTTP(w, r, 404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"GET\" {\n\t\tw.Header().Set(\"Allow\", \"GET\")\n\t\tfailHTTP(w, r, 405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\t// Credentials are accepted only in the first frame. No query or protocol\n\t// token can leak through access logs, referers or proxy diagnostics.\n\tif r.URL.RawQuery != \"\" || r.URL.ForceQuery || r.URL.RawPath != \"\" || len(r.Header.Values(\"Authorization\")) != 0 || len(r.Header.Values(\"Sec-WebSocket-Protocol\")) != 0 || r.ContentLength > 0 {\n\t\tfailHTTP(w, r, 400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tctx, cancel := context.WithCancel(context.Background())\n\tc := &client{g: g, ctx: ctx, cancel: cancel, out: make(chan outbound, 8), stop: make(chan struct{}), lastActivity: time.Now(), budgetAt: time.Now(), authUntil: time.Now().Add(g.timing.auth)}\n\tg.mu.Lock()\n\tif g.stopping || len(g.clients) >= 300 {\n\t\tg.mu.Unlock()\n\t\tcancel()\n\t\tfailHTTP(w, r, 503, \"CHAT_RESOURCE_BUSY\")\n\t\treturn\n\t}\n\tg.clients[c] = struct{}{}\n\tg.wg.Add(1)\n\tg.mu.Unlock()\n\tdefer func() {\n\t\tcancel()\n\t\tc.clearTransient()\n\t\tg.mu.Lock()\n\t\tdelete(g.clients, c)\n\t\tg.mu.Unlock()\n\t\tg.wg.Done()\n\t}()\n\tup := websocket.Upgrader{HandshakeTimeout: g.timing.write, ReadBufferSize: 4096, WriteBufferSize: 4096, EnableCompression: false, Error: func(w http.ResponseWriter, r *http.Request, status int, _ error) {\n\t\tfailHTTP(w, r, status, \"CHAT_SOCKET_UPGRADE_INVALID\")\n\t}, CheckOrigin: func(r *http.Request) bool {\n\t\torigins := r.Header.Values(\"Origin\")\n\t\tif len(origins) == 0 {\n\t\t\treturn true\n\t\t}\n\t\tif len(origins) != 1 {\n\t\t\treturn false\n\t\t}\n\t\tu, e := url.Parse(origins[0])\n\t\treturn e == nil && u.Scheme == \"https\" && u.Host == r.Host && u.User == nil && u.RawQuery == \"\" && u.Fragment == \"\" && u.Path == \"\"\n\t}}\n\tws, e := up.Upgrade(w, r, nil)\n\tif e != nil {\n\t\treturn\n\t}\n\tc.transportMu.Lock()\n\tc.ws = ws\n\tc.transportMu.Unlock()\n\tdefer ws.Close()\n\tselect {\n\tcase <-c.stop:\n\t\treturn\n\tdefault:\n\t}\n\tws.SetReadLimit(32 << 10)\n\t_ = ws.SetReadDeadline(time.Now().Add(g.timing.auth))\n\t// Control replies also go through the one writer. Control floods consume\n\t// the same in-memory budget as application commands.\n\tws.SetPingHandler(func(s string) error {\n\t\tif !c.allow() {\n\t\t\treturn ports.ErrBusy\n\t\t}\n\t\tif !c.enqueue(outbound{control: websocket.PongMessage, bytes: []byte(s)}) {\n\t\t\treturn ports.ErrBusy\n\t\t}\n\t\treturn nil\n\t})\n\tws.SetPongHandler(func(s string) error { c.pong(s); return nil })\n\tws.SetCloseHandler(func(int, string) error { return nil })\n\twriterDone := make(chan struct{})\n\tgo func() { defer close(writerDone); c.writeLoop() }()\n\texpiryDone := make(chan struct{})\n\tgo func() { defer close(expiryDone); c.expiryLoop() }()\n\tdefer func() { c.close(websocket.CloseNormalClosure); <-writerDone; <-expiryDone }()\n\tkind, raw, e := ws.ReadMessage()\n\tf, ok := decode(raw)\n\tvar q struct {\n\t\tTicket string `json:\"ticket\"`\n\t}\n\tif e != nil || kind != websocket.TextMessage || !ok || f.Type != \"auth\" || !strict(f.Payload, &q) {\n\t\tc.close(websocket.ClosePolicyViolation)\n\t\treturn\n\t}\n\tselect {\n\tcase g.gate <- struct{}{}:\n\tdefault:\n\t\tc.close(websocket.CloseTryAgainLater)\n\t\treturn\n\t}\n\top, stop := context.WithDeadline(c.ctx, minTime(c.authUntil, time.Now().Add(g.timing.operation)))\n\tclaims, e := g.identity.ConsumeTicket(op, q.Ticket)\n\tstop()\n\t<-g.gate\n\tif e != nil {\n\t\tc.close(websocket.ClosePolicyViolation)\n\t\treturn\n\t}\n\tc.identity = auth.NewSocketIdentity(claims)\n\tc.actor = claims.ActorID\n\tc.kind = claims.Kind\n\tc.expires.Store(claims.ExpiresAt)\n\tc.epoch.Store(1)\n\tc.foreground.Store(true)\n\tc.send(f, \"auth.ok\", map[string]any{\"actor_id\": claims.ActorID, \"expires_at\": claims.ExpiresAt, \"heartbeat_seconds\": 30}, true)\n\t_ = ws.SetReadDeadline(time.Now().Add(g.timing.idle))\n\tfor {\n\t\tkind, raw, e = ws.ReadMessage()\n\t\tif e != nil {\n\t\t\treturn\n\t\t}\n\t\tif kind != websocket.TextMessage {\n\t\t\tc.close(websocket.CloseUnsupportedData)\n\t\t\treturn\n\t\t}\n\t\tif !c.allow() {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn\n\t\t}\n\t\tf, ok = decode(raw)\n\t\tif !ok {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn\n\t\t}\n\t\tc.heartbeatMu.Lock()\n\t\tc.lastActivity = time.Now()\n\t\tc.heartbeatMu.Unlock()\n\t\tif f.Type == \"pong\" {\n\t\t\tvar q struct {\n\t\t\t\tNonce string `json:\"nonce\"`\n\t\t\t}\n\t\t\tif !strict(f.Payload, &q) {\n\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tc.pong(q.Nonce)\n\t\t\tcontinue\n\t\t}\n\t\tif !c.handle(f) {\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc failHTTP(w http.ResponseWriter, r *http.Request, status int, code string) {\n\tvar b [16]byte\n\t_, _ = rand.Read(b[:])\n\tid := hex.EncodeToString(b[:])\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"X-Request-ID\", id)\n\tw.WriteHeader(status)\n\tif r.Method != \"HEAD\" {\n\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"retryable\": status == 503, \"server_time\": time.Now().UTC()})\n\t}\n}\nfunc (c *client) allow() bool {\n\tc.budgetMu.Lock()\n\tdefer c.budgetMu.Unlock()\n\tif time.Since(c.budgetAt) >= time.Second {\n\t\tc.budget = 0\n\t\tc.budgetAt = time.Now()\n\t}\n\tc.budget++\n\treturn c.budget <= 20\n}\nfunc (c *client) pong(nonce string) {\n\tc.heartbeatMu.Lock()\n\tdefer c.heartbeatMu.Unlock()\n\tif c.challenge != \"\" && nonce == c.challenge {\n\t\tc.challenge = \"\"\n\t\tc.pongUntil = time.Time{}\n\t\tc.lastActivity = time.Now()\n\t\t_ = c.ws.SetReadDeadline(time.Now().Add(c.g.timing.idle))\n\t}\n}\nfunc (c *client) close(code int) {\n\tc.once.Do(func() {\n\t\tc.foreground.Store(false)\n\t\tc.code.Store(int32(code))\n\t\tclose(c.stop)\n\t\tc.cancel()\n\t})\n}\nfunc (c *client) enqueue(o outbound) bool {\n\tc.queueMu.Lock()\n\tdefer c.queueMu.Unlock()\n\tselect {\n\tcase <-c.stop:\n\t\treturn false\n\tdefault:\n\t}\n\tsize := int64(len(o.frame.Payload) + len(o.bytes) + 128)\n\tif c.g.queuedBytes.Add(size) > 16<<20 {\n\t\tc.g.queuedBytes.Add(-size)\n\t\tc.close(websocket.CloseTryAgainLater)\n\t\treturn false\n\t}\n\tselect {\n\tcase c.out <- o:\n\t\treturn true\n\tdefault:\n\t\tc.g.queuedBytes.Add(-size)\n\t\tc.close(websocket.CloseTryAgainLater)\n\t\treturn false\n\t}\n}\nfunc (c *client) send(f frame, typ string, payload any, protected bool) bool {\n\traw, e := json.Marshal(payload)\n\tif e != nil || len(raw) > 256<<10 {\n\t\tc.close(websocket.CloseInternalServerErr)\n\t\treturn false\n\t}\n\treturn c.enqueue(outbound{frame: frame{1, f.RequestID, typ, raw}, protected: protected, epoch: c.epoch.Load()})\n}\nfunc (c *client) current() (auth.Claims, error) {\n\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\tdefer cancel()\n\tfor {\n\t\tclaims, err := c.identity.Current(ctx, c.g.identity)\n\t\tif !errors.Is(err, ports.ErrBusy) {\n\t\t\treturn claims, err\n\t\t}\n\t\t// Socket admission already bounds the number of waiters. A brief\n\t\t// concurrency collision must not masquerade as revoked authority.\n\t\tvar jitter [1]byte\n\t\t_, _ = rand.Read(jitter[:])\n\t\twait := time.NewTimer(time.Duration(5+int(jitter[0])%20) * time.Millisecond)\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\twait.Stop()\n\t\t\treturn auth.Claims{}, ports.ErrUnavailable\n\t\tcase <-wait.C:\n\t\t}\n\t}\n}\nfunc (c *client) authorityClose(err error) {\n\tif errors.Is(err, auth.ErrUnauthorized) {\n\t\tc.close(websocket.ClosePolicyViolation)\n\t} else {\n\t\tc.close(websocket.CloseTryAgainLater)\n\t}\n}\nfunc minTime(a, b time.Time) time.Time {\n\tif a.Before(b) {\n\t\treturn a\n\t}\n\treturn b\n}\nfunc principal(c auth.Claims) ports.Principal {\n\treturn ports.Principal{ActorID: c.ActorID, Kind: c.Kind, SourceID: c.SourceID, SessionID: c.SessionID, Environment: c.Environment, SessionVersion: c.Version, Scopes: c.Scopes, ExpiresAt: time.Unix(c.ExpiresAt, 0).UTC()}\n}\nfunc (c *client) handle(f frame) bool {\n\tselect {\n\tcase c.g.gate <- struct{}{}:\n\t\tdefer func() { <-c.g.gate }()\n\tdefault:\n\t\treturn c.send(f, \"error\", map[string]any{\"code\": \"CHAT_RESOURCE_BUSY\", \"retryable\": true}, false)\n\t}\n\tclaims, e := c.current()\n\tif e != nil {\n\t\tc.authorityClose(e)\n\t\treturn false\n\t}\n\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\tdefer cancel()\n\tswitch f.Type {\n\tcase \"auth.refresh\":\n\t\tvar q struct {\n\t\t\tAccessToken string `json:\"access_token\"`\n\t\t}\n\t\tif !strict(f.Payload, &q) || len(q.AccessToken) > 4096 {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn false\n\t\t}\n\t\tif c.identity.Refresh(ctx, c.g.identity, q.AccessToken) != nil {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn false\n\t\t}\n\t\tc.epoch.Add(1)\n\t\tclaims, e = c.current()\n\t\tif e != nil {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn false\n\t\t}\n\t\tc.expires.Store(claims.ExpiresAt)\n\t\treturn c.send(f, \"auth.ok\", map[string]any{\"actor_id\": claims.ActorID, \"expires_at\": claims.ExpiresAt}, true)\n\tcase \"session.state\":\n\t\tvar q struct {\n\t\t\tState string `json:\"state\"`\n\t\t}\n\t\tif !strict(f.Payload, &q) || (q.State != \"foreground\" && q.State != \"background\") {\n\t\t\treturn c.send(f, \"error\", map[string]any{\"code\": \"CHAT_INVALID_REQUEST\", \"retryable\": false}, false)\n\t\t}\n\t\tc.foreground.Store(q.State == \"foreground\")\n\t\tif q.State == \"background\" {\n\t\t\tc.clearTransient()\n\t\t}\n\t\treturn c.send(f, \"session.state\", q, true)\n\tcase \"ping\":\n\t\tvar q struct {\n\t\t\tNonce string `json:\"nonce\"`\n\t\t}\n\t\tif !strict(f.Payload, &q) || len(q.Nonce) > 64 {\n\t\t\treturn c.send(f, \"error\", map[string]any{\"code\": \"CHAT_INVALID_REQUEST\", \"retryable\": false}, false)\n\t\t}\n\t\treturn c.send(f, \"pong\", q, false)\n\tcase \"auth\":\n\t\tc.close(websocket.ClosePolicyViolation)\n\t\treturn false\n\t}\n\tif handled, ok := c.transient(ctx, claims, f); handled {\n\t\treturn ok\n\t}\n\ttyp, data, e := c.g.commands.Execute(ctx, principal(claims), f.Type, f.Payload)\n\tif e != nil {\n\t\tcode, retry := \"CHAT_DEPENDENCY_UNAVAILABLE\", true\n\t\tvar safe interface{ PublicCode() (string, bool) }\n\t\tif errors.As(e, &safe) {\n\t\t\tcode, retry = safe.PublicCode()\n\t\t}\n\t\treturn c.send(f, \"error\", map[string]any{\"code\": code, \"retryable\": retry}, false)\n\t}\n\treturn c.send(f, typ, data, true)\n}\n\n// Expiry must not wait behind a slow write or a persistent-session lookup.\n// The writer remains the sole frame writer; cancellation interrupts use cases.\nfunc (c *client) expiryLoop() {\n\ttick := time.NewTicker(min(c.g.timing.check, 100*time.Millisecond))\n\tdefer tick.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-c.stop:\n\t\t\treturn\n\t\tcase now := <-tick.C:\n\t\t\tif c.epoch.Load() == 0 {\n\t\t\t\tif !now.Before(c.authUntil) {\n\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t} else if now.Unix() >= c.expires.Load() {\n\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\nfunc (c *client) writeLoop() {\n\tdefer c.ws.Close()\n\tdefer func() {\n\t\tc.queueMu.Lock()\n\t\tdefer c.queueMu.Unlock()\n\t\tfor {\n\t\t\tselect {\n\t\t\tcase o := <-c.out:\n\t\t\t\tc.g.queuedBytes.Add(-int64(len(o.frame.Payload) + len(o.bytes) + 128))\n\t\t\tdefault:\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}()\n\ttick := time.NewTicker(min(c.g.timing.check, 100*time.Millisecond))\n\tdefer tick.Stop()\n\tnextPing := time.Now().Add(c.g.timing.ping)\n\tnextCheck := time.Now().Add(c.g.timing.check)\n\tvar warned uint64\n\tfor {\n\t\tselect {\n\t\tcase <-c.stop:\n\t\t\t_ = c.ws.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(int(c.code.Load()), \"\"), time.Now().Add(c.g.timing.write))\n\t\t\treturn\n\t\tcase o := <-c.out:\n\t\t\tc.g.queuedBytes.Add(-int64(len(o.frame.Payload) + len(o.bytes) + 128))\n\t\t\tif o.protected {\n\t\t\t\tif o.epoch != c.epoch.Load() {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif o.conversation != \"\" {\n\t\t\t\t\tclaims, e := c.current()\n\t\t\t\t\tif e != nil {\n\t\t\t\t\t\tc.authorityClose(e)\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tif !c.foreground.Load() || c.g.realtime == nil {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\t\t\t\t\t_, e = c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(claims), ConversationID: o.conversation, Action: \"read\"})\n\t\t\t\t\tcancel()\n\t\t\t\t\tif e != nil {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tif o.typingSource != nil {\n\t\t\t\t\t\tc.stateMu.Lock()\n\t\t\t\t\t\tfocused := c.active == o.conversation\n\t\t\t\t\t\tc.stateMu.Unlock()\n\t\t\t\t\t\tif !focused || !o.typingSource.canType(o.conversation, o.typingUntil) {\n\t\t\t\t\t\t\tcontinue\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif _, e := c.current(); e != nil {\n\t\t\t\t\tc.authorityClose(e)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif o.epoch != c.epoch.Load() {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t}\n\t\t\tselect {\n\t\t\tcase <-c.stop:\n\t\t\t\tcontinue\n\t\t\tdefault:\n\t\t\t}\n\t\t\tdeadline := time.Now().Add(c.g.timing.write)\n\t\t\tif o.protected {\n\t\t\t\tdeadline = minTime(deadline, time.Unix(c.expires.Load(), 0))\n\t\t\t}\n\t\t\t_ = c.ws.SetWriteDeadline(deadline)\n\t\t\tvar e error\n\t\t\tif o.control != 0 {\n\t\t\t\te = c.ws.WriteControl(o.control, o.bytes, time.Now().Add(c.g.timing.write))\n\t\t\t} else {\n\t\t\t\te = c.ws.WriteJSON(o.frame)\n\t\t\t}\n\t\t\tif e != nil {\n\t\t\t\tc.close(websocket.CloseTryAgainLater)\n\t\t\t}\n\t\tcase now := <-tick.C:\n\t\t\t// epoch publishes identity after first-frame auth. Heartbeats never write\n\t\t\t// last_seen, Redis presence, read progress or successful-event logs.\n\t\t\tif c.epoch.Load() == 0 {\n\t\t\t\tif !now.Before(c.authUntil) {\n\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif now.Unix() >= c.expires.Load() {\n\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif c.expires.Load()-now.Unix() <= 30 && warned != c.epoch.Load() {\n\t\t\t\twarned = c.epoch.Load()\n\t\t\t\tc.send(frame{RequestID: \"server\"}, \"auth.required\", map[string]any{\"expires_at\": c.expires.Load()}, true)\n\t\t\t}\n\t\t\tc.heartbeatMu.Lock()\n\t\t\texpired := !c.pongUntil.IsZero() && !now.Before(c.pongUntil) || now.Sub(c.lastActivity) >= c.g.timing.idle\n\t\t\tc.heartbeatMu.Unlock()\n\t\t\tif expired {\n\t\t\t\tc.close(websocket.CloseGoingAway)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif !now.Before(nextCheck) {\n\t\t\t\tif _, e := c.current(); e != nil {\n\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tnextCheck = now.Add(c.g.timing.check)\n\t\t\t}\n\t\t\tif !now.Before(nextPing) {\n\t\t\t\tvar b [16]byte\n\t\t\t\tif _, e := rand.Read(b[:]); e != nil {\n\t\t\t\t\tc.close(websocket.CloseInternalServerErr)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tnonce := hex.EncodeToString(b[:])\n\t\t\t\tc.heartbeatMu.Lock()\n\t\t\t\tc.challenge = nonce\n\t\t\t\tc.pongUntil = now.Add(c.g.timing.pong)\n\t\t\t\tc.heartbeatMu.Unlock()\n\t\t\t\tif e := c.ws.WriteControl(websocket.PingMessage, []byte(nonce), now.Add(c.g.timing.write)); e != nil {\n\t\t\t\t\tc.close(websocket.CloseGoingAway)\n\t\t\t\t}\n\t\t\t\tnextPing = now.Add(c.g.timing.ping)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// Shutdown explicitly owns hijacked connections, which http.Server.Shutdown\n// does not wait for. Cancellation blocks admission and interrupts use cases.\nfunc (g *Gateway) Shutdown(ctx context.Context) error {\n\tg.mu.Lock()\n\tg.stopping = true\n\tif g.realtime != nil {\n\t\tg.realtime.once.Do(func() {\n\t\t\tif g.realtime.cancel != nil {\n\t\t\t\tg.realtime.cancel()\n\t\t\t}\n\t\t\tclose(g.realtime.stop)\n\t\t})\n\t}\n\tfor c := range g.clients {\n\t\tc.close(websocket.CloseGoingAway)\n\t}\n\tg.mu.Unlock()\n\tdone := make(chan struct{})\n\tgo func() {\n\t\tg.wg.Wait()\n\t\tif g.realtime != nil {\n\t\t\tg.realtime.workers.Wait()\n\t\t}\n\t\tclose(done)\n\t}()\n\tselect {\n\tcase <-done:\n\t\treturn nil\n\tcase <-ctx.Done():\n\t\tg.mu.Lock()\n\t\tfor c := range g.clients {\n\t\t\tc.transportMu.Lock()\n\t\t\tif c.ws != nil {\n\t\t\t\t_ = c.ws.Close()\n\t\t\t}\n\t\t\tc.transportMu.Unlock()\n\t\t}\n\t\tg.mu.Unlock()\n\t\treturn ctx.Err()\n\t}\n}\n","chat/internal/socket/gateway_test.go":"package socket\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/gorilla/websocket\"\n)\n\ntype tickets struct {\n\tsync.Mutex\n\tvalues map[string]string\n\tfail   atomic.Bool\n}\n\nfunc (m *tickets) Put(_ context.Context, k, v string, _ time.Duration) (bool, error) {\n\tm.Lock()\n\tdefer m.Unlock()\n\tif m.fail.Load() {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tm.values[k] = v\n\treturn true, nil\n}\nfunc (m *tickets) Take(_ context.Context, k string) (string, error) {\n\tm.Lock()\n\tdefer m.Unlock()\n\tif m.fail.Load() {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tv := m.values[k]\n\tdelete(m.values, k)\n\treturn v, nil\n}\n\ntype source struct {\n\trevoked atomic.Bool\n\tcalls   atomic.Int64\n}\n\nfunc (s *source) Validate(context.Context, auth.Claims) error {\n\ts.calls.Add(1)\n\tif s.revoked.Load() {\n\t\treturn auth.ErrUnauthorized\n\t}\n\treturn nil\n}\n\ntype echo struct {\n\tcalls atomic.Int64\n\tblock atomic.Bool\n}\n\nfunc (e *echo) Execute(ctx context.Context, p ports.Principal, typ string, raw json.RawMessage) (string, any, error) {\n\te.calls.Add(1)\n\tif typ == \"large\" {\n\t\treturn \"large.result\", strings.Repeat(\"x\", 200<<10), nil\n\t}\n\tif e.block.Load() {\n\t\t<-ctx.Done()\n\t\treturn \"\", nil, ctx.Err()\n\t}\n\treturn typ + \".result\", map[string]any{\"actor_id\": p.ActorID}, nil\n}\n\ntype fixture struct {\n\tg        *Gateway\n\ts        *auth.Service\n\tsrc      *source\n\tstore    *tickets\n\tcommands *echo\n\tpriv     ed25519.PrivateKey\n\tclaims   auth.Claims\n\tserver   *httptest.Server\n\turl      string\n}\n\nfunc setup(t *testing.T) *fixture {\n\tt.Helper()\n\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\tv, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"v1\": pub})\n\tsrc := &source{}\n\tstore := &tickets{values: map[string]string{}}\n\ts, _ := auth.NewService(v, src, store, 16, 100*time.Millisecond)\n\tcommands := &echo{}\n\tg, _ := New(s, commands)\n\tg.timing = timings{300 * time.Millisecond, 100 * time.Millisecond, 100 * time.Millisecond, 70 * time.Millisecond, 600 * time.Millisecond, 30 * time.Millisecond, 100 * time.Millisecond}\n\tserver := httptest.NewServer(g)\n\tnow := time.Now().Unix()\n\tc := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: \"18446744073709551615\", Kind: \"mini\", SourceID: \"1\", SessionID: strings.Repeat(\"a\", 64), Version: strings.Repeat(\"b\", 64), Environment: \"test\", Scopes: []string{\"chat:use\"}, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\tf := &fixture{g, s, src, store, commands, priv, c, server, \"ws\" + strings.TrimPrefix(server.URL, \"http\") + \"/chat/ws\"}\n\tt.Cleanup(func() {\n\t\tctx, cancel := context.WithTimeout(context.Background(), time.Second)\n\t\tdefer cancel()\n\t\tif err := g.Shutdown(ctx); err != nil {\n\t\t\tt.Error(err)\n\t\t}\n\t\tserver.Close()\n\t\tif g.queuedBytes.Load() != 0 {\n\t\t\tt.Error(\"outbound byte budget leaked\")\n\t\t}\n\t})\n\treturn f\n}\nfunc (f *fixture) token(c auth.Claims) string {\n\tb, _ := json.Marshal(c)\n\ta := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(b)\n\treturn a + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(f.priv, []byte(a)))\n}\nfunc (f *fixture) ticket(t *testing.T) string {\n\tt.Helper()\n\tv, _, e := f.s.IssueTicket(context.Background(), f.token(f.claims))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\treturn v\n}\nfunc (f *fixture) dial(t *testing.T) *websocket.Conn {\n\tt.Helper()\n\tc, _, e := websocket.DefaultDialer.Dial(f.url, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Cleanup(func() { c.Close() })\n\treturn c\n}\nfunc send(t *testing.T, c *websocket.Conn, typ string, payload any) {\n\tt.Helper()\n\tb, e := json.Marshal(payload)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = c.WriteJSON(frame{1, \"r1\", typ, b}); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\nfunc read(t *testing.T, c *websocket.Conn, typ string) frame {\n\tt.Helper()\n\tc.SetReadDeadline(time.Now().Add(time.Second))\n\tvar f frame\n\tif e := c.ReadJSON(&f); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif f.Type != typ || f.Version != 1 || f.RequestID != \"r1\" {\n\t\tt.Fatalf(\"wrong frame %s\", f.Type)\n\t}\n\treturn f\n}\nfunc (f *fixture) login(t *testing.T) *websocket.Conn {\n\tt.Helper()\n\tc := f.dial(t)\n\tsend(t, c, \"auth\", map[string]string{\"ticket\": f.ticket(t)})\n\tread(t, c, \"auth.ok\")\n\treturn c\n}\nfunc closed(t *testing.T, c *websocket.Conn) {\n\tt.Helper()\n\tc.SetReadDeadline(time.Now().Add(2 * time.Second))\n\tfor {\n\t\t_, _, e := c.ReadMessage()\n\t\tif e != nil {\n\t\t\tvar ce *websocket.CloseError\n\t\t\tif !errors.As(e, &ce) {\n\t\t\t\tt.Fatalf(\"connection timed out instead of closing: %v\", e)\n\t\t\t}\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc TestFirstFrameReplayAndTimeout(t *testing.T) {\n\tf := setup(t)\n\tc := f.dial(t)\n\tclosed(t, c)\n\tc = f.dial(t)\n\tsend(t, c, \"sync.request\", map[string]string{})\n\tclosed(t, c)\n\tticket := f.ticket(t)\n\tc = f.dial(t)\n\tsend(t, c, \"auth\", map[string]string{\"ticket\": ticket})\n\tread(t, c, \"auth.ok\")\n\tother := f.dial(t)\n\tsend(t, other, \"auth\", map[string]string{\"ticket\": ticket})\n\tclosed(t, other)\n\tif f.commands.calls.Load() != 0 {\n\t\tt.Fatal(\"unauthenticated command executed\")\n\t}\n}\nfunc TestConcurrentTicketReplayOnlyOneConnection(t *testing.T) {\n\tf := setup(t)\n\tticket := f.ticket(t)\n\tclients := make([]*websocket.Conn, 12)\n\tfor i := range clients {\n\t\tclients[i] = f.dial(t)\n\t}\n\tvar successes atomic.Int64\n\tvar wg sync.WaitGroup\n\tfor _, c := range clients {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tb, _ := json.Marshal(map[string]string{\"ticket\": ticket})\n\t\t\tc.WriteJSON(frame{1, \"r1\", \"auth\", b})\n\t\t\tc.SetReadDeadline(time.Now().Add(time.Second))\n\t\t\tvar out frame\n\t\t\tif c.ReadJSON(&out) == nil && out.Type == \"auth.ok\" {\n\t\t\t\tsuccesses.Add(1)\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\tif successes.Load() != 1 {\n\t\tt.Fatalf(\"ticket accepted %d times\", successes.Load())\n\t}\n}\nfunc TestRefreshIdentityRevocationAndTwoDevices(t *testing.T) {\n\tf := setup(t)\n\ta, b := f.login(t), f.login(t)\n\tsend(t, a, \"session.state\", map[string]string{\"state\": \"background\"})\n\tread(t, a, \"session.state\")\n\tsend(t, b, \"sync.request\", map[string]string{})\n\tread(t, b, \"sync.request.result\")\n\tnext := f.claims\n\tnext.IssuedAt++\n\tnext.NotBefore++\n\tnext.ExpiresAt++\n\tsend(t, a, \"auth.refresh\", map[string]string{\"access_token\": f.token(next)})\n\tread(t, a, \"auth.ok\")\n\tnext.ActorID = \"2\"\n\tsend(t, a, \"auth.refresh\", map[string]string{\"access_token\": f.token(next)})\n\tclosed(t, a)\n\t// Closing one device does not log out another; persistent PHP revocation does.\n\tsend(t, b, \"ping\", map[string]string{\"nonce\": \"alive\"})\n\tread(t, b, \"pong\")\n\tf.src.revoked.Store(true)\n\tclosed(t, b)\n}\nfunc TestExpiryCannotReviveAndIdleRevocation(t *testing.T) {\n\tf := setup(t)\n\tf.claims.ExpiresAt = time.Now().Unix() + 1\n\tc := f.login(t)\n\tclosed(t, c)\n\tif f.commands.calls.Load() != 0 {\n\t\tt.Fatal(\"expiry executed a command\")\n\t}\n}\nfunc TestHeartbeatRequiresMatchingPong(t *testing.T) {\n\tf := setup(t)\n\tc := f.login(t)\n\tc.SetPingHandler(func(string) error { return nil })\n\tclosed(t, c)\n\thealthy := f.login(t)\n\tfor i := 0; i < 5; i++ {\n\t\ttime.Sleep(45 * time.Millisecond)\n\t\tsend(t, healthy, \"ping\", map[string]string{\"nonce\": \"app\"})\n\t\tread(t, healthy, \"pong\")\n\t}\n}\nfunc TestRedisOutageDoesNotBypassTicketOrKillAuthenticatedHTTPIdentity(t *testing.T) {\n\tf := setup(t)\n\tc := f.login(t)\n\tticket := f.ticket(t)\n\tf.store.fail.Store(true)\n\tnewConnection := f.dial(t)\n\tsend(t, newConnection, \"auth\", map[string]string{\"ticket\": ticket})\n\tclosed(t, newConnection)\n\tsend(t, c, \"sync.request\", map[string]string{})\n\tread(t, c, \"sync.request.result\")\n\tif _, e := f.s.Authenticate(context.Background(), f.token(f.claims)); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\nfunc TestAdmissionAndProtocolBoundaries(t *testing.T) {\n\tf := setup(t)\n\tfor _, tc := range []struct {\n\t\tsuffix  string\n\t\theaders http.Header\n\t}{{\"?ticket=private\", nil}, {\"?\", nil}, {\"\", http.Header{\"Authorization\": {\"Bearer private\"}}}, {\"\", http.Header{\"Sec-WebSocket-Protocol\": {\"private\"}}}, {\"\", http.Header{\"Origin\": {\"https://evil.invalid\"}}}} {\n\t\tc, res, e := websocket.DefaultDialer.Dial(f.url+tc.suffix, tc.headers)\n\t\tif e == nil {\n\t\t\tc.Close()\n\t\t\tt.Fatal(\"unsafe upgrade accepted\")\n\t\t}\n\t\tif res != nil {\n\t\t\tres.Body.Close()\n\t\t}\n\t}\n\tfor _, raw := range []string{`{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"auth\",\"payload\":{\"ticket\":\"x\",\"ticket\":\"x\"}}`, `{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"auth\",\"payload\":{},\"TYPE\":\"auth\"}`, `{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"auth\",\"payload\":{\"ticket\":\"\\ud800\"}}`} {\n\t\tc := f.dial(t)\n\t\tc.WriteMessage(websocket.TextMessage, []byte(raw))\n\t\tclosed(t, c)\n\t}\n\tc := f.login(t)\n\tc.WriteMessage(websocket.BinaryMessage, []byte(\"binary\"))\n\tclosed(t, c)\n\tc = f.login(t)\n\tc.WriteMessage(websocket.TextMessage, []byte(strings.Repeat(\"x\", (32<<10)+1)))\n\tclosed(t, c)\n}\nfunc TestBoundedQueueAndShutdownIsolation(t *testing.T) {\n\tf := setup(t)\n\thealthy := f.login(t)\n\tctx, cancel := context.WithCancel(context.Background())\n\tslow := &client{g: f.g, ctx: ctx, cancel: cancel, out: make(chan outbound, 8), stop: make(chan struct{})}\n\tfor range 8 {\n\t\tif !slow.enqueue(outbound{}) {\n\t\t\tt.Fatal(\"early overflow\")\n\t\t}\n\t}\n\tif slow.enqueue(outbound{}) {\n\t\tt.Fatal(\"unbounded queue\")\n\t}\n\tif slow.code.Load() != websocket.CloseTryAgainLater {\n\t\tt.Fatal(\"slow client not disconnected\")\n\t}\n\tfor len(slow.out) > 0 {\n\t\to := <-slow.out\n\t\tf.g.queuedBytes.Add(-int64(len(o.frame.Payload) + len(o.bytes) + 128))\n\t}\n\tsend(t, healthy, \"sync.request\", map[string]string{})\n\tread(t, healthy, \"sync.request.result\")\n\t// Shutdown interrupts a blocked use case and owns the hijacked connection.\n\tf.commands.block.Store(true)\n\tsend(t, healthy, \"sync.request\", map[string]string{})\n\tshutdown, stop := context.WithTimeout(context.Background(), time.Second)\n\tdefer stop()\n\tif e := f.g.Shutdown(shutdown); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tclosed(t, healthy)\n\t_, res, e := websocket.DefaultDialer.Dial(f.url, nil)\n\tif e == nil || res == nil || res.StatusCode != 503 {\n\t\tt.Fatal(\"shutdown admitted a connection\")\n\t}\n\tres.Body.Close()\n}\nfunc TestStrictEnvelope(t *testing.T) {\n\tfor _, raw := range []string{`null`, `[]`, `{\"protocol_version\":2,\"request_id\":\"r1\",\"type\":\"ping\",\"payload\":{}}`, `{\"protocol_version\":1,\"request_id\":\"bad\\n\",\"type\":\"ping\",\"payload\":{}}`, `{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"ping\",\"payload\":null}`} {\n\t\tif _, ok := decode([]byte(raw)); ok {\n\t\t\tt.Fatal(\"invalid envelope accepted\")\n\t\t}\n\t}\n}\n\nfunc TestNetworkSlowReaderDoesNotBlockAnotherConnection(t *testing.T) {\n\tf := setup(t)\n\tslow := f.login(t)\n\thealthy := f.login(t)\n\t// Make backpressure deterministic rather than relying on the OS default\n\t// several-megabyte TCP buffers or flooding the process with test data.\n\tslow.UnderlyingConn().(*net.TCPConn).SetReadBuffer(1024)\n\tf.g.mu.Lock()\n\tvar serverSide *client\n\tfor c := range f.g.clients {\n\t\tif c.ws.RemoteAddr().String() == slow.LocalAddr().String() {\n\t\t\tserverSide = c\n\t\t\tc.ws.UnderlyingConn().(*net.TCPConn).SetWriteBuffer(1024)\n\t\t}\n\t}\n\tf.g.mu.Unlock()\n\tif serverSide == nil {\n\t\tt.Fatal(\"connection registry\")\n\t}\n\tfor range 12 {\n\t\tsend(t, slow, \"large\", map[string]string{})\n\t}\n\tsend(t, healthy, \"sync.request\", map[string]string{})\n\tread(t, healthy, \"sync.request.result\")\n\tselect {\n\tcase <-serverSide.stop:\n\tcase <-time.After(time.Second):\n\t\tt.Fatal(\"slow reader not bounded\")\n\t}\n}\n\nfunc TestBoundedGlobalOutputBudget(t *testing.T) {\n\tf := setup(t)\n\tf.g.queuedBytes.Store(16 << 20)\n\tctx, cancel := context.WithCancel(context.Background())\n\tc := &client{g: f.g, ctx: ctx, cancel: cancel, out: make(chan outbound, 8), stop: make(chan struct{})}\n\tif c.enqueue(outbound{}) || c.code.Load() != websocket.CloseTryAgainLater {\n\t\tt.Fatal(\"global byte budget bypassed\")\n\t}\n\tif f.g.queuedBytes.Load() != 16<<20 {\n\t\tt.Fatal(\"failed enqueue retained bytes\")\n\t}\n\tf.g.queuedBytes.Store(0)\n}\n\ntype contentionSource struct {\n\tentered chan struct{}\n\trelease chan struct{}\n\trevoked atomic.Bool\n}\n\nfunc (s *contentionSource) Validate(ctx context.Context, c auth.Claims) error {\n\tselect {\n\tcase s.entered <- struct{}{}:\n\tdefault:\n\t}\n\tselect {\n\tcase <-ctx.Done():\n\t\treturn ports.ErrUnavailable\n\tcase <-s.release:\n\t}\n\tif s.revoked.Load() {\n\t\treturn auth.ErrUnauthorized\n\t}\n\treturn nil\n}\nfunc TestS21SocketAuthorityContentionRetriesWithinBudgetAndStillRevokes(t *testing.T) {\n\tf := setup(t)\n\tpub := f.priv.Public().(ed25519.PublicKey)\n\tverifier, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"v1\": pub})\n\tsrc := &contentionSource{entered: make(chan struct{}, 1), release: make(chan struct{})}\n\tservice, _ := auth.NewService(verifier, src, f.store, 1, 100*time.Millisecond)\n\tfinished := make(chan error, 1)\n\tgo func() { _, err := service.Check(context.Background(), f.token(f.claims)); finished <- err }()\n\t<-src.entered\n\tc := &client{ctx: context.Background(), g: &Gateway{identity: service, timing: timings{operation: 100 * time.Millisecond}}, identity: auth.NewSocketIdentity(f.claims)}\n\ttimer := time.AfterFunc(20*time.Millisecond, func() { close(src.release) })\n\tdefer timer.Stop()\n\tif _, err := c.current(); err != nil {\n\t\tt.Fatal(\"transient contention treated as revocation\", err)\n\t}\n\tif err := <-finished; err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrc.revoked.Store(true)\n\tif _, err := c.current(); err != auth.ErrUnauthorized {\n\t\tt.Fatal(\"real revoke was softened\", err)\n\t}\n}\n","chat/internal/socket/protocol.go":"// Package socket owns the single-instance WSS transport, never business SQL.\npackage socket\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"unicode/utf8\"\n)\n\ntype frame struct {\n\tVersion   int             `json:\"protocol_version\"`\n\tRequestID string          `json:\"request_id\"`\n\tType      string          `json:\"type\"`\n\tPayload   json.RawMessage `json:\"payload\"`\n}\n\nvar requestID = regexp.MustCompile(`^[A-Za-z0-9_.:-]{1,64}$`)\n\n// JSON's duplicate keys, case aliases and replacement of unpaired surrogates\n// must not give different transports different interpretations of a command.\nfunc strict(raw []byte, target any) bool {\n\tif !utf8.Valid(raw) || !surrogates(raw) {\n\t\treturn false\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\tif !unique(d, 0) {\n\t\treturn false\n\t}\n\tif _, e := d.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\td = json.NewDecoder(bytes.NewReader(raw))\n\td.DisallowUnknownFields()\n\treturn d.Decode(target) == nil\n}\nfunc unique(d *json.Decoder, depth int) bool {\n\tif depth > 12 {\n\t\treturn false\n\t}\n\tt, e := d.Token()\n\tif e != nil || t == nil {\n\t\treturn false\n\t}\n\tdelim, ok := t.(json.Delim)\n\tif !ok {\n\t\treturn true\n\t}\n\tif delim != '{' && delim != '[' {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tif delim == '{' {\n\t\t\tt, e = d.Token()\n\t\t\tk, ok := t.(string)\n\t\t\tif e != nil || !ok || seen[k] || k != strings.ToLower(k) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tseen[k] = true\n\t\t}\n\t\tif !unique(d, depth+1) {\n\t\t\treturn false\n\t\t}\n\t}\n\tend, e := d.Token()\n\treturn e == nil && (delim == '{' && end == json.Delim('}') || delim == '[' && end == json.Delim(']'))\n}\nfunc surrogates(raw []byte) bool {\n\tfor i := 0; i < len(raw); i++ {\n\t\tif raw[i] != '\\\\' {\n\t\t\tcontinue\n\t\t}\n\t\ti++\n\t\tif i >= len(raw) {\n\t\t\treturn false\n\t\t}\n\t\tif raw[i] != 'u' {\n\t\t\tcontinue\n\t\t}\n\t\tif i+4 >= len(raw) {\n\t\t\treturn false\n\t\t}\n\t\tn, e := strconv.ParseUint(string(raw[i+1:i+5]), 16, 16)\n\t\tif e != nil {\n\t\t\treturn false\n\t\t}\n\t\ti += 4\n\t\tif n >= 0xdc00 && n <= 0xdfff {\n\t\t\treturn false\n\t\t}\n\t\tif n >= 0xd800 && n <= 0xdbff {\n\t\t\tif i+6 >= len(raw) || raw[i+1] != '\\\\' || raw[i+2] != 'u' {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tn, e = strconv.ParseUint(string(raw[i+3:i+7]), 16, 16)\n\t\t\tif e != nil || n < 0xdc00 || n > 0xdfff {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\ti += 6\n\t\t}\n\t}\n\treturn true\n}\nfunc decode(raw []byte) (frame, bool) {\n\tvar f frame\n\tok := strict(raw, &f) && len(bytes.TrimSpace(raw)) > 0 && bytes.TrimSpace(raw)[0] == '{' && f.Version == 1 && requestID.MatchString(f.RequestID) && len(f.Type) <= 64 && len(f.Payload) > 0 && f.Payload[0] == '{'\n\treturn f, ok\n}\n","chat/internal/socket/realtime.go":"package socket\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype liveEvent struct {\n\tmessage ports.CommittedMessage\n\tkind    string\n\tsource  *client\n\tuntil   time.Time\n}\ntype realtime struct {\n\tpolicy  ports.RealtimePolicy\n\tevents  chan liveEvent\n\tstop    chan struct{}\n\tonce    sync.Once\n\tworkers sync.WaitGroup\n\tctx     context.Context\n\tcancel  context.CancelFunc\n}\n\nfunc NewWithPolicy(identity *auth.Service, commands Commands, policy ports.RealtimePolicy) (*Gateway, error) {\n\tif policy == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tg, e := New(identity, commands)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tg.realtime = &realtime{policy: policy, events: make(chan liveEvent, 64), stop: make(chan struct{})}\n\tg.realtime.ctx, g.realtime.cancel = context.WithCancel(context.Background())\n\tfor range 2 {\n\t\tg.realtime.workers.Add(1)\n\t\tgo func() { defer g.realtime.workers.Done(); g.deliver() }()\n\t}\n\treturn g, nil\n}\n\n// Called only AFTER MySQL COMMIT. Admission is bounded and performs no I/O.\n// A lost wakeup is recovered by account reconciliation and both opaque cursors.\nfunc (g *Gateway) Changed(m ports.CommittedMessage) {\n    g.offer(liveEvent{message:m,kind:\"message.changed\"})\n}\nfunc (g *Gateway) Committed(m ports.CommittedMessage) {\n\tg.offer(liveEvent{message: m, kind: \"message.new\"})\n}\nfunc (g *Gateway) offer(e liveEvent) {\n\tif g.realtime == nil {\n\t\treturn\n\t}\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tif g.stopping {\n\t\treturn\n\t}\n\tselect {\n\tcase g.realtime.events <- e:\n\tdefault:\n\t}\n}\nfunc (g *Gateway) connections() []*client {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tlist := make([]*client, 0, len(g.clients))\n\tfor c := range g.clients {\n\t\tif c.epoch.Load() > 0 {\n\t\t\tlist = append(list, c)\n\t\t}\n\t}\n\treturn list\n}\nfunc (g *Gateway) deliver() {\n\tfor {\n\t\tselect {\n\t\tcase <-g.realtime.stop:\n\t\t\treturn\n\t\tcase event := <-g.realtime.events:\n\t\t\troot := g.realtime.ctx\n\t\t\tif root == nil {\n\t\t\t\troot = context.Background()\n\t\t\t}\n\t\t\tctx, cancel := context.WithTimeout(root, 2*time.Second)\n\t\t\tids, e := g.realtime.policy.MemberCandidates(ctx, event.message.ConversationID)\n\t\t\tcancel()\n\t\t\tif e != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tcandidates := map[ports.ID]bool{}\n\t\t\tfor _, id := range ids {\n\t\t\t\tcandidates[id] = true\n\t\t\t}\n\t\t\tfor _, c := range g.connections() {\n\t\t\t\tif c.kind != \"mini\" || !candidates[c.actor] || !c.foreground.Load() {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif event.kind == \"presence.changed\" {\n\t\t\t\t\tc.stateMu.Lock()\n\t\t\t\t\tfocused := c.active == event.message.ConversationID\n\t\t\t\t\tc.stateMu.Unlock()\n\t\t\t\t\tif !focused {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif event.source != nil {\n\t\t\t\t\tc.stateMu.Lock()\n\t\t\t\t\tfocused := c.active == event.message.ConversationID\n\t\t\t\t\tc.stateMu.Unlock()\n\t\t\t\t\tif !focused || c.actor == event.source.actor {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tpayload := map[string]any{\"conversation_id\": event.message.ConversationID}\n\t\t\t\tif event.kind == \"message.new\" {\n\t\t\t\t\tpayload[\"highest_seq\"] = event.message.Seq\n\t\t\t\t\tpayload[\"policy_version\"] = event.message.PolicyVersion\n\t\t\t\t}\n\t\t\t\tif event.source != nil {\n\t\t\t\t\tpayload[\"actor_id\"] = event.source.actor\n\t\t\t\t\tpayload[\"expires_at\"] = event.until.UnixMilli()\n\t\t\t\t}\n\t\t\t\tc.live(frame{RequestID: \"server\"}, event.kind, payload, event.message.ConversationID, event.source, event.until)\n\t\t\t\tif event.kind == \"message.new\" || event.kind==\"message.changed\" {\n\t\t\t\t\tc.live(frame{RequestID: \"server\"}, \"account.summary.changed\", map[string]bool{\"reconcile\": true}, event.message.ConversationID, nil, time.Time{})\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\nfunc (c *client) live(f frame, typ string, payload any, id ports.ID, source *client, until time.Time) bool {\n\traw, e := json.Marshal(payload)\n\tif e != nil {\n\t\treturn false\n\t}\n\treturn c.enqueue(outbound{frame: frame{1, f.RequestID, typ, raw}, protected: true, epoch: c.epoch.Load(), conversation: id, typingSource: source, typingUntil: until})\n}\nfunc (c *client) clearTransient() {\n\tc.stateMu.Lock()\n\tprevious := c.active\n\tc.active = \"\"\n\tc.typingUntil = time.Time{}\n\tc.stateMu.Unlock()\n\tif previous != \"\" {\n\t\tc.g.offer(liveEvent{message: ports.CommittedMessage{ConversationID: previous}, kind: \"presence.changed\"})\n\t}\n}\nfunc (c *client) canType(id ports.ID, until time.Time) bool {\n\tselect {\n\tcase <-c.stop:\n\t\treturn false\n\tdefault:\n\t}\n\tif !c.foreground.Load() || time.Now().Unix() >= c.expires.Load() {\n\t\treturn false\n\t}\n\tc.stateMu.Lock()\n\tvalid := c.active == id && c.typingUntil.Equal(until) && (until.IsZero() || time.Now().Before(until))\n\tc.stateMu.Unlock()\n\tif !valid {\n\t\treturn false\n\t}\n\tclaims, e := c.current()\n\tif e != nil {\n\t\treturn false\n\t}\n\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\tdefer cancel()\n\taction := \"send\"\n\tif until.IsZero() {\n\t\taction = \"read\"\n\t}\n\t_, e = c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(claims), ConversationID: id, Action: action})\n\treturn e == nil\n}\nfunc (c *client) transient(ctx context.Context, claims auth.Claims, f frame) (bool, bool) {\n\tswitch f.Type {\n\tcase \"conversation.focus\", \"presence.query\", \"typing.start\", \"typing.stop\":\n\tdefault:\n\t\treturn false, false\n\t}\n\tfail := func(code string) (bool, bool) {\n\t\treturn true, c.send(f, \"error\", map[string]any{\"code\": code, \"retryable\": false}, false)\n\t}\n\tif c.g.realtime == nil {\n\t\treturn fail(\"CHAT_REALTIME_NOT_READY\")\n\t}\n\tvar q struct {\n\t\tConversationID ports.ID `json:\"conversation_id\"`\n\t}\n\tif !strict(f.Payload, &q) || !q.ConversationID.Valid() {\n\t\treturn fail(\"CHAT_INVALID_REQUEST\")\n\t}\n\tif f.Type == \"conversation.focus\" && q.ConversationID == \"0\" {\n\t\tc.clearTransient()\n\t\treturn true, c.send(f, \"conversation.focus.result\", q, true)\n\t}\n\taction := \"read\"\n\tif f.Type == \"typing.start\" {\n\t\taction = \"send\"\n\t}\n\tif _, e := c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(claims), ConversationID: q.ConversationID, Action: action}); e != nil {\n\t\treturn fail(\"CHAT_PERMISSION_DENIED\")\n\t}\n\tswitch f.Type {\n\tcase \"conversation.focus\":\n\t\tc.clearTransient()\n\t\tc.stateMu.Lock()\n\t\tc.active = q.ConversationID\n\t\tc.stateMu.Unlock()\n\t\tc.g.offer(liveEvent{message: ports.CommittedMessage{ConversationID: q.ConversationID}, kind: \"presence.changed\"})\n\t\treturn true, c.live(f, \"conversation.focus.result\", q, q.ConversationID, nil, time.Time{})\n\tcase \"presence.query\":\n\t\tc.stateMu.Lock()\n\t\tif time.Since(c.presenceAt) < time.Second {\n\t\t\tc.stateMu.Unlock()\n\t\t\treturn fail(\"CHAT_RESOURCE_BUSY\")\n\t\t}\n\t\tc.presenceAt = time.Now()\n\t\tc.stateMu.Unlock()\n\t\tids, e := c.g.realtime.policy.MemberCandidates(ctx, q.ConversationID)\n\t\tif e != nil {\n\t\t\treturn fail(\"CHAT_DEPENDENCY_UNAVAILABLE\")\n\t\t}\n\t\tcandidates := map[ports.ID]bool{}\n\t\tfor _, id := range ids {\n\t\t\tcandidates[id] = true\n\t\t}\n\t\tonline := []ports.ID{}\n\t\ttyping := []ports.ID{}\n\t\tseen := map[ports.ID]bool{}\n\t\ttypingSeen := map[ports.ID]bool{}\n\t\tfor _, other := range c.g.connections() {\n\t\t\tif ctx.Err() != nil {\n\t\t\t\treturn fail(\"CHAT_DEPENDENCY_UNAVAILABLE\")\n\t\t\t}\n\t\t\tif other.kind != \"mini\" || !candidates[other.actor] || !other.foreground.Load() {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tp, e := other.identity.Current(ctx, c.g.identity)\n\t\t\tif e != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tgrant, e := c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(p), ConversationID: q.ConversationID, Action: \"read\"})\n\t\t\tif e != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tother.heartbeatMu.Lock()\n\t\t\thealthy := time.Since(other.lastActivity) < c.g.timing.idle && (other.pongUntil.IsZero() || time.Now().Before(other.pongUntil))\n\t\t\tother.heartbeatMu.Unlock()\n\t\t\tif !healthy {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif !seen[other.actor] {\n\t\t\t\tseen[other.actor] = true\n\t\t\t\tonline = append(online, other.actor)\n\t\t\t}\n\t\t\tother.stateMu.Lock()\n\t\t\tactive, until := other.active, other.typingUntil\n\t\t\tother.stateMu.Unlock()\n\t\t\tif active == q.ConversationID && time.Now().Before(until) && grant.CanSend && !typingSeen[other.actor] {\n\t\t\t\ttypingSeen[other.actor] = true\n\t\t\t\ttyping = append(typing, other.actor)\n\t\t\t}\n\t\t}\n\t\treturn true, c.live(f, \"presence.snapshot\", map[string]any{\"conversation_id\": q.ConversationID, \"online_actor_ids\": online, \"typing_actor_ids\": typing, \"ttl_seconds\": 6}, q.ConversationID, nil, time.Time{})\n\tcase \"typing.start\", \"typing.stop\":\n\t\tif !c.foreground.Load() {\n\t\t\treturn fail(\"CHAT_PERMISSION_DENIED\")\n\t\t}\n\t\tc.stateMu.Lock()\n\t\tif c.active != q.ConversationID {\n\t\t\tc.stateMu.Unlock()\n\t\t\treturn fail(\"CHAT_PERMISSION_DENIED\")\n\t\t}\n\t\tnow := time.Now()\n\t\tif f.Type == \"typing.start\" {\n\t\t\tif now.Sub(c.typingAt) < 2*time.Second {\n\t\t\t\tc.stateMu.Unlock()\n\t\t\t\treturn true, c.send(f, \"typing.result\", map[string]bool{\"throttled\": true}, true)\n\t\t\t}\n\t\t\tc.typingAt = now\n\t\t\tc.typingUntil = now.Add(6 * time.Second)\n\t\t} else {\n\t\t\tc.typingUntil = time.Time{}\n\t\t}\n\t\tuntil := c.typingUntil\n\t\tc.stateMu.Unlock()\n\t\t// Stop is best-effort; no stale start may pass the writer's source check.\n\t\tif f.Type == \"typing.start\" || f.Type == \"typing.stop\" {\n\t\t\tc.g.offer(liveEvent{message: ports.CommittedMessage{ConversationID: q.ConversationID}, kind: f.Type, source: c, until: until})\n\t\t}\n\t\treturn true, c.live(f, \"typing.result\", map[string]bool{\"active\": f.Type == \"typing.start\"}, q.ConversationID, nil, time.Time{})\n\t}\n\treturn false, false\n}\n","chat/internal/socket/realtime_test.go":"package socket\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc readLive(t *testing.T, c interface {\n\tSetReadDeadline(time.Time) error\n\tReadJSON(any) error\n}, typ string) frame {\n\tt.Helper()\n\t_ = c.SetReadDeadline(time.Now().Add(time.Second))\n\tfor {\n\t\tvar f frame\n\t\tif e := c.ReadJSON(&f); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif f.RequestID == \"server\" && f.Type == \"presence.changed\" {\n\t\t\tcontinue\n\t\t}\n\t\tif f.Type != typ {\n\t\t\tt.Fatalf(\"got %s want %s\", f.Type, typ)\n\t\t}\n\t\treturn f\n\t}\n}\n\ntype livePolicy struct {\n\tdeny  atomic.Bool\n\tcalls atomic.Int64\n}\n\nfunc (p *livePolicy) Authorize(context.Context, ports.PolicyRequest) (ports.Grant, error) {\n\tp.calls.Add(1)\n\tif p.deny.Load() {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\treturn ports.Grant{CanRead: true, CanSend: true, Version: \"1\"}, nil\n}\nfunc (p *livePolicy) MemberCandidates(context.Context, ports.ID) ([]ports.ID, error) {\n\treturn []ports.ID{\"18446744073709551615\"}, nil\n}\nfunc liveSetup(t *testing.T) (*fixture, *livePolicy) {\n\tf := setup(t)\n\tp := &livePolicy{}\n\tf.g.realtime = &realtime{policy: p, events: make(chan liveEvent, 64), stop: make(chan struct{})}\n\tf.g.realtime.workers.Add(1)\n\tgo func() { defer f.g.realtime.workers.Done(); f.g.deliver() }()\n\treturn f, p\n}\nfunc TestS11CommittedHintContainsNoMessageBody(t *testing.T) {\n\tf, p := liveSetup(t)\n\tc := f.login(t)\n\tf.g.Committed(ports.CommittedMessage{ConversationID: \"77\", Seq: \"103\", PolicyVersion: \"1\"})\n\tc.SetReadDeadline(time.Now().Add(time.Second))\n\tvar event frame\n\tif e := c.ReadJSON(&event); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif event.Type != \"message.new\" || event.RequestID != \"server\" {\n\t\tt.Fatal(event.Type)\n\t}\n\tvar payload map[string]any\n\tjson.Unmarshal(event.Payload, &payload)\n\tif len(payload) != 3 || payload[\"highest_seq\"] != \"103\" || payload[\"text\"] != nil {\n\t\tt.Fatal(payload)\n\t}\n\tif e := c.ReadJSON(&event); e != nil || event.Type != \"account.summary.changed\" {\n\t\tt.Fatal(\"account wakeup\", e)\n\t}\n\tif p.calls.Load() < 2 {\n\t\tt.Fatal(\"output did not reauthorize\")\n\t}\n}\nfunc TestS11WriterDropsQueuedHintAfterMembershipLoss(t *testing.T) {\n\tf, p := liveSetup(t)\n\tc := f.login(t)\n\tp.deny.Store(true)\n\tf.g.Committed(ports.CommittedMessage{ConversationID: \"77\", Seq: \"1\", PolicyVersion: \"1\"})\n\t// Ordered application response can pass, but no unauthorized hint may pass.\n\tsend(t, c, \"ping\", map[string]string{\"nonce\": \"barrier\"})\n\tread(t, c, \"pong\")\n\ttime.Sleep(45 * time.Millisecond)\n\tsend(t, c, \"ping\", map[string]string{\"nonce\": \"barrier2\"})\n\tread(t, c, \"pong\")\n}\nfunc TestS11PresenceBackgroundAndTypingThrottle(t *testing.T) {\n\tf, _ := liveSetup(t)\n\tc := f.login(t)\n\tsend(t, c, \"conversation.focus\", map[string]string{\"conversation_id\": \"77\"})\n\treadLive(t, c, \"conversation.focus.result\")\n\tsend(t, c, \"typing.start\", map[string]string{\"conversation_id\": \"77\"})\n\treadLive(t, c, \"typing.result\")\n\tsend(t, c, \"typing.start\", map[string]string{\"conversation_id\": \"77\"})\n\tr := readLive(t, c, \"typing.result\")\n\tvar throttled map[string]bool\n\tjson.Unmarshal(r.Payload, &throttled)\n\tif !throttled[\"throttled\"] {\n\t\tt.Fatal(\"typing not throttled\")\n\t}\n\tsend(t, c, \"presence.query\", map[string]string{\"conversation_id\": \"77\"})\n\tr = readLive(t, c, \"presence.snapshot\")\n\tvar snapshot struct {\n\t\tOnline []ports.ID `json:\"online_actor_ids\"`\n\t\tTyping []ports.ID `json:\"typing_actor_ids\"`\n\t}\n\tjson.Unmarshal(r.Payload, &snapshot)\n\tif len(snapshot.Online) != 1 || len(snapshot.Typing) != 1 {\n\t\tt.Fatal(\"live snapshot\")\n\t}\n\tsend(t, c, \"session.state\", map[string]string{\"state\": \"background\"})\n\treadLive(t, c, \"session.state\")\n\t// Background sockets cannot publish ephemeral activity. The ordinary state\n\t// acknowledgement remains allowed so the client can complete its transition.\n\tsend(t, c, \"typing.start\", map[string]string{\"conversation_id\": \"77\"})\n\treadLive(t, c, \"error\")\n}\nfunc TestS11CommitQueueNeverBlocksAndDoesNotGrow(t *testing.T) {\n\tf := setup(t)\n\tf.g.realtime = &realtime{policy: &livePolicy{}, events: make(chan liveEvent, 64), stop: make(chan struct{})}\n\tfor range 10000 {\n\t\tf.g.Committed(ports.CommittedMessage{ConversationID: \"1\", Seq: \"1\", PolicyVersion: \"1\"})\n\t}\n\tif len(f.g.realtime.events) != 64 {\n\t\tt.Fatal(\"unbounded event queue\")\n\t}\n}\n","chat/internal/storagepolicy/policy.go":"// Package storagepolicy defines PHP-owned storage settings consumed by Go.\npackage storagepolicy\n\nimport (\n \"bytes\"\n \"context\"\n \"database/sql\"\n \"encoding/json\"\n \"errors\"\n \"io\"\n \"time\"\n)\n\nvar ErrPolicy = errors.New(\"CHAT_STORAGE_POLICY_UNAVAILABLE\")\n\ntype Rule struct {\n Mode string `json:\"mode\"`\n Days int `json:\"days\"`\n}\ntype Retention struct {\n Text Rule `json:\"text\"`\n Image Rule `json:\"image\"`\n Audio Rule `json:\"audio\"`\n Video Rule `json:\"video\"`\n}\ntype Tiering struct {\n Enabled bool `json:\"enabled\"`\n Images bool `json:\"images\"`\n Audio bool `json:\"audio\"`\n Videos bool `json:\"videos\"`\n AgeDays int `json:\"age_days\"`\n IdleDays int `json:\"idle_days\"`\n MinBytes int64 `json:\"min_bytes\"`\n RemainingDays int `json:\"remaining_days\"`\n Batch int `json:\"batch\"`\n}\ntype Quota struct {\n VideoCount int `json:\"video_count\"`\n VideoBytes int64 `json:\"video_bytes\"`\n}\ntype Policy struct {\n Schema int `json:\"schema\"`\n Retention Retention `json:\"retention\"`\n Tiering Tiering `json:\"tiering\"`\n Quota Quota `json:\"quota\"`\n}\ntype Snapshot struct {\n Revision uint64 `json:\"revision,string\"`\n Policy Policy `json:\"policy\"`\n ApplyThrough uint64 `json:\"apply_through_id,string\"`\n}\nfunc Defaults() Policy {\n permanent := Rule{Mode:\"permanent\"}\n return Policy{Schema:1,Retention:Retention{permanent,permanent,permanent,Rule{\"days\",60}},\n  Tiering:Tiering{Enabled:false,Images:true,Audio:true,AgeDays:60,IdleDays:30,MinBytes:65536,RemainingDays:32,Batch:20},\n  Quota:Quota{VideoCount:20,VideoBytes:100*1024*1024}}\n}\nfunc (r Rule) Valid() bool {\n return r.Mode==\"permanent\" && r.Days==0 || r.Mode==\"days\" && r.Days>=1 && r.Days<=3650\n}\nfunc (p Policy) Valid() bool {\n t:=p.Tiering\n return p.Schema==1 && p.Retention.Text.Valid() && p.Retention.Image.Valid() && p.Retention.Audio.Valid() && p.Retention.Video.Valid() &&\n  (!t.Enabled || t.Images || t.Audio || t.Videos) && t.AgeDays>=30 && t.AgeDays<=3650 && t.IdleDays>=1 && t.IdleDays<=3650 &&\n  t.MinBytes>=65536 && t.MinBytes<=1024*1024*1024 && t.RemainingDays>=32 && t.RemainingDays<=3650 && t.Batch>=1 && t.Batch<=50 &&\n  p.Quota.VideoCount>=1 && p.Quota.VideoCount<=200 && p.Quota.VideoBytes>=20*1024*1024 && p.Quota.VideoBytes<=2*1024*1024*1024\n}\nfunc Decode(raw []byte) (Policy,error) {\n var p Policy\n if len(raw)==0 || len(raw)>8192 || !uniqueJSON(raw) {return p,ErrPolicy}\n d:=json.NewDecoder(bytes.NewReader(raw));d.DisallowUnknownFields()\n if d.Decode(&p)!=nil || d.Decode(new(any))!=io.EOF || !p.Valid() {return Policy{},ErrPolicy}\n // Reject JSON null and duplicate keys, including case aliases: re-encoding a\n // strict, exact-shape object must have the same normalized JSON tree.\n var seen any\n if json.Unmarshal(raw,&seen)!=nil {return Policy{},ErrPolicy}\n if !exactShape(seen,p) {return Policy{},ErrPolicy}\n return p,nil\n}\nfunc exactShape(raw any,p Policy) bool {\n canonical,_:=json.Marshal(p)\n var want any\n _=json.Unmarshal(canonical,&want)\n // Unknown fields/case aliases/missing fields (even zero-valued ones) fail.\n a,_:=json.Marshal(raw);b,_:=json.Marshal(want)\n return bytes.Equal(a,b)\n}\nfunc uniqueJSON(raw []byte) bool {\n d:=json.NewDecoder(bytes.NewReader(raw))\n var visit func() bool\n visit=func()bool{\n  token,e:=d.Token();if e!=nil{return false}\n  delim,ok:=token.(json.Delim);if !ok{return true}\n  if delim=='{' {\n   keys:=map[string]bool{}\n   for d.More(){v,e:=d.Token();k,ok:=v.(string);if e!=nil||!ok||keys[k]{return false};keys[k]=true;if !visit(){return false}}\n   end,e:=d.Token();return e==nil&&end==json.Delim('}')\n  }\n  if delim=='[' {for d.More(){if !visit(){return false}};end,e:=d.Token();return e==nil&&end==json.Delim(']')}\n  return false\n }\n return visit()\n}\nfunc (p Policy) Rule(kind string)(Rule,error) {\n switch kind {\n case \"text\":return p.Retention.Text,nil\n case \"image\",\"image_album\":return p.Retention.Image,nil\n case \"audio\":return p.Retention.Audio,nil\n case \"video\":return p.Retention.Video,nil\n }\n return Rule{},ErrPolicy\n}\nfunc (r Rule) Deadline(created time.Time) *time.Time {\n if r.Mode==\"permanent\" {return nil}\n v:=created.UTC().Add(time.Duration(r.Days)*24*time.Hour);return &v\n}\nfunc Load(ctx context.Context,tx *sql.Tx)(Snapshot,error) {\n var s Snapshot\n var raw []byte\n if tx.QueryRowContext(ctx,\"SELECT revision,policy_json,apply_through_id FROM chat_storage_policy WHERE id=1 LOCK IN SHARE MODE\").Scan(&s.Revision,&raw,&s.ApplyThrough)!=nil||s.Revision==0||!uniqueJSON(raw){return Snapshot{},ErrPolicy}\n p,e:=Decode(raw);if e!=nil{return Snapshot{},e};s.Policy=p\n return s,nil\n}\nfunc Stamp(ctx context.Context,tx *sql.Tx,id int64,kind string)error {\n s,e:=Load(ctx,tx);if e!=nil{return e};r,e:=s.Policy.Rule(kind);if e!=nil{return e}\n var days any\n if r.Mode==\"days\"{days=r.Days}\n result,e:=tx.ExecContext(ctx,\"UPDATE chat_messages SET retention_policy_version=?,retention_mode=?,expires_at=IF(? IS NULL,NULL,TIMESTAMPADD(DAY,?,created_at)) WHERE id=?\",s.Revision,r.Mode,days,days,id)\n if e!=nil{return ErrPolicy};n,e:=result.RowsAffected();if e!=nil||n!=1{return ErrPolicy};return nil\n}\n","chat/internal/storagepolicy/policy_test.go":"package storagepolicy\n\nimport (\n \"encoding/json\"\n \"strings\"\n \"testing\"\n \"time\"\n)\nfunc TestPolicyDefaultsAndStrictWireContract(t *testing.T) {\n p:=Defaults();b,_:=json.Marshal(p)\n got,e:=Decode(b);if e!=nil||got.Retention.Text.Mode!=\"permanent\"||got.Retention.Image.Mode!=\"permanent\"||got.Retention.Audio.Mode!=\"permanent\"||got.Retention.Video.Days!=60||got.Tiering.Enabled{t.Fatal(got,e)}\n for _,raw:=range []string{\n  strings.Replace(string(b),\"\\\"schema\\\":1\",\"\\\"schema\\\":1,\\\"schema\\\":1\",1),\n  strings.Replace(string(b),\"\\\"schema\\\":1\",\"\\\"Schema\\\":1\",1),\n  strings.Replace(string(b),\"\\\"enabled\\\":false\",\"\\\"enabled\\\":null\",1),\n  strings.Replace(string(b),\"\\\"videos\\\":false,\",\"\",1),\n  strings.Replace(string(b),\"\\\"days\\\":0\",\"\\\"days\\\":1\",1),\n  strings.Replace(string(b),\"\\\"days\\\":60\",\"\\\"days\\\":0\",1),\n  string(b)+\"{}\",\n }{if _,e:=Decode([]byte(raw));e==nil{t.Fatal(\"invalid policy accepted\",raw)}}\n}\nfunc TestRuleDeadlineAndModeIsolation(t *testing.T){\n p:=Defaults();now:=time.Date(2026,1,1,12,0,0,0,time.UTC)\n for _,kind:=range []string{\"text\",\"image\",\"image_album\",\"audio\"}{r,e:=p.Rule(kind);if e!=nil||r.Deadline(now)!=nil{t.Fatal(kind,r,e)}}\n video,_:=p.Rule(\"video\");if v:=video.Deadline(now);v==nil||!v.Equal(now.Add(60*24*time.Hour)){t.Fatal(v)}\n if _,e:=p.Rule(\"file\");e==nil{t.Fatal(\"unknown media\")}\n p.Tiering.Enabled=true;p.Tiering.Images=false;p.Tiering.Audio=false\n if p.Valid(){t.Fatal(\"enabled empty type set\")}\n p=Defaults();p.Retention.Text=Rule{Mode:\"days\",Days:7}\n if !p.Valid()||p.Retention.Audio.Mode!=\"permanent\"{t.Fatal(\"type settings coupled\")}\n}\n","chat/scripts/package.sh":"#!/bin/sh\n# Build a reviewable artifact; this script never uploads, switches current or restarts a process.\nset -eu\ncd \"$(dirname \"$0\")/..\"\nif [ \"$#\" -ne 1 ] || [ ! -d \"$1\" ]; then\n    printf '%s\\n' '用法: package.sh 已存在的绝对产物目录' >&2\n    exit 2\nfi\ncase \"$1\" in /*) ;; *) exit 2 ;; esac\nif [ -n \"$(git status --porcelain)\" ]; then\n    printf '%s\\n' '正式构建需要干净的完整源码提交' >&2\n    exit 2\nfi\nsh ./build.sh\nout=\"$1\"\ncp bin/chatd \"$out/chatd\"\n./bin/chatd version > \"$out/version.json\"\npython3 - \"$out\" <<'PY'\nimport hashlib,json,pathlib,sys\nout=pathlib.Path(sys.argv[1])\nversion=json.loads((out/\"version.json\").read_bytes())\nif version[\"source_dirty\"]!=\"false\" or version[\"source_revision\"]==\"unknown\" or version[\"go_version\"]!=\"go1.27.3\":\n    raise SystemExit(\"invalid release provenance\")\nmanifest={\"schema\":1,\"version\":version,\"php\":\"8.3.36\",\"database\":\"2.7.0\",\"files\":{}}\nfor p in [pathlib.Path(\"bin/chatd\"),pathlib.Path(\"helpers/images/inspect.py\"),pathlib.Path(\"helpers/images/requirements.lock\")]:\n    manifest[\"files\"][str(p)]={\"bytes\":p.stat().st_size,\"sha256\":hashlib.sha256(p.read_bytes()).hexdigest()}\n(out/\"manifest.json\").write_text(json.dumps(manifest,indent=2)+\"\\n\")\nPY\n","chat/scripts/seal-binlogs.py":"#!/usr/bin/env python3\n\"\"\"Validate a continuous archived binlog range; never execute its SQL.\"\"\"\nimport argparse, base64, hashlib, hmac, json, os, pathlib, re, subprocess, sys, tempfile\n\ndef encode(v):\n    return json.dumps(v,ensure_ascii=False,separators=(\",\",\":\")).encode()\ndef read(path,limit=65536):\n    path=pathlib.Path(path)\n    if path.is_symlink() or not path.is_file() or path.stat().st_size>limit or path.stat().st_mode&0o022:\n        raise ValueError(\"protected file required\")\n    def pairs(items):\n        out={}\n        for k,v in items:\n            if k in out: raise ValueError(\"duplicate field\")\n            out[k]=v\n        return out\n    return json.loads(path.read_bytes(),object_pairs_hook=pairs)\ndef sealed(path,key):\n    v=read(path);p=v[\"payload\"]\n    if not hmac.compare_digest(v[\"mac\"],hmac.new(key,encode(p),\"sha256\").hexdigest()):\n        raise ValueError(\"checkpoint signature\")\n    return p\ndef coordinate(v):\n    name=v[\"file\"];m=re.fullmatch(r\"([A-Za-z0-9_-]+\\.)([0-9]{6})\",name)\n    pos=v[\"position\"]\n    if not m or not re.fullmatch(r\"[0-9]{1,20}\",pos) or int(pos)<4 or not re.fullmatch(r\"[0-9a-f-]{36}\",v[\"server_uuid\"]):\n        raise ValueError(\"binlog coordinate\")\n    return m[1],int(m[2]),int(pos)\ndef verify_range(start,end,directory,binary):\n    a,first,position=coordinate(start);b,last,stop=coordinate(end)\n    if a!=b or start[\"server_uuid\"]!=end[\"server_uuid\"] or first>last or last-first>10000 or first==last and position>stop:\n        raise ValueError(\"noncontinuous range\")\n    root=pathlib.Path(directory).resolve(strict=True)\n    if not root.is_dir(): raise ValueError(\"archive directory\")\n    hashes={}\n    for n in range(first,last+1):\n        name=a+str(n).zfill(6);path=root/name\n        if path.is_symlink() or not path.is_file() or path.resolve().parent!=root:\n            raise ValueError(\"binlog gap\")\n        size=path.stat().st_size\n        lo=position if n==first else 4\n        hi=stop if n==last else size\n        if lo>hi or hi>size: raise ValueError(\"incomplete archive tail\")\n        with path.open(\"rb\") as f:\n            if f.read(4)!=b\"\\xfebin\": raise ValueError(\"binlog header\")\n            digest=hashlib.sha256()\n            f.seek(0)\n            while chunk:=f.read(1024*1024): digest.update(chunk)\n        cmd=[binary,\"--no-defaults\",\"--verify-binlog-checksum\",\"--start-position=\"+str(lo),\"--stop-position=\"+str(hi),str(path)]\n        p=subprocess.run(cmd,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=120)\n        if p.returncode: raise ValueError(\"binlog verification\")\n        hashes[name]={\"bytes\":size,\"sha256\":digest.hexdigest(),\"start\":lo,\"stop\":hi}\n    return hashes\n\ndef main(args):\n    encoded=os.environ.get(args.key_env,\"\")\n    if not re.fullmatch(r\"CHAT_[A-Z0-9_]{1,60}\",args.key_env): raise ValueError(\"key name\")\n    key=base64.b64decode(encoded,validate=True)\n    if len(key)!=32 or base64.b64encode(key).decode()!=encoded: raise ValueError(\"key\")\n    directory=pathlib.Path(args.control).resolve(strict=True)\n    gate=read(directory/\"gate.json\",1024)\n    if gate[\"state\"]!=\"blocked\": raise ValueError(\"maintenance required\")\n    before=sealed(args.backup_checkpoint,key)\n    after=sealed(directory/\"checkpoint.json\",key)\n    latest=read(directory/\"latest.json\",4096)\n    latest_hash=hashlib.sha256(encode(read(directory/\"checkpoint.json\"))).hexdigest()\n    if latest_hash!=latest[\"sha256\"] or latest[\"watermark\"]!=after[\"watermark\"]:\n        raise ValueError(\"stale checkpoint\")\n    for field in (\"schema\",\"environment\",\"epoch\"):\n        if before[field]!=after[field] or after[field]!=gate[field] or (field==\"schema\" and after[field]!=1):\n            raise ValueError(\"environment or epoch\")\n    binary=pathlib.Path(args.mysqlbinlog).resolve(strict=True)\n    if not binary.is_file() or not os.access(binary,os.X_OK): raise ValueError(\"explicit mysqlbinlog executable\")\n    hashes=verify_range(before[\"watermark\"],after[\"watermark\"],args.archive,str(binary))\n    p={\"schema\":1,\"environment\":after[\"environment\"],\"epoch\":after[\"epoch\"],\"watermark\":after[\"watermark\"],\n        \"complete\":True,\"from\":before[\"watermark\"],\"archive_sha256\":hashlib.sha256(encode(hashes)).hexdigest()}\n    proof={\"payload\":p,\"mac\":hmac.new(key,encode(p),\"sha256\").hexdigest()}\n    fd,name=tempfile.mkstemp(prefix=\".continuity-\",dir=directory)\n    try:\n        os.fchmod(fd,0o640)\n        with os.fdopen(fd,\"wb\") as out:\n            out.write(encode(proof));out.flush();os.fsync(out.fileno())\n        os.replace(name,directory/\"continuity.json\")\n    finally:\n        if os.path.exists(name): os.unlink(name)\n    print(json.dumps({\"status\":\"verified\",\"files\":len(hashes),\"sql_executed\":False}))\nif __name__==\"__main__\":\n    p=argparse.ArgumentParser()\n    p.add_argument(\"--control\",required=True);p.add_argument(\"--backup-checkpoint\",required=True)\n    p.add_argument(\"--archive\",required=True);p.add_argument(\"--mysqlbinlog\",required=True)\n    p.add_argument(\"--key-env\",default=\"CHAT_RECOVERY_KEY\")\n    try: main(p.parse_args())\n    except ValueError as error:\n        allowed={\"protected file required\",\"duplicate field\",\"checkpoint signature\",\"binlog coordinate\",\"noncontinuous range\",\n            \"archive directory\",\"binlog gap\",\"incomplete archive tail\",\"binlog header\",\"binlog verification\",\"key name\",\n            \"key\",\"maintenance required\",\"stale checkpoint\",\"environment or epoch\",\"explicit mysqlbinlog executable\"}\n        reason=str(error) if str(error) in allowed else \"invalid structure\"\n        print(json.dumps({\"status\":\"blocked\",\"code\":\"CHAT_RECOVERY_INCREMENT_GAP\",\"reason\":reason}));sys.exit(1)\n    except (OSError,KeyError,TypeError,subprocess.SubprocessError):\n        print('{\"status\":\"blocked\",\"code\":\"CHAT_RECOVERY_INCREMENT_GAP\",\"reason\":\"dependency or structure unavailable\"}');sys.exit(1)\n","chat/scripts/test-center.py":"#!/usr/bin/env python3\n\"\"\"Run existing Go/MySQL contracts from a sanitized Test Center fixture.\"\"\"\nimport argparse, base64, hashlib, hmac, json, os, pathlib, re, subprocess, sys, tempfile\n\nSUITES = {\n    \"recovery\": r\"S21|S08|S10|S15|S09\",\n    \"media\": r\"S21|S16|S17\",\n    \"governance\": r\"S21|S18|S19\",\n    \"reminders\": r\"S21|S20\",\n    \"retention\": r\"S21|S22\",\n}\ndef validate(f):\n    if set(f) != {\"schema\",\"instance\",\"suite\",\"environment\",\"provider\",\"order\",\"actors\",\"image_counts\"}:\n        raise ValueError(\"fixture fields\")\n    if type(f[\"schema\"]) is not int or f[\"schema\"] != 1 or not re.fullmatch(r\"[A-Za-z0-9_-]{1,96}\", f[\"instance\"]):\n        raise ValueError(\"fixture identity\")\n    if f[\"suite\"] not in SUITES or f[\"environment\"] != \"test\" or f[\"provider\"] != \"simulated\":\n        raise ValueError(\"isolated fixture required\")\n    o=f[\"order\"]\n    if set(o) != {\"workflow\",\"source\",\"dispatch\"} or o[\"workflow\"] not in (\"construction\",\"measurement\") or o[\"source\"] not in (\"consumer\",\"platform\") or o[\"dispatch\"] not in (\"multi_quote\",\"single_grab\"):\n        raise ValueError(\"order fixture\")\n    if f[\"actors\"] != [\"worker\",\"customer\",\"platform_staff\"] or f[\"image_counts\"] != [1,2,4,9] or any(type(n) is not int for n in f[\"image_counts\"]):\n        raise ValueError(\"no injected identity or image input\")\n    return f\n\ndef run(args):\n    if bool(args.sign_env)!=bool(args.report_file): raise ValueError(\"report output and signing key must be paired\")\n    path=pathlib.Path(args.fixture).resolve()\n    if path.stat().st_size > 4096:\n        raise ValueError(\"fixture too large\")\n    raw=path.read_bytes()\n    def pairs(items):\n        d={}\n        for k,v in items:\n            if k in d: raise ValueError(\"duplicate fixture field\")\n            d[k]=v\n        return d\n    f=validate(json.loads(raw,object_pairs_hook=pairs))\n    canonical={\"schema\":1,\"instance\":f[\"instance\"],\"suite\":f[\"suite\"],\"environment\":\"test\",\"provider\":\"simulated\",\n        \"order\":{name:f[\"order\"][name] for name in (\"workflow\",\"source\",\"dispatch\")},\n        \"actors\":f[\"actors\"],\"image_counts\":f[\"image_counts\"]}\n    fixture_hash=hashlib.sha256(json.dumps(canonical,ensure_ascii=False,separators=(\",\",\":\")).encode()).hexdigest()\n    for key in (\"CHAT_AUTH_TEST_INTEGRATION\",\"CHAT_INTEGRATION\"):\n        if os.environ.get(key) != \"1\": raise ValueError(\"explicit isolated integration required\")\n    for key in (\"CHAT_INTEGRATION_MYSQL_ADDR\",\"CHAT_INTEGRATION_REDIS_ADDR\"):\n        if not re.fullmatch(r\"127\\.0\\.0\\.1:[1-9][0-9]{0,4}\",os.environ.get(key,\"\")):\n            raise ValueError(\"loopback dependencies required\")\n    env=dict(os.environ, CHAT_TEST_CENTER_FIXTURE=str(path), GOTOOLCHAIN=\"local\")\n    root=pathlib.Path(__file__).resolve().parents[1]\n    # Fixed executable and argument list; fixture cannot introduce paths, URLs or shell.\n    required=\"go\"+next(line.split()[1] for line in (root/\"go.mod\").read_text().splitlines() if line.startswith(\"go \"))\n    actual=subprocess.check_output([\"go\",\"env\",\"GOVERSION\"],cwd=root,env=env,text=True,timeout=10).strip()\n    if actual!=required: raise ValueError(\"locked Go toolchain required\")\n    source_hash=hashlib.sha256()\n    for source in sorted(list((root/\"internal\").rglob(\"*.go\"))+list((root/\"cmd\").rglob(\"*.go\"))+[root/\"go.mod\",root/\"go.sum\"]):\n        source_hash.update(str(source.relative_to(root)).encode()+b\"\\\\0\"+hashlib.sha256(source.read_bytes()).digest())\n    cmd=[\"go\",\"test\",\"-race\",\"-count=1\",\"-json\",\"-run\",SUITES[f[\"suite\"]],\"./internal/message\"]\n    p=subprocess.run(cmd,cwd=root,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=900)\n    tests=[]; failed=[]; skipped=[]\n    for line in p.stdout.decode(\"utf-8\",errors=\"replace\").splitlines():\n        try: row=json.loads(line)\n        except ValueError: continue\n        if row.get(\"Test\") and row.get(\"Action\")==\"pass\": tests.append(row[\"Test\"])\n        if row.get(\"Test\") and row.get(\"Action\")==\"fail\": failed.append(row[\"Test\"])\n        if row.get(\"Test\") and row.get(\"Action\")==\"skip\": skipped.append(row[\"Test\"])\n    report={\"schema\":1,\"instance\":f[\"instance\"],\"suite\":f[\"suite\"],\"fixture_sha256\":fixture_hash,\n        \"go_version\":actual,\"source_sha256\":source_hash.hexdigest(),\"source_revision\":os.environ.get(\"CHAT_VERIFIED_SOURCE_REVISION\",\"unrecorded\"),\n        \"status\":\"passed\" if p.returncode==0 and tests and not failed and not skipped else \"failed\",\n        \"tests\":tests,\"failed\":failed,\"skipped\":skipped,\"simulated_provider\":True,\"real_channel\":False}\n    # Do not echo raw test logs (they may contain fixture SQL). Operators can retain private CI logs.\n    if args.report_file:\n        if not args.sign_env or not re.fullmatch(r\"CHAT_[A-Z0-9_]{1,60}\",args.sign_env): raise ValueError(\"report signing key name\")\n        key_text=os.environ.get(args.sign_env,\"\");key=base64.b64decode(key_text,validate=True)\n        if len(key)!=32 or base64.b64encode(key).decode()!=key_text or not re.fullmatch(r\"[0-9a-f]{40}\",report[\"source_revision\"]):\n            raise ValueError(\"report key/source binding\")\n        payload=json.dumps(report,ensure_ascii=False,separators=(\",\",\":\")).encode()\n        envelope={\"payload\":base64.b64encode(payload).decode(),\"mac\":hmac.new(key,payload,\"sha256\").hexdigest()}\n        target=pathlib.Path(args.report_file)\n        if not target.is_absolute() or target.is_symlink(): raise ValueError(\"private absolute report path\")\n        fd,name=tempfile.mkstemp(prefix=\".chat-report-\",dir=target.parent)\n        try:\n            os.fchmod(fd,0o640)\n            with os.fdopen(fd,\"w\") as output:\n                json.dump(envelope,output,separators=(\",\",\":\"));output.flush();os.fsync(output.fileno())\n            os.replace(name,target)\n        finally:\n            if os.path.exists(name): os.unlink(name)\n    print(json.dumps(report,ensure_ascii=False))\n    return 0 if report[\"status\"]==\"passed\" else 1\n\nif __name__==\"__main__\":\n    parser=argparse.ArgumentParser()\n    parser.add_argument(\"--fixture\",required=True)\n    parser.add_argument(\"--report-file\");parser.add_argument(\"--sign-env\")\n    try: sys.exit(run(parser.parse_args()))\n    except (ValueError,OSError,subprocess.SubprocessError,TypeError,KeyError):\n        print('{\"status\":\"failed\",\"code\":\"CHAT_TEST_CENTER_INVALID_OR_UNAVAILABLE\"}')\n        sys.exit(2)\n","chat/scripts/verify-s09.sh":"#!/usr/bin/env bash\n# S09 acceptance only. No production database, no deployment, no schema\n# writes outside explicitly isolated random test databases.\nset -euo pipefail\n\nfail() { printf 'CHAT_S09_VERIFY_BLOCKED: %s\\n' \"$1\" >&2; exit 1; }\nroot=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\ncd \"$root\"\n\n[[ \"${CHAT_AUTH_TEST_INTEGRATION:-}\" == \"1\" ]] || fail \"isolated integration switch must be exactly 1\"\n[[ \"${CHAT_INTEGRATION_MYSQL_ADDR:-}\" =~ ^127\\.0\\.0\\.1:[0-9]+$ ]] || fail \"MySQL must be explicitly loopback only\"\n[[ \"${CHAT_INTEGRATION_REDIS_ADDR:-}\" =~ ^127\\.0\\.0\\.1:[0-9]+$ ]] || fail \"Redis must be explicitly loopback only\"\n[[ \"${CHAT_AUTH_TEST_REDIS_ADDRESS:-}\" =~ ^127\\.0\\.0\\.1:[0-9]+$ ]] || fail \"Redis identity integration address must be loopback only\"\n[[ -n \"${CHAT_INTEGRATION_ADMIN_PASSWORD:-}\" ]] || fail \"explicit isolated MySQL fixture administrator credential missing\"\n[[ -n \"${CHAT_AUTH_TEST_PHP:-}\" && -x \"${CHAT_AUTH_TEST_PHP:-/nonexistent}\" ]] || fail \"explicit PHP binary path required\"\n[[ \"${CHAT_AUTH_TEST_MYSQL_USER_HOST:-}\" == \"127.0.0.1\" || \"${CHAT_AUTH_TEST_MYSQL_USER_HOST:-}\" == \"%\" ]] || fail \"isolated SQL fixture user host not allowed\"\n\n[[ \"$(go version)\" =~ ^go[[:space:]]version[[:space:]]go1\\.27\\.3[[:space:]] ]] || fail \"requires exact Go 1.27.3\"\n[[ \"$(\"$CHAT_AUTH_TEST_PHP\" -r 'echo PHP_VERSION;')\" == \"8.3.36\" ]] || fail \"requires exact PHP 8.3.36\"\n\n# Root privileges are restricted to ephemeral, randomly named test databases.\n# Never interpolate the database address into SQL; parse its numeric port.\nmysql_port=\"${CHAT_INTEGRATION_MYSQL_ADDR##*:}\"\nCHAT_S09_FIXTURE_PORT=\"$mysql_port\" \"$CHAT_AUTH_TEST_PHP\" -r '\n  $port = (int) getenv(\"CHAT_S09_FIXTURE_PORT\");\n  $db = new PDO(\"mysql:host=127.0.0.1;port=\".$port.\";charset=utf8mb4\",\n                \"root\", (string)getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\"),\n                [PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);\n  $version = (string)$db->query(\"SELECT VERSION()\")->fetchColumn();\n  if (!preg_match(\"/^5\\\\.7\\\\.44(?:[-.].*)?$/D\", $version)) {\n    fwrite(STDERR, \"CHAT_S09_VERIFY_BLOCKED: exact MySQL 5.7.44 required\\n\");\n    exit(1);\n  }\n  echo \"Isolated MySQL 5.7.44 verified\\n\";\n'\n\necho 'S09: PHP contracts, upgrade checks and ephemeral MySQL fixtures'\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_schema_contract.php\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_identity_contract.php\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_policy_contract.php\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_text_security_contract.php\n\necho 'S09: Go module integrity, vet, compile and race-tested integration'\n(\n  cd chat\n  export GOTOOLCHAIN=local\n  go mod verify\n  go vet ./...\n  bash build.sh\n  go test -race -count=1 ./...\n)\necho 'CHAT_S09_ACCEPTANCE_PASSED (only for the exact checked-out revision)'\n","chat/scripts/verify-s10.sh":"#!/usr/bin/env bash\n# Same isolated PHP/MySQL/Redis/version gates and full S01-S09 regression suite;\n# go test ./... additionally runs real S10 WSS/HTTP equivalence and lifecycle.\nset -euo pipefail\nroot=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nbash \"$root/chat/scripts/verify-s09.sh\"\necho 'CHAT_S10_ACCEPTANCE_PASSED (only for the exact checked-out revision)'\n","chat/scripts/verify-s11.sh":"#!/usr/bin/env bash\n# The existing strict isolated PHP/MySQL/Redis gates remain authoritative.\nset -euo pipefail\nroot=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nbash \"$root/chat/scripts/verify-s10.sh\"\ncd \"$root\"\nnode --test tools/test_chat_s11.js\necho 'CHAT_S11_ACCEPTANCE_PASSED (only for the exact checked-out revision)'\n","server/VERSION":"2.7.0\n","server/app/Application/Chat/ChatCredentialIssuer.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Chat;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\Auth;\n\n/** Only exchanges an existing PHP identity; never creates a login or touches last_seen. */\nfinal class ChatCredentialIssuer\n{\n    private Database $db;\n    private array $config;\n    private string $environment;\n\n    public function __construct(Database $db, array $config, string $phpEnvironment)\n    {\n        $this->db = $db;\n        $this->config = $config;\n        $this->environment = ['testing'=>'test','development'=>'development','production'=>'production'][$phpEnvironment] ?? '';\n    }\n\n    public function exchangeMini(string $token, bool $audit = false): array\n    {\n        $this->assertEnabled();\n        if (preg_match('/^[A-Fa-f0-9]{64}$/D', $token) !== 1) throw new RuntimeException('请重新登录', 401);\n        // Match the original persisted login authority. Proxy/test identities are exported only as sanitized offline fixtures; they never borrow this production identity.\n        $row = $this->db->fetch(\n            \"SELECT CAST(s.id AS CHAR) source_id,CAST(s.user_id AS CHAR) user_id,s.token_hash,\n                    UNIX_TIMESTAMP(s.expires_at) expires_unix\n             FROM login_sessions s JOIN users u ON u.id=s.user_id AND u.status='active'\n             WHERE s.token_hash=:token_hash AND s.status='active' AND s.expires_at>UTC_TIMESTAMP()\n               AND COALESCE(s.demo_actor_user_id,0)=0 AND COALESCE(s.test_actor_user_id,0)=0\n               AND COALESCE(s.test_instance_id,0)=0 AND s.test_actor_expires_at IS NULL LIMIT 1\",\n            ['token_hash'=>hash('sha256', $token)]\n        );\n        if (!$row) throw new RuntimeException('登录状态已失效，请重新进入', 401);\n        $source = $this->id($row['source_id']);\n        $actor = $this->id($row['user_id']);\n        $hash = (string)$row['token_hash'];\n        if (preg_match('/^[a-f0-9]{64}$/D', $hash) !== 1) throw new RuntimeException('聊天身份暂不可用', 503);\n        $auditVersion='';\n        if($audit){\n            $grant=$this->db->fetch('SELECT authority_version FROM chat_mini_auditors WHERE user_id=:id AND enabled=1',['id'=>$actor]);\n            if(!$grant||preg_match('/^[a-f0-9]{64}$/D',(string)$grant['authority_version'])!==1)throw new RuntimeException('当前账号无会话抽检权限',403);\n            $auditVersion=(string)$grant['authority_version'];\n        }\n        return $this->issue([\n            'sub'=>$actor,'kind'=>$audit?'mini_audit':'mini','source_id'=>$source,\n            'session_id'=>hash('sha256', \"mini\\n\".$source.\"\\n\".$hash),\n            'session_version'=>$audit?hash('sha256',\"mini-audit-v1\\n\".$source.\"\\n\".$hash.\"\\n\".$actor.\"\\n\".$auditVersion):hash('sha256', \"mini-v1\\n\".$source.\"\\n\".$hash.\"\\n\".$actor),\n            'scopes'=>[$audit?'chat:audit':'chat:use'],\n        ], (int)$row['expires_unix']);\n    }\n\n    private function assertEnabled(): void\n    {\n        \\WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryGate::assertReady($this->config,$this->environment);\n        if (($this->config['enabled'] ?? false) !== true || $this->environment === '') {\n            throw new RuntimeException('聊天凭证交换未启用', 503);\n        }\n    }\n\n    public function exchangeAdmin(Auth $auth): array\n    {\n        $this->assertEnabled();\n        if (session_status() !== PHP_SESSION_ACTIVE || session_id() === '') throw new RuntimeException('请重新登录', 401);\n        $admin = $auth->user();\n        if (!$admin) throw new RuntimeException('请重新登录', 401);\n        if (!empty($admin['must_change_password']) || !$auth->can('audit.view')) throw new RuntimeException('当前账号无聊天审计权限', 403);\n        $scopes = ['chat:audit'];\n        if ($auth->can('users.manage')) $scopes[] = 'chat:moderate';\n        if ($auth->can('chat.images.review')) $scopes[] = 'chat:images';\n        if ($auth->can('chat.media.review')) $scopes[] = 'chat:media';\n        if ($auth->can('chat.evidence.view')) $scopes[] = 'chat:evidence';\n        $scopeJSON = json_encode($scopes, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);\n        $adminID = $this->id($admin['id']);\n        $sessionHash = hash('sha256', \"admin\\n\".$this->environment.\"\\n\".session_id());\n        $deadline = (int)($_SESSION['_last_activity'] ?? time()) + max(1, (int)\\app_config('security.session_lifetime',7200));\n        $expiry = min(time()+300, $deadline);\n        if ($expiry <= time()) throw new RuntimeException('请重新登录',401);\n        $expectedRole = (string)$admin['role'];\n        $row = $this->db->transaction(function() use($adminID,$sessionHash,$scopeJSON,$expiry,$expectedRole): array {\n            $current = $this->db->fetch(\"SELECT CAST(id AS CHAR) id,role,password_hash FROM admin_users WHERE id=:id AND status IN ('active','1') AND must_change_password=0 FOR UPDATE\",['id'=>$adminID]);\n            if (!$current) throw new RuntimeException('请重新登录',401);\n            if ((string)$current['role'] !== $expectedRole) throw new RuntimeException('后台权限已变化，请刷新页面',403);\n            $authority = hash('sha256', \"admin-v1\\n\".$adminID.\"\\n\".(string)$current['role'].\"\\n\".(string)$current['password_hash'].\"\\n\".$scopeJSON);\n            $this->db->execute(\n                \"INSERT INTO chat_admin_sessions(admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at)\n                 VALUES(:admin_id,:session_hash,:version,:authority,:scopes,:expires,UTC_TIMESTAMP())\n                 ON DUPLICATE KEY UPDATE session_version=IF(revoked_at IS NOT NULL OR authority_hash<>VALUES(authority_hash),VALUES(session_version),session_version),\n                 authority_hash=VALUES(authority_hash),scopes_json=VALUES(scopes_json),expires_at=VALUES(expires_at),revoked_at=NULL\",\n                ['admin_id'=>$adminID,'session_hash'=>$sessionHash,'version'=>bin2hex(random_bytes(32)),\n                 'authority'=>$authority,'scopes'=>$scopeJSON,'expires'=>gmdate('Y-m-d H:i:s',$expiry)]\n            );\n            $row = $this->db->fetch('SELECT CAST(id AS CHAR) source_id,session_version,revoked_at FROM chat_admin_sessions WHERE session_hash=:hash AND admin_id=:admin_id LIMIT 1', ['hash'=>$sessionHash,'admin_id'=>$adminID]);\n            if (!$row || $row['revoked_at'] !== null) throw new RuntimeException('请重新登录',401);\n            return $row;\n        });\n        $_SESSION['chat_admin_session_id'] = $this->id($row['source_id']);\n        return $this->issue(['sub'=>$adminID,'kind'=>'admin','source_id'=>$this->id($row['source_id']),\n            'session_id'=>$sessionHash,'session_version'=>(string)$row['session_version'],'scopes'=>$scopes],$expiry);\n    }\n\n    private function id($value): string\n    {\n        $id = (string)$value;\n        if (preg_match('/^[1-9][0-9]{0,19}$/D', $id) !== 1 || strlen($id) === 20 && strcmp($id, '18446744073709551615') > 0) {\n            throw new RuntimeException('聊天身份暂不可用', 503);\n        }\n        return $id;\n    }\n\n    private function issue(array $identity, int $sessionExpiry): array\n    {\n        $kid = (string)($this->config['key_id'] ?? '');\n        $name = (string)($this->config['seed_env'] ?? '');\n        if (preg_match('/^[a-z0-9_-]{1,32}$/D', $kid) !== 1 || preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D', $name) !== 1 || !function_exists('sodium_crypto_sign_seed_keypair')) {\n            throw new RuntimeException('聊天凭证配置不可用', 503);\n        }\n        $encoded = getenv($name);\n        $seed = is_string($encoded) ? base64_decode($encoded, true) : false;\n        if (!is_string($seed) || strlen($seed) !== SODIUM_CRYPTO_SIGN_SEEDBYTES || base64_encode($seed) !== $encoded) {\n            throw new RuntimeException('聊天凭证配置不可用', 503);\n        }\n        $now = time();\n        $expires = min($now + 300, $sessionExpiry);\n        if ($expires <= $now) throw new RuntimeException('登录状态已失效，请重新进入', 401);\n        $claims = array_merge($identity, [\n            'iss'=>'bixuan-php:'.$this->environment,'aud'=>'bixuan-chat','env'=>$this->environment,\n            'iat'=>$now,'nbf'=>$now,'exp'=>$expires,'jti'=>bin2hex(random_bytes(32)),\n        ]);\n        $header = ['alg'=>'EdDSA','typ'=>'JWT','kid'=>$kid];\n        $input = $this->base64url(json_encode($header, JSON_THROW_ON_ERROR)).'.'.$this->base64url(json_encode($claims, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES));\n        $pair = sodium_crypto_sign_seed_keypair($seed);\n        sodium_memzero($seed);\n        $secret = sodium_crypto_sign_secretkey($pair);\n        $signature = sodium_crypto_sign_detached($input, $secret);\n        sodium_memzero($secret);\n        sodium_memzero($pair);\n        return ['access_token'=>$input.'.'.$this->base64url($signature),'token_type'=>'Bearer','actor_id'=>$identity['sub'],'environment'=>$this->environment,\n            'expires_at'=>gmdate('Y-m-d\\TH:i:s\\Z', $expires),'expires_in'=>$expires-$now];\n    }\n\n    private function base64url(string $value): string { return rtrim(strtr(base64_encode($value), '+/', '-_'), '='); }\n}\n","server/app/Application/Chat/ChatReminderDispatch.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse Throwable;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatReminderTemplate;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionQuotaStore;\n/** Reuses the existing gateway/quota; no copied channel, SMS or billing stack. */\nfinal class ChatReminderDispatch\n{\n    private Database $db;private SubscribeMessageGateway $gateway;private $eligible;\n    public function __construct(Database $db,SubscribeMessageGateway $gateway,callable $eligible){$this->db=$db;$this->gateway=$gateway;$this->eligible=$eligible;}\n    public function dispatch(int $limit=20):array\n    {\n        if($this->db->pdo()->inTransaction())throw new RuntimeException('CHAT_SEND_TRANSACTION');\n        $limit=max(1,min(50,$limit));\n        // A dead process after entering the channel has an unknown result. It\n        // cannot re-enter generic failed retries or trigger an SMS fallback.\n        $this->db->execute(\"UPDATE chat_reminder_receipts SET state='provider_unknown',diagnostic='provider_unknown',updated_at=UTC_TIMESTAMP(6) WHERE state='sending' AND updated_at<UTC_TIMESTAMP(6)-INTERVAL 5 MINUTE\");\n        $rows=$this->db->fetchAll(\"SELECT o.id,o.payload_json FROM message_outbox o JOIN chat_reminder_receipts r ON r.outbox_id=o.id WHERE o.topic='chat_reminder' AND o.status IN ('pending','failed','processing') AND r.state='accepted' AND o.attempt_count<8 AND (o.next_attempt_at IS NULL OR o.next_attempt_at<=UTC_TIMESTAMP()) ORDER BY o.id LIMIT \".$limit);\n        $stats=['scanned'=>count($rows),'sent'=>0,'suppressed'=>0,'unknown'=>0,'retry'=>0];\n        foreach($rows as $row){\n            $id=(int)$row['id'];$q=json_decode((string)$row['payload_json'],true);$op=(string)($q['operation_id']??'');\n            if(preg_match('/^[a-f0-9]{64}$/D',$op)!==1)continue;\n            $claimed=$this->db->execute(\"UPDATE message_outbox SET status='processing',attempt_count=attempt_count+1,next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE WHERE id=:id AND topic='chat_reminder' AND (status IN ('pending','failed') OR (status='processing' AND next_attempt_at<=UTC_TIMESTAMP()))\",['id'=>$id]);\n            if($claimed!==1)continue;\n            $entered=false;\n            try{\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $built=ChatReminderTemplate::build($this->db,$q);\n                if(!isset($built['payload'])){$this->finish($op,$id,'channel_limited',(string)$built['diagnostic']);$stats['suppressed']++;continue;}\n                // Final check is after metadata/permissions and immediately\n                // before recording the irreversible provider boundary.\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $entered=$this->db->transaction(function()use($op,$q):bool{\n                    $receipt=$this->db->fetch('SELECT state FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$op]);\n                    if(!$receipt||$receipt['state']!=='accepted')return false;\n                    $this->db->fetch(\"SELECT setting_key FROM system_settings WHERE setting_key=:key FOR UPDATE\",['key'=>'wechat.subscription.user.'.(int)$q['recipient_id']]);\n                    $current=ChatReminderTemplate::build($this->db,$q);if(!isset($current['payload']))return false;\n                    // Reserve once, including provider-unknown outcomes.\n                    SubscriptionQuotaStore::markSubscriptionConsumed($this->db,(int)$q['recipient_id'],'chat_unread');\n                    $this->db->execute(\"UPDATE chat_reminder_receipts SET state='sending',diagnostic='channel_entered',updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op\",['op'=>$op]);return true;\n                });\n                if(!$entered){$this->finish($op,$id,'suppressed','subscription_changed');$stats['suppressed']++;continue;}\n                $this->gateway->send($built['payload']);\n                $this->finish($op,$id,'sent','sent');$stats['sent']++;\n            }catch(Throwable $error){\n                if($entered){$this->finish($op,$id,'provider_unknown','provider_unknown');$stats['unknown']++;}\n                else{$this->db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE,last_error='chat_eligibility_unavailable' WHERE id=:id\",['id'=>$id]);$stats['retry']++;}\n            }\n        }\n        return $stats;\n    }\n    private function finish(string $op,int $id,string $state,string $diagnostic):void\n    {\n        $this->db->transaction(function()use($op,$id,$state,$diagnostic):void{\n            $this->db->execute(\"UPDATE chat_reminder_receipts SET state=:state,diagnostic=:diagnostic,updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op AND state IN ('accepted','sending')\",['state'=>$state,'diagnostic'=>$diagnostic,'op'=>$op]);\n            $this->db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP(),next_attempt_at=NULL,last_error=:diagnostic WHERE id=:id AND topic='chat_reminder'\",['diagnostic'=>$diagnostic,'id'=>$id]);\n        });\n    }\n}\n","server/app/Application/Chat/ChatReminderReceipts.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nfinal class ChatReminderReceipts\n{\n    private Database $db;\n    public function __construct(Database $db){$this->db=$db;}\n    public function receive(string $raw):array\n    {\n        $q=json_decode($raw,true,8,JSON_THROW_ON_ERROR);\n        if(is_array($q)&&array_keys($q)===['operation_id']&&json_encode($q,JSON_THROW_ON_ERROR)===$raw)return $this->status((string)$q['operation_id']);\n        $fields=['cluster_version','conversation_id','intent_id','operation_id','recipient_id','target_seq'];\n        if(!is_array($q)||array_keys($q)!==$fields||json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES)!==$raw)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        foreach($q as $key=>$value){\n            if(!is_string($value)||preg_match($key==='operation_id'?'/^[a-f0-9]{64}$/D':'/^[1-9][0-9]{0,19}$/D',$value)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n            if($key!=='operation_id'&&strlen($value)===20&&strcmp($value,'18446744073709551615')>0)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        }\n        return $this->db->transaction(function()use($q,$raw):array{\n            $hash=hash('sha256',$raw);\n            $this->db->execute(\"INSERT IGNORE INTO chat_reminder_receipts(operation_id,payload_hash,payload_json,state,diagnostic,created_at,updated_at) VALUES(:op,:hash,:body,'accepted','queued',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\",['op'=>$q['operation_id'],'hash'=>$hash,'body'=>$raw]);\n            $row=$this->db->fetch('SELECT payload_hash,state,diagnostic,outbox_id FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$q['operation_id']]);\n            if(!$row||!hash_equals((string)$row['payload_hash'],$hash))throw new RuntimeException('CHAT_REMINDER_CONFLICT');\n            if($row['outbox_id']===null){\n                $id=$this->db->insert(\"INSERT INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('chat_reminder',:key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['key'=>'chat:'.$q['operation_id'],'payload'=>$raw]);\n                $this->db->execute('UPDATE chat_reminder_receipts SET outbox_id=:id WHERE operation_id=:op',['id'=>$id,'op'=>$q['operation_id']]);\n            }\n            return $this->result($q['operation_id'],$row);\n        });\n    }\n    public function status(string $operation):array\n    {\n        if(preg_match('/^[a-f0-9]{64}$/D',$operation)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        $row=$this->db->fetch('SELECT state,diagnostic FROM chat_reminder_receipts WHERE operation_id=:op',['op'=>$operation]);\n        if(!$row)throw new RuntimeException('CHAT_REMINDER_NOT_FOUND');\n        return $this->result($operation,$row);\n    }\n    private function result(string $operation,array $row):array\n    {\n        $state=in_array($row['state'],['sending','provider_unknown'],true)?'provider_unknown':(string)$row['state'];\n        return ['operation_id'=>$operation,'state'=>$state,'diagnostic'=>(string)$row['diagnostic']];\n    }\n}\n","server/app/Application/Chat/ChatStorageSettings.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n\n/** PHP owns configuration only. Existing-message changes are applied by Go. */\nfinal class ChatStorageSettings\n{\n    private Database $db;\n    private string $key;\n    public function __construct(Database $db, string $key) { $this->db=$db; $this->key=$key; }\n    public function current(): array\n    {\n        $row=$this->db->fetch('SELECT revision,policy_json,CAST(apply_through_id AS CHAR) apply_through_id,updated_at FROM chat_storage_policy WHERE id=1');\n        if(!$row)throw new RuntimeException('请先完成聊天数据库升级');\n        $policy=json_decode((string)$row['policy_json'],true,32,JSON_THROW_ON_ERROR);\n        self::validate($policy);\n        $application=$this->db->fetch('SELECT state,last_message_id,diagnostic FROM chat_storage_applications WHERE revision=:revision',['revision'=>$row['revision']]);\n        return ['applications'=>$this->db->fetchAll('SELECT revision,state,last_message_id,errors,diagnostic FROM chat_storage_applications ORDER BY revision DESC LIMIT 10'),'revision'=>(string)$row['revision'],'policy'=>$policy,'apply_through_id'=>(string)$row['apply_through_id'],'application'=>$application,'updated_at'=>$row['updated_at']];\n    }\n    public static function validate(array $p): void\n    {\n        self::shape($p,['schema','retention','tiering','quota']);\n        if($p['schema']!==1)throw new RuntimeException('保存策略版本不支持');\n        if(!is_array($p['retention'])||!is_array($p['tiering'])||!is_array($p['quota']))throw new RuntimeException('保存策略格式不正确');\n        self::shape($p['retention'],['text','image','audio','video']);\n        foreach($p['retention'] as $rule){\n            if(!is_array($rule))throw new RuntimeException('保存期限不正确');\n            self::shape($rule,['mode','days']);\n            if(!is_int($rule['days'])||!($rule['mode']==='permanent'&&$rule['days']===0||$rule['mode']==='days'&&$rule['days']>=1&&$rule['days']<=3650))throw new RuntimeException('请选择永久保存或1至3650天');\n        }\n        $t=$p['tiering'];self::shape($t,['enabled','images','audio','videos','age_days','idle_days','min_bytes','remaining_days','batch']);\n        foreach(['enabled','images','audio','videos'] as $k)if(!is_bool($t[$k]))throw new RuntimeException('低频开关格式不正确');\n        if($t['enabled']&&!$t['images']&&!$t['audio']&&!$t['videos'])throw new RuntimeException('请选择低频适用类型');\n        foreach(['age_days'=>[30,3650],'idle_days'=>[1,3650],'min_bytes'=>[65536,1073741824],'remaining_days'=>[32,3650],'batch'=>[1,50]] as $k=>$range)self::bounded($t[$k],$range[0],$range[1]);\n        self::shape($p['quota'],['video_count','video_bytes']);\n        self::bounded($p['quota']['video_count'],1,200);self::bounded($p['quota']['video_bytes'],20971520,2147483648);\n    }\n    private static function shape(array $v,array $keys): void\n    {\n        $actual=array_keys($v);sort($actual);sort($keys);\n        if($actual!==$keys)throw new RuntimeException('配置字段缺失或包含未知字段');\n    }\n    private static function bounded($v,int $min,int $max): void\n    {\n        if(!is_int($v)||$v<$min||$v>$max)throw new RuntimeException('配置数字超出允许范围');\n    }\n    private static function number(array $input,string $key,int $min,int $max): int\n    {\n        $value=$input[$key]??null;\n        if(!is_string($value)||preg_match('/^(0|[1-9][0-9]{0,10})$/D',$value)!==1)throw new RuntimeException('请填写完整的整数配置');\n        $n=(int)$value;self::bounded($n,$min,$max);return $n;\n    }\n    public static function fromForm(array $input): array\n    {\n        $p=['schema'=>1,'retention'=>[],'tiering'=>[],'quota'=>[]];\n        foreach(['text','image','audio','video'] as $kind){\n            $mode=$input[$kind.'_mode']??null;\n            if(!is_string($mode)||!in_array($mode,['permanent','days'],true))throw new RuntimeException('请选择各类型的保存方式');\n            $p['retention'][$kind]=['mode'=>$mode,'days'=>$mode==='permanent'?0:self::number($input,$kind.'_days',1,3650)];\n        }\n        foreach(['enabled','images','audio','videos'] as $key){\n            $v=$input['tier_'.$key]??'0';\n            if(!is_string($v)||!in_array($v,['0','1'],true))throw new RuntimeException('低频开关格式不正确');\n            $p['tiering'][$key]=$v==='1';\n        }\n        foreach(['age_days'=>[30,3650],'idle_days'=>[1,3650],'remaining_days'=>[32,3650],'batch'=>[1,50]] as $key=>$range)$p['tiering'][$key]=self::number($input,'tier_'.$key,$range[0],$range[1]);\n        $p['tiering']['min_bytes']=self::number($input,'tier_min_kb',64,1048576)*1024;\n        $p['quota']=['video_count'=>self::number($input,'video_count',1,200),'video_bytes'=>self::number($input,'video_mb',20,2048)*1048576];\n        self::validate($p);return $p;\n    }\n    public function preview(array $input,int $admin): array\n    {\n        if(strlen($this->key)<32)throw new RuntimeException('应用签名配置不可用');\n        $current=$this->current();$policy=self::fromForm($input);\n        if(!isset($input['revision'])||!is_string($input['revision'])||$input['revision']!==$current['revision'])throw new RuntimeException('设置已变化，请刷新后重新预览');\n        $apply=$input['apply_existing']??'0';if(!is_string($apply)||!in_array($apply,['0','1'],true))throw new RuntimeException('应用范围不正确');\n        $through=$apply==='1'?(string)($this->db->fetchValue('SELECT COALESCE(MAX(id),0) FROM chat_messages')??'0'):'0';\n        $json=json_encode($policy,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);\n        $payload=['admin'=>$admin,'revision'=>$current['revision'],'hash'=>hash('sha256',$json),'through'=>$through,'apply'=>$apply,'expires'=>time()+600];\n        $encoded=rtrim(strtr(base64_encode(json_encode($payload,JSON_THROW_ON_ERROR)),'+/','-_'),'=');\n        $token=$encoded.'.'.hash_hmac('sha256',$encoded,$this->key);\n        return ['policy'=>$policy,'revision'=>$current['revision'],'through'=>$through,'apply'=>$apply,'preview_token'=>$token];\n    }\n    public function save(array $input,int $admin,string $role): void\n    {\n        if(strlen($this->key)<32)throw new RuntimeException('应用签名配置不可用');\n        $token=$input['preview_token']??null;\n        if(!is_string($token)||strlen($token)>2048||substr_count($token,'.')!==1)throw new RuntimeException('请先预览本次设置');\n        [$body,$signature]=explode('.',$token);\n        if(!hash_equals(hash_hmac('sha256',$body,$this->key),$signature))throw new RuntimeException('设置预览已失效');\n        $raw=base64_decode(strtr($body,'-_','+/'),true);\n        $proof=is_string($raw)?json_decode($raw,true,16,JSON_THROW_ON_ERROR):null;\n        $policy=self::fromForm($input);$json=json_encode($policy,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);\n        $reason=$input['reason']??null;$revision=$input['revision']??null;$apply=$input['apply_existing']??'0';\n        if(!is_array($proof)||($proof['admin']??0)!==$admin||!is_int($proof['expires']??null)||$proof['expires']<=time()||$proof['expires']>time()+600||($proof['revision']??null)!==$revision||($proof['hash']??null)!==hash('sha256',$json)||($proof['apply']??null)!==$apply||!is_string($proof['through']??null)||preg_match('/^(0|[1-9][0-9]{0,19})$/D',$proof['through'])!==1)throw new RuntimeException('设置预览已失效，请重新预览');\n        if(!is_string($reason)||mb_strlen(trim($reason))<2||mb_strlen($reason)>200||str_contains($reason,chr(0)))throw new RuntimeException('请填写2至200字修改理由');\n        $this->db->transaction(function()use($admin,$role,$proof,$revision,$json,$reason):void{\n            $currentAdmin=$this->db->fetch(\"SELECT role FROM admin_users WHERE id=:id AND status IN ('active','1') AND must_change_password=0 FOR UPDATE\",['id'=>$admin]);\n            if(!$currentAdmin||(string)$currentAdmin['role']!==$role)throw new RuntimeException('后台权限已变化');\n            $row=$this->db->fetch('SELECT revision,apply_through_id FROM chat_storage_policy WHERE id=1 FOR UPDATE');\n            if(!$row||(string)$row['revision']!==$revision||(int)$revision>=PHP_INT_MAX-1)throw new RuntimeException('设置已变化，请刷新后重新预览');\n            $next=(int)$revision+1;\n            $this->db->execute('UPDATE chat_storage_policy SET revision=:next,policy_json=:policy,apply_through_id=:through,updated_by=:admin,updated_at=UTC_TIMESTAMP(6) WHERE id=1',['next'=>$next,'policy'=>$json,'through'=>$proof['through'],'admin'=>$admin]);\n            $this->db->execute('INSERT INTO chat_storage_policy_audit(revision,admin_id,policy_json,apply_through_id,reason,created_at) VALUES(:revision,:admin,:policy,:through,:reason,UTC_TIMESTAMP(6))',['revision'=>$next,'admin'=>$admin,'policy'=>$json,'through'=>$proof['through'],'reason'=>trim($reason)]);\n        });\n    }\n}\n","server/app/Application/Identity/ActorCapabilityResolver.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Identity;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Domain\\Identity\\AdminActorPolicy;\n\n/**\n * 服务端身份能力解析入口。\n *\n * 页面/HTTP 模块只问“是否具备能力”，不再重复解释管理员 OpenID、演示身份等组合规则。\n */\nfinal class ActorCapabilityResolver\n{\n    private SettingsProvider $settings;\n    private AdminActorPolicy $policy;\n\n    public function __construct(SettingsProvider $settings, ?AdminActorPolicy $policy = null)\n    {\n        $this->settings = $settings;\n        $this->policy = $policy ?: new AdminActorPolicy();\n    }\n\n    /** @return string[] */\n    public function adminOpenIds(): array\n    {\n        $openids = $this->settings->get('wechat.admin_openids', []);\n        if (is_string($openids)) {\n            $decoded = json_decode($openids, true);\n            $openids = is_array($decoded)\n                ? $decoded\n                : preg_split('/[\\s,，]+/', $openids, -1, PREG_SPLIT_NO_EMPTY);\n        }\n        if (!is_array($openids)) return [];\n        $openids = array_map(static function ($value): string {\n            return trim((string) $value);\n        }, $openids);\n        return array_values(array_unique(array_filter($openids, static function (string $value): bool {\n            return $value !== '';\n        })));\n    }\n\n    public function isRealMiniAdmin(array $actor): bool\n    {\n        return $this->policy->isRealMiniAdmin($actor, $this->adminOpenIds());\n    }\n\n    public function isMiniAdmin(array $actor): bool\n    {\n        return $this->policy->isMiniAdmin($actor, $this->adminOpenIds());\n    }\n\n    public function isWorker(array $actor): bool\n    {\n        return $this->policy->isWorker($actor);\n    }\n\n    public function isOrderOwner(array $actor, array $order): bool\n    {\n        return $this->policy->isOrderOwner($actor, $order);\n    }\n}\n","server/app/Application/Messaging/MessageEventSwitches.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\n\nfinal class MessageEventSwitches\n{\n    private SettingsProvider $settings;\n    public function __construct(SettingsProvider $settings) { $this->settings=$settings; }\n    public function forChannel(string $channel):array\n    {\n        $key=$channel==='wecom'?'wecom.event_switches':($channel==='inapp'?'notification.internal_event_switches':'sms.event_switches');\n        $configured=$this->settings->get($key,[]);return MessageEventCatalog::switches($channel,is_array($configured)?$configured:[]);\n    }\n}\n","server/app/Application/Messaging/NotificationInbox.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\NotificationInboxRepository;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOperationException;\n\nfinal class NotificationInbox\n{\n    private NotificationInboxRepository $repository;\n    public function __construct(NotificationInboxRepository $repository) { $this->repository = $repository; }\n    public function summary(array $actor): array { return $this->repository->summary($actor); }\n    public function list(array $actor, int $page, string $throughId = ''): array\n    {\n        if(strlen($throughId)>80)throw new MessageOperationException('通知范围无效','NOTIFICATION_RANGE_INVALID');\n        return $this->repository->list($actor,max(1,min(10000,$page)),trim($throughId));\n    }\n    private function threadRepository(string $cursor): \\WorkerAdmin\\Contracts\\NotificationThreadRepository\n    {\n        if(strlen($cursor)>2048)throw new MessageOperationException('通知浏览范围无效','NOTIFICATION_RESYNC_REQUIRED',409);\n        if(!$this->repository instanceof \\WorkerAdmin\\Contracts\\NotificationThreadRepository)throw new MessageOperationException('通知分页暂不可用','NOTIFICATION_CURSOR_UNAVAILABLE',503);\n        return $this->repository;\n    }\n    public function threads(array $actor,string $cursor=''): array\n    {return $this->threadRepository($cursor)->threads($actor,$cursor);}\n    public function threadMessages(array $actor,string $cursor): array\n    {\n        if($cursor==='')throw new MessageOperationException('请刷新通知列表','NOTIFICATION_RESYNC_REQUIRED',409);\n        return $this->threadRepository($cursor)->threadMessages($actor,$cursor);\n    }\n    public function readRange(array $actor,string $cursor): void\n    {\n        if($cursor==='')throw new MessageOperationException('请刷新通知列表','NOTIFICATION_RESYNC_REQUIRED',409);\n        $this->threadRepository($cursor)->readRange($actor,$cursor);\n    }\n    public function read(array $actor, string $id): void\n    {\n        $id = trim($id);\n        if ($id === '') throw new MessageOperationException('请选择要查看的消息', 'NOTIFICATION_REQUIRED');\n        $this->repository->read($actor, $id);\n    }\n    public function readBatch(array $actor, array $rawIds): array\n    {\n        if (count($rawIds) > 50) throw new MessageOperationException('单次最多标记 50 条消息', 'NOTIFICATION_BATCH_LIMIT');\n        $ids = [];\n        foreach ($rawIds as $value) {\n            if (!is_scalar($value)) continue;\n            $value = trim((string)$value);\n            if ($value !== '' && !in_array($value, $ids, true)) $ids[] = $value;\n        }\n        if (!$ids) throw new MessageOperationException('请选择要查看的消息', 'NOTIFICATION_REQUIRED');\n        return ['updated_count' => $this->repository->readBatch($actor, $ids)];\n    }\n    public function readAll(array $actor, string $throughId = ''): void\n    {\n        if (strlen($throughId)>80) throw new MessageOperationException('通知范围无效','NOTIFICATION_RANGE_INVALID');\n        $this->repository->readAll($actor,trim($throughId));\n    }\n}\n","server/app/Application/Messaging/OrderNotificationPublisher.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse InvalidArgumentException;\nuse WorkerAdmin\\Contracts\\NotificationProducer;\nuse WorkerAdmin\\Contracts\\OrderNotificationPort;\n\nfinal class OrderNotificationPublisher implements OrderNotificationPort\n{\n    private NotificationProducer $producer;\n    public function __construct(NotificationProducer $producer) { $this->producer=$producer; }\n    public function queue(int $orderId,string $idempotencyKey,string $eventType,array $payload=[]):void { $this->producer->queue($orderId,$idempotencyKey,$eventType,$payload); }\n    public function queuePersistedEvent(int $orderId,int $eventId,string $type,array $payload=[]):void\n    { if($eventId<1)throw new InvalidArgumentException('通知必须关联已落库的订单事件');$this->queue($orderId,'order-event:'.$eventId,$type,$payload); }\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void { $this->producer->adminTask($key,$type,$title,$lines); }\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void { $this->producer->withdrawalResult($workerId,$no,$status,$note,$amount); }\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void { $this->producer->workerReviewResult($workerId,$cloudId,$decision,$reason,$name); }\n}\n","server/app/Application/Messaging/SubscriptionTestData.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\n\nfinal class SubscriptionTestData\n{\n    private SettingsProvider $settings;\n    public function __construct(SettingsProvider $settings) { $this->settings=$settings; }\n    public function subscriptionTestEventOptions(string $sceneKey):array\n    {\n        $options=[];\n        foreach(MessageEventCatalog::all() as $eventType=>$meta){\n            if(!is_array($meta)||(string)($meta['subscription_scene']??'')!==$sceneKey)continue;\n            $status=trim((string)($meta['status']??''));if($status==='')continue;\n            $label=trim((string)($meta['label']??''));if($label==='')$label=$status;\n            $options[(string)$eventType]=['label'=>$label,'status'=>$status];\n        }\n        return $options;\n    }\n\n    public function subscriptionTestSampleValues(string $sceneKey):array\n    {\n        $eventOptions= $this->subscriptionTestEventOptions($sceneKey);$first=$eventOptions?(array)reset($eventOptions):[];\n        $platformName=trim((string)$this->settings->get('site.name','壁选'));if($platformName==='')$platformName='壁选';\n        return [\n            'order_no'=>'TEST'.date('YmdHis'),\n            'status'=>(string)($first['status']??'测试通知'),\n            'time'=>date('Y-m-d H:i'),\n            'amount'=>'128.00',\n            'quote_party'=>'张师傅',\n            'platform_name'=>$platformName,\n            'merchant_name'=>'示例家居门店',\n            'worker_name'=>'张师傅',\n            'service_category'=>'墙布施工',\n            'order_title'=>'客厅墙布施工',\n            'service_address'=>'杭州市西湖区示例路',\n            'requirement_note'=>'墙面需先检查基层',\n            'audit_note'=>'资料齐全，审核通过',\n            'expected_visit_time'=>date('Y-m-d H:i',time()+86400),\n            'contact_name'=>'张**',\n            'appointment_time'=>date('Y-m-d H:i',time()+86400),\n            'appointment_note'=>'上门前请电话联系',\n        ];\n    }\n\n    public function buildSubscriptionTestData(string $sceneKey,array $scene,array $input=[]):array\n    {\n        if($sceneKey==='reviewResult'){\n            return [\n                'name1'=>['value'=>'测试师傅'],\n                'phone_number2'=>['value'=>'13800000000'],\n                'phrase3'=>['value'=>'测试通知'],\n                'thing5'=>['value'=>'后台订阅消息链路测试'],\n            ];\n        }\n        $fieldMap=is_array($scene['field_map']??null)?$scene['field_map']:[];\n        if(!$fieldMap)throw new \\RuntimeException('该订阅场景尚未配置字段映射，不能发送测试。');\n        $samples= $this->subscriptionTestSampleValues($sceneKey);\n        $eventOptions= $this->subscriptionTestEventOptions($sceneKey);\n        $eventPost=is_array($input['test_event_type']??null)?$input['test_event_type']:[];\n        $eventType=trim((string)($eventPost[$sceneKey]??''));\n        if($eventType!==''&&isset($eventOptions[$eventType]))$samples['status']=(string)$eventOptions[$eventType]['status'];\n        $valuesPost=is_array($input['test_values']??null)?($input['test_values'][$sceneKey]??[]):[];\n        if(is_array($valuesPost)){\n            foreach($valuesPost as $semantic=>$value){\n                $semantic=(string)$semantic;if(!array_key_exists($semantic,$samples)||is_array($value))continue;\n                // 有真实业务节点可选时，状态必须来自事件目录，避免“测试成功但生产不存在这种状态”。\n                if($semantic==='status'&&$eventOptions)continue;\n                $value=mb_substr(trim((string)$value),0,500);if($value!=='')$samples[$semantic]=$value;\n            }\n        }\n        $data=[];\n        foreach($fieldMap as $semantic=>$wechatKey){\n            $semantic=(string)$semantic;$wechatKey=trim((string)$wechatKey);\n            if($wechatKey===''||!array_key_exists($semantic,$samples))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,(string)$samples[$semantic]);\n            if($formatted===null||$formatted==='')throw new \\RuntimeException('测试字段 '.$semantic.' → '.$wechatKey.' 无法生成合法示例值，请检查字段映射或测试值。');\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $wechatKey=>$fixedValue){\n            $wechatKey=trim((string)$wechatKey);$fixedValue=trim((string)$fixedValue);\n            if($wechatKey===''||$fixedValue===''||isset($data[$wechatKey]))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,$fixedValue);\n            if($formatted===null||$formatted==='')throw new \\RuntimeException('固定字段 '.$wechatKey.' 无法生成合法测试值，请检查高级设置。');\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['template_fields']??[]) as $templateField)if(!isset($data[$templateField]))throw new \\RuntimeException('模板字段 '.$templateField.' 尚未配置数据来源，不能测试发送。');\n        if(!$data)throw new \\RuntimeException('没有可用于测试发送的模板字段。');\n        return $data;\n    }\n}\n","server/app/Contracts/AdminRepairResolutionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\n/** 平台介入后的维修售后裁定端口；不承载退款、赔付或资金处理。 */\ninterface AdminRepairResolutionRepository\n{\n    /**\n     * @param array{channel:string,user_id:int} $operator\n     * @return array<string,mixed>\n     */\n    public function resolve(\n        array $operator,\n        string $orderNo,\n        string $afterSaleNo,\n        string $decision,\n        string $note\n    ): array;\n}\n","server/app/Contracts/AdminWorkbenchOperationsRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface AdminWorkbenchOperationsRepository\n{\n    /** @return array<string,mixed> */\n    public function reassignWorker(array $actor, string $orderNo, int $workerId, string $reason): array;\n\n    /** @return array<string,mixed> */\n    public function interveneRepair(array $actor, string $orderNo, string $afterSaleNo, string $reason): array;\n\n    /** @return array<string,mixed> */\n    public function retryPlatformAutoPublish(array $actor, string $orderNo, string $sourceId): array;\n\n    /** @return array<string,mixed> */\n    public function addInternalFollowup(array $actor, string $orderNo, string $note, ?string $followUpAt): array;\n\n    /** @return array<string,mixed> */\n    public function completeInternalFollowup(array $actor, string $orderNo, int $followupEventId, string $note): array;\n\n    /** @return array<int,array<string,mixed>> */\n    public function workerOptions(string $orderNo, string $keyword, int $limit): array;\n\n    /** @return array<int,array<string,mixed>> */\n    public function internalFollowups(string $orderNo, int $limit): array;\n}\n","server/app/Contracts/MessageOutboxRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface MessageOutboxRepository\n{\n    public function dashboard(string $status, string $q, int $page, string $tab = 'records'): array;\n    public function retry(int $id): array;\n    public function close(int $id): array;\n    public function addSuppression(string $hmac, string $masked, string $reason, string $note, int $adminId): void;\n    public function removeSuppression(int $id): array;\n}\n","server/app/Contracts/NotificationInboxRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface NotificationInboxRepository\n{\n    public function summary(array $actor): array;\n    public function list(array $actor, int $page, string $throughId = ''): array;\n    public function read(array $actor, string $publicId): void;\n    public function readBatch(array $actor, array $ids): int;\n    public function readAll(array $actor, string $throughId = ''): void;\n}\n","server/app/Contracts/NotificationProducer.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface NotificationProducer\n{\n    public function queue(int $orderId,string $key,string $type,array $payload=[]):void;\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void;\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void;\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void;\n}\n","server/app/Contracts/OrderCancellationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCancellationRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array<string,mixed>\n     */\n    public function request(array $actor, string $orderNo, string $reason, string $reasonCode): array;\n\n    /**\n     * @param array<string,mixed> $operator 带 channel 的管理员描述符：mini_admin 使用 users.id，仅写 typed event；web_admin 使用 admin_users.id，可写 decided_by/requested_by_admin_id。\n     * @return array<string,mixed>\n     */\n    public function review(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array;\n}\n","server/app/Contracts/OrderCancellationRiskRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCancellationRiskRepository\n{\n    public function configuration(): array;\n    public function saveConfiguration(array $rules): void;\n    public function user(int $userId): ?array;\n    public function state(int $userId): array;\n    public function recordDial(array $actor, string $publicNo): void;\n    public function reviewData(int $userId): array;\n    public function restrictManually(int $userId, int $adminId, int $days, string $reason): void;\n    public function release(int $userId, int $adminId, string $reason, array $excludedOrderIds = [], ?int $expectedId = null): void;\n}\n","server/app/Contracts/OrderCenterRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCenterRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array{rows:array<int,array<string,mixed>>,has_more:bool}\n     */\n    public function page(array $actor, string $kind, string $status, int $page, int $limit, string $keyword = ''): array;\n\n    /** @param array<string,mixed> $actor */\n    public function supplementCount(array $actor, string $kind): int;\n\n    /** @param array<string,mixed> $actor */\n    public function todoCount(array $actor, string $kind): int;\n}\n","server/app/Contracts/OrderDisputeRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderDisputeRepository\n{\n    /** @param array<string,mixed> $actor @param string[] $evidenceIds @return array<string,mixed> */\n    public function startNegotiation(array $actor, string $orderNo, string $description, array $evidenceIds): array;\n\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function escalate(array $actor, string $disputeNo, string $note): array;\n\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function resolveByAgreement(array $actor, string $disputeNo, string $note): array;\n\n    /**\n     * @param array<string,mixed> $operator 带 channel 的管理员描述符；mini_admin 只能零金额结案，web_admin 可做资金裁定。\n     * @return array<string,mixed>\n     */\n    public function resolveByAdmin(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array;\n}\n","server/app/Contracts/OrderNegotiationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderNegotiationRepository\n{\n    public function respond(array $actor, string $orderNo, string $kind, string $reference, string $decision, string $note): array;\n    public function escalate(array $actor, string $orderNo, string $kind, string $reference, string $note): array;\n    public function proposeRefund(array $actor, string $orderNo, string $reference, int $amount, string $note): array;\n    public function withdrawRefund(array $actor, string $orderNo, string $reference, string $note): array;\n}\n","server/app/Contracts/OrderNotificationPort.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderNotificationPort\n{\n    public function queue(\n        int $orderId,\n        string $idempotencyKey,\n        string $eventType,\n        array $payload = []\n    ): void;\n}\n","server/app/Contracts/OrderQuoteSwitchRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderQuoteSwitchRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array{message:string,data:array<string,mixed>}\n     */\n    public function switchWorker(array $actor, string $orderPublicNo, string $quotePublicId, string $reason): array;\n}\n","server/app/Contracts/OrderRepairInterventionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderRepairInterventionRepository\n{\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function request(array $actor, string $orderNo, string $afterSaleNo, string $note): array;\n}\n","server/app/Contracts/PlatformOrderAdminRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface PlatformOrderAdminRepository\n{\n    /** @return array<string,mixed> */\n    public function dashboard(): array;\n\n    /** @param array<string,mixed> $command */\n    public function create(array $command, int $adminId): int;\n\n    public function publish(int $orderId, int $adminId, int $quoteDays): void;\n\n    public function selectQuote(int $orderId, int $quoteId, int $adminId): void;\n\n    /** @return array<string,mixed> */\n    public function createInvite(int $orderId, int $adminId, int $validDays): array;\n\n    public function revokeInvite(int $orderId, int $inviteId, int $adminId): void;\n}\n","server/app/Contracts/PrivateValueCipher.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\n/**\n * 隐私字段加密/哈希端口。业务层不直接依赖全局加密函数。\n */\ninterface PrivateValueCipher\n{\n    public function hmac(string $plainText, string $context): string;\n\n    public function encrypt(string $plainText, string $context): ?string;\n\n    public function decrypt(string $cipherText, string $context): string;\n}\n","server/app/Contracts/SettingsProvider.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\n/**\n * 业务层读取系统配置的稳定端口。\n *\n * Domain/Application 不再直接依赖全局 setting()，便于后续切换数据库配置、缓存或测试替身。\n */\ninterface SettingsProvider\n{\n    /** @return mixed */\n    public function get(string $key, $default = null);\n\n    public function bool(string $key, bool $default = false): bool;\n\n    public function int(string $key, int $default = 0): int;\n}\n","server/app/Contracts/SubscribeMessageGateway.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface SubscribeMessageGateway\n{\n    public function categoryList(): array;\n    public function publicTemplateTitles(array $categoryIds, int $start = 0, int $limit = 30): array;\n    public function publicTemplateKeywords(string $tid): array;\n    public function addTemplate(string $tid, array $kidList, string $sceneDesc = ''): string;\n    public function templateList(): array;\n    public function send(array $payload): array;\n}\n","server/app/Contracts/SubscriptionRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface SubscriptionRepository\n{\n    public function definitions(): array;\n    public function preferences(int $userId): array;\n    public function save(int $userId, string $key, bool $enabled, string $status): array;\n    public function diagnose(int $userId): array;\n}\n","server/app/Contracts/TestCenterActionRunner.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface TestCenterActionRunner\n{\n    /** @return array<string,mixed> */\n    public function available(string $instancePublicId): array;\n\n    /**\n     * @param array<string,mixed> $input\n     * @return array<string,mixed>\n     */\n    public function run(string $instancePublicId, string $actionKey, array $input, int $adminId, string $requestKey): array;\n}\n","server/app/Core/Auth.php":"<?php\n\nnamespace WorkerAdmin\\Core;\n\nuse RuntimeException;\n\nclass Auth\n{\n    private $db;\n    private $userLoaded = false;\n    private $user;\n\n    private $permissions = [\n        'operations' => ['chat.images.review', 'chat.media.review', 'dashboard.view', 'orders.manage', 'workers.manage', 'users.view', 'users.manage', 'catalog.manage', 'help.manage', 'reviews.manage', 'disputes.manage', 'audit.view'],\n        'finance' => ['dashboard.view', 'orders.view', 'payments.manage', 'refunds.manage', 'commissions.manage', 'withdrawals.manage', 'audit.view'],\n        'viewer' => ['dashboard.view', 'orders.view', 'users.view'],\n    ];\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    // 2026-08-14：登录包含失败锁定、会话轮换和密码哈希升级。\n    public function attempt($username, $password)\n    {\n        $username = trim((string) $username);\n        $user = $this->db->fetch('SELECT * FROM admin_users WHERE username = :username LIMIT 1', ['username' => $username]);\n        if (!$user || !in_array((string) $user['status'], ['active', '1'], true)) {\n            return false;\n        }\n\n        if (!empty($user['locked_until']) && strtotime($user['locked_until'] . ' UTC') > time()) {\n            throw new RuntimeException('登录失败次数过多，请稍后再试。');\n        }\n\n        if (!password_verify((string) $password, $user['password_hash'])) {\n            $attempts = (int) $user['failed_attempts'] + 1;\n            $max = (int) \\app_config('security.login_max_attempts', 5);\n            // 2026-08-14：锁定时间按 UTC 写库，与订单及审计时间约定保持一致。\n            $lockedUntil = $attempts >= $max ? gmdate('Y-m-d H:i:s', time() + ((int) \\app_config('security.login_lock_minutes', 15) * 60)) : null;\n            $this->db->execute('UPDATE admin_users SET failed_attempts=:attempts, locked_until=:locked_until, updated_at=NOW() WHERE id=:id', [\n                'attempts' => $attempts, 'locked_until' => $lockedUntil, 'id' => $user['id'],\n            ]);\n            return false;\n        }\n\n        if (password_needs_rehash($user['password_hash'], PASSWORD_BCRYPT, ['cost' => 12])) {\n            $this->db->execute('UPDATE admin_users SET password_hash=:hash WHERE id=:id', [\n                'hash' => password_hash((string) $password, PASSWORD_BCRYPT, ['cost' => 12]), 'id' => $user['id'],\n            ]);\n        }\n\n        $this->revokeChatIdentity();\n        session_regenerate_id(true);\n        $_SESSION['admin_id'] = (int) $user['id'];\n        $_SESSION['admin_login_at'] = time();\n        $this->db->execute('UPDATE admin_users SET failed_attempts=0, locked_until=NULL, last_login_at=NOW(), last_login_ip=:ip, updated_at=NOW() WHERE id=:id', [\n            'ip' => \\request_ip(), 'id' => $user['id'],\n        ]);\n        $this->userLoaded = false;\n        $this->user = null;\n        \\csrf()->rotate();\n        return true;\n    }\n\n    public function user()\n    {\n        if ($this->userLoaded) {\n            return $this->user;\n        }\n        $this->userLoaded = true;\n        if (empty($_SESSION['admin_id'])) {\n            return $this->user = null;\n        }\n        // 2026-08-14：管理员表不保存手机号，避免查询不存在字段导致登录后页面报错。\n        $this->user = $this->db->fetch('SELECT id, username, real_name, role, status, must_change_password, last_login_at, last_login_ip, created_at FROM admin_users WHERE id=:id LIMIT 1', ['id' => (int) $_SESSION['admin_id']]);\n        if (!$this->user || !in_array((string) $this->user['status'], ['active', '1'], true)) {\n            $this->logout();\n            return null;\n        }\n        return $this->user;\n    }\n\n    public function check()\n    {\n        return $this->user() !== null;\n    }\n\n    public function logout()\n    {\n        $this->revokeChatIdentity();\n        $this->user = null;\n        $this->userLoaded = true;\n        unset($_SESSION['admin_id'], $_SESSION['admin_login_at']);\n        if (session_status() === PHP_SESSION_ACTIVE) {\n            session_regenerate_id(true);\n        }\n    }\n\n    private function revokeChatIdentity(): void\n    {\n        if (empty($_SESSION['chat_admin_session_id'])) return;\n        try {\n            $this->db->execute('UPDATE chat_admin_sessions SET revoked_at=COALESCE(revoked_at,UTC_TIMESTAMP()) WHERE id=:id AND admin_id=:admin_id',\n                ['id'=>(string)$_SESSION['chat_admin_session_id'],'admin_id'=>(string)($_SESSION['admin_id'] ?? '0')]);\n        } catch (\\Throwable $error) {\n            // Don't report successful logout if persistent chat revocation failed.\n            throw new RuntimeException('聊天会话暂时无法撤销，请稍后再试。');\n        }\n        unset($_SESSION['chat_admin_session_id']);\n    }\n\n    public function can($permission)\n    {\n        $user = $this->user();\n        if (!$user) {\n            return false;\n        }\n        if ($user['role'] === 'super_admin') {\n            return true;\n        }\n        $grants = isset($this->permissions[$user['role']]) ? $this->permissions[$user['role']] : [];\n        if (in_array($permission, $grants, true)) {\n            return true;\n        }\n        if (substr($permission, -5) === '.view') {\n            return in_array(str_replace('.view', '.manage', $permission), $grants, true);\n        }\n        return false;\n    }\n\n    public function requireLogin()\n    {\n        if (!$this->check()) {\n            \\redirect(\\admin_url('login'));\n        }\n    }\n\n    public function requirePermission($permission)\n    {\n        $this->requireLogin();\n        if (!$this->can($permission)) {\n            http_response_code(403);\n            echo \\view('errors/403', ['pageTitle' => '无权访问']);\n            exit;\n        }\n    }\n}\n\n","server/app/Core/Csrf.php":"<?php\n\nnamespace WorkerAdmin\\Core;\n\nuse RuntimeException;\n\nclass Csrf\n{\n    // 2026-08-14：所有后台写操作统一使用会话 CSRF 令牌。\n    public function token()\n    {\n        if (empty($_SESSION['_csrf_token'])) {\n            $_SESSION['_csrf_token'] = bin2hex(random_bytes(32));\n        }\n        return $_SESSION['_csrf_token'];\n    }\n\n    public function input()\n    {\n        return '<input type=\"hidden\" name=\"_token\" value=\"' . \\e($this->token()) . '\">';\n    }\n\n    public function validate($token)\n    {\n        return is_string($token) && hash_equals($this->token(), $token);\n    }\n\n    public function verifyRequest()\n    {\n        $token = isset($_POST['_token']) ? $_POST['_token'] : (isset($_SERVER['HTTP_X_CSRF_TOKEN']) ? $_SERVER['HTTP_X_CSRF_TOKEN'] : '');\n        if (!$this->validate($token)) {\n            throw new RuntimeException('页面已过期，请刷新后重试。');\n        }\n    }\n\n    public function rotate()\n    {\n        $_SESSION['_csrf_token'] = bin2hex(random_bytes(32));\n        return $_SESSION['_csrf_token'];\n    }\n}\n","server/app/Core/Database.php":"<?php\n\nnamespace WorkerAdmin\\Core;\n\nuse PDO;\nuse PDOException;\nuse RuntimeException;\nuse Throwable;\n\nclass Database\n{\n    private $config;\n    private $pdo;\n    private $transactionDepth = 0;\n    private $transactionRollbackOnly = false;\n    private array $beforeCommitCallbacks = [];\n    private bool $runningBeforeCommit = false;\n\n    // 2026-08-14：统一 PDO 连接并强制真实预处理，兼容 MySQL 5.7.44。\n    public function __construct(array $config)\n    {\n        $this->config = $config;\n    }\n\n    public function pdo()\n    {\n        if ($this->pdo instanceof PDO) {\n            return $this->pdo;\n        }\n        if (!extension_loaded('pdo_mysql')) {\n            throw new RuntimeException('服务器未安装 pdo_mysql 扩展。');\n        }\n\n        $host = isset($this->config['host']) ? $this->config['host'] : '127.0.0.1';\n        $port = isset($this->config['port']) ? (int) $this->config['port'] : 3306;\n        $database = isset($this->config['database']) ? $this->config['database'] : '';\n        $charset = isset($this->config['charset']) ? $this->config['charset'] : 'utf8mb4';\n        if ($database === '') {\n            throw new RuntimeException('数据库名称尚未配置。');\n        }\n\n        $dsn = sprintf('mysql:host=%s;port=%d;dbname=%s;charset=%s', $host, $port, $database, $charset);\n        try {\n            $this->pdo = new PDO($dsn, (string) $this->config['username'], (string) $this->config['password'], [\n                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,\n                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,\n                PDO::ATTR_EMULATE_PREPARES => false,\n                PDO::ATTR_STRINGIFY_FETCHES => false,\n                PDO::ATTR_TIMEOUT => 5,\n            ]);\n            $this->pdo->exec(\"SET SESSION sql_mode='STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'\");\n            $this->pdo->exec(\"SET time_zone='+00:00'\");\n        } catch (PDOException $exception) {\n            throw new RuntimeException('数据库连接失败，请检查安装配置。', 0, $exception);\n        }\n\n        return $this->pdo;\n    }\n\n    /**\n     * MySQL 原生预处理不允许在同一条 SQL 中重复使用同名占位符。\n     * 这里仅展开重复命名参数，继续保持 ATTR_EMULATE_PREPARES=false，避免各业务控制器重复踩坑。\n     */\n    private function prepareAndExecute($sql, array $params = [])\n    {\n        list($sql, $params) = $this->expandDuplicateNamedParameters((string) $sql, $params);\n        $statement = $this->pdo()->prepare($sql);\n        $statement->execute($params);\n        return $statement;\n    }\n\n    private function expandDuplicateNamedParameters($sql, array $params)\n    {\n        if (!$params || strpos($sql, ':') === false) {\n            return [$sql, $params];\n        }\n\n        $normalized = [];\n        foreach ($params as $key => $value) {\n            $normalized[ltrim((string) $key, ':')] = $value;\n        }\n        $seen = [];\n        $expanded = [];\n        $rewritten = preg_replace_callback('/(?<!:):([A-Za-z_][A-Za-z0-9_]*)\\b/', function ($match) use (&$seen, &$expanded, $normalized) {\n            $name = $match[1];\n            if (!array_key_exists($name, $normalized)) {\n                return $match[0];\n            }\n            $index = isset($seen[$name]) ? ++$seen[$name] : ($seen[$name] = 1);\n            $target = $index === 1 ? $name : $name . '__dup' . $index;\n            $expanded[$target] = $normalized[$name];\n            return ':' . $target;\n        }, $sql);\n\n        // 保留未出现在 SQL 中的参数会触发 HY093；因此只传递实际匹配到的命名参数。\n        // 本项目数据库层统一使用命名参数，若 SQL 没有匹配到占位符则沿用原参数以便显式暴露调用错误。\n        return [$rewritten, $expanded ?: $params];\n    }\n\n    public function fetch($sql, array $params = [])\n    {\n        $statement = $this->prepareAndExecute($sql, $params);\n        $row = $statement->fetch();\n        return $row === false ? null : $row;\n    }\n\n    public function fetchAll($sql, array $params = [])\n    {\n        return $this->prepareAndExecute($sql, $params)->fetchAll();\n    }\n\n    public function fetchValue($sql, array $params = [])\n    {\n        return $this->prepareAndExecute($sql, $params)->fetchColumn();\n    }\n\n    public function execute($sql, array $params = [])\n    {\n        return $this->prepareAndExecute($sql, $params)->rowCount();\n    }\n\n    public function insert($sql, array $params = [])\n    {\n        $this->execute($sql, $params);\n        return (int) $this->pdo()->lastInsertId();\n    }\n\n    /**\n     * 共享连接的事务加入语义：只有最外层真正 begin/commit；内层 transaction 加入当前事务。\n     * 任一内层回调抛错都会把整笔用例标记 rollback-only，即使上层业务误捕获异常，也禁止提交部分结果。\n     */\n    public function transaction(callable $callback)\n    {\n        $pdo = $this->pdo();\n        $outermost = $this->transactionDepth === 0;\n\n        if ($outermost) {\n            $pdo->beginTransaction();\n            $this->transactionRollbackOnly = false;\n            $this->beforeCommitCallbacks = [];\n        }\n        $this->transactionDepth++;\n\n        try {\n            $result = $callback($this);\n\n            if (!$outermost) {\n                $this->transactionDepth--;\n                return $result;\n            }\n\n            if ($this->transactionRollbackOnly) {\n                throw new RuntimeException('事务已因内部失败标记为回滚，禁止提交部分业务结果。');\n            }\n\n            $this->runningBeforeCommit = true;\n            ksort($this->beforeCommitCallbacks,SORT_STRING);\n            foreach ($this->beforeCommitCallbacks as $beforeCommit) $beforeCommit($this);\n            $this->runningBeforeCommit = false;\n            if ($this->transactionRollbackOnly) throw new RuntimeException('事务已因内部失败标记为回滚，禁止提交部分业务结果。');\n            $this->transactionDepth--;\n            $pdo->commit();\n            $this->resetTransactionState();\n            return $result;\n        } catch (Throwable $exception) {\n            if ($this->transactionDepth > 0) {\n                $this->transactionDepth--;\n            }\n            $this->transactionRollbackOnly = true;\n\n            if ($outermost) {\n                if ($pdo->inTransaction()) {\n                    $pdo->rollBack();\n                }\n                $this->resetTransactionState();\n            }\n            throw $exception;\n        }\n    }\n\n    /** Register bounded DML work after all outer/nested writes, before the same commit. */\n    public function beforeCommit(string $key, callable $callback): void\n    {\n        if ($this->transactionDepth<1 || !$this->pdo()->inTransaction() || $this->runningBeforeCommit\n            || $key==='' || strlen($key)>96 || (!isset($this->beforeCommitCallbacks[$key]) && count($this->beforeCommitCallbacks)>=128)) {\n            throw new RuntimeException('预提交动作必须在原事务内登记且不得递归或超过上限');\n        }\n        $this->beforeCommitCallbacks[$key]=$callback;\n    }\n\n    private function resetTransactionState()\n    {\n        $this->transactionDepth = 0;\n        $this->transactionRollbackOnly = false;\n        $this->beforeCommitCallbacks = [];\n        $this->runningBeforeCommit = false;\n    }\n\n    public function tableExists($table)\n    {\n        $count = $this->fetchValue(\n            'SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = :table',\n            ['table' => $table]\n        );\n        return (int) $count > 0;\n    }\n\n    public function columnExists($table, $column)\n    {\n        $count = $this->fetchValue(\n            'SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = :table AND column_name = :column',\n            ['table' => $table, 'column' => $column]\n        );\n        return (int) $count > 0;\n    }\n}\n\n","server/app/Domain/Chat/OrderConversationPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Chat;\n\n/** PHP is the only interpreter of order/assignment states. Input is server-owned facts. */\nfinal class OrderConversationPolicy\n{\n    /** PHP-owned platform policy; staff authority is intersected again by Go. */\n    public function evaluatePlatform(array $facts): ?array\n    {\n        foreach (['order_id','customer_id','assignment_id','worker_id','worker_user_id'] as $key) {\n            if (!$this->id($facts[$key] ?? null)) return null;\n        }\n        if (($facts['order_source_type'] ?? '') !== 'platform'\n            || ($facts['customer_flow_mode'] ?? '') !== 'platform_managed'\n            || ($facts['is_demo'] ?? null) !== 0 || ($facts['booking_fee_cents'] ?? null) !== 0\n            || ($facts['payment_status'] ?? '') !== 'not_required'\n            || !in_array($facts['workflow_profile'] ?? '', ['construction','measurement'], true)\n            || (string)($facts['current_assignment_id'] ?? '') !== (string)$facts['assignment_id']\n            || (string)($facts['assignment_order_id'] ?? '') !== (string)$facts['order_id']\n            || (string)($facts['assigned_worker_id'] ?? '') !== (string)$facts['worker_id']\n            || ($facts['worker_user_status'] ?? '') !== 'active'\n            || empty($facts['assignment_accepted_at'])\n            || (string)$facts['customer_id'] === (string)$facts['worker_user_id']\n            || !$this->id($facts['staff_config_version'] ?? null)) return null;\n        $lifecycle = (string)($facts['lifecycle_status'] ?? '');\n        $episode = 'assignment:'.$facts['assignment_id'].':service';\n        $repair = array_key_exists('repair_episode',$facts);\n        if ($repair) {\n            $accepted = is_array($facts['repair_episode']) ? $this->repair($facts,$facts['repair_episode'],true) : null;\n            if (!$accepted) return null;\n            $episode = $accepted['episode_key'];\n        }\n        $open = $lifecycle === 'active' || $repair;\n        if (!$open && !in_array($lifecycle, ['completed','cancelled','closed','refunded','cancel_approved_pending_refund'], true)) return null;\n        $statuses = $lifecycle === 'active' ? ['accepted','info_released'] : ['accepted','info_released','completed','cancelled'];\n        if (!in_array($facts['assignment_status'] ?? '', $statuses, true)\n            || !in_array($facts['assignment_record_status'] ?? '', $statuses, true)) return null;\n        $members = [];\n        if (($facts['customer_status'] ?? '') === 'active') {\n            if ((string)$facts['customer_id'] === (string)$facts['worker_user_id']) return null;\n            $members[] = $this->member((string)$facts['customer_id'], 'customer', $open);\n        } elseif (($facts['customer_status'] ?? '') !== 'platform_unbound') return null;\n        $members[] = $this->member((string)$facts['worker_user_id'], 'worker', $open);\n        $staff = $facts['platform_staff'] ?? null;\n        if (!is_array($staff) || count($staff) > 8) return null;\n        $seen = array_fill_keys(array_column($members, 'actor_id'), true);\n        foreach ($staff as $person) {\n            if (!is_array($person) || !$this->id($person['actor_id'] ?? null)\n                || ($person['kind'] ?? '') !== 'mini' || ($person['status'] ?? '') !== 'active'\n                || ($person['is_mini_admin'] ?? null) !== true || !$this->id($person['authority_version'] ?? null)) return null;\n            $id = (string)$person['actor_id'];\n            if (($facts['customer_status'] ?? '') === 'platform_unbound' && $id === (string)$facts['customer_id']) return null;\n            // A worker/customer who is also an administrator retains that role.\n            if (isset($seen[$id])) continue;\n            $seen[$id] = true;\n            $member = $this->member($id, 'platform_staff', $open);\n            $member['authority_version'] = (string)$person['authority_version'];\n            $members[] = $member;\n        }\n        if (count($members) > 10) return null;\n        if (count($members) === 1) $members[0]['can_send'] = false;\n        $snapshot = $this->snapshot($facts, $open, $episode);\n        $snapshot['schema_version'] = 2;\n        $snapshot['staff_config_version'] = (string)$facts['staff_config_version'];\n        $snapshot['members'] = $members;\n        return $snapshot;\n    }\n\n    private function member(string $id, string $role, bool $open): array\n    {\n        return ['actor_id'=>$id,'kind'=>'mini','role'=>$role,'can_read'=>true,'can_send'=>$open];\n    }\n\n    /** A null result means no new grant. Existing grants must be closed by the bridge. */\n    public function evaluate(array $facts): ?array\n    {\n        if (($facts['order_source_type'] ?? '') === 'platform') return $this->evaluatePlatform($facts);\n        foreach (['order_id','customer_id','assignment_id','worker_id','worker_user_id'] as $key) {\n            if (!$this->id($facts[$key] ?? null)) return null;\n        }\n        if ((string)($facts['current_assignment_id'] ?? '') !== (string)$facts['assignment_id']\n            || (string)($facts['assignment_order_id'] ?? '') !== (string)$facts['order_id']\n            || (string)($facts['assigned_worker_id'] ?? '') !== (string)$facts['worker_id']\n            || (string)$facts['customer_id'] === (string)$facts['worker_user_id']) return null;\n        if (($facts['is_demo'] ?? null) !== 0 || ($facts['customer_status'] ?? '') !== 'active'\n            || ($facts['worker_user_status'] ?? '') !== 'active') return null;\n        if (!in_array($facts['workflow_profile'] ?? '', ['construction','measurement'],true)\n            || !in_array($facts['order_source_type'] ?? '', ['consumer','merchant'],true)) return null;\n        if(array_key_exists('repair_episode',$facts)) {\n            return is_array($facts['repair_episode'])?$this->repair($facts,$facts['repair_episode']):null;\n        }\n        // An offered/unaccepted assignment never creates order chat.\n        if (($facts['assignment_record_status'] ?? '') !== 'accepted'\n            || !in_array($facts['assignment_status'] ?? '', ['accepted','info_released'],true)\n            || empty($facts['assignment_accepted_at']) || ($facts['payment_status'] ?? '') !== 'paid') return null;\n        $lifecycle = (string)($facts['lifecycle_status'] ?? '');\n        $open = $lifecycle === 'active';\n        if (!$open && !in_array($lifecycle,['completed','cancelled','closed','refunded','cancel_approved_pending_refund'],true)) return null;\n        return $this->snapshot($facts,$open,'assignment:'.$facts['assignment_id'].':service');\n    }\n\n    private function repair(array $facts,array $episode,bool $platform=false): ?array\n    {\n        foreach(['id','after_sale_id'] as $key) if(!$this->id($episode[$key]??null))return null;\n        foreach(['order_id'=>'order_id','assignment_id'=>'assignment_id','worker_id'=>'worker_id','accepted_user_id'=>'worker_user_id',\n            'repair_order_id'=>'order_id','repair_user_id'=>'customer_id'] as $key=>$fact) {\n            if((string)($episode[$key]??'')!==(string)$facts[$fact])return null;\n        }\n        if(($facts['workflow_profile']??'')!=='construction' || ($facts['lifecycle_status']??'')!=='completed'\n            || ($facts['payment_status']??'')!==($platform?'not_required':'paid')\n            || !in_array($facts['assignment_record_status']??'',['accepted','completed'],true)\n            || !in_array($facts['assignment_status']??'',['accepted','info_released','completed'],true) || empty($facts['assignment_accepted_at'])\n            || ($episode['state']??'')!=='active' || empty($episode['accepted_at']) || !empty($episode['closed_at'])\n            || ($episode['repair_type']??'')!=='warranty_repair' || ($episode['repair_status']??'')!=='processing'\n            || !empty($episode['repair_closed_at']))return null;\n        return $this->snapshot($facts,true,'assignment:'.$facts['assignment_id'].':repair:'.$episode['id']);\n    }\n\n    private function snapshot(array $facts,bool $open,string $episode): array\n    {\n        $order=(string)$facts['order_id'];$assignment=(string)$facts['assignment_id'];\n        return [\n            'schema_version'=>1,'scope_key'=>'order:'.$order.':assignment:'.$assignment,\n            'order_id'=>$order,'assignment_id'=>$assignment,'episode_key'=>$episode,\n            'state'=>$open?'open':'readonly','can_invite'=>false,\n            'members'=>[\n                ['actor_id'=>(string)$facts['customer_id'],'kind'=>'mini','role'=>'customer','can_read'=>true,'can_send'=>$open],\n                ['actor_id'=>(string)$facts['worker_user_id'],'kind'=>'mini','role'=>'worker','can_read'=>true,'can_send'=>$open],\n            ],\n        ];\n    }\n\n    private function id($value): bool\n    {\n        if (!is_string($value) && !is_int($value)) return false;\n        $id=(string)$value;\n        return preg_match('/^[1-9][0-9]{0,19}$/D',$id)===1\n            && (strlen($id)<20 || strcmp($id,'18446744073709551615')<=0);\n    }\n}\n","server/app/Domain/Identity/AdminActorPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Identity;\n\n/**\n * 小程序管理员身份纯规则。\n *\n * 管理员资格绑定真实登录会话 OpenID；进入演示代理后不得继承生产管理员权限。\n */\nfinal class AdminActorPolicy\n{\n    public function isRealMiniAdmin(array $actor, array $adminOpenIds): bool\n    {\n        $openid = trim((string) ($actor['payer_openid'] ?? ''));\n        if ($openid === '') return false;\n        return in_array($openid, $adminOpenIds, true);\n    }\n\n    public function isMiniAdmin(array $actor, array $adminOpenIds): bool\n    {\n        return empty($actor['is_demo_actor']) && $this->isRealMiniAdmin($actor, $adminOpenIds);\n    }\n\n    public function isWorker(array $actor): bool\n    {\n        return (int) ($actor['worker_id'] ?? 0) > 0;\n    }\n\n    public function isOrderOwner(array $actor, array $order): bool\n    {\n        return (int) ($actor['user_id'] ?? 0) > 0\n            && (int) ($actor['user_id'] ?? 0) === (int) ($order['user_id'] ?? 0);\n    }\n}\n","server/app/Domain/Messaging/MessageEventCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\nrequire_once __DIR__.'/OrderProgressMessageCatalog.php';\n\n// 2026-10-08：统一协商事件仅通知另一方，升级后才通知管理员。\nfinal class MessageEventCatalog\n{\n    public static function all(): array\n    {\n        static $catalog = null;\n        if (is_array($catalog)) return $catalog;\n\n        $labels = [\n            'negotiation_responded'=>'对方响应协商','repair_worker_accepted'=>'师傅接受维修','measurement_rework_rejected'=>'师傅无法补测',\n            'order_ready_for_prepayment'=>'下单待支付预约费','order_submitted'=>'新订单待管理员审核','order_approved'=>'订单审核通过','order_supplement_required'=>'要求用户补充资料','order_supplemented'=>'用户已补充资料','order_rejected'=>'订单审核未通过',\n            'worker_quoted'=>'师傅首次报价','worker_quote_updated'=>'师傅修改报价','platform_quoted'=>'平台报价','quote_selected_pending_payment'=>'用户选择报价','payment_reservation_released'=>'支付超时释放报价','booking_fee_paid'=>'预约费支付成功','booking_fee_paid_upfront'=>'下单预约费支付成功',\n            'worker_assigned'=>'安排施工师傅','assignment_accepted'=>'师傅接单','assignment_rejected'=>'师傅拒绝派单','assignment_expired'=>'派单超时释放','appointment_recorded'=>'师傅登记预约','appointment_waiting_customer_notice'=>'师傅已响应预约，等待客户确认',\n            'change_requested'=>'师傅申请费用调整','change_accepted'=>'用户同意费用调整','change_rejected'=>'用户不同意费用调整','completion_submitted'=>'师傅提交完工','completion_accepted_by_user'=>'用户确认验收','auto_completion_accepted'=>'系统自动验收','auto_accepted_72h'=>'72小时自动验收',\n            'exceptional_arrival_reported'=>'师傅登记到场异常','offline_collection_delayed'=>'尾款延期登记','offline_collection_bad_debt'=>'尾款坏账','cancel_requested'=>'用户申请取消退款','cancel_approved'=>'取消退款通过','admin_cancelled'=>'平台强制取消','cancel_rejected'=>'取消退款驳回','auto_cancelled_7d'=>'七天自动取消','refund_succeeded'=>'退款成功',\n            'order_auto_preapproved'=>'新订单自动预审公开','offline_collection_adjustment_requested'=>'师傅提交实际尾款','offline_collection_adjustment_auto_approved'=>'实际尾款自动预审生效','offline_collection_adjustment_approved'=>'实际尾款复核通过','offline_collection_adjustment_rejected'=>'实际尾款驳回',\n            'commission_estimate_created'=>'预计服务费已生成','commission_receivable_finalized'=>'正式平台服务费已生成','commission_receivable_created'=>'平台服务费待缴','commission_paid'=>'平台服务费结清','commission_overdue'=>'平台服务费逾期',\n            'dispute_opened'=>'订单争议发起','completion_dispute_opened'=>'用户提交完工争议','dispute_resolved'=>'订单争议结案','review_submitted'=>'用户提交评价','auto_reviewed_5d'=>'系统自动评价',\n            'run_empty_claim_submitted'=>'商家跑空费待确认','run_empty_claim_confirmed'=>'商家已确认跑空费','run_empty_claim_disputed'=>'跑空费进入争议','run_empty_fee_paid'=>'商家已支付跑空费',\n            'worker_profile_submitted'=>'师傅发布/更新资料待审核','worker_realname_submitted'=>'师傅实名待审核','worker_collection_code_submitted'=>'旧版收款码待审核','worker_collection_code_auto_approved'=>'收款码自动预审后待抽查','merchant_auth_submitted'=>'商家认证待审核','withdrawal_submitted'=>'师傅提交提现申请',\n            'warranty_repair_requested'=>'用户提交维修申请','warranty_repair_withdrawn'=>'用户撤回维修申请','repair_worker_rejected'=>'师傅拒绝维修','repair_worker_completed'=>'师傅完成维修','repair_intervention_available'=>'维修超时可申请平台介入','repair_platform_intervention_requested'=>'用户申请平台介入维修','repair_platform_continue'=>'平台要求继续维修','repair_platform_resolved'=>'平台确认售后解决','repair_platform_closed'=>'平台关闭售后','repair_appointment_recorded'=>'师傅登记维修预约','repair_waiting_customer_notice'=>'师傅已响应维修，等待客户确认','worker_replaced_by_user'=>'用户更换成交师傅',\n            'supplement_deadline_reminder'=>'补资料期限提醒','supplement_timeout_refunded'=>'补资料超时退款',\n            'measurement_service_paid'=>'测量服务费支付成功','measurement_change_paid'=>'测量加费支付成功','measurement_change_accepted_pending_payment'=>'测量加费待付款','measurement_result_submitted'=>'测量成果待确认','measurement_rework_requested'=>'用户申请补测','measurement_result_accepted'=>'测量成果已确认','measurement_auto_accepted'=>'测量成果自动确认',\n            'measurement_hold_extension_requested'=>'测量冻结延期申请','measurement_hold_extension_approved'=>'测量冻结延期已通过','measurement_hold_extension_rejected'=>'测量冻结延期未通过','measurement_income_released'=>'测量费用已结算','measurement_construction_linked'=>'测量单已关联施工单',\n            'measurement_change_refund_created'=>'测量加费退款处理中','measurement_change_refunded'=>'测量加费退款成功','measurement_late_balance_refund_created'=>'测量尾款退款处理中','measurement_late_balance_refunded'=>'测量尾款退款成功',\n            'worker_contact_reveal_requested'=>'用户申请公开师傅电话','worker_contact_reveal_approved'=>'师傅电话公开申请已批准','worker_contact_reveal_rejected'=>'师傅电话公开申请未批准','worker_contact_reveal_cancelled'=>'师傅电话公开申请已取消',\n        ];\n\n        $normal = array_flip([\n            'order_approved','worker_assigned','assignment_accepted','appointment_recorded','booking_fee_paid','booking_fee_paid_upfront','measurement_service_paid','measurement_change_paid','refund_succeeded','measurement_change_refunded','measurement_late_balance_refunded','worker_quote_updated','payment_reservation_released','commission_estimate_created','run_empty_fee_paid','auto_cancelled_7d','repair_worker_completed','completion_accepted_by_user','commission_paid','review_submitted','auto_reviewed_5d','run_empty_fee_paid',\n            'order_auto_preapproved','offline_collection_adjustment_auto_approved','worker_collection_code_auto_approved',\n            'measurement_result_accepted','measurement_auto_accepted','measurement_income_released','measurement_construction_linked','worker_contact_reveal_cancelled','appointment_waiting_customer_notice','repair_waiting_customer_notice',\n            'warranty_repair_withdrawn','repair_worker_completed','repair_appointment_recorded','repair_platform_resolved','repair_platform_closed','measurement_hold_extension_approved','measurement_hold_extension_rejected','offline_collection_adjustment_approved','offline_collection_adjustment_rejected',\n        ]);\n        $definitions = [\n            'negotiation_responded'=>['对方已响应协商',['user','worker'],'order_status','user_order_update'],\n            'repair_worker_accepted'=>['师傅已接受维修',['user'],'order_status','repair_progress'],\n            'measurement_rework_rejected'=>['师傅无法补测，可继续协商',['user'],'order_status','user_order_update'],\n            'order_ready_for_prepayment'=>['订单待支付预约费',['user'],'order_status',''],\n            'order_submitted'=>['订单待审核',['admin'],'order_status',''],\n            'order_approved'=>['审核通过，开始报价',['user'],'order_status','order_audit'],\n            'order_supplement_required'=>['请补充订单资料',['user'],'order_status','order_audit'],\n            'order_supplemented'=>['用户已补充订单资料',['admin'],'order_status',''],\n            'order_rejected'=>['订单审核未通过',['user'],'order_status','order_audit'],\n            'worker_quoted'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'worker_quote_updated'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'platform_quoted'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'quote_selected_pending_payment'=>['已选报价，待支付预约费',['user'],'order_status','payment_pending'],\n            'payment_reservation_released'=>['支付超时，订单恢复报价',['user'],'order_status',''],\n            'booking_fee_paid'=>['预约费支付成功',['user'],'payment_success','payment_success'],\n            'booking_fee_paid_upfront'=>['预约费支付成功',['user'],'payment_success','payment_success'],\n            'worker_assigned'=>['已安排施工师傅',['worker','user'],'order_status','worker_assigned'],\n            'assignment_accepted'=>['师傅已接单',['user'],'order_status','worker_assigned'],\n            'assignment_rejected'=>['师傅已拒绝派单',['user','admin'],'order_status','user_order_update'],\n            'assignment_expired'=>['派单超时已释放',['user','worker','admin'],'order_status','user_order_update'],\n            'appointment_recorded'=>['已预约上门',['user'],'order_status',''],\n            'appointment_waiting_customer_notice'=>['师傅已联系，请确认预约',['user'],'order_status',''],\n            'change_requested'=>['费用调整待确认',['user'],'order_status','fee_adjustment'],\n            'change_accepted'=>['费用调整已同意',['worker'],'order_status','worker_order_update'],\n            'change_rejected'=>['费用调整未同意',['worker'],'order_status','worker_order_update'],\n            'completion_submitted'=>['完工待验收',['user'],'order_status','completion_submitted'],\n            'completion_accepted_by_user'=>['用户已验收',['worker'],'order_status',''],\n            'auto_completion_accepted'=>['订单已自动验收',['user'],'order_status',''],