'],'order_status',''],\n            'cancel_requested'=>['订单申请退款',['user','worker','admin'],'order_status','worker_order_update'],\n            'cancel_approved'=>['取消退款已通过',['user','worker'],'order_status','refund_result'],\n            'admin_cancelled'=>['平台已取消订单',['user','worker'],'order_status','user_order_update'],\n            'cancel_rejected'=>['取消退款未通过',['user','worker'],'order_status','refund_result'],\n            'auto_cancelled_7d'=>['订单超期自动取消',['user','admin'],'order_status',''],\n            'refund_succeeded'=>['预约费退款成功',['user'],'order_status','refund_result'],\n            'worker_contact_reveal_approved'=>['师傅电话公开申请已批准',['user','worker'],'order_status','user_order_update'],\n            'worker_contact_reveal_rejected'=>['师傅电话公开申请未批准',['user'],'order_status','user_order_update'],\n            'worker_contact_reveal_cancelled'=>['师傅电话公开申请已取消',['user'],'order_status',''],\n            'offline_collection_adjustment_requested'=>['实际尾款待审批',['admin'],'order_status',''],\n            'offline_collection_adjustment_approved'=>['实际尾款已核准',['worker'],'order_status',''],\n            'offline_collection_adjustment_rejected'=>['实际尾款未核准',['worker'],'order_status',''],\n            'commission_receivable_created'=>['平台服务费待缴',['worker'],'order_status','worker_commission_due'],\n            'commission_paid'=>['平台服务费已结清',['worker'],'order_status',''],\n            'dispute_opened'=>['订单进入争议处理',['user','worker','admin'],'order_status','worker_order_update'],\n            'dispute_resolved'=>['订单争议已处理',['user','worker'],'order_status','dispute_progress'],\n            'review_submitted'=>['订单收到用户评价',['worker'],'order_status',''],\n            'run_empty_claim_submitted'=>['商家跑空费待确认',['user'],'order_status','user_order_update'],\n            'run_empty_claim_confirmed'=>['商家已确认跑空费',['worker'],'order_status','worker_order_update'],\n            'run_empty_claim_disputed'=>['跑空费进入争议处理',['user','worker','admin'],'order_status','user_order_update'],\n            'run_empty_fee_paid'=>['商家跑空费已支付',['worker'],'order_status',''],\n            'measurement_service_paid'=>['测量服务费支付成功',['user','worker'],'order_status',''],\n            'measurement_change_paid'=>['测量加费支付成功',['user','worker'],'order_status',''],\n            'measurement_change_accepted_pending_payment'=>['测量加费待付款',['user'],'order_status','payment_pending'],\n            'measurement_result_submitted'=>['测量成果待确认',['user'],'order_status','measurement_result'],\n            'measurement_rework_requested'=>['用户申请补测',['worker'],'order_status','worker_rework'],\n            'measurement_result_accepted'=>['测量成果已确认',['user','worker'],'order_status',''],\n            'measurement_auto_accepted'=>['测量成果已自动确认',['user','worker'],'order_status',''],\n            'measurement_hold_extension_approved'=>['测量冻结延期已通过',['user'],'order_status','measurement_extension'],\n            'measurement_hold_extension_rejected'=>['测量冻结延期未通过',['user'],'order_status','measurement_extension'],\n            'measurement_income_released'=>['测量费用已结算',['worker'],'order_status',''],\n            'measurement_construction_linked'=>['测量单已关联施工单',['user','worker'],'order_status',''],\n            'measurement_change_refund_created'=>['测量加费退款处理中',['user'],'order_status','user_order_update'],\n            'measurement_change_refunded'=>['测量加费退款成功',['user'],'order_status',''],\n            'measurement_late_balance_refund_created'=>['测量尾款退款处理中',['user'],'order_status','user_order_update'],\n            'measurement_late_balance_refunded'=>['测量尾款退款成功',['user'],'order_status',''],\n        ];\n        $smsRecommended = array_flip([\n            'order_supplement_required','worker_quoted','platform_quoted','change_requested',\n            'completion_submitted','measurement_result_submitted','measurement_rework_requested',\n            'warranty_repair_requested','repair_worker_rejected','supplement_deadline_reminder',\n            'commission_receivable_created','run_empty_claim_submitted',\n        ]);\n        $internalOnly = array_flip([\n            'booking_fee_paid','booking_fee_paid_upfront','measurement_service_paid','measurement_change_paid',\n            'completion_accepted_by_user','commission_estimate_created','commission_paid',\n            'repair_worker_completed','review_submitted','auto_reviewed_5d',\n            'measurement_result_accepted','measurement_auto_accepted','measurement_income_released',\n            'measurement_construction_linked','worker_contact_reveal_cancelled',\n        ]);\n        $wecomDefaults = array_flip([\n            'order_submitted','order_supplemented','assignment_rejected','assignment_expired','exceptional_arrival_reported','offline_collection_delayed','cancel_requested','auto_cancelled_7d',\n            'offline_collection_adjustment_requested','dispute_opened','run_empty_claim_disputed','worker_profile_submitted','worker_realname_submitted','merchant_auth_submitted','commission_overdue',\n            'withdrawal_submitted','worker_contact_reveal_requested','measurement_hold_extension_requested','completion_dispute_opened','repair_platform_intervention_requested','supplement_timeout_refunded',\n        ]);\n        $wecomNormalVisible = array_flip(['order_auto_preapproved','offline_collection_adjustment_auto_approved','worker_collection_code_auto_approved']);\n        $explicitWecom = array_flip(['worker_profile_submitted','worker_realname_submitted','worker_collection_code_submitted','worker_collection_code_auto_approved','merchant_auth_submitted','commission_overdue','withdrawal_submitted','worker_contact_reveal_requested','measurement_hold_extension_requested','completion_dispute_opened','repair_platform_intervention_requested','order_auto_preapproved','offline_collection_adjustment_auto_approved']);\n\n        $catalog = [];\n        foreach ($labels as $key => $label) {\n            $definition = $definitions[$key] ?? null;\n            $recipients = $definition ? $definition[1] : [];\n            $audienceLabel = in_array('user',$recipients,true) && in_array('worker',$recipients,true) ? '用户、师傅' : (in_array('worker',$recipients,true) ? '师傅' : (in_array('user',$recipients,true) ? '用户' : '管理员'));\n            $catalog[$key] = [\n                'key'=>$key,\n                'label'=>$label,\n                'priority'=>isset($normal[$key]) ? 'normal' : 'important',\n                'audience_label'=>$audienceLabel,\n                'status'=>$definition ? $definition[0] : '',\n                'recipients'=>$recipients,\n                'scene'=>$definition ? $definition[2] : '',\n                'subscription_scene'=>$definition ? $definition[3] : '',\n                'inapp_visible'=>$definition && (in_array('user',$recipients,true) || in_array('worker',$recipients,true)),\n                'internal_only'=>isset($internalOnly[$key]),\n                'sms_visible'=>$definition && (in_array('user',$recipients,true) || in_array('worker',$recipients,true)) && !isset($internalOnly[$key]),\n                'sms_default'=>isset($smsRecommended[$key]),\n                'sms_recommended'=>isset($smsRecommended[$key]),\n                'sms_delivery_mode'=>(!isset($smsRecommended[$key]) && $definition && trim((string)$definition[3])!=='')?'subscription_fallback':'independent',\n                'sms_subscription_fallback'=>!isset($smsRecommended[$key]) && $definition && trim((string)$definition[3])!=='',\n                'sms_priority'=>isset($smsRecommended[$key])?'important':'normal',\n                'wecom_visible'=>isset($explicitWecom[$key]) || in_array('admin',$recipients,true) || isset($wecomNormalVisible[$key]),\n                'wecom_default'=>isset($wecomDefaults[$key]),\n            ];\n        }\n\n        return $catalog += \\WorkerAdmin\\Domain\\Messaging\\OrderProgressMessageCatalog::all();\n    }\n\n    public static function get(string $eventType): ?array\n    {\n        $all = self::all();\n        return $all[$eventType] ?? null;\n    }\n\n    public static function switches(string $channel, array $configured): array\n    {\n        $all = self::all();\n        $visibleKey = $channel === 'wecom' ? 'wecom_visible' : ($channel === 'inapp' ? 'inapp_visible' : 'sms_visible');\n        $result = [];\n\n        foreach ($all as $eventKey => $meta) {\n            if (empty($meta[$visibleKey])) continue;\n            $saved = $configured[$eventKey] ?? null;\n            $enabled = $saved === null ? $channel === 'inapp' : filter_var(is_array($saved) ? ($saved['enabled'] ?? false) : $saved, FILTER_VALIDATE_BOOLEAN);\n            $extra = is_array($saved) ? $saved : [];\n            $extra['enabled'] = $enabled;\n            $extra['priority'] = (string) ($channel==='sms'?($meta['sms_priority']??'normal'):$meta['priority']);\n            $result[$eventKey] = $extra;\n        }\n        foreach ($configured as $eventKey => $saved) {\n            if (isset($result[$eventKey]) || isset($all[$eventKey])) continue;\n            $extra = is_array($saved) ? $saved : [];\n            $extra['enabled'] = filter_var(is_array($saved) ? ($saved['enabled'] ?? false) : $saved, FILTER_VALIDATE_BOOLEAN);\n            $extra['priority'] = isset($extra['priority']) && $extra['priority'] === 'normal' ? 'normal' : 'important';\n            $result[(string)$eventKey] = $extra;\n        }\n\n        return $result;\n    }\n\n    public static function enabled(string $channel, string $eventType, array $configured): bool\n    {\n        $switches = self::switches($channel, $configured);\n        return isset($switches[$eventType]) && !empty($switches[$eventType]['enabled']);\n    }\n}\n","server/app/Domain/Messaging/MessageOperationException.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nuse RuntimeException;\n\nfinal class MessageOperationException extends RuntimeException\n{\n    private string $apiCode;\n    public function __construct(string $message, string $apiCode, int $status = 422)\n    {\n        parent::__construct($message, $status);\n        $this->apiCode = $apiCode;\n    }\n    public function apiCode(): string { return $this->apiCode; }\n}\n","server/app/Domain/Messaging/MessageOutboxPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nuse RuntimeException;\n\nfinal class MessageOutboxPolicy\n{\n\n    /** Eligibility is checked against the row locked by the persistence operation. */\n    public static function requireDeadLetter(?array $row, string $operation): void\n    {\n        if ($row && $row['topic'] === 'aliyun_paid_sms' && $operation === 'retry') {\n            throw new RuntimeException('付费短信禁止从普通消息重试入口重新发送；仅允许用户在明确失败且费用已释放后重新发起。');\n        }\n        if (!$row || !in_array((string)$row['topic'], ['aliyun_sms','wecom_webhook','wechat_subscribe'], true)) {\n            throw new RuntimeException($operation === 'retry' ? '该消息类型不由通用消息调度器发送，请在对应业务页面处理。' : '该消息类型不支持在此结案，请在对应业务页面处理。');\n        }\n        if ($row['status'] !== 'failed' || (int)$row['attempt_count'] < 5) {\n            throw new RuntimeException($operation === 'retry' ? '仅可人工重试已达到 5 次自动重试上限的失败消息；请刷新页面确认当前状态。' : '仅可结案已达到 5 次自动重试上限的失败消息；请刷新页面确认当前状态。');\n        }\n    }\n}\n","server/app/Domain/Messaging/OrderMessageDefinition.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nfinal class OrderMessageDefinition\n{\n    public static function definition(string $type, array $payload): ?array\n    {\n        $meta = MessageEventCatalog::get($type);\n        // 管理员恢复类事件只需要订单进度触达，不自动扩入短信/模板配置目录。\n        if (!$meta && $type === 'worker_replaced_by_admin') {\n            $meta = ['status'=>'平台已改派师傅，等待新师傅确认接单','recipients'=>['user','worker'],'scene'=>'order_status'];\n        }\n        if (!$meta && $type === 'repair_platform_intervention_started') {\n            $meta = ['status'=>'平台已主动介入维修售后','recipients'=>['user','worker'],'scene'=>'order_status'];\n        }\n        if (!$meta || trim((string)($meta['status'] ?? '')) === '' || empty($meta['recipients'])) return null;\n        if (!empty($payload['assisted']) && in_array($type,['completion_submitted','measurement_result_submitted','platform_measurement_result_submitted','platform_measurement_auto_confirmed','repair_worker_completed'],true)) {\n            $meta['status']=$type==='completion_submitted' ? '管理员已补录完工，等待客户验收'\n                : ($type==='repair_worker_completed' ? '管理员已补录维修处理结果' : '管理员已补录测量成果');\n            $meta['recipients']=['user','worker'];\n        }\n        if (!empty($payload['assisted']) && in_array($type, ['appointment_recorded','appointment_waiting_customer_notice','repair_appointment_recorded','repair_waiting_customer_notice'], true)) {\n            $meta['status'] = !empty($payload['wait_customer_notice']) ? '管理员补录联系结果：等待客户另行通知' : '管理员已补录预约';\n            $meta['recipients'] = ['user','worker'];\n        }\n        $amount = null;\n        foreach (['amount_cents','requested_tail_cents','new_amount_cents','added_amount_cents','total_amount_cents','refund_amount_cents'] as $amountKey) {\n            if (isset($payload[$amountKey]) && is_numeric($payload[$amountKey])) { $amount = (int)$payload[$amountKey]; break; }\n        }\n        $recipients = (array)$meta['recipients'];\n        if (isset($payload['notify_recipients']) && is_array($payload['notify_recipients'])) {\n            $requested = array_values(array_unique(array_map('strval', $payload['notify_recipients'])));\n            $recipients = array_values(array_intersect($recipients, $requested));\n        }\n        return [\n            'scene'=>(string)($meta['scene'] ?? 'order_status'),\n            'status'=>(string)$meta['status'],\n            'recipients'=>$recipients,\n            'amount_cents'=>$amount,\n        ];\n    }\n}\n","server/app/Domain/Messaging/OrderProgressMessageCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\n/** 新订单持久化事件的纯消息目录；渠道是否启用仍由既有配置决定。 */\nfinal class OrderProgressMessageCatalog\n{\n    public static function all(): array\n    {\n        $labels = [\n            'platform_worker_quoted'=>'平台单工费报价待选择','platform_worker_quote_selected'=>'平台已选定成交师傅',\n            'platform_single_grab_accepted'=>'平台单抢单成交','platform_invite_fixed_price_accepted'=>'受邀师傅按工费成交','invite_claimed'=>'受邀师傅待接单',\n            'platform_measurement_auto_confirmed'=>'平台测量成果已确认，待核价','platform_measurement_confirmed'=>'客户确认平台测量成果',\n            'platform_measurement_pricing_reviewed'=>'平台施工核价已完成','platform_measurement_pricing_confirmed'=>'施工价格已确认，可预约',\n            'platform_change_requested'=>'平台单工费/加项待处理','platform_change_accepted'=>'客户已同意平台单加项','platform_change_rejected'=>'客户已拒绝平台单加项',\n            'platform_balance_change_approved'=>'平台工费增项已批准','platform_balance_change_rejected'=>'平台工费增项已驳回',\n            'platform_completion_accepted'=>'平台单已验收','platform_income_received'=>'平台收入款已核实','platform_pricing_quantity_adjusted'=>'实际用量与金额已更新',\n            'assignment_auto_accepted'=>'已报价师傅自动成交',\n        ];\n        $definitions = [\n            'platform_worker_quoted'=>['收到师傅工费报价，请选择成交师傅',['admin'],'order_status',''],\n            'platform_worker_quote_selected'=>['平台已选定成交师傅，请联系预约',['user','worker'],'order_status','worker_assigned'],\n            'platform_single_grab_accepted'=>['师傅已按约定工费成交',['user'],'order_status','worker_assigned'],\n            'platform_invite_fixed_price_accepted'=>['受邀师傅已按约定工费成交',['user'],'order_status','worker_assigned'],\n            'invite_claimed'=>['受邀师傅已领取订单，请确认接单',['worker'],'order_status','worker_assigned'],\n            'platform_measurement_auto_confirmed'=>['测量成果已确认，等待平台核价',['user','admin'],'order_status',''],\n            'platform_measurement_confirmed'=>['测量成果已确认，等待平台核价',['admin'],'order_status',''],\n            // 托管单核价由平台完成后立即生效；reviewed 仅保留内部审计，不再要求客户二次确认。\n            'platform_measurement_pricing_reviewed'=>['平台已完成测量后施工核价',['admin'],'order_status',''],\n            'platform_measurement_pricing_confirmed'=>['施工价格已确认，可以联系客户预约',['worker'],'order_status','worker_order_update'],\n            'platform_change_requested'=>['平台单费用调整待处理',['user','admin'],'order_status','fee_adjustment'],\n            'platform_change_accepted'=>['客户已同意订单外加项',['worker'],'order_status','worker_order_update'],\n            'platform_change_rejected'=>['客户已拒绝订单外加项',['worker'],'order_status','worker_order_update'],\n            'platform_balance_change_approved'=>['平台已批准工费增项',['worker'],'order_status','worker_order_update'],\n            'platform_balance_change_rejected'=>['平台已驳回工费增项',['worker'],'order_status','worker_order_update'],\n            'platform_completion_accepted'=>['平台单已验收，结算金额已生成',['worker'],'order_status',''],\n            'platform_income_received'=>['平台收入款已核实结清',['worker'],'order_status',''],\n            'platform_pricing_quantity_adjusted'=>['实际用量和客户金额已更新',['user'],'order_status',''],\n            'assignment_auto_accepted'=>['客户已选定您的报价，请联系预约',['worker'],'order_status','worker_order_update'],\n        ];\n        $normal = array('platform_worker_quote_selected', 'platform_single_grab_accepted', 'platform_invite_fixed_price_accepted', 'invite_claimed', 'platform_measurement_auto_confirmed', 'platform_measurement_confirmed', 'platform_completion_accepted', 'platform_income_received', 'platform_pricing_quantity_adjusted', 'assignment_auto_accepted');\n        $internal = array('platform_completion_accepted', 'platform_income_received', 'platform_pricing_quantity_adjusted', 'platform_measurement_auto_confirmed', 'platform_measurement_pricing_reviewed');\n        $catalog = [];\n        foreach ($definitions as $key=>$definition) {\n            $recipients=$definition[1]; $isInternal=in_array($key,$internal,true);\n            $fallback=$definition[3]!=='';\n            $catalog[$key]=[\n                'key'=>$key,'label'=>$labels[$key],\n                'priority'=>in_array($key,$normal,true)?'normal':'important',\n                'audience_label'=>in_array('user',$recipients,true)&&in_array('worker',$recipients,true)?'用户、师傅':(in_array('worker',$recipients,true)?'师傅':(in_array('user',$recipients,true)?'用户':'管理员')),\n                'status'=>$definition[0],'recipients'=>$recipients,'scene'=>$definition[2],'subscription_scene'=>$definition[3],\n                'inapp_visible'=>in_array('user',$recipients,true)||in_array('worker',$recipients,true),\n                'internal_only'=>$isInternal,\n                'sms_visible'=>!$isInternal&&(in_array('user',$recipients,true)||in_array('worker',$recipients,true)),\n                'sms_default'=>false,'sms_recommended'=>false,'sms_delivery_mode'=>$fallback?'subscription_fallback':'independent',\n                'sms_subscription_fallback'=>$fallback,'sms_priority'=>'normal',\n                'wecom_visible'=>in_array('admin',$recipients,true),'wecom_default'=>false,\n            ];\n        }\n        return $catalog;\n    }\n}\n","server/app/Domain/Messaging/WechatTemplateValue.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\n\n\nfinal class WechatTemplateValue\n{\n\n    public static function format(string $wechatKey,string $value):?string\n    {\n        $value=trim((string)(preg_replace('/[\\x00-\\x1F\\x7F]+/u',' ',$value)??$value));\n        if($value==='')return null;\n        $prefix=strtolower((string)(preg_replace('/\\d+$/','',$wechatKey)??''));\n        if($prefix==='thing')return mb_substr($value,0,20);\n        if($prefix==='name')return mb_substr($value,0,32);\n        if($prefix==='phrase')return mb_substr($value,0,16);\n        if($prefix==='character_string'){\n            $ascii=(string)(preg_replace('/[^A-Za-z0-9_+\\-\\.\\/]/','',$value)??'');\n            return $ascii===''?null:substr($ascii,0,64);\n        }\n        if($prefix==='number'){\n            $number=(string)(preg_replace('/[^0-9.\\-]/','',$value)??'');\n            return $number===''?null:substr($number,0,32);\n        }\n        if($prefix==='letter'){\n            $letters=(string)(preg_replace('/[^A-Za-z]/','',$value)??'');\n            return $letters===''?null:substr($letters,0,32);\n        }\n        if($prefix==='symbol'){\n            $symbols=(string)(preg_replace('/[A-Za-z0-9\\x{4e00}-\\x{9fff}\\s]/u','',$value)??'');\n            return $symbols===''?null:mb_substr($symbols,0,5);\n        }\n        if($prefix==='phone_number'){\n            $phone=(string)(preg_replace('/[^0-9+\\-]/','',$value)??'');\n            return $phone===''?null:substr($phone,0,17);\n        }\n        if($prefix==='car_number')return mb_substr($value,0,12);\n        if($prefix==='amount'){\n            $number=(string)(preg_replace('/[^0-9.]/','',$value)??'');\n            if($number===''||!preg_match('/^\\d{1,8}(?:\\.\\d{1,2})?$/',$number))return null;\n            return '¥'.$number;\n        }\n        if($prefix==='time'){\n            if(preg_match('/(?:^|\\s)([0-2]\\d:[0-5]\\d)(?::[0-5]\\d)?$/',$value,$match)===1)return (string)$match[1];\n            return preg_match('/^([0-2]\\d:[0-5]\\d)(?::[0-5]\\d)?$/',$value,$match)===1?(string)$match[1]:null;\n        }\n        if($prefix==='date'){\n            if(preg_match('/(\\d{4}-[01]\\d-[0-3]\\d)/',$value,$match)===1)return (string)$match[1];\n            return null;\n        }\n        return mb_substr($value,0,20);\n    }\n}\n","server/app/Domain/Order/CancellationRiskPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/** 2026-10-08：同单最高分、不同订单数门槛与固定七天限制；不依赖数据库或通知。 */\nfinal class CancellationRiskPolicy\n{\n    public const DEFAULTS = ['quote'=>2, 'contact'=>4, 'deal'=>5, 'complaint'=>6, 'run_empty'=>6,\n        'short_days'=>7, 'short_orders'=>2, 'short_score'=>6, 'long_days'=>30, 'long_orders'=>3, 'long_score'=>10];\n\n    public static function config(array $input): array\n    {\n        $result = self::DEFAULTS;\n        foreach ($result as $key=>$default) {\n            if (isset($input[$key]) && is_numeric($input[$key])) {\n                $max = strpos($key, 'days') !== false ? 90 : 100;\n                $minimum = strpos($key, 'orders') !== false ? 2 : 1;\n                $result[$key] = max($minimum, min($max, (int)$input[$key]));\n            }\n        }\n        $result['long_days'] = max($result['short_days'], $result['long_days']);\n        return $result;\n    }\n\n    public static function score(bool $quoted, bool $dealt, array $signals, bool $runEmpty, array $config): int\n    {\n        $points = max($quoted ? $config['quote'] : 0, $dealt ? $config['deal'] : 0, $runEmpty ? $config['run_empty'] : 0);\n        if (in_array('dialed', $signals, true) || in_array('contacted', $signals, true)) $points = max($points, $config['contact']);\n        if (in_array('complaint', $signals, true)) $points = max($points, $config['complaint']);\n        return $points;\n    }\n\n    public static function threshold(array $rows, int $now, array $config): ?array\n    {\n        foreach (['short','long'] as $window) {\n            $cutoff = $now - $config[$window.'_days'] * 86400;\n            $orders = [];\n            foreach ($rows as $row) {\n                $at = strtotime((string)$row['cancelled_at'].' UTC');\n                if ($at !== false && $at >= $cutoff && $at <= $now && (int)$row['score'] > 0) {\n                    $id = (int)$row['order_id'];\n                    $orders[$id] = max($orders[$id] ?? 0, (int)$row['score']);\n                }\n            }\n            if (count($orders) >= $config[$window.'_orders'] && array_sum($orders) >= $config[$window.'_score']) {\n                return ['window'=>$window, 'days'=>$config[$window.'_days'], 'order_count'=>count($orders),\n                    'score'=>array_sum($orders), 'order_ids'=>array_keys($orders)];\n            }\n        }\n        return null;\n    }\n}\n","server/app/Domain/Order/FulfillmentActor.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/** 领域事件的真实经办来源；协助字段只由已鉴权且重验指派的管理员用例构造。 */\nfinal class FulfillmentActor\n{\n    public static function assisted(array $actor): bool\n    {\n        return (int)($actor['user_id'] ?? 0)>0 && (int)($actor['worker_id'] ?? 0)>0\n            && (int)($actor['assistance_operator_id'] ?? 0)===(int)$actor['user_id']\n            && trim((string)($actor['assistance_assignment_id'] ?? ''))!=='';\n    }\n\n    public static function type(array $actor): string { return self::assisted($actor) ? 'mini_admin' : 'worker'; }\n    public static function id(array $actor): int { return (int)($actor[self::assisted($actor) ? 'user_id' : 'worker_id'] ?? 0); }\n\n    public static function metadata(array $actor): array\n    {\n        return !self::assisted($actor) ? [] : [\n            'assisted'=>true,'operator_channel'=>'mini_admin','operator_user_id'=>(int)$actor['user_id'],\n            'worker_id'=>(int)$actor['worker_id'],'assignment_id'=>(string)$actor['assistance_assignment_id'],\n            'occurred_at'=>(string)($actor['assistance_occurred_at'] ?? ''),\n        ];\n    }\n}\n","server/app/Domain/Order/NegotiationPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\n\n// 2026-10-08：各类异常共用升级规则；拒绝和超时只开放申请，不自动生成平台待办。\nfinal class NegotiationPolicy\n{\n    public const WAIT_HOURS = 48;\n\n    public static function evaluate(string $status, ?string $openedAt, string $timezone = 'UTC', ?DateTimeImmutable $now = null): array\n    {\n        $result = ['eligible'=>false,'reason'=>'not_active','available_at'=>null,'wait_hours'=>self::WAIT_HOURS];\n        if ($status === 'rejected') return array_merge($result, ['eligible'=>true,'reason'=>'counterparty_rejected']);\n        if (!in_array($status, ['pending','accepted_processing'], true) || !$openedAt) return $result;\n        try {\n            $zone = new DateTimeZone($timezone ?: 'UTC');\n            $available = (new DateTimeImmutable($openedAt, $zone))->modify('+'.self::WAIT_HOURS.' hours');\n            $result['available_at'] = $available->format('Y-m-d H:i:s');\n            $result['eligible'] = ($now ?: new DateTimeImmutable('now', $zone)) >= $available;\n            $result['reason'] = $result['eligible'] ? 'response_timeout' : 'waiting_counterparty';\n        } catch (Throwable $exception) {\n            $result['reason'] = 'invalid_deadline';\n        }\n        return $result;\n    }\n\n    public static function refundStatus(string $reasonCode): string\n    {\n        return ['bilateral_refund_pending'=>'pending','bilateral_refund_rejected'=>'rejected',\n            'bilateral_refund_escalated'=>'escalated','bilateral_refund_execution_required'=>'escalated'][$reasonCode] ?? '';\n    }\n\n    public static function disputeStatus(?string $resolution): string\n    {\n        return strpos((string)$resolution, '师傅拒绝异议') === 0 ? 'rejected' : 'pending';\n    }\n}\n","server/app/Domain/Order/OrderOperationException.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse RuntimeException;\nuse Throwable;\n\nfinal class OrderOperationException extends RuntimeException\n{\n    private string $apiCode;\n    /** @var array<string,mixed> */\n    private array $data;\n\n    /** @param array<string,mixed> $data */\n    public function __construct(string $message, string $apiCode, int $httpStatus = 422, array $data = [], ?Throwable $previous = null)\n    {\n        parent::__construct($message, $httpStatus, $previous);\n        $this->apiCode = $apiCode;\n        $this->data = $data;\n    }\n\n    public function apiCode(): string\n    {\n        return $this->apiCode;\n    }\n\n    /** @return array<string,mixed> */\n    public function data(): array\n    {\n        return $this->data;\n    }\n}\n","server/app/Domain/Order/PlatformOrderSettlementPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/**\n * V2.5.0 平台承接单纯金额规则。\n *\n * 不访问数据库、不读取配置、不处理 HTTP，供当前平台履约适配器以及后续统一\n * OrderFulfillment Application 复用，避免 worker_collect / platform_balance 的\n * 金额算法在多个入口各写一份。\n */\nfinal class PlatformOrderSettlementPolicy\n{\n    public const MODE_WORKER_COLLECT = 'worker_collect';\n    public const MODE_PLATFORM_BALANCE = 'platform_balance';\n\n    /**\n     * 兼容现有 extra_income_rate_bp_snapshot 单字段的规则编码。\n     * 0..10000 表示万分比；大于等于该偏移量表示“固定金额”，偏移后的值单位为分。\n     * 这样 V2.5.0 尚未正式运营时无需再拆一套加项结算表，且所有资金算法仍集中在领域层。\n     */\n    public const EXTRA_INCOME_FIXED_OFFSET = 1000000000;\n\n    /**\n     * @return array{booking_paid_cents:int,customer_tail_cents:int,platform_receivable_cents:int,worker_balance_credit_cents:int}\n     */\n    public function settlement(int $customerTotal, int $workerLabor, int $bookingPaid, string $mode): array\n    {\n        if ($customerTotal <= 0 || $workerLabor <= 0) {\n            throw new OrderOperationException('客户金额或师傅工费尚未确认', 'PLATFORM_SETTLEMENT_AMOUNT_REQUIRED', 409);\n        }\n        $this->assertMode($mode);\n\n        $bookingPaid = min($customerTotal, max(0, $bookingPaid));\n        $customerTail = max(0, $customerTotal - $bookingPaid);\n        $platformReceivable = $mode === self::MODE_PLATFORM_BALANCE\n            ? $customerTail\n            : $customerTotal - $workerLabor - $bookingPaid;\n        if ($platformReceivable < 0) {\n            throw new OrderOperationException(\n                '本单会形成负差额，请先与客户加收或处理加价后再验收',\n                'PLATFORM_SETTLEMENT_NEGATIVE',\n                409\n            );\n        }\n\n        return [\n            'booking_paid_cents' => $bookingPaid,\n            'customer_tail_cents' => $customerTail,\n            'platform_receivable_cents' => $platformReceivable,\n            'worker_balance_credit_cents' => $mode === self::MODE_PLATFORM_BALANCE ? $workerLabor : 0,\n        ];\n    }\n\n    /** @return array{platform_share_cents:int,worker_share_cents:int} */\n    public function splitExtraIncome(int $addedAmount, int $platformRuleValue): array\n    {\n        if ($addedAmount <= 0) {\n            throw new OrderOperationException('请输入正确的加价金额', 'PLATFORM_CHANGE_AMOUNT_INVALID', 422);\n        }\n\n        if ($platformRuleValue >= self::EXTRA_INCOME_FIXED_OFFSET) {\n            $fixed = max(0, $platformRuleValue - self::EXTRA_INCOME_FIXED_OFFSET);\n            if ($fixed > $addedAmount) {\n                throw new OrderOperationException('本次加项金额低于本单设置的固定平台收入，请先调整加项金额或平台收入规则', 'PLATFORM_CHANGE_BELOW_FIXED_INCOME', 422);\n            }\n            return [\n                'platform_share_cents' => $fixed,\n                'worker_share_cents' => $addedAmount - $fixed,\n            ];\n        }\n\n        $rate = max(0, min(10000, $platformRuleValue));\n        $platformShare = (int) round($addedAmount * $rate / 10000);\n        return [\n            'platform_share_cents' => $platformShare,\n            'worker_share_cents' => max(0, $addedAmount - $platformShare),\n        ];\n    }\n\n    /** @return array{available_delta_cents:int,frozen_delta_cents:int,entry_type:string} */\n    public function workerBalanceEntry(int $workerBalanceCredit, int $freezeDays): array\n    {\n        $credit = max(0, $workerBalanceCredit);\n        $days = max(0, $freezeDays);\n        return [\n            'available_delta_cents' => $days === 0 ? $credit : 0,\n            'frozen_delta_cents' => $days > 0 ? $credit : 0,\n            'entry_type' => $days === 0 ? 'platform_order_income' : 'platform_order_income_frozen',\n        ];\n    }\n\n    private function assertMode(string $mode): void\n    {\n        if (!in_array($mode, [self::MODE_WORKER_COLLECT, self::MODE_PLATFORM_BALANCE], true)) {\n            throw new OrderOperationException('平台承接单工费结算方式无效', 'PLATFORM_SETTLEMENT_MODE_INVALID', 409);\n        }\n    }\n}\n","server/app/Domain/Order/RepairInterventionPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\n\n/** 售后维修先由双方处理；师傅拒绝或超时后才允许升级平台。 */\nfinal class RepairInterventionPolicy\n{\n    public const WAIT_HOURS = 48;\n\n    /** @return array{eligible:bool,reason:string,available_at:?string,wait_hours:int} */\n    public static function evaluate(\n        string $status,\n        ?string $resolution,\n        ?string $openedAt,\n        string $timezone = 'UTC',\n        ?DateTimeImmutable $now = null\n    ): array {\n        $status = trim($status);\n        $resolution = trim((string)$resolution);\n        $openedAt = trim((string)$openedAt);\n        $result = ['eligible'=>false,'reason'=>'not_active','available_at'=>null,'wait_hours'=>self::WAIT_HOURS];\n\n        if (!in_array($status, ['open','processing'], true)) return $result;\n        if (strpos($resolution, '用户申请平台介入') === 0) {\n            $result['reason'] = 'already_escalated';\n            return $result;\n        }\n        if (strpos($resolution, '师傅拒绝维修') === 0) {\n            $result['eligible'] = true;\n            $result['reason'] = 'worker_rejected';\n            return $result;\n        }\n        if ($openedAt === '') {\n            $result['reason'] = 'opened_at_missing';\n            return $result;\n        }\n\n        try {\n            $zone = new DateTimeZone($timezone !== '' ? $timezone : 'UTC');\n            $opened = new DateTimeImmutable($openedAt, $zone);\n            $available = $opened->modify('+'.self::WAIT_HOURS.' hours');\n            $current = $now ?: new DateTimeImmutable('now', $zone);\n            $result['available_at'] = $available->format('Y-m-d H:i');\n            $result['eligible'] = $current >= $available;\n            $result['reason'] = $result['eligible'] ? 'response_timeout' : 'waiting_worker';\n            return $result;\n        } catch (Throwable $exception) {\n            $result['reason'] = 'opened_at_invalid';\n            return $result;\n        }\n    }\n}\n","server/app/Domain/Testing/TestCenterException.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Testing;\n\nuse RuntimeException;\n\nfinal class TestCenterException extends RuntimeException\n{\n    private string $businessCode;\n    private int $httpStatus;\n    /** @var array<string,mixed> */\n    private array $details;\n\n    /** @param array<string,mixed> $details */\n    public function __construct(string $message, string $businessCode = 'TEST_CENTER_ERROR', int $httpStatus = 409, array $details = [])\n    {\n        parent::__construct($message);\n        $this->businessCode = $businessCode;\n        $this->httpStatus = $httpStatus;\n        $this->details = $details;\n    }\n\n    public function businessCode(): string { return $this->businessCode; }\n    public function httpStatus(): int { return $this->httpStatus; }\n    /** @return array<string,mixed> */\n    public function details(): array { return $this->details; }\n}\n","server/app/Foundation/TestCenterComposition.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Foundation;\n\nuse WorkerAdmin\\Application\\Testing\\TestCenter;\nuse WorkerAdmin\\Application\\Testing\\TestScenarioCatalog;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseTestCenterRepository;\nuse WorkerAdmin\\Infrastructure\\Security\\GlobalPrivateValueCipher;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterActionSafetyRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFailureReplay;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterReplayCaptureRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSchedulerInspector;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSchedulerActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMessageSimulationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMessageProviderFailureActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterPaidSmsReceiptActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAdminAdjudicationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAdminAdjudicationVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoReviewVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoReviewCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoCancelVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundRetryVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSupplementTimeoutVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSupplementTimeoutCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoCancelCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAdminRefundReplayRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterCleanupGuardRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterCleanupSafetyRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterDisputeFinanceActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterDisputeFinanceCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterDisputeFinanceVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFulfillmentActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFulfillmentCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFulfillmentVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterM1Repository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegativeQuoteRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegotiationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegotiationCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegotiationVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterProgressVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRepairActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRepairCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRepairVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSingleGrabActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSingleGrabVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterPlatformMeasurementRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterPlatformMeasurementActionRunner;\n\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterProxyOrderActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterProxyOrderRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterInvitationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterInvitationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementTailActionRunner;\n\nfinal class TestCenterComposition\n{\n    public static function entrySessions(Database $db): \\WorkerAdmin\\Contracts\\TestCenterEntryGateway\n    {\n        return new \\WorkerAdmin\\Infrastructure\\Testing\\TestCenterEntrySession($db);\n    }\n\n    public static function build(Database $db): TestCenter\n    {\n        $cipher=new GlobalPrivateValueCipher();\n        $base=new DatabaseTestCenterRepository($db,$cipher);\n        $m1=new DatabaseTestCenterM1Repository($db,$cipher,$base);\n        $measurementBase=new DatabaseTestCenterMeasurementRepository($db,$cipher,$m1);\n        $negative=new DatabaseTestCenterNegativeQuoteRepository($db,$measurementBase);\n        $dealProgress=new DatabaseTestCenterProgressVerificationRepository($db,$negative);\n        $singleGrabProgress=new DatabaseTestCenterSingleGrabVerificationRepository($db,$dealProgress);\n        $measurementProgress=new DatabaseTestCenterMeasurementVerificationRepository($db,$singleGrabProgress);\n        $fulfillmentProgress=new DatabaseTestCenterFulfillmentVerificationRepository($db,$measurementProgress);\n        $negotiationProgress=new DatabaseTestCenterNegotiationVerificationRepository($db,$fulfillmentProgress);\n        $refundProgress=new DatabaseTestCenterRefundVerificationRepository($db,$negotiationProgress);\n        $repairProgress=new DatabaseTestCenterRepairVerificationRepository($db,$refundProgress);\n        $adminProgress=new DatabaseTestCenterAdminAdjudicationVerificationRepository($db,$repairProgress);\n        $financeProgress=new DatabaseTestCenterDisputeFinanceVerificationRepository($db,$adminProgress);\n        $autoReviewProgress=new DatabaseTestCenterAutoReviewVerificationRepository($db,$financeProgress);\n        $autoCancelProgress=new DatabaseTestCenterAutoCancelVerificationRepository($db,$autoReviewProgress);\n        $refundRetryProgress=new DatabaseTestCenterRefundRetryVerificationRepository($db,$autoCancelProgress);\n        $supplementTimeoutProgress=new DatabaseTestCenterSupplementTimeoutVerificationRepository($db,$refundRetryProgress);\n        $financeCleanup=new DatabaseTestCenterDisputeFinanceCleanupRepository($db,$supplementTimeoutProgress);\n        $fulfillmentCleanup=new DatabaseTestCenterFulfillmentCleanupRepository($db,$financeCleanup);\n        $negotiationCleanup=new DatabaseTestCenterNegotiationCleanupRepository($db,$fulfillmentCleanup);\n        $refundCleanup=new DatabaseTestCenterRefundCleanupRepository($db,$negotiationCleanup);\n        $repairCleanup=new DatabaseTestCenterRepairCleanupRepository($db,$refundCleanup);\n        $measurementCleanup=new DatabaseTestCenterMeasurementCleanupRepository($db,$repairCleanup);\n        $platformMeasurement=new DatabaseTestCenterPlatformMeasurementRepository($db,$measurementCleanup);\n        $proxyFactory=new DatabaseTestCenterProxyOrderActionRunner($db,new DatabaseTestCenterActionRunner($db));\n        $proxyRepository=new DatabaseTestCenterProxyOrderRepository($db,$platformMeasurement,$proxyFactory);\n        $invitationRepository=new DatabaseTestCenterInvitationRepository($db,$proxyRepository);\n        $autoReviewCleanup=new DatabaseTestCenterAutoReviewCleanupRepository($db,$invitationRepository);\n        $autoCancelCleanup=new DatabaseTestCenterAutoCancelCleanupRepository($db,$autoReviewCleanup);\n        $supplementTimeoutCleanup=new DatabaseTestCenterSupplementTimeoutCleanupRepository($db,$autoCancelCleanup);\n        $cleanupGuard=new DatabaseTestCenterCleanupGuardRepository($db,$supplementTimeoutCleanup);\n        $repository=new DatabaseTestCenterCleanupSafetyRepository($db,$cleanupGuard);\n\n        $dealActions=new DatabaseTestCenterActionRunner($db);\n        $singleGrabActions=new DatabaseTestCenterSingleGrabActionRunner($db,$dealActions);\n        $measurementActions=new DatabaseTestCenterMeasurementActionRunner($db,$singleGrabActions);\n        $fulfillmentActions=new DatabaseTestCenterFulfillmentActionRunner($db,$measurementActions);\n        $negotiationActions=new DatabaseTestCenterNegotiationActionRunner($db,$fulfillmentActions);\n        $refundActions=new DatabaseTestCenterRefundActionRunner($db,$negotiationActions);\n        $repairActions=new DatabaseTestCenterRepairActionRunner($db,$refundActions);\n        $adminActions=new DatabaseTestCenterAdminAdjudicationActionRunner($db,$repairActions);\n        $financeActions=new DatabaseTestCenterDisputeFinanceActionRunner($db,$adminActions);\n        $adminReplayActions=new DatabaseTestCenterAdminRefundReplayRunner($db,$financeActions);\n        $platformActions=new DatabaseTestCenterPlatformMeasurementActionRunner($db,$adminReplayActions);\n        $proxyActions=new DatabaseTestCenterProxyOrderActionRunner($db,$platformActions);\n        $invitationActions=new DatabaseTestCenterInvitationActionRunner($db,$proxyActions,$repository);\n        $tailActions=new DatabaseTestCenterMeasurementTailActionRunner($db,$invitationActions,$repository);\n        $schedulerActions=new DatabaseTestCenterSchedulerActionRunner($db,$tailActions);\n        $messageSimulationActions=new DatabaseTestCenterMessageSimulationActionRunner($db,$schedulerActions);\n        $messageProviderActions=new DatabaseTestCenterMessageProviderFailureActionRunner($db,$messageSimulationActions);\n        $paidSmsReceiptActions=new DatabaseTestCenterPaidSmsReceiptActionRunner($db,$messageProviderActions);\n        $captureActions=new DatabaseTestCenterReplayCaptureRunner($db,new \\WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterChatActionRunner($db,$paidSmsReceiptActions));\n        $actions=new DatabaseTestCenterActionSafetyRunner($db,$captureActions);\n        $failureReplay=new DatabaseTestCenterFailureReplay($db,$actions);\n        $schedulerInspector=new DatabaseTestCenterSchedulerInspector($db);\n        return new TestCenter($repository,new TestScenarioCatalog(),$actions,$failureReplay,$schedulerInspector);\n    }\n}\n\n","server/app/Http/Admin/AdminKernel.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AdminAccountAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ChatCredentialAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ChatImageReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AgreedRefundExecutionAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AgreementAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AuditAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ContactRevealReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\DisputeReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ExceptionDashboardAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\FailedRefundRecoveryAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\FinanceAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\HelpCenterAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\MeasurementHoldReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\PlatformOrderAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\PlatformOrderFinanceAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RealNameAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderCancellationRiskAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RefundReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RepairInterventionAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\SchedulerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\MessageOutboxAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RuntimeLogAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ConfigurationSettingsAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ServiceCategoryAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderFormDesignerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\TestCenterAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\UserMerchantAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\WorkerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\LegacyAdminModule;\n\n/** 后台模块组合根。 */\nfinal class AdminKernel\n{\n    /** @var AdminModule[] */\n    private array $modules;\n    private AdminRequestGuard $guard;\n\n    /** @param AdminModule[]|null $modules */\n    public function __construct(Database $db, Auth $auth, Csrf $csrf, ?array $modules = null)\n    {\n        $this->guard = new AdminRequestGuard($auth, $csrf);\n        $this->modules = $modules ?: [\n            new AdminAccountAdminModule($db, $auth, $csrf),\n            new ChatCredentialAdminModule($db, $auth, $csrf),\n            new ChatImageReviewAdminModule($db, $auth, $csrf),\n            new \\WorkerAdmin\\Http\\Admin\\Modules\\ChatAVReviewAdminModule($db,$auth,$csrf),\n            new \\WorkerAdmin\\Http\\Admin\\Modules\\ChatStorageAdminModule($db,$auth,$csrf),\n            new \\WorkerAdmin\\Http\\Admin\\Modules\\ChatGovernanceAdminModule($db,$auth,$csrf),\n            new ExceptionDashboardAdminModule($db, $auth, $csrf),\n            new RefundReviewAdminModule($db, $auth, $csrf),\n            new DisputeReviewAdminModule($db, $auth, $csrf),\n            new AuditAdminModule($db, $auth, $csrf),\n            new ContactRevealReviewAdminModule($db, $auth, $csrf),\n            new MeasurementHoldReviewAdminModule($db, $auth, $csrf),\n            new RepairInterventionAdminModule($db, $auth, $csrf),\n            new AgreementAdminModule($db, $auth, $csrf),\n            new HelpCenterAdminModule($db, $auth, $csrf),\n            new RealNameAdminModule($db, $auth, $csrf),\n            new OrderCancellationRiskAdminModule($db, $auth, $csrf),\n            new SchedulerAdminModule($db, $auth, $csrf),\n            new AgreedRefundExecutionAdminModule($db, $auth, $csrf),\n            new FailedRefundRecoveryAdminModule($db, $auth, $csrf),\n            new PlatformOrderFinanceAdminModule($db, $auth, $csrf),\n            new PlatformOrderAdminModule($db, $auth, $csrf),\n            new MessageOutboxAdminModule($db, $auth, $csrf),\n            new RuntimeLogAdminModule($db, $auth, $csrf),\n            new TestCenterAdminModule($db, $auth, $csrf),\n            new ConfigurationSettingsAdminModule($db,$auth,$csrf),\n            new ServiceCategoryAdminModule($db,$auth,$csrf),\n            new OrderFormDesignerAdminModule($db,$auth,$csrf),\n            new UserMerchantAdminModule($db,$auth,$csrf),\n            new ReviewAdminModule($db,$auth,$csrf),\n            new WorkerAdminModule($db,$auth,$csrf),\n            // 最后一块旧网页订单路由由正式模块接管；Legacy 只保留 staged 旧 handler 的物理代码。\n            new OrderAdminModule($db,$auth,$csrf),\n            new FinanceAdminModule($db,$auth,$csrf),\n            new LegacyAdminModule($db, $auth, $csrf),\n        ];\n    }\n\n    public function dispatch(string $route): void\n    {\n        try {\n            $this->guard->inspect($route);\n        } catch (RuntimeException $exception) {\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) === 'POST') {\n                \\flash('danger', $exception->getMessage());\n                \\redirect(\\admin_url('dashboard'));\n            }\n            throw $exception;\n        }\n        foreach ($this->modules as $module) {\n            if (!$module instanceof AdminModule || !$module->supports($route)) continue;\n            $module->dispatch($route);\n            return;\n        }\n        throw new RuntimeException('后台路由不存在');\n    }\n}\n","server/app/Http/Admin/AdminRequestGuard.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\n\nfinal class AdminRequestGuard\n{\n    private Auth $auth;\n    private Csrf $csrf;\n\n    public function __construct(Auth $auth, Csrf $csrf)\n    {\n        $this->auth = $auth;\n        $this->csrf = $csrf;\n    }\n\n    public function inspect(string $route): void\n    {\n        if ($route === 'chat.credentials') {\n            $status = 0;\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {\n                header('Allow: POST'); $status = 405;\n            } elseif (!$this->auth->check()) { $status = 401;\n            } elseif (!empty($this->auth->user()['must_change_password'])) { $status = 403;\n            } else {\n                try { $this->csrf->verifyRequest(); } catch (\\RuntimeException $error) { $status = 403; }\n            }\n            if ($status) \\json_response(['ok'=>false,'code'=>$status===401?'CHAT_UNAUTHORIZED':($status===405?'CHAT_METHOD_NOT_ALLOWED':'CHAT_FORBIDDEN'),\n                'message'=>'请刷新页面后重试','retryable'=>false,'request_id'=>\\request_id(),'server_time'=>gmdate('Y-m-d\\TH:i:s\\Z')],$status);\n            return;\n        }\n        if ($route === 'login') return;\n        $this->auth->requireLogin();\n        $user = $this->auth->user();\n        if (!empty($user['must_change_password']) && !in_array($route, ['profile','profile.password','logout'], true)) {\n            \\flash('warning', '首次登录必须先修改演示密码。');\n            \\redirect(\\admin_url('profile'));\n        }\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) === 'POST') {\n            $this->csrf->verifyRequest();\n        }\n    }\n}\n\n","server/app/Http/Admin/Modules/ChatAVReviewAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n\n/** PHP provides an authorized page only. All review state is owned by Go. */\nfinal class ChatAVReviewAdminModule implements AdminModule\n{\n    private Auth $auth;\n    public function __construct(Database $db, Auth $auth, Csrf $csrf) { $this->auth = $auth; }\n    public function supports(string $route): bool { return $route === 'chat.av-review'; }\n    public function dispatch(string $route): void\n    {\n        $this->auth->requirePermission('chat.media.review');\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'GET') {\n            http_response_code(405); throw new \\RuntimeException('该页面只接受 GET 请求。');\n        }\n        echo \\view('admin/chat-av-review', ['pageTitle'=>'聊天音视频预审','activeMenu'=>'chat.av-review']);\n    }\n}\n","server/app/Http/Admin/Modules/ChatGovernanceAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n/** PHP owns page/identity grants only; every chat-governance mutation uses Go. */\nfinal class ChatGovernanceAdminModule implements AdminModule\n{\n    private Database $db;private Auth $auth;\n    public function __construct(Database $db,Auth $auth,Csrf $csrf){$this->db=$db;$this->auth=$auth;}\n    public function supports(string $route):bool{return in_array($route,['chat.governance','chat.auditors'],true);}\n    public function dispatch(string $route):void\n    {\n        $this->auth->requirePermission($route==='chat.auditors'?'chat.audit.grants':'audit.view');\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));\n        if($route==='chat.auditors'&&$method==='POST'){\n            $id=trim((string)($_POST['user_id']??''));$reason=trim((string)($_POST['reason']??''));$enabled=(string)($_POST['enabled']??'')==='1';\n            if(preg_match('/^[1-9][0-9]{0,19}$/D',$id)!==1||mb_strlen($reason)<2||mb_strlen($reason)>200||!$this->db->fetchValue(\"SELECT id FROM users WHERE id=:id AND status='active'\",['id'=>$id]))throw new RuntimeException('请填写真实用户编号和授权理由');\n            $admin=(string)$this->auth->user()['id'];$version=bin2hex(random_bytes(32));\n            $this->db->transaction(function()use($id,$reason,$enabled,$admin,$version):void{\n                $this->db->execute('INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE enabled=VALUES(enabled),authority_version=VALUES(authority_version),granted_by=VALUES(granted_by),reason=VALUES(reason),updated_at=VALUES(updated_at)',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n                $this->db->execute('INSERT INTO chat_auditor_grant_audit(user_id,enabled,authority_version,admin_id,reason,created_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6))',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n            });\n            \\flash('success','会话抽检授权已更新');\\redirect(\\admin_url('chat.auditors'));return;\n        }\n        if($method!=='GET'){http_response_code(405);throw new RuntimeException('请求方式不正确');}\n        $grants=$route==='chat.auditors'?$this->db->fetchAll('SELECT user_id,enabled,granted_by,reason,updated_at FROM chat_mini_auditors ORDER BY updated_at DESC,user_id DESC LIMIT 50'):[];\n        echo \\view('admin/chat-governance',['pageTitle'=>$route==='chat.auditors'?'小程序抽检授权':'聊天抽检与治理','activeMenu'=>$route,'grants'=>$grants,'grantPage'=>$route==='chat.auditors',\n            'canModerate'=>$this->auth->can('users.manage'),'canEvidence'=>$this->auth->can('chat.evidence.view')]);\n    }\n}\n","server/app/Http/Admin/Modules/ChatImageReviewAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n\n/** PHP provides an authorized page only. All review state is owned by Go. */\nfinal class ChatImageReviewAdminModule implements AdminModule\n{\n    private Auth $auth;\n    public function __construct(Database $db, Auth $auth, Csrf $csrf) { $this->auth = $auth; }\n    public function supports(string $route): bool { return $route === 'chat.image-review'; }\n    public function dispatch(string $route): void\n    {\n        $this->auth->requirePermission('chat.images.review');\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'GET') {\n            http_response_code(405); throw new \\RuntimeException('该页面只接受 GET 请求。');\n        }\n        echo \\view('admin/chat-image-review', ['pageTitle'=>'聊天图片预审','activeMenu'=>'chat.image-review']);\n    }\n}\n","server/app/Http/Admin/Modules/ChatStorageAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Application\\Chat\\ChatStorageSettings;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n\nfinal class ChatStorageAdminModule implements AdminModule\n{\n    private Auth $auth;private Csrf $csrf;private ChatStorageSettings $settings;\n    public function __construct(Database $db,Auth $auth,Csrf $csrf)\n    { $this->auth=$auth;$this->csrf=$csrf;$this->settings=new ChatStorageSettings($db,(string)\\app_config('app.key','')); }\n    public function supports(string $route):bool { return $route==='chat.storage'; }\n    public function dispatch(string $route):void\n    {\n        $this->auth->requirePermission('settings.manage');\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));\n        if(!in_array($method,['GET','POST'],true)){http_response_code(405);throw new RuntimeException('请求方式不正确');}\n        $preview=null;$notice='';\n        try{\n            if($method==='POST'){\n                $this->csrf->verifyRequest();$admin=$this->auth->user();$action=$_POST['_action']??'';\n                if($action==='preview')$preview=$this->settings->preview($_POST,(int)$admin['id']);\n                elseif($action==='save'){\n                    $this->settings->save($_POST,(int)$admin['id'],(string)$admin['role']);\n                    \\flash('success','聊天保存设置已更新；历史应用按预览范围分批处理');\\redirect(\\admin_url('chat.storage'));return;\n                }else throw new RuntimeException('请先预览设置');\n            }\n        }catch(RuntimeException $error){$notice=$error->getMessage();}\n        catch(Throwable $error){$notice='暂时无法读取或保存聊天设置，请稍后重试';}\n        $current=$this->settings->current();\n        echo \\view('admin/chat-storage',['pageTitle'=>'聊天存储与保存期','activeMenu'=>'chat.storage','current'=>$current,'policy'=>$preview['policy']??$current['policy'],'preview'=>$preview,'notice'=>$notice]);\n    }\n}\n","server/app/Http/Admin/Modules/TestCenterAdminModule.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse Throwable;\nuse WorkerAdmin\\Application\\Testing\\TestCenter;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Testing\\TestCenterException;\nuse WorkerAdmin\\Foundation\\TestCenterComposition;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\nuse WorkerAdmin\\Contracts\\TestCenterEntryGateway;\n\nfinal class TestCenterAdminModule implements AdminModule\n{\n    private Auth $auth;\n    private Csrf $csrf;\n    private TestCenter $testCenter;\n    private TestCenterEntryGateway $testEntry;\n\n    public function __construct(Database $db, Auth $auth, Csrf $csrf)\n    {\n        $this->auth=$auth;$this->csrf=$csrf;$this->testCenter=TestCenterComposition::build($db);$this->testEntry=TestCenterComposition::entrySessions($db);\n    }\n\n    public function supports(string $route): bool{return$route==='test-center'||strpos($route,'test-center.')===0;}\n\n    public function dispatch(string $route): void\n    {\n        $this->auth->requireLogin();$admin=$this->auth->user();\n        if(!empty($admin['must_change_password'])){\\flash('warning','首次登录必须先修改演示密码。');\\redirect(\\admin_url('profile'));}\n        $this->auth->requirePermission('settings.manage');\n        if(($admin['role']??'')!=='super_admin'){http_response_code(403);echo \\view('errors/403',['pageTitle'=>'无权访问测试中心']);return;}\n        $allowed=['test-center','test-center.detail','test-center.create','test-center.verify','test-center.action','test-center.replay-failure','test-center.copy','test-center.rebuild','test-center.cleanup','test-center.batch-cleanup','test-center.batch-cleanup.execute','test-center.entry-token'];\n        if(!in_array($route,$allowed,true)){http_response_code(404);echo \\view('errors/404',['pageTitle'=>'页面不存在']);return;}\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));if($method==='POST')$this->csrf->verifyRequest();$adminId=(int)($admin['id']??0);\n        try{\n            if($route==='test-center'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $filters=['q'=>trim((string)($_GET['q']??'')),'status'=>trim((string)($_GET['status']??'')),'scenario'=>trim((string)($_GET['scenario']??''))];\n                $data=$this->testCenter->dashboard($filters);$requestKeys=[];\n                foreach((array)($data['scenarios']??[])as$scenario){$key=(string)($scenario['key']??'');if($key!=='')$requestKeys[$key]='create:'.bin2hex(random_bytes(12));}\n                echo \\view('admin/test-center',array_merge($data,['pageTitle'=>'测试中心','activeMenu'=>'test-center','filters'=>$filters,'requestKeys'=>$requestKeys]));return;\n            }\n            if($route==='test-center.detail'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $id=trim((string)($_GET['id']??''));$detail=$this->testCenter->detail($id);$detail['entry_tokens']=$this->testEntry->options($id);$actionRequestKeys=[];$failureReplayRequestKeys=[];\n                foreach((array)($detail['actions']['items']??[])as$key=>$action){$actionKey=(string)($action['key']??$key);if($actionKey!=='')$actionRequestKeys[$actionKey]='action:'.bin2hex(random_bytes(12));}\n                foreach((array)($detail['failure_replays']['items']??[])as$item){$runId=(string)($item['run_public_id']??'');if($runId!==''&&!empty($item['replayable']))$failureReplayRequestKeys[$runId]='failure-replay:'.bin2hex(random_bytes(12));}\n                echo \\view('admin/test-center-detail-v260',['pageTitle'=>'测试订单详情','activeMenu'=>'test-center','detail'=>$detail,'copyRequestKey'=>'copy:'.bin2hex(random_bytes(12)),'rebuildRequestKey'=>'rebuild:'.bin2hex(random_bytes(12)),'actionRequestKeys'=>$actionRequestKeys,'failureReplayRequestKeys'=>$failureReplayRequestKeys]);return;\n            }\n            if($route==='test-center.batch-cleanup'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $batch=trim((string)($_GET['batch']??''));$preview=$this->testCenter->batchCleanupPreview($batch);\n                echo \\view('admin/test-center-batch-cleanup',['pageTitle'=>'测试批次清理','activeMenu'=>'test-center','preview'=>$preview]);return;\n            }\n            if($method!=='POST')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n            if($route==='test-center.create'){\n                $result=$this->testCenter->create($_POST,$adminId);$id=(string)($result['instance']['public_id']??'');\n                \\audit('test_center.create','test_instance',(int)($result['instance']['id']??0),'创建测试场景 '.(string)($result['instance']['scenario_key']??''));\\flash('success','测试场景已生成并完成结构检查。');\\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.entry-token'){\n                $id=trim((string)($_POST['id']??''));\n                $entry=$this->testEntry->issue(\n                    $id,\n                    (string)($_POST['role']??''),\n                    (string)($_POST['worker_slot']??''),\n                    (int)($_POST['ttl_minutes']??10),\n                    $adminId\n                );\n                \\audit('test_center.entry_issue','test_instance',0,'生成测试中心短期小程序入口，实例 '.$id.'，角色 '.(string)$entry['actor_role'],[\n                    'entry_public_id'=>(string)$entry['public_id'],'worker_slot'=>$entry['worker_slot'],'expires_at'=>(string)$entry['expires_at'],\n                ]);\n                echo \\view('admin/test-center-entry-token',['pageTitle'=>'短期小程序测试入口','activeMenu'=>'test-center','entry'=>$entry]);\n                return;\n            }\n            if($route==='test-center.batch-cleanup.execute'){\n                $batch=trim((string)($_POST['batch']??''));$result=$this->testCenter->cleanupBatch($batch,$adminId,trim((string)($_POST['plan_digest']??'')));\n                \\audit('test_center.batch_cleanup','test_batch',0,'清理测试批次 '.$batch.'；成功 '.(int)$result['succeeded'].'，失败 '.(int)$result['failed']);\n                \\flash(!empty($result['complete'])?'success':'warning','批次清理完成：成功 '.(int)$result['succeeded'].'，失败 '.(int)$result['failed'].'。');\n                \\redirect(\\admin_url('test-center'));\n            }\n            $id=trim((string)($_POST['id']??''));\n            if($route==='test-center.action'){\n                $action=trim((string)($_POST['action_key']??''));$result=$this->testCenter->runAction($id,$_POST,$adminId);$mode=(string)($result['operation_mode']??'real_service');\n                \\audit('test_center.action','test_instance',0,'执行测试动作 '.$action.'，mode='.$mode.'，实例 '.$id.'，run '.(string)($result['run_public_id']??''));\n                if(!empty($result['replayed']))$message='该测试动作此前已成功执行，本次返回幂等结果。';\n                elseif($mode==='isolated_regression')$message=!empty($result['regression_passed'])?'隔离聊天回归通过，已登记指定源码与实例的签名结果；真机和真实渠道需分别验收。':'隔离聊天回归未通过，已记录失败结果，请查看执行记录。';\n                elseif($mode==='isolated_fixture')$message='隔离聊天夹具已准备，尚未执行聊天回归；请查看本次执行记录。';\n                elseif($mode==='real_service')$message='真实业务动作执行成功，订单/售后状态已按正式流程推进。';\n                elseif($mode==='time_fixture')$message='测试时间条件已推进；该步骤不计作真实业务动作。';\n                else $message='测试前置条件已补齐；该步骤不计作真实业务动作。';\n                \\flash(($result['result']??'')==='failed'?'warning':'success',$message);\\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.replay-failure'){\n                $sourceRun=trim((string)($_POST['run_id']??''));$requestKey=trim((string)($_POST['request_key']??''));\n                $result=$this->testCenter->replayFailure($id,$sourceRun,$adminId,$requestKey);\n                \\audit('test_center.failure_replay','test_instance',0,'重放失败测试动作，实例 '.$id.'，来源 run '.$sourceRun.'，新 run '.(string)($result['run_public_id']??''));\n                \\flash('success',!empty($result['replayed'])?'该失败动作已经按同一复现请求执行过，本次返回幂等结果。':'失败动作已使用原安全参数重新执行。');\n                \\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.verify'){$result=$this->testCenter->verify($id,$adminId);\\flash($result['failed']>0?'danger':'success',$result['failed']>0?'检查发现失败断言，请查看详情。':'测试实例检查通过。');\\redirect(\\admin_url('test-center.detail',['id'=>$id]));}\n            if($route==='test-center.copy'){$result=$this->testCenter->copy($id,$adminId,(string)($_POST['request_key']??''));$newId=(string)($result['instance']['public_id']??'');\\audit('test_center.copy','test_instance',(int)($result['instance']['id']??0),'复制测试场景，来源 '.$id);\\flash('success','已复制为新的测试实例。');\\redirect(\\admin_url('test-center.detail',['id'=>$newId]));}\n            if($route==='test-center.rebuild'){$result=$this->testCenter->rebuild($id,$adminId,(string)($_POST['request_key']??''));$newId=(string)($result['instance']['public_id']??'');\\audit('test_center.rebuild','test_instance',(int)($result['instance']['id']??0),'重建测试场景，来源 '.$id);\\flash('success','已按原场景参数重建新实例，旧实例和报告保留。');\\redirect(\\admin_url('test-center.detail',['id'=>$newId]));}\n            if($route==='test-center.cleanup'){$result=$this->testCenter->cleanup($id,$adminId,trim((string)($_POST['plan_digest']??'')));\\flash('success','测试业务数据已清理，实例留档与检查记录继续保留。');\\redirect(\\admin_url('test-center.detail',['id'=>(string)($result['public_id']??$id)]));}\n        }catch(TestCenterException $exception){\n            \\flash('danger',$exception->getMessage().'（'.$exception->businessCode().'）');\n            if($method==='GET')\\redirect(\\admin_url('test-center'));\n            $batch=trim((string)($_POST['batch']??''));if($batch!=='')\\redirect(\\admin_url('test-center.batch-cleanup',['batch'=>$batch]));\n            $id=trim((string)($_POST['id']??''));\\redirect($id!==''?\\admin_url('test-center.detail',['id'=>$id]):\\admin_url('test-center'));\n        }catch(Throwable $exception){\n            $requestId=\\request_id();\\write_log('test-center','['.date('c').'] request_id='.$requestId.' '.$exception.\"\\n\");\\flash('danger','测试中心处理失败，请查看运行日志。请求编号：'.$requestId);\n            if($method==='GET')\\redirect(\\admin_url('test-center'));\n            $batch=trim((string)($_POST['batch']??''));if($batch!=='')\\redirect(\\admin_url('test-center.batch-cleanup',['batch'=>$batch]));\n            $id=trim((string)($_POST['id']??''));\\redirect($id!==''?\\admin_url('test-center.detail',['id'=>$id]):\\admin_url('test-center'));\n        }\n    }\n}\n","server/app/Http/Api/Modules/ChatCredentialApiModule.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Api\\Modules;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Application\\Chat\\ChatCredentialIssuer;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Api\\ApiModule;\n\nfinal class ChatCredentialApiModule implements ApiModule\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function supports(string $route): bool { return in_array($route,['chat.credentials','chat.audit.credentials'],true); }\n    public function requiresContentSecurity(string $route): bool { return false; }\n    public function dispatch(string $route): void\n    {\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {\n            header('Allow: POST');\n            $this->fail('请求方式不正确', 'CHAT_METHOD_NOT_ALLOWED', 405);\n        }\n        $authorization = (string)($_SERVER['HTTP_AUTHORIZATION'] ?? '');\n        if (preg_match('/^Bearer ([A-Fa-f0-9]{64})$/D', $authorization, $match) !== 1) $this->fail('请重新登录', 'CHAT_UNAUTHORIZED', 401);\n        try {\n            $issuer = new ChatCredentialIssuer($this->db, (array)\\app_config('chat', []), (string)\\app_config('app.env', 'production'));\n            \\json_response(['ok'=>true,'data'=>$issuer->exchangeMini($match[1],$route==='chat.audit.credentials')]);\n        } catch (Throwable $exception) {\n            // Deliberately don't pass the exception/SQL/token to the global API logger.\n            $status = $exception instanceof RuntimeException && in_array($exception->getCode(),[401,403],true) ? $exception->getCode() : 503;\n            $this->fail($status === 401 ? '登录状态已失效，请重新进入' : '聊天身份暂不可用，请稍后重试',\n                $status === 401 ? 'CHAT_UNAUTHORIZED' : ($status===403?'CHAT_FORBIDDEN':'CHAT_DEPENDENCY_UNAVAILABLE'), $status);\n        }\n    }\n    private function fail(string $message, string $code, int $status): void\n    {\n        \\json_response(['ok'=>false,'code'=>$code,'message'=>$message,'request_id'=>\\request_id(),\n            'retryable'=>$status === 503,'server_time'=>gmdate('Y-m-d\\TH:i:s\\Z')], $status);\n    }\n}\n","server/app/Http/Api/Modules/MessagingApiModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Api\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Api\\ApiModule;\nuse WorkerAdmin\\Foundation\\ApplicationContainer;\nuse WorkerAdmin\\Foundation\\MessagingApplicationContainer;\nuse WorkerAdmin\\Application\\Identity\\ApiActorResolver;\nuse WorkerAdmin\\Application\\Messaging\\NotificationInbox;\nuse WorkerAdmin\\Application\\Messaging\\SubscriptionPreferences;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOperationException;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n/** Subscription settings and the signed-in actor's notification inbox. */\nfinal class MessagingApiModule implements ApiModule\n{\n    private const ROUTES = [\n        'announcement.current'=>'GET',\n        'subscriptions.status'=>'GET', 'subscriptions.diagnose'=>'GET', 'subscriptions.preference'=>'POST',\n        'notifications.threads'=>'GET','notifications.thread_messages'=>'GET','notifications.summary'=>'GET', 'notifications.list'=>'GET', 'notifications.read'=>'POST',\n        'notifications.read_batch'=>'POST', 'notifications.read_all'=>'POST',\n    ];\n    private \\WorkerAdmin\\Application\\Messaging\\AnnouncementQuery $announcement;\n    private ApiActorResolver $actors;\n    private NotificationInbox $inbox;\n    private SubscriptionPreferences $subscriptions;\n    public function __construct(Database $db, ?ApiActorResolver $actors=null, ?NotificationInbox $inbox=null, ?SubscriptionPreferences $subscriptions=null)\n    {\n        $container = new MessagingApplicationContainer($db);\n        $this->announcement=new \\WorkerAdmin\\Application\\Messaging\\AnnouncementQuery((new ApplicationContainer($db))->settings());\n        $this->actors = $actors ?: (new ApplicationContainer($db))->apiActorResolver();\n        $this->inbox = $inbox ?: $container->inbox();\n        $this->subscriptions = $subscriptions ?: $container->subscriptions();\n    }\n    public function supports(string $route): bool { return isset(self::ROUTES[$route]); }\n    public function requiresContentSecurity(string $route): bool { return false; }\n    public function dispatch(string $route): void\n    {\n        if (!$this->supports($route)) { $this->fail('接口不存在', 'NOT_FOUND', 404); return; }\n        $header = trim((string)($_SERVER['HTTP_AUTHORIZATION'] ?? ''));\n        if ($header === '' && function_exists('getallheaders')) {\n            $headers = getallheaders();\n            $header = trim((string)($headers['Authorization'] ?? $headers['authorization'] ?? ''));\n        }\n        if (preg_match('/^Bearer\\s+([A-Fa-f0-9]{64})$/', $header, $matches) !== 1) { $this->fail('请重新登录','UNAUTHORIZED',401); return; }\n        try { $actor = $this->actors->resolve($matches[1]); }\n        catch (RuntimeException $exception) {\n            $status = in_array($exception->getCode(), [401,403,503], true) ? (int)$exception->getCode() : 401;\n            $this->fail($exception->getMessage(), $status === 503 ? 'MINIAPP_APPID_MISSING' : 'UNAUTHORIZED', $status);\n            return;\n        }\n        try {\n            // The demo boundary precedes method/body validation, as in the old dispatch.\n            if ($route === 'subscriptions.preference' && !empty($actor['is_demo_actor'])) {\n                $this->subscriptions->save($actor, []);\n            }\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== self::ROUTES[$route]) {\n                $this->fail('请求方式不正确','METHOD_NOT_ALLOWED',405); return;\n            }\n            $raw = self::ROUTES[$route] === 'POST' ? file_get_contents('php://input') : '';\n            // Retain the legacy empty/malformed-body fallback for these existing endpoints.\n            $body = json_decode(is_string($raw) ? $raw : '', true);\n            $body = is_array($body) ? $body : [];\n            if ($route === 'subscriptions.preference') { \\json_response(['ok'=>true] + $this->subscriptions->save($actor, $body)); return; }\n            if ($route === 'announcement.current') $data=$this->announcement->current((string)($_GET['scene']??''));\n            elseif ($route === 'subscriptions.status') $data = $this->subscriptions->status($actor, (string)($_GET['include_application'] ?? '') === '1');\n            elseif ($route === 'subscriptions.diagnose') $data = $this->subscriptions->diagnose($actor);\n            elseif ($route === 'notifications.summary') $data = $this->inbox->summary($actor);\n            elseif ($route === 'notifications.threads') $data=$this->inbox->threads($actor,$this->cursorInput($_GET['cursor']??''));\n            elseif ($route === 'notifications.thread_messages') $data=$this->inbox->threadMessages($actor,(string)($_GET['cursor']??''));\n            elseif ($route === 'notifications.list') $data = $this->inbox->list($actor, (int)($_GET['page'] ?? 1), (string)($_GET['through_id'] ?? ''));\n            elseif ($route === 'notifications.read_batch') $data = $this->inbox->readBatch($actor, is_array($body['ids'] ?? null) ? $body['ids'] : []);\n            elseif ($route === 'notifications.read') {\n                $this->inbox->read($actor, (string)($body['id'] ?? ''));\n                \\json_response(['ok'=>true,'message'=>'已标记为已读']); return;\n            } else {\n                if(array_key_exists('range_cursor',$body))$this->inbox->readRange($actor,$this->cursorInput($body['range_cursor']));\n                else $this->inbox->readAll($actor, (string)($body['through_id'] ?? ''));\n                \\json_response(['ok'=>true,'message'=>'未读消息已清除']); return;\n            }\n            $result = ['ok'=>true,'data'=>$data];\n            if ($route === 'notifications.read_batch') $result['message'] = '消息已标记为已读';\n            \\json_response($result);\n        } catch (MessageOperationException $exception) {\n            $this->fail($exception->getMessage(), $exception->apiCode(), (int)$exception->getCode());\n        } catch (OrderOperationException $exception) {\n            $this->fail($exception->getMessage(), $exception->apiCode(), (int)$exception->getCode());\n        }\n    }\n    private function cursorInput($value): string\n    {\n        if(!is_string($value))throw new MessageOperationException('通知浏览范围无效','NOTIFICATION_RESYNC_REQUIRED',409);\n        return $value;\n    }\n    private function fail(string $message, string $code, int $status): void\n    { \\json_response(['ok'=>false,'code'=>$code,'message'=>$message,'request_id'=>\\request_id()], $status); }\n}\n","server/app/Infrastructure/Chat/ChatRecoveryCheckpoint.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Chat;\n\nuse PDO;\nuse RuntimeException;\n\n/**\n * Compare safety facts after operator-controlled, continuous binlog replay.\n * Never replay messages, enqueue notification, charge wallets or invent missing increments.\n * Capture/verify require stopped chat processes and a separately protected control directory.\n */\nfinal class ChatRecoveryCheckpoint\n{\n    private PDO $db;private string $environment;private string $key;private string $directory;private string $epoch;\n    public function __construct(PDO $db,string $environment,string $key,string $directory,string $epoch)\n    {\n        if(!in_array($environment,['test','development','production'],true)||strlen($key)!==32\n            ||!ChatRecoveryGate::path($directory)||!is_dir($directory)||is_link($directory)||(fileperms($directory)&0027)!==0\n            ||preg_match('/^[a-f0-9]{64}$/D',$epoch)!==1)throw new RuntimeException('CHAT_RECOVERY_CONFIG');\n        $this->db=$db;$this->environment=$environment;$this->key=$key;$this->directory=rtrim($directory,'/\\\\');$this->epoch=$epoch;\n    }\n    public function block(): void\n    {$this->write('gate.json',['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'blocked']);}\n    private function blocked(): void\n    {\n        $m=$this->read('gate.json',1024);\n        if($m!==['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'blocked'])throw new RuntimeException('CHAT_RECOVERY_MAINTENANCE_REQUIRED');\n    }\n    /** Fingerprints only; no message bodies, source identities, media keys or channel payloads leave the DB. */\n    public static function queries(): array\n    {\n        return [\n            'chat_storage_policy'=>'SELECT * FROM chat_storage_policy ORDER BY id',\n            'chat_storage_policy_audit'=>'SELECT * FROM chat_storage_policy_audit ORDER BY id',\n            'chat_storage_applications'=>'SELECT * FROM chat_storage_applications ORDER BY revision',\n            'chat_storage_application_errors'=>'SELECT * FROM chat_storage_application_errors ORDER BY revision,message_id',\n            'chat_av_uploads'=>'SELECT * FROM chat_av_uploads ORDER BY id',\n            'chat_av_parts'=>'SELECT * FROM chat_av_parts ORDER BY upload_id,ordinal',\n            'chat_av_jobs'=>'SELECT * FROM chat_av_jobs ORDER BY intent_id',\n            'chat_av_objects'=>'SELECT * FROM chat_av_objects ORDER BY object_key',\n            'chat_av_items'=>'SELECT * FROM chat_av_items ORDER BY message_id',\n            'chat_av_listens'=>'SELECT * FROM chat_av_listens ORDER BY actor_id,message_id',\n            'chat_av_raw_receipts'=>'SELECT * FROM chat_av_raw_receipts ORDER BY trace_id',\n            'chat_av_asr_requests'=>'SELECT * FROM chat_av_asr_requests ORDER BY intent_id,ordinal',\n            'chat_av_budgets'=>'SELECT * FROM chat_av_budgets ORDER BY actor_id',\n            'chat_policy_guards'=>'SELECT id,order_id,assignment_id,policy_version,SHA2(snapshot_json,256) snapshot_hash FROM chat_policy_guards ORDER BY id',\n            'chat_repair_episodes'=>'SELECT * FROM chat_repair_episodes ORDER BY id',\n            'chat_policy_refresh'=>'SELECT * FROM chat_policy_refresh ORDER BY order_id',\n            'chat_auditor_grant_audit'=>'SELECT * FROM chat_auditor_grant_audit ORDER BY id',\n            'chat_audit_accounts'=>'SELECT * FROM chat_audit_accounts ORDER BY 1',\n            'chat_audit_snapshots'=>'SELECT * FROM chat_audit_snapshots ORDER BY 1',\n            'chat_audit_snapshot_items'=>'SELECT * FROM chat_audit_snapshot_items ORDER BY 1,2',\n            'admin_authority'=>'SELECT id,role,status,must_change_password,SHA2(password_hash,256) password_version FROM admin_users ORDER BY id',\n            'chat_staff_authority_versions'=>'SELECT user_id,authority_version FROM chat_staff_authority_versions ORDER BY user_id',\n            'chat_admin_sessions'=>'SELECT id,session_version,authority_hash,scopes_json,expires_at,revoked_at FROM chat_admin_sessions ORDER BY id',\n            'chat_mini_auditors'=>'SELECT user_id,enabled,authority_version FROM chat_mini_auditors ORDER BY user_id',\n            'login_sessions'=>'SELECT id,user_id,status,expires_at,SHA2(token_hash,256) credential_hash,demo_actor_user_id,test_actor_user_id,test_instance_id,test_actor_expires_at FROM login_sessions ORDER BY id',\n            'users'=>'SELECT id,status FROM users ORDER BY id',\n            'wechat_identities'=>'SELECT id,user_id,SHA2(CONCAT(app_id,CHAR(10),openid),256) identity_hash,status FROM wechat_identities ORDER BY id',\n            'staff_settings'=>\"SELECT setting_key,SHA2(setting_value,256) value_hash FROM system_settings WHERE setting_key IN ('wechat.miniapp_appid','wechat.admin_openids') ORDER BY setting_key\",\n            'chat_business_events'=>'SELECT id,event_id,aggregate_key,aggregate_version,SHA2(payload_json,256) payload_hash FROM chat_business_events ORDER BY id',\n            'chat_event_receipts'=>'SELECT * FROM chat_event_receipts ORDER BY event_id',\n            'chat_conversations'=>'SELECT * FROM chat_conversations ORDER BY id',\n            'chat_members'=>'SELECT * FROM chat_members ORDER BY conversation_id,actor_id',\n            'chat_member_intervals'=>'SELECT * FROM chat_member_intervals ORDER BY conversation_id,actor_id,start_version',\n            'chat_restrictions'=>'SELECT * FROM chat_restrictions ORDER BY actor_id',\n            'chat_messages'=>'SELECT id,conversation_id,seq,sender_id,client_message_id,policy_version,message_type,state,state_version,retention_policy_version,retention_mode,expires_at,SHA2(COALESCE(text_body,\"\"),256) body_hash,reply_to_message_id,edited_from_recalled_message_id,reply_to_item_id,recalled_at FROM chat_messages ORDER BY id',\n            'chat_message_changes'=>'SELECT * FROM chat_message_changes ORDER BY conversation_id,change_seq',\n            'chat_send_intents'=>'SELECT * FROM chat_send_intents ORDER BY id',\n            'chat_member_reads'=>'SELECT * FROM chat_member_reads ORDER BY conversation_id,actor_id',\n            'chat_user_preferences'=>'SELECT * FROM chat_user_preferences ORDER BY actor_id,conversation_id',\n            'chat_preference_accounts'=>'SELECT * FROM chat_preference_accounts ORDER BY actor_id',\n            'chat_risk_events'=>'SELECT id,intent_id,confirmed,review_state,retain_until,SHA2(text_evidence,256) text_hash,SHA2(context_evidence,256) context_hash FROM chat_risk_events ORDER BY id',\n            'chat_cases'=>'SELECT * FROM chat_cases ORDER BY id',\n            'chat_image_uploads'=>'SELECT * FROM chat_image_uploads ORDER BY id',\n            'chat_image_bundles'=>'SELECT * FROM chat_image_bundles ORDER BY intent_id',\n            'chat_image_items'=>'SELECT * FROM chat_image_items ORDER BY message_id,item_id',\n            'chat_image_objects'=>'SELECT * FROM chat_image_objects ORDER BY object_key',\n            'chat_image_reports'=>'SELECT * FROM chat_image_reports ORDER BY id',\n            'chat_image_audit'=>'SELECT * FROM chat_image_audit ORDER BY id',\n            'chat_governance_audit'=>'SELECT * FROM chat_governance_audit ORDER BY id',\n            'chat_reminder_events'=>'SELECT * FROM chat_reminder_events ORDER BY id',\n            'chat_reminder_clusters'=>'SELECT * FROM chat_reminder_clusters ORDER BY id',\n            'chat_reminder_budgets'=>'SELECT * FROM chat_reminder_budgets ORDER BY recipient_id',\n            'chat_reminder_intents'=>'SELECT * FROM chat_reminder_intents ORDER BY id',\n            'chat_reminder_receipts'=>'SELECT * FROM chat_reminder_receipts ORDER BY operation_id',\n            'chat_reminder_outbox'=>\"SELECT id,status,attempt_count,next_attempt_at,processed_at,SHA2(payload_json,256) payload_hash FROM message_outbox WHERE topic='chat_reminder' ORDER BY id\",\n        ];\n    }\n    public function facts(): array\n    {\n        if($this->db->inTransaction())throw new RuntimeException('CHAT_RECOVERY_TRANSACTION');\n        $this->db->exec('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ');\n        $this->db->beginTransaction();\n        try{\n            $result=[];\n            foreach(self::queries() as $name=>$query){\n                // PDO unbuffered scan, one row in memory. JSON numeric values are\n                // normalized to strings for driver/PHP patch-version stability.\n                $this->db->setAttribute(PDO::MYSQL_ATTR_USE_BUFFERED_QUERY,false);\n                $rows=$this->db->query($query);$hash=hash_init('sha256');$count=0;\n                while($row=$rows->fetch(PDO::FETCH_ASSOC)){\n                    foreach($row as &$value)if($value!==null)$value=(string)$value;unset($value);\n                    hash_update($hash,json_encode($row,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR).\"\\n\");$count++;\n                }\n                $rows->closeCursor();\n                $result[$name]=['count'=>$count,'sha256'=>hash_final($hash)];\n            }\n            $this->db->commit();return$result;\n        }catch(\\Throwable $e){if($this->db->inTransaction())$this->db->rollBack();throw new RuntimeException('CHAT_RECOVERY_FACTS_UNAVAILABLE');}\n        finally{$this->db->setAttribute(PDO::MYSQL_ATTR_USE_BUFFERED_QUERY,true);}\n    }\n    private function coordinate(): array\n    {\n        $row=$this->db->query('SHOW MASTER STATUS')->fetch(PDO::FETCH_ASSOC);\n        $uuid=(string)$this->db->query('SELECT @@server_uuid')->fetchColumn();\n        if(!$row||!isset($row['File'],$row['Position'])||$uuid==='')throw new RuntimeException('CHAT_RECOVERY_BINLOG_REQUIRED');\n        return ['server_uuid'=>$uuid,'file'=>(string)$row['File'],'position'=>(string)$row['Position']];\n    }\n    public function capture(): array\n    {\n        $this->blocked();$before=$this->coordinate();$facts=$this->facts();$after=$this->coordinate();\n        if($before!==$after)throw new RuntimeException('CHAT_RECOVERY_SOURCE_NOT_QUIESCENT');\n        $payload=['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,\n            'captured_at'=>gmdate('Y-m-d\\\\TH:i:s\\\\Z'),'watermark'=>$after,'facts'=>$facts];\n        $json=self::encode($payload);$sealed=['payload'=>$payload,'mac'=>hash_hmac('sha256',$json,$this->key)];\n        $this->write('checkpoint.json',$sealed);\n        // Latest anchor is independent of backup/restore. Never accept any older signed file.\n        $this->write('latest.json',['sha256'=>hash('sha256',self::encode($sealed)),'watermark'=>$after,'epoch'=>$this->epoch]);\n        return ['status'=>'captured','tables'=>count($facts),'watermark'=>$after];\n    }\n    public function verify(bool $release=false): array\n    {\n        $this->blocked();$sealed=$this->read('checkpoint.json',65536);$latest=$this->read('latest.json',4096);\n        $p=$sealed['payload']??null;$mac=$sealed['mac']??'';\n        if(!is_array($p)||!is_string($mac)||!hash_equals(hash_hmac('sha256',self::encode($p),$this->key),$mac)\n            ||($p['schema']??0)!==1||($p['environment']??'')!==$this->environment||($p['epoch']??'')!==$this->epoch\n            ||($latest['epoch']??'')!==$this->epoch||($latest['watermark']??null)!==($p['watermark']??null)\n            ||!hash_equals((string)($latest['sha256']??''),hash('sha256',self::encode($sealed))))throw new RuntimeException('CHAT_RECOVERY_CHECKPOINT_INVALID');\n        $current=$this->facts();$missing=[];\n        if(array_keys((array)($p['facts']??[]))!==array_keys($current))throw new RuntimeException('CHAT_RECOVERY_CONTRACT_CHANGED');\n        foreach($current as $table=>$fact)if($fact!==$p['facts'][$table])$missing[]=$table;\n        if($missing)return['status'=>'blocked','mismatched_tables'=>$missing,'notification_replayed'=>false];\n        if($release){\n            $continuity=$this->read('continuity.json',8192);$proof=$continuity['payload']??null;\n            if(!is_array($proof)||($proof['schema']??0)!==1||($proof['environment']??'')!==$this->environment\n                ||($proof['epoch']??'')!==$this->epoch||($proof['watermark']??null)!==$p['watermark']\n                ||($proof['complete']??false)!==true\n                ||!hash_equals(hash_hmac('sha256',self::encode($proof),$this->key),(string)($continuity['mac']??'')))throw new RuntimeException('CHAT_RECOVERY_INCREMENT_GAP');\n        }\n        if($release)$this->write('gate.json',['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'ready']);\n        return['status'=>$release?'ready':'verified','tables'=>count($current),'notification_replayed'=>false];\n    }\n    /** Explicit maintenance-account purge; normal Go audit grants remain INSERT/SELECT only. */\n    public function pruneAudit(): array\n    {\n        $this->blocked();\n        $progress=is_file($this->directory.'/audit-progress.json')?$this->read('audit-progress.json',4096):[];\n        $rules=[\n            'chat_governance_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.retain_until>UTC_TIMESTAMP(6) AND (c.conversation_id=chat_governance_audit.conversation_id OR c.subject_id=chat_governance_audit.actor_id OR c.reporter_id=chat_governance_audit.actor_id))\",\n            'chat_image_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_send_intents i ON i.id=chat_image_audit.intent_id WHERE c.retain_until>UTC_TIMESTAMP(6) AND ((c.target_type='image_intent' AND c.target_id=i.id) OR (c.target_type='message' AND c.target_id=i.message_id)))\",\n            'chat_auditor_grant_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.retain_until>UTC_TIMESTAMP(6) AND (c.subject_id=chat_auditor_grant_audit.user_id OR c.reporter_id=chat_auditor_grant_audit.user_id))\",\n        ];\n        $counts=[];\n        $this->journal(['action'=>'audit.prune.begin','epoch'=>$this->epoch,'days'=>365,'at'=>gmdate('c')]);\n        foreach($rules as $table=>$hold){\n            $after=(string)($progress[$table]??'0');\n            if(preg_match('/^[0-9]{1,20}$/D',$after)!==1)throw new RuntimeException('CHAT_AUDIT_CURSOR');\n            $stmt=$this->db->prepare('SELECT id FROM '.$table.' WHERE id>? ORDER BY id LIMIT 100');$stmt->execute([$after]);\n            $ids=$stmt->fetchAll(PDO::FETCH_COLUMN);$removed=0;\n            foreach($ids as $id){\n                $delete=$this->db->prepare('DELETE FROM '.$table.' WHERE id=? AND created_at<UTC_TIMESTAMP(6)-INTERVAL 365 DAY AND '.$hold);\n                $delete->execute([(string)$id]);$removed+=$delete->rowCount();\n            }\n            $progress[$table]=count($ids)<100?'0':(string)end($ids);\n            $counts[$table]=['scanned'=>count($ids),'deleted'=>$removed,'next_after'=>$progress[$table]];\n        }\n        $this->write('audit-progress.json',$progress);\n        $this->journal(['action'=>'audit.prune.complete','epoch'=>$this->epoch,'counts'=>$counts,'at'=>gmdate('c')]);\n        return ['status'=>'maintenance_blocked','audit'=>$counts,'recapture_required'=>true];\n    }\n    private function journal(array $v): void\n    {\n        $file=$this->directory.'/maintenance.jsonl';\n        if(is_link($file))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        $h=fopen($file,'ab');if(!$h)throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        try{\n            if(!chmod($file,0640)||!flock($h,LOCK_EX))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n            $raw=self::encode($v).\"\\n\";\n            if(fwrite($h,$raw)!==strlen($raw)||!fflush($h)||!fsync($h))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        }finally{flock($h,LOCK_UN);fclose($h);}\n        $this->syncDirectory();\n    }\n    private function read(string $file,int $limit): array\n    {\n        $path=$this->directory.'/'.$file;\n        if(!is_file($path)||is_link($path)||filesize($path)>$limit||(fileperms($path)&0022)!==0)throw new RuntimeException('CHAT_RECOVERY_FILE_INVALID');\n        $raw=file_get_contents($path);$v=is_string($raw)?json_decode($raw,true):null;\n        if(!is_array($v))throw new RuntimeException('CHAT_RECOVERY_FILE_INVALID');return$v;\n    }\n    private function write(string $name,array $value): void\n    {\n        $path=$this->directory.'/'.$name;$temporary=$path.'.'.bin2hex(random_bytes(8));\n        $handle=fopen($temporary,'x');if(!$handle)throw new RuntimeException('CHAT_RECOVERY_WRITE');\n        try{$raw=self::encode($value);if(!chmod($temporary,0640)||fwrite($handle,$raw)!==strlen($raw)||!fflush($handle)||!fsync($handle))throw new RuntimeException('CHAT_RECOVERY_WRITE');}\n        finally{fclose($handle);}\n        if(!rename($temporary,$path)){unlink($temporary);throw new RuntimeException('CHAT_RECOVERY_WRITE');}\n        $this->syncDirectory();\n    }\n    private function syncDirectory(): void\n    {\n        $handle=fopen($this->directory,'r');\n        if(!$handle)throw new RuntimeException('CHAT_RECOVERY_DURABILITY');\n        try{if(!fsync($handle))throw new RuntimeException('CHAT_RECOVERY_DURABILITY');}finally{fclose($handle);}\n    }\n    private static function encode(array $v): string{return(string)json_encode($v,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR);}\n}\n","server/app/Infrastructure/Chat/ChatRecoveryGate.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Chat;\n\nuse RuntimeException;\n\n/** Independent control marker; never stored inside a DB backup or release tree. */\nfinal class ChatRecoveryGate\n{\n    public static function ready(array $config,string $environment): bool\n    {\n        $path=(string)($config['recovery_gate_file']??'');$epoch=(string)($config['recovery_epoch']??'');\n        if($path===''&&$epoch==='')return in_array($environment,['test','development'],true);\n        if(!self::path($path)||preg_match('/^[a-f0-9]{64}$/D',$epoch)!==1||!is_file($path)||is_link($path)||filesize($path)>1024||(fileperms($path)&0022)!==0)return false;\n        $raw=file_get_contents($path);if(!is_string($raw))return false;\n        $m=json_decode($raw,true);\n        if(!is_array($m)||array_keys($m)!==['schema','environment','epoch','state'])return false;\n        if(json_encode($m,JSON_UNESCAPED_SLASHES)!==preg_replace('/\\s+(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/','',$raw))return false;\n        return$m===['schema'=>1,'environment'=>$environment,'epoch'=>$epoch,'state'=>'ready'];\n    }\n    public static function assertReady(array $config,string $environment): void\n    {if(!self::ready($config,$environment))throw new RuntimeException('聊天安全恢复尚未核验',503);}\n    public static function path(string $path): bool\n    {return$path!==''&&($path[0]==='/'||preg_match('/^[A-Za-z]:[\\\\\\\\\\/]/D',$path)===1)&&strpos($path,\"\\0\")===false;}\n}\n","server/app/Infrastructure/External/WeChatAccessTokenProvider.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\External;\n\nuse RuntimeException;\nuse Throwable;\n\n/** One cross-process refresh coordinator for every PHP caller; Go never owns AppSecret. */\nfinal class WeChatAccessTokenProvider\n{\n    private string $environment;\n    private string $appId;\n    private string $secret;\n    private string $directory;\n    private ?string $exportDirectory;\n    private $request;\n\n    public function __construct(string $environment,string $appId,#[\\SensitiveParameter] string $secret,string $directory,?string $exportDirectory=null,?callable $request=null)\n    {\n        if(!in_array($environment,['production','development','test'],true)||preg_match('/^[A-Za-z0-9_-]{1,64}$/D',$appId)!==1||$secret==='')throw new RuntimeException('微信统一凭证配置不可用');\n        $this->environment=$environment;$this->appId=$appId;$this->secret=$secret;\n        $this->directory=$directory;$this->exportDirectory=$exportDirectory;$this->request=$request;\n    }\n\n    public static function fromSettings(): self\n    {\n        $env=(string)\\app_config('app.env','production');if($env==='testing')$env='test';\n        return new self($env,trim((string)\\setting('wechat.miniapp_appid','')),trim((string)\\setting('wechat.miniapp_secret','')),\n            \\base_path('storage/private/wechat-tokens'),\\app_config('chat.safety_credential_export_enabled',false)===true?\\base_path('storage/private/chat-credentials'):null);\n    }\n\n    public function get(): string\n    {\n        $this->ensureDirectory($this->directory,0700);\n        $cached=$this->read();\n        if($this->valid($cached,300)&&$this->exportMatches($cached)){ return $cached['token']; }\n        $lock=$this->lock($cached);\n        if($lock===null){ return $cached['token']; }\n        try{\n            $cached=$this->read();\n            if($this->valid($cached,300)){ $this->export($cached);return $cached['token']; }\n            if(!$this->valid($cached,5))$this->revokeExport();\n            $started=time();\n            try{\n                $response=$this->request!==null?($this->request)($this->appId,$this->secret):$this->requestToken();\n                if(!is_array($response)||isset($response['errcode'])&&$response['errcode']!==0\n                    ||!is_string($response['access_token']??null)||preg_match('/^[A-Za-z0-9_-]{10,2048}$/D',$response['access_token'])!==1\n                    ||!is_int($response['expires_in']??null)||$response['expires_in']<1||$response['expires_in']>7200)throw new RuntimeException('微信统一凭证响应不可用');\n                // Never extend a provider TTL with max(600, expires_in).\n                $next=['schema_version'=>1,'env'=>$this->environment,'app_id'=>$this->appId,'token'=>$response['access_token'],\n                    'issued_at'=>$started,'expires_at'=>$started+$response['expires_in'],'credential_hash'=>$this->credentialHash()];\n                if(!$this->valid($next,5))throw new RuntimeException('微信统一凭证剩余有效期不足');\n                $this->write($this->cachePath(),$next,0600);\n                $this->export($next);\n                return $next['token'];\n            }catch(Throwable $error){\n                // A failed refresh does not invent a new expiry or discard a\n                // still-valid credential. Rejected/rotated credentials fail this.\n                if($this->valid($cached,5)){ $this->export($cached);return $cached['token']; }\n                throw new RuntimeException('微信统一凭证暂不可用');\n            }\n        }finally{flock($lock,LOCK_UN);fclose($lock);}\n    }\n\n    /** Only invalidate the exact generation actually rejected by a caller. */\n    public function rejectGeneration(string $generation): bool\n    {\n        if(preg_match('/^[a-f0-9]{64}$/D',$generation)!==1)return false;\n        $this->ensureDirectory($this->directory,0700);$lock=$this->lock(null);\n        try{\n            $cached=$this->read();\n            if(!is_array($cached)||!hash_equals($this->generation($cached['token']),$generation))return false;\n            if(is_file($this->cachePath())&&!unlink($this->cachePath()))throw new RuntimeException('微信统一凭证撤销失败');\n            if($this->exportDirectory!==null){$this->revokeExport();}\n            return true;\n        }finally{flock($lock,LOCK_UN);fclose($lock);}\n    }\n    public function reject(#[\\SensitiveParameter] string $usedToken): bool\n    {\n        return $usedToken!==''&&$this->rejectGeneration($this->generation($usedToken));\n    }\n    public function generation(#[\\SensitiveParameter] string $token): string {return hash('sha256',$this->environment.\"\\n\".$this->appId.\"\\n\".$token);}\n    public function exportPath(): string\n    {\n        if($this->exportDirectory===null)throw new RuntimeException('聊天凭证导出未启用');\n        return $this->exportDirectory.DIRECTORY_SEPARATOR.$this->environment.'-'.hash('sha256',$this->appId).'.json';\n    }\n    /** Read-only preflight, including permissions and exact current configuration. */\n    public function metadata(): array\n    {\n        $cached=$this->read();\n        if(!$this->valid($cached,5)||!$this->exportMatches($cached))throw new RuntimeException('微信聊天导出凭证不可用');\n        return ['status'=>'ready','credential_file'=>$this->exportPath(),'env'=>$this->environment,'generation'=>$this->generation($cached['token']),'expires_at'=>$cached['expires_at']];\n    }\n    private function credentialHash(): string {return hash('sha256',$this->environment.\"\\n\".$this->appId.\"\\n\".$this->secret);}\n    private function cachePath(): string {return $this->directory.DIRECTORY_SEPARATOR.hash('sha256',$this->environment.\"\\n\".$this->appId).'.json';}\n    private function read(): ?array\n    {\n        $path=$this->cachePath();clearstatcache(true,$path);\n        if(is_link($path)||!is_file($path)||filesize($path)>4096)return null;\n        $data=json_decode((string)@file_get_contents($path),true);\n        return $this->valid($data,0)?$data:null;\n    }\n    private function valid(#[\\SensitiveParameter] $data,int $margin): bool\n    {\n        return is_array($data)&&($data['schema_version']??null)===1&&($data['env']??null)===$this->environment&&($data['app_id']??null)===$this->appId\n            &&is_string($data['token']??null)&&preg_match('/^[A-Za-z0-9_-]{10,2048}$/D',$data['token'])===1\n            &&is_int($data['issued_at']??null)&&$data['issued_at']<=time()+5&&is_int($data['expires_at']??null)&&$data['expires_at']>time()+$margin\n            &&$data['expires_at']>$data['issued_at']&&$data['expires_at']-$data['issued_at']<=7200\n            &&is_string($data['credential_hash']??null)&&hash_equals($this->credentialHash(),$data['credential_hash']);\n    }\n    private function lock(#[\\SensitiveParameter] ?array $fallback)\n    {\n        $path=$this->cachePath().'.lock';if(is_link($path))throw new RuntimeException('微信统一凭证锁不可用');\n        $handle=@fopen($path,'c+');if($handle===false)throw new RuntimeException('微信统一凭证锁不可用');@chmod($path,0600);\n        $until=microtime(true)+1.0;\n        do{\n            if(flock(