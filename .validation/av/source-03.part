P(),UTC_TIMESTAMP()),\n('worker_verifications','worker_id','师傅ID','师傅ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_verifications','submitted_snapshot_json','提交快照JSON','提交快照JSON',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_verifications','decision','处理决定','处理决定',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_verifications','decision_reason','决定原因','决定原因',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_verifications','reviewed_by','审核人ID','审核人ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_verifications','submitted_at','提交时间','提交时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_verifications','reviewed_at','审核时间','审核时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','code','代码','代码',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','name','名称','名称',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','sort_order','排序值','排序值',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','homepage_featured','首页推荐','首页推荐',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','status','状态','状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_categories','updated_at','更新时间','更新时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','faq_id','问答ID','问答ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','category_id','类目ID','类目ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','question','问题','问题',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','answer','回答','回答',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','aliases','别名','别名',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','keywords','关键词','关键词',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','roles','适用角色','适用角色',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','sort_order','排序值','排序值',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','is_featured','是否推荐','是否推荐',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','status','状态','状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','related_faq_ids','相关问答ID列表','相关问答ID列表',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','business_entry_label','业务记录标签','业务记录标签',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','business_entry_path','业务记录路径','业务记录路径',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','draft_payload','草稿内容','草稿内容',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','version','版本号','版本号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','published_version','已发布版本','已发布版本',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','published_at','发布时间','发布时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','created_by','创建人ID','创建人ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','updated_by','更新人ID','更新人ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','deleted_at','删除时间','删除时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','updated_at','更新时间','更新时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','faq_id','问答ID','问答ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','version','版本号','版本号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','snapshot_json','快照JSON','快照JSON',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','action','操作','操作',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','operator_admin_id','操作人管理员ID','操作人管理员ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','query_text','查询文本','查询文本',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','query_hash','查询摘要','查询摘要',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','role_key','角色键','角色键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','result_count','结果数量','结果数量',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','clicked_faq_id','点击问答ID','点击问答ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\n-- V2.4.0 BASELINE EXTENSION END\n\n-- V2.5.0 review rating dictionary seed\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('reviews','attitude_rating','服务态度评分','订单评价中的服务态度星级，1-5星',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('reviews','craft_rating','施工手艺评分','订单评价中的施工手艺星级，1-5星',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-10-08：取消风控与七天下单限制；账号锁、同单事实及解除审计独立于退款状态。\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_accounts (\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  blocked_until datetime DEFAULT NULL COMMENT '新下单限制结束时间（UTC）',\n  last_restriction_id bigint unsigned DEFAULT NULL COMMENT '最近限制审计ID',\n  updated_at datetime NOT NULL COMMENT '更新时间（UTC）',\n  PRIMARY KEY (user_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_signals (\n  id bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  order_id bigint unsigned NOT NULL COMMENT '取消订单ID',\n  worker_id bigint unsigned NOT NULL COMMENT '参与师傅ID',\n  signal_type varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原操作信号：dialed拨号、contacted预约联系、complaint异常投诉',\n  note varchar(500) NOT NULL DEFAULT '' COMMENT '原提交说明',\n  created_at datetime NOT NULL COMMENT '创建时间（UTC）',\n  revoked_at datetime DEFAULT NULL COMMENT '信号撤销时间',\n  PRIMARY KEY (id),\n  UNIQUE KEY uq_cancel_risk_signal (order_id,worker_id,signal_type)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_scores (\n  order_id bigint unsigned NOT NULL COMMENT '取消订单ID',\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  base_score smallint unsigned NOT NULL DEFAULT 0 COMMENT '取消前报价成交跑空最高分',\n  score smallint unsigned NOT NULL DEFAULT 0 COMMENT '同单所有有效事实最高分',\n  cancelled_at datetime NOT NULL COMMENT '取消成立时间（UTC）',\n  snapshot_json longtext NOT NULL COMMENT '取消事实或处罚规则命中快照',\n  consumed_restriction_id bigint unsigned DEFAULT NULL COMMENT '消耗本单计分的限制ID；防止旧单重复封禁',\n  excluded_at datetime DEFAULT NULL COMMENT '客服或责任裁定排除时间',\n  exclusion_reason varchar(500) DEFAULT NULL COMMENT '计分排除原因',\n  created_at datetime NOT NULL COMMENT '创建时间（UTC）',\n  updated_at datetime NOT NULL COMMENT '更新时间（UTC）',\n  PRIMARY KEY (order_id),\n  KEY idx_cancel_risk_user_time (user_id,cancelled_at),\n  KEY idx_cancel_risk_user_unused (user_id,consumed_restriction_id,excluded_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_restrictions (\n  id bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  starts_at datetime NOT NULL COMMENT '限制开始时间（UTC）',\n  expires_at datetime NOT NULL COMMENT '限制结束时间（UTC）',\n  snapshot_json longtext NOT NULL COMMENT '取消事实或处罚规则命中快照',\n  released_at datetime DEFAULT NULL COMMENT '客服解除时间（UTC）',\n  released_by_admin_id bigint unsigned DEFAULT NULL COMMENT '解除管理员ID',\n  release_reason varchar(500) DEFAULT NULL COMMENT '客服解除核实说明',\n  PRIMARY KEY (id),\n  KEY idx_cancel_risk_restriction_user (user_id,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n  ('order_cancellation_risk_accounts','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','blocked_until','新下单限制结束时间（UTC）','新下单限制结束时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','last_restriction_id','最近限制审计ID','最近限制审计ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','updated_at','更新时间（UTC）','更新时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','order_id','取消订单ID','取消订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','worker_id','参与师傅ID','参与师傅ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','signal_type','原操作信号：dialed拨号、contacted预约联系、complaint异常投诉','原操作信号：dialed拨号、contacted预约联系、complaint异常投诉',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','note','原提交说明','原提交说明',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','created_at','创建时间（UTC）','创建时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','revoked_at','信号撤销时间','信号撤销时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','order_id','取消订单ID','取消订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','base_score','取消前报价成交跑空最高分','取消前报价成交跑空最高分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','score','同单所有有效事实最高分','同单所有有效事实最高分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','cancelled_at','取消成立时间（UTC）','取消成立时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','snapshot_json','取消事实或处罚规则命中快照','取消事实或处罚规则命中快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','consumed_restriction_id','消耗本单计分的限制ID；防止旧单重复封禁','消耗本单计分的限制ID；防止旧单重复封禁',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','excluded_at','客服或责任裁定排除时间','客服或责任裁定排除时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','exclusion_reason','计分排除原因','计分排除原因',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','created_at','创建时间（UTC）','创建时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','updated_at','更新时间（UTC）','更新时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','starts_at','限制开始时间（UTC）','限制开始时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','expires_at','限制结束时间（UTC）','限制结束时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','snapshot_json','取消事实或处罚规则命中快照','取消事实或处罚规则命中快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','released_at','客服解除时间（UTC）','客服解除时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','released_by_admin_id','解除管理员ID','解除管理员ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','release_reason','客服解除核实说明','客服解除核实说明',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE chinese_name=VALUES(chinese_name),description=VALUES(description),updated_at=UTC_TIMESTAMP();\n\n-- Current empty identity/testing table exports from isolated MySQL 5.7.42.\nDROP TABLE IF EXISTS `chat_admin_sessions`;\nCREATE TABLE `chat_admin_sessions` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '聊天后台会话ID',\n  `admin_id` bigint(20) unsigned NOT NULL COMMENT '原后台管理员ID',\n  `session_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '环境绑定的PHP Session摘要',\n  `session_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '随机会话撤销版本',\n  `authority_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '角色密码及scope快照摘要',\n  `scopes_json` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '限权scope JSON数组',\n  `expires_at` datetime NOT NULL COMMENT '最晚凭证到期时间UTC',\n  `revoked_at` datetime DEFAULT NULL COMMENT '原Session登出或撤销时间UTC',\n  `created_at` datetime NOT NULL COMMENT '创建时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_admin_session_hash` (`session_hash`),\n  KEY `idx_chat_admin_actor_expiry` (`admin_id`,`expires_at`),\n  KEY `idx_chat_admin_expiry` (`expires_at`),\n  CONSTRAINT `fk_chat_admin_actor` FOREIGN KEY (`admin_id`) REFERENCES `admin_users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP后台聊天凭证会话，Go只读';\n\nDROP TABLE IF EXISTS `test_assertion_results`;\nCREATE TABLE `test_assertion_results` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `run_id` bigint(20) unsigned DEFAULT NULL,\n  `assertion_group` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `assertion_key` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `expected_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `actual_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `details_json` text COLLATE utf8mb4_unicode_ci,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  KEY `idx_test_assertions_instance` (`instance_id`,`id`),\n  KEY `idx_test_assertions_run` (`run_id`,`id`),\n  KEY `idx_test_assertions_status` (`status`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心断言结果';\n\nDROP TABLE IF EXISTS `test_batches`;\nCREATE TABLE `test_batches` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `create_request_key` varchar(80) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `code_sha` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `app_version` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `environment` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `archived_at` datetime DEFAULT NULL,\n  `cleanup_at` datetime DEFAULT NULL,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_batches_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_batches_request` (`created_by_admin_id`,`create_request_key`),\n  KEY `idx_test_batches_status_created` (`status`,`created_at`),\n  KEY `idx_test_batches_admin_created` (`created_by_admin_id`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心批次元数据';\n\nDROP TABLE IF EXISTS `test_entry_tokens`;\nCREATE TABLE `test_entry_tokens` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `token_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `actor_role` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_user_id` bigint(20) unsigned NOT NULL,\n  `actor_worker_id` bigint(20) unsigned DEFAULT NULL,\n  `worker_slot` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `page_key` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `expires_at` datetime NOT NULL,\n  `used_at` datetime DEFAULT NULL,\n  `used_by_session_id` bigint(20) unsigned DEFAULT NULL,\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_entry_public` (`public_id`),\n  UNIQUE KEY `uniq_test_entry_hash` (`token_hash`),\n  KEY `idx_test_entry_instance_status` (`instance_id`,`status`,`expires_at`),\n  KEY `idx_test_entry_session` (`used_by_session_id`,`used_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心一次性小程序短期入口；只保存 token 摘要';\n\nDROP TABLE IF EXISTS `test_instances`;\nCREATE TABLE `test_instances` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `batch_id` bigint(20) unsigned NOT NULL,\n  `scenario_key` varchar(160) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `scenario_version` int(10) unsigned NOT NULL DEFAULT '1',\n  `order_id` bigint(20) unsigned DEFAULT NULL,\n  `order_no_snapshot` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `params_json` text COLLATE utf8mb4_unicode_ci,\n  `params_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `build_mode` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'preset',\n  `build_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'building',\n  `verification_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n  `source_instance_id` bigint(20) unsigned DEFAULT NULL,\n  `rebuilt_from_instance_id` bigint(20) unsigned DEFAULT NULL,\n  `version` int(10) unsigned NOT NULL DEFAULT '1',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  `archived_at` datetime DEFAULT NULL,\n  `deleted_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_instances_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_instances_order_id` (`order_id`),\n  KEY `idx_test_instances_batch` (`batch_id`,`id`),\n  KEY `idx_test_instances_scenario` (`scenario_key`,`build_status`,`created_at`),\n  KEY `idx_test_instances_verification` (`verification_status`,`created_at`),\n  KEY `idx_test_instances_source` (`source_instance_id`),\n  KEY `idx_test_instances_rebuilt` (`rebuilt_from_instance_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心场景实例';\n\nDROP TABLE IF EXISTS `test_media_facts`;\nCREATE TABLE `test_media_facts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `media_file_id` bigint(20) unsigned NOT NULL,\n  `purpose` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `storage_key_snapshot` varchar(500) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_media_instance_file` (`instance_id`,`media_file_id`),\n  KEY `idx_test_media_file` (`media_file_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心创建媒体归属，用于精确清理';\n\nDROP TABLE IF EXISTS `test_message_outbox`;\nCREATE TABLE `test_message_outbox` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `order_id` bigint(20) unsigned NOT NULL,\n  `business_key` varchar(190) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `event_key` varchar(160) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `event_type` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `channel` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `recipient_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `recipient_id` bigint(20) unsigned DEFAULT NULL,\n  `scene_key` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `projection_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `reason_code` varchar(120) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `payload_json` text COLLATE utf8mb4_unicode_ci,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_message_business` (`instance_id`,`business_key`),\n  KEY `idx_test_message_instance_created` (`instance_id`,`created_at`),\n  KEY `idx_test_message_event_channel` (`event_type`,`channel`,`projection_status`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心消息模拟投影；绝不进入真实外部投递队列';\n\nDROP TABLE IF EXISTS `test_participants`;\nCREATE TABLE `test_participants` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `slot_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` bigint(20) unsigned DEFAULT NULL,\n  `worker_id` bigint(20) unsigned DEFAULT NULL,\n  `expected_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_participant_slot` (`instance_id`,`slot_key`),\n  KEY `idx_test_participant_user` (`user_id`),\n  KEY `idx_test_participant_worker` (`worker_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试实例参与者 slot 映射；主档可由多个实例共享';\n\nDROP TABLE IF EXISTS `test_payment_facts`;\nCREATE TABLE `test_payment_facts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `payment_order_id` bigint(20) unsigned NOT NULL,\n  `simulation_request_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `business_type` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `amount_cents` bigint(20) unsigned NOT NULL,\n  `simulated_provider` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'internal_test',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'paid',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_payment_order` (`payment_order_id`),\n  UNIQUE KEY `uniq_test_payment_request` (`simulation_request_key`),\n  KEY `idx_test_payment_instance` (`instance_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='testing 内部支付事实来源登记；绝非微信交易';\n\nDROP TABLE IF EXISTS `test_runs`;\nCREATE TABLE `test_runs` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `action_key` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_role` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'admin',\n  `operation_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'preset',\n  `idempotency_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `before_summary_json` text COLLATE utf8mb4_unicode_ci,\n  `after_summary_json` text COLLATE utf8mb4_unicode_ci,\n  `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'running',\n  `error_code` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `error_message` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `duration_ms` int(10) unsigned DEFAULT NULL,\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `started_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `finished_at` datetime DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_runs_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_runs_idempotency` (`instance_id`,`idempotency_key`),\n  KEY `idx_test_runs_instance_created` (`instance_id`,`created_at`),\n  KEY `idx_test_runs_result_created` (`result`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心动作执行记录';\n\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TRIGGER `chat_admin_identity_revoke` AFTER UPDATE ON `admin_users`\nFOR EACH ROW UPDATE `chat_admin_sessions`\nSET `revoked_at`=COALESCE(`revoked_at`,UTC_TIMESTAMP())\nWHERE `admin_id`=NEW.id AND `revoked_at` IS NULL\n  AND (NOT (OLD.role <=> NEW.role) OR NOT (OLD.status <=> NEW.status)\n       OR NOT (OLD.password_hash <=> NEW.password_hash)\n       OR NOT (OLD.must_change_password <=> NEW.must_change_password));\nINSERT INTO database_field_dictionary (table_name,field_name,chinese_name,description,created_at,updated_at) VALUES\n('login_sessions','test_actor_expires_at','测试身份到期时间','到期后 API actor 解析自动清除临时身份','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('login_sessions','test_actor_user_id','测试实例临时身份','仅 testing 的真实管理员小程序会话可通过一次性测试入口临时绑定；正式环境解析时忽略并清除','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('login_sessions','test_instance_id','测试实例临时绑定','短期测试会话只能访问此实例归属的客户或 test_participants 师傅身份','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_assertion_results','status','断言结果','passed/failed/skipped/not_applicable/blocked','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_batches','create_request_key','测试创建请求键','同一管理员的场景生成请求幂等键','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_entry_tokens','status','入口票据状态','active/used/expired/revoked；used 后不可再次兑换','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_entry_tokens','token_hash','短期入口摘要','一次性入口只保存 SHA-256 摘要，不保存明文 token','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_instances','order_id','测试主订单ID','测试实例主要查看订单；M1 一实例一订单，删除后置空保留 tombstone','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_instances','scenario_key','测试场景键','代码版本化场景模板稳定标识，不包含应用版本号','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_instances','verification_status','测试检查状态','pending/passed/failed/blocked','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_media_facts','media_file_id','测试媒体ID','测试中心创建并可安全删除的媒体主档，不得指向正式业务媒体','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_message_outbox','business_key','消息模拟幂等键','按测试实例、业务事件、渠道、收件人和场景去重，业务重试不得重复生成相同投影','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_message_outbox','projection_status','消息模拟状态','delivered/config_disabled/demo_suppressed/not_applicable/environment_blocked/simulated/failed/not_run；模拟消息绝不进入真实 dispatcher','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_participants','slot_key','测试参与者槽位','例如 worker_1/worker_2/pending_worker；用于页面测试与清理归属','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_payment_facts','payment_order_id','内部模拟支付单ID','仅 testing 内部支付适配器登记；对应 payment_orders 不得具有微信 prepay/transaction_id','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_runs','idempotency_key','测试动作幂等键','同一实例同一动作请求的幂等保护键','2026-10-21 17:43:27','2026-10-21 17:43:27')\nON DUPLICATE KEY UPDATE chinese_name=VALUES(chinese_name),description=VALUES(description);\n\n-- 隔离MySQL实际导出的空授权表，无业务订单或消息。\nDROP TABLE IF EXISTS `chat_policy_guards`;\nCREATE TABLE `chat_policy_guards` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '栅栏ID',\n  `scope_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '订单与不可变指派代次',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '不可变指派ID',\n  `policy_version` bigint(20) unsigned NOT NULL COMMENT '同scope单调权限版本',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'open可发或readonly只读',\n  `active_order_id` bigint(20) unsigned GENERATED ALWAYS AS (if((`state` = 'open'),`order_id`,NULL)) STORED COMMENT '同订单仅一个可发scope',\n  `snapshot_json` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'PHP权威身份与授权区间快照',\n  `snapshot_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '无版本快照指纹用于幂等',\n  `updated_at` datetime NOT NULL COMMENT '更新时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_policy_scope` (`scope_key`),\n  UNIQUE KEY `uq_chat_policy_active_order` (`active_order_id`),\n  KEY `idx_chat_policy_order` (`order_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP单写订单聊天权限栅栏，Go只读和取共享锁';\n\nDROP TABLE IF EXISTS `chat_business_events`;\nCREATE TABLE `chat_business_events` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '扫描定位ID，不等于已提交水位',\n  `event_id` char(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '随机稳定业务事件ID',\n  `aggregate_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '会话作用域',\n  `aggregate_version` bigint(20) unsigned NOT NULL COMMENT '该scope权限版本',\n  `schema_version` int(10) unsigned NOT NULL COMMENT '事件协议版本',\n  `event_type` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '事件类型',\n  `payload_json` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '版本化完整授权快照',\n  `created_at` datetime NOT NULL COMMENT '提交时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_business_event` (`event_id`),\n  UNIQUE KEY `uq_chat_business_scope_version` (`aggregate_key`,`aggregate_version`),\n  KEY `idx_chat_business_created` (`created_at`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP订单事务事件，Go不修改消费状态';\n\n-- 隔离MySQL实际导出的空授权表，无业务订单或消息。\nDROP TABLE IF EXISTS `chat_repair_episodes`;\nCREATE TABLE `chat_repair_episodes` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '不可变售后受理代次',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '受理时不可变指派ID',\n  `after_sale_id` bigint(20) unsigned NOT NULL COMMENT '售后申请ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '明确受理的师傅ID',\n  `accepted_user_id` bigint(20) unsigned NOT NULL COMMENT '师傅对应真实小程序用户ID',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'active或closed，closed不复活',\n  `active_order_id` bigint(20) unsigned GENERATED ALWAYS AS (if((`state` = 'active'),`order_id`,NULL)) STORED COMMENT '同订单仅一个有效受理区间',\n  `accepted_at` datetime NOT NULL COMMENT '原受理事务内UTC时间',\n  `closed_at` datetime DEFAULT NULL COMMENT '结束UTC时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_repair_active_order` (`active_order_id`),\n  KEY `idx_chat_repair_request` (`order_id`,`after_sale_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP单写售后明确受理事实，不从processing或事件文字推断授权';\n\n\n-- V2.10.0：平台工作人员权限代次及有界授权恢复。PHP单写，Go只读。\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\n\n-- 修复历史新装基线遗漏的平台专属表；已有升级库保持原表及资金数据。\nCREATE TABLE IF NOT EXISTS `order_platform_terms` (\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `customer_flow_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'platform_managed' COMMENT '客户参与方式：platform_managed平台托管、miniapp_booking小程序预约',\n  `customer_pricing_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'fixed_total' COMMENT '客户计价方式：fixed_total固定总价、itemized明细计价',\n  `customer_contract_total_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户当前最终成交金额（分）',\n  `worker_settlement_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'worker_collect' COMMENT '师傅工费结算：worker_collect师傅代收、platform_balance平台余额',\n  `worker_labor_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '当前最终师傅工费（分）',\n  `extra_income_rate_bp_snapshot` int(10) unsigned NOT NULL DEFAULT '2000' COMMENT '订单外加项平台收入比例快照（万分比）',\n  `booking_paid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '最终结算时平台已收预约费快照（分）',\n  `customer_tail_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户现场剩余应付（分）',\n  `platform_receivable_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '平台收入款待收金额（分）',\n  `worker_balance_credit_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '应进入师傅余额金额（分）',\n  `worker_balance_freeze_days_snapshot` smallint(5) unsigned NOT NULL DEFAULT '0' COMMENT '师傅余额冻结天数快照',\n  `settlement_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '平台承接单结算状态',\n  `settled_at` datetime DEFAULT NULL COMMENT '结算完成时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`order_id`),\n  KEY `idx_platform_terms_settlement` (`settlement_status`,`updated_at`),\n  CONSTRAINT `fk_platform_terms_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单专属计价与结算条件';\n\nCREATE TABLE IF NOT EXISTS `order_pricing_items` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `item_source` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'base' COMMENT '明细来源：base基础开单、change订单外加项',\n  `change_request_id` bigint(20) unsigned DEFAULT NULL COMMENT '关联费用调整申请ID',\n  `description` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '施工项目/描述',\n  `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '项目说明',\n  `quantity` decimal(12,3) DEFAULT NULL COMMENT '数量/实际用量',\n  `unit` varchar(24) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '计价单位',\n  `unit_price_cents` bigint(20) unsigned DEFAULT NULL COMMENT '单价（分）',\n  `amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '项目金额（分）',\n  `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  KEY `idx_pricing_items_order_sort` (`order_id`,`status`,`sort_order`,`id`),\n  KEY `idx_pricing_items_change` (`change_request_id`),\n  CONSTRAINT `fk_pricing_items_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_pricing_items_change` FOREIGN KEY (`change_request_id`) REFERENCES `change_requests` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单结构化开单明细';\n\nCREATE TABLE IF NOT EXISTS `platform_order_refund_reviews` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '退款财务复核单ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '关联平台承接订单ID',\n  `refund_id` bigint(20) unsigned NOT NULL COMMENT '原真实退款单ID（一退款只处理一次）',\n  `refund_amount_cents` bigint(20) unsigned NOT NULL COMMENT '建档时退款成功金额快照（分）',\n  `worker_labor_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时师傅工费快照（分）',\n  `worker_balance_credit_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时实际应入师傅余额快照（分）',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT 'open待判责、awaiting_recovery待实际追偿、resolved核账结束',\n  `responsibility` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'undetermined' COMMENT 'undetermined待定、platform平台、worker师傅、shared分担',\n  `worker_recovery_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '人工判定应由师傅补交金额（分）',\n  `recovered_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已核对真实到账的线下追偿累计金额（分）',\n  `decision_note` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '责任判定的事实依据',\n  `recovery_reference` varchar(120) COLLATE utf8mb4_bin DEFAULT NULL COMMENT '最近一次已核实的追偿交易流水号（完整逐笔凭证见人工收款台账）',\n  `recovery_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '线下真实追偿核验说明',\n  `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '发起核账管理员ID',\n  `decided_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '判责管理员ID',\n  `resolved_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核实结清管理员ID',\n  `created_at` datetime NOT NULL COMMENT '建档时间',\n  `decided_at` datetime DEFAULT NULL COMMENT '判责时间',\n  `resolved_at` datetime DEFAULT NULL COMMENT '核账结束时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_platform_refund_review_refund` (`refund_id`),\n  UNIQUE KEY `uq_platform_refund_review_recovery` (`recovery_reference`),\n  KEY `idx_platform_refund_review_order_status` (`order_id`,`status`),\n  KEY `idx_platform_refund_review_status_created` (`status`,`created_at`),\n  CONSTRAINT `fk_platform_refund_review_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_platform_refund_review_refund` FOREIGN KEY (`refund_id`) REFERENCES `refunds` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台单已验收后退款资金判责与线下追偿人工核账';\n\nCREATE TABLE IF NOT EXISTS `platform_order_manual_receipts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '实际外部收款凭证ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '所属平台订单',\n  `refund_review_id` bigint(20) unsigned DEFAULT NULL COMMENT '追偿对应退款复核单；平台收入款时为空',\n  `income_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '仅平台收入款填写的订单ID，唯一防重复核销',\n  `receipt_kind` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'platform_income平台收入款、refund_recovery退款追偿',\n  `amount_cents` bigint(20) unsigned NOT NULL COMMENT '本笔人工核验实际到账分数',\n  `payment_reference` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '银行或第三方支付实际收款编号；全类型唯一',\n  `verification_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '人工核实凭据及渠道说明',\n  `verified_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核验管理员ID',\n  `verified_at` datetime NOT NULL COMMENT '实际核验记录时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_manual_receipt_reference` (`payment_reference`),\n  UNIQUE KEY `uq_manual_income_order` (`income_order_id`),\n  KEY `idx_manual_receipt_review` (`refund_review_id`,`verified_at`),\n  KEY `idx_manual_receipt_order` (`order_id`,`verified_at`),\n  CONSTRAINT `fk_manual_receipt_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_manual_receipt_review` FOREIGN KEY (`refund_review_id`) REFERENCES `platform_order_refund_reviews` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台外部收款人工核验逐笔凭证，不代表微信支付或钱包入账';\n\nCREATE TABLE IF NOT EXISTS `chat_staff_authority_versions` (\n  `user_id` bigint(20) unsigned NOT NULL COMMENT '0为管理员配置，其余为真实用户；删除后保留代次',\n  `authority_version` bigint(20) unsigned NOT NULL DEFAULT 1 COMMENT '只增不减，移除再加入不得复用',\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP权限源同事务更新，Go取共享锁校验';\nINSERT IGNORE INTO `chat_staff_authority_versions` (`user_id`,`authority_version`) VALUES (0,1);\nINSERT IGNORE INTO `chat_staff_authority_versions` (`user_id`,`authority_version`) SELECT id,1 FROM users;\n\nCREATE TABLE IF NOT EXISTS `chat_policy_refresh` (\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID，不存消息内容',\n  `checked_at` datetime NOT NULL COMMENT '上次检查UTC',\n  `next_check_at` datetime NOT NULL COMMENT '下一次可检查UTC',\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'success或failed',\n  PRIMARY KEY (`order_id`),\n  KEY `idx_chat_policy_refresh_due` (`next_check_at`,`order_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP授权投影恢复游标，不承担即时撤权';\n\n-- 单语句触发器，覆盖Web/小程序/CLI/SQL维护，且回滚与原身份写入一致。\nDROP TRIGGER IF EXISTS `chat_staff_settings_insert`;\nCREATE TRIGGER `chat_staff_settings_insert` AFTER INSERT ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND NEW.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid');\nDROP TRIGGER IF EXISTS `chat_staff_settings_update`;\nCREATE TRIGGER `chat_staff_settings_update` AFTER UPDATE ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND (OLD.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid') OR NEW.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid'))\nAND (NOT (BINARY OLD.setting_key <=> BINARY NEW.setting_key) OR NOT (BINARY OLD.setting_value <=> BINARY NEW.setting_value) OR NOT (BINARY OLD.value_type <=> BINARY NEW.value_type));\nDROP TRIGGER IF EXISTS `chat_staff_settings_delete`;\nCREATE TRIGGER `chat_staff_settings_delete` AFTER DELETE ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND OLD.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid');\nDROP TRIGGER IF EXISTS `chat_staff_user_insert`;\nCREATE TRIGGER `chat_staff_user_insert` AFTER INSERT ON `users`\nFOR EACH ROW INSERT INTO chat_staff_authority_versions(user_id,authority_version) VALUES(NEW.id,1)\nON DUPLICATE KEY UPDATE authority_version=authority_version+1;\nDROP TRIGGER IF EXISTS `chat_staff_user_update`;\nCREATE TRIGGER `chat_staff_user_update` AFTER UPDATE ON `users`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id IN (OLD.id,NEW.id) AND (NOT (OLD.id <=> NEW.id) OR NOT (OLD.status <=> NEW.status));\nDROP TRIGGER IF EXISTS `chat_staff_user_delete`;\nCREATE TRIGGER `chat_staff_user_delete` AFTER DELETE ON `users`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=OLD.id;\nDROP TRIGGER IF EXISTS `chat_staff_wechat_insert`;\nCREATE TRIGGER `chat_staff_wechat_insert` AFTER INSERT ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=NEW.user_id;\nDROP TRIGGER IF EXISTS `chat_staff_wechat_update`;\nCREATE TRIGGER `chat_staff_wechat_update` AFTER UPDATE ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id IN (OLD.user_id,NEW.user_id)\nAND (NOT (OLD.user_id <=> NEW.user_id) OR NOT (OLD.app_id <=> NEW.app_id) OR NOT (OLD.openid <=> NEW.openid) OR NOT (OLD.status <=> NEW.status));\nDROP TRIGGER IF EXISTS `chat_staff_wechat_delete`;\nCREATE TRIGGER `chat_staff_wechat_delete` AFTER DELETE ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=OLD.user_id;\n\n-- V2.11.0：Go单写会话/成员权限版本区间与事件租约；不创建消息或启用聊天。\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_conversations` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立会话ID，不等于订单ID',\n  `conversation_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前仅order',\n  `scope_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP提供的不可变订单指派作用域',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '可信订单绑定，不直接授予权限',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '不可变指派绑定',\n  `policy_version` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已连续应用的PHP权限版本',\n  `snapshot_hash` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '已应用快照指纹',\n  `episode_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP授权业务区间代次',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'open或readonly；pending仅事务内',\n  `created_at` datetime(6) NOT NULL COMMENT '建立时间UTC',\n  `updated_at` datetime(6) NOT NULL COMMENT '投影更新时间UTC，不是消息活跃时间',\n  `last_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '同会话已提交封闭消息高水位',\n  `last_change_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '同会话已提交封闭变更高水位',\n  `last_message_id` bigint(20) unsigned DEFAULT NULL COMMENT '最后正式消息ID，无待审占位',\n  `last_message_at` datetime(6) DEFAULT NULL COMMENT '最后正式消息提交UTC',\n  `sync_floor_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '消息补收已清理范围上界，不含可补收起点',\n  `change_floor_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '安全变更已清理范围上界，不含可补收起点',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_conversation_scope` (`conversation_type`,`scope_key`),\n  UNIQUE KEY `uq_chat_conversation_binding` (`conversation_type`,`order_id`,`assignment_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写独立会话与可信业务绑定';\n\nCREATE TABLE IF NOT EXISTS `chat_members` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实用户ID，当前仅小程序身份',\n  `actor_kind` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前仅mini，不接受后台审计成员',\n  `role` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'customer/worker/platform_staff',\n  `member_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '包含episode和工作人员配置/用户代次',\n  `can_read` tinyint(1) NOT NULL COMMENT '最近应用快照的读取资格，仍需当前栅栏交集',\n  `can_send` tinyint(1) NOT NULL COMMENT '最近应用快照的发送资格，仍需当前栅栏交集',\n  PRIMARY KEY (`conversation_id`,`actor_id`),\n  KEY `idx_chat_member_actor` (`actor_id`,`can_read`,`conversation_id`),\n  CONSTRAINT `fk_chat_member_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写当前成员投影，不复制用户账号';\n\nCREATE TABLE IF NOT EXISTS `chat_member_intervals` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实用户ID',\n  `member_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '不可变授权身份代次',\n  `start_version` bigint(20) unsigned NOT NULL COMMENT '可读消息权限版本下界，包含',\n  `end_version` bigint(20) unsigned DEFAULT NULL COMMENT '可读消息权限版本上界，不包含；空表示尚未闭合',\n  `open_actor_id` bigint(20) unsigned GENERATED ALWAYS AS (IF(`end_version` IS NULL,`actor_id`,NULL)) STORED COMMENT '每会话每人最多一个未闭合区间',\n  PRIMARY KEY (`conversation_id`,`actor_id`,`start_version`),\n  UNIQUE KEY `uq_chat_interval_open` (`conversation_id`,`open_actor_id`),\n  CONSTRAINT `fk_chat_interval_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写历史授权版本区间，禁止用处理时seq补权';\n\nCREATE TABLE IF NOT EXISTS `chat_event_receipts` (\n  `event_id` char(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP原始不可变事件ID',\n  `aggregate_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原始会话作用域',\n  `aggregate_version` bigint(20) unsigned NOT NULL COMMENT '原始PHP权限版本',\n  `payload_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '领取时原始事件指纹',\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'processing/retry/done/rejected',\n  `attempts` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '领取次数，有界递增',\n  `lease_owner` char(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '每次领取随机独立所有者',\n  `lease_until` datetime(6) DEFAULT NULL COMMENT '服务端租约截止UTC',\n  `next_attempt_at` datetime(6) NOT NULL COMMENT '失败退避后可重试时间UTC',\n  `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '稳定诊断码，不存正文或SQL',\n  `completed_at` datetime(6) DEFAULT NULL COMMENT '与会话投影同事务完成UTC',\n  PRIMARY KEY (`event_id`),\n  UNIQUE KEY `uq_chat_receipt_scope_version` (`aggregate_key`,`aggregate_version`),\n  KEY `idx_chat_receipt_retry` (`status`,`next_attempt_at`),\n  KEY `idx_chat_receipt_lease` (`status`,`lease_until`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写消费回执/租约，PHP事件表只读';\n\n-- V2.12.0 S06 Go单写消息基础，默认关闭\nCREATE TABLE IF NOT EXISTS `chat_restrictions` (\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实mini用户ID，永久稳定锁行，不得删除',\n  `permanent` tinyint(1) NOT NULL DEFAULT '0' COMMENT '永久禁发；不限制合法查询与原业务',\n  `blocked_until` datetime(6) DEFAULT NULL COMMENT '限时禁发截止UTC，空且非永久表示未限制',\n  `version` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '限制变更单调代次，后续管理写入需递增',\n  `updated_at` datetime(6) NOT NULL COMMENT '限制更新时间UTC',\n  PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写账号发送限制与稳定锁，不能按有无禁令加锁';\n\nCREATE TABLE IF NOT EXISTS `chat_send_intents` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '服务端发送意图ID',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '授权会话ID',\n  `client_message_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '10位Unix秒点32位小写hex随机数，不随重试变化',\n  `fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '版本化完整正文结构SHA256，不存被拒绝正文',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'checking/retryable/rejected/accepted',\n  `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '安全稳定诊断码，无规则证据',\n  `message_id` bigint(20) unsigned DEFAULT NULL COMMENT '已提交正式消息ID，拒绝为空',\n  `lease_owner` char(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '当前检查随机所有者，旧所有者不能发布',\n  `lease_until` datetime(6) DEFAULT NULL COMMENT '10秒有界审核所有权截止UTC',\n  `attempts` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '最多8次检查尝试，耗尽不自动换ID补发',\n  `action_expires_at` datetime(6) NOT NULL COMMENT 'ID创建秒加24小时，发布前再次校验',\n  `retain_until` datetime(6) NOT NULL COMMENT '至少动作截止后30天；独立于正文TTL，本阶段不清理',\n  `created_at` datetime(6) NOT NULL COMMENT '首次创建UTC',\n  `updated_at` datetime(6) NOT NULL COMMENT '状态更新时间UTC',\n  `risk_event_id` bigint(20) unsigned DEFAULT NULL COMMENT '风险或疑似复核事件ID，仅本人最小结果返回，不展开证据',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_send_client` (`sender_id`,`conversation_id`,`client_message_id`),\n  KEY `idx_chat_send_pending` (`sender_id`,`state`,`lease_until`),\n  KEY `idx_chat_send_retention` (`retain_until`),\n  CONSTRAINT `fk_chat_send_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写发送意图与最小幂等结果，审核中不占消息seq';\n\nCREATE TABLE IF NOT EXISTS `chat_messages` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立正式消息ID，对外字符串',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `seq` bigint(20) unsigned NOT NULL COMMENT '会话锁内按提交顺序分配，拒绝不占号',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `client_message_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原客户端动作ID',\n  `policy_version` bigint(20) unsigned NOT NULL COMMENT '最终提交时PHP权限版本，不可回填改写',\n  `message_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '本阶段仅text',\n  `text_body` text COLLATE utf8mb4_unicode_ci COMMENT '原始UTF8正文，普通查询必须按安全状态过滤',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'published/recalled/blocked，普通结果不返回正文',\n  `state_version` bigint(20) unsigned NOT NULL DEFAULT '1' COMMENT '安全状态单调版本',\n  `safety_rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '通过必需审核的版本',\n  `created_at` datetime(6) NOT NULL COMMENT '正式发布UTC',\n  `reply_to_message_id` bigint(20) unsigned DEFAULT NULL COMMENT '同会话单层引用，仅服务端安全投影',\n  `edited_from_recalled_message_id` bigint(20) unsigned DEFAULT NULL COMMENT '同作者已撤回直接来源，不可变',\n  `reedit_depth` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '重新编辑来源深度，最多8',\n  `recalled_at` datetime(6) DEFAULT NULL COMMENT '作者撤回提交UTC，正文仅受控证据留存',\n  `reply_to_item_id` bigint(20) unsigned DEFAULT NULL COMMENT '同会话图片合集稳定条目引用',\n  `retention_policy_version` bigint unsigned NOT NULL DEFAULT 0,\n  `retention_mode` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'permanent',\n  `expires_at` datetime(6) DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_message_seq` (`conversation_id`,`seq`),\n  UNIQUE KEY `uq_chat_message_client` (`sender_id`,`conversation_id`,`client_message_id`),\n  KEY `idx_chat_unread` (`conversation_id`,`state`,`seq`,`sender_id`,`policy_version`),\n  KEY idx_chat_message_expiry(expires_at,id),\n  KEY idx_chat_conversation_expiry(conversation_id,expires_at,seq),\n  CONSTRAINT `fk_chat_message_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写已提交消息，无审核占位，历史按权限版本裁剪';\n\nCREATE TABLE IF NOT EXISTS `chat_message_changes` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `change_seq` bigint(20) unsigned NOT NULL COMMENT '会话共享提交锁内分配的封闭变更游标',\n  `message_id` bigint(20) unsigned NOT NULL COMMENT '变更所属正式消息ID',\n  `state_version` bigint(20) unsigned NOT NULL COMMENT '消息安全状态版本',\n  `change_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前message.accepted，后续撤回等同事务追加',\n  `created_at` datetime(6) NOT NULL COMMENT '提交UTC',\n  PRIMARY KEY (`conversation_id`,`change_seq`),\n  CONSTRAINT `fk_chat_change_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`),\n  CONSTRAINT `fk_chat_change_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写消息安全变更，S08再接同步分页接口';\n\n-- V2.13.0 S07 Go单写审核与证据\nCREATE TABLE IF NOT EXISTS `chat_text_checks` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '短窗口检查顺序，同作者稳定锁内登记',\n  `intent_id` bigint(20) unsigned NOT NULL COMMENT '逻辑发送动作ID，重试不追加片段',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '仅限本会话上下文，不跨群跟踪',\n  `fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '完整不可变发送内容指纹',\n  `normalized_text` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '受限业务短窗口证据，不进入普通日志或普通API',\n  `cache_key` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '环境AppID身份代次场景规则及指纹联合去重键',\n  `pass_until` datetime(6) DEFAULT NULL COMMENT '仅明确官方pass缓存五分钟，不延长原判定',\n  `created_at` datetime(6) NOT NULL COMMENT '首次动作登记UTC，重试不刷新窗口',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_text_intent` (`intent_id`),\n  KEY `idx_chat_text_context` (`sender_id`,`conversation_id`,`created_at`,`id`),\n  KEY `idx_chat_text_pass` (`cache_key`,`pass_until`),\n  KEY `idx_chat_text_expiry` (`created_at`),\n  CONSTRAINT `fk_chat_text_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写两分钟最近五动作检测，十分钟后有界清理';\n\nCREATE TABLE IF NOT EXISTS `chat_risk_events` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立风险事件ID，仅作者安全结果可引用',\n  `intent_id` bigint(20) unsigned NOT NULL COMMENT '逻辑发送动作唯一，不因重试累计违规',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '原会话ID',\n  `content_fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原始完整内容结构指纹',\n  `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '完整检测规则版本',\n  `provider` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '官方内容安全或本地私单检测来源',\n  `reason_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '稳定规则码，不向普通接口输出命中详情',\n  `provider_trace` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '受限供应商追踪标识，不存整包响应',\n  `risk_level` tinyint(3) unsigned NOT NULL COMMENT '1疑似待复核，2明确拦截；不直接作财务处置',\n  `confirmed` tinyint(1) NOT NULL COMMENT '仅明确拦截记确认风险；审核故障不建风险',\n  `disposition` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'rejected或review_pending，不自动补发',\n  `review_state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT 'S19复核接续状态，当前无处理接口',\n  `text_evidence` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原文只在受控业务证据中，未来独立权限审计读取',\n  `context_evidence` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '仅拆条命中的有界上下文，含动作ID指纹和规范化片段；普通接口不展开',\n  `retain_until` datetime(6) NOT NULL COMMENT '至少覆盖原动作最小结果保留窗，当前不清理证据',\n  `created_at` datetime(6) NOT NULL COMMENT '与发送者终态同事务提交UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_risk_intent` (`intent_id`),\n  KEY `idx_chat_risk_actor` (`sender_id`,`confirmed`,`created_at`),\n  KEY `idx_chat_risk_review` (`review_state`,`created_at`,`id`),\n  CONSTRAINT `fk_chat_risk_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写风险证据和复核接续；普通API不返回原文，不自动罚款封号';\n\nCREATE TABLE `chat_member_reads` (\n `conversation_id` bigint(20) unsigned NOT NULL,\n `actor_id` bigint(20) unsigned NOT NULL,\n `member_key_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `read_seq` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`conversation_id`,`actor_id`),\n CONSTRAINT `fk_chat_read_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写会话已读水位，身份代次隔离';\n\n-- CHAT_SECTION preferences\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_preference_accounts` (\n `actor_id` bigint(20) unsigned NOT NULL,\n `revision` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写账号偏好修订与并发串行锁，不授予会话权限';\nCREATE TABLE IF NOT EXISTS `chat_user_preferences` (\n `conversation_id` bigint(20) unsigned NOT NULL,\n `actor_id` bigint(20) unsigned NOT NULL,\n `member_key_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `pinned` tinyint(1) NOT NULL DEFAULT 0,\n `pinned_version` bigint(20) unsigned NOT NULL DEFAULT 0,\n `later` tinyint(1) NOT NULL DEFAULT 0,\n `later_version` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`conversation_id`,`actor_id`),\n KEY `idx_chat_preferences_actor` (`actor_id`,`pinned`,`conversation_id`),\n CONSTRAINT `fk_chat_preferences_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写本人置顶和稍后处理，字段独立版本，成员代次隔离';\n-- CHAT_END preferences\n\nCREATE TABLE IF NOT EXISTS `chat_image_uploads` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `actor_id` bigint(20) unsigned NOT NULL,\n `conversation_id` bigint(20) unsigned NOT NULL,\n `upload_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `object_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `source_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `declared_bytes` bigint(20) unsigned NOT NULL,\n `state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `attempts` tinyint(3) unsigned NOT NULL DEFAULT 0,\n `lease_owner` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `lease_until` datetime(6) DEFAULT NULL,\n `source_cleaned` tinyint(1) NOT NULL DEFAULT 0,\n `source_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `main_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `thumb_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `main_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `thumb_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `mime_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `width_px` int unsigned DEFAULT NULL,\n `height_px` int unsigned DEFAULT NULL,\n `method` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `qr_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `qr_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `anti_diversion_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `optional_ocr_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `legal_hold` tinyint(1) NOT NULL DEFAULT 0,\n `expires_at` datetime(6) NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n UNIQUE KEY `uq_chat_image_upload` (`actor_id`,`conversation_id`,`upload_id`),\n UNIQUE KEY `uq_chat_image_object` (`object_version`),\n KEY `idx_chat_image_work` (`state`,`lease_until`,`id`),\n KEY `idx_chat_image_quota` (`actor_id`,`expires_at`),\n CONSTRAINT `fk_chat_image_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写私有图片任务；对象不可覆盖；原图临时保留';\n\nCREATE TABLE IF NOT EXISTS `chat_image_bundles` (\n `intent_id` bigint(20) unsigned NOT NULL,\n `principal_json` text COLLATE utf8mb4_unicode_ci NOT NULL,\n `manifest_json` text COLLATE utf8mb4_unicode_ci NOT NULL,\n `manifest_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `revision` int unsigned NOT NULL,\n `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `review_state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `review_version` bigint(20) unsigned NOT NULL DEFAULT 1,\n `reviewer_id` bigint(20) unsigned DEFAULT NULL,\n `review_lease_until` datetime(6) DEFAULT NULL,\n `general_safety_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `anti_diversion_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `review_reason` varchar(600) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n `submitted_at` datetime(6) NOT NULL,\n `expires_at` datetime(6) NOT NULL,\n PRIMARY KEY (`intent_id`),\n KEY `idx_chat_image_review` (`review_state`,`submitted_at`,`intent_id`),\n CONSTRAINT `fk_chat_image_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写已确认图片发送及整组人工预审；选择上传不建立意图';\n\nCREATE TABLE IF NOT EXISTS `chat_image_items` (\n `message_id` bigint(20) unsigned NOT NULL,\n `item_id` bigint(20) unsigned NOT NULL,\n `ordinal` tinyint(3) unsigned NOT NULL,\n `object_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n PRIMARY KEY (`message_id`,`item_id`),\n UNIQUE KEY `uq_chat_image_ordinal` (`message_id`,`ordinal`),\n KEY `idx_chat_image_reference` (`item_id`),\n CONSTRAINT `fk_chat_image_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`),\n CONSTRAINT `fk_chat_image_item` FOREIGN KEY (`item_id`) REFERENCES `chat_image_uploads` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='一个图片消息下有序不可变条目；item_id为附件ID';\n\nCREATE TABLE IF NOT EXISTS `chat_image_audit` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `intent_id` bigint(20) unsigned NOT NULL,\n `admin_id` bigint(20) unsigned NOT NULL,\n `action` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `item_id` bigint(20) unsigned DEFAULT NULL,\n `review_version` bigint(20) unsigned NOT NULL,\n `manifest_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `reason` varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n KEY `idx_chat_image_audit` (`intent_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go追加图片预审/取件审计，无URL或原文';\n\nCREATE TABLE IF NOT EXISTS `chat_image_objects` (\n `object_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `upload_id` bigint(20) unsigned NOT NULL,\n `sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `created_at` datetime(6) NOT NULL,\n size_bytes bigint unsigned NOT NULL DEFAULT 0,\n storage_class tinyint unsigned NOT NULL DEFAULT 0,\n last_access_at datetime(6) DEFAULT NULL,\n PRIMARY KEY (`object_key`),\n KEY `idx_chat_image_object_age` (`created_at`,`upload_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go处理件清理账本，网络写入前登记';\n\nCREATE TABLE IF NOT EXISTS `chat_image_reports` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `reporter_id` bigint(20) unsigned NOT NULL,\n `conversation_id` bigint(20) unsigned NOT NULL,\n `message_id` bigint(20) unsigned NOT NULL,\n `item_id` bigint(20) unsigned NOT NULL DEFAULT 0,\n `reason` varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n `state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n UNIQUE KEY `uq_chat_image_report` (`reporter_id`,`message_id`,`item_id`),\n KEY `idx_chat_image_report_queue` (`state`,`created_at`,`id`),\n CONSTRAINT `fk_chat_image_report_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go图片单图或整组举报，保留条目顺序，S19接续治理';\n\n-- CHAT_SECTION governance\nCREATE TABLE IF NOT EXISTS chat_mini_auditors (\n user_id bigint unsigned NOT NULL,\n enabled tinyint(1) NOT NULL DEFAULT 0,\n authority_version char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n granted_by bigint unsigned NOT NULL,\n reason varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n updated_at datetime(6) NOT NULL,\n PRIMARY KEY(user_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP独立配置抽检授权，工作人员身份不继承';\nCREATE TABLE IF NOT EXISTS chat_audit_accounts (\n binding char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n updated_at datetime(6) NOT NULL,\n PRIMARY KEY(binding)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go抽检快照配额稳定锁';\nCREATE TABLE IF NOT EXISTS chat_audit_snapshots (\n id char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n binding char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n expires_at datetime(6) NOT NULL,\n PRIMARY KEY(id),KEY idx_chat_audit_expiry(expires_at),KEY idx_chat_audit_binding(binding,expires_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go只含会话元数据的固定活动快照';\nCREATE TABLE IF NOT EXISTS chat_audit_snapshot_items (\n snapshot_id char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n conversation_id bigint unsigned NOT NULL,\n order_id bigint unsigned NOT NULL,\n activity_at datetime(6) NOT NULL,\n PRIMARY KEY(snapshot_id,conversation_id),\n KEY idx_chat_audit_page(snapshot_id,activity_at,conversation_id),\n CONSTRAINT fk_chat_audit_snapshot FOREIGN KEY(snapshot_id) REFERENCES chat_audit_snapshots(id) ON DELETE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='抽检翻页固定排序，不回写个人消息状态';\nCREATE TABLE IF NOT EXISTS chat_governance_audit (\n id bigint unsigned NOT NULL AUTO_INCREMENT,\n actor_kind varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n actor_id bigint unsigned NOT NULL,\n session_binding char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n action varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n conversation_id bigint unsigned DEFAULT NULL,\n target_id bigint unsigned DEFAULT NULL,\n item_id bigint unsigned DEFAULT NULL,\n target_version bigint unsigned DEFAULT NULL,\n reason varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n created_at datetime(6) NOT NULL,\n PRIMARY KEY(id),KEY idx_chat_governance_target(target_id,action,target_version),KEY idx_chat_governance_actor(actor_id,created_at,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go追加抽检/证据/禁聊/复核审计，不含正文或签名URL';\nCREATE TABLE IF NOT EXISTS chat_cases (\n id bigint unsigned NOT NULL AUTO_INCREMENT,\n kind varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n target_type varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n target_id bigint unsigned NOT NULL,\n item_id bigint unsigned NOT NULL DEFAULT 0,\n conversation_id bigint unsigned NOT NULL DEFAULT 0,\n reporter_id bigint unsigned NOT NULL,\n subject_id bigint unsigned NOT NULL,\n target_version bigint unsigned NOT NULL,\n fingerprint char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n reason varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n state varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n version bigint unsigned NOT NULL DEFAULT 1,\n resolution varchar(600) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n reviewer_id bigint unsigned DEFAULT NULL,\n decided_at datetime(6) DEFAULT NULL,\n retain_until datetime(6) NOT NULL,\n created_at datetime(6) NOT NULL,\n PRIMARY KEY(id),\n UNIQUE KEY uq_chat_case(kind,target_type,target_id,item_id,reporter_id,target_version),\n KEY idx_chat_case_owner(reporter_id,id),KEY idx_chat_case_queue(state,id),KEY idx_chat_case_retention(retain_until,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go举报复核申诉，不自动补发或财务处罚';\nINSERT IGNORE INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at)\n SELECT 'review','risk',id,0,conversation_id,sender_id,sender_id,1,content_fingerprint,'内容安全待复核','pending',1,retain_until,created_at FROM chat_risk_events;\nINSERT IGNORE INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at)\n SELECT 'report','message',r.message_id,r.item_id,r.conversation_id,r.reporter_id,m.sender_id,m.state_version,SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256),r.reason,'pending',1,UTC_TIMESTAMP(6)+INTERVAL 30 DAY,r.created_at FROM chat_image_reports r JOIN chat_messages m ON m.id=r.message_id WHERE NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.kind='report' AND c.target_type='message' AND c.target_id=r.message_id AND c.item_id=r.item_id AND c.reporter_id=r.reporter_id);\n-- CHAT_END governance\n\n-- CHAT_SECTION reminders\nCREATE TABLE IF NOT EXISTS chat_reminder_events (\n id bigint unsigned NOT NULL AUTO_INCREMENT,conversation_id bigint unsigned NOT NULL,seq bigint unsigned NOT NULL,\n created_at datetime(6) NOT NULL,processed_at datetime(6) DEFAULT NULL,\n PRIMARY KEY(id),UNIQUE KEY uq_chat_reminder_event(conversation_id,seq),KEY idx_chat_reminder_event_work(processed_at,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go消息提交同事务持久提醒意图，不依赖在线回调';\nCREATE TABLE IF NOT EXISTS chat_reminder_clusters (\n id bigint unsigned NOT NULL AUTO_INCREMENT,conversation_id bigint unsigned NOT NULL,recipient_id bigint unsigned NOT NULL,\n member_hash char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,round_version bigint unsigned NOT NULL,first_seq bigint unsigned NOT NULL,target_seq bigint unsigned NOT NULL,\n first_due_at datetime(6) NOT NULL,first_notified_at datetime(6) DEFAULT NULL,last_notified_seq bigint unsigned NOT NULL DEFAULT 0,\n next_due datetime(6) NOT NULL,rounds tinyint unsigned NOT NULL,state varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,blocked_reason varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(id),UNIQUE KEY uq_chat_reminder_cluster(conversation_id,recipient_id,member_hash),KEY idx_chat_reminder_due(state,next_due,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go首次10秒可配置至30秒，5/15分钟持续复查至多3轮成功';\nCREATE TABLE IF NOT EXISTS chat_reminder_budgets (\n recipient_id bigint unsigned NOT NULL,hour_start datetime NOT NULL,hour_count int unsigned NOT NULL,\n day_start date NOT NULL,day_count int unsigned NOT NULL,PRIMARY KEY(recipient_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go聊天独立账号提醒预算，业务通知不消费';\nCREATE TABLE IF NOT EXISTS chat_reminder_intents (\n id bigint unsigned NOT NULL AUTO_INCREMENT,operation_id char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n cluster_id bigint unsigned NOT NULL,round_version bigint unsigned NOT NULL,round_no tinyint unsigned NOT NULL,\n conversation_id bigint unsigned NOT NULL,recipient_id bigint unsigned NOT NULL,member_hash char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n target_seq bigint unsigned NOT NULL,budget_released tinyint(1) NOT NULL DEFAULT 0,state varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,attempts tinyint unsigned NOT NULL DEFAULT 0,\n next_attempt_at datetime(6) NOT NULL,next_receipt_at datetime(6) DEFAULT NULL,diagnostic varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n created_at datetime(6) NOT NULL,expires_at datetime(6) NOT NULL,\n PRIMARY KEY(id),UNIQUE KEY uq_chat_reminder_operation(operation_id),UNIQUE KEY uq_chat_reminder_round(cluster_id,round_version,round_no),KEY idx_chat_reminder_submit(state,next_attempt_at,id),KEY idx_chat_reminder_receipt(state,next_receipt_at,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go不可变跨PHP操作编号，未知结果同编号查回执';\nCREATE TABLE IF NOT EXISTS chat_reminder_receipts (\n operation_id char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n payload_hash char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n payload_json text COLLATE utf8mb4_unicode_ci NOT NULL,\n state varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n diagnostic varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n outbox_id bigint unsigned DEFAULT NULL,\n created_at datetime(6) NOT NULL,updated_at datetime(6) NOT NULL,\n PRIMARY KEY(operation_id),KEY idx_chat_reminder_receipt_state(state,updated_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP单写接收回执与渠道状态，不复制Go消息';\nCREATE TABLE IF NOT EXISTS chat_internal_nonces (\n nonce_hash char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,expires_at datetime NOT NULL,\n PRIMARY KEY(nonce_hash),KEY idx_chat_nonce_expiry(expires_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP内部HMAC防重放，与用户登录凭证隔离';\n-- CHAT_END reminders\n\nCREATE TABLE IF NOT EXISTS chat_auditor_grant_audit (\n id bigint unsigned NOT NULL AUTO_INCREMENT,user_id bigint unsigned NOT NULL,enabled tinyint(1) NOT NULL,authority_version char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,admin_id bigint unsigned NOT NULL,\n reason varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(id),KEY idx_chat_auditor_grant(user_id,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP追加独立抽检身份授权审计';\n\n-- CHAT_SECTION storage\nCREATE TABLE IF NOT EXISTS chat_storage_policy (\n id tinyint unsigned NOT NULL,revision bigint unsigned NOT NULL,policy_json JSON NOT NULL,\n apply_through_id bigint unsigned NOT NULL DEFAULT 0,updated_by bigint unsigned DEFAULT NULL,updated_at datetime(6) NOT NULL,\n PRIMARY KEY(id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP保存聊天分类型留存与低频配置，Go只读';\nINSERT IGNORE INTO chat_storage_policy(id,revision,policy_json,apply_through_id,updated_at) VALUES(1,1,'{\"schema\":1,\"retention\":{\"text\":{\"mode\":\"permanent\",\"days\":0},\"image\":{\"mode\":\"permanent\",\"days\":0},\"audio\":{\"mode\":\"permanent\",\"days\":0},\"video\":{\"mode\":\"days\",\"days\":60}},\"tiering\":{\"enabled\":false,\"images\":true,\"audio\":true,\"videos\":false,\"age_days\":60,\"idle_days\":30,\"min_bytes\":65536,\"remaining_days\":32,\"batch\":20},\"quota\":{\"video_count\":20,\"video_bytes\":104857600}}',0,UTC_TIMESTAMP(6));\nCREATE TABLE IF NOT EXISTS chat_storage_policy_audit (\n id bigint unsigned NOT NULL AUTO_INCREMENT,revision bigint unsigned NOT NULL,admin_id bigint unsigned NOT NULL,\n policy_json JSON NOT NULL,apply_through_id bigint unsigned NOT NULL,reason varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(id),UNIQUE KEY uq_chat_storage_revision(revision)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP追加保存策略审计，禁止普通Go写入';\nCREATE TABLE IF NOT EXISTS chat_storage_applications (\n revision bigint unsigned NOT NULL,last_message_id bigint unsigned NOT NULL DEFAULT 0,state varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n diagnostic varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,errors int unsigned NOT NULL DEFAULT 0,\n lease_owner char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,lease_until datetime(6) DEFAULT NULL,updated_at datetime(6) NOT NULL,\n PRIMARY KEY(revision)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go有界应用存量保存策略，不直接受PHP改写';\nCREATE TABLE IF NOT EXISTS chat_storage_application_errors (\n revision bigint unsigned NOT NULL,message_id bigint unsigned NOT NULL,code varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(revision,message_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go逐消息记录保存策略未应用原因，不含正文';\n-- CHAT_END storage\n\n-- CHAT_SECTION av\nCREATE TABLE IF NOT EXISTS chat_av_uploads (\n id bigint unsigned NOT NULL AUTO_INCREMENT,actor_id bigint unsigned NOT NULL,conversation_id bigint unsigned NOT NULL,\n upload_id varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,object_version char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n kind varchar(8) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,source varchar(12) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n declared_bytes bigint unsigned NOT NULL,source_md5 char(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,part_count tinyint unsigned NOT NULL,\n state varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,main_key varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n main_sha256 char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,poster_key varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n poster_sha256 char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,mime_type varchar(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n duration_ms int unsigned NOT NULL DEFAULT 0,has_audio tinyint(1) NOT NULL DEFAULT 0,transcript text COLLATE utf8mb4_unicode_ci DEFAULT NULL,asr_metadata JSON DEFAULT NULL,\n legal_hold tinyint(1) NOT NULL DEFAULT 0,error_code varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n expires_at datetime(6) NOT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(id),UNIQUE KEY uq_chat_av_upload(actor_id,conversation_id,upload_id),UNIQUE KEY uq_chat_av_version(object_version),\n KEY idx_chat_av_quota(actor_id,created_at),KEY idx_chat_av_expiry(expires_at,id),\n CONSTRAINT fk_chat_av_conversation FOREIGN KEY(conversation_id) REFERENCES chat_conversations(id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go音视频上传与正式交付，不自动形成消息';\nCREATE TABLE IF NOT EXISTS chat_av_parts (\n upload_id bigint unsigned NOT NULL,ordinal tinyint unsigned NOT NULL,object_key varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n size_bytes int unsigned NOT NULL,grant_until datetime(6) DEFAULT NULL,state varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'allocated',created_at datetime(6) NOT NULL,\n PRIMARY KEY(upload_id,ordinal),UNIQUE KEY uq_chat_av_part_key(object_key),\n CONSTRAINT fk_chat_av_part_upload FOREIGN KEY(upload_id) REFERENCES chat_av_uploads(id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go逐片精确大小直传账本，服务端核验后才能处理';\nCREATE TABLE IF NOT EXISTS chat_av_jobs (\n intent_id bigint unsigned NOT NULL,upload_id bigint unsigned NOT NULL,principal_json text COLLATE utf8mb4_unicode_ci NOT NULL,\n manifest_json text COLLATE utf8mb4_unicode_ci NOT NULL,manifest_hash char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n rule_version varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,configuration_hash char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n phase varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,segments_json JSON DEFAULT NULL,asr_ordinal tinyint unsigned NOT NULL DEFAULT 0,\n transcript text COLLATE utf8mb4_unicode_ci DEFAULT NULL,asr_metadata JSON DEFAULT NULL,source_proof char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n text_rule varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,text_proof char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n raw_trace_id varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,raw_decision varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n review_state varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'waiting',review_version bigint unsigned NOT NULL DEFAULT 1,\n reviewer_id bigint unsigned DEFAULT NULL,review_lease_until datetime(6) DEFAULT NULL,general_confirmed tinyint(1) NOT NULL DEFAULT 0,group_confirmed tinyint(1) NOT NULL DEFAULT 0,\n lease_owner char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,lease_until datetime(6) DEFAULT NULL,\n attempts tinyint unsigned NOT NULL DEFAULT 0,next_attempt_at datetime(6) NOT NULL,error_code varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n expires_at datetime(6) NOT NULL,submitted_at datetime(6) NOT NULL,\n PRIMARY KEY(intent_id),UNIQUE KEY uq_chat_av_confirmed_upload(upload_id),KEY idx_chat_av_work(phase,next_attempt_at,lease_until,intent_id),UNIQUE KEY uq_chat_av_raw_trace(raw_trace_id),\n CONSTRAINT fk_chat_av_job_intent FOREIGN KEY(intent_id) REFERENCES chat_send_intents(id),CONSTRAINT fk_chat_av_job_upload FOREIGN KEY(upload_id) REFERENCES chat_av_uploads(id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go已确认音视频处理状态；外部未知不重发';\nCREATE TABLE IF NOT EXISTS chat_av_objects (\n object_key varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,upload_id bigint unsigned NOT NULL,\n sha256 char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,size_bytes bigint unsigned NOT NULL,role varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n storage_class tinyint unsigned NOT NULL DEFAULT 0,last_access_at datetime(6) DEFAULT NULL,\n tier_lease_owner char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,tier_lease_until datetime(6) DEFAULT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(object_key),KEY idx_chat_av_object_upload(upload_id),KEY idx_chat_av_cold(storage_class,created_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go音视频不可覆盖对象账本；写云前登记';\nCREATE TABLE IF NOT EXISTS chat_av_items (\n message_id bigint unsigned NOT NULL,upload_id bigint unsigned NOT NULL,object_version char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n PRIMARY KEY(message_id),KEY idx_chat_av_item_upload(upload_id),\n CONSTRAINT fk_chat_av_item_message FOREIGN KEY(message_id) REFERENCES chat_messages(id),CONSTRAINT fk_chat_av_item_upload FOREIGN KEY(upload_id) REFERENCES chat_av_uploads(id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go正式音视频引用，过期与证据分别处理';\nCREATE TABLE IF NOT EXISTS chat_av_listens (\n actor_id bigint unsigned NOT NULL,message_id bigint unsigned NOT NULL,first_listened_at datetime(6) NOT NULL,\n PRIMARY KEY(actor_id,message_id),KEY idx_chat_av_listen_message(message_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go本人实际播放完成声明，不替代会话已读';\nCREATE TABLE IF NOT EXISTS chat_av_raw_receipts (\n trace_id varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,app_id varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n decision varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,code varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n fingerprint char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(trace_id),KEY idx_chat_av_receipt_expiry(created_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go微信加密签名回调结果，冲突不放行，无原始用户音频';\nCREATE TABLE IF NOT EXISTS chat_av_asr_requests (\n intent_id bigint unsigned NOT NULL,ordinal tinyint unsigned NOT NULL,request_key char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n state varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,provider_request_id varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n text_result text COLLATE utf8mb4_unicode_ci DEFAULT NULL,source_proof char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n metadata_json JSON DEFAULT NULL,created_at datetime(6) NOT NULL,\n PRIMARY KEY(intent_id,ordinal),UNIQUE KEY uq_chat_av_asr_key(request_key),KEY idx_chat_av_asr_expiry(created_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go先落外部请求状态，未知结果不盲重试，转写按期归并清理';\nCREATE TABLE IF NOT EXISTS chat_av_budgets (\n actor_id bigint unsigned NOT NULL,day_start date NOT NULL,asr_reserved int unsigned NOT NULL DEFAULT 0,PRIMARY KEY(actor_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go全局0行和账号行按序锁定外部识别预算';\n-- CHAT_END av\n\n","server/database/upgrades/1.0.0.sql":"-- 2026-08-14：V1.0.0 是首次安装基线，完整表结构由 server/database/database.sql 创建。\n-- 2026-08-14：在线升级器遇到已经安装的 V1.0.0 时应通过 schema_migrations 校验后跳过本文件。\n-- 2026-08-14：本文件保留为可重复执行的空迁移，便于统一升级包格式，升级器负责写入迁移结果。\n\nSET NAMES utf8mb4;\nSELECT 'V1.0.0 baseline is already provided by database.sql' AS `migration_message`;\n","server/database/upgrades/1.0.1.sql":"-- 2026-08-14：V1.0.1 扩充订单生命周期字段，兼容完整的待退款状态文本。\n-- 2026-08-14：重复执行 MODIFY 不会改变业务数据，适用于异常中断后的人工复核重试。\n\nSET NAMES utf8mb4;\n\nALTER TABLE `orders`\n  MODIFY `lifecycle_status` VARCHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active';\n\nSELECT 'V1.0.1 lifecycle_status expanded to VARCHAR(40)' AS `migration_message`;\n","server/database/upgrades/1.0.2.sql":"-- 2026-08-23：V1.0.2 后台管理体验、类目化订单号、支付配置与演示数据升级。\n-- 2026-08-23：脚本支持 MySQL 5.7.44 并可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_102_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_102_schema`()\nBEGIN\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='service_categories' AND column_name='order_code'\n  ) THEN\n    ALTER TABLE `service_categories`\n      ADD COLUMN `order_code` VARCHAR(8) CHARACTER SET ascii COLLATE ascii_bin NULL AFTER `category_key`;\n  END IF;\n\n  UPDATE `service_categories` SET `order_code`='QZ' WHERE `category_key`='wallpaper';\n  UPDATE `service_categories` SET `order_code`='QB' WHERE `category_key`='wall_cloth';\n  UPDATE `service_categories` SET `order_code`='BLM' WHERE `category_key`='glass_film';\n  UPDATE `service_categories` SET `order_code`='JJM' WHERE `category_key`='furniture_film';\n  UPDATE `service_categories` SET `order_code`='CL' WHERE `category_key`='curtain';\n  UPDATE `service_categories` SET `order_code`='MF' WHERE `category_key`='grout';\n  UPDATE `service_categories`\n    SET `order_code`=CONCAT('C',LEFT(UPPER(CONV(`id`,10,36)),7))\n    WHERE `order_code` IS NULL OR `order_code`='' OR `order_code`='QT';\n\n  ALTER TABLE `service_categories`\n    MODIFY `order_code` VARCHAR(8) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'QT';\n\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.statistics\n    WHERE table_schema=DATABASE() AND table_name='service_categories' AND index_name='uq_service_categories_order_code'\n  ) THEN\n    ALTER TABLE `service_categories`\n      ADD UNIQUE KEY `uq_service_categories_order_code` (`order_code`);\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_102_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_102_schema`;\n\n-- 2026-08-23：新增运营基础设置、微信普通商户 API v3、订阅消息和短信配置。\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('site.name','壁选师傅订单管理系统','string','site',1,'后台及后续小程序接口显示的系统名称',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('site.icp_no','','string','site',1,'网站底部展示的 ICP 备案号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('site.customer_service_phone','','string','site',1,'运营客服电话',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.miniapp_appid','wx8736899b027f2b3b','string','wechat',0,'微信小程序 AppID',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.miniapp_secret','','string','wechat',0,'微信小程序 AppSecret，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.cloud_env','worker-real','string','wechat',0,'旧云开发环境 ID，用于渐进同步',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.subscribe_enabled','false','boolean','notification',0,'是否启用微信订阅消息',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.subscribe_template_ids','{}','json','notification',0,'订阅消息场景与模板 ID 映射',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.enabled','false','boolean','payment',0,'是否启用微信支付真实接口',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.mchid','','string','payment',0,'微信支付普通商户号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.api_v3_key','','string','payment',0,'微信支付 API v3 密钥，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.merchant_serial_no','','string','payment',0,'商户 API 证书序列号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.private_key','','string','payment',0,'商户 API 私钥 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.platform_cert_serial','','string','payment',0,'微信支付平台证书序列号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.platform_certificate','','string','payment',0,'微信支付平台证书 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.notify_url','https://worker.20m.cc/api/wechat/pay/notify','string','payment',0,'预约费支付结果回调地址',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.refund_notify_url','https://worker.20m.cc/api/wechat/refund/notify','string','payment',0,'预约费退款结果回调地址',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.enabled','false','boolean','sms',0,'是否启用短信通知',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.provider','','string','sms',0,'短信服务商标识',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.access_key_id','','string','sms',0,'短信 AccessKey ID，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.access_key_secret','','string','sms',0,'短信 AccessKey Secret，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.sign_name','','string','sms',0,'短信签名',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.template_codes','{}','json','sms',0,'短信场景与模板编码映射',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-23：补充不同业务步骤、待退款、邀请、时间线和订单图片演示数据。\nSET @demo_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\nSET @demo_customer_id=(SELECT `id` FROM `users` WHERE `public_id` LIKE '%DEMO%' ORDER BY `id` LIMIT 1);\nSET @demo_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%' ORDER BY `id` LIMIT 1);\nSET @order_schema_version_id=(SELECT `id` FROM `form_schema_versions` WHERE `status`='published' ORDER BY `id` DESC LIMIT 1);\nSET @category_wallpaper=(SELECT `id` FROM `service_categories` WHERE `category_key`='wallpaper' LIMIT 1);\nSET @category_wall_cloth=(SELECT `id` FROM `service_categories` WHERE `category_key`='wall_cloth' LIMIT 1);\nSET @category_furniture=(SELECT `id` FROM `service_categories` WHERE `category_key`='furniture_film' LIMIT 1);\nSET @category_grout=(SELECT `id` FROM `service_categories` WHERE `category_key`='grout' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-AUDIT-102',@demo_customer_id,@order_schema_version_id,@category_grout,'美缝','待管理员审核的美缝订单（演示）','用户已提交资料，等待管理员审核。','杭州市','余杭区','余杭区未来科技城附近（演示）','张**','138******01','pending','hidden','waiting','unassigned','not_started','unpaid','none','none','active',0,5000,1000,5000,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL\nON DUPLICATE KEY UPDATE `updated_at`=UTC_TIMESTAMP();\nSET @demo_order_audit=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-AUDIT-102' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-PAY-102',@demo_customer_id,@order_schema_version_id,@category_wallpaper,'墙纸','已选报价待付预约费（演示）','用户已选择平台报价，尚未支付 50 元预约费。','杭州市','萧山区','萧山区市心路附近（演示）','张**','138******01','approved','hidden','selected','unassigned','not_started','awaiting_payment','none','none','active',68000,5000,1000,5000,2,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL\nON DUPLICATE KEY UPDATE `updated_at`=UTC_TIMESTAMP();\nSET @demo_order_pay=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-PAY-102' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`assigned_worker_id`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`contact_revealed_at`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-BUILD-102',@demo_customer_id,@order_schema_version_id,@category_wall_cloth,'墙布','师傅施工中的墙布订单（演示）','已电话预约并进场施工，施工前照片为非必填。','杭州市','临平区','临平区南苑附近（演示）','张**','138******01','approved','hidden','selected','info_released','in_progress','paid','none','none','active',@demo_worker_id,120000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 HOUR,4,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL AND @demo_worker_id IS NOT NULL\nON DUPLICATE KEY UPDATE `assigned_worker_id`=VALUES(`assigned_worker_id`),`updated_at`=UTC_TIMESTAMP();\nSET @demo_order_build=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-BUILD-102' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`cancelled_at`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-REFUND-PENDING-102',@demo_customer_id,@order_schema_version_id,@category_furniture,'家具膜','取消后待退款订单（演示）','管理员已同意未上门取消，等待微信退款人工审核。','杭州市','钱塘区','钱塘区金沙大道附近（演示）','张**','138******01','approved','hidden','selected','unassigned','not_started','paid','pending_review','none','cancel_approved_pending_refund',76000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 HOUR,4,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL\nON DUPLICATE KEY UPDATE `refund_status`='pending_review',`lifecycle_status`='cancel_approved_pending_refund',`updated_at`=UTC_TIMESTAMP();\nSET @demo_order_refund_pending=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-REFUND-PENDING-102' LIMIT 1);\n\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`currency`,`amount_cents`,`status`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'PAY-DEMO-PENDING-102','booking_fee',@demo_order_refund_pending,@demo_order_refund_pending,@demo_customer_id,'CNY',5000,'paid','演示待退款预约费',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_order_refund_pending IS NOT NULL\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`status`='paid',`updated_at`=UTC_TIMESTAMP();\nSET @demo_payment_refund_pending=LAST_INSERT_ID();\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`created_at`,`updated_at`)\nSELECT 'REF-DEMO-PENDING-102',@demo_payment_refund_pending,@demo_order_refund_pending,5000,'管理员已同意取消，等待人工审核（演示）','pending_review',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_payment_refund_pending>0\nON DUPLICATE KEY UPDATE `status`='pending_review',`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-23：邀请记录覆盖有效、已领取两种状态，令牌为不可使用的演示哈希。\nSET @demo_hall_order=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-HALL-8K3M2Q7X' LIMIT 1);\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`created_at`)\nSELECT @demo_hall_order,9,1200,5000,'admin_adjustment','分享前调整为 12%（演示）',@demo_admin_id,'active',UTC_TIMESTAMP()-INTERVAL 2 HOUR\nFROM DUAL WHERE @demo_hall_order IS NOT NULL\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`rate_bp`=1200,`status`='active';\nSET @demo_invite_rule=LAST_INSERT_ID();\nINSERT INTO `invite_tokens` (`order_id`,`token_hash`,`purpose`,`created_by_admin_id`,`commission_rule_version_id`,`status`,`max_claims`,`claim_count`,`expires_at`,`created_at`)\nSELECT @demo_hall_order,SHA2('V102_DEMO_INVITE_NOT_USABLE',256),'worker_assignment',@demo_admin_id,@demo_invite_rule,'active',1,0,UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 2 HOUR\nFROM DUAL WHERE @demo_hall_order IS NOT NULL\nON DUPLICATE KEY UPDATE `status`='active',`expires_at`=VALUES(`expires_at`);\n\n-- 2026-08-23：图片文件均为升级包内的压缩演示资源，用于后台图片模块验收。\nINSERT INTO `media_files` (`public_id`,`storage_disk`,`storage_key`,`mime_type`,`extension`,`size_bytes`,`width_px`,`height_px`,`sha256`,`compression_quality`,`status`,`reference_count`,`created_at`) VALUES\n  (LEFT(SHA2('demo-material-102',256),26),'private_local','storage/private/uploads/demo/order-material.png','image/png','png',181195,750,270,'52c6f8f13731acad90f77da0310c7b32a320580094f28817ac9d2842fb7f1874',80,'active',1,UTC_TIMESTAMP()),\n  (LEFT(SHA2('demo-wall-102',256),26),'private_local','storage/private/uploads/demo/order-wall.png','image/png','png',62655,500,400,'8190a8bb9b71229f241af3fef50ce702bc05f613a1bb7fb78d2e77fcaa586fb3',80,'active',1,UTC_TIMESTAMP()),\n  (LEFT(SHA2('demo-completion-102',256),26),'private_local','storage/private/uploads/demo/order-completion.png','image/png','png',18844,200,200,'30e0a1e015bcf26f8d0efff252679ad62449f099f649ce0662e5094f0be37137',80,'active',1,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`status`='active';\nSET @demo_media_material=(SELECT `id` FROM `media_files` WHERE `storage_key`='storage/private/uploads/demo/order-material.png' LIMIT 1);\nSET @demo_media_wall=(SELECT `id` FROM `media_files` WHERE `storage_key`='storage/private/uploads/demo/order-wall.png' LIMIT 1);\nSET @demo_media_completion=(SELECT `id` FROM `media_files` WHERE `storage_key`='storage/private/uploads/demo/order-completion.png' LIMIT 1);\nINSERT IGNORE INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`)\nSELECT @demo_media_material,'order',@demo_hall_order,'material',10,'system',NULL,UTC_TIMESTAMP() FROM DUAL WHERE @demo_hall_order IS NOT NULL\nUNION ALL SELECT @demo_media_wall,'order',@demo_hall_order,'wall',20,'system',NULL,UTC_TIMESTAMP() FROM DUAL WHERE @demo_hall_order IS NOT NULL\nUNION ALL SELECT @demo_media_completion,'order',@demo_order_build,'before_optional',10,'system',NULL,UTC_TIMESTAMP() FROM DUAL WHERE @demo_order_build IS NOT NULL;\n\nINSERT IGNORE INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) VALUES\n  (@demo_order_audit,'order_submitted','demo:102:audit:submitted','user',@demo_customer_id,'{\"message\":\"用户提交订单，等待管理员审核\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n  (@demo_order_pay,'quote_selected','demo:102:pay:selected','user',@demo_customer_id,'{\"message\":\"用户已接受平台报价，等待支付预约费\"}',UTC_TIMESTAMP()-INTERVAL 20 HOUR),\n  (@demo_order_build,'appointment_recorded','demo:102:build:appointment','worker',@demo_worker_id,'{\"message\":\"师傅电话预约上门时间\"}',UTC_TIMESTAMP()-INTERVAL 1 DAY),\n  (@demo_order_build,'work_started','demo:102:build:started','worker',@demo_worker_id,'{\"message\":\"师傅已开始施工\"}',UTC_TIMESTAMP()-INTERVAL 4 HOUR),\n  (@demo_order_refund_pending,'cancel_approved','demo:102:refund:approved','admin',@demo_admin_id,'{\"message\":\"管理员同意取消，预约费进入待退款审核\"}',UTC_TIMESTAMP()-INTERVAL 1 HOUR),\n  (@demo_hall_order,'invite_created','demo:102:invite:created','admin',@demo_admin_id,'{\"message\":\"管理员生成受邀师傅分享记录，服务费 12%\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR);\n\nSELECT 'V1.0.2 admin console, order codes, payment settings and demo workflow upgraded' AS `migration_message`;\n","server/database/upgrades/1.0.3.sql":"-- 2026-08-24：V1.0.3 微信小程序订单、支付退款与师傅结算闭环升级。\n-- 2026-08-24：补充报价快照、配置及演示流程修正，兼容 MySQL 5.7.44，可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_103_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_103_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='quote_versions' AND column_name='commission_rate_bp_snapshot') THEN\n    ALTER TABLE `quote_versions` ADD COLUMN `commission_rate_bp_snapshot` INT UNSIGNED NOT NULL DEFAULT 1000 AFTER `booking_fee_cents`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='quote_versions' AND column_name='commission_min_cents_snapshot') THEN\n    ALTER TABLE `quote_versions` ADD COLUMN `commission_min_cents_snapshot` BIGINT UNSIGNED NOT NULL DEFAULT 5000 AFTER `commission_rate_bp_snapshot`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='quote_versions' AND column_name='rule_acknowledged_at') THEN\n    ALTER TABLE `quote_versions` ADD COLUMN `rule_acknowledged_at` DATETIME NULL AFTER `commission_min_cents_snapshot`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_103_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_103_schema`;\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('app.version','1.0.3','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('commission.payment_due_days','3','integer','finance',0,'订单验收后师傅缴纳平台服务费的期限天数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('withdrawal.minimum_cents','100','integer','finance',0,'师傅单次最低提现金额，单位分',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings` SET `setting_value`='1.0.3',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\n-- 2026-08-23：V1.0.2 的无查询参数回调会被宝塔目录规则送回站点首页，只替换旧默认值，不覆盖商户自行配置。\nUPDATE `system_settings`\nSET `setting_value`='https://worker.20m.cc/api/?route=wechatpay.notify',`description`='支付结果回调地址，须指向同域 API 公开验签路由',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/wechat/pay/notify');\n\nUPDATE `system_settings`\nSET `setting_value`='https://worker.20m.cc/api/?route=wechatpay.refund_notify',`description`='退款结果回调地址，须指向同域 API 公开验签路由',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.refund_notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/wechat/refund/notify');\n\n-- 2026-08-24：统一图片键为相对 storage/private 的 uploads/...，修复旧演示图和后台图片重复拼目录。\nUPDATE `media_files`\nSET `storage_key`=SUBSTRING(`storage_key`,17)\nWHERE `storage_key` LIKE 'storage/private/uploads/%';\n\n-- 2026-08-24：首期不设置“开始施工”动作，旧演示订单改为电话预约后直接等待完工提交。\nUPDATE `orders`\nSET `title`='师傅已预约的墙布订单（演示）',`description`='已电话预约，施工前照片为非必填，完成后直接提交完工照。',`fulfillment_status`='scheduled',`updated_at`=UTC_TIMESTAMP()\nWHERE `public_no`='WO-DEMO-BUILD-102';\n\nUPDATE `order_events`\nSET `event_type`='before_photo_uploaded',`event_key`='demo:103:build:before-photo',`payload_json`='{\"message\":\"师傅上传了非必填施工前照片\"}'\nWHERE `event_key`='demo:102:build:started';\n\n-- 2026-08-24：补一条待平台跟进的尾款延期演示记录，便于升级后直接查看结算异常流程。\nINSERT INTO `offline_payment_delay_requests` (`order_id`,`worker_id`,`amount_cents_snapshot`,`reason`,`expected_collect_at`,`status`,`submitted_at`,`created_at`,`updated_at`)\nSELECT o.`id`,w.`id`,115000,'业主约定三天后补付线下尾款（演示）',UTC_TIMESTAMP()+INTERVAL 3 DAY,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o JOIN `worker_profiles` w ON w.`public_id`='01K2DEMOWORKER000000000001'\nWHERE o.`public_no`='WO-DEMO-BUILD-102'\n  AND NOT EXISTS (SELECT 1 FROM `offline_payment_delay_requests` d WHERE d.`order_id`=o.`id` AND d.`worker_id`=w.`id`);\n\nSELECT 'V1.0.3 mini-program order, WeChat Pay and worker settlement workflow upgraded' AS `migration_message`;\n","server/database/upgrades/1.0.4.sql":"-- 2026-08-24：V1.0.4 微信支付 v2/v3、师傅云资料快照与中文字段字典升级。\n-- 2026-08-24：兼容 MySQL 5.7.44，脚本可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_104_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_104_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='payment_orders' AND column_name='api_version') THEN\n    ALTER TABLE `payment_orders` ADD COLUMN `api_version` VARCHAR(8) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'v3' AFTER `mch_id`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_snapshot_json') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_snapshot_json` LONGTEXT NULL AFTER `cloud_worker_id`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_record_count') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_record_count` INT UNSIGNED NOT NULL DEFAULT 0 AFTER `cloud_snapshot_json`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_record_mode') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_record_mode` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'legacy' AFTER `cloud_record_count`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_last_synced_at') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_last_synced_at` DATETIME NULL AFTER `cloud_record_mode`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_104_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_104_schema`;\n\nCREATE TABLE IF NOT EXISTS `database_field_dictionary` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '字典主键',\n  `table_name` VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '数据表英文名',\n  `field_name` VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '字段英文名',\n  `chinese_name` VARCHAR(80) NOT NULL COMMENT '字段中文名',\n  `description` VARCHAR(255) NOT NULL DEFAULT '' COMMENT '业务说明',\n  `created_at` DATETIME NOT NULL COMMENT '创建时间',\n  `updated_at` DATETIME NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_database_field_dictionary_field` (`table_name`,`field_name`),\n  KEY `idx_database_field_dictionary_chinese` (`chinese_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='数据库字段中文名字典';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','1.0.4','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.api_version','v3','string','payment',0,'新建支付单使用的接口版本：v2 或 v3',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.api_v2_key','','string','payment',0,'微信支付 API v2 密钥，32 位，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.v2_client_certificate','','string','payment',0,'API v2 退款使用的商户证书 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.v2_client_key','','string','payment',0,'API v2 退款使用的证书私钥 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\nUPDATE `system_settings` SET `setting_value`='1.0.4',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\n-- 2026-08-24：API v2 规范要求回调 URL 不携带参数，只替换系统旧默认值，不覆盖商户自定义域名。\nUPDATE `system_settings` SET `setting_value`='https://worker.20m.cc/api/wechatpay/notify',`description`='支付结果回调地址，API v2 不得携带查询参数',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/?route=wechatpay.notify');\nUPDATE `system_settings` SET `setting_value`='https://worker.20m.cc/api/wechatpay/refund-notify',`description`='退款结果回调地址，API v2 不得携带查询参数',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.refund_notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/?route=wechatpay.refund_notify');\n\n-- 2026-08-24：英文物理字段保持 API 稳定，中文名集中维护，可在开发设置中查询。\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('users','id','用户ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','public_id','用户公开编号','对外可展示的用户编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','nickname','用户昵称','微信或本地昵称',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','avatar_url','用户头像','头像地址',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','mobile_masked','脱敏手机号','仅用于展示',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','status','用户状态','账号状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','cloud_user_id','云用户ID','旧云开发 user 记录ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','last_synced_at','最后同步时间','云数据最后同步时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','id','师傅ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','user_id','关联用户ID','一个用户唯一对应一份师傅档案',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','display_name','师傅姓名','师傅对外展示名称',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','verification_status','审核状态','pending/approved/rejected/suspended',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','city','居住城市','师傅居住城市',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','district','居住区县','师傅居住区县',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_worker_id','云师傅主记录ID','当前主记录的云数据库ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_snapshot_json','云资料快照','包含主记录和历史多条记录',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_record_count','云记录数','旧模式留存的 worker 记录数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_record_mode','发布记录模式','unique 或 legacy',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_last_synced_at','云资料同步时间','该师傅资料的最后同步时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','id','订单ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','public_no','订单号','BX+类目拼音码+时间+随机数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','user_id','下单用户ID','订单所属用户',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','category_id','服务类目ID','关联可配置类目',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','title','订单标题','后台和大厅摘要',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','audit_status','审核状态','管理员审核状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','publish_status','大厅发布状态','是否在接单大厅展示',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','quote_status','报价状态','报价选择进度',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','fulfillment_status','施工状态','预约、完工与验收进度',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','payment_status','支付状态','50元预约费状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','refund_status','退款状态','退款审核和入账状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','lifecycle_status','订单生命周期','active/completed/cancelled 等',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','assigned_worker_id','指派师傅ID','当前最终履约师傅',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','final_amount_cents','订单总额（分）','最终确认价格',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','booking_fee_cents','预约费（分）','线上支付预约费',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','commission_rate_bp','服务费比例（万分比）','1000 表示 10%',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('quotes','id','报价ID','报价主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('quotes','quote_type','报价类型','worker 师傅报价或 platform 平台报价',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('quotes','worker_id','报价师傅ID','平台报价可为空',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('quotes','status','报价状态','报价有效状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('payment_orders','id','支付单ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','public_no','商户支付单号','提交给微信支付的唯一单号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','business_type','支付业务类型','booking_fee 或 commission',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','payer_openid','付款人OpenID','小程序付款人',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','mch_id','微信商户号','创建支付单时快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','api_version','支付接口版本','v2 或 v3，退款沿用该值',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','amount_cents','支付金额（分）','不使用浮点数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','status','支付单状态','created/pending/paid/refunded/closed',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','wechat_prepay_id','微信预支付ID','requestPayment 签名使用',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','wechat_transaction_id','微信支付单号','微信交易号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('refunds','id','退款单ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('refunds','public_no','商户退款单号','提交给微信支付的唯一退款号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('refunds','amount_cents','退款金额（分）','本次退款金额',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('refunds','status','退款状态','审核、处理、成功或失败',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('system_settings','setting_key','设置键','程序稳定读取的英文键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('system_settings','setting_value','设置值','敏感值以 AES-GCM 密文保存',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('system_settings','group_name','设置分组','后台分块展示与独立保存',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('form_schemas','schema_key','表单编码','order_submit 为用户下单表单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('form_schemas','current_version','当前编辑版本','可指向未发布草稿',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('form_schema_versions','version_no','表单版本号','按发布版本回退查找',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('form_schema_versions','status','版本状态','draft/published/archived',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V1.0.4 WeChat Pay v2/v3, worker cloud snapshots and Chinese field dictionary upgraded' AS `migration_message`;\n","server/database/upgrades/1.0.5.sql":"-- 2026-08-25：V1.0.5 多类目、实名认证、管理工作台及运营配置升级。\n-- 2026-08-25：兼容 MySQL 5.7.44；DDL 与数据补齐均可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_105_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_105_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='category_names_snapshot') THEN\n    ALTER TABLE `orders` ADD COLUMN `category_names_snapshot` VARCHAR(255) NOT NULL DEFAULT '不确定类目' AFTER `category_name_snapshot`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='is_demo') THEN\n    ALTER TABLE `orders` ADD COLUMN `is_demo` TINYINT UNSIGNED NOT NULL DEFAULT 0 AFTER `version`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_105_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_105_schema`;\n\nCREATE TABLE IF NOT EXISTS `order_categories` (\n  `order_id` BIGINT UNSIGNED NOT NULL,\n  `category_id` BIGINT UNSIGNED NOT NULL,\n  `category_name_snapshot` VARCHAR(80) NOT NULL,\n  `sort_order` INT NOT NULL DEFAULT 0,\n  `created_at` DATETIME NOT NULL,\n  PRIMARY KEY (`order_id`,`category_id`),\n  KEY `idx_order_categories_category` (`category_id`,`order_id`),\n  CONSTRAINT `fk_order_categories_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_categories_category` FOREIGN KEY (`category_id`) REFERENCES `service_categories` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-25：订单多类目关系';\n\nCREATE TABLE IF NOT EXISTS `worker_real_name_verifications` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `worker_id` BIGINT UNSIGNED NOT NULL,\n  `real_name_masked` VARCHAR(80) NOT NULL DEFAULT '',\n  `real_name_ciphertext` TEXT NULL,\n  `id_number_masked` VARCHAR(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '',\n  `id_number_ciphertext` TEXT NULL,\n  `id_number_hmac` CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft',\n  `review_reason` VARCHAR(500) NULL,\n  `reviewed_by` BIGINT UNSIGNED NULL,\n  `submitted_at` DATETIME NULL,\n  `reviewed_at` DATETIME NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_worker_real_name_worker` (`worker_id`),\n  KEY `idx_worker_real_name_status` (`status`,`submitted_at`),\n  CONSTRAINT `fk_worker_real_name_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_real_name_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-25：师傅实名认证';\n\n-- 2026-08-25：旧单首类目自动转入关系表，原字段继续作为兼容字段和订单号类目码来源。\nINSERT IGNORE INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`)\nSELECT `id`,`category_id`,`category_name_snapshot`,0,COALESCE(`created_at`,UTC_TIMESTAMP()) FROM `orders` WHERE `category_id` IS NOT NULL;\nUPDATE `orders` SET `category_names_snapshot`=`category_name_snapshot` WHERE `category_names_snapshot`='' OR `category_names_snapshot`='不确定类目';\nUPDATE `orders` SET `is_demo`=1 WHERE `public_no` LIKE '%DEMO%';\nUPDATE form_fields SET label='是否拆旧翻新',updated_at=UTC_TIMESTAMP() WHERE field_key='is_renovation';\nUPDATE form_fields SET label='现场环境/墙面图片',updated_at=UTC_TIMESTAMP() WHERE field_key='wall_images';\nUPDATE order_answers SET field_label_snapshot='是否拆旧翻新',updated_at=UTC_TIMESTAMP() WHERE field_key_snapshot='is_renovation';\nUPDATE order_answers SET field_label_snapshot='现场环境/墙面图片',updated_at=UTC_TIMESTAMP() WHERE field_key_snapshot='wall_images';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','1.0.5','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.admin_openids','[\"oyAoh5UdSEEWJAQphBD05Uk6DMWg\"]','json','wechat',0,'可进入小程序管理员工作台的 OpenID 列表',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\nUPDATE `system_settings` SET `setting_value`='1.0.5',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\n-- 2026-08-25：运营明确选择明文维护接口密钥；旧密文可继续读取，下一次在后台保存后写为明文。\nUPDATE `system_settings` SET `description`=REPLACE(`description`,'加密保存','明文保存'),`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key` REGEXP '(^wechat\\\\.|^sms\\\\.)' AND `description` LIKE '%加密保存%';\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('orders','category_names_snapshot','服务类目名称','多选类目名称快照，使用顿号分隔',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','is_demo','演示数据','1 表示仅供后台排查流程的演示订单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order_categories','order_id','订单ID','订单多类目关系中的订单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order_categories','category_id','服务类目ID','订单选择的一级类目',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order_categories','category_name_snapshot','类目名称快照','下单时的类目中文名称',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','worker_id','师傅ID','实名认证所属师傅',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','real_name_masked','脱敏姓名','后台列表仅显示脱敏姓名',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','id_number_masked','脱敏身份证号','后台列表仅显示部分身份证号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','status','实名状态','draft/pending/approved/rejected',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-25：只清理带 DEMO 标记的业务链，再生成 V1.0.5 全状态基线；真实用户、真实订单和真实资金记录不受影响。\nDROP TEMPORARY TABLE IF EXISTS `worker_v105_demo_orders`;\nCREATE TEMPORARY TABLE `worker_v105_demo_orders` (`id` BIGINT UNSIGNED NOT NULL PRIMARY KEY) ENGINE=MEMORY\nSELECT `id` FROM `orders` WHERE `is_demo`=1 OR `public_no` LIKE '%DEMO%';\nDROP TEMPORARY TABLE IF EXISTS `worker_v105_demo_withdrawals`;\nCREATE TEMPORARY TABLE `worker_v105_demo_withdrawals` (`id` BIGINT UNSIGNED NOT NULL PRIMARY KEY) ENGINE=MEMORY\nSELECT `id` FROM `withdrawal_requests` WHERE `public_no` LIKE '%DEMO%';\n\nSET @worker_v105_old_fk_checks=@@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\nDELETE FROM `review_media` WHERE `review_id` IN (SELECT `id` FROM `reviews` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `review_replies` WHERE `review_id` IN (SELECT `id` FROM `reviews` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `dispute_evidence` WHERE `dispute_id` IN (SELECT `id` FROM `disputes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `quote_items` WHERE `quote_version_id` IN (SELECT `id` FROM `quote_versions` WHERE `quote_id` IN (SELECT `id` FROM `quotes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`)));\nDELETE FROM `quote_selections` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `quote_versions` WHERE `quote_id` IN (SELECT `id` FROM `quotes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `payment_notifications` WHERE `payment_order_id` IN (SELECT `id` FROM `payment_orders` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\n-- 2026-08-25：MySQL 5.7 同一语句不能二次打开同一个临时表，按关联来源拆成两条幂等删除。\nDELETE FROM `commission_payments` WHERE `receivable_id` IN (SELECT `id` FROM `commission_receivables` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `commission_payments` WHERE `payment_order_id` IN (SELECT `id` FROM `payment_orders` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `change_confirmations` WHERE `change_request_id` IN (SELECT `id` FROM `change_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `order_cancel_decisions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `refunds` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `payment_orders` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `assignment_history` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `commission_receivables` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `reviews` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `disputes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `after_sales` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_cancel_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `completion_submissions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `offline_payment_delay_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `change_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `appointment_records` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `exceptional_arrivals` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_role_grants` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `assignments` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `invite_tokens` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `share_contexts` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `commission_rule_versions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `quotes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_deadlines` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_events` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_revisions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_answers` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_addresses` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_categories` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `media_links` WHERE `entity_type`='order' AND `entity_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `orders` WHERE `id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `withdrawal_allocations` WHERE `withdrawal_request_id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`);\nDELETE FROM `withdrawal_events` WHERE `withdrawal_request_id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`);\nDELETE FROM `worker_payouts` WHERE `withdrawal_request_id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`) OR `public_no` LIKE '%DEMO%';\nDELETE FROM `worker_balance_ledger` WHERE `idempotency_key` LIKE 'demo:%';\nDELETE FROM `withdrawal_requests` WHERE `id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`);\nDELETE FROM `worker_payout_accounts` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%');\nDELETE FROM `media_links` WHERE `entity_type`='worker_verification' AND `entity_id` IN (SELECT `id` FROM `worker_real_name_verifications` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%'));\nDELETE FROM `worker_real_name_verifications` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%');\nDELETE FROM `rating_summaries` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%');\nDELETE FROM `audit_logs` WHERE `request_id` LIKE 'DEMO-%';\nSET FOREIGN_KEY_CHECKS=@worker_v105_old_fk_checks;\n\nSET @demo_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\nSET @order_schema_version_id=(SELECT v.`id` FROM `form_schema_versions` v INNER JOIN `form_schemas` s ON s.`id`=v.`schema_id` WHERE s.`schema_key`='order_submit' AND v.`status`='published' ORDER BY v.`version_no` DESC LIMIT 1);\nSET @category_wallpaper=(SELECT `id` FROM `service_categories` WHERE `category_key`='wallpaper' LIMIT 1);\nSET @category_wall_cloth=(SELECT `id` FROM `service_categories` WHERE `category_key`='wall_cloth' LIMIT 1);\nSET @category_glass_film=(SELECT `id` FROM `service_categories` WHERE `category_key`='glass_film' LIMIT 1);\nSET @category_furniture_film=(SELECT `id` FROM `service_categories` WHERE `category_key`='furniture_film' LIMIT 1);\nSET @category_curtain=(SELECT `id` FROM `service_categories` WHERE `category_key`='curtain' LIMIT 1);\nSET @category_grout=(SELECT `id` FROM `service_categories` WHERE `category_key`='grout' LIMIT 1);\n\nINSERT INTO `users` (`public_id`,`nickname`,`mobile_masked`,`status`,`created_at`,`updated_at`) VALUES\n('01K2DEMOUSER00000000000001','演示业主','138******01','active',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('01K2DEMOWORKER000000000001','演示师傅','139******02','active',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('01K2DEMOPENDING0000000001','待审核演示师傅','137******03','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `nickname`=VALUES(`nickname`),`mobile_masked`=VALUES(`mobile_masked`),`status`='active',`updated_at`=UTC_TIMESTAMP();\nSET @demo_customer_id=(SELECT `id` FROM `users` WHERE `public_id`='01K2DEMOUSER00000000000001' LIMIT 1);\nSET @demo_worker_user_id=(SELECT `id` FROM `users` WHERE `public_id`='01K2DEMOWORKER000000000001' LIMIT 1);\nSET @demo_pending_user_id=(SELECT `id` FROM `users` WHERE `public_id`='01K2DEMOPENDING0000000001' LIMIT 1);\nINSERT INTO `worker_profiles` (`user_id`,`public_id`,`display_name`,`mobile_masked`,`verification_status`,`invited_only`,`city`,`district`,`address_masked`,`lat`,`lng`,`rating`,`completed_orders`,`verified_at`,`verified_by`,`created_at`,`updated_at`) VALUES\n(@demo_worker_user_id,'01K2DEMOWORKERPROFILE00001','王师傅（演示）','139******02','approved',0,'杭州市','西湖区','西湖区文三路附近',30.2741000,120.1551000,5.00,12,UTC_TIMESTAMP(),@demo_admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n(@demo_pending_user_id,'01K2DEMOPENDINGPROFILE001','李师傅（待审核演示）','137******03','pending',0,'杭州市','余杭区','余杭区附近',30.4188000,120.2994000,5.00,0,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `display_name`=VALUES(`display_name`),`verification_status`=VALUES(`verification_status`),`city`=VALUES(`city`),`district`=VALUES(`district`),`updated_at`=UTC_TIMESTAMP();\nSET @demo_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `public_id`='01K2DEMOWORKERPROFILE00001' LIMIT 1);\nSET @demo_pending_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `public_id`='01K2DEMOPENDINGPROFILE001' LIMIT 1);\nSET @demo_role_customer=(SELECT `id` FROM `roles` WHERE `role_key`='customer' LIMIT 1);\nSET @demo_role_worker=(SELECT `id` FROM `roles` WHERE `role_key`='worker' LIMIT 1);\nSET @demo_role_pending=(SELECT `id` FROM `roles` WHERE `role_key`='worker_pending' LIMIT 1);\nINSERT IGNORE INTO `user_roles` (`user_id`,`role_id`,`source`,`granted_by_admin_id`,`created_at`) VALUES\n(@demo_customer_id,@demo_role_customer,'demo_seed',@demo_admin_id,UTC_TIMESTAMP()),\n(@demo_worker_user_id,@demo_role_worker,'demo_seed',@demo_admin_id,UTC_TIMESTAMP()),\n(@demo_pending_user_id,@demo_role_pending,'demo_seed',@demo_admin_id,UTC_TIMESTAMP());\n\n-- 2026-08-25：订单状态覆盖待审核、大厅报价、待支付、履约争议、待验收、已完成、待退款、退款成功、过期和邀请接单。\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,`is_renovation`,`city`,`district`,`address_summary`,`lat`,`lng`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`assigned_worker_id`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`completion_submitted_at`,`accepted_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`) VALUES\n('WO-DEMO-AUDIT-102',@demo_customer_id,@order_schema_version_id,@category_grout,'美缝','美缝','待审核美缝订单（演示）','资料已提交，等待管理员审核。','约 80 米',0,'杭州市','余杭区','未来科技城附近（演示）',30.2800000,120.0200000,'张**','138******01','pending','hidden','waiting','unassigned','not_started','unpaid','none','none','active',NULL,0,5000,1000,5000,NULL,NULL,NULL,NULL,NULL,1,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()),\n('WO-DEMO-HALL-8K3M2Q7X',@demo_customer_id,@order_schema_version_id,@category_wallpaper,'墙纸','墙纸、墙布','墙纸与墙布组合施工（多类目演示）','大厅同时存在师傅报价与平台报价。','约 45 平方米',1,'杭州市','西湖区','文二路附近（演示）',30.2819000,120.1280000,'张**','138******01','approved','published','quoting','unassigned','not_started','unpaid','none','none','active',NULL,0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 6 DAY,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-PAY-102',@demo_customer_id,@order_schema_version_id,@category_wallpaper,'墙纸','墙纸','已选报价待付预约费（演示）','用户已选择报价，等待支付预约费。','约 30 平方米',0,'杭州市','萧山区','市心路附近（演示）',30.1700000,120.2500000,'张**','138******01','approved','hidden','selected_pending_payment','unassigned','not_started','awaiting_payment','none','none','active',NULL,68000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 6 DAY,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-BUILD-102',@demo_customer_id,@order_schema_version_id,@category_wall_cloth,'墙布','墙布','预约施工、尾款延期且有争议（演示）','用户拒绝加价，双方协商未果，等待管理员裁定。','约 90 平方米',1,'杭州市','临平区','南苑附近（演示）',30.4100000,120.3000000,'张**','138******01','approved','hidden','selected','info_released','scheduled','paid','none','open','active',@demo_worker_id,120000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()+INTERVAL 3 DAY,NULL,NULL,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-COMPLETE-105',@demo_customer_id,@order_schema_version_id,@category_curtain,'窗帘','窗帘','师傅已提交完工待验收（演示）','完工照已提交，72 小时后自动验收。','2 套',0,'杭州市','上城区','庆春路附近（演示）',30.2600000,120.1800000,'张**','138******01','approved','hidden','selected','assigned','submitted','paid','none','none','active',@demo_worker_id,90000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 5 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 20 HOUR,NULL,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-DONE-4T8Y6U2A',@demo_customer_id,@order_schema_version_id,@category_glass_film,'玻璃膜','玻璃膜','已验收评价与服务费账单（演示）','用于查看已完成、评价图片和服务费结算。','约 35 平方米',0,'杭州市','滨江区','江南大道附近（演示）',30.2000000,120.2100000,'张**','138******01','approved','hidden','selected','assigned','accepted','paid','none','none','completed',@demo_worker_id,100000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 12 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,7,1,UTC_TIMESTAMP()-INTERVAL 12 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-REFUND-PENDING-102',@demo_customer_id,@order_schema_version_id,@category_furniture_film,'家具膜','家具膜','取消后部分退款待审核（演示）','预约费 50 元，本次拟部分退款 25 元。','1 组',0,'杭州市','钱塘区','金沙大道附近（演示）',30.3000000,120.3500000,'张**','138******01','approved','hidden','selected','unassigned','not_started','paid','pending_review','none','cancel_approved_pending_refund',NULL,76000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-REFUND-7C3B9M5D',@demo_customer_id,@order_schema_version_id,@category_curtain,'窗帘','窗帘','已取消退款成功（演示）','未上门取消，预约费已原路退款。','1 套',0,'杭州市','上城区','湖滨附近（演示）',30.2500000,120.1700000,'张**','138******01','approved','hidden','cancelled','cancelled','cancelled','refunded','succeeded','resolved','cancelled',NULL,60000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 7 DAY,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 3 DAY,6,1,UTC_TIMESTAMP()-INTERVAL 7 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-EXPIRED-105',@demo_customer_id,@order_schema_version_id,NULL,'不确定类目','不确定类目','七天未成交自动取消（演示）','无报价或用户未接受报价，系统已到期取消。','待沟通',NULL,'杭州市','拱墅区','运河附近（演示）',30.3200000,120.1500000,'张**','138******01','approved','hidden','cancelled','unassigned','not_started','unpaid','none','none','expired',NULL,0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,2,1,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-INVITE-105',@demo_customer_id,@order_schema_version_id,@category_wall_cloth,'墙布','墙布','平台报价后邀请师傅待接单（演示）','用户已付预约费，管理员已发出师傅邀请。','约 70 平方米',0,'杭州市','西湖区','古荡附近（演示）',30.2750000,120.1100000,'张**','138******01','approved','hidden','selected','offered','not_started','paid','none','none','active',@demo_pending_worker_id,110000,5000,800,3000,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP());\n\nSET @demo_order_audit=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-AUDIT-102');\nSET @demo_order_hall_id=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-HALL-8K3M2Q7X');\nSET @demo_order_pay=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-PAY-102');\nSET @demo_order_build_id=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-BUILD-102');\nSET @demo_order_complete=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-COMPLETE-105');\nSET @demo_order_done=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-DONE-4T8Y6U2A');\nSET @demo_order_refund_pending_id=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-REFUND-PENDING-102');\nSET @demo_order_refund_done=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-REFUND-7C3B9M5D');\nSET @demo_order_expired=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-EXPIRED-105');\nSET @demo_order_invite=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-INVITE-105');\n\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`) VALUES\n(@demo_order_audit,@category_grout,'美缝',0,UTC_TIMESTAMP()),(@demo_order_pay,@category_wallpaper,'墙纸',0,UTC_TIMESTAMP()),\n(@demo_order_hall_id,@category_wallpaper,'墙纸',0,UTC_TIMESTAMP()),(@demo_order_hall_id,@category_wall_cloth,'墙布',1,UTC_TIMESTAMP()),\n(@demo_order_build_id,@category_wall_cloth,'墙布',0,UTC_TIMESTAMP()),(@demo_order_complete,@category_curtain,'窗帘',0,UTC_TIMESTAMP()),\n(@demo_order_done,@category_glass_film,'玻璃膜',0,UTC_TIMESTAMP()),(@demo_order_refund_pending_id,@category_furniture_film,'家具膜',0,UTC_TIMESTAMP()),\n(@demo_order_refund_done,@category_curtain,'窗帘',0,UTC_TIMESTAMP()),(@demo_order_invite,@category_wall_cloth,'墙布',0,UTC_TIMESTAMP());\n\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment