并为表单版本增加前端展示配置以支持非必填资料折叠。\"\n    },\n    {\n      \"version\": \"2.5.0\",\n      \"name\": \"双维度评价与平台承接单\",\n      \"file\": \"2.5.0.sql\",\n      \"checksum\": \"a8fb5669fafcfbf5ea24afd338c534229b9921e10b5310af611ead60cb871bb3\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"评价拆分为服务态度与施工手艺双维度；平台承接单继续复用统一 orders 内核，新增结构化计价/结算、customer_flow_mode 客户参与方式、平台测量后核价确认衔接，以及默认平台收入比例与余额冻结设置。新增取消行为计分、七天下单限制、原拨号/预约/异常入口信号及客服解除审计表。V2.5.0 迁移同时写入 BXDEMOHALL01-06 六条 is_demo=1 接单大厅审核展示样例，仅补最小订单、类目、测量和平台条件，不创建真实支付、消息、退款、结算或钱包流水。迁移包含 DDL，失败后禁止自动整段重试；兼容已成功执行的经核验历史 checksum：注释差异版，以及正式结构和业务迁移完全一致但未追加可选 BXDEMOHALL 样例的旧版；不重跑历史迁移、不补写演示订单，不放宽当前脚本校验。\",\n      \"retry_failed\": false,\n      \"accepted_applied_checksums\": [\n        \"391814af1a34f7d451664b6640843009175432ab51c3ab1788add73e10b492cd\",\n        \"042fc8d8ea74f95ee5ff410b9ec7e16c3928448a39df72d0a719f31c9a7ab894\"\n      ]\n    },\n    {\n      \"version\": \"2.6.0\",\n      \"name\": \"后台测试中心与可回收场景数据工厂\",\n      \"file\": \"2.6.0.sql\",\n      \"checksum\": \"a5579951d24b766f3d571d1c3a0487c8ec1932f35788a81e6b0c8254e067dc06\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"新增 testing-only 后台测试中心运行元数据、内部预约费模拟事实、测试参与者、媒体归属、消息模拟投影及一次性短期小程序测试入口；支持普通施工/测量、抢单、平台承接、代下单与定向邀请等测试场景的一键生成、真实业务动作、断言、复制、重建和所有权证明式清理。审核展示样例 BXDEMOHALL01-06 始终只读，外部消息只记录应发未投递证据，正式环境写操作硬阻断。迁移包含 DDL，失败后禁止自动整段重试。\"\n    },\n    {\n      \"version\": \"2.7.0\",\n      \"name\": \"订单聊天整包结构与权限、消息及已读基础\",\n      \"file\": \"2.7.0.sql\",\n      \"checksum\": \"ad39ca0eafab23f347caf6a9a71bafefc982be6f425aff12c03c00e38b3557e0\",\n      \"min_php\": \"8.3.36\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"2.6.0之后尚未发布的S01～S17结构收敛为一次2.7.0升级：PHP身份/订单权限/工作人员撤权、Go会话/发送/审核/双游标/已读水位与未读索引、字段独立版本的会话偏好、同会话引用、撤回与有界重新编辑来源、私有图片上传/任务/逐图和整组预审/原子发布与清理账本。各阶段继续修改本未发布包，不按开发单元新增版本。保留全部已发布2.6.0及更早SQL校验值，默认不开启、不回填、不发送；DDL失败不自动整段重跑。\"\n    }\n  ]\n}\n","server/tests/chat_assignment_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseAdminWorkbenchOperationsRepository;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderQuoteSwitchRepository;\nuse WorkerAdmin\\Infrastructure\\Scheduling\\AssignmentTimeoutProcessor;\nuse WorkerAdmin\\Support\\SqlScriptRunner;\n\n// Config/id helpers are fixture ports; business repositories, schema and SQL are real.\nfunction public_id(): string{return strtoupper(bin2hex(random_bytes(13)));}\nfunction setting($key,$default=null){return $default;}\n\n/** Called only by chat_policy_contract.php with its explicit loopback test config. */\nfunction chatAssignmentContract(array $config): void\n{\n    policyAssert($config['host']==='127.0.0.1' && strpos($config['database'],'bixuan_test_policy_')===0,'assignment fixture boundary');\n    $config['database']='mysql';$admin=new Database($config);\n    $name='bixuan_test_policy_assignment_'.bin2hex(random_bytes(5));\n    $admin->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n    $config['database']=$name;$db=new Database($config);\n    try {\n        (new SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n        foreach([10001,10002,10003,10004] as $id)$db->execute(\"INSERT INTO users(id,public_id,status,created_at,updated_at) VALUES(:id,:public_id,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id,'public_id'=>public_id()]);\n        foreach([10=>10002,20=>10003] as $worker=>$user)$db->execute(\"INSERT INTO worker_profiles(id,user_id,public_id,display_name,verification_status,created_at,updated_at) VALUES(:id,:user_id,:public_id,'fixture','approved',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$worker,'user_id'=>$user,'public_id'=>public_id()]);\n        $db->execute(\"INSERT INTO orders(id,public_no,user_id,audit_status,lifecycle_status,payment_status,assignment_status,final_amount_cents,booking_fee_cents,created_at,updated_at) VALUES(77,'CHAT-ASG',10001,'approved','active','paid','accepted',20000,5000,UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        $rule=$db->insert(\"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,status,created_at) VALUES(77,1,1000,1000,'active',UTC_TIMESTAMP())\");\n        $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at) VALUES(100,:public_id,77,10,'admin',:rule,20000,5000,1000,1000,2000,15000,18000,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>public_id(),'rule'=>$rule]);\n        $db->execute(\"UPDATE orders SET current_assignment_id=100,assigned_worker_id=10,commission_rule_version_id=:rule WHERE id=77\",['rule'=>$rule]);\n        $db->execute(\"INSERT INTO order_role_grants(order_id,user_id,grant_type,status,created_at) VALUES(77,10002,'assignment','active',UTC_TIMESTAMP())\");\n        $bridge=new DatabaseOrderConversationBridge($db,true);\n        $db->transaction(static function()use($bridge):void{$bridge->synchronize(77);});\n        $workbench=new DatabaseAdminWorkbenchOperationsRepository($db);\n        $workbench->reassignWorker(['user_id'=>10004],'CHAT-ASG',20,'fixture reassign');\n        $offered=(int)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77');\n        policyAssert($offered!==100 && $db->fetchValue('SELECT status FROM assignments WHERE id=100')==='cancelled','actual admin reassign creates a new assignment');\n        policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='readonly','admin reassign immediately closes old worker chat');\n        policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards WHERE state='open'\")===0,'new offered worker has no chat grant');\n        policyAssert($db->fetchValue(\"SELECT status FROM order_role_grants WHERE order_id=77 AND user_id=10002\")==='revoked','original order access revocation retained');\n        $quote=$db->insert(\"INSERT INTO quotes(public_id,order_id,quote_type,worker_id,amount_cents,booking_fee_cents,status,current_version,created_at,updated_at) VALUES(:public_id,77,'worker',10,20000,5000,'active',1,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>public_id()]);\n        $db->insert(\"INSERT INTO quote_versions(quote_id,version_no,amount_cents,booking_fee_cents,commission_rate_bp_snapshot,commission_min_cents_snapshot,rule_acknowledged_at,operator_type,created_at) VALUES(:quote,1,20000,5000,1000,1000,UTC_TIMESTAMP(),'worker',UTC_TIMESTAMP())\",['quote'=>$quote]);\n        $db->insert(\"INSERT INTO payment_orders(public_no,business_type,business_id,order_id,payer_user_id,amount_cents,status,created_at,updated_at) VALUES('CHAT-PAY','order_booking',77,77,10001,5000,'paid',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        $quotePublic=(string)$db->fetchValue('SELECT public_id FROM quotes WHERE id=:id',['id'=>$quote]);\n        $switch=new DatabaseOrderQuoteSwitchRepository($db);\n        $count=(int)$db->fetchValue('SELECT COUNT(*) FROM assignments');\n        $db->execute(\"CREATE TRIGGER fixture_switch_event_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n        $failed=false;try{$switch->switchWorker(['user_id'=>10001],'CHAT-ASG',$quotePublic,'fixture');}catch(PDOException $error){$failed=($error->errorInfo[1]??0)===1644;}\n        $db->execute('DROP TRIGGER fixture_switch_event_failure');\n        policyAssert($failed && (int)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77')===$offered,'guard failure rolls actual customer switch back');\n        policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM assignments')===$count && $db->fetchValue('SELECT status FROM assignments WHERE id=:id',['id'=>$offered])==='offered','failed switch preserves assignment history and current offer');\n        $switch->switchWorker(['user_id'=>10001],'CHAT-ASG',$quotePublic,'fixture');\n        $current=(int)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77');\n        policyAssert($current!==100 && $current!==$offered && $db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=:id',['id'=>$current])==='open','same original worker returns on independent accepted scope');\n        policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='readonly','returning worker never reopens original scope');\n        policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards WHERE state='open'\")===1,'only one active assignment scope');\n        $workbench->reassignWorker(['user_id'=>10004],'CHAT-ASG',20,'fixture timeout');\n        $expiring=(int)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77');\n        $db->execute('UPDATE assignments SET accept_deadline_at=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 HOUR) WHERE id=:id',['id'=>$expiring]);\n        policyAssert((new AssignmentTimeoutProcessor($db))->expireProduction($expiring),'actual production timeout executes');\n        policyAssert($db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77')===null && $db->fetchValue('SELECT status FROM assignments WHERE id=:id',['id'=>$expiring])==='expired','timeout clears current assignment');\n        policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards WHERE state='open'\")===0,'timeout never invents a grant');\n        echo \"完整新装库的真实管理员改派、客户换回、故障回滚与指派超时验证通过\\n\";\n        require_once __DIR__.'/chat_repair_contract.php';\n        chatRepairEpisodeContract($db);\n        chatPlatformStaffContract($db,$config);\n        require_once __DIR__.'/chat_platform_contract.php';\n        chatPlatformLifecycleContract($db,$config);\n    } finally {$admin->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n}\n\n/** Real source tables from database.sql; no miniature imitation of staff SQL. */\nfunction chatPlatformStaffContract(Database $db,array $config): void\n{\n    $staffReader=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatPlatformStaff($db);\n    $outside=false;try{$staffReader->readLocked();}catch(RuntimeException $error){$outside=true;}\n    policyAssert($outside,'platform staff requires owning transaction');\n    $write=static function(string $key,string $value,string $type='string')use($db):void{\n        $db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,created_at,updated_at)\n            VALUES(:key,:value,:type,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n            ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type=VALUES(value_type)\",['key'=>$key,'value'=>$value,'type'=>$type]);\n    };\n    $identity=static function(int $user,string $app,string $openid,string $status='active')use($db):int{\n        return $db->insert(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at)\n            VALUES(:user,:app,:openid,:status,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['user'=>$user,'app'=>$app,'openid'=>$openid,'status'=>$status]);\n    };\n    $read=static function()use($db,$staffReader):array{return $db->transaction(static function()use($staffReader):array{return $staffReader->readLocked();});};\n    foreach([10101,10102,10103,10104] as $id)$db->execute(\"INSERT INTO users(id,public_id,status,created_at,updated_at) VALUES(:id,:public,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id,'public'=>public_id()]);\n    $write('wechat.miniapp_appid','chat-staff-app');\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\",\"Disabled\",\"WrongApp\"]','json');\n    $identity(10101,'chat-staff-app','StaffA');$identity(10102,'chat-staff-app','StaffB');\n    $identity(10103,'chat-staff-app','Disabled');$identity(10104,'other-app','WrongApp');\n    $db->execute(\"UPDATE users SET status='disabled' WHERE id=10103\");\n    $expected=['10101','10102'];\n    policyAssert(array_column($read(),'actor_id')===$expected,'only current active configured mini identities, bounded and ordered');\n    $write('wechat.admin_openids',\" StaffB，StaffA  StaffA\\n\");\n    policyAssert(array_column($read(),'actor_id')===$expected,'legacy delimiter normalization matches existing mini-admin authority');\n    $write('wechat.admin_openids','[\"StaffA\",\"staffb\"]','json');\n    policyAssert(array_column($read(),'actor_id')===['10101'],'OpenID comparisons are exact, not database case folding');\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\"]','json');\n    $newIdentity=$identity(10101,'chat-staff-app','NonAdminLatest');\n    policyAssert(array_column($read(),'actor_id')===['10102'],'old configured identity cannot override latest active app identity');\n    $db->execute(\"UPDATE wechat_identities SET status='revoked' WHERE id=:id\",['id'=>$newIdentity]);\n    policyAssert(array_column($read(),'actor_id')===$expected,'latest active identity matches original repository rule');\n    foreach([['[[\"StaffA\"]]','json'],['[\"StaffA\",{}]','string'],['{\"broken\"','json'],['enc:v1:unusable','string'],['1','integer']] as [$value,$type]){\n        $write('wechat.admin_openids',$value,$type);policyAssert($read()===[],'invalid configuration fails closed without scalar coercion');\n    }\n    $write('wechat.admin_openids',json_encode(range(1,9)),'json');policyAssert($read()===[],'non-string admin IDs rejected');\n    $write('wechat.admin_openids',json_encode(array_map('strval',range(1,9))),'json');policyAssert($read()===[],'over-budget staff configuration cannot grant partial list');\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\"]','json');\n    $other=new Database($config);\n    $db->transaction(static function(Database $db)use($other,$staffReader):void{\n        $db->fetchValue(\"SELECT setting_value FROM system_settings WHERE setting_key='wechat.admin_openids'\");\n        $other->execute(\"UPDATE system_settings SET setting_value='[\\\"StaffB\\\"]' WHERE setting_key='wechat.admin_openids'\");\n        policyAssert(array_column($staffReader->readLocked(),'actor_id')===['10102'],'configuration source bypasses stale transaction snapshots');\n    });\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\"]','json');\n    $db->transaction(static function(Database $db)use($other,$staffReader,$identity):void{\n        $db->fetchValue('SELECT MAX(id) FROM wechat_identities WHERE user_id=10101');\n        $other->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10101,'chat-staff-app','NewerNonAdmin','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        policyAssert(array_column($staffReader->readLocked(),'actor_id')===['10102'],'latest identity read also bypasses stale transaction snapshots');\n    });\n    $other->execute(\"UPDATE wechat_identities SET status='revoked' WHERE openid='NewerNonAdmin'\");\n    $other->execute('SET SESSION innodb_lock_wait_timeout=1');\n    foreach([\n        \"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\",\n        \"UPDATE wechat_identities SET status='revoked' WHERE user_id=10101 AND openid='StaffA'\",\n        \"UPDATE users SET status='disabled' WHERE id=10101\",\n    ] as $mutation){\n        $db->transaction(static function()use($other,$staffReader,$mutation):void{\n            $staffReader->readLocked();$blocked=false;\n            try{$other->execute($mutation);}catch(PDOException $error){$blocked=($error->errorInfo[1]??0)===1205;}\n            policyAssert($blocked,'source shared locks serialize actual staff revocation mutations');\n        });\n    }\n    policyAssert(array_column($read(),'actor_id')===$expected,'failed concurrent mutation preserves authority');\n    // Actual source/config changes are observable; integration hooks are c3.b.\n    $write('wechat.admin_openids','[\"StaffB\"]','json');\n    policyAssert(array_column($read(),'actor_id')===['10102'],'removed administrator disappears immediately from fresh candidate facts');\n    $db->execute(\"UPDATE wechat_identities SET status='revoked' WHERE user_id=10102 AND openid='StaffB'\");\n    policyAssert($read()===[],'revoked identity cannot create a staff candidate');\n    $platformCount=(int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards g JOIN orders o ON o.id=g.order_id WHERE o.order_source_type='platform'\");\n    policyAssert($platformCount===0,'candidate reader never writes or grants production platform scope');\n    echo \"平台工作人员真实设置/微信身份/状态、最新快照及共享锁专项通过\\n\";\n}\n","server/tests/chat_closure_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Infrastructure\\Persistence\\OrderAutomaticAcceptanceWriter;\nuse WorkerAdmin\\Infrastructure\\Persistence\\SchedulerOrderEventWriter;\n\n/** Reused by chat_policy_contract.php inside its disposable MySQL database. */\nfunction chatClosureContract(Database $db,DatabaseOrderConversationBridge $bridge): void\n{\n    spl_autoload_register(static function(string $class):void {\n        $prefix='WorkerAdmin\\\\';\n        if (strpos($class,$prefix)!==0) return;\n        $file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';\n        if (is_file($file)) require_once $file;\n    });\n    $create=static function(int $id)use($db,$bridge):void {\n        $db->execute(\"INSERT INTO assignments(id,order_id,worker_id,status,accepted_at) VALUES(:id,:id_order,10,'accepted',UTC_TIMESTAMP())\",['id'=>$id,'id_order'=>$id]);\n        $db->execute(\"INSERT INTO orders(id,user_id,is_demo,workflow_profile,order_source_type,lifecycle_status,payment_status,assignment_status,current_assignment_id,assigned_worker_id) VALUES(:id,1,0,'construction','consumer','active','paid','accepted',:assignment,10)\",['id'=>$id,'assignment'=>$id]);\n        $db->transaction(static function()use($bridge,$id):void{$bridge->synchronize($id);});\n        policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=:id',['id'=>$id])==='open','closure fixture starts open');\n    };\n    $classes=['DatabaseOrderCompletionRepository','DatabaseOrderMeasurementCompletionRepository',\n        'DatabaseOrderCancellationRepository','DatabasePaidPaymentSettlement','DatabaseOrderRunEmptyRepository',\n        'DatabaseOrderNegotiationRepository','DatabaseOrderDisputeRepository','DatabaseMiniAdminOrderRepository',\n        'DatabaseOrderInvitationRepository','SchedulerOrderEventWriter',\n        'DatabaseOrderQuoteSwitchRepository','DatabasePaymentCreationRepository'];\n    foreach($classes as $index=>$class) {\n        $id=1000+$index;$create($id);\n        $scope='order:'.$id.':assignment:'.$id;\n        $beforeEvents=(int)$db->fetchValue('SELECT COUNT(*) FROM chat_business_events WHERE aggregate_key=:scope',['scope'=>$scope]);\n        $db->transaction(static function(Database $db)use($class,$id):void {\n            // Only notification delivery is replaced; execute each production SQL event outlet.\n            $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\'.$class);\n            $repository=$reflection->newInstanceWithoutConstructor();\n            if($class==='SchedulerOrderEventWriter') {\n                $repository->record($db,$id,'fixture_closed','fixture_closure',3,[]);\n            } else {\n                $event=$reflection->getMethod('event');$event->setAccessible(true);\n                if(in_array($class,['DatabasePaidPaymentSettlement','DatabasePaymentCreationRepository'],true)) {\n                    $property=$reflection->getProperty('db');$property->setAccessible(true);$property->setValue($repository,$db);\n                    $args=[$id,'fixture_closed','system',0,[]];\n                } elseif($class==='DatabaseOrderNegotiationRepository') {\n                    $args=[$db,['id'=>$id,'user_id'=>1],['user_id'=>1,'worker_id'=>10],'fixture_closed',[]];\n                } elseif(in_array($class,['DatabaseMiniAdminOrderRepository','DatabaseOrderInvitationRepository'],true)) {\n                    $args=[$db,$id,'fixture_closed',1,[]];\n                } else {\n                    $args=[$db,$id,'fixture_closed','system',0,[]];\n                    if(in_array($class,['DatabaseOrderRunEmptyRepository','DatabaseOrderDisputeRepository'],true)) $args[]=false;\n                }\n                $event->invokeArgs($repository,$args);\n            }\n            // The event may precede final order writes. The hook must observe final state.\n            $db->execute(\"UPDATE orders SET lifecycle_status='cancelled',assignment_status='cancelled' WHERE id=:id\",['id'=>$id]);\n            policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=:id',['id'=>$id])==='open','policy writes deferred to outer commit');\n        });\n        policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=:id',['id'=>$id])==='readonly',$class.' closes send permission');\n        policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_business_events WHERE aggregate_key=:scope',['scope'=>$scope])===$beforeEvents+1,$class.' emits one closure');\n        if($class==='SchedulerOrderEventWriter') policyAssert($db->fetchValue('SELECT event_key FROM order_events WHERE order_id=:id',['id'=>$id])==='scheduler:fixture_closure:order:'.$id.':v3','scheduler preserves original deterministic event key');\n    }\n    // Actual automatic acceptance DML, including its callback-independent hook.\n    $db->execute(\"ALTER TABLE orders ADD fulfillment_status VARCHAR(24) DEFAULT 'submitted',ADD version INT DEFAULT 1,ADD completion_submitted_at DATETIME NULL,ADD auto_accept_at DATETIME NULL,ADD accepted_at DATETIME NULL,ADD auto_review_at DATETIME NULL,ADD closed_at DATETIME NULL,ADD updated_at DATETIME NULL\");\n    $db->execute('ALTER TABLE worker_profiles ADD completed_orders INT DEFAULT 0,ADD updated_at DATETIME NULL');\n    $db->execute('CREATE TABLE completion_submissions(order_id BIGINT UNSIGNED,status VARCHAR(24),accepted_at DATETIME NULL,accepted_type VARCHAR(24),updated_at DATETIME NULL) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE order_deadlines(order_id BIGINT UNSIGNED,deadline_type VARCHAR(40),status VARCHAR(24),version INT,due_at DATETIME,created_at DATETIME,updated_at DATETIME,block_reason TEXT,processed_at DATETIME,UNIQUE KEY(order_id,deadline_type)) ENGINE=InnoDB');\n    $events=0;$finance=0;\n    $record=static function(...$args)use(&$events):void{$events++;};\n    $finalize=static function(...$args)use(&$finance):void{$finance++;};\n    $accept=static function(int $id)use($db,$record,$finalize):void {\n        $db->transaction(static function(Database $db)use($id,$record,$finalize):void {\n            $order=$db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE',['id'=>$id]);\n            (new OrderAutomaticAcceptanceWriter())->apply($db,$order,$record,$finalize);\n        });\n    };\n    foreach([1100,1101] as $id) {\n        $create($id);\n        $db->execute(\"UPDATE orders SET completion_submitted_at=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 73 HOUR) WHERE id=:id\",['id'=>$id]);\n        $db->execute(\"INSERT INTO completion_submissions(order_id,status) VALUES(:id,'submitted')\",['id'=>$id]);\n    }\n    $accept(1100);\n    policyAssert($db->fetchValue('SELECT lifecycle_status FROM orders WHERE id=1100')==='completed','automatic acceptance ran actual business writes');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=1100')==='readonly','automatic acceptance closes even with inert event callback');\n    policyAssert($events===1 && $finance===1,'existing callbacks retained, no financial provider called');\n    $db->execute(\"CREATE TRIGGER fixture_accept_event_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;\n    try{$accept(1101);}catch(PDOException $error){$failed=($error->errorInfo[1]??0)===1644;}\n    $db->execute('DROP TRIGGER fixture_accept_event_failure');\n    policyAssert($failed && $db->fetchValue('SELECT lifecycle_status FROM orders WHERE id=1101')==='active','chat failure rolls actual acceptance back');\n    policyAssert($db->fetchValue('SELECT status FROM completion_submissions WHERE order_id=1101')==='submitted','submission update rolled back with acceptance');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=1101')==='open','failed acceptance leaves original guard');\n    $db->execute('ALTER TABLE assignments ADD updated_at DATETIME NULL');\n    $db->execute('ALTER TABLE orders ADD final_amount_cents INT DEFAULT 10000');\n    $db->execute('CREATE TABLE payment_orders(order_id BIGINT UNSIGNED,business_type VARCHAR(40),status VARCHAR(24),amount_cents INT) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE order_measurement_states(order_id BIGINT UNSIGNED PRIMARY KEY,result_status VARCHAR(24),accepted_at DATETIME,settlement_status VARCHAR(24),gross_amount_cents INT,service_rate_bp_snapshot INT,service_min_cents_snapshot INT,service_fee_cents INT,worker_net_cents INT,hold_until DATETIME,max_hold_until DATETIME,settled_at DATETIME,updated_at DATETIME) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE worker_balance_ledger(worker_id BIGINT UNSIGNED,entry_type VARCHAR(40),direction VARCHAR(24),amount_cents INT,available_delta_cents INT,frozen_delta_cents INT,business_type VARCHAR(40),business_id BIGINT UNSIGNED,idempotency_key VARCHAR(128) UNIQUE,description TEXT,status VARCHAR(24),created_at DATETIME) ENGINE=InnoDB');\n    foreach([1200=>'measurement_accepted',1201=>'measurement_auto_accepted'] as $id=>$type) {\n        $create($id);\n        $db->execute(\"UPDATE orders SET workflow_profile='measurement' WHERE id=:id\",['id'=>$id]);\n        $db->execute(\"INSERT INTO payment_orders VALUES(:id,'order_booking','paid',10000)\",['id'=>$id]);\n        $db->execute(\"INSERT INTO order_measurement_states(order_id,result_status) VALUES(:id,'submitted')\",['id'=>$id]);\n        $db->transaction(static function(Database $db)use($id,$type,$record):void {\n            $order=$db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE',['id'=>$id]);\n            $assignment=$db->fetch('SELECT * FROM assignments WHERE id=:id FOR UPDATE',['id'=>$id]);\n            $assignment['commission_rate_bp_snapshot']=1000;\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\OrdinaryMeasurementAcceptanceWriter())->apply($db,$order,$assignment,5,7,30,$record,$type,'fixture');\n        });\n        policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=:id',['id'=>$id])==='readonly',$type.' closes after assignment becomes completed');\n        policyAssert($db->fetchValue('SELECT status FROM assignments WHERE id=:id',['id'=>$id])==='completed','actual measurement assignment completion');\n        policyAssert((int)$db->fetchValue('SELECT frozen_delta_cents FROM worker_balance_ledger WHERE business_id=:id',['id'=>$id])===9000,'actual isolated measurement ledger preserved');\n    }\n    echo \"订单关闭事件出口、真实施工/测量验收与事务回滚验证通过\\n\";\n}\n","server/tests/chat_identity_contract.php":"<?php\n\ndeclare(strict_types=1);\n\n// Standalone PHP 7.4+ contract; optional real MySQL fixture is explicitly opted in.\nrequire_once dirname(__DIR__).'/app/Core/Database.php';\nrequire_once dirname(__DIR__).'/app/Core/Auth.php';\nrequire_once dirname(__DIR__).'/app/Core/Csrf.php';\nrequire_once dirname(__DIR__).'/app/Http/Admin/AdminRequestGuard.php';\nrequire_once dirname(__DIR__).'/app/Application/Chat/ChatCredentialIssuer.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Chat/ChatRecoveryGate.php';\n\nuse WorkerAdmin\\Application\\Chat\\ChatCredentialIssuer;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Http\\Admin\\AdminRequestGuard;\n\n$config = ['enabled'=>true,'key_id'=>'chat-v1','seed_env'=>'CHAT_ACCESS_SEED'];\n\nif (in_array(($argv[1] ?? ''), ['--issue-mini','--issue-admin','--logout-admin'],true)) {\n    if (getenv('CHAT_AUTH_TEST_INTEGRATION') !== '1') exit(2);\n    $host = (string)getenv('CHAT_AUTH_TEST_MYSQL_HOST');\n    $database = (string)getenv('CHAT_AUTH_TEST_MYSQL_DATABASE');\n    if ($host !== '127.0.0.1' || strpos($database, 'bixuan_test_auth_') !== 0) exit(2);\n    $db = new Database(['host'=>$host,'port'=>(int)getenv('CHAT_AUTH_TEST_MYSQL_PORT'),\n        'database'=>$database,'username'=>(string)getenv('CHAT_AUTH_TEST_MYSQL_USER'),\n        'password'=>(string)getenv('CHAT_AUTH_TEST_MYSQL_PASSWORD'),'charset'=>'utf8mb4']);\n    try {\n        $issuer = new ChatCredentialIssuer($db, $config, 'testing');\n        if ($argv[1] === '--issue-mini') {\n            $result = $issuer->exchangeMini((string)getenv('CHAT_AUTH_TEST_LOGIN_TOKEN'));\n        } else {\n            $folder = (string)getenv('CHAT_AUTH_TEST_SESSION_DIR');\n            if (!is_dir($folder)) exit(2);\n            session_save_path($folder);\n            session_id((string)getenv('CHAT_AUTH_TEST_SESSION_ID'));\n            session_start();\n            if ($argv[1] === '--issue-admin') {\n                $_SESSION['admin_id']='2'; $_SESSION['_last_activity']=time();\n                $result = $issuer->exchangeAdmin(new Auth($db));\n            } else {\n                (new Auth($db))->logout(); $result=['revoked'=>true];\n            }\n        }\n        echo json_encode($result, JSON_THROW_ON_ERROR);\n    } catch (Throwable $error) { fwrite(STDERR, \"fixture exchange failed\\n\"); exit(1); }\n    exit;\n}\n\nfunction app_config($key, $default=null) { return $default; }\n\nfinal class ChatIdentityFixtureDatabase extends Database\n{\n    public ?array $row;\n    public int $reads = 0;\n    public ?array $auditGrant = null;\n    public function __construct() { $this->row = ['source_id'=>'7','user_id'=>'18446744073709551615',\n        'token_hash'=>hash('sha256', str_repeat('a',64)),'expires_unix'=>time()+60]; }\n    public function fetch($sql, array $params = []) {\n        $this->reads++;\n        if(strpos($sql,'SELECT authority_version FROM chat_mini_auditors')===0){if(array_keys($params)!==['id'])throw new RuntimeException('unexpected grant access');return $this->auditGrant;}\n        if (strpos($sql, 'SELECT ') !== 0 || array_keys($params) !== ['token_hash']) throw new RuntimeException('unexpected source access');\n        return $this->row;\n    }\n    public function execute($sql, array $params = []) { throw new RuntimeException('identity must never write'); }\n}\n\nfunction ensure(bool $ok, string $message): void { if (!$ok) throw new RuntimeException($message); }\nfunction rejected(callable $fn, int $status): void { try { $fn(); } catch (RuntimeException $e) { ensure($e->getCode() === $status, 'unexpected status'); return; } throw new RuntimeException('unexpected acceptance'); }\n\n$seed = random_bytes(32);\nputenv('CHAT_ACCESS_SEED='.base64_encode($seed));\n$db = new ChatIdentityFixtureDatabase();\n$issuer = new ChatCredentialIssuer($db, $config, 'testing');\n$result = $issuer->exchangeMini(str_repeat('a',64));\n$parts = explode('.', $result['access_token']);\n$decode = static function(string $s): string { return (string)base64_decode(strtr($s,'-_','+/')); };\n$claims = json_decode($decode($parts[1]), true, 32, JSON_THROW_ON_ERROR);\nensure($claims['sub'] === '18446744073709551615' && $claims['source_id'] === '7', 'IDs lost precision');\nensure($claims['env'] === 'test' && $claims['scopes'] === ['chat:use'], 'authority mismatch');\nensure($claims['exp'] <= time()+60 && $claims['exp'] > time(), 'source expiry not respected');\n$public = sodium_crypto_sign_publickey(sodium_crypto_sign_seed_keypair($seed));\nensure(sodium_crypto_sign_verify_detached($decode($parts[2]),$parts[0].'.'.$parts[1],$public), 'signature mismatch');\nrejected(static function() use($issuer): void { $issuer->exchangeMini('invalid'); },401);\nrejected(static function() use($issuer): void { $issuer->exchangeMini(str_repeat('a',64),true); },403);\n$db->auditGrant=['authority_version'=>str_repeat('b',64)];\n$auditResult=$issuer->exchangeMini(str_repeat('a',64),true);\n$auditParts=explode('.',$auditResult['access_token']);\n$auditClaims=json_decode($decode($auditParts[1]),true,32,JSON_THROW_ON_ERROR);\nensure($auditClaims['kind']==='mini_audit'&&$auditClaims['scopes']===['chat:audit'],'mini audit mixed with ordinary authority');\nensure($auditClaims['session_version']===hash('sha256',\"mini-audit-v1\\n7\\n\".$db->row['token_hash'].\"\\n\".$db->row['user_id'].\"\\n\".str_repeat('b',64)),'independent audit generation mismatch');\n$db->auditGrant=['authority_version'=>str_repeat('c',64)];\n$regrant=$issuer->exchangeMini(str_repeat('a',64),true);$regrantParts=explode('.',$regrant['access_token']);$regrantClaims=json_decode($decode($regrantParts[1]),true,32,JSON_THROW_ON_ERROR);\nensure($regrantClaims['session_version']!==$auditClaims['session_version'],'regrant revived previous credential generation');\n$db->row = null;\nrejected(static function() use($issuer): void { $issuer->exchangeMini(str_repeat('a',64)); },401);\n$db->row = ['source_id'=>'1','user_id'=>'1','token_hash'=>str_repeat('a',64),'expires_unix'=>time()+60];\nputenv('CHAT_ACCESS_SEED=bad-secret');\nrejected(static function() use($issuer): void { $issuer->exchangeMini(str_repeat('a',64)); },503);\nrejected(static function() use($db,$config): void { (new ChatCredentialIssuer($db,$config,'test'))->exchangeMini(str_repeat('a',64)); },503);\nrejected(static function() use($db): void { (new ChatCredentialIssuer($db,['enabled'=>false],'production'))->exchangeMini(str_repeat('a',64)); },503);\nputenv('CHAT_ACCESS_SEED');\n\nfinal class ChatResponse extends RuntimeException\n{\n    public array $payload;\n    public function __construct(array $payload,int $status) { parent::__construct('fixture response',$status);$this->payload=$payload; }\n}\nfunction json_response(array $payload,$status=200) { throw new ChatResponse($payload,(int)$status); }\nfunction request_id() { return 'fixture-request'; }\nfinal class ChatGuardAuth extends Auth\n{\n    public bool $loggedIn=true;\n    public bool $changePassword=false;\n    public function __construct() {}\n    public function check() { return $this->loggedIn; }\n    public function user() { return ['must_change_password'=>$this->changePassword]; }\n}\n$guardAuth=new ChatGuardAuth();$guard=new AdminRequestGuard($guardAuth,new Csrf());\n$_SESSION['_csrf_token']=str_repeat('a',64);$_SERVER['REQUEST_METHOD']='POST';$_POST=[];\nrejected(static function()use($guard):void{$guard->inspect('chat.credentials');},403);\n$_SERVER['HTTP_X_CSRF_TOKEN']=str_repeat('a',64);$guard->inspect('chat.credentials');\n$guardAuth->loggedIn=false;rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},401);\n$guardAuth->loggedIn=true;$guardAuth->changePassword=true;rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},403);\n$_SERVER['REQUEST_METHOD']='GET';rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},405);\n$_SESSION=['admin_id'=>'2','chat_admin_session_id'=>'1'];\ntry { (new Auth(new ChatIdentityFixtureDatabase()))->logout(); throw new RuntimeException('logout bypassed revocation failure'); }\ncatch(RuntimeException $error) { ensure(isset($_SESSION['admin_id'],$_SESSION['chat_admin_session_id']), 'failed logout discarded revocation evidence'); }\necho \"聊天身份PHP契约通过\\n\";\n","server/tests/chat_migration_fixture.php":"<?php\n\ndeclare(strict_types=1);\n\n// Minimal policy/identity fixtures use named sections of the actual release\n// package. The full 2.6.0 -> 2.7.0 path is separately tested against real schema.\nfunction chatFixtureMigration(PDO $pdo, string $section): void\n{\n    if (getenv('CHAT_AUTH_TEST_INTEGRATION') !== '1'\n        || !in_array($section,['identity','policy','repair','staff'],true)) {\n        throw new RuntimeException('Explicit isolated chat fixture required');\n    }\n    $sql=(string)file_get_contents(dirname(__DIR__).'/database/upgrades/2.7.0.sql');\n    $start='-- CHAT_SECTION '.$section.\"\\n\";$end='-- CHAT_END '.$section;\n    $parts=explode($start,$sql);\n    if(count($parts)!==2 || count(explode($end,$parts[1]))!==2)throw new RuntimeException('Chat migration section missing');\n    (new \\WorkerAdmin\\Support\\SqlScriptRunner())->run($pdo,explode($end,$parts[1])[0],'2.7.0.sql:'.$section);\n}\n","server/tests/chat_operations_contract.php":"<?php\ndeclare(strict_types=1);\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'){echo \"隔离运行未启用\\n\";exit;}\nrequire_once dirname(__DIR__).'/app/Support/functions.php';\nspl_autoload_register(static function(string $class):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)===0){$file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require_once$file;}});\nrequire_once __DIR__.'/chat_platform_contract.php';\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryCheckpoint;\nuse WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryGate;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterChatActionRunner;\nuse WorkerAdmin\\Contracts\\TestCenterActionRunner;\nfunction operationsEnsure(bool $ok,string $why):void{if(!$ok)throw new RuntimeException($why);}\nfunction operationsReject(callable $call,string $why):void{$failed=false;try{$call();}catch(Throwable $e){$failed=true;}operationsEnsure($failed,$why);}\n$address=(string)(getenv('CHAT_RECOVERY_TEST_MYSQL_ADDR')?:getenv('CHAT_INTEGRATION_MYSQL_ADDR'));\nif(preg_match('/^127\\\\.0\\\\.0\\\\.1:([0-9]+)$/D',$address,$match)!==1)throw new RuntimeException('loopback required');\n$config=['host'=>'127.0.0.1','port'=>(int)$match[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$root=new Database($config);\n$mode=(string)($argv[1]??'');$verification=in_array($mode,['--verify-restored-old','--verify-replayed'],true);$importing=$mode==='--import-report';\n$control=(string)getenv('CHAT_RECOVERY_TEST_CONTROL_DIR');\n$meta=($verification||$importing)?json_decode((string)file_get_contents($control.'/fixture-meta.json'),true):[];\n$name=($verification||$importing)?(string)($meta['database']??''):'bixuan_test_chat_ops_'.bin2hex(random_bytes(6));\nif(preg_match('/^bixuan_test_chat_ops_[a-f0-9]{12}$/D',$name)!==1)throw new RuntimeException('isolated recovery database required');\nif(!$verification&&!$importing)$root->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$GLOBALS['worker_admin_config']=['app'=>['env'=>'testing'],'database'=>$config];$db=db();\n$export=(string)getenv('CHAT_RECOVERY_TEST_CONTROL_DIR');\n$dir=$export!==''?$export:sys_get_temp_dir().'/chat-recovery-'.bin2hex(random_bytes(8));if(!is_dir($dir))mkdir($dir,0700,true);chmod($dir,0700);\n$receiptBody=static function(string $op):string{return json_encode(['cluster_version'=>'1','conversation_id'=>'401','intent_id'=>'1','operation_id'=>$op,'recipient_id'=>'10203','target_seq'=>'2'],JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);};\nif($importing){\n $GLOBALS['worker_admin_config']['chat']=['test_report_revision'=>(string)getenv('CHAT_VERIFIED_SOURCE_REVISION'),'test_report_key_env'=>'CHAT_TEST_REPORT_KEY'];\n $inner=new class implements TestCenterActionRunner{public function available(string $id):array{return['items'=>[]];}public function run(string $id,string $a,array $i,int $u,string $k):array{throw new RuntimeException('inner');}};\n $actions=new DatabaseTestCenterChatActionRunner($db,$inner);$id=str_repeat('T',26);\n $raw=(string)file_get_contents((string)getenv('CHAT_TEST_CENTER_SIGNED_REPORT'));\n $report=['chat_report'=>$raw];\n $first=$actions->run($id,'chat_result_import',$report,1,'chat:report:actual');\n $again=$actions->run($id,'chat_result_import',$report,1,'chat:report:actual');\n operationsEnsure($first['regression_passed']===true&&!empty($again['replayed']),'actual signed Go result did not reach original center');\n $bad=json_decode($raw,true);$bad['mac']=str_repeat('0',64);\n operationsReject(static fn()=>$actions->run($id,'chat_result_import',['chat_report'=>json_encode($bad)],1,'chat:report:tampered'),'tampered Go result accepted');\n $payload=json_decode((string)base64_decode(json_decode($raw,true)['payload']),true);\n $payload['status']='failed';$payload['failed']=[(string)$payload['tests'][0]];\n $failedJson=json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);\n $failedRaw=json_encode(['payload'=>base64_encode($failedJson),'mac'=>hash_hmac('sha256',$failedJson,(string)base64_decode((string)getenv('CHAT_TEST_REPORT_KEY'),true))],JSON_THROW_ON_ERROR);\n $failed=$actions->run($id,'chat_result_import',['chat_report'=>$failedRaw],1,'chat:report:failure-contract');\n operationsEnsure($failed['regression_passed']===false&&$failed['result']==='failed'\n  &&$db->fetchValue('SELECT result FROM test_runs WHERE public_id=:id',['id'=>$failed['run_public_id']])==='failed','failed signed regression incorrectly recorded as passed');\n operationsReject(static fn()=>$actions->run($id,'chat_result_import',['chat_report'=>$failedRaw],1,'chat:report:failure-contract'),'failed result became successful on request replay');\n $GLOBALS['worker_admin_config']['chat']['test_report_revision']=str_repeat('0',40);\n operationsReject(static fn()=>$actions->run($id,'chat_result_import',$report,1,'chat:report:old-source'),'wrong source imported');\n echo \"原测试中心签名Go回归结果登记、同键重试、失败结果留档、篡改和旧源码拒绝验证通过\\n\";exit;\n}\nif($verification){\n $ops=new ChatRecoveryCheckpoint($db->pdo(),'test',str_repeat('k',32),$dir,str_repeat('e',64));\n if($mode==='--verify-restored-old'){\n  operationsEnsure($ops->verify()['status']==='blocked','old backup unexpectedly opened');\n  echo \"旧备份缺少最新撤权及提醒回执，已保持隔离\\n\";exit;\n }\n try{\n  operationsEnsure($ops->verify(true)['status']==='ready','continuous binlog replay differs from final source');\n  operationsEnsure($db->fetchValue('SELECT state FROM chat_messages WHERE id=1')==='recalled'&&$db->fetchValue('SELECT status FROM users WHERE id=10203')==='disabled','replay resurrected recall or removed authority');\n  $before=(int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\");\n  $receipts=new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts($db);\n  operationsEnsure($receipts->receive($receiptBody(str_repeat('a',64)))['state']==='provider_unknown','unknown receipt resurrected');\n  operationsEnsure($receipts->receive($receiptBody(str_repeat('b',64)))['state']==='sent','sent receipt replayed');\n  operationsEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\")===$before,'restore duplicated notification');\n  operationsEnsure((int)$db->fetchValue('SELECT COUNT(*) FROM user_wallet_ledger')===0&&(int)$db->fetchValue('SELECT COUNT(*) FROM worker_balance_ledger')===0,'restore charged wallet');\n  echo \"真实旧备份 + 连续 binlog 恢复、撤权与提醒未知/已发送幂等及无资金副作用验证通过\\n\";\n }finally{$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n exit;\n}\ntry{\n (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n chatPlatformSeed($db);\n $db->execute(\"UPDATE orders SET is_demo=1 WHERE id=401\");\n $id=str_repeat('T',26);\n $db->execute(\"INSERT INTO test_batches(id,public_id,create_request_key,request_digest,app_version,environment,created_by_admin_id) VALUES(1,:public,'chat',REPEAT('a',64),'2.7.0','testing',1)\",['public'=>str_repeat('B',26)]);\n $db->execute(\"INSERT INTO test_instances(id,public_id,batch_id,scenario_key,order_id,order_no_snapshot,params_digest,build_status,created_by_admin_id) VALUES(1,:public,1,'platform.construction',401,'CHAT-PLATFORM-401',REPEAT('a',64),'built',1)\",['public'=>$id]);\n $inner=new class implements TestCenterActionRunner{public function available(string $id):array{return['items'=>[]];}public function run(string $id,string $action,array $input,int $admin,string $key):array{throw new RuntimeException('inner untouched');}};\n $actions=new DatabaseTestCenterChatActionRunner($db,$inner);\n operationsEnsure(isset($actions->available($id)['items']['chat_fixture_export']),'chat not in existing center');\n $first=$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:test:1');\n $again=$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:test:1');\n operationsEnsure(!empty($again['replayed'])&&$again['operation_mode']==='isolated_fixture','fixture retry not durable');\n operationsEnsure($first['business']['tests_executed']===false&&$first['business']['status']==='fixture_ready','fixture claimed real test success');\n operationsEnsure((int)$db->fetchValue('SELECT COUNT(*) FROM test_runs')===1,'fixture duplicate run');\n operationsEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox\")===0,'fixture touched real outbox');\n $json=json_encode($first['business']['fixture'],JSON_THROW_ON_ERROR);\n operationsEnsure(strpos($json,'10202')===false&&strpos($json,'401')===false&&strpos($json,'token')===false,'export contains source identity');\n operationsReject(static fn()=>$actions->run($id,'chat_fixture_export',['chat_suite'=>'http://outside/'],1,'chat:bad'),'unbounded suite');\n $GLOBALS['worker_admin_config']['app']['env']='production';\n operationsEnsure(!isset($actions->available($id)['items']['chat_fixture_export']),'production action visible');\n operationsReject(static fn()=>$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:prod'),'production export ran');\n $GLOBALS['worker_admin_config']['app']['env']='testing';\n $db->execute(\"UPDATE orders SET is_demo=0 WHERE id=401\");\n operationsReject(static fn()=>$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:real'),'real order exported');\n $db->execute(\"UPDATE orders SET is_demo=1 WHERE id=401\");\n $instance=$db->fetch('SELECT * FROM test_instances WHERE id=1');$order=$db->fetch('SELECT * FROM orders WHERE id=401');\n $fixtureDir=(string)getenv('CHAT_TEST_CENTER_FIXTURE_DIR');\n if($fixtureDir!==''){\n  if(!is_dir($fixtureDir))mkdir($fixtureDir,0700,true);\n  foreach(['ordinary'=>['consumer','construction','multi_quote'],'measurement'=>['consumer','measurement','multi_quote'],'single_grab'=>['consumer','construction','single_grab'],'platform'=>['platform','construction','multi_quote']] as $label=>$profile){\n   [$order['order_source_type'],$order['workflow_profile'],$order['dispatch_mode']]=$profile;\n   file_put_contents($fixtureDir.'/'.$label.'.json',json_encode(DatabaseTestCenterChatActionRunner::fixture($instance,$order,'recovery'),JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR));\n  }\n }\n $epoch=str_repeat('e',64);$key=str_repeat('k',32);$ops=new ChatRecoveryCheckpoint($db->pdo(),'test',$key,$dir,$epoch);\n $gate=['recovery_gate_file'=>$dir.'/gate.json','recovery_epoch'=>$epoch];\n operationsEnsure(!ChatRecoveryGate::ready($gate,'test'),'missing gate ready');\n $ops->block();\n $db->execute(\"INSERT INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at) VALUES('appeal','restriction',10203,0,0,10203,10203,1,REPEAT('c',64),'审计保留','pending',1,UTC_TIMESTAMP()+INTERVAL 30 DAY,UTC_TIMESTAMP())\");\n for($i=0;$i<102;$i++)$db->execute(\"INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,reason,created_at) VALUES('system',10202,REPEAT('a',64),'fixture.expired','过期审计',UTC_TIMESTAMP()-INTERVAL 400 DAY)\");\n $db->execute(\"INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,reason,created_at) VALUES('system',10203,REPEAT('a',64),'fixture.hold','争议保留',UTC_TIMESTAMP()-INTERVAL 400 DAY)\");\n $prune=$ops->pruneAudit();operationsEnsure($prune['audit']['chat_governance_audit']['scanned']===100,'unbounded audit cleanup');\n $ops->pruneAudit();\n operationsEnsure((int)$db->fetchValue('SELECT COUNT(*) FROM chat_governance_audit')===1,'held audit removed or old audit uncollected');\n $db->execute(\"INSERT INTO chat_conversations(id,conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,last_seq,last_change_seq,created_at,updated_at) VALUES(1,'order','restore-fixture',401,401,1,REPEAT('a',64),'restore-fixture','open',1,1,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\");\n $db->execute(\"INSERT INTO chat_messages(id,conversation_id,seq,sender_id,client_message_id,policy_version,message_type,text_body,state,state_version,safety_rule_version,created_at) VALUES(1,1,1,10202,CONCAT('1700000000.',REPEAT('a',32)),1,'text','隔离恢复证据','published',1,'restore-fixture',UTC_TIMESTAMP(6))\");\n $db->execute(\"INSERT INTO chat_send_intents(id,sender_id,conversation_id,client_message_id,fingerprint,state,message_id,action_expires_at,retain_until,created_at,updated_at) VALUES(1,10202,1,CONCAT('1700000000.',REPEAT('a',32)),REPEAT('a',64),'accepted',1,UTC_TIMESTAMP()+INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 31 DAY,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\");\n $db->execute(\"INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(1,1,1,1,'message.accepted',UTC_TIMESTAMP(6))\");\n $receipts=new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts($db);\n $receipts->receive($receiptBody(str_repeat('a',64)));\n $db->execute(\"UPDATE chat_reminder_receipts SET state='provider_unknown',diagnostic='provider_unknown' WHERE operation_id=REPEAT('a',64)\");\n $db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP() WHERE topic='chat_reminder'\");\n $capture=$ops->capture();\n operationsEnsure($capture['status']==='captured'&&count($ops->facts())===count(ChatRecoveryCheckpoint::queries()),'real MySQL snapshot');\n operationsEnsure($ops->verify()['status']==='verified','matching checkpoint rejected');\n operationsReject(static fn()=>$ops->verify(true),'missing independent increment evidence released');\n $old=file_get_contents($dir.'/checkpoint.json');if($export!==''){file_put_contents($dir.'/backup-checkpoint.json',$old);chmod($dir.'/backup-checkpoint.json',0640);}\n if($export!==''){\n  file_put_contents($dir.'/fixture-meta.json',json_encode(['database'=>$name],JSON_THROW_ON_ERROR));chmod($dir.'/fixture-meta.json',0640);\n  $backup=(string)getenv('CHAT_RECOVERY_TEST_BACKUP_PATH');\n  if($backup==='')throw new RuntimeException('explicit private backup path required');\n  $process=proc_open(['docker','exec','-e','MYSQL_PWD=s14-fixture-only','bxchat-recovery','mysqldump','-uroot','--single-transaction','--hex-blob','--routines','--triggers','--set-gtid-purged=OFF','--databases',$name],[0=>['pipe','r'],1=>['file',$backup,'w'],2=>['pipe','w']],$pipes);\n  if(!is_resource($process))throw new RuntimeException('isolated backup unavailable');\n  fclose($pipes[0]);stream_get_contents($pipes[2]);fclose($pipes[2]);\n  if(proc_close($process)!==0||!chmod($backup,0600))throw new RuntimeException('isolated backup failed');\n }\n $db->transaction(static function(Database $db):void{\n  $db->fetch('SELECT id FROM chat_conversations WHERE id=1 FOR UPDATE');\n  $db->execute(\"UPDATE chat_messages SET state='recalled',state_version=2,recalled_at=UTC_TIMESTAMP(6) WHERE id=1\");\n  $db->execute(\"INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(1,2,1,2,'message.recalled',UTC_TIMESTAMP(6))\");\n  $db->execute('UPDATE chat_conversations SET last_change_seq=2 WHERE id=1');\n });\n $receipts->receive($receiptBody(str_repeat('b',64)));\n $db->execute(\"UPDATE chat_reminder_receipts SET state='sent',diagnostic='sent' WHERE operation_id=REPEAT('b',64)\");\n $db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP() WHERE topic='chat_reminder'\");\n\n operationsEnsure($ops->verify()['status']==='blocked','post-backup recall and receipt changes not detected');\n $db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");$ops->capture();\n $new=file_get_contents($dir.'/checkpoint.json');\n $authority=$db->fetchAll('SELECT user_id,authority_version FROM chat_staff_authority_versions ORDER BY user_id');\n file_put_contents($dir.'/checkpoint.json',$old);\n operationsReject(static fn()=>$ops->verify(),'old signed checkpoint accepted');\n file_put_contents($dir.'/checkpoint.json',$new);\n $db->execute(\"UPDATE users SET status='active' WHERE id=10203\");\n $mismatch=$ops->verify();\n operationsEnsure($mismatch['status']==='blocked'&&in_array('users',$mismatch['mismatched_tables'],true)&&!ChatRecoveryGate::ready($gate,'test'),'restored old authority reopened');\n $db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");\n foreach($authority as $row)$db->execute('UPDATE chat_staff_authority_versions SET authority_version=:version WHERE user_id=:user',['version'=>$row['authority_version'],'user'=>$row['user_id']]);\n // A separate archive validator supplies this HMAC proof; this fixture models a\n // complete verified archive, never a live channel or an automatic success fallback.\n $sealed=json_decode($new,true);$proof=['schema'=>1,'environment'=>'test','epoch'=>$epoch,'watermark'=>$sealed['payload']['watermark'],'complete'=>true];\n $encode=static fn(array $v):string=>(string)json_encode($v,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR);\n $continuity=['payload'=>$proof,'mac'=>hash_hmac('sha256',$encode($proof),$key)];\n file_put_contents($dir.'/continuity.json',$encode($continuity));chmod($dir.'/continuity.json',0640);\n operationsEnsure($ops->verify(true)['status']==='ready'&&ChatRecoveryGate::ready($gate,'test')&&!ChatRecoveryGate::ready($gate,'production'),'verified gate/environment');\n $ops->block();$db->execute(\"UPDATE users SET status='active' WHERE id=10203\");\n operationsEnsure($ops->verify()['status']==='blocked','post-checkpoint permission loss not detected');\n operationsEnsure(!ChatRecoveryGate::ready($gate,'test'),'failed verification reopened gate');\n if($export!==''){$db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");$ops->capture();}\n echo \"S21 测试中心实例/请求键/生产隔离、S22 MySQL 安全指纹/旧检查点/增量缺口/恢复门禁验证通过\\n\";\n}finally{\n if($export==='')$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');\n if($export===''){foreach(['gate.json','checkpoint.json','latest.json','continuity.json','maintenance.jsonl','audit-progress.json'] as $file)if(is_file($dir.'/'.$file))unlink($dir.'/'.$file);rmdir($dir);}\n}\n","server/tests/chat_platform_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatPolicyMaintenance;\n\n/** Reused by the PHP and Go real-MySQL suites; no copied application SQL. */\nfunction chatPlatformSeed(Database $db): void\n{\n    foreach([10201=>'active',10202=>'active',10203=>'active',10204=>'platform_unbound'] as $id=>$status){\n        $db->execute(\"INSERT INTO users(id,public_id,status,created_at,updated_at) VALUES(:id,:public,:status,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id,'public'=>public_id(),'status'=>$status]);\n    }\n    $db->execute(\"INSERT INTO worker_profiles(id,user_id,public_id,display_name,verification_status,created_at,updated_at) VALUES(30,10202,:public,'测试师傅','approved',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>public_id()]);\n    foreach(['wechat.miniapp_appid'=>'chat-platform-app','wechat.admin_openids'=>'[\"PlatformStaff\"]'] as $key=>$value){\n        $db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,created_at,updated_at)\n            VALUES(:key,:value,'string',UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type='string'\",['key'=>$key,'value'=>$value]);\n    }\n    $db->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10203,'chat-platform-app','PlatformStaff','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    foreach([401=>'construction',402=>'construction',403=>'measurement',404=>'construction',405=>'construction',406=>'construction'] as $id=>$profile){\n        $bound=in_array($id,[402,404],true);$ordinary=$id===404;$unassigned=$id===406;$offered=$id===405;\n        $db->execute(\"INSERT INTO orders(id,public_no,user_id,workflow_profile,order_source_type,audit_status,publish_status,lifecycle_status,payment_status,assignment_status,booking_fee_cents,final_amount_cents,quote_deadline_at,created_at,updated_at)\n            VALUES(:id,:no,:user,:profile,:source,'approved',:publish,:life,:payment,:assignment,0,12000,UTC_TIMESTAMP()+INTERVAL 1 DAY,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['id'=>$id,'no'=>'CHAT-PLATFORM-'.$id,'user'=>$bound?10201:10204,'profile'=>$profile,'source'=>$ordinary?'consumer':'platform','publish'=>$unassigned?'published':'hidden','life'=>$ordinary?'completed':'active','payment'=>$ordinary?'paid':'not_required','assignment'=>$unassigned?'unassigned':($offered?'offered':'accepted')]);\n        if(!$ordinary)$db->execute(\"INSERT INTO order_platform_terms(order_id,customer_flow_mode,customer_contract_total_cents,worker_labor_cents,created_at,updated_at) VALUES(:id,'platform_managed',12000,10000,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id]);\n        if($unassigned)continue;\n        $rule=$db->insert(\"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,status,created_at) VALUES(:id,1,0,0,'active',UTC_TIMESTAMP())\",['id'=>$id]);\n        $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at)\n            VALUES(:id,:public,:order_id,30,'admin',:rule,10000,0,0,0,0,10000,10000,:status,UTC_TIMESTAMP(),:accepted,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['id'=>$id,'public'=>public_id(),'order_id'=>$id,'rule'=>$rule,'status'=>$offered?'offered':'accepted','accepted'=>$offered?null:gmdate('Y-m-d H:i:s')]);\n        $db->execute('UPDATE orders SET current_assignment_id=:assignment,assigned_worker_id=30 WHERE id=:id',['assignment'=>$id,'id'=>$id]);\n    }\n}\n\nfunction chatPlatformLifecycleContract(Database $db,array $config): void\n{\n    chatPlatformSeed($db);$bridge=new DatabaseOrderConversationBridge($db,true);\n    $sync=static function(int $id)use($db,$bridge):array{return $db->transaction(static function()use($bridge,$id):array{return $bridge->synchronize($id);});};\n    $snapshot=static function(int $id)use($db):array{return json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=:id ORDER BY id DESC LIMIT 1',['id'=>$id]),true,32,JSON_THROW_ON_ERROR);};\n    $maintenance=new DatabaseChatPolicyMaintenance($db);\n    policyAssert($maintenance->preflight()['revocation_triggers']===9,'enablement check verifies real trigger sources and authority seeds');\n    $db->execute('DROP TRIGGER chat_staff_wechat_update');\n    $rejected=false;try{$maintenance->backfill(400,2,false);}catch(RuntimeException $error){$rejected=true;}\n    policyAssert($rejected,'missing revocation trigger blocks preview/apply, not a permissive fallback');\n    require_once __DIR__.'/chat_migration_fixture.php';chatFixtureMigration($db->pdo(),'staff');\n    $before=(int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards');\n    $preview=$maintenance->backfill(400,2,false);\n    policyAssert($preview['scanned']===2 && $preview['has_more'] && $preview['next_after']===402,'bounded dry-run and stable resumable cursor');\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards')===$before,'dry-run performs no policy/event/refresh writes');\n    $maintenance->backfill(400,100,true);\n    policyAssert($snapshot(401)['schema_version']===2 && array_column($snapshot(401)['members'],'actor_id')===['10202','10203'],'real unbound platform scope has worker and named platform staff only');\n    policyAssert(count($snapshot(402)['members'])===3 && $snapshot(403)['state']==='open','bound platform and measurement share the policy');\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards WHERE order_id IN (404,405)')===0,'historical completed orders and unaccepted offers are not backfilled');\n    policyAssert($sync(401)===[],'platform projection repeats without incrementing policy version');\n    $initial=$snapshot(401);\n    $epoch=(string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"platformstaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    policyAssert((string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0')!==$epoch,'case-only OpenID edits revoke even on unicode_ci settings columns');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    $epoch=(string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0');\n    try{$db->transaction(static function(Database $db):void{$db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");throw new RuntimeException('rollback fixture');});}catch(RuntimeException $error){}\n    policyAssert((string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0')===$epoch,'configuration epoch rolls back with original settings');\n    $db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");\n    $sync(401);policyAssert(count($snapshot(401)['members'])===1 && !$snapshot(401)['members'][0]['can_send'],'unbound worker waits safely when no platform staff is available');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    $sync(401);policyAssert($snapshot(401)['state']==='open' && $snapshot(401)['staff_config_version']!==$initial['staff_config_version'],'remove/re-add uses a new staff interval, without a business reopen');\n    $beforeStaff=$snapshot(401)['members'][1]['authority_version'];\n    $db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");\n    $db->execute(\"UPDATE users SET status='active' WHERE id=10203\");\n    $sync(401);policyAssert($snapshot(401)['members'][1]['authority_version']!==$beforeStaff,'disable/re-enable never resurrects original staff authority generation');\n    $epoch=(string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=10203');\n    $db->execute(\"UPDATE users SET nickname='测试工作人员' WHERE id=10203\");\n    policyAssert((string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=10203')===$epoch,'non-authority profile edits do not churn staff generations');\n\n    // Execute the real platform quote selection transaction, including failure\n    // injection at its deferred authority write. Only notification delivery is fake.\n    $quote=$db->insert(\"INSERT INTO quotes(public_id,order_id,quote_type,worker_id,amount_cents,booking_fee_cents,status,current_version,created_at,updated_at)\n        VALUES(:public,406,'worker',30,10000,0,'active',1,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>public_id()]);\n    $cipher=new class implements \\WorkerAdmin\\Contracts\\PrivateValueCipher {\n        public function hmac(string $plainText,string $context):string{return hash('sha256',$plainText);}\n        public function encrypt(string $plainText,string $context):?string{return $plainText;}\n        public function decrypt(string $cipherText,string $context):string{return $cipherText;}\n    };\n    $adminRepo=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabasePlatformOrderAdminRepository($db,$cipher);\n    $db->execute(\"CREATE TRIGGER fixture_platform_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;try{$adminRepo->selectQuote(406,(int)$quote,0);}catch(PDOException $error){$failed=($error->errorInfo[1]??0)===1644;}\n    $db->execute('DROP TRIGGER fixture_platform_failure');\n    policyAssert($failed && $db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=406')===null,'authority failure rolls real platform deal back');\n    policyAssert($db->fetchValue('SELECT status FROM quotes WHERE id=:id',['id'=>$quote])==='active','failed deal preserves quote status');\n    $adminRepo->selectQuote(406,(int)$quote,0);\n    policyAssert($snapshot(406)['state']==='open' && $db->fetchValue('SELECT status FROM quotes WHERE id=:id',['id'=>$quote])==='selected','actual platform deal creates the guarded assignment');\n\n    // Run every newly wired production event outlet against final transaction\n    // facts; method signatures stay the actual repository contracts.\n    foreach(['DatabasePlatformOrderAdminRepository','DatabasePlatformOrderFinanceRepository','DatabasePlatformOrderCustomerShareRepository',\n        'PlatformPricingAwareOrderMeasurementCompletionRepository','PlatformOrderRefundReviewWriter'] as $i=>$class){\n        $assignment=510+$i;\n        $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at)\n            SELECT :id,:public,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM assignments WHERE id=401\",['id'=>$assignment,'public'=>public_id()]);\n        $db->execute(\"UPDATE orders SET lifecycle_status='active',current_assignment_id=:id WHERE id=401\",['id'=>$assignment]);$sync(401);\n        $db->transaction(static function(Database $db)use($class):void{\n            $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\'.$class);$repo=$reflection->newInstanceWithoutConstructor();\n            $event=$reflection->getMethod('event');$event->setAccessible(true);\n            $db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=401\");\n            if(in_array($class,['DatabasePlatformOrderCustomerShareRepository','PlatformPricingAwareOrderMeasurementCompletionRepository'],true))$event->invoke($repo,$db,401,'fixture_platform_closed','system',0,[]);\n            else $event->invoke($repo,$db,401,'fixture_platform_closed',0,[]);\n        });\n        policyAssert($snapshot(401)['state']==='readonly',$class.' closes policy in the owner transaction');\n    }\n    $closed=$snapshot(401);\n    $db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");$sync(401);\n    policyAssert($snapshot(401)===$closed,'completed historical roster is never replaced by a fresh staff list');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    // A real explicitly accepted platform repair may open a NEW episode.\n    $db->execute(\"UPDATE assignments SET status='completed' WHERE id=:id\",['id'=>$closed['assignment_id']]);\n    $db->execute(\"UPDATE orders SET assignment_status='completed' WHERE id=401\");\n    $repair=$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at)\n        VALUES('CHAT-PLATFORM-REPAIR',401,10204,'warranty_repair','测试售后','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $episodes=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true);\n    $db->transaction(static function()use($episodes,$repair):void{$episodes->acceptWorker(401,(int)$repair,30);});\n    policyAssert($snapshot(401)['state']==='open' && strpos($snapshot(401)['episode_key'],':repair:')!==false,'explicit platform repair acceptance opens only its immutable generation');\n    $db->transaction(static function(Database $db)use($episodes,$repair):void{$db->execute(\"UPDATE after_sales SET status='resolved',closed_at=UTC_TIMESTAMP() WHERE id=:id\",['id'=>$repair]);$episodes->close(401,(int)$repair);});\n    policyAssert($snapshot(401)['state']==='readonly','platform repair closure retains history only');\n\n    // Refresh remains bounded and recovers a revoked roster without new chat\n    // messages. A broken row backs off; a later healthy row still completes.\n    $db->execute(\"UPDATE chat_policy_refresh SET next_check_at=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 MINUTE) WHERE order_id IN (402,403,406)\");\n    $db->execute(\"CREATE TRIGGER fixture_refresh_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");\n    $run=$maintenance->refresh(1);policyAssert($run['scanned']===1 && $run['failure']===1,'refresh hard limit and failure audit');\n    $db->execute('DROP TRIGGER fixture_refresh_failure');\n    $run=$maintenance->refresh(2);policyAssert($run['scanned']===2 && $run['failure']===0,'failed first row cannot starve later orders');\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM scheduled_job_failures WHERE job_name='chat_policy_refresh' AND resolved_at IS NULL\")===1,'refresh failure remains visible for repair');\n    $GLOBALS['chat_policy_fixture_enabled']=false;\n    policyAssert($maintenance->refresh()['scanned']===0,'disabled maintenance is independent of chat tables');\n    $blocked=false;try{$maintenance->backfill(0,1,true);}catch(RuntimeException $error){$blocked=true;}policyAssert($blocked,'apply refuses disabled order policy');\n    $GLOBALS['chat_policy_fixture_enabled']=true;\n    echo \"平台真实成交/回滚、入口关闭、售后、撤权代次及分页回填/恢复专项通过\\n\";\n}\n","server/tests/chat_platform_fixture.php":"<?php\n\ndeclare(strict_types=1);\n\nspl_autoload_register(static function(string $class):void{\n    $prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)!==0)return;\n    $file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';\n    if(is_file($file))require_once $file;\n});\nfunction public_id():string{return strtoupper(bin2hex(random_bytes(13)));}\nrequire_once __DIR__.'/chat_platform_contract.php';\n$name=(string)getenv('CHAT_POLICY_FIXTURE_DATABASE');$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');$action=$argv[1]??'';\n$orderID=$action==='test-center'?401:(int)($argv[2]??401);\nif(!in_array($orderID,[401,402,403],true)||($orderID!==401&&$action!=='sync'))throw new RuntimeException('Explicit fixture order required');\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'||preg_match('/^bixuan_test_policy_platform_[a-z0-9]+$/D',$name)!==1\n    ||preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$m)!==1||!in_array($action,['init','sync','close','repair','repair-close','config-blocked','user-blocked','attention-seed','test-center'],true))throw new RuntimeException('Explicit isolated platform fixture required');\n$db=new \\WorkerAdmin\\Core\\Database(['host'=>'127.0.0.1','port'=>(int)$m[1],'database'=>$name,'username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4']);\nif($action==='init'){\n    (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n    chatPlatformSeed($db);\n}\n$db->execute('SET SESSION innodb_lock_wait_timeout=1');\ntry{\n    $db->transaction(static function(\\WorkerAdmin\\Core\\Database $db)use($action,$orderID,$argv):void{\n        if($action==='test-center'){\n            $source=(string)($argv[2]??'');$workflow=(string)($argv[3]??'');$dispatch=(string)($argv[4]??'');\n            if(!in_array($source,['consumer','platform'],true)||!in_array($workflow,['construction','measurement'],true)||!in_array($dispatch,['multi_quote','single_grab'],true))throw new RuntimeException('test center profile');\n            $db->execute(\"UPDATE orders SET user_id=:user,order_source_type=:source,workflow_profile=:workflow,dispatch_mode=:dispatch,payment_status=:payment,lifecycle_status='active' WHERE id=401\",['user'=>$source==='consumer'?10201:10204,'source'=>$source,'workflow'=>$workflow,'dispatch'=>$dispatch,'payment'=>$source==='consumer'?'paid':'not_required']);\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->synchronize(401);\n        }\n        elseif($action==='config-blocked')$db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");\n        elseif($action==='user-blocked')$db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");\n        else{\n            if($action==='attention-seed'){\n                for($i=1;$i<=125;$i++){\n                    $id=5000+$i;\n                    $db->execute(\"INSERT INTO orders(id,public_no,user_id,workflow_profile,order_source_type,audit_status,publish_status,lifecycle_status,payment_status,assignment_status,booking_fee_cents,final_amount_cents,created_at,updated_at) VALUES(:id,:no,10204,'construction','platform','approved','hidden','active','not_required','accepted',0,12000,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id,'no'=>'CHAT-ATTENTION-'.$id]);\n                    $db->execute(\"INSERT INTO order_platform_terms(order_id,customer_flow_mode,customer_contract_total_cents,worker_labor_cents,created_at,updated_at) VALUES(:id,'platform_managed',12000,10000,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id]);\n                    $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at) SELECT :id,:public,:order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at FROM assignments WHERE id=401\",['id'=>$id,'public'=>public_id(),'order_id'=>$id]);\n                    $db->execute(\"UPDATE orders SET current_assignment_id=:id,assigned_worker_id=30 WHERE id=:id\",['id'=>$id]);\n                    (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->synchronize($id);\n                }\n                return;\n            }\n            if($action==='close')$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=401\");\n            if($action==='repair'){\n                $repair=$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at)\n                    VALUES('CHAT-GO-REPAIR',401,10204,'warranty_repair','测试售后','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n                (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->acceptWorker(401,(int)$repair,30);\n            }elseif($action==='repair-close'){\n                $repair=(int)$db->fetchValue(\"SELECT id FROM after_sales WHERE public_no='CHAT-GO-REPAIR'\");\n                $db->execute(\"UPDATE after_sales SET status='resolved',closed_at=UTC_TIMESTAMP() WHERE id=:id\",['id'=>$repair]);\n                (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->close(401,$repair);\n            }\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->synchronize($orderID);\n        }\n    });\n    if(strpos($action,'blocked')!==false)throw new RuntimeException('Missing authority shared lock');\n    echo \"committed\\n\";\n}catch(PDOException $error){\n    if(strpos($action,'blocked')===false||($error->errorInfo[1]??0)!==1205)throw new RuntimeException('Platform fixture SQL failed; code='.(string)($error->errorInfo[1]??0));\n    echo \"blocked\\n\";\n}\n","server/tests/chat_policy_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nrequire_once dirname(__DIR__).'/app/Domain/Chat/OrderConversationPolicy.php';\nrequire_once dirname(__DIR__).'/app/Core/Database.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseOrderConversationBridge.php';\nrequire_once dirname(__DIR__).'/app/Support/SqlScriptRunner.php';\nrequire_once dirname(__DIR__).'/app/Contracts/SettingsProvider.php';\nrequire_once dirname(__DIR__).'/app/Domain/Identity/AdminActorPolicy.php';\nrequire_once dirname(__DIR__).'/app/Application/Identity/ActorCapabilityResolver.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseChatPlatformStaff.php';\nuse WorkerAdmin\\Domain\\Chat\\OrderConversationPolicy;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Support\\SqlScriptRunner;\n\nfunction policyAssert(bool $ok,string $label): void { if (!$ok) throw new RuntimeException($label); }\nfunction app_config($key,$default=null) { return $key==='chat.order_policy_enabled' ? ($GLOBALS['chat_policy_fixture_enabled'] ?? false) : $default; }\n\nif (($argv[1] ?? '')==='--hold-guard') {\n    $input=json_decode((string)fgets(STDIN,4096),true,32,JSON_THROW_ON_ERROR);\n    policyAssert(($input['config']['host'] ?? '')==='127.0.0.1' && strpos($input['config']['database'] ?? '','bixuan_test_policy_')===0,'isolated child endpoint');\n    $child=new Database($input['config']);$pdo=$child->pdo();$pdo->beginTransaction();\n    try {\n        $child->fetch('SELECT policy_version FROM chat_policy_guards WHERE scope_key=:scope LOCK IN SHARE MODE',['scope'=>$input['scope']]);\n        echo \"locked\\n\";fflush(STDOUT);\n        $read=[STDIN];$write=[];$except=[];if (stream_select($read,$write,$except,5)>0) fgets(STDIN);\n    } finally { $pdo->rollBack(); }\n    exit;\n}\n\n$facts=['order_id'=>'77','customer_id'=>'1','customer_status'=>'active','is_demo'=>0,\n    'workflow_profile'=>'construction','order_source_type'=>'consumer','lifecycle_status'=>'active','payment_status'=>'paid',\n    'assignment_status'=>'accepted','current_assignment_id'=>'100','assigned_worker_id'=>'10',\n    'assignment_id'=>'100','assignment_order_id'=>'77','worker_id'=>'10','worker_user_id'=>'2',\n    'worker_user_status'=>'active','assignment_record_status'=>'accepted','assignment_accepted_at'=>'2026-10-21 00:00:00'];\n$policy=new OrderConversationPolicy();$snapshot=$policy->evaluate($facts);\npolicyAssert($snapshot!==null && $snapshot['scope_key']==='order:77:assignment:100' && $snapshot['state']==='open','normal accepted grant');\npolicyAssert($snapshot['members'][1]['actor_id']==='2' && $snapshot['can_invite']===false,'worker is a user, no invites');\n$released=$facts;$released['assignment_status']='info_released';policyAssert($policy->evaluate($released)===$snapshot,'explicit contact release preserves accepted chat authority');\n$measurement=$facts;$measurement['workflow_profile']='measurement';policyAssert($policy->evaluate($measurement)!==null,'measurement reuses same policy');\n$grab=$facts;$grab['dispatch_mode']='single_grab';policyAssert($policy->evaluate($grab)===$snapshot,'fixed grab shares final assignment authority');\n$merchant=$facts;$merchant['order_source_type']='merchant';policyAssert($policy->evaluate($merchant)!==null,'merchant ordinary order');\n$self=$facts;$self['worker_user_id']='1';policyAssert($policy->evaluate($self)===null,'self assignment cannot invent another participant');\nforeach (['payment_status'=>'unpaid','assignment_record_status'=>'offered','assignment_status'=>'offered',\n    'current_assignment_id'=>'99','assigned_worker_id'=>'11','assignment_order_id'=>'78','customer_status'=>'platform_unbound',\n    'worker_user_status'=>'disabled','order_source_type'=>'platform','lifecycle_status'=>'unknown','workflow_profile'=>'unknown','is_demo'=>1,\n    'assignment_id'=>'01','customer_id'=>'18446744073709551616'] as $key=>$value) {\n    $bad=$facts;$bad[$key]=$value;policyAssert($policy->evaluate($bad)===null,'fail closed '.$key);\n}\n$completed=$facts;$completed['lifecycle_status']='completed';policyAssert($policy->evaluate($completed)['state']==='readonly','completed is readonly');\n$repair=$completed;\n$repair['repair_episode']=['id'=>'900','after_sale_id'=>'500','order_id'=>'77','assignment_id'=>'100','worker_id'=>'10','accepted_user_id'=>'2',\n    'repair_order_id'=>'77','repair_user_id'=>'1','state'=>'active','accepted_at'=>'2026-10-22 00:00:00','closed_at'=>null,\n    'repair_type'=>'warranty_repair','repair_status'=>'processing','repair_closed_at'=>null];\npolicyAssert($policy->evaluate($repair)['episode_key']==='assignment:100:repair:900','explicit repair generation grants a distinct episode');\nforeach(['id'=>'0','assignment_id'=>'99','accepted_user_id'=>'3','repair_user_id'=>'3','repair_order_id'=>'78','state'=>'closed',\n    'accepted_at'=>null,'repair_type'=>'unknown','repair_status'=>'resolved','repair_closed_at'=>'2026-10-22 01:00:00'] as $key=>$value){\n    $bad=$repair;$bad['repair_episode'][$key]=$value;policyAssert($policy->evaluate($bad)===null,'repair rejects '.$key);\n}\n$big=$facts;$big['order_id']='18446744073709551615';$big['assignment_order_id']=$big['order_id'];policyAssert(strpos($policy->evaluate($big)['scope_key'],$big['order_id'])!==false,'UINT64 strings remain exact');\n$platform=$facts;\n$platform['order_source_type']='platform';$platform['payment_status']='not_required';\n$platform['customer_flow_mode']='platform_managed';$platform['booking_fee_cents']=0;\n$platform['customer_status']='platform_unbound';\n$staff=['actor_id'=>'3','kind'=>'mini','status'=>'active','is_mini_admin'=>true,'authority_version'=>'1'];\n$platform['platform_staff']=[$staff];$platform['staff_config_version']='1';\n$candidate=$policy->evaluatePlatform($platform);\npolicyAssert($candidate!==null && $candidate['schema_version']===2 && $candidate['members'][0]['role']==='worker'\n    && $candidate['members'][1]['role']==='platform_staff','unbound customer replaced only by real staff');\npolicyAssert(!in_array('1',array_column($candidate['members'],'actor_id'),true),'placeholder customer never becomes a member');\npolicyAssert($policy->evaluate($platform)===$candidate,'production platform policy uses the same authority contract');\n$alone=$platform;$alone['platform_staff']=[];policyAssert(!$policy->evaluate($alone)['members'][0]['can_send'],'no staff/customer means no writable peer, no fabricated customer');\nforeach(['construction','measurement'] as $profile)foreach(['multi_quote','single_grab'] as $dispatch){\n    $case=$platform;$case['workflow_profile']=$profile;$case['dispatch_mode']=$dispatch;\n    policyAssert($policy->evaluatePlatform($case)!==null,'platform profiles and dispatch modes share accepted assignment authority');\n}\n$bound=$platform;$bound['customer_status']='active';\npolicyAssert(count($policy->evaluatePlatform($bound)['members'])===3,'bound customer, worker and staff retain explicit roles');\n$bound['platform_staff']=[];policyAssert(count($policy->evaluatePlatform($bound)['members'])===2,'bound customer needs no invented staff');\n$collision=$platform;$collision['platform_staff']=[$staff,$staff,array_replace($staff,['actor_id'=>'2'])];\npolicyAssert(count($policy->evaluatePlatform($collision)['members'])===2,'duplicate staff and worker/admin overlap never duplicate or elevate member');\n$collision=$bound;$collision['platform_staff']=[array_replace($staff,['actor_id'=>'1'])];\npolicyAssert($policy->evaluatePlatform($collision)['members'][0]['role']==='customer','customer/admin overlap retains customer identity');\nforeach(['staff_config_version'=>'0','customer_status'=>'disabled','customer_flow_mode'=>'unknown','booking_fee_cents'=>1,\n    'payment_status'=>'paid','current_assignment_id'=>'99','assigned_worker_id'=>'11','assignment_order_id'=>'78',\n    'assignment_record_status'=>'offered','assignment_status'=>'offered','assignment_accepted_at'=>null,\n    'worker_user_status'=>'disabled','lifecycle_status'=>'unknown','is_demo'=>1,'repair_episode'=>[]] as $key=>$value){\n    $case=$platform;$case[$key]=$value;policyAssert($policy->evaluatePlatform($case)===null,'platform rejects '.$key);\n}\nforeach(['kind'=>'admin','status'=>'disabled','is_mini_admin'=>false,'actor_id'=>'01'] as $key=>$value){\n    $case=$platform;$case['platform_staff'][0][$key]=$value;policyAssert($policy->evaluatePlatform($case)===null,'staff rejects '.$key);\n}\n$limit=$bound;$limit['platform_staff']=[];\nfor($i=3;$i<=10;$i++)$limit['platform_staff'][]=array_replace($staff,['actor_id'=>(string)$i]);\npolicyAssert(count($policy->evaluatePlatform($limit)['members'])===10,'bounded ten-member candidate');\n$limit['platform_staff'][]=array_replace($staff,['actor_id'=>'11']);policyAssert($policy->evaluatePlatform($limit)===null,'no partial grants beyond group budget');\nforeach(['completed','cancelled','closed','refunded','cancel_approved_pending_refund'] as $state){\n    $case=$platform;$case['lifecycle_status']=$state;\n    $closed=$policy->evaluatePlatform($case);policyAssert($closed['state']==='readonly' && !in_array(true,array_column($closed['members'],'can_send'),true),'platform terminal read-only '.$state);\n}\necho \"平台托管身份与权限代次矩阵通过\\n\";\npolicyAssert((new DatabaseOrderConversationBridge(new Database([])))->synchronize(0)===[],'disabled bridge performs no IO');\necho \"聊天订单策略矩阵通过\\n\";\nif (getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1') {echo \"隔离授权事务验证未启用\\n\";exit;}\n\npolicyAssert(preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR'),$match)===1,'explicit isolated endpoint');\n$config=['host'=>'127.0.0.1','port'=>(int)$match[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$admin=new Database($config);$name='bixuan_test_policy_'.bin2hex(random_bytes(5));$admin->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$db=new Database($config);$bridge=new DatabaseOrderConversationBridge($db,true);\n$user='bxchat_test_'.bin2hex(random_bytes(6));$pw=bin2hex(random_bytes(16));$host=(string)(getenv('CHAT_AUTH_TEST_MYSQL_USER_HOST') ?: '127.0.0.1');\npolicyAssert(in_array($host,['127.0.0.1','%'],true),'fixture host');\ntry {\n    $db->execute('CREATE TABLE users(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE worker_profiles(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE assignments(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,worker_id BIGINT UNSIGNED,status VARCHAR(24),accepted_at DATETIME) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE orders(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED,is_demo TINYINT,workflow_profile VARCHAR(24),order_source_type VARCHAR(24),lifecycle_status VARCHAR(40),payment_status VARCHAR(24),assignment_status VARCHAR(24),current_assignment_id BIGINT UNSIGNED,assigned_worker_id BIGINT UNSIGNED) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE after_sales(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,user_id BIGINT UNSIGNED,type VARCHAR(32),status VARCHAR(24),closed_at DATETIME NULL) ENGINE=InnoDB');\n    require_once __DIR__.'/chat_migration_fixture.php';foreach ([1,2] as $unused) foreach(['policy','repair'] as $section)chatFixtureMigration($db->pdo(),$section);\n    $db->execute(\"INSERT INTO users VALUES(1,'active'),(2,'active')\");$db->execute('INSERT INTO worker_profiles VALUES(10,2)');\n    $db->execute(\"INSERT INTO assignments VALUES(100,77,10,'accepted',UTC_TIMESTAMP()),(101,77,10,'accepted',UTC_TIMESTAMP()),(102,77,10,'offered',NULL),(103,77,10,'accepted',UTC_TIMESTAMP()),(104,77,10,'accepted',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO orders VALUES(77,1,0,'construction','consumer','active','paid','accepted',100,10)\");\n    // Exercise real event outlets, isolating only the outbound notification port.\n    class ChatNotificationFixture {\n        public static int $calls=0;\n        public static function queuePersistedEvent(...$args):void{self::$calls++;}\n        public static function queue(...$args):void{self::$calls++;}\n    }\n    class_alias(ChatNotificationFixture::class,'WorkerAdmin\\\\Services\\\\OrderNotificationService');\n    foreach(['Contracts/OrderDealRepository.php','Contracts/OrderQuoteSelectionRepository.php',\n        'Infrastructure/Persistence/OrderDealAssignmentOperations.php','Infrastructure/Persistence/OrderDealQuoteOperations.php',\n        'Infrastructure/Persistence/DatabaseOrderDealRepository.php','Infrastructure/Persistence/DatabaseOrderQuoteSelectionRepository.php',\n        'Infrastructure/Persistence/DatabaseOrderPaidPaymentSettlement.php'] as $file)require_once dirname(__DIR__).'/app/'.$file;\n    $db->execute('CREATE TABLE order_events(id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,order_id BIGINT UNSIGNED,event_type VARCHAR(64),event_key VARCHAR(128) NULL,actor_type VARCHAR(24),actor_id BIGINT UNSIGNED,payload_json TEXT,created_at DATETIME) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE run_empty_fee_claims(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB');\n    $db->execute(\"INSERT INTO run_empty_fee_claims VALUES(55,'paid')\");\n    $rejected=false;try {$bridge->synchronize(77);} catch(RuntimeException $e) {$rejected=true;}\n    policyAssert($rejected && !$db->pdo()->inTransaction(),'missing original transaction is rejected');\n    $sync=static function()use($db,$bridge):array{return $db->transaction(static function()use($bridge):array{return $bridge->synchronize(77);});};\n    $db->execute(\"UPDATE orders SET payment_status='unpaid' WHERE id=77\");\n    $GLOBALS['chat_policy_fixture_enabled']=true;\n    $db->transaction(static function(Database $db)use($bridge):void{\n        $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderDealRepository');$repository=$reflection->newInstanceWithoutConstructor();\n        $event=$reflection->getMethod('event');$event->setAccessible(true);$event->invoke($repository,$db,77,'assignment_accepted','system',0,[]);\n        $db->transaction(static function(Database $db)use($bridge):void{\n            $bridge->schedule(77);\n            $db->execute(\"UPDATE orders SET payment_status='paid' WHERE id=77\");\n        });\n        policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards')===0,'projection waits until all outer writes');\n    });\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='open' && $sync()===[],'precommit reads final facts and remains idempotent');\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_business_events')===1,'no duplicate event');\n    foreach ([78=>201,79=>202] as $order=>$assignment) {\n        $db->execute(\"INSERT INTO assignments VALUES(:id,:order_id,10,'accepted',UTC_TIMESTAMP())\",['id'=>$assignment,'order_id'=>$order]);\n        $db->execute(\"INSERT INTO orders VALUES(:id,1,0,'construction','consumer','active','paid','accepted',:assignment,10)\",['id'=>$order,'assignment'=>$assignment]);\n        $db->transaction(static function(Database $db)use($order):void{\n            if ($order===78) {\n                $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderQuoteSelectionRepository');$repository=$reflection->newInstanceWithoutConstructor();\n                $method=$reflection->getMethod('event');$method->setAccessible(true);$method->invoke($repository,$db,$order,'booking_fee_paid','system',0,[]);\n            } else {\n                $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderPaidPaymentSettlement');$repository=$reflection->newInstanceWithoutConstructor();\n                $property=$reflection->getProperty('db');$property->setAccessible(true);$property->setValue($repository,$db);\n                $repository->settle('run_empty_fee',['order_id'=>$order,'business_id'=>55,'payer_user_id'=>1]);\n            }\n        });\n        policyAssert($db->fetchValue(\"SELECT state FROM chat_policy_guards WHERE order_id=:id\",['id'=>$order])==='open','each production outlet schedules its own policy');\n        $db->transaction(static function(Database $db)use($bridge,$order):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=:id\",['id'=>$order]);$bridge->synchronize($order);});\n    }\n    policyAssert(ChatNotificationFixture::$calls===2,'notification port isolated while real order outlets ran');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='readonly','close commits guard');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='active' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='readonly','same episode cannot silently reopen');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute('UPDATE orders SET current_assignment_id=101 WHERE id=77');$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=101')==='open','same worker new assignment is new scope');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET current_assignment_id=102,assignment_status='offered' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards WHERE state='open'\")===0,'offered assignment closes former scope');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET current_assignment_id=103,assignment_status='accepted' WHERE id=77\");$bridge->synchronize(77);});\n    $db->execute(\"CREATE TRIGGER fixture_event_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;\n    try {$db->transaction(static function()use($db,$bridge):void{$db->execute('UPDATE orders SET current_assignment_id=104 WHERE id=77');$bridge->schedule(77);});} catch(PDOException $e) {$failed=($e->errorInfo[1] ?? 0)===1644;}\n    policyAssert($failed && (string)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77')==='103','event failure rolls back order and guard');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=103')==='open','rollback did not close current guard');\n    $db->execute('DROP TRIGGER fixture_event_failure');\n\n    $admin->execute(\"CREATE USER '\".$user.\"'@'\".$host.\"' IDENTIFIED BY '\".$pw.\"'\");\n    foreach (['chat_policy_guards','chat_business_events'] as $table) $admin->execute(\"GRANT SELECT ON `\".$name.\"`.\".$table.\" TO '\".$user.\"'@'\".$host.\"'\");\n    $readConfig=$config;$readConfig['username']=$user;$readConfig['password']=$pw;$reader=new Database($readConfig);\n    $denied=false;try {$reader->execute(\"UPDATE chat_policy_guards SET state='open'\");}catch(Throwable $e){$denied=true;}policyAssert($denied,'Go cannot write PHP guards');\n    $runtime=(string)(getenv('CHAT_AUTH_TEST_PHP') ?: PHP_BINARY);\n    $process=proc_open([$runtime,__FILE__,'--hold-guard'],[['pipe','r'],['pipe','w'],['pipe','w']],$pipes);\n    policyAssert(is_resource($process),'shared-lock fixture process');\n    try {\n        fwrite($pipes[0],json_encode(['config'=>$readConfig,'scope'=>'order:77:assignment:103'],JSON_THROW_ON_ERROR).\"\\n\");fflush($pipes[0]);\n        policyAssert(trim((string)fgets($pipes[1]))==='locked','Go SELECT-only shared lock established');\n        $db->execute('SET SESSION innodb_lock_wait_timeout=1');$blocked=false;\n        try {$db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");$bridge->synchronize(77);});}catch(PDOException $e){$blocked=($e->errorInfo[1] ?? 0)===1205;}\n        policyAssert($blocked && $db->fetchValue('SELECT lifecycle_status FROM orders WHERE id=77')==='active','shared lock prevents close committing ahead of send');\n        fwrite($pipes[0],\"release\\n\");fflush($pipes[0]);\n    } finally {foreach($pipes as $pipe)fclose($pipe);proc_close($process);}\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=103')==='readonly','close succeeds after shared lease ends');\n    require_once __DIR__.'/chat_closure_contract.php';\n    chatClosureContract($db,$bridge);\n    require_once __DIR__.'/chat_assignment_contract.php';\n    chatAssignmentContract($config);\n    $db->execute(\"INSERT INTO assignments(id,order_id,worker_id,status,accepted_at) VALUES(1300,1300,10,'accepted',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO orders(id,user_id,is_demo,workflow_profile,order_source_type,lifecycle_status,payment_status,assignment_status,current_assignment_id,assigned_worker_id) VALUES(1300,1,0,'construction','consumer','active','paid','accepted',1300,10)\");\n    $db->transaction(static function()use($bridge):void{$bridge->synchronize(1300);});\n    $other=new Database($config);\n    $db->transaction(static function(Database $db)use($bridge,$other):void{\n        policyAssert($db->fetchValue('SELECT status FROM users WHERE id=2')==='active','establish old repeatable-read view');\n        $other->execute(\"UPDATE users SET status='disabled' WHERE id=2\");\n        policyAssert($db->fetchValue('SELECT status FROM users WHERE id=2')==='active','plain SQL still sees stale view');\n        $bridge->schedule(1300);\n    });\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=1300')==='readonly','final projection uses current account facts despite earlier snapshot');\n    $other->execute(\"UPDATE users SET status='active' WHERE id=2\");\n    $env=getenv();$env['V250_PLATFORM_MYSQL_TEST']='1';$env['V250_DB_HOST']='127.0.0.1';$env['V250_DB_PORT']=(string)$config['port'];\n    $env['V250_DB_NAME']=$name;$env['V250_DB_USER']='root';$env['V250_DB_PASSWORD']=$config['password'];\n    $transactionTest=proc_open([$runtime,__DIR__.'/v250_transaction_mysql.php'],[STDIN,STDOUT,STDERR],$unused,null,$env);\n    policyAssert(is_resource($transactionTest) && proc_close($transactionTest)===0,'existing transaction regression');\n    $db->execute('DROP TABLE chat_business_events');$db->execute('DROP TABLE chat_policy_guards');$GLOBALS['chat_policy_fixture_enabled']=false;\n    $before=(int)$db->fetchValue('SELECT COUNT(*) FROM order_events');\n    $db->transaction(static function(Database $db):void{\n        $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderDealRepository');$repository=$reflection->newInstanceWithoutConstructor();\n        $event=$reflection->getMethod('event');$event->setAccessible(true);$event->invoke($repository,$db,77,'fixture_disabled','system',0,[]);\n    });\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM order_events')===$before+1,'disabled chat leaves original event path independent of chat tables');\n    echo \"隔离授权幂等、回滚、改派及共享锁并发验证通过\\n\";\n} finally {\n    $admin->execute('DROP DATABASE IF EXISTS `'.$name.'`');\n    $admin->execute(\"DROP USER IF EXISTS '\".$user.\"'@'\".$host.\"'\");\n}\n","server/tests/chat_policy_fixture.php":"<?php\n\ndeclare(strict_types=1);\n\n// Child process for Go's real shared-lock test. Never load application config.\nrequire_once dirname(__DIR__).'/app/Core/Database.php';\nrequire_once dirname(__DIR__).'/app/Domain/Chat/OrderConversationPolicy.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseOrderConversationBridge.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseChatRepairEpisodes.php';\nrequire_once dirname(__DIR__).'/app/Support/SqlScriptRunner.php';\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Support\\SqlScriptRunner;\n\n$name=(string)getenv('CHAT_POLICY_FIXTURE_DATABASE');\n$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');\n$action=$argv[1]??'';\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1' || preg_match('/^bixuan_test_policy_go_[a-z0-9]+$/D',$name)!==1\n    || preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$match)!==1 || !in_array($action,['init','close','close-blocked','repair','repair-close'],true)) throw new RuntimeException('Explicit isolated policy fixture required');\n$db=new Database(['host'=>'127.0.0.1','port'=>(int)$match[1],'database'=>$name,'username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4']);\nif($action==='init') {\n    $db->execute('CREATE TABLE after_sales(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,user_id BIGINT UNSIGNED,type VARCHAR(32),status VARCHAR(24),closed_at DATETIME NULL) ENGINE=InnoDB');\n    require_once __DIR__.'/chat_migration_fixture.php';foreach(['policy','repair'] as $section)chatFixtureMigration($db->pdo(),$section);\n}\n$db->execute('SET SESSION innodb_lock_wait_timeout=1');\ntry {\n    $db->transaction(static function(Database $db)use($action):void {\n        $db->fetch('SELECT id FROM orders WHERE id=77 FOR UPDATE');\n        if($action!=='init') $db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");\n        if($action==='repair') {\n            $db->execute(\"INSERT INTO after_sales VALUES(500,77,1,'warranty_repair','processing',NULL)\");\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->acceptWorker(77,500,10);\n        } elseif($action==='repair-close') {\n            $db->execute(\"UPDATE after_sales SET status='resolved',closed_at=UTC_TIMESTAMP() WHERE id=500\");\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->close(77,500);\n        }\n        (new DatabaseOrderConversationBridge($db,true))->schedule(77);\n    });\n    if($action==='close-blocked') throw new RuntimeException('Shared lock was not held');\n    echo \"committed\\n\";\n} catch(PDOException $error) {\n    if($action!=='close-blocked' || ($error->errorInfo[1]??0)!==1205) throw new RuntimeException('Policy fixture SQL failed');\n    echo \"blocked\\n\";\n}\n","server/tests/chat_reminder_contract.php":"<?php\ndeclare(strict_types=1);\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'){echo \"提醒数据库验证未启用\\n\";exit;}\nrequire_once dirname(__DIR__).'/app/Support/functions.php';\nspl_autoload_register(static function(string $class):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)===0){$file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require_once $file;}});\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderReceipts;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderDispatch;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nfunction reminderEnsure(bool $ok,string $message):void{if(!$ok)throw new RuntimeException($message);}\nfinal class ReminderGatewayFixture implements SubscribeMessageGateway{\n public int $calls=0;public bool $fail=false;\n public function categoryList():array{return [];}public function publicTemplateTitles(array $ids,int $start=0,int $limit=30):array{return [];}\n public function publicTemplateKeywords(string $tid):array{return [];}public function addTemplate(string $tid,array $kids,string $desc=''):string{return '';}\n public function templateList():array{return [];}\n public function send(array $payload):array{$this->calls++;reminderEnsure(!isset($payload['sms_fallback'])&&$payload['scene_key']==='chat_unread','chat SMS fallback or wrong scene');if($this->fail)throw new RuntimeException('accepted but transport result lost');return ['ok'=>true];}\n}\n$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');if(preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$m)!==1)throw new RuntimeException('loopback required');\n$config=['host'=>'127.0.0.1','port'=>(int)$m[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$root=new Database($config);$name='bixuan_test_chat_reminder_'.bin2hex(random_bytes(6));$root->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$GLOBALS['worker_admin_config']=['database'=>$config];$db=db();\ntry{\n (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n $db->execute(\"INSERT INTO users(id,public_id,nickname,status,created_at,updated_at) VALUES(10001,:public,'提醒隔离用户','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>str_repeat('U',26)]);\n $db->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10001,'fixture-app','fixture-openid','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n $settings=['wechat.subscribe_enabled'=>['1','bool'],'wechat.subscribe_template_ids'=>[json_encode(['chat_unread'=>['template_id'=>'fixture-template','field_map'=>['status'=>'thing1','time'=>'time2']]]),'json'],\n 'wechat.subscription.user.10001'=>[json_encode(['chat_unread'=>['enabled'=>true,'authorization_status'=>'accept','remaining_count'=>5,'subscription_type'=>'one_time']]),'json']];\n foreach($settings as $key=>$value)$db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,created_at,updated_at) VALUES(:key,:value,:type,'notification',0,'隔离测试',UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type=VALUES(value_type)\",['key'=>$key,'value'=>$value[0],'type'=>$value[1]]);\n $receipts=new ChatReminderReceipts($db);\n $body=static function(string $op):string{$q=['cluster_version'=>'1','conversation_id'=>'401','intent_id'=>'1','operation_id'=>$op,'recipient_id'=>'10001','target_seq'=>'2'];return json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);};\n $a=str_repeat('a',64);$raw=$body($a);\n $auth=new ChatInternalAuth($db,'test','internal-fixture',str_repeat('k',32));$headers=[];\n foreach($auth->sign('/chat-internal.php',$raw) as $line){[$key,$value]=explode(': ',$line,2);$headers[strtolower(substr($key,7))]=$value;}\n $auth->verify('/chat-internal.php',$raw,$headers);\n $replayed=false;try{$auth->verify('/chat-internal.php',$raw,$headers);}catch(RuntimeException $error){$replayed=true;}reminderEnsure($replayed,'internal replay accepted');\n $tamper=false;try{$auth->verify('/chat-internal.php',$raw.' ',$headers);}catch(RuntimeException $error){$tamper=true;}reminderEnsure($tamper,'tampered body accepted');\n for($i=0;$i<3;$i++)reminderEnsure($receipts->receive($raw)['state']==='accepted','receipt changed');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\")===1,'duplicate PHP receipt duplicated outbox');\n $conflict=false;try{$receipts->receive(str_replace('\"target_seq\":\"2\"','\"target_seq\":\"3\"',$raw));}catch(RuntimeException $error){$conflict=true;}reminderEnsure($conflict,'immutable operation payload changed');\n $gateway=new ReminderGatewayFixture();\n $dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>false);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===0&&$stats['suppressed']===1,'read message sent');\n $b=str_repeat('b',64);$receipts->receive($body($b));$dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>true);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===1&&$stats['sent']===1,'unread not sent once');\n $c=str_repeat('c',64);$receipts->receive($body($c));$gateway->fail=true;$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['unknown']===1,'provider unknown not recorded');\n $db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP() WHERE business_key=:key\",['key'=>'chat:'.$c]);$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$receipts->receive($body($c))['state']==='provider_unknown','unknown provider blindly retried');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='aliyun_sms'\")===0,'unknown fell back to paid SMS');\n $d=str_repeat('d',64);$receipts->receive($body($d));$checks=0;$final=new ChatReminderDispatch($db,$gateway,static function(string $op)use(&$checks):bool{return ++$checks===1;});$stats=$final->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['suppressed']===1,'final read check missed');\n $e=str_repeat('e',64);$receipts->receive($body($e));$db->execute(\"UPDATE chat_reminder_receipts SET state='sending',updated_at=UTC_TIMESTAMP()-INTERVAL 6 MINUTE WHERE operation_id=:op\",['op'=>$e]);\n $dispatcher->dispatch();reminderEnsure($receipts->receive($body($e))['state']==='provider_unknown'&&$gateway->calls===2,'crashed sender retried');\n $large=str_repeat('f',64);$largeBody=str_replace('\"recipient_id\":\"10001\"','\"recipient_id\":\"18446744073709551615\"',$body($large));$receipts->receive($largeBody);$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$receipts->status($large)['diagnostic']==='recipient_id_unsupported','unsigned recipient ID saturated into another channel account');\n echo \"S20 PHP 内部签名/重放、幂等回执、最终未读复验、供应商未知、ID精度与短信隔离验证通过\\n\";\n}finally{$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n","server/tests/chat_repair_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderNegotiationRepository;\n\n/** Reuses the full disposable install from chat_assignment_contract.php. */\nfunction chatRepairEpisodeContract(Database $db): void\n{\n    $db->execute(\"INSERT INTO orders(id,public_no,user_id,audit_status,lifecycle_status,payment_status,assignment_status,created_at,updated_at) VALUES(78,'CHAT-REPAIR',10001,'approved','active','paid','accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $rule=$db->insert(\"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,status,created_at) VALUES(78,1,1000,1000,'active',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at) VALUES(200,:public_id,78,10,'admin',:rule,20000,5000,1000,1000,2000,15000,18000,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>public_id(),'rule'=>$rule]);\n    $db->execute('UPDATE orders SET current_assignment_id=200,assigned_worker_id=10 WHERE id=78');\n    $bridge=new DatabaseOrderConversationBridge($db,true);\n    $db->transaction(static function()use($bridge):void{$bridge->synchronize(78);});\n    $db->transaction(static function(Database $db)use($bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=78\");$bridge->synchronize(78);});\n    $repair=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at) VALUES('CHAT-AFTER',78,10001,'warranty_repair','fixture','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_repair_episodes')===0,'processing application is not explicit chat acceptance');\n    $episodes=new DatabaseChatRepairEpisodes($db,true);\n    $outside=false;try{$episodes->acceptWorker(78,$repair,10);}catch(RuntimeException $e){$outside=true;}policyAssert($outside,'acceptance fact cannot escape original transaction');\n    $repo=new DatabaseOrderNegotiationRepository($db);\n    $actor=['user_id'=>10002,'worker_id'=>10];\n    $db->execute(\"CREATE TRIGGER fixture_repair_episode_failure BEFORE INSERT ON chat_repair_episodes FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;try{$repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','accepted','fixture');}catch(PDOException $e){$failed=($e->errorInfo[1]??0)===1644;}\n    $db->execute('DROP TRIGGER fixture_repair_episode_failure');\n    policyAssert($failed && $db->fetchValue('SELECT resolution FROM after_sales WHERE id=:id',['id'=>$repair])===null,'episode write failure rolls real repair acceptance back');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','accepted','fixture');\n    $first=(string)$db->fetchValue('SELECT id FROM chat_repair_episodes WHERE active_order_id=78');\n    policyAssert($first!=='' && $db->fetchValue('SELECT accepted_user_id FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==10002,'explicit acceptance binds actual assignment and user');\n    $same=$db->transaction(static function()use($episodes,$repair):?string{return $episodes->acceptWorker(78,$repair,10);});\n    policyAssert($same===$first && (int)$db->fetchValue('SELECT COUNT(*) FROM chat_repair_episodes')===1,'replayed acceptance does not invent a generation');\n    $firstSnapshot=json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=78'),true,32,JSON_THROW_ON_ERROR);\n    policyAssert($firstSnapshot['state']==='open' && $firstSnapshot['episode_key']==='assignment:200:repair:'.$first,'explicit acceptance opens only its new repair episode');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','complete','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==='closed','actual worker completion closes accepted episode');\n    policyAssert($db->fetchValue('SELECT status FROM after_sales WHERE id=:id',['id'=>$repair])==='resolved','original repair completion retained');\n    $closed=json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=78'),true,32,JSON_THROW_ON_ERROR);\n    policyAssert($closed['state']==='readonly' && $closed['episode_key']===$firstSnapshot['episode_key'],'completion retains the closing repair identity');\n    $db->transaction(static function()use($bridge):void{policyAssert($bridge->synchronize(78)===[],'completed repair never flaps back to service identity');});\n    $rejected=false;try{$db->transaction(static function()use($episodes,$repair):void{$episodes->acceptWorker(78,$repair,10);});}catch(RuntimeException $e){$rejected=true;}\n    policyAssert($rejected && (int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0,'resolved request cannot resurrect an accepted generation');\n    $next=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at) VALUES('CHAT-AFTER2',78,10001,'warranty_repair','fixture','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER2','accepted','fixture');\n    $second=(string)$db->fetchValue('SELECT id FROM chat_repair_episodes WHERE active_order_id=78');\n    policyAssert($second!==$first && $db->fetchValue('SELECT state FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==='closed','new request creates a new immutable generation');\n    $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderFulfillmentAuxiliaryRepository');\n    $auxiliary=$reflection->newInstanceWithoutConstructor();$property=$reflection->getProperty('db');$property->setAccessible(true);$property->setValue($auxiliary,$db);\n    $auxiliary->withdrawRepair(['user_id'=>10001],'CHAT-REPAIR','CHAT-AFTER2');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly','actual customer withdrawal closes the guard');\n    $db->transaction(static function()use($episodes,$next):void{$episodes->close(78,$next);});\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='closed'\")===2,'repeated closure is idempotent');\n    $third=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,resolution,opened_at,created_at,updated_at) VALUES('CHAT-AFTER3',78,10001,'warranty_repair','fixture','processing','用户申请平台介入：fixture',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO order_events(order_id,event_type,actor_type,actor_id,payload_json,created_at) VALUES(78,'repair_platform_intervention_requested','user',10001,:payload,UTC_TIMESTAMP())\",['payload'=>json_encode(['after_sale_id'=>'CHAT-AFTER3'],JSON_THROW_ON_ERROR)]);\n    $admin=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseAdminRepairResolutionRepository($db);\n    $operator=['channel'=>'mini_admin','user_id'=>10004];\n    $admin->resolve($operator,'CHAT-REPAIR','CHAT-AFTER3','continue','fixture');\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0\n        && $db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly','platform continue alone never impersonates worker acceptance');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER3','accepted','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='open','worker explicitly accepts after platform continue');\n    $admin->resolve($operator,'CHAT-REPAIR','CHAT-AFTER3','closed','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly'\n        && (int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0,'actual platform closure ends both guard and episode');\n    $disabled=new DatabaseChatRepairEpisodes(new Database([]));\n    policyAssert($disabled->acceptWorker(0,0,0)===null,'disabled episode writer does no IO');\n    echo \"售后明确受理、授权区间、完成/撤回/平台关闭、继续处理与回滚验证通过\\n\";\n}\n","server/tests/chat_schema_contract.php":"<?php\n\ndeclare(strict_types=1);\n\n// Check every historical checksum before touching an explicitly isolated database.\n$root = dirname(__DIR__,2);\n$manifest = json_decode((string)file_get_contents($root.'/server/database/upgrades/manifest.json'),true,64,JSON_THROW_ON_ERROR);\nforeach ($manifest['upgrades'] as $row) {\n    if (!hash_equals($row['checksum'],hash_file('sha256',$root.'/server/database/upgrades/'.$row['file']))) throw new RuntimeException('Historical SQL checksum mismatch: '.$row['version']);\n}\nif (!hash_equals($manifest['install_checksum'],hash_file('sha256',$root.'/server/database/database.sql'))) throw new RuntimeException('Install checksum mismatch');\n$last = end($manifest['upgrades']);\nif (trim((string)file_get_contents($root.'/server/VERSION')) !== $last['version']) throw new RuntimeException('Server version differs from manifest');\necho \"聊天安装与历史迁移校验通过\\n\";\nif (getenv('CHAT_AUTH_TEST_INTEGRATION') !== '1') { echo \"隔离数据库结构验证未启用\\n\"; exit; }\n\nrequire_once $root.'/server/app/Support/SqlScriptRunner.php';\nuse WorkerAdmin\\Support\\SqlScriptRunner;\n\n$address = (string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');\nif (preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$match) !== 1) throw new RuntimeException('Explicit loopback test endpoint required');\n$pdo = new PDO('mysql:host=127.0.0.1;port='.(int)$match[1].';charset=utf8mb4','root',(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),[\n    PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_EMULATE_PREPARES=>false,\n]);\n$pdo->exec(\"SET time_zone='+00:00'\");\n$runner = new SqlScriptRunner();\n$database = 'bixuan_test_chat_schema_'.bin2hex(random_bytes(6));\n$pdo->exec('CREATE DATABASE `'.$database.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\ntry {\n    $pdo->exec('USE `'.$database.'`');\n    $runner->runFile($pdo,$root.'/server/database/database.sql');\n    $before = [];\n    $tables = $pdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);\n    foreach ($tables as $table) $before[$table] = $pdo->query('SHOW CREATE TABLE `'.$table.'`')->fetch(PDO::FETCH_NUM)[1];\n    // Only one unreleased package follows the actually released 2.6.0.\n    if ($last['version']!=='2.7.0' || array_filter($manifest['upgrades'],static fn(array $r):bool=>version_compare($r['version'],'2.7.0','>'))) throw new RuntimeException('Unreleased package must stay at 2.7.0');\n    foreach (['2.6.0','2.7.0','2.7.0'] as $version) $runner->runFile($pdo,$root.'/server/database/upgrades/'.$version.'.sql');\n    $normalize=static fn(string $ddl):string=>(string)preg_replace('/ AUTO_INCREMENT=[0-9]+/','',$ddl);\n    $compare=static function()use($pdo,$before,$normalize):void{\n        $actual=$pdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);\n        $expected=array_keys($before);sort($actual);sort($expected);\n        if($actual!==$expected)throw new RuntimeException('Install/upgrade table set mismatch');\n        foreach($before as $table=>$ddl){$after=$pdo->query('SHOW CREATE TABLE `'.$table.'`')->fetch(PDO::FETCH_NUM)[1];if($normalize($after)!==$normalize($ddl))throw new RuntimeException('Install/upgrade schema mismatch: '.$table);}\n    };\n    $compare();\n    // Previously applied unreleased S14/S15 packages can receive these columns\n    // through the same amended package, without a new release number.\n    $pdo->exec('ALTER TABLE chat_messages DROP COLUMN reply_to_message_id,DROP COLUMN edited_from_recalled_message_id,DROP COLUMN reedit_depth,DROP COLUMN recalled_at,DROP COLUMN reply_to_item_id');\n    foreach([1,2] as $repeat)$runner->runFile($pdo,$root.'/server/database/upgrades/2.7.0.sql');\n    $compare();\n    foreach(['chat_image_reports','chat_image_objects','chat_image_audit','chat_image_items','chat_image_bundles','chat_image_uploads'] as $table)$pdo->exec('DROP TABLE `'.$table.'`');\n    $pdo->exec('ALTER TABLE chat_messages DROP COLUMN reply_to_item_id');\n    foreach([1,2] as $repeat)$runner->runFile($pdo,$root.'/server/database/upgrades/2.7.0.sql');\n    $compare();\n    foreach (['chat_image_reports','chat_image_uploads','chat_image_bundles','chat_image_items','chat_image_audit','chat_image_objects','chat_admin_sessions','chat_policy_guards','chat_business_events','chat_repair_episodes','chat_policy_refresh','chat_conversations','chat_members','chat_member_intervals','chat_member_reads','chat_user_preferences','chat_preference_accounts','chat_event_receipts','chat_restrictions','chat_send_intents','chat_messages','chat_message_changes','chat_text_checks','chat_risk_events','order_platform_terms','order_pricing_items','platform_order_refund_reviews','platform_order_manual_receipts','test_batches','test_instances','test_entry_tokens'] as $table) {\n        if ((int)$pdo->query('SELECT COUNT(*) FROM `'.$table.'`')->fetchColumn() !== 0) throw new RuntimeException('Fresh install contains session/test data');\n    }\n    // Archived immutable main/2.6.0 schema is a compressed test fixture, never\n    // an extra deployment migration or a generated approximation of old state.\n    $metadata=json_decode((string)file_get_contents(__DIR__.'/fixtures/schema-2.6.0.json'),true,16,JSON_THROW_ON_ERROR);\n    $legacy=gzdecode((string)file_get_contents(__DIR__.'/fixtures/schema-2.6.0.sql.gz'));\n    if($legacy===false||!hash_equals($metadata['sha256'],hash('sha256',$legacy)))throw new RuntimeException('2.6.0 fixture checksum mismatch');\n    $upgraded=$database.'_upgrade';$pdo->exec('CREATE DATABASE `'.$upgraded.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n    try{\n        $pdo->exec('USE `'.$upgraded.'`');$runner->run($pdo,$legacy,'immutable-2.6.0-baseline');\n        // Match a deployed 2.6.0 database including its released migration.\n        $runner->runFile($pdo,$root.'/server/database/upgrades/2.6.0.sql');\n        $pdo->exec(\"INSERT INTO users(id,public_id,nickname,status,created_at,updated_at) VALUES(902601,REPEAT('U',26),'升级保留账号','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        $pdo->exec(\"INSERT INTO user_wallets(user_id,available_cents,reserved_cents,created_at,updated_at) VALUES(902601,12345,0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        foreach([1,2] as $repeat)$runner->runFile($pdo,$root.'/server/database/upgrades/2.7.0.sql');\n        $compare();\n        if((string)$pdo->query('SELECT available_cents FROM user_wallets WHERE user_id=902601')->fetchColumn()!=='12345')throw new RuntimeException('Upgrade changed existing wallet data');\n        if((string)$pdo->query('SELECT nickname FROM users WHERE id=902601')->fetchColumn()!=='升级保留账号')throw new RuntimeException('Upgrade changed existing user data');\n        if((int)$pdo->query('SELECT COUNT(*) FROM chat_member_reads')->fetchColumn()!==0)throw new RuntimeException('Upgrade wrote read state');\n    }finally{$pdo->exec('USE `'.$database.'`');$pdo->exec('DROP DATABASE IF EXISTS `'.$upgraded.'`');}\n    echo \"真实2.6.0→2.7.0整包、重复升级、账号/钱包保留与新装结构一致通过\\n\";\n    $trigger=$pdo->query(\"SELECT COUNT(*) FROM information_schema.triggers WHERE trigger_schema=DATABASE() AND trigger_name='chat_admin_identity_revoke'\")->fetchColumn();\n    if ((int)$trigger !== 1) throw new RuntimeException('Admin revocation trigger missing');\n    $count=(int)$pdo->query(\"SELECT COUNT(*) FROM information_schema.triggers WHERE trigger_schema=DATABASE() AND trigger_name LIKE 'chat_staff_%'\")->fetchColumn();\n    if($count!==9)throw new RuntimeException('Platform authority revocation triggers missing');\n    if((int)$pdo->query('SELECT COUNT(*) FROM chat_staff_authority_versions')->fetchColumn()!==(int)$pdo->query('SELECT COUNT(*)+1 FROM users')->fetchColumn())throw new RuntimeException('Initial authority generations missing');\n    $pdo->beginTransaction();\n    try {\n        $pdo->exec(\"INSERT INTO admin_users(username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES('chat-schema-fixture','fixture','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        $adminID=(string)$pdo->lastInsertId();\n        $statement=$pdo->prepare(\"INSERT INTO chat_admin_sessions(admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(?,REPEAT('a',64),REPEAT('b',64),REPEAT('c',64),'[\\\"chat:audit\\\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())\");\n        $statement->execute([$adminID]);\n        $pdo->exec(\"UPDATE admin_users SET role='viewer' WHERE id=\".$adminID);\n        if ((int)$pdo->query('SELECT COUNT(*) FROM chat_admin_sessions WHERE revoked_at IS NOT NULL')->fetchColumn() !== 1) throw new RuntimeException('Fresh trigger failed to revoke');\n    } finally { $pdo->rollBack(); }\n    echo '隔离新装与重复迁移结构验证通过，表数='.count($tables).\"\\n\";\n    // Historical S16 reports migrate once even after a later recall increments\n    // the message version. New ban generations still have separate appeals.\n    $pdo->exec(\"INSERT INTO chat_conversations(id,conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at,last_seq) VALUES(990001,'order','order:990001:assignment:990001',990001,990001,1,REPEAT('a',64),'assignment:990001:service','readonly',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6),1)\");\n    $pdo->exec(\"INSERT INTO chat_messages(id,conversation_id,seq,sender_id,client_message_id,policy_version,message_type,state,state_version,safety_rule_version,created_at) VALUES(990001,990001,1,990001,CONCAT('1700000000.',REPEAT('a',32)),1,'image','published',1,'fixture',UTC_TIMESTAMP(6))\");\n    $pdo->exec(\"INSERT INTO chat_image_reports(reporter_id,conversation_id,message_id,item_id,reason,created_at) VALUES(990002,990001,990001,0,'历史图片举报',UTC_TIMESTAMP(6))\");\n    $runner->runFile($pdo,$root.'/server/database/upgrades/2.7.0.sql');\n    $pdo->exec(\"UPDATE chat_messages SET state='recalled',state_version=2 WHERE id=990001\");\n    $runner->runFile($pdo,$root.'/server/database/upgrades/2.7.0.sql');\n    if((int)$pdo->query(\"SELECT COUNT(*) FROM chat_cases WHERE kind='report' AND target_id=990001\")->fetchColumn()!==1)throw new RuntimeException('Report migration duplicated after message state change');\n    echo \"历史举报在撤回增版后重复升级仍幂等通过\\n\";\n} finally { $pdo->exec('DROP DATABASE IF EXISTS `'.$database.'`'); }","server/tests/chat_storage_contract.php":"<?php\ndeclare(strict_types=1);\nrequire_once dirname(__DIR__).'/app/Core/Database.php';\nrequire_once dirname(__DIR__).'/app/Application/Chat/ChatStorageSettings.php';\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Application\\Chat\\ChatStorageSettings;\nfinal class StorageFixtureDB extends Database {\n public array $policy;public string $revision='1';public int $writes=0;public string $role='super_admin';\n public function __construct(array $policy){parent::__construct([]);$this->policy=$policy;}\n public function fetch($sql,array $params=[]){\n  if(str_contains($sql,'admin_users'))return ['role'=>$this->role];\n  if(str_contains($sql,'chat_storage_policy WHERE'))return ['revision'=>$this->revision,'policy_json'=>json_encode($this->policy),'apply_through_id'=>'0','updated_at'=>'fixture'];\n  return null;\n }\n public function fetchAll($sql,array $params=[]){return [];}\n public function fetchValue($sql,array $params=[]){return '100';}\n public function transaction(callable $callback){$revision=$this->revision;$writes=$this->writes;try{return $callback($this);}catch(Throwable $e){$this->revision=$revision;$this->writes=$writes;throw $e;}}\n public function execute($sql,array $params=[]){$this->writes++;if(str_starts_with($sql,'UPDATE chat_storage_policy'))$this->revision=(string)$params['next'];return 1;}\n}\nfunction check(bool $ok,string $name):void{if(!$ok)throw new RuntimeException($name);}\nfunction rejected(callable $fn,string $name):void{try{$fn();}catch(Throwable $e){return;}throw new RuntimeException('Accepted '.$name);}\n$p=json_decode('{\"schema\":1,\"retention\":{\"text\":{\"mode\":\"permanent\",\"days\":0},\"image\":{\"mode\":\"permanent\",\"days\":0},\"audio\":{\"mode\":\"permanent\",\"days\":0},\"video\":{\"mode\":\"days\",\"days\":60}},\"tiering\":{\"enabled\":false,\"images\":true,\"audio\":true,\"videos\":false,\"age_days\":60,\"idle_days\":30,\"min_bytes\":65536,\"remaining_days\":32,\"batch\":20},\"quota\":{\"video_count\":20,\"video_bytes\":104857600}}',true,32,JSON_THROW_ON_ERROR);\nChatStorageSettings::validate($p);\n$bad=$p;$bad['retention']['video']=['mode'=>'permanent','days'=>60];rejected(fn()=>ChatStorageSettings::validate($bad),'contradictory retention');\n$bad=$p;$bad['tiering']['enabled']='0';rejected(fn()=>ChatStorageSettings::validate($bad),'string boolean');\n$bad=$p;$bad['tiering']['remaining_days']=30;rejected(fn()=>ChatStorageSettings::validate($bad),'low frequency insufficient remaining life');\n$input=['revision'=>'1','apply_existing'=>'1','reason'=>'测试配置',\n 'text_mode'=>'permanent','image_mode'=>'permanent','audio_mode'=>'permanent','video_mode'=>'days','video_days'=>'60',\n 'tier_enabled'=>'0','tier_images'=>'1','tier_audio'=>'1','tier_videos'=>'0','tier_age_days'=>'60','tier_idle_days'=>'30','tier_min_kb'=>'64','tier_remaining_days'=>'32','tier_batch'=>'20','video_count'=>'20','video_mb'=>'100'];\n$db=new StorageFixtureDB($p);$service=new ChatStorageSettings($db,str_repeat('k',32));$preview=$service->preview($input,9);\ncheck($preview['through']==='100','bounded existing range');\n$input['preview_token']=$preview['preview_token'];\n$tampered=$input;$tampered['video_days']='1';rejected(fn()=>$service->save($tampered,9,'super_admin'),'policy tamper');\nrejected(fn()=>$service->save($input,10,'super_admin'),'other administrator token');\n$db->role='viewer';rejected(fn()=>$service->save($input,9,'super_admin'),'revoked administrator');\n$db->role='super_admin';$service->save($input,9,'super_admin');check($db->writes===2&&$db->revision==='2','policy and audit committed');\nrejected(fn()=>$service->save($input,9,'super_admin'),'stale revision');check($db->writes===2,'stale save wrote');\necho \"Storage policy validation, preview binding, revoked authority, revision and audit passed\\n\";\n\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')==='1'){\n require_once dirname(__DIR__).'/app/Support/SqlScriptRunner.php';\n $address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');\n if(preg_match('/^127\\\\.0\\\\.0\\\\.1:([0-9]+)$/D',$address,$match)!==1)throw new RuntimeException('Explicit loopback fixture required');\n $config=['host'=>'127.0.0.1','port'=>(int)$match[1],'username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n $pdo=new PDO('mysql:host=127.0.0.1;port='.(int)$match[1].';charset=utf8mb4','root',$config['password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);\n $name='bixuan_test_chat_storage_'.bin2hex(random_bytes(5));$pdo->exec('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n try{\n  $pdo->exec('USE `'.$name.'`');(new WorkerAdmin\\Support\\SqlScriptRunner())->runFile($pdo,dirname(__DIR__).'/database/database.sql');\n  $config['database']=$name;$db=new Database($config);\n  $db->execute(\"INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(9,'storage-fixture','fixture','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n  $service=new ChatStorageSettings($db,str_repeat('k',32));$input['revision']='1';$input['apply_existing']='0';unset($input['preview_token']);$preview=$service->preview($input,9);$input['preview_token']=$preview['preview_token'];\n  $service->save($input,9,'super_admin');\n  check((string)$db->fetchValue('SELECT revision FROM chat_storage_policy WHERE id=1')==='2','real revision');\n  check((int)$db->fetchValue('SELECT COUNT(*) FROM chat_storage_policy_audit')===1,'real append audit');\n  rejected(fn()=>$service->save($input,9,'super_admin'),'real stale CAS');check((int)$db->fetchValue('SELECT COUNT(*) FROM chat_storage_policy_audit')===1,'stale save atomic');\n  $input['revision']='2';$preview=$service->preview($input,9);$input['preview_token']=$preview['preview_token'];\n  $db->execute(\"UPDATE admin_users SET role='viewer' WHERE id=9\");rejected(fn()=>$service->save($input,9,'super_admin'),'real administrator revocation');\n  check((string)$db->fetchValue('SELECT revision FROM chat_storage_policy WHERE id=1')==='2','revocation no writes');\n  echo \"Real MySQL storage policy, audit, stale CAS and revocation passed\\n\";\n }finally{$pdo->exec('DROP DATABASE IF EXISTS `'.$name.'`');}\n}\n","server/tests/chat_text_security_contract.php":"<?php\n\ndeclare(strict_types=1);\n\n// Pure isolated coordinator tests. No real AppSecret, WeChat or notifications.\n$root=dirname(__DIR__,2);\nspl_autoload_register(static function(string $class)use($root):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)!==0)return;$path=$root.'/server/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($path))require_once $path;});\nuse WorkerAdmin\\Infrastructure\\External\\WeChatAccessTokenProvider;\nfunction app_config(string $key,$default=null){return $GLOBALS['s07_settings'][$key]??$default;}\nfunction setting(string $key,$default=null){return $GLOBALS['s07_settings'][$key]??$default;}\nfunction base_path(string $path=''):string{return $GLOBALS['s07_root'].($path!==''?'/'.$path:'');}\nfunction s07_assert(bool $ok,string $message):void{if(!$ok)throw new RuntimeException($message);}\nfunction s07_remove(string $dir):void{foreach(scandir($dir)?:[] as $name){if($name==='.'||$name==='..')continue;$path=$dir.'/'.$name;if(is_dir($path)&&!is_link($path))s07_remove($path);else unlink($path);}rmdir($dir);}\nfunction s07_provider(string $directory,string $secret='fixture-secret',?callable $request=null,string $environment='test'):WeChatAccessTokenProvider{\n return new WeChatAccessTokenProvider($environment,'chat-platform-app',$secret,$directory.'/tokens',$directory.'/export',$request??static function():array{return ['access_token'=>'s07_fixture_official_token','expires_in'=>7200];});\n}\n$mode=$argv[1]??'';\nif(in_array($mode,['--child','--export'],true)){\n $directory=$argv[2]??'';\n if(!is_dir($directory)||is_link($directory)||preg_match('/^bixuan-s07-[a-zA-Z0-9]+$/D',basename($directory))!==1)throw new RuntimeException('Explicit S07 fixture directory required');\n if($mode==='--export'){\n  if(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1')throw new RuntimeException('Explicit integration fixture required');\n  s07_provider($directory)->get();echo \"exported\\n\";exit;\n }\n $provider=s07_provider($directory,'fixture-secret',static function()use($directory):array{\n  file_put_contents($directory.'/requests','refresh\\n',FILE_APPEND|LOCK_EX);usleep(200000);\n  return ['access_token'=>'s07_fixture_official_token','expires_in'=>7200];\n });\n $provider->get();echo \"ok\\n\";exit;\n}\n$directory=sys_get_temp_dir().'/bixuan-s07-'.bin2hex(random_bytes(6));mkdir($directory,0700);\ntry{\n // Eight independent PHP processes contend for the same credential lock.\n $processes=[];\n for($i=0;$i<8;$i++){\n  $pipes=[];$process=proc_open([PHP_BINARY,__FILE__,'--child',$directory],[0=>['pipe','r'],1=>['pipe','w'],2=>['pipe','w']],$pipes);\n  s07_assert(is_resource($process),'child startup');fclose($pipes[0]);$processes[]=[$process,$pipes];\n }\n foreach($processes as [$process,$pipes]){$out=stream_get_contents($pipes[1]);$error=stream_get_contents($pipes[2]);fclose($pipes[1]);fclose($pipes[2]);s07_assert(proc_close($process)===0&&trim($out)==='ok','concurrent credential child failed: '.$error);}\n s07_assert(substr_count((string)file_get_contents($directory.'/requests'),'refresh')===1,'multiple concurrent refreshers');\n $provider=s07_provider($directory);$token=$provider->get();$export=$provider->exportPath();$data=json_decode((string)file_get_contents($export),true);\n s07_assert($data['env']==='test'&&$data['app_id']==='chat-platform-app'&&$data['generation']===$provider->generation($token),'export scope/generation');\n s07_assert(!array_key_exists('credential_hash',$data)&&strpos(json_encode($data),'fixture-secret')===false,'AppSecret exported');\n s07_assert((fileperms($export)&0777)===0640,'export mode');\n s07_assert($provider->metadata()['status']==='ready','read-only export preflight');\n chmod($export,0644);clearstatcache(true,$export);try{$provider->metadata();throw new LogicException('insecure export reported ready');}catch(RuntimeException $expected){}\n $provider->get();clearstatcache(true,$export);s07_assert((fileperms($export)&0777)===0640,'coordinator did not repair export permissions');\n $generation=$provider->generation($token);s07_assert($provider->rejectGeneration(str_repeat('a',64))===false,'unrelated invalidation');\n s07_assert($provider->rejectGeneration($generation),'rejected generation not invalidated');\n $revoked=json_decode((string)file_get_contents($export),true);s07_assert($revoked['token']===''&&$revoked['expires_at']===0,'revocation must stop cached Go generation');\n $fresh=s07_provider($directory,'fixture-secret',static function():array{return ['access_token'=>'s07_fixture_rotated_token','expires_in'=>7200];});$fresh->get();\n s07_assert($provider->rejectGeneration($generation)===false,'late invalidation erased a newer token');\n // TTL must never be inflated; valid old token survives a refresh outage.\n $shortDir=$directory.'/short';mkdir($shortDir,0700);\n $short=s07_provider($shortDir,'fixture-secret',static function():array{return ['access_token'=>'s07_fixture_short_token','expires_in'=>60];});$short->get();$shortData=json_decode((string)file_get_contents($short->exportPath()),true);\n s07_assert($shortData['expires_at']-$shortData['issued_at']===60,'provider TTL extended');\n $failing=s07_provider($shortDir,'fixture-secret',static function():array{throw new RuntimeException('secret fixture must not leak');});s07_assert($failing->get()==='s07_fixture_short_token','valid credential outage fallback');\n $expiry=json_decode((string)file_get_contents($short->exportPath()),true);s07_assert($expiry['expires_at']===$shortData['expires_at'],'fallback extended expiry');\n foreach(glob($shortDir.'/tokens/*.json')?:[] as $file){$row=json_decode((string)file_get_contents($file),true);$row['issued_at']=time()-100;$row['expires_at']=time()-1;file_put_contents($file,json_encode($row));}\n try{$failing->get();throw new LogicException('expired credential used');}catch(RuntimeException $e){s07_assert(strpos($e->getMessage(),'secret fixture')===false,'raw credential transport error leaked');}\n // A changed AppSecret cannot reuse the previous configuration cache.\n $rotated=s07_provider($directory,'new-fixture-secret',static function():array{return ['access_token'=>'s07_fixture_new_secret','expires_in'=>7200];});s07_assert($rotated->get()==='s07_fixture_new_secret','secret rotation reused old credential');\n $other=s07_provider($directory,'new-fixture-secret',static function():array{return ['access_token'=>'s07_fixture_production','expires_in'=>7200];},'production');s07_assert($other->get()==='s07_fixture_production','cross-environment credential collision');\n // All five legacy callers use the same coordinator cache, including the\n // subscription Infrastructure adapter. No constructor injection in runtime.\n $GLOBALS['s07_root']=$directory.'/legacy';mkdir($GLOBALS['s07_root'],0700);\n $GLOBALS['s07_settings']=['app.env'=>'test','wechat.miniapp_appid'=>'chat-platform-app','wechat.miniapp_secret'=>'fixture-secret','chat.safety_credential_export_enabled'=>true];\n $legacy=new WeChatAccessTokenProvider('test','chat-platform-app','fixture-secret',base_path('storage/private/wechat-tokens'),base_path('storage/private/chat-credentials'),static function():array{return ['access_token'=>'s07_fixture_shared_legacy','expires_in'=>7200];});$legacy->get();\n foreach(['Services\\\\WeChatContentSecurityService','Services\\\\WeChatCloudSyncService','Services\\\\MiniProgramCodeService','Services\\\\WorkerCloudGatewayService','Infrastructure\\\\External\\\\WeChatSubscribeGateway'] as $name){\n  $class='WorkerAdmin\\\\'.$name;$object=new $class();$method=new ReflectionMethod($class,'accessToken');s07_assert($method->invoke($object)==='s07_fixture_shared_legacy','legacy caller has independent refresh path: '.$name);\n }\n echo \"S07统一凭证并发、代次撤销、真实TTL、失效关闭、环境隔离及五个PHP调用方通过\\n\";\n}finally{s07_remove($directory);}\n","server/tests/fixtures/schema-2.6.0.json":"{\n  \"repository\": \"franz-9527/workers\",\n  \"source_commit\": \"8fcae77245205bb47e9457c70e5c264ee013706f\",\n  \"git_blob\": \"d3f26c8ca95edc3242aa89f52fb0fdd20575c947\",\n  \"sha256\": \"2d8d088ef268ca3b7ddf3137098a366d95620561b1fd5a6a3a296f72e71dcf8e\",\n  \"version\": \"2.6.0\"\n}\n","server/tests/fixtures/schema-2.6.0.sql.gz":"H4sIAAAAAAACA+y9aXMbyZUo+t2/As8RL6ieQauxE/ANR4ymW+ORpxdPL353\n7vUNdAEokGWBAIyFas6NiSBb4iZxk0QtlKiFkiipWxIotTaKIMUfY1QB+NR/\n4eVWWZm1ALWBZI/tGcsgUHnyZFbm2ZcPPwz8MXI8cjwVyJbGygWxJgakYrUm\nFAqBjFAVC1JRPP6rDz8M/E4sihWhJuYCmYmANFYuVWpScSRQGxUD5YpUqmjD\n1WEBoZgLSDkRPFsTi7XCBHikOC5WRvC4Sqk+MhrI1isV8GMAoXC8+pdCoFQM\nfDbx1b9/GogfHz4ei6HJvyrVK1kxUMoHapV6bTSQB/OJ46VCvSaBxyvimABw\nDuSEmgAn/6