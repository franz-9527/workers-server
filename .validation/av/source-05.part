'更新时间';\nALTER TABLE `worker_collection_codes`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `code_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'wechat' COMMENT '代码类型',\n  MODIFY COLUMN `media_file_id` bigint(20) unsigned DEFAULT NULL COMMENT '媒体文件ID',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft' COMMENT '状态',\n  MODIFY COLUMN `review_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核原因',\n  MODIFY COLUMN `submitted_at` datetime DEFAULT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `worker_payout_accounts`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `account_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'alipay' COMMENT '账户类型',\n  MODIFY COLUMN `holder_name_masked` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '户名名称脱敏值',\n  MODIFY COLUMN `holder_name_ciphertext` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '户名名称密文',\n  MODIFY COLUMN `account_masked` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '账户脱敏值',\n  MODIFY COLUMN `account_ciphertext` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '账户密文',\n  MODIFY COLUMN `account_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '账户HMAC摘要',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `is_default` tinyint(3) unsigned NOT NULL DEFAULT '1' COMMENT '是否默认',\n  MODIFY COLUMN `verified_at` datetime DEFAULT NULL COMMENT '认证时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `worker_payouts`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `withdrawal_request_id` bigint(20) unsigned NOT NULL COMMENT '提现请求ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `amount_cents` bigint(20) unsigned NOT NULL COMMENT '金额（分）',\n  MODIFY COLUMN `channel` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'alipay_manual' COMMENT '渠道',\n  MODIFY COLUMN `external_transaction_no` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '外部交易编号',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'paid' COMMENT '状态',\n  MODIFY COLUMN `proof_media_id` bigint(20) unsigned DEFAULT NULL COMMENT '凭证媒体ID',\n  MODIFY COLUMN `paid_by` bigint(20) unsigned DEFAULT NULL COMMENT '已支付操作人',\n  MODIFY COLUMN `paid_at` datetime NOT NULL COMMENT '已支付时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `worker_phone_reveal_logs`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `viewer_user_id` bigint(20) unsigned NOT NULL COMMENT '查看者用户ID',\n  MODIFY COLUMN `viewer_role` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '查看者角色',\n  MODIFY COLUMN `worker_cloud_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '师傅云端ID',\n  MODIFY COLUMN `mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '手机号HMAC摘要',\n  MODIFY COLUMN `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '结果',\n  MODIFY COLUMN `reason_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT '原因代码',\n  MODIFY COLUMN `ip_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT 'IPHMAC摘要',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `worker_profiles`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `display_name` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '显示名称',\n  MODIFY COLUMN `mobile_masked` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '手机号脱敏值',\n  MODIFY COLUMN `mobile_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '手机号密文',\n  MODIFY COLUMN `mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '手机号HMAC摘要',\n  MODIFY COLUMN `verification_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '认证状态',\n  MODIFY COLUMN `invited_only` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否仅邀请',\n  MODIFY COLUMN `city` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '城市',\n  MODIFY COLUMN `district` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '区县',\n  MODIFY COLUMN `address_masked` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '地址脱敏值',\n  MODIFY COLUMN `address_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '地址密文',\n  MODIFY COLUMN `lat` decimal(10,7) DEFAULT NULL COMMENT '纬度',\n  MODIFY COLUMN `lng` decimal(11,7) DEFAULT NULL COMMENT '经度',\n  MODIFY COLUMN `coordinate_system` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'GCJ-02' COMMENT '坐标系'