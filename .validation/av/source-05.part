'决定操作人',\n  MODIFY COLUMN `decided_at` datetime NOT NULL COMMENT '决定时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `order_cancel_requests`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `applicant_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '申请人类型',\n  MODIFY COLUMN `applicant_id` bigint(20) unsigned DEFAULT NULL COMMENT '申请人ID',\n  MODIFY COLUMN `request_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'cancel_refund' COMMENT '请求类型',\n  MODIFY COLUMN `order_state_snapshot_json` longtext COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '订单状态快照JSON',\n  MODIFY COLUMN `reason_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '原因代码',\n  MODIFY COLUMN `reason` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原因',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `requested_refund_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '申请退款（分）',\n  MODIFY COLUMN `requested_at` datetime NOT NULL COMMENT '申请时间',\n  MODIFY COLUMN `closed_at` datetime DEFAULT NULL COMMENT '关闭时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_categories`\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `category_id` bigint(20) unsigned NOT NULL COMMENT '类目ID',\n  MODIFY COLUMN `category_name_snapshot` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '类目名称快照',\n  MODIFY COLUMN `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `order_deadline