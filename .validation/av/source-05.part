nts','quote_items','reconciliation_records','subscription_preferences',\n  'upload_sessions','worker_locations','worker_skills','worker_cloud_media_imports'\n);\n\nDELETE FROM `database_field_dictionary` WHERE `table_name`='form_fields' AND `field_name`='category_id';\n\n-- 2026-09-29：全部保留表的物理字段补充中文 COMMENT，phpMyAdmin 可直接查看中文说明。\nALTER TABLE `admin_users`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `username` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '登录账号',\n  MODIFY COLUMN `password_hash` varchar(255) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '密码哈希',\n  MODIFY COLUMN `real_name` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '真实姓名',\n  MODIFY COLUMN `role` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'operator' COMMENT '角色',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `must_change_password` tinyint(3) unsigned NOT NULL DEFAULT '1' COMMENT '是否必须修改密码',\n  MODIFY COLUMN `failed_attempts` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '登录失败次数',\n  MODIFY COLUMN `locked_until` datetime DEFAULT NULL COMMENT '锁定截止时间',\n  MODIFY COLUMN `last_login_at` datetime DEFAULT NULL COMMENT '最后登录时间',\n  MODIFY COLUMN `last_login_ip` varchar(45) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '最后登录IP',\n  MODIFY COLUMN `password_changed_at` datetime DEFAULT NULL COMMENT '密码修改时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `after_sales`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '类型',\n  MODIFY COLUMN `description` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '描述',\n  MODIFY COLUMN `warranty_months_snapshot` smallint(5) unsigned DEFAULT NULL COMMENT '保修月数快照',\n  MODIFY COLUMN `warranty_expires_at_snapshot` datetime DEFAULT NULL COMMENT '保修到期时间快照',\n  MODIFY COLUMN `non_human_confirmed` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否确认非人为原因',\n  MODIFY COLUMN `evidence_media_ids_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '证据媒体ID列表JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT '状态',\n  MODIFY COLUMN `handled_by` bigint(20) unsigned DEFAULT NULL COMMENT '处理管理员ID',\n  MODIFY COLUMN `resolution` text COLLATE utf8mb4_unicode_ci COMMENT '处理结果',\n  MODIFY COLUMN `opened_at` datetime NOT NULL COMMENT '开启时间',\n  MODIFY COLUMN `closed_at` datetime DEFAULT NULL COMMENT '关闭时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `appointment_records`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `appointment_at` datetime DEFAULT NULL COMMENT '预约时间',\n  MODIFY COLUMN `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备注',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'recorded' COMMENT '状态',\n  MODIFY COLUMN `context_type` varchar(16) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'service' COMMENT '预约上下文：service施工、repair维修',\n  MODIFY COLUMN `after_sale_id` bigint(20) unsigned DEFAULT NULL COMMENT '维修上下文对应售后记录',\n  MODIFY COLUMN `wait_customer_notice` tinyint(1) NOT NULL DEFAULT '0' COMMENT '1等待客户另行通知',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `assignment_history`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `assignment_id` bigint(20) unsigned NOT NULL COMMENT '派单ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `action` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  MODIFY COLUMN `reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '原因',\n  MODIFY COLUMN `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作者类型',\n  MODIFY COLUMN `actor_id` bigint(20) unsigned DEFAULT NULL COMMENT '操作者ID',\n  MODIFY COLUMN `snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '快照JSON',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `assignments`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `quote_id` bigint(20) unsigned DEFAULT NULL COMMENT '报价ID',\n  MODIFY COLUMN `invite_token_id` bigint(20) unsigned DEFAULT NULL COMMENT '邀请令牌ID',\n  MODIFY COLUMN `assignment_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '派单类型',\n  MODIFY COLUMN `commission_rule_version_id` bigint(20) unsigned NOT NULL COMMENT '服务费规则版本ID',\n  MODIFY COLUMN `final_amount_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '最终金额（分）快照',\n  MODIFY COLUMN `booking_fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '预约费（分）快照',\n  MODIFY COLUMN `commission_rate_bp_snapshot` int(10) unsigned NOT NULL COMMENT '服务费比例（万分比）快照',\n  MODIFY COLUMN `commission_min_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '最低服务费（分）快照',\n  MODIFY COLUMN `estimated_commission_cents` bigint(20) unsigned NOT NULL COMMENT '预计服务费（分）',\n  MODIFY COLUMN `estimated_offline_collect_cents` bigint(20) unsigned NOT NULL COMMENT '预计线下收款（分）',\n  MODIFY COLUMN `estimated_net_income_cents` bigint(20) NOT NULL COMMENT '预计净额收入（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'offered' COMMENT '状态',\n  MODIFY COLUMN `offered_at` datetime NOT NULL COMMENT '报价时间',\n  MODIFY COLUMN `accept_deadline_at` datetime DEFAULT NULL COMMENT '接受截止时间',\n  MODIFY COLUMN `accepted_at` datetime DEFAULT NULL COMMENT '接受时间',\n  MODIFY COLUMN `rejected_at` datetime DEFAULT NULL COMMENT '驳回时间',\n  MODIFY COLUMN `cancelled_at` datetime DEFAULT NULL COMMENT '取消时间',\n  MODIFY COLUMN `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建管理员ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `audit_logs`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '请求ID',\n  MODIFY COLUMN `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作者类型',\n  MODIFY COLUMN `actor_id` bigint(20) unsigned DEFAULT NULL COMMENT '操作者ID',\n  MODIFY COLUMN `actor_name_snapshot` varchar(80) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '操作者名称快照',\n  MODIFY COLUMN `action` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  MODIFY COLUMN `entity_type` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '实体类型',\n  MODIFY COLUMN `entity_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '实体ID',\n  MODIFY COLUMN `before_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '变更前JSON',\n  MODIFY COLUMN `after_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '变更后JSON',\n  MODIFY COLUMN `reason` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '原因',\n  MODIFY COLUMN `ip_address` varchar(45) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT 'IP地址',\n  MODIFY COLUMN `user_agent` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '客户端User-Agent',\n  MODIFY COLUMN `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'success' COMMENT '结果',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `change_confirmations`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `change_request_id` bigint(20) unsigned NOT NULL COMMENT '变更请求ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `decision` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '处理决定',\n  MODIFY COLUMN `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备注',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `change_requests`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `original_amount_cents` bigint(20) unsigned NOT NULL COMMENT '原始金额（分）',\n  MODIFY COLUMN `added_amount_cents` bigint(20) unsigned NOT NULL COMMENT '增加金额（分）',\n  MODIFY COLUMN `new_total_cents` bigint(20) unsigned NOT NULL COMMENT '新总计（分）',\n  MODIFY COLUMN `reason` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原因',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `payment_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '在线加费支付状态；测量单 accepted 后 awaiting_payment/paid/refund_pending/refunded',\n  MODIFY COLUMN `expires_at` datetime DEFAULT NULL COMMENT '到期时间',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `decided_at` datetime DEFAULT NULL COMMENT '决定时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `cloud_identity_mappings`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `wechat_identity_id` bigint(20) unsigned DEFAULT NULL COMMENT '微信身份ID',\n  MODIFY COLUMN `cloud_user_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '云端用户ID',\n  MODIFY COLUMN `cloud_worker_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '云端师傅ID',\n  MODIFY COLUMN `source_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '来源版本',\n  MODIFY COLUMN `source_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '来源摘要',\n  MODIFY COLUMN `sync_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '同步状态',\n  MODIFY COLUMN `last_synced_at` datetime DEFAULT NULL COMMENT '最后同步时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `commission_payments`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `receivable_id` bigint(20) unsigned NOT NULL COMMENT '应收ID',\n  MODIFY COLUMN `payment_order_id` bigint(20) unsigned NOT NULL COMMENT '支付订单ID',\n  MODIFY COLUMN `amount_cents` bigint(20) unsigned NOT NULL COMMENT '金额（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `paid_at` datetime DEFAULT NULL COMMENT '已