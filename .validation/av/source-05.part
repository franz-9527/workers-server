LT 'reported' COMMENT '状态',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `review_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核备注',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_addresses`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `province` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '省份',\n  MODIFY COLUMN `city` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '城市',\n  MODIFY COLUMN `district` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '区县',\n  MODIFY COLUMN `address_summary` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '地址摘要',\n  MODIFY COLUMN `address_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '地址密文',\n  MODIFY COLUMN `address_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '地址HMAC摘要',\n  MODIFY COLUMN `contact_name_masked` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '联系人名称脱敏值',\n  MODIFY COLUMN `contact_name_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '联系人名称密文',\n  MODIFY COLUMN `contact_mobile_masked` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '联系人手机号脱敏值',\n  MODIFY COLUMN `contact_mobile_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '联系人手机号密文',\n  MODIFY COLUMN `contact_mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '联系人手机号HMAC摘要',\n  MODIFY COLUMN `lat` decimal(10,7) DEFAULT NULL COMMENT '纬度',\n  MODIFY COLUMN `lng` decimal(11,7) DEFAULT NULL COMMENT '经度',\n  MODIFY COLUMN `coordinate_system` varchar(16) CHAR