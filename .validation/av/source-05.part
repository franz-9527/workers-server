MMENT '数据JSON',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `order_measurement_hold_extensions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `requested_by_user_id` bigint(20) unsigned NOT NULL COMMENT '申请操作人用户ID',\n  MODIFY COLUMN `old_hold_until` datetime NOT NULL COMMENT '旧冻结截止',\n  MODIFY COLUMN `requested_hold_until` datetime NOT NULL COMMENT '申请冻结截止',\n  MODIFY COLUMN `approved_hold_until` datetime DEFAULT NULL COMMENT '批准冻结截止时间',\n  MODIFY COLUMN `reason` varchar(500) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原因',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `review_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核备注',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_measurement_spaces`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `name` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '名称',\n  MODIFY COLUMN `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  MODIFY COLUMN `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_measurement_states`\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `service_payment_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'unpaid' COMMENT '服务支付状态',\n  MODIFY COLUMN `balance_payment_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '余额支付订单ID',\n  MODIFY COLUMN `result_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'editing' COMMENT '结果状态',\n  MODIFY COLUMN `submitted_at` datetime DEFAULT NULL COMMENT '提交时间',\n  MODIFY COLUMN `auto_accept_at` datetime DEFAULT NULL COMMENT '自动验收时间',\n  MODIFY COLUMN `accepted_at` datetime DEFAULT NULL COMMENT '接受时间',\n  MODIFY COLUMN `settlement_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'none' COMMENT '结算状态',\n  MODIFY COLUMN `gross_amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '总额金额（分）',\n  MODIFY COLUMN `refunded_amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '退款金额（分）',\n  MODIFY COLUMN `service_rate_bp_snapshot` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '服务费比例（万分比）快照',\n  MODIFY COLUMN `service_min_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '最低服务费（分）快照',\n  MODIFY COLUMN `service_fee_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '服务费用（分）',\n  MODIFY COLUMN `worker_net_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '师傅净额（分）',\n  MODIFY COLUMN `hold_until` datetime DEFAULT NULL COMMENT '测量净收入冻结截止，同时是未关联时优惠施工关联资格截止',\n  MODIFY COLUMN `max_hold_until` datetime DEFAULT NULL COMMENT '普通延期最多可批准到此时间',\n  MODIFY COLUMN `settled_at` datetime DEFAULT NULL COMMENT '冻结资金实际释放到可用余额时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_relations`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `relation_type` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '关联类型',\n  MODIFY COLUMN `parent_order_id` bigint(20) unsigned NOT NULL COMMENT '测量订单',\n  MODIFY COLUMN `child_order_id` bigint(20) unsigned NOT NULL COMMENT '施工订单',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '原测量师傅',\n  MODIFY COLUMN `measurement_amount_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '测量金额（分）快照',\n  MODIFY COLUMN `requested_discount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '申请优惠（分）',\n  MODIFY COLUMN `agreed_discount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '协商优惠（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_revisions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `version_before` int(10) unsigned NOT NULL COMMENT '修改前版本',\n  MODIFY COLUMN `version_after` int(10) unsigned NOT NULL COMMENT '版本售后',\n  MODIFY COLUMN `changes_json` longtext COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '变更内容JSON',\n  MODIFY COLUMN `reason` varchar(500) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '原因',\n  MODIFY COLUMN `operator_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作人类型',\n  MODIFY COLUMN `operator_id` bigint(20) unsigned DEFAULT NULL COMMENT '操作人ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `order_role_grants`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `grant_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '授权类型',\n  MODIFY COLUMN `scope_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '范围JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `granted_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '授权操作人管理员ID',\n  MODIFY COLUMN `expires_at` datetime DEFAULT NULL COMMENT '到期时间',\n  MODIFY COLUMN `revoked_at` datetime DEFAULT NULL COMMENT '撤销时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `order_worker_contact_reveal_requests`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `context_type` varchar(16) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'service' COMMENT '上下文类型',\n  MODIFY COLUMN `after_sale_id` bigint(20) unsigned DEFAULT NULL COMMENT '售后售后ID',\n  MODIFY COLUMN `reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '原因',\n  MODIFY COLUMN `eligible_at` datetime NOT NULL COMMENT '资格时间',\n  MODIFY COLUMN `status` varchar(24) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `requested_at` datetime NOT NULL COMMENT '申请时间',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `review_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核备注',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_worker_sms_batches`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `client_request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '客户端请求ID',\n  MODIFY COLUMN `request_fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '请求指纹',\n  MODIFY COLUMN `pricing_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '计价版本',\n  MODIFY COLUMN `unit_fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '单次费用（分）快照',\n  MODIFY COLUMN `confirmed_max_total_cents` bigint(20) unsigned NOT NULL COMMENT '确认最大总计（分）',\n  MODIFY COLUMN `requested_count` tinyint(3) unsigned NOT NULL COMMENT '申请数量',\n  MODIFY COLUMN `valid_count` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '有效数量',\n  MODIFY COLUMN `initial_held_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '初始冻结（分）',\n  MODIFY COLUMN `charged_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '扣费（分）',\n  MODIFY COLUMN `released_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已释放（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'prepared' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `completed_at` datetime DEFAULT NULL COMMENT '完成时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_worker_sms_invites`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `batch_id` bigint(20) unsigned NOT NULL COMMENT '批次ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `candidate_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '候选类型',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned DEFAULT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `cloud_worker_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '云端师傅ID',\n  MODIFY COLUMN `worker_identity_key` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '师傅身份键',\n  MODIFY COLUMN `active_dedupe_key` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '启用去重键',\n  MODIFY COLUMN `retry_of_invite_id` bigint(20) unsigned DEFAULT NULL COMMENT '重试原邀请ID',\n  MODIFY COLUMN `worker_name_snapshot` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '师傅名称快照',\n  MODIFY COLUMN `mobile_masked_snapshot` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '手机号脱敏值快照',\n  MODIFY COLUMN `mobile_ciphertext_snapshot` text COLLATE utf8mb4_unicode_ci COMMENT '手机号密文快照',\n  MODIFY COLUMN `mobile_hmac_snapshot` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '手机号HMAC摘要快照',\n  MODIFY COLUMN `distance_m_snapshot` int(10) unsigned NOT NULL COMMENT '距离（米）快照',\n  MODIFY COLUMN `fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '费用（分）快照',\n  MODIFY COLUMN `delivery_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'prepared' COMMENT '投递状态',\n  MODIFY COLUMN `billing_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'held' COMMENT '账单状态',\n  MODIFY COLUMN `outbox_id` bigint(20) unsigned DEFAULT NULL COMMENT '发件箱ID',\n  MODIFY COLUMN `aliyun_biz_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '阿里云业务ID',\n  MODIFY COLUMN `aliyun_request_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '阿里云请求ID',\n  MODIFY COLUMN `provider_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '服务商代码',\n  MODIFY COLUMN `error_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '错误代码',\n  MODIFY COLUMN `error_message_safe` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '错误消息安全',\n  MODIFY COLUMN `wallet_reservation_id` bigint(20) unsigned DEFAULT NULL COMMENT '钱包预留ID',\n  MODIFY COLUMN `receipt_attempt_count` smallint(5) unsigned NOT NULL DEFAULT '0' COMMENT '回执尝试数量',\n  MODIFY COLUMN `next_receipt_check_at` datetime DEFAULT NULL COMMENT '下次回执检查时间',\n  MODIFY COLUMN `receipt_deadline_at` datetime DEFAULT NULL COMMENT '回执截止时间',\n  MODIFY COLUMN `attempted_at` datetime DEFAULT NULL COMMENT '尝试时间',\n  MODIFY COLUMN `provider_accepted_at` datetime DEFAULT NULL COMMENT '服务商接受时间',\n  MODIFY COLUMN `delivered_at` datetime DEFAULT NULL COMMENT '送达时间',\n  MODIFY COLUMN `failed_at` datetime DEFAULT NULL COMMENT '失败时间',\n  MODIFY COLUMN `charged_at` datetime DEFAULT NULL COMMENT '扣费时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `orders`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `form_schema_version_id` bigint(20) unsigned DEFAULT NULL COMMENT '表单结构版本ID',\n  MODIFY COLUMN `workflow_profile` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'construction' COMMENT '订单工作流：construction施工、measurement测量',\n  MODIFY COLUMN `dispatch_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'multi_quote' COMMENT '施工接单方式：multi_quote多师傅报价、single_grab单师傅抢单',\n  MODIFY COLUMN `expected_fee_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '期望费用计价方式：total总价金额、unit单价文本',\n  MODIFY COLUMN `expected_fee_cents` bigint(20) unsigned DEFAULT NULL COMMENT '用户下单期望总价金额（分）；仅total使用并可在single_grab中直接成交',\n  MODIFY COLUMN `expected_fee_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '用户填写的期望单价说明文本；仅unit使用，不参与金额计算',\n  MODIFY COLUMN `pending_measurement_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '待正式关联的来源测量订单；草稿/待付款阶段不占一对一资格',\n  MODIFY COLUMN `category_id` bigint(20) unsigned DEFAULT NULL COMMENT '类目ID',\n  MODIFY COLUMN `category_name_snapshot` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '不确定类目' COMMENT '类目名称快照',\n  MODIFY COLUMN `category_names_snapshot` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '不确定类目' COMMENT '类目名称列表快照',\n  MODIFY COLUMN `title` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '标题',\n  MODIFY COLUMN `description` text COLLATE utf8mb4_unicode_ci COMMENT '描述',\n  MODIFY COLUMN `quantity_text` varchar(120) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '数量文本',\n  MODIFY COLUMN `wall_height_text` varchar(120) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '墙高说明',\n  MODIFY COLUMN `is_renovation` tinyint(3) unsigned DEFAULT NULL COMMENT '是否翻新',\n  MODIFY COLUMN `expected_visit_at` datetime DEFAULT NULL COMMENT '期望上门时间',\n  MODIFY COLUMN `city` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '城市',\n  MODIFY COLUMN `district` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '区县',\n  MODIFY COLUMN `address_summary` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '地址摘要',\n  MODIFY COLUMN `address_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '地址密文',\n  MODIFY COLUMN `address_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '地址HMAC摘要',\n  MODIFY COLUMN `lat` decimal(10,7) DEFAULT NULL COMMENT '纬度',\n  MODIFY COLUMN `lng` decimal(11,7) DEFAULT NULL COMMENT '经度',\n  MODIFY COLUMN `coordinate_system` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'GCJ-02' COMMENT '坐标系',\n  MODIFY COLUMN `contact_name_masked` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '联系人名称脱敏值',\n  MODIFY COLUMN `contact_name_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '联系人名称密文',\n  MODIFY COLUMN `contact_mobile_masked` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '联系人手机号脱敏值',\n  MODIFY COLUMN `contact_mobile_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '联系人手机号密文',\n  MODIFY COLUMN `contact_mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '联系人手机号HMAC摘要',\n  MODIFY COLUMN `owner_mobile_base_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '所有者手机号基础HMAC摘要',\n  MODIFY COLUMN `order_source_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'consumer' COMMENT '订单来源类型',\n  MODIFY COLUMN `merchant_profile_id` bigint(20) unsigned DEFAULT NULL COMMENT '商家档案ID',\n  MODIFY COLUMN `merchant_risk_level` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'none' COMMENT '商家风险等级',\n  MODIFY COLUMN `audit_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '审核状态',\n  MODIFY COLUMN `audit_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核备注',\n  MODIFY COLUMN `supplement_due_at` datetime DEFAULT NULL COMMENT '补资料截止时间',\n  MODIFY COLUMN `audited_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `publish_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'hidden' COMMENT '发布状态',\n  MODIFY COLUMN `quote_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'waiting' COMMENT '报价状态',\n  MODIFY COLUMN `assignment_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'unassigned' COMMENT '派单状态',\n  MODIFY COLUMN `fulfillment_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'not_started' COMMENT '履约状态',\n  MODIFY COLUMN `payment_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'unpaid' COMMENT '支付状态',\n  MODIFY COLUMN `refund_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'none' COMMENT '退款状态',\n  MODIFY COLUMN `dispute_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin N