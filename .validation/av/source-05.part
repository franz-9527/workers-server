AULT NULL COMMENT 'ID号码HMAC摘要',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft' COMMENT '状态',\n  MODIFY COLUMN `review_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核原因',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `submitted_at` datetime DEFAULT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `worker_verifications`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `submitted_snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '提交快照JSON',\n  MODIFY COLUMN `decision` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '处理决定',\n  MODIFY COLUMN `decision_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '决定原因',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间';\nALTER TABLE `help_categories`\n  MODIFY COLUMN `id` int unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '代码',\n  MODIFY COLUMN `name` varchar(80) NOT NULL COMMENT '名称',\n  MODIFY COLUMN `sort_order` int NOT NULL DEFAULT 0 COMMENT '排序值',\n  MODIFY COLUMN `homepage_featured` tinyint(1) NOT NULL DEFAULT 0 COMMENT '首页推荐',\n  MODIFY COLUMN `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `