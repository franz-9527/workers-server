e NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `commission_rule_versions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `version_no` int(10) unsigned NOT NULL COMMENT '版本编号',\n  MODIFY COLUMN `rate_bp` int(10) unsigned NOT NULL DEFAULT '1000' COMMENT '比例（万分比）',\n  MODIFY COLUMN `min_fee_cents` bigint(20) unsigned NOT NULL DEFAULT '5000' COMMENT '最低费用（分）',\n  MODIFY COLUMN `adjustment_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'default' COMMENT '调整类型',\n  MODIFY COLUMN `adjustment_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '调整原因',\n  MODIFY COLUMN `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建管理员ID',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `locked_at` datetime DEFAULT NULL COMMENT '锁定时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `completion_submissions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `description` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '描述',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'submitted' COMMENT '状态',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `accepted_at` datetime DEFAULT NULL COMMENT '接受时间',\n  MODIFY COLUMN `accepted_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '接受类型',\n  MODIFY COLUMN `warranty_months` smallint(5) unsigned DEFAULT NULL COMMENT '保修月数',\n  MODIFY COLUMN `warranty_expires_at` datetime DEFAULT NULL COMMENT '保修到期时间',\n  MODIFY COLUMN `warranty_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '保修备注',\n  MODIFY COLUMN `version` int(10) unsigned NOT NULL DEFAULT '1' COMMENT '版本号',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `database_field_dictionary`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '字典主键',\n  MODIFY COLUMN `table_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '数据表英文名',\n  MODIFY COLUMN `field_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '字段英文名',\n  MODIFY COLUMN `chinese_name` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '字段中文名',\n  MODIFY COLUMN `description` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '业务说明',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `dispute_evidence`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `dispute_id` bigint(20) unsigned NOT NULL COMMENT '争议ID',\n  MODIFY COLUMN `submitted_by_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '提交人类型',\n  MODIFY COLUMN `submitted_by_id` bigint(20) unsigned DEFAULT NULL COMMENT '提交人ID',\n  MODIFY COLUMN `evidence_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '证据类型',\n  MODIFY COLUMN `description` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '描述',\n  MODIFY COLUMN `media_file_id` bigint(20) unsigned DEFAULT NULL COMMENT '媒体文件ID',\n  MODIFY COLUMN `occurred_at` datetime DEFAULT NULL COMMENT '发生时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `disputes`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 