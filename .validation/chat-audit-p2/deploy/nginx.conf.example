# Add these shared zones ONCE inside nginx.conf http {} (not inside server/location).
# Handshake limiting is only an outer shield; Go still enforces its own pre-auth
# global/per-IP admission before consuming a one-time ticket.
limit_req_zone $binary_remote_addr zone=chat_ws_handshake:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=chat_ws_ip:10m;
limit_conn_zone $server_name zone=chat_ws_global:1m;

# Include these locations inside the EXISTING HTTPS PHP server.
# Keep existing TLS, PHP handler and order routes; run nginx -t before reload.
location = /chat/ws {
    # WebSocket handshake only. Keep limits above normal reconnect bursts:
    # Go applies the tighter 48 global pre-auth / 12 concurrent per-IP gate.
    limit_req zone=chat_ws_handshake burst=60 nodelay;
    limit_req_status 429;
    limit_conn chat_ws_ip 64;
    limit_conn chat_ws_global 400;
    limit_conn_status 429;

    proxy_pass http://127.0.0.1:9501;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 3s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_buffering off;
}
location ^~ /chat/api/v1/ {
    proxy_pass http://127.0.0.1:9501;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    client_max_body_size 64k;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    proxy_buffering off;
    proxy_cache off;
}
# Internal bridge is never exposed by this public PHP virtual host. Give it a
# separate loopback TLS virtual host using the existing FPM pool and a certificate
# matching the configured private HTTPS endpoint; do not expose 9502 or metrics.
location = /chat-internal.php { return 404; }
location = /chat-calls.php { return 404; }
# The private 9502 listener routes /chat/internal/v1/calls/stop-confirmed.
# PHP resource RPC /chat-calls.php belongs in the private TLS/FPM vhost only.
location ^~ /chat/ { return 404; }
location ^~ /internal/ { return 404; }
