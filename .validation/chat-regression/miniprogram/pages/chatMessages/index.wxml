<view class="chat-inbox">
  <view class="chat-page-toolbar inbox-toolbar">
    <view class="chat-toolbar-copy">
      <view class="chat-toolbar-title">{{adminInboxMode && chatFilter === 'all' ? '用户会话' : (chatFilter === 'later' ? '稍后处理' : (chatFilter === 'ended' ? '已结束会话' : '全部会话'))}}</view>
      <view wx:if="{{adminInboxMode}}" class="chat-toolbar-sub">{{adminUserGroups.length}} 位用户 · {{adminConversationCount}} 个会话</view>
      <view wx:elif="{{chatRole !== 'all'}}" class="chat-toolbar-sub">{{chatRole === 'customer' ? '我的下单' : (chatRole === 'worker' ? '我的接单' : '平台协作')}}</view>
    </view>
    <button class="chat-icon-button chat-menu-trigger" bindtap="inboxMenu" aria-label="{{showInboxMenu ? '收起消息菜单' : '消息设置与筛选'}}" aria-expanded="{{showInboxMenu}}"><text class="chat-icon chat-icon-tune" aria-hidden="true"></text></button>
  </view>
  <view wx:if="{{showInboxMenu}}" class="chat-operation-mask" catchtap="closeInboxMenu" catchtouchmove="stopMenuTouch">
    <view class="chat-operation-panel inbox-operation-panel" catchtap="stopMenuTouch" aria-label="消息菜单">
      <view wx:if="{{chatEnabled && isLoggedIn}}" class="chat-operation-group">
        <view class="chat-operation-label">会话状态</view>
        <view class="chat-operation-grid">
          <button class="chat-operation-chip {{chatFilter === 'all' ? 'selected' : ''}}" data-action="filter_all" bindtap="runInboxMenuAction"><text>全部消息</text><text>当前会话</text></button>
          <button class="chat-operation-chip {{chatFilter === 'later' ? 'selected' : ''}}" data-action="filter_later" bindtap="runInboxMenuAction"><text>稍后处理</text><text>待回看</text></button>
          <button class="chat-operation-chip {{chatFilter === 'ended' ? 'selected' : ''}}" data-action="filter_ended" bindtap="runInboxMenuAction"><text>已结束会话</text><text>历史沟通</text></button>
        </view>
        <view class="chat-operation-label inbox-role-label">身份</view>
        <view class="chat-operation-grid">
          <button class="chat-operation-chip {{chatRole === 'all' ? 'selected' : ''}}" data-action="role_all" bindtap="runInboxMenuAction"><text>全部身份</text><text>不限制</text></button>
          <button class="chat-operation-chip {{chatRole === 'customer' ? 'selected' : ''}}" data-action="role_customer" bindtap="runInboxMenuAction"><text>我的下单</text><text>客户身份</text></button>
          <button class="chat-operation-chip {{chatRole === 'worker' ? 'selected' : ''}}" data-action="role_worker" bindtap="runInboxMenuAction"><text>我的接单</text><text>师傅身份</text></button>
          <button wx:if="{{hasPlatformChats || chatRole === 'platform_staff'}}" class="chat-operation-chip {{chatRole === 'platform_staff' ? 'selected' : ''}}" data-action="role_platform_staff" bindtap="runInboxMenuAction"><text>平台协作</text><text>平台身份</text></button>
        </view>
      </view>
      <view class="chat-operation-group">
        <view class="chat-operation-label">设置与支持</view>
        <view class="chat-operation-list">
          <button class="chat-operation-item" data-action="notifications" bindtap="runInboxMenuAction"><text>通知设置</text><text>›</text></button>
          <button wx:if="{{canSwitchChatScope}}" class="chat-operation-item" data-action="scope" bindtap="runInboxMenuAction"><text>{{ordersOnly ? '查看测试会话' : '查看普通会话'}}</text><text>›</text></button>
          <button wx:if="{{chatEnabled && isLoggedIn}}" class="chat-operation-item" data-action="governance" bindtap="runInboxMenuAction"><text>举报与申诉</text><text>›</text></button>
          <button wx:if="{{chatEnabled && directEnabled && !ordersOnly}}" class="chat-operation-item" data-action="direct" bindtap="runInboxMenuAction"><text>私聊管理</text><text>{{directHasMore ? '更多私聊' : '关系与历史'}} ›</text></button>
          <button wx:if="{{chatEnabled && supportEntry && supportEntry.staff && !ordersOnly}}" class="chat-operation-item" data-action="feedback" bindtap="runInboxMenuAction"><text>反馈会话筛选</text><text>归档 / 隐藏 ›</text></button>
          <button wx:if="{{auditAllowed && chatEnabled}}" class="chat-operation-item" data-action="audit" bindtap="runInboxMenuAction"><text>全部订单会话</text><text>只读审计 ›</text></button>
        </view>
      </view>
    </view>
  </view>
  
  <view wx:if="{{checkingLogin}}" class="inbox-placeholder">
    <text class="cuIcon-loading2 cuIconfont-spin placeholder-icon"></text>
    <view class="placeholder-title">正在确认登录状态</view>
  </view>
  <view wx:elif="{{!isLoggedIn}}" class="inbox-placeholder">
    <view class="placeholder-circle"><text class="cuIcon-people"></text></view>
    <view class="placeholder-title">登录后查看消息</view>
    <view class="placeholder-desc">可从“我的”页进入通知与待办</view>
  </view>
  <block wx:else>
    <subscription-health-banner audience="account" active="{{isLoggedIn}}"></subscription-health-banner>
    <view wx:if="{{summaryError}}" class="chat-connection-warning" bindtap="openOrdinaryNotifications" role="button">{{summaryReady ? '通知摘要暂未更新，点击查看通知' : '通知摘要暂不可用，点击查看通知'}}</view>
    <view wx:if="{{chatEnabled && chatStatus === 'unavailable'}}" class="chat-connection-warning">
      <text class="cuIcon-warn"></text> 沟通连接暂不可用，请下拉重试
    </view>
    <view wx:if="{{preferenceError}}" class="chat-connection-warning" role="alert">{{preferenceError}}</view>
    <view wx:if="{{adminInboxError}}" class="chat-connection-warning" role="alert">{{adminInboxError}}</view>
    <view wx:if="{{directSummaryStale && directEnabled && !ordersOnly}}" class="chat-connection-warning" bindtap="openDirect" role="button">部分私聊摘要暂未更新，点击查看私聊</view>
    <!-- 重要通知固定在列表首行；其余消息按真实消息时间混排。 -->
    <view class="conversation-list">
<view wx:if="{{isLoggedIn && !checkingLogin}}" class="conversation-row important-notification is-pinned {{businessTone}}" bindtap="openNotifications" role="button" aria-label="重要通知，{{importantCount}}项需要关注">
    <view class="conversation-avatar important-avatar"><text class="cuIcon-noticefill"></text><view wx:if="{{importantCount > 0}}" class="conversation-unread">{{importantCount > 99 ? '99+' : importantCount}}</view></view>
    <view class="conversation-body">
      <view class="conversation-main"><text class="conversation-title">重要通知</text></view>
      <view class="conversation-preview">{{summaryError ? '通知状态暂未更新，点击重试' : (!summaryReady ? '正在同步待处理事项' : (topTodoText ? ((topTodoRole ? topTodoRole + ' · ' : '') + topTodoText) : (importantCount > 0 ? '有订单新动态，点击查看' : '暂无待处理事项')))}}</view>
    </view>
    <view class="conversation-meta"><text class="important-pin">置顶</text></view>
  </view>
    <block wx:if="{{chatEnabled && supportEntry && !supportEntry.staff && !ordersOnly && chatFilter==='all' && chatRole==='all'}}">
      <view class="conversation-row support-service-row" bindtap="openSupport" role="button" aria-label="{{supportEntry.name}}，{{supportEntry.ownLastText || '平台官方反馈入口'}}">
        <view class="conversation-avatar support-service-avatar"><text class="cuIcon-commentfill"></text><view wx:if="{{supportEntry.ownUnread}}" class="conversation-unread">{{supportEntry.ownUnread>99?'99+':supportEntry.ownUnread}}</view></view>
        <view class="conversation-body">
          <view class="conversation-main"><text class="conversation-title">{{supportEntry.name}}</text><text class="support-service-mark">平台</text></view>
          <view class="conversation-preview">{{supportEntry.ownLastText || '问题反馈 · 体验优化 · 开发建议'}}</view>
        </view>
        <view wx:if="{{supportEntry.ownActivityLabel}}" class="conversation-meta"><text class="conversation-clock">{{supportEntry.ownActivityLabel}}</text></view>
      </view>
    </block>

    <block wx:if="{{adminInboxMode}}">
      <block wx:for="{{adminUserGroups}}" wx:for-item="group" wx:key="key">
        <view class="conversation-row admin-user-group {{group.expanded ? 'is-expanded' : ''}}" data-key="{{group.key}}" bindtap="toggleAdminUserGroup" role="button" aria-expanded="{{group.expanded}}" aria-label="{{group.displayName}}，{{group.conversationCount}}个会话，{{group.expanded ? '收起' : '展开'}}">
          <view class="conversation-avatar admin-user-avatar">
            <image class="conversation-fixed-avatar" src="{{group.avatarPath}}" mode="aspectFill"/>
            <view wx:if="{{group.unreadCount > 0}}" class="conversation-unread">{{group.unreadLabel}}</view>
          </view>
          <view class="conversation-body">
            <view class="conversation-main"><text class="conversation-title">{{group.displayName}}</text><text class="admin-group-count">{{group.conversationCount}} 个会话</text></view>
            <view class="conversation-tags"><text>{{group.typeSummary}}</text></view>
            <view class="conversation-preview">{{group.latestText}}</view>
          </view>
          <view class="conversation-meta"><text class="conversation-clock">{{group.activityLabel}}</text><text class="admin-group-toggle">{{group.expanded ? '收起' : '展开'}}</text></view>
        </view>
        <view wx:if="{{group.expanded}}" class="admin-conversation-children">
          <view wx:for="{{group.children}}" wx:for-item="child" wx:key="conversationId" class="conversation-row admin-conversation-child {{child.preferences.pinned?'is-pinned':''}}" data-id="{{child.conversationId}}" data-type="{{child.conversationType}}" bindtap="openAdminConversation" bindlongpress="conversationActions" role="button" aria-label="{{child.adminTitle}}，{{child.lastText}}">
            <view class="conversation-avatar admin-child-avatar {{child.conversationType}}">
              <text class="{{child.conversationType === 'support' ? 'cuIcon-service' : (child.conversationType === 'direct' ? 'cuIcon-commentfill' : 'cuIcon-form')}}"></text>
              <view wx:if="{{child.unreadCount > 0}}" class="conversation-unread">{{child.unreadLabel}}</view>
            </view>
            <view class="conversation-body">
              <view class="conversation-main"><text class="conversation-title">{{child.adminTitle}}</text></view>
              <view class="conversation-tags"><text wx:if="{{child.adminMeta}}" class="conversation-id">{{child.adminMeta}}</text><text wx:if="{{child.preferences.pinned}}">已置顶</text><text wx:if="{{child.preferences.later}}">稍后处理</text><text wx:if="{{child.conversationState==='readonly'}}">已结束沟通</text></view>
              <view class="conversation-preview">{{child.lastText}}</view>
            </view>
            <view class="conversation-meta"><text class="conversation-clock">{{child.activityLabel}}</text></view>
          </view>
        </view>
      </block>
    </block>

<view wx:for="{{visibleChatRows}}" wx:key="conversationId" class="conversation-row {{item.kind === 'notification' ? 'ordinary-notification' : ''}} {{item.preferences.pinned?'is-pinned':''}}" data-id="{{item.conversationId}}" bindtap="openConversation" bindlongpress="conversationActions" aria-role="button" aria-label="{{item.displayTitle || item.title}}，{{item.lastText}}，长按管理会话">
      <view class="conversation-avatar {{item.kind === 'notification' ? 'notification-avatar' : ''}}">
        <view wx:if="{{item.kind==='chat' && item.groupAvatars && item.groupAvatars.length}}" class="conversation-group-avatar"><image wx:for="{{item.groupAvatars}}" wx:for-item="avatar" wx:key="index" src="{{avatar}}" mode="aspectFill"/></view>
        <image wx:elif="{{item.kind==='chat' && item.avatarPath}}" class="conversation-fixed-avatar" src="{{item.avatarPath}}" mode="aspectFill"/>
        <text wx:else class="{{item.kind === 'notification' ? 'chat-icon chat-icon-notice' : 'cuIcon-commentfill'}}"></text>
        <view wx:if="{{item.kind === 'notification' && item.unreadCount > 0}}" class="ordinary-unread-dot"></view>
        <view wx:elif="{{item.unreadCount > 0}}" class="conversation-unread">{{item.unreadLabel}}</view>
      </view>
      <view class="conversation-body">
        <view class="conversation-main">
          <text class="conversation-title">{{item.displayTitle || item.title}}</text>
          <text wx:if="{{item.kind==='chat' && !item.isGroup && onlineRows[item.conversationId]}}" class="conversation-presence" aria-label="对方在线">在线</text>
        </view>
        <view class="conversation-tags"><text wx:if="{{item.subtitle}}" class="conversation-id">{{item.subtitle}}</text><text wx:if="{{item.preferences.pinned}}">已置顶</text><text wx:if="{{item.preferences.later}}">稍后处理</text><text wx:if="{{item.conversationState==='readonly'}}">已结束沟通</text></view>
        <view class="conversation-preview">{{item.lastText}}</view>
      </view>
      <view class="conversation-meta"><text class="conversation-clock">{{item.activityLabel}}</text><text wx:if="{{item.preferences.later}}" class="conversation-later">稍后处理</text></view>
    </view>
</view>
    <view wx:if="{{chatEnabled && chatLoading && !chatRows.length && !adminUserGroups.length}}" class="sync-hint">正在同步会话</view>
    <view wx:elif="{{!chatLoading && !visibleChatRows.length && !adminUserGroups.length && summaryReady && !(chatEnabled && supportEntry && !supportEntry.staff && !ordersOnly && chatFilter==='all' && chatRole==='all')}}" class="inbox-placeholder slim">
      <view class="placeholder-circle"><text class="cuIcon-comment"></text></view>
      <view class="placeholder-title">暂无消息</view>
    </view>
    <view wx:if="{{adminInboxMode && supportInboxHasMore}}" class="list-pagination admin-more-users"><button bindtap="loadMoreSupport" disabled="{{supportInboxLoading}}">{{supportInboxLoading ? '正在加载' : '加载更多用户反馈'}}</button></view>
    <view class="list-pagination"><button wx:if="{{listBefore}}" bindtap="firstList">回到最新会话</button><button wx:if="{{listMore}}" bindtap="nextList" disabled="{{chatHasMore}}">下一批会话</button></view>
    <view wx:if="{{chatSimulation && chatEnabled}}" class="sync-hint">测试模拟会话 · 文字消息仅在当前测试实例内同步</view>
    <view wx:if="{{canSwitchChatScope && !ordersOnly}}" class="sync-hint">当前显示测试会话，可在右上角切换至普通会话</view>
    <view wx:if="{{!chatEnabled}}" class="sync-hint">{{chatAvailabilityReason === 'disabled' ? '订单聊天已暂停' : (chatAvailabilityReason === 'demo_identity' ? '当前测试身份暂无聊天会话' : '沟通服务暂不可用，可下拉重试')}}</view>
    <view wx:if="{{chatHasMore}}" class="sync-hint">正在分批核对更多会话</view>
  </block>
  <view class="bottom-clearance"></view>
</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>