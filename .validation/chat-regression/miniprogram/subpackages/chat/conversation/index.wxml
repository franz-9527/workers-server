<view class="conversation-page {{keyboardOpen ? 'keyboard-open' : ''}}" style="padding-bottom:{{keyboardHeight}}px">
  <view class="conversation-context chat-page-toolbar conversation-utility-bar">
    <view class="conversation-context-copy chat-toolbar-copy"><view class="conversation-context-sub conversation-context-only">{{contextLabel}}{{!canSend && !loading && !syncing && status !== 'resyncing' && status !== 'unavailable' && status !== 'denied' ? ' · 只读' : ''}}<text wx:if="{{peerOnline && directCalls}}" class="chat-peer-online" aria-label="对方在线">在线</text></view></view>
    <button wx:if="{{enabled}}" class="chat-icon-button chat-details chat-menu-trigger" bindtap="chatInfo" aria-label="{{showChatMenu ? '收起会话菜单' : '会话设置与操作'}}" aria-expanded="{{showChatMenu}}"><text class="chat-icon chat-icon-tune" aria-hidden="true"></text></button>
  </view>
  <view wx:if="{{showChatMenu}}" class="chat-operation-mask" catchtap="closeChatMenu" catchtouchmove="stopMenuTouch">
    <view class="chat-operation-panel conversation-operation-panel" catchtap="stopMenuTouch" aria-label="会话菜单">
      <view class="chat-operation-group">
        <view class="chat-operation-label">会话</view>
        <view class="chat-operation-list">
          <button wx:if="{{!supportScene && (isGroup || testSandbox)}}" class="chat-operation-item" data-action="group" bindtap="runChatMenuAction"><text>群成员与邀请</text><text>›</text></button>
          <button wx:if="{{directScene}}" class="chat-operation-item" data-action="direct_relation" bindtap="runChatMenuAction"><text>拉黑与关系设置</text><text>›</text></button>
          <button wx:if="{{canOpenOrder}}" class="chat-operation-item" data-action="order" bindtap="runChatMenuAction"><text>{{simulation ? '查看测试订单' : '查看订单'}}</text><text>›</text></button>
          <button wx:if="{{!simulation && directCalls}}" class="chat-operation-item" data-action="calls" bindtap="runChatMenuAction"><text>通话记录</text><text>›</text></button>
          <button wx:if="{{supportStaff}}" class="chat-operation-item" data-action="support_settings" bindtap="runChatMenuAction"><text>反馈助手设置</text><text>›</text></button>
          <button wx:if="{{supportStaff && supportWorkVersion}}" class="chat-operation-item" data-action="support_handled" bindtap="runChatMenuAction" disabled="{{supportHandled || windowBusy}}"><text>{{supportHandled ? '已标记处理完成' : '标记为已处理'}}</text><text>{{supportHandled ? '✓' : '›'}}</text></button>
          <button wx:if="{{simulation}}" class="chat-operation-item" data-action="simulation" bindtap="runChatMenuAction"><text>测试会话说明</text><text>›</text></button>
        </view>
      </view>
      <view wx:if="{{(supportScene || directScene) && supportPreferences}}" class="chat-operation-group">
        <view class="chat-operation-label">会话整理</view>
        <view class="chat-operation-grid">
          <button wx:if="{{supportStaff || directScene}}" class="chat-operation-chip {{supportPreferences.pinned?'selected':''}}" data-field="pinned" bindtap="toggleSupportPreference" disabled="{{supportPreferenceBusy}}"><text>{{supportPreferences.pinned?'已置顶':'置顶'}}</text><text>消息列表靠前</text></button>
          <button class="chat-operation-chip {{supportPreferences.later?'selected':''}}" data-field="later" bindtap="toggleSupportPreference" disabled="{{supportPreferenceBusy}}"><text>{{supportPreferences.later?'已稍后处理':'稍后处理'}}</text><text>稍后再回复</text></button>
          <button class="chat-operation-chip {{supportPreferences.muted?'selected':''}}" data-field="muted" bindtap="toggleSupportPreference" disabled="{{supportPreferenceBusy}}"><text>{{supportPreferences.muted?'已静音':'静音'}}</text><text>调整提醒</text></button>
          <button wx:if="{{supportStaff || directScene}}" class="chat-operation-chip {{supportPreferences.archived?'selected':''}}" data-field="archived" bindtap="toggleSupportPreference" disabled="{{supportPreferenceBusy}}"><text>{{supportPreferences.archived?'已归档':'归档'}}</text><text>移出当前列表</text></button>
          <button wx:if="{{supportStaff || directScene}}" class="chat-operation-chip {{supportPreferences.hidden?'selected':''}}" data-field="hidden" bindtap="toggleSupportPreference" disabled="{{supportPreferenceBusy}}"><text>{{supportPreferences.hidden?'已隐藏':'隐藏'}}</text><text>从普通列表隐藏</text></button>
        </view>
      </view>
      <view wx:if="{{!simulation && !supportScene}}" class="chat-operation-group">
        <view class="chat-operation-label">工具与支持</view>
        <view class="chat-operation-list">
          <button class="chat-operation-item" data-action="storage" bindtap="runChatMenuAction"><text>聊天缓存</text><text>›</text></button>
          <button class="chat-operation-item" data-action="governance" bindtap="runChatMenuAction"><text>举报与申诉</text><text>›</text></button>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{invalid}}" class="conversation-empty"><text class="cuIcon-warn"></text><view>会话编号无效</view></view>
  <view wx:elif="{{!enabled}}" class="conversation-empty"><text class="cuIcon-comment"></text><view>{{supportScene||directScene?'沟通服务已暂停或状态暂未同步':'订单聊天已暂停或状态暂未同步'}}</view><view class="muted">{{supportScene||directScene?'请返回消息页稍后重试':'可先通过订单详情或通知与待办联系相关人员'}}</view></view>
  <block wx:else>
    <view wx:if="{{status === 'denied'}}" class="conversation-warning conversation-status" role="alert"><text class="conversation-status-copy">当前无权查看此会话</text></view>
    <view wx:elif="{{syncing || status === 'resyncing' || status === 'unavailable'}}" class="conversation-warning conversation-status" role="alert">
      <text class="conversation-status-copy">{{syncing || status === 'resyncing' ? '正在同步消息…' : '连接异常，消息可能未更新'}}</text>
      <button class="retry-button" bindtap="retryConnection" disabled="{{syncing || status === 'resyncing'}}" aria-label="重新同步消息">{{syncing || status === 'resyncing' ? '同步中' : '重新同步'}}</button>
    </view>
    <view wx:elif="{{directScene && directState && !directState.established && !restrictionText && !notice}}" class="conversation-status conversation-warning"><text class="conversation-status-copy">{{directState.initiator ? (directState.new_contact && directState.daily_new_contacts_remaining <= 0 ? '今日新联系人额度已用完' : (directState.remaining_messages > 0 ? '对方回复前还可发送 ' + directState.remaining_messages + ' 条消息' : '已发送3条，等待对方回复')) : '回复后建立正常私聊'}}</text></view>
    <view wx:elif="{{restrictionText}}" class="conversation-warning conversation-status" role="alert"><text class="conversation-status-copy">{{restrictionText}}</text><button wx:if="{{!supportScene}}" class="retry-button" bindtap="openGovernance">查看申诉</button></view>
    <view wx:elif="{{notice}}" class="conversation-status conversation-action-notice" role="alert"><text class="conversation-status-copy">{{notice}}</text><button class="notice-close" bindtap="dismissNotice" aria-label="关闭提示">×</button></view>
    <view wx:if="{{status !== 'denied' && (hasReturn || newCount > 0)}}" class="conversation-jump-actions">
      <button wx:if="{{hasReturn}}" bindtap="returnToPosition" disabled="{{windowBusy}}">返回刚才位置</button>
      <button wx:if="{{newCount > 0}}" bindtap="latestMessages" disabled="{{windowBusy}}"><text class="chat-new-dot" aria-hidden="true">●</text>{{newCount}} 条新消息</button>
    </view>
    <scroll-view class="message-scroll" scroll-y scroll-top="{{scrollTop}}" scroll-into-view="{{scrollInto}}" scroll-with-animation="{{false}}" bindtap="dismissTools" bindscroll="onScroll" bindscrolltoupper="loadEarlier" bindscrolltolower="onBottom" upper-threshold="60" lower-threshold="30">
      <view class="message-content">
        <view wx:if="{{!simulation && status !== 'denied'}}" class="conversation-safety-tip" role="note"><text class="cuIcon-warnfill safety-tip-icon"></text><text>{{supportScene ? '这里用于提交使用问题、体验优化和开发建议；订单问题请在对应订单会话沟通。' : '平台内沟通更安全，请勿私下交易或发送手机号、微信号、二维码。'}}</text></view>
        <button wx:if="{{hasHistory}}" class="history-button" bindtap="loadEarlier" disabled="{{windowBusy}}" loading="{{windowBusy}}">加载更早消息</button>
        <block wx:for="{{messages}}" wx:key="messageId"><view wx:if="{{item.timeDivider}}" class="message-divider">{{item.timeDivider}}</view><view id="message-{{item.messageId}}" class="message-item {{item.state === 'recalled' ? 'is-recalled' : ''}} {{item.isPlaceholder ? 'is-placeholder' : ''}} {{item.isMine ? 'is-mine' : ''}}" data-id="{{item.messageId}}" bindlongpress="messageActions" role="text" aria-label="{{item.displayName}}：{{item.body}}">
          <view wx:if="{{item.state === 'recalled'}}" class="recall-notice"><text>{{item.isMine ? '你撤回了一条消息' : item.displayName + '撤回了一条消息'}}</text><button wx:if="{{item.canReedit}}" data-id="{{item.messageId}}" catchtap="reeditRecalled" aria-label="重新编辑已撤回消息">重新编辑</button></view>
          <view wx:if="{{item.state !== 'recalled'}}" class="message-avatar-frame" data-id="{{item.messageId}}" catchtap="openUserProfile" catchlongpress="stopImageTouch" role="button" aria-label="查看{{item.displayName}}资料"><image class="message-avatar" src="{{item.avatarPath}}" mode="aspectFill" aria-hidden="true"/></view>
          <view wx:if="{{item.state !== 'recalled'}}" class="message-body"><view wx:if="{{isGroup}}" class="message-sender">{{item.displayName}}</view><view class="message-bubble {{item.isAV ? 'av-message-bubble' : ''}} {{item.isAudio ? 'voice-message-bubble' : ''}} {{item.isImage ? 'image-message-bubble' : ''}}" style="{{item.isAudio ? 'width:' + item.bubbleWidth + 'rpx' : ''}}">
          <button wx:if="{{item.reply}}" class="reference-preview" disabled="{{!item.reply.message_id}}" data-id="{{item.messageId}}" catchtap="locateReference" aria-label="引用：{{item.replyText}}"><text class="reference-author">{{item.quoteAuthor || '引用'}}</text><text class="reference-text">{{item.replyText}}</text></button>
          <button wx:if="{{item.editedFrom}}" class="reedit-source" data-id="{{item.messageId}}" data-source="edited" catchtap="locateReference" aria-label="定位重新编辑来源">由已撤回消息重新编辑</button>
          <view wx:if="{{item.isCall}}" class="call-event"><text class="chat-icon {{item.callVideo ? 'chat-icon-video' : 'chat-icon-phone'}}" aria-hidden="true"></text><text>{{item.callText}}</text></view><button wx:elif="{{item.orderCard}}" class="shared-order-card" data-id="{{item.messageId}}" catchtap="openSharedOrder"><text>订单 · {{item.orderCard.title}}</text><text>{{item.orderCard.publicNo}}</text><text>查看订单 ›</text></button><view wx:elif="{{!item.isAV && !item.isImage}}" class="message-text">{{item.body}}</view>
          <view wx:if="{{item.isAV}}" class="av-card {{playingAudio === item.messageId ? 'is-playing' : ''}}">
            <button data-id="{{item.messageId}}" catchtap="playAV" aria-label="播放{{item.isAudio ? '语音' : '视频'}}">
              <text class="chat-icon {{item.isAudio ? 'chat-icon-voice' : 'chat-icon-video'}}" aria-hidden="true"></text><text>{{item.duration}}″</text>
              <text wx:if="{{item.isAudio && !item.heard && !item.isMine}}" class="av-unheard">●</text>
            </button>
            <button wx:if="{{!item.isAudio}}" data-id="{{item.messageId}}" catchtap="showFrames">查看保留的封面与抽帧</button>
            <text wx:if="{{item.isAudio && item.transcript}}" class="av-transcript">{{item.transcript}}</text>
          </view>
          <view wx:if="{{item.isImage}}" class="image-card {{item.imageCount === 1 ? 'image-card-single' : 'image-card-multi'}}">
            <view class="image-grid">
              <view wx:for="{{item.images}}" wx:for-item="photo" wx:key="item_id" class="chat-image {{item.imageCount === 1 ? 'chat-image-single' : ''}}" id="image-{{item.messageId}}-{{photo.item_id}}" data-message="{{item.messageId}}" data-item="{{photo.item_id}}" catchtap="previewImage" catchlongpress="imageActions" aria-label="查看第{{photo.ordinal + 1}}张图片，长按引用此图">
                <image wx:if="{{photo.url}}" src="{{photo.url}}" mode="aspectFill" lazy-load/><text wx:else>第{{photo.ordinal + 1}}张</text>
              </view>
            </view>
            <button wx:if="{{item.imageCount > 4}}" class="image-expand-action" data-id="{{item.messageId}}" catchtap="toggleImages">{{item.imageExpanded ? '收起图片' : '查看全部 ' + item.imageCount + ' 张'}}</button>
          </view>
          <view wx:if="{{smsAnchor === item.messageId}}" class="sms-nudge-row">
            <text wx:if="{{smsFirstHint}}" class="sms-nudge-hint">暂未读，可用余额发短信提醒</text>
            <button class="sms-nudge-button" catchtap="openSMS" aria-label="短信提醒，点击查看费用与余额"><text class="chat-icon chat-icon-notice" aria-hidden="true"></text></button>
          </view>
          </view><view wx:if="{{item.safetyNote}}" class="message-safety-note" role="note">{{item.safetyNote}}</view><view wx:if="{{!supportScene && item.isMine && item.state === 'published' && !item.isCall}}" class="message-receipt" role="button" data-id="{{item.messageId}}" catchtap="showReaders">{{receiptLabels[item.messageId] || ((directCalls || directScene) ? '未读' : '查看阅读状态')}}</view></view>
        </view></block>
        <view wx:if="{{loading && !syncing && status !== 'resyncing' && status !== 'unavailable' && !messages.length && !attempts.length && !albums.length && !avAttempts.length}}" class="conversation-empty compact"><text class="cuIcon-loading2 cuIconfont-spin"></text> 正在加载消息</view>
        <view wx:elif="{{!loading && !syncing && !messages.length && !attempts.length && !albums.length && !avAttempts.length && (status === 'http' || status === 'socket')}}" class="conversation-empty compact"><text class="cuIcon-comment"></text> 暂无消息</view>
        <block wx:for="{{pendingRows}}" wx:for-item="pending" wx:key="key">
        <view wx:if="{{pending.kind === 'text'}}" class="message-item is-mine attempt-item {{pending.row.severity === 'blocked' ? 'is-blocked' : ''}}" data-id="{{pending.row.clientId}}" bindlongpress="pendingTextActions">
          <view class="message-avatar-frame"><image class="message-avatar" src="{{pending.row.avatarPath}}" mode="aspectFill"/></view>
          <view class="message-body">
            <view wx:if="{{isGroup}}" class="message-sender">{{pending.row.displayName}}</view>
            <view wx:if="{{pending.row.body}}" class="message-bubble attempt-bubble"><view class="message-text">{{pending.row.body}}</view></view>
            <view class="attempt-status-line {{pending.row.state === 'rejected' || pending.row.state === 'retryable' ? 'is-error' : ''}}">
              <text class="attempt-status-copy">{{pending.row.busy && pending.row.state !== 'sending' ? '正在核验…' : (pending.row.reason || pending.row.label)}}</text>
              <button wx:if="{{pending.row.canRetry}}" data-id="{{pending.row.clientId}}" catchtap="retryMessage" aria-label="核验原消息并在允许时重试">{{pending.row.retryLabel}}</button>
              <button wx:if="{{pending.row.canEdit && canSend}}" data-id="{{pending.row.clientId}}" catchtap="editAttempt">修改</button>
              <button wx:if="{{pending.row.canDismiss && (!pending.row.canEdit || !canSend)}}" data-id="{{pending.row.clientId}}" catchtap="deleteAttempt">删除</button>
            </view>
          </view>
        </view>
        <view wx:elif="{{pending.kind === 'image'}}" class="album-attempt">
          <view class="album-attempt-heading"><text class="album-attempt-name">{{pending.row.items.length}} 张照片</text><text class="album-attempt-status">{{pending.row.submitted ? (pending.row.reason || pending.row.label) : '待确认'}}</text></view><view wx:if="{{!pending.row.submitted}}" class="draft-hint">仅暂存本机，确认后才会发送</view>
          <view wx:for="{{pending.row.items}}" wx:for-item="photo" wx:key="index" class="album-item">
            <image wx:if="{{photo.path}}" src="{{photo.path}}" mode="aspectFill"/><text>第{{photo.index + 1}}张 · {{photo.label}}{{photo.state === 'uploading' ? ' ' + photo.progress + '%' : ''}}</text>
            <button wx:if="{{photo.canRetry}}" data-client="{{pending.row.clientId}}" data-index="{{photo.index}}" bindtap="retryImage">重试此图</button>
            <view wx:if="{{pending.row.canChange}}" class="album-tools">
              <button data-client="{{pending.row.clientId}}" data-index="{{photo.index}}" data-action="up" bindtap="changeImage" disabled="{{photo.index === 0}}">上移</button>
              <button data-client="{{pending.row.clientId}}" data-index="{{photo.index}}" data-action="down" bindtap="changeImage" disabled="{{photo.index === pending.row.items.length - 1}}">下移</button>
              <button data-client="{{pending.row.clientId}}" data-index="{{photo.index}}" data-action="replace" bindtap="changeImage">替换</button>
              <button data-client="{{pending.row.clientId}}" data-index="{{photo.index}}" data-action="remove" bindtap="changeImage">移除</button>
            </view>
          </view>
          <button wx:if="{{!supportScene && pending.row.state === 'rejected'}}" data-client="{{pending.row.clientId}}" bindtap="appealImages">核验并申诉此次图片检查</button>
          <button wx:if="{{!pending.row.submitted}}" class="album-send-action" data-client="{{pending.row.clientId}}" bindtap="sendImages" disabled="{{!pending.row.canSend || !canSend}}">确认发送 {{pending.row.items.length}} 张</button>
          <button wx:if="{{pending.row.submitted && pending.row.state !== 'accepted' && pending.row.state !== 'canceled'}}" data-client="{{pending.row.clientId}}" bindtap="imageStatus">核验原发送状态</button>
          <button wx:if="{{pending.row.canRetrySend}}" data-client="{{pending.row.clientId}}" bindtap="retryImageSend">重试发送</button>
          <button wx:if="{{pending.row.canCancel}}" data-client="{{pending.row.clientId}}" bindtap="cancelImages">取消本次发送</button>
        </view>
        <view wx:elif="{{pending.kind === 'av'}}" class="message-item is-mine pending-media">
          <view class="message-avatar-frame"><image class="message-avatar" src="{{pending.row.avatarPath}}" mode="aspectFill"/></view>
          <view class="message-body">
            <view wx:if="{{isGroup}}" class="message-sender">{{pending.row.displayName}}</view>
            <view class="pending-media-line {{pending.row.canRetry ? 'has-retry' : ''}}">
              <view wx:if="{{pending.row.canRetry}}" class="media-retry" role="button" aria-label="核验并重试{{pending.row.kind === 'audio' ? '语音' : '视频'}}" data-client="{{pending.row.client}}" catchtap="retryAV">!</view>
              <view class="message-bubble av-message-bubble pending-av-bubble {{pending.row.kind === 'audio' ? 'voice-message-bubble' : ''}}" style="width:{{pending.row.bubbleWidth}}rpx">
                <view class="av-card">
                  <button data-client="{{pending.row.client}}" catchtap="previewAV" catchlongpress="pendingAVActions" aria-label="预览{{pending.row.kind === 'audio' ? '语音' : '视频'}}"><text class="chat-icon {{pending.row.kind === 'audio' ? 'chat-icon-voice' : 'chat-icon-video'}}" aria-hidden="true"></text><text>{{pending.row.duration}}″</text></button>
                  <text wx:if="{{pending.row.kind === 'audio' && pending.row.transcript}}" class="av-transcript">{{pending.row.transcript}}</text>
                </view>
              </view>
            </view>
            <view class="attempt-status-line {{pending.row.failed ? 'is-error' : ''}}">
              <text class="attempt-status-copy" data-client="{{pending.row.client}}" catchtap="pendingAVActions">{{pending.row.uploading ? '上传中 ' + pending.row.progress + '%' : pending.row.label}}</text>
              <button wx:if="{{pending.row.canSend}}" data-client="{{pending.row.client}}" catchtap="sendAV">发送</button>
              <button wx:if="{{pending.row.state === 'rejected' && !supportScene}}" data-client="{{pending.row.client}}" catchtap="appealAV">检查结果</button>
            </view>
          </view>
        </view>
        </block>
        <view id="message-bottom" class="message-bottom"></view>
      </view>
    </scroll-view>
    <view wx:if="{{status !== 'denied'}}" class="composer {{!canSend && (restrictionText || loading || syncing || (status !== 'http' && status !== 'socket')) ? 'is-empty' : ''}}">
      <block wx:if="{{canSend}}">
        <view wx:if="{{replyTarget}}" class="composer-reference"><view class="composer-reference-copy"><text class="composer-reference-label">引用</text><text class="composer-reference-text">{{replyPreview}}</text></view><button class="composer-reference-close" bindtap="cancelReply" aria-label="取消引用">×</button></view>
        <view wx:if="{{editedSource}}" class="composer-reedit"><text>由已撤回消息重新编辑 · 将作为新消息发送</text><button bindtap="cancelReedit">取消重新编辑</button></view>
        <view class="composer-row">
          <button wx:if="{{audioEnabled}}" class="chat-icon-button composer-mode" bindtap="toggleVoiceMode" aria-label="{{voiceMode ? '切换键盘输入' : '切换语音输入'}}"><text class="chat-icon {{voiceMode ? 'chat-icon-keyboard' : 'chat-icon-voice'}}" aria-hidden="true"></text></button>
          <button wx:if="{{voiceMode && audioEnabled}}" class="voice-hold {{recording ? 'is-recording' : ''}}" bindtouchstart="beginVoice" catchtouchmove="moveVoice" bindtouchend="endVoice" bindtouchcancel="cancelVoice" aria-label="按住录音，松开发送，上滑取消">{{recordCanceled ? '松开 取消' : recording ? '松开 发送' : voiceStarting ? '准备中…' : '按住 说话'}}</button>
          <input wx:else class="composer-input" type="text" value="{{draft}}" maxlength="2000" adjust-position="{{false}}" confirm-type="send" confirm-hold="{{true}}" hold-keyboard="{{true}}" bindconfirm="sendText" bindinput="inputText" bindfocus="focusComposer" bindblur="inputBlur" bindkeyboardheightchange="keyboardChange" placeholder="输入消息" placeholder-class="composer-placeholder" aria-label="消息内容，键盘发送键可发送"/>
          <view wx:if="{{draft && (!voiceMode || !audioEnabled)}}" class="composer-send {{inputError ? 'is-disabled' : ''}}" role="button" bindtap="sendText" aria-disabled="{{!!inputError}}" aria-label="发送文字消息">发送</view>
          <button wx:elif="{{!simulation}}" class="chat-icon-button composer-more" bindtap="toggleTools" aria-label="{{showTools ? '收起更多功能' : '更多功能'}}" aria-expanded="{{showTools}}"><text class="chat-icon {{showTools ? 'chat-icon-close' : 'chat-icon-plus'}}" aria-hidden="true"></text></button>
        </view>
        
        <view wx:if="{{showTools}}" class="chat-tools">
          <view wx:if="{{canShareOrder}}" class="chat-tool" bindtap="shareOrder" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-order" aria-hidden="true"></text></view><text>订单</text></view>
          <view class="chat-tool" bindtap="chooseImages" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-photo" aria-hidden="true"></text></view><text>照片</text></view>
          <view class="chat-tool" bindtap="takePhoto" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-camera" aria-hidden="true"></text></view><text>拍摄</text></view>
          <view wx:if="{{videoEnabled}}" class="chat-tool" bindtap="chooseVideo" disabled="{{avSelecting}}" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-video" aria-hidden="true"></text></view><text>视频</text></view>
          <view wx:if="{{!simulation && canSend && directCalls && callAudioVisible}}" class="chat-tool {{callAudio ? '' : 'is-unavailable'}}" data-media="audio" bindtap="openCall" role="button" aria-disabled="{{!callAudio}}"><view class="chat-tool-icon"><text class="chat-icon chat-icon-phone" aria-hidden="true"></text></view><text>语音通话</text></view>
          <view wx:if="{{!simulation && canSend && directCalls && callVideoVisible}}" class="chat-tool {{callVideo ? '' : 'is-unavailable'}}" data-media="video" bindtap="openCall" role="button" aria-disabled="{{!callVideo}}"><view class="chat-tool-icon"><text class="chat-icon chat-icon-video" aria-hidden="true"></text></view><text>视频通话</text></view>
        </view>
        <view wx:if="{{showTools && !simulation && canSend && directCalls && (callAudioVisible || callVideoVisible) && !callAudio && !callVideo && callReason}}" class="call-tool-hint">{{callReason}}</view>
        <view wx:if="{{inputError}}" class="input-error" role="alert">{{inputError}}</view>
      </block>
      <view wx:elif="{{!restrictionText && !loading && !syncing && (status === 'http' || status === 'socket')}}" class="composer-closed">当前会话只读</view>
    </view>
  </block>

  <view wx:if="{{messageMenu}}" class="message-menu-mask" catchtap="closeMessageMenu" catchtouchmove="stopImageTouch"><view class="message-menu is-{{messageMenu.placement}}" style="top:{{messageMenu.top}}px;left:{{messageMenu.left}}px;width:{{messageMenu.width}}px;grid-template-columns:repeat({{messageMenu.columns}},minmax(0,1fr));--menu-arrow-x:{{messageMenu.arrowX}}px" catchtap="stopImageTouch"><button wx:for="{{messageMenu.actions}}" wx:key="key" class="{{item.tone === 'danger' ? 'is-danger' : ''}}" data-key="{{item.key}}" catchtap="runMessageAction" aria-label="{{item.label}}"><text class="chat-action-icon chat-action-{{item.icon}}" aria-hidden="true"></text><text class="message-menu-label">{{item.label}}</text></button></view></view>
  <view wx:if="{{recording}}" class="voice-record-mask" aria-live="polite"><view class="voice-record-panel {{recordCanceled ? 'is-cancel' : ''}}">
    <view wx:if="{{recordCanceled}}" class="voice-cancel-symbol">↶</view>
    <view wx:else class="voice-waveform"><text class="chat-icon chat-icon-mic"></text><view class="voice-level-bars"><view></view><view></view><view></view><view></view><view></view></view></view>
    <text class="voice-elapsed">{{recordSeconds}} / 60 秒</text>
    <text wx:if="{{voiceCountdown <= 10 && !recordCanceled}}" class="voice-countdown">还可说 {{voiceCountdown}} 秒</text>
    <text class="voice-record-instruction">{{recordCanceled ? '松开手指，取消发送' : '手指上滑，取消发送'}}</text>
  </view></view>
  <view wx:if="{{smsDialog}}" class="sms-mask" catchtouchmove="stopImageTouch" bindtap="closeSMS">
    <view class="sms-dialog" role="dialog" aria-label="短信提醒确认" catchtap="stopImageTouch">
      <view class="sms-dialog-title">短信提醒</view>
      <scroll-view wx:if="{{smsDialog.state === 'confirm'}}" scroll-y class="sms-recipient-list {{smsDialog.items.length === 1 ? 'sms-one' : (smsDialog.items.length === 2 ? 'sms-two' : '')}}">
        <button wx:for="{{smsDialog.items}}" wx:key="id" class="sms-recipient {{smsDialog.selected === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectSMSRecipient" disabled="{{smsBusy}}"><text>{{item.name}}</text><text>{{smsDialog.selected === item.id ? '✓' : ''}}</text></button>
      </scroll-view>
      <view wx:if="{{smsDialog.state === 'confirm'}}" class="sms-fee">本次 {{smsDialog.fee}} · 可用余额 {{smsDialog.balance}}</view>
      <view wx:if="{{smsDialog.insufficient}}" class="sms-insufficient">余额不足，充值后可提醒。充值不会自动发送短信。</view>
      <view class="sms-dialog-note">{{smsDialog.notice}}</view>
      <view class="sms-dialog-actions"><button bindtap="closeSMS" disabled="{{smsBusy}}">{{smsDialog.state === 'confirm' ? '取消' : '关闭'}}</button><button class="sms-confirm" bindtap="confirmSMS" loading="{{smsBusy}}" disabled="{{smsBusy}}">{{smsDialog.state === 'confirm' ? (smsDialog.insufficient ? '去充值' : '确认提醒') : (smsDialog.state === 'pending' ? '核对结果' : '知道了')}}</button></view>
    </view>
  </view>
  <view wx:if="{{imageViewer}}" class="image-viewer" catchtouchmove="stopImageTouch">
    <swiper class="image-viewer-swiper" current="{{imageViewer.index}}" bindchange="imageViewerChange" duration="220">
      <swiper-item wx:for="{{imageViewer.urls}}" wx:key="*this"><view class="image-viewer-slide"><image src="{{item}}" mode="aspectFit" show-menu-by-longpress="{{true}}" catchtap="closeImageViewer" aria-label="图片预览，左右滑动切换，点击关闭，长按保存"/></view></swiper-item>
    </swiper>
    <text wx:if="{{imageViewer.count > 1}}" class="image-viewer-count">{{imageViewer.index + 1}} / {{imageViewer.count}}</text>
  </view>
  <view wx:if="{{activeVideo}}" class="av-viewer" catchtouchmove="stopImageTouch">
    <button bindtap="closeAV">关闭视频</button>
    <video id="chat-video" src="{{activeVideo.src}}" controls autoplay="{{false}}" show-center-play-btn object-fit="contain" binderror="closeAV" />
    <view wx:if="{{activeVideo.preview}}">预览不会发送，请关闭后点击确认发送</view>
  </view>
</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>