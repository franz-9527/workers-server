.adaptive-nav{position:fixed;left:0;right:0;top:0;z-index:40;box-sizing:border-box;color:#fff;transition:background .2s ease,color .2s ease,box-shadow .2s ease;pointer-events:none}.nav-inner{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;pointer-events:auto}.nav-back{position:absolute;left:22rpx;display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;background:rgba(123,70,20,.20);color:#fff;font-size:34rpx;backdrop-filter:blur(10px)}.nav-title{font-size:31rpx;font-weight:700;opacity:0;transform:translateY(-6rpx);transition:opacity .18s ease,transform .18s ease}.adaptive-nav.solid{background:rgba(255,255,255,.96);color:#27383b;box-shadow:0 1rpx 0 rgba(37,69,74,.08);backdrop-filter:blur(18px)}.adaptive-nav.solid .nav-back{background:transparent;color:#27383b}.adaptive-nav.solid .nav-title{opacity:1;transform:translateY(0)}.hero{display:flex;align-items:center;justify-content:space-between;padding:42rpx 34rpx 48rpx;color:#fff;background:linear-gradient(135deg,#f1a241,#dd7d27);border-radius:0 0 34rpx 34rpx}.hero-title{font-size:42rpx;font-weight:700}.hero-subtitle{margin-top:10rpx;font-size:24rpx;opacity:.88}.hero-icon{font-size:76rpx;opacity:.25}.legacy-entry{display:flex;align-items:center;margin:-20rpx 24rpx 20rpx;padding:24rpx;background:#fff;border-radius:20rpx;box-shadow:0 10rpx 30rpx rgba(161,94,28,.10);position:relative;z-index:9}.legacy-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:18rpx;background:#fff3e4;color:#e68729;font-size:38rpx}.legacy-content{flex:1;margin-left:20rpx;color:#304044;font-size:30rpx;font-weight:600}.legacy-content text{display:block;margin-top:6rpx;color:#879397;font-size:22rpx;font-weight:400}.legacy-entry>.cuIcon-right{color:#a6b0b2}
.center-page{min-height:100vh;background:#f4f7f8;padding-bottom:40rpx}.status-nav{position:sticky;top:0;z-index:8;white-space:nowrap;border-bottom:1rpx solid #e8eff0}.status-tabs{display:flex;min-width:100%;height:92rpx;padding:0 12rpx;box-sizing:border-box}.status-tab{position:relative;flex:1;min-width:168rpx;line-height:92rpx;text-align:center;color:#6f8084;font-size:27rpx}.status-tab.active{color:#0099a8;font-weight:700}.status-tab.active:after{content:"";position:absolute;left:50%;bottom:0;width:44rpx;height:6rpx;border-radius:6rpx;background:#00b9cb;transform:translateX(-50%)}.list{padding:24rpx}.card{padding:24rpx;border-radius:20rpx;margin-bottom:20rpx;box-shadow:0 8rpx 28rpx rgba(29,67,74,.07)}.cover{width:166rpx;height:142rpx;border-radius:14rpx;flex:none}.placeholder{background:#edf2f3}.content{min-width:0;flex:1;margin-left:20rpx}.ellipsis{max-width:300rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.footer{border-top:1rpx solid #edf1f2;margin-top:20rpx;padding-top:18rpx;color:#718185;font-size:24rpx;gap:12rpx}.footer-actions{display:flex;align-items:center;justify-content:flex-end;gap:14rpx;min-width:0}.draft-close-button{flex:none;margin:0;padding:0 18rpx;height:46rpx;line-height:44rpx;border:1rpx solid #d7e0e2;border-radius:24rpx;background:transparent;color:#77878a;font-size:21rpx}.draft-close-button:after{border:0}.draft-close-button[disabled]{opacity:.55}.empty{padding:160rpx 40rpx;color:#66777a}.icon{font-size:90rpx;display:block;margin-bottom:24rpx}.spin{display:inline-block;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
/* 2026-09-15：待补资料独立筛选并显示未处理数，方便用户从“我的”直接定位需要修改的订单。 */
.status-tab{display:flex;align-items:center;justify-content:center;gap:8rpx}.supplement-count-badge{min-width:28rpx;height:28rpx;padding:0 7rpx;border-radius:18rpx;background:#e9514a;color:#fff;font-size:18rpx;line-height:28rpx;text-align:center}
.todo-count-badge{min-width:28rpx;height:28rpx;padding:0 7rpx;border-radius:18rpx;background:#00b9cb;color:#fff;font-size:18rpx;line-height:28rpx;text-align:center}
@media (prefers-color-scheme:dark){.supplement-count-badge{background:#d84c46;color:#fff}}

.repair-card{border:2rpx solid #f1a246;box-shadow:0 10rpx 28rpx rgba(238,149,40,.12)!important}.repair-alert{margin-top:12rpx;padding:10rpx 12rpx;border-radius:12rpx;background:#fff4e6;color:#c76f08;font-size:21rpx;font-weight:700}.repair-alert .cuIcon-warnfill{margin-right:7rpx}

/* 2026-09-17：售后维修订单从已完工回到进行中后，用左侧强调条明显提醒双方。 */
.repair-card{position:relative;border:2rpx solid rgba(242,145,52,.28)!important;box-shadow:0 12rpx 34rpx rgba(242,145,52,.10)!important}.repair-card:before{content:'';position:absolute;left:0;top:22rpx;bottom:22rpx;width:6rpx;border-radius:0 6rpx 6rpx 0;background:#f29134}.repair-alert{margin-top:12rpx;padding:10rpx 14rpx;border-radius:12rpx;background:#fff5e9;color:#c76611;font-weight:600}.repair-alert text{margin-right:6rpx}
/* 2026-09-20：测量单不再单独导航，仅在统一订单流中使用弱紫色卡片标识。 */
.measurement-card{border-left:6rpx solid rgba(102,87,217,.38);background:linear-gradient(90deg,rgba(102,87,217,.035),#fff 20%)}
.measurement-badge{margin-right:8rpx;color:#6657d9;background:#f4f2ff;border:1rpx solid #ddd8ff}
.order-kind-line{display:flex;align-items:center;gap:8rpx;min-width:0}
.order-kind-line .measurement-badge{flex:none;white-space:nowrap}
.order-address{flex:1;min-width:0;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#536467}
@media (prefers-color-scheme:dark){.measurement-card{background:linear-gradient(90deg,rgba(119,104,225,.10),rgba(255,255,255,.02) 24%)}}

/* V2.5.0：商家/高频用户按订单号、地址等查找自己的历史订单；搜索区不覆盖状态筛选。 */
.order-search-wrap{padding:4rpx 24rpx 12rpx}.order-search-box{display:flex;align-items:center;height:68rpx;min-height:0;padding:0 12rpx 0 16rpx;border:1rpx solid #dfe8ea;border-radius:15rpx;background:#fff;box-shadow:0 3rpx 12rpx rgba(29,67,74,.035)}.order-search-icon{flex:none;margin-right:10rpx;color:#87979a;font-size:28rpx}.order-search-input{min-width:0;flex:1;height:64rpx;color:#27383b;font-size:26rpx}.order-search-clear{flex:none;padding:10rpx;color:#9aa7aa;font-size:25rpx}.order-search-button{box-sizing:border-box;flex:none;display:flex;align-items:center;justify-content:center;width:84rpx;height:50rpx;margin-left:4rpx;padding:0 4rpx;border-radius:12rpx;background:#e6f8fa;color:#008d9c;font-size:23rpx;font-weight:650;white-space:nowrap}.order-search-result{display:flex;align-items:center;justify-content:space-between;padding:12rpx 8rpx 0;color:#7b8b8e;font-size:22rpx}.order-search-result text:last-child{padding:4rpx 10rpx;color:#0097a6}

@media (prefers-color-scheme:dark){.center-page{background:#101718;color:#e7f0f1}.adaptive-nav.solid{background:rgba(18,28,30,.96);color:#e7f0f1;box-shadow:0 1rpx 0 #263638}.adaptive-nav.solid .nav-back{color:#e7f0f1}.legacy-entry,.card,.status-nav.bg-white{background:#192629!important;color:#e7f0f1;box-shadow:none}.legacy-icon{background:#3a2d20;color:#f3b56f}.legacy-content{color:#e7f0f1}.legacy-content text{color:#9eabad}.status-nav{border-bottom-color:#2a3a3d}.status-tab{color:#9aabad}.status-tab.active{color:#58d0da}.placeholder{background:#223033}.footer{border-top-color:#2b393c;color:#9dabad}.footer-actions{color:#b8c5c7}.draft-close-button{border-color:#405154;color:#aebcbf}.order-address{color:#b5c3c6}.empty{color:#a3b1b4}.repair-card{background:#192629!important}.measurement-card{background:linear-gradient(90deg,rgba(119,104,225,.10),#192629 24%)!important}.measurement-badge{background:#2a2744;border-color:#45406e;color:#b7aef4}.order-search-box{background:#192629;border-color:#314347;box-shadow:none}.order-search-input{color:#e7f0f1}.order-search-icon,.order-search-clear{color:#91a4a8}.order-search-button{background:#193b40;color:#67d6df}.order-search-result{color:#9badb0}.order-search-result text:last-child{color:#67d6df}}
/* 与接单大厅统一标签尺寸，但订单中心的地址同列时禁止 flex 压缩汉字换行。 */
.order-category-label{display:inline-block;flex:none;box-sizing:border-box;max-width:180rpx;min-width:0;padding:6rpx 12rpx;height:auto;line-height:1.4;white-space:nowrap;word-break:keep-all;overflow:hidden;text-overflow:ellipsis;vertical-align:middle}
.order-card-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-width:0}
.order-card-title{display:block;flex:1;min-width:0;max-width:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:28rpx}
.order-card-status{display:block;flex:none;max-width:60%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
@media (max-width:360px){.list{padding:20rpx 18rpx}.card{padding:18rpx}.cover{width:140rpx;height:126rpx}.content{margin-left:14rpx}.order-category-label{max-width:150rpx}.order-card-status{max-width:62%}.footer-actions{gap:8rpx}}
