<!-- 2026-08-23：报价、预约、异常到场与完工均在当前详情页弹窗处理，减少低频用户跳转。 -->
<view class="detail-page">
  <view wx:if="{{loading}}" class="loading-box text-center text-grey"><text class="cuIcon-loading2 spin"></text> 订单加载中</view>
  <view wx:elif="{{errorText && !detail}}" class="loading-box text-center"><text class="cuIcon-warn text-orange big-icon"></text><view class="margin-top">{{errorText}}</view><button class="cu-btn round bg-cyan text-white margin-top" bindtap="retry">重新加载</button></view>

  <block wx:if="{{detail}}">
    <view wx:if="{{failedUploadLabel}}" class="upload-retry-card"><view><text class="cuIcon-warn"></text>{{failedUploadLabel}}</view><button class="cu-btn sm round line-cyan" loading="{{uploading}}" disabled="{{uploading}}" bindtap="retryPendingPhotos">继续处理</button></view>
    <view class="hero bg-gradual-cyan text-white">
      <view class="flex justify-between align-center"><view><view class="text-xxl text-bold">{{statusText}}</view><view class="margin-top-xs opacity">订单号 {{order.id}}</view></view><text class="cuIcon-formfill hero-icon"></text></view>
      <view wx:if="{{detail.viewer_mode !== 'public_preview'}}" class="hero-money flex justify-between"><view><view class="text-sm opacity">{{order.is_platform_order ? '客户最终金额' : '订单总价'}}</view><view class="text-xl text-bold margin-top-xs">{{amountText}}</view></view><view class="text-right"><view class="text-sm opacity">{{order.is_platform_order && detail.platform_order && detail.platform_order.customer_flow_mode === 'platform_managed' ? '平台托管' : '线上预约费'}}</view><view class="text-xl text-bold margin-top-xs">{{order.is_platform_order && detail.platform_order && detail.platform_order.customer_flow_mode === 'platform_managed' ? '无需微信预约费' : bookingFeeText}}</view></view></view>
    </view>

    <!-- V2.5.0 平台开单与实际数量直接嵌入现有订单详情，不新增详情页。 -->
    <platform-order-pricing wx:if="{{detail.platform_order && detail.viewer_mode !== 'public_preview'}}" order-id="{{orderId}}" pricing="{{detail.platform_order}}" order-state="{{order}}" viewer-mode="{{detail.viewer_mode}}" bindpricingupdated="loadDetail"></platform-order-pricing>
    <measurement-order-detail wx:if="{{(isMeasurementOrder || (detail.measurement && detail.measurement.platform_stage)) && detail.viewer_mode !== 'public_preview'}}" order-id="{{orderId}}" show-platform-pricing="{{false}}"></measurement-order-detail>

    <!-- 2026-09-19：测量单绑定与双方商议抵扣额单独提示，避免误认为已经自动减价。 -->
    <view wx:if="{{measurementLink}}" class="notice bg-cyan light"><text class="cuIcon-infofill text-cyan"></text> 已关联测量单 {{measurementLink.measurement_id}}，仅原测量师傅可报价。测量费抵扣默认 0 元，最高可抵 ¥{{measurementLink.measurement_amount_cents / 100}}；请与用户沟通后在报价时填写实际抵扣额。<navigator class="cu-btn sm round line-cyan margin-top-sm" url="/pages/workerOrder/detail?id={{measurementLink.measurement_id}}">查看原测量成果</navigator></view>
    <view wx:if="{{order.repair_status}}" class="notice bg-orange light repair-priority-notice"><text class="cuIcon-warnfill text-orange"></text> {{isMeasurementOrder ? '测量售后处理中 · 用户已提交售后，你仍是原测量处理师傅' : '用户已提交维修申请，请接受处理或说明拒绝原因'}}</view>
    <view wx:if="{{ownQuote && !assignment}}" class="notice bg-cyan light quote-waiting-note"><text class="cuIcon-infofill text-cyan"></text> {{order.is_platform_order ? '已报工费 ¥' + quoteAmount + '，等待平台选择师傅。' : '我的报价 ¥' + quoteAmount + '，等待用户选择；选中并完成付款后自动进入' + (isMeasurementOrder ? '测量' : '施工') + '阶段。'}}</view>
    <view wx:if="{{order.dispatch_mode === 'single_grab' && !assignment && actions.can_grab}}" class="notice grab-mode-notice"><text class="cuIcon-lightningfill"></text> {{order.fixed_grab_total ? '本单期望总价 ' + order.expected_fee_text + '：抢单即成交，无需再报价，沟通/现场有复杂情况可申请加价。' : (order.expected_fee_type === 'unit' && order.expected_fee_text ? '本单期望单价：' + order.expected_fee_text + '。该文本不参与金额计算，仅供参考；抢单后仍需沟通并提交施工总价。' : '本单为抢单模式：抢单成功后订单立即锁定给你，先联系用户沟通，再填写报价直接进入施工。')}}</view>
    <view wx:if="{{!order.is_platform_order && order.fixed_grab_total && actions.can_grab}}" class="notice bg-orange light"><text class="cuIcon-pay text-orange"></text> 平台{{commissionText}}</view>
    <view wx:if="{{assignment && assignment.assignment_type === 'single_grab' && assignment.status === 'accepted' && order.fixed_grab_total}}" class="notice grab-pending-notice"><text class="cuIcon-roundcheckfill"></text> 已按用户期望总价 {{order.expected_fee_text}} 抢单成交。复杂情况仍可申请加价，由用户确认后生效。</view>
    <view wx:if="{{assignment && assignment.assignment_type === 'single_grab' && assignment.status === 'offered'}}" class="notice grab-pending-notice"><text class="cuIcon-phone"></text> 已抢单。请先联系用户确认现场和价格，再于 {{assignment.accept_deadline_at || '规定时间'}} 前提交报价；提交后直接进入施工，无需用户再次选择。</view>
    <view wx:if="{{quotePaused}}" class="notice quote-paused"><text class="cuIcon-infofill"></text> {{actions.quote_disabled_reason}}</view>
    <view wx:if="{{!assignment && order.dispatch_mode !== 'single_grab' && actions.worker_quote_limit}}" class="notice bg-cyan light"><text class="cuIcon-people"></text> 当前已有 {{actions.worker_quote_count || 0}} 位师傅报价，还可 {{actions.worker_quote_remaining || 0}} 位报价（上限 {{actions.worker_quote_limit}} 位）。</view>
    <view wx:if="{{!assignment && order.dispatch_mode !== 'single_grab' && !actions.contact_revealed && !quotePaused}}" class="notice bg-cyan light"><text class="cuIcon-lock text-cyan"></text> 报价阶段仅显示脱敏联系方式；用户选中师傅或平台派单后自动开放。</view>
    <view wx:if="{{pendingChange}}" class="notice bg-orange light"><text class="cuIcon-time text-orange"></text> 加价 {{pendingChange.added_text}} 正等待用户处理，请先电话协商。</view>
    <view wx:if="{{order.fulfillment_status === 'submitted' && order.auto_accept_at}}" class="notice bg-cyan light"><text class="cuIcon-time text-cyan"></text> {{isMeasurementOrder ? '已提交测量成果' : '已提交完工'}}；用户未操作时将在 {{order.auto_accept_at}} 自动确认。</view>

<order-fulfillment-materials media="{{media}}"></order-fulfillment-materials>
<order-negotiation-panel cases="{{negotiations}}" order-id="{{orderId}}" bindchanged="reloadNegotiation"></order-negotiation-panel>
    <view id="section-grab" class="panel bg-white workflow-target-panel grab-action-panel" wx:if="{{actions.can_grab}}"><view class="panel-title"><text class="cuIcon-lightningfill text-orange"></text> 单师傅抢单</view><view class="text-grey text-sm">{{order.fixed_grab_total ? '期望总价 ' + order.expected_fee_text + '。抢单即成交，无需再报价，沟通/现场有复杂情况可申请加价。' : (order.expected_fee_type === 'unit' && order.expected_fee_text ? '期望单价：' + order.expected_fee_text + '。该文本不参与金额计算，仅供参考；抢单后先沟通，再提交施工总价进入施工。' : '抢单成功后本单立即锁定给你，并开放业主联系方式。先电话沟通施工条件和价格，再填写报价；报价提交后直接进入施工流程。')}}</view><view wx:if="{{order.fixed_grab_total && !order.is_platform_order}}" class="text-orange text-sm margin-top-xs">平台{{commissionText}}</view><button class="cu-btn block round bg-orange text-white margin-top" loading="{{grabbing}}" disabled="{{grabbing}}" bindtap="grabOrder">{{order.fixed_grab_total ? '按 ' + order.expected_fee_text + ' 总价抢单' : '立即抢单'}}</button></view>

    <view id="section-quote" class="panel bg-white workflow-target-panel" wx:if="{{actions.can_quote}}">
      <view class="panel-title"><text class="cuIcon-moneybag text-cyan"></text> 报价处理</view>
      <view class="text-grey text-sm">{{ownQuote ? (order.is_platform_order ? '当前工费报价 ¥' : '当前报价 ¥') + quoteAmount + '，如需调整请进入报价编辑。' : (assignment && assignment.assignment_type === 'single_grab' && assignment.status === 'offered' ? '已完成抢单。请先与用户电话沟通，再填写双方确认后的施工总价和服务范围；提交后直接进入施工。' : (isMeasurementOrder ? '查看下单资料后填写测量总价、测量范围和可上门时间。' : '查看施工资料后填写施工总价、施工范围和可上门时间。'))}}</view>
      <button class="cu-btn block round bg-cyan text-white margin-top" data-target="quote" bindtap="showModal">{{ownQuote ? '修改报价' : '填写报价'}}</button>
    </view>

    <view id="section-navigation" class="panel bg-white workflow-target-panel">
      <view class="panel-title"><text class="cuIcon-profile text-cyan"></text> {{detail.viewer_mode === 'public_preview' ? '订单位置' : '业主信息'}}</view>
      <view wx:if="{{detail.viewer_mode !== 'public_preview'}}" class="info-line"><text class="label">对接人</text><text>{{order.contact_name || '未填写'}}</text></view>
      <view wx:if="{{detail.viewer_mode !== 'public_preview'}}" class="info-line"><text class="label">电话</text><text>{{order.contact_mobile || '未填写'}}</text><text wx:if="{{actions.contact_revealed}}" class="text-cyan" bindtap="callOwner">拨打</text><text wx:else class="text-grey">已保护</text></view>
      <view class="info-line align-start"><text class="label">地址</text><text class="value">{{order.address}}</text></view>
      <view class="address-actions"><button class="cu-btn address-action copy-action" bindtap="copyAddress"><text class="cuIcon-copy"></text> 复制地址</button><button wx:if="{{actions.contact_revealed && order.lat && order.lng}}" class="cu-btn address-action navigation-action" bindtap="openMap"><text class="cuIcon-locationfill"></text> 查看导航</button></view>
      <view class="distance-grid">
        <view wx:if="{{distance.show_home}}"><text class="text-grey">距居住地址</text><view class="text-bold margin-top-xs">{{distance.home_km === null ? '待计算' : distance.home_km + 'km'}}</view></view>
        <view><text class="text-grey">距当前位置</text><view class="text-bold margin-top-xs {{distance.current_km > 50 ? 'text-red' : ''}}">{{distance.current_km === null ? '待定位' : distance.current_km + 'km'}}</view></view>
      </view>
      <view class="info-line"><text class="label">下单时间</text><text class="value">{{order.created_at || '—'}}</text></view>
      <view class="info-line"><text class="label">期望上门</text><text class="value">{{order.expected_visit_at || '接单后与业主预约'}}</text></view>
    </view>

    <view class="panel bg-white">
      <view class="panel-title"><text class="cuIcon-goods text-cyan"></text> {{isMeasurementOrder ? '测量下单信息' : '商品与施工信息'}}</view>
      <view wx:if="{{order.title}}" class="info-line align-start"><text class="label">订单标题</text><text class="value">{{order.title}}</text></view>
      <view class="info-line"><text class="label">类目</text><text class="value">{{order.category_name}}</text></view>
      <view class="info-line"><text class="label">拆旧翻新</text><text>{{order.is_renovation === null ? '未选择' : (order.is_renovation ? '是' : '否')}}</text></view>
      <view wx:if="{{order.quantity_text}}" class="info-line"><text class="label">数量/面积</text><text>{{order.quantity_text}}</text></view>
      <view wx:if="{{order.expected_fee_text}}" class="info-line align-start"><text class="label">{{order.is_platform_order ? (order.expected_fee_type === 'unit' ? '期望单价' : '工费') : (order.expected_fee_type === 'unit' ? '期望单价' : '期望总价')}}</text><text class="value expected-fee-value {{order.fixed_grab_total ? 'fixed' : ''}}" >{{order.expected_fee_text}}</text></view>
      <view wx:if="{{order.wall_height_text}}" class="info-line"><text class="label">墙面高度</text><text>{{order.wall_height_text}}</text></view>
      <view wx:for="{{answers}}" wx:key="label" class="info-line align-start"><text class="label">{{item.label}}</text><text class="value">{{item.value || '—'}}</text></view>
      <view wx:if="{{order.description}}" class="description">{{order.description}}</view>
      <scroll-view wx:if="{{media.length}}" scroll-x class="media-scroll"><view class="media-row"><image wx:for="{{media}}" wx:key="id" class="media-image" mode="aspectFill" src="{{item.display_url || item.url}}" data-url="{{item.url}}" bindtap="previewImage"></image></view></scroll-view>
    </view>

    <view id="section-assignment" class="panel bg-white workflow-target-panel" wx:if="{{assignment}}">
      <view class="panel-title"><text class="cuIcon-recharge text-cyan"></text> 接单收入</view>
      <view wx:if="{{!order.is_platform_order && (assignment.assignment_type !== 'single_grab' || assignment.status !== 'offered')}}" class="income-grid"><view><text class="text-grey">{{isMeasurementOrder ? '测量总价' : '施工总价'}}</text><view class="text-lg text-bold margin-top-xs">{{amountText}}</view></view><view><text class="text-grey">预计服务费</text><view class="text-lg text-orange text-bold margin-top-xs">{{assignment.commission_text}}</view></view><view><text class="text-grey">预计净收入</text><view class="text-lg text-green text-bold margin-top-xs">{{assignment.net_income_text}}</view></view></view>
      <view wx:if="{{assignment.status === 'offered' && assignment.accept_deadline_at}}" class="notice bg-orange light margin-top-sm"><text class="cuIcon-time text-orange"></text> {{assignment.assignment_type === 'single_grab' ? '请在 ' + assignment.accept_deadline_at + ' 前完成沟通并提交报价，超时将自动释放订单重新抢单。' : '请在 ' + assignment.accept_deadline_at + ' 前接受或拒绝本次派单，超时将自动释放。'}}</view>
      <view wx:if="{{!order.is_platform_order}}" class="commission-tip"><text class="cuIcon-info"></text> {{assignment.assignment_type === 'single_grab' && assignment.status === 'offered' ? '报价提交时按本单规则计算服务费；预约费仍在最终服务费中抵扣。' : commissionText + '；预约费在最终佣金中抵扣。'}}</view><view wx:if="{{actions.can_accept || actions.can_reject_assignment}}" class="assignment-actions margin-top"><button wx:if="{{actions.can_accept}}" class="cu-btn round bg-cyan text-white" bindtap="acceptAssignment">确认接单</button><button wx:if="{{actions.can_reject_assignment}}" class="cu-btn round line-orange" bindtap="rejectAssignment">{{assignment.assignment_type === 'single_grab' ? '放弃抢单' : '拒绝派单'}}</button></view>
    </view>

    <view id="section-dispute" class="panel bg-white fee-change-panel workflow-target-panel" wx:if="{{changes.length || order.dispute_status === 'open' || order.dispute_status === 'processing'}}">
      <view class="panel-title"><text class="cuIcon-moneybag text-orange"></text> 报价与费用变更</view>
      <view wx:for="{{changes}}" wx:key="id" class="fee-change-item">
        <view class="flex justify-between align-center"><view class="text-bold">申请增加 {{item.added_text}}</view><text class="change-status {{item.status}}">{{item.status_text}}</text></view>
        <view class="fee-change-reason">{{item.reason}}</view>
        <view class="text-grey text-sm">申请后总价 {{item.total_text}} · {{item.submitted_at}}</view>
        <view wx:if="{{item.status === 'rejected'}}" class="change-result rejected"><text class="cuIcon-close"></text> 该加价未生效，当前结算仍按最后一次双方确认的金额计算。请继续协商，协商不成应申请客服介入或结束订单。</view>
        <view wx:elif="{{item.status === 'accepted'}}" class="change-result accepted"><text class="cuIcon-check"></text> 加价已生效，订单总价及服务费计算基数已同步更新。</view>
      </view>
      <view wx:if="{{runEmptyClaim}}" class="run-empty-status"><view class="flex justify-between"><text class="text-bold">跑空费 {{runEmptyClaim.amount_text}}</text><text class="text-orange">{{runEmptyClaim.status_text}}</text></view><view class="text-sm text-grey margin-top-xs">{{runEmptyClaim.reason}}</view><view class="text-sm text-grey margin-top-xs">{{runEmptyClaim.order_source_type === 'merchant' ? '商家确认后在线支付' : '普通订单线下收取，未付已交平台争议处理'}}</view></view>
      <button wx:if="{{actions.can_submit_run_empty_claim}}" class="cu-btn block round line-orange margin-top" data-target="runEmpty" bindtap="showModal">{{order.order_source_type === 'merchant' ? '提交商家确认跑空费' : '上报用户未付跑空费'}}</button>
    </view>

    <view id="section-work" class="panel bg-white fulfillment-panel workflow-target-panel" wx:if="{{actions.can_work}}">
      <view class="panel-title fulfillment-title"><view><text class="cuIcon-roundcheck text-cyan"></text> {{isMeasurementOrder ? '测量进度' : '施工进度'}}</view><text class="stage-status">{{isMeasurementOrder ? (order.fulfillment_status === 'submitted' ? '成果待确认' : (order.fulfillment_status === 'accepted' ? '成果已确认' : '测量中')) : (order.fulfillment_status === 'submitted' ? '已提交完工' : (order.fulfillment_status === 'accepted' ? '已验收' : '施工中'))}}</text></view>

      <worker-service-appointment id="section-appointment" order-id="{{orderId}}" appointment="{{appointment}}" expected-visit-at="{{order.expected_visit_at}}" quote-availability="{{quoteAvailability}}" bindupdated="loadDetail"></worker-service-appointment>

      <view wx:if="{{order.fulfillment_status !== 'submitted' && order.fulfillment_status !== 'accepted'}}" class="work-stage-card">
        <view class="work-stage-head"><view class="work-stage-index"><text class="cuIcon-moneybag"></text></view><view class="work-stage-main"><view class="work-stage-title">{{isMeasurementOrder ? '现场费用调整' : '施工中调整'}}</view><view class="work-stage-summary">现场确需增加费用时再提交给用户确认</view></view><button class="stage-mini-action warning" data-target="change" bindtap="showModal">申请加费</button></view>
      </view>

      <view class="work-stage-card">
        <view class="work-stage-head"><view class="work-stage-index"><text class="cuIcon-camera"></text></view><view class="work-stage-main"><view class="work-stage-title">{{isMeasurementOrder ? '现场记录照片' : '施工前照片'}} <text class="optional-tag">选填</text></view><view class="work-stage-summary">{{beforePhotos.length ? '已上传 ' + beforePhotos.length + ' 张' : (isMeasurementOrder ? '最多 3 张，记录测量前现场状态' : '最多 3 张，便于留存施工前状态')}}</view></view><button class="stage-mini-action" data-purpose="before_optional" bindtap="choosePhoto">{{beforePhotos.length ? '补充' : '上传'}}</button></view>
        <view wx:if="{{beforePhotos.length}}" class="thumb-row compact-thumbs"><image wx:for="{{beforePhotos}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image></view>
      </view>

      <view wx:if="{{!isMeasurementOrder}}" id="section-completion" class="work-stage-card completion-stage {{order.fulfillment_status === 'submitted' || order.fulfillment_status === 'accepted' ? 'is-done' : ''}}">
        <view class="work-stage-head"><view class="work-stage-index"><text class="cuIcon-roundcheck"></text></view><view class="work-stage-main"><view class="work-stage-title">完工提交</view><view class="work-stage-summary" wx:if="{{order.fulfillment_status === 'submitted' || order.fulfillment_status === 'accepted'}}">已提交 {{completionPhotos.length}} 张完工照片{{order.warranty_months ? ' · 保障 ' + order.warranty_months + ' 个月' : ''}}</view><view class="work-stage-summary" wx:else>上传完工照片后一次提交；维修保障按实际约定选填</view></view><text wx:if="{{order.fulfillment_status === 'submitted' || order.fulfillment_status === 'accepted'}}" class="stage-done-mark"><text class="cuIcon-roundcheckfill"></text> 已提交</text></view>
        <block wx:if="{{order.fulfillment_status !== 'submitted' && order.fulfillment_status !== 'accepted'}}">
          <view class="completion-editor">
            <view class="completion-upload-head"><view><view class="text-bold">完工照片 <text class="text-red">*</text></view><view class="text-grey text-sm">至少 1 张，自动记录时间与定位</view></view><button class="cu-btn sm round bg-cyan text-white" data-purpose="completion" bindtap="choosePhoto"><text class="cuIcon-camera"></text> {{completionPhotos.length ? '继续上传' : '上传'}}</button></view>
            <view wx:if="{{completionPhotos.length}}" class="thumb-row"><image wx:for="{{completionPhotos}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image></view>
            <worker-completion-submit order-id="{{orderId}}" photo-count="{{completionPhotos.length}}" bindupdated="loadDetail"></worker-completion-submit>
          </view>
        </block>
        <view wx:else class="thumb-row compact-thumbs"><image wx:for="{{completionPhotos}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image></view>
      </view>

      <button wx:if="{{order.fulfillment_status !== 'submitted' && order.fulfillment_status !== 'accepted'}}" class="exception-entry" data-target="arrival" bindtap="showModal"><text class="cuIcon-warn"></text><text>{{isMeasurementOrder ? '无法联系或无法测量' : '无法联系或无法施工'}}</text><text class="cuIcon-right"></text></button>
    </view>

    <view id="section-settlement" class="panel bg-white settlement-panel workflow-target-panel" wx:if="{{!isMeasurementOrder && assignment && (order.fulfillment_status === 'submitted' || order.fulfillment_status === 'accepted')}}">
      <view class="panel-title"><text class="cuIcon-recharge text-cyan"></text> {{order.is_platform_order ? '平台单收款凭证' : '完工收款与平台服务费'}}</view>
      <view wx:if="{{commissionReceivable}}" class="notice bg-orange light margin-top-sm"><text class="cuIcon-infofill text-orange"></text> {{commissionReceivable.stage_text}}；验收前金额可调整，提前支付的差额会在验收后按规则结算。</view>
      <view wx:if="{{!order.is_platform_order}}" class="settlement-progress"><view class="done"><text class="cuIcon-roundcheckfill"></text><small>完工已提交</small></view><view class="line {{collectionReceipts.length ? 'done' : ''}}"></view><view class="{{collectionReceipts.length ? 'done' : ''}}"><text class="{{collectionReceipts.length ? 'cuIcon-roundcheckfill' : 'cuIcon-camera'}}"></text><small>收款凭证</small></view><view class="line {{commissionReceivable && commissionReceivable.unpaid_cents === 0 ? 'done' : ''}}"></view><view class="{{commissionReceivable && commissionReceivable.unpaid_cents === 0 ? 'done' : ''}}"><text class="{{commissionReceivable && commissionReceivable.unpaid_cents === 0 ? 'cuIcon-roundcheckfill' : 'cuIcon-pay'}}"></text><small>服务费</small></view></view>
      <view class="receipt-box"><view class="flex justify-between align-center"><view><view class="text-bold">线下收款凭证 <text class="text-red">*</text></view><view class="text-grey text-sm margin-top-xs">请上传转账记录或双方确认的收款截图，最多 3 张</view></view><button wx:if="{{actions.can_upload_collection_receipt && collectionReceipts.length < 3}}" class="cu-btn sm round line-cyan" data-purpose="collection_receipt" bindtap="choosePhoto"><text class="cuIcon-camera"></text> 上传</button></view><view wx:if="{{collectionReceipts.length}}" class="thumb-row receipt-thumb-row"><view class="receipt-thumb" wx:for="{{collectionReceipts}}" wx:key="id"><image src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image><button wx:if="{{actions.can_edit_collection_receipt}}" class="receipt-delete" data-id="{{item.id}}" catchtap="deleteCollectionReceipt"><text class="cuIcon-close"></text></button></view></view><view wx:if="{{collectionAdjustment && (collectionAdjustment.status === 'pending' || collectionAdjustment.status === 'auto_approved' || collectionAdjustment.status === 'approved')}}" class="text-grey text-sm margin-top-xs">当前凭证已形成结算快照，不能删除；后台驳回后可重新提交。</view></view>
      <view class="tail-adjustment" wx:if="{{actions.can_request_collection_adjustment || collectionAdjustment}}">
        <view class="flex justify-between align-center"><view><view class="text-bold">实际收取尾款</view><view wx:if="{{actions.can_request_collection_adjustment && (!collectionAdjustment || collectionAdjustment.status === 'rejected')}}" class="text-grey text-sm margin-top-xs">预计尾款 ¥{{actualTailAmount}}；金额一致无需填写</view></view><button wx:if="{{actions.can_request_collection_adjustment && (!collectionAdjustment || collectionAdjustment.status === 'rejected') && modalName !== 'tailAdjustment'}}" class="cu-btn sm round line-cyan" data-target="tailAdjustment" bindtap="showModal">{{collectionAdjustment && collectionAdjustment.status === 'rejected' ? '重新登记' : '金额有变'}}</button></view>
        <view wx:if="{{collectionAdjustment}}" class="adjustment-result {{collectionAdjustment.status}}"><view>{{collectionAdjustment.status_text}}</view><text>原尾款 {{collectionAdjustment.original_tail_text}} → 实际尾款 {{collectionAdjustment.requested_tail_text}}</text><text wx:if="{{collectionAdjustment.review_note}}">平台说明：{{collectionAdjustment.review_note}}</text></view>
        <block wx:if="{{actions.can_request_collection_adjustment && (!collectionAdjustment || collectionAdjustment.status === 'rejected') && modalName === 'tailAdjustment'}}"><view class="tail-input"><text>¥</text><input type="digit" value="{{actualTailAmount}}" placeholder="实际收取尾款" bindinput="inputActualTailAmount" /></view><textarea maxlength="500" value="{{actualTailReason}}" placeholder="说明实际收款金额发生变化的原因（至少4字）" bindinput="inputActualTailReason"></textarea><view class="flex margin-top-sm"><button class="cu-btn round line-grey flex-sub" bindtap="hideModal">取消</button><button class="cu-btn round line-cyan flex-sub margin-left" loading="{{adjustmentSubmitting}}" disabled="{{adjustmentSubmitting}}" bindtap="submitCollectionAdjustment">确认实际尾款</button></view></block>
      </view>
      <view wx:if="{{commissionReceivable}}" class="commission-bill"><view><text>平台服务费</text><text>{{commissionReceivable.gross_text}}</text></view><view><text>预约费抵扣</text><text class="text-green">-{{commissionReceivable.offset_text}}</text></view><view wx:if="{{commissionReceivable.worker_credit_cents > 0}}"><text>待验收冻结给师傅</text><text class="text-orange">{{commissionReceivable.credit_text}}</text></view><view wx:if="{{commissionReceivable.amount_paid_cents > 0}}"><text>已经支付</text><text class="text-green">-{{commissionReceivable.paid_text}}</text></view><view class="bill-total"><text>还需支付</text><text>{{commissionReceivable.unpaid_text}}</text></view></view>
      <view wx:if="{{!commissionReceivable && !order.is_platform_order}}" class="settlement-note">服务费账单正在生成，请稍后下拉刷新。</view>
      <button wx:if="{{actions.can_pay_commission}}" class="cu-btn block round bg-cyan text-white margin-top" loading="{{commissionPaying}}" disabled="{{commissionPaying}}" bindtap="payCommission">微信支付 {{commissionReceivable.unpaid_text}}</button>
      <view wx:elif="{{commissionReceivable && commissionReceivable.unpaid_cents > 0 && !collectionReceipts.length}}" class="settlement-note">上传收款凭证后即可支付 {{commissionReceivable.unpaid_text}}</view>
      <view wx:elif="{{commissionReceivable && commissionReceivable.unpaid_cents === 0}}" class="settlement-success"><text class="cuIcon-roundcheckfill"></text> 本单平台服务费已结清</view>
    </view>

    <view class="panel bg-white" wx:if="{{!isMeasurementOrder && !order.is_platform_order && assignment && assignment.status === 'accepted' && (order.fulfillment_status === 'submitted' || order.fulfillment_status === 'accepted' || offlineDelay)}}">
      <view class="panel-title"><text class="cuIcon-time text-cyan"></text> 线下尾款</view>
      <view class="collection-note">正常收款无需额外登记；实际金额有变化用上方“金额有变”，尾款暂未收齐时再在这里登记。</view>
      <view wx:if="{{offlineDelay}}" class="delay-record"><view class="flex justify-between"><text class="text-grey">延期尾款</text><text class="text-bold">{{offlineDelay.amount_text}}</text></view><view class="margin-top-sm">{{offlineDelay.reason}}</view><view wx:if="{{offlineDelay.expected_collect_at}}" class="text-grey text-sm margin-top-xs">预计收款：{{offlineDelay.expected_collect_at}}</view><view class="text-orange text-sm margin-top-xs">状态：{{offlineDelay.status === 'bad_debt' ? '已标记坏账' : '已登记，平台已知悉'}}</view><view wx:if="{{offlineDelay.review_note}}" class="text-grey text-sm margin-top-xs">平台说明：{{offlineDelay.review_note}}</view></view>
      <button wx:if="{{actions.can_report_collection_delay}}" class="cu-btn block round line-orange margin-top" data-target="delay" bindtap="showModal">尾款未收齐</button>
    </view>

    <view id="section-repair" class="panel bg-white after-sales-panel workflow-target-panel" wx:if="{{afterSales.length}}">
      <view class="panel-title"><text class="cuIcon-safe text-orange"></text> {{isMeasurementOrder ? '测量售后事项' : '售后事项'}}</view>
      <view wx:for="{{afterSales}}" wx:key="id" class="after-sales-item">
        <view class="flex justify-between align-center"><text class="text-bold">{{item.type_text}}</text><text class="after-sales-status {{item.status}}">{{item.status_text}}</text></view>
        <view class="description">{{item.description || '用户已提交售后申请'}}</view>
        <view wx:if="{{item.warranty_expires_at}}" class="text-grey text-sm margin-top-xs">维修保障至 {{item.warranty_expires_at}}</view>
        <view wx:if="{{item.resolution}}" class="after-sales-resolution">处理记录：{{item.resolution}}</view>
        <view wx:if="{{item.evidence.length}}" class="thumb-row"><image wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="id" src="{{evidence.display_url || evidence.url}}" mode="aspectFill" data-url="{{evidence.url}}" bindtap="previewAfterSalesEvidence"></image></view>
        <view wx:if="{{item.type === 'warranty_repair' && item.can_worker_process}}" class="flex flex-wrap margin-top-sm"><button class="cu-btn sm round line-cyan margin-right-sm" data-target="appointment" data-context="repair" data-after-sale-id="{{item.id}}" bindtap="showModal">{{repairAppointment ? (isMeasurementOrder ? '修改售后预约' : '修改维修预约') : (isMeasurementOrder ? '记录售后预约' : '记录联系/预约')}}</button><button class="cu-btn sm round bg-green text-white margin-right-sm" data-id="{{item.id}}" data-action="complete" bindtap="respondRepair">{{isMeasurementOrder ? '完成售后' : '完成维修'}}</button><button class="cu-btn sm round line-orange" data-id="{{item.id}}" data-action="reject" bindtap="respondRepair">{{isMeasurementOrder ? '拒绝售后' : '拒绝维修'}}</button></view>
        <view wx:if="{{item.type === 'warranty_repair' && item.can_worker_process && repairAppointment}}" class="text-grey text-sm margin-top-xs">{{isMeasurementOrder ? '本次售后联系：' : '本次维修联系：'}}{{repairAppointment.wait_customer_notice ? '等待客户另行通知' : (repairAppointment.appointment_at || '时间待定')}}{{repairAppointment.note ? ' · ' + repairAppointment.note : ''}}</view>
        <view class="text-grey text-sm margin-top-xs">提交于 {{item.opened_at || '—'}}</view>
      </view>
    </view>

    <view class="panel bg-white" wx:if="{{review}}"><view class="panel-title"><text class="cuIcon-favorfill text-orange"></text> 本单评价</view><view class="info-line"><text class="label">服务态度</text><text>{{review.attitude_rating || review.rating}} 星</text></view><view class="info-line"><text class="label">施工手艺</text><text>{{review.craft_rating || review.rating}} 星</text></view><view class="info-line"><text class="label">综合评分</text><text class="text-orange text-bold">{{review.overall_rating || review.rating}}</text></view><view class="description">{{review.content || '本次服务已完成评价'}}</view><view class="text-grey text-sm margin-top-xs">{{review.is_auto ? '系统默认评价' : '用户评价'}} · {{review.reviewed_at}}</view></view>

    <view wx:if="{{actions.can_worker_cancel}}" class="panel bg-white"><view class="panel-title">无法继续服务</view><view class="text-grey">如因你自身原因无法履约，请主动取消；客户不承担上门或时间补偿，可退线上实收全额原路退款。</view><button class="cu-btn round line-orange margin-top" bindtap="cancelOwnService">因自身原因取消</button></view>
    <canvas type="2d" id="completionWatermarkCanvas" class="watermark-canvas" style="width:{{watermarkCanvasWidth}}px;height:{{watermarkCanvasHeight}}px"></canvas>
    <view class="safe-bottom"></view>
    <view class="bottom-bar bg-white workflow-bottom-bar">
      <button wx:if="{{actions.is_admin}}" class="bottom-icon admin-manage" bindtap="goAdminOrder"><text class="cuIcon-commandfill"></text><view>管理</view></button>
      <button wx:else class="bottom-icon" bindtap="qwkefu"><text class="cuIcon-service"></text><view>客服</view></button>
      <button class="bottom-icon" open-type="share"><text class="cuIcon-share"></text><view>转给朋友</view></button>
      <block wx:if="{{workflowNav.length}}"><button wx:for="{{workflowNav}}" wx:key="target" class="cu-btn workflow-nav-action {{index === 0 ? 'action-primary' : 'action-secondary'}}" data-section="{{item.target}}" bindtap="scrollWorkflowSection"><text class="{{item.icon}} action-main-icon"></text>{{item.label}}</button></block>
      <navigator wx:elif="{{actions.can_start_worker_onboarding}}" url="/pages/plus/plus" class="cu-btn workflow-nav-action action-primary" hover-class="none"><text class="cuIcon-peoplefill action-main-icon"></text>{{actions.worker_onboarding_label || '申请成为师傅后报价'}}</navigator>
      <button wx:elif="{{actions.quote_disabled_reason}}" class="cu-btn workflow-nav-action action-disabled" disabled><text class="cuIcon-warnfill action-main-icon"></text>{{actions.quote_disabled_reason}}</button>
      <button wx:else class="cu-btn workflow-nav-action action-disabled" disabled><text class="cuIcon-check action-main-icon"></text>暂无待办</button>
    </view>
  </block>

  <view class="cu-modal bottom-modal quote-sheet {{modalName === 'quote' || modalName === 'grab' ? 'show' : ''}}" catchtouchmove="true"><view class="cu-dialog"><view class="cu-bar bg-white"><view class="action text-grey" bindtap="hideModal">取消</view><view class="content text-bold">{{modalName === 'grab' ? '确认总价抢单' : (order.is_platform_order ? '平台单工费报价' : (isMeasurementOrder ? '测量报价' : (assignment && assignment.assignment_type === 'single_grab' && assignment.status === 'offered' ? '抢单后报价' : '师傅报价')))}}</view><view class="action text-cyan" bindtap="submitQuote">{{modalName === 'grab' ? '确认抢单' : '提交'}}</view></view><view class="modal-body text-left"><view wx:if="{{modalName === 'grab'}}" class="quote-reminder">本单总价已由用户确定，不能在抢单时修改；请核对资料、服务范围及上门安排，同意协议后抢单。新增项目须用户确认后生效。</view><view class="quote-reminder"><text class="cuIcon-infofill text-orange"></text> {{order.is_platform_order ? '平台单仅填写师傅工费，不是客户最终金额；不另收普通平台服务费。' : commissionText + '。'}}{{assignment && assignment.assignment_type === 'single_grab' && assignment.status === 'offered' ? '本次报价提交后将直接确认由你施工，不再等待用户选择师傅。' : ''}}{{measurementLink ? '先填施工原价，下一步与用户商定测量费抵扣；抵扣后成交价不能低于预约费。' : (isMeasurementOrder ? '测量总价不能低于预约费；用户选中后只补齐与已付预约费的差额。' : (order.is_platform_order ? '平台单报价填写的是师傅工费，客户成交价不变。' : '施工总价不能低于预约费。'))}}</view><view class="amount-input flex align-center"><text class="text-xxl text-bold">¥</text><text wx:if="{{modalName === 'grab'}}" class="grab-fixed-amount">{{quoteAmount}}</text><input wx:else placeholder-class="quote-placeholder" type="digit" inputmode="decimal" maxlength="11" placeholder="{{order.is_platform_order ? '请输入师傅工费' : (isMeasurementOrder ? '请输入测量总价' : '请输入施工总价')}}" value="{{quoteAmount}}" bindinput="inputQuoteAmount"/></view><view wx:if="{{quoteAmount && order.is_platform_order}}" class="quote-preview"><view>此次报价为师傅工费，不改变客户成交价；平台单不另扣普通平台服务费。</view></view><view wx:if="{{quoteAmount && !order.is_platform_order}}" class="quote-preview"><view wx:if="{{measurementLink}}" class="text-grey">以下为抵扣前预估，最终以确认抵扣后的价格计算</view><view><text>预计线下收款</text><text>{{quotePreview.offline}}</text></view><view><text>预计平台服务费</text><text>{{quotePreview.commission}}</text></view><view><text>预计补缴服务费</text><text>{{quotePreview.due}}</text></view><view><text>预计净收入</text><text class="text-green text-bold">{{quotePreview.net}}</text></view></view><view class="quote-field"><text>{{modalName === 'grab' ? '服务说明（选填）' : '报价说明（选填）'}}</text><textarea placeholder-class="quote-placeholder" maxlength="1000" placeholder="请说明包含的服务、不包含的项目及其他补充事项，例如：包含铺贴人工，不含材料和旧墙铲除。" value="{{quoteDescription}}" bindinput="inputQuoteDescription"></textarea></view><view class="quote-field"><text>可上门时间（选填）</text><input placeholder-class="quote-placeholder" maxlength="80" placeholder="例如：本周工作日均可，电话预约" value="{{quoteAvailability}}" bindinput="inputQuoteAvailability"/></view><view class="quote-agreement-notice"><checkbox-group bindchange="quoteAckChange"><label class="ack"><checkbox value="ack" checked="{{quoteAcknowledged}}" color="#16a568"/>我已阅读并同意师傅服务协议，知晓本单报价、服务费及结算规则</label></checkbox-group><navigator class="quote-agreement-link" url="/pages/agreementCenter/index?key=worker_cooperation_agreement">查看《师傅服务协议》及结算约定 ›</navigator><view class="text-sm text-grey">提交前请确认报价与服务范围；不同意可取消勾选。</view></view></view></view></view>

  <view class="cu-modal bottom-modal {{modalName === 'appointment' ? 'show' : ''}}" catchtouchmove="true"><view class="cu-dialog"><view class="cu-bar bg-white"><view class="action text-grey" bindtap="hideModal">取消</view><view class="content text-bold">{{appointmentContext === 'repair' ? '维修联系/预约' : '记录预约'}}</view><view class="action text-cyan" bindtap="saveAppointment">保存</view></view><view class="modal-body text-left"><checkbox-group bindchange="appointmentWaitChange"><label class="appointment-wait-option"><checkbox value="wait" checked="{{appointmentWaitCustomerNotice}}" color="#00b9cb"/>等待客户另行通知</label></checkbox-group><view class="text-grey text-sm margin-top-xs">勾选后无需填写具体时间；保存即视为你已经响应客户，本次不会再触发“超过2小时未联系”的电话公开申请。</view><block wx:if="{{!appointmentWaitCustomerNotice}}"><view wx:if="{{appointmentPresets.length}}" class="appointment-presets"><view class="text-grey text-sm margin-bottom-xs">快捷选择</view><view class="preset-row"><button wx:for="{{appointmentPresets}}" wx:key="label" class="cu-btn sm round line-cyan preset-button" data-index="{{index}}" bindtap="quickAppointment">{{item.label}}</button></view></view><view class="picker-row flex"><picker mode="date" value="{{appointmentDate}}" bindchange="pickAppointmentDate"><view class="picker-box">{{appointmentDate || '选择日期'}}</view></picker><picker mode="time" value="{{appointmentTime}}" bindchange="pickAppointmentTime"><view class="picker-box">{{appointmentTime || '选择时间'}}</view></picker></view></block><textarea maxlength="500" placeholder="{{appointmentContext === 'repair' ? '维修联系说明（选填）' : '预约备注（选填）'}}" value="{{appointmentNote}}" bindinput="inputAppointmentNote"></textarea><view class="text-grey text-sm margin-top">预约由师傅提交，无需客户再次确认。</view></view></view></view>

  <view class="cu-modal bottom-modal {{modalName === 'arrival' ? 'show' : ''}}" catchtouchmove="true"><view class="cu-dialog"><view class="cu-bar bg-white"><view class="action text-grey" bindtap="hideModal">取消</view><view class="content text-bold">异常到场</view><view class="action text-cyan" bindtap="submitArrival">提交</view></view><view class="modal-body text-left"><view class="arrival-tags"><text class="cu-tag round {{arrivalType === 'cannot_contact' ? 'bg-orange text-white' : 'line-grey'}}" data-type="cannot_contact" bindtap="selectArrivalType">无法联系</text><text class="cu-tag round {{arrivalType === 'cannot_work' ? 'bg-orange text-white' : 'line-grey'}}" data-type="cannot_work" bindtap="selectArrivalType">{{isMeasurementOrder ? '无法测量' : '无法施工'}}</text><text class="cu-tag round {{arrivalType === 'other' ? 'bg-orange text-white' : 'line-grey'}}" data-type="other" bindtap="selectArrivalType">其他</text></view><view class="quote-reminder"><text class="cuIcon-infofill text-orange"></text> 必须先上传现场取证照片；照片会自动写入拍摄时间、订单地点和定位坐标，作为平台裁决依据。</view><view wx:if="{{arrivalPhotos.length}}" class="thumb-row"><image wx:for="{{arrivalPhotos}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image></view><button class="cu-btn block round line-orange margin-top" data-purpose="arrival_evidence" bindtap="choosePhoto">上传/补充取证照片</button><textarea maxlength="1000" placeholder="请说明现场情况，提交后联系客服协商处理" value="{{arrivalDescription}}" bindinput="inputArrivalDescription"></textarea></view></view></view>

  <view class="cu-modal bottom-modal {{modalName === 'change' ? 'show' : ''}}" catchtouchmove="true"><view class="cu-dialog"><view class="cu-bar bg-white"><view class="action text-grey" bindtap="hideModal">取消</view><view class="content text-bold">{{isMeasurementOrder ? '测量加费申请' : '施工加价申请'}}</view><view class="action text-cyan" bindtap="submitChange">提交</view></view><view class="modal-body text-left"><view class="quote-reminder"><text class="cuIcon-infofill text-orange"></text> 请先与用户口头沟通。用户拒绝后不会要求你按原价继续，协商不成可申请客服介入或结束订单。</view><view class="amount-input flex align-center"><text class="text-xxl text-bold">¥</text><input type="digit" placeholder="本次增加金额" value="{{changeAmount}}" bindinput="inputChangeAmount"/></view><textarea maxlength="1000" placeholder="{{isMeasurementOrder ? '说明测量现场特殊情况及增加费用原因' : '说明施工难度、现场特殊情况及增加费用原因'}}" value="{{changeReason}}" bindinput="inputChangeReason"></textarea></view></view></view>

  <view class="cu-modal bottom-modal {{modalName === 'runEmpty' ? 'show' : ''}}" catchtouchmove="true"><view class="cu-dialog"><view class="cu-bar bg-white"><view class="action text-grey" bindtap="hideModal">取消</view><view class="content text-bold">跑空费处理</view><view class="action text-cyan" bindtap="submitRunEmptyClaim">提交</view></view><view class="modal-body text-left"><view class="quote-reminder"><text class="cuIcon-infofill text-orange"></text> {{order.order_source_type === 'merchant' ? '请说明到场及协商情况，商家确认后在线支付；商家不同意时转平台争议。' : '请先线下向用户收取跑空费。只有用户已申请退款且不愿支付时，才提交平台争议。'}}</view><view class="quote-reminder"><text class="cuIcon-camera text-orange"></text> 必须先上传带位置和时间水印的现场取证照片，平台将按照片和说明裁决。</view><view wx:if="{{arrivalPhotos.length}}" class="thumb-row"><image wx:for="{{arrivalPhotos}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image></view><button class="cu-btn block round line-orange margin-top" data-purpose="arrival_evidence" bindtap="choosePhoto">上传/补充取证照片</button><view class="amount-input flex align-center"><text class="text-xxl text-bold">¥</text><input type="digit" inputmode="decimal" placeholder="金额，不超过本单预约费" value="{{runEmptyAmount}}" bindinput="inputRunEmptyAmount"/></view><textarea maxlength="1000" placeholder="说明到场、无法施工和双方协商情况" value="{{runEmptyReason}}" bindinput="inputRunEmptyReason"></textarea></view></view></view>

  <view class="cu-modal bottom-modal {{modalName === 'delay' ? 'show' : ''}}" catchtouchmove="true"><view class="cu-dialog"><view class="cu-bar bg-white"><view class="action text-grey" bindtap="hideModal">取消</view><view class="content text-bold">登记尾款延期</view><view class="action text-cyan" bindtap="submitCollectionDelay">提交</view></view><view class="modal-body text-left"><view class="quote-reminder"><text class="cuIcon-infofill text-orange"></text> 仅在尾款不能按时收取时登记；正常线下收款不需要报告。</view><picker mode="date" value="{{delayDate}}" bindchange="pickDelayDate"><view class="picker-box margin-top">预计收款日期：{{delayDate || '暂不确定'}}</view></picker><textarea maxlength="1000" placeholder="请说明尾款延期原因" value="{{delayReason}}" bindinput="inputDelayReason"></textarea></view></view></view>
</view>
