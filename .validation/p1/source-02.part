  $financeProgress=new DatabaseTestCenterDisputeFinanceVerificationRepository($db,$adminProgress);\n        $autoReviewProgress=new DatabaseTestCenterAutoReviewVerificationRepository($db,$financeProgress);\n        $autoCancelProgress=new DatabaseTestCenterAutoCancelVerificationRepository($db,$autoReviewProgress);\n        $refundRetryProgress=new DatabaseTestCenterRefundRetryVerificationRepository($db,$autoCancelProgress);\n        $supplementTimeoutProgress=new DatabaseTestCenterSupplementTimeoutVerificationRepository($db,$refundRetryProgress);\n        $financeCleanup=new DatabaseTestCenterDisputeFinanceCleanupRepository($db,$supplementTimeoutProgress);\n        $fulfillmentCleanup=new DatabaseTestCenterFulfillmentCleanupRepository($db,$financeCleanup);\n        $negotiationCleanup=new DatabaseTestCenterNegotiationCleanupRepository($db,$fulfillmentCleanup);\n        $refundCleanup=new DatabaseTestCenterRefundCleanupRepository($db,$negotiationCleanup);\n        $repairCleanup=new DatabaseTestCenterRepairCleanupRepository($db,$refundCleanup);\n        $measurementCleanup=new DatabaseTestCenterMeasurementCleanupRepository($db,$repairCleanup);\n        $platformMeasurement=new DatabaseTestCenterPlatformMeasurementRepository($db,$measurementCleanup);\n        $proxyFactory=new DatabaseTestCenterProxyOrderActionRunner($db,new DatabaseTestCenterActionRunner($db));\n        $proxyRepository=new DatabaseTestCenterProxyOrderRepository($db,$platformMeasurement,$proxyFactory);\n        $invitationRepository=new DatabaseTestCenterInvitationRepository($db,$proxyRepository);\n        $autoReviewCleanup=new DatabaseTestCenterAutoReviewCleanupRepository($db,$invitationRepository);\n        $autoCancelCleanup=new DatabaseTestCenterAutoCancelCleanupRepository($db,$autoReviewCleanup);\n        $supplementTimeoutCleanup=new DatabaseTestCenterSupplementTimeoutCleanupRepository($db,$autoCancelCleanup);\n        $cleanupGuard=new DatabaseTestCenterCleanupGuardRepository($db,$supplementTimeoutCleanup);\n        $repository=new DatabaseTestCenterCleanupSafetyRepository($db,$cleanupGuard);\n\n        $dealActions=new DatabaseTestCenterActionRunner($db);\n        $singleGrabActions=new DatabaseTestCenterSingleGrabActionRunner($db,$dealActions);\n        $measurementActions=new DatabaseTestCenterMeasurementActionRunner($db,$singleGrabActions);\n        $fulfillmentActions=new DatabaseTestCenterFulfillmentActionRunner($db,$measurementActions);\n        $negotiationActions=new DatabaseTestCenterNegotiationActionRunner($db,$fulfillmentActions);\n        $refundActions=new DatabaseTestCenterRefundActionRunner($db,$negotiationActions);\n        $repairActions=new DatabaseTestCenterRepairActionRunner($db,$refundActions);\n        $adminActions=new DatabaseTestCenterAdminAdjudicationActionRunner($db,$repairActions);\n        $financeActions=new DatabaseTestCenterDisputeFinanceActionRunner($db,$adminActions);\n        $adminReplayActions=new DatabaseTestCenterAdminRefundReplayRunner($db,$financeActions);\n        $platformActions=new DatabaseTestCenterPlatformMeasurementActionRunner($db,$adminReplayActions);\n        $proxyActions=new DatabaseTestCenterProxyOrderActionRunner($db,$platformActions);\n        $invitationActions=new DatabaseTestCenterInvitationActionRunner($db,$proxyActions,$repository);\n        $tailActions=new DatabaseTestCenterMeasurementTailActionRunner($db,$invitationActions,$repository);\n        $schedulerActions=new DatabaseTestCenterSchedulerActionRunner($db,$tailActions);\n        $messageSimulationActions=new DatabaseTestCenterMessageSimulationActionRunner($db,$schedulerActions);\n        $messageProviderActions=new DatabaseTestCenterMessageProviderFailureActionRunner($db,$messageSimulationActions);\n        $paidSmsReceiptActions=new DatabaseTestCenterPaidSmsReceiptActionRunner($db,$messageProviderActions);\n        $captureActions=new DatabaseTestCenterReplayCaptureRunner($db,new \\WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterChatActionRunner($db,$paidSmsReceiptActions));\n        $actions=new DatabaseTestCenterActionSafetyRunner($db,$captureActions);\n        $failureReplay=new DatabaseTestCenterFailureReplay($db,$actions);\n        $schedulerInspector=new DatabaseTestCenterSchedulerInspector($db);\n        return new TestCenter($repository,new TestScenarioCatalog(),$actions,$failureReplay,$schedulerInspector);\n    }\n}\n\n","server/app/Http/Admin/AdminKernel.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AdminAccountAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ChatCredentialAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ChatImageReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AgreedRefundExecutionAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AgreementAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AuditAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ContactRevealReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\DisputeReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ExceptionDashboardAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\FailedRefundRecoveryAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\FinanceAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\HelpCenterAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\MeasurementHoldReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\PlatformOrderAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\PlatformOrderFinanceAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RealNameAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderCancellationRiskAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RefundReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RepairInterventionAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\SchedulerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\MessageOutboxAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RuntimeLogAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ConfigurationSettingsAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ServiceCategoryAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderFormDesignerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\TestCenterAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\UserMerchantAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\WorkerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\LegacyAdminModule;\n\n/** 后台模块组合根。 */\nfinal class AdminKernel\n{\n    /** @var AdminModule[] */\n    private array $modules;\n    private AdminRequestGuard $guard;\n\n    /** @param AdminModule[]|null $modules */\n    public function __construct(Database $db, Auth $auth, Csrf $csrf, ?array $modules = null)\n    {\n        $this->guard = new AdminRequestGuard($auth, $csrf);\n        $this->modules = $modules ?: [\n            new AdminAccountAdminModule($db, $auth, $csrf),\n            new ChatCredentialAdminModule($db, $auth, $csrf),\n            new ChatImageReviewAdminModule($db, $auth, $csrf),\n            new \\WorkerAdmin\\Http\\Admin\\Modules\\ChatAVReviewAdminModule($db,$auth,$csrf),\n            new \\WorkerAdmin\\Http\\Admin\\Modules\\ChatStorageAdminModule($db,$auth,$csrf),\n            new \\WorkerAdmin\\Http\\Admin\\Modules\\ChatGovernanceAdminModule($db,$auth,$csrf),\n            new ExceptionDashboardAdminModule($db, $auth, $csrf),\n            new RefundReviewAdminModule($db, $auth, $csrf),\n            new DisputeReviewAdminModule($db, $auth, $csrf),\n            new AuditAdminModule($db, $auth, $csrf),\n            new ContactRevealReviewAdminModule($db, $auth, $csrf),\n            new MeasurementHoldReviewAdminModule($db, $auth, $csrf),\n            new RepairInterventionAdminModule($db, $auth, $csrf),\n            new AgreementAdminModule($db, $auth, $csrf),\n            new HelpCenterAdminModule($db, $auth, $csrf),\n            new RealNameAdminModule($db, $auth, $csrf),\n            new OrderCancellationRiskAdminModule($db, $auth, $csrf),\n            new SchedulerAdminModule($db, $auth, $csrf),\n            new AgreedRefundExecutionAdminModule($db, $auth, $csrf),\n            new FailedRefundRecoveryAdminModule($db, $auth, $csrf),\n            new PlatformOrderFinanceAdminModule($db, $auth, $csrf),\n            new PlatformOrderAdminModule($db, $auth, $csrf),\n            new MessageOutboxAdminModule($db, $auth, $csrf),\n            new RuntimeLogAdminModule($db, $auth, $csrf),\n            new TestCenterAdminModule($db, $auth, $csrf),\n            new ConfigurationSettingsAdminModule($db,$auth,$csrf),\n            new ServiceCategoryAdminModule($db,$auth,$csrf),\n            new OrderFormDesignerAdminModule($db,$auth,$csrf),\n            new UserMerchantAdminModule($db,$auth,$csrf),\n            new ReviewAdminModule($db,$auth,$csrf),\n            new WorkerAdminModule($db,$auth,$csrf),\n            // 最后一块旧网页订单路由由正式模块接管；Legacy 只保留 staged 旧 handler 的物理代码。\n            new OrderAdminModule($db,$auth,$csrf),\n            new FinanceAdminModule($db,$auth,$csrf),\n            new LegacyAdminModule($db, $auth, $csrf),\n        ];\n    }\n\n    public function dispatch(string $route): void\n    {\n        try {\n            $this->guard->inspect($route);\n        } catch (RuntimeException $exception) {\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) === 'POST') {\n                \\flash('danger', $exception->getMessage());\n                \\redirect(\\admin_url('dashboard'));\n            }\n            throw $exception;\n        }\n        foreach ($this->modules as $module) {\n            if (!$module instanceof AdminModule || !$module->supports($route)) continue;\n            $module->dispatch($route);\n            return;\n        }\n        throw new RuntimeException('后台路由不存在');\n    }\n}\n","server/app/Http/Admin/AdminRequestGuard.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\n\nfinal class AdminRequestGuard\n{\n    private Auth $auth;\n    private Csrf $csrf;\n\n    public function __construct(Auth $auth, Csrf $csrf)\n    {\n        $this->auth = $auth;\n        $this->csrf = $csrf;\n    }\n\n    public function inspect(string $route): void\n    {\n        if ($route === 'chat.credentials') {\n            $status = 0;\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {\n                header('Allow: POST'); $status = 405;\n            } elseif (!$this->auth->check()) { $status = 401;\n            } elseif (!empty($this->auth->user()['must_change_password'])) { $status = 403;\n            } else {\n                try { $this->csrf->verifyRequest(); } catch (\\RuntimeException $error) { $status = 403; }\n            }\n            if ($status) \\json_response(['ok'=>false,'code'=>$status===401?'CHAT_UNAUTHORIZED':($status===405?'CHAT_METHOD_NOT_ALLOWED':'CHAT_FORBIDDEN'),\n                'message'=>'请刷新页面后重试','retryable'=>false,'request_id'=>\\request_id(),'server_time'=>gmdate('Y-m-d\\TH:i:s\\Z')],$status);\n            return;\n        }\n        if ($route === 'login') return;\n        $this->auth->requireLogin();\n        $user = $this->auth->user();\n        if (!empty($user['must_change_password']) && !in_array($route, ['profile','profile.password','logout'], true)) {\n            \\flash('warning', '首次登录必须先修改演示密码。');\n            \\redirect(\\admin_url('profile'));\n        }\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) === 'POST') {\n            $this->csrf->verifyRequest();\n        }\n    }\n}\n\n","server/app/Http/Admin/Modules/ChatAVReviewAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n\n/** PHP provides an authorized page only. All review state is owned by Go. */\nfinal class ChatAVReviewAdminModule implements AdminModule\n{\n    private Auth $auth;\n    public function __construct(Database $db, Auth $auth, Csrf $csrf) { $this->auth = $auth; }\n    public function supports(string $route): bool { return $route === 'chat.av-review'; }\n    public function dispatch(string $route): void\n    {\n        $this->auth->requirePermission('chat.media.review');\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'GET') {\n            http_response_code(405); throw new \\RuntimeException('该页面只接受 GET 请求。');\n        }\n        echo \\view('admin/chat-av-review', ['pageTitle'=>'聊天音视频预审','activeMenu'=>'chat.av-review']);\n    }\n}\n","server/app/Http/Admin/Modules/ChatGovernanceAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n/** PHP owns page/identity grants only; every chat-governance mutation uses Go. */\nfinal class ChatGovernanceAdminModule implements AdminModule\n{\n    private Database $db;private Auth $auth;\n    public function __construct(Database $db,Auth $auth,Csrf $csrf){$this->db=$db;$this->auth=$auth;}\n    public function supports(string $route):bool{return in_array($route,['chat.governance','chat.auditors'],true);}\n    public function dispatch(string $route):void\n    {\n        $this->auth->requirePermission($route==='chat.auditors'?'chat.audit.grants':'audit.view');\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));\n        if($route==='chat.auditors'&&$method==='POST'){\n            $id=trim((string)($_POST['user_id']??''));$reason=trim((string)($_POST['reason']??''));$enabled=(string)($_POST['enabled']??'')==='1';\n            if(preg_match('/^[1-9][0-9]{0,19}$/D',$id)!==1||mb_strlen($reason)<2||mb_strlen($reason)>200||!$this->db->fetchValue(\"SELECT id FROM users WHERE id=:id AND status='active'\",['id'=>$id]))throw new RuntimeException('请填写真实用户编号和授权理由');\n            $admin=(string)$this->auth->user()['id'];$version=bin2hex(random_bytes(32));\n            $this->db->transaction(function()use($id,$reason,$enabled,$admin,$version):void{\n                $this->db->execute('INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE enabled=VALUES(enabled),authority_version=VALUES(authority_version),granted_by=VALUES(granted_by),reason=VALUES(reason),updated_at=VALUES(updated_at)',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n                $this->db->execute('INSERT INTO chat_auditor_grant_audit(user_id,enabled,authority_version,admin_id,reason,created_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6))',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n            });\n            \\flash('success','会话抽检授权已更新');\\redirect(\\admin_url('chat.auditors'));return;\n        }\n        if($method!=='GET'){http_response_code(405);throw new RuntimeException('请求方式不正确');}\n        $grants=$route==='chat.auditors'?$this->db->fetchAll('SELECT user_id,enabled,granted_by,reason,updated_at FROM chat_mini_auditors ORDER BY updated_at DESC,user_id DESC LIMIT 50'):[];\n        echo \\view('admin/chat-governance',['pageTitle'=>$route==='chat.auditors'?'小程序抽检授权':'聊天抽检与治理','activeMenu'=>$route,'grants'=>$grants,'grantPage'=>$route==='chat.auditors',\n            'canModerate'=>$this->auth->can('users.manage'),'canEvidence'=>$this->auth->can('chat.evidence.view')]);\n    }\n}\n","server/app/Http/Admin/Modules/ChatImageReviewAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n\n/** PHP provides an authorized page only. All review state is owned by Go. */\nfinal class ChatImageReviewAdminModule implements AdminModule\n{\n    private Auth $auth;\n    public function __construct(Database $db, Auth $auth, Csrf $csrf) { $this->auth = $auth; }\n    public function supports(string $route): bool { return $route === 'chat.image-review'; }\n    public function dispatch(string $route): void\n    {\n        $this->auth->requirePermission('chat.images.review');\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'GET') {\n            http_response_code(405); throw new \\RuntimeException('该页面只接受 GET 请求。');\n        }\n        echo \\view('admin/chat-image-review', ['pageTitle'=>'聊天图片预审','activeMenu'=>'chat.image-review']);\n    }\n}\n","server/app/Http/Admin/Modules/ChatStorageAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Application\\Chat\\ChatStorageSettings;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n\nfinal class ChatStorageAdminModule implements AdminModule\n{\n    private Auth $auth;private Csrf $csrf;private ChatStorageSettings $settings;\n    public function __construct(Database $db,Auth $auth,Csrf $csrf)\n    { $this->auth=$auth;$this->csrf=$csrf;$this->settings=new ChatStorageSettings($db,(string)\\app_config('app.key','')); }\n    public function supports(string $route):bool { return $route==='chat.storage'; }\n    public function dispatch(string $route):void\n    {\n        $this->auth->requirePermission('settings.manage');\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));\n        if(!in_array($method,['GET','POST'],true)){http_response_code(405);throw new RuntimeException('请求方式不正确');}\n        $preview=null;$notice='';\n        try{\n            if($method==='POST'){\n                $this->csrf->verifyRequest();$admin=$this->auth->user();$action=$_POST['_action']??'';\n                if($action==='preview')$preview=$this->settings->preview($_POST,(int)$admin['id']);\n                elseif($action==='save'){\n                    $this->settings->save($_POST,(int)$admin['id'],(string)$admin['role']);\n                    \\flash('success','聊天保存设置已更新；历史应用按预览范围分批处理');\\redirect(\\admin_url('chat.storage'));return;\n                }else throw new RuntimeException('请先预览设置');\n            }\n        }catch(RuntimeException $error){$notice=$error->getMessage();}\n        catch(Throwable $error){$notice='暂时无法读取或保存聊天设置，请稍后重试';}\n        $current=$this->settings->current();\n        echo \\view('admin/chat-storage',['pageTitle'=>'聊天存储与保存期','activeMenu'=>'chat.storage','current'=>$current,'policy'=>$preview['policy']??$current['policy'],'preview'=>$preview,'notice'=>$notice]);\n    }\n}\n","server/app/Http/Admin/Modules/TestCenterAdminModule.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse Throwable;\nuse WorkerAdmin\\Application\\Testing\\TestCenter;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Testing\\TestCenterException;\nuse WorkerAdmin\\Foundation\\TestCenterComposition;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\nuse WorkerAdmin\\Contracts\\TestCenterEntryGateway;\n\nfinal class TestCenterAdminModule implements AdminModule\n{\n    private Auth $auth;\n    private Csrf $csrf;\n    private TestCenter $testCenter;\n    private TestCenterEntryGateway $testEntry;\n\n    public function __construct(Database $db, Auth $auth, Csrf $csrf)\n    {\n        $this->auth=$auth;$this->csrf=$csrf;$this->testCenter=TestCenterComposition::build($db);$this->testEntry=TestCenterComposition::entrySessions($db);\n    }\n\n    public function supports(string $route): bool{return$route==='test-center'||strpos($route,'test-center.')===0;}\n\n    public function dispatch(string $route): void\n    {\n        $this->auth->requireLogin();$admin=$this->auth->user();\n        if(!empty($admin['must_change_password'])){\\flash('warning','首次登录必须先修改演示密码。');\\redirect(\\admin_url('profile'));}\n        $this->auth->requirePermission('settings.manage');\n        if(($admin['role']??'')!=='super_admin'){http_response_code(403);echo \\view('errors/403',['pageTitle'=>'无权访问测试中心']);return;}\n        $allowed=['test-center','test-center.detail','test-center.create','test-center.verify','test-center.action','test-center.replay-failure','test-center.copy','test-center.rebuild','test-center.cleanup','test-center.batch-cleanup','test-center.batch-cleanup.execute','test-center.entry-token'];\n        if(!in_array($route,$allowed,true)){http_response_code(404);echo \\view('errors/404',['pageTitle'=>'页面不存在']);return;}\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));if($method==='POST')$this->csrf->verifyRequest();$adminId=(int)($admin['id']??0);\n        try{\n            if($route==='test-center'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $filters=['q'=>trim((string)($_GET['q']??'')),'status'=>trim((string)($_GET['status']??'')),'scenario'=>trim((string)($_GET['scenario']??''))];\n                $data=$this->testCenter->dashboard($filters);$requestKeys=[];\n                foreach((array)($data['scenarios']??[])as$scenario){$key=(string)($scenario['key']??'');if($key!=='')$requestKeys[$key]='create:'.bin2hex(random_bytes(12));}\n                echo \\view('admin/test-center',array_merge($data,['pageTitle'=>'测试中心','activeMenu'=>'test-center','filters'=>$filters,'requestKeys'=>$requestKeys]));return;\n            }\n            if($route==='test-center.detail'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $id=trim((string)($_GET['id']??''));$detail=$this->testCenter->detail($id);$detail['entry_tokens']=$this->testEntry->options($id);$actionRequestKeys=[];$failureReplayRequestKeys=[];\n                foreach((array)($detail['actions']['items']??[])as$key=>$action){$actionKey=(string)($action['key']??$key);if($actionKey!=='')$actionRequestKeys[$actionKey]='action:'.bin2hex(random_bytes(12));}\n                foreach((array)($detail['failure_replays']['items']??[])as$item){$runId=(string)($item['run_public_id']??'');if($runId!==''&&!empty($item['replayable']))$failureReplayRequestKeys[$runId]='failure-replay:'.bin2hex(random_bytes(12));}\n                echo \\view('admin/test-center-detail-v260',['pageTitle'=>'测试订单详情','activeMenu'=>'test-center','detail'=>$detail,'copyRequestKey'=>'copy:'.bin2hex(random_bytes(12)),'rebuildRequestKey'=>'rebuild:'.bin2hex(random_bytes(12)),'actionRequestKeys'=>$actionRequestKeys,'failureReplayRequestKeys'=>$failureReplayRequestKeys]);return;\n            }\n            if($route==='test-center.batch-cleanup'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $batch=trim((string)($_GET['batch']??''));$preview=$this->testCenter->batchCleanupPreview($batch);\n                echo \\view('admin/test-center-batch-cleanup',['pageTitle'=>'测试批次清理','activeMenu'=>'test-center','preview'=>$preview]);return;\n            }\n            if($method!=='POST')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n            if($route==='test-center.create'){\n                $result=$this->testCenter->create($_POST,$adminId);$id=(string)($result['instance']['public_id']??'');\n                \\audit('test_center.create','test_instance',(int)($result['instance']['id']??0),'创建测试场景 '.(string)($result['instance']['scenario_key']??''));\\flash('success','测试场景已生成并完成结构检查。');\\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.entry-token'){\n                $id=trim((string)($_POST['id']??''));\n                $entry=$this->testEntry->issue(\n                    $id,\n                    (string)($_POST['role']??''),\n                    (string)($_POST['worker_slot']??''),\n                    (int)($_POST['ttl_minutes']??10),\n                    $adminId\n                );\n                \\audit('test_center.entry_issue','test_instance',0,'生成测试中心短期小程序入口，实例 '.$id.'，角色 '.(string)$entry['actor_role'],[\n                    'entry_public_id'=>(string)$entry['public_id'],'worker_slot'=>$entry['worker_slot'],'expires_at'=>(string)$entry['expires_at'],\n                ]);\n                echo \\view('admin/test-center-entry-token',['pageTitle'=>'短期小程序测试入口','activeMenu'=>'test-center','entry'=>$entry]);\n                return;\n            }\n            if($route==='test-center.batch-cleanup.execute'){\n                $batch=trim((string)($_POST['batch']??''));$result=$this->testCenter->cleanupBatch($batch,$adminId,trim((string)($_POST['plan_digest']??'')));\n                \\audit('test_center.batch_cleanup','test_batch',0,'清理测试批次 '.$batch.'；成功 '.(int)$result['succeeded'].'，失败 '.(int)$result['failed']);\n                \\flash(!empty($result['complete'])?'success':'warning','批次清理完成：成功 '.(int)$result['succeeded'].'，失败 '.(int)$result['failed'].'。');\n                \\redirect(\\admin_url('test-center'));\n            }\n            $id=trim((string)($_POST['id']??''));\n            if($route==='test-center.action'){\n                $action=trim((string)($_POST['action_key']??''));$result=$this->testCenter->runAction($id,$_POST,$adminId);$mode=(string)($result['operation_mode']??'real_service');\n                \\audit('test_center.action','test_instance',0,'执行测试动作 '.$action.'，mode='.$mode.'，实例 '.$id.'，run '.(string)($result['run_public_id']??''));\n                if(!empty($result['replayed']))$message='该测试动作此前已成功执行，本次返回幂等结果。';\n                elseif($mode==='isolated_regression')$message=!empty($result['regression_passed'])?'隔离聊天回归通过，已登记指定源码与实例的签名结果；真机和真实渠道需分别验收。':'隔离聊天回归未通过，已记录失败结果，请查看执行记录。';\n                elseif($mode==='isolated_fixture')$message='隔离聊天夹具已准备，尚未执行聊天回归；请查看本次执行记录。';\n                elseif($mode==='real_service')$message='真实业务动作执行成功，订单/售后状态已按正式流程推进。';\n                elseif($mode==='time_fixture')$message='测试时间条件已推进；该步骤不计作真实业务动作。';\n                else $message='测试前置条件已补齐；该步骤不计作真实业务动作。';\n                \\flash(($result['result']??'')==='failed'?'warning':'success',$message);\\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.replay-failure'){\n                $sourceRun=trim((string)($_POST['run_id']??''));$requestKey=trim((string)($_POST['request_key']??''));\n                $result=$this->testCenter->replayFailure($id,$sourceRun,$adminId,$requestKey);\n                \\audit('test_center.failure_replay','test_instance',0,'重放失败测试动作，实例 '.$id.'，来源 run '.$sourceRun.'，新 run '.(string)($result['run_public_id']??''));\n                \\flash('success',!empty($result['replayed'])?'该失败动作已经按同一复现请求执行过，本次返回幂等结果。':'失败动作已使用原安全参数重新执行。');\n                \\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.verify'){$result=$this->testCenter->verify($id,$adminId);\\flash($result['failed']>0?'danger':'success',$result['failed']>0?'检查发现失败断言，请查看详情。':'测试实例检查通过。');\\redirect(\\admin_url('test-center.detail',['id'=>$id]));}\n            if($route==='test-center.copy'){$result=$this->testCenter->copy($id,$adminId,(string)($_POST['request_key']??''));$newId=(string)($result['instance']['public_id']??'');\\audit('test_center.copy','test_instance',(int)($result['instance']['id']??0),'复制测试场景，来源 '.$id);\\flash('success','已复制为新的测试实例。');\\redirect(\\admin_url('test-center.detail',['id'=>$newId]));}\n            if($route==='test-center.rebuild'){$result=$this->testCenter->rebuild($id,$adminId,(string)($_POST['request_key']??''));$newId=(string)($result['instance']['public_id']??'');\\audit('test_center.rebuild','test_instance',(int)($result['instance']['id']??0),'重建测试场景，来源 '.$id);\\flash('success','已按原场景参数重建新实例，旧实例和报告保留。');\\redirect(\\admin_url('test-center.detail',['id'=>$newId]));}\n            if($route==='test-center.cleanup'){$result=$this->testCenter->cleanup($id,$adminId,trim((string)($_POST['plan_digest']??'')));\\flash('success','测试业务数据已清理，实例留档与检查记录继续保留。');\\redirect(\\admin_url('test-center.detail',['id'=>(string)($result['public_id']??$id)]));}\n        }catch(TestCenterException $exception){\n            \\flash('danger',$exception->getMessage().'（'.$exception->businessCode().'）');\n            if($method==='GET')\\redirect(\\admin_url('test-center'));\n            $batch=trim((string)($_POST['batch']??''));if($batch!=='')\\redirect(\\admin_url('test-center.batch-cleanup',['batch'=>$batch]));\n            $id=trim((string)($_POST['id']??''));\\redirect($id!==''?\\admin_url('test-center.detail',['id'=>$id]):\\admin_url('test-center'));\n        }catch(Throwable $exception){\n            $requestId=\\request_id();\\write_log('test-center','['.date('c').'] request_id='.$requestId.' '.$exception.\"\\n\");\\flash('danger','测试中心处理失败，请查看运行日志。请求编号：'.$requestId);\n            if($method==='GET')\\redirect(\\admin_url('test-center'));\n            $batch=trim((string)($_POST['batch']??''));if($batch!=='')\\redirect(\\admin_url('test-center.batch-cleanup',['batch'=>$batch]));\n            $id=trim((string)($_POST['id']??''));\\redirect($id!==''?\\admin_url('test-center.detail',['id'=>$id]):\\admin_url('test-center'));\n        }\n    }\n}\n","server/app/Http/Api/Modules/ChatCredentialApiModule.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Api\\Modules;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Application\\Chat\\ChatCredentialIssuer;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Api\\ApiModule;\n\nfinal class ChatCredentialApiModule implements ApiModule\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function supports(string $route): bool { return in_array($route,['chat.credentials','chat.audit.credentials'],true); }\n    public function requiresContentSecurity(string $route): bool { return false; }\n    public function dispatch(string $route): void\n    {\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {\n            header('Allow: POST');\n            $this->fail('请求方式不正确', 'CHAT_METHOD_NOT_ALLOWED', 405);\n        }\n        $authorization = (string)($_SERVER['HTTP_AUTHORIZATION'] ?? '');\n        if (preg_match('/^Bearer ([A-Fa-f0-9]{64})$/D', $authorization, $match) !== 1) $this->fail('请重新登录', 'CHAT_UNAUTHORIZED', 401);\n        try {\n            $issuer = new ChatCredentialIssuer($this->db, (array)\\app_config('chat', []), (string)\\app_config('app.env', 'production'));\n            \\json_response(['ok'=>true,'data'=>$issuer->exchangeMini($match[1],$route==='chat.audit.credentials')]);\n        } catch (Throwable $exception) {\n            // Deliberately don't pass the exception/SQL/token to the global API logger.\n            $status = $exception instanceof RuntimeException && in_array($exception->getCode(),[401,403],true) ? $exception->getCode() : 503;\n            $this->fail($status === 401 ? '登录状态已失效，请重新进入' : '聊天身份暂不可用，请稍后重试',\n                $status === 401 ? 'CHAT_UNAUTHORIZED' : ($status===403?'CHAT_FORBIDDEN':'CHAT_DEPENDENCY_UNAVAILABLE'), $status);\n        }\n    }\n    private function fail(string $message, string $code, int $status): void\n    {\n        \\json_response(['ok'=>false,'code'=>$code,'message'=>$message,'request_id'=>\\request_id(),\n            'retryable'=>$status === 503,'server_time'=>gmdate('Y-m-d\\TH:i:s\\Z')], $status);\n    }\n}\n","server/app/Http/Api/Modules/MessagingApiModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Api\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Api\\ApiModule;\nuse WorkerAdmin\\Foundation\\ApplicationContainer;\nuse WorkerAdmin\\Foundation\\MessagingApplicationContainer;\nuse WorkerAdmin\\Application\\Identity\\ApiActorResolver;\nuse WorkerAdmin\\Application\\Messaging\\NotificationInbox;\nuse WorkerAdmin\\Application\\Messaging\\SubscriptionPreferences;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOperationException;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n/** Subscription settings and the signed-in actor's notification inbox. */\nfinal class MessagingApiModule implements ApiModule\n{\n    private const ROUTES = [\n        'announcement.current'=>'GET',\n        'subscriptions.status'=>'GET', 'subscriptions.diagnose'=>'GET', 'subscriptions.preference'=>'POST',\n        'notifications.threads'=>'GET','notifications.thread_messages'=>'GET','notifications.summary'=>'GET', 'notifications.list'=>'GET', 'notifications.read'=>'POST',\n        'notifications.read_batch'=>'POST', 'notifications.read_all'=>'POST',\n    ];\n    private \\WorkerAdmin\\Application\\Messaging\\AnnouncementQuery $announcement;\n    private ApiActorResolver $actors;\n    private NotificationInbox $inbox;\n    private SubscriptionPreferences $subscriptions;\n    public function __construct(Database $db, ?ApiActorResolver $actors=null, ?NotificationInbox $inbox=null, ?SubscriptionPreferences $subscriptions=null)\n    {\n        $container = new MessagingApplicationContainer($db);\n        $this->announcement=new \\WorkerAdmin\\Application\\Messaging\\AnnouncementQuery((new ApplicationContainer($db))->settings());\n        $this->actors = $actors ?: (new ApplicationContainer($db))->apiActorResolver();\n        $this->inbox = $inbox ?: $container->inbox();\n        $this->subscriptions = $subscriptions ?: $container->subscriptions();\n    }\n    public function supports(string $route): bool { return isset(self::ROUTES[$route]); }\n    public function requiresContentSecurity(string $route): bool { return false; }\n    public function dispatch(string $route): void\n    {\n        if (!$this->supports($route)) { $this->fail('接口不存在', 'NOT_FOUND', 404); return; }\n        $header = trim((string)($_SERVER['HTTP_AUTHORIZATION'] ?? ''));\n        if ($header === '' && function_exists('getallheaders')) {\n            $headers = getallheaders();\n            $header = trim((string)($headers['Authorization'] ?? $headers['authorization'] ?? ''));\n        }\n        if (preg_match('/^Bearer\\s+([A-Fa-f0-9]{64})$/', $header, $matches) !== 1) { $this->fail('请重新登录','UNAUTHORIZED',401); return; }\n        try { $actor = $this->actors->resolve($matches[1]); }\n        catch (RuntimeException $exception) {\n            $status = in_array($exception->getCode(), [401,403,503], true) ? (int)$exception->getCode() : 401;\n            $this->fail($exception->getMessage(), $status === 503 ? 'MINIAPP_APPID_MISSING' : 'UNAUTHORIZED', $status);\n            return;\n        }\n        try {\n            // The demo boundary precedes method/body validation, as in the old dispatch.\n            if ($route === 'subscriptions.preference' && !empty($actor['is_demo_actor'])) {\n                $this->subscriptions->save($actor, []);\n            }\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== self::ROUTES[$route]) {\n                $this->fail('请求方式不正确','METHOD_NOT_ALLOWED',405); return;\n            }\n            $raw = self::ROUTES[$route] === 'POST' ? file_get_contents('php://input') : '';\n            // Retain the legacy empty/malformed-body fallback for these existing endpoints.\n            $body = json_decode(is_string($raw) ? $raw : '', true);\n            $body = is_array($body) ? $body : [];\n            if ($route === 'subscriptions.preference') { \\json_response(['ok'=>true] + $this->subscriptions->save($actor, $body)); return; }\n            if ($route === 'announcement.current') $data=$this->announcement->current((string)($_GET['scene']??''));\n            elseif ($route === 'subscriptions.status') $data = $this->subscriptions->status($actor, (string)($_GET['include_application'] ?? '') === '1');\n            elseif ($route === 'subscriptions.diagnose') $data = $this->subscriptions->diagnose($actor);\n            elseif ($route === 'notifications.summary') $data = $this->inbox->summary($actor);\n            elseif ($route === 'notifications.threads') $data=$this->inbox->threads($actor,$this->cursorInput($_GET['cursor']??''));\n            elseif ($route === 'notifications.thread_messages') $data=$this->inbox->threadMessages($actor,(string)($_GET['cursor']??''));\n            elseif ($route === 'notifications.list') $data = $this->inbox->list($actor, (int)($_GET['page'] ?? 1), (string)($_GET['through_id'] ?? ''));\n            elseif ($route === 'notifications.read_batch') $data = $this->inbox->readBatch($actor, is_array($body['ids'] ?? null) ? $body['ids'] : []);\n            elseif ($route === 'notifications.read') {\n                $this->inbox->read($actor, (string)($body['id'] ?? ''));\n                \\json_response(['ok'=>true,'message'=>'已标记为已读']); return;\n            } else {\n                if(array_key_exists('range_cursor',$body))$this->inbox->readRange($actor,$this->cursorInput($body['range_cursor']));\n                else $this->inbox->readAll($actor, (string)($body['through_id'] ?? ''));\n                \\json_response(['ok'=>true,'message'=>'未读消息已清除']); return;\n            }\n            $result = ['ok'=>true,'data'=>$data];\n            if ($route === 'notifications.read_batch') $result['message'] = '消息已标记为已读';\n            \\json_response($result);\n        } catch (MessageOperationException $exception) {\n            $this->fail($exception->getMessage(), $exception->apiCode(), (int)$exception->getCode());\n        } catch (OrderOperationException $exception) {\n            $this->fail($exception->getMessage(), $exception->apiCode(), (int)$exception->getCode());\n        }\n    }\n    private function cursorInput($value): string\n    {\n        if(!is_string($value))throw new MessageOperationException('通知浏览范围无效','NOTIFICATION_RESYNC_REQUIRED',409);\n        return $value;\n    }\n    private function fail(string $message, string $code, int $status): void\n    { \\json_response(['ok'=>false,'code'=>$code,'message'=>$message,'request_id'=>\\request_id()], $status); }\n}\n","server/app/Infrastructure/Chat/ChatRecoveryCheckpoint.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Chat;\n\nuse PDO;\nuse RuntimeException;\n\n/**\n * Compare safety facts after operator-controlled, continuous binlog replay.\n * Never replay messages, enqueue notification, charge wallets or invent missing increments.\n * Capture/verify require stopped chat processes and a separately protected control directory.\n */\nfinal class ChatRecoveryCheckpoint\n{\n    private PDO $db;private string $environment;private string $key;private string $directory;private string $epoch;\n    public function __construct(PDO $db,string $environment,string $key,string $directory,string $epoch)\n    {\n        if(!in_array($environment,['test','development','production'],true)||strlen($key)!==32\n            ||!ChatRecoveryGate::path($directory)||!is_dir($directory)||is_link($directory)||(fileperms($directory)&0027)!==0\n            ||preg_match('/^[a-f0-9]{64}$/D',$epoch)!==1)throw new RuntimeException('CHAT_RECOVERY_CONFIG');\n        $this->db=$db;$this->environment=$environment;$this->key=$key;$this->directory=rtrim($directory,'/\\\\');$this->epoch=$epoch;\n    }\n    public function block(): void\n    {$this->write('gate.json',['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'blocked']);}\n    private function blocked(): void\n    {\n        $m=$this->read('gate.json',1024);\n        if($m!==['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'blocked'])throw new RuntimeException('CHAT_RECOVERY_MAINTENANCE_REQUIRED');\n    }\n    /** Fingerprints only; no message bodies, source identities, media keys or channel payloads leave the DB. */\n    public static function queries(): array\n    {\n        return [\n            'chat_storage_policy'=>'SELECT * FROM chat_storage_policy ORDER BY id',\n            'chat_storage_policy_audit'=>'SELECT * FROM chat_storage_policy_audit ORDER BY id',\n            'chat_storage_applications'=>'SELECT * FROM chat_storage_applications ORDER BY revision',\n            'chat_storage_application_errors'=>'SELECT * FROM chat_storage_application_errors ORDER BY revision,message_id',\n            'chat_av_uploads'=>'SELECT * FROM chat_av_uploads ORDER BY id',\n            'chat_av_parts'=>'SELECT * FROM chat_av_parts ORDER BY upload_id,ordinal',\n            'chat_av_jobs'=>'SELECT * FROM chat_av_jobs ORDER BY intent_id',\n            'chat_av_objects'=>'SELECT * FROM chat_av_objects ORDER BY object_key',\n            'chat_av_items'=>'SELECT * FROM chat_av_items ORDER BY message_id',\n            'chat_av_listens'=>'SELECT * FROM chat_av_listens ORDER BY actor_id,message_id',\n            'chat_av_raw_receipts'=>'SELECT * FROM chat_av_raw_receipts ORDER BY trace_id',\n            'chat_av_asr_requests'=>'SELECT * FROM chat_av_asr_requests ORDER BY intent_id,ordinal',\n            'chat_av_budgets'=>'SELECT * FROM chat_av_budgets ORDER BY actor_id',\n            'chat_policy_guards'=>'SELECT id,order_id,assignment_id,policy_version,SHA2(snapshot_json,256) snapshot_hash FROM chat_policy_guards ORDER BY id',\n            'chat_repair_episodes'=>'SELECT * FROM chat_repair_episodes ORDER BY id',\n            'chat_policy_refresh'=>'SELECT * FROM chat_policy_refresh ORDER BY order_id',\n            'chat_auditor_grant_audit'=>'SELECT * FROM chat_auditor_grant_audit ORDER BY id',\n            'chat_audit_accounts'=>'SELECT * FROM chat_audit_accounts ORDER BY 1',\n            'chat_audit_snapshots'=>'SELECT * FROM chat_audit_snapshots ORDER BY 1',\n            'chat_audit_snapshot_items'=>'SELECT * FROM chat_audit_snapshot_items ORDER BY 1,2',\n            'admin_authority'=>'SELECT id,role,status,must_change_password,SHA2(password_hash,256) password_version FROM admin_users ORDER BY id',\n            'chat_staff_authority_versions'=>'SELECT user_id,authority_version FROM chat_staff_authority_versions ORDER BY user_id',\n            'chat_admin_sessions'=>'SELECT id,session_version,authority_hash,scopes_json,expires_at,revoked_at FROM chat_admin_sessions ORDER BY id',\n            'chat_mini_auditors'=>'SELECT user_id,enabled,authority_version FROM chat_mini_auditors ORDER BY user_id',\n            'login_sessions'=>'SELECT id,user_id,status,expires_at,SHA2(token_hash,256) credential_hash,demo_actor_user_id,test_actor_user_id,test_instance_id,test_actor_expires_at FROM login_sessions ORDER BY id',\n            'users'=>'SELECT id,status FROM users ORDER BY id',\n            'wechat_identities'=>'SELECT id,user_id,SHA2(CONCAT(app_id,CHAR(10),openid),256) identity_hash,status FROM wechat_identities ORDER BY id',\n            'staff_settings'=>\"SELECT setting_key,SHA2(setting_value,256) value_hash FROM system_settings WHERE setting_key IN ('wechat.miniapp_appid','wechat.admin_openids') ORDER BY setting_key\",\n            'chat_business_events'=>'SELECT id,event_id,aggregate_key,aggregate_version,SHA2(payload_json,256) payload_hash FROM chat_business_events ORDER BY id',\n            'chat_event_receipts'=>'SELECT * FROM chat_event_receipts ORDER BY event_id',\n            'chat_conversations'=>'SELECT * FROM chat_conversations ORDER BY id',\n            'chat_members'=>'SELECT * FROM chat_members ORDER BY conversation_id,actor_id',\n            'chat_member_intervals'=>'SELECT * FROM chat_member_intervals ORDER BY conversation_id,actor_id,start_version',\n            'chat_restrictions'=>'SELECT * FROM chat_restrictions ORDER BY actor_id',\n            'chat_messages'=>'SELECT id,conversation_id,seq,sender_id,client_message_id,policy_version,message_type,state,state_version,retention_policy_version,retention_mode,expires_at,SHA2(COALESCE(text_body,\"\"),256) body_hash,reply_to_message_id,edited_from_recalled_message_id,reply_to_item_id,recalled_at FROM chat_messages ORDER BY id',\n            'chat_message_changes'=>'SELECT * FROM chat_message_changes ORDER BY conversation_id,change_seq',\n            'chat_send_intents'=>'SELECT * FROM chat_send_intents ORDER BY id',\n            'chat_member_reads'=>'SELECT * FROM chat_member_reads ORDER BY conversation_id,actor_id',\n            'chat_user_preferences'=>'SELECT * FROM chat_user_preferences ORDER BY actor_id,conversation_id',\n            'chat_preference_accounts'=>'SELECT * FROM chat_preference_accounts ORDER BY actor_id',\n            'chat_risk_events'=>'SELECT id,intent_id,confirmed,review_state,retain_until,SHA2(text_evidence,256) text_hash,SHA2(context_evidence,256) context_hash FROM chat_risk_events ORDER BY id',\n            'chat_cases'=>'SELECT * FROM chat_cases ORDER BY id',\n            'chat_image_uploads'=>'SELECT * FROM chat_image_uploads ORDER BY id',\n            'chat_image_bundles'=>'SELECT * FROM chat_image_bundles ORDER BY intent_id',\n            'chat_image_items'=>'SELECT * FROM chat_image_items ORDER BY message_id,item_id',\n            'chat_image_objects'=>'SELECT * FROM chat_image_objects ORDER BY object_key',\n            'chat_image_reports'=>'SELECT * FROM chat_image_reports ORDER BY id',\n            'chat_image_audit'=>'SELECT * FROM chat_image_audit ORDER BY id',\n            'chat_governance_audit'=>'SELECT * FROM chat_governance_audit ORDER BY id',\n            'chat_reminder_events'=>'SELECT * FROM chat_reminder_events ORDER BY id',\n            'chat_reminder_clusters'=>'SELECT * FROM chat_reminder_clusters ORDER BY id',\n            'chat_reminder_budgets'=>'SELECT * FROM chat_reminder_budgets ORDER BY recipient_id',\n            'chat_reminder_intents'=>'SELECT * FROM chat_reminder_intents ORDER BY id',\n            'chat_reminder_receipts'=>'SELECT * FROM chat_reminder_receipts ORDER BY operation_id',\n            'chat_reminder_outbox'=>\"SELECT id,status,attempt_count,next_attempt_at,processed_at,SHA2(payload_json,256) payload_hash FROM message_outbox WHERE topic='chat_reminder' ORDER BY id\",\n        ];\n    }\n    public function facts(): array\n    {\n        if($this->db->inTransaction())throw new RuntimeException('CHAT_RECOVERY_TRANSACTION');\n        $this->db->exec('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ');\n        $this->db->beginTransaction();\n        try{\n            $result=[];\n            foreach(self::queries() as $name=>$query){\n                // PDO unbuffered scan, one row in memory. JSON numeric values are\n                // normalized to strings for driver/PHP patch-version stability.\n                $this->db->setAttribute(PDO::MYSQL_ATTR_USE_BUFFERED_QUERY,false);\n                $rows=$this->db->query($query);$hash=hash_init('sha256');$count=0;\n                while($row=$rows->fetch(PDO::FETCH_ASSOC)){\n                    foreach($row as &$value)if($value!==null)$value=(string)$value;unset($value);\n                    hash_update($hash,json_encode($row,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR).\"\\n\");$count++;\n                }\n                $rows->closeCursor();\n                $result[$name]=['count'=>$count,'sha256'=>hash_final($hash)];\n            }\n            $this->db->commit();return$result;\n        }catch(\\Throwable $e){if($this->db->inTransaction())$this->db->rollBack();throw new RuntimeException('CHAT_RECOVERY_FACTS_UNAVAILABLE');}\n        finally{$this->db->setAttribute(PDO::MYSQL_ATTR_USE_BUFFERED_QUERY,true);}\n    }\n    private function coordinate(): array\n    {\n        $row=$this->db->query('SHOW MASTER STATUS')->fetch(PDO::FETCH_ASSOC);\n        $uuid=(string)$this->db->query('SELECT @@server_uuid')->fetchColumn();\n        if(!$row||!isset($row['File'],$row['Position'])||$uuid==='')throw new RuntimeException('CHAT_RECOVERY_BINLOG_REQUIRED');\n        return ['server_uuid'=>$uuid,'file'=>(string)$row['File'],'position'=>(string)$row['Position']];\n    }\n    public function capture(): array\n    {\n        $this->blocked();$before=$this->coordinate();$facts=$this->facts();$after=$this->coordinate();\n        if($before!==$after)throw new RuntimeException('CHAT_RECOVERY_SOURCE_NOT_QUIESCENT');\n        $payload=['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,\n            'captured_at'=>gmdate('Y-m-d\\\\TH:i:s\\\\Z'),'watermark'=>$after,'facts'=>$facts];\n        $json=self::encode($payload);$sealed=['payload'=>$payload,'mac'=>hash_hmac('sha256',$json,$this->key)];\n        $this->write('checkpoint.json',$sealed);\n        // Latest anchor is independent of backup/restore. Never accept any older signed file.\n        $this->write('latest.json',['sha256'=>hash('sha256',self::encode($sealed)),'watermark'=>$after,'epoch'=>$this->epoch]);\n        return ['status'=>'captured','tables'=>count($facts),'watermark'=>$after];\n    }\n    public function verify(bool $release=false): array\n    {\n        $this->blocked();$sealed=$this->read('checkpoint.json',65536);$latest=$this->read('latest.json',4096);\n        $p=$sealed['payload']??null;$mac=$sealed['mac']??'';\n        if(!is_array($p)||!is_string($mac)||!hash_equals(hash_hmac('sha256',self::encode($p),$this->key),$mac)\n            ||($p['schema']??0)!==1||($p['environment']??'')!==$this->environment||($p['epoch']??'')!==$this->epoch\n            ||($latest['epoch']??'')!==$this->epoch||($latest['watermark']??null)!==($p['watermark']??null)\n            ||!hash_equals((string)($latest['sha256']??''),hash('sha256',self::encode($sealed))))throw new RuntimeException('CHAT_RECOVERY_CHECKPOINT_INVALID');\n        $current=$this->facts();$missing=[];\n        if(array_keys((array)($p['facts']??[]))!==array_keys($current))throw new RuntimeException('CHAT_RECOVERY_CONTRACT_CHANGED');\n        foreach($current as $table=>$fact)if($fact!==$p['facts'][$table])$missing[]=$table;\n        if($missing)return['status'=>'blocked','mismatched_tables'=>$missing,'notification_replayed'=>false];\n        if($release){\n            $continuity=$this->read('continuity.json',8192);$proof=$continuity['payload']??null;\n            if(!is_array($proof)||($proof['schema']??0)!==1||($proof['environment']??'')!==$this->environment\n                ||($proof['epoch']??'')!==$this->epoch||($proof['watermark']??null)!==$p['watermark']\n                ||($proof['complete']??false)!==true\n                ||!hash_equals(hash_hmac('sha256',self::encode($proof),$this->key),(string)($continuity['mac']??'')))throw new RuntimeException('CHAT_RECOVERY_INCREMENT_GAP');\n        }\n        if($release)$this->write('gate.json',['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'ready']);\n        return['status'=>$release?'ready':'verified','tables'=>count($current),'notification_replayed'=>false];\n    }\n    /** Explicit maintenance-account purge; normal Go audit grants remain INSERT/SELECT only. */\n    public function pruneAudit(): array\n    {\n        $this->blocked();\n        $progress=is_file($this->directory.'/audit-progress.json')?$this->read('audit-progress.json',4096):[];\n        $rules=[\n            'chat_governance_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.retain_until>UTC_TIMESTAMP(6) AND (c.conversation_id=chat_governance_audit.conversation_id OR c.subject_id=chat_governance_audit.actor_id OR c.reporter_id=chat_governance_audit.actor_id))\",\n            'chat_image_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_send_intents i ON i.id=chat_image_audit.intent_id WHERE c.retain_until>UTC_TIMESTAMP(6) AND ((c.target_type='image_intent' AND c.target_id=i.id) OR (c.target_type='message' AND c.target_id=i.message_id)))\",\n            'chat_auditor_grant_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.retain_until>UTC_TIMESTAMP(6) AND (c.subject_id=chat_auditor_grant_audit.user_id OR c.reporter_id=chat_auditor_grant_audit.user_id))\",\n        ];\n        $counts=[];\n        $this->journal(['action'=>'audit.prune.begin','epoch'=>$this->epoch,'days'=>365,'at'=>gmdate('c')]);\n        foreach($rules as $table=>$hold){\n            $after=(string)($progress[$table]??'0');\n            if(preg_match('/^[0-9]{1,20}$/D',$after)!==1)throw new RuntimeException('CHAT_AUDIT_CURSOR');\n            $stmt=$this->db->prepare('SELECT id FROM '.$table.' WHERE id>? ORDER BY id LIMIT 100');$stmt->execute([$after]);\n            $ids=$stmt->fetchAll(PDO::FETCH_COLUMN);$removed=0;\n            foreach($ids as $id){\n                $delete=$this->db->prepare('DELETE FROM '.$table.' WHERE id=? AND created_at<UTC_TIMESTAMP(6)-INTERVAL 365 DAY AND '.$hold);\n                $delete->execute([(string)$id]);$removed+=$delete->rowCount();\n            }\n            $progress[$table]=count($ids)<100?'0':(string)end($ids);\n            $counts[$table]=['scanned'=>count($ids),'deleted'=>$removed,'next_after'=>$progress[$table]];\n        }\n        $this->write('audit-progress.json',$progress);\n        $this->journal(['action'=>'audit.prune.complete','epoch'=>$this->epoch,'counts'=>$counts,'at'=>gmdate('c')]);\n        return ['status'=>'maintenance_blocked','audit'=>$counts,'recapture_required'=>true];\n    }\n    private function journal(array $v): void\n    {\n        $file=$this->directory.'/maintenance.jsonl';\n        if(is_link($file))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        $h=fopen($file,'ab');if(!$h)throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        try{\n            if(!chmod($file,0640)||!flock($h,LOCK_EX))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n            $raw=self::encode($v).\"\\n\";\n            if(fwrite($h,$raw)!==strlen($raw)||!fflush($h)||!fsync($h))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        }finally{flock($h,LOCK_UN);fclose($h);}\n        $this->syncDirectory();\n    }\n    private function read(string $file,int $limit): array\n    {\n        $path=$this->directory.'/'.$file;\n        if(!is_file($path)||is_link($path)||filesize($path)>$limit||(fileperms($path)&0022)!==0)throw new RuntimeException('CHAT_RECOVERY_FILE_INVALID');\n        $raw=file_get_contents($path);$v=is_string($raw)?json_decode($raw,true):null;\n        if(!is_array($v))throw new RuntimeException('CHAT_RECOVERY_FILE_INVALID');return$v;\n    }\n    private function write(string $name,array $value): void\n    {\n        $path=$this->directory.'/'.$name;$temporary=$path.'.'.bin2hex(random_bytes(8));\n        $handle=fopen($temporary,'x');if(!$handle)throw new RuntimeException('CHAT_RECOVERY_WRITE');\n        try{$raw=self::encode($value);if(!chmod($temporary,0640)||fwrite($handle,$raw)!==strlen($raw)||!fflush($handle)||!fsync($handle))throw new RuntimeException('CHAT_RECOVERY_WRITE');}\n        finally{fclose($handle);}\n        if(!rename($temporary,$path)){unlink($temporary);throw new RuntimeException('CHAT_RECOVERY_WRITE');}\n        $this->syncDirectory();\n    }\n    private function syncDirectory(): void\n    {\n        $handle=fopen($this->directory,'r');\n        if(!$handle)throw new RuntimeException('CHAT_RECOVERY_DURABILITY');\n        try{if(!fsync($handle))throw new RuntimeException('CHAT_RECOVERY_DURABILITY');}finally{fclose($handle);}\n    }\n    private static function encode(array $v): string{return(string)json_encode($v,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR);}\n}\n","server/app/Infrastructure/Chat/ChatRecoveryGate.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Chat;\n\nuse RuntimeException;\n\n/** Independent control marker; never stored inside a DB backup or release tree. */\nfinal class ChatRecoveryGate\n{\n    public static function ready(array $config,string $environment): bool\n    {\n        $path=(string)($config['recovery_gate_file']??'');$epoch=(string)($config['recovery_epoch']??'');\n        if($path===''&&$epoch==='')return in_array($environment,['test','development'],true);\n        if(!self::path($path)||preg_match('/^[a-f0-9]{64}$/D',$epoch)!==1||!is_file($path)||is_link($path)||filesize($path)>1024||(fileperms($path)&0022)!==0)return false;\n        $raw=file_get_contents($path);if(!is_string($raw))return false;\n        $m=json_decode($raw,true);\n        if(!is_array($m)||array_keys($m)!==['schema','environment','epoch','state'])return false;\n        if(json_encode($m,JSON_UNESCAPED_SLASHES)!==preg_replace('/\\s+(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/','',$raw))return false;\n        return$m===['schema'=>1,'environment'=>$environment,'epoch'=>$epoch,'state'=>'ready'];\n    }\n    public static function assertReady(array $config,string $environment): void\n    {if(!self::ready($config,$environment))throw new RuntimeException('聊天安全恢复尚未核验',503);}\n    public static function path(string $path): bool\n    {return$path!==''&&($path[0]==='/'||preg_match('/^[A-Za-z]:[\\\\\\\\\\/]/D',$path)===1)&&strpos($path,\"\\0\")===false;}\n}\n","server/app/Infrastructure/External/WeChatAccessTokenProvider.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\External;\n\nuse RuntimeException;\nuse Throwable;\n\n/** One cross-process refresh coordinator for every PHP caller; Go never owns AppSecret. */\nfinal class WeChatAccessTokenProvider\n{\n    private string $environment;\n    private string $appId;\n    private string $secret;\n    private string $directory;\n    private ?string $exportDirectory;\n    private $request;\n    private ?string $rejectionDirectory;\n\n    public function __construct(string $environment,string $appId,#[\\SensitiveParameter] string $secret,string $directory,?string $exportDirectory=null,?callable $request=null,?string $rejectionDirectory=null)\n    {\n        if(!in_array($environment,['production','development','test'],true)||preg_match('/^[A-Za-z0-9_-]{1,64}$/D',$appId)!==1||$secret==='')throw new RuntimeException('微信统一凭证配置不可用');\n        $this->environment=$environment;$this->appId=$appId;$this->secret=$secret;\n        $this->directory=$directory;$this->exportDirectory=$exportDirectory;$this->request=$request;$this->rejectionDirectory=$rejectionDirectory;\n    }\n\n    public static function fromSettings(): self\n    {\n        $env=(string)\\app_config('app.env','production');if($env==='testing')$env='test';\n        return new self($env,trim((string)\\setting('wechat.miniapp_appid','')),trim((string)\\setting('wechat.miniapp_secret','')),\n            \\base_path('storage/private/wechat-tokens'),\\app_config('chat.safety_credential_export_enabled',false)===true?\\base_path('storage/private/chat-credentials'):null,null,\\app_config('chat.safety_rejection_directory','')?:null);\n    }\n\n    public function get(): string\n    {\n        $this->ensureDirectory($this->directory,0700);\n        $cached=$this->read();\n        $this->consumeRejection($cached);$cached=$this->read();\n        if($this->valid($cached,300)&&$this->exportMatches($cached)){ return $cached['token']; }\n        $lock=$this->lock($cached);\n        if($lock===null){ return $cached['token']; }\n        try{\n            $cached=$this->read();\n            if($this->valid($cached,300)){ $this->export($cached);return $cached['token']; }\n            if(!$this->valid($cached,5))$this->revokeExport();\n            $started=time();\n            try{\n                $response=$this->request!==null?($this->request)($this->appId,$this->secret):$this->requestToken();\n                if(!is_array($response)||isset($response['errcode'])&&$response['errcode']!==0\n                    ||!is_string($response['access_token']??null)||preg_match('/^[A-Za-z0-9_-]{10,2048}$/D',$response['access_token'])!==1\n                    ||!is_int($response['expires_in']??null)||$response['expires_in']<1||$response['expires_in']>7200)throw new RuntimeException('微信统一凭证响应不可用');\n                // Never extend a provider TTL with max(600, expires_in).\n                $next=['schema_version'=>1,'env'=>$this->environment,'app_id'=>$this->appId,'token'=>$response['access_token'],\n                    'issued_at'=>$started,'expires_at'=>$started+$response['expires_in'],'credential_hash'=>$this->credentialHash()];\n                if(!$this->valid($next,5))throw new RuntimeException('微信统一凭证剩余有效期不足');\n                $this->write($this->cachePath(),$next,0600);\n                $this->export($next);\n                return $next['token'];\n            }catch(Throwable $error){\n                // A failed refresh does not invent a new expiry or discard a\n                // still-valid credential. Rejected/rotated credentials fail this.\n                if($this->valid($cached,5)){ $this->export($cached);return $cached['token']; }\n                throw new RuntimeException('微信统一凭证暂不可用');\n            }\n        }finally{flock($lock,LOCK_UN);fclose($lock);}\n    }\n\n    /** Only invalidate the exact generation actually rejected by a caller. */\n    public function rejectGeneration(string $generation): bool\n    {\n        if(preg_match('/^[a-f0-9]{64}$/D',$generation)!==1)return false;\n        $this->ensureDirectory($this->directory,0700);$lock=$this->lock(null);\n        try{\n            $cached=$this->read();\n            if(!is_array($cached)||!hash_equals($this->generation($cached['token']),$generation))return false;\n            if(is_file($this->cachePath())&&!unlink($this->cachePath()))throw new RuntimeException('微信统一凭证撤销失败');\n            if($this->exportDirectory!==null){$this->revokeExport();}\n            return true;\n        }finally{flock($lock,LOCK_UN);fclose($lock);}\n    }\n    public function reject(#[\\SensitiveParameter] string $usedToken): bool\n    {\n        return $usedToken!==''&&$this->rejectGeneration($this->generation($usedToken));\n    }\n    public function generation(#[\\SensitiveParameter] string $token): string {return hash('sha256',$this->environment.\"\\n\".$this->appId.\"\\n\".$token);}\n    public function exportPath(): string\n    {\n        if($this->exportDirectory===null)throw new RuntimeException('聊天凭证导出未启用');\n        return $this->exportDirectory.DIRECTORY_SEPARATOR.$this->environment.'-'.hash('sha256',$this->appId).'.json';\n    }\n    /** Read-only preflight, including permissions and exact current configuration. */\n    public function metadata(): array\n    {\n        $cached=$this->read();\n        if(!$this->valid($cached,5)||!$this->exportMatches($cached))throw new RuntimeException('微信聊天导出凭证不可用');\n        return ['status'=>'ready','credential_file'=>$this->exportPath(),'env'=>$this->environment,'generation'=>$this->generation($cached['token']),'expires_at'=>$cached['expires_at']];\n    }\n    private function consumeRejection(?array $cached): void\n    {\n        if($this->rejectionDirectory===null||$cached===null)return;\n        $dir=$this->rejectionDirectory;\n        if($dir===''||$dir[0]!=='/'||is_link($dir)||!is_dir($dir)||(fileperms($dir)&0007)!==0)throw new RuntimeException('聊天凭证拒绝目录不可用');\n        $generation=$this->generation($cached['token']);\n        $path=$dir.'/'.$this->environment.'-'.hash('sha256',$this->appId).'-'.$generation.'.json';\n        clearstatcache(true,$path);\n        if(!is_file($path))return;\n        if(is_link($path)||filesize($path)>512||(fileperms($path)&0027)!==0)throw new RuntimeException('聊天凭证拒绝提示不可用');\n        $hint=json_decode((string)file_get_contents($path),true);\n        if(!is_array($hint)||($hint['schema_version']??null)!==1||($hint['env']??null)!==$this->environment||($hint['app_id']??null)!==$this->appId||($hint['generation']??null)!==$generation)throw new RuntimeException('聊天凭证拒绝提示不可用');\n        // rejectGeneration locks and compares again: an old hint cannot erase a\n        // new token installed by another PHP process while we were reading.\n        $this->rejectGeneration($generation);\n        @unlink($path);\n    }\n    private function credentialHash(): string {return hash('sha256',$this->environment.\"\\n\".$this->appId.\"\\n\".$this->secret);}\n    private function cachePath(): string {return $this->directory.DIRECTORY_SEPARATOR.hash('sha256',$this->environment.\"\\n\".$this->appId).'.json';}\n    private function read(): ?array\n    {\n        $path=$this->cachePath();clearstatcache(true,$path);\n        if(is_link($path)||!is_file($path)||filesize($path)>4096)return null;\n        $data=json_decode((string)@file_get_contents($path),true);\n        return $this->valid($data,0)?$data:null;\n    }\n    private function valid(#[\\SensitiveParameter] $data,int $margin): bool\n    {\n        return is_array($data)&&($data['schema_version']??null)===1&&($data['env']??null)===$this->environment&&($data['app_id']??null)===$this->appId\n            &&is_string($data['token']??null)&&preg_match('/^[A-Za-z0-9_-]{10,2048}$/D',$data['token'])===1\n            &&is_int($data['issued_at']??null)&&$data['issued_at']<=time()+5&&is_int($data['expires_at']??null)&&$data['expires_at']>time()+$margin\n            &&$data['expires_at']>$data['issued_at']&&$data['expires_at']-$data['issued_at']<=7200\n            &&is_string($data['credential_hash']??null)&&hash_equals($this->credentialHash(),$data['credential_hash']);\n    }\n    private function lock(#[\\SensitiveParameter] ?array $fallback)\n    {\n        $path=$this->cachePath().'.lock';if(is_link($path))throw new RuntimeException('微信统一凭证锁不可用');\n        $handle=@fopen($path,'c+');if($handle===false)throw new RuntimeException('微信统一凭证锁不可用');@chmod($path,0600);\n        $until=microtime(true)+1.0;\n        do{\n            if(flock($handle,LOCK_EX|LOCK_NB))return $handle;\n            if($this->valid($fallback,5)){fclose($handle);return null;}\n            usleep(20000);\n        }while(microtime(true)<$until);\n        fclose($handle);throw new RuntimeException('微信统一凭证刷新繁忙');\n    }\n    private function revokeExport(): void\n    {\n        if($this->exportDirectory===null)return;\n        $this->ensureDirectory($this->exportDirectory,0750);\n        $this->write($this->exportPath(),['schema_version'=>1,'env'=>$this->environment,'app_id'=>$this->appId,'token'=>'','issued_at'=>time(),'expires_at'=>0,'generation'=>''],0640);\n    }\n    private function exportMatches(#[\\SensitiveParameter] array $cached): bool\n    {\n        if($this->exportDirectory===null)return true;\n        $file=$this->exportPath();if(is_link($file)||!is_file($file)||filesize($file)>4096||(fileperms($file)&0027)!==0||(fileperms(dirname($file))&0022)!==0)return false;\n        $data=json_decode((string)@file_get_contents($file),true);\n        return is_array($data)&&($data['schema_version']??null)===1&&($data['env']??null)===$this->environment&&($data['app_id']??null)===$this->appId&&($data['token']??null)===$cached['token']&&($data['issued_at']??null)===$cached['issued_at']&&($data['generation']??'')===$this->generation($cached['token'])&&($data['expires_at']??0)===$cached['expires_at'];\n    }\n    private function export(#[\\SensitiveParameter] array $cached): void\n    {\n        if($this->exportDirectory===null)return;\n        $this->ensureDirectory($this->exportDirectory,0750);\n        $data=['schema_version'=>1,'env'=>$this->environment,'app_id'=>$this->appId,'token'=>$cached['token'],\n            'issued_at'=>$cached['issued_at'],'expires_at'=>$cached['expires_at'],'generation'=>$this->generation($cached['token'])];\n        $this->write($this->exportPath(),$data,0640);\n    }\n    private function ensureDirectory(string $directory,int $mode): void\n    {\n        if(is_link($directory)||!is_dir($directory)&&!@mkdir($directory,$mode,true)&&!is_dir($directory))throw new RuntimeException('微信统一凭证目录不可用');\n        clearstatcache(true,$directory);$permissions=fileperms($directory);\n        if($permissions===false||($permissions&0022)!==0)throw new RuntimeException('微信统一凭证目录权限过宽');\n    }\n    private function write(string $path,#[\\SensitiveParameter] array $data,int $mode): void\n    {\n        if(is_link($path))throw new RuntimeException('微信统一凭证文件不可用');\n        $temporary=dirname($path).DIRECTORY_SEPARATOR.'.token-'.bin2hex(random_bytes(8));\n        $handle=@fopen($temporary,'x');if($handle===false)throw new RuntimeException('微信统一凭证保存失败');\n        try{\n            if(!chmod($temporary,$mode))throw new RuntimeException('微信统一凭证权限设置失败');\n            $json=json_encode($data,JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);\n            if(fwrite($handle,$json)!==strlen($json)||!fflush($handle))throw new RuntimeException('微信统一凭证保存失败');\n            fclose($handle);$handle=null;\n            if(!rename($temporary,$path))throw new RuntimeException('微信统一凭证保存失败');\n        }finally{if(is_resource($handle))fclose($handle);if(is_file($temporary))@unlink($temporary);}\n    }\n    private function requestToken(): array\n    {\n        if(!function_exists('curl_init'))throw new RuntimeException('微信统一凭证需要cURL');\n        $url='https://api.weixin.qq.com/cgi-bin/token?'.http_build_query(['grant_type'=>'client_credential','appid'=>$this->appId,'secret'=>$this->secret]);\n        $curl=curl_init($url);if($curl===false)throw new RuntimeException('微信统一凭证暂不可用');$raw='';\n        curl_setopt_array($curl,[CURLOPT_CONNECTTIMEOUT=>3,CURLOPT_TIMEOUT=>8,CURLOPT_SSL_VERIFYPEER=>true,CURLOPT_SSL_VERIFYHOST=>2,CURLOPT_FOLLOWLOCATION=>false,\n            CURLOPT_WRITEFUNCTION=>static function($handle,string $chunk)use(&$raw):int{if(strlen($raw)+strlen($chunk)>4096)return 0;$raw.=$chunk;return strlen($chunk);}]);\n        $ok=curl_exec($curl);$status=(int)curl_getinfo($curl,CURLINFO_HTTP_CODE);curl_close($curl);\n        if($ok===false||$status!==200)throw new RuntimeException('微信统一凭证暂不可用');\n        $data=json_decode($raw,true);if(!is_array($data))throw new RuntimeException('微信统一凭证响应不可用');return $data;\n    }\n}\n\n","server/app/Infrastructure/Messaging/ChatInternalAuth.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n/** Internal shared key is independent of access-token signing and channel keys. */\nfinal class ChatInternalAuth\n{\n    private Database $db; private string $env; private string $kid; private string $key;\n    public function __construct(Database $db,string $env,string $kid,string $key)\n    {\n        if (!in_array($env,['production','development','test'],true) || preg_match('/^[a-z0-9_-]{1,32}$/D',$kid)!==1 || strlen($key)!==32) throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $this->db=$db;$this->env=$env;$this->kid=$kid;$this->key=$key;\n    }\n    public static function configured(Database $db):self\n    {\n        $env=['testing'=>'test','development'=>'development','production'=>'production'][(string)\\app_config('app.env','')]??'';\n        $name=(string)\\app_config('chat.internal_key_env','');\n        if(preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D',$name)!==1)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $encoded=getenv($name);$key=is_string($encoded)?base64_decode($encoded,true):false;\n        if(!is_string($key)||base64_encode($key)!==$encoded)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        return new self($db,$env,(string)\\app_config('chat.internal_key_id',''),$key);\n    }\n    private function canonical(string $uri,string $body,string $stamp,string $nonce):string\n    {return implode(\"\\n\",['chat-internal-v1','POST',$uri,hash('sha256',$body),$stamp,$nonce,$this->env,$this->kid]);}\n    public function sign(string $uri,string $body):array\n    {\n        $stamp=(string)time();$nonce=bin2hex(random_bytes(32));\n        return ['X-Chat-Environment: '.$this->env,'X-Chat-Key-ID: '.$this->kid,'X-Chat-Timestamp: '.$stamp,'X-Chat-Nonce: '.$nonce,\n            'X-Chat-Signature: '.hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key)];\n    }\n    public function verify(string $uri,string $body,array $headers):void\n    {\n        if($uri!=='/chat-internal.php'||strlen($body)>8192)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $get=static fn(string $key):string=>(string)($headers[$key]??'');\n        $stamp=$get('timestamp');$nonce=$get('nonce');$signature=$get('signature');\n        if($get('environment')!==$this->env||$get('key-id')!==$this->kid||preg_match('/^[1-9][0-9]{9}$/D',$stamp)!==1||abs(time()-(int)$stamp)>30\n            ||preg_match('/^[a-f0-9]{64}$/D',$nonce)!==1||preg_match('/^[a-f0-9]{64}$/D',$signature)!==1\n            ||!hash_equals(hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key),$signature))throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $insert=$this->db->execute('INSERT IGNORE INTO chat_internal_nonces(nonce_hash,expires_at) VALUES(:hash,UTC_TIMESTAMP()+INTERVAL 61 SECOND)',['hash'=>hash('sha256',$this->kid.':'.$nonce)]);\n        if($insert!==1)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n    }\n    public function eligible(string $operation):bool\n    {\n        $origin=rtrim((string)\\app_config('chat.internal_go_origin',''),'/');$url=parse_url($origin);\n        if(!$url||($url['scheme']??'')!=='https'||empty($url['host'])||isset($url['user'])||isset($url['pass'])||isset($url['query'])||isset($url['fragment'])||!empty($url['path']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $uri='/chat/internal/v1/reminders/eligible';$body=json_encode(['operation_id'=>$operation],JSON_THROW_ON_ERROR);\n        $response='';$ch=curl_init($origin.$uri);curl_setopt_array($ch,[CURLOPT_POST=>true,CURLOPT_POSTFIELDS=>$body,CURLOPT_HTTPHEADER=>array_merge(['Content-Type: application/json'],$this->sign($uri,$body)),CURLOPT_RETURNTRANSFER=>false,CURLOPT_WRITEFUNCTION=>static function($handle,string $chunk)use(&$response):int{if(strlen($response)+strlen($chunk)>1024)return 0;$response.=$chunk;return strlen($chunk);},CURLOPT_CONNECTTIMEOUT_MS=>1000,CURLOPT_TIMEOUT_MS=>3000,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_PROTOCOLS=>CURLPROTO_HTTPS]);\n        $ok=curl_exec($ch);$raw=$ok===false?false:$response;$status=(int)curl_getinfo($ch,CURLINFO_RESPONSE_CODE);curl_close($ch);\n        if($status!==200||!is_string($raw)||strlen($raw)>1024)throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $result=json_decode($raw,true);if(!is_array($result)||!isset($result['eligible'])||!is_bool($result['eligible']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');return $result['eligible'];\n    }\n}\n","server/app/Infrastructure/Messaging/ChatReminderTemplate.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\nfinal class ChatReminderTemplate\n{\n    public static function build(Database $db,array $q):array\n    {\n        $scene=SubscriptionCatalog::subscriptionSceneDefinitions()['chat_unread']??[];\n        if(empty($scene['available']))return ['diagnostic'=>'template_unavailable'];\n        $recipient=(string)$q['recipient_id'];\n        // Existing PHP channel/quota ports take signed integers. Reject an\n        // unrepresentable unsigned ID instead of sending to a saturated ID.\n        $maximum=(string)PHP_INT_MAX;\n        if(strlen($recipient)>strlen($maximum)||(strlen($recipient)===strlen($maximum)&&strcmp($recipient,$maximum)>0))return ['diagnostic'=>'recipient_id_unsupported'];\n        $uid=(int)$recipient;$pref=SubscriptionQuotaStore::subscriptionPreferences($db,$uid)['chat_unread']??[];\n        $type=(string)($scene['subscription_type']??'one_time');\n        if(in_array((string)($pref['authorization_status']??''),['ban','disabled'],true)\n            ||($type==='one_time'&&max(0,(int)($pref['remaining_count']??0))<1)\n            ||($type!=='one_time'&&(empty($pref['enabled'])||!in_array($pref['authorization_status']??'',['accept','acceptWithAudio','acceptWithAlert'],true))))return ['diagnostic'=>'subscription_unavailable'];\n        // Subscription grants belong to an AppID/template pair, not just a user.\n        if((string)($pref['template_id']??'')!==(string)$scene['template_id'])return ['diagnostic'=>'subscription_template_changed'];\n        $appId=trim((string)\\setting('wechat.miniapp_appid',''));\n        if($appId==='')return ['diagnostic'=>'appid_missing'];\n        $identities=$db->fetchAll(\"SELECT openid FROM wechat_identities WHERE user_id=:id AND app_id=:app AND status='active' ORDER BY id LIMIT 2\",['id'=>$uid,'app'=>$appId]);\n        if(count($identities)!==1||trim((string)$identities[0]['openid'])==='')return ['diagnostic'=>'openid_missing_or_ambiguous'];\n        $openid=(string)$identities[0]['openid'];\n        $values=['status'=>'您有未读的订单聊天消息','time'=>date('Y-m-d H:i')];$data=[];\n        foreach((array)$scene['field_map'] as $semantic=>$key){\n            if(!isset($values[$semantic]))return ['diagnostic'=>'template_data_invalid'];\n            $value=WechatTemplateValue::format((string)$key,$values[$semantic]);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $key=>$fixed){\n            if(isset($data[$key]))continue;$value=WechatTemplateValue::format((string)$key,(string)$fixed);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['template_fields']??[]) as $key)if(!isset($data[$key]))return ['diagnostic'=>'template_data_missing'];\n        if(!$data)return ['diagnostic'=>'template_data_missing'];\n        return ['payload'=>['user_id'=>$uid,'scene_key'=>'chat_unread','openid'=>$openid,'template_id'=>(string)$scene['template_id'],\n            'page'=>'subpackages/chat/conversation/index?conversation_id='.rawurlencode($q['conversation_id']),'data'=>$data]];\n    }\n}\n\n","server/app/Infrastructure/Messaging/DatabaseNotificationProducer.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\NotificationProducer;\n\nfinal class DatabaseNotificationProducer implements NotificationProducer\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db=$db; }\n    public function queue(int $orderId,string $key,string $type,array $payload=[]):void { OrderNotificationProjector::queue($this->db,$orderId,$key,$type,$payload); }\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void { OrderNotificationProjector::queueAdminTask($this->db,$key,$type,$title,$lines); }\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void { OrderNotificationProjector::queueWorkerWithdrawalResult($this->db,$workerId,$no,$status,$note,$amount); }\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void { OrderNotificationProjector::queueWorkerReviewResult($this->db,$workerId,$cloudId,$decision,$reason,$name); }\n}\n","server/app/Infrastructure/Messaging/DatabaseSubscriptionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\SubscriptionRepository;\n\n\nfinal class DatabaseSubscriptionRepository implements SubscriptionRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function definitions(): array { return SubscriptionCatalog::subscriptionSceneDefinitions(); }\n    public function preferences(int $userId): array { return SubscriptionQuotaStore::subscriptionPreferences($this->db, $userId); }\n    public function save(int $userId, string $key, bool $enabled, string $status): array\n    { return SubscriptionQuotaStore::saveSubscriptionPreference($this->db, $userId, $key, $enabled, $status); }\n    public function diagnose(int $userId): array\n    {\n        $where=\"topic='wechat_subscribe' AND JSON_VALID(payload_json) AND CAST(JSON_UNQUOTE(JSON_EXTRACT(payload_json,'$.user_id')) AS UNSIGNED)=:user_id\";\n        $pending=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE \".$where.\" AND status IN ('pending','processing')\",['user_id'=>$userId]);\n        $processed24h=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE \".$where.\" AND status='processed' AND processed_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 DAY)\",['user_id'=>$userId]);\n        $failed24h=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE \".$where.\" AND status='failed' AND created_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 DAY)\",['user_id'=>$userId]);\n        $lastError=(string)($this->db->fetchValue(\"SELECT last_error FROM message_outbox WHERE \".$where.\" AND status='failed' AND last_error IS NOT NULL ORDER BY id DESC LIMIT 1\",['user_id'=>$userId])?:'');\n        $lastErrorCode='';\n        if($lastError!==''&&preg_match('/微信订阅消息发送失败（(\\d+)）/u',$lastError,$match)===1)$lastErrorCode=(string)($match[1]??'');\n        $dispatcherRecent=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM scheduler_runs WHERE job_name='sms_dispatch' AND started_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 10 MINUTE)\")>0;\n        $dispatcherLast=$this->db->fetch(\"SELECT status,started_at,finished_at,failure_count FROM scheduler_runs WHERE job_name='sms_dispatch' ORDER BY id DESC LIMIT 1\");\n        $dispatcherHealthy=$dispatcherRecent&&((string)($dispatcherLast['status']??'')==='success');\n        return [\n            'subscribe_enabled'=>filter_var(\\setting('wechat.subscribe_enabled',true),FILTER_VALIDATE_BOOLEAN),\n            'appid_configured'=>trim((string)\\setting('wechat.miniapp_appid',''))!=='',\n            'secret_configured'=>trim((string)\\setting('wechat.miniapp_secret',''))!=='',\n            'env_version'=>(string)\\setting('wechat.miniapp_env_version','formal'),\n            'dispatcher_recent'=>$dispatcherRecent,\n            'dispatcher_healthy'=>$dispatcherHealthy,\n            'dispatcher_last_status'=>(string)($dispatcherLast['status']??''),\n            'dispatcher_last_at'=>(string)($dispatcherLast['started_at']??''),\n            'pending_count'=>$pending,\n            'processed_24h'=>$processed24h,\n            'failed_24h'=>$failed24h,\n            'last_failure_code'=>$lastErrorCode,\n        ];\n\n    }\n}\n","server/app/Infrastructure/Messaging/OrderNotificationProjector.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\OrderMessageDefinition;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\nuse WorkerAdmin\\Infrastructure\\Testing\\TestMessageProjectionRecorder;\n\nfinal class OrderNotificationProjector\n{\n\n    public static function queueAdminTask(Database $db,string $eventKey,string $eventType,string $title,array $lines=[]):void\n    {\n        // 与订单事件的 demo 隔离保持一致：带订单号的演示/测试订单绝不能进入真实企业微信管理员待办。\n        // 无订单号的入驻、提现等独立业务仍沿用原有通知逻辑。\n        $orderNo=trim((string)($lines['订单号']??''));\n        if($orderNo!==''){\n            $isDemo=(int)$db->fetchValue('SELECT COALESCE(is_demo,0) FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);\n            if($isDemo===1)return;\n        }\n        if(!self::eventEnabled('wecom.event_switches',$eventType)||!\\filter_var(\\setting('wecom.webhook_enabled',false),FILTER_VALIDATE_BOOLEAN))return;\n        // 2026-09-22：机器人首行直接显示具体事项标题，不再套“壁选后台待办”等笼统标题。\n        $title=trim((string)(preg_replace('/[\\\\r\\\\n【】]+/u',' ',$title)??''));\n        if($title==='')$title=$eventType;\n        $title=mb_substr($title,0,40);\n        $content='【'.$title.'】';\n        foreach($lines as $label=>$value){$value=trim((string)$value);if($value!=='')$content.=\"\\n\".$label.'：'.$value;}\n        $orderId=0;\n        if(isset($lines['订单号'])&&trim((string)$lines['订单号'])!==''){\n            $orderId=(int)$db->fetchValue('SELECT id FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>(string)$lines['订单号']]);\n        }\n        $data=['content'=>$content,'event_type'=>$eventType,'title'=>$title,'action_path'=>self::adminActionPath($eventType,$orderId)];\n        $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wecom_webhook',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':admin:wecom',0,128),'payload'=>json_encode($data,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n    }\n\n    public static function queue(Database $db, int $orderId, string $eventKey, string $eventType, array $payload = []): void\n    {\n        $definition = OrderMessageDefinition::definition($eventType, $payload); if (!$definition) return;\n        $order = $db->fetch(\"SELECT o.public_no,o.user_id,o.assigned_worker_id,o.final_amount_cents,o.booking_fee_cents,o.is_demo,u.mobile_ciphertext user_mobile FROM orders o JOIN users u ON u.id=o.user_id WHERE o.id=:id\", ['id'=>$orderId]);\n        if (!$order) return;\n        $parameters = ['order_no'=>(string)$order['public_no'],'status'=>$definition['status'],'amount'=>number_format(((int)($definition['amount_cents'] ?? $order['final_amount_cents']))/100,2,'.',''),'time'=>date('Y-m-d H:i')];\n        // 内部通知是基础渠道，可单独关闭某类进度消息；不影响外部通知。\n        if (self::eventEnabled('notification.internal_event_switches', $eventType)) {\n            $noticeData = json_encode(['order_id' => (int) $orderId, 'event_key' => $eventKey], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n            foreach ($definition['recipients'] as $recipientType) {\n                if (!in_array($recipientType, ['user', 'worker'], true)) continue;\n                $recipientId = $recipientType === 'user' ? (int) $order['user_id'] : (int) ($order['assigned_worker_id'] ?? 0);\n                if ($recipientId < 1) continue;\n                $content = '订单 ' . $parameters['order_no'] . '：' . $definition['status'];\n                if (!empty($definition['amount_cents'])) $content .= '，金额 ' . $parameters['amount'] . ' 元';\n                $duplicate = $db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type=:recipient_type AND recipient_id=:recipient_id AND channel='in_app' AND template_key=:template_key AND BINARY data_json=BINARY :data_json LIMIT 1\", [\n                    'recipient_type' => $recipientType, 'recipient_id' => $recipientId, 'template_key' => $eventType, 'data_json' => $noticeData,\n                ]);\n                if (!$duplicate) {\n                    $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,:recipient_type,:recipient_id,'in_app',:template_key,:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\", [\n                        'public_id' => \\public_id(), 'recipient_type' => $recipientType, 'recipient_id' => $recipientId,\n                        'template_key' => $eventType, 'title' => $definition['status'], 'content' => $content, 'data' => $noticeData,\n                    ]);\n                }\n            }\n        }\n        // V2.2.7：演示订单只落站内消息，绝不进入企业微信、微信订阅或短信发件箱。\n        // 测试中心订单额外记录“应发但未真实投递”的模拟投影，不复用真实 message_outbox。\n        if(!empty($order['is_demo'])){\n            try{\n                TestMessageProjectionRecorder::capture($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters);\n            }catch(\\Throwable $exception){\n                \\write_log('test-center','['.date('c').'] message_projection_failed order_id='.$orderId.' event='.str_replace([\"\\r\",\"\\n\"],' ',$eventType).' '.$exception->getMessage().\"\\n\");\n            }\n            return;\n        }\n        // 2026-09-02：管理员通知独立进入企业微信机器人，不读取或发送管理员短信号码。\n        if (in_array('admin', $definition['recipients'], true) && self::eventEnabled('wecom.event_switches', $eventType)\n            && \\filter_var(\\setting('wecom.webhook_enabled', false), FILTER_VALIDATE_BOOLEAN)) {\n            $adminTitle=trim((string)($definition['admin_title']??$definition['status']??''));\n            $adminTitle=trim((string)(preg_replace('/[\\\\r\\\\n【】]+/u',' ',$adminTitle)??''));\n            if($adminTitle==='')$adminTitle=$eventType;\n            $adminTitle=mb_substr($adminTitle,0,40);\n            $content = \"【{$adminTitle}】\\n订单号：{$parameters['order_no']}\\n时间：{$parameters['time']}\";\n            if ((string)$definition['status'] !== $adminTitle) $content .= \"\\n状态：{$definition['status']}\";\n            if (!empty($definition['amount_cents'])) $content .= \"\\n金额：{$parameters['amount']} 元\";\n            $adminData=['content'=>$content,'event_type'=>$eventType,'order_id'=>$orderId,'title'=>$adminTitle,'action_path'=>self::adminActionPath($eventType,$orderId,(string)$order['public_no'])];\n            $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wecom_webhook',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':admin:wecom',0,128),'payload'=>json_encode($adminData,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        }\n        // 2026-10-01：外部触达分两种模式：\n        // 1) 建议/普通短信仍按开关独立发送；\n        // 2) “订阅补充短信”改为微信订阅优先，只有订阅不可用或最终失败时才进入短信队列。\n        $smsEnabled=\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('sms.event_switches',$eventType);\n        $eventMeta=MessageEventCatalog::get($eventType)??[];\n        $fallbackMode=$smsEnabled && (($eventMeta['sms_delivery_mode']??'independent')==='subscription_fallback');\n        $fallbackPayload=$fallbackMode\n            ? OrderSubscriptionQueue::buildSubscriptionFallbackSmsPayload($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters)\n            : null;\n        $subscription=OrderSubscriptionQueue::queueOrderSubscription(\n            $db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,\n            is_array($fallbackPayload)?$fallbackPayload:[]\n        );\n        // 同一事件对用户和师傅的外部提醒语义可能不同。若事件需要师傅及时知道、\n        // 但主订阅场景并不是师傅场景，则额外使用通用“师傅订单重要进度”模板补一条微信提醒。\n        OrderSubscriptionQueue::queueWorkerOrderUpdateSupplement($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$fallbackMode);\n        if($fallbackMode){\n            if(empty($subscription['queued'])&&is_array($fallbackPayload)){\n                $fallbackPayload['fallback_reason']=(string)($subscription['reason']??'subscription_unavailable');\n                OrderSubscriptionQueue::enqueueSmsFallback($db,$fallbackPayload);\n            }\n            return;\n        }\n\n        if(!$smsEnabled)return;\n        $templates=\\setting('sms.template_codes',[]);if(!is_array($templates))return;\n        $configured=$templates[$definition['scene']]??'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        if($templateCode==='')return;\n        $recipients=[];\n        foreach($definition['recipients'] as $recipient){\n            if($recipient==='user'){$mobile=\\decrypt_private_value((string)$order['user_mobile'],'user-mobile');if($mobile!=='')$recipients['user:'.(int)$order['user_id']]=[$mobile,'user',(int)$order['user_id']];}\n            elseif($recipient==='worker'&&!empty($order['assigned_worker_id'])){$row=$db->fetch('SELECT mobile_ciphertext FROM worker_profiles WHERE id=:id',['id'=>$order['assigned_worker_id']]);$mobile=$row?\\decrypt_private_value((string)$row['mobile_ciphertext'],'worker-mobile'):'';if($mobile!=='')$recipients['worker:'.(int)$order['assigned_worker_id']]=[$mobile,'worker',(int)$order['assigned_worker_id']];}\n        }\n        foreach($recipients as $key=>$recipient){\n            $data=['mobile'=>$recipient[0],'template_code'=>$templateCode,'parameters'=>$parameters,'event_type'=>$eventType,'order_id'=>$orderId,'recipient_type'=>$recipient[1],'recipient_id'=>$recipient[2]];\n            $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('aliyun_sms',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':'.$key,0,128),'payload'=>json_encode($data,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        }\n    }\n\n    public static function adminActionPath(string $eventType, int $orderId=0, string $orderNo=''): ?string\n    {\n        $routes=[\n            'platform_worker_quoted'=>'platform-orders',\n            'platform_change_requested'=>'platform-order-finance',\n            'merchant_auth_submitted'=>'merchants',\n            'worker_profile_submitted'=>'workers',\n            'worker_realname_submitted'=>'worker-credentials',\n            'worker_collection_code_submitted'=>'worker-credentials',\n            'worker_collection_code_auto_approved'=>'worker-credentials',\n            'withdrawal_submitted'=>'withdrawals',\n            'commission_overdue'=>'commissions',\n        ];\n        if (in_array($eventType, ['platform_measurement_auto_confirmed','platform_measurement_confirmed'], true) && $orderId > 0) {\n            return $orderNo !== '' ? '/admin/?route=platform-orders.pricing-review&order_no='.rawurlencode($orderNo) : '/admin/?route=platform-orders';\n        }\n        if(isset($routes[$eventType]))return '/admin/?route='.$routes[$eventType];\n        if($orderId>0)return '/admin/?route=orders.view&id='.$orderId;\n        return null;\n    }\n\n    public static function queueWorkerWithdrawalResult(Database $db,int $workerId,string $withdrawalNo,string $status,string $note='',int $amountCents=0):void\n    {\n        if($workerId<1||$withdrawalNo==='')return;\n        $labels=[\n            'approved'=>['提现审核通过','提现申请已审核通过，等待平台登记付款。'],\n            'rejected'=>['提现申请未通过','提现申请未通过，冻结金额已退回可用余额。'],\n            'paid'=>['提现已付款','平台已登记人工付款，请核对支付宝到账情况。'],\n            'payment_failed'=>['提现付款失败','人工付款未完成，请查看处理说明或等待平台重新处理。'],\n        ];\n        if(!isset($labels[$status]))return;\n        [$title,$content]=$labels[$status];\n        if($amountCents>0)$content.=' 金额 '.number_format($amountCents/100,2,'.','').' 元。';\n        $note=trim($note);if($note!=='')$content.=' 说明：'.mb_substr($note,0,120);\n        $data=json_encode(['withdrawal_no'=>$withdrawalNo,'status'=>$status],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $duplicate=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='withdrawal_result' AND BINARY data_json=BINARY :data LIMIT 1\",['worker_id'=>$workerId,'data'=>$data]);\n        if($duplicate)return;\n        $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:worker_id,'in_app','withdrawal_result',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n            'public_id'=>\\public_id(),'worker_id'=>$workerId,'title'=>$title,'content'=>$content,'data'=>$data,\n        ]);\n    }\n\n    public static function queueWorkerReviewResult(Database $db, int $workerId, string $cloudId, string $decision, string $reason, string $workerName=''): void\n    {\n        if ($workerId < 1) return;\n        $row = $db->fetch(\"SELECT w.user_id,w.display_name,u.mobile_ciphertext,(SELECT wi.openid FROM wechat_identities wi WHERE wi.user_id=w.user_id AND wi.status='active' ORDER BY wi.id DESC LIMIT 1) openid FROM worker_profiles w JOIN users u ON u.id=w.user_id WHERE w.id=:id LIMIT 1\", ['id'=>$workerId]);\n        if (!$row) return;\n        $labels=['approved'=>'审核通过','rejected'=>'审核未通过','suspended'=>'接单已暂停','pending'=>'等待审核'];\n        $status=$labels[$decision]??'审核状态已更新';\n        $dataJson=json_encode(['cloud_id'=>$cloudId,'review_status'=>$decision],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $duplicate=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:id AND channel='in_app' AND template_key='worker_profile_review_result' AND BINARY data_json=BINARY :data LIMIT 1\",['id'=>$workerId,'data'=>$dataJson]);\n        if(!$duplicate)$db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:recipient_id,'in_app','worker_profile_review_result',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>\\public_id(),'recipient_id'=>$workerId,'title'=>'师傅入驻'.$status,'content'=>$reason!==''?$status.'：'.mb_substr($reason,0,80):$status,'data'=>$dataJson]);\n        if(!in_array($decision,['approved','rejected','suspended'],true))return;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes['reviewResult'];$userId=(int)$row['user_id'];$pref=SubscriptionQuotaStore::subscriptionPreferences($db,$userId)['reviewResult']??[];\n        if(empty($scene['available']))return;\n        $authorizationStatus=(string)($pref['authorization_status']??'');\n        $subscriptionType=(string)($scene['subscription_type']??'one_time');\n        if($subscriptionType==='one_time'){\n            if(in_array($authorizationStatus,['ban','disabled'],true))return;\n            if(max(0,(int)($pref['remaining_count']??0))<1)return;\n        }else{\n            if(empty($pref['enabled'])||!in_array($authorizationStatus,['accept','acceptWithAudio','acceptWithAlert'],true))return;\n        }\n        $openid=trim((string)$row['openid']);$mobile=\\decrypt_private_value((string)$row['mobile_ciphertext'],'user-mobile');if($openid===''||$mobile==='')return;\n        $name=mb_substr(trim($workerName)!==''?trim($workerName):(string)$row['display_name'],0,10);\n        $thing=$decision==='approved'?'入驻审核已通过，请进入小程序查看。':($decision==='rejected'?'入驻审核未通过，请按处理说明修改。':'师傅接单状态已暂停，请查看处理说明。');\n        if($reason!=='')$thing=mb_substr($thing.' '.trim($reason),0,20);\n        OrderSubscriptionQueue::enqueueWechatSubscribe($db,'worker-review:'.$cloudId.':'.$decision.':'.gmdate('YmdHi'),$userId,'reviewResult',$openid,(string)$scene['template_id'],'pages/record/detail?id='.rawurlencode($cloudId),[\n            'name1'=>['value'=>$name?:'入驻师傅'],\n            'phone_number2'=>['value'=>$mobile],\n            'phrase3'=>['value'=>$status],\n            'thing5'=>['value'=>$thing],\n        ]);\n    }\n\n    public static function eventEnabled(string $settingKey, string $eventType): bool\n    {\n        $channel = strpos($settingKey, 'wecom.') === 0 ? 'wecom' : (strpos($settingKey, 'notification.') === 0 ? 'inapp' : 'sms');\n        $configured = \\setting($settingKey, []);\n        return MessageEventCatalog::enabled($channel, $eventType, is_array($configured) ? $configured : []);\n    }\n}\n","server/app/Infrastructure/Messaging/OrderSubscriptionDefinitionOperations.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\n\n/** Subscription metadata / mapping extracted from the frozen notification facade. */\ntrait OrderSubscriptionDefinitionOperations\n{\n    public static function subscriptionSceneDefinitions(): array\n    {\n        $scenes = [\n            'chat_unread'=>['title'=>'聊天未读提醒','description'=>'会话持续未读时聚合提醒，可单独订阅','template_id'=>'','field_map'=>[],'field_semantics'=>['status','time'],'keywords'=>['提醒内容','时间'],'recipient'=>'user'],\n            'reviewResult' => ['title'=>'入驻审核结果通知','description'=>'师傅入驻审核完成后通知','template_id'=>'b7RKsUBxQu3BWwMEwzw-oFHkw1K9m4egjVFSLQ5rWMY','field_map'=>[],'field_semantics'=>[],'keywords'=>['师傅姓名','手机号','审核结果','说明'],'recipient'=>'worker'],\n            'order_audit' => ['title'=>'订单审核通知','description'=>'订单通过、补资料或审核未通过时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time','audit_note'],'keywords'=>['订单编号','审核结果','处理时间','审核说明']],\n            'quote_received' => ['title'=>'收到报价通知','description'=>'订单收到新的师傅或平台报价时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','amount','quote_party','time'],'keywords'=>['订单编号','报价金额','报价方','报价时间']],\n            'payment_success' => ['title'=>'预约费支付成功','description'=>'微信支付已有结果反馈，通常保留内部通知即可','template_id'=>'','field_map'=>[],'field_semantics'=>['amount','time','platform_name','order_no'],'keywords'=>['支付金额','付款时间','平台名称','订单编号'],'recommended'=>false],\n            'worker_assigned' => ['title'=>'师傅接单通知','description'=>'安排师傅或师傅确认接单时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','worker_name','requirement_note'],'keywords'=>['订单编号','师傅姓名','需求说明']],\n            'completion_submitted' => ['title'=>'完工待验收通知','description'=>'师傅提交完工后提醒用户验收','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','time','service_category'],'keywords'=>['订单编号','完工时间','服务类目']],\n            'refund_result' => ['title'=>'退款结果通知','description'=>'取消退款审核及退款结果','template_id'=>'','field_map'=>[],'field_semantics'=>['amount','status','order_no','time'],'keywords'=>['退款金额','退款状态','订单编号','处理时间']],\n            'payment_pending'=>['title'=>'待付款提醒','description'=>'报价确认或测量加费待付款','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','待办事项','时间']],\n            'fee_adjustment'=>['title'=>'费用调整待确认','description'=>'师傅申请调整费用，待用户确认','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','调整状态','时间']],\n            'supplement_reminder'=>['title'=>'补资料临期提醒','description'=>'订单补充资料的处理期限提醒','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理状态','提醒时间']],\n            'measurement_result'=>['title'=>'测量成果待确认','description'=>'测量师傅提交成果，待用户验收','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','成果状态','提交时间']],\n            'measurement_extension'=>['title'=>'测量冻结延期结果','description'=>'用户申请延长冻结期的审核结果','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理结果','时间']],\n            'repair_progress'=>['title'=>'维修进度提醒','description'=>'师傅拒绝、已预约或可申请平台介入','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','维修进度','时间']],\n            'dispute_progress'=>['title'=>'争议处理通知','description'=>'争议处理完成或关键结果更新时通知用户','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理状态','时间']],\n            'user_order_update'=>['title'=>'订单重要进度通知','description'=>'派单异常、平台取消、电话公开、跑空费等需要用户及时知道的重要订单变化','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','订单状态','更新时间'],'recipient'=>'user'],\n            'worker_order_update'=>['title'=>'师傅订单重要进度','description'=>'安排接单、退款/取消、费用处理或争议等需要师傅及时知道的订单变化','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','订单状态','更新时间'],'recipient'=>'worker'],\n            'worker_repair'=>['title'=>'新维修工单','description'=>'提醒师傅及时联系用户处理售后','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','维修任务','时间'],'recipient'=>'worker'],\n            'worker_rework'=>['title'=>'测量成果需补测','description'=>'用户要求师傅重新提交测量成果','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','补测状态','时间'],'recipient'=>'worker'],\n            'worker_commission_due'=>['title'=>'平台服务费待缴','description'=>'服务费账单生成，提醒师傅处理','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','amount','time'],'keywords'=>['订单号','费用金额','生成时间'],'recipient'=>'worker'],\n        ];\n        // V2.4.1：一次性订阅改为“剩余可发送次数”；长期订阅仅在微信公众平台真实模板具备长期资格时使用。\n        // important 仅用于小程序端“重要通知一键续收”，不改变后台事件优先级、短信分类或发送顺序。\n        $importantScenes = [\n            // 入驻审核 reviewResult 有独立提交埋点，不参与日常“一键续收”，避免审核完成后长期占用批量名额。\n            'order_audit','quote_received','worker_assigned','completion_submitted','refund_result',\n            'payment_pending','fee_adjustment','supplement_reminder','measurement_result','measurement_extension','repair_progress','dispute_progress',\n            'user_order_update','worker_order_update','worker_repair','worker_rework','worker_commission_due',\n        ];\n        foreach ($scenes as $sceneKey => &$scene) {\n            $scene['subscription_type'] = 'one_time';\n            $scene['template_title'] = '';\n            $scene['template_fields'] = [];\n            $scene['synced_template_id'] = '';\n            $scene['important'] = in_array($sceneKey, $importantScenes, true);\n        }\n        unset($scene);\n        $configured = \\setting('wechat.subscribe_template_ids', []);\n        if (is_array($configured)) {\n            foreach ($configured as $key => $row) {\n                if (!isset($scenes[$key])) continue;\n                if (is_string($row)) $scenes[$key]['template_id'] = trim($row);\n                elseif (is_array($row)) {\n                    $scenes[$key]['template_id'] = trim((string) ($row['template_id'] ?? $row['id'] ?? $scenes[$key]['template_id']));\n                    $scenes[$key]['template_title'] = mb_substr(trim((string)($row['template_title'] ?? '')),0,80);\n                    $scenes[$key]['synced_template_id'] = trim((string)($row['synced_template_id'] ?? ''));\n                    $scenes[$key]['template_fields'] = ($scenes[$key]['synced_template_id']!==''&&hash_equals($scenes[$key]['template_id'],$scenes[$key]['synced_template_id'])&&is_array($row['template_fields'] ?? null)) ? array_values(array_filter(array_map('strval',$row['template_fields']))) : [];\n                    $scenes[$key]['template_field_labels'] = is_array($row['template_field_labels'] ?? null) ? $row['template_field_labels'] : [];\n                    $fieldMap = is_array($row['field_map'] ?? null) ? $row['field_map'] : [];\n                    // 2.5.0：旧字段名在读取时无损迁移为明确语义；审核备注与订单需求必须按场景分开。\n                    if(isset($fieldMap['service_name'])&&!isset($fieldMap['service_category'])){$fieldMap['service_category']=$fieldMap['service_name'];unset($fieldMap['service_name']);}\n                    if(isset($fieldMap['remark'])){\n                        if($key==='order_audit'&&!isset($fieldMap['audit_note']))$fieldMap['audit_note']=$fieldMap['remark'];\n                        elseif(!isset($fieldMap['requirement_note']))$fieldMap['requirement_note']=$fieldMap['remark'];\n                        unset($fieldMap['remark']);\n                    }\n                    // 旧 payment_success 的 merchant_name 实际发送的是“壁选”，本质是平台名称，不是订单商家。\n                    if($key==='payment_success'&&isset($fieldMap['merchant_name'])&&!isset($fieldMap['platform_name'])){$fieldMap['platform_name']=$fieldMap['merchant_name'];unset($fieldMap['merchant_name']);}\n                    $scenes[$key]['field_map'] = $fieldMap;\n                    $scenes[$key]['field_defaults'] = is_array($row['field_defaults'] ?? null) ? $row['field_defaults'] : [];\n                    $subscriptionType = trim((string) ($row['subscription_type'] ?? 'one_time'));\n                    if (in_array($subscriptionType, ['one_time','long_term'], true)) $scenes[$key]['subscription_type'] = $subscriptionType;\n                }\n            }\n        }\n        $global = filter_var(\\setting('wechat.subscribe_enabled', true), FILTER_VALIDATE_BOOLEAN);\n        foreach ($scenes as $key => &$scene) {\n            $scene['key'] = $key;\n            $scene['global_enabled'] = $global;\n            $requiredSemantics = array_values(array_map('strval',(array)($scene['field_semantics']??[])));\n            $knownSemantics = array_fill_keys(array_keys(self::subscriptionSemanticLabels()), true);\n            $fieldMap = is_array($scene['field_map']??null) ? $scene['field_map'] : [];\n            $fieldDefaults = is_array($scene['field_defaults']??null) ? $scene['field_defaults'] : [];\n            $templateFields=is_array($scene['template_fields']??null)?array_values(array_map('strval',$scene['template_fields'])):[];\n            $mapComplete = true; $targets = [];\n            // 当前场景声明的 field_semantics 是“必须来源”，必须全部映射。\n            foreach($requiredSemantics as $semantic){\n                $target=trim((string)($fieldMap[$semantic]??''));\n                if($target===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            // 微信模板可能比业务场景多字段。允许使用系统已知业务字段补齐，但这些不是当前场景的必填语义。\n            foreach($fieldMap as $semantic=>$target){\n                $semantic=(string)$semantic;$target=trim((string)$target);\n                if(in_array($semantic,$requiredSemantics,true))continue;\n                if(!isset($knownSemantics[$semantic])||$target===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            foreach($fieldDefaults as $target=>$fixedValue){\n                $target=trim((string)$target);$fixedValue=trim((string)$fixedValue);\n                if($target===''||$fixedValue===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            if($templateFields){\n                foreach($templateFields as $templateField)if(!isset($targets[$templateField])){$mapComplete=false;break;}\n            }\n            $needsFieldMap = !empty($requiredSemantics)||!empty($templateFields);\n            // reviewResult 是项目已验证的固定模板，字段由专用发送代码固定生成，不走通用 field_map。\n            if($key==='reviewResult'){\n                $mapComplete=true;\n                if($templateFields){\n                    foreach(self::reviewResultFixedTemplateFields() as $fixedField){\n                        if(!in_array($fixedField,$templateFields,true)){$mapComplete=false;break;}\n                    }\n                }\n            }\n            $scene['configuration_complete'] = $scene['template_id'] !== '' && (!$needsFieldMap||$mapComplete);\n            $scene['available'] = $global && $scene['configuration_complete'];\n            $scene['availability_reason'] = $scene['template_id'] === '' ? 'template_missing' : ($needsFieldMap && !$mapComplete ? ($key==='reviewResult'?'fixed_template_mismatch':'field_map_missing') : ($global ? 'ready' : 'global_disabled'));\n        }\n        unset($scene);\n        return $scenes;\n    }\n\n    public static function subscriptionSemanticLabels(): array\n    {\n        return [\n            'order_no'=>'订单编号',\n            'status'=>'当前状态/处理结果',\n            'time'=>'状态更新时间',\n            'amount'=>'金额',\n            'quote_party'=>'报价方',\n            'platform_name'=>'平台名称',\n            'merchant_name'=>'商家名称',\n            'worker_name'=>'师傅姓名',\n            'service_category'=>'服务类目',\n            'order_title'=>'订单名称',\n            'service_address'=>'施工地址',\n            'requirement_note'=>'需求说明',\n            'audit_note'=>'审核说明',\n            'expected_visit_time'=>'期望上门时间',\n            'contact_name'=>'对接人',\n            'appointment_time'=>'预约时间',\n            'appointment_note'=>'预约说明',\n        ];\n    }\n\n    public static function subscriptionSemanticDescriptions(): array\n    {\n        return [\n            'order_no'=>'订单 public_no',\n            'status'=>'本次真实业务事件的状态文字',\n            'time'=>'本次消息生成时间',\n            'amount'=>'本次事件金额；无专项金额时使用订单成交金额',\n            'quote_party'=>'报价事件对应的师傅或平台',\n            'platform_name'=>'后台基础设置 site.name',\n            'merchant_name'=>'订单关联 merchant_profiles.business_name；普通用户订单显示“个人订单”',\n            'worker_name'=>'订单当前成交/指派师傅姓名',\n            'service_category'=>'orders.category_names_snapshot，等同用户下单选择的服务类目',\n            'order_title'=>'orders.title，订单标题/名称，不等同服务类目',\n            'service_address'=>'订单地址快照 order_addresses.address_summary',\n            'requirement_note'=>'orders.description，用户订单需求说明',\n            'audit_note'=>'orders.audit_note，管理员审核时填写的说明',\n            'expected_visit_time'=>'orders.expected_visit_at，用户下单填写的期望上门时间',\n            'contact_name'=>'订单地址快照中的脱敏对接人姓名',\n            'appointment_time'=>'该订单最近一次施工预约时间',\n            'appointment_note'=>'该订单最近一次施工预约说明',\n        ];\n    }\n\n    public static function reviewResultFixedTemplateFields(): array\n    {\n        return ['name1','phone_number2','phrase3','thing5'];\n    }\n\n    public static function subscriptionFixedValuePresets(string $wechatField,string $label=''): array\n    {\n        $label=trim($label);\n        if(preg_match('/温馨提示|提示|备注|说明/u',$label))return ['请查看小程序详情','请及时处理'];\n        return [];\n    }\n\n    public static function inferSubscriptionTemplateBinding(array $scene,array $actual,array $previous=[]): array\n    {\n        $fields=is_array($actual['fields']??null)?array_values(array_unique(array_filter(array_map('strval',$actual['fields'])))):[];\n        $labels=is_array($actual['field_labels']??null)?$actual['field_labels']:[];\n        $required=array_values(array_map('strval',(array)($scene['field_semantics']??[])));\n        $known=array_keys(self::subscriptionSemanticLabels());\n        // 必填语义优先匹配；模板额外字段可继续匹配系统已知业务字段。\n        $allowed=array_values(array_unique(array_merge($required,$known)));\n        $fieldMap=[];$defaults=[];$used=[];\n        $previousMap=is_array($previous['field_map']??null)?$previous['field_map']:[];\n        // 兼容旧配置后再参与自动识别，避免同步模板时把已经绑好的字段丢掉。\n        if(isset($previousMap['service_name'])&&!isset($previousMap['service_category'])){$previousMap['service_category']=$previousMap['service_name'];unset($previousMap['service_name']);}\n        if(isset($previousMap['remark'])){\n            if((string)($scene['key']??'')==='order_audit'&&!isset($previousMap['audit_note']))$previousMap['audit_note']=$previousMap['remark'];\n            elseif(!isset($previousMap['requirement_note']))$previousMap['requirement_note']=$previousMap['remark'];\n            unset($previousMap['remark']);\n        }\n        if((string)($scene['key']??'')==='payment_success'&&isset($previousMap['merchant_name'])&&!isset($previousMap['platform_name'])){$previousMap['platform_name']=$previousMap['merchant_name'];unset($previousMap['merchant_name']);}\n        $previousDefaults=is_array($previous['field_defaults']??null)?$previous['field_defaults']:[];\n        foreach($previousMap as $semantic=>$field){\n            $semantic=(string)$semantic;$field=trim((string)$field);\n            if(in_array($semantic,$allowed,true)&&in_array($field,$fields,true)&&!isset($used[$field])){$fieldMap[$semantic]=$field;$used[$field]=true;}\n        }\n        foreach($previousDefaults as $field=>$value){\n            $field=trim((string)$field);$value=trim((string)$value);\n            if($value!==''&&in_array($field,$fields,true)&&!isset($used[$field])){$defaults[$field]=$value;$used[$field]=true;}\n        }\n        $aliases=[\n            'order_no'=>['订单编号','订单号','服务单号','工单号','预约单号'],\n            'status'=>['订单状态','审核结果','处理状态','处理结果','退款状态','维修进度','进度','待办事项','调整状态','成果状态','补测状态','维修任务'],\n            'time'=>['处理时间','更新时间','提醒时间','提交时间','生成时间','报价时间','付款时间','完工时间','时间'],\n            'amount'=>['支付金额','退款金额','报价金额','费用金额','金额','费用'],\n            'quote_party'=>['报价方','报价人','报价师傅'],\n            'platform_name'=>['平台名称','服务平台','平台'],\n            'merchant_name'=>['商家名称','商户名称','门店名称','店铺名称','企业名称'],\n            'worker_name'=>['师傅姓名','服务人员','接单人','工作人员'],\n            'service_category'=>['服务类目','服务分类','施工类目','业务类目','类目','服务项目','服务内容'],\n            'order_title'=>['订单名称','订单标题','服务名称','项目名称'],\n            'service_address'=>['施工地址','服务地址','上门地址','安装地址','地址'],\n            'requirement_note'=>['需求说明','订单说明','施工要求','服务要求'],\n            'audit_note'=>['审核说明','审核备注','审核意见','驳回原因','备注','说明'],\n            'expected_visit_time'=>['期望上门时间','期望时间','期望日期','上门时间'],\n            'contact_name'=>['联系人','联系人姓名','对接人','客户姓名'],\n            'appointment_time'=>['预约时间','预约日期','上门预约'],\n            'appointment_note'=>['预约说明','预约备注'],\n        ];\n        // payment_success 的“商家/商户名称”历史上实际表达收款平台；仅该场景将二者优先解释为平台名称。\n        if((string)($scene['key']??'')==='payment_success')$aliases['platform_name']=array_merge(['商家名称','商户名称'],$aliases['platform_name']);\n        $normalize=static function(string $value):string{return mb_strtolower((string)(preg_replace('/[\\s：:（）()\\-—_\\/]+/u','',$value)??$value));};\n        foreach($fields as $field){\n            if(isset($used[$field]))continue;\n            $label=trim((string)($labels[$field]??''));$normalized=$normalize($label);\n            if($normalized==='')continue;\n            $best='';\n            foreach($allowed as $semantic){\n                if(isset($fieldMap[$semantic]))continue;\n                foreach($aliases[$semantic]??[] as $alias){\n                    $a=$normalize($alias);\n                    if($normalized===$a||mb_strpos($normalized,$a)!==false||mb_strpos($a,$normalized)!==false){$best=$semantic;break 2;}\n                }\n            }\n            if($best!==''){$fieldMap[$best]=$field;$used[$field]=true;continue;}\n\n        }\n        $unresolved=[];foreach($fields as $field)if(!isset($used[$field]))$unresolved[]=$field;\n        $missingSemantics=[];foreach($required as $semantic)if(empty($fieldMap[$semantic]))$missingSemantics[]=$semantic;\n        return ['field_map'=>$fieldMap,'field_defaults'=>$defaults,'unresolved_fields'=>$unresolved,'missing_semantics'=>$missingSemantics,'complete'=>!$unresolved&&!$missingSemantics];\n    }\n\n    public static function recommendSubscriptionKeywords(array $scene,array $keywords): array\n    {\n        $pseudo=['fields'=>[],'field_labels'=>[]];\n        foreach($keywords as $row){\n            if(!is_array($row))continue;\n            $kid=(int)($row['kid']??0);if($kid<1)continue;\n            $field='kid'.$kid;$pseudo['fields'][]=$field;$pseudo['field_labels'][$field]=(string)($row['name']??'');\n        }\n        $binding=self::inferSubscriptionTemplateBinding($scene,$pseudo,[]);\n        $recommended=[];\n        foreach(array_merge(array_values($binding['field_map']),array_keys($binding['field_defaults'])) as $field){\n            if(strpos((string)$field,'kid')===0)$recommended[]=(int)substr((string)$field,3);\n        }\n        return array_values(array_unique(array_filter($recommended,static function($id){return $id>0;})));\n    }\n}\n","server/app/Infrastructure/Messaging/OrderSubscriptionQueue.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\OrderMessageDefinition;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\n\nfinal class OrderSubscriptionQueue\n{\n\n    public static function subscriptionBusinessValues(Database $db,int $orderId,string $eventType,array $definition,array $parameters):array\n    {\n        $row=$db->fetch(\"SELECT o.public_no,o.order_source_type,o.merchant_profile_id,o.category_name_snapshot,o.category_names_snapshot,o.title,o.description,o.audit_note,o.expected_visit_at,o.city,o.district,o.address_summary,o.assigned_worker_id,mp.business_name merchant_business_name,oa.address_summary address_snapshot,oa.contact_name_masked,wp.display_name worker_name FROM orders o LEFT JOIN merchant_profiles mp ON mp.id=o.merchant_profile_id LEFT JOIN order_addresses oa ON oa.order_id=o.id LEFT JOIN worker_profiles wp ON wp.id=o.assigned_worker_id WHERE o.id=:id LIMIT 1\",['id'=>$orderId]);\n        if(!$row)$row=[];\n        $appointment=$db->fetch(\"SELECT appointment_at,note,wait_customer_notice FROM appointment_records WHERE order_id=:id AND context_type='service' ORDER BY id DESC LIMIT 1\",['id'=>$orderId]);\n        if(!$appointment)$appointment=[];\n        $platformName=trim((string)\\setting('site.name','壁选'));\n        if($platformName==='')$platformName='壁选';\n        $serviceCategory=trim((string)($row['category_names_snapshot']??''));\n        if($serviceCategory===''||$serviceCategory==='不确定类目')$serviceCategory=trim((string)($row['category_name_snapshot']??''));\n        if($serviceCategory==='')$serviceCategory='施工服务';\n        $orderTitle=trim((string)($row['title']??''));if($orderTitle==='')$orderTitle=$serviceCategory;\n        $address=trim((string)($row['address_snapshot']??''));if($address==='')$address=trim((string)($row['address_summary']??''));\n        if($address==='')$address=trim((string)(($row['city']??'').($row['district']??'')));if($address==='')$address='请查看订单详情';\n        $merchantName=trim((string)($row['merchant_business_name']??''));if($merchantName==='')$merchantName=((string)($row['order_source_type']??'consumer')==='merchant'?'商家订单':'个人订单');\n        $workerName=trim((string)($row['worker_name']??''));if($workerName==='')$workerName='待安排师傅';\n        $requirement=trim((string)($row['description']??''));if($requirement==='')$requirement='无特殊要求';\n        $auditNote=trim((string)($row['audit_note']??''));if($auditNote==='')$auditNote='请查看订单详情';\n        $expectedVisit=trim((string)($row['expected_visit_at']??''));if($expectedVisit==='')$expectedVisit=(string)($parameters['time']??date('Y-m-d H:i'));\n        $appointmentTime=trim((string)($appointment['appointment_at']??''));if($appointmentTime==='')$appointmentTime=$expectedVisit;\n        $appointmentNote=trim((string)($appointment['note']??''));\n        if($appointmentNote==='')$appointmentNote=!empty($appointment['wait_customer_notice'])?'等待客户另行通知':'请查看订单详情';\n        $quoteParty=$eventType==='platform_quoted'?$platformName:($workerName==='待安排师傅'?'师傅报价':$workerName);\n        return [\n            'order_no'=>(string)($parameters['order_no']??($row['public_no']??'')),\n            'status'=>(string)($definition['status']??($parameters['status']??'')),\n            'time'=>(string)($parameters['time']??date('Y-m-d H:i')),\n            'amount'=>(string)($parameters['amount']??'0.00').'元',\n            'quote_party'=>$quoteParty,\n            'platform_name'=>$platformName,\n            'merchant_name'=>$merchantName,\n            'worker_name'=>$workerName,\n            'service_category'=>$serviceCategory,\n            'order_title'=>$orderTitle,\n            'service_address'=>$address,\n            'requirement_note'=>$requirement,\n            'audit_note'=>$auditNote,\n            'expected_visit_time'=>$expectedVisit,\n            'contact_name'=>trim((string)($row['contact_name_masked']??''))?:'订单联系人',\n            'appointment_time'=>$appointmentTime,\n            'appointment_note'=>$appointmentNote,\n        ];\n    }\n\n    public static function queueOrderSubscription(Database $db, int $orderId, string $eventKey, string $eventType, array $definition, array $order, array $parameters, array $smsFallback=[], string $sceneOverride=''): array\n    {\n        $sceneKey=$sceneOverride!==''?$sceneOverride:self::subscriptionSceneForEvent($eventType);if($sceneKey==='')return ['queued'=>false,'reason'=>'scene_missing'];\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes[$sceneKey]??null;\n        if(!$scene)return ['queued'=>false,'reason'=>'scene_missing'];\n        if(empty($scene['available'])||empty($scene['field_map']))return ['queued'=>false,'reason'=>(string)($scene['availability_reason']??'scene_unavailable')];\n        $recipient=(string)($scene['recipient']??'user');\n        if(!in_array($recipient,(array)($definition['recipients']??[]),true))return ['queued'=>false,'reason'=>'recipient_mismatch'];\n        $workerProfile=null;\n        if($recipient==='worker'){\n            if(empty($order['assigned_worker_id']))return ['queued'=>false,'reason'=>'worker_missing'];\n            $workerProfile=$db->fetch('SELECT user_id FROM worker_profiles WHERE id=:id LIMIT 1',['id'=>(int)$order['assigned_worker_id']]);\n            if(!$workerProfile)return ['queued'=>false,'reason'=>'worker_missing'];\n        }\n        $userId=$recipient==='worker'?(int)$workerProfile['user_id']:(int)$order['user_id'];\n        $pref=SubscriptionQuotaStore::subscriptionPreferences($db,$userId)[$sceneKey]??[];\n        $authorizationStatus=(string)($pref['authorization_status']??'');\n        $subscriptionType=(string)($scene['subscription_type']??'one_time');\n        if($subscriptionType==='one_time'){\n            if(in_array($authorizationStatus,['ban','disabled'],true))return ['queued'=>false,'reason'=>$authorizationStatus];\n            if(max(0,(int)($pref['remaining_count']??0))<1)return ['queued'=>false,'reason'=>'count_exhausted'];\n        }else{\n            if(empty($pref['enabled'])||!in_array($authorizationStatus,['accept','acceptWithAudio','acceptWithAlert'],true))return ['queued'=>false,'reason'=>'not_authorized'];\n        }\n        $openid=(string)$db->fetchValue(\"SELECT openid FROM wechat_identities WHERE user_id=:id AND status='active' ORDER BY id DESC LIMIT 1\",['id'=>$userId]);\n        if($openid==='')return ['queued'=>false,'reason'=>'openid_missing'];\n        $values=self::subscriptionBusinessValues($db,$orderId,$eventType,$definition,$parameters);\n        $data=[];\n        foreach((array)$scene['field_map'] as $semantic=>$wechatKey){\n            $wechatKey=trim((string)$wechatKey);\n            if(!isset($values[$semantic])||preg_match('/^[A-Za-z_]+\\d+$/',$wechatKey)!==1)continue;\n            $formatted=WechatTemplateValue::format($wechatKey,(string)$values[$semantic]);\n            if($formatted===null||$formatted==='')return ['queued'=>false,'reason'=>'template_data_invalid'];\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $wechatKey=>$fixedValue){\n            $wechatKey=trim((string)$wechatKey);$fixedValue=trim((string)$fixedValue);\n            if($wechatKey===''||$fixedValue===''||isset($data[$wechatKey]))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,$fixedValue);\n            if($formatted===null||$formatted==='')return ['queued'=>false,'reason'=>'template_data_invalid'];\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['template_fields']??[]) as $templateField)if(!isset($data[$templateField]))return ['queued'=>false,'reason'=>'template_data_missing'];\n        if(!$data)return ['queued'=>false,'reason'=>'template_data_missing'];\n        $page=$recipient==='worker'?'pages/workerOrder/detail?id=':'pages/userOrder/detail?id=';\n        self::enqueueWechatSubscribe($db,$eventKey.':'.$recipient.':wxsub',$userId,$sceneKey,$openid,(string)$scene['template_id'],$page.rawurlencode((string)$order['public_no']),$data,$smsFallback);\n        return ['queued'=>true,'reason'=>'queued'];\n    }\n\n    public static function queueWorkerOrderUpdateSupplement(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,bool $fallbackMode=false):void\n    {\n        if(!in_array('worker',(array)($definition['recipients']??[]),true)||empty($order['assigned_worker_id']))return;\n        $primaryKey=self::subscriptionSceneForEvent($eventType);\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();\n        $primary=$primaryKey!==''?($scenes[$primaryKey]??null):null;\n        if(is_array($primary)&&(string)($primary['recipient']??'user')==='worker')return;\n        $meta=MessageEventCatalog::get($eventType)??[];\n        $important=((string)($meta['priority']??'normal')==='important')||$eventType==='worker_assigned';\n        if(!$important)return;\n        $workerFallback=$fallbackMode\n            ? self::buildSubscriptionFallbackSmsPayload($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,'worker')\n            : null;\n        $result=self::queueOrderSubscription(\n            $db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,\n            is_array($workerFallback)?$workerFallback:[],\n            'worker_order_update'\n        );\n        if($fallbackMode&&empty($result['queued'])&&is_array($workerFallback)){\n            $workerFallback['fallback_reason']=(string)($result['reason']??'worker_subscription_unavailable');\n            self::enqueueSmsFallback($db,$workerFallback);\n        }\n    }\n\n    public static function subscriptionSceneForEvent(string $eventType): string\n    {\n        $meta = MessageEventCatalog::get($eventType);\n        return $meta ? (string)($meta['subscription_scene'] ?? '') : '';\n    }\n\n    public static function enqueueWechatSubscribe(Database $db,string $businessKey,int $userId,string $sceneKey,string $openid,string $templateId,string $page,array $data,array $smsFallback=[]):void\n    {\n        $payload=['user_id'=>$userId,'scene_key'=>$sceneKey,'openid'=>$openid,'template_id'=>$templateId,'page'=>$page,'data'=>$data];\n        if($smsFallback)$payload['sms_fallback']=$smsFallback;\n        $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wechat_subscribe',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($businessKey,0,128),'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n    }\n\n    public static function buildSubscriptionFallbackSmsPayload(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,string $recipientOverride=''):?array\n    {\n        $meta=MessageEventCatalog::get($eventType);\n        if(!$meta||empty($meta['sms_subscription_fallback']))return null;\n        $sceneKey=(string)($meta['subscription_scene']??'');if($sceneKey==='')return null;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes[$sceneKey]??null;if(!$scene)return null;\n        $recipient=in_array($recipientOverride,['user','worker'],true)?$recipientOverride:(string)($scene['recipient']??'user');\n        if(!in_array($recipient,(array)($definition['recipients']??[]),true))return null;\n        $recipientId=0;$mobile='';\n        if($recipient==='user'){\n            $recipientId=(int)$order['user_id'];\n            $mobile=\\decrypt_private_value((string)$order['user_mobile'],'user-mobile');\n        }elseif($recipient==='worker'&&!empty($order['assigned_worker_id'])){\n            $recipientId=(int)$order['assigned_worker_id'];\n            $row=$db->fetch('SELECT mobile_ciphertext FROM worker_profiles WHERE id=:id LIMIT 1',['id'=>$recipientId]);\n            $mobile=$row?\\decrypt_private_value((string)$row['mobile_ciphertext'],'worker-mobile'):'';\n        }\n        if($recipientId<1||$mobile==='')return null;\n        return [\n            'business_key'=>substr($eventKey.':'.$recipient.':'.$recipientId.':sms-fallback',0,128),\n            'mobile'=>$mobile,\n            'sms_scene'=>(string)$definition['scene'],\n            'parameters'=>$parameters,\n            'event_type'=>$eventType,\n            'order_id'=>$orderId,\n            'recipient_type'=>$recipient,\n            'recipient_id'=>$recipientId,\n            'delivery_mode'=>'subscription_fallback',\n        ];\n    }\n\n    public static function enqueueSmsFallback(Database $db,array $fallback):bool\n    {\n        $eventType=trim((string)($fallback['event_type']??''));\n        if($eventType===''||!\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)||!self::eventEnabled('sms.event_switches',$eventType))return false;\n        $meta=MessageEventCatalog::get($eventType);\n        if(!$meta||empty($meta['sms_subscription_fallback']))return false;\n        $smsScene=trim((string)($fallback['sms_scene']??''));if($smsScene==='')return false;\n        $templates=\\setting('sms.template_codes',[]);if(!is_array($templates))return false;\n        $configured=$templates[$smsScene]??'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        $mobile=trim((string)($fallback['mobile']??''));\n        $businessKey=trim((string)($fallback['business_key']??''));\n        if($templateCode===''||$mobile===''||$businessKey==='')return false;\n        $payload=[\n            'mobile'=>$mobile,\n            'template_code'=>$templateCode,\n            'parameters'=>is_array($fallback['parameters']??null)?$fallback['parameters']:[],\n            'event_type'=>$eventType,\n            'order_id'=>(int)($fallback['order_id']??0),\n            'recipient_type'=>(string)($fallback['recipient_type']??'user'),\n            'recipient_id'=>(int)($fallback['recipient_id']??0),\n            'delivery_mode'=>'subscription_fallback',\n            'fallback_reason'=>(string)($fallback['fallback_reason']??'wechat_unavailable'),\n        ];\n        $businessKey=substr($businessKey,0,128);\n        $affected=$db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('aliyun_sms',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n            'business_key'=>$businessKey,\n            'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n        ]);\n        if($affected===1)return true;\n        return (bool)$db->fetchValue(\"SELECT id FROM message_outbox WHERE topic='aliyun_sms' AND BINARY business_key=BINARY :business_key LIMIT 1\",['business_key'=>$businessKey]);\n    }\n\n    public static function eventEnabled(string $settingKey, string $eventType): bool\n    {\n        $channel = strpos($settingKey, 'wecom.') === 0 ? 'wecom' : (strpos($settingKey, 'notification.') === 0 ? 'inapp' : 'sms');\n        $configured = \\setting($settingKey, []);\n        return MessageEventCatalog::enabled($channel, $eventType, is_array($configured) ? $configured : []);\n    }\n}\n","server/app/Infrastructure/Messaging/SubscriptionCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\n\n\nfinal class SubscriptionCatalog\n{\n    use OrderSubscriptionDefinitionOperations;\n\n}\n","server/app/Infrastructure/Messaging/SubscriptionQuotaStore.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\n\nfinal class SubscriptionQuotaStore\n{\n\n    public static function subscriptionPreferences(Database $db, int $userId): array\n    {\n        if ($userId < 1) return [];\n        $raw = (string) ($db->fetchValue('SELECT setting_value FROM system_settings WHERE setting_key=:key LIMIT 1', ['key'=>self::subscriptionPreferenceKey($userId)]) ?: '');\n        $decoded = $raw === '' ? [] : json_decode($raw, true);\n        if (!is_array($decoded)) return [];\n        // 无需新增表字段：旧 enabled/consumed 偏好在读取时补成计数模型，下次授权或消费即写回新结构。\n        $scenes = SubscriptionCatalog::subscriptionSceneDefinitions();\n        foreach ($decoded as $sceneKey => &$pref) {\n            if (!is_array($pref)) { $pref = []; continue; }\n            $scene = $scenes[$sceneKey] ?? [];\n            $type = trim((string)($pref['subscription_type'] ?? $scene['subscription_type'] ?? 'one_time'));\n            if (!in_array($type, ['one_time','long_term'], true)) $type = 'one_time';\n            $status = (string)($pref['authorization_status'] ?? '');\n            $legacyAccepted = !empty($pref['enabled']) && in_array($status, ['accept','acceptWithAudio','acceptWithAlert'], true);\n            if ($type === 'one_time') {\n                $remaining = array_key_exists('remaining_count', $pref) ? max(0, (int)$pref['remaining_count']) : ($legacyAccepted ? 1 : 0);\n                $pref['remaining_count'] = $remaining;\n                if (!array_key_exists('total_authorized_count', $pref)) $pref['total_authorized_count'] = $remaining;\n                // 一次性订阅的“拒绝”只代表本次没有新增额度，不应抹掉之前已经积累的可发送次数。\n                // 旧数据若出现 remaining_count>0 但状态为 reject/consumed，读取时恢复为可用。\n                if ($remaining > 0 && in_array($status, ['consumed','reject'], true)) $pref['authorization_status'] = 'accept';\n                if (!array_key_exists('last_request_status', $pref) && $status !== '') $pref['last_request_status'] = $status;\n            } else {\n                $pref['remaining_count'] = null;\n                if (!array_key_exists('total_authorized_count', $pref)) $pref['total_authorized_count'] = $legacyAccepted ? 1 : 0;\n            }\n            $pref['subscription_type'] = $type;\n        }\n        unset($pref);\n        return $decoded;\n    }\n\n    public static function saveSubscriptionPreference(Database $db, int $userId, string $sceneKey, bool $enabled, string $authorizationStatus): array\n    {\n        $scenes = SubscriptionCatalog::subscriptionSceneDefinitions();\n        if ($userId < 1 || !isset($scenes[$sceneKey])) throw new \\RuntimeException('订阅场景不存在。');\n        if ($enabled && empty($scenes[$sceneKey]['available'])) throw new \\RuntimeException('该订阅场景尚未在后台配置可用模板。');\n        $allowed = ['accept','acceptWithAudio','acceptWithAlert','reject','ban','filter','disabled','consumed','error',''];\n        if (!in_array($authorizationStatus, $allowed, true)) $authorizationStatus = $enabled ? 'accept' : 'disabled';\n        if ($enabled && $authorizationStatus === '') $authorizationStatus = 'accept';\n        $preferences = self::subscriptionPreferences($db, $userId);\n        $previous = is_array($preferences[$sceneKey] ?? null) ? $preferences[$sceneKey] : [];\n        $type = (string)($scenes[$sceneKey]['subscription_type'] ?? 'one_time');\n        $accepted = in_array($authorizationStatus, ['accept','acceptWithAudio','acceptWithAlert'], true);\n        $remaining = $type === 'one_time' ? max(0, (int)($previous['remaining_count'] ?? 0)) : null;\n        $total = max(0, (int)($previous['total_authorized_count'] ?? 0));\n        $effectiveStatus = $authorizationStatus;\n        if ($accepted) {\n            $enabled = true;\n            if ($type === 'one_time') $remaining++;\n            $total++;\n        } elseif ($type === 'one_time' && in_array($authorizationStatus, ['reject','filter'], true)) {\n            // reject 只是本次没有新增额度；filter 是微信因同标题过滤，本质也不是授权失效。\n            // 两种情况都保留之前已经积累的 remaining_count。\n            $enabled = $remaining > 0;\n            $effectiveStatus = $remaining > 0 ? 'accept' : $authorizationStatus;\n        } elseif (in_array($authorizationStatus, ['ban','disabled'], true)) {\n            $enabled = false;\n        } elseif ($type === 'one_time' && $remaining > 0) {\n            $enabled = true;\n            $effectiveStatus = 'accept';\n        }\n        $preferences[$sceneKey] = array_merge($previous, [\n            'enabled'=>(bool)$enabled,\n            'authorization_status'=>$effectiveStatus,\n            'last_request_status'=>$authorizationStatus,\n            'subscription_type'=>$type,\n            'remaining_count'=>$remaining,\n            'total_authorized_count'=>$total,\n            'template_id'=>(string)$scenes[$sceneKey]['template_id'],\n            'updated_at'=>gmdate('c'),\n        ]);\n        if ($accepted) $preferences[$sceneKey]['last_authorized_at'] = gmdate('c');\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,updated_by,created_at,updated_at) VALUES(:key,:value,'json','notification_user',0,'用户微信订阅消息偏好',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type='json',group_name='notification_user',is_public=0,updated_at=UTC_TIMESTAMP()\", ['key'=>self::subscriptionPreferenceKey($userId),'value'=>$json]);\n        return $preferences[$sceneKey];\n    }\n\n    public static function markSubscriptionConsumed(Database $db, int $userId, string $sceneKey): void\n    {\n        $preferences = self::subscriptionPreferences($db, $userId);\n        if (!isset($preferences[$sceneKey]) || !is_array($preferences[$sceneKey])) return;\n        $pref = $preferences[$sceneKey];\n        $type = (string)($pref['subscription_type'] ?? 'one_time');\n        if ($type === 'one_time') {\n            $remaining = max(0, (int)($pref['remaining_count'] ?? 0) - 1);\n            $pref['remaining_count'] = $remaining;\n            $pref['authorization_status'] = $remaining > 0 ? 'accept' : 'consumed';\n        } else {\n            $pref['authorization_status'] = 'accept';\n        }\n        $pref['last_consumed_at'] = gmdate('c');\n        $pref['updated_at'] = gmdate('c');\n        $preferences[$sceneKey] = $pref;\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute('UPDATE system_settings SET setting_value=:value,updated_at=UTC_TIMESTAMP() WHERE setting_key=:key', ['value'=>$json,'key'=>self::subscriptionPreferenceKey($userId)]);\n    }\n\n    /** Caller holds the user's preference lock; only a definite provider rejection releases this reservation. */\n    public static function restoreSubscriptionConsumed(Database $db,int $userId,string $sceneKey,string $templateId): void\n    {\n        $preferences=self::subscriptionPreferences($db,$userId);\n        $pref=$preferences[$sceneKey]??[];\n        if((string)($pref['template_id']??'')!==$templateId||($pref['subscription_type']??'one_time')!=='one_time')return;\n        $pref['remaining_count']=max(0,(int)($pref['remaining_count']??0))+1;\n        if(!in_array($pref['authorization_status']??'',['ban','disabled'],true))$pref['authorization_status']='accept';\n        $pref['updated_at']=gmdate('c');$preferences[$sceneKey]=$pref;\n        $db->execute('UPDATE system_settings SET setting_value=:value,updated_at=UTC_TIMESTAMP() WHERE setting_key=:key',[\n            'value'=>json_encode($preferences,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR),'key'=>self::subscriptionPreferenceKey($userId)]);\n    }\n\n    public static function markSubscriptionPermissionUnavailable(Database $db, int $userId, string $sceneKey): void\n    {\n        $preferences = self::subscriptionPreferences($db, $userId);\n        if (!isset($preferences[$sceneKey]) || !is_array($preferences[$sceneKey])) return;\n        $pref = $preferences[$sceneKey];\n        if ((string)($pref['subscription_type'] ?? 'one_time') === 'one_time') $pref['remaining_count'] = 0;\n        $pref['authorization_status'] = 'consumed';\n        $pref['updated_at'] = gmdate('c');\n        $preferences[$sceneKey] = $pref;\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute('UPDATE system_settings SET setting_value=:value,updated_at=UTC_TIMESTAMP() WHERE setting_key=:key', ['value'=>$json,'key'=>self::subscriptionPreferenceKey($userId)]);\n    }\n\n    private static function subscriptionPreferenceKey(int $userId): string\n    {\n        return 'wechat.subscription.user.'.$userId;\n    }\n}\n\n","server/app/Infrastructure/Persistence/DatabaseAdminRepairResolutionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\AdminRepairResolutionRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/**\n * 平台介入维修裁定。\n *\n * mini_admin 的 users.id 只写带类型的 order_events，不写 after_sales.handled_by；\n * web_admin 的 admin_users.id 与 handled_by 外键同域，可作为后台处理人落库。\n * 资金补偿/退款继续走退款与争议领域，不在本仓储混合处理。\n */\nfinal class DatabaseAdminRepairResolutionRepository implements AdminRepairResolutionRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function resolve(\n        array $operator,\n        string $orderNo,\n        string $afterSaleNo,\n        string $decision,\n        string $note\n    ): array {\n        $channel = trim((string)($operator['channel'] ?? ''));\n        $operatorUserId = (int)($operator['user_id'] ?? 0);\n        if (!in_array($channel, ['mini_admin','web_admin'], true) || $operatorUserId < 1) {\n            throw new OrderOperationException('管理员身份无效', 'ADMIN_REQUIRED', 403);\n        }\n        if (!in_array($decision, ['continue','resolved','closed'], true)) {\n            throw new OrderOperationException('平台售后处理动作无效', 'REPAIR_PLATFORM_DECISION_INVALID', 422);\n        }\n\n        return $this->db->transaction(function (Database $db) use ($channel,$operatorUserId,$orderNo,$afterSaleNo,$decision,$note): array {\n            $order = $db->fetch(\n                'SELECT id,public_no,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $afterSale = $db->fetch(\n                \"SELECT * FROM after_sales\n                 WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair'\n                 LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id'],'public_no'=>$afterSaleNo]\n            );\n            if (!$afterSale) {\n                throw new OrderOperationException('维修售后不存在', 'REPAIR_NOT_FOUND', 404);\n            }\n            if (!in_array((string)$afterSale['status'], ['open','processing'], true)) {\n                throw new OrderOperationException('该售后已结束，请刷新', 'REPAIR_PLATFORM_REVIEW_CHANGED', 409);\n            }\n\n            $currentResolution = (string)($afterSale['resolution'] ?? '');\n            $alreadyContinued = strpos($currentResolution, '平台介入：要求继续维修：') === 0;\n            $hasIntervention = strpos($currentResolution, '用户申请平台介入') === 0;\n            if (!$hasIntervention) {\n                $hasIntervention = (bool)$db->fetchValue(\n                    \"SELECT 1 FROM order_events\n                     WHERE order_id=:order_id AND event_type='repair_platform_intervention_requested'\n                       AND payload_json LIKE :needle\n                     ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                    [\n                        'order_id'=>$order['id'],\n                        'needle'=>'%\"after_sale_id\":\"'.$afterSaleNo.'\"%',\n                    ]\n                );\n            }\n            if (!$hasIntervention) {\n                throw new OrderOperationException(\n                    '请先由用户按规则申请平台介入',\n                    'REPAIR_PLATFORM_INTERVENTION_REQUIRED',\n                    409\n                );\n            }\n            if ($decision === 'continue' && $alreadyContinued) {\n                throw new OrderOperationException(\n                    '平台已要求继续维修，请等待处理后再确认解决或关闭售后',\n                    'REPAIR_PLATFORM_CONTINUE_ALREADY_REQUESTED',\n                    409\n                );\n            }\n\n            $status = 'processing';\n            $resolution = '平台介入：要求继续维修：'.$note;\n            $eventType = 'repair_platform_continue';\n            $message = '平台介入后要求师傅继续维修：'.$note;\n            $closeNow = 0;\n            if ($decision === 'resolved') {\n                $status = 'resolved';\n                $resolution = '平台裁定：问题已解决：'.$note;\n                $eventType = 'repair_platform_resolved';\n                $message = '平台已确认本次售后问题解决：'.$note;\n                $closeNow = 1;\n            } elseif ($decision === 'closed') {\n                $status = 'closed';\n                $resolution = '平台裁定：关闭售后：'.$note;\n                $eventType = 'repair_platform_closed';\n                $message = '平台已关闭本次售后：'.$note;\n                $closeNow = 1;\n            }\n\n            $handledBy = $channel === 'web_admin' ? $operatorUserId : 0;\n            $changed = $db->execute(\n                \"UPDATE after_sales\n                 SET status=:status,resolution=:resolution,\n                     handled_by=IF(:handled_by>0,:handled_by,handled_by),\n                     closed_at=IF(:close_now=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status IN ('open','processing')\",\n                [\n                    'status'=>$status,\n                    'resolution'=>$resolution,\n                    'handled_by'=>$handledBy,\n                    'close_now'=>$closeNow,\n                    'id'=>$afterSale['id'],\n                ]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('该售后状态已变化，请刷新', 'REPAIR_PLATFORM_REVIEW_CHANGED', 409);\n            }\n\n            if ($closeNow === 1) {\n                if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                    (new DatabaseChatRepairEpisodes($db,true))->close((int)$order['id'],(int)$afterSale['id']);\n                }\n                // 售后结束后，尚未处理的维修电话公开申请不再有业务上下文，直接关闭为 rejected。\n                $db->execute(\n                    \"UPDATE order_worker_contact_reveal_requests\n                     SET status='rejected',review_note='售后已由平台结案',reviewed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                     WHERE order_id=:order_id AND after_sale_id=:after_sale_id AND context_type='repair' AND status='pending'\",\n                    ['order_id'=>$order['id'],'after_sale_id'=>$afterSale['id']]\n                );\n            }\n\n            $db->execute(\n                'UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id',\n                ['id'=>$order['id']]\n            );\n\n            $actorType = $channel === 'web_admin' ? 'admin' : 'mini_admin';\n            $eventKey = $eventType.':'.$order['id'].':'.bin2hex(random_bytes(6));\n            $payload = [\n                'after_sale_id'=>$afterSaleNo,\n                'decision'=>$decision,\n                'note'=>$note,\n                'message'=>$message,\n                'operator_channel'=>$channel,\n                'operator_user_id'=>$channel === 'mini_admin' ? $operatorUserId : null,\n                'operator_admin_id'=>$channel === 'web_admin' ? $operatorUserId : null,\n                'notify_recipients'=>['user','worker'],\n            ];\n            $db->insert(\n                'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n                 VALUES(:order_id,:event_type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n                [\n                    'order_id'=>$order['id'],\n                    'event_type'=>$eventType,\n                    'event_key'=>$eventKey,\n                    'actor_type'=>$actorType,\n                    'actor_id'=>$operatorUserId,\n                    'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n                ]\n            );\n            OrderNotificationService::queue($db, (int)$order['id'], $eventKey, $eventType, $payload);\n\n            return [\n                'order_id'=>(string)$order['public_no'],\n                'after_sale_id'=>$afterSaleNo,\n                'status'=>$status,\n                'decision'=>$decision,\n                'order_version'=>(int)$order['version'] + 1,\n            ];\n        });\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseAdminWorkbenchOperationsRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\nuse WorkerAdmin\\Contracts\\AdminWorkbenchOperationsRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Infrastructure\\Scheduling\\PlatformOrderAutoPublishTask;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseAdminWorkbenchOperationsRepository implements AdminWorkbenchOperationsRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db){$this->db=$db;}\n\n    public function reassignWorker(array $actor,string $orderNo,int $workerId,string $reason):array\n    {\n        $miniUserId=(int)($actor['user_id']??0);\n        return $this->db->transaction(function(Database $db)use($orderNo,$workerId,$reason,$miniUserId):array{\n            $order=$db->fetch(\"SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE\",['public_no'=>$orderNo]);\n            if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n            if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                (new DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n            }\n            if((string)$order['lifecycle_status']!=='active'||in_array((string)$order['fulfillment_status'],['submitted','accepted'],true))throw new OrderOperationException('完工已提交、已验收或已结束的订单不能直接改派','ADMIN_REASSIGN_STAGE_BLOCKED',409);\n            if(!in_array((string)($order['refund_status']??'none'),['','none'],true)\n                ||(bool)$db->fetchValue(\"SELECT 1 FROM refunds WHERE order_id=:id AND status NOT IN ('failed','closed','cancelled','rejected') LIMIT 1\",['id'=>$order['id']])\n                ||(bool)$db->fetchValue(\"SELECT 1 FROM order_cancel_requests WHERE order_id=:id AND status IN ('pending','processing') LIMIT 1\",['id'=>$order['id']]))throw new OrderOperationException('订单正在取消或退款处理中，不能直接改派','ADMIN_REASSIGN_FINANCE_BLOCKED',409);\n            if((bool)$db->fetchValue(\"SELECT 1 FROM change_requests WHERE order_id=:id AND status IN ('pending','processing','negotiating') LIMIT 1\",['id'=>$order['id']]))throw new OrderOperationException('订单存在待确认的费用调整，请先处理后再改派','ADMIN_REASSIGN_CHANGE_BLOCKED',409);\n            if((string)($order['order_source_type']??'')==='platform'){$settlement=(string)$db->fetchValue('SELECT settlement_status FROM order_platform_terms WHERE order_id=:id LIMIT 1',['id'=>$order['id']]);if($settlement!==''&&$settlement!=='pending')throw new OrderOperationException('平台单已进入结算阶段，不能直接改派','ADMIN_REASSIGN_SETTLEMENT_BLOCKED',409);}\n\n            $assignmentId=(int)($order['current_assignment_id']??0);\n            $old=$assignmentId>0?$db->fetch(\"SELECT a.*,w.user_id old_worker_user_id,w.display_name old_worker_name FROM assignments a JOIN worker_profiles w ON w.id=a.worker_id WHERE a.id=:id AND a.order_id=:order_id FOR UPDATE\",['id'=>$assignmentId,'order_id'=>$order['id']]):null;\n            if(!$old||!in_array((string)$old['status'],['offered','accepted'],true))throw new OrderOperationException('当前没有可改派的有效师傅指派','ADMIN_REASSIGN_ASSIGNMENT_REQUIRED',409);\n            if((int)$old['worker_id']===$workerId)throw new OrderOperationException('请选择另一位师傅','ADMIN_REASSIGN_SAME_WORKER',409);\n\n            $worker=$db->fetch(\"SELECT w.id,w.user_id,w.public_id,w.display_name,w.verification_status,w.cloud_record_mode,u.status user_status FROM worker_profiles w JOIN users u ON u.id=w.user_id WHERE w.id=:id LIMIT 1 FOR UPDATE\",['id'=>$workerId]);\n            if(!$worker||(string)$worker['verification_status']!=='approved'||(string)$worker['user_status']!=='active')throw new OrderOperationException('新师傅不存在、未审核通过或账号不可用','ADMIN_REASSIGN_WORKER_UNAVAILABLE',422);\n            $orderIsDemo=!empty($order['is_demo']);$workerIsDemo=(string)($worker['cloud_record_mode']??'')==='demo_local';if($orderIsDemo!==$workerIsDemo)throw new OrderOperationException('演示与真实数据环境不能互相改派','DEMO_DATA_BOUNDARY',403);\n            $measurementWorker=$db->fetchValue(\"SELECT worker_id FROM order_relations WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1\",['id'=>$order['id']]);\n            if($measurementWorker!==false&&(int)$measurementWorker!==$workerId)throw new OrderOperationException('关联测量单施工仍绑定原测量师傅；如需更换请新建普通施工单','MEASUREMENT_WORKER_BOUND',409);\n\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id AND status IN ('offered','accepted')\",['id'=>$old['id']]);\n            $db->insert(\"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,snapshot_json,created_at) VALUES(:assignment_id,:order_id,:worker_id,'reassigned',:reason,'mini_admin',:actor_id,:snapshot,UTC_TIMESTAMP())\",[\n                'assignment_id'=>$old['id'],'order_id'=>$order['id'],'worker_id'=>$old['worker_id'],'reason'=>$reason,'actor_id'=>$miniUserId,'snapshot'=>$this->json(['reassigned_to_worker_id'=>$workerId])\n            ]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:order_id AND user_id=:user_id AND status='active'\",['order_id'=>$order['id'],'user_id'=>$old['old_worker_user_id']]);\n            $db->execute(\"UPDATE order_worker_contact_reveal_requests SET status='cancelled',review_note='订单已由管理员改派其他师傅',reviewed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:order_id AND worker_id=:worker_id AND status='pending'\",['order_id'=>$order['id'],'worker_id'=>$old['worker_id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:order_id AND status IN ('active','claimed')\",['order_id'=>$order['id']]);\n\n            $acceptHours=max(1,min(72,(int)(function_exists('setting')?\\setting('order.assignment_accept_hours',24):24)));\n            $newAssignmentId=$db->insert(\"INSERT INTO assignments(public_id,order_id,worker_id,quote_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accept_deadline_at,created_by_admin_id,created_at,updated_at) VALUES(:public_id,:order_id,:worker_id,NULL,'admin',:rule_id,:final_amount,:booking_fee,:rate,:minimum,:commission,:offline,:net,'offered',UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$acceptHours} HOUR),NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n                'public_id'=>\\public_id(),'order_id'=>$order['id'],'worker_id'=>$workerId,'rule_id'=>$old['commission_rule_version_id']?:null,'final_amount'=>$old['final_amount_cents_snapshot'],'booking_fee'=>$old['booking_fee_cents_snapshot'],'rate'=>$old['commission_rate_bp_snapshot'],'minimum'=>$old['commission_min_cents_snapshot'],'commission'=>$old['estimated_commission_cents'],'offline'=>$old['estimated_offline_collect_cents'],'net'=>$old['estimated_net_income_cents']\n            ]);\n            $db->insert(\"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,snapshot_json,created_at) VALUES(:assignment_id,:order_id,:worker_id,'offered',:reason,'mini_admin',:actor_id,:snapshot,UTC_TIMESTAMP())\",[\n                'assignment_id'=>$newAssignmentId,'order_id'=>$order['id'],'worker_id'=>$workerId,'reason'=>$reason,'actor_id'=>$miniUserId,'snapshot'=>$this->json(['reassigned_from_worker_id'=>(int)$old['worker_id'],'requires_worker_acceptance'=>true])\n            ]);\n            $db->execute(\"UPDATE orders SET current_assignment_id=:assignment_id,assigned_worker_id=:worker_id,assignment_status='offered',fulfillment_status='not_started',contact_revealed_at=NULL,updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",['assignment_id'=>$newAssignmentId,'worker_id'=>$workerId,'id'=>$order['id']]);\n\n            $eventKey='admin-reassign:'.$order['id'].':'.$newAssignmentId;\n            $payload=['message'=>'平台已改派师傅；新师傅仍需本人确认接单','old_worker_id'=>(int)$old['worker_id'],'old_worker_name'=>(string)$old['old_worker_name'],'new_worker_id'=>$workerId,'new_worker_name'=>(string)$worker['display_name'],'reason'=>$reason,'operator_user_id'=>$miniUserId,'notify_recipients'=>['user','worker']];\n            $db->insert(\"INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,'worker_replaced_by_admin',:event_key,'mini_admin',:actor_id,:payload,UTC_TIMESTAMP())\",['order_id'=>$order['id'],'event_key'=>substr($eventKey,0,128),'actor_id'=>$miniUserId,'payload'=>$this->json($payload)]);\n            OrderNotificationService::queue($db,(int)$order['id'],$eventKey,'worker_replaced_by_admin',$payload);\n\n            $oldNoticeData=$this->json(['order_id'=>(int)$order['id'],'event_key'=>$eventKey,'reassigned_to_worker_id'=>$workerId]);\n            $oldNoticeExists=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='worker_replaced_by_admin_old' AND BINARY data_json=BINARY :data LIMIT 1\",['worker_id'=>$old['worker_id'],'data'=>$oldNoticeData]);\n            if(!$oldNoticeExists){\n                $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:worker_id,'in_app','worker_replaced_by_admin_old','订单已由平台改派',:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n                    'public_id'=>\\public_id(),'worker_id'=>$old['worker_id'],'content'=>'订单 '.(string)$order['public_no'].' 已由平台改派其他师傅，本单访问权限已收回。原因：'.mb_substr($reason,0,120),'data'=>$oldNoticeData,\n                ]);\n            }\n            return ['order_id'=>(string)$order['public_no'],'assignment_id'=>$newAssignmentId,'old_worker'=>['id'=>(int)$old['worker_id'],'name'=>(string)$old['old_worker_name']],'new_worker'=>['id'=>$workerId,'name'=>(string)$worker['display_name']],'assignment_status'=>'offered','requires_worker_acceptance'=>true];\n        });\n    }\n\n    public function interveneRepair(array $actor,string $orderNo,string $afterSaleNo,string $reason):array\n    {\n        $miniUserId=(int)($actor['user_id']??0);\n        return $this->db->transaction(function(Database $db)use($orderNo,$afterSaleNo,$reason,$miniUserId):array{\n            $order=$db->fetch('SELECT id,public_no,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n            $repair=$db->fetch(\"SELECT id,public_no,status,resolution FROM after_sales WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair' LIMIT 1 FOR UPDATE\",['order_id'=>$order['id'],'public_no'=>$afterSaleNo]);\n            if(!$repair||!in_array((string)$repair['status'],['open','processing'],true))throw new OrderOperationException('维修申请不存在或已结束','REPAIR_NOT_ACTIVE',409);\n            $already=strpos((string)($repair['resolution']??''),'平台主动介入：')===0||(bool)$db->fetchValue(\"SELECT 1 FROM order_events WHERE order_id=:order_id AND event_type='repair_platform_intervention_started' AND payload_json LIKE :needle LIMIT 1\",['order_id'=>$order['id'],'needle'=>'%\\\"after_sale_id\\\":\\\"'.$afterSaleNo.'\\\"%']);\n            if($already)return ['order_id'=>$orderNo,'after_sale_id'=>$afterSaleNo,'status'=>'processing','already_intervened'=>true];\n            $db->execute(\"UPDATE after_sales SET status='processing',resolution=:resolution,updated_at=UTC_TIMESTAMP() WHERE id=:id\",['resolution'=>'平台主动介入：'.$reason,'id'=>$repair['id']]);\n            $db->execute('UPDATE orders SET updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id',['id'=>$order['id']]);\n            $eventKey='admin-repair-intervention:'.$repair['id'];$payload=['after_sale_id'=>$afterSaleNo,'reason'=>$reason,'message'=>'平台已主动介入本次维修售后','operator_user_id'=>$miniUserId,'notify_recipients'=>['user','worker']];\n            $db->insert(\"INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,'repair_platform_intervention_started',:event_key,'mini_admin',:actor_id,:payload,UTC_TIMESTAMP())\",['order_id'=>$order['id'],'event_key'=>$eventKey,'actor_id'=>$miniUserId,'payload'=>$this->json($payload)]);\n            OrderNotificationService::queue($db,(int)$order['id'],$eventKey,'repair_platform_intervention_started',$payload);\n            return ['order_id'=>$orderNo,'after_sale_id'=>$afterSaleNo,'status'=>'processing','already_intervened'=>false];\n        });\n    }\n\n    public function retryPlatformAutoPublish(array $actor,string $orderNo,string $sourceId):array\n    {\n        $order=$this->db->fetch(\"SELECT id,public_no,order_source_type,publish_status FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1\",['public_no'=>$orderNo]);\n        if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);if((string)$order['order_source_type']!=='platform')throw new OrderOperationException('只有平台承接单支持自动发布恢复','AUTO_PUBLISH_RETRY_NOT_PLATFORM',409);\n        $failure=$this->db->fetch(\"SELECT id FROM scheduled_job_failures WHERE job_name='platform_auto_publish' AND business_key=:business_key AND resolved_at IS NULL ORDER BY id DESC LIMIT 1\",['business_key'=>'order:'.(int)$order['id']]);\n        if($sourceId!==''&&$failure&&ctype_digit($sourceId)&&(int)$failure['id']!==(int)$sourceId)throw new OrderOperationException('该失败事项已经变化，请刷新后重试','ADMIN_RETRY_STALE_TASK',409);\n        $result=(new PlatformOrderAutoPublishTask($this->db,1))->retryOrder((int)$order['id']);if(empty($result['ok']))throw new OrderOperationException((string)($result['message']??'当前条件仍不满足自动发布'),'ADMIN_RETRY_NOT_READY',409);\n        $this->internalRevision((int)$order['id'],'admin_internal_recovery',(int)($actor['user_id']??0),['note'=>'管理员手动重新检查平台自动发布','result'=>(string)($result['status']??'')]);\n        return ['order_id'=>$orderNo]+$result;\n    }\n\n    public function addInternalFollowup(array $actor,string $orderNo,string $note,?string $followUpAt):array\n    {\n        $order=$this->db->fetch('SELECT id,public_no FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n        $utc=$this->normalizeFollowupTime($followUpAt);$revisionId=$this->internalRevision((int)$order['id'],'admin_internal_followup',(int)($actor['user_id']??0),['note'=>$note,'follow_up_at'=>$utc]);\n        return ['order_id'=>$orderNo,'followup_event_id'=>$revisionId,'note'=>$note,'follow_up_at'=>$utc,'completed'=>false];\n    }\n\n    public function completeInternalFollowup(array $actor,string $orderNo,int $followupEventId,string $note):array\n    {\n        $order=$this->db->fetch('SELECT id,public_no FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n        $followup=$this->db->fetch(\"SELECT id FROM order_revisions WHERE id=:id AND order_id=:order_id AND operator_type='mini_admin' AND JSON_UNQUOTE(JSON_EXTRACT(changes_json,'$.kind'))='admin_internal_followup' LIMIT 1\",['id'=>$followupEventId,'order_id'=>$order['id']]);\n        if(!$followup)throw new OrderOperationException('跟进事项不存在','ADMIN_FOLLOWUP_NOT_FOUND',404);\n        $completed=(bool)$this->db->fetchValue(\"SELECT 1 FROM order_revisions WHERE order_id=:order_id AND operator_type='mini_admin' AND CAST(JSON_UNQUOTE(JSON_EXTRACT(changes_json,'$.completed_of')) AS UNSIGNED)=:completed_of LIMIT 1\",['order_id'=>$order['id'],'completed_of'=>$followupEventId]);\n        if(!$completed)$this->internalRevision((int)$order['id'],'admin_internal_followup_completed',(int)($actor['user_id']??0),['completed_of'=>$followupEventId,'note'=>$note]);\n        return ['order_id'=>$orderNo,'followup_event_id'=>$followupEventId,'completed'=>true];\n    }\n\n    public function workerOptions(string $orderNo,string $keyword,int $limit):array\n    {\n        $order=$this->db->fetch('SELECT id,is_demo,assigned_worker_id FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n        $limit=max(1,min(50,$limit));$params=[];$where=[\"w.verification_status='approved'\",\"u.status='active'\",!empty($order['is_demo'])?\"w.cloud_record_mode='demo_local'\":\"COALESCE(w.cloud_record_mode,'')<>'demo_local'\"];\n        if($keyword!==''){$where[]='(w.display_name LIKE :q_name OR w.public_id LIKE :q_public OR w.mobile_masked LIKE :q_mobile)';$like='%'.mb_substr($keyword,0,50).'%';$params=['q_name'=>$like,'q_public'=>$like,'q_mobile'=>$like];}\n        $rows=$this->db->fetchAll(\"SELECT w.id,w.public_id,w.display_name,w.mobile_masked,w.verification_status FROM worker_profiles w JOIN users u ON u.id=w.user_id WHERE \".implode(' AND ',$where).\" ORDER BY (w.id=:current_worker) DESC,w.id DESC LIMIT {$limit}\",$params+['current_worker'=>(int)($order['assigned_worker_id']??0)]);\n        foreach($rows as &$row){$row['id']=(int)$row['id'];$row['is_current']=$row['id']===(int)($order['assigned_worker_id']??0);}unset($row);return $rows;\n    }\n\n    public function internalFollowups(string $orderNo,int $limit):array\n    {\n        $orderId=(int)$this->db->fetchValue('SELECT id FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if($orderId<1)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);$limit=max(1,min(50,$limit));\n        $rows=$this->db->fetchAll(\"SELECT r.id,r.changes_json,r.created_at,r.operator_id,EXISTS(SELECT 1 FROM order_revisions c WHERE c.order_id=r.order_id AND c.operator_type='mini_admin' AND CAST(JSON_UNQUOTE(JSON_EXTRACT(c.changes_json,'$.completed_of')) AS UNSIGNED)=r.id) completed FROM order_revisions r WHERE r.order_id=:order_id AND r.operator_type='mini_admin' AND JSON_UNQUOTE(JSON_EXTRACT(r.changes_json,'$.kind'))='admin_internal_followup' ORDER BY r.id DESC LIMIT {$limit}\",['order_id'=>$orderId]);\n        $items=[];$now=time();foreach($rows as $row){$payload=json_decode((string)$row['changes_json'],true);if(!is_array($payload))$payload=[];$followAt=trim((string)($payload['follow_up_at']??''));$ts=$followAt!==''?strtotime($followAt.' UTC'):false;$items[]=['id'=>(int)$row['id'],'note'=>(string)($payload['note']??''),'follow_up_at'=>$followAt?:null,'created_at'=>(string)$row['created_at'],'operator_user_id'=>(int)($row['operator_id']??0),'completed'=>(bool)$row['completed'],'due'=>!(bool)$row['completed']&&$ts!==false&&$ts<=$now];}return $items;\n    }\n\n    private function normalizeFollowupTime(?string $value):?string\n    {\n        $value=trim((string)$value);if($value==='')return null;try{$timezone=(string)(function_exists('app_config')?\\app_config('app.timezone','Asia/Shanghai'):'Asia/Shanghai');return(new DateTimeImmutable($value,new DateTimeZone($timezone)))->setTimezone(new DateTimeZone('UTC'))->format('Y-m-d H:i:s');}catch(Throwable $e){throw new OrderOperationException('跟进时间格式不正确','ADMIN_FOLLOWUP_TIME_INVALID',422);}\n    }\n\n    private function internalRevision(int $orderId,string $kind,int $actorId,array $payload):int\n    {\n        $version=(int)$this->db->fetchValue('SELECT version FROM orders WHERE id=:id LIMIT 1',['id'=>$orderId]);$changes=['kind'=>$kind]+$payload+['visibility'=>'internal'];\n        return $this->db->insert(\"INSERT INTO order_revisions(order_id,version_before,version_after,changes_json,reason,operator_type,operator_id,created_at) VALUES(:order_id,:version_before,:version_after,:changes,:reason,'mini_admin',:operator_id,UTC_TIMESTAMP())\",['order_id'=>$orderId,'version_before'=>$version,'version_after'=>$version,'changes'=>$this->json($changes),'reason'=>$kind==='admin_internal_followup'?'管理员内部跟进':($kind==='admin_internal_followup_completed'?'管理员完成内部跟进':'管理员恢复操作'),'operator_id'=>$actorId]);\n    }\n\n    private function json(array $payload):string{$json=json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);return is_string($json)?$json:'{}';}\n}\n","server/app/Infrastructure/Persistence/DatabaseChatPlatformStaff.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Application\\Identity\\ActorCapabilityResolver;\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Core\\Database;\n\n/** Current real mini-admin facts; no cached setting(), backend admin IDs or tokens. */\nfinal class DatabaseChatPlatformStaff\n{\n    private Database $db;\n\n    public function __construct(Database $db) { $this->db = $db; }\n\n    /**\n     * Current facts for OrderConversationPolicy; never writes memberships.\n     * Caller must own the order transaction; all source rows remain shared-locked.\n     * Lock order: source rows, per-user authority versions, configuration version.\n     */\n    public function readLocked(): array\n    { return $this->readAuthorityLocked()['platform_staff']; }\n\n    public function readAuthorityLocked(): array\n    {\n        if (!$this->db->pdo()->inTransaction()) throw new RuntimeException('平台聊天身份必须在订单事务内解析');\n        $values = [];\n        $rows = $this->db->fetchAll(\n            \"SELECT setting_key,setting_value,value_type FROM system_settings\n             WHERE setting_key IN ('wechat.admin_openids','wechat.miniapp_appid')\n             ORDER BY setting_key LOCK IN SHARE MODE\"\n        );\n        foreach ($rows as $row) {\n            $value = $row['setting_value'];\n            // These identity settings are plaintext. Unknown/encrypted legacy data\n            // cannot silently use a request-local cache or an alternate app ID.\n            if (!is_string($value) || strlen($value) > 8192 || strncmp($value, 'enc:v1:', 7) === 0) return $this->authority([]);\n            if ($row['value_type'] === 'json') {\n                $value = json_decode($value, true);\n                if (json_last_error() !== JSON_ERROR_NONE) return $this->authority([]);\n            } elseif ($row['value_type'] !== 'string') return $this->authority([]);\n            $values[$row['setting_key']] = $value;\n        }\n        $settings = new class($values) implements SettingsProvider {\n            private array $values;\n            public function __construct(array $values) { $this->values = $values; }\n            public function get(string $key, $default = null) { return $this->values[$key] ?? $default; }\n            public function bool(string $key, bool $default = false): bool { return $default; }\n            public function int(string $key, int $default = 0): int { return $default; }\n        };\n        $capabilities = new ActorCapabilityResolver($settings);\n        $configured = $settings->get('wechat.admin_openids', []);\n        if (is_string($configured)) {\n            $decoded = json_decode($configured, true);\n            if (is_array($decoded)) $configured = $decoded;\n        }\n        if (is_array($configured)) foreach ($configured as $value) if (!is_string($value)) return $this->authority([]);\n        if (!is_array($configured) && !is_string($configured)) return $this->authority([]);\n        $openids = $capabilities->adminOpenIds();\n        $app = $settings->get('wechat.miniapp_appid', '');\n        if (!is_string($app) || trim($app) === '' || count($openids) < 1 || count($openids) > 8) return $this->authority([]);\n        $params = ['app'=>trim($app)]; $slots = [];\n        foreach ($openids as $i=>$openid) { $slots[] = ':openid'.$i; $params['openid'.$i] = $openid; }\n        $identities = $this->db->fetchAll(\n            \"SELECT CAST(u.id AS CHAR) actor_id,u.status,wi.openid payer_openid\n             FROM wechat_identities wi JOIN users u ON u.id=wi.user_id AND u.status='active'\n             WHERE wi.status='active' AND BINARY wi.app_id=BINARY :app\n               AND BINARY wi.openid IN (\".implode(',', $slots).\")\n             ORDER BY u.id,wi.id LIMIT 9 LOCK IN SHARE MODE\", $params\n        );\n        if (count($identities) > 8) return $this->authority([]);\n        $staff = [];\n        foreach ($identities as $actor) {\n            // Explicit current locking read: a correlated MAX subquery can retain\n            // an earlier REPEATABLE READ snapshot even inside an outer lock read.\n            $current = $this->db->fetch(\n                \"SELECT openid payer_openid FROM wechat_identities\n                 WHERE user_id=:user AND status='active' AND BINARY app_id=BINARY :app\n                 ORDER BY id DESC LIMIT 1 LOCK IN SHARE MODE\",\n                ['user'=>$actor['actor_id'],'app'=>trim($app)]\n            );\n            if (!$current || !$capabilities->isMiniAdmin($current)) continue;\n            $staff[(string)$actor['actor_id']] = ['actor_id'=>(string)$actor['actor_id'],'kind'=>'mini','status'=>'active','is_mini_admin'=>true,\n                'authority_version'=>$this->versionLocked((string)$actor['actor_id'])];\n        }\n        return $this->authority(array_values($staff));\n    }\n    private function authority(array $staff): array\n    {\n        return ['platform_staff'=>$staff,'staff_config_version'=>$this->versionLocked('0')];\n    }\n\n    private function versionLocked(string $user): string\n    {\n        $version=$this->db->fetchValue('SELECT CAST(authority_version AS CHAR) FROM chat_staff_authority_versions WHERE user_id=:id LOCK IN SHARE MODE',['id'=>$user]);\n        if (!is_string($version) || preg_match('/^[1-9][0-9]{0,19}$/D',$version)!==1) throw new RuntimeException('平台聊天权限代次不可用');\n        return $version;\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseChatPolicyMaintenance.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse InvalidArgumentException;\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\n\n/** Bounded, resumable PHP projection only; never creates a Go message or interval. */\nfinal class DatabaseChatPolicyMaintenance\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db=$db; }\n\n    /** Read-only enablement gate; it neither toggles features nor changes epochs. */\n    public function preflight(): array\n    {\n        $expected=['chat_staff_settings_insert'=>'system_settings','chat_staff_settings_update'=>'system_settings','chat_staff_settings_delete'=>'system_settings',\n            'chat_staff_user_insert'=>'users','chat_staff_user_update'=>'users','chat_staff_user_delete'=>'users',\n            'chat_staff_wechat_insert'=>'wechat_identities','chat_staff_wechat_update'=>'wechat_identities','chat_staff_wechat_delete'=>'wechat_identities'];\n        $rows=$this->db->fetchAll(\"SELECT TRIGGER_NAME,EVENT_OBJECT_TABLE,ACTION_TIMING,EVENT_MANIPULATION\n            FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME LIKE 'chat_staff_%'\");\n        $actual=[];\n        foreach($rows as $row){\n            $name=(string)$row['TRIGGER_NAME'];\n            if(!isset($expected[$name]))continue;\n            if($row['ACTION_TIMING']!=='AFTER' || strtolower((string)$row['EVENT_MANIPULATION'])!==substr($name,strrpos($name,'_')+1)\n                || $row['EVENT_OBJECT_TABLE']!==$expected[$name])throw new RuntimeException('工作人员撤权触发器定义不匹配');\n            $actual[$name]=true;\n        }\n        if(count($actual)!==count($expected))throw new RuntimeException('工作人员撤权触发器缺失或不可核验');\n        $tables=['chat_policy_guards','chat_business_events','chat_repair_episodes','chat_staff_authority_versions','chat_policy_refresh',\n            'order_platform_terms','order_pricing_items','platform_order_refund_reviews','platform_order_manual_receipts'];\n        foreach($tables as $table)if(!$this->db->tableExists($table))throw new RuntimeException('聊天授权依赖表缺失');\n        $config=$this->db->fetchValue('SELECT CAST(authority_version AS CHAR) FROM chat_staff_authority_versions WHERE user_id=0');\n        $missing=(int)$this->db->fetchValue('SELECT COUNT(*) FROM users u LEFT JOIN chat_staff_authority_versions a ON a.user_id=u.id WHERE a.user_id IS NULL OR a.authority_version=0');\n        if(!$config || $config==='0' || $missing>0)throw new RuntimeException('聊天权限代次种子缺失');\n        return ['ready'=>true,'schema_target'=>'2.7.0','revocation_triggers'=>count($actual),'policy_enabled'=>$this->enabled()];\n    }\n\n    public function backfill(int $after,int $limit=100,bool $apply=false): array\n    {\n        if($after<0 || $limit<1 || $limit>100) throw new InvalidArgumentException('回填游标无效或每批超过100笔');\n        if($apply && !$this->enabled()) throw new RuntimeException('订单聊天授权开关未启用，不能执行回填');\n        $this->preflight();\n        $rows=$this->db->fetchAll(\"SELECT o.id FROM orders o WHERE o.id>:after AND o.is_demo=0\n            AND ((o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL)\n                OR EXISTS(SELECT 1 FROM chat_policy_guards g WHERE g.order_id=o.id)\n                OR EXISTS(SELECT 1 FROM chat_repair_episodes e WHERE e.active_order_id=o.id))\n            ORDER BY o.id LIMIT \".($limit+1),['after'=>$after]);\n        $more=count($rows)>$limit;$rows=array_slice($rows,0,$limit);\n        $result=['mode'=>$apply?'apply':'dry_run','scanned'=>0,'changed'=>0,'next_after'=>$after,'has_more'=>$more];\n        foreach($rows as $row){\n            $id=(int)$row['id'];\n            $scopes=$this->db->transaction(function()use($id,$apply):array{\n                return (new DatabaseOrderConversationBridge($this->db,$apply))->synchronize($id,$apply);\n            });\n            $result['scanned']++;$result['changed']+=count($scopes);$result['next_after']=$id;\n        }\n        return $result;\n    }\n\n    /** Existing all scheduler calls once; LIMIT is a hard per-run budget. */\n    public function refresh(int $limit=100): array\n    {\n        $limit=max(1,min(100,$limit));\n        $result=['task'=>'chat_policy_refresh','status'=>'success','scanned'=>0,'success'=>0,'failure'=>0];\n        if(!$this->enabled())return $result;\n        if((int)$this->db->fetchValue(\"SELECT GET_LOCK(CONCAT('chat-policy:',SHA1(DATABASE())),0)\")!==1){$result['status']='skipped';return $result;}\n        try{\n            $rows=$this->db->fetchAll(\"SELECT g.order_id FROM chat_policy_guards g\n                JOIN orders o ON o.id=g.order_id AND o.order_source_type='platform' AND o.is_demo=0\n                LEFT JOIN chat_policy_refresh r ON r.order_id=g.order_id\n                WHERE g.state='open' AND (r.order_id IS NULL OR r.next_check_at<=UTC_TIMESTAMP())\n                ORDER BY COALESCE(r.next_check_at,'1970-01-01'),g.order_id LIMIT {$limit}\");\n            foreach($rows as $row){\n                $id=(int)$row['order_id'];$result['scanned']++;\n                try{\n                    $this->db->transaction(function()use($id):void{(new DatabaseOrderConversationBridge($this->db,true))->synchronize($id);});\n                    $result['success']++;\n                    $this->db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP()\n                        WHERE job_name='chat_policy_refresh' AND business_key=:key AND resolved_at IS NULL\",['key'=>'order:'.$id]);\n                }catch(Throwable $error){\n                    $result['failure']++;$result['status']='failed';\n                    // A broken first row cannot starve later work. No SQL, token,\n                    // identity list or message content is copied to diagnostics.\n                    $this->db->execute(\"INSERT INTO chat_policy_refresh(order_id,checked_at,next_check_at,status)\n                        VALUES(:id,UTC_TIMESTAMP(),UTC_TIMESTAMP()+INTERVAL 5 MINUTE,'failed')\n                        ON DUPLICATE KEY UPDATE checked_at=VALUES(checked_at),next_check_at=VALUES(next_check_at),status='failed'\",['id'=>$id]);\n                    $this->db->execute(\"INSERT INTO scheduled_job_failures(job_name,business_key,business_version,error_class,error_message,next_retry_at,created_at)\n                        VALUES('chat_policy_refresh',:key,1,'CHAT_POLICY_REFRESH_FAILED','聊天授权投影恢复失败，请检查事务与升级状态',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())\",['key'=>'order:'.$id]);\n                }\n            }\n        }finally{$this->db->fetchValue(\"SELECT RELEASE_LOCK(CONCAT('chat-policy:',SHA1(DATABASE())))\");}\n        return $result;\n    }\n\n    private function enabled(): bool\n    {return function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true;}\n}\n","server/app/Infrastructure/Persistence/DatabaseChatRepairEpisodes.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n\n/** Called only after the owning PHP repair command has authorized its actor. */\nfinal class DatabaseChatRepairEpisodes\n{\n    private Database $db;\n    private bool $enabled;\n    public function __construct(Database $db,bool $enabled=false){$this->db=$db;$this->enabled=$enabled;}\n\n    /** Record the worker's explicit acceptance, never infer it from processing. */\n    public function acceptWorker(int $orderId,int $afterSaleId,int $workerId): ?string\n    {\n        if(!$this->enabled)return null;\n        $order=$this->lockOrder($orderId);\n        // Unsupported order profiles retain their existing repair workflow.\n        // They never gain a chat episode until their own S04 policy is defined.\n        if((int)$order['is_demo']!==0 || (string)$order['workflow_profile']!=='construction'\n            || !in_array((string)$order['order_source_type'],['consumer','merchant','platform'],true))return null;\n        $assignment=$this->db->fetch(\n            'SELECT a.*,w.user_id worker_user_id,u.status worker_user_status FROM assignments a\n             JOIN worker_profiles w ON w.id=a.worker_id JOIN users u ON u.id=w.user_id\n             WHERE a.id=:id AND a.order_id=:order_id FOR UPDATE',\n            ['id'=>$order['current_assignment_id']??0,'order_id'=>$orderId]\n        );\n        $repair=$this->db->fetch('SELECT * FROM after_sales WHERE id=:id AND order_id=:order_id FOR UPDATE',['id'=>$afterSaleId,'order_id'=>$orderId]);\n        $customer=$this->db->fetch('SELECT status FROM users WHERE id=:id LOCK IN SHARE MODE',['id'=>$order['user_id']]);\n        $platform=(string)$order['order_source_type']==='platform';\n        $terms=$platform?$this->db->fetch('SELECT customer_flow_mode FROM order_platform_terms WHERE order_id=:id LOCK IN SHARE MODE',['id'=>$orderId]):null;\n        if((int)$order['is_demo']!==0 || (string)$order['lifecycle_status']!=='completed'\n            || (string)$order['payment_status']!==($platform?'not_required':'paid') || (string)$order['workflow_profile']!=='construction'\n            || ($platform && (($terms['customer_flow_mode']??'')!=='platform_managed' || (int)$order['booking_fee_cents']!==0))\n            || !$assignment || (int)$assignment['worker_id']!==$workerId || (int)($order['assigned_worker_id']??0)!==$workerId\n            || !in_array((string)$assignment['status'],['accepted','completed'],true) || empty($assignment['accepted_at'])\n            || (string)$assignment['worker_user_status']!=='active'\n            || !in_array($customer['status']??'', $platform?['active','platform_unbound']:['active'],true)\n            || (string)$assignment['worker_user_id']===(string)$order['user_id']\n            || !$repair || (string)$repair['type']!=='warranty_repair' || (string)$repair['status']!=='processing'\n            || !empty($repair['closed_at']) || (string)$repair['user_id']!==(string)$order['user_id']) {\n            throw new RuntimeException('售后聊天受理事实不满足真实订单与指派边界');\n        }\n        $current=$this->db->fetch('SELECT * FROM chat_repair_episodes WHERE active_order_id=:id FOR UPDATE',['id'=>$orderId]);\n        if($current){\n            if((string)$current['assignment_id']!==(string)$assignment['id'] || (int)$current['after_sale_id']!==$afterSaleId\n                || (int)$current['worker_id']!==$workerId || (string)$current['accepted_user_id']!==(string)$assignment['worker_user_id']) {\n                throw new RuntimeException('订单已有其他有效售后受理区间');\n            }\n            (new DatabaseOrderConversationBridge($this->db,true))->schedule($orderId);\n            return (string)$current['id'];\n        }\n        $id=$this->db->insert(\"INSERT INTO chat_repair_episodes(order_id,assignment_id,after_sale_id,worker_id,accepted_user_id,state,accepted_at)\n            VALUES(:order_id,:assignment_id,:after_sale_id,:worker_id,:user_id,'active',UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'assignment_id'=>$assignment['id'],'after_sale_id'=>$afterSaleId,'worker_id'=>$workerId,'user_id'=>$assignment['worker_user_id']]);\n        (new DatabaseOrderConversationBridge($this->db,true))->schedule($orderId);\n        return (string)$id;\n    }\n\n    /** A future acceptance must INSERT a new immutable episode, never reopen this row. */\n    public function close(int $orderId,int $afterSaleId): void\n    {\n        if(!$this->enabled)return;\n        $this->lockOrder($orderId);\n        $this->db->execute(\"UPDATE chat_repair_episodes SET state='closed',closed_at=UTC_TIMESTAMP()\n            WHERE order_id=:order_id AND after_sale_id=:after_sale_id AND state='active'\",['order_id'=>$orderId,'after_sale_id'=>$afterSaleId]);\n        (new DatabaseOrderConversationBridge($this->db,true))->schedule($orderId);\n    }\n\n    private function lockOrder(int $id): array\n    {\n        if($id<1 || !$this->db->pdo()->inTransaction())throw new RuntimeException('售后聊天事实必须加入原订单事务');\n        $order=$this->db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE',['id'=>$id]);\n        if(!$order)throw new RuntimeException('售后订单不存在');\n        return $order;\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseDemoOrderWriteGuard.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\nfinal class DatabaseDemoOrderWriteGuard\n{\n    private Database $db;\n\n    public function __construct(Database $db) { $this->db = $db; }\n\n    public function run(string $orderNo, callable $operation): array\n    {\n        $params = ['lock_name'=>'wall_worker_admin_demo_guard'];\n        if ((int)$this->db->fetchValue('SELECT GET_LOCK(:lock_name,5)', $params) !== 1) {\n            throw new OrderOperationException('演示数据设置正在变更，请稍后重试。', 'DEMO_SETTING_BUSY', 409);\n        }\n        try {\n            // Locking read bypasses the HTTP settings cache and any earlier transaction snapshot.\n            $setting = $this->db->fetch(\n                \"SELECT setting_value FROM system_settings WHERE setting_key='demo.data_enabled' LOCK IN SHARE MODE\"\n            );\n            $enabled = !$setting || in_array(strtolower((string)$setting['setting_value']), ['1','true','yes','on'], true);\n            if (!$enabled) {\n                $order = $this->db->fetch(\n                    'SELECT is_demo,public_no FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',\n                    ['public_no'=>$orderNo]\n                );\n                if ($order && (!empty($order['is_demo']) || stripos((string)$order['public_no'], 'DEMO') !== false)) {\n                    throw new OrderOperationException('演示数据已关闭，该演示记录不可继续处理。', 'DEMO_DATA_DISABLED', 403);\n                }\n            }\n            return $operation();\n        } finally {\n            try { $this->db->fetchValue('SELECT RELEASE_LOCK(:lock_name)', $params); }\n            catch (Throwable $exception) { /* Connection close also releases the advisory lock. */ }\n        }\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseMessageOutboxRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse Throwable;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\MessageOutboxRepository;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy;\n\nfinal class DatabaseMessageOutboxRepository implements MessageOutboxRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function schema(): array\n    {\n        try {\n            $exists = (int) $this->db->fetchValue(\"SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='message_outbox'\");\n            if ($exists < 1) {\n                return [\n                    'ready' => false,\n                    'columns' => [],\n                    'message' => '消息发送记录表尚未建立，请先在系统升级页完成当前版本数据库升级。',\n                ];\n            }\n\n            $columnRows = $this->db->fetchAll('SHOW COLUMNS FROM message_outbox');\n            $columns = [];\n            foreach ($columnRows as $columnRow) {\n                $field = (string) ($columnRow['Field'] ?? $columnRow['field'] ?? '');\n                if ($field !== '') $columns[$field] = true;\n            }\n            $required = ['id', 'topic', 'business_key', 'status'];\n            $missing = array_values(array_filter($required, static function (string $field) use ($columns): bool {\n                return !isset($columns[$field]);\n            }));\n            if ($missing) {\n                \\write_log('admin-message-outbox', '[' . date('c') . '] schema missing columns: ' . implode(',', $missing) . \"\\n\");\n                return [\n                    'ready' => false,\n                    'columns' => $columns,\n                    'message' => '消息发送记录表结构与当前版本不一致，请先完成数据库升级后再查看。',\n                ];\n            }\n            return ['ready' => true, 'columns' => $columns, 'message' => ''];\n        } catch (Throwable $exception) {\n            \\write_log('admin-message-outbox', '[' . date('c') . '] schema read failed: ' . mb_substr($exception->getMessage(), 0, 500) . \"\\n\");\n            return [\n                'ready' => false,\n                'columns' => [],\n                'message' => '消息发送记录暂时无法读取，请检查数据库升级状态后重试。',\n            ];\n        }\n    }\n\n    public function dashboard(string $status, string $q, int $page, string $tab = 'records'): array\n    {\n        $result = ['rows'=>[], 'total'=>0, 'page'=>1, 'pages'=>1, 'per_page'=>20];\n        $suppressionResult = ['rows'=>[], 'total'=>0, 'page'=>1, 'pages'=>1, 'per_page'=>20];\n        $failedCount = 0;\n        $schema = $this->schema();\n        $schemaWarning = (string) ($schema['message'] ?? '');\n\n        if (!empty($schema['ready'])) {\n            $columns = (array) ($schema['columns'] ?? []);\n            $has = static function (string $field) use ($columns): bool { return isset($columns[$field]); };\n            try {\n                $where = ['1=1'];\n                $params = [];\n                if ($status !== '') {\n                    $where[] = 'm.status=:status';\n                    $params['status'] = $status;\n                }\n                if ($q !== '') {\n                    $like = '%' . $q . '%';\n                    $searchParts = ['CAST(m.business_key AS CHAR CHARACTER SET utf8mb4) COLLATE utf8mb4_general_ci LIKE :q_key'];\n                    $params['q_key'] = $like;\n                    if ($has('last_error')) {\n                        $searchParts[] = 'CAST(m.last_error AS CHAR CHARACTER SET utf8mb4) COLLATE utf8mb4_general_ci LIKE :q_error';\n                        $params['q_error'] = $like;\n                    }\n                    if ($has('payload_json')) {\n                        $searchParts[] = 'CAST(m.payload_json AS CHAR CHARACTER SET utf8mb4) COLLATE utf8mb4_general_ci LIKE :q_payload';\n                        $params['q_payload'] = $like;\n                    }\n                    $where[] = '(' . implode(' OR ', $searchParts) . ')';\n                }\n\n                $paidSmsReady = $this->db->tableExists('order_worker_sms_invites') && $this->db->tableExists('order_worker_sms_batches');\n                $select = [\n                    'm.id', 'm.topic', 'm.business_key', 'm.status',\n                    $has('payload_json') ? 'm.payload_json AS _payload_json' : 'NULL AS _payload_json',\n                    $has('attempt_count') ? 'm.attempt_count' : '0 AS attempt_count',\n                    $has('next_attempt_at') ? 'm.next_attempt_at' : 'NULL AS next_attempt_at',\n                    $has('last_error') ? 'm.last_error' : 'NULL AS last_error',\n                    $has('created_at') ? 'm.created_at' : 'NULL AS created_at',\n                    $has('processed_at') ? 'm.processed_at' : ($has('updated_at') ? 'm.updated_at AS processed_at' : 'NULL AS processed_at'),\n                ];\n                $join = '';\n                if ($paidSmsReady) {\n                    $select[] = 'psi.delivery_status AS paid_delivery_status';\n                    $select[] = 'psi.billing_status AS paid_billing_status';\n                    $select[] = 'psi.worker_name_snapshot AS paid_worker_name';\n                    $select[] = 'psi.fee_cents_snapshot AS paid_fee_cents';\n                    $select[] = 'psb.public_no AS paid_batch_no';\n                    $join = ' LEFT JOIN order_worker_sms_invites psi ON psi.outbox_id=m.id LEFT JOIN order_worker_sms_batches psb ON psb.id=psi.batch_id';\n                } else {\n                    $select[] = 'NULL AS paid_delivery_status';\n                    $select[] = 'NULL AS paid_billing_status';\n                    $select[] = 'NULL AS paid_worker_name';\n                    $select[] = 'NULL AS paid_fee_cents';\n                    $select[] = 'NULL AS paid_batch_no';\n                }\n                $result = $this->paginate(\n                    'SELECT ' . implode(',', $select) . ' FROM message_outbox m' . $join . ' WHERE ' . implode(' AND ', $where) . ' ORDER BY m.id DESC',\n                    'SELECT COUNT(*) FROM message_outbox m WHERE ' . implode(' AND ', $where),\n                    $params, $tab === 'records' ? $page : 1\n                );\n\n                foreach ($result['rows'] as &$messageRow) {\n                    $safeError = (string) ($messageRow['last_error'] ?? '');\n                    $safeError = preg_replace('/(?<!\\\\d)1[3-9]\\\\d{9}(?!\\\\d)/', '1**********', $safeError);\n                    $safeError = preg_replace('#https?://qyapi\\\\.weixin\\\\.qq\\\\.com/cgi-bin/webhook/send\\\\?key=[A-Za-z0-9_-]+#i', '企业微信 Webhook 地址已隐藏', $safeError);\n                    $messageRow['last_error_display'] = mb_substr((string) $safeError, 0, 1000);\n                }\n                unset($messageRow);\n\n                if ($has('attempt_count')) {\n                    $failedCount = (int) $this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic IN ('aliyun_sms','wecom_webhook','wechat_subscribe') AND status='failed' AND attempt_count>=5\");\n                }\n            } catch (Throwable $exception) {\n                \\write_log('admin-message-outbox', '[' . date('c') . '] list read failed: ' . mb_substr($exception->getMessage(), 0, 500) . \"\\n\");\n                $result = ['rows'=>[], 'total'=>0, 'page'=>1, 'pages'=>1, 'per_page'=>20];\n                $failedCount = 0;\n                $schemaWarning = '消息发送记录读取失败。后台其他功能不受影响，请检查数据库升级状态或服务器日志后重试。';\n            }\n        }\n\n        if($this->db->tableExists('sms_recipient_suppressions')){\n            try{\n                $suppressionResult=$this->paginate(\n                    \"SELECT id,mobile_masked,reason,note,status,created_at,updated_at FROM sms_recipient_suppressions WHERE status='active' ORDER BY id DESC\",\n                    \"SELECT COUNT(*) FROM sms_recipient_suppressions WHERE status='active'\",\n                    [], $tab === 'suppressions' ? $page : 1\n                );\n            }catch(Throwable $exception){\n                \\write_log('admin-sms-suppression','['.date('c').'] list failed: '.mb_substr($exception->getMessage(),0,500).\"\\n\");\n            }\n        }\n\n        return [\n            'result'=>$result,\n            'suppressionResult'=>$suppressionResult,\n            'status'=>$status,\n            'q'=>$q,\n            'failedCount'=>$failedCount,\n            'schemaWarning'=>$schemaWarning,\n        ];\n\n    }\n\n    public function retry(int $id): array\n    {\n        $schema = $this->schema();\n        $columns = (array) ($schema['columns'] ?? []);\n        if (empty($schema['ready']) || !isset($columns['attempt_count'])) {\n            throw new RuntimeException((string)(($schema['message'] ?? '') ?: '消息发送记录表缺少重试字段，请先完成数据库升级。'));\n        }\n\n        $message = $this->db->transaction(function (Database $db) use ($id, $columns) {\n            $row = $db->fetch('SELECT id,topic,status,attempt_count FROM message_outbox WHERE id=:id FOR UPDATE', ['id' => $id]);\n            MessageOutboxPolicy::requireDeadLetter($row, 'retry');\n            $sets = [\"status='pending'\", 'attempt_count=0'];\n            if (isset($columns['next_attempt_at'])) $sets[] = 'next_attempt_at=UTC_TIMESTAMP()';\n            if (isset($columns['last_error'])) $sets[] = 'last_error=NULL';\n            if (isset($columns['processed_at'])) $sets[] = 'processed_at=NULL';\n            $changed = $db->execute('UPDATE message_outbox SET ' . implode(',', $sets) . \" WHERE id=:id AND status='failed' AND attempt_count>=5\", ['id' => $id]);\n            if ($changed !== 1) throw new RuntimeException('消息状态已变化，没有重复加入重试队列。');\n            return $row;\n        });\n        return $message;\n    }\n\n    public function close(int $id): array\n    {\n        $schema = $this->schema();\n        $columns = (array) ($schema['columns'] ?? []);\n        if (empty($schema['ready']) || !isset($columns['attempt_count'])) {\n            throw new RuntimeException((string)(($schema['message'] ?? '') ?: '消息发送记录表缺少结案所需字段，请先完成数据库升级。'));\n        }\n\n        $message = $this->db->transaction(function (Database $db) use ($id, $columns) {\n            $row = $db->fetch('SELECT id,topic,status,attempt_count FROM message_outbox WHERE id=:id FOR UPDATE', ['id' => $id]);\n            MessageOutboxPolicy::requireDeadLetter($row, 'close');\n            $sets = [\"status='closed'\"];\n            if (isset($columns['next_attempt_at'])) $sets[] = 'next_attempt_at=NULL';\n            $changed = $db->execute('UPDATE message_outbox SET ' . implode(',', $sets) . \" WHERE id=:id AND status='failed' AND attempt_count>=5\", ['id' => $id]);\n            if ($changed !== 1) throw new RuntimeException('消息状态已变化，没有执行结案。');\n            return $row;\n        });\n        return $message;\n    }\n\n    public function addSuppression(string $hmac, string $masked, string $reason, string $note, int $adminId): void\n    {\n        if(!$this->db->tableExists('sms_recipient_suppressions')){\n            throw new RuntimeException('短信抑制名单表尚未建立，请先完成数据库升级。');\n        }\n        $this->db->execute(\n            \"INSERT INTO sms_recipient_suppressions\n             (mobile_hmac,mobile_masked,reason,note,status,created_by_admin_id,created_at,updated_at)\n             VALUES(:hmac,:masked,:reason,:note,'active',:admin,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n             ON DUPLICATE KEY UPDATE mobile_masked=VALUES(mobile_masked),reason=VALUES(reason),note=VALUES(note),\n                                     status='active',created_by_admin_id=VALUES(created_by_admin_id),updated_at=UTC_TIMESTAMP()\",\n            ['hmac'=>$hmac,'masked'=>$masked,'reason'=>$reason,'note'=>$note!==''?$note:null,'admin'=>$adminId]\n        );\n    }\n\n    public function removeSuppression(int $id): array\n    {\n        $row=$this->db->fetch('SELECT id,mobile_masked,status FROM sms_recipient_suppressions WHERE id=:id LIMIT 1',['id'=>$id]);\n        if(!$row)throw new RuntimeException('抑制名单记录不存在。');\n        $this->db->execute(\n            \"UPDATE sms_recipient_suppressions SET status='inactive',updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='active'\",\n            ['id'=>$id]\n        );\n        return $row;\n    }\n    private function paginate($sql, $countSql, array $params, int $page)\n    {\n        $page=max(1,$page); $perPage=20; $total=(int)$this->db->fetchValue($countSql,$params); $pages=max(1,(int)ceil($total/$perPage)); $page=min($page,$pages); $offset=($page-1)*$perPage;\n        $rows=$this->db->fetchAll($sql.' LIMIT '.$perPage.' OFFSET '.$offset,$params);\n        return ['rows'=>$rows,'total'=>$total,'page'=>$page,'pages'=>$pages,'per_page'=>$perPage];\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseNotificationInboxRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\NotificationInboxRepository;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOperationException;\n\nfinal class DatabaseNotificationInboxRepository implements NotificationInboxRepository, \\WorkerAdmin\\Contracts\\NotificationThreadRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function summary(array $actor): array\n    {\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        // One bounded projection for the normal-notification conversation; never load bodies.\n        $latest = $this->db->fetch(\"SELECT n.public_id,n.title,n.created_at FROM notifications n WHERE n.channel='in_app' AND ((n.recipient_type='user' AND n.recipient_id=:user_id) OR (n.recipient_type='worker' AND :worker_enabled>0 AND n.recipient_id=:worker_id)) ORDER BY n.created_at DESC,n.id DESC LIMIT 1\", [\n            'user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId,\n        ]);\n        $unreadCount = (int) $this->db->fetchValue(\"SELECT COUNT(*) FROM notifications n WHERE n.channel='in_app' AND n.read_at IS NULL AND ((n.recipient_type='user' AND n.recipient_id=:user_id) OR (n.recipient_type='worker' AND :worker_enabled>0 AND n.recipient_id=:worker_id))\", [\n            'user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId,\n        ]);\n\n        [$userWhere,$userParams] = DatabaseOrderCenterRepository::scope($actor,'mine','todo');\n        $userTodoCount = (int) $this->db->fetchValue('SELECT COUNT(*) FROM orders o WHERE ' . $userWhere, $userParams);\n        $userTop = $this->db->fetch(\"SELECT o.public_no,o.audit_status,o.payment_status,o.fulfillment_status,(o.order_source_type='platform' AND EXISTS(SELECT 1 FROM order_events apr WHERE apr.order_id=o.id AND apr.event_type='platform_measurement_pricing_reviewed') AND NOT EXISTS(SELECT 1 FROM order_events apc WHERE apc.order_id=o.id AND apc.event_type='platform_measurement_pricing_confirmed')) pending_pricing,(SELECT c.public_id FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')) ORDER BY c.id DESC LIMIT 1) pending_change_id,(SELECT rc.status FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment') ORDER BY rc.id DESC LIMIT 1) pending_run_empty_status,CASE WHEN o.audit_status='draft' AND o.payment_status='awaiting_payment' THEN 95 WHEN EXISTS(SELECT 1 FROM run_empty_fee_claims rp WHERE rp.order_id=o.id AND rp.status='awaiting_payment') THEN 95 WHEN o.audit_status='supplement_required' THEN 85 WHEN EXISTS(SELECT 1 FROM change_requests cp WHERE cp.order_id=o.id AND (cp.status='pending' OR (cp.status='accepted' AND cp.payment_status='awaiting_payment'))) THEN 80 WHEN EXISTS(SELECT 1 FROM run_empty_fee_claims rc2 WHERE rc2.order_id=o.id AND rc2.status='pending_confirmation') THEN 80 WHEN o.fulfillment_status='submitted' THEN 75 ELSE 70 END todo_priority FROM orders o WHERE \" . $userWhere . \" ORDER BY todo_priority DESC,o.updated_at DESC,o.id DESC LIMIT 1\", $userParams);\n        $userTodo = null;\n        if ($userTop) {\n            if ($userTop['audit_status'] === 'supplement_required') $action = '补充订单资料';\n            elseif ($userTop['audit_status'] === 'draft' && $userTop['payment_status'] === 'awaiting_payment') $action = '支付预约费';\n            elseif (!empty($userTop['pending_pricing'])) $action = '确认平台报价';\n            elseif (!empty($userTop['pending_change_id'])) $action = '处理费用调整';\n            elseif (($userTop['pending_run_empty_status'] ?? '') === 'pending_confirmation') $action = '确认跑空费';\n            elseif (($userTop['pending_run_empty_status'] ?? '') === 'awaiting_payment') $action = '支付跑空费';\n            elseif ($userTop['fulfillment_status'] === 'submitted') $action = '确认完工';\n            else $action = '选择报价';\n            $userTodo = ['order_id' => (string) $userTop['public_no'], 'action' => $action, 'role' => '我的下单', 'detail_page' => 'user', 'priority' => (int) $userTop['todo_priority']];\n        }\n\n        $workerTodoCount = 0;\n        $workerTodo = null;\n        if ($workerId > 0) {\n            [$workerWhere,$workerParams] = DatabaseOrderCenterRepository::scope($actor,'worker','todo');\n            $workerTodoCount = (int) $this->db->fetchValue('SELECT COUNT(*) FROM orders o WHERE ' . $workerWhere, $workerParams);\n            $workerTop = $this->db->fetch(\"SELECT o.public_no,o.assignment_status,o.dispatch_mode,(SELECT COUNT(*) FROM after_sales ast WHERE ast.order_id=o.id AND ast.type='warranty_repair' AND (ast.status='open' OR (ast.status='processing' AND (ast.resolution IS NULL OR (ast.resolution NOT LIKE '师傅拒绝维修%' AND ast.resolution NOT LIKE '用户申请平台介入%'))))) pending_repair_count FROM orders o WHERE \" . $workerWhere . \" ORDER BY pending_repair_count DESC,o.updated_at DESC,o.id DESC LIMIT 1\", $workerParams);\n            if ($workerTop) {\n                $repair = (int) ($workerTop['pending_repair_count'] ?? 0) > 0;\n                $workerTodo = ['order_id' => (string) $workerTop['public_no'], 'action' => $repair ? '处理待维修' : ($workerTop['assignment_status']==='accepted'?'预约施工':($workerTop['dispatch_mode']==='multi_quote'?'提交报价':'确认接单')), 'role' => '我的接单', 'detail_page' => 'worker', 'priority' => $repair ? 100 : 90];\n            }\n        }\n\n        $topTodo = $userTodo;\n        if ($workerTodo && (!$topTodo || (int) $workerTodo['priority'] > (int) $topTodo['priority'])) $topTodo = $workerTodo;\n        $attention = $this->attention($actor);\n        return [\n            'attention_schema' => 1,\n            'order_attention_count' => $attention['order_attention_count'],\n            'standalone_unread_count' => $attention['standalone_unread_count'],\n            'unread_count' => $unreadCount,\n            'todo_count' => $userTodoCount + $workerTodoCount,\n            'user_todo_count' => $userTodoCount,\n            'worker_todo_count' => $workerTodoCount,\n            'top_todo' => $topTodo,\n            'latest_notification' => $latest ? [\n                'id' => (string) $latest['public_id'],\n                'title' => (string) $latest['title'],\n                'created_at' => (new DateTimeImmutable((string) $latest['created_at'], new DateTimeZone('UTC')))->format(DATE_ATOM),\n            ] : null,\n        ];\n\n    }\n\n\n    private function attention(array $actor): array\n    {\n        [$userTodo,$userParams] = DatabaseOrderCenterRepository::scope($actor,'mine','todo');\n        [$workerTodo,$workerParams] = DatabaseOrderCenterRepository::scope($actor,'worker','todo');\n        [$userRead,$userReadParams] = DatabaseOrderCenterRepository::scope($actor,'mine','all');\n        [$workerRead,$workerReadParams] = DatabaseOrderCenterRepository::scope($actor,'worker','all');\n        $workerId=(int)($actor['worker_id']??0);\n        // Only a canonical internal order ID and the current receiver's order\n        // scope can merge a notice into B. Invalid/missing/unowned links stay S.\n        $orderId=\"JSON_UNQUOTE(JSON_EXTRACT(IF(JSON_VALID(n.data_json),n.data_json,'{}'),'$.order_id'))\";\n        $orderType=\"JSON_TYPE(JSON_EXTRACT(IF(JSON_VALID(n.data_json),n.data_json,'{}'),'$.order_id'))\";\n        $match=\"{$orderType} IN ('INTEGER','STRING') AND {$orderId} REGEXP '^[1-9][0-9]{0,19}$' AND o.id=CAST({$orderId} AS UNSIGNED) AND BINARY CAST(o.id AS CHAR)=BINARY {$orderId}\n            AND ((n.recipient_type='user' AND ({$userRead})) OR (n.recipient_type='worker' AND ({$workerRead})))\";\n        $owned=\"n.channel='in_app' AND n.read_at IS NULL AND ((n.recipient_type='user' AND n.recipient_id=:attention_user) OR (n.recipient_type='worker' AND :attention_worker_enabled>0 AND n.recipient_id=:attention_worker))\";\n        // UNION deduplicates identity+order across todos and any number of\n        // order notices. Kind separates unrelated notification IDs from orders.\n        $sql=\"SELECT COALESCE(SUM(kind='order'),0) order_attention_count,COALESCE(SUM(kind='standalone'),0) standalone_unread_count FROM (\n            SELECT 'order' kind,'user' identity_kind,o.id item_id FROM orders o WHERE {$userTodo}\n            UNION SELECT 'order','worker',o.id FROM orders o WHERE {$workerTodo}\n            UNION SELECT IF(o.id IS NULL,'standalone','order'),n.recipient_type,IF(o.id IS NULL,n.id,o.id)\n                FROM notifications n LEFT JOIN orders o ON {$match} WHERE {$owned}\n        ) attention_items\";\n        $params=$userParams+$workerParams+$userReadParams+$workerReadParams+['attention_user'=>(int)$actor['user_id'],'attention_worker_enabled'=>$workerId,'attention_worker'=>$workerId];\n        $row=$this->db->fetch($sql,$params);\n        return ['order_attention_count'=>(int)$row['order_attention_count'],'standalone_unread_count'=>(int)$row['standalone_unread_count']];\n    }\n\n    public function list(array $actor, int $page, string $throughId = ''): array\n    {\n        $limit = 20;\n        $offset = ($page - 1) * $limit;\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        $where = \"n.channel='in_app' AND ( (n.recipient_type='user' AND n.recipient_id=:user_id) OR (n.recipient_type='worker' AND :worker_enabled>0 AND n.recipient_id=:worker_id) )\";\n        $params = ['user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId];\n        // Capture the range before loading the list, not after it. Later pages\n        // retain the same owned public ID so arrivals cannot shift offsets.\n        $boundary=$this->db->fetch('SELECT n.id,n.public_id FROM notifications n WHERE '.$where.($throughId!==''?' AND n.public_id=:through_id':'').' ORDER BY n.id DESC LIMIT 1',$throughId!==''?$params+['through_id'=>$throughId]:$params);\n        if($throughId!==''&&!$boundary)throw new MessageOperationException('通知范围已失效，请刷新后重试','NOTIFICATION_RANGE_INVALID',404);\n        $throughId=$boundary?(string)$boundary['public_id']:'';\n        $unreadCount = (int) $this->db->fetchValue('SELECT COUNT(*) FROM notifications n WHERE ' . $where . ' AND n.read_at IS NULL', $params);\n        $rows = $this->db->fetchAll('SELECT n.public_id,n.recipient_type,n.template_key,n.title,n.content,n.data_json,n.read_at,n.created_at FROM notifications n WHERE ' . $where . ' AND n.id<=:range_cutoff ORDER BY n.created_at DESC,n.id DESC LIMIT ' . ($limit + 1) . ' OFFSET ' . $offset, $params+['range_cutoff'=>$boundary?(int)$boundary['id']:0]);\n        $hasMore = count($rows) > $limit;\n        $rows = array_slice($rows, 0, $limit);\n        // V2.2.3：先解析本页关联订单，再一次性批量取订单号，避免每条通知额外执行一次 SQL。\n        $preparedRows = []; $orderIds = [];\n        foreach ($rows as $row) {\n            $data = (json_decode((string)($row['data_json'] ?? ''), true) ?: []);\n            $orderId = is_array($data) ? (int) ($data['order_id'] ?? 0) : 0;\n            if ($orderId > 0) $orderIds[$orderId] = true;\n            $preparedRows[] = ['row' => $row, 'order_id' => $orderId];\n        }\n        $orderNoById = [];\n        if ($orderIds) {\n            $safeIds = array_map('intval', array_keys($orderIds));\n            foreach ($this->db->fetchAll('SELECT id,public_no FROM orders WHERE id IN (' . implode(',', $safeIds) . ')') as $orderRow) {\n                $orderNoById[(int) $orderRow['id']] = (string) $orderRow['public_no'];\n            }\n        }\n        $items = [];\n        foreach ($preparedRows as $prepared) {\n            $row = $prepared['row']; $orderId = (int) $prepared['order_id'];\n            $items[] = [\n                'id' => (string) $row['public_id'], 'recipient_type' => (string) $row['recipient_type'],\n                'template_key' => (string) $row['template_key'], 'title' => (string) $row['title'],\n                'content' => (string) $row['content'], 'read' => !empty($row['read_at']),\n                'created_at' => $this->localTime($row['created_at']), 'order_id' => $orderId,\n                'order_no' => $orderNoById[$orderId] ?? '', 'detail_page' => $row['recipient_type'] === 'worker' ? 'worker' : 'user',\n            ];\n        }\n        return ['items' => $items, 'page' => $page, 'has_more' => $hasMore, 'unread_count' => $unreadCount, 'read_through_id'=>$throughId];\n\n    }\n\n    public function read(array $actor, string $publicId): void\n    {\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        $params = ['public_id' => $publicId, 'user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId];\n        $owned = $this->db->fetchValue(\"SELECT id FROM notifications WHERE public_id=:public_id AND channel='in_app' AND ((recipient_type='user' AND recipient_id=:user_id) OR (recipient_type='worker' AND :worker_enabled>0 AND recipient_id=:worker_id)) LIMIT 1\", $params);\n        if (!$owned) throw new MessageOperationException('消息不存在或不属于当前账号', 'NOTIFICATION_NOT_FOUND', 404);\n        $this->db->execute(\"UPDATE notifications SET read_at=COALESCE(read_at,UTC_TIMESTAMP()) WHERE id=:id\", ['id' => (int) $owned]);\n\n    }\n\n    public function readBatch(array $actor, array $ids): int\n    {\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        $marks = [];\n        $params = ['user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId];\n        foreach ($ids as $index => $publicId) {\n            $key = 'notification_' . $index;\n            $marks[] = ':' . $key;\n            $params[$key] = $publicId;\n        }\n        $changed = $this->db->execute(\"UPDATE notifications SET read_at=COALESCE(read_at,UTC_TIMESTAMP()) WHERE public_id IN (\" . implode(',', $marks) . \") AND channel='in_app' AND ((recipient_type='user' AND recipient_id=:user_id) OR (recipient_type='worker' AND :worker_enabled>0 AND recipient_id=:worker_id))\", $params);\n        return $changed;\n\n    }\n\n    public function readAll(array $actor, string $throughId = ''): void\n    {\n        $workerId=!empty($actor['worker_id'])?(int)$actor['worker_id']:0;\n        $params=['user_id'=>(int)$actor['user_id'],'worker_enabled'=>$workerId,'worker_id'=>$workerId];\n        $where=\"channel='in_app' AND ((recipient_type='user' AND recipient_id=:user_id) OR (recipient_type='worker' AND :worker_enabled>0 AND recipient_id=:worker_id))\";\n        if($throughId!==''){\n            $cutoff=$this->db->fetchValue('SELECT id FROM notifications WHERE '.$where.' AND public_id=:through_id LIMIT 1',$params+['through_id'=>$throughId]);\n            if(!$cutoff)throw new MessageOperationException('通知范围已失效，请刷新后重试','NOTIFICATION_RANGE_INVALID',404);\n        }else{\n            // Old clients also receive a server-side cutoff before the UPDATE.\n            $cutoff=$this->db->fetchValue('SELECT COALESCE(MAX(id),0) FROM notifications WHERE '.$where,$params);\n        }\n        $this->db->execute('UPDATE notifications SET read_at=UTC_TIMESTAMP() WHERE '.$where.' AND read_at IS NULL AND id<=:cutoff',$params+['cutoff'=>(int)$cutoff]);\n    }\n\n\n    private function threadExpression(): string\n    {\n        $json=\"IF(JSON_VALID(n.data_json),n.data_json,'{}')\";\n        $id=\"JSON_UNQUOTE(JSON_EXTRACT({$json},'$.order_id'))\";\n        $type=\"JSON_TYPE(JSON_EXTRACT({$json},'$.order_id'))\";\n        // Identity remains part of the key. An association is never an order access grant.\n        return \"CASE WHEN {$type} IN ('INTEGER','STRING') AND {$id} REGEXP '^[1-9][0-9]{0,19}$'\n            AND BINARY CAST(CAST({$id} AS UNSIGNED) AS CHAR)=BINARY {$id}\n            THEN CONCAT(n.recipient_type,':',{$id}) ELSE CONCAT('single:',n.public_id) END\";\n    }\n    private function notificationScope(array $actor): array\n    {\n        return [\"n.channel='in_app' AND ((n.recipient_type='user' AND n.recipient_id=:thread_user)\n            OR (n.recipient_type='worker' AND :thread_enabled>0 AND n.recipient_id=:thread_worker))\",\n            ['thread_user'=>(int)$actor['user_id'],'thread_enabled'=>(int)($actor['worker_id']??0),'thread_worker'=>(int)($actor['worker_id']??0)]];\n    }\n    private function threadRange(array $actor,string $cursor,string $kind): array\n    {\n        $signer=new \\WorkerAdmin\\Infrastructure\\Messaging\\NotificationInboxCursor();\n        [$where,$params]=$this->notificationScope($actor);\n        if($cursor===''&&$kind!=='threads')throw new MessageOperationException('请刷新通知列表','NOTIFICATION_RESYNC_REQUIRED',409);\n        if($cursor===''){\n            $anchor=$this->db->fetch('SELECT COALESCE(MAX(n.id),0) max_id,COUNT(*) total FROM notifications n WHERE '.$where,$params);\n            $state=$signer->begin($actor,(string)$anchor['max_id'],(string)$anchor['total']);\n        }else $state=$signer->open($actor,$cursor,$kind);\n        $params['thread_max']=$state['max'];$where.=' AND n.id<=:thread_max';\n        $count=(string)$this->db->fetchValue('SELECT COUNT(*) FROM notifications n WHERE '.$where,$params);\n        // Read flags may change without invalidation; deleted members require an explicit resync.\n        if($count!==$state['count'])throw new MessageOperationException('通知浏览范围已变化，请下拉刷新','NOTIFICATION_RESYNC_REQUIRED',409);\n        return [$signer,$state,$where,$params];\n    }\n    public function threads(array $actor,string $cursor=''): array\n    {\n        return $this->db->transaction(function()use($actor,$cursor):array{\n            [$signer,$state,$where,$params]=$this->threadRange($actor,$cursor,'threads');\n            $expr=$this->threadExpression();\n            $sort=\"CONCAT(DATE_FORMAT(n.created_at,'%Y-%m-%d %H:%i:%s'),LPAD(CAST(n.id AS CHAR),20,'0'))\";\n            $after='';\n            if($state['before']!==''){$after=' WHERE g.sort_key<:thread_before';$params['thread_before']=$state['before'];}\n            $rows=$this->db->fetchAll(\"SELECT g.thread_key,g.thread_count,g.unread_count,g.sort_key,n.public_id,n.recipient_type,n.template_key,n.title,n.content,n.created_at,n.read_at\n                FROM (SELECT {$expr} thread_key,COUNT(*) thread_count,SUM(n.read_at IS NULL) unread_count,MAX({$sort}) sort_key\n                    FROM notifications n WHERE {$where} GROUP BY thread_key) g\n                JOIN notifications n ON n.id=CAST(SUBSTRING(g.sort_key,20) AS UNSIGNED){$after} ORDER BY g.sort_key DESC LIMIT 21\",$params);\n            $more=count($rows)>20;$rows=array_slice($rows,0,20);$items=[];$orders=$this->threadOrders($actor,$rows);\n            foreach($rows as $row){\n                $item=$this->threadItem($row,$orders);\n                $item['thread_cursor']=$signer->seal($state,'messages',(string)$row['thread_key']);\n                $items[]=$item;\n            }\n            return ['schema'=>2,'items'=>$items,'has_more'=>$more,\n                'next_cursor'=>$more?$signer->seal($state,'threads','',(string)end($rows)['sort_key']):'',\n                'range_cursor'=>$signer->seal($state,'range'),'unread_count'=>$this->notificationUnread($actor)];\n        });\n    }\n    public function threadMessages(array $actor,string $cursor): array\n    {\n        return $this->db->transaction(function()use($actor,$cursor):array{\n            [$signer,$state,$where,$params]=$this->threadRange($actor,$cursor,'messages');\n            $expr=$this->threadExpression();\n            $sort=\"CONCAT(DATE_FORMAT(n.created_at,'%Y-%m-%d %H:%i:%s'),LPAD(CAST(n.id AS CHAR),20,'0'))\";\n            $params['thread_key']=$state['thread'];$where.=\" AND ({$expr})=:thread_key\";\n            if($state['before']!==''){$where.=\" AND {$sort}<:thread_before\";$params['thread_before']=$state['before'];}\n            $rows=$this->db->fetchAll(\"SELECT n.public_id,n.recipient_type,n.template_key,n.title,n.content,n.read_at,n.created_at,{$sort} sort_key\n                FROM notifications n WHERE {$where} ORDER BY n.created_at DESC,n.id DESC LIMIT 21\",$params);\n            $more=count($rows)>20;$rows=array_slice($rows,0,20);\n            $items=array_map(fn(array $row):array=>$this->notificationItem($row),$rows);\n            return ['schema'=>2,'thread_key'=>$state['thread'],'items'=>$items,'has_more'=>$more,\n                'next_cursor'=>$more?$signer->seal($state,'messages',$state['thread'],(string)end($rows)['sort_key']):''];\n        });\n    }\n    public function readRange(array $actor,string $cursor): void\n    {\n        $this->db->transaction(function()use($actor,$cursor):void{\n            [,,$where,$params]=$this->threadRange($actor,$cursor,'range');\n            $this->db->execute('UPDATE notifications n SET n.read_at=UTC_TIMESTAMP() WHERE '.$where.' AND n.read_at IS NULL',$params);\n        });\n    }\n    private function notificationUnread(array $actor): int\n    {\n        [$where,$params]=$this->notificationScope($actor);\n        return (int)$this->db->fetchValue('SELECT COUNT(*) FROM notifications n WHERE '.$where.' AND n.read_at IS NULL',$params);\n    }\n    private function notificationItem(array $row): array\n    {\n        return ['id'=>(string)$row['public_id'],'recipient_type'=>(string)$row['recipient_type'],\n            'template_key'=>(string)$row['template_key'],'title'=>(string)$row['title'],'content'=>(string)$row['content'],\n            'created_at'=>$this->localTime($row['created_at']),'read'=>!empty($row['read_at'])];\n    }\n    private function threadOrders(array $actor,array $rows): array\n    {\n        $ids=[];$result=[];\n        foreach($rows as $row)if(strpos((string)$row['thread_key'],'single:')!==0){\n            [$role,$id]=explode(':',(string)$row['thread_key'],2);$ids[$role][$id]=true;\n        }\n        foreach($ids as $role=>$values){\n            [$scope,$params]=DatabaseOrderCenterRepository::scope($actor,$role==='worker'?'worker':'mine','all');\n            $marks=[];foreach(array_keys($values) as $i=>$id){$name='thread_order_'.$i;$marks[]=':'.$name;$params[$name]=(string)$id;}\n            foreach($this->db->fetchAll('SELECT o.id,o.public_no FROM orders o WHERE o.id IN ('.implode(',',$marks).') AND ('.$scope.')',$params) as $order)$result[$role.':'.$order['id']]=(string)$order['public_no'];\n        }\n        return $result;\n    }\n    private function threadItem(array $row,array $orders): array\n    {\n        $item=$this->notificationItem($row);$key=(string)$row['thread_key'];\n        return $item+['thread_key'=>$key,'is_thread'=>strpos($key,'single:')!==0,'thread_count'=>(int)$row['thread_count'],\n            'unread_count'=>(int)$row['unread_count'],'order_no'=>$orders[$key]??'',\n            'detail_page'=>$row['recipient_type']==='worker'?'worker':'user'];\n    }\n\n    private function localTime($value): ?string\n    {\n        if (!$value) return null;\n        try {\n            return (new DateTimeImmutable((string) $value, new DateTimeZone('UTC')))->setTimezone(new DateTimeZone((string) \\app_config('app.timezone', 'Asia/Shanghai')))->format('Y-m-d H:i');\n        } catch (Throwable $exception) { return (string) $value; }\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCancellationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderCancellationRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderCancellationRepository implements OrderCancellationRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function request(array $actor, string $orderNo, string $reason, string $reasonCode): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reason,$reasonCode): array {\n            $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE', ['public_no'=>$orderNo]);\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能取消自己的订单', 'FORBIDDEN', 403);\n            }\n            if ((string)$order['payment_status'] !== 'paid') {\n                throw new OrderOperationException('预约费尚未支付，不存在可退款款项；如不需要该订单可直接保留未付款状态', 'REFUND_NOT_AVAILABLE_BEFORE_PAYMENT', 409);\n            }\n            if ((string)$order['lifecycle_status'] !== 'active' || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                throw new OrderOperationException('该订单当前不能申请退款并取消订单', 'ORDER_NOT_CANCELLABLE', 409);\n            }\n            if ($db->fetchValue(\n                \"SELECT id FROM order_cancel_requests WHERE order_id=:id AND status IN ('pending','processing','approved') AND closed_at IS NULL LIMIT 1 FOR UPDATE\",\n                ['id'=>$order['id']]\n            )) {\n                throw new OrderOperationException('已经存在待处理的取消申请', 'CANCEL_REQUEST_ALREADY_OPEN', 409);\n            }\n\n            $payments = $this->refundablePayments($db, $order);\n            $refundAmount = array_sum(array_map(static function (array $row): int { return (int)$row['available_cents']; }, $payments));\n            $auto = $refundAmount > 0 && $this->canAutoApproveBeforeService($db, $order);\n            $requestPublicId = \\public_id();\n\n            if (!$auto) {\n                $db->insert(\n                    \"INSERT INTO order_cancel_requests(public_id,order_id,applicant_type,applicant_id,request_type,order_state_snapshot_json,reason_code,reason,status,requested_refund_cents,requested_at,created_at,updated_at)\n                     VALUES(:public_id,:order_id,'user',:user_id,'cancel_refund',:snapshot,:reason_code,:reason,'pending',:refund,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_id'=>$requestPublicId,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                        'snapshot'=>$this->snapshot($order),'reason_code'=>!empty($order['assigned_worker_id']) ? 'bilateral_refund_pending' : $reasonCode,'reason'=>$reason,'refund'=>$refundAmount,\n                    ]\n                );\n                $db->execute(\n                    \"UPDATE orders SET refund_status='pending_review',publish_status='hidden',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n                $this->event($db, (int)$order['id'], 'cancel_requested', 'user', (int)$actor['user_id'], [\n                    'requested_refund_cents'=>$refundAmount,\n                    'notify_recipients'=>!empty($order['assigned_worker_id']) ? ['worker'] : ['admin'],\n                    'message'=>!empty($order['assigned_worker_id']) ? '用户提出退款方案，请师傅先接受或拒绝；方案金额 ¥'.number_format($refundAmount/100, 2) : '用户申请退款取消，当前可退线上实收合计 ¥'.number_format($refundAmount/100, 2),\n                ]);\n                return ['request_id'=>$requestPublicId,'auto_approved'=>false,'bilateral_negotiation'=>!empty($order['assigned_worker_id']),'refund_cents'=>$refundAmount,'refund_count'=>0];\n            }\n\n            $requestId = $db->insert(\n                \"INSERT INTO order_cancel_requests(public_id,order_id,applicant_type,applicant_id,request_type,order_state_snapshot_json,reason_code,reason,status,requested_refund_cents,requested_at,created_at,updated_at)\n                 VALUES(:public_id,:order_id,'user',:user_id,'cancel_refund',:snapshot,'pre_service_auto_refund',:reason,'approved',:refund,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_id'=>$requestPublicId,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                    'snapshot'=>$this->snapshot($order),'reason'=>$reason,'refund'=>$refundAmount,\n                ]\n            );\n\n            return $this->approveRefund($db, $order, $requestId, $requestPublicId, $payments, $refundAmount, $reason, (int)$actor['user_id']);\n        });\n    }\n\n\n    // 2026-10-08：接受方案时锁内复核对方身份和资金；复用未成交自动退款的同一执行器。\n    public function approveByAgreement(array $actor, string $requestNo): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$requestNo): array {\n            $seed = $db->fetch('SELECT order_id FROM order_cancel_requests WHERE BINARY public_id=BINARY :no', ['no'=>$requestNo]);\n            if (!$seed) throw new OrderOperationException('退款方案不存在', 'REFUND_PROPOSAL_NOT_FOUND', 404);\n            $order = $db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE BINARY public_id=BINARY :no FOR UPDATE', ['no'=>$requestNo]);\n            $isWorker = (string)$request['applicant_type'] === 'user' && (int)($actor['worker_id'] ?? 0) > 0 && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n            $isUser = (string)$request['applicant_type'] === 'worker' && (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n            if (!$isWorker && !$isUser) throw new OrderOperationException('只能由方案的另一方接受', 'FORBIDDEN', 403);\n            if ((string)$request['status'] !== 'pending' || (string)$request['reason_code'] !== 'bilateral_refund_pending'\n                || (string)$order['lifecycle_status'] !== 'active' || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                throw new OrderOperationException('方案已经响应或订单状态已变化', 'REFUND_PROPOSAL_NOT_PENDING', 409);\n            }\n            $assignment = $db->fetch(\"SELECT id FROM assignments WHERE id=:id AND order_id=:order AND worker_id=:worker AND status='accepted' FOR UPDATE\", ['id'=>$order['current_assignment_id'] ?: 0,'order'=>$order['id'],'worker'=>$order['assigned_worker_id']]);\n            if (!$assignment) throw new OrderOperationException('成交师傅关系已变化', 'ASSIGNMENT_CHANGED', 409);\n            $payments = $this->refundablePayments($db, $order);\n            $amount = array_sum(array_column($payments, 'available_cents'));\n            // 已同意不等于能够随意分配资金：平台工费/跑空费/争议/已入账收入保持既有财务核验。\n            $blocked = (string)$order['order_source_type'] === 'platform' || $amount !== (int)$request['requested_refund_cents'] || $amount < 1\n                || !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                || (bool)$db->fetchValue(\"SELECT id FROM run_empty_fee_claims WHERE order_id=:id AND status NOT IN ('cancelled') LIMIT 1\", ['id'=>$order['id']])\n                || (bool)$db->fetchValue(\"SELECT l.id FROM worker_balance_ledger l WHERE l.status='effective' AND ((l.business_type IN ('order','platform_order','measurement_order','order_measurement') AND l.business_id=:id) OR (l.business_type='commission' AND l.business_id IN (SELECT id FROM commission_receivables WHERE order_id=:id)) OR (l.business_type='dispute' AND l.business_id IN (SELECT id FROM disputes WHERE order_id=:id))) LIMIT 1\", ['id'=>$order['id']]);\n            if ($blocked) {\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_execution_required',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n                // 双方已经接受取消/退款方案时，业务履约立即终止；这里只等待资金核账，不允许订单继续施工。\n                $db->execute(\n                    \"UPDATE orders\n                     SET lifecycle_status='cancel_approved_pending_refund',refund_status='pending_review',publish_status='hidden',\n                         quote_status='cancelled',assignment_status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),\n                         version=version+1,updated_at=UTC_TIMESTAMP()\n                     WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n                $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n                $this->event($db, (int)$order['id'], 'cancel_requested', $isWorker ? 'worker' : 'user', $isWorker ? (int)$actor['worker_id'] : (int)$actor['user_id'], [\n                    'message'=>'双方已接受退款方案，订单已停止履约；涉及资金分配或可退金额变化，需平台核账后执行退款','notify_recipients'=>['user','worker','admin'],\n                ]);\n                return ['request_id'=>$requestNo,'agreement_accepted'=>true,'execution_requires_platform'=>true];\n            }\n            $db->execute(\"UPDATE order_cancel_requests SET status='approved',reason_code='bilateral_refund_accepted',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n            return $this->approveRefund($db, $order, (int)$request['id'], $requestNo, $payments, $amount, '双方接受退款方案：'.$request['reason'], (int)$order['user_id'], true);\n        });\n    }\n\n    private function approveRefund(Database $db, array $order, int $requestId, string $requestPublicId, array $payments, int $refundAmount, string $reason, int $userId, bool $agreed = false): array\n    {\n            $refundIds = [];\n            $firstRefundId = null;\n            foreach ($payments as $payment) {\n                $amount = (int)$payment['available_cents'];\n                if ($amount < 1) continue;\n                $refundId = $db->insert(\n                    \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                     VALUES(:public_no,:payment_id,:order_id,:request_id,:amount,:reason,'pending_review',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_no'=>\\business_no('RF'),'payment_id'=>$payment['id'],'order_id'=>$order['id'],'request_id'=>$requestId,\n                        'amount'=>$amount,'reason'=>mb_substr('自动取消退款：'.$reason.'；原支付：'.(string)$payment['business_type'], 0, 1000),\n                    ]\n                );\n                if ($firstRefundId === null) $firstRefundId = $refundId;\n                $refundIds[] = $refundId;\n            }\n            if (!$refundIds) {\n                throw new OrderOperationException('当前没有可自动原路退款的实际支付，请转人工核对', 'AUTO_REFUND_PAYMENT_MISSING', 409);\n            }\n\n            // 2026-10-08：取消成立时保存失效前的报价/成交事实，与取消退款同事务提交。\n            (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order);\n\n            $db->execute(\n                \"UPDATE orders SET lifecycle_status='cancel_approved_pending_refund',refund_status='pending_review',publish_status='hidden',quote_status='cancelled',assignment_status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n            $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            $db->insert(\n                \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                 VALUES(:request_id,:order_id,'approved','user',:reason,:refund,0,:refund_id,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'request_id'=>$requestId,'order_id'=>$order['id'],\n                    'reason'=>mb_substr('系统执行已获准退款；原因：'.$reason, 0, 1000),\n                    'refund'=>$refundAmount,'refund_id'=>$firstRefundId,\n                ]\n            );\n            $this->event($db, (int)$order['id'], 'cancel_approved', 'system', 0, [\n                'refund_amount_cents'=>$refundAmount,'refund_count'=>count($refundIds),'auto_approved'=>1,\n                'requested_by_user_id'=>$userId,\n                'message'=>'系统已取消订单并登记 '.count($refundIds).' 笔原路退款，无需管理员审核',\n                'notify_recipients'=>$agreed ? ['user','worker'] : ['user'],\n            ]);\n            return ['request_id'=>$requestPublicId,'auto_approved'=>true,'refund_cents'=>$refundAmount,'refund_count'=>count($refundIds)];\n    }\n\n    public function review(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array {\n        $operation = function () use ($operator, $orderNo, $decision, $workerArrived, $responsibility, $reason, $refundCents): array {\n            return $this->reviewUnderWriteGuard($operator, $orderNo, $decision, $workerArrived, $responsibility, $reason, $refundCents);\n        };\n        if (($operator['channel'] ?? '') === 'web_admin') {\n            return (new DatabaseDemoOrderWriteGuard($this->db))->run($orderNo, $operation);\n        }\n        return $operation();\n    }\n\n    private function reviewUnderWriteGuard(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array {\n        $channel = (string)($operator['channel'] ?? '');\n        if ($channel === 'mini_admin') {\n            $operatorId = max(0, (int)($operator['user_id'] ?? 0));\n            $webAdminId = 0;\n        } elseif ($channel === 'web_admin') {\n            $operatorId = max(0, (int)($operator['admin_user_id'] ?? 0));\n            $webAdminId = $operatorId;\n        } else {\n            $operatorId = 0;\n            $webAdminId = 0;\n        }\n        if ($operatorId < 1) {\n            throw new OrderOperationException('管理员操作来源无效', 'ADMIN_REQUIRED', 403);\n        }\n        $decidedBy = $webAdminId > 0 ? $webAdminId : null;\n\n        return $this->db->transaction(function (Database $db) use ($orderNo,$decision,$workerArrived,$responsibility,$reason,$refundCents,$channel,$operatorId,$decidedBy): array {\n            $order = $db->fetch(\n                'SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $request = $db->fetch(\n                \"SELECT * FROM order_cancel_requests\n                 WHERE order_id=:order_id AND status='pending'\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id']]\n            );\n            if (!$request) {\n                throw new OrderOperationException('当前没有待审核退款申请', 'REFUND_REVIEW_CHANGED', 409);\n            }\n            if (in_array((string)$request['reason_code'], ['bilateral_refund_pending','bilateral_refund_rejected'], true)) {\n                throw new OrderOperationException('请先由订单双方申请平台介入', 'NEGOTIATION_NOT_ESCALATED', 409);\n            }\n            if ((string)$request['reason_code'] === 'bilateral_refund_execution_required') {\n                throw new OrderOperationException(\n                    '双方已经接受退款方案；当前涉及资金核账或历史入账，请到 Web 后台按真实资金记录执行，不能在小程序重新通过或拒绝',\n                    'REFUND_EXECUTION_WEB_REQUIRED',\n                    409\n                );\n            }\n\n            $needsArrival = !empty($order['assigned_worker_id'])\n                || in_array((string)($order['assignment_status'] ?? ''), ['offered','accepted','assigned'], true)\n                || in_array((string)($order['fulfillment_status'] ?? ''), ['scheduled','in_progress'], true);\n            if (!$needsArrival) $workerArrived = 'no';\n            if ($needsArrival && !in_array($workerArrived, ['yes','no'], true)) {\n                throw new OrderOperationException('请确认师傅是否已经上门', 'WORKER_ARRIVAL_REQUIRED', 422);\n            }\n            $responsibilityLabels = [\n                'worker'=>'师傅','user'=>'用户','platform'=>'平台','shared'=>'双方','unclear'=>'待定',\n            ];\n            $decisionReason = ($workerArrived === 'yes' ? '师傅已上门' : '师傅未上门')\n                .'；责任：'.$responsibilityLabels[$responsibility].'；'.$reason;\n\n            if ($decision === 'reject') {\n                $changed = $db->execute(\n                    \"UPDATE order_cancel_requests\n                     SET status='rejected',closed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                     WHERE id=:id AND status='pending'\",\n                    ['id'=>$request['id']]\n                );\n                if ($changed !== 1) {\n                    throw new OrderOperationException('退款申请状态已变化，请刷新', 'REFUND_REVIEW_CHANGED', 409);\n                }\n                $hasMeasurementLink = (bool)$db->fetchValue(\n                    \"SELECT 1 FROM order_relations\n                     WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1\",\n                    ['id'=>$order['id']]\n                );\n                $snapshot = $this->decodeSnapshot((string)($request['order_state_snapshot_json'] ?? ''));\n                $restorePublish = (string)($snapshot['publish_status'] ?? 'hidden');\n                if (!in_array($restorePublish, ['published','hidden'], true)) $restorePublish = 'hidden';\n                if ($hasMeasurementLink) $restorePublish = 'hidden';\n                $restoreRefund = (string)($snapshot['refund_status'] ?? 'none');\n                if (!in_array($restoreRefund, ['','none','failed'], true)) $restoreRefund = 'none';\n                if ($restoreRefund === '') $restoreRefund = 'none';\n                $db->execute(\n                    \"UPDATE orders\n                     SET refund_status=:refund_status,publish_status=:publish_status,\n                         updated_at=UTC_TIMESTAMP(),version=version+1\n                     WHERE id=:id\",\n                    [\n                        'refund_status'=>$restoreRefund,\n                        'publish_status'=>$restorePublish,\n                        'id'=>$order['id'],\n                    ]\n                );\n                $db->insert(\n                    \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                     VALUES(:request_id,:order_id,'rejected',:responsibility,:reason,0,0,NULL,:decided_by,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'request_id'=>$request['id'],'order_id'=>$order['id'],\n                        'responsibility'=>$responsibility,'reason'=>$decisionReason,'decided_by'=>$decidedBy,\n                    ]\n                );\n                $this->event($db, (int)$order['id'], 'cancel_rejected', $channel, $operatorId, [\n                    'message'=>'退款申请未通过：'.$decisionReason,\n                    'restored_publish_status'=>$restorePublish,\n                    'operator_channel'=>$channel,\n                    'operator_user_id'=>$channel === 'mini_admin' ? $operatorId : null,\n                    'operator_admin_id'=>$channel === 'web_admin' ? $operatorId : null,\n                    'notify_recipients'=>['user'],\n                ]);\n                return ['approved'=>false,'refund_cents'=>0,'refund_ids'=>[]];\n            }\n\n            if ($workerArrived === 'yes' && $responsibility !== 'worker') {\n                throw new OrderOperationException(\n                    '师傅已上门且不是师傅责任时，请拒绝退款并记录说明',\n                    'REFUND_ARRIVAL_RESPONSIBILITY_CONFLICT',\n                    422\n                );\n            }\n\n            $payments = $this->refundablePayments($db, $order);\n            $available = array_sum(array_map(static function (array $row): int {\n                return (int)$row['available_cents'];\n            }, $payments));\n            $requested = max(0, (int)$request['requested_refund_cents']);\n            $maxRefund = $requested > 0 ? min($available, $requested) : $available;\n            if ($maxRefund > 0 && $refundCents < 1) {\n                throw new OrderOperationException('请填写退款金额', 'REFUND_AMOUNT_REQUIRED', 422);\n            }\n            if ($refundCents > $maxRefund) {\n                throw new OrderOperationException(\n                    '退款金额超过当前可退线上余额 '.number_format($maxRefund/100, 2).' 元',\n                    'REFUND_AMOUNT_EXCEEDS_AVAILABLE',\n                    422,\n                    ['max_refund_cents'=>$maxRefund]\n                );\n            }\n\n            $remaining = $refundCents;\n            $refundIds = [];\n            $firstRefundId = null;\n            foreach ($payments as $payment) {\n                if ($remaining <= 0) break;\n                $part = min($remaining, (int)$payment['available_cents']);\n                if ($part < 1) continue;\n                $refundId = $db->insert(\n                    \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                     VALUES(:public_no,:payment_id,:order_id,:request_id,:amount,:reason,'pending_review',:requested_by_admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_no'=>\\business_no('RF'),\n                        'payment_id'=>$payment['id'],\n                        'order_id'=>$order['id'],\n                        'request_id'=>$request['id'],\n                        'amount'=>$part,\n                        'reason'=>$decisionReason.'；原支付：'.(string)$payment['business_type'],\n                        'requested_by_admin_id'=>$decidedBy,\n                    ]\n                );\n                if ($firstRefundId === null) $firstRefundId = $refundId;\n                $refundIds[] = $refundId;\n                $remaining -= $part;\n            }\n            if ($remaining > 0) {\n                throw new OrderOperationException(\n                    '退款拆分失败，当前原支付可退余额不足，请刷新后重试',\n                    'REFUND_SPLIT_BALANCE_CHANGED',\n                    409\n                );\n            }\n\n            // 先抢占 pending 取消申请，再推进订单；网络重试或并发请求只能有一个事务成功。\n            $requestChanged = $db->execute(\n                \"UPDATE order_cancel_requests\n                 SET status=:status,requested_refund_cents=:refund,\n                     closed_at=IF(:close_now=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='pending'\",\n                [\n                    'status'=>$refundCents > 0 ? 'processing' : 'approved',\n                    'refund'=>$refundCents,\n                    'close_now'=>$refundCents > 0 ? 0 : 1,\n                    'id'=>$request['id'],\n                ]\n            );\n            if ($requestChanged !== 1) {\n                throw new OrderOperationException('退款申请状态已变化，请刷新', 'REFUND_REVIEW_CHANGED', 409);\n            }\n\n            $lifecycle = $refundCents > 0 ? 'cancel_approved_pending_refund' : 'cancelled';\n            (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order, $responsibility);\n            $refundStatus = $refundCents > 0 ? 'pending_review' : 'none';\n            $db->execute(\n                \"UPDATE orders\n                 SET lifecycle_status=:lifecycle,refund_status=:refund_status,publish_status='hidden',\n                     quote_status='cancelled',assignment_status='cancelled',cancelled_at=UTC_TIMESTAMP(),\n                     closed_at=IF(:close_now=1,COALESCE(closed_at,UTC_TIMESTAMP()),closed_at),\n                     updated_at=UTC_TIMESTAMP(),version=version+1\n                 WHERE id=:id\",\n                [\n                    'lifecycle'=>$lifecycle,'refund_status'=>$refundStatus,\n                    'close_now'=>$refundCents > 0 ? 0 : 1,'id'=>$order['id'],\n                ]\n            );\n            $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            $db->insert(\n                \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                 VALUES(:request_id,:order_id,'approved',:responsibility,:reason,:refund,0,:refund_id,:decided_by,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'request_id'=>$request['id'],'order_id'=>$order['id'],'responsibility'=>$responsibility,\n                    'reason'=>$decisionReason,'refund'=>$refundCents,'refund_id'=>$firstRefundId,'decided_by'=>$decidedBy,\n                ]\n            );\n            $this->event($db, (int)$order['id'], 'cancel_approved', $channel, $operatorId, [\n                'refund_amount_cents'=>$refundCents,\n                'refund_count'=>count($refundIds),\n                'message'=>$refundCents > 0\n                    ? '退款审核通过，已按原支付单拆分为 '.count($refundIds).' 笔微信退款'\n                    : '取消申请通过，无线上款项需退',\n                'operator_channel'=>$channel,\n                'operator_user_id'=>$channel === 'mini_admin' ? $operatorId : null,\n                'operator_admin_id'=>$channel === 'web_admin' ? $operatorId : null,\n                'notify_recipients'=>['user'],\n            ]);\n            return ['approved'=>true,'refund_cents'=>$refundCents,'refund_ids'=>$refundIds];\n        });\n    }\n\n    /** @return array<int,array<string,mixed>> */\n    private function refundablePayments(Database $db, array $order): array\n    {\n        $measurement = (string)($order['workflow_profile'] ?? 'construction') === 'measurement';\n        $types = $measurement ? ['order_booking','booking_fee','measurement_balance','measurement_change'] : ['order_booking','booking_fee'];\n        $marks = [];\n        $params = ['order_id'=>$order['id']];\n        foreach ($types as $index=>$type) {\n            $key = 'type_'.$index;\n            $marks[] = ':'.$key;\n            $params[$key] = $type;\n        }\n        $rows = $db->fetchAll(\n            \"SELECT * FROM payment_orders WHERE order_id=:order_id AND business_type IN (\".implode(',', $marks).\") AND status IN ('paid','refunded')\n             ORDER BY CASE business_type WHEN 'measurement_change' THEN 1 WHEN 'measurement_balance' THEN 2 WHEN 'booking_fee' THEN 3 WHEN 'order_booking' THEN 4 ELSE 9 END,id DESC FOR UPDATE\",\n            $params\n        );\n        $runnerRemaining = (int)$db->fetchValue(\n            \"SELECT COALESCE(SUM(l.amount_cents),0) FROM worker_balance_ledger l\n             INNER JOIN disputes d ON d.id=l.business_id\n             WHERE l.business_type='dispute' AND l.entry_type='run_empty_fee' AND l.status='effective' AND d.order_id=:order_id\",\n            ['order_id'=>$order['id']]\n        );\n        $result = [];\n        foreach ($rows as $row) {\n            $refundAllocated = (int)$db->fetchValue(\n                \"SELECT COALESCE(SUM(amount_cents),0) FROM refunds WHERE payment_order_id=:payment_id AND status NOT IN ('failed','closed','cancelled','rejected')\",\n                ['payment_id'=>$row['id']]\n            );\n            $cap = max(0, (int)$row['amount_cents']);\n            if (in_array((string)$row['business_type'], ['order_booking','booking_fee'], true)) {\n                if ((int)($order['booking_fee_cents'] ?? 0) > 0) $cap = min($cap, (int)$order['booking_fee_cents']);\n                $runnerApplied = min($cap, max(0, $runnerRemaining));\n                $runnerRemaining = max(0, $runnerRemaining - $runnerApplied);\n            } else {\n                $runnerApplied = 0;\n            }\n            $available = max(0, $cap - $refundAllocated - $runnerApplied);\n            if ($available < 1) continue;\n            $row['available_cents'] = $available;\n            $result[] = $row;\n        }\n        return $result;\n    }\n\n    private function canAutoApproveBeforeService(Database $db, array $order): bool\n    {\n        if ((string)($order['order_source_type'] ?? 'consumer') !== 'consumer') return false;\n        if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) return false;\n        if (!empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) return false;\n        if (!empty($order['contact_revealed_at']) || !empty($order['completion_submitted_at']) || !empty($order['accepted_at'])) return false;\n        if (in_array((string)($order['fulfillment_status'] ?? ''), ['scheduled','in_progress','submitted','accepted'], true)) return false;\n\n        $blocked = (int)$db->fetchValue(\n            \"SELECT (\n                EXISTS(SELECT 1 FROM assignments WHERE order_id=:a LIMIT 1)\n                OR EXISTS(SELECT 1 FROM quote_selections WHERE order_id=:q LIMIT 1)\n                OR EXISTS(SELECT 1 FROM appointment_records WHERE order_id=:ap LIMIT 1)\n                OR EXISTS(SELECT 1 FROM change_requests WHERE order_id=:c LIMIT 1)\n                OR EXISTS(SELECT 1 FROM disputes WHERE order_id=:d LIMIT 1)\n                OR EXISTS(SELECT 1 FROM after_sales WHERE order_id=:s LIMIT 1)\n                OR EXISTS(SELECT 1 FROM run_empty_fee_claims WHERE order_id=:r LIMIT 1)\n            ) AS blocked\",\n            ['a'=>$order['id'],'q'=>$order['id'],'ap'=>$order['id'],'c'=>$order['id'],'d'=>$order['id'],'s'=>$order['id'],'r'=>$order['id']]\n        );\n        return $blocked === 0;\n    }\n\n    /** @return array<string,mixed> */\n    private function decodeSnapshot(string $json): array\n    {\n        $decoded = json_decode($json, true);\n        return is_array($decoded) ? $decoded : [];\n    }\n\n    private function snapshot(array $order): string\n    {\n        $json = json_encode([\n            'lifecycle_status'=>$order['lifecycle_status'] ?? null,\n            'fulfillment_status'=>$order['fulfillment_status'] ?? null,\n            'payment_status'=>$order['payment_status'] ?? null,\n            'workflow_profile'=>$order['workflow_profile'] ?? null,\n            'order_source_type'=>$order['order_source_type'] ?? null,\n            'refund_status'=>$order['refund_status'] ?? null,\n            'publish_status'=>$order['publish_status'] ?? null,\n            'quote_status'=>$order['quote_status'] ?? null,\n            'assignment_status'=>$order['assignment_status'] ?? null,\n            'selected_quote_id'=>$order['selected_quote_id'] ?? null,\n            'assigned_worker_id'=>$order['assigned_worker_id'] ?? null,\n        ], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        return is_string($json) ? $json : '{}';\n    }\n\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey = $type.':'.$orderId.':'.bin2hex(random_bytes(6));\n        $db->insert(\n            'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$eventKey,'actor_type'=>$actorType,\n                'actor_id'=>$actorId > 0 ? $actorId : null,\n                'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        OrderNotificationService::queue($db, $orderId, $eventKey, $type, $payload);\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCancellationRiskRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\OrderCancellationRiskRepository;\nuse WorkerAdmin\\Domain\\Order\\CancellationRiskPolicy;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\n/** 2026-10-08：取消事实、原预约/取证信号与下单限制共用账号锁；不改变原退款执行器。 */\nfinal class DatabaseOrderCancellationRiskRepository implements OrderCancellationRiskRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db) { $this->db = $db; }\n\n    public function configuration(): array\n    {\n        $raw = $this->db->fetchValue('SELECT setting_value FROM system_settings WHERE setting_key=:key', ['key'=>'order.cancellation_risk']);\n        $input = json_decode((string)$raw, true);\n        return CancellationRiskPolicy::config(is_array($input) ? $input : []);\n    }\n\n    public function user(int $userId): ?array\n    { return $this->db->fetch('SELECT id,public_id,nickname FROM users WHERE id=:id', ['id'=>$userId]); }\n\n    public function saveConfiguration(array $rules): void\n    {\n        $this->db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,description,is_public,created_at,updated_at)\n            VALUES('order.cancellation_risk',:value,'json','order','频繁取消下单风控',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n            ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),updated_at=UTC_TIMESTAMP()\",\n            ['value'=>json_encode(CancellationRiskPolicy::config($rules),JSON_UNESCAPED_UNICODE)]);\n    }\n\n    public function state(int $userId): array\n    {\n        $row = $this->db->fetch('SELECT blocked_until,last_restriction_id,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n        $active = $row && !empty($row['blocked_until']) && $row['blocked_until'] > $row['now_utc'];\n        $until = $active ? (string)$row['blocked_until'] : null;\n        $local = $until ? (new \\DateTimeImmutable($until, new \\DateTimeZone('UTC')))->setTimezone(new \\DateTimeZone('Asia/Shanghai'))->format('Y-m-d H:i') : null;\n        return ['restricted'=>(bool)$active, 'expires_at_utc'=>$until, 'expires_at'=>$local,\n            'message'=>$active ? '当前已暂停新下单，将于'.$local.'自动恢复。如有误判，请联系客服核实解除。' : '',\n            'restriction_id'=>$active ? (int)$row['last_restriction_id'] : null];\n    }\n\n    // 调用方已有订单锁时按“订单→账号”顺序；草稿创建只锁账号，不锁其它已有订单。\n    public function assertCanSubmit(int $userId, ?array $order = null): void\n    {\n        if ($order !== null && !$this->eligible($order)) return;\n        $this->db->transaction(function () use ($userId): void {\n            $this->lockAccount($userId);\n            $state = $this->state($userId);\n            if ($state['restricted']) throw new OrderOperationException($state['message'], 'ORDER_SUBMISSION_RESTRICTED', 403, $state);\n        });\n    }\n\n    // 2026-10-08：支付回调只判断准入而不抛业务拒绝，确保真实到账仍然入账及原路退款。\n    public function canPublish(array $order): bool\n    {\n        if (!$this->eligible($order)) return true;\n        return $this->db->transaction(function () use ($order): bool {\n            $this->lockAccount((int)$order['user_id']);\n            return !$this->state((int)$order['user_id'])['restricted'];\n        });\n    }\n\n    /** 必须在订单失效报价/指派前、同一取消事务内调用；仅取消成立后该事务才会提交。 */\n    public function captureCancellation(array $order, string $responsibility = 'unclear', int $runEmptyCents = 0): void\n    {\n        if (!$this->eligible($order)) return;\n        $this->db->transaction(function () use ($order,$responsibility,$runEmptyCents): void {\n            $userId = (int)$order['user_id'];\n            $this->lockAccount($userId);\n            if (in_array($responsibility, ['worker','platform'], true)) {\n                $this->db->execute('UPDATE order_cancellation_risk_scores SET excluded_at=UTC_TIMESTAMP(),exclusion_reason=:reason,updated_at=UTC_TIMESTAMP() WHERE order_id=:id', ['reason'=>$responsibility.'责任免计分','id'=>$order['id']]);\n                return;\n            }\n            $quoted = (bool)$this->db->fetchValue(\"SELECT id FROM quotes WHERE order_id=:id AND worker_id>0 AND status IN ('active','selected') AND (expires_at IS NULL OR expires_at>UTC_TIMESTAMP()) LIMIT 1\", ['id'=>$order['id']]);\n            $dealt = !empty($order['selected_quote_id']) || (string)($order['assignment_status'] ?? '') === 'accepted';\n            $config = $this->configuration();\n            $base = CancellationRiskPolicy::score($quoted, $dealt, [], $runEmptyCents > 0, $config);\n            $snapshot = json_encode(['quoted'=>$quoted,'dealt'=>$dealt,'run_empty_cents'=>$runEmptyCents,\n                'assignment_id'=>$order['current_assignment_id'] ?? null,'worker_id'=>$order['assigned_worker_id'] ?? null,\n                'responsibility'=>$responsibility,'config'=>$config], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $this->db->execute(\"INSERT INTO order_cancellation_risk_scores(order_id,user_id,base_score,score,cancelled_at,snapshot_json,created_at,updated_at)\n                VALUES(:order_id,:user_id,:base,:base,COALESCE(:cancelled_at,UTC_TIMESTAMP()),:snapshot,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n                ON DUPLICATE KEY UPDATE base_score=GREATEST(base_score,VALUES(base_score)),updated_at=UTC_TIMESTAMP()\",\n                ['order_id'=>$order['id'],'user_id'=>$userId,'base'=>$base,'cancelled_at'=>$order['cancelled_at'] ?? null,'snapshot'=>$snapshot]);\n            $this->recalculateOrder((int)$order['id'], $config);\n            $this->evaluate($userId, $config);\n        });\n    }\n\n    /** 原电话、预约和异常入口写入；没有实际取消则只记录信号，不计分。 */\n    public function recordExistingSignal(int $orderId, int $workerId, string $kind, string $note = ''): void\n    {\n        if (!in_array($kind, ['dialed','contacted','complaint'], true)) throw new OrderOperationException('联系行为无效', 'RISK_SIGNAL_INVALID');\n        $this->db->transaction(function () use ($orderId,$workerId,$kind,$note): void {\n            $order = $this->db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$orderId]);\n            if (!$order || !$this->eligible($order)) return;\n            $workerUser = (int)$this->db->fetchValue('SELECT user_id FROM worker_profiles WHERE id=:id', ['id'=>$workerId]);\n            $participated = $this->db->fetchValue('SELECT id FROM quotes WHERE order_id=:id AND worker_id=:worker LIMIT 1', ['id'=>$orderId,'worker'=>$workerId])\n                || $this->db->fetchValue('SELECT id FROM assignments WHERE order_id=:id AND worker_id=:worker LIMIT 1', ['id'=>$orderId,'worker'=>$workerId]);\n            if ($workerId < 1 || !$participated || $workerUser === (int)$order['user_id']) throw new OrderOperationException('无权记录本单联系行为', 'FORBIDDEN', 403);\n            if ($kind !== 'complaint' && (string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('订单已结束，不能补记联系行为', 'ORDER_NOT_ACTIVE', 409);\n            $userId = (int)$order['user_id'];\n            $this->lockAccount($userId);\n            $this->db->execute(\"INSERT IGNORE INTO order_cancellation_risk_signals(order_id,worker_id,signal_type,note,created_at)\n                VALUES(:id,:worker,:kind,:note,UTC_TIMESTAMP())\", ['id'=>$orderId,'worker'=>$workerId,'kind'=>$kind,'note'=>mb_substr($note,0,500)]);\n            $config = $this->configuration();\n            $this->recalculateOrder($orderId, $config);\n            $this->evaluate($userId, $config);\n        });\n    }\n\n    public function recordDial(array $actor, string $publicNo): void\n    {\n        $this->db->transaction(function () use ($actor,$publicNo): void {\n            $order = $this->db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :no FOR UPDATE', ['no'=>$publicNo]);\n            $worker = (int)($actor['worker_id'] ?? 0);\n            if (!$order || $worker < 1 || (int)($order['assigned_worker_id'] ?? 0) !== $worker\n                || !$this->db->fetchValue(\"SELECT id FROM assignments WHERE id=:assignment AND order_id=:id AND worker_id=:worker AND status IN ('accepted','completed') LIMIT 1\", ['assignment'=>$order['current_assignment_id'] ?? 0,'id'=>$order['id'],'worker'=>$worker])) {\n                throw new OrderOperationException('接受本单后才能拨打业主电话', 'FORBIDDEN', 403);\n            }\n            // 已完成后的正常售后拨号不属于取消主订单的风险，不因限单阻止联系。\n            if ((string)$order['lifecycle_status'] === 'active') $this->recordExistingSignal((int)$order['id'], $worker, 'dialed');\n        });\n    }\n\n    public function reviewData(int $userId): array\n    {\n        $scores=$this->db->fetchAll('SELECT s.*,o.public_no FROM order_cancellation_risk_scores s JOIN orders o ON o.id=s.order_id WHERE s.user_id=:id ORDER BY s.cancelled_at DESC LIMIT 50', ['id'=>$userId]);\n        foreach ($scores as &$score) $score['signals']=$this->db->fetchAll('SELECT worker_id,signal_type,note,created_at,revoked_at FROM order_cancellation_risk_signals WHERE order_id=:id ORDER BY created_at,id', ['id'=>$score['order_id']]);\n        unset($score);\n        return ['state'=>$this->state($userId), 'scores'=>$scores,\n            'restrictions'=>$this->db->fetchAll('SELECT * FROM order_cancellation_risk_restrictions WHERE user_id=:id ORDER BY id DESC LIMIT 20', ['id'=>$userId])];\n    }\n\n    public function restrictManually(int $userId, int $adminId, int $days, string $reason): void\n    {\n        $days=max(1,min(30,$days));\n        $reason=trim($reason);\n        if ($userId<1 || $adminId<1) throw new OrderOperationException('用户或管理员无效', 'MANUAL_RESTRICTION_INVALID');\n        if (mb_strlen($reason)<2) throw new OrderOperationException('请填写人工限制原因', 'MANUAL_RESTRICTION_REASON_REQUIRED');\n        $this->db->transaction(function () use ($userId,$adminId,$days,$reason): void {\n            $account=$this->lockAccount($userId);\n            if (!empty($account['blocked_until']) && $account['blocked_until']>$account['now_utc']) {\n                throw new OrderOperationException('该用户当前已有生效中的下单限制，请先核实或解除', 'RESTRICTION_ALREADY_ACTIVE', 409);\n            }\n            $snapshot=json_encode(['rule_version'=>'manual-v1','source'=>'admin','admin_id'=>$adminId,'days'=>$days,'reason'=>mb_substr($reason,0,500)],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $id=$this->db->insert('INSERT INTO order_cancellation_risk_restrictions(user_id,starts_at,expires_at,snapshot_json) VALUES(:user,UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL '.(int)$days.' DAY),:snapshot)', ['user'=>$userId,'snapshot'=>$snapshot]);\n            $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=(SELECT expires_at FROM order_cancellation_risk_restrictions WHERE id=:restriction),last_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user', ['restriction'=>$id,'user'=>$userId]);\n        });\n    }\n\n    public function release(int $userId, int $adminId, string $reason, array $excludedOrderIds = [], ?int $expectedId = null): void\n    {\n        if ($adminId < 1 || mb_strlen(trim($reason)) < 2) throw new OrderOperationException('请填写解除原因', 'RELEASE_REASON_REQUIRED');\n        $this->db->transaction(function () use ($userId,$adminId,$reason,$excludedOrderIds,$expectedId): void {\n            $account = $this->lockAccount($userId);\n            $id = (int)($account['last_restriction_id'] ?? 0);\n            if ($id < 1 || ($expectedId !== null && $id !== $expectedId)) throw new OrderOperationException('限制记录已变化，请刷新重试', 'RESTRICTION_CHANGED', 409);\n            $restriction = $this->db->fetch('SELECT * FROM order_cancellation_risk_restrictions WHERE id=:id FOR UPDATE', ['id'=>$id]);\n            if (!empty($restriction['released_at'])) return;\n            foreach (array_unique(array_map('intval', $excludedOrderIds)) as $orderId) {\n                $this->db->execute('UPDATE order_cancellation_risk_scores SET excluded_at=UTC_TIMESTAMP(),exclusion_reason=:reason,updated_at=UTC_TIMESTAMP() WHERE order_id=:order AND user_id=:user', ['reason'=>mb_substr($reason,0,500),'order'=>$orderId,'user'=>$userId]);\n            }\n            if (!$this->manualRestriction($restriction)) $this->consume($userId,$id);\n            $this->db->execute('UPDATE order_cancellation_risk_restrictions SET released_at=UTC_TIMESTAMP(),released_by_admin_id=:admin,release_reason=:reason WHERE id=:id', ['admin'=>$adminId,'reason'=>mb_substr($reason,0,500),'id'=>$id]);\n            $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=NULL,updated_at=UTC_TIMESTAMP() WHERE user_id=:id', ['id'=>$userId]);\n        });\n    }\n\n    private function eligible(array $order): bool\n    {\n        return empty($order['is_demo']) && (string)($order['order_source_type'] ?? 'consumer') !== 'platform' && (int)($order['user_id'] ?? 0) > 0;\n    }\n\n    private function lockAccount(int $userId): array\n    {\n        $this->db->execute('INSERT INTO order_cancellation_risk_accounts(user_id,updated_at) VALUES(:id,UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE user_id=VALUES(user_id)', ['id'=>$userId]);\n        return $this->db->fetch('SELECT *,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n    }\n\n    private function recalculateOrder(int $orderId, array $config): void\n    {\n        $score = $this->db->fetch('SELECT base_score,cancelled_at FROM order_cancellation_risk_scores WHERE order_id=:id FOR UPDATE', ['id'=>$orderId]);\n        if (!$score) return;\n        $rows = $this->db->fetchAll(\"SELECT signal_type FROM order_cancellation_risk_signals WHERE order_id=:id AND revoked_at IS NULL\n            AND (signal_type='complaint' OR created_at<=:cancelled_at) FOR UPDATE\", ['id'=>$orderId,'cancelled_at'=>$score['cancelled_at']]);\n        $points = max((int)$score['base_score'], CancellationRiskPolicy::score(false,false,array_column($rows,'signal_type'),false,$config));\n        $this->db->execute('UPDATE order_cancellation_risk_scores SET score=:score,updated_at=UTC_TIMESTAMP() WHERE order_id=:id', ['score'=>$points,'id'=>$orderId]);\n    }\n\n    private function evaluate(int $userId, array $config): void\n    {\n        $account = $this->db->fetch('SELECT *,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n        if (!empty($account['blocked_until']) && $account['blocked_until'] > $account['now_utc']) {\n            $restriction=$this->db->fetch('SELECT snapshot_json FROM order_cancellation_risk_restrictions WHERE id=:id FOR UPDATE',['id'=>(int)$account['last_restriction_id']]);\n            if (!$this->manualRestriction($restriction ?: [])) $this->consume($userId,(int)$account['last_restriction_id']);\n            return;\n        }\n        // 使用当前读：取消事务此前可能已建立 RR 快照，账号锁等待后仍须看见另一单的最新提交。\n        $rows = $this->db->fetchAll('SELECT order_id,score,cancelled_at,snapshot_json FROM order_cancellation_risk_scores WHERE user_id=:id AND excluded_at IS NULL AND consumed_restriction_id IS NULL AND score>0 AND cancelled_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL '.$config['long_days'].' DAY) FOR UPDATE', ['id'=>$userId]);\n        $match = CancellationRiskPolicy::threshold($rows, (int)strtotime($account['now_utc'].' UTC'), $config);\n        if (!$match) return;\n        $facts=[];\n        foreach ($rows as $row) $facts[]=['order_id'=>$row['order_id'],\n            'cancellation'=>json_decode($row['snapshot_json'],true),\n            'signals'=>$this->db->fetchAll('SELECT worker_id,signal_type,note,created_at,revoked_at FROM order_cancellation_risk_signals WHERE order_id=:id FOR UPDATE',['id'=>$row['order_id']])];\n        $snapshot = json_encode(['rule_version'=>'2026-10-08','config'=>$config,'match'=>$match,'scores'=>$rows,'facts'=>$facts], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $id = $this->db->insert('INSERT INTO order_cancellation_risk_restrictions(user_id,starts_at,expires_at,snapshot_json) VALUES(:user,UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL 7 DAY),:snapshot)', ['user'=>$userId,'snapshot'=>$snapshot]);\n        $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=(SELECT expires_at FROM order_cancellation_risk_restrictions WHERE id=:restriction),last_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user', ['restriction'=>$id,'user'=>$userId]);\n        $this->consume($userId,$id);\n    }\n\n    private function manualRestriction(array $restriction): bool\n    {\n        $snapshot=json_decode((string)($restriction['snapshot_json'] ?? ''),true);\n        return is_array($snapshot) && ($snapshot['source'] ?? '')==='admin';\n    }\n\n    private function consume(int $userId, int $restrictionId): void\n    {\n        if ($restrictionId < 1) return;\n        $this->db->execute('UPDATE order_cancellation_risk_scores SET consumed_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user AND consumed_restriction_id IS NULL AND excluded_at IS NULL AND score>0', ['restriction'=>$restrictionId,'user'=>$userId]);\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCenterRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderCenterRepository;\nuse WorkerAdmin\\Core\\Database;\n\nfinal class DatabaseOrderCenterRepository implements OrderCenterRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    // Shared SQL scope for lists and attention counts; no page-size approximation.\n    public static function scope(array $actor, string $kind, string $status, string $keyword = ''): array\n    {\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        $params = ['own_worker_id' => $workerId];\n\n        if ($kind === 'mine') {\n            $where = \"o.user_id=:center_user_id AND o.lifecycle_status<>'archived'\";\n            $params['center_user_id'] = (int)$actor['user_id'];\n        } else {\n            if ($workerId < 1) return ['1=0', []];\n            $where = \"o.lifecycle_status<>'archived' AND (\n                EXISTS(SELECT 1 FROM quotes q0 WHERE q0.order_id=o.id AND q0.worker_id=:center_quote_worker AND q0.status IN ('active','selected'))\n                OR EXISTS(SELECT 1 FROM assignments a0 WHERE a0.order_id=o.id AND a0.worker_id=:center_assignment_worker AND a0.status IN ('offered','accepted'))\n                OR EXISTS(SELECT 1 FROM invite_tokens it0 WHERE it0.order_id=o.id AND it0.claimed_worker_id=:center_invite_worker AND it0.status='claimed')\n                OR (o.assigned_worker_id=:center_refund_worker AND o.refund_status IN ('pending_review','approved','processing','refunding','succeeded'))\n            )\";\n            $params['center_quote_worker'] = $workerId;\n            $params['center_assignment_worker'] = $workerId;\n            $params['center_invite_worker'] = $workerId;\n            $params['center_refund_worker'] = $workerId;\n        }\n\n        $where .= !empty($actor['is_demo_actor']) ? ' AND o.is_demo=1' : ' AND o.is_demo=0';\n        $keyword = trim($keyword);\n        if ($kind === 'mine' && $keyword !== '') {\n            $pattern = '%' . $keyword . '%';\n            // PDO 原生预处理下不复用同名占位符；所有权条件已经在前面固定为当前 user_id。\n            $where .= \" AND (\n                o.public_no LIKE :center_keyword_no\n                OR CONCAT_WS(' ',COALESCE(o.title,''),COALESCE(o.category_names_snapshot,''),COALESCE(o.category_name_snapshot,''),COALESCE(o.district,''),COALESCE(o.address_summary,'')) LIKE :center_keyword_text\n            )\";\n            $params['center_keyword_no'] = $pattern;\n            $params['center_keyword_text'] = $pattern;\n        }\n        $activeRepairSql = \"EXISTS(SELECT 1 FROM after_sales ar_active WHERE ar_active.order_id=o.id AND ar_active.type='warranty_repair' AND ar_active.status IN ('open','processing'))\";\n        $pricingAwaitingCustomerSql = \"o.order_source_type='platform'\n            AND EXISTS(SELECT 1 FROM order_events pre WHERE pre.order_id=o.id AND pre.event_type='platform_measurement_pricing_reviewed')\n            AND NOT EXISTS(SELECT 1 FROM order_events pce WHERE pce.order_id=o.id AND pce.event_type='platform_measurement_pricing_confirmed')\";\n        $constructionAppointmentTodoSql = \"o.order_source_type='platform'\n            AND o.workflow_profile='construction'\n            AND o.fulfillment_status='not_started'\n            AND EXISTS(SELECT 1 FROM order_events prc WHERE prc.order_id=o.id AND prc.event_type='platform_measurement_pricing_reviewed')\n            AND EXISTS(SELECT 1 FROM order_events pcc WHERE pcc.order_id=o.id AND pcc.event_type='platform_measurement_pricing_confirmed')\n            AND NOT EXISTS(SELECT 1 FROM appointment_records pac WHERE pac.order_id=o.id AND pac.context_type='service')\";\n\n        if ($status === 'todo') {\n            if ($kind === 'mine') {\n                $where .= \" AND o.lifecycle_status='active' AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND (\n                    o.audit_status='supplement_required'\n                    OR (o.audit_status='draft' AND o.payment_status='awaiting_payment')\n                    OR ({$pricingAwaitingCustomerSql})\n                    OR (o.fulfillment_status='submitted' AND o.dispute_status NOT IN ('open','processing'))\n                    OR (o.audit_status='approved' AND o.selected_quote_id IS NULL AND EXISTS(SELECT 1 FROM quotes qt WHERE qt.order_id=o.id AND qt.status='active'))\n                    OR EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')))\n                    OR EXISTS(SELECT 1 FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment'))\n                )\";\n            } else {\n                $where .= \" AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND (\n                    (o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL AND EXISTS(\n                        SELECT 1 FROM assignments atodo WHERE atodo.id=o.current_assignment_id AND atodo.worker_id=:todo_worker AND atodo.status='offered'\n                    ))\n                    OR (o.lifecycle_status='active' AND o.assigned_worker_id=:todo_construction_worker AND o.assignment_status='accepted' AND ({$constructionAppointmentTodoSql}))\n                    OR (o.lifecycle_status='active' AND o.order_source_type='platform' AND o.dispatch_mode='multi_quote'\n                        AND o.selected_quote_id IS NULL\n                        AND EXISTS(SELECT 1 FROM invite_tokens ittodo WHERE ittodo.order_id=o.id AND ittodo.claimed_worker_id=:todo_invite_worker AND ittodo.status='claimed')\n                        AND NOT EXISTS(SELECT 1 FROM quotes qtodo WHERE qtodo.order_id=o.id AND qtodo.worker_id=:todo_quote_worker AND qtodo.status IN ('active','selected'))\n                    )\n                    OR (o.assigned_worker_id=:todo_repair_worker AND EXISTS(\n                        SELECT 1 FROM after_sales astodo WHERE astodo.order_id=o.id AND astodo.type='warranty_repair'\n                        AND (astodo.status='open' OR (astodo.status='processing' AND (astodo.resolution IS NULL OR (astodo.resolution NOT LIKE '师傅拒绝维修%' AND astodo.resolution NOT LIKE '用户申请平台介入%'))))\n                    ))\n                )\";\n                $params['todo_worker'] = $workerId;\n                $params['todo_construction_worker'] = $workerId;\n                $params['todo_invite_worker'] = $workerId;\n                $params['todo_quote_worker'] = $workerId;\n                $params['todo_repair_worker'] = $workerId;\n            }\n        } elseif ($status === 'supplement') {\n            $where .= $kind === 'mine'\n                ? \" AND o.audit_status='supplement_required' AND o.lifecycle_status='active'\"\n                : ' AND 1=0';\n        } elseif ($status === 'quoting') {\n            $where .= $kind === 'mine'\n                ? \" AND o.audit_status='approved' AND o.lifecycle_status='active' AND o.selected_quote_id IS NULL AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\"\n                : \" AND o.lifecycle_status='active' AND o.assignment_status<>'accepted' AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\";\n        } elseif ($status === 'progress') {\n            if ($kind === 'mine') {\n                $where .= \" AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND ((o.lifecycle_status='active' AND o.selected_quote_id IS NOT NULL AND o.fulfillment_status<>'accepted') OR {$activeRepairSql})\";\n            } else {\n                $where .= \" AND o.assigned_worker_id=:progress_worker AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND ((o.assignment_status='accepted' AND o.lifecycle_status='active' AND o.fulfillment_status<>'accepted') OR {$activeRepairSql})\";\n                $params['progress_worker'] = $workerId;\n            }\n        } elseif ($status === 'completed') {\n            if ($kind === 'mine') {\n                $where .= \" AND (o.fulfillment_status='accepted' OR o.lifecycle_status='completed') AND NOT {$activeRepairSql}\";\n            } else {\n                $where .= \" AND o.assigned_worker_id=:completed_worker AND (o.fulfillment_status='accepted' OR o.lifecycle_status='completed') AND NOT {$activeRepairSql}\";\n                $params['completed_worker'] = $workerId;\n            }\n        } elseif ($status === 'refunding') {\n            $where .= \" AND (o.refund_status IN ('pending_review','approved','processing','refunding') OR o.lifecycle_status='cancel_approved_pending_refund')\";\n        }\n\n        return [$where,$params];\n    }\n\n    public function page(array $actor, string $kind, string $status, int $page, int $limit, string $keyword = ''): array\n    {\n        $page = max(1, $page);\n        $limit = max(1, min(50, $limit));\n        $offset = ($page - 1) * $limit;\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        if ($kind !== 'mine' && $workerId < 1) return ['rows'=>[], 'has_more'=>false];\n        [$where,$params] = self::scope($actor,$kind,$status,$keyword);\n        $params['invite_worker_flag'] = $workerId;\n        $params['invite_worker_lookup'] = $workerId;\n        $params['invite_token_worker_lookup'] = $workerId;\n        $params['invite_quote_worker_lookup'] = $workerId;\n        $sql = \"SELECT o.*,\n                    (SELECT COUNT(*) FROM quotes q WHERE q.order_id=o.id AND q.status IN ('active','selected')) quote_count,\n                    (SELECT q.amount_cents FROM quotes q WHERE q.order_id=o.id AND q.worker_id=:own_worker_id ORDER BY q.id DESC LIMIT 1) own_quote_cents,\n                    (SELECT mf.public_id FROM media_links ml JOIN media_files mf ON mf.id=ml.media_file_id AND mf.status='active'\n                     WHERE ml.entity_type='order' AND ml.entity_id=o.id\n                     ORDER BY FIELD(ml.purpose,'product','wall','completion','before_optional'),ml.sort_order,ml.id LIMIT 1) cover_media_id,\n                    (SELECT c.public_id FROM change_requests c WHERE c.order_id=o.id AND c.status='pending' ORDER BY c.id DESC LIMIT 1) pending_change_id,\n                    (SELECT rc.status FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment') ORDER BY rc.id DESC LIMIT 1) pending_run_empty_status,\n                    (SELECT COUNT(*) FROM after_sales ast WHERE ast.order_id=o.id AND ast.type='warranty_repair' AND (ast.status='open' OR (ast.status='processing' AND (ast.resolution IS NULL OR (ast.resolution NOT LIKE '师傅拒绝维修%' AND ast.resolution NOT LIKE '用户申请平台介入%'))))) pending_repair_count,\n                    (SELECT ast2.status FROM after_sales ast2 WHERE ast2.order_id=o.id AND ast2.type='warranty_repair' AND ast2.status IN ('open','processing') ORDER BY ast2.id DESC LIMIT 1) active_repair_status,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr WHERE pr.order_id=o.id AND pr.event_type='platform_measurement_pricing_reviewed')\n                        THEN 1 ELSE 0 END platform_pricing_reviewed,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr2 WHERE pr2.order_id=o.id AND pr2.event_type='platform_measurement_pricing_reviewed')\n                        AND NOT EXISTS(SELECT 1 FROM order_events pc2 WHERE pc2.order_id=o.id AND pc2.event_type='platform_measurement_pricing_confirmed')\n                        THEN 1 ELSE 0 END platform_pricing_confirmation_pending,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pc3 WHERE pc3.order_id=o.id AND pc3.event_type='platform_measurement_pricing_confirmed')\n                        THEN 1 ELSE 0 END platform_pricing_confirmed,\n                    CASE WHEN EXISTS(SELECT 1 FROM appointment_records pas WHERE pas.order_id=o.id AND pas.context_type='service')\n                        THEN 1 ELSE 0 END service_appointment_exists,\n                    CASE WHEN :invite_worker_flag>0 AND (\n                        EXISTS(SELECT 1 FROM assignments ai WHERE ai.order_id=o.id AND ai.worker_id=:invite_worker_lookup AND ai.assignment_type='invite')\n                        OR EXISTS(SELECT 1 FROM invite_tokens iti WHERE iti.order_id=o.id AND iti.claimed_worker_id=:invite_token_worker_lookup AND iti.status='claimed')\n                    ) THEN 1 ELSE 0 END is_invited,\n                    CASE WHEN o.order_source_type='platform' AND o.dispatch_mode='multi_quote' AND o.selected_quote_id IS NULL\n                        AND EXISTS(SELECT 1 FROM invite_tokens itr WHERE itr.order_id=o.id AND itr.claimed_worker_id=:invite_token_worker_lookup2 AND itr.status='claimed')\n                        AND NOT EXISTS(SELECT 1 FROM quotes qir WHERE qir.order_id=o.id AND qir.worker_id=:invite_quote_worker_lookup AND qir.status IN ('active','selected'))\n                        THEN 1 ELSE 0 END invite_requires_quote\n                FROM orders o WHERE {$where}\n                ORDER BY o.updated_at DESC,o.id DESC\n                LIMIT \" . ($limit + 1) . ' OFFSET ' . $offset;\n        $params['invite_token_worker_lookup2'] = $workerId;\n        $rows = $this->db->fetchAll($sql, $params);\n        $hasMore = count($rows) > $limit;\n        if ($hasMore) $rows = array_slice($rows, 0, $limit);\n        return ['rows' => $rows, 'has_more' => $hasMore];\n    }\n\n    public function supplementCount(array $actor, string $kind): int\n    {\n        if ($kind !== 'mine') return 0;\n        return (int)$this->db->fetchValue(\n            \"SELECT COUNT(*) FROM orders WHERE user_id=:user_id AND audit_status='supplement_required' AND lifecycle_status='active'\",\n            ['user_id' => (int)$actor['user_id']]\n        );\n    }\n\n    public function todoCount(array $actor, string $kind): int\n    {\n        if ($kind === 'mine') {\n            return (int)$this->db->fetchValue(\n                \"SELECT COUNT(*) FROM orders o\n                 WHERE o.user_id=:user_id AND o.lifecycle_status='active'\n                   AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\n                   AND (\n                     o.audit_status='supplement_required'\n                     OR (o.audit_status='draft' AND o.payment_status='awaiting_payment')\n                     OR (o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr WHERE pr.order_id=o.id AND pr.event_type='platform_measurement_pricing_reviewed')\n                        AND NOT EXISTS(SELECT 1 FROM order_events pc WHERE pc.order_id=o.id AND pc.event_type='platform_measurement_pricing_confirmed'))\n                     OR (o.fulfillment_status='submitted' AND o.dispute_status NOT IN ('open','processing'))\n                     OR (o.audit_status='approved' AND o.selected_quote_id IS NULL AND EXISTS(SELECT 1 FROM quotes q WHERE q.order_id=o.id AND q.status='active'))\n                     OR EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')))\n                     OR EXISTS(SELECT 1 FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment'))\n                   )\",\n                ['user_id' => (int)$actor['user_id']]\n            );\n        }\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        if ($workerId < 1) return 0;\n        return (int)$this->db->fetchValue(\n            \"SELECT COUNT(*) FROM orders o\n             WHERE o.refund_status NOT IN ('pending_review','approved','processing','refunding')\n               AND (\n                 (o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL AND EXISTS(\n                    SELECT 1 FROM assignments atc WHERE atc.id=o.current_assignment_id AND atc.worker_id=:worker_id AND atc.status='offered'\n                 ))\n                 OR (o.lifecycle_status='active' AND o.assigned_worker_id=:construction_worker_id AND o.assignment_status='accepted'\n                    AND o.order_source_type='platform' AND o.workflow_profile='construction' AND o.fulfillment_status='not_started'\n                    AND EXISTS(SELECT 1 FROM order_events prc WHERE prc.order_id=o.id AND prc.event_type='platform_measurement_pricing_reviewed')\n                    AND EXISTS(SELECT 1 FROM order_events pcc WHERE pcc.order_id=o.id AND pcc.event_type='platform_measurement_pricing_confirmed')\n                    AND NOT EXISTS(SELECT 1 FROM appointment_records pac WHERE pac.order_id=o.id AND pac.context_type='service'))\n                 OR (o.lifecycle_status='active' AND o.order_source_type='platform' AND o.dispatch_mode='multi_quote'\n                    AND o.selected_quote_id IS NULL\n                    AND EXISTS(SELECT 1 FROM invite_tokens itc WHERE itc.order_id=o.id AND itc.claimed_worker_id=:invite_worker_id AND itc.status='claimed')\n                    AND NOT EXISTS(SELECT 1 FROM quotes qic WHERE qic.order_id=o.id AND qic.worker_id=:quote_worker_id AND qic.status IN ('active','selected'))\n                 )\n                 OR (o.assigned_worker_id=:repair_worker_id AND EXISTS(\n                    SELECT 1 FROM after_sales ascnt WHERE ascnt.order_id=o.id AND ascnt.type='warranty_repair'\n                    AND (ascnt.status='open' OR (ascnt.status='processing' AND (ascnt.resolution IS NULL OR (ascnt.resolution NOT LIKE '师傅拒绝维修%' AND ascnt.resolution NOT LIKE '用户申请平台介入%'))))\n                 ))\n               )\",\n            [\n                'worker_id' => $workerId,\n                'construction_worker_id' => $workerId,\n                'invite_worker_id' => $workerId,\n                'quote_worker_id' => $workerId,\n                'repair_worker_id' => $workerId,\n            ]\n        );\n    }\n}","server/app/Infrastructure/Persistence/DatabaseOrderConversationBridge.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Chat\\OrderConversationPolicy;\n\n/** Called inside the owning order transaction; never opens an independent transaction. */\nfinal class DatabaseOrderConversationBridge\n{\n    private Database $db;\n    private OrderConversationPolicy $policy;\n    private bool $enabled;\n    public function __construct(Database $db, bool $enabled=false)\n    { $this->db=$db;$this->enabled=$enabled;$this->policy=new OrderConversationPolicy(); }\n\n    /** Coalesce every event for this order until the original transaction's final facts exist. */\n    public function schedule(int $orderID): void\n    {\n        if (!$this->enabled) return;\n        if ($orderID<1) throw new RuntimeException('聊天授权订单编号无效');\n        $this->db->beforeCommit('chat-policy:'.$orderID,function()use($orderID):void{$this->synchronize($orderID);});\n    }\n\n    /** @return string[] changed scope keys; no messages/Go tables/notifications are written. */\n    public function synchronize(int $orderID,bool $apply=true): array\n    {\n        if ($apply && !$this->enabled) return [];\n        if ($orderID<1 || !$this->db->pdo()->inTransaction()) throw new RuntimeException('聊天授权必须加入原订单事务');\n        // Lock order first, then current authority reads, then the guard. Plain\n        // reads could reuse an earlier REPEATABLE READ snapshot and grant stale accounts.\n        $order=$this->db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE',['id'=>$orderID]);\n        if (!$order) throw new RuntimeException('聊天授权订单不存在');\n        $assignment=$this->db->fetch(\n            'SELECT a.*,CAST(w.user_id AS CHAR) worker_user_id,u.status worker_user_status\n             FROM assignments a JOIN worker_profiles w ON w.id=a.worker_id\n             JOIN users u ON u.id=w.user_id WHERE a.id=:id AND a.order_id=:order_id LIMIT 1 LOCK IN SHARE MODE',\n            ['id'=>$order['current_assignment_id'] ?? 0,'order_id'=>$orderID]\n        );\n        $customer=$this->db->fetch('SELECT status FROM users WHERE id=:id LIMIT 1 LOCK IN SHARE MODE',['id'=>$order['user_id']]);\n        $facts=[\n            'order_id'=>(string)$orderID,'customer_id'=>(string)$order['user_id'],\n            'customer_status'=>(string)($customer['status'] ?? ''),'is_demo'=>(int)$order['is_demo'],\n            'workflow_profile'=>(string)$order['workflow_profile'],'order_source_type'=>(string)$order['order_source_type'],\n            'lifecycle_status'=>(string)$order['lifecycle_status'],'payment_status'=>(string)$order['payment_status'],\n            'assignment_status'=>(string)$order['assignment_status'],\n            'current_assignment_id'=>(string)($order['current_assignment_id'] ?? ''),\n            'assigned_worker_id'=>(string)($order['assigned_worker_id'] ?? ''),\n            'assignment_id'=>(string)($assignment['id'] ?? ''),'assignment_order_id'=>(string)($assignment['order_id'] ?? ''),\n            'worker_id'=>(string)($assignment['worker_id'] ?? ''),'worker_user_id'=>(string)($assignment['worker_user_id'] ?? ''),\n            'worker_user_status'=>(string)($assignment['worker_user_status'] ?? ''),\n            'assignment_record_status'=>(string)($assignment['status'] ?? ''),'assignment_accepted_at'=>$assignment['accepted_at'] ?? null,\n        ];\n        if ($facts['order_source_type']==='platform') {\n            $terms=$this->db->fetch('SELECT customer_flow_mode FROM order_platform_terms WHERE order_id=:id LOCK IN SHARE MODE',['id'=>$orderID]);\n            $facts['customer_flow_mode']=(string)($terms['customer_flow_mode']??'');\n            $facts['booking_fee_cents']=(int)($order['booking_fee_cents']??-1);\n            $facts=array_merge($facts,(new DatabaseChatPlatformStaff($this->db))->readAuthorityLocked());\n        }\n        if($facts['lifecycle_status']==='completed' && $facts['workflow_profile']==='construction'\n            && in_array($facts['order_source_type'],['consumer','merchant','platform'],true)) {\n            $episode=$this->db->fetch(\n                'SELECT e.*,a.order_id repair_order_id,a.user_id repair_user_id,a.type repair_type,\n                    a.status repair_status,a.closed_at repair_closed_at\n                 FROM chat_repair_episodes e JOIN after_sales a ON a.id=e.after_sale_id\n                 WHERE e.active_order_id=:id LIMIT 1 LOCK IN SHARE MODE',['id'=>$orderID]\n            );\n            if($episode)$facts['repair_episode']=$episode;\n        }\n        $snapshot=$this->policy->evaluate($facts);\n        // Bounded display facts travel with the same immutable PHP authority hash.\n        $context=['public_no'=>(string)$order['public_no'],\n            'title'=>mb_substr((string)preg_replace('/[\\\\p{Cc}\\\\p{Cf}]+/u',' ',(string)($order['title']??'')),0,120,'UTF-8'),\n            'workflow'=>(string)$order['workflow_profile']];\n        $open=$this->db->fetch('SELECT * FROM chat_policy_guards WHERE active_order_id=:id FOR UPDATE',['id'=>$orderID]);\n        $changed=[];\n        if ($open && (!$snapshot || $open['scope_key'] !== $snapshot['scope_key'])) {\n            $closed=json_decode((string)$open['snapshot_json'],true,32,JSON_THROW_ON_ERROR);\n            $closed['state']='readonly';\n            $closed['order_context']=$context;\n            foreach ($closed['members'] as &$member) $member['can_send']=false;\n            unset($member);\n            if ($this->persist($closed,$open,$apply)) $changed[]=$closed['scope_key'];\n        }\n        if ($snapshot) {\n            $existing=$this->db->fetch('SELECT * FROM chat_policy_guards WHERE scope_key=:scope FOR UPDATE',['scope'=>$snapshot['scope_key']]);\n            $previous=$existing?json_decode((string)$existing['snapshot_json'],true,32,JSON_THROW_ON_ERROR):null;\n            // Never manufacture historical membership during a backfill/late event.\n            if (!$existing && $snapshot['state']==='readonly') return $changed;\n            // Keep the closing repair identity, rather than silently replacing it\n            // with the old service episode. S05 needs that precise boundary.\n            if($previous && $snapshot['state']==='readonly') {\n                $snapshot=$previous;$snapshot['state']='readonly';\n                foreach($snapshot['members'] as &$member)$member['can_send']=false;unset($member);\n            }\n            // Only an explicit, different accepted repair generation can reopen.\n            if ($existing && $existing['state']==='readonly' && $snapshot['state']==='open') {\n                $newRepair=isset($facts['repair_episode']) && $snapshot['episode_key']!==$previous['episode_key'];\n                if(!$newRepair){$snapshot=$previous;$snapshot['state']='readonly';foreach ($snapshot['members'] as &$member)$member['can_send']=false;unset($member);}\n            }\n            $snapshot['order_context']=$context;\n            if ($this->persist($snapshot,$existing,$apply)) $changed[]=$snapshot['scope_key'];\n        }\n        if($apply && $facts['order_source_type']==='platform') {\n            $this->db->execute(\"INSERT INTO chat_policy_refresh(order_id,checked_at,next_check_at,status)\n                VALUES(:id,UTC_TIMESTAMP(),UTC_TIMESTAMP()+INTERVAL 60 SECOND,'success')\n                ON DUPLICATE KEY UPDATE checked_at=VALUES(checked_at),next_check_at=VALUES(next_check_at),status='success'\",['id'=>$orderID]);\n        }\n        return $changed;\n    }\n\n    private function persist(array $snapshot, ?array $existing,bool $apply): bool\n    {\n        $json=json_encode($snapshot,JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);\n        if (strlen($json)>16384) throw new RuntimeException('聊天授权快照超过上限');\n        $hash=hash('sha256',$json);\n        if ($existing && hash_equals((string)$existing['snapshot_hash'],$hash)) return false;\n        if (!$apply) return true;\n        $params=['scope'=>$snapshot['scope_key'],'order_id'=>$snapshot['order_id'],'assignment_id'=>$snapshot['assignment_id'],\n            'state'=>$snapshot['state'],'json'=>$json,'hash'=>$hash];\n        if (!$existing) {\n            $this->db->execute('INSERT INTO chat_policy_guards(scope_key,order_id,assignment_id,policy_version,state,snapshot_json,snapshot_hash,updated_at)\n                VALUES(:scope,:order_id,:assignment_id,1,:state,:json,:hash,UTC_TIMESTAMP())',$params);\n        } else {\n            unset($params['order_id'],$params['assignment_id']);$params['expected']=(string)$existing['policy_version'];\n            $count=$this->db->execute('UPDATE chat_policy_guards SET state=:state,snapshot_json=:json,snapshot_hash=:hash,policy_version=policy_version+1,updated_at=UTC_TIMESTAMP()\n                WHERE scope_key=:scope AND policy_version=:expected',$params);\n            if ($count!==1) throw new RuntimeException('聊天授权版本已变化');\n        }\n        $version=(string)$this->db->fetchValue('SELECT CAST(policy_version AS CHAR) FROM chat_policy_guards WHERE scope_key=:scope',['scope'=>$snapshot['scope_key']]);\n        $payload=json_encode(['schema_version'=>1,'policy_version'=>$version,'snapshot'=>$snapshot],JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);\n        $this->db->execute(\"INSERT INTO chat_business_events(event_id,aggregate_key,aggregate_version,schema_version,event_type,payload_json,created_at)\n            VALUES(:event_id,:scope,:version,1,'chat.policy.changed',:payload,UTC_TIMESTAMP())\",\n            ['event_id'=>bin2hex(random_bytes(16)),'scope'=>$snapshot['scope_key'],'version'=>$version,'payload'=>$payload]);\n        return true;\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderDisputeRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderDisputeRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\NegotiationPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderDisputeRepository implements OrderDisputeRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function startNegotiation(array $actor, string $orderNo, string $description, array $evidenceIds): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$description,$evidenceIds): array {\n            $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE', ['public_no'=>$orderNo]);\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能为自己的订单提交异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$order['fulfillment_status'] !== 'submitted' || (string)$order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('只有待确认的服务结果可以提交异议', 'DISPUTE_NOT_ALLOWED', 409);\n            }\n            if (!in_array((string)($order['dispute_status'] ?? 'none'), ['','none','resolved'], true)\n                || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\", ['id'=>$order['id']])) {\n                throw new OrderOperationException('本单已有异议正在处理中', 'DISPUTE_ALREADY_ACTIVE', 409);\n            }\n\n            $params = ['order_id'=>$order['id']];\n            $marks = [];\n            foreach (array_values($evidenceIds) as $index=>$publicId) {\n                $key = 'media_'.$index;\n                $marks[] = ':'.$key;\n                $params[$key] = $publicId;\n            }\n            $mediaRows = $db->fetchAll(\n                \"SELECT m.id,m.public_id FROM media_files m\n                 JOIN media_links l ON l.media_file_id=m.id AND l.entity_type='order' AND l.entity_id=:order_id AND l.purpose='dispute_evidence'\n                 WHERE m.public_id IN (\".implode(',', $marks).\") AND m.status='active'\n                 GROUP BY m.id,m.public_id\",\n                $params\n            );\n            if (count($mediaRows) !== count($evidenceIds)) {\n                throw new OrderOperationException('异议证据图片无效，请重新上传后提交', 'DISPUTE_EVIDENCE_INVALID', 422);\n            }\n\n            $measurement = (string)($order['workflow_profile'] ?? 'construction') === 'measurement';\n            $disputeNo = 'DSP'.gmdate('ymdHis').strtoupper(bin2hex(random_bytes(4)));\n            $disputeId = $db->insert(\n                \"INSERT INTO disputes(public_no,order_id,raised_by_type,raised_by_id,dispute_type,title,description,status,responsibility,refund_amount_cents,run_empty_fee_cents,opened_at,created_at,updated_at)\n                 VALUES(:public_no,:order_id,'user',:user_id,:dispute_type,:title,:description,'negotiating','undetermined',0,0,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_no'=>$disputeNo,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                    'dispute_type'=>$measurement ? 'measurement_result' : 'completion_quality',\n                    'title'=>$measurement ? '测量成果异议协商中' : '完工异议协商中',\n                    'description'=>$description,\n                ]\n            );\n            foreach ($mediaRows as $row) {\n                $db->insert(\n                    \"INSERT INTO dispute_evidence(dispute_id,submitted_by_type,submitted_by_id,evidence_type,description,media_file_id,occurred_at,created_at)\n                     VALUES(:dispute_id,'user',:user_id,'photo',NULL,:media_id,NULL,UTC_TIMESTAMP())\",\n                    ['dispute_id'=>$disputeId,'user_id'=>$actor['user_id'],'media_id'=>$row['id']]\n                );\n            }\n            $db->execute(\n                \"UPDATE orders SET dispute_status='negotiating',publish_status='hidden',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n            $eventKey = $this->event($db, (int)$order['id'], 'dispute_negotiation_started', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$disputeNo,\n                'evidence_count'=>count($mediaRows),\n                'message'=>$measurement\n                    ? '用户提出测量成果异议，自动确认已暂停，请双方先自行沟通处理'\n                    : '用户提出完工异议，自动验收已暂停，请双方先自行沟通处理',\n            ], false);\n            $this->notifyWorkerNegotiation($db, $order, $eventKey, $measurement);\n            return ['id'=>$disputeNo,'status'=>'negotiating','admin_escalated'=>false];\n        });\n    }\n\n    public function escalate(array $actor, string $disputeNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$disputeNo,$note): array {\n            $seed = $db->fetch('SELECT order_id FROM disputes WHERE BINARY public_no=BINARY :no', ['no'=>$disputeNo]);\n            if (!$seed) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            $db->fetch('SELECT id FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $row = $db->fetch(\n                \"SELECT d.*,o.public_no order_no,o.user_id,o.id order_id,o.workflow_profile\n                 FROM disputes d JOIN orders o ON o.id=d.order_id\n                 WHERE BINARY d.public_no=BINARY :public_no FOR UPDATE\",\n                ['public_no'=>$disputeNo]\n            );\n            if (!$row) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            if ((int)$row['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能处理自己的订单异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$row['status'] !== 'negotiating') {\n                throw new OrderOperationException('该异议当前不能重复申请平台介入', 'DISPUTE_ESCALATE_NOT_ALLOWED', 409);\n            }\n            // 2026-10-08：直接 API 与页面使用同一升级条件，不能提交后立即绕过协商。\n            $eligibility = NegotiationPolicy::evaluate(NegotiationPolicy::disputeStatus($row['resolution'] ?? null), $row['opened_at'] ?? null);\n            if (empty($eligibility['eligible'])) {\n                throw new OrderOperationException('请先协商；师傅拒绝或满48小时未解决后才可申请平台介入', 'NEGOTIATION_WAIT_REQUIRED', 409, $eligibility);\n            }\n            if ($note !== '') {\n                $db->insert(\n                    \"INSERT INTO dispute_evidence(dispute_id,submitted_by_type,submitted_by_id,evidence_type,description,media_file_id,occurred_at,created_at)\n                     VALUES(:dispute_id,'user',:user_id,'note',:description,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['dispute_id'=>$row['id'],'user_id'=>$actor['user_id'],'description'=>$note]\n                );\n            }\n            $measurement = (string)($row['workflow_profile'] ?? 'construction') === 'measurement';\n            $db->execute(\n                \"UPDATE disputes SET status='open',title=:title,updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='negotiating'\",\n                ['title'=>$measurement ? '用户申请平台介入测量成果争议' : '用户申请平台介入完工争议','id'=>$row['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET dispute_status='open',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$row['order_id']]\n            );\n            // 平台待办只通过 queueAdminTask 产生一次；订单事件仅通知双方，避免管理员收到两条重复提醒。\n            $eventKey = $this->event($db, (int)$row['order_id'], 'dispute_opened', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$row['public_no'],\n                'dispute_type'=>$row['dispute_type'],\n                'message'=>'双方自行协商未解决，用户已申请平台介入',\n                'reason'=>$note,\n                'notify_recipients'=>['user','worker'],\n            ], true);\n            OrderNotificationService::queueAdminTask(\n                $db,\n                'dispute:'.$row['id'],\n                'completion_dispute_opened',\n                $measurement ? '用户申请平台介入测量成果争议' : '用户申请平台介入完工争议',\n                [\n                    '订单号'=>(string)$row['order_no'],\n                    '争议说明'=>(string)$row['description'],\n                    '补充说明'=>$note,\n                ]\n            );\n            return ['id'=>(string)$row['public_no'],'status'=>'open','admin_escalated'=>true,'event_key'=>$eventKey];\n        });\n    }\n\n    public function resolveByAgreement(array $actor, string $disputeNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$disputeNo,$note): array {\n            $seed = $db->fetch('SELECT order_id FROM disputes WHERE BINARY public_no=BINARY :no', ['no'=>$disputeNo]);\n            if (!$seed) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            $db->fetch('SELECT id FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $row = $db->fetch(\n                \"SELECT d.*,o.user_id,o.id order_id FROM disputes d JOIN orders o ON o.id=d.order_id\n                 WHERE BINARY d.public_no=BINARY :public_no FOR UPDATE\",\n                ['public_no'=>$disputeNo]\n            );\n            if (!$row) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            if ((int)$row['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能处理自己的订单异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$row['status'] !== 'negotiating') {\n                throw new OrderOperationException('平台已经介入或异议已经结束，不能自行关闭', 'DISPUTE_SELF_RESOLVE_NOT_ALLOWED', 409);\n            }\n            $resolution = '双方自行协商解决'.($note !== '' ? '：'.$note : '');\n            $db->execute(\n                \"UPDATE disputes SET status='resolved',responsibility='mutual',resolution=:resolution,resolved_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='negotiating'\",\n                ['resolution'=>$resolution,'id'=>$row['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET dispute_status='resolved',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$row['order_id']]\n            );\n            $this->event($db, (int)$row['order_id'], 'dispute_resolved', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$row['public_no'],\n                'resolution'=>$resolution,\n                'self_resolved'=>1,\n                'notify_recipients'=>['worker'],\n            ], true);\n            return ['id'=>(string)$row['public_no'],'status'=>'resolved','admin_escalated'=>false];\n        });\n    }\n\n    public function resolveByAdmin(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array {\n        $operation = function () use ($operator, $orderNo, $resolution, $responsibility, $refundCents, $runEmptyCents): array {\n            return $this->resolveByAdminUnderWriteGuard($operator, $orderNo, $resolution, $responsibility, $refundCents, $runEmptyCents);\n        };\n        if (($operator['channel'] ?? '') === 'web_admin') {\n            return (new DatabaseDemoOrderWriteGuard($this->db))->run($orderNo, $operation);\n        }\n        return $operation();\n    }\n\n    private function resolveByAdminUnderWriteGuard(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array {\n        $channel = (string)($operator['channel'] ?? '');\n        if ($channel === 'mini_admin') {\n            $operatorId = max(0, (int)($operator['user_id'] ?? 0));\n            $handledBy = null;\n        } elseif ($channel === 'web_admin') {\n            $operatorId = max(0, (int)($operator['admin_user_id'] ?? 0));\n            $handledBy = $operatorId;\n        } else {\n            throw new OrderOperationException('管理员操作来源无效', 'ADMIN_REQUIRED', 403);\n        }\n        if ($operatorId < 1) throw new OrderOperationException('管理员身份无效', 'ADMIN_REQUIRED', 403);\n        $refundCents = max(0, $refundCents);\n        $runEmptyCents = max(0, $runEmptyCents);\n        if ($channel === 'mini_admin' && ($refundCents > 0 || $runEmptyCents > 0)) {\n            throw new OrderOperationException('涉及退款或跑空费金额，请到网页后台处理', 'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED', 409);\n        }\n\n        return $this->db->transaction(function (Database $db) use (\n            $orderNo,$resolution,$responsibility,$refundCents,$runEmptyCents,$channel,$operatorId,$handledBy\n        ): array {\n            $order = $db->fetch(\n                'SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $dispute = $db->fetch(\n                \"SELECT * FROM disputes\n                 WHERE order_id=:order_id AND status IN ('open','processing')\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id']]\n            );\n            if (!$dispute) {\n                throw new OrderOperationException('当前没有待处理争议', 'DISPUTE_ADMIN_NOT_FOUND', 409);\n            }\n            if ($channel === 'mini_admin' && ((int)($dispute['refund_amount_cents'] ?? 0) > 0 || (int)($dispute['run_empty_fee_cents'] ?? 0) > 0)) {\n                throw new OrderOperationException(\n                    '该争议涉及退款或跑空费金额，请到网页后台处理',\n                    'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED',\n                    409\n                );\n            }\n\n            $financial = $refundCents > 0 || $runEmptyCents > 0;\n            $effectiveRefundCents = 0;\n            $autoRefundCents = 0;\n            $allocations = [\n                'refund_cents'=>0,\n                'outstanding_refund_cents'=>0,\n                'succeeded_refund_cents'=>0,\n                'runner_cents'=>0,\n            ];\n            $payment = null;\n            $availableBookingFee = 0;\n\n            if ($financial) {\n                if ($channel !== 'web_admin' || $handledBy === null) {\n                    throw new OrderOperationException('资金争议只能由网页后台裁定', 'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED', 409);\n                }\n                if ($this->isTerminalLifecycle((string)($order['lifecycle_status'] ?? ''))) {\n                    throw new OrderOperationException('已结束订单不能再次分配预约费，请核对已有退款和结算记录', 'DISPUTE_FINANCE_ORDER_CLOSED', 409);\n                }\n                $payment = $db->fetch(\n                    \"SELECT id,amount_cents FROM payment_orders\n                     WHERE order_id=:order_id AND business_type IN ('order_booking','booking_fee') AND status='paid'\n                     ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                    ['order_id'=>$order['id']]\n                );\n                $availableBookingFee = $payment\n                    ? ((int)($order['booking_fee_cents'] ?? 0) > 0\n                        ? min((int)$payment['amount_cents'], (int)$order['booking_fee_cents'])\n                        : (int)$payment['amount_cents'])\n                    : 0;\n                if ($refundCents + $runEmptyCents > $availableBookingFee) {\n                    throw new OrderOperationException('退款与跑空费合计不能超过本单实际支付的预约费', 'DISPUTE_FINANCE_EXCEEDS_BOOKING', 409);\n                }\n                $allocations = $payment\n                    ? $this->bookingFeeAllocations($db, (int)$payment['id'], (int)$order['id'])\n                    : $allocations;\n                if ($allocations['refund_cents'] + $allocations['runner_cents'] + $refundCents + $runEmptyCents > $availableBookingFee) {\n                    throw new OrderOperationException('该支付单已有退款或费用分配，剩余预约费不足', 'DISPUTE_FINANCE_ALREADY_ALLOCATED', 409);\n                }\n\n                // 资金裁定会终止本次履约；未判给师傅且尚未被占用的预约费必须全部回到退款，避免余额悬空。\n                $allocatedAfterDecision = $allocations['refund_cents'] + $allocations['runner_cents'] + $refundCents + $runEmptyCents;\n                $autoRefundCents = max(0, $availableBookingFee - $allocatedAfterDecision);\n                $effectiveRefundCents = $refundCents + $autoRefundCents;\n\n                if ($effectiveRefundCents > 0) {\n                    $db->insert(\n                        \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                         VALUES(:public_no,:payment_id,:order_id,NULL,:amount,:reason,'pending_review',:admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                        [\n                            'public_no'=>\\business_no('RF'),\n                            'payment_id'=>$payment['id'],\n                            'order_id'=>$order['id'],\n                            'amount'=>$effectiveRefundCents,\n                            'reason'=>mb_substr('争议裁定：'.$resolution, 0, 1000),\n                            'admin_id'=>$handledBy,\n                        ]\n                    );\n                }\n\n                if ($runEmptyCents > 0) {\n                    $workerId = !empty($order['assigned_worker_id'])\n                        ? (int)$order['assigned_worker_id']\n                        : (int)$db->fetchValue(\n                            \"SELECT worker_id FROM assignments\n                             WHERE order_id=:order_id\n                             ORDER BY CASE status WHEN 'accepted' THEN 1 WHEN 'completed' THEN 2 WHEN 'cancelled' THEN 3 WHEN 'offered' THEN 4 ELSE 5 END,id DESC\n                             LIMIT 1\",\n                            ['order_id'=>$order['id']]\n                        );\n                    if ($workerId < 1) {\n                        throw new OrderOperationException('订单没有可收取跑空费的师傅，请先核对指派记录', 'DISPUTE_RUN_EMPTY_WORKER_MISSING', 409);\n                    }\n                    $db->execute(\n                        \"INSERT INTO worker_balance_ledger(\n                            worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                            business_type,business_id,idempotency_key,description,status,created_by_admin_id,created_at\n                         ) VALUES(\n                            :worker_id,'run_empty_fee','credit',:amount,:available_delta,0,\n                            'dispute',:dispute_id,:idempotency_key,:description,'effective',:admin_id,UTC_TIMESTAMP()\n                         )\",\n                        [\n                            'worker_id'=>$workerId,\n                            'amount'=>$runEmptyCents,\n                            'available_delta'=>$runEmptyCents,\n                            'dispute_id'=>$dispute['id'],\n                            'idempotency_key'=>'dispute:'.$dispute['id'].':run_empty_fee',\n                            'description'=>mb_substr('争议裁定跑空费：'.$resolution, 0, 1000),\n                            'admin_id'=>$handledBy,\n                        ]\n                    );\n                }\n            }\n\n            $changed = $db->execute(\n                \"UPDATE disputes\n                 SET status='resolved',resolution=:resolution,responsibility=:responsibility,\n                     refund_amount_cents=:refund,run_empty_fee_cents=:runner,handled_by=:handled_by,\n                     resolved_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status IN ('open','processing')\",\n                [\n                    'resolution'=>$resolution,\n                    'responsibility'=>$responsibility,\n                    'refund'=>$effectiveRefundCents,\n                    'runner'=>$runEmptyCents,\n                    'handled_by'=>$handledBy,\n                    'id'=>$dispute['id'],\n                ]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('争议状态已变化，请刷新后重试', 'DISPUTE_ADMIN_CHANGED', 409);\n            }\n\n            if ($financial) {\n                // 取消风控必须在报价/指派失效前捕获原事实，并与争议裁定同一事务提交。\n                (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order, $responsibility, $runEmptyCents);\n                $hasOutstandingRefund = $allocations['outstanding_refund_cents'] + $effectiveRefundCents > 0;\n                $lifecycle = $hasOutstandingRefund ? 'cancel_approved_pending_refund' : 'cancelled';\n                $db->execute(\n                    \"UPDATE orders\n                     SET dispute_status='resolved',lifecycle_status=:lifecycle,publish_status='hidden',quote_status='cancelled',\n                         assignment_status='cancelled',fulfillment_status='cancelled',\n                         refund_status=IF(:has_refund=1,'pending_review',refund_status),\n                         cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),\n                         closed_at=IF(:close_now=1,COALESCE(closed_at,UTC_TIMESTAMP()),closed_at),\n                         updated_at=UTC_TIMESTAMP(),version=version+1\n                     WHERE id=:id\",\n                    [\n                        'lifecycle'=>$lifecycle,\n                        'has_refund'=>$hasOutstandingRefund ? 1 : 0,\n                        'close_now'=>$hasOutstandingRefund ? 0 : 1,\n                        'id'=>$order['id'],\n                    ]\n                );\n                $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=COALESCE(revoked_at,UTC_TIMESTAMP()) WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            } else {\n                $db->execute(\n                    \"UPDATE orders SET dispute_status='resolved',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n            }\n\n            $payload = [\n                'dispute_no'=>(string)$dispute['public_no'],\n                'message'=>'平台争议处理完成：'.$resolution,\n                'resolution'=>$resolution,\n                'responsibility'=>$responsibility,\n                'refund_cents'=>$effectiveRefundCents,\n                'run_empty_fee_cents'=>$runEmptyCents,\n                'auto_refund_cents'=>$autoRefundCents,\n                'operator_channel'=>$channel,\n                'notify_recipients'=>['user','worker'],\n            ];\n            if ($channel === 'mini_admin') $payload['operator_user_id'] = $operatorId;\n            else $payload['operator_admin_id'] = $operatorId;\n            $eventKey = $this->event($db, (int)$order['id'], 'dispute_resolved', $channel, $operatorId, $payload, true);\n\n            return [\n                'id'=>(string)$dispute['public_no'],\n                'status'=>'resolved',\n                'order_id'=>(int)$order['id'],\n                'refund_cents'=>$effectiveRefundCents,\n                'run_empty_fee_cents'=>$runEmptyCents,\n                'auto_refund_cents'=>$autoRefundCents,\n                'event_key'=>$eventKey,\n            ];\n        });\n    }\n\n    /** @return array{refund_cents:int,outstanding_refund_cents:int,succeeded_refund_cents:int,runner_cents:int} */\n    private function bookingFeeAllocations(Database $db, int $paymentId, int $orderId): array\n    {\n        $refundRows = $db->fetchAll(\n            \"SELECT id,amount_cents,status FROM refunds\n             WHERE payment_order_id=:payment_id\n               AND status NOT IN ('failed','closed','cancelled','rejected')\n             FOR UPDATE\",\n            ['payment_id'=>$paymentId]\n        );\n        $refundCents = 0;\n        $outstandingRefundCents = 0;\n        $succeededRefundCents = 0;\n        foreach ($refundRows as $row) {\n            $amount = max(0, (int)$row['amount_cents']);\n            $refundCents += $amount;\n            if ((string)$row['status'] === 'succeeded') $succeededRefundCents += $amount;\n            else $outstandingRefundCents += $amount;\n        }\n\n        $runnerCents = 0;\n        $paymentBusiness = (string)$db->fetchValue('SELECT business_type FROM payment_orders WHERE id=:id', ['id'=>$paymentId]);\n        if ($orderId > 0 && in_array($paymentBusiness, ['order_booking','booking_fee'], true)) {\n            $runnerRows = $db->fetchAll(\n                \"SELECT l.id,l.amount_cents\n                 FROM worker_balance_ledger l\n                 INNER JOIN disputes d ON d.id=l.business_id\n                 WHERE l.business_type='dispute'\n                   AND l.entry_type='run_empty_fee'\n                   AND l.status='effective'\n                   AND d.order_id=:order_id\n                 FOR UPDATE\",\n                ['order_id'=>$orderId]\n            );\n            foreach ($runnerRows as $row) $runnerCents += max(0, (int)$row['amount_cents']);\n        }\n        return [\n            'refund_cents'=>$refundCents,\n            'outstanding_refund_cents'=>$outstandingRefundCents,\n            'succeeded_refund_cents'=>$succeededRefundCents,\n            'runner_cents'=>$runnerCents,\n        ];\n    }\n\n    private function isTerminalLifecycle(string $status): bool\n    {\n        return strpos($status, 'cancel') === 0 || in_array($status, ['completed','closed','expired'], true);\n    }\n\n    private function notifyWorkerNegotiation(Database $db, array $order, string $eventKey, bool $measurement): void\n    {\n        $workerId = (int)($order['assigned_worker_id'] ?? 0);\n        if ($workerId < 1) return;\n        $data = json_encode(['order_id'=>(int)$order['id'],'event_key'=>$eventKey], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        if ($db->fetchValue(\n            \"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='dispute_negotiation_started' AND BINARY data_json=BINARY :data LIMIT 1\",\n            ['worker_id'=>$workerId,'data'=>$data]\n        )) return;\n        $db->insert(\n            \"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at)\n             VALUES(:public_id,'worker',:worker_id,'in_app','dispute_negotiation_started',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            [\n                'public_id'=>\\public_id(),\n                'worker_id'=>$workerId,\n                'title'=>$measurement ? '用户提出测量成果异议' : '用户提出完工异议',\n                'content'=>'订单 '.(string)$order['public_no'].'：用户对'.($measurement ? '测量成果' : '完工结果').'有异议，请先主动联系协商处理；协商不成时用户可再申请平台介入。',\n                'data'=>$data,\n            ]\n        );\n    }\n\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload, bool $notify): string\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey = $type.':'.$orderId.':'.bin2hex(random_bytes(6));\n        $db->insert(\n            'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$eventKey,'actor_type'=>$actorType,'actor_id'=>$actorId,\n                'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        if ($notify) OrderNotificationService::queue($db, $orderId, $eventKey, $type, $payload);\n        return $eventKey;\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderNegotiationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderNegotiationRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\NegotiationPolicy;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\FulfillmentActor;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n// 2026-10-08：所有写操作先锁订单，再锁原业务记录；升级只创建一份现有平台争议。\nfinal class DatabaseOrderNegotiationRepository implements OrderNegotiationRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n\n    private function order(Database $db, array $actor, string $orderNo): array\n    {\n        $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :no FOR UPDATE', ['no'=>$orderNo]);\n        if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n        $owner = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n        $worker = (int)($actor['worker_id'] ?? 0) > 0 && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n        if (!$owner && !$worker) throw new OrderOperationException('只有订单双方可以处理协商', 'FORBIDDEN', 403);\n        return $order;\n    }\n\n    public function respond(array $actor, string $orderNo, string $kind, string $reference, string $decision, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$kind,$reference,$decision,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if (FulfillmentActor::assisted($actor) && ($kind!=='repair' || $decision!=='complete')) {\n                throw new OrderOperationException('协助入口只能提交维修处理结果','ASSISTANCE_NOT_ALLOWED',422);\n            }\n            if ($kind === 'refund') {\n                $request = $this->refund($db, (int)$order['id'], $reference);\n                $this->requireCounterparty($actor, $order, $request);\n                if ($decision === 'accepted') return (new DatabaseOrderCancellationRepository($db))->approveByAgreement($actor, $reference);\n                if ($decision !== 'rejected') throw new OrderOperationException('退款只能接受或拒绝', 'NEGOTIATION_RESPONSE_INVALID', 422);\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_rejected',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n            } elseif ($kind === 'repair') {\n                $this->requireWorker($actor, $order);\n                $repair = $db->fetch(\"SELECT * FROM after_sales WHERE order_id=:id AND BINARY public_no=BINARY :no AND type='warranty_repair' FOR UPDATE\", ['id'=>$order['id'],'no'=>$reference]);\n                if (!$repair || !in_array((string)$repair['status'], ['open','processing'], true)\n                    || strpos((string)$repair['resolution'], '用户申请平台介入') === 0 || strpos((string)$repair['resolution'], '平台主动介入') === 0 || strpos((string)$repair['resolution'], '师傅拒绝维修') === 0) {\n                    throw new OrderOperationException('维修已经响应、结束或平台介入', 'REPAIR_NOT_ACTIVE', 409);\n                }\n                if ($decision === 'accepted' && strpos((string)$repair['resolution'], '师傅接受维修') === 0) {\n                    throw new OrderOperationException('已经接受处理，请记录预约或完成维修', 'REPAIR_ALREADY_ACCEPTED', 409);\n                }\n                $resolution = ($decision === 'rejected' ? '师傅拒绝维修：' : ($decision === 'complete' ? '师傅已完成维修：' : '师傅接受维修：')).$note;\n                if (FulfillmentActor::assisted($actor)) $resolution='管理员补录维修处理结果：'.$note;\n                $db->execute(\"UPDATE after_sales SET status=:status,resolution=:resolution,closed_at=IF(:done=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                    ['status'=>$decision === 'complete' ? 'resolved' : 'processing','resolution'=>$resolution,'done'=>$decision === 'complete' ? 1 : 0,'id'=>$repair['id']]);\n                if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                    $episodes=new DatabaseChatRepairEpisodes($db,true);\n                    if($decision==='accepted') $episodes->acceptWorker((int)$order['id'],(int)$repair['id'],(int)$actor['worker_id']);\n                    else $episodes->close((int)$order['id'],(int)$repair['id']);\n                }\n            } elseif ($kind === 'dispute') {\n                $this->requireWorker($actor, $order);\n                $dispute = $db->fetch('SELECT * FROM disputes WHERE order_id=:id AND BINARY public_no=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                if (!$dispute || (string)$dispute['status'] !== 'negotiating' || !empty($dispute['resolution']) || $decision === 'complete') {\n                    throw new OrderOperationException('异议已经响应或不在协商阶段', 'DISPUTE_RESPONSE_NOT_ALLOWED', 409);\n                }\n                $db->execute('UPDATE disputes SET resolution=:note,updated_at=UTC_TIMESTAMP() WHERE id=:id',\n                    ['note'=>($decision === 'rejected' ? '师傅拒绝异议：' : '师傅接受异议，处理中：').$note,'id'=>$dispute['id']]);\n            } elseif ($kind === 'measurement') {\n                $this->requireWorker($actor, $order);\n                $state = $this->measurement($db, $order, $reference);\n                if ($decision !== 'rejected') throw new OrderOperationException('补测请直接补充成果后提交', 'MEASUREMENT_RESPONSE_INVALID', 422);\n                if ($state['status'] === 'rejected') throw new OrderOperationException('已拒绝本次补测', 'MEASUREMENT_ALREADY_REJECTED', 409);\n                $this->event($db, $order, $actor, 'measurement_rework_rejected', ['rework_id'=>$reference,'note'=>$note,'message'=>'师傅拒绝补测：'.$note]);\n            } else {\n                throw new OrderOperationException('加价请使用原有同意/拒绝入口', 'NEGOTIATION_RESPONSE_INVALID', 422);\n            }\n            // 补测拒绝已经记录专属事件并通知客户；不要再投递一次通用响应。\n            if ($kind !== 'measurement') {\n                $event = $kind === 'repair' ? ['accepted'=>'repair_worker_accepted','rejected'=>'repair_worker_rejected','complete'=>'repair_worker_completed'][$decision] : 'negotiation_responded';\n                $this->event($db, $order, $actor, $event, ['after_sale_id'=>$kind === 'repair' ? $reference : null,'kind'=>$kind,'reference'=>$reference,'decision'=>$decision,'note'=>$note,'message'=>FulfillmentActor::assisted($actor) ? '管理员已补录维修处理结果' : ($decision === 'complete' ? '师傅已提交维修处理结果' : ($decision === 'rejected' ? '对方拒绝方案，可继续协商或申请平台介入' : '对方已接受处理'))]);\n            }\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'decision'=>$decision];\n        });\n    }\n\n    public function proposeRefund(array $actor, string $orderNo, string $reference, int $amount, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reference,$amount,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n            if (!$request || (string)$request['status'] !== 'pending' || NegotiationPolicy::refundStatus((string)$request['reason_code']) !== 'rejected'\n                || (string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('拒绝后才能重新提出退款方案', 'REFUND_PROPOSAL_NOT_ALLOWED', 409);\n            $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n            // 报价式方案只记录双方意愿，执行时仍重新核对真实可退支付，不相信客户端金额。\n            $db->execute(\"UPDATE order_cancel_requests SET applicant_type=:type,applicant_id=:actor,requested_refund_cents=:amount,reason=:note,reason_code='bilateral_refund_pending',requested_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                ['type'=>$type,'actor'=>in_array($type,['user','mini_admin'],true) ? $actor['user_id'] : $actor['worker_id'],'amount'=>$amount,'note'=>$note,'id'=>$request['id']]);\n            $this->event($db, $order, $actor, 'cancel_requested', ['reference'=>$reference,'requested_refund_cents'=>$amount,'message'=>'双方重新提出退款方案，等待对方接受或拒绝']);\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'status'=>'pending'];\n        });\n    }\n\n    public function withdrawRefund(array $actor, string $orderNo, string $reference, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reference,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if ((string)$order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('订单已进入取消、退款或结束流程，不能撤回退款方案', 'REFUND_WITHDRAW_NOT_ALLOWED', 409);\n            }\n            $request = $db->fetch(\n                'SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE',\n                ['id'=>$order['id'],'no'=>$reference]\n            );\n            if (!$request || (string)$request['status'] !== 'pending'\n                || !in_array((string)$request['reason_code'], ['bilateral_refund_pending','bilateral_refund_rejected'], true)) {\n                throw new OrderOperationException('退款方案已进入平台处理、资金执行或已经结束，不能撤回', 'REFUND_WITHDRAW_NOT_ALLOWED', 409);\n            }\n\n            $userApplicant = (string)$request['applicant_type'] === 'user'\n                && (int)$request['applicant_id'] === (int)($actor['user_id'] ?? 0)\n                && (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n            $workerApplicant = (string)$request['applicant_type'] === 'worker'\n                && (int)$request['applicant_id'] === (int)($actor['worker_id'] ?? 0)\n                && (int)($actor['worker_id'] ?? 0) > 0\n                && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n            if (!$userApplicant && !$workerApplicant) {\n                throw new OrderOperationException('只有当前退款方案提出方可以撤回', 'REFUND_WITHDRAW_FORBIDDEN', 403);\n            }\n\n            if ($db->fetchValue(\n                \"SELECT id FROM refunds\n                 WHERE cancel_request_id=:request_id AND status NOT IN ('failed','closed','cancelled','rejected')\n                 LIMIT 1 FOR UPDATE\",\n                ['request_id'=>$request['id']]\n            )) {\n                throw new OrderOperationException('本方案已经产生退款资金记录，不能恢复履约', 'REFUND_WITHDRAW_FINANCE_STARTED', 409);\n            }\n\n            $snapshot = json_decode((string)($request['order_state_snapshot_json'] ?? ''), true);\n            if (!is_array($snapshot)) $snapshot = [];\n            $restoreRefund = (string)($snapshot['refund_status'] ?? 'none');\n            if (!in_array($restoreRefund, ['', 'none','failed'], true)) $restoreRefund = 'none';\n            if ($restoreRefund === '') $restoreRefund = 'none';\n            $restorePublish = (string)($snapshot['publish_status'] ?? 'hidden');\n            if (!in_array($restorePublish, ['published','hidden'], true)) $restorePublish = 'hidden';\n\n            $hasMeasurementLink = (bool)$db->fetchValue(\n                \"SELECT 1 FROM order_relations\n                 WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1 FOR UPDATE\",\n                ['id'=>$order['id']]\n            );\n            $hasActiveDispute = !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                || (bool)$db->fetchValue(\n                    \"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\",\n                    ['id'=>$order['id']]\n                );\n            if ($hasMeasurementLink || $hasActiveDispute) $restorePublish = 'hidden';\n\n            $changed = $db->execute(\n                \"UPDATE order_cancel_requests\n                 SET status='cancelled',reason_code='bilateral_refund_withdrawn',closed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='pending' AND reason_code IN ('bilateral_refund_pending','bilateral_refund_rejected')\",\n                ['id'=>$request['id']]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('退款方案状态已变化，请刷新', 'REFUND_WITHDRAW_CHANGED', 409);\n            }\n            $db->execute(\n                \"UPDATE orders\n                 SET refund_status=:refund_status,publish_status=:publish_status,version=version+1,updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND lifecycle_status='active'\",\n                ['refund_status'=>$restoreRefund,'publish_status'=>$restorePublish,'id'=>$order['id']]\n            );\n            $this->event($db, $order, $actor, 'negotiation_responded', [\n                'kind'=>'refund','reference'=>$reference,'decision'=>'withdrawn','note'=>$note,\n                'message'=>'退款方案已由提出方撤回，订单恢复继续履约',\n            ]);\n            return ['reference'=>$reference,'status'=>'withdrawn','order_resumed'=>true];\n        });\n    }\n\n    public function escalate(array $actor, string $orderNo, string $kind, string $reference, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$kind,$reference,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if ((string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('订单已结束', 'ORDER_NOT_ACTIVE', 409);\n            if ($kind === 'dispute') return (new DatabaseOrderDisputeRepository($db))->escalate($actor, $reference, $note);\n            if ($kind === 'repair') return (new DatabaseOrderRepairInterventionRepository($db))->request($actor, $orderNo, $reference, $note);\n            if ($kind === 'refund') {\n                $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                if (!$request || (string)$request['status'] !== 'pending') throw new OrderOperationException('退款方案已经结束', 'REFUND_PROPOSAL_NOT_FOUND', 409);\n                $eligibility = NegotiationPolicy::evaluate(NegotiationPolicy::refundStatus((string)$request['reason_code']), $request['requested_at']);\n                $this->requireEligible($eligibility);\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_escalated',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n                $this->event($db, $order, $actor, 'cancel_requested', ['message'=>'双方退款协商未解决，已申请平台介入','reference'=>$reference,'note'=>$note,'notify_recipients'=>['user','worker','admin']]);\n            } else {\n                if ($kind === 'change') {\n                    $change = $db->fetch('SELECT * FROM change_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                    $latest = $db->fetchValue('SELECT public_id FROM change_requests WHERE order_id=:id ORDER BY id DESC LIMIT 1', ['id'=>$order['id']]);\n                    if (!$change || $latest !== $reference || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                        throw new OrderOperationException('加价事项已失效或被新方案替代', 'CHANGE_NOT_ACTIVE', 409);\n                    }\n                    $eligibility = NegotiationPolicy::evaluate((string)$change['status'], $change['submitted_at']);\n                } elseif ($kind === 'measurement') {\n                    $this->requireOwner($actor, $order);\n                    $state = $this->measurement($db, $order, $reference);\n                    $eligibility = NegotiationPolicy::evaluate($state['status'], $state['opened_at']);\n                } else throw new OrderOperationException('协商类型不支持升级', 'NEGOTIATION_INVALID', 422);\n                $this->requireEligible($eligibility);\n                if (!in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                    || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\", ['id'=>$order['id']])) {\n                    throw new OrderOperationException('本单已有争议正在处理中', 'DISPUTE_ALREADY_ACTIVE', 409);\n                }\n                $disputeNo = \\business_no('DSP');\n                $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n                $db->insert(\"INSERT INTO disputes(public_no,order_id,raised_by_type,raised_by_id,dispute_type,title,description,status,responsibility,opened_at,created_at,updated_at)\n                    VALUES(:no,:order,:type,:actor,:kind,:title,:description,'open','undetermined',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['no'=>$disputeNo,'order'=>$order['id'],'type'=>$type,'actor'=>$type === 'user' ? $actor['user_id'] : $actor['worker_id'],'kind'=>$kind === 'change' ? 'fee_negotiation' : 'measurement_rework',\n                     'title'=>$kind === 'change' ? '加价协商未解决，申请平台介入' : '补测未解决，申请平台介入','description'=>'关联事项 '.$reference.'；'.$note]);\n                $db->execute(\"UPDATE orders SET dispute_status='open',publish_status='hidden' WHERE id=:id\", ['id'=>$order['id']]);\n                $this->event($db, $order, $actor, 'dispute_opened', ['dispute_no'=>$disputeNo,'reference'=>$reference,'intervention_reason'=>$eligibility['reason'],'message'=>'双方协商未解决，已申请平台介入','notify_recipients'=>['user','worker']]);\n                OrderNotificationService::queueAdminTask($db, 'dispute:'.$disputeNo, 'completion_dispute_opened', '双方协商未解决，申请平台介入', ['订单号'=>$orderNo,'事项'=>$kind,'协商说明'=>$note]);\n            }\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'status'=>'escalated','intervention_reason'=>$eligibility['reason']];\n        });\n    }\n\n    private function refund(Database $db, int $orderId, string $reference): array\n    {\n        $row = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$orderId,'no'=>$reference]);\n        if (!$row || (string)$row['status'] !== 'pending' || (string)$row['reason_code'] !== 'bilateral_refund_pending') throw new OrderOperationException('退款方案已经响应或不在协商阶段', 'REFUND_PROPOSAL_NOT_PENDING', 409);\n        return $row;\n    }\n\n    private function requireCounterparty(array $actor, array $order, array $request): void\n    {\n        if ((string)$request['applicant_type'] === 'user') $this->requireWorker($actor, $order);\n        elseif ((string)$request['applicant_type'] === 'worker') $this->requireOwner($actor, $order);\n        else throw new OrderOperationException('该退款需平台处理', 'REFUND_PROPOSAL_NOT_ALLOWED', 409);\n    }\n\n    private function requireWorker(array $actor, array $order): void\n    {\n        if ((int)($actor['worker_id'] ?? 0) < 1 || (int)$order['assigned_worker_id'] !== (int)$actor['worker_id']) throw new OrderOperationException('只能由成交师傅响应', 'FORBIDDEN', 403);\n    }\n    private function requireOwner(array $actor, array $order): void\n    {\n        if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) throw new OrderOperationException('只能由订单客户申请', 'FORBIDDEN', 403);\n    }\n    private function requireEligible(array $eligibility): void\n    {\n        if (empty($eligibility['eligible'])) throw new OrderOperationException('请先协商；对方拒绝或满48小时未解决后才可申请平台介入', 'NEGOTIATION_WAIT_REQUIRED', 409, $eligibility);\n    }\n    private function measurement(Database $db, array $order, string $reference): array\n    {\n        $state = $db->fetch('SELECT result_status FROM order_measurement_states WHERE order_id=:id FOR UPDATE', ['id'=>$order['id']]);\n        $rework = $db->fetch(\"SELECT id,created_at FROM order_events WHERE order_id=:id AND event_type='measurement_rework_requested' ORDER BY id DESC LIMIT 1\", ['id'=>$order['id']]);\n        if (!$state || !$rework || (string)$rework['id'] !== $reference || (string)$state['result_status'] !== 'editing'\n            || !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)) throw new OrderOperationException('补测已提交或正在平台处理中', 'MEASUREMENT_REWORK_NOT_ACTIVE', 409);\n        $rejected = $db->fetchValue(\"SELECT id FROM order_events WHERE order_id=:id AND event_type='measurement_rework_rejected' AND id>:rework LIMIT 1\", ['id'=>$order['id'],'rework'=>$rework['id']]);\n        return ['status'=>$rejected ? 'rejected' : 'pending','opened_at'=>$rework['created_at']];\n    }\n    private function event(Database $db, array $order, array $actor, string $event, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n        }\n        $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n        if (FulfillmentActor::assisted($actor)) { $type='mini_admin'; $payload += FulfillmentActor::metadata($actor); }\n        $key = $event.':'.$order['id'].':'.bin2hex(random_bytes(6));\n        $payload += ['notify_recipients'=>$type==='mini_admin' ? ['user','worker'] : [$type === 'user' ? 'worker' : 'user']];\n        $db->insert('INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order,:event,:key,:type,:actor,:payload,UTC_TIMESTAMP())',\n            ['order'=>$order['id'],'event'=>$event,'key'=>$key,'type'=>$type,'actor'=>$type === 'user' ? $actor['user_id'] : $actor['worker_id'],'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        OrderNotificationService::queue($db, (int)$order['id'], $key, $event, $payload);\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderQuoteSwitchRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Contracts\\OrderQuoteSwitchRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/** 开工前更换已报价师傅；不产生新的报价金额，也不修改真实预约费支付记录。 */\nfinal class DatabaseOrderQuoteSwitchRepository implements OrderQuoteSwitchRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function switchWorker(array $actor, string $orderPublicNo, string $quotePublicId, string $reason): array\n    {\n        $order = $this->db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1', ['public_no'=>$orderPublicNo]);\n        if (!$order || (int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n            throw new OrderOperationException('只能更换自己订单的师傅', 'FORBIDDEN', 403);\n        }\n        if ((string)($order['order_source_type'] ?? '') === 'platform') {\n            throw new OrderOperationException('平台承接单由平台安排履约师傅，客户不能直接更换', 'PLATFORM_ORDER_ADMIN_ASSIGNS_WORKER', 409);\n        }\n        if ((string)($order['workflow_profile'] ?? 'construction') === 'measurement') {\n            throw new OrderOperationException('测量成交后不直接更换师傅，如无法继续请走售后处理', 'MEASUREMENT_SWITCH_REQUIRES_AFTERSALE', 409);\n        }\n\n        $result = $this->db->transaction(function (Database $db) use ($actor,$order,$quotePublicId,$reason): array {\n            $locked = $db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$order['id']]);\n            if (!$locked || $locked['lifecycle_status'] !== 'active' || $locked['payment_status'] !== 'paid'\n                || empty($locked['current_assignment_id']) || empty($locked['assigned_worker_id'])) {\n                throw new RuntimeException('当前订单不满足更换师傅条件');\n            }\n            if ((string)($locked['order_source_type'] ?? '') === 'platform') throw new RuntimeException('平台承接单由平台安排履约师傅');\n            if (in_array((string)$locked['fulfillment_status'], ['scheduled','in_progress','submitted','accepted'], true)) {\n                throw new RuntimeException('已预约、开工或完工后不能直接更换师傅，请联系平台介入');\n            }\n            if ($db->fetchValue('SELECT id FROM appointment_records WHERE order_id=:id LIMIT 1', ['id'=>$locked['id']])\n                || $db->fetchValue('SELECT id FROM change_requests WHERE order_id=:id LIMIT 1', ['id'=>$locked['id']])\n                || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('open','processing') LIMIT 1\", ['id'=>$locked['id']])) {\n                throw new RuntimeException('订单已产生预约、费用变更或争议，不能直接更换师傅，请联系平台处理');\n            }\n\n            $bookingPayment = $db->fetch(\n                \"SELECT id,public_no,amount_cents FROM payment_orders\n                 WHERE order_id=:order_id AND business_type='order_booking' AND status='paid'\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$locked['id']]\n            );\n            if (!$bookingPayment) throw new RuntimeException('真实预约费支付记录不存在，暂不能更换师傅');\n\n            $old = $db->fetch(\n                \"SELECT * FROM assignments WHERE id=:id AND order_id=:order_id AND status IN ('offered','accepted') LIMIT 1 FOR UPDATE\",\n                ['id'=>$locked['current_assignment_id'],'order_id'=>$locked['id']]\n            );\n            if (!$old) throw new RuntimeException('原师傅指派状态已变化，请刷新后重试');\n\n            $quote = $db->fetch(\n                \"SELECT q.*,qv.id quote_version_id,qv.commission_rate_bp_snapshot,qv.commission_min_cents_snapshot,qv.rule_acknowledged_at\n                 FROM quotes q\n                 JOIN quote_versions qv ON qv.quote_id=q.id AND qv.version_no=q.current_version\n                 WHERE q.order_id=:order_id AND BINARY q.public_id=BINARY :public_id\n                   AND q.quote_type='worker' AND q.worker_id IS NOT NULL AND q.worker_id<>:old_worker\n                   AND q.status IN ('active','closed') LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$locked['id'],'public_id'=>$quotePublicId,'old_worker'=>$old['worker_id']]\n            );\n            if (!$quote) throw new RuntimeException('请选择该订单中另一位已报价师傅');\n\n            $worker = $db->fetch(\n                \"SELECT w.id,w.verification_status,u.status user_status\n                 FROM worker_profiles w JOIN users u ON u.id=w.user_id\n                 WHERE w.id=:worker_id LIMIT 1 FOR UPDATE\",\n                ['worker_id'=>$quote['worker_id']]\n            );\n            if (!$worker || (string)$worker['verification_status'] !== 'approved' || (string)$worker['user_status'] !== 'active') {\n                throw new RuntimeException('新师傅当前已不具备接单资格，请选择其他报价');\n            }\n\n            $rate = $quote['rule_acknowledged_at'] ? (int)$quote['commission_rate_bp_snapshot'] : (int)$locked['commission_rate_bp'];\n            $minimum = $quote['rule_acknowledged_at'] ? (int)$quote['commission_min_cents_snapshot'] : (int)$locked['commission_min_cents'];\n            $amount = (int)$quote['amount_cents'];\n            $booking = min($amount, (int)$locked['booking_fee_cents'], (int)$bookingPayment['amount_cents']);\n            $commission = $this->commissionAmount($amount, $rate, $minimum);\n            $ruleId = $this->ensureRuleVersion($db, $locked, $rate, $minimum);\n\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$old['id']]);\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'cancelled',:reason,'user',:actor_id,UTC_TIMESTAMP())\",\n                ['assignment_id'=>$old['id'],'order_id'=>$locked['id'],'worker_id'=>$old['worker_id'],'reason'=>'用户更换师傅：'.$reason,'actor_id'=>$actor['user_id']]\n            );\n            $db->execute(\n                \"UPDATE order_role_grants g JOIN worker_profiles w ON w.user_id=g.user_id\n                 SET g.status='revoked',g.revoked_at=UTC_TIMESTAMP()\n                 WHERE g.order_id=:order_id AND g.status='active' AND w.id=:worker_id\",\n                ['order_id'=>$locked['id'],'worker_id'=>$old['worker_id']]\n            );\n            $db->execute(\n                \"UPDATE quotes\n                 SET status=CASE WHEN id=:new_id THEN 'selected' WHEN id=:old_id THEN 'closed' ELSE status END,\n                     selected_at=CASE WHEN id=:new_time THEN UTC_TIMESTAMP() ELSE selected_at END,\n                     updated_at=UTC_TIMESTAMP()\n                 WHERE order_id=:order_id\",\n                ['new_id'=>$quote['id'],'old_id'=>$old['quote_id'] ?: 0,'new_time'=>$quote['id'],'order_id'=>$locked['id']]\n            );\n            $db->insert(\n                \"INSERT INTO quote_selections(order_id,quote_id,quote_version_id,user_id,amount_cents_snapshot,booking_fee_cents_snapshot,status,payment_expires_at,selected_at,confirmed_at)\n                 VALUES(:order_id,:quote_id,:version_id,:user_id,:amount,:booking,'confirmed',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['order_id'=>$locked['id'],'quote_id'=>$quote['id'],'version_id'=>$quote['quote_version_id'],'user_id'=>$actor['user_id'],'amount'=>$amount,'booking'=>$booking]\n            );\n\n            // 先按旧成交关系生成旧师傅通知，再切换订单当前师傅。\n            OrderNotificationService::queue(\n                $db,(int)$locked['id'],'worker-switch-old:'.$old['id'],'worker_replaced_by_user',\n                ['reason'=>$reason,'role'=>'old_worker','notify_recipients'=>['worker']]\n            );\n\n            $assignmentPublicId = \\public_id();\n            $assignmentId = $db->insert(\n                \"INSERT INTO assignments(public_id,order_id,worker_id,quote_id,assignment_type,commission_rule_version_id,\n                    final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,\n                    estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accept_deadline_at,created_at,updated_at)\n                 VALUES(:public_id,:order_id,:worker_id,:quote_id,'worker_quote',:rule_id,:amount,:booking,:rate,:minimum,:commission,:offline,:net,'offered',UTC_TIMESTAMP(),NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_id'=>$assignmentPublicId,'order_id'=>$locked['id'],'worker_id'=>$quote['worker_id'],'quote_id'=>$quote['id'],'rule_id'=>$ruleId,\n                    'amount'=>$amount,'booking'=>$booking,'rate'=>$rate,'minimum'=>$minimum,'commission'=>$commission,\n                    'offline'=>max(0,$amount-$booking),'net'=>$amount-$commission,\n                ]\n            );\n            $db->execute(\n                \"UPDATE orders SET selected_quote_id=:quote_id,final_amount_cents=:amount,assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,\n                        commission_rule_version_id=:rule_id,assignment_status='offered',contact_revealed_at=NULL,updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['quote_id'=>$quote['id'],'amount'=>$amount,'worker_id'=>$quote['worker_id'],'assignment_id'=>$assignmentId,'rule_id'=>$ruleId,'id'=>$locked['id']]\n            );\n            $this->autoAcceptWorkerQuoteAssignment(\n                $db,(int)$locked['id'],$assignmentId,(int)$quote['worker_id'],$ruleId,\n                '用户选择另一位已报价师傅，报价即视为承接意愿',(int)$actor['user_id']\n            );\n            $this->event($db, (int)$locked['id'], 'worker_replaced_by_user', 'user', (int)$actor['user_id'], [\n                'old_worker_id'=>(int)$old['worker_id'],'new_worker_id'=>(int)$quote['worker_id'],'reason'=>$reason,\n                'quote_id'=>(string)$quote['public_id'],'booking_payment_no'=>(string)$bookingPayment['public_no'],\n                'message'=>'用户在开工前更换已报价师傅，新师傅按其报价意愿自动接单；旧师傅后续订单访问权已撤销。',\n            ]);\n            return ['assignment_id'=>$assignmentPublicId,'quote_id'=>(string)$quote['public_id'],'amount_cents'=>$amount];\n        });\n\n        return [\n            'message'=>'已更换师傅，新师傅已按报价意愿自动接单；原师傅后续订单访问权限已撤销',\n            'data'=>$result,\n        ];\n    }\n\n    /** @param array<string,mixed> $order */\n    private function ensureRuleVersion(Database $db, array $order, int $rate, int $minimum): int\n    {\n        $ruleId = (int)($order['commission_rule_version_id'] ?? 0);\n        if ($ruleId > 0 && $db->fetchValue('SELECT id FROM commission_rule_versions WHERE id=:id AND order_id=:order_id LIMIT 1', ['id'=>$ruleId,'order_id'=>$order['id']])) {\n            return $ruleId;\n        }\n        $version = 1 + (int)$db->fetchValue('SELECT COALESCE(MAX(version_no),0) FROM commission_rule_versions WHERE order_id=:order_id', ['order_id'=>$order['id']]);\n        return $db->insert(\n            \"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,adjustment_type,status,locked_at,created_at)\n             VALUES(:order_id,:version,:rate,:minimum,'default','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['order_id'=>$order['id'],'version'=>$version,'rate'=>$rate,'minimum'=>$minimum]\n        );\n    }\n\n    private function autoAcceptWorkerQuoteAssignment(Database $db, int $orderId, int $assignmentId, int $workerId, int $ruleId, string $reason, int $actorUserId): void\n    {\n        $assignment = $db->fetch(\n            \"SELECT * FROM assignments WHERE id=:id AND order_id=:order_id AND worker_id=:worker_id FOR UPDATE\",\n            ['id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$workerId]\n        );\n        if (!$assignment || $assignment['assignment_type'] !== 'worker_quote') throw new RuntimeException('师傅报价指派不存在或状态异常');\n        if ($assignment['status'] !== 'offered') throw new RuntimeException('师傅报价指派状态已变化');\n        $db->execute(\"UPDATE assignments SET status='accepted',accepted_at=UTC_TIMESTAMP(),accept_deadline_at=NULL,updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$assignmentId]);\n        $db->execute(\n            \"UPDATE orders SET assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,assignment_status='accepted',publish_status='hidden',\n                    contact_revealed_at=COALESCE(contact_revealed_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:order_id\",\n            ['worker_id'=>$workerId,'assignment_id'=>$assignmentId,'order_id'=>$orderId]\n        );\n        if ($ruleId > 0) $db->execute('UPDATE commission_rule_versions SET locked_at=COALESCE(locked_at,UTC_TIMESTAMP()) WHERE id=:id', ['id'=>$ruleId]);\n        $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:order_id AND id<>:id AND status='offered'\", ['order_id'=>$orderId,'id'=>$assignmentId]);\n        $db->insert(\n            \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n             VALUES(:assignment_id,:order_id,:worker_id,'accepted',:reason,'system',:actor_id,UTC_TIMESTAMP())\",\n            ['assignment_id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$workerId,'reason'=>$reason,'actor_id'=>$actorUserId]\n        );\n        $this->event($db, $orderId, 'assignment_auto_accepted', 'system', 0, ['worker_id'=>$workerId,'source'=>'worker_quote','message'=>$reason]);\n        OrderNotificationService::queue($db, $orderId, 'worker-quote-auto-accepted:'.$assignmentId, 'assignment_accepted', ['auto_accepted'=>1,'source'=>'worker_quote']);\n    }\n\n    private function commissionAmount(int $amount, int $rateBp, int $minimum): int\n    {\n        if ($amount <= 0) return 0;\n        return min($amount, max((int)round($amount * $rateBp / 10000, 0, PHP_ROUND_HALF_UP), max(0,$minimum)));\n    }\n\n    /** @param array<string,mixed> $payload */\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n        $db->insert(\n            \"INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())\",\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$type.':'.$orderId.':'.bin2hex(random_bytes(6)),\n                'actor_type'=>$actorType,'actor_id'=>$actorId > 0 ? $actorId : null,'payload'=>is_string($json) ? $json : '{}',\n            ]\n        );\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderRepairInterventionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderRepairInterventionRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\RepairInterventionPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderRepairInterventionRepository implements OrderRepairInterventionRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function request(array $actor, string $orderNo, string $afterSaleNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$afterSaleNo,$note): array {\n            $order = $db->fetch(\n                'SELECT id,public_no,user_id,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能为自己的维修申请平台介入', 'FORBIDDEN', 403);\n            }\n\n            $repair = $db->fetch(\n                \"SELECT id,public_no,status,resolution,opened_at\n                 FROM after_sales\n                 WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair'\n                 LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id'],'public_no'=>$afterSaleNo]\n            );\n            if (!$repair || !in_array((string)$repair['status'], ['open','processing'], true)) {\n                throw new OrderOperationException('维修申请不存在或已结束', 'REPAIR_NOT_ACTIVE', 409);\n            }\n\n            $eligibility = RepairInterventionPolicy::evaluate(\n                (string)$repair['status'],\n                $repair['resolution'] === null ? null : (string)$repair['resolution'],\n                $repair['opened_at'] === null ? null : (string)$repair['opened_at'],\n                'UTC'\n            );\n            if (!$eligibility['eligible']) {\n                if ((string)$eligibility['reason'] === 'already_escalated') {\n                    throw new OrderOperationException('已经申请平台介入，请勿重复提交', 'REPAIR_INTERVENTION_ALREADY_REQUESTED', 409);\n                }\n                $availableAt = (string)($eligibility['available_at'] ?? '');\n                throw new OrderOperationException(\n                    $availableAt !== ''\n                        ? '请先与师傅沟通处理；师傅未明确拒绝时，维修申请满 48 小时后（'.$availableAt.'）才可申请平台介入'\n                        : '请先与师傅沟通处理；师傅明确拒绝或维修申请满 48 小时后才可申请平台介入',\n                    'REPAIR_INTERVENTION_WAIT_REQUIRED',\n                    409,\n                    ['available_at'=>$availableAt,'wait_hours'=>RepairInterventionPolicy::WAIT_HOURS]\n                );\n            }\n\n            $resolution = '用户申请平台介入'.($note !== '' ? '：'.$note : '');\n            $db->execute(\n                \"UPDATE after_sales SET status='processing',resolution=:resolution,updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                ['resolution'=>$resolution,'id'=>$repair['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n\n            $eventKey = 'repair_platform_intervention_requested:'.$order['id'].':'.bin2hex(random_bytes(6));\n            $payload = [\n                'after_sale_id'=>(string)$repair['public_no'],\n                'message'=>'用户申请平台介入维修',\n                'note'=>$note,\n                'notify_recipients'=>['worker'],\n            ];\n            $db->insert(\n                'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,\\'user\\',:actor_id,:payload,UTC_TIMESTAMP())',\n                [\n                    'order_id'=>$order['id'],'type'=>'repair_platform_intervention_requested','event_key'=>$eventKey,\n                    'actor_id'=>$actor['user_id'],'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n                ]\n            );\n            OrderNotificationService::queue($db, (int)$order['id'], $eventKey, 'repair_platform_intervention_requested', $payload);\n            OrderNotificationService::queueAdminTask(\n                $db,\n                'after-sales:'.$repair['public_no'].':user-escalated',\n                'repair_platform_intervention_requested',\n                '用户申请平台介入维修',\n                ['订单号'=>(string)$order['public_no'],'售后编号'=>(string)$repair['public_no'],'用户说明'=>$note]\n            );\n\n            return [\n                'after_sale_id'=>(string)$repair['public_no'],\n                'status'=>'processing',\n                'intervention_reason'=>(string)$eligibility['reason'],\n            ];\n        });\n    }\n}\n","server/app/Infrastructure/Persistence/DatabasePlatformOrderAdminRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse PDOException;\nuse WorkerAdmin\\Contracts\\PlatformOrderAdminRepository;\nuse WorkerAdmin\\Contracts\\PrivateValueCipher;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\nfinal class DatabasePlatformOrderAdminRepository implements PlatformOrderAdminRepository\n{\n    private const UNBOUND_CLOUD_USER_ID = 'platform-order-unbound-v250';\n\n    private Database $db;\n    private PrivateValueCipher $cipher;\n    private PlatformOrderBookingPaymentVerifier $prepaymentVerifier;\n\n    public function __construct(Database $db, PrivateValueCipher $cipher)\n    {\n        $this->db = $db;\n        $this->cipher = $cipher;\n        $this->prepaymentVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    public function dashboard(): array\n    {\n        $rows = $this->db->fetchAll(\n            \"SELECT o.id,o.public_no,o.title,o.category_name_snapshot,o.city,o.district,o.address_summary,o.lat,o.lng,\n                    o.payment_status,o.audit_status,o.publish_status,o.quote_status,o.assignment_status,o.fulfillment_status,o.lifecycle_status,\n                    o.workflow_profile,o.dispatch_mode,o.booking_fee_cents,o.expected_fee_type,o.expected_fee_cents,o.final_amount_cents,o.selected_quote_id,\n                    o.assigned_worker_id,o.current_assignment_id,o.quote_deadline_at,o.created_at,o.updated_at,u.nickname,u.mobile_masked,u.status customer_user_status,\n                    t.customer_flow_mode,t.customer_pricing_mode,t.customer_contract_total_cents,t.booking_paid_cents AS external_prepayment_cents,\n                    t.worker_settlement_mode,t.worker_labor_cents,t.extra_income_rate_bp_snapshot,t.customer_tail_cents,t.platform_receivable_cents,\n                    t.worker_balance_credit_cents,t.settlement_status,\n                    ms.order_id measurement_state_id,ms.result_status measurement_status,\n                    w.display_name AS worker_name\n             FROM orders o\n             INNER JOIN order_platform_terms t ON t.order_id=o.id\n             INNER JOIN users u ON u.id=o.user_id\n             LEFT JOIN order_measurement_states ms ON ms.order_id=o.id\n             LEFT JOIN worker_profiles w ON w.id=o.assigned_worker_id\n             WHERE o.order_source_type='platform'\n             ORDER BY o.id DESC LIMIT 100\"\n        );\n\n        foreach ($rows as &$row) {\n            $row['customer_bound'] = (string)($row['customer_user_status'] ?? '') !== 'platform_unbound';\n            $row['fulfillment_mode'] = !empty($row['measurement_state_id']) ? 'measure_then_install' : 'direct_install';\n            $row['measurement_status'] = !empty($row['measurement_state_id']) ? (string)$row['measurement_status'] : 'not_required';\n            $row['customer_flow_mode'] = (string)$row['customer_flow_mode'];\n            $row['can_review_platform_pricing'] = (string)($row['workflow_profile'] ?? '') === 'measurement'\n                && $row['measurement_status'] === 'accepted'\n                && PlatformOrderPricingReviewReadiness::isReady($this->db, (int)$row['id']);\n        }\n        unset($row);\n\n        $quotesByOrder = [];\n        $invitesByOrder = [];\n        if ($rows) {\n            $params = [];\n            $marks = [];\n            foreach ($rows as $index => $row) {\n                $key = 'order_' . $index;\n                $marks[] = ':' . $key;\n                $params[$key] = (int)$row['id'];\n            }\n            $quoted = $this->db->fetchAll(\n                \"SELECT q.id,q.order_id,q.public_id,q.amount_cents,q.description,q.status,q.updated_at,w.display_name,w.verification_status\n                 FROM quotes q INNER JOIN worker_profiles w ON w.id=q.worker_id\n                 WHERE q.quote_type='worker' AND q.order_id IN (\" . implode(',', $marks) . \")\n                 ORDER BY q.order_id DESC,q.amount_cents ASC,q.id ASC\",\n                $params\n            );\n            foreach ($quoted as $quote) $quotesByOrder[(int)$quote['order_id']][] = $quote;\n\n            $invites = $this->db->fetchAll(\n                \"SELECT i.id,i.order_id,i.status,i.max_claims,i.claim_count,i.expires_at,i.created_at,i.claimed_at,\n                        i.claimed_worker_id,w.display_name claimed_worker_name\n                 FROM invite_tokens i\n                 LEFT JOIN worker_profiles w ON w.id=i.claimed_worker_id\n                 WHERE i.purpose='worker_assignment' AND i.order_id IN (\" . implode(',', $marks) . \")\n                 ORDER BY i.order_id DESC,i.id DESC\",\n                $params\n            );\n            foreach ($invites as $invite) $invitesByOrder[(int)$invite['order_id']][] = $invite;\n        }\n\n        return [\n            'rows'=>$rows,\n            'quotesByOrder'=>$quotesByOrder,\n            'invitesByOrder'=>$invitesByOrder,\n            'users'=>$this->db->fetchAll(\"SELECT id,nickname,mobile_masked,public_id FROM users WHERE status='active' ORDER BY id DESC LIMIT 200\"),\n            'categories'=>$this->db->fetchAll(\"SELECT id,name,order_code FROM service_categories WHERE status='active' ORDER BY sort_order ASC,id ASC\"),\n        ];\n    }\n\n    public function create(array $command, int $adminId): int\n    {\n        if ((string)($command['customer_flow_mode'] ?? '') !== 'platform_managed') {\n            throw new OrderOperationException('平台承接单只允许平台托管模式。', 'PLATFORM_CUSTOMER_FLOW_INVALID', 422);\n        }\n        $requestedUserId = (int)($command['user_id'] ?? 0);\n        if ($requestedUserId > 0) {\n            $user = $this->db->fetch(\"SELECT id,nickname,status FROM users WHERE id=:id AND status='active' LIMIT 1\", ['id'=>$requestedUserId]);\n            if (!$user) throw new OrderOperationException('选择的客户账号不存在或不可用。', 'PLATFORM_USER_NOT_FOUND', 422);\n            $userId = (int)$user['id'];\n        } else {\n            $userId = $this->ensureUnboundCustomerUser();\n        }\n        $category = $this->db->fetch(\"SELECT id,name,order_code FROM service_categories WHERE id=:id AND status='active' LIMIT 1\", ['id'=>$command['category_id']]);\n        if (!$category) throw new OrderOperationException('请选择有效服务类目。', 'PLATFORM_CATEGORY_NOT_FOUND', 422);\n\n        // 与普通/代下单共用同一 order_submit 版本，不允许误取其他表单的最新 published 版本。\n        $schemaVersionId = (int)$this->db->fetchValue(\n            \"SELECT v.id FROM form_schema_versions v\n             INNER JOIN form_schemas s ON s.id=v.schema_id\n             WHERE BINARY s.schema_key=BINARY 'order_submit' AND v.status='published'\n             ORDER BY v.version_no DESC,v.id DESC LIMIT 1\"\n        );\n        if ($schemaVersionId < 1) {\n            throw new OrderOperationException('管理员尚未发布普通下单表单，暂不能创建平台承接单。', 'FORM_NOT_PUBLISHED', 503);\n        }\n\n        $province = mb_substr(trim((string)($command['province'] ?? '')), 0, 64);\n        $city = mb_substr(trim((string)($command['city'] ?? '')), 0, 64);\n        $district = mb_substr(trim((string)($command['district'] ?? '')), 0, 64);\n        $detailAddress = mb_substr(trim((string)($command['address'] ?? '')), 0, 255);\n        $fullAddress = trim(implode('', [$province,$city,$district,$detailAddress]));\n        $baseMobile = preg_match('/^(1\\d{10})/u', (string)$command['contact_mobile'], $mobileMatch) === 1\n            ? (string)$mobileMatch[1]\n            : (string)$command['contact_mobile'];\n        $maskedMobile = $this->maskContactMobile((string)$command['contact_mobile']);\n        [$lat,$lng,$locationSource,$mapPointName,$mapPointAddress] = $this->resolveLocation($command);\n        $expectedFeeType = $command['dispatch_mode'] === 'single_grab' ? 'total' : null;\n        $expectedFeeCents = $command['dispatch_mode'] === 'single_grab' ? (int)$command['worker_labor_cents'] : null;\n        $measureFirst = (string)($command['fulfillment_mode'] ?? 'direct_install') === 'measure_then_install';\n        $externalPrepayment = max(0, (int)($command['external_prepayment_cents'] ?? 0));\n\n        return $this->db->transaction(function (Database $db) use ($command,$userId,$category,$schemaVersionId,$province,$city,$district,$detailAddress,$fullAddress,$baseMobile,$maskedMobile,$expectedFeeType,$expectedFeeCents,$measureFirst,$adminId,$lat,$lng,$locationSource,$mapPointName,$mapPointAddress,$externalPrepayment): int {\n            $orderId = 0;\n            for ($attempt = 0; $attempt < 10; $attempt++) {\n                $publicNo = \\order_business_no((string)($category['order_code'] ?? 'QT'));\n                try {\n                    $orderId = $db->insert(\n                        \"INSERT INTO orders(public_no,user_id,form_schema_version_id,workflow_profile,dispatch_mode,expected_fee_type,expected_fee_cents,category_id,category_name_snapshot,category_names_snapshot,title,description,city,district,address_summary,address_ciphertext,address_hmac,lat,lng,contact_name_masked,contact_name_ciphertext,contact_mobile_masked,contact_mobile_ciphertext,contact_mobile_hmac,owner_mobile_base_hmac,order_source_type,audit_status,publish_status,quote_status,assignment_status,fulfillment_status,payment_status,refund_status,dispute_status,lifecycle_status,final_amount_cents,booking_fee_cents,commission_rate_bp,commission_min_cents,quote_deadline_at,version,created_at,updated_at)\n                         VALUES(:public_no,:user_id,:schema_version_id,'construction',:dispatch_mode,:expected_fee_type,:expected_fee_cents,:category_id,:category_name,:category_name,:title,:description,:city,:district,:address_summary,:address_ciphertext,:address_hmac,:lat,:lng,:contact_name_masked,:contact_name_ciphertext,:contact_mobile_masked,:contact_mobile_ciphertext,:contact_mobile_hmac,:owner_hmac,'platform','pending','hidden','waiting','unassigned','not_started','not_required','none','none','active',:customer_total,0,0,0,NULL,1,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                        [\n                            'public_no'=>$publicNo,\n                            'user_id'=>$userId,\n                            'schema_version_id'=>$schemaVersionId,\n                            'dispatch_mode'=>$command['dispatch_mode'],\n                            'expected_fee_type'=>$expectedFeeType,\n                            'expected_fee_cents'=>$expectedFeeCents,\n                            'category_id'=>$category['id'],\n                            'category_name'=>$category['name'],\n                            'title'=>$command['title'],\n                            'description'=>$command['description'] !== '' ? $command['description'] : null,\n                            'city'=>$city,\n                            'district'=>$district,\n                            'address_summary'=>$detailAddress,\n                            'address_ciphertext'=>$this->cipher->encrypt($fullAddress, 'order-address'),\n                            'address_hmac'=>$this->cipher->hmac($fullAddress, 'order-address'),\n                            'lat'=>$lat,\n                            'lng'=>$lng,\n                            'contact_name_masked'=>\\mask_private_name($command['contact_name']),\n                            'contact_name_ciphertext'=>$this->cipher->encrypt($command['contact_name'], 'order-contact-name'),\n                            'contact_mobile_masked'=>$maskedMobile,\n                            'contact_mobile_ciphertext'=>$this->cipher->encrypt($command['contact_mobile'], 'order-contact-mobile'),\n                            'contact_mobile_hmac'=>$this->cipher->hmac($command['contact_mobile'], 'order-contact-mobile'),\n                            'owner_hmac'=>$this->cipher->hmac($baseMobile, 'owner-mobile-base'),\n                            'customer_total'=>$command['customer_total_cents'],\n                        ]\n                    );\n                    break;\n                } catch (PDOException $exception) {\n                    if ((string)$exception->getCode() !== '23000' || $attempt === 9) throw $exception;\n                }\n            }\n            if ($orderId < 1) throw new OrderOperationException('订单号生成失败，请重试。', 'PLATFORM_ORDER_CREATE_FAILED', 409);\n\n            $db->insert(\n                \"INSERT INTO order_categories(order_id,category_id,category_name_snapshot,sort_order,created_at)\n                 VALUES(:order_id,:category_id,:category_name,0,UTC_TIMESTAMP())\",\n                ['order_id'=>$orderId,'category_id'=>$category['id'],'category_name'=>$category['name']]\n            );\n            $db->insert(\n                \"INSERT INTO order_addresses(order_id,province,city,district,address_summary,address_ciphertext,address_hmac,contact_name_masked,contact_name_ciphertext,contact_mobile_masked,contact_mobile_ciphertext,contact_mobile_hmac,lat,lng,coordinate_system,created_at,updated_at)\n                 VALUES(:order_id,:province,:city,:district,:address_summary,:address_ciphertext,:address_hmac,:contact_name_masked,:contact_name_ciphertext,:contact_mobile_masked,:contact_mobile_ciphertext,:contact_mobile_hmac,:lat,:lng,'GCJ-02',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'order_id'=>$orderId,\n                    'province'=>$province,\n                    'city'=>$city,\n                    'district'=>$district,\n                    'address_summary'=>$detailAddress,\n                    'address_ciphertext'=>$this->cipher->encrypt($fullAddress, 'order-address'),\n                    'address_hmac'=>$this->cipher->hmac($fullAddress, 'order-address'),\n                    'contact_name_masked'=>\\mask_private_name($command['contact_name']),\n                    'contact_name_ciphertext'=>$this->cipher->encrypt($command['contact_name'], 'order-contact-name'),\n                    'contact_mobile_masked'=>$maskedMobile,\n                    'contact_mobile_ciphertext'=>$this->cipher->encrypt($command['contact_mobile'], 'order-contact-mobile'),\n                    'contact_mobile_hmac'=>$this->cipher->hmac($command['contact_mobile'], 'order-contact-mobile'),\n                    'lat'=>$lat,'lng'=>$lng,\n                ]\n            );\n            $db->insert(\n                \"INSERT INTO order_platform_terms(order_id,customer_flow_mode,customer_pricing_mode,customer_contract_total_cents,worker_settlement_mode,worker_labor_cents,extra_income_rate_bp_snapshot,booking_paid_cents,worker_balance_freeze_days_snapshot,settlement_status,created_at,updated_at)\n                 VALUES(:order_id,'platform_managed',:pricing_mode,:customer_total,:settlement_mode,:worker_labor,:extra_rate,:external_prepayment,:freeze_days,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'order_id'=>$orderId,'pricing_mode'=>$command['customer_pricing_mode'],'customer_total'=>$command['customer_total_cents'],\n                    'settlement_mode'=>$command['worker_settlement_mode'],'worker_labor'=>$command['worker_labor_cents'],\n                    'extra_rate'=>$command['extra_income_rate_bp'],'external_prepayment'=>$externalPrepayment,\n                    'freeze_days'=>$command['worker_balance_freeze_days'],\n                ]\n            );\n            if ($measureFirst) {\n                $db->insert(\n                    \"INSERT INTO order_measurement_states(order_id,service_payment_status,result_status,settlement_status,created_at,updated_at)\n                     VALUES(:order_id,'not_required','editing','not_applicable',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['order_id'=>$orderId]\n                );\n            }\n            foreach ($command['pricing_items'] as $index => $item) {\n                $db->insert(\n                    \"INSERT INTO order_pricing_items(order_id,item_source,description,note,quantity,unit,unit_price_cents,amount_cents,sort_order,status,created_at,updated_at)\n                     VALUES(:order_id,'base',:description,:note,:quantity,:unit,:unit_price,:amount,:sort_order,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'order_id'=>$orderId,'description'=>$item['description'],'note'=>$item['note'] !== '' ? $item['note'] : null,\n                        'quantity'=>$item['quantity'],'unit'=>$item['unit'],'unit_price'=>$item['unit_price_cents'],'amount'=>$item['amount_cents'],'sort_order'=>$index + 1,\n                    ]\n                );\n            }\n            $this->event($db, $orderId, 'platform_order_created', $adminId, [\n                'operator_channel'=>(string)($command['operator_channel'] ?? 'web_admin'),\n                'operator_user_id'=>(int)($command['operator_user_id'] ?? 0),\n                'customer_bound'=>(int)($command['user_id'] ?? 0) > 0,\n                'customer_flow_mode'=>'platform_managed',\n                'fulfillment_mode'=>(string)$command['fulfillment_mode'],\n                'customer_total_cents'=>(int)$command['customer_total_cents'],\n                'external_prepayment_cents'=>$externalPrepayment,\n                'dispatch_mode'=>$command['dispatch_mode'],\n                'worker_settlement_mode'=>$command['worker_settlement_mode'],\n                'location_source'=>$locationSource,'lat'=>$lat,'lng'=>$lng,\n                'map_point_name'=>$mapPointName,'map_point_address'=>$mapPointAddress,'text_address'=>$fullAddress,\n            ]);\n            return $orderId;\n        });\n    }\n\n    public function publish(int $orderId, int $adminId, int $quoteDays): void\n    {\n        $this->db->transaction(function (Database $db) use ($orderId,$adminId,$quoteDays): void {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order) throw new OrderOperationException('平台承接单不存在。', 'PLATFORM_ORDER_NOT_FOUND', 404);\n            if ((string)$order['customer_flow_mode'] !== 'platform_managed' || (int)$order['booking_fee_cents'] !== 0) {\n                throw new OrderOperationException('平台单资金口径仍含旧预约模式，不能发布。', 'PLATFORM_BOOKING_FLOW_INVALID', 409);\n            }\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            if ($order['lifecycle_status'] !== 'active' || !empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) {\n                throw new OrderOperationException('当前订单阶段不能发布。', 'PLATFORM_PUBLISH_NOT_ALLOWED', 409);\n            }\n            if ((string)$order['publish_status'] === 'published') {\n                throw new OrderOperationException('平台承接单已经发布，请勿重复刷新报价截止时间。', 'PLATFORM_ALREADY_PUBLISHED', 409);\n            }\n            if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) {\n                throw new OrderOperationException('订单存在退款状态，不能重新发布。', 'PLATFORM_REFUND_BLOCKS_PUBLISH', 409);\n            }\n            if ($order['lat'] === null || $order['lng'] === null) {\n                throw new OrderOperationException('施工地址缺少地图坐标，请先补充地图选点。', 'PLATFORM_LOCATION_REQUIRED', 409);\n            }\n            $changed = $db->execute(\n                \"UPDATE orders SET audit_status='approved',publish_status='published',quote_status='waiting',audited_at=UTC_TIMESTAMP(),published_at=UTC_TIMESTAMP(),quote_deadline_at=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$quoteDays} DAY),audit_note='平台托管条件核验通过后人工异常修复发布',updated_at=UTC_TIMESTAMP(),version=version+1\n                 WHERE id=:id AND publish_status<>'published' AND selected_quote_id IS NULL AND assigned_worker_id IS NULL AND current_assignment_id IS NULL\",\n                ['id'=>$orderId]\n            );\n            if ($changed !== 1) throw new OrderOperationException('订单发布状态已变化，请刷新后重试。', 'PLATFORM_PUBLISH_RACE', 409);\n            $this->event($db, $orderId, 'platform_order_published', $adminId, ['quote_days'=>$quoteDays]);\n        });\n    }\n\n    public function selectQuote(int $orderId, int $quoteId, int $adminId): void\n    {\n        $this->db->transaction(function (Database $db) use ($orderId,$quoteId,$adminId): void {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents,t.worker_settlement_mode\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order) throw new OrderOperationException('平台承接单不存在。', 'PLATFORM_ORDER_NOT_FOUND', 404);\n            if ($order['dispatch_mode'] !== 'multi_quote') throw new OrderOperationException('只有师傅报价模式可以由平台选择报价。', 'PLATFORM_QUOTE_MODE_REQUIRED', 409);\n            if ((string)$order['customer_flow_mode'] !== 'platform_managed' || (int)$order['booking_fee_cents'] !== 0\n                || $order['audit_status'] !== 'approved' || $order['publish_status'] !== 'published' || $order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('订单尚未满足平台托管/发布条件或已经结束。', 'PLATFORM_ORDER_NOT_READY', 409);\n            }\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            if (!empty($order['quote_deadline_at']) && strtotime((string)$order['quote_deadline_at'].' UTC') <= time()) {\n                throw new OrderOperationException('本单报价期限已经结束，不能再选择师傅。', 'PLATFORM_QUOTE_DEADLINE_PASSED', 409);\n            }\n            if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) {\n                throw new OrderOperationException('订单存在退款状态，不能选择师傅。', 'PLATFORM_REFUND_BLOCKS_DEAL', 409);\n            }\n            if (!empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) {\n                throw new OrderOperationException('该订单已经成交，请勿重复选择。', 'PLATFORM_ORDER_ALREADY_ASSIGNED', 409);\n            }\n\n            $quote = $db->fetch(\n                \"SELECT q.*,w.display_name FROM quotes q INNER JOIN worker_profiles w ON w.id=q.worker_id\n                 WHERE q.id=:quote_id AND q.order_id=:order_id AND q.quote_type='worker' AND q.status='active' FOR UPDATE\",\n                ['quote_id'=>$quoteId,'order_id'=>$orderId]\n            );\n            if (!$quote) throw new OrderOperationException('师傅报价不存在或已经失效。', 'PLATFORM_QUOTE_NOT_FOUND', 404);\n            $labor = max(0, (int)$quote['amount_cents']);\n            if ($labor <= 0) throw new OrderOperationException('师傅工费无效。', 'PLATFORM_LABOR_INVALID', 409);\n            if ($order['worker_settlement_mode'] === 'worker_collect'\n                && (int)$order['customer_contract_total_cents'] - $labor - (int)$order['booking_paid_cents'] < 0) {\n                throw new OrderOperationException('选择该报价会形成负差额，请先调整客户价格或让师傅修改报价。', 'PLATFORM_SETTLEMENT_NEGATIVE', 409);\n            }\n\n            $nextVersion = 1 + (int)$db->fetchValue('SELECT COALESCE(MAX(version_no),0) FROM commission_rule_versions WHERE order_id=:order_id', ['order_id'=>$orderId]);\n            $ruleId = $db->insert(\n                \"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,adjustment_type,adjustment_reason,created_by_admin_id,status,locked_at,created_at)\n                 VALUES(:order_id,:version,0,0,'platform_order','平台承接单不重复收取普通平台服务费',:admin_id,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['order_id'=>$orderId,'version'=>$nextVersion,'admin_id'=>$adminId ?: null]\n            );\n            $assignmentId = $db->insert(\n                \"INSERT INTO assignments(public_id,order_id,worker_id,quote_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_by_admin_id,created_at,updated_at)\n                 VALUES(:public_id,:order_id,:worker_id,:quote_id,'worker_quote',:rule_id,:labor,0,0,0,0,0,:labor,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),:admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['public_id'=>\\public_id(),'order_id'=>$orderId,'worker_id'=>$quote['worker_id'],'quote_id'=>$quoteId,'rule_id'=>$ruleId,'labor'=>$labor,'admin_id'=>$adminId ?: null]\n            );\n            $db->execute(\n                \"UPDATE quotes SET status=IF(id=:selected_id,'selected','closed'),selected_at=IF(id=:selected_time,UTC_TIMESTAMP(),selected_at),updated_at=UTC_TIMESTAMP()\n                 WHERE order_id=:order_id AND quote_type='worker' AND status='active'\",\n                ['selected_id'=>$quoteId,'selected_time'=>$quoteId,'order_id'=>$orderId]\n            );\n            $changed = $db->execute(\n                \"UPDATE orders SET selected_quote_id=:quote_id,assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,\n                         commission_rule_version_id=:rule_id,commission_rate_bp=0,commission_min_cents=0,quote_status='selected',assignment_status='accepted',publish_status='hidden',\n                         contact_revealed_at=COALESCE(contact_revealed_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP(),version=version+1\n                 WHERE id=:order_id AND selected_quote_id IS NULL AND assigned_worker_id IS NULL AND current_assignment_id IS NULL\",\n                ['quote_id'=>$quoteId,'worker_id'=>$quote['worker_id'],'assignment_id'=>$assignmentId,'rule_id'=>$ruleId,'order_id'=>$orderId]\n            );\n            if ($changed !== 1) throw new OrderOperationException('该订单刚刚已被其他操作成交，请刷新。', 'PLATFORM_ORDER_DEAL_RACE', 409);\n            $db->execute('UPDATE order_platform_terms SET worker_labor_cents=:labor,updated_at=UTC_TIMESTAMP() WHERE order_id=:order_id', ['labor'=>$labor,'order_id'=>$orderId]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:order_id AND purpose='worker_assignment' AND status='active'\", ['order_id'=>$orderId]);\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'accepted','平台承接单：师傅主动报价被平台选中后自动成交','admin',:actor_id,UTC_TIMESTAMP())\",\n                ['assignment_id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$quote['worker_id'],'actor_id'=>$adminId ?: null]\n            );\n            $this->event($db, $orderId, 'platform_worker_quote_selected', $adminId, [\n                'quote_id'=>$quote['public_id'],'worker_id'=>(int)$quote['worker_id'],'worker_labor_cents'=>$labor,\n            ]);\n        });\n    }\n\n    public function createInvite(int $orderId, int $adminId, int $validDays): array\n    {\n        $plainToken = rtrim(strtr(base64_encode(random_bytes(24)), '+/', '-_'), '=');\n        return $this->db->transaction(function (Database $db) use ($orderId,$adminId,$validDays,$plainToken): array {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order) throw new OrderOperationException('平台承接单不存在。', 'PLATFORM_ORDER_NOT_FOUND', 404);\n            if ((string)$order['customer_flow_mode'] !== 'platform_managed' || (int)$order['booking_fee_cents'] !== 0\n                || $order['audit_status'] !== 'approved' || $order['publish_status'] !== 'published' || $order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('只有托管条件完整、已发布且仍在接单阶段的平台单可以邀请师傅。', 'PLATFORM_INVITE_NOT_ALLOWED', 409);\n            }\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            if (!in_array((string)$order['quote_status'], ['waiting','quoting','collecting'], true)\n                || !empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) {\n                throw new OrderOperationException('该平台单已经成交或不再接收师傅。', 'PLATFORM_INVITE_NOT_ALLOWED', 409);\n            }\n            if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) {\n                throw new OrderOperationException('该订单存在退款状态，不能继续邀请师傅。', 'PLATFORM_REFUND_BLOCKS_INVITE', 409);\n            }\n            if (empty($order['quote_deadline_at']) || strtotime((string)$order['quote_deadline_at'].' UTC') <= time()) {\n                throw new OrderOperationException('本单报价期限已经结束，不能再生成邀请。', 'PLATFORM_QUOTE_DEADLINE_PASSED', 409);\n            }\n\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:order_id AND purpose='worker_assignment' AND status='active'\", ['order_id'=>$orderId]);\n            $ruleId = (int)$db->fetchValue(\n                \"SELECT id FROM commission_rule_versions WHERE order_id=:order_id AND adjustment_type='platform_order' AND status='active' ORDER BY version_no DESC,id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$orderId]\n            );\n            if ($ruleId < 1) {\n                $nextVersion = 1 + (int)$db->fetchValue('SELECT COALESCE(MAX(version_no),0) FROM commission_rule_versions WHERE order_id=:order_id', ['order_id'=>$orderId]);\n                $ruleId = $db->insert(\n                    \"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,adjustment_type,adjustment_reason,created_by_admin_id,status,locked_at,created_at)\n                     VALUES(:order_id,:version,0,0,'platform_order','平台承接单受邀师傅不重复收取普通服务费',:admin_id,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['order_id'=>$orderId,'version'=>$nextVersion,'admin_id'=>$adminId ?: null]\n                );\n            }\n            $expiresAt = gmdate('Y-m-d H:i:s', min(\n                time() + max(1, min(30, $validDays)) * 86400,\n                (int)strtotime((string)$order['quote_deadline_at'].' UTC')\n            ));\n            $inviteId = $db->insert(\n                \"INSERT INTO invite_tokens(order_id,token_hash,purpose,created_by_admin_id,commission_rule_version_id,status,max_claims,claim_count,expires_at,created_at)\n                 VALUES(:order_id,:token_hash,'worker_assignment',:admin_id,:rule_id,'active',1,0,:expires_at,UTC_TIMESTAMP())\",\n                [\n                    'order_id'=>$orderId,'token_hash'=>hash('sha256',$plainToken),'admin_id'=>$adminId ?: null,\n                    'rule_id'=>$ruleId,'expires_at'=>$expiresAt,\n                ]\n            );\n            $this->event($db, $orderId, 'platform_worker_invite_created', $adminId, [\n                'invite_id'=>$inviteId,'dispatch_mode'=>(string)$order['dispatch_mode'],'expires_at'=>$expiresAt,\n                'message'=>(string)$order['dispatch_mode']==='multi_quote'\n                    ? '受邀只是触达渠道，领取后仍需提交师傅工费报价'\n                    : '一口价平台单领取邀请即按既定师傅工费成交',\n            ]);\n            return [\n                'order_id'=>$orderId,'order_no'=>(string)$order['public_no'],'invite_id'=>$inviteId,\n                'token'=>$plainToken,'expires_at'=>$expiresAt,'dispatch_mode'=>(string)$order['dispatch_mode'],\n            ];\n        });\n    }\n\n    public function revokeInvite(int $orderId, int $inviteId, int $adminId): void\n    {\n        $this->db->transaction(function (Database $db) use ($orderId,$inviteId,$adminId): void {\n            $invite = $db->fetch(\n                \"SELECT i.id,i.status,o.order_source_type FROM invite_tokens i JOIN orders o ON o.id=i.order_id\n                 WHERE i.id=:invite_id AND i.order_id=:order_id FOR UPDATE\",\n                ['invite_id'=>$inviteId,'order_id'=>$orderId]\n            );\n            if (!$invite || (string)$invite['order_source_type'] !== 'platform') {\n                throw new OrderOperationException('平台邀请不存在。', 'PLATFORM_INVITE_NOT_FOUND', 404);\n            }\n            if ((string)$invite['status'] !== 'active') return;\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE id=:id AND status='active'\", ['id'=>$inviteId]);\n            $this->event($db,$orderId,'platform_worker_invite_revoked',$adminId,['invite_id'=>$inviteId]);\n        });\n    }\n\n    private function ensureUnboundCustomerUser(): int\n    {\n        $id = (int)$this->db->fetchValue(\"SELECT id FROM users WHERE cloud_user_id=:cloud_id LIMIT 1\", ['cloud_id'=>self::UNBOUND_CLOUD_USER_ID]);\n        if ($id > 0) return $id;\n        try {\n            $id = $this->db->insert(\n                \"INSERT INTO users(public_id,nickname,mobile_masked,status,cloud_user_id,created_at,updated_at)\n                 VALUES(:public_id,'平台待绑定客户','','platform_unbound',:cloud_id,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['public_id'=>\\public_id(),'cloud_id'=>self::UNBOUND_CLOUD_USER_ID]\n            );\n        } catch (PDOException $exception) {\n            if ((string)$exception->getCode() !== '23000') throw $exception;\n            $id = (int)$this->db->fetchValue(\"SELECT id FROM users WHERE cloud_user_id=:cloud_id LIMIT 1\", ['cloud_id'=>self::UNBOUND_CLOUD_USER_ID]);\n        }\n        if ($id < 1) throw new OrderOperationException('待绑定客户占位账号初始化失败，请重试。', 'PLATFORM_UNBOUND_CUSTOMER_INIT_FAILED', 500);\n        return $id;\n    }\n\n    /** @param array<string,mixed> $command @return array{0:float,1:float,2:string,3:string,4:string} */\n    private function resolveLocation(array $command): array\n    {\n        $lat = isset($command['lat']) && is_numeric($command['lat']) ? (float)$command['lat'] : null;\n        $lng = isset($command['lng']) && is_numeric($command['lng']) ? (float)$command['lng'] : null;\n        if ($lat === null || $lng === null || $lat < -90 || $lat > 90 || $lng < -180 || $lng > 180) {\n            throw new OrderOperationException('平台承接单必须先完成地图选点。', 'PLATFORM_LOCATION_REQUIRED', 422);\n        }\n        $mapName = mb_substr(trim((string)($command['map_point_name'] ?? '')), 0, 160);\n        $mapAddress = mb_substr(trim((string)($command['map_point_address'] ?? '')), 0, 255);\n        return [$lat,$lng,'map_picker',$mapName,$mapAddress];\n    }\n\n    private function maskContactMobile(string $mobile): string\n    {\n        if (preg_match('/^(1\\d{2})\\d{4}(\\d{4})(.*)$/u', $mobile, $matches) === 1) {\n            return $matches[1] . '****' . $matches[2] . $matches[3];\n        }\n        return $mobile;\n    }\n\n    private function event(Database $db, int $orderId, string $eventType, int $adminId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $mini = ($payload['operator_channel'] ?? '') === 'mini_admin';\n        $actorId = $mini ? (int)($payload['operator_user_id'] ?? 0) : $adminId;\n        $encoded = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n        $eventId = $db->insert(\n            \"INSERT INTO order_events(order_id,event_type,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,:event_type,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'event_type'=>$eventType,'actor_type'=>$mini ? 'mini_admin' : 'admin','actor_id'=>$actorId > 0 ? $actorId : null,'payload'=>is_string($encoded) ? $encoded : '{}']\n        );\n        \\WorkerAdmin\\Services\\OrderNotificationService::queuePersistedEvent($db, $orderId, $eventId, $eventType, $payload);\n    }\n}\n","server/app/Infrastructure/Persistence/OrderAutomaticAcceptanceWriter.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n\n/** 自动验收事务步骤；调用者负责锁订单、到期/风险校验及任务领取。与测试限定入口共用。 */\nfinal class OrderAutomaticAcceptanceWriter\n{\n    public function apply(Database $db,array $order,callable $recordEvent,callable $finalizeCommission): void\n    {\n        $orderId=(int)$order['id'];$businessVersion=max(1,(int)$order['version']);\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $updated = $db->execute(\n            \"UPDATE orders SET fulfillment_status='accepted',lifecycle_status='completed',auto_accept_at=COALESCE(auto_accept_at,DATE_ADD(completion_submitted_at,INTERVAL 72 HOUR)),accepted_at=UTC_TIMESTAMP(),auto_review_at=DATE_ADD(UTC_TIMESTAMP(),INTERVAL 5 DAY),closed_at=COALESCE(closed_at,UTC_TIMESTAMP()),version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id AND accepted_at IS NULL AND lifecycle_status='active'\",\n            ['id' => $orderId]\n        );\n        if ($updated !== 1) {\n            throw new RuntimeException('订单状态已变化，自动验收未写入。');\n        }\n\n        $versionAfter = (int) $order['version'] + 1;\n        $db->execute(\n            \"UPDATE completion_submissions SET status='accepted',accepted_at=COALESCE(accepted_at,UTC_TIMESTAMP()),accepted_type='auto_72h',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('submitted','pending','pending_acceptance')\",\n            ['id' => $orderId]\n        );\n        $db->execute(\n            \"UPDATE order_deadlines SET status='completed',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND deadline_type IN ('auto_accept','auto_accept_completion') AND status IN ('pending','blocked','claimed')\",\n            ['id' => $orderId]\n        );\n        $db->execute(\n            \"INSERT INTO order_deadlines(order_id,deadline_type,status,version,due_at,created_at,updated_at) VALUES (:order_id,'auto_review_order','pending',:version,DATE_ADD(UTC_TIMESTAMP(),INTERVAL 5 DAY),UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE status='pending',due_at=VALUES(due_at),block_reason=NULL,processed_at=NULL,updated_at=UTC_TIMESTAMP()\",\n            ['order_id' => $orderId, 'version' => $versionAfter]\n        );\n        $recordEvent($db, $orderId, 'auto_accepted_72h', 'auto_accept_completion', $businessVersion, [\n            'message' => '师傅提交完工满 72 小时，系统自动确认验收。',\n        ]);\n        // 三种来源共用同一订单自动验收状态机，平台单则走平台收入款与工费结算，\n        // 绝不能创建普通订单佣金；与客户手动验收共用同一个资金写入器。\n        if ((string)($order['order_source_type'] ?? '') === 'platform') {\n            $platformTerms = $db->fetch(\n                'SELECT * FROM order_platform_terms WHERE order_id=:id FOR UPDATE',\n                ['id'=>$orderId]\n            );\n            $platformAssignment = $db->fetch(\n                \"SELECT * FROM assignments WHERE id=:id AND worker_id=:worker_id AND status='accepted' FOR UPDATE\",\n                ['id'=>$order['current_assignment_id'] ?: 0, 'worker_id'=>$order['assigned_worker_id'] ?: 0]\n            );\n            if (!$platformTerms || !$platformAssignment) {\n                throw new RuntimeException('平台单自动验收时成交关系或结算条件不存在');\n            }\n            $settlement = (new PlatformOrderSettlementWriter())->apply($db, $order, $platformTerms, $platformAssignment);\n            $recordEvent($db, $orderId, 'platform_auto_accepted_settlement',\n                'auto_accept_platform_settlement', $businessVersion, [\n                    'customer_tail_cents'=>$settlement['customer_tail_cents'],\n                    'booking_paid_cents'=>$settlement['booking_paid_cents'],\n                    'worker_labor_cents'=>(int)$platformTerms['worker_labor_cents'],\n                    'platform_receivable_cents'=>$settlement['platform_receivable_cents'],\n                    'worker_balance_credit_cents'=>$settlement['worker_balance_credit_cents'],\n                    'settlement_status'=>$settlement['settlement_status'],\n                ]);\n        } else {\n            // 普通订单仍按原流程生成/正式化服务费。\n            $finalizeCommission($db,$orderId);\n        }\n        if(!empty($order['assigned_worker_id'])){$count=(int)$db->fetchValue('SELECT COUNT(*) FROM orders WHERE assigned_worker_id=:worker_id AND accepted_at IS NOT NULL',['worker_id'=>$order['assigned_worker_id']]);$db->execute('UPDATE worker_profiles SET completed_orders=:count,updated_at=UTC_TIMESTAMP() WHERE id=:id',['count'=>$count,'id'=>$order['assigned_worker_id']]);}\n    }\n}\n","server/app/Infrastructure/Persistence/OrderFormMediaRules.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\n\n/**\n * order_submit 图片字段的统一规则读取与就绪判断。\n * 普通下单 finalize、图片上传与平台承接单发布必须使用同一字段映射。\n */\nfinal class OrderFormMediaRules\n{\n    /** @return array{active:bool,min:int,max:int,label:string} */\n    public static function rule(Database $db,int $schemaVersionId,string $purpose):array\n    {\n        $keys=['product'=>'material_images','wall'=>'wall_images'];\n        if($schemaVersionId<1||!isset($keys[$purpose]))return ['active'=>false,'min'=>0,'max'=>20,'label'=>'图片'];\n        $row=$db->fetch(\n            \"SELECT f.label,f.component_type,f.is_required,f.validation_json\n             FROM form_fields f\n             JOIN form_steps s ON s.id=f.step_id\n             WHERE s.schema_version_id=:version AND s.status='active' AND f.status='active' AND BINARY f.field_key=BINARY :field\n             LIMIT 1\",\n            ['version'=>$schemaVersionId,'field'=>$keys[$purpose]]\n        );\n        if(!$row||!in_array((string)$row['component_type'],['image','image_upload'],true)){\n            return ['active'=>false,'min'=>0,'max'=>20,'label'=>$purpose==='product'?'商品/材料图片':'现场环境/墙面图片'];\n        }\n        $validation=[];\n        if(is_string($row['validation_json']??null)&&$row['validation_json']!==''){\n            $decoded=json_decode((string)$row['validation_json'],true);\n            if(is_array($decoded))$validation=$decoded;\n        }\n        $max=max(1,min(20,(int)($validation['max_items']??20)));\n        $min=min($max,max(!empty($row['is_required'])?1:0,(int)($validation['min_items']??0)));\n        return ['active'=>true,'min'=>$min,'max'=>$max,'label'=>(string)($row['label']?:($purpose==='product'?'商品/材料图片':'现场环境/墙面图片'))];\n    }\n\n    /** @return array{ready:bool,reason:string,purpose:string,required:int,actual:int} */\n    public static function readiness(Database $db,int $orderId,int $schemaVersionId,string $workflowProfile):array\n    {\n        // 与普通订单 finalize 保持一致：测量单不要求施工材料/墙面图片。\n        if($workflowProfile==='measurement')return ['ready'=>true,'reason'=>'','purpose'=>'','required'=>0,'actual'=>0];\n        foreach(['product','wall'] as $purpose){\n            $rule=self::rule($db,$schemaVersionId,$purpose);\n            if(!$rule['active'])continue;\n            $count=(int)$db->fetchValue(\n                \"SELECT COUNT(*) FROM media_links\n                 WHERE entity_type='order' AND entity_id=:order_id AND purpose=:purpose\",\n                ['order_id'=>$orderId,'purpose'=>$purpose]\n            );\n            if($count<$rule['min']){\n                return ['ready'=>false,'reason'=>'“'.$rule['label'].'”至少需要上传 '.$rule['min'].' 张','purpose'=>$purpose,'required'=>$rule['min'],'actual'=>$count];\n            }\n            if($count>$rule['max']){\n                return ['ready'=>false,'reason'=>'“'.$rule['label'].'”最多允许 '.$rule['max'].' 张','purpose'=>$purpose,'required'=>$rule['max'],'actual'=>$count];\n            }\n        }\n        return ['ready'=>true,'reason'=>'','purpose'=>'','required'=>0,'actual'=>0];\n    }\n}\n","server/app/Infrastructure/Persistence/OrdinaryMeasurementAcceptanceWriter.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n\n/**\n * 普通测量成果确认后的统一资金与终态写入。\n *\n * 调用者负责锁定 order / measurement state / assignment，以及 actor、到期和异常阻断校验。\n */\nfinal class OrdinaryMeasurementAcceptanceWriter\n{\n    /** @return array{gross_amount_cents:int,service_fee_cents:int,worker_net_cents:int,freeze_days:int,max_freeze_days:int} */\n    public function apply(\n        Database $db,\n        array $order,\n        array $assignment,\n        int $autoReviewDays,\n        int $freezeDays,\n        int $maxFreezeDays,\n        callable $recordEvent,\n        string $eventType,\n        string $message\n    ): array {\n        $orderId=(int)($order['id']??0);\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        if($orderId<1||(string)($order['workflow_profile']??'')!=='measurement'||(string)($order['order_source_type']??'consumer')==='platform'){\n            throw new RuntimeException('普通测量确认写入器收到无效订单');\n        }\n        if((int)($assignment['worker_id']??0)<1||(string)($assignment['status']??'')!=='accepted'){\n            throw new RuntimeException('普通测量确认缺少 accepted assignment');\n        }\n\n        $gross=max(0,(int)($order['final_amount_cents']??0));\n        $paid=(int)$db->fetchValue(\n            \"SELECT COALESCE(SUM(amount_cents),0)\n             FROM payment_orders\n             WHERE order_id=:order_id\n               AND business_type IN ('order_booking','measurement_balance','measurement_change')\n               AND status='paid'\",\n            ['order_id'=>$orderId]\n        );\n        if($gross<1||$paid<$gross){\n            throw new RuntimeException('测量服务款尚未全部到账，不能确认');\n        }\n\n        $rate=max(0,min(10000,(int)($assignment['commission_rate_bp_snapshot']??0)));\n        $minimum=max(0,(int)($assignment['commission_min_cents_snapshot']??0));\n        $fee=$this->commissionAmount($gross,$rate,$minimum);\n        $net=max(0,$gross-$fee);\n        $autoReviewDays=max(1,min(30,$autoReviewDays));\n        $freezeDays=max(1,min(36500,$freezeDays));\n        $maxFreezeDays=max($freezeDays,min(36500,$maxFreezeDays));\n\n        $updated=$db->execute(\n            \"UPDATE order_measurement_states\n             SET result_status='accepted',\n                 accepted_at=UTC_TIMESTAMP(),\n                 settlement_status='frozen',\n                 gross_amount_cents=:gross,\n                 service_rate_bp_snapshot=:rate,\n                 service_min_cents_snapshot=:minimum,\n                 service_fee_cents=:fee,\n                 worker_net_cents=:net,\n                 hold_until=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$freezeDays} DAY),\n                 max_hold_until=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$maxFreezeDays} DAY),\n                 settled_at=NULL,\n                 updated_at=UTC_TIMESTAMP()\n             WHERE order_id=:order_id AND result_status='submitted'\",\n            [\n                'gross'=>$gross,\n                'rate'=>$rate,\n                'minimum'=>$minimum,\n                'fee'=>$fee,\n                'net'=>$net,\n                'order_id'=>$orderId,\n            ]\n        );\n        if($updated!==1)throw new RuntimeException('测量成果状态已变化，确认未写入');\n\n        if($net>0){\n            $db->execute(\n                \"INSERT IGNORE INTO worker_balance_ledger(\n                    worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                    business_type,business_id,idempotency_key,description,status,created_at\n                 ) VALUES(\n                    :worker_id,'measurement_income_frozen','credit',:amount,0,:frozen,\n                    'order_measurement',:business_id,:key,:description,'effective',UTC_TIMESTAMP()\n                 )\",\n                [\n                    'worker_id'=>(int)$assignment['worker_id'],\n                    'amount'=>$net,\n                    'frozen'=>$net,\n                    'business_id'=>$orderId,\n                    'key'=>'order-measurement:'.$orderId.':frozen',\n                    'description'=>$eventType==='measurement_auto_accepted'\n                        ?'测量成果自动确认，净收入进入冻结余额'\n                        :'测量成果确认，净收入进入冻结余额',\n                ]\n            );\n        }\n\n        $db->execute(\n            \"UPDATE assignments SET status='completed',updated_at=UTC_TIMESTAMP()\n             WHERE id=:id AND status='accepted'\",\n            ['id'=>(int)$assignment['id']]\n        );\n        $orderUpdated=$db->execute(\n            \"UPDATE orders\n             SET fulfillment_status='accepted',\n                 lifecycle_status='completed',\n                 accepted_at=UTC_TIMESTAMP(),\n                 auto_review_at=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$autoReviewDays} DAY),\n                 closed_at=COALESCE(closed_at,UTC_TIMESTAMP()),\n                 version=version+1,\n                 updated_at=UTC_TIMESTAMP()\n             WHERE id=:id AND lifecycle_status='active' AND fulfillment_status='submitted'\",\n            ['id'=>$orderId]\n        );\n        if($orderUpdated!==1)throw new RuntimeException('测量订单状态已变化，确认未写入');\n\n        $db->insert(\n            \"INSERT INTO order_deadlines(order_id,deadline_type,status,version,due_at,created_at,updated_at)\n             VALUES(:order_id,'auto_review','pending',:version,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$autoReviewDays} DAY),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'version'=>(int)$order['version']+1]\n        );\n\n        $payload=[\n            'gross_amount_cents'=>$gross,\n            'service_fee_cents'=>$fee,\n            'worker_net_cents'=>$net,\n            'freeze_days'=>$freezeDays,\n            'message'=>$message,\n        ];\n        $recordEvent($db,$orderId,$eventType,(int)$order['version']+1,$payload);\n\n        return[\n            'gross_amount_cents'=>$gross,\n            'service_fee_cents'=>$fee,\n            'worker_net_cents'=>$net,\n            'freeze_days'=>$freezeDays,\n            'max_freeze_days'=>$maxFreezeDays,\n        ];\n    }\n\n    private function commissionAmount(int $amount,int $rateBp,int $minimum): int\n    {\n        if($amount<=0||$rateBp<=0)return 0;\n        return min($amount,max((int)round($amount*$rateBp/10000,0,PHP_ROUND_HALF_UP),max(0,$minimum)));\n    }\n}\n","server/app/Infrastructure/Persistence/PlatformOrderBookingPaymentVerifier.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\n/**\n * 平台承接单外部预付款核验。\n *\n * 平台承接单只允许 platform_managed：客户侧款项由外部渠道托管，系统不创建微信\n * order_booking/booking_fee 支付记录。普通客户（包含后台代下单）的微信预约费走普通订单\n * 支付链，绝不能进入本核验器。\n *\n * 调用方必须先在同一事务中锁定 orders 行；本类只核对平台专属资金事实，不发起支付/退款。\n */\nfinal class PlatformOrderBookingPaymentVerifier\n{\n    /**\n     * 返回当前可参与平台单结算的外部已收预付款金额。\n     *\n     * $expectedCents 为调用方已锁定的 order_platform_terms.booking_paid_cents；为兼容少量旧调用\n     * 允许传 null，此时直接从平台条款读取。customerFlowMode 仅用于验证，不再支持 miniapp_booking。\n     */\n    public function verifiedPaidCents(\n        Database $db,\n        int $orderId,\n        int $customerTotalCents,\n        ?int $expectedCents = null,\n        ?string $customerFlowMode = null\n    ): int {\n        if ($orderId <= 0 || $customerTotalCents <= 0) {\n            throw new OrderOperationException('平台承接订单金额或编号无效', 'PLATFORM_BOOKING_INVALID', 409);\n        }\n\n        $terms = null;\n        if ($expectedCents === null || trim((string)$customerFlowMode) === '') {\n            $terms = $db->fetch(\n                'SELECT customer_flow_mode,booking_paid_cents FROM order_platform_terms WHERE order_id=:order_id LIMIT 1 FOR UPDATE',\n                ['order_id'=>$orderId]\n            );\n            if (!$terms) {\n                throw new OrderOperationException('平台承接单缺少托管资金条款，请先修复订单数据', 'PLATFORM_TERMS_REQUIRED', 409);\n            }\n        }\n\n        $flow = trim((string)($customerFlowMode ?? ($terms['customer_flow_mode'] ?? '')));\n        if ($flow !== 'platform_managed') {\n            throw new OrderOperationException('平台承接单只允许平台托管模式；旧小程序预约模式必须先完成数据清理', 'PLATFORM_BOOKING_FLOW_INVALID', 409);\n        }\n\n        $externalPaid = $expectedCents !== null\n            ? $expectedCents\n            : (int)($terms['booking_paid_cents'] ?? 0);\n        if ($externalPaid < 0 || $externalPaid > $customerTotalCents) {\n            throw new OrderOperationException('平台外部已收预付款金额异常，请先核对订单资金条件', 'PLATFORM_BOOKING_AMOUNT_MISMATCH', 409);\n        }\n\n        // 平台托管单出现真实微信预约费，意味着订单来源/支付链串线或客户被重复收费。\n        $payments = $db->fetchAll(\n            \"SELECT id,amount_cents FROM payment_orders\n             WHERE order_id=:order_id AND business_type IN ('order_booking','booking_fee')\n               AND status='paid' ORDER BY id FOR UPDATE\",\n            ['order_id'=>$orderId]\n        );\n        if ($payments) {\n            throw new OrderOperationException(\n                '平台托管单检测到微信预约费付款，请先按资金异常核对；该笔款不能与外部预付款重复抵扣',\n                'PLATFORM_BOOKING_UNEXPECTED_PAYMENT',\n                409\n            );\n        }\n\n        return $externalPaid;\n    }\n}\n","server/app/Infrastructure/Persistence/PlatformOrderPricingReviewReadiness.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\n/** 小程序详情与 Web 正常核价入口共用可操作条件。 */\nfinal class PlatformOrderPricingReviewReadiness\n{\n    public static function isReady(\\WorkerAdmin\\Core\\Database $db, int $orderId): bool\n    {\n        return (bool)$db->fetchValue(\n            \"SELECT 1\n             FROM orders o\n             JOIN order_measurement_states ms ON ms.order_id=o.id AND ms.result_status='accepted'\n             JOIN order_platform_terms t ON t.order_id=o.id\n                                        AND t.customer_flow_mode='platform_managed'\n                                        AND t.settlement_status='pending'\n                                        AND t.booking_paid_cents<=t.customer_contract_total_cents\n             JOIN assignments a ON a.id=o.current_assignment_id\n                               AND a.order_id=o.id\n                               AND a.worker_id=o.assigned_worker_id\n                               AND a.status='accepted'\n             WHERE o.id=:order_id\n               AND o.order_source_type='platform'\n               AND o.booking_fee_cents=0\n               AND o.workflow_profile='measurement'\n               AND o.lifecycle_status='active'\n               AND COALESCE(o.dispute_status,'none') IN ('','none','resolved')\n               AND COALESCE(o.refund_status,'none') IN ('','none','failed')\n               AND NOT EXISTS(\n                   SELECT 1 FROM payment_orders p\n                   WHERE p.order_id=o.id AND p.business_type IN ('order_booking','booking_fee') AND p.status='paid'\n               )\n               AND NOT EXISTS(SELECT 1 FROM disputes d WHERE d.order_id=o.id AND d.status IN ('open','pending','processing'))\n               AND NOT EXISTS(SELECT 1 FROM refunds r WHERE r.order_id=o.id AND r.status NOT IN ('failed','closed','cancelled','rejected','succeeded'))\n               AND NOT EXISTS(SELECT 1 FROM order_cancel_requests cr WHERE cr.order_id=o.id AND cr.status IN ('pending','processing'))\n               AND NOT EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND c.status IN ('pending','processing','negotiating'))\n               AND NOT EXISTS(SELECT 1 FROM after_sales s WHERE s.order_id=o.id AND s.status IN ('open','processing'))\n             LIMIT 1\",\n            ['order_id'=>$orderId]\n        );\n    }\n}\n","server/app/Infrastructure/Persistence/PlatformOrderSettlementWriter.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\PlatformOrderSettlementPolicy;\n\n/**\n * 平台单验收的资金侧事务步骤。调用者必须已锁定 orders、order_platform_terms、assignments，\n * 并处于同一个事务；本类不单独提交事务、不生成虚假的客户支付记录。\n * 普通客户订单（包括后台代下单）不调用该类，也绝不创建普通订单服务费。\n */\nfinal class PlatformOrderSettlementWriter\n{\n    private PlatformOrderSettlementPolicy $policy;\n    private PlatformOrderBookingPaymentVerifier $bookingVerifier;\n\n    public function __construct()\n    {\n        $this->policy = new PlatformOrderSettlementPolicy();\n        $this->bookingVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    /**\n     * @param array<string,mixed> $order\n     * @param array<string,mixed> $terms\n     * @param array<string,mixed> $assignment\n     * @return array<string,int|string>\n     */\n    public function apply(Database $db, array $order, array $terms, array $assignment): array\n    {\n        $orderId = (int)($order['id'] ?? 0);\n        $workerId = (int)($order['assigned_worker_id'] ?? 0);\n        if ($orderId < 1 || (string)($order['order_source_type'] ?? '') !== 'platform'\n            || (int)($terms['order_id'] ?? 0) !== $orderId\n            || (string)($terms['customer_flow_mode'] ?? '') !== 'platform_managed'\n            || (int)($assignment['worker_id'] ?? 0) !== $workerId\n            || $workerId < 1\n            || (string)($assignment['status'] ?? '') !== 'accepted'\n            || (string)($terms['settlement_status'] ?? '') !== 'pending') {\n            throw new OrderOperationException('平台单结算关系或状态已变化，请刷新后重试', 'PLATFORM_SETTLEMENT_STATE_CHANGED', 409);\n        }\n        // 师傅现场收款凭证是客户向师傅付款的证据，不等同于师傅已向平台付清收入款。\n        $receiptCount = (int)$db->fetchValue(\n            \"SELECT COUNT(*) FROM media_links ml JOIN media_files mf ON mf.id=ml.media_file_id AND mf.status='active'\n             WHERE ml.entity_type='order' AND ml.entity_id=:order_id AND ml.purpose='collection_receipt'\",\n            ['order_id'=>$orderId]\n        );\n        if ($receiptCount < 1) {\n            throw new OrderOperationException('师傅尚未上传客户现场收款凭证，当前不能验收', 'COLLECTION_RECEIPT_REQUIRED', 409);\n        }\n\n        // booking_paid_cents 对平台单表示“外部渠道已实际收取的客户预付款”。\n        // orders.booking_fee_cents 属于普通订单微信预约费口径，平台单不得再读取或抵扣它。\n        $bookingPaid = $this->bookingVerifier->verifiedPaidCents(\n            $db,\n            $orderId,\n            (int)$terms['customer_contract_total_cents'],\n            (int)($terms['booking_paid_cents'] ?? 0),\n            'platform_managed'\n        );\n        $calculation = $this->policy->settlement(\n            (int)$terms['customer_contract_total_cents'],\n            (int)$terms['worker_labor_cents'],\n            $bookingPaid,\n            (string)$terms['worker_settlement_mode']\n        );\n        $platformReceivable = (int)$calculation['platform_receivable_cents'];\n        $workerCredit = (int)$calculation['worker_balance_credit_cents'];\n        $freezeDays = max(0, (int)$terms['worker_balance_freeze_days_snapshot']);\n        $status = $platformReceivable > 0 ? 'awaiting_platform_income' : 'settled';\n\n        $changed = $db->execute(\n            \"UPDATE order_platform_terms SET booking_paid_cents=:booking,customer_tail_cents=:tail,\n                    platform_receivable_cents=:platform_income,worker_balance_credit_cents=:worker_credit,\n                    settlement_status=:status,settled_at=IF(:settled_status='settled',UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n             WHERE order_id=:order_id AND settlement_status='pending' AND customer_flow_mode='platform_managed'\",\n            [\n                'booking'=>$calculation['booking_paid_cents'],\n                'tail'=>$calculation['customer_tail_cents'],\n                'platform_income'=>$platformReceivable,'worker_credit'=>$workerCredit,\n                'status'=>$status,'settled_status'=>$status,'order_id'=>$orderId,\n            ]\n        );\n        if ($changed !== 1) {\n            throw new OrderOperationException('平台结算已被处理，请刷新后重试', 'PLATFORM_SETTLEMENT_ALREADY_POSTED', 409);\n        }\n        $assignmentChanged = $db->execute(\n            \"UPDATE assignments SET status='completed',\n                    estimated_commission_cents=0,estimated_net_income_cents=:labor,updated_at=UTC_TIMESTAMP()\n             WHERE id=:id AND worker_id=:worker_id AND status='accepted'\",\n            ['labor'=>$terms['worker_labor_cents'],'id'=>$assignment['id'],'worker_id'=>$workerId]\n        );\n        if ($assignmentChanged !== 1) {\n            throw new OrderOperationException('成交师傅关系已变化，请刷新后重试', 'PLATFORM_ASSIGNMENT_CHANGED', 409);\n        }\n        if ($workerCredit > 0) {\n            $entry = $this->policy->workerBalanceEntry($workerCredit, $freezeDays);\n            $idempotencyKey = 'platform-order:'.$orderId.':worker-income';\n            $existing = $db->fetch(\n                'SELECT id FROM worker_balance_ledger WHERE idempotency_key=:key LIMIT 1 FOR UPDATE',\n                ['key'=>$idempotencyKey]\n            );\n            if ($existing) {\n                throw new OrderOperationException('师傅工费入账记录已存在，请先核对，禁止重复入账', 'PLATFORM_WORKER_CREDIT_ALREADY_POSTED', 409);\n            }\n            $inserted = $db->execute(\n                \"INSERT INTO worker_balance_ledger(worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                        business_type,business_id,idempotency_key,description,status,created_at)\n                 VALUES(:worker_id,:entry_type,'credit',:amount,:available,:frozen,'platform_order',:business_id,:key,:description,'effective',UTC_TIMESTAMP())\",\n                [\n                    'worker_id'=>$workerId,'entry_type'=>$entry['entry_type'],'amount'=>$workerCredit,\n                    'available'=>$entry['available_delta_cents'],'frozen'=>$entry['frozen_delta_cents'],\n                    'business_id'=>$orderId,'key'=>$idempotencyKey,\n                    'description'=>$freezeDays === 0 ? '平台承接单工费结算进入可提现余额' : '平台承接单工费进入冻结余额',\n                ]\n            );\n            if ($inserted !== 1) {\n                throw new OrderOperationException('师傅余额入账失败，验收已自动回滚', 'PLATFORM_WORKER_CREDIT_FAILED', 409);\n            }\n        }\n        return $calculation + [\n            'settlement_status'=>$status,\n            'worker_settlement_mode'=>(string)$terms['worker_settlement_mode'],\n            'freeze_days'=>$freezeDays,\n        ];\n    }\n}","server/app/Infrastructure/Persistence/SchedulerOrderEventWriter.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/** Existing scheduler event semantics, now outside the frozen legacy service. */\nfinal class SchedulerOrderEventWriter\n{\n    public function record(Database $db,int $orderId,string $eventType,string $jobName,int $version,array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey=substr('scheduler:'.$jobName.':order:'.$orderId.':v'.max(1,$version),0,128);\n        $db->execute(\n            \"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,:event_type,:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'event_type'=>$eventType,'event_key'=>$eventKey,\n                'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)]\n        );\n        OrderNotificationService::queue($db,$orderId,$eventKey,$eventType,$payload);\n    }\n}\n","server/app/Infrastructure/Safety/TestingEnvironmentPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Safety;\n\nuse RuntimeException;\n\n/**\n * 测试环境外部副作用统一安全边界。\n * 是否处于 testing 只由 config/installed.php 的 app.env 决定；可调参数来自后台 system_settings。\n */\nfinal class TestingEnvironmentPolicy\n{\n    public static function active(): bool\n    {\n        return strtolower(trim((string) \\app_config('app.env', 'production'))) === 'testing';\n    }\n\n    public static function qiniuUploadPrefix(string $configuredPrefix): string\n    {\n        $configuredPrefix=trim($configuredPrefix,'/');\n        if (!self::active()) return $configuredPrefix;\n        $prefix = trim((string) \\setting('testing.qiniu_path_prefix', 'test'), '/');\n        if ($prefix === '' || preg_match('#^[A-Za-z0-9._-]{1,40}$#', $prefix) !== 1 || strpos($prefix, '..') !== false) {\n            throw new RuntimeException('测试环境七牛根目录配置无效。');\n        }\n        if($configuredPrefix!==''&&strcasecmp($prefix,$configuredPrefix)===0){\n            throw new RuntimeException('测试环境七牛根目录不能与正式根目录相同。');\n        }\n        return $prefix;\n    }\n\n    public static function assertQiniuDeleteAllowed(string $key): void\n    {\n        if (!self::active()) return;\n        $prefix = self::qiniuUploadPrefix((string)\\setting('qiniu.path_prefix','upload'));\n        $normalized = ltrim(trim($key), '/');\n        if ($normalized === '' || strpos($normalized, $prefix . '/') !== 0) {\n            throw new RuntimeException('测试环境禁止删除非测试目录的七牛对象：仅允许 ' . $prefix . '/ 下的对象。');\n        }\n    }\n\n    public static function paymentEnabled(bool $configuredEnabled): bool\n    {\n        return self::active() ? false : $configuredEnabled;\n    }\n\n    public static function assertPaymentAllowed(string $operation, string $outTradeNo = '', string $outRefundNo = ''): void\n    {\n        if (self::active()) throw new RuntimeException('测试环境禁止真实微信支付、退款、查单和支付回调入账。');\n    }\n\n    public static function assertSmsRecipientAllowed(string $mobile): void\n    {\n        if (!self::active()) return;\n        if (!self::boolSetting('testing.sms_enabled', false)) {\n            throw new RuntimeException('测试环境真实短信总开关未开启。');\n        }\n        $mobile = preg_replace('/\\D+/', '', $mobile) ?? '';\n        $allowed = self::stringList('testing.allowed_sms_mobiles');\n        if ($mobile === '' || !in_array($mobile, $allowed, true)) {\n            throw new RuntimeException('测试环境禁止向非白名单手机号发送真实短信。');\n        }\n    }\n\n    public static function assertWechatRecipientAllowed(string $openid): void\n    {\n        if (!self::active()) return;\n        if (!self::boolSetting('testing.subscribe_enabled', false)) {\n            throw new RuntimeException('测试环境微信订阅消息总开关未开启。');\n        }\n        $openid = trim($openid);\n        $allowed = self::stringList('testing.allowed_wechat_openids');\n        if ($openid === '' || !in_array($openid, $allowed, true)) {\n            throw new RuntimeException('测试环境禁止向非白名单 OpenID 发送真实微信订阅消息。');\n        }\n    }\n\n    public static function adminAlertContent(string $content): string\n    {\n        if (!self::active()) return $content;\n        if (!self::boolSetting('testing.allow_wecom', false)) {\n            throw new RuntimeException('测试环境默认禁止企业微信机器人通知。');\n        }\n        return strpos($content, '【测试环境】') === 0 ? $content : \"【测试环境】\\n\" . $content;\n    }\n\n    public static function assertWechatAccountWriteAllowed(): void\n    {\n        if (self::active() && !self::boolSetting('testing.allow_wechat_account_writes', false)) {\n            throw new RuntimeException('测试环境默认禁止修改正式小程序的订阅模板配置。');\n        }\n    }\n\n    public static function assertCloudActionAllowed(string $action): void\n    {\n        if (!self::active()) return;\n        if (self::boolSetting('testing.allow_cloud_writes', false)) return;\n        $readOnly = [\n            'admin.health','admin.list','admin.detail','server.owner.get','server.nearbyMarkedWorkers',\n            'server.phoneSearchIds','server.phoneReveal','server.membershipStatus','server.publicWorkerSearch',\n        ];\n        if (!in_array($action, $readOnly, true)) {\n            throw new RuntimeException('测试环境禁止写入正式微信云开发环境：' . $action);\n        }\n    }\n\n    private static function boolSetting(string $key, bool $default): bool\n    {\n        return filter_var(\\setting($key, $default ? '1' : '0'), FILTER_VALIDATE_BOOLEAN);\n    }\n\n    private static function stringList(string $settingKey): array\n    {\n        $value = \\setting($settingKey, '');\n        if (is_string($value)) $value = preg_split('/[\\s,;]+/', $value) ?: [];\n        if (!is_array($value)) return [];\n        $rows = [];\n        foreach ($value as $item) {\n            $item = trim((string) $item);\n            if ($item !== '') $rows[] = $item;\n        }\n        return array_values(array_unique($rows));\n    }\n}\n","server/app/Infrastructure/Scheduling/AssignmentTimeoutProcessor.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Scheduling;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/**\n * 派单/抢单占位超时的单笔正式处理器。\n *\n * 生产 scheduler 负责扫描候选，本类只锁定并处理一个 assignment。\n * testing 入口必须绑定一个 built test_instance，且只允许 demo 非审核样例订单。\n */\nfinal class AssignmentTimeoutProcessor\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db=$db;\n    }\n\n    public function expireProduction(int $assignmentId): bool\n    {\n        if($assignmentId<1)return false;\n        return $this->expire($assignmentId,0,null);\n    }\n\n    /** @return array<string,mixed> */\n    public function expireTestInstance(int $instanceId,bool $advanceClock=true): array\n    {\n        if(!TestingEnvironmentPolicy::active())throw new RuntimeException('派单超时实例执行只允许 testing 环境');\n        if($instanceId<1)throw new RuntimeException('测试实例无效');\n\n        $target=$this->db->fetch(\n            \"SELECT ti.id instance_id,ti.order_id,ti.order_no_snapshot,ti.scenario_key,ti.build_status,ti.archived_at,ti.deleted_at,\n                    o.public_no,o.is_demo,o.current_assignment_id,o.lifecycle_status,\n                    a.id assignment_id,a.status assignment_status,a.assignment_type,a.offered_at,a.accept_deadline_at\n             FROM test_instances ti\n             JOIN orders o ON o.id=ti.order_id\n             JOIN assignments a ON a.id=o.current_assignment_id AND a.order_id=o.id\n             WHERE ti.id=:instance\n             LIMIT 1\",\n            ['instance'=>$instanceId]\n        );\n        if(!$target\n            ||(string)$target['build_status']!=='built'\n            ||!empty($target['archived_at'])\n            ||!empty($target['deleted_at'])\n            ||(int)$target['is_demo']!==1\n            ||(string)$target['public_no']!==(string)$target['order_no_snapshot']\n            ||strpos((string)$target['public_no'],'BXDEMOHALL')===0\n            ||(string)$target['lifecycle_status']!=='active'\n            ||(string)$target['assignment_status']!=='offered'){\n            throw new RuntimeException('派单超时测试实例边界失败');\n        }\n\n        $deadline=$this->deadline((string)($target['accept_deadline_at']??''),(string)($target['offered_at']??''));\n        if($deadline===null)throw new RuntimeException('当前派单缺少可验证的接受截止时间');\n        $asOf=$advanceClock\n            ?gmdate('Y-m-d H:i:s',max(time(),strtotime($deadline.' UTC')+1))\n            :gmdate('Y-m-d H:i:s');\n\n        $expired=$this->expire((int)$target['assignment_id'],$instanceId,$asOf);\n        return[\n            'expired'=>$expired,\n            'assignment_id'=>(int)$target['assignment_id'],\n            'order_id'=>(int)$target['order_id'],\n            'assignment_type'=>(string)$target['assignment_type'],\n            'deadline_at'=>$deadline,\n            'as_of'=>$asOf,\n            'clock_fixture'=>$advanceClock,\n            'scope'=>'test_instance',\n        ];\n    }\n\n    private function expire(int $assignmentId,int $testInstanceId,?string $asOf): bool\n    {\n        return$this->db->transaction(function(Database $db)use($assignmentId,$testInstanceId,$asOf):bool{\n            if($testInstanceId>0&&!TestingEnvironmentPolicy::active())throw new RuntimeException('禁止跨测试域执行派单超时');\n\n            $params=['id'=>$assignmentId];\n            $dueSql='COALESCE(accept_deadline_at,DATE_ADD(offered_at,INTERVAL 24 HOUR))<=UTC_TIMESTAMP()';\n            if($testInstanceId>0){\n                $dueSql='COALESCE(accept_deadline_at,DATE_ADD(offered_at,INTERVAL 24 HOUR))<=:as_of';\n                $params['as_of']=$asOf;\n            }\n            $assignment=$db->fetch(\n                \"SELECT * FROM assignments\n                 WHERE id=:id AND status='offered' AND {$dueSql}\n                 FOR UPDATE\",\n                $params\n            );\n            if(!$assignment)return false;\n\n            if($testInstanceId>0){\n                $order=$db->fetch(\n                    \"SELECT o.*\n                     FROM orders o\n                     JOIN test_instances ti ON ti.id=:instance AND ti.order_id=o.id\n                     WHERE o.id=:id\n                       AND o.is_demo=1\n                       AND BINARY o.public_no=BINARY ti.order_no_snapshot\n                       AND ti.build_status='built'\n                       AND ti.archived_at IS NULL\n                       AND ti.deleted_at IS NULL\n                     FOR UPDATE\",\n                    ['instance'=>$testInstanceId,'id'=>$assignment['order_id']]\n                );\n                if(!$order||strpos((string)$order['public_no'],'BXDEMOHALL')===0)throw new RuntimeException('派单超时测试订单边界失败');\n                if((int)($order['current_assignment_id']??0)!==(int)$assignment['id'])throw new RuntimeException('当前测试指派已经变化');\n            }else{\n                $order=$db->fetch(\n                    'SELECT * FROM orders WHERE id=:id AND COALESCE(is_demo,0)=0 FOR UPDATE',\n                    ['id'=>$assignment['order_id']]\n                );\n            }\n\n            if(!$order||(string)$order['lifecycle_status']!=='active')return false;\n            if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n            }\n\n            $changed=$db->execute(\n                \"UPDATE assignments\n                 SET status='expired',rejected_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='offered'\",\n                ['id'=>$assignment['id']]\n            );\n            if($changed!==1)return false;\n\n            $timeoutReason=(string)$assignment['assignment_type']==='single_grab'\n                ?'抢单后未在规定时间提交报价，系统自动释放并重新开放抢单'\n                :'派单超过处理期限未处理，系统自动释放';\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'expired',:reason,'system',NULL,UTC_TIMESTAMP())\",\n                [\n                    'assignment_id'=>$assignment['id'],\n                    'order_id'=>$assignment['order_id'],\n                    'worker_id'=>$assignment['worker_id'],\n                    'reason'=>$timeoutReason,\n                ]\n            );\n\n            if((int)($order['current_assignment_id']??0)===(int)$assignment['id']){\n                if((string)$assignment['assignment_type']==='single_grab'){\n                    $db->execute(\n                        \"UPDATE orders\n                         SET current_assignment_id=NULL,assigned_worker_id=NULL,assignment_status='unassigned',\n                             publish_status='published',quote_status='waiting',contact_revealed_at=NULL,\n                             updated_at=UTC_TIMESTAMP(),version=version+1\n                         WHERE id=:id\",\n                        ['id'=>$order['id']]\n                    );\n                }else{\n                    $db->execute(\n                        \"UPDATE orders\n                         SET current_assignment_id=NULL,assigned_worker_id=NULL,assignment_status='unassigned',\n                             publish_status='hidden',contact_revealed_at=NULL,\n                             updated_at=UTC_TIMESTAMP(),version=version+1\n                         WHERE id=:id\",\n                        ['id'=>$order['id']]\n                    );\n                }\n            }\n\n            $db->execute(\n                \"UPDATE order_role_grants g\n                 JOIN worker_profiles w ON w.user_id=g.user_id\n                 SET g.status='revoked',g.revoked_at=UTC_TIMESTAMP()\n                 WHERE g.order_id=:order_id AND g.status='active' AND w.id=:worker_id\",\n                ['order_id'=>$order['id'],'worker_id'=>$assignment['worker_id']]\n            );\n\n            $payload=[\n                'assignment_id'=>(int)$assignment['id'],\n                'message'=>(string)$assignment['assignment_type']==='single_grab'\n                    ?'抢单后未在规定时间提交报价，系统已释放并重新开放抢单。'\n                    :'派单超过处理期限未处理，系统已自动释放。',\n            ];\n            if($testInstanceId>0){\n                $payload['test_instance_id']=$testInstanceId;\n                $payload['clock_fixture']=$asOf!==null;\n                $payload['as_of']=$asOf;\n            }\n            $this->recordOrderEvent($db,(int)$order['id'],(int)$order['version'],$payload);\n            return true;\n        });\n    }\n\n    private function recordOrderEvent(Database $db,int $orderId,int $version,array $payload): void\n    {\n        $eventKey='scheduler:assignment_timeout:order:'.$orderId.':v'.max(1,$version);\n        $db->execute(\n            \"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,'assignment_expired',:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",\n            [\n                'order_id'=>$orderId,\n                'event_key'=>substr($eventKey,0,128),\n                'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        OrderNotificationService::queue(\n            $db,\n            $orderId,\n            substr($eventKey,0,128),\n            'assignment_expired',\n            $payload\n        );\n    }\n\n    private function deadline(string $explicit,string $offeredAt): ?string\n    {\n        $explicit=trim($explicit);\n        if($explicit!==''){\n            $timestamp=strtotime($explicit.' UTC');\n            if($timestamp!==false)return gmdate('Y-m-d H:i:s',$timestamp);\n        }\n        $offeredAt=trim($offeredAt);\n        if($offeredAt==='')return null;\n        $timestamp=strtotime($offeredAt.' UTC');\n        return$timestamp===false?null:gmdate('Y-m-d H:i:s',$timestamp+86400);\n    }\n}\n","server/app/Infrastructure/Scheduling/PlatformOrderAutoPublishTask.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Scheduling;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\OrderFormMediaRules;\nuse WorkerAdmin\\Infrastructure\\Persistence\\PlatformOrderBookingPaymentVerifier;\n\n/** V2.5.0 平台承接单自动发布。 */\nfinal class PlatformOrderAutoPublishTask\n{\n    private const JOB = 'platform_auto_publish';\n\n    private Database $db;\n    private int $limit;\n    private PlatformOrderBookingPaymentVerifier $prepaymentVerifier;\n\n    public function __construct(Database $db, int $limit = 100)\n    {\n        $this->db = $db;\n        $this->limit = max(1, min(500, $limit));\n        $this->prepaymentVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    public function run(): array\n    {\n        $runUuid = $this->uuidV4();\n        $runId = $this->db->insert(\n            \"INSERT INTO scheduler_runs(run_uuid,job_name,status,host_name,process_id,scanned_count,success_count,failure_count,started_at)\n             VALUES(:uuid,:job,'running',:host,:pid,0,0,0,UTC_TIMESTAMP())\",\n            ['uuid'=>$runUuid,'job'=>self::JOB,'host'=>substr((string)gethostname(),0,128),'pid'=>function_exists('getmypid')?(int)getmypid():null]\n        );\n        $startedAt = microtime(true);\n        $stats = ['scanned'=>0,'success'=>0,'failure'=>0];\n        $error = null;\n\n        try {\n            $cursorUpdatedAt = null;\n            $cursorId = 0;\n            do {\n                $cursorSql = '';\n                $params = [];\n                if ($cursorUpdatedAt !== null) {\n                    $cursorSql = ' AND (o.updated_at>:cursor_updated OR (o.updated_at=:cursor_updated_eq AND o.id>:cursor_id))';\n                    $params = ['cursor_updated'=>$cursorUpdatedAt,'cursor_updated_eq'=>$cursorUpdatedAt,'cursor_id'=>$cursorId];\n                }\n                $rows = $this->db->fetchAll(\n                    \"SELECT o.id,o.version,o.updated_at\n                     FROM orders o\n                     INNER JOIN order_platform_terms t ON t.order_id=o.id\n                     WHERE o.order_source_type='platform'\n                       AND t.customer_flow_mode='platform_managed'\n                       AND t.settlement_status='pending'\n                       AND t.customer_contract_total_cents>0\n                       AND t.booking_paid_cents<=t.customer_contract_total_cents\n                       AND o.booking_fee_cents=0\n                       AND COALESCE(o.is_demo,0)=0\n                       AND o.lifecycle_status='active'\n                       AND o.publish_status<>'published'\n                       AND o.audit_status IN ('pending','approved')\n                       AND COALESCE(o.refund_status,'none') IN ('','none')\n                       AND o.selected_quote_id IS NULL\n                       AND o.assigned_worker_id IS NULL\n                       AND o.current_assignment_id IS NULL\n                       AND o.quote_status IN ('waiting','quoting','collecting')\n                       AND NOT EXISTS(\n                           SELECT 1 FROM payment_orders p\n                           WHERE p.order_id=o.id AND p.business_type IN ('order_booking','booking_fee') AND p.status='paid'\n                       )\n                       AND NOT EXISTS(\n                           SELECT 1 FROM scheduled_job_failures f\n                           WHERE f.job_name='platform_auto_publish'\n                             AND f.business_key=CONCAT('order:',o.id)\n                             AND f.business_version=o.version\n                             AND f.resolved_at IS NULL\n                             AND f.next_retry_at>UTC_TIMESTAMP()\n                       )\n                       {$cursorSql}\n                     ORDER BY o.updated_at,o.id\n                     LIMIT {$this->limit}\",\n                    $params\n                );\n                if (!$rows) break;\n                $stats['scanned'] += count($rows);\n                foreach ($rows as $row) {\n                    $orderId = (int)$row['id'];\n                    $version = max(1,(int)$row['version']);\n                    try {\n                        if ($this->publishOne($orderId)) $stats['success']++;\n                    } catch (Throwable $exception) {\n                        $stats['failure']++;\n                        $this->recordFailure($runId,$orderId,$version,$exception);\n                    }\n                }\n                $last = $rows[count($rows)-1];\n                $cursorUpdatedAt = (string)$last['updated_at'];\n                $cursorId = (int)$last['id'];\n            } while (count($rows) === $this->limit);\n        } catch (Throwable $exception) {\n            $stats['failure']++;\n            $error = mb_substr($exception->getMessage(),0,4000);\n            $this->recordFailure($runId,0,1,$exception,'task:'.self::JOB);\n        }\n\n        if ($error === null && $stats['failure'] > 0) $error = '本批次有 '.$stats['failure'].' 笔平台承接单自动发布失败，请查看异常工作台。';\n        $status = $stats['failure'] > 0 ? 'failed' : 'success';\n        $this->db->execute(\n            \"UPDATE scheduler_runs SET status=:status,scanned_count=:scanned,success_count=:success,failure_count=:failure,finished_at=UTC_TIMESTAMP(),error_message=:error WHERE id=:id\",\n            ['status'=>$status,'scanned'=>$stats['scanned'],'success'=>$stats['success'],'failure'=>$stats['failure'],'error'=>$error,'id'=>$runId]\n        );\n        if ($status === 'success') {\n            $this->db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP() WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",['job'=>self::JOB,'key'=>'task:'.self::JOB]);\n        }\n        if ($stats['success'] === 0 && $stats['failure'] === 0) {\n            $this->db->execute(\"DELETE FROM scheduler_runs WHERE job_name=:job AND id<>:id AND status='success' AND success_count=0 AND failure_count=0\",['job'=>self::JOB,'id'=>$runId]);\n        }\n\n        return ['run_id'=>$runId,'run_uuid'=>$runUuid,'task'=>self::JOB,'status'=>$status,'scanned'=>$stats['scanned'],'success'=>$stats['success'],'failure'=>$stats['failure'],'duration_ms'=>(int)round((microtime(true)-$startedAt)*1000),'error'=>$error];\n    }\n\n    /**\n     * 管理员恢复入口只重检这一张订单，复用自动发布的完整锁内校验，不运行整批 scheduler。\n     * 已经发布视为幂等成功；当前业务条件不满足时只返回 not_ready，不伪造状态。\n     * @return array{ok:bool,status:string,message:string}\n     */\n    public function retryOrder(int $orderId): array\n    {\n        $order = $this->db->fetch('SELECT id,publish_status FROM orders WHERE id=:id LIMIT 1', ['id'=>$orderId]);\n        if (!$order) return ['ok'=>false,'status'=>'not_found','message'=>'订单不存在'];\n        if ((string)$order['publish_status'] === 'published') {\n            $this->db->execute(\n                \"UPDATE scheduled_job_failures SET resolved_at=COALESCE(resolved_at,UTC_TIMESTAMP())\n                 WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",\n                ['job'=>self::JOB,'key'=>'order:'.$orderId]\n            );\n            return ['ok'=>true,'status'=>'already_published','message'=>'订单已经发布，无需重复处理'];\n        }\n        try {\n            $published = $this->publishOne($orderId);\n        } catch (Throwable $exception) {\n            return ['ok'=>false,'status'=>'failed','message'=>mb_substr($exception->getMessage(),0,500)];\n        }\n        if (!$published) return ['ok'=>false,'status'=>'not_ready','message'=>'订单当前条件仍不满足自动发布，请按最新状态处理'];\n        return ['ok'=>true,'status'=>'published','message'=>'重新检查通过，订单已发布'];\n    }\n\n    private function publishOne(int $orderId): bool\n    {\n        return $this->db->transaction(function (Database $db) use ($orderId): bool {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents,t.settlement_status\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order\n                || (int)($order['is_demo']??0)!==0\n                || (string)$order['customer_flow_mode']!=='platform_managed'\n                || (string)$order['settlement_status']!=='pending'\n                || (int)$order['booking_fee_cents']!==0\n                || (int)$order['customer_contract_total_cents']<=0\n                || (int)$order['booking_paid_cents']>(int)$order['customer_contract_total_cents']\n                || (string)$order['lifecycle_status']!=='active'\n                || (string)$order['publish_status']==='published'\n                || !in_array((string)$order['audit_status'],['pending','approved'],true)\n                || !in_array((string)($order['refund_status']??'none'),['','none'],true)\n                || !empty($order['selected_quote_id'])\n                || !empty($order['assigned_worker_id'])\n                || !empty($order['current_assignment_id'])\n                || !in_array((string)$order['quote_status'],['waiting','quoting','collecting'],true)\n                || $this->hasBlockingBusiness($db,$orderId)) return false;\n            if ($order['lat']===null || $order['lng']===null) throw new RuntimeException('平台承接单缺少地图坐标，系统已停止自动发布，请补充地址后处理');\n            $mediaReadiness = OrderFormMediaRules::readiness($db,$orderId,(int)($order['form_schema_version_id']??0),(string)($order['workflow_profile']??'construction'));\n            if (empty($mediaReadiness['ready'])) return false;\n\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            $quoteDays = max(1,min(30,(int)\\setting('order.auto_cancel_days',7)));\n            $version = max(1,(int)$order['version']);\n            $changed = $db->execute(\n                \"UPDATE orders SET audit_status='approved',publish_status='published',quote_status='waiting',audited_at=COALESCE(audited_at,UTC_TIMESTAMP()),published_at=COALESCE(published_at,UTC_TIMESTAMP()),quote_deadline_at=COALESCE(quote_deadline_at,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$quoteDays} DAY)),audit_note='平台托管条件核验通过后系统自动发布',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id AND order_source_type='platform' AND booking_fee_cents=0 AND lifecycle_status='active' AND publish_status<>'published' AND selected_quote_id IS NULL AND assigned_worker_id IS NULL AND current_assignment_id IS NULL\",\n                ['id'=>$orderId]\n            );\n            if ($changed!==1) return false;\n\n            $eventKey='scheduler:'.self::JOB.':order:'.$orderId.':v'.$version;\n            $payload=json_encode(['quote_days'=>$quoteDays,'external_prepayment_cents'=>(int)$order['booking_paid_cents'],'message'=>'平台承接单托管条件与公共下单资料完整，系统自动审核并发布，无需管理员二次确认。'],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $db->execute(\"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,'platform_order_auto_published',:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",['order_id'=>$orderId,'event_key'=>substr($eventKey,0,128),'payload'=>is_string($payload)?$payload:'{}']);\n            $db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP() WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",['job'=>self::JOB,'key'=>'order:'.$orderId]);\n            return true;\n        });\n    }\n\n    private function hasBlockingBusiness(Database $db, int $orderId): bool\n    {\n        return (int)$db->fetchValue(\n            \"SELECT (EXISTS(SELECT 1 FROM disputes WHERE order_id=:id1 AND status IN ('open','pending','processing')) OR EXISTS(SELECT 1 FROM refunds WHERE order_id=:id2 AND status NOT IN ('failed','closed','cancelled','rejected')) OR EXISTS(SELECT 1 FROM order_cancel_requests WHERE order_id=:id3 AND status IN ('pending','processing')) OR EXISTS(SELECT 1 FROM change_requests WHERE order_id=:id4 AND status IN ('pending','processing','negotiating')) OR EXISTS(SELECT 1 FROM after_sales WHERE order_id=:id5 AND status IN ('open','processing'))) AS blocked\",\n            ['id1'=>$orderId,'id2'=>$orderId,'id3'=>$orderId,'id4'=>$orderId,'id5'=>$orderId]\n        )===1;\n    }\n\n    private function recordFailure(int $runId, int $orderId, int $version, Throwable $exception, ?string $businessKey=null): void\n    {\n        try {\n            $key=$businessKey??('order:'.$orderId);\n            $attempt=(int)$this->db->fetchValue(\"SELECT COALESCE(MAX(attempt_no),0)+1 FROM scheduled_job_failures WHERE job_name=:job AND business_key=:key AND business_version=:version\",['job'=>self::JOB,'key'=>$key,'version'=>max(1,$version)]);\n            $attempt=max(1,$attempt);\n            $minutes=min(1440,max(1,1<<min(10,max(0,$attempt-1))));\n            $this->db->execute(\n                \"INSERT INTO scheduled_job_failures(job_name,business_key,business_version,scheduler_run_id,attempt_no,error_class,error_message,next_retry_at,created_at) VALUES(:job,:key,:version,:run_id,:attempt,:error_class,:error_message,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$minutes} MINUTE),UTC_TIMESTAMP())\",\n                ['job'=>self::JOB,'key'=>substr($key,0,128),'version'=>max(1,$version),'run_id'=>$runId,'attempt'=>$attempt,'error_class'=>substr(get_class($exception),0,160),'error_message'=>mb_substr($exception->getMessage(),0,2000)]\n            );\n        } catch (Throwable $ignored) {}\n    }\n\n    private function uuidV4(): string\n    {\n        $data=random_bytes(16);\n        $data[6]=chr((ord($data[6])&0x0f)|0x40);\n        $data[8]=chr((ord($data[8])&0x3f)|0x80);\n        return vsprintf('%s%s-%s-%s-%s-%s%s%s',str_split(bin2hex($data),4));\n    }\n}\n","server/app/Infrastructure/Settings/GlobalSettingsProvider.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Settings;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\n\n/**\n * 兼容现有 setting() 的基础设施适配器。\n */\nfinal class GlobalSettingsProvider implements SettingsProvider\n{\n    public function get(string $key, $default = null)\n    {\n        return \\setting($key, $default);\n    }\n\n    public function bool(string $key, bool $default = false): bool\n    {\n        $value = $this->get($key, $default);\n        if (is_bool($value)) {\n            return $value;\n        }\n        $filtered = filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE);\n        return $filtered === null ? $default : $filtered;\n    }\n\n    public function int(string $key, int $default = 0): int\n    {\n        $value = $this->get($key, $default);\n        return is_numeric($value) ? (int) $value : $default;\n    }\n}\n","server/app/Infrastructure/Testing/DatabaseTestCenterChatActionRunner.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Testing;\n\nuse WorkerAdmin\\Contracts\\TestCenterActionRunner;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Testing\\TestCenterException;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\n\n/** Export an allowlisted fixture from the EXISTING instance, never a real identity or provider credential. */\nfinal class DatabaseTestCenterChatActionRunner implements TestCenterActionRunner\n{\n    public const ACTION='chat_fixture_export';\n    public const IMPORT='chat_result_import';\n    public const SUITES=[\n        'recovery'=>'双游标、进程重启与撤权恢复',\n        'media'=>'1/2/4/9 图、部分失败与共享对象',\n        'governance'=>'抽检、禁聊、举报与申诉',\n        'reminders'=>'任务重放、已读/撤权与渠道故障',\n        'retention'=>'留存、清理与安全恢复',\n    ];\n    private Database $db;\n    private TestCenterActionRunner $inner;\n    private TestingActionExecution $execution;\n    public function __construct(Database $db,TestCenterActionRunner $inner)\n    {$this->db=$db;$this->inner=$inner;$this->execution=new TestingActionExecution($db);}\n\n    public function available(string $id): array\n    {\n        $result=$this->inner->available($id);\n        if(!TestingEnvironmentPolicy::active())return$result;\n        [$instance,$order]=$this->execution->context($id);\n        if(!$order||$instance['build_status']!=='built'||!empty($instance['archived_at'])||!empty($instance['deleted_at']))return$result;\n        $result['items'][self::ACTION]=['key'=>self::ACTION,'label'=>'准备隔离聊天回归',\n            'description'=>'从本实例导出无身份凭证的夹具，复用独立 MySQL/Redis 回归；准备成功不代表回归通过，不调用真实消息渠道。',\n            'suites'=>self::SUITES];\n        if(preg_match('/^[a-f0-9]{40}$/D',(string)\\app_config('chat.test_report_revision',''))===1){\n            $result['items'][self::IMPORT]=['key'=>self::IMPORT,'label'=>'登记隔离聊天回归结果',\n                'description'=>'校验回归工具的签名、当前实例夹具及指定源码版本，分别记录回归通过或失败；不代表真机、主机或真实渠道验收。'];\n        }\n        return$result;\n    }\n    public function run(string $id,string $action,array $input,int $adminId,string $request): array\n    {\n        if($action===self::IMPORT)return$this->importReport($id,(string)($input['chat_report']??''),$adminId,$request);\n        if($action!==self::ACTION)return$this->inner->run($id,$action,$input,$adminId,$request);\n        $suite=(string)($input['chat_suite']??'');\n        if(!isset(self::SUITES[$suite]))throw new TestCenterException('请选择聊天回归场景。','TEST_CHAT_SUITE_INVALID',422);\n        $result=$this->execution->run($id,$action,['suite'=>$suite],$adminId,$request,'system','isolated_fixture',\n            function(array $instance,array $order,array $command):array {\n                // Re-read under the existing instance execution boundary. Production orders never qualify.\n                $fixture=self::fixture($instance,$order,(string)$command['suite']);\n                return ['status'=>'fixture_ready','tests_executed'=>false,'external_delivery_executed'=>false,\n                    'fixture_sha256'=>hash('sha256',self::encode($fixture)),'fixture'=>$fixture];\n            });\n        $result['operation_mode']='isolated_fixture';return$result;\n    }\n\n    private function importReport(string $id,string $raw,int $adminId,string $request): array\n    {\n        if(!TestingEnvironmentPolicy::active())throw new TestCenterException('回归登记仅允许测试环境。','TEST_ACTION_PRODUCTION_BLOCKED',403);\n        if(strlen($raw)>65536)throw new TestCenterException('回归结果过大。','TEST_CHAT_REPORT_INVALID',422);\n        $envelope=json_decode($raw,true);\n        if(!is_array($envelope)||count($envelope)!==2||!is_string($envelope['payload']??null)||!is_string($envelope['mac']??null))throw new TestCenterException('回归结果格式无效。','TEST_CHAT_REPORT_INVALID',422);\n        $encoded=(string)\\getenv((string)\\app_config('chat.test_report_key_env','CHAT_TEST_REPORT_KEY'));\n        $key=base64_decode($encoded,true);$payload=base64_decode($envelope['payload'],true);\n        if(!is_string($key)||strlen($key)!==32||base64_encode($key)!==$encoded||!is_string($payload)||base64_encode($payload)!==$envelope['payload']\n            ||!hash_equals(hash_hmac('sha256',$payload,$key),$envelope['mac']))throw new TestCenterException('回归结果签名不匹配。','TEST_CHAT_REPORT_SIGNATURE',422);\n        $report=json_decode($payload,true);$expected=(string)\\app_config('chat.test_report_revision','');\n        $fields=['schema','instance','suite','fixture_sha256','status','tests','failed','skipped','simulated_provider','real_channel','go_version','source_sha256','source_revision'];\n        if(!is_array($report)||array_diff(array_keys($report),$fields)||array_diff($fields,array_keys($report))\n            ||$report['schema']!==1||$report['instance']!==$id||!isset(self::SUITES[$report['suite']??''])\n            ||$report['simulated_provider']!==true||$report['real_channel']!==false||$report['go_version']!=='go1.27.3'\n            ||preg_match('/^[a-f0-9]{40}$/D',$expected)!==1||$report['source_revision']!==$expected\n            ||preg_match('/^[a-f0-9]{64}$/D',(string)$report['source_sha256'])!==1\n            ||!in_array($report['status'],['passed','failed'],true))throw new TestCenterException('实例、源码或回归范围不匹配。','TEST_CHAT_REPORT_BINDING',409);\n        foreach(['tests','failed','skipped'] as $list){\n            if(!is_array($report[$list])||count($report[$list])>500)throw new TestCenterException('回归条目无效。','TEST_CHAT_REPORT_INVALID',422);\n            foreach($report[$list] as $test)if(!is_string($test)||preg_match('#^Test[A-Za-z0-9_./:-]{1,199}$#D',$test)!==1)throw new TestCenterException('回归条目无效。','TEST_CHAT_REPORT_INVALID',422);\n        }\n        if($report['status']==='passed'&&(!$report['tests']||$report['failed']||$report['skipped']))throw new TestCenterException('通过结果存在缺项。','TEST_CHAT_REPORT_INCOMPLETE',409);\n        [$instance,$order]=$this->execution->context($id);\n        $fixture=self::fixture($instance,(array)$order,$report['suite']);$digest=hash('sha256',self::encode($fixture));\n        if(!hash_equals($digest,(string)$report['fixture_sha256']))throw new TestCenterException('实例夹具已经变化。','TEST_CHAT_REPORT_BINDING',409);\n        $prepared=false;\n        foreach($this->db->fetchAll(\"SELECT after_summary_json FROM test_runs WHERE instance_id=:instance AND action_key='chat_fixture_export' AND result='passed' ORDER BY id DESC LIMIT 20\",['instance'=>(int)$instance['id']]) as $row){\n            $summary=json_decode((string)$row['after_summary_json'],true);\n            if(hash_equals($digest,(string)($summary['business']['fixture_sha256']??'')))$prepared=true;\n        }\n        if(!$prepared)throw new TestCenterException('请先为当前实例准备同一回归夹具。','TEST_CHAT_FIXTURE_REQUIRED',409);\n        $result=$this->execution->run($id,self::IMPORT,['report_sha256'=>hash('sha256',$payload)],$adminId,$request,'system','isolated_regression',\n            static fn(array $i,array $o,array $command):array=>['status'=>$report['status']==='passed'?'regression_passed':'regression_failed','tests_executed'=>true,'real_channel'=>false,'report'=>$report]);\n        $result['operation_mode']='isolated_regression';$result['regression_passed']=$report['status']==='passed';\n        if(!$result['regression_passed']){\n            $this->db->execute(\"UPDATE test_runs SET result='failed',error_code='TEST_CHAT_REGRESSION_FAILED',error_message='隔离聊天回归未通过，请查看签名结果。' WHERE BINARY public_id=BINARY :id\",['id'=>$result['run_public_id']]);\n            $result['result']='failed';\n        }\n        return$result;\n    }\n\n    /** A schema shared with chat/scripts/test-center.py. No source IDs, names, addresses, tokens or content. */\n    public static function fixture(array $instance,array $order,string $suite): array\n    {\n        $id=(string)($instance['public_id']??'');\n        $profile=(string)($order['workflow_profile']??'construction');\n        $source=(string)($order['order_source_type']??'consumer');\n        $dispatch=(string)($order['dispatch_mode']??'multi_quote');\n        if(!isset(self::SUITES[$suite])||preg_match('/^[A-Za-z0-9_-]{1,96}$/D',$id)!==1\n            ||(int)($order['is_demo']??0)!==1\n            ||(string)($instance['order_no_snapshot']??'')!==(string)($order['public_no']??'')\n            ||strpos((string)($order['public_no']??''),'BXDEMOHALL')===0\n            ||!in_array($profile,['construction','measurement'],true)||!in_array($source,['consumer','platform'],true)\n            ||!in_array($dispatch,['multi_quote','single_grab'],true)){\n            throw new TestCenterException('夹具必须来自当前测试实例。','TEST_CHAT_INSTANCE_BOUNDARY',403);\n        }\n        return ['schema'=>1,'instance'=>$id,'suite'=>$suite,'environment'=>'test','provider'=>'simulated',\n            'order'=>['workflow'=>$profile,'source'=>$source,'dispatch'=>$dispatch],\n            'actors'=>['worker','customer','platform_staff'],'image_counts'=>[1,2,4,9]];\n    }\n    private static function encode(array $value): string\n    {return(string)json_encode($value,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);}\n}\n","server/app/Infrastructure/Testing/TestMessageProjectionRecorder.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Testing;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionCatalog;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\n\n/**\n * 测试订单消息投影记录器。\n *\n * 只记录“本来会尝试什么渠道”的测试证据，不写真实 message_outbox，\n * 不读取/保存手机号、OpenID、Webhook 等敏感投递地址。\n */\nfinal class TestMessageProjectionRecorder\n{\n    public static function capture(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters): void\n    {\n        if(!TestingEnvironmentPolicy::active()||!$db->tableExists('test_message_outbox'))return;\n        $instanceId=self::resolveInstanceId($db,$orderId);\n        if($instanceId<1)return;\n\n        $meta=MessageEventCatalog::get($eventType)??[];\n        foreach((array)($definition['recipients']??[]) as $recipientType){\n            if(!in_array($recipientType,['user','worker'],true))continue;\n            $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n            if($recipientId<1)continue;\n            $inappEnabled=self::eventEnabled('notification.internal_event_switches','inapp',$eventType);\n            self::record($db,$instanceId,$orderId,$eventKey,$eventType,'in_app',$recipientType,$recipientId,\n                $inappEnabled?'delivered':'config_disabled',$inappEnabled?'notification_created_or_deduplicated':'event_switch_disabled',\n                (string)($definition['scene']??''),[\n                    'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                    'amount'=>(string)($parameters['amount']??''),'delivery_mode'=>'internal',\n                ]);\n        }\n\n        self::captureSubscription($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$meta);\n        self::captureSms($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$meta);\n        self::captureWecom($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$parameters,$meta);\n    }\n\n    private static function captureSubscription(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,array $meta): void\n    {\n        $sceneKey=trim((string)($meta['subscription_scene']??''));\n        if($sceneKey==='')return;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();\n        $scene=$scenes[$sceneKey]??null;\n        $recipientType=is_array($scene)?(string)($scene['recipient']??'user'):'user';\n        if(!in_array($recipientType,(array)($definition['recipients']??[]),true))return;\n        $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n        if($recipientId<1)return;\n        $available=is_array($scene)&&!empty($scene['available'])&&!empty($scene['field_map']);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wechat_subscribe',$recipientType,$recipientId,\n            $available?'demo_suppressed':'config_disabled',\n            $available?'demo_order_external_delivery_suppressed':(string)($scene['availability_reason']??'scene_unavailable'),\n            $sceneKey,[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'subscription_type'=>(string)($scene['subscription_type']??''),'eligibility'=>'quota_and_authorization_not_consumed',\n            ]);\n\n        if($recipientType==='worker'||!in_array('worker',(array)($definition['recipients']??[]),true)||(int)($order['assigned_worker_id']??0)<1)return;\n        $important=((string)($meta['priority']??'normal')==='important')||$eventType==='worker_assigned';\n        if(!$important)return;\n        $supplement=$scenes['worker_order_update']??null;\n        $supplementAvailable=is_array($supplement)&&!empty($supplement['available'])&&!empty($supplement['field_map']);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wechat_subscribe','worker',(int)$order['assigned_worker_id'],\n            $supplementAvailable?'demo_suppressed':'config_disabled',\n            $supplementAvailable?'demo_order_external_delivery_suppressed':(string)($supplement['availability_reason']??'scene_unavailable'),\n            'worker_order_update',[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'supplement'=>true,'eligibility'=>'quota_and_authorization_not_consumed',\n            ]);\n    }\n\n    private static function captureSms(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,array $meta): void\n    {\n        if(empty($meta['sms_visible']))return;\n        $enabled=\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('sms.event_switches','sms',$eventType);\n        $templates=\\setting('sms.template_codes',[]);\n        $configured=is_array($templates)?($templates[(string)($definition['scene']??'')]??''):'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        $deliveryMode=(string)($meta['sms_delivery_mode']??'independent');\n        if(!$enabled||$templateCode===''){\n            $status='config_disabled';\n            $reason=$enabled?'template_missing':'channel_or_event_disabled';\n        }elseif($deliveryMode==='subscription_fallback'){\n            $status='not_run';\n            $reason='subscription_fallback_not_triggered_in_demo';\n        }else{\n            $status='demo_suppressed';\n            $reason='demo_order_external_delivery_suppressed';\n        }\n        foreach((array)($definition['recipients']??[]) as $recipientType){\n            if(!in_array($recipientType,['user','worker'],true))continue;\n            $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n            if($recipientId<1)continue;\n            self::record($db,$instanceId,$orderId,$eventKey,$eventType,'aliyun_sms',$recipientType,$recipientId,$status,$reason,(string)($definition['scene']??''),[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'delivery_mode'=>$deliveryMode,'template_configured'=>$templateCode!=='',\n            ]);\n        }\n    }\n\n    private static function captureWecom(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $parameters,array $meta): void\n    {\n        if(!in_array('admin',(array)($definition['recipients']??[]),true)||empty($meta['wecom_visible']))return;\n        $enabled=\\filter_var(\\setting('wecom.webhook_enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('wecom.event_switches','wecom',$eventType);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wecom_webhook','admin',0,\n            $enabled?'demo_suppressed':'config_disabled',$enabled?'demo_order_external_delivery_suppressed':'channel_or_event_disabled',\n            (string)($definition['scene']??''),[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n            ]);\n    }\n\n    private static function resolveInstanceId(Database $db,int $orderId): int\n    {\n        $direct=(int)$db->fetchValue(\"SELECT ti.id FROM test_instances ti JOIN orders o ON o.id=ti.order_id WHERE ti.order_id=:id AND o.is_demo=1 AND ti.deleted_at IS NULL LIMIT 1\",['id'=>$orderId]);\n        if($direct>0)return $direct;\n        if(!$db->tableExists('order_relations'))return 0;\n        return(int)$db->fetchValue(\"SELECT ti.id FROM order_relations r JOIN test_instances ti ON ti.order_id=r.parent_order_id JOIN orders child_order ON child_order.id=r.child_order_id WHERE r.child_order_id=:id AND r.relation_type='measurement_construction' AND r.status='active' AND child_order.is_demo=1 AND ti.deleted_at IS NULL LIMIT 1\",['id'=>$orderId]);\n    }\n\n    private static function eventEnabled(string $settingKey,string $channel,string $eventType): bool\n    {\n        $configured=\\setting($settingKey,[]);\n        return MessageEventCatalog::enabled($channel,$eventType,is_array($configured)?$configured:[]);\n    }\n\n    private static function record(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,string $channel,string $recipientType,int $recipientId,string $status,string $reason,string $sceneKey,array $payload): void\n    {\n        $businessIdentity=$eventKey.':'.$channel.':'.$recipientType.':'.$recipientId.':'.$sceneKey;\n        // Keep long event keys distinct: a raw 190-byte prefix can silently collide under INSERT IGNORE.\n        $businessKey=strlen($businessIdentity)<=190?$businessIdentity:substr($businessIdentity,0,125).':'.hash('sha256',$businessIdentity);\n        $db->execute(\"INSERT IGNORE INTO test_message_outbox(instance_id,order_id,business_key,event_key,event_type,channel,recipient_type,recipient_id,scene_key,projection_status,reason_code,payload_json,created_at) VALUES(:instance,:order_id,:business_key,:event_key,:event_type,:channel,:recipient_type,:recipient_id,:scene_key,:status,:reason,:payload,UTC_TIMESTAMP())\",[\n            'instance'=>$instanceId,'order_id'=>$orderId,'business_key'=>$businessKey,'event_key'=>substr($eventKey,0,160),\n            'event_type'=>substr($eventType,0,120),'channel'=>$channel,'recipient_type'=>$recipientType,'recipient_id'=>$recipientId>0?$recipientId:null,\n            'scene_key'=>substr($sceneKey,0,80),'status'=>$status,'reason'=>substr($reason,0,120),\n            'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n        ]);\n    }\n}\n","server/app/Infrastructure/Testing/TestingActionExecution.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Testing;\n\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Testing\\TestCenterException;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\n\n/** 受控测试命令的持久化请求键、审计与实例边界。回调只能由服务端白名单适配器装配。 */\nfinal class TestingActionExecution\n{\n    private Database $db;\n    public function __construct(Database $db){$this->db=$db;}\n    public function context(string $publicId): array\n    {\n        $i=$this->db->fetch('SELECT * FROM test_instances WHERE BINARY public_id=BINARY :public LIMIT 1',['public'=>trim($publicId)]);\n        if(!$i)throw new TestCenterException('测试实例不存在。','TEST_INSTANCE_NOT_FOUND',404);\n        $o=!empty($i['order_id'])?$this->db->fetch('SELECT * FROM orders WHERE id=:id',['id'=>(int)$i['order_id']]):null;\n        if($o&&((int)$o['is_demo']!==1||(string)$o['public_no']!==(string)$i['order_no_snapshot']||strpos((string)$o['public_no'],'BXDEMOHALL')===0))throw new TestCenterException('订单不属于当前测试实例。','TEST_ACTION_ORDER_BOUNDARY',403);\n        return[$i,$o];\n    }\n    public function run(string $publicId,string $action,array $command,int $adminId,string $request,string $role,string $mode,callable $execute): array\n    {\n        if(!TestingEnvironmentPolicy::active())throw new TestCenterException('测试动作仅允许 testing 环境。','TEST_ACTION_PRODUCTION_BLOCKED',403);\n        if($adminId<1)throw new TestCenterException('管理员身份无效。','TEST_ADMIN_REQUIRED',403);\n        if(preg_match('/^[A-Za-z0-9._:-]{1,96}$/D',$request)!==1)throw new TestCenterException('动作请求键无效。','TEST_ACTION_REQUEST_KEY_INVALID',422);\n        [$i,$o]=$this->context($publicId);\n        $digest=hash('sha256',$this->json(['action'=>$action,'order'=>(int)($o['id']??0),'command'=>$command]));\n        $prior=$this->db->fetch('SELECT * FROM test_runs WHERE instance_id=:instance AND BINARY idempotency_key=BINARY :key LIMIT 1',['instance'=>(int)$i['id'],'key'=>$request]);\n        if($prior){\n            if(!hash_equals((string)$prior['request_digest'],$digest))throw new TestCenterException('相同请求键对应的动作或参数已经变化。','TEST_ACTION_IDEMPOTENCY_CONFLICT',409);\n            if($prior['result']==='passed')return['replayed'=>true,'result'=>'passed','run_public_id'=>$prior['public_id'],'after'=>json_decode((string)$prior['after_summary_json'],true)];\n            throw new TestCenterException((string)($prior['error_message']?:'动作正在执行或已失败，请查看原运行记录。'),(string)($prior['error_code']?:'TEST_ACTION_RUNNING'),409);\n        }\n        if(!$o||$i['build_status']!=='built'||!empty($i['archived_at'])||!empty($i['deleted_at']))throw new TestCenterException('测试实例当前不可写。','TEST_ACTION_INSTANCE_NOT_WRITABLE',409);\n        $public=\\public_id();$started=microtime(true);\n        $run=$this->db->insert(\"INSERT INTO test_runs(public_id,instance_id,action_key,actor_role,operation_mode,idempotency_key,request_digest,request_id,before_summary_json,result,created_by_admin_id,started_at,created_at) VALUES(:public,:instance,:action,:role,:mode,:key,:digest,:request,:before,'running',:admin,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>$public,'instance'=>(int)$i['id'],'action'=>$action,'role'=>$role,'mode'=>$mode,'key'=>$request,'digest'=>$digest,'request'=>\\request_id(),'before'=>$this->json(['order'=>$o]),'admin'=>$adminId]);\n        try{\n            $business=$execute($i,$o,$command);\n            $after=['business'=>$business,'order'=>$this->db->fetch('SELECT * FROM orders WHERE id=:id',['id'=>(int)$o['id']])];\n            $this->finish($run,$started,'passed',$after,null,null);\n            $this->db->execute(\"UPDATE test_instances SET verification_status='pending',version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id\",['id'=>(int)$i['id']]);\n            return['replayed'=>false,'result'=>'passed','run_public_id'=>$public,'business'=>$business,'after'=>$after];\n        }catch(Throwable $e){\n            $code=$e instanceof OrderOperationException?$e->apiCode():($e instanceof TestCenterException?$e->businessCode():'TEST_ACTION_FAILED');\n            $this->finish($run,$started,'failed',['order'=>$this->db->fetch('SELECT * FROM orders WHERE id=:id',['id'=>(int)$o['id']])],$code,$e->getMessage());\n            if($e instanceof TestCenterException)throw$e;\n            $status=$e instanceof OrderOperationException?(int)$e->getCode():500;\n            throw new TestCenterException($e instanceof OrderOperationException?$e->getMessage():'测试动作失败，请查看运行记录。',$code,$status>=400&&$status<=599?$status:409,['run_public_id'=>$public]);\n        }\n    }\n    private function finish(int $id,float $started,string $status,array $after,?string $code,?string $message): void\n    {\n        $this->db->execute('UPDATE test_runs SET result=:status,after_summary_json=:after,error_code=:code,error_message=:message,duration_ms=:duration,finished_at=UTC_TIMESTAMP() WHERE id=:id',['status'=>$status,'after'=>$this->json($after),'code'=>$code,'message'=>$message===null?null:mb_substr($message,0,1000),'duration'=>(int)round((microtime(true)-$started)*1000),'id'=>$id]);\n    }\n    private function json(array $value): string{return(string)json_encode($value,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);}\n}\n","server/app/Services/ImageOptimizerService.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nuse RuntimeException;\n\n/**\n * 服务器 API 图片统一处理器。\n *\n * 策略：先保留原格式并尝试无损优化；只有超过长边或最终容量限制时才缩放。\n * 缩放时不降低编码质量，避免原来“所有图片转 JPEG、质量逐级降到 72”的清晰度损失。\n * 旧云开发图片导入有独立历史兼容链路，故不由本服务接管。\n */\nfinal class ImageOptimizerService\n{\n    /**\n     * @return array{path:string,storage_key:string,mime_type:string,extension:string,size_bytes:int,width_px:int,height_px:int,sha256:string,compression_quality:?int,method:string}\n     */\n    public function optimize(string $sourcePath): array\n    {\n        if (!is_file($sourcePath) || !is_readable($sourcePath)) {\n            throw new RuntimeException('待处理的图片不存在或不可读。');\n        }\n        $info = @getimagesize($sourcePath);\n        if (!is_array($info) || empty($info[0]) || empty($info[1])) {\n            throw new RuntimeException('仅支持有效的 JPG、PNG、WEBP 图片。');\n        }\n        $mime = strtolower((string) ($info['mime'] ?? ''));\n        $extensions = ['image/jpeg' => 'jpg', 'image/png' => 'png', 'image/webp' => 'webp'];\n        if (!isset($extensions[$mime])) {\n            throw new RuntimeException('仅支持 JPG、PNG、WEBP 图片。');\n        }\n\n        $width = (int) $info[0];\n        $height = (int) $info[1];\n        $maxEdge = max(800, min(2400, (int) \\setting('media.max_long_edge_px', 1600)));\n        $maxBytes = max(10240, min(20 * 1024 * 1024, (int) \\setting('media.max_file_bytes', 1048576)));\n        $folder = 'uploads/' . gmdate('Y/m');\n        $directory = \\base_path('storage/private/' . $folder);\n        if (!is_dir($directory) && !@mkdir($directory, 0775, true) && !is_dir($directory)) {\n            throw new RuntimeException('服务器图片目录不可写。');\n        }\n\n        $name = bin2hex(random_bytes(16)) . '.' . $extensions[$mime];\n        $path = $directory . DIRECTORY_SEPARATOR . $name;\n        $method = 'original';\n        $quality = null;\n        try {\n            if (!@copy($sourcePath, $path)) {\n                throw new RuntimeException('图片暂存失败。');\n            }\n            $losslessTool = $this->runLosslessOptimizer($path, $mime);\n            if ($losslessTool !== '') {\n                $method = 'lossless-' . $losslessTool;\n            }\n\n            $currentSize = is_file($path) ? (int) filesize($path) : 0;\n            if (max($width, $height) > $maxEdge || $currentSize > $maxBytes) {\n                if (!function_exists('imagecreatetruecolor')) {\n                    throw new RuntimeException('图片需要缩放，但服务器未安装 GD 图片扩展。');\n                }\n                [$width, $height] = $this->resizeUntilWithinLimit($path, $mime, $width, $height, $maxEdge, $maxBytes);\n                $method = 'resize-quality-100' . ($losslessTool !== '' ? '-after-lossless' : '');\n                $quality = 100;\n            }\n\n            $size = is_file($path) ? (int) filesize($path) : 0;\n            if ($size < 1 || $size > $maxBytes) {\n                throw new RuntimeException('图片无损优化或必要缩放后仍超过服务器容量限制，请裁剪后重新上传。');\n            }\n            $sha = hash_file('sha256', $path);\n            if (!is_string($sha) || $sha === '') {\n                throw new RuntimeException('图片摘要生成失败。');\n            }\n            return [\n                'path' => $path,\n                'storage_key' => $folder . '/' . $name,\n                'mime_type' => $mime,\n                'extension' => $extensions[$mime],\n                'size_bytes' => $size,\n                'width_px' => $width,\n                'height_px' => $height,\n                'sha256' => $sha,\n                'compression_quality' => $quality,\n                'method' => $method,\n            ];\n        } catch (\\Throwable $exception) {\n            if (is_file($path)) @unlink($path);\n            throw $exception;\n        }\n    }\n\n    /**\n     * 使用固定命令调用服务器上已安装的无损工具。命令名不来自用户输入。\n     * 返回空字符串表示工具未安装，调用方继续保留原始文件格式和字节内容。\n     */\n    private function runLosslessOptimizer(string $path, string $mime): string\n    {\n        // 服务器可能出于安全策略禁用 proc_open；无损工具属于可选优化，禁用时安全回退到原格式。\n        if (!function_exists('proc_open')) return '';\n        $commands = [];\n        if ($mime === 'image/jpeg') {\n            $commands = [\n                ['name' => 'jpegoptim', 'command' => 'jpegoptim --strip-all --all-progressive --quiet ' . escapeshellarg($path)],\n            ];\n        } elseif ($mime === 'image/png') {\n            $commands = [\n                ['name' => 'oxipng', 'command' => 'oxipng -o 4 --strip safe --quiet ' . escapeshellarg($path)],\n                ['name' => 'optipng', 'command' => 'optipng -o7 -strip all -quiet ' . escapeshellarg($path)],\n            ];\n        } elseif ($mime === 'image/webp') {\n            // cwebp 必须输出到临时文件，成功后再原子替换，避免输入输出同路径导致原图损坏。\n            $temporary = $path . '.lossless.webp';\n            $commands = [\n                ['name' => 'cwebp-lossless', 'command' => 'cwebp -lossless -quiet ' . escapeshellarg($path) . ' -o ' . escapeshellarg($temporary), 'temporary_path' => $temporary],\n            ];\n        }\n        foreach ($commands as $item) {\n            $temporary = (string) ($item['temporary_path'] ?? '');\n            $pipes = [];\n            $process = @proc_open($item['command'], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);\n            if (!is_resource($process)) {\n                if ($temporary !== '' && is_file($temporary)) @unlink($temporary);\n                continue;\n            }\n            if (isset($pipes[1]) && is_resource($pipes[1])) @fclose($pipes[1]);\n            if (isset($pipes[2]) && is_resource($pipes[2])) @fclose($pipes[2]);\n            $status = proc_close($process);\n            if ($status === 0 && $temporary !== '' && is_file($temporary) && (int) filesize($temporary) > 0) {\n                // WebP 转无损后有可能比原文件更大；只在确实缩小或等大时替换，始终保留更优结果。\n                $originalSize = is_file($path) ? (int) filesize($path) : 0;\n                $optimizedSize = (int) filesize($temporary);\n                if ($originalSize > 0 && $optimizedSize <= $originalSize && @rename($temporary, $path) && is_file($path) && (int) filesize($path) > 0) return (string) $item['name'];\n            }\n            if ($temporary !== '' && is_file($temporary)) @unlink($temporary);\n            if ($status === 0 && $temporary === '' && is_file($path) && (int) filesize($path) > 0) return (string) $item['name'];\n        }\n        return '';\n    }\n\n    /** @return array{0:int,1:int} */\n    private function resizeUntilWithinLimit(string $path, string $mime, int $sourceWidth, int $sourceHeight, int $maxEdge, int $maxBytes): array\n    {\n        $scale = min(1.0, $maxEdge / max($sourceWidth, $sourceHeight));\n        $minimumEdge = 640;\n        $lastWidth = max(1, (int) round($sourceWidth * $scale));\n        $lastHeight = max(1, (int) round($sourceHeight * $scale));\n        for ($attempt = 0; $attempt < 10; $attempt++) {\n            $lastWidth = max(1, (int) round($sourceWidth * $scale));\n            $lastHeight = max(1, (int) round($sourceHeight * $scale));\n            $this->resizeOne($path, $mime, $lastWidth, $lastHeight);\n            $this->runLosslessOptimizer($path, $mime);\n            if (is_file($path) && (int) filesize($path) <= $maxBytes) return [$lastWidth, $lastHeight];\n            if (max($lastWidth, $lastHeight) <= $minimumEdge) break;\n            $scale *= 0.82;\n        }\n        throw new RuntimeException('图片必要缩放后仍超过服务器容量限制，请裁剪后重新上传。');\n    }\n\n    private function resizeOne(string $path, string $mime, int $width, int $height): void\n    {\n        $source = @imagecreatefromstring((string) @file_get_contents($path));\n        if (!$source) throw new RuntimeException('图片解码失败，无法完成必要缩放。');\n        $sourceWidth = imagesx($source);\n        $sourceHeight = imagesy($source);\n        $canvas = imagecreatetruecolor($width, $height);\n        if (!$canvas) {\n            imagedestroy($source);\n            throw new RuntimeException('图片缩放画布创建失败。');\n        }\n        if ($mime === 'image/jpeg') {\n            $background = imagecolorallocate($canvas, 255, 255, 255);\n            imagefill($canvas, 0, 0, $background);\n        } else {\n            imagealphablending($canvas, false);\n            imagesavealpha($canvas, true);\n            $transparent = imagecolorallocatealpha($canvas, 0, 0, 0, 127);\n            imagefill($canvas, 0, 0, $transparent);\n        }\n        imagecopyresampled($canvas, $source, 0, 0, 0, 0, $width, $height, $sourceWidth, $sourceHeight);\n        if ($mime === 'image/jpeg') {\n            $saved = imagejpeg($canvas, $path, 100);\n        } elseif ($mime === 'image/png') {\n            $saved = imagepng($canvas, $path, 9);\n        } else {\n            $saved = function_exists('imagewebp') && imagewebp($canvas, $path, 100);\n        }\n        imagedestroy($source);\n        imagedestroy($canvas);\n        if (!$saved || !is_file($path)) throw new RuntimeException('图片缩放保存失败。');\n    }\n}\n","server/app/Services/MessageEventCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nrequire_once __DIR__.'/../Domain/Messaging/MessageEventCatalog.php';\n\nfinal class MessageEventCatalog\n{\n\n    public static function all(): array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::all(); }\n    public static function get(string $eventType): ?array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::get($eventType); }\n    public static function switches(string $channel, array $configured): array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::switches($channel,$configured); }\n    public static function enabled(string $channel, string $eventType, array $configured): bool { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::enabled($channel,$eventType,$configured); }\n}\n","server/app/Services/OrderNotificationService.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionQuotaStore;\nuse WorkerAdmin\\Infrastructure\\Messaging\\OrderSubscriptionQueue;\nuse WorkerAdmin\\Infrastructure\\Messaging\\DatabaseNotificationProducer;\nuse WorkerAdmin\\Infrastructure\\Settings\\GlobalSettingsProvider;\nuse WorkerAdmin\\Application\\Messaging\\OrderNotificationPublisher;\nuse WorkerAdmin\\Application\\Messaging\\SubscriptionTestData;\n\nforeach([\n    'Contracts/NotificationProducer.php',\n    'Contracts/OrderNotificationPort.php',\n    'Contracts/SettingsProvider.php',\n    'Domain/Messaging/MessageEventCatalog.php',\n    'Domain/Messaging/OrderMessageDefinition.php',\n    'Domain/Messaging/WechatTemplateValue.php',\n    'Infrastructure/Messaging/OrderSubscriptionDefinitionOperations.php',\n    'Infrastructure/Messaging/SubscriptionCatalog.php',\n    'Infrastructure/Messaging/SubscriptionQuotaStore.php',\n    'Infrastructure/Messaging/OrderSubscriptionQueue.php',\n    'Infrastructure/Messaging/OrderNotificationProjector.php',\n    'Infrastructure/Messaging/DatabaseNotificationProducer.php',\n    'Infrastructure/Settings/GlobalSettingsProvider.php',\n    'Application/Messaging/OrderNotificationPublisher.php',\n    'Application/Messaging/SubscriptionTestData.php',\n    'Application/Messaging/MessageEventSwitches.php',\n] as $dependency)require_once __DIR__.'/../'.$dependency;\nunset($dependency);\n\nfinal class OrderNotificationService\n{\n    public static function queuePersistedEvent(Database $db, int $orderId, int $eventId, string $eventType, array $payload = []): void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->queuePersistedEvent($orderId,$eventId,$eventType,$payload);\n    }\n\n    public static function queueAdminTask(Database $db,string $eventKey,string $eventType,string $title,array $lines=[]):void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->adminTask($eventKey,$eventType,$title,$lines);\n    }\n\n    public static function queue(Database $db, int $orderId, string $eventKey, string $eventType, array $payload = []): void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->queue($orderId,$eventKey,$eventType,$payload);\n    }\n\n    public static function eventCatalog(): array { return MessageEventCatalog::all(); }\n    public static function eventSwitches(string $channel):array { return (new \\WorkerAdmin\\Application\\Messaging\\MessageEventSwitches(new GlobalSettingsProvider()))->forChannel($channel); }\n    public static function subscriptionPreferences(Database $db, int $userId): array { return SubscriptionQuotaStore::subscriptionPreferences($db,$userId); }\n    public static function saveSubscriptionPreference(Database $db, int $userId, string $sceneKey, bool $enabled, string $authorizationStatus): array { return SubscriptionQuotaStore::saveSubscriptionPreference($db,$userId,$sceneKey,$enabled,$authorizationStatus); }\n    public static function markSubscriptionConsumed(Database $db, int $userId, string $sceneKey): void { SubscriptionQuotaStore::markSubscriptionConsumed($db,$userId,$sceneKey); }\n    public static function markSubscriptionPermissionUnavailable(Database $db, int $userId, string $sceneKey): void { SubscriptionQuotaStore::markSubscriptionPermissionUnavailable($db,$userId,$sceneKey); }\n    public static function queueWorkerWithdrawalResult(Database $db,int $workerId,string $withdrawalNo,string $status,string $note='',int $amountCents=0):void { (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->withdrawalResult($workerId,$withdrawalNo,$status,$note,$amountCents); }\n    public static function queueWorkerReviewResult(Database $db, int $workerId, string $cloudId, string $decision, string $reason, string $workerName=''): void { (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->workerReviewResult($workerId,$cloudId,$decision,$reason,$workerName); }\n    public static function subscriptionTestEventOptions(string $sceneKey):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->subscriptionTestEventOptions($sceneKey); }\n    public static function subscriptionTestSampleValues(string $sceneKey):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->subscriptionTestSampleValues($sceneKey); }\n    public static function buildSubscriptionTestData(string $sceneKey,array $scene):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->buildSubscriptionTestData($sceneKey,$scene,$_POST); }\n    public static function enqueueSmsFallback(Database $db,array $fallback):bool { return OrderSubscriptionQueue::enqueueSmsFallback($db,$fallback); }\n\n    public static function subscriptionSceneDefinitions(): array { return SubscriptionCatalog::subscriptionSceneDefinitions(); }\n    public static function subscriptionSemanticLabels(): array { return SubscriptionCatalog::subscriptionSemanticLabels(); }\n    public static function subscriptionSemanticDescriptions(): array { return SubscriptionCatalog::subscriptionSemanticDescriptions(); }\n    public static function reviewResultFixedTemplateFields(): array { return SubscriptionCatalog::reviewResultFixedTemplateFields(); }\n    public static function subscriptionFixedValuePresets(string $wechatField,string $label=''): array { return SubscriptionCatalog::subscriptionFixedValuePresets($wechatField,$label); }\n    public static function inferSubscriptionTemplateBinding(array $scene,array $actual,array $previous=[]): array { return SubscriptionCatalog::inferSubscriptionTemplateBinding($scene,$actual,$previous); }\n    public static function recommendSubscriptionKeywords(array $scene,array $keywords): array { return SubscriptionCatalog::recommendSubscriptionKeywords($scene,$keywords); }\n}\n","server/app/Support/SqlScriptRunner.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Support;\n\nuse PDO;\nuse PDOStatement;\nuse RuntimeException;\nuse Throwable;\n\n/**\n * 2026-08-14：无 Composer 环境下的 MySQL 脚本解析与执行器。\n */\nfinal class SqlScriptRunner\n{\n    /**\n     * 2026-08-14：读取并执行 SQL 文件，返回可记录到升级历史中的统计数据。\n     *\n     * @return array{file:string,checksum:string,statements:int,execution_ms:int}\n     */\n    public function runFile(PDO $pdo, string $file): array\n    {\n        $realFile = realpath($file);\n        if ($realFile === false || !is_file($realFile) || !is_readable($realFile)) {\n            throw new SqlScriptException('SQL 文件不存在或不可读。');\n        }\n\n        $sql = file_get_contents($realFile);\n        if ($sql === false) {\n            throw new SqlScriptException('SQL 文件读取失败。');\n        }\n\n        $rawChecksum = hash('sha256', $sql);\n        $result = $this->run($pdo, $sql, $realFile);\n        $result['checksum'] = $rawChecksum;\n        return $result;\n    }\n\n    /**\n     * 2026-08-14：执行 SQL 文本；单条失败时给出序号和安全摘要，避免泄露连接信息。\n     *\n     * @return array{file:string,checksum:string,statements:int,execution_ms:int}\n     */\n    public function run(PDO $pdo, string $sql, string $sourceName = 'inline.sql'): array\n    {\n        $sql = $this->removeUtf8Bom($sql);\n        if (trim($sql) === '') {\n            throw new SqlScriptException('SQL 脚本内容为空。');\n        }\n\n        $startedAt = microtime(true);\n        $statements = $this->splitStatements($sql);\n        $executed = 0;\n\n        foreach ($statements as $index => $statement) {\n            if (trim($statement) === '' || !$this->hasExecutableSql($statement)) {\n                continue;\n            }\n\n            try {\n                $this->executeStatement($pdo, $statement);\n                ++$executed;\n            } catch (Throwable $exception) {\n                $number = $index + 1;\n                $summary = $this->statementSummary($statement);\n                throw new SqlScriptException(\n                    sprintf('SQL 第 %d 条执行失败（%s）：%s', $number, $summary, $exception->getMessage()),\n                    0,\n                    $exception\n                );\n            }\n        }\n\n        return [\n            'file' => $sourceName,\n            'checksum' => hash('sha256', $sql),\n            'statements' => $executed,\n            'execution_ms' => (int) round((microtime(true) - $startedAt) * 1000),\n        ];\n    }\n\n    /**\n     * 2026-08-14：按 MySQL 语法状态拆分语句，兼容字符串、注释及 DELIMITER 指令。\n     *\n     * @return string[]\n     */\n    public function splitStatements(string $sql): array\n    {\n        $length = strlen($sql);\n        $delimiter = ';';\n        $buffer = '';\n        $statements = [];\n        $quote = null;\n        $lineComment = false;\n        $blockComment = false;\n        $lineStart = true;\n\n        for ($position = 0; $position < $length; ++$position) {\n            $character = $sql[$position];\n            $next = $position + 1 < $length ? $sql[$position + 1] : '';\n\n            if ($lineComment) {\n                $buffer .= $character;\n                if ($character === \"\\n\") {\n                    $lineComment = false;\n                    $lineStart = true;\n                }\n                continue;\n            }\n\n            if ($blockComment) {\n                $buffer .= $character;\n                if ($character === '*' && $next === '/') {\n                    $buffer .= '/';\n                    ++$position;\n                    $blockComment = false;\n                }\n                continue;\n            }\n\n            if ($quote !== null) {\n                $buffer .= $character;\n                if ($character === '\\\\' && $quote !== '`' && $next !== '') {\n                    $buffer .= $next;\n                    ++$position;\n                    continue;\n                }\n                if ($character === $quote) {\n                    if ($next === $quote) {\n                        $buffer .= $next;\n                        ++$position;\n                    } else {\n                        $quote = null;\n                    }\n                }\n                $lineStart = $character === \"\\n\";\n                continue;\n            }\n\n            if ($lineStart) {\n                $remaining = substr($sql, $position);\n                if (preg_match('/^[ \\t]*DELIMITER[ \\t]+([^\\r\\n]+)[\\r\\n]*/i', $remaining, $match) === 1) {\n                    $newDelimiter = trim($match[1]);\n                    if ($newDelimiter === '') {\n                        throw new SqlScriptException('DELIMITER 指令缺少分隔符。');\n                    }\n                    $delimiter = $newDelimiter;\n                    $position += strlen($match[0]) - 1;\n                    $lineStart = true;\n                    continue;\n                }\n            }\n\n            if ($character === '-' && $next === '-' && $this->isDashComment($sql, $position)) {\n                $buffer .= '--';\n                ++$position;\n                $lineComment = true;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($character === '#') {\n                $buffer .= $character;\n                $lineComment = true;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($character === '/' && $next === '*') {\n                $buffer .= '/*';\n                ++$position;\n                $blockComment = true;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($character === \"'\" || $character === '\"' || $character === '`') {\n                $quote = $character;\n                $buffer .= $character;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($delimiter !== '' && substr($sql, $position, strlen($delimiter)) === $delimiter) {\n                if (trim($buffer) !== '') {\n                    $statements[] = trim($buffer);\n                }\n                $buffer = '';\n                $position += strlen($delimiter) - 1;\n                $lineStart = false;\n                continue;\n            }\n\n            $buffer .= $character;\n            if ($character === \"\\n\" || $character === \"\\r\") {\n                $lineStart = true;\n            } elseif ($character !== ' ' && $character !== \"\\t\") {\n                $lineStart = false;\n            }\n        }\n\n        if ($quote !== null) {\n            throw new SqlScriptException('SQL 脚本包含未闭合的字符串或标识符。');\n        }\n        if ($blockComment) {\n            throw new SqlScriptException('SQL 脚本包含未闭合的块注释。');\n        }\n        if (trim($buffer) !== '') {\n            $statements[] = trim($buffer);\n        }\n\n        return $statements;\n    }\n\n    /**\n     * 2026-08-14：MySQL 的双横线注释要求其后为空白或文件结束。\n     */\n    private function isDashComment(string $sql, int $position): bool\n    {\n        $after = $position + 2;\n        return !isset($sql[$after]) || ctype_space($sql[$after]);\n    }\n\n    /**\n     * 2026-09-24：可能返回结果集的语句统一使用 query，并完整消费全部 rowset。\n     *\n     * MySQL PREPARE/EXECUTE 的 EXECUTE 可能动态执行 SELECT；若错误地交给 PDO::exec()，\n     * mysqlnd 会保留未消费结果，下一条语句即触发 SQLSTATE HY000/2014。\n     */\n    private function executeStatement(PDO $pdo, string $statement): void\n    {\n        $command = preg_replace('/\\A(?:\\s+|--[^\\r\\n]*(?:\\r?\\n|\\z)|#[^\\r\\n]*(?:\\r?\\n|\\z)|\\/\\*(?!\\!)[\\s\\S]*?\\*\\/)*\\s*/', '', $statement);\n        $command = is_string($command) ? $command : $statement;\n        if (preg_match('/^(SELECT|SHOW|DESCRIBE|DESC|EXPLAIN|CALL|EXECUTE)\\b/i', $command) === 1) {\n            $result = $pdo->query($statement);\n            if ($result === false) {\n                throw new SqlScriptException('SQL 查询执行失败且未返回 PDOStatement。');\n            }\n            $this->drainResultSets($result);\n            return;\n        }\n        $pdo->exec($statement);\n    }\n\n    /**\n     * 2026-09-24：消费当前结果集及后续全部 rowset，确保连接可安全执行下一条 SQL。\n     */\n    private function drainResultSets(PDOStatement $statement): void\n    {\n        try {\n            do {\n                if ($statement->columnCount() > 0) {\n                    while ($statement->fetch(PDO::FETCH_NUM) !== false) {\n                        // 升级脚本只关心执行成功与否；结果内容无需保留。\n                    }\n                }\n            } while ($statement->nextRowset());\n        } finally {\n            $statement->closeCursor();\n        }\n    }\n\n    /**\n     * 2026-08-14：跳过文件末尾的纯说明注释，同时保留 MySQL 可执行版本注释。\n     */\n    private function hasExecutableSql(string $statement): bool\n    {\n        $withoutComments = preg_replace(\n            '/--[^\\r\\n]*(?:\\r?\\n|\\z)|#[^\\r\\n]*(?:\\r?\\n|\\z)|\\/\\*(?!\\!)[\\s\\S]*?\\*\\//',\n            '',\n            $statement\n        );\n        return is_string($withoutComments) && trim($withoutComments) !== '';\n    }\n\n    /**\n     * 2026-08-14：去除 UTF-8 BOM，避免第一条语句无法识别。\n     */\n    private function removeUtf8Bom(string $sql): string\n    {\n        return substr($sql, 0, 3) === \"\\xEF\\xBB\\xBF\" ? substr($sql, 3) : $sql;\n    }\n\n    /**\n     * 2026-08-14：错误页面只显示一行有限长度摘要。\n     */\n    private function statementSummary(string $statement): string\n    {\n        $redacted = preg_replace('/\\'(?:\\\\\\\\.|\\'\\'|[^\\'])*\\'/s', \"'…'\", $statement);\n        $redacted = is_string($redacted) ? preg_replace('/\"(?:\\\\\\\\.|\"\"|[^\"])*\"/s', '\"…\"', $redacted) : $statement;\n        $summary = preg_replace('/\\s+/u', ' ', trim(is_string($redacted) ? $redacted : $statement));\n        if (!is_string($summary)) {\n            return '无法生成摘要';\n        }\n        if (function_exists('mb_substr')) {\n            return mb_substr($summary, 0, 120, 'UTF-8');\n        }\n        return substr($summary, 0, 120);\n    }\n}\n\n/**\n * 2026-08-14：为安装器和升级页提供可区分的脚本异常类型。\n */\nfinal class SqlScriptException extends RuntimeException\n{\n}\n","server/app/Support/functions.php":"<?php\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\View;\n\n// 2026-08-14：集中提供后台通用帮助函数，避免页面重复处理配置、转义与安全逻辑。\nfunction base_path($path = '')\n{\n    $base = defined('WORKER_BASE_PATH') ? WORKER_BASE_PATH : dirname(__DIR__, 2);\n    return $path === '' ? $base : $base . DIRECTORY_SEPARATOR . ltrim(str_replace(['/', '\\\\'], DIRECTORY_SEPARATOR, $path), DIRECTORY_SEPARATOR);\n}\n\nfunction app_config($key = null, $default = null)\n{\n    $config = isset($GLOBALS['worker_admin_config']) ? $GLOBALS['worker_admin_config'] : [];\n    if ($key === null || $key === '') {\n        return $config;\n    }\n\n    $value = $config;\n    foreach (explode('.', (string) $key) as $segment) {\n        if (!is_array($value) || !array_key_exists($segment, $value)) {\n            return $default;\n        }\n        $value = $value[$segment];\n    }\n    return $value;\n}\n\nfunction is_installed()\n{\n    return (bool) app_config('installed', false)\n        && is_file(base_path('config/installed.php'))\n        && is_file(base_path('storage/install.lock'));\n}\n\n// 2026-08-14：发布新代码后若配置版本尚未同步，后台仅允许登录并进入升级页，API 与计划任务保持暂停。\nfunction upgrade_required()\n{\n    return !empty($GLOBALS['worker_admin_upgrade_required']);\n}\n\nfunction db()\n{\n    static $database;\n    if (!$database) {\n        $config = (array) app_config('database', []);\n        if (empty($config['database']) && !empty($config['name'])) {\n            $config['database'] = $config['name'];\n        }\n        $database = new Database($config);\n    }\n    return $database;\n}\n\nfunction auth()\n{\n    static $auth;\n    if (!$auth) {\n        $auth = new Auth(db());\n    }\n    return $auth;\n}\n\nfunction csrf()\n{\n    static $csrf;\n    if (!$csrf) {\n        $csrf = new Csrf();\n    }\n    return $csrf;\n}\n\nfunction view($template, array $data = [], $layout = 'layouts/admin')\n{\n    return (new View(base_path('views')))->render($template, $data, $layout);\n}\n\nfunction e($value)\n{\n    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n}\n\nfunction app_url($path = '')\n{\n    $base = rtrim((string) app_config('app.url', ''), '/');\n    if ($base === '' && PHP_SAPI !== 'cli') {\n        $https = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')\n            || (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https');\n        $host = isset($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost';\n        $base = ($https ? 'https://' : 'http://') . $host;\n    }\n    return $base . ($path === '' ? '' : '/' . ltrim($path, '/'));\n}\n\nfunction admin_url($route = 'dashboard', array $params = [])\n{\n    $params = array_merge(['route' => $route], $params);\n    return app_url('admin/?' . http_build_query($params));\n}\n\nfunction asset_url($path)\n{\n    // 后台热修不提升数据库版本时，追加文件指纹刷新 CSS/JS，避免浏览器或 CDN 继续命中旧 2.4.0 静态资源。\n    $version = (string) app_config('app.version', app_config('version', '2.4.0'));\n    $relative = ltrim((string) $path, '/');\n    $assetPath = dirname(__DIR__, 2) . '/assets/' . $relative;\n    $fingerprint = '';\n    if (is_file($assetPath)) {\n        $mtime = @filemtime($assetPath);\n        $size = @filesize($assetPath);\n        if ($mtime !== false && $size !== false) $fingerprint = '-' . (string) $mtime . '-' . (string) $size;\n    }\n    return app_url('assets/' . $relative) . '?v=' . rawurlencode($version . $fingerprint);\n}\n\nfunction redirect($url, $status = 302)\n{\n    header('Location: ' . $url, true, $status);\n    exit;\n}\n\nfunction json_response(array $data, $status = 200)\n{\n    http_response_code((int) $status);\n    header('Content-Type: application/json; charset=utf-8');\n    // 2026-09-22：鉴权 API 可能位于 ESA/CDN 后方；显式禁止浏览器、代理和共享缓存保存或串用敏感响应。\n    header('Cache-Control: no-store, private, max-age=0');\n    header('Surrogate-Control: no-store');\n    header('Pragma: no-cache');\n    header('Expires: 0');\n    header('Vary: Authorization', false);\n    echo json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n    exit;\n}\n\nfunction request_id()\n{\n    static $id;\n    if (!$id) {\n        try {\n            $id = bin2hex(random_bytes(8));\n        } catch (Exception $exception) {\n            $id = str_replace('.', '', uniqid('', true));\n        }\n    }\n    return $id;\n}\n\nfunction request_ip()\n{\n    $ip = isset($_SERVER['REMOTE_ADDR']) ? (string) $_SERVER['REMOTE_ADDR'] : '127.0.0.1';\n    return substr($ip, 0, 45);\n}\n\nfunction write_log($channel, $message)\n{\n    $directory = base_path('storage/logs');\n    if (!is_dir($directory)) {\n        @mkdir($directory, 0775, true);\n    }\n    @file_put_contents($directory . DIRECTORY_SEPARATOR . preg_replace('/[^a-z0-9_-]/i', '', $channel) . '.log', $message, FILE_APPEND | LOCK_EX);\n}\n\nfunction flash($type = null, $message = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return null;\n    }\n    if ($type !== null && $message !== null) {\n        $_SESSION['_flash'][$type][] = (string) $message;\n        return null;\n    }\n    $messages = isset($_SESSION['_flash']) ? $_SESSION['_flash'] : [];\n    unset($_SESSION['_flash']);\n    return $messages;\n}\n\nfunction old_input(array $values = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return [];\n    }\n    if ($values !== null) {\n        $_SESSION['_old_input'] = $values;\n        return [];\n    }\n    $old = isset($_SESSION['_old_input']) ? $_SESSION['_old_input'] : [];\n    unset($_SESSION['_old_input']);\n    return $old;\n}\n\nfunction money($cents)\n{\n    return '¥' . number_format(((int) $cents) / 100, 2);\n}\n\n// 2026-08-14：数据库统一保存 UTC，后台所有可见时间通过此函数转换为站点时区，避免中国管理员看到时间少八小时。\nfunction local_datetime($value, $format = 'Y-m-d H:i')\n{\n    $value = trim((string) $value);\n    if ($value === '' || $value === '0000-00-00 00:00:00') {\n        return '—';\n    }\n    try {\n        $date = new DateTimeImmutable($value, new DateTimeZone('UTC'));\n        return $date->setTimezone(new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai')))->format((string) $format);\n    } catch (Throwable $exception) {\n        return $value;\n    }\n}\n\n// 2026-08-14：生成不含易混淆字符的 26 位公开标识，数据库只暴露该标识而不暴露自增主键。\nfunction public_id()\n{\n    $alphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\n    $bytes = random_bytes(26);\n    $id = '';\n    for ($index = 0; $index < 26; $index++) {\n        $id .= $alphabet[ord($bytes[$index]) & 31];\n    }\n    return $id;\n}\n\n// 2026-08-14：业务单号包含类型、UTC 时间与随机尾号，便于人工检索且避免并发冲突。\nfunction business_no($prefix)\n{\n    return strtoupper(preg_replace('/[^A-Z0-9]/i', '', (string) $prefix))\n        . gmdate('YmdHis')\n        . substr(public_id(), -6);\n}\n\n// 新订单号：BX + 两位类目码 + YYMMDD + '-' + 六位安全随机码。历史订单号保持不变。\n// 生成函数不访问数据库；订单表 public_no 唯一索引与写入端重试负责处理极少数碰撞。\nfunction order_business_no($categoryCode)\n{\n    $code = strtoupper(preg_replace('/[^A-Z]/i', '', (string) $categoryCode));\n    $code = strlen($code) === 2 ? $code : 'QT';\n    $alphabet = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';\n    $suffix = '';\n    for ($i = 0; $i < 6; $i++) {\n        $suffix .= $alphabet[random_int(0, strlen($alphabet) - 1)];\n    }\n    $date = (new DateTimeImmutable('now', new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai'))))->format('ymd');\n    return 'BX' . $code . $date . '-' . $suffix;\n}\n\n// 2026-08-23：后台新增订单和云数据同步统一生成姓名、手机号的最小必要脱敏展示值。\nfunction mask_private_name($value)\n{\n    $value = trim((string) $value);\n    if ($value === '') {\n        return '';\n    }\n    $length = function_exists('mb_strlen') ? mb_strlen($value, 'UTF-8') : strlen($value);\n    $first = function_exists('mb_substr') ? mb_substr($value, 0, 1, 'UTF-8') : substr($value, 0, 1);\n    return $first . str_repeat('*', max(1, min(3, $length - 1)));\n}\n\nfunction mask_private_mobile($value)\n{\n    $digits = preg_replace('/\\D+/', '', (string) $value);\n    if (strlen($digits) < 7) {\n        return $digits === '' ? '' : substr($digits, 0, 2) . '***';\n    }\n    return substr($digits, 0, 3) . str_repeat('*', max(4, strlen($digits) - 7)) . substr($digits, -4);\n}\n\n// 2026-08-23：使用安装时生成的站点密钥加密微信支付、短信、云开发和订单隐私字段。\nfunction encrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if ($value === '') {\n        return null;\n    }\n    $appKey = (string) app_config('app.key', '');\n    if ($appKey === '' || !function_exists('openssl_encrypt')) {\n        throw new RuntimeException('站点加密密钥或 OpenSSL 不可用，无法保存敏感内容。');\n    }\n    $key = hash('sha256', $appKey, true);\n    $nonce = random_bytes(12);\n    $tag = '';\n    $ciphertext = openssl_encrypt($value, 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $nonce, $tag, (string) $context, 16);\n    if (!is_string($ciphertext)) {\n        throw new RuntimeException('敏感内容加密失败。');\n    }\n    return 'enc:v1:' . base64_encode($nonce . $tag . $ciphertext);\n}\n\nfunction decrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if (strpos($value, 'enc:v1:') !== 0) {\n        return $value;\n    }\n    $payload = base64_decode(substr($value, 7), true);\n    $appKey = (string) app_config('app.key', '');\n    if (!is_string($payload) || strlen($payload) < 29 || $appKey === '' || !function_exists('openssl_decrypt')) {\n        return '';\n    }\n    $plaintext = openssl_decrypt(substr($payload, 28), 'aes-256-gcm', hash('sha256', $appKey, true), OPENSSL_RAW_DATA, substr($payload, 0, 12), substr($payload, 12, 16), (string) $context);\n    return is_string($plaintext) ? $plaintext : '';\n}\n\nfunction private_value_hmac($value, $context = 'private')\n{\n    return hash_hmac('sha256', (string) $value, hash('sha256', (string) app_config('app.key', ''), true) . (string) $context);\n}\n\nfunction status_meta($status)\n{\n    $map = [\n        'pending' => ['待处理', 'warning'], 'pending_review' => ['待审核', 'warning'],\n        'approved' => ['已通过', 'success'], 'active' => ['正常', 'success'],\n        'published' => ['已公开', 'info'], 'paid' => ['已支付', 'success'],\n        'completed' => ['已完成', 'success'], 'success' => ['成功', 'success'],\n        'rejected' => ['已驳回', 'danger'], 'cancelled' => ['已取消', 'muted'],\n        'canceled' => ['已取消', 'muted'], 'disabled' => ['已停用', 'muted'],\n        'failed' => ['失败', 'danger'], 'refunding' => ['退款中', 'warning'],\n        'unpaid' => ['未支付', 'muted'], 'processing' => ['处理中', 'info'],\n        'open' => ['处理中', 'warning'], 'resolved' => ['已解决', 'success'],\n        'hidden' => ['已隐藏', 'muted'], 'visible' => ['显示', 'success'],\n        'waiting' => ['等待报价', 'warning'], 'collecting' => ['报价中', 'info'],\n        'offered' => ['待师傅接单', 'warning'], 'accepted' => ['已接受', 'success'],\n        'supplement_required' => ['待补资料', 'warning'], 'suspended' => ['已暂停', 'danger'],\n        'none' => ['无', 'muted'], 'created' => ['已创建', 'warning'],\n        'cancel_approved_pending_refund' => ['已取消待退款', 'warning'],\n        'succeeded' => ['退款成功', 'success'], 'archived' => ['已归档', 'muted'],\n        'draft' => ['草稿', 'warning'], 'payment_failed' => ['付款失败', 'danger'],\n        'claimed' => ['已领取', 'success'], 'revoked' => ['已撤销', 'muted'],\n        'expired' => ['已过期', 'muted'], 'overdue' => ['已逾期', 'danger'],\n        'acknowledged' => ['已知悉', 'info'],\n        'quoting' => ['报价中', 'info'], 'selected' => ['已选报价', 'success'],\n        'unassigned' => ['待安排', 'warning'], 'assigned' => ['已安排', 'info'],\n        'info_released' => ['已开放信息', 'success'], 'not_started' => ['未开始', 'muted'],\n        'scheduled' => ['已预约', 'info'], 'refunded' => ['已退款', 'success'],\n        'awaiting_payment' => ['待付预约费', 'warning'], 'in_progress' => ['施工中', 'info'],\n        'submitted' => ['待验收', 'warning'], 'confirmed' => ['已确认', 'success'],\n        'settled' => ['已抵扣结清', 'success'], 'released' => ['已释放', 'muted'],\n        'deleted' => ['已删除', 'muted'], 'user' => ['用户责任', 'danger'],\n        'worker' => ['师傅责任', 'danger'], 'platform' => ['平台责任', 'warning'],\n        'shared' => ['双方协商', 'info'], 'unclear' => ['责任不清', 'warning'],\n        'undetermined' => ['待判定', 'warning'], 'user_schedule_change' => ['用户行程原因', 'info'],\n        'draft_pending_upload' => ['待上传图片', 'warning'], 'pending_payment' => ['待付款', 'warning'],\n        'selected_pending_payment' => ['已选报价待付款', 'warning'], 'reviewed' => ['已审核', 'success'],\n        'pending_contact_release' => ['待开放联系信息', 'warning'], 'completed_with_delay' => ['完成但尾款延期', 'warning'],\n        'booking_fee' => ['预约费', 'info'], 'commission' => ['平台服务费', 'info'],\n        'cancel_refund' => ['申请退款并取消订单', 'warning'], 'change_rejected' => ['拒绝加价', 'warning'],\n        // 2026-08-28：补齐后台资源列表、支付、派单和通知中可能出现的枚举中文名。\n        'closed' => ['已关闭', 'muted'], 'requested' => ['待提交', 'warning'],\n        'received' => ['已接收', 'info'], 'sent' => ['已发送', 'success'], 'read' => ['已读', 'success'],\n        'unknown' => ['未确定', 'muted'], 'recorded' => ['已记录', 'info'], 'effective' => ['已生效', 'success'],\n        'locked' => ['已锁定', 'success'], 'superseded' => ['已被新版本替代', 'muted'],\n        'order_booking' => ['订单预约费', 'info'], 'measurement_balance' => ['测量选师傅补款', 'info'], 'measurement_change' => ['测量现场加费', 'info'], 'booking_fee_paid' => ['预约费已支付', 'success'],\n        'worker_quote' => ['师傅报价成交', 'info'], 'admin_assignment' => ['管理员指派', 'info'],\n        'admin' => ['管理员指派', 'info'], 'invite' => ['邀请师傅接单', 'info'],\n        'ordinary_order' => ['普通订单分享', 'info'], 'worker_invite' => ['邀请师傅分享', 'info'],\n        'run_empty_fee' => ['跑空费', 'warning'], 'auto_72h' => ['72小时自动验收', 'info'],\n        'schedule_changed' => ['行程变化', 'info'], 'forced_cancel_refund' => ['强制取消并退款', 'danger'],\n        'change_accepted' => ['同意加价', 'success'], 'construction_issue' => ['施工问题', 'warning'],\n        // 2026-08-29：尾款延期提交即为已登记，只有放弃收款才标记坏账。\n        'reported' => ['已登记', 'info'], 'bad_debt' => ['已标记坏账', 'danger'],\n        // 2026-09-09：实际尾款先自动生效，再由管理员抽查。\n        'auto_approved' => ['自动预审已生效', 'success'],\n        // 2026-09-15：补齐 V2.2.1 预计服务费在验收前的中文状态。\n        'estimate' => ['预计服务费待缴', 'warning'], 'estimate_paid' => ['预计服务费部分已缴', 'info'],\n        'estimate_settled' => ['预计服务费已结清', 'success'],\n    ];\n    return isset($map[$status]) ? $map[$status] : [$status ?: '—', 'muted'];\n}\n\n// 2026-08-25：模板只需要中文状态文字时统一走同一份映射，避免列表与详情翻译不一致。\nfunction status_text($status)\n{\n    $meta = status_meta($status);\n    return $meta[0];\n}\n\n// 2026-08-30：订单专用状态按小程序列表的业务优先级计算，避免 active 被笼统翻译成“正常”。\nfunction order_business_status_meta(array $order)\n{\n    $refundStatus = (string) ($order['refund_status'] ?? '');\n    $lifecycleStatus = (string) ($order['lifecycle_status'] ?? 'active');\n    $auditStatus = (string) ($order['audit_status'] ?? '');\n    $paymentStatus = (string) ($order['payment_status'] ?? '');\n    $fulfillmentStatus = (string) ($order['fulfillment_status'] ?? '');\n    $assignmentStatus = (string) ($order['assignment_status'] ?? '');\n    $quoteStatus = (string) ($order['quote_status'] ?? '');\n    $dispatchMode = (string) ($order['dispatch_mode'] ?? 'multi_quote');\n    $expectedFeeType = (string) ($order['expected_fee_type'] ?? '');\n    $expectedFeeCents = max(0, (int) ($order['expected_fee_cents'] ?? 0));\n\n    if (in_array($refundStatus, ['created', 'pending_review', 'approved', 'processing', 'refunding'], true) || $lifecycleStatus === 'cancel_approved_pending_refund') return ['退款处理中', 'warning'];\n    if ($refundStatus === 'succeeded') return ['已退款', 'success'];\n    if ($lifecycleStatus === 'expired') return ['已到期取消', 'warning'];\n    if ($lifecycleStatus === 'cancelled') return ['已取消', 'danger'];\n    if ($lifecycleStatus === 'completed') return ['已完成', 'success'];\n    if ($auditStatus === 'draft' && $paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($auditStatus === 'draft') return ['草稿', 'muted'];\n    if ($auditStatus === 'pending') return ['待审核', 'warning'];\n    if ($auditStatus === 'supplement_required') return ['待补充资料', 'warning'];\n    if ($auditStatus === 'rejected') return ['审核未通过', 'danger'];\n    if ($fulfillmentStatus === 'accepted') return ['已验收', 'success'];\n    if ($fulfillmentStatus === 'submitted') return ['待验收', 'warning'];\n    if ($fulfillmentStatus === 'in_progress') return ['施工中', 'info'];\n    if ($fulfillmentStatus === 'scheduled') return ['已预约', 'info'];\n    if ($paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($assignmentStatus === 'accepted') {\n        if ($dispatchMode === 'single_grab') return [$expectedFeeType === 'total' && $expectedFeeCents > 0 ? '已按期望总价抢单，待施工' : '抢单报价已成交，待施工', 'info'];\n        return ['已安排师傅，待施工', 'info'];\n    }\n    if (in_array($assignmentStatus, ['offered', 'assigned'], true)) {\n        if ($dispatchMode === 'single_grab' && $assignmentStatus === 'offered') return ['师傅已抢单，待沟通报价', 'warning'];\n        return ['已安排师傅，待接单', 'warning'];\n    }\n    if (!empty($order['selected_quote_id']) || $quoteStatus === 'selected') return ['已选报价，待安排师傅', 'warning'];\n    if (in_array($quoteStatus, ['quoting', 'collecting'], true)) return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '报价中', 'info'];\n    return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '等待报价', 'info'];\n}\n\n// 2026-08-28：后台订单时间线统一显示中文事件标题；事件正文继续展示具体金额、原因和处理结果。\nfunction order_event_text($eventType)\n{\n    $map = [\n        'draft_created'=>'订单草稿已保存','admin_created'=>'管理员新增订单','admin_updated'=>'管理员修改订单资料',\n        'order_ready_for_prepayment'=>'等待支付预约费','order_submitted'=>'订单已提交审核','order_approved'=>'审核通过并公开',\n        'order_supplement_required'=>'要求补充资料','order_supplemented'=>'用户补充资料并重新提交','order_rejected'=>'订单审核未通过','order_published'=>'订单公开到大厅','order_hidden'=>'订单从大厅隐藏','order_edited'=>'订单资料已修改',\n        'worker_quoted'=>'师傅提交报价','worker_quote_updated'=>'师傅修改报价','platform_quoted'=>'平台提交报价','platform_quote_created'=>'平台新增报价','quote_selected_pending_payment'=>'用户选择报价',\n        'booking_fee_paid'=>'预约费支付成功','booking_fee_paid_upfront'=>'下单预约费支付成功','payment_reservation_released'=>'支付占位已释放',\n        'worker_invite_created'=>'生成邀请师傅分享','invite_claimed'=>'受邀师傅领取订单','worker_assigned'=>'管理员安排师傅','order_grabbed'=>'师傅抢单成功','single_grab_quote_confirmed'=>'抢单报价直接成交','single_grab_fixed_price_accepted'=>'按期望总价抢单成交','assignment_accepted'=>'师傅确认接单','contact_revealed'=>'完整联系信息已开放',\n        'appointment_recorded'=>'电话预约已记录','exceptional_arrival_reported'=>'到场异常已提交','change_requested'=>'师傅申请加价','change_accepted'=>'用户同意加价','change_rejected'=>'用户拒绝加价',\n        'measurement_service_paid'=>'测量服务款已补齐','measurement_change_accepted_pending_payment'=>'测量加费待支付','measurement_change_paid'=>'测量现场加费已支付','measurement_change_refund_created'=>'测量加费已登记退款','measurement_change_refunded'=>'测量加费已退款','measurement_late_balance_refund_created'=>'测量补款已登记退款','measurement_late_balance_refunded'=>'测量补款已退款',\n        'measurement_result_submitted'=>'测量成果已提交','measurement_result_accepted'=>'测量成果已确认','measurement_auto_accepted'=>'测量成果自动确认','measurement_rework_requested'=>'用户要求补测',\n        'measurement_hold_extension_requested'=>'申请延长测量冻结期','measurement_hold_extension_approved'=>'测量冻结延期已批准','measurement_hold_extension_rejected'=>'测量冻结延期未批准',\n        'measurement_income_released'=>'测量收入已释放','measurement_construction_linked'=>'测量单已关联施工',\n        'offline_collection_delayed'=>'线下尾款延期已登记','offline_collection_bad_debt'=>'线下尾款已标记坏账','completion_submitted'=>'师傅提交完工','completion_accepted_by_user'=>'用户确认验收','auto_completion_accepted'=>'系统自动验收','auto_accepted_72h'=>'72小时自动验收',\n        'auto_reviewed_5d'=>'5天自动评价','review_submitted'=>'用户提交评价','commission_receivable_created'=>'生成平台服务费账单','commission_paid'=>'平台服务费已结清',\n        'cancel_requested'=>'用户申请退款取消','cancel_approved'=>'管理员同意取消退款','admin_cancelled'=>'管理员强制取消','forced_cancel_refund'=>'管理员强制取消退款','auto_cancelled_7d'=>'7天未成交自动取消',\n        'cancel_rejected'=>'取消退款申请未通过','cancel_approved'=>'取消退款审核通过','refund_succeeded'=>'预约费退款成功','dispute_opened'=>'订单进入争议处理','dispute_resolved'=>'订单争议已结案','order_demo_seeded'=>'测试流程数据建立',\n        'test_center_scenario_built'=>'测试场景已生成（预置数据）',\n        'test_center_preset_preapproved'=>'已预置审核通过状态（未执行人工审核）',\n        'test_center_preset_target_built'=>'测试订单目标状态已生成（预置数据）',\n        'test_center_preset_worker_quote'=>'已预置师傅报价（未执行真实报价）',\n        'test_center_linked_construction_ready'=>'关联施工测试单已就绪（预置数据）',\n        'test_center_proxy_ready'=>'普通代录测试草稿已就绪'\n    ];\n    return isset($map[$eventType]) ? $map[$eventType] : '订单流程记录';\n}\n\nfunction audit($action, $resourceType, $resourceId = null, $description = '', $before = null, $after = null)\n{\n    if (!is_installed()) {\n        return;\n    }\n    try {\n        $admin = auth()->user();\n        // 2026-08-14：审计字段与不可变审计表保持一致，记录操作者快照及业务对象。\n        db()->execute(\n            \"INSERT INTO audit_logs (request_id, actor_type, actor_id, actor_name_snapshot, action, entity_type, entity_id, before_json, after_json, reason, ip_address, user_agent, result, created_at) VALUES (:request_id,'admin',:actor_id,:actor_name,:action,:entity_type,:entity_id,:before_json,:after_json,:reason,:ip,:ua,'success',NOW())\",\n            [\n                'actor_id' => $admin ? $admin['id'] : null,\n                'actor_name' => $admin ? ($admin['real_name'] ?: $admin['username']) : 'system',\n                'action' => $action,\n                'entity_type' => $resourceType,\n                'entity_id' => $resourceId === null ? null : (string) $resourceId,\n                'reason' => $description,\n                'before_json' => $before === null ? null : json_encode($before, JSON_UNESCAPED_UNICODE),\n                'after_json' => $after === null ? null : json_encode($after, JSON_UNESCAPED_UNICODE),\n                'ip' => request_ip(),\n                'ua' => substr(isset($_SERVER['HTTP_USER_AGENT']) ? $_SERVER['HTTP_USER_AGENT'] : 'cli', 0, 500),\n                'request_id' => request_id(),\n            ]\n        );\n    } catch (Throwable $exception) {\n        write_log('audit', '[' . date('c') . '] ' . $exception->getMessage() . \"\\n\");\n    }\n}\n\nfunction setting($key, $default = null)\n{\n    static $cache = [];\n    if (array_key_exists($key, $cache)) {\n        return $cache[$key];\n    }\n    try {\n        $row = db()->fetch('SELECT setting_value, value_type FROM system_settings WHERE setting_key = :key LIMIT 1', ['key' => $key]);\n        if (!$row) {\n            return $cache[$key] = $default;\n        }\n        $value = $row['setting_value'];\n        // 2026-08-25：新设置按运营要求明文保存；这里继续兼容读取升级前已有的 enc:v1 密文。\n        if (is_string($value) && strpos($value, 'enc:v1:') === 0) {\n            $value = decrypt_private_value($value, 'system-setting:' . (string) $key);\n        }\n        if (in_array($row['value_type'], ['int', 'integer'], true)) {\n            $value = (int) $value;\n        } elseif (in_array($row['value_type'], ['bool', 'boolean'], true)) {\n            $value = in_array(strtolower((string) $value), ['1', 'true', 'yes', 'on'], true);\n        } elseif ($row['value_type'] === 'json') {\n            $decoded = json_decode((string) $value, true);\n            $value = json_last_error() === JSON_ERROR_NONE ? $decoded : $default;\n        }\n        return $cache[$key] = $value;\n    } catch (Throwable $exception) {\n        return $default;\n    }\n}\n","server/bin/chat-images.php":"<?php\ndeclare(strict_types=1);\nif (PHP_SAPI !== 'cli') { http_response_code(404); exit; }\n// Only a Go-created private job directory is accepted; no application bootstrap,\n// FPM request, database write or arbitrary optimizer command is involved.\ntry {\n    $job = realpath($argv[1] ?? '');\n    if (!$job || !is_dir($job) || strpos(basename($job), 'bxchat-image-') !== 0 || is_link($argv[1])) throw new RuntimeException('job');\n    foreach (['source','clean.input'] as $name) if (!is_file($job.'/'.$name) || is_link($job.'/'.$name)) throw new RuntimeException('input');\n    $GLOBALS['chat_image_job'] = $job;\n    function base_path(string $path = ''): string { return $GLOBALS['chat_image_job'].'/'.$path; }\n    function setting(string $name, $default = null) {\n        $values = ['media.max_long_edge_px'=>(int)getenv('CHAT_IMAGE_EDGE'),'media.max_file_bytes'=>(int)getenv('CHAT_IMAGE_BYTES')];\n        return $values[$name] ?? $default;\n    }\n    require dirname(__DIR__).'/app/Services/ImageOptimizerService.php';\n    $result = (new \\WorkerAdmin\\Services\\ImageOptimizerService())->optimize($job.'/clean.input');\n    if (!copy($result['path'], $job.'/main')) throw new RuntimeException('copy');\n    $source = imagecreatefromstring((string)file_get_contents($job.'/main'));\n    if (!$source) throw new RuntimeException('decode');\n    $width = imagesx($source); $height = imagesy($source);\n    $scale = min(1.0, 400/max($width,$height));\n    $thumb = imagecreatetruecolor(max(1,(int)round($width*$scale)),max(1,(int)round($height*$scale)));\n    $white = imagecolorallocate($thumb,255,255,255); imagefill($thumb,0,0,$white);\n    imagecopyresampled($thumb,$source,0,0,0,0,imagesx($thumb),imagesy($thumb),$width,$height);\n    if (!imagejpeg($thumb,$job.'/thumb',90)) throw new RuntimeException('thumb');\n    imagedestroy($thumb);imagedestroy($source);\n    fwrite(STDOUT,json_encode(['method'=>$result['method']],JSON_THROW_ON_ERROR).\"\\n\");\n} catch (Throwable $error) {\n    fwrite(STDOUT,'{\"code\":\"CHAT_IMAGE_CHECK_UNAVAILABLE\"}'.\"\\n\");exit(1);\n}\n","server/bin/chat-recovery.php":"<?php\ndeclare(strict_types=1);\nif(PHP_SAPI!=='cli'){http_response_code(404);exit;}\nrequire dirname(__DIR__).'/bootstrap.php';\ntry {\n    if(!is_installed()||upgrade_required()||count($argv)!==2||!in_array($argv[1],['block','capture','verify','release','prune-audit'],true))throw new RuntimeException('CHAT_RECOVERY_USAGE');\n    $config=(array)app_config('chat',[]);\n    $env=['testing'=>'test','development'=>'development','production'=>'production'][(string)app_config('app.env','production')]??'';\n    $directory=(string)($config['recovery_directory']??'');\n    if((string)($config['recovery_gate_file']??'')!==rtrim($directory,'/\\\\').'/gate.json')throw new RuntimeException('CHAT_RECOVERY_GATE_PATH');\n    $name=(string)($config['recovery_key_env']??'');\n    if(preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D',$name)!==1)throw new RuntimeException('CHAT_RECOVERY_KEY');\n    $encoded=getenv($name);$key=is_string($encoded)?base64_decode($encoded,true):false;\n    if(!is_string($key)||strlen($key)!==32||base64_encode($key)!==$encoded)throw new RuntimeException('CHAT_RECOVERY_KEY');\n    $ops=new \\WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryCheckpoint(db()->pdo(),$env,$key,$directory,(string)($config['recovery_epoch']??''));\n    if($argv[1]==='block'){$ops->block();$result=['status'=>'blocked'];}\n    elseif($argv[1]==='prune-audit')$result=$ops->pruneAudit();\n    elseif($argv[1]==='capture')$result=$ops->capture();\n    else $result=$ops->verify($argv[1]==='release');\n    fwrite(STDOUT,json_encode($result,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES).\"\\n\");\n    exit(($result['status']??'')==='blocked'&&$argv[1]!=='block'?1:0);\n}catch(Throwable $e){fwrite(STDERR,\"聊天恢复核验未通过，保持维护状态\\n\");exit(1);}\n","server/bin/chat-reminders.php":"<?php\ndeclare(strict_types=1);\nif(PHP_SAPI!=='cli'){http_response_code(404);exit;}\n$args=array_slice($argv,1);\nif($args===['--help']){fwrite(STDOUT,\"用法：php bin/chat-reminders.php [--loop]\\n单次处理20项；--loop每5秒启动独立子进程，失败退避15秒。由Supervisor按进程组托管。\\n\");exit;}\nif($args===['--loop']){\n    // Each pass has fresh settings/token metadata. The parent never opens a DB\n    // or channel, so a long-running process cannot retain an old template map.\n    if(!function_exists('proc_open')){fwrite(STDERR,\"提醒调度需要CLI proc_open\\n\");exit(1);}\n    while(true){\n        $started=microtime(true);$pipes=[];\n        $child=proc_open([PHP_BINARY,__FILE__],[0=>['file','/dev/null','r'],1=>STDOUT,2=>STDERR],$pipes,dirname(__DIR__));\n        $status=is_resource($child)?proc_close($child):1;\n        $wait=max(0,($status===0?5:15)-(microtime(true)-$started));\n        if($wait>0)usleep((int)($wait*1000000));\n    }\n}\nif($args!==[]){fwrite(STDERR,\"参数无效\\n\");exit(2);}\nrequire dirname(__DIR__).'/bootstrap.php';\ntry{\n    $recoveryEnvironment=['testing'=>'test','development'=>'development','production'=>'production'][(string)app_config('app.env','production')]??'';\n    \\WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryGate::assertReady((array)app_config('chat',[]),$recoveryEnvironment);\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());\n    $shared=new \\WorkerAdmin\\Foundation\\ApplicationContainer(db());\n    $dispatcher=new \\WorkerAdmin\\Application\\Chat\\ChatReminderDispatch(db(),$shared->subscribeMessages(),[$auth,'eligible']);\n    $stats=$dispatcher->dispatch(20);\n    db()->execute('DELETE FROM chat_internal_nonces WHERE expires_at<=UTC_TIMESTAMP() ORDER BY expires_at LIMIT 1000');\n    fwrite(STDOUT,json_encode($stats,JSON_THROW_ON_ERROR).\"\\n\");\n}catch(Throwable $error){fwrite(STDERR,\"聊天提醒处理暂不可用\\n\");exit(1);}\n\n","server/chat-internal.php":"<?php\ndeclare(strict_types=1);\nrequire __DIR__.'/bootstrap.php';\nheader('Content-Type: application/json');header('Cache-Control: no-store');header('X-Content-Type-Options: nosniff');\ntry{\n    $recoveryEnvironment=['testing'=>'test','development'=>'development','production'=>'production'][(string)app_config('app.env','production')]??'';\n    \\WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryGate::assertReady((array)app_config('chat',[]),$recoveryEnvironment);\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    if(($_SERVER['REQUEST_METHOD']??'')!=='POST'||($_SERVER['REQUEST_URI']??'')!=='/chat-internal.php'||strtolower(trim(explode(';',(string)($_SERVER['CONTENT_TYPE']??''))[0]))!=='application/json')throw new RuntimeException('request');\n    $raw=file_get_contents('php://input',false,null,0,8193);if(!is_string($raw)||strlen($raw)>8192)throw new RuntimeException('body');\n    $headers=[];foreach(['environment','key-id','timestamp','nonce','signature'] as $key)$headers[$key]=(string)($_SERVER['HTTP_X_CHAT_'.strtoupper(str_replace('-','_',$key))]??'');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());$auth->verify('/chat-internal.php',$raw,$headers);\n    $result=(new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts(db()))->receive($raw);\n    echo json_encode($result,JSON_THROW_ON_ERROR);\n}catch(Throwable $error){http_response_code(503);echo '{\"code\":\"CHAT_REMINDER_UNAVAILABLE\"}';}\n","server/config/defaults.php":"<?php\n\n// 2026-08-14：提供无需 Composer 的默认配置，生产密钥由网页安装器写入 installed.php。\nreturn [\n    'installed' => false,\n    // V2.4.0：默认版本跟随当前代码包；全新安装基线已包含帮助中心结构和草稿问答。\n    'version' => '2.4.0',\n    'app' => [\n        'name' => '壁选师傅订单管理系统',\n        'url' => '',\n        'env' => 'production',\n        'debug' => false,\n        'timezone' => 'Asia/Shanghai',\n        'key' => '',\n    ],\n    'database' => [\n        'host' => '127.0.0.1',\n        'port' => 3306,\n        'database' => '',\n        'username' => '',\n        'password' => '',\n        'charset' => 'utf8mb4',\n    ],\n    // Independent PHP Ed25519 seed; Go receives public keys only. Disabled until chat acceptance.\n    'chat' => ['enabled'=>false,'key_id'=>'chat-v1','seed_env'=>'CHAT_ACCESS_SEED','order_policy_enabled'=>false,'safety_credential_export_enabled'=>false,'safety_rejection_directory'=>'','reminders_enabled'=>false,'internal_key_id'=>'chat-internal-v1','internal_key_env'=>'CHAT_INTERNAL_KEY','internal_go_origin'=>'','recovery_directory'=>'','recovery_gate_file'=>'','recovery_epoch'=>'','recovery_key_env'=>'CHAT_RECOVERY_KEY','test_report_key_env'=>'CHAT_TEST_REPORT_KEY','test_report_revision'=>''],\n    'security' => [\n        'session_name' => 'worker_admin_session',\n        'session_lifetime' => 7200,\n        'login_max_attempts' => 5,\n        'login_lock_minutes' => 15,\n        'force_https' => true,\n    ],\n    'media' => [\n        'max_width' => 1600,\n        'jpeg_quality' => 90,\n        'max_file_bytes' => 1048576,\n        'storage_path' => 'storage/private/uploads',\n    ],\n];\n\n\n","server/database/database.sql":"-- V2.2.9 complete install baseline.\n-- Generated by importing the prior complete baseline and idempotently converging through current 2.2.9.sql on MySQL 5.7.44.\n-- Source of truth for evolution remains database/upgrades/*.sql; this file is the consolidated fresh-install result.\n\n/*!40101 SET @OLD_CHARACTER_SET_CLIENT=@@CHARACTER_SET_CLIENT */;\n/*!40101 SET @OLD_CHARACTER_SET_RESULTS=@@CHARACTER_SET_RESULTS */;\n/*!40101 SET @OLD_COLLATION_CONNECTION=@@COLLATION_CONNECTION */;\n/*!40101 SET NAMES utf8mb4 */;\n/*!40103 SET @OLD_TIME_ZONE=@@TIME_ZONE */;\n/*!40103 SET TIME_ZONE='+00:00' */;\n/*!40014 SET @OLD_UNIQUE_CHECKS=@@UNIQUE_CHECKS, UNIQUE_CHECKS=0 */;\n/*!40014 SET @OLD_FOREIGN_KEY_CHECKS=@@FOREIGN_KEY_CHECKS, FOREIGN_KEY_CHECKS=0 */;\n/*!40101 SET @OLD_SQL_MODE=@@SQL_MODE, SQL_MODE='NO_AUTO_VALUE_ON_ZERO' */;\n/*!40111 SET @OLD_SQL_NOTES=@@SQL_NOTES, SQL_NOTES=0 */;\nDROP TABLE IF EXISTS `admin_users`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `admin_users` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `username` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '登录账号',\n  `password_hash` varchar(255) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '密码哈希',\n  `real_name` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '真实姓名',\n  `role` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'operator' COMMENT '角色',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  `must_change_password` tinyint(3) unsigned NOT NULL DEFAULT '1' COMMENT '是否必须修改密码',\n  `failed_attempts` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '登录失败次数',\n  `locked_until` datetime DEFAULT NULL COMMENT '锁定截止时间',\n  `last_login_at` datetime DEFAULT NULL COMMENT '最后登录时间',\n  `last_login_ip` varchar(45) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '最后登录IP',\n  `password_changed_at` datetime DEFAULT NULL COMMENT '密码修改时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_admin_users_username` (`username`),\n  KEY `idx_admin_users_status_role` (`status`,`role`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：后台管理员账号';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `admin_users` WRITE;\n/*!40000 ALTER TABLE `admin_users` DISABLE KEYS */;\n/*!40000 ALTER TABLE `admin_users` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `after_sales`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `after_sales` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  `type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '类型',\n  `description` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '描述',\n  `warranty_months_snapshot` smallint(5) unsigned DEFAULT NULL COMMENT '保修月数快照',\n  `warranty_expires_at_snapshot` datetime DEFAULT NULL COMMENT '保修到期时间快照',\n  `non_human_confirmed` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否确认非人为原因',\n  `evidence_media_ids_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '证据媒体ID列表JSON',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT '状态',\n  `handled_by` bigint(20) unsigned DEFAULT NULL COMMENT '处理管理员ID',\n  `resolution` text COLLATE utf8mb4_unicode_ci COMMENT '处理结果',\n  `opened_at` datetime NOT NULL COMMENT '开启时间',\n  `closed_at` datetime DEFAULT NULL COMMENT '关闭时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_after_sales_public_no` (`public_no`),\n  KEY `idx_after_sales_order_status` (`order_id`,`status`),\n  KEY `fk_after_sales_user` (`user_id`),\n  KEY `fk_after_sales_admin` (`handled_by`),\n  CONSTRAINT `fk_after_sales_admin` FOREIGN KEY (`handled_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_after_sales_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_after_sales_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：订单售后';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `after_sales` WRITE;\n/*!40000 ALTER TABLE `after_sales` DISABLE KEYS */;\n/*!40000 ALTER TABLE `after_sales` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `appointment_records`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `appointment_records` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  `appointment_at` datetime DEFAULT NULL COMMENT '预约时间',\n  `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备注',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'recorded' COMMENT '状态',\n  `context_type` varchar(16) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'service' COMMENT '预约上下文：service施工、repair维修',\n  `after_sale_id` bigint(20) unsigned DEFAULT NULL COMMENT '维修上下文对应售后记录',\n  `wait_customer_notice` tinyint(1) NOT NULL DEFAULT '0' COMMENT '1等待客户另行通知',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  KEY `idx_appointment_records_order_time` (`order_id`,`created_at`),\n  KEY `fk_appointment_records_worker` (`worker_id`),\n  KEY `idx_appointment_context` (`order_id`,`worker_id`,`context_type`,`after_sale_id`,`id`),\n  CONSTRAINT `fk_appointment_records_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_appointment_records_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：选填预约记录';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `appointment_records` WRITE;\n/*!40000 ALTER TABLE `appointment_records` DISABLE KEYS */;\n/*!40000 ALTER TABLE `appointment_records` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `assignment_history`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `assignment_history` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '派单ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  `action` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  `reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '原因',\n  `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作者类型',\n  `actor_id` bigint(20) unsigned DEFAULT NULL COMMENT '操作者ID',\n  `snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '快照JSON',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  PRIMARY KEY (`id`),\n  KEY `idx_assignment_history_order_time` (`order_id`,`created_at`),\n  KEY `fk_assignment_history_assignment` (`assignment_id`),\n  KEY `fk_assignment_history_worker` (`worker_id`),\n  CONSTRAINT `fk_assignment_history_assignment` FOREIGN KEY (`assignment_id`) REFERENCES `assignments` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_assignment_history_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_assignment_history_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：指派历史';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `assignment_history` WRITE;\n/*!40000 ALTER TABLE `assignment_history` DISABLE KEYS */;\n/*!40000 ALTER TABLE `assignment_history` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `assignments`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `assignments` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `worker_id` bigint(20) unsigned NOT NULL COM