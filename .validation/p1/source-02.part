_ci COMMENT='数据库字段中文名字典';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `database_field_dictionary` WRITE;\n/*!40000 ALTER TABLE `database_field_dictionary` DISABLE KEYS */;\nINSERT INTO `database_field_dictionary` VALUES (1,'users','public_id','用户公开编号','用户对外编号','2026-09-21 13:34:33','2026-09-21 13:34:33'),(2,'users','nickname','用户昵称','微信或本地昵称','2026-09-21 13:34:33','2026-09-21 13:34:33'),(3,'users','cloud_user_id','云用户ID','旧云开发 user 记录ID','2026-09-21 13:34:33','2026-09-21 13:34:33'),(4,'worker_profiles','display_name','师傅姓名','师傅展示名称','2026-09-21 13:34:33','2026-09-21 13:34:33'),(5,'worker_profiles','verification_status','师傅审核状态','待审核、已通过、已驳回或已暂停','2026-09-21 13:34:33','2026-09-21 13:34:33'),(6,'worker_profiles','profile_json','旧版师傅资料兼容字段','V2.0.6 起不再作为师傅主档，新数据保持为空','2026-09-21 13:34:33','2026-09-21 13:34:33'),(7,'worker_profiles','profile_source','师傅资料来源','cloud 表示完整资料实时从云开发读取','2026-09-21 13:34:33','2026-09-21 13:34:33'),(8,'worker_profiles','cloud_worker_id','云端师傅主记录编号','关联云开发 worker 集合唯一主记录','2026-09-21 13:34:33','2026-09-21 13:34:33'),(9,'worker_profiles','cloud_snapshot_json','旧版云资料快照兼容字段','V2.0.6 起不再复制云端完整资料或图片，新数据保持为空','2026-09-21 13:34:33','2026-09-21 13:34:33'),(10,'worker_profiles','cloud_record_count','云师傅记录数','用于兼容旧多条发布','2026-09-21 13:34:33','2026-09-21 13:34:33'),(11,'orders','public_no','订单号','BX+类目拼音码+时间+随机数','2026-09-21 13:34:33','2026-09-21 13:34:33'),(12,'orders','audit_status','订单审核状态','管理员审核进度','2026-09-21 13:34:33','2026-09-21 13:34:33'),(13,'orders','audit_note','订单审核说明','驳回或要求补充资料时的中文说明','2026-09-21 13:34:33','2026-09-21 13:34:33'),(14,'orders','audited_at','订单审核时间','管理员最后一次完成审核的时间','2026-09-21 13:34:33','2026-09-21 13:34:33'),(15,'orders','publish_status','大厅发布状态','是否在接单大厅展示','2026-09-21 13:34:33','2026-09-21 13:34:33'),(16,'orders','fulfillment_status','施工履约状态','预约、完工和验收进度','2026-09-21 13:34:33','2026-09-21 13:34:33'),(17,'orders','booking_fee_cents','预约费（分）','线上支付的预约费','2026-09-21 13:34:33','2026-09-21 13:34:33'),(18,'orders','commission_rate_bp','平台服务费比例','1000 表示 10%','2026-09-21 13:34:33','2026-09-21 13:34:33'),(19,'orders','order_source_type','订单客户类型','consumer 普通用户订单，merchant 商家订单','2026-09-21 13:34:33','2026-09-21 13:34:33'),(20,'orders','merchant_profile_id','商家档案编号','商家订单关联的认证或行为识别档案','2026-09-21 13:34:33','2026-09-21 13:34:33'),(21,'orders','merchant_risk_level','商家风控等级','none、medium 或 high','2026-09-21 13:34:33','2026-09-21 13:34:33'),(22,'orders','owner_mobile_base_hmac','业主手机号校验摘要','用于识别不同账号重复使用同一业主号码，不保存明文','2026-09-21 13:34:33','2026-09-21 13:34:33'),(23,'merchant_profiles','verification_status','商家认证状态','未认证、草稿、待审核、已认证、驳回或暂停','2026-09-21 13:34:33','2026-09-21 13:34:33'),(24,'merchant_profiles','recognition_level','商家识别等级','普通用户、疑似商家、行为确认商家或认证商家','2026-09-21 13:34:33','2026-09-21 13:34:33'),(25,'worker_collection_codes','status','旧版收款码审核状态','兼容升级前唯一收款码记录','2026-09-21 13:34:33','2026-09-21 13:34:33'),(26,'worker_collection_code_items','code_type','历史收款码类型','仅保留旧版数据兼容，V2.2.2 起前后端均只使用一张通用收款码','2026-09-21 13:34:33','2026-09-21 13:34:33'),(27,'worker_collection_code_items','status','收款码审核状态','auto_approved 表示系统预审后立即可用；管理员抽查可改为已复核或已驳回','2026-09-21 13:34:33','2026-09-21 13:34:33'),(28,'run_empty_fee_claims','collection_mode','跑空费收取方式','普通用户线下收取，商家订单线上支付','2026-09-21 13:34:33','2026-09-21 13:34:33'),(29,'run_empty_fee_claims','amount_cents','跑空费金额（分）','以分为单位保存师傅提出或平台裁定的跑空费','2026-09-21 13:34:33','2026-09-21 13:34:33'),(30,'run_empty_fee_claims','status','跑空费处理状态','待确认、待支付、已支付、争议中或已取消','2026-09-21 13:34:33','2026-09-21 13:34:33'),(31,'payment_orders','public_no','商户支付单号','微信支付商户单号','2026-09-21 13:34:33','2026-09-21 13:34:33'),(32,'payment_orders','business_type','支付业务类型','包含 measurement_fee 测量费全额支付','2026-09-21 13:34:33','2026-09-21 13:34:34'),(33,'payment_orders','api_version','微信支付接口版本','v2 或 v3，退款沿用该值','2026-09-21 13:34:33','2026-09-21 13:34:33'),(34,'payment_orders','amount_cents','支付金额（分）','不使用浮点数','2026-09-21 13:34:33','2026-09-21 13:34:33'),(35,'payment_orders'