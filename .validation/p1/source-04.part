sumer','approved',NULL,UTC_TIMESTAMP()-INTERVAL 14 DAY,'hidden','selected','completed','accepted','paid','none','none','completed',95000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 14 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 13 DAY,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 6 DAY,12,1,UTC_TIMESTAMP()-INTERVAL 14 DAY,UTC_TIMESTAMP()),\n('BXCL202609045841',@v213_customer_id,@v213_schema_id,@v213_cl,'窗帘','窗帘','演示：已选师傅待退款','用户取消订单，管理员已核准部分退款，等待财务处理。','3套',NULL,0,NULL,'杭州市','上城区','杭州市上城区解放路88号2幢602室','杭州市上城区解放路88号2幢602室',30.2572000,120.1769000,'吴女士','吴女士','12011112222','12011112222','consumer','approved',NULL,UTC_TIMESTAMP()-INTERVAL 4 DAY,'hidden','closed','accepted','scheduled','paid','pending_review','none','cancel_approved_pending_refund',76000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 3 DAY,NULL,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 HOUR,NULL,6,1,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()),\n('BXMF202609041275',@v213_customer_id,@v213_schema_id,@v213_mf,'美缝','美缝','演示：七天到期自动退款','订单到期未选报价，已自动取消并原路退还预约费。','约80m',NULL,0,NULL,'杭州市','富阳区','杭州市富阳区富春街道9号1幢201室','杭州市富阳区富春街道9号1幢201室',30.0547000,119.9511000,'钱先生','钱先生','13088880000','13088880000','consumer','approved',NULL,UTC_TIMESTAMP()-INTERVAL 9 DAY,'hidden','closed','unassigned','not_started','refunded','succeeded','none','expired',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,4,1,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()),\n('BXQB202609047736',@v213_customer_id,@v213_schema_id,@v213_qb,'墙布','墙布','演示：商家单跑空费争议','商家拒绝加价后协商未果，师傅提交跑空费并转平台争议。','72.00㎡','3.10m',1,NULL,'杭州市','西湖区','杭州市西湖区留下街道77号2幢602室','杭州市西湖区留下街道77号2幢602室',30.2356000,120.0812000,'何先生','何先生','12011112222','12011112222','merchant','approved',NULL,UTC_TIMESTAMP()-INTERVAL 5 DAY,'hidden','selected','accepted','in_progress','paid','none','open','active',135000,5000,800,5000,UTC_TIMESTAMP()-INTERVAL 5 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 4 DAY,NULL,NULL,NULL,NULL,NULL,NULL,8,1,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\n\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`) SELECT `id`,`category_id`,`category_name_snapshot`,0,UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1 AND `category_id` IS NOT NULL;\nINSERT INTO `order_addresses` (`order_id`,`province`,`city`,`district`,`address_summary`,`address_ciphertext`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`lat`,`lng`,`coordinate_system`,`created_at`,`updated_at`) SELECT `id`,'浙江省',`city`,`district`,`address_summary`,`address_ciphertext`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`lat`,`lng`,'GCJ-02',UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1;\n\n-- 2026-09-04：复用升级包中的三张压缩演示图，每笔订单都可直接检查图片展示。\nINSERT INTO `media_files` (`public_id`,`storage_disk`,`storage_key`,`mime_type`,`extension`,`size_bytes`,`width_px`,`height_px`,`sha256`,`compression_quality`,`status`,`reference_count`,`created_at`) VALUES\n(LEFT(SHA2('v213-material',256),26),'private_local','uploads/demo/order-material.jpg','image/jpeg','jpg',80804,900,675,'ab8fda1afebff029b6249570a4f7466150598cb4f20d6f092a585f74382fce51',82,'active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('v213-wall',256),26),'private_local','uploads/demo/order-wall.jpg','image/jpeg','jpg',41075,900,675,'baa9fbd644cf266126cd79c894ef44731010311b736ac072b47412b479f3543b',82,'active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('v213-completion',256),26),'private_local','uploads/demo/order-completion.jpg','image/jpeg','jpg',48207,900,675,'967ee65e75ca2d0c6d8f591ca856f476a5d2d88e57c41172431c885381d5675f',82,'active',0,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `status`='active',`pending_delete_at`=NULL,`deleted_at`=NULL;\nSET @v213_material=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-material.jpg' LIMIT 1);\nSET @v213_wall=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-wall.jpg' LIMIT 1);\nSET @v213_completion=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-completion.jpg' LIMIT 1);\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_at`) SELECT @v213_material,'order',`id`,'product',10,'system',UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1;\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_at`) SELECT @v213_wall,'order',`id`,'wall',20,'system',UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1;\n\n-- 2026-09-04：报价与选择快照，师傅报价可点击进入原 record 师傅详情页。\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v213-worker-',o.`public_no`),256),26),o.`id`,'worker',@v213_worker_id,NULL,88000,5000,'师傅报价：包含基础墙面检查和铺贴施工。','active',1,UTC_TIMESTAMP()-INTERVAL 18 HOUR,UTC_TIMESTAMP() FROM `orders` o WHERE o.`public_no`='BXQB202609046351';\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v213-platform-',o.`public_no`),256),26),o.`id`,'platform',@v213_admin_id,92000,5000,'平台报价：接受后由管理员安排师傅。','active',1,UTC_TIMESTAMP()-INTERVAL 16 HOUR,UTC_TIMESTAMP() FROM `orders` o WHERE o.`public_no`='BXQB202609046351';\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`selected_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v213-selected-',o.`public_no`),256),26),o.`id`,IF(o.`public_no`='BXBLM202609048047','platform','worker'),IF(o.`public_no`='BXBLM202609048047',NULL,@v213_worker_id),IF(o.`public_no`='BXBLM202609048047',@v213_admin_id,NULL),o.`final_amount_cents`,o.`booking_fee_cents`,'V2.1.3 当前流程演示报价','selected',1,o.`contact_revealed_at`,o.`created_at`+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no` IN ('BXBLM202609048047','BXCL202609042619','BXJJM202609047194','BXQZ202609043568','BXQZ202609049402','BXCL202609045841','BXQB202609047736');\nINSERT INTO `quote_versions` (`quote_id`,`version_no`,`amount_cents`,`booking_fee_cents`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`rule_acknowledged_at`,`description`,`operator_type`,`operator_id`,`created_at`)\nSELECT q.`id`,1,q.`amount_cents`,q.`booking_fee_cents`,o.`commission_rate_bp`,o.`commission_min_cents`,q.`created_at`,q.`description`,IF(q.`quote_type`='platform','admin','worker'),IF(q.`quote_type`='platform',@v213_admin_id,@v213_worker_id),q.`created_at` FROM `quotes` q INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nINSERT INTO `quote_selections` (`order_id`,`quote_id`,`quote_version_id`,`user_id`,`amount_cents_snapshot`,`booking_fee_cents_snapshot`,`status`,`selected_at`,`confirmed_at`)\nSELECT o.`id`,q.`id`,qv.`id`,@v213_customer_id,q.`amount_cents`,q.`booking_fee_cents`,'confirmed',q.`selected_at`,q.`selected_at` FROM `orders` o INNER JOIN `quotes` q ON q.`order_id`=o.`id` AND q.`status`='selected' INNER JOIN `quote_versions` qv ON qv.`quote_id`=q.`id` AND qv.`version_no`=1 WHERE o.`is_demo`=1;\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`locked_at`,`created_at`)\nSELECT o.`id`,1,o.`commission_rate_bp`,o.`commission_min_cents`,'default','V2.1.3 演示订单服务费快照',@v213_admin_id,IF(o.`public_no`='BXBLM202609048047','active','locked'),IF(o.`public_no`='BXBLM202609048047',NULL,o.`contact_revealed_at`),o.`created_at` FROM `orders` o WHERE o.`is_demo`=1 AND o.`quote_status`='selected';\n\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT CONCAT('PAY-V213-',RIGHT(o.`public_no`,4)),'order_booking',o.`id`,o.`id`,@v213_customer_id,'V213_CUSTOMER_OPENID','V213_APPID','V213_MCHID','v3','CNY',5000,IF(o.`lifecycle_status`='expired','refunded','paid'),CONCAT('V213_TX_',RIGHT(o.`public_no`,4)),'V2.1.3 演示预约费，不是真实微信交易',o.`created_at`+INTERVAL 10 MINUTE,o.`created_at`,UTC_TIMESTAMP() FROM `orders` o WHERE o.`is_demo`=1;\n\nINSERT INTO `assignments` (`public_id`,`order_id`,`worker_id`,`quote_id`,`assignment_type`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`estimated_commission_cents`,`estimated_offline_collect_cents`,`estimated_net_income_cents`,`status`,`offered_at`,`accepted_at`,`created_by_admin_id`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v213-assignment-',o.`public_no`),256),26),o.`id`,@v213_worker_id,q.`id`,'worker_quote',crv.`id`,o.`final_amount_cents`,o.`booking_fee_cents`,o.`commission_rate_bp`,o.`commission_min_cents`,GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`),o.`final_amount_cents`-o.`booking_fee_cents`,o.`final_amount_cents`-GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`),IF(o.`fulfillment_status`='accepted','completed','accepted'),o.`created_at`+INTERVAL 1 DAY,o.`created_at`+INTERVAL 1 DAY,@v213_admin_id,o.`created_at`+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM `orders` o INNER JOIN `quotes` q ON q.`order_id`=o.`id` AND q.`status`='selected' INNER JOIN `commission_rule_versions` crv ON crv.`order_id`=o.`id` WHERE o.`is_demo`=1 AND o.`public_no`<>'BXBLM202609048047';\nUPDATE `orders` o INNER JOIN `quotes` q ON q.`order_id`=o.`id` AND q.`status`='selected' LEFT JOIN `commission_rule_versions` crv ON crv.`order_id`=o.`id` LEFT JOIN `assignments` a ON a.`order_id`=o.`id` SET o.`selected_quote_id`=q.`id`,o.`commission_rule_version_id`=crv.`id`,o.`current_assignment_id`=a.`id`,o.`assigned_worker_id`=a.`worker_id` WHERE o.`is_demo`=1;\n\nSET @v213_platform_order=(SELECT `id` FROM `orders` WHERE `public_no`='BXBLM202609048047');\nSET @v213_platform_rule=(SELECT `id` FROM `commission_rule_versions` WHERE `order_id`=@v213_platform_order LIMIT 1);\nINSERT INTO `invite_tokens` (`order_id`,`token_hash`,`purpose`,`created_by_admin_id`,`commission_rule_version_id`,`status`,`max_claims`,`claim_count`,`expires_at`,`created_at`) VALUES (@v213_platform_order,SHA2('V213-DEMO-INVITE-NOT-USABLE',256),'worker_assignment',@v213_admin_id,@v213_platform_rule,'active',1,0,UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\nINSERT INTO `share_contexts` (`order_id`,`context_type`,`token_hash`,`created_by_type`,`created_by_id`,`snapshot_json`,`status`,`expires_at`,`created_at`) VALUES (@v213_platform_order,'worker_invite',SHA2('V213-DEMO-SHARE-NOT-USABLE',256),'admin',@v213_admin_id,'{\"share_type\":\"worker_invite\",\"demo\":true}','active',UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\n\nSET @v213_scheduled=(SELECT `id` FROM `orders` WHERE `public_no`='BXCL202609042619');\nINSERT INTO `appointment_records` (`order_id`,`worker_id`,`appointment_at`,`note`,`status`,`created_at`,`updated_at`) VALUES (@v213_scheduled,@v213_worker_id,DATE_ADD(DATE(UTC_TIMESTAMP()),INTERVAL 1 DAY)+INTERVAL 9 HOUR,'电话联系后约定明日上午上门。','recorded',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nSET @v213_adjust_order=(SELECT `id` FROM `orders` WHERE `public_no`='BXJJM202609047194');\nSET @v213_adjust_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v213_adjust_order LIMIT 1);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`version`,`created_at`,`updated_at`) VALUES (@v213_adjust_order,@v213_worker_id,'家具膜施工完成，已添加时间地点水印。','submitted',UTC_TIMESTAMP()-INTERVAL 12 HOUR,1,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP());\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES (@v213_completion,'order',@v213_adjust_order,'completion',10,'worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 12 HOUR),(@v213_material,'order',@v213_adjust_order,'collection_receipt',10,'worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 11 HOUR);\nINSERT INTO `offline_collection_adjustment_requests` (`public_id`,`order_id`,`worker_id`,`assignment_id`,`original_total_cents`,`original_tail_cents`,`requested_total_cents`,`requested_tail_cents`,`reason`,`receipt_media_ids_json`,`status`,`submitted_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v213-offline-adjustment',256),26),@v213_adjust_order,@v213_worker_id,@v213_adjust_assignment,120000,115000,126000,121000,'现场增加了一面家具膜，按实际收款金额申请核准。',JSON_ARRAY(@v213_material),'pending',UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP());\n\nSET @v213_overdue_order=(SELECT `id` FROM `orders` WHERE `public_no`='BXQZ202609043568');\nSET @v213_overdue_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v213_overdue_order LIMIT 1);\nSET @v213_overdue_rule=(SELECT `commission_rule_version_id` FROM `assignments` WHERE `id`=@v213_overdue_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES (@v213_overdue_order,@v213_worker_id,'墙纸施工完成，用户已验收。','accepted',UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 3 DAY,'auto_72h',1,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES (@v213_completion,'order',@v213_overdue_order,'completion',10,'worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 6 DAY),(@v213_material,'order',@v213_overdue_order,'collection_receipt',10,'worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`created_at`,`updated_at`) VALUES ('COM-V213-OVERDUE',@v213_overdue_order,@v213_worker_id,@v213_overdue_assignment,@v213_overdue_rule,110000,5000,1000,5000,11000,5000,6000,0,'overdue',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP());\nINSERT INTO `offline_payment_delay_requests` (`order_id`,`worker_id`,`amount_cents_snapshot`,`reason`,`expected_collect_at`,`status`,`reviewed_by`,`review_note`,`submitted_at`,`reviewed_at`,`created_at`,`updated_at`) VALUES (@v213_overdue_order,@v213_worker_id,105000,'商家超过约定日期仍未结清尾款。',UTC_TIMESTAMP()-INTERVAL 2 DAY,'bad_debt',@v213_admin_id,'演示：师傅确认对方不再支付，管理员标记坏账。',UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP());\n\nSET @v213_done_order=(SELECT `id` FROM `orders` WHERE `public_no`='BXQZ202609049402');\nSET @v213_done_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v213_done_order LIMIT 1);\nSET @v213_done_rule=(SELECT `commission_rule_version_id` FROM `assignments` WHERE `id`=@v213_done_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES (@v213_done_order,@v213_worker_id,'墙纸施工完成，用户评价满意。','accepted',UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,'user',1,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP());\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES (@v213_completion,'order',@v213_done_order,'completion',10,'worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 9 DAY),(@v213_material,'order',@v213_done_order,'collection_receipt',10,'worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 8 DAY);\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`settled_at`,`created_at`,`updated_at`) VALUES ('COM-V213-SETTLED',@v213_done_order,@v213_worker_id,@v213_done_assignment,@v213_done_rule,95000,5000,1000,5000,9500,5000,4500,4500,'settled',UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nSET @v213_receivable_done=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`) VALUES ('PAY-V213-COMMISSION','commission',@v213_receivable_done,@v213_done_order,@v213_worker_user_id,'V213_WORKER_OPENID','V213_APPID','V213_MCHID','v3','CNY',4500,'paid','V213_TX_COMMISSION','V2.1.3 演示平台服务费',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @v213_commission_payment=LAST_INSERT_ID();\nINSERT INTO `commission_payments` (`receivable_id`,`payment_order_id`,`amount_cents`,`status`,`paid_at`,`created_at`) VALUES (@v213_receivable_done,@v213_commission_payment,4500,'paid',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO `reviews` (`public_id`,`order_id`,`user_id`,`worker_id`,`rating`,`content`,`is_auto`,`status`,`reviewed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v213-review',256),26),@v213_done_order,@v213_customer_id,@v213_worker_id,5,'师傅沟通及时，施工细致，完工效果满意。',0,'visible',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @v213_review=LAST_INSERT_ID();\nINSERT INTO `review_media` (`review_id`,`media_file_id`,`sort_order`,`created_at`) VALUES (@v213_review,@v213_completion,10,UTC_TIMESTAMP()-INTERVAL 5 DAY);\n\nSET @v213_refund_order=(SELECT `id` FROM `orders` WHERE `public_no`='BXCL202609045841');\nSET @v213_refund_payment=(SELECT `id` FROM `payment_orders` WHERE `order_id`=@v213_refund_order AND `business_type`='order_booking' LIMIT 1);\nINSERT INTO `order_cancel_requests` (`public_id`,`order_id`,`applicant_type`,`applicant_id`,`request_type`,`order_state_snapshot_json`,`reason_code`,`reason`,`status`,`requested_refund_cents`,`requested_at`,`closed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v213-cancel-pending',256),26),@v213_refund_order,'user',@v213_customer_id,'cancel_refund','{\"fulfillment_status\":\"scheduled\",\"assignment_status\":\"accepted\",\"payment_status\":\"paid\"}','schedule_changed','行程变化，师傅确认尚未上门，申请退回部分预约费。','approved',2500,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP());\nSET @v213_cancel=LAST_INSERT_ID();\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`cancel_request_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`created_at`,`updated_at`) VALUES ('REF-V213-PENDING',@v213_refund_payment,@v213_refund_order,@v213_cancel,2500,'管理员核准部分退款25.00元','pending_review',@v213_admin_id,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP());\n\nSET @v213_expired_order=(SELECT `id` FROM `orders` WHERE `public_no`='BXMF202609041275');\nSET @v213_expired_payment=(SELECT `id` FROM `payment_orders` WHERE `order_id`=@v213_expired_order AND `business_type`='order_booking' LIMIT 1);\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`amount_cents`,`reason`,`status`,`wechat_refund_id`,`requested_at`,`succeeded_at`,`created_at`,`updated_at`) VALUES ('REF-V213-DONE',@v213_expired_payment,@v213_expired_order,5000,'七天未接受报价自动取消并全额退款','succeeded','V213_REFUND_DONE',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 23 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nSET @v213_dispute_order=(SELECT `id` FROM `orders` WHERE `public_no`='BXQB202609047736');\nINSERT INTO `change_requests` (`public_id`,`order_id`,`worker_id`,`original_amount_cents`,`added_amount_cents`,`new_total_cents`,`reason`,`status`,`submitted_at`,`decided_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v213-change-rejected',256),26),@v213_dispute_order,@v213_worker_id,135000,20000,155000,'现场墙面基层破损严重，需增加修补费用。','rejected',UTC_TIMESTAMP()-INTERVAL 6 HOUR,UTC_TIMESTAMP()-INTERVAL 5 HOUR,UTC_TIMESTAMP()-INTERVAL 6 HOUR,UTC_TIMESTAMP());\nSET @v213_change=LAST_INSERT_ID();\nINSERT INTO `change_confirmations` (`change_request_id`,`user_id`,`decision`,`note`,`created_at`) VALUES (@v213_change,@v213_customer_id,'rejected','商家不同意增加费用，双方继续协商。',UTC_TIMESTAMP()-INTERVAL 5 HOUR);\nINSERT INTO `disputes` (`public_no`,`order_id`,`raised_by_type`,`raised_by_id`,`dispute_type`,`title`,`description`,`status`,`responsibility`,`refund_amount_cents`,`run_empty_fee_cents`,`opened_at`,`created_at`,`updated_at`) VALUES ('DSP-V213-OPEN',@v213_dispute_order,'worker',@v213_worker_id,'run_empty_fee','商家单跑空费争议','商家拒绝加价且不愿支付跑空费，师傅提交平台核查。','open','undetermined',0,8000,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP());\nSET @v213_dispute=LAST_INSERT_ID();\nINSERT INTO `run_empty_fee_claims` (`public_id`,`order_id`,`change_request_id`,`worker_id`,`order_source_type`,`collection_mode`,`amount_cents`,`reason`,`status`,`user_note`,`dispute_id`,`submitted_at`,`decided_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v213-run-empty',256),26),@v213_dispute_order,@v213_change,@v213_worker_id,'merchant','online',8000,'已到现场后发现基层无法按原方案施工，协商未达成。','disputed','商家不认可跑空费，申请平台处理。',@v213_dispute,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP());\n\n-- 2026-09-04：时间线使用具体中文流程说明，不生成笼统的“订单状态已更新”。\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT o.`id`,'booking_fee_paid_upfront',CONCAT('v213:paid:',o.`id`),'user',@v213_customer_id,JSON_OBJECT('amount_cents',5000),o.`created_at`+INTERVAL 10 MINUTE FROM `orders` o WHERE o.`is_demo`=1;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT o.`id`,'order_submitted',CONCAT('v213:submitted:',o.`id`),'user',@v213_customer_id,JSON_OBJECT('message','预约费50.00元已支付，订单资料已提交审核'),o.`created_at`+INTERVAL 11 MINUTE FROM `orders` o WHERE o.`is_demo`=1;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT o.`id`,'order_approved',CONCAT('v213:approved:',o.`id`),'admin',@v213_admin_id,JSON_OBJECT('message','管理员审核通过，订单进入报价或履约流程'),o.`audited_at` FROM `orders` o WHERE o.`is_demo`=1 AND o.`audit_status`='approved';\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT q.`order_id`,IF(q.`quote_type`='platform','platform_quoted','worker_quoted'),CONCAT('v213:quote:',q.`id`),IF(q.`quote_type`='platform','admin','worker'),IF(q.`quote_type`='platform',@v213_admin_id,@v213_worker_id),JSON_OBJECT('amount_cents',q.`amount_cents`),q.`created_at` FROM `quotes` q INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT a.`order_id`,'assignment_accepted',CONCAT('v213:assignment:',a.`id`),'worker',@v213_worker_id,JSON_OBJECT('message','师傅已接单，完整业主信息已自动开放'),a.`accepted_at` FROM `assignments` a INNER JOIN `orders` o ON o.`id`=a.`order_id` AND o.`is_demo`=1;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) VALUES\n(@v213_platform_order,'worker_invite_created',CONCAT('v213:invite:',@v213_platform_order),'admin',@v213_admin_id,JSON_OBJECT('message','管理员已生成邀请师傅分享，等待师傅领取'),UTC_TIMESTAMP()),\n(@v213_scheduled,'appointment_recorded',CONCAT('v213:appointment:',@v213_scheduled),'worker',@v213_worker_id,JSON_OBJECT('message','师傅电话联系后记录：明日上午上门'),UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@v213_adjust_order,'completion_submitted',CONCAT('v213:completion:',@v213_adjust_order),'worker',@v213_worker_id,JSON_OBJECT('photo_count',1,'message','师傅已提交带时间地点水印的完工照'),UTC_TIMESTAMP()-INTERVAL 12 HOUR),\n(@v213_adjust_order,'offline_collection_adjustment_requested',CONCAT('v213:adjust:',@v213_adjust_order),'worker',@v213_worker_id,JSON_OBJECT('original_tail_cents',115000,'requested_tail_cents',121000),UTC_TIMESTAMP()-INTERVAL 10 HOUR),\n(@v213_overdue_order,'auto_accepted_72h',CONCAT('v213:autoaccept:',@v213_overdue_order),'system',NULL,JSON_OBJECT('message','完工满72小时，系统自动确认验收'),UTC_TIMESTAMP()-INTERVAL 3 DAY),\n(@v213_overdue_order,'commission_receivable_created',CONCAT('v213:commission-due:',@v213_overdue_order),'system',NULL,JSON_OBJECT('amount_cents',6000,'message','平台服务费抵扣预约费后尚需补缴60.00元'),UTC_TIMESTAMP()-INTERVAL 3 DAY),\n(@v213_done_order,'commission_paid',CONCAT('v213:commission-paid:',@v213_done_order),'worker',@v213_worker_id,JSON_OBJECT('amount_cents',4500,'message','师傅已支付平台服务45.00元，账单结清'),UTC_TIMESTAMP()-INTERVAL 5 DAY),\n(@v213_refund_order,'cancel_approved',CONCAT('v213:cancel:',@v213_refund_order),'admin',@v213_admin_id,JSON_OBJECT('amount_cents',2500,'message','师傅确认未上门，管理员已核准部分退款25.00元'),UTC_TIMESTAMP()-INTERVAL 40 MINUTE),\n(@v213_expired_order,'auto_cancelled_7d',CONCAT('v213:expired:',@v213_expired_order),'system',NULL,JSON_OBJECT('message','订单超过7天未接受报价，系统自动取消'),UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@v213_expired_order,'refund_succeeded',CONCAT('v213:refunded:',@v213_expired_order),'system',NULL,JSON_OBJECT('amount_cents',5000,'message','预约费50.00元已原路退回'),UTC_TIMESTAMP()-INTERVAL 23 HOUR),\n(@v213_dispute_order,'change_rejected',CONCAT('v213:change-rejected:',@v213_dispute_order),'user',@v213_customer_id,JSON_OBJECT('message','商家已拒绝加价，双方自行协商未达成'),UTC_TIMESTAMP()-INTERVAL 5 HOUR),\n(@v213_dispute_order,'run_empty_claim_disputed',CONCAT('v213:run-empty:',@v213_dispute_order),'worker',@v213_worker_id,JSON_OBJECT('amount_cents',8000,'message','商家不愿支付跑空费80.00元，师傅申请平台介入'),UTC_TIMESTAMP()-INTERVAL 3 HOUR);\n\n-- 2026-09-04：提现演示同时覆盖待审核与已付款，冻结金额与台账变化严格对应。\nSET @v213_payout_account=(SELECT `id` FROM `worker_payout_accounts` WHERE `worker_id`=@v213_worker_id AND `status`='active' ORDER BY `is_default` DESC,`id` DESC LIMIT 1);\nINSERT INTO `worker_payout_accounts` (`worker_id`,`account_type`,`holder_name_masked`,`holder_name_ciphertext`,`account_masked`,`account_ciphertext`,`account_hmac`,`status`,`is_default`,`verified_at`,`created_at`,`updated_at`)\nSELECT w.`id`,'alipay',w.`display_name`,w.`display_name`,'13088880000','13088880000',SHA2(CONCAT('V213-DEMO-ALIPAY-',u.`public_id`),256),'active',1,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM `worker_profiles` w INNER JOIN `users` u ON u.`id`=w.`user_id` WHERE w.`id`=@v213_worker_id AND @v213_payout_account IS NULL;\nSET @v213_payout_account=(SELECT `id` FROM `worker_payout_accounts` WHERE `worker_id`=@v213_worker_id AND `status`='active' ORDER BY `is_default` DESC,`id` DESC LIMIT 1);\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v213_worker_id,'run_empty_fee','credit',30000,30000,0,'demo_adjustment',213001,'v213:balance:credit','V2.1.3 演示跑空费进入余额','effective',UTC_TIMESTAMP()-INTERVAL 3 DAY);\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v213_worker_id,'withdrawal_freeze','transfer',3000,-3000,3000,'withdrawal_request',213002,'v213:withdrawal:pending:freeze','V2.1.3 待审核提现冻结','effective',UTC_TIMESTAMP()-INTERVAL 2 HOUR);\nSET @v213_pending_freeze=LAST_INSERT_ID();\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v213_worker_id,'withdrawal_freeze','transfer',5000,-5000,5000,'withdrawal_request',213003,'v213:withdrawal:paid:freeze','V2.1.3 已付款提现冻结','effective',UTC_TIMESTAMP()-INTERVAL 2 DAY);\nSET @v213_paid_freeze=LAST_INSERT_ID();\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v213_worker_id,'withdrawal_paid','debit',5000,0,-5000,'withdrawal_request',213003,'v213:withdrawal:paid:finish','V2.1.3 人工支付完成，扣减冻结金额','effective',UTC_TIMESTAMP()-INTERVAL 1 DAY);\nINSERT INTO `withdrawal_requests` (`public_no`,`worker_id`,`payout_account_id`,`amount_cents`,`account_type_snapshot`,`holder_name_masked_snapshot`,`holder_name_ciphertext_snapshot`,`account_masked_snapshot`,`account_ciphertext_snapshot`,`status`,`review_note`,`submitted_at`,`reviewed_at`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'WD-V213-PENDING',@v213_worker_id,p.`id`,3000,p.`account_type`,p.`holder_name_masked`,p.`holder_name_ciphertext`,p.`account_masked`,p.`account_ciphertext`,'pending','演示：等待管理员审核并人工转账',UTC_TIMESTAMP()-INTERVAL 2 HOUR,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP() FROM `worker_payout_accounts` p WHERE p.`id`=@v213_payout_account;\nSET @v213_withdraw_pending=LAST_INSERT_ID();\nINSERT INTO `withdrawal_requests` (`public_no`,`worker_id`,`payout_account_id`,`amount_cents`,`account_type_snapshot`,`holder_name_masked_snapshot`,`holder_name_ciphertext_snapshot`,`account_masked_snapshot`,`account_ciphertext_snapshot`,`status`,`reviewed_by`,`review_note`,`submitted_at`,`reviewed_at`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'WD-V213-PAID',@v213_worker_id,p.`id`,5000,p.`account_type`,p.`holder_name_masked`,p.`holder_name_ciphertext`,p.`account_masked`,p.`account_ciphertext`,'paid',@v213_admin_id,'演示：已完成支付并登记支付宝流水号',UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()-INTERVAL 36 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP() FROM `worker_payout_accounts` p WHERE p.`id`=@v213_payout_account;\nSET @v213_withdraw_paid=LAST_INSERT_ID();\nINSERT INTO `withdrawal_allocations` (`withdrawal_request_id`,`ledger_entry_id`,`amount_cents`,`created_at`) VALUES (@v213_withdraw_pending,@v213_pending_freeze,3000,UTC_TIMESTAMP()-INTERVAL 2 HOUR),(@v213_withdraw_paid,@v213_paid_freeze,5000,UTC_TIMESTAMP()-INTERVAL 2 DAY);\nINSERT INTO `withdrawal_events` (`withdrawal_request_id`,`event_type`,`from_status`,`to_status`,`note`,`operator_type`,`operator_id`,`created_at`) VALUES\n(@v213_withdraw_pending,'submitted',NULL,'pending','师傅申请提现30.00元','worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n(@v213_withdraw_paid,'submitted',NULL,'pending','师傅申请提现50.00元','worker',@v213_worker_id,UTC_TIMESTAMP()-INTERVAL 2 DAY),\n(@v213_withdraw_paid,'approved','pending','approved','管理员审核通过','admin',@v213_admin_id,UTC_TIMESTAMP()-INTERVAL 36 HOUR),\n(@v213_withdraw_paid,'paid','approved','paid','支付宝人工转账完成','admin',@v213_admin_id,UTC_TIMESTAMP()-INTERVAL 1 DAY);\nINSERT INTO `worker_payouts` (`public_no`,`withdrawal_request_id`,`worker_id`,`amount_cents`,`channel`,`external_transaction_no`,`status`,`paid_by`,`paid_at`,`created_at`) VALUES ('PAYOUT-V213-PAID',@v213_withdraw_paid,@v213_worker_id,5000,'alipay_manual','ALI-V213-20260904-5831','paid',@v213_admin_id,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY);\n\n-- 2026-09-04：收款码界面只读取每位师傅最近的一张；旧双类型记录保留为可回滚历史，新上传不再按微信/支付宝分类。\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('worker_profiles','rejection_reason','师傅状态处理说明','驳回入驻或暂停接单的原因，同步向师傅端展示',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_collection_code_items','code_type','历史收款码类型','仅保留旧版数据兼容，V2.1.3 起前后端均只使用一张通用收款码',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','is_demo','演示订单','1 表示仅用于后台流程与财务排查，关闭演示数据后不计入统计',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `media_files` m SET m.`reference_count`=(SELECT COUNT(*) FROM `media_links` l WHERE l.`media_file_id`=m.`id`) WHERE m.`id` IN (@v213_material,@v213_wall,@v213_completion);\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('demo.seed_version','2.1.3','string','system',0,'当前订单与财务演示数据版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('app.version','2.1.3','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\nUPDATE `system_settings` SET `setting_value`='2.1.3',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\nSELECT 'V2.1.3 师傅审核一致性、单一收款码和当前订单财务演示数据已更新' AS `升级结果`;\n","server/database/upgrades/2.1.4.sql":"-- 2026-09-09：V2.1.4 自动预审、实际尾款先结算后抽查，以及商家资料精简。\n-- 仅包含可重复执行的数据修正，兼容 MySQL 5.7.44。\nSET NAMES utf8mb4;\n\n-- 预约费已到账且仍处于旧待审核状态的报价前订单，升级后按新规则自动预审公开。\nUPDATE `orders`\nSET `audit_status`='approved',\n    `publish_status`='published',\n    `quote_status`=IF(`quote_status` IN ('waiting','quoting','collecting'),`quote_status`,'waiting'),\n    `audited_at`=COALESCE(`audited_at`,UTC_TIMESTAMP()),\n    `published_at`=COALESCE(`published_at`,UTC_TIMESTAMP()),\n    `quote_deadline_at`=COALESCE(`quote_deadline_at`,DATE_ADD(UTC_TIMESTAMP(),INTERVAL 7 DAY)),\n    `updated_at`=UTC_TIMESTAMP(),\n    `version`=`version`+1\nWHERE `audit_status`='pending'\n  AND `payment_status`='paid'\n  AND `lifecycle_status`='active'\n  AND `selected_quote_id` IS NULL;\n\nINSERT IGNORE INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`)\nSELECT `id`,'quote_expiry','pending',`version`,`quote_deadline_at`,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders`\nWHERE `audit_status`='approved' AND `publish_status`='published' AND `lifecycle_status`='active'\n  AND `selected_quote_id` IS NULL AND `quote_deadline_at` IS NOT NULL;\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('offline_collection_adjustment_requests','status','实际尾款复核状态','auto_approved 表示系统预审已生效；管理员发现异常可驳回并恢复原金额',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('merchant_profiles','business_name','商家名称','小程序商家认证必填资料',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('merchant_profiles','business_address','商家地址','小程序商家认证必填资料',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.1.4','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT IGNORE INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('wecom.event_switches','{\"order_auto_preapproved\":true,\"offline_collection_adjustment_auto_approved\":true}','json','wecom',0,'管理员企业微信通知环节开关',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\nUPDATE `system_settings`\nSET `setting_value`=JSON_SET(IF(JSON_VALID(`setting_value`),`setting_value`,'{}'),'$.order_auto_preapproved',true,'$.offline_collection_adjustment_auto_approved',true),\n    `updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wecom.event_switches';\n\nSELECT 'V2.1.4 自动预审、实际尾款预审结算及商家认证精简已更新' AS `升级结果`;\n","server/database/upgrades/2.1.5.sql":"-- 2026-09-09：V2.1.5 订单直接编辑、收款码自动预审与管理员通知完善。\n-- 仅包含可重复执行的数据修正，兼容 MySQL 5.7.44。\nSET NAMES utf8mb4;\n\n-- 升级前仍在等待人工审核的有效收款码，统一进入自动预审可用、后台待抽查状态。\nUPDATE `worker_collection_code_items`\nSET `status`='auto_approved',\n    `review_reason`='系统自动预审通过，管理员可抽查驳回',\n    `reviewed_at`=COALESCE(`reviewed_at`,UTC_TIMESTAMP()),\n    `reviewed_by`=NULL,\n    `updated_at`=UTC_TIMESTAMP()\nWHERE `status`='pending' AND `media_file_id` IS NOT NULL;\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('worker_collection_code_items','status','收款码审核状态','auto_approved 表示系统预审后立即可用；管理员抽查可改为已复核或已驳回',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.1.5','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT IGNORE INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('wecom.event_switches','{\"commission_overdue\":true,\"worker_collection_code_auto_approved\":true,\"withdrawal_submitted\":true}','json','wecom',0,'管理员企业微信通知环节开关',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\nUPDATE `system_settings`\nSET `setting_value`=JSON_REMOVE(JSON_SET(\n        IF(JSON_VALID(`setting_value`),`setting_value`,'{}'),\n        '$.commission_overdue',true,\n        '$.worker_collection_code_auto_approved',true,\n        '$.withdrawal_submitted',true\n    ),'$.worker_collection_code_submitted'),\n    `description`='管理员企业微信只提醒需要复核、逾期或人工处理的事项',\n    `updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wecom.event_switches';\n\nSELECT 'V2.1.5 订单编辑、收款码自动预审与管理员通知已更新' AS `升级结果`;\n","server/database/upgrades/2.1.6.sql":"-- 2026-09-11：V2.1.6 收款码文案、短信测试与师傅 OpenID 关联修复。\n-- 仅更新版本标记，可重复执行并兼容 MySQL 5.7.44。\nSET NAMES utf8mb4;\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.1.6','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.1.6 收款码显示、短信测试与师傅身份关联已更新' AS `升级结果`;\n","server/database/upgrades/2.1.7.sql":"-- 2026-09-14：V2.1.7 订单审核、派单时限、验收结算、证据链与售后保障升级。\n-- 兼容 MySQL 5.7.44；所有字段变更均按 information_schema 判断后执行，可重复运行。\nSET NAMES utf8mb4;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='supplement_due_at')=0,\n  'ALTER TABLE orders ADD COLUMN supplement_due_at DATETIME NULL AFTER audit_note','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='warranty_months')=0,\n  'ALTER TABLE orders ADD COLUMN warranty_months SMALLINT UNSIGNED NULL AFTER auto_review_at','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='warranty_expires_at')=0,\n  'ALTER TABLE orders ADD COLUMN warranty_expires_at DATETIME NULL AFTER warranty_months','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='warranty_note')=0,\n  'ALTER TABLE orders ADD COLUMN warranty_note VARCHAR(500) NULL AFTER warranty_expires_at','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='order_deadlines' AND column_name='reminded_at')=0,\n  'ALTER TABLE order_deadlines ADD COLUMN reminded_at DATETIME NULL AFTER due_at','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='assignments' AND column_name='accept_deadline_at')=0,\n  'ALTER TABLE assignments ADD COLUMN accept_deadline_at DATETIME NULL AFTER offered_at','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.statistics WHERE table_schema=DATABASE() AND table_name='assignments' AND index_name='idx_assignments_offer_deadline')=0,\n  'ALTER TABLE assignments ADD KEY idx_assignments_offer_deadline (status,accept_deadline_at)','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='exceptional_arrivals' AND column_name='evidence_media_ids_json')=0,\n  'ALTER TABLE exceptional_arrivals ADD COLUMN evidence_media_ids_json LONGTEXT NULL AFTER coordinate_system','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='exceptional_arrivals' AND column_name='watermark_metadata_json')=0,\n  'ALTER TABLE exceptional_arrivals ADD COLUMN watermark_metadata_json LONGTEXT NULL AFTER evidence_media_ids_json','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='run_empty_fee_claims' AND column_name='evidence_media_ids_json')=0,\n  'ALTER TABLE run_empty_fee_claims ADD COLUMN evidence_media_ids_json LONGTEXT NULL AFTER reason','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='run_empty_fee_claims' AND column_name='watermark_metadata_json')=0,\n  'ALTER TABLE run_empty_fee_claims ADD COLUMN watermark_metadata_json LONGTEXT NULL AFTER evidence_media_ids_json','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='completion_submissions' AND column_name='warranty_months')=0,\n  'ALTER TABLE completion_submissions ADD COLUMN warranty_months SMALLINT UNSIGNED NULL AFTER accepted_type','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='completion_submissions' AND column_name='warranty_expires_at')=0,\n  'ALTER TABLE completion_submissions ADD COLUMN warranty_expires_at DATETIME NULL AFTER warranty_months','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='completion_submissions' AND column_name='warranty_note')=0,\n  'ALTER TABLE completion_submissions ADD COLUMN warranty_note VARCHAR(500) NULL AFTER warranty_expires_at','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='commission_receivables' AND column_name='is_provisional')=0,\n  'ALTER TABLE commission_receivables ADD COLUMN is_provisional TINYINT UNSIGNED NOT NULL DEFAULT 0 AFTER amount_paid_cents','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='commission_receivables' AND column_name='finalized_at')=0,\n  'ALTER TABLE commission_receivables ADD COLUMN finalized_at DATETIME NULL AFTER is_provisional','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='commission_receivables' AND column_name='overpaid_cents')=0,\n  'ALTER TABLE commission_receivables ADD COLUMN overpaid_cents BIGINT UNSIGNED NOT NULL DEFAULT 0 AFTER finalized_at','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='commission_receivables' AND column_name='worker_credit_cents')=0,\n  'ALTER TABLE commission_receivables ADD COLUMN worker_credit_cents BIGINT UNSIGNED NOT NULL DEFAULT 0 AFTER overpaid_cents','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='after_sales' AND column_name='warranty_months_snapshot')=0,\n  'ALTER TABLE after_sales ADD COLUMN warranty_months_snapshot SMALLINT UNSIGNED NULL AFTER description','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='after_sales' AND column_name='warranty_expires_at_snapshot')=0,\n  'ALTER TABLE after_sales ADD COLUMN warranty_expires_at_snapshot DATETIME NULL AFTER warranty_months_snapshot','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='after_sales' AND column_name='non_human_confirmed')=0,\n  'ALTER TABLE after_sales ADD COLUMN non_human_confirmed TINYINT UNSIGNED NOT NULL DEFAULT 0 AFTER warranty_expires_at_snapshot','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\nSET @sql = IF((SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='after_sales' AND column_name='evidence_media_ids_json')=0,\n  'ALTER TABLE after_sales ADD COLUMN evidence_media_ids_json LONGTEXT NULL AFTER non_human_confirmed','SELECT 1'); PREPARE s FROM @sql; EXECUTE s; DEALLOCATE PREPARE s;\n\nUPDATE assignments SET accept_deadline_at=DATE_ADD(offered_at,INTERVAL 24 HOUR) WHERE accept_deadline_at IS NULL AND status='offered';\nUPDATE orders SET supplement_due_at=DATE_ADD(COALESCE(updated_at,UTC_TIMESTAMP()),INTERVAL 72 HOUR) WHERE audit_status='supplement_required' AND lifecycle_status='active' AND supplement_due_at IS NULL;\nINSERT IGNORE INTO order_deadlines(order_id,deadline_type,status,version,due_at,created_at,updated_at)\nSELECT id,'audit_supplement_timeout','pending',version,supplement_due_at,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM orders WHERE audit_status='supplement_required' AND lifecycle_status='active' AND supplement_due_at IS NOT NULL;\nUPDATE commission_receivables c JOIN orders o ON o.id=c.order_id\nSET c.is_provisional=IF(o.accepted_at IS NULL,1,0), c.finalized_at=IF(o.accepted_at IS NOT NULL,COALESCE(c.finalized_at,o.accepted_at),NULL)\nWHERE c.is_provisional=0 AND o.accepted_at IS NULL;\n\nINSERT INTO database_field_dictionary(table_name,field_name,chinese_name,description,created_at,updated_at) VALUES\n('assignments','accept_deadline_at','接单截止时间','派单后 24 小时内接受或拒绝，超时自动释放',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','warranty_months','售后保障月数','完工时填写的非人为原因维修保障期限',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('after_sales','non_human_confirmed','非人为原因确认','用户申请维修时确认问题并非人为因素造成',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('run_empty_fee_claims','evidence_media_ids_json','跑空费证据图片','到场异常或跑空费申报关联的带水印图片编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('commission_receivables','is_provisional','预计应收标记','验收前仅为预计服务费，验收后才转正式应收',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE chinese_name=VALUES(chinese_name),description=VALUES(description),updated_at=UTC_TIMESTAMP();\n\nINSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,updated_by,created_at,updated_at) VALUES\n('app.version','2.1.7','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order.assignment_accept_hours','24','integer','order',1,'平台派单后师傅接受或拒绝的小时数，超时自动释放',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order.supplement_timeout_hours','72','integer','order',1,'待补资料订单超过该小时数自动取消并退款',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order.supplement_reminder_hours','24','integer','order',1,'待补资料到期前提醒小时数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('media.jpeg_quality','90','integer','media',1,'服务端高质量 JPEG 重编码质量，超出大小限制时自适应下降',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),description=VALUES(description),updated_at=UTC_TIMESTAMP();\n\nSELECT 'V2.1.7 订单审核、派单时限、验收结算、证据链与售后保障已更新' AS `升级结果`;\n","server/database/upgrades/2.1.8.sql":"-- 2026-09-15：V2.1.8 作为 V2.1.7 之后的代码修复增量，仅同步运行版本，不重复执行 V2.1.7 结构迁移。\n-- 本脚本只包含可重复执行的数据语句，允许失败后安全重试。\nSET NAMES utf8mb4;\n\nINSERT INTO system_settings\n  (setting_key, setting_value, value_type, group_name, is_public, description, updated_by, created_at, updated_at)\nVALUES\n  ('app.version', '2.1.8', 'string', 'system', 1, '当前后台和数据库基线版本', NULL, UTC_TIMESTAMP(), UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  setting_value = VALUES(setting_value),\n  value_type = VALUES(value_type),\n  group_name = VALUES(group_name),\n  is_public = VALUES(is_public),\n  description = VALUES(description),\n  updated_at = UTC_TIMESTAMP();\n\nSELECT 'V2.1.8 代码修复增量版本已更新' AS `升级结果`;\n","server/database/upgrades/2.1.9.sql":"-- 2026-09-15：V2.1.9 面向已完成 V2.1.8 的代码修复，仅同步运行版本。\n-- 本脚本只包含可重复执行的数据语句，允许失败后安全重试；不重复执行任何结构迁移。\nSET NAMES utf8mb4;\n\nINSERT INTO system_settings\n  (setting_key, setting_value, value_type, group_name, is_public, description, updated_by, created_at, updated_at)\nVALUES\n  ('app.version', '2.1.9', 'string', 'system', 1, '当前后台和数据库基线版本', NULL, UTC_TIMESTAMP(), UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  setting_value = VALUES(setting_value),\n  value_type = VALUES(value_type),\n  group_name = VALUES(group_name),\n  is_public = VALUES(is_public),\n  description = VALUES(description),\n  updated_at = UTC_TIMESTAMP();\n\nSELECT 'V2.1.9 代码修复增量版本已更新' AS `升级结果`;\n","server/database/upgrades/2.2.0.sql":"-- 2026-09-15：V2.2.0 发布代码复审修复；数据库无结构变更，仅同步运行版本。\n-- 本脚本只包含可重复执行的数据语句，允许失败后安全重试。\nSET NAMES utf8mb4;\n\nINSERT INTO system_settings\n  (setting_key, setting_value, value_type, group_name, is_public, description, updated_by, created_at, updated_at)\nVALUES\n  ('app.version', '2.2.0', 'string', 'system', 1, '当前后台和数据库基线版本', NULL, UTC_TIMESTAMP(), UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  setting_value = VALUES(setting_value),\n  value_type = VALUES(value_type),\n  group_name = VALUES(group_name),\n  is_public = VALUES(is_public),\n  description = VALUES(description),\n  updated_at = UTC_TIMESTAMP();\n\nSELECT 'V2.2.0 代码复审版本已更新' AS `升级结果`;\n","server/database/upgrades/2.2.1.sql":"-- 2026-09-15：V2.2.1 重建编号演示订单，并修复关闭演示数据后的服务费逾期扫描隔离。\n-- 仅清理 orders.is_demo=1 或 public_no 为 WO-DEMO-* 的模拟订单及其关联业务数据；保留用户/师傅主档、提现和非订单余额。\n-- 本文件只含可重复执行的数据语句（DELETE、INSERT、UPDATE），不含 DDL、事务控制、SET 或独立 SELECT。\n\n-- 清理订单通知和待投递消息，只按订单 JSON ID 或订单事件业务键匹配。\nDELETE n\nFROM `notifications` n\nINNER JOIN `orders` o ON (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n  AND CASE WHEN JSON_VALID(n.`data_json`) THEN CAST(JSON_UNQUOTE(JSON_EXTRACT(n.`data_json`,'$.order_id')) AS UNSIGNED) ELSE NULL END=o.`id`;\n\nDELETE mo\nFROM `message_outbox` mo\nINNER JOIN `orders` o ON (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n  AND (mo.`business_key` LIKE CONCAT('%:order:',o.`id`,':%')\n    OR CASE WHEN JSON_VALID(mo.`payload_json`) THEN CAST(JSON_UNQUOTE(JSON_EXTRACT(mo.`payload_json`,'$.order_id')) AS UNSIGNED) ELSE NULL END=o.`id`);\n\nDELETE sjc\nFROM `scheduled_job_claims` sjc\nWHERE EXISTS (\n  SELECT 1 FROM `orders` o\n  WHERE (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n    AND (sjc.`business_key`=CONCAT('order:',o.`id`)\n      OR sjc.`business_key` LIKE CONCAT('order:',o.`id`,':%')\n      OR EXISTS (SELECT 1 FROM `assignments` a WHERE a.`order_id`=o.`id` AND sjc.`business_key`=CONCAT('assignment:',a.`id`)))\n);\n\nDELETE sjf\nFROM `scheduled_job_failures` sjf\nWHERE EXISTS (\n  SELECT 1 FROM `orders` o\n  WHERE (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n    AND (sjf.`business_key`=CONCAT('order:',o.`id`)\n      OR sjf.`business_key` LIKE CONCAT('order:',o.`id`,':%')\n      OR EXISTS (SELECT 1 FROM `assignments` a WHERE a.`order_id`=o.`id` AND sjf.`business_key`=CONCAT('assignment:',a.`id`)))\n);\n\n-- 先按外键依赖删除订单链最深层记录。媒体文件本身保留，避免误删被其他业务引用的物理图片。\n-- 先把将受影响图片的引用数设为删除模拟关联后的实际剩余关联数；语句可重复执行且不会删除物理文件。\nUPDATE `media_files` mf\nINNER JOIN (\n  SELECT DISTINCT ml.`media_file_id`\n  FROM `media_links` ml\n  INNER JOIN `orders` o ON ml.`entity_type`='order' AND ml.`entity_id`=o.`id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n  UNION\n  SELECT DISTINCT ml.`media_file_id`\n  FROM `media_links` ml\n  INNER JOIN `reviews` r ON ml.`entity_type`='review' AND ml.`entity_id`=r.`id`\n  INNER JOIN `orders` o ON o.`id`=r.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n  UNION\n  SELECT DISTINCT rm.`media_file_id`\n  FROM `review_media` rm\n  INNER JOIN `reviews` r ON r.`id`=rm.`review_id`\n  INNER JOIN `orders` o ON o.`id`=r.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n) affected_media ON affected_media.`media_file_id`=mf.`id`\nSET mf.`reference_count`=(\n  SELECT COUNT(*)\n  FROM `media_links` retained\n  WHERE retained.`media_file_id`=mf.`id`\n    AND NOT (\n      (retained.`entity_type`='order' AND EXISTS (\n        SELECT 1 FROM `orders` o\n        WHERE o.`id`=retained.`entity_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n      ))\n      OR (retained.`entity_type`='review' AND EXISTS (\n        SELECT 1 FROM `reviews` r\n        INNER JOIN `orders` o ON o.`id`=r.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n        WHERE r.`id`=retained.`entity_id`\n      ))\n    )\n);\n\nDELETE rm\nFROM `review_media` rm\nINNER JOIN `reviews` r ON r.`id`=rm.`review_id`\nINNER JOIN `orders` o ON o.`id`=r.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ml\nFROM `media_links` ml\nINNER JOIN `reviews` r ON r.`id`=ml.`entity_id` AND ml.`entity_type`='review'\nINNER JOIN `orders` o ON o.`id`=r.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE rr\nFROM `review_replies` rr\nINNER JOIN `reviews` r ON r.`id`=rr.`review_id`\nINNER JOIN `orders` o ON o.`id`=r.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE de\nFROM `dispute_evidence` de\nINNER JOIN `disputes` d ON d.`id`=de.`dispute_id`\nINNER JOIN `orders` o ON o.`id`=d.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE qi\nFROM `quote_items` qi\nINNER JOIN `quote_versions` qv ON qv.`id`=qi.`quote_version_id`\nINNER JOIN `quotes` q ON q.`id`=qv.`quote_id`\nINNER JOIN `orders` o ON o.`id`=q.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE cp\nFROM `commission_payments` cp\nINNER JOIN `commission_receivables` cr ON cr.`id`=cp.`receivable_id`\nINNER JOIN `orders` o ON o.`id`=cr.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ca\nFROM `commission_adjustments` ca\nINNER JOIN `commission_receivables` cr ON cr.`id`=ca.`receivable_id`\nINNER JOIN `orders` o ON o.`id`=cr.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE pn\nFROM `payment_notifications` pn\nINNER JOIN `payment_orders` p ON p.`id`=pn.`payment_order_id`\nLEFT JOIN `orders` o ON o.`id`=p.`order_id`\nLEFT JOIN `commission_receivables` cr ON p.`business_type`='commission' AND cr.`id`=p.`business_id`\nLEFT JOIN `orders` oc ON oc.`id`=cr.`order_id`\nWHERE (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n   OR (oc.`is_demo`=1 OR oc.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ci\nFROM `change_items` ci\nINNER JOIN `change_requests` c ON c.`id`=ci.`change_request_id`\nINNER JOIN `orders` o ON o.`id`=c.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE cc\nFROM `change_confirmations` cc\nINNER JOIN `change_requests` c ON c.`id`=cc.`change_request_id`\nINNER JOIN `orders` o ON o.`id`=c.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ah\nFROM `assignment_history` ah\nINNER JOIN `assignments` a ON a.`id`=ah.`assignment_id`\nINNER JOIN `orders` o ON o.`id`=a.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE od\nFROM `order_cancel_decisions` od\nINNER JOIN `orders` o ON o.`id`=od.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE rf\nFROM `refunds` rf\nLEFT JOIN `orders` od ON od.`id`=rf.`order_id`\nLEFT JOIN `payment_orders` p ON p.`id`=rf.`payment_order_id`\nLEFT JOIN `orders` op ON op.`id`=p.`order_id`\nLEFT JOIN `order_cancel_requests` cr ON cr.`id`=rf.`cancel_request_id`\nLEFT JOIN `orders` oc ON oc.`id`=cr.`order_id`\nWHERE (od.`is_demo`=1 OR od.`public_no` LIKE 'WO-DEMO-%')\n   OR (op.`is_demo`=1 OR op.`public_no` LIKE 'WO-DEMO-%')\n   OR (oc.`is_demo`=1 OR oc.`public_no` LIKE 'WO-DEMO-%');\n\n-- 只删能通过演示应收/争议/跑空申请精确关联到模拟订单的师傅流水，不触碰提现、真实余额或其他业务流水。\nDELETE l\nFROM `worker_balance_ledger` l\nINNER JOIN `commission_receivables` cr ON l.`business_type`='commission' AND l.`business_id`=cr.`id`\nINNER JOIN `orders` o ON o.`id`=cr.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE l\nFROM `worker_balance_ledger` l\nINNER JOIN `disputes` d ON l.`business_type`='dispute' AND l.`business_id`=d.`id`\nINNER JOIN `orders` o ON o.`id`=d.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE l\nFROM `worker_balance_ledger` l\nINNER JOIN `run_empty_fee_claims` c ON l.`business_type` IN ('run_empty_claim','run_empty_fee') AND l.`business_id`=c.`id`\nINNER JOIN `orders` o ON o.`id`=c.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE cr\nFROM `commission_receivables` cr\nINNER JOIN `orders` o ON o.`id`=cr.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE r\nFROM `reviews` r\nINNER JOIN `orders` o ON o.`id`=r.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\n-- 演示订单评价删除后，仅为曾接过模拟单的师傅重算评分和完成单量，保留其余真实评价与真实订单统计。\nINSERT INTO `rating_summaries` (`worker_id`,`review_count`,`rating_sum`,`rating_average`,`five_star_count`,`updated_at`)\nSELECT affected.`worker_id`,COUNT(r.`id`),COALESCE(SUM(r.`rating`),0),COALESCE(AVG(r.`rating`),5.00),COALESCE(SUM(CASE WHEN r.`rating`=5 THEN 1 ELSE 0 END),0),UTC_TIMESTAMP()\nFROM (\n  SELECT DISTINCT a.`worker_id`\n  FROM `assignments` a\n  INNER JOIN `orders` o ON o.`id`=a.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n  UNION\n  SELECT DISTINCT o.`assigned_worker_id` AS `worker_id`\n  FROM `orders` o\n  WHERE (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%') AND o.`assigned_worker_id` IS NOT NULL\n) affected\nLEFT JOIN `reviews` r ON r.`worker_id`=affected.`worker_id` AND r.`status`='visible'\nGROUP BY affected.`worker_id`\nON DUPLICATE KEY UPDATE `review_count`=VALUES(`review_count`),`rating_sum`=VALUES(`rating_sum`),`rating_average`=VALUES(`rating_average`),`five_star_count`=VALUES(`five_star_count`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `worker_profiles` wp\nINNER JOIN (\n  SELECT DISTINCT a.`worker_id`\n  FROM `assignments` a\n  INNER JOIN `orders` o ON o.`id`=a.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n  UNION\n  SELECT DISTINCT o.`assigned_worker_id` AS `worker_id`\n  FROM `orders` o\n  WHERE (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%') AND o.`assigned_worker_id` IS NOT NULL\n) affected ON affected.`worker_id`=wp.`id`\nLEFT JOIN `rating_summaries` rs ON rs.`worker_id`=wp.`id`\nSET wp.`rating`=COALESCE(rs.`rating_average`,5.00),\n    wp.`completed_orders`=(SELECT COUNT(*) FROM `orders` real_order WHERE real_order.`assigned_worker_id`=wp.`id` AND real_order.`accepted_at` IS NOT NULL AND NOT (real_order.`is_demo`=1 OR real_order.`public_no` LIKE 'WO-DEMO-%')),\n    wp.`updated_at`=UTC_TIMESTAMP();\n\nDELETE claim\nFROM `run_empty_fee_claims` claim\nINNER JOIN `orders` o ON o.`id`=claim.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE d\nFROM `disputes` d\nINNER JOIN `orders` o ON o.`id`=d.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE af\nFROM `after_sales` af\nINNER JOIN `orders` o ON o.`id`=af.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE oc\nFROM `order_cancel_requests` oc\nINNER JOIN `orders` o ON o.`id`=oc.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE cs\nFROM `completion_submissions` cs\nINNER JOIN `orders` o ON o.`id`=cs.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE delay_row\nFROM `offline_payment_delay_requests` delay_row\nINNER JOIN `orders` o ON o.`id`=delay_row.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE adjust_row\nFROM `offline_collection_adjustment_requests` adjust_row\nINNER JOIN `orders` o ON o.`id`=adjust_row.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE c\nFROM `change_requests` c\nINNER JOIN `orders` o ON o.`id`=c.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ap\nFROM `appointment_records` ap\nINNER JOIN `orders` o ON o.`id`=ap.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ea\nFROM `exceptional_arrivals` ea\nINNER JOIN `orders` o ON o.`id`=ea.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE org\nFROM `order_role_grants` org\nINNER JOIN `orders` o ON o.`id`=org.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE a\nFROM `assignments` a\nINNER JOIN `orders` o ON o.`id`=a.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE it\nFROM `invite_tokens` it\nINNER JOIN `orders` o ON o.`id`=it.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE sc\nFROM `share_contexts` sc\nINNER JOIN `orders` o ON o.`id`=sc.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE qs\nFROM `quote_selections` qs\nINNER JOIN `orders` o ON o.`id`=qs.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE qv\nFROM `quote_versions` qv\nINNER JOIN `quotes` q ON q.`id`=qv.`quote_id`\nINNER JOIN `orders` o ON o.`id`=q.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE q\nFROM `quotes` q\nINNER JOIN `orders` o ON o.`id`=q.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE crv\nFROM `commission_rule_versions` crv\nINNER JOIN `orders` o ON o.`id`=crv.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE p\nFROM `payment_orders` p\nLEFT JOIN `orders` o ON o.`id`=p.`order_id`\nLEFT JOIN `commission_receivables` cr ON p.`business_type`='commission' AND cr.`id`=p.`business_id`\nLEFT JOIN `orders` oc ON oc.`id`=cr.`order_id`\nWHERE (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%')\n   OR (oc.`is_demo`=1 OR oc.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE mr\nFROM `merchant_risk_events` mr\nINNER JOIN `orders` o ON o.`id`=mr.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE dl\nFROM `order_deadlines` dl\nINNER JOIN `orders` o ON o.`id`=dl.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ev\nFROM `order_events` ev\nINNER JOIN `orders` o ON o.`id`=ev.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE rev\nFROM `order_revisions` rev\nINNER JOIN `orders` o ON o.`id`=rev.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ans\nFROM `order_answers` ans\nINNER JOIN `orders` o ON o.`id`=ans.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE addr\nFROM `order_addresses` addr\nINNER JOIN `orders` o ON o.`id`=addr.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE cat\nFROM `order_categories` cat\nINNER JOIN `orders` o ON o.`id`=cat.`order_id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE ml\nFROM `media_links` ml\nINNER JOIN `orders` o ON ml.`entity_type`='order' AND ml.`entity_id`=o.`id` AND (o.`is_demo`=1 OR o.`public_no` LIKE 'WO-DEMO-%');\n\nDELETE FROM `reconciliation_records`\nWHERE `internal_no` LIKE 'PAY-DEMO-%' OR `internal_no` LIKE 'REF-DEMO-%'\n   OR `internal_no` LIKE 'PAY-V204-%' OR `internal_no` LIKE 'PAY-V213-%'\n   OR `internal_no` LIKE 'REF-V204-%' OR `internal_no` LIKE 'REF-V213-%';\n\nDELETE FROM `orders` WHERE `is_demo`=1 OR `public_no` LIKE 'WO-DEMO-%';\n\n-- 重建全套编号演示单。所有联系方式均为虚构脱敏值，支付/退款流水均使用 DEMO 标识。\n-- 真实收款凭证、完工照、到场异常水印和维修照片不造假；相应订单保持在等待真实测试证据的阶段。\nINSERT INTO `orders` (\n  `public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,\n  `city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`audit_note`,`supplement_due_at`,\n  `publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`assigned_worker_id`,\n  `final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`completion_submitted_at`,`auto_accept_at`,\n  `accepted_at`,`auto_review_at`,`warranty_months`,`warranty_expires_at`,`warranty_note`,`cancelled_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`\n)\nSELECT f.`public_no`,demo_customer.`id`,\n  (SELECT `id` FROM `form_schema_versions` WHERE CAST(`status` AS BINARY)=CAST('published' AS BINARY) ORDER BY `version_no` DESC,`id` DESC LIMIT 1),\n  c.`id`,f.`category_name`,f.`category_names_snapshot`,f.`title`,f.`description`,f.`quantity_text`,\n  '杭州市',f.`district`,CONCAT('浙江省杭州市',f.`district`,'（虚构演示地址）'),'演示用户','130****0000',f.`audit_status`,f.`audit_note`,\n  IF(f.`supplement_hours_from_now` IS NULL,NULL,DATE_ADD(UTC_TIMESTAMP(),INTERVAL f.`supplement_hours_from_now` HOUR)),\n  f.`publish_status`,f.`quote_status`,f.`assignment_status`,f.`fulfillment_status`,f.`payment_status`,f.`refund_status`,f.`dispute_status`,f.`lifecycle_status`,\n  IF(f.`has_worker`=1,dw.`id`,NULL),f.`final_amount_cents`,f.`booking_fee_cents`,1000,5000,\n  IF(f.`published_days_ago` IS NULL,NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`published_days_ago` DAY)),\n  IF(f.`quote_days_from_now` IS NULL,NULL,DATE_ADD(UTC_TIMESTAMP(),INTERVAL f.`quote_days_from_now` DAY)),\n  IF(f.`completion_hours_ago` IS NULL,NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`completion_hours_ago` HOUR)),\n  IF(f.`completion_hours_ago` IS NULL,NULL,DATE_ADD(DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`completion_hours_ago` HOUR),INTERVAL 72 HOUR)),\n  IF(f.`accepted_days_ago` IS NULL,NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`accepted_days_ago` DAY)),\n  IF(f.`auto_review_days_from_now` IS NULL,NULL,DATE_ADD(UTC_TIMESTAMP(),INTERVAL f.`auto_review_days_from_now` DAY)),\n  f.`warranty_months`,\n  CASE WHEN f.`warranty_months` IS NULL THEN NULL WHEN f.`warranty_expired`=1 THEN DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 DAY) ELSE DATE_ADD(DATE_SUB(UTC_TIMESTAMP(),INTERVAL COALESCE(f.`completion_hours_ago`,0) HOUR),INTERVAL f.`warranty_months` MONTH) END,\n  IF(f.`warranty_months` IS NULL,NULL,'非人为因素维修保障测试样例；不代表真实服务承诺。'),\n  IF(f.`cancelled_days_ago` IS NULL,NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`cancelled_days_ago` DAY)),\n  IF(f.`closed_days_ago` IS NULL,NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`closed_days_ago` DAY)),\n  CASE WHEN CAST(f.`dispute_status` AS BINARY)=CAST('open' AS BINARY) THEN 4 WHEN CAST(f.`lifecycle_status` AS BINARY)=CAST('completed' AS BINARY) THEN 4 WHEN f.`completion_hours_ago` IS NOT NULL THEN 3 WHEN CAST(f.`assignment_status` AS BINARY) IN (CAST('offered' AS BINARY),CAST('accepted' AS BINARY)) THEN 2 WHEN CAST(f.`audit_status` AS BINARY)=CAST('supplement_required' AS BINARY) THEN 2 ELSE 1 END,\n  1,DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`created_days_ago` DAY),UTC_TIMESTAMP()\nFROM (\n  SELECT 1 AS `sort_no`,'WO-DEMO-V221-01' AS `public_no`,'wallpaper' AS `category_key`,'墙纸' AS `category_name`,'墙纸' AS `category_names_snapshot`,'1、草稿待付预约费-审核前付款' AS `title`,'草稿等待支付预约费，验证付款前不进入正式审核或派单。' AS `description`,'约 30 平方米' AS `quantity_text`,'西湖区' AS `district`,'draft' AS `audit_status`,NULL AS `audit_note`,'hidden' AS `publish_status`,'waiting' AS `quote_status`,'unassigned' AS `assignment_status`,'not_started' AS `fulfillment_status`,'awaiting_payment' AS `payment_status`,'none' AS `refund_status`,'none' AS `dispute_status`,'active' AS `lifecycle_status`,0 AS `has_worker`,0 AS `final_amount_cents`,5000 AS `booking_fee_cents`,NULL AS `published_days_ago`,NULL AS `quote_days_from_now`,NULL AS `supplement_hours_from_now`,NULL AS `completion_hours_ago`,NULL AS `accepted_days_ago`,NULL AS `auto_review_days_from_now`,NULL AS `warranty_months`,0 AS `warranty_expired`,NULL AS `cancelled_days_ago`,NULL AS `closed_days_ago`,1 AS `created_days_ago`\n  UNION ALL SELECT 2,'WO-DEMO-V221-02','wallpaper','墙纸','墙纸','2、已付待审核-测试驳回即取消退款','预约费已支付，等待管理员审核；支付单号为 DEMO，不是真实微信交易。','约 45 平方米','拱墅区','pending',NULL,'hidden','waiting','unassigned','not_started','paid','none','none','active',0,0,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,NULL,NULL,2\n  UNION ALL SELECT 3,'WO-DEMO-V221-03','wall_cloth','墙布','墙布','3、待补资料-临期提醒与超时退款','待补资料期限设为未来 48 小时，供观察提醒与退款任务；不会在升级后立即自动取消。','约 60 平方米','上城区','supplement_required','请补充现场墙面全景及施工要求。','hidden','waiting','unassigned','not_started','paid','none','none','active',0,0,5000,NULL,NULL,48,NULL,NULL,NULL,NULL,0,NULL,NULL,3\n  UNION ALL SELECT 4,'WO-DEMO-V221-04','wallpaper','墙纸','墙纸、墙布','4、多类目报价中-报价无有效期','墙纸与墙布两个类目；同时存在师傅报价和平台报价，报价 expires_at 均为空。','约 45 平方米','西湖区','approved',NULL,'published','quoting','unassigned','not_started','paid','none','none','active',0,0,5000,1,6,NULL,NULL,NULL,NULL,NULL,0,NULL,NULL,2\n  UNION ALL SELECT 5,'WO-DEMO-V221-05','wall_cloth','墙布','墙布','5、派单待响应-剩余约 1 小时','师傅派单已发出约 23 小时，测试接受、拒绝及 24 小时超时释放。','约 70 平方米','滨江区','approved',NULL,'hidden','selected','offered','not_started','paid','none','none','active',1,120000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,NULL,NULL,3\n  UNION ALL SELECT 6,'WO-DEMO-V221-06','wallpaper','墙纸','墙纸','6、师傅已拒绝-订单已释放','已拒绝的派单保留历史记录，订单不再绑定该师傅或开放其联系方式。','约 35 平方米','余杭区','approved',NULL,'hidden','selected','unassigned','not_started','paid','none','none','active',0,85000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,NULL,NULL,3\n  UNION ALL SELECT 7,'WO-DEMO-V221-07','curtain','窗帘','窗帘','7、已接单待预约-核验角色权限','师傅已接单并登记明日上门预约，联系方式仍按当前角色权限读取。','2 套','上城区','approved',NULL,'hidden','selected','accepted','scheduled','paid','none','none','active',1,86000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,NULL,NULL,4\n  UNION ALL SELECT 8,'WO-DEMO-V221-08','wall_cloth','墙布','墙布','8、施工中待报到场异常-需真实水印证据','施工中，可由实际师傅测试到场异常上报；请现场拍摄真实图片，不预置伪造的时间/位置水印。','约 72 平方米','萧山区','approved',NULL,'hidden','selected','accepted','in_progress','paid','none','none','active',1,138000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,NULL,NULL,4\n  UNION ALL SELECT 9,'WO-DEMO-V221-09','furniture_film','家具膜','家具膜','9、完工待验收-预计服务费已预付 30 元','完工已提交，预计服务费已预付 30 元；故意不附收款凭证，当前不可验收。','12 件','余杭区','approved',NULL,'hidden','selected','accepted','submitted','paid','none','none','active',1,150000,5000,NULL,NULL,NULL,12,NULL,NULL,12,0,NULL,NULL,2\n  UNION ALL SELECT 10,'WO-DEMO-V221-10','wall_cloth','墙布','墙布','10、完工争议中-验收与自动验收应阻断','存在未裁决施工争议；仅保留文本演示说明，不伪造争议照片或收款凭证。','约 55 平方米','西湖区','approved',NULL,'hidden','selected','accepted','submitted','paid','none','open','active',1,120000,5000,NULL,NULL,NULL,18,NULL,NULL,6,0,NULL,NULL,4\n  UNION ALL SELECT 11,'WO-DEMO-V221-11','wallpaper','墙纸','墙纸','11、完工待验收-预约费差额冻结中','预约费高于预计服务费 70 元，预计差额进入师傅冻结余额；需验收后释放。','约 28 平方米','钱塘区','approved',NULL,'hidden','selected','accepted','submitted','paid','none','none','active',1,80000,15000,NULL,NULL,NULL,10,NULL,NULL,24,0,NULL,NULL,2\n  UNION ALL SELECT 12,'WO-DEMO-V221-12','wallpaper','墙纸','墙纸','12、已验收-正式服务费待补缴','已验收并生成正式服务费，应补缴 70 元；到期时间留有测试缓冲。','约 60 平方米','临平区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,120000,5000,NULL,NULL,NULL,60,1,30,12,0,NULL,NULL,5\n  UNION ALL SELECT 13,'WO-DEMO-V221-13','curtain','窗帘','窗帘','13、已验收-预计服务费超缴退回余额','正式应收 50 元，演示预缴 70 元，多付的 20 元进入师傅可用余额；支付单均标记 DEMO。','3 套','滨江区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,100000,5000,NULL,NULL,NULL,70,2,30,12,0,NULL,NULL,7\n  UNION ALL SELECT 14,'WO-DEMO-V221-14','glass_film','玻璃膜','玻璃膜','14、已验收-预约费高于服务费结余','预约费 150 元高于正式服务费 80 元，70 元演示差额进入师傅可用余额。','约 32 平方米','滨江区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,80000,15000,NULL,NULL,NULL,90,3,30,6,0,NULL,NULL,8\n  UNION ALL SELECT 15,'WO-DEMO-V221-15','wall_cloth','墙布','墙布','15、维修保障 6 个月-非人为申请待处理','六个月保障期展示样例；维修申请明确标记非人为原因，不附伪造维修照片。','约 52 平方米','西湖区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,100000,5000,NULL,NULL,NULL,500,20,30,6,0,NULL,NULL,24\n  UNION ALL SELECT 16,'WO-DEMO-V221-16','wallpaper','墙纸','墙纸','16、维修保障 12 个月-期限内展示','十二个月保障期限内的已验收订单展示样例。','约 48 平方米','拱墅区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,110000,5000,NULL,NULL,NULL,720,30,30,12,0,NULL,NULL,34\n  UNION ALL SELECT 17,'WO-DEMO-V221-17','curtain','窗帘','窗帘','17、维修保障 24 个月-期限内展示','二十四个月保障期限内的已验收订单展示样例。','4 套','上城区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,160000,5000,NULL,NULL,NULL,1440,60,30,24,0,NULL,NULL,64\n  UNION ALL SELECT 18,'WO-DEMO-V221-18','furniture_film','家具膜','家具膜','18、自填维修保障 18 个月-申请处理中','自定义十八个月保障期限样例，维修申请状态为处理中。','10 件','余杭区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,98000,5000,NULL,NULL,NULL,960,40,30,18,0,NULL,NULL,44\n  UNION ALL SELECT 19,'WO-DEMO-V221-19','wallpaper','墙纸','墙纸','19、维修保障已过期-申请应拒绝','三个月保障期已过，供检查过期后维修申请必须被拒绝。','约 40 平方米','富阳区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,98000,5000,NULL,NULL,NULL,2400,100,30,3,1,NULL,NULL,104\n  UNION ALL SELECT 20,'WO-DEMO-V221-20','wallpaper','墙纸','墙纸','20、已取消退款成功-历史结果核验','历史取消流程已完成，演示预约费退款成功；微信交易号和退款号均为 DEMO。','约 30 平方米','钱塘区','approved',NULL,'hidden','cancelled','cancelled','cancelled','refunded','succeeded','none','cancelled',0,0,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,2,2,5\n  UNION ALL SELECT 21,'WO-DEMO-V221-21','wallpaper','墙纸','墙纸','21、已验收待自动评价-期限在未来','已验收样例，自动评价时间设在未来 4 天，恰为验收后 5 天，避免升级后立即被计划任务改写。','约 50 平方米','西湖区','approved',NULL,'hidden','selected','completed','accepted','paid','none','none','completed',1,95000,5000,NULL,NULL,NULL,96,1,4,6,0,NULL,NULL,4\n  ) f\nINNER JOIN (SELECT COALESCE((SELECT `id` FROM `users` WHERE BINARY `public_id`=BINARY '4P6VCTD79R5B9QHYRWGNB7VBRG' LIMIT 1),(SELECT `id` FROM `users` WHERE BINARY `public_id`=BINARY 'BE20FMBCSMG6924JK21TE0RJTP' LIMIT 1)) AS `id`) demo_customer\nLEFT JOIN `service_categories` c ON CAST(c.`category_key` AS BINARY)=CAST(f.`category_key` AS BINARY)\nLEFT JOIN `worker_profiles` dw ON dw.`id`=COALESCE(\n  (SELECT `id` FROM `worker_profiles` WHERE BINARY `public_id`=BINARY '01K2DEMOWORKERPROFILE00001' LIMIT 1),\n  (SELECT wp.`id` FROM `worker_profiles` wp INNER JOIN `users` wu ON wu.`id`=wp.`user_id` WHERE BINARY wu.`public_id`=BINARY '4P6VCTD79R5B9QHYRWGNB7VBRG' ORDER BY wp.`id` LIMIT 1)\n)\nORDER BY f.`sort_no` DESC;\n\n-- 类目、脱敏地址和少量答案快照，地址及联系电话均为虚构数据。\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`)\nSELECT o.`id`,o.`category_id`,o.`category_name_snapshot`,0,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no` LIKE 'WO-DEMO-V221-%' AND o.`category_id` IS NOT NULL;\n\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`)\nSELECT o.`id`,c.`id`,c.`name`,10,UTC_TIMESTAMP()\nFROM `orders` o INNER JOIN `service_categories` c ON c.`category_key`='wall_cloth'\nWHERE o.`public_no`='WO-DEMO-V221-04';\n\nINSERT INTO `order_addresses` (`order_id`,`province`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`created_at`,`updated_at`)\nSELECT o.`id`,'浙江省',o.`city`,o.`district`,o.`address_summary`,o.`contact_name_masked`,o.`contact_mobile_masked`,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no` LIKE 'WO-DEMO-V221-%';\n\nINSERT INTO `order_answers` (`order_id`,`field_id`,`field_key_snapshot`,`field_label_snapshot`,`value_json`,`display_value`,`sort_order`,`created_at`,`updated_at`)\nSELECT o.`id`,NULL,a.`field_key`,a.`field_label`,a.`value_json`,a.`display_value`,a.`sort_order`,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM (\n  SELECT 'WO-DEMO-V221-04' AS `public_no`,'quantity' AS `field_key`,'施工数量' AS `field_label`,'\"约 45 平方米\"' AS `value_json`,'约 45 平方米' AS `display_value`,10 AS `sort_order`\n  UNION ALL SELECT 'WO-DEMO-V221-04','wall_height','墙面高度','\"2.8 米\"','2.8 米',20\n  UNION ALL SELECT 'WO-DEMO-V221-07','quantity','施工数量','\"2 套\"','2 套',10\n  UNION ALL SELECT 'WO-DEMO-V221-08','quantity','施工数量','\"约 72 平方米\"','约 72 平方米',10\n) a INNER JOIN `orders` o ON CAST(o.`public_no` AS BINARY)=CAST(a.`public_no` AS BINARY);\n\n-- 每条订单时间线均明确表明是演示数据，避免排查时被误认作真实交易或服务记录。\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`from_state_json`,`to_state_json`,`payload_json`,`created_at`)\nSELECT o.`id`,'order_demo_seeded',CONCAT('demo-seed-v221:',o.`public_no`),'system',NULL,NULL,\n  JSON_OBJECT('audit_status',o.`audit_status`,'payment_status',o.`payment_status`,'lifecycle_status',o.`lifecycle_status`),\n  JSON_OBJECT('message',CONCAT(o.`title`,'（演示数据，仅用于测试，不代表真实服务或资金）'),'demo',TRUE,'seed_version','2.2.1'),o.`created_at`\nFROM `orders` o WHERE o.`public_no` LIKE 'WO-DEMO-V221-%';\n\n-- 订单预约费仅使用虚构交易编号；不存在真实微信交易。\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT CONCAT('PAY-DEMO-V221-',RIGHT(o.`public_no`,2)),'order_booking',o.`id`,o.`id`,o.`user_id`,'DEMO_OPENID_V221','DEMO_APPID','DEMO_MCHID','v3','CNY',o.`booking_fee_cents`,IF(o.`payment_status`='refunded','refunded','paid'),CONCAT('DEMO_TX_V221_BOOKING_',RIGHT(o.`public_no`,2)),'演示预约费，DEMO 交易，不是真实微信支付',DATE_ADD(o.`created_at`,INTERVAL 10 MINUTE),o.`created_at`,UTC_TIMESTAMP()\nFROM `orders` o\nWHERE o.`public_no` LIKE 'WO-DEMO-V221-%' AND o.`payment_status` IN ('paid','refunded');\n\n-- 多类目报价样例：师傅与平台报价均无有效期，报价版本各保留一条明细。\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`expires_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2('demo-v221-worker-quote',256),26),o.`id`,'worker',w.`id`,NULL,72000,o.`booking_fee_cents`,'师傅演示报价：基础施工和基层检查。','active',1,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o\nINNER JOIN `worker_profiles` w ON w.`id`=COALESCE((SELECT `id` FROM `worker_profiles` WHERE BINARY `public_id`=BINARY '01K2DEMOWORKERPROFILE00001' LIMIT 1),(SELECT wp.`id` FROM `worker_profiles` wp INNER JOIN `users` u ON u.`id`=wp.`user_id` WHERE BINARY u.`public_id`=BINARY '4P6VCTD79R5B9QHYRWGNB7VBRG' ORDER BY wp.`id` LIMIT 1))\nWHERE o.`public_no`='WO-DEMO-V221-04';\n\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`expires_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2('demo-v221-platform-quote',256),26),o.`id`,'platform',NULL,NULL,76000,o.`booking_fee_cents`,'平台演示报价：报价不设置有效期，用户可继续比较。','active',1,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-04';\n\nINSERT INTO `quote_versions` (`quote_id`,`version_no`,`amount_cents`,`booking_fee_cents`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`rule_acknowledged_at`,`description`,`change_reason`,`operator_type`,`operator_id`,`created_at`)\nSELECT q.`id`,1,q.`amount_cents`,q.`booking_fee_cents`,o.`commission_rate_bp`,o.`commission_min_cents`,NULL,q.`description`,NULL,IF(q.`quote_type`='worker','worker','system'),q.`worker_id`,q.`created_at`\nFROM `quotes` q INNER JOIN `orders` o ON o.`id`=q.`order_id` WHERE o.`public_no`='WO-DEMO-V221-04';\n\nINSERT INTO `quote_items` (`quote_version_id`,`item_name`,`quantity`,`unit_name`,`unit_price_cents`,`amount_cents`,`sort_order`,`created_at`)\nSELECT qv.`id`,'基础施工',1.00,'项',qv.`amount_cents`,qv.`amount_cents`,10,UTC_TIMESTAMP()\nFROM `quote_versions` qv INNER JOIN `quotes` q ON q.`id`=qv.`quote_id` INNER JOIN `orders` o ON o.`id`=q.`order_id` WHERE o.`public_no`='WO-DEMO-V221-04';\n\n-- 为演示订单建立规则快照和派单链，拒绝样例只保留历史 assignment，不绑定到订单当前师傅。\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`locked_at`,`created_at`)\nSELECT o.`id`,1,o.`commission_rate_bp`,o.`commission_min_cents`,'default','V2.2.1 演示订单结算规则快照',NULL,'active',NULL,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no` LIKE 'WO-DEMO-V221-%';\n\nINSERT INTO `assignments` (`public_id`,`order_id`,`worker_id`,`quote_id`,`invite_token_id`,`assignment_type`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`estimated_commission_cents`,`estimated_offline_collect_cents`,`estimated_net_income_cents`,`status`,`offered_at`,`accept_deadline_at`,`accepted_at`,`rejected_at`,`cancelled_at`,`created_by_admin_id`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('demo-v221-assignment-',o.`public_no`),256),26),o.`id`,w.`id`,NULL,NULL,'admin',crv.`id`,o.`final_amount_cents`,o.`booking_fee_cents`,o.`commission_rate_bp`,o.`commission_min_cents`,LEAST(o.`final_amount_cents`,GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`)),GREATEST(0,o.`final_amount_cents`-o.`booking_fee_cents`),o.`final_amount_cents`-LEAST(o.`final_amount_cents`,GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`)),\n  CASE WHEN o.`public_no`='WO-DEMO-V221-05' THEN 'offered' WHEN o.`public_no`='WO-DEMO-V221-06' THEN 'rejected' WHEN o.`lifecycle_status`='completed' THEN 'completed' ELSE 'accepted' END,\n  CASE WHEN o.`public_no`='WO-DEMO-V221-05' THEN UTC_TIMESTAMP()-INTERVAL 23 HOUR WHEN o.`public_no`='WO-DEMO-V221-06' THEN UTC_TIMESTAMP()-INTERVAL 4 HOUR WHEN o.`completion_submitted_at` IS NOT NULL THEN DATE_SUB(o.`completion_submitted_at`,INTERVAL 2 DAY) ELSE UTC_TIMESTAMP()-INTERVAL 3 DAY END,\n  CASE WHEN o.`public_no`='WO-DEMO-V221-05' THEN UTC_TIMESTAMP()+INTERVAL 1 HOUR WHEN o.`public_no`='WO-DEMO-V221-06' THEN UTC_TIMESTAMP()+INTERVAL 20 HOUR ELSE UTC_TIMESTAMP()-INTERVAL 1 DAY END,\n  CASE WHEN o.`public_no` IN ('WO-DEMO-V221-05','WO-DEMO-V221-06') THEN NULL WHEN o.`completion_submitted_at` IS NOT NULL THEN DATE_SUB(o.`completion_submitted_at`,INTERVAL 1 DAY) ELSE UTC_TIMESTAMP()-INTERVAL 2 DAY END,\n  IF(o.`public_no`='WO-DEMO-V221-06',UTC_TIMESTAMP()-INTERVAL 2 HOUR,NULL),NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o\nINNER JOIN `commission_rule_versions` crv ON crv.`order_id`=o.`id` AND crv.`version_no`=1\nINNER JOIN `worker_profiles` w ON w.`id`=COALESCE((SELECT `id` FROM `worker_profiles` WHERE BINARY `public_id`=BINARY '01K2DEMOWORKERPROFILE00001' LIMIT 1),(SELECT wp.`id` FROM `worker_profiles` wp INNER JOIN `users` u ON u.`id`=wp.`user_id` WHERE BINARY u.`public_id`=BINARY '4P6VCTD79R5B9QHYRWGNB7VBRG' ORDER BY wp.`id` LIMIT 1))\nWHERE o.`public_no` IN ('WO-DEMO-V221-05','WO-DEMO-V221-06','WO-DEMO-V221-07','WO-DEMO-V221-08','WO-DEMO-V221-09','WO-DEMO-V221-10','WO-DEMO-V221-11','WO-DEMO-V221-12','WO-DEMO-V221-13','WO-DEMO-V221-14','WO-DEMO-V221-15','WO-DEMO-V221-16','WO-DEMO-V221-17','WO-DEMO-V221-18','WO-DEMO-V221-19','WO-DEMO-V221-21');\n\nUPDATE `orders` o\nINNER JOIN `assignments` a ON a.`order_id`=o.`id` AND a.`status` IN ('offered','accepted','completed')\nSET o.`current_assignment_id`=a.`id`,o.`assigned_worker_id`=a.`worker_id`\nWHERE o.`public_no` LIKE 'WO-DEMO-V221-%';\n\nINSERT INTO `assignment_history` (`assignment_id`,`order_id`,`worker_id`,`action`,`reason`,`actor_type`,`actor_id`,`snapshot_json`,`created_at`)\nSELECT a.`id`,a.`order_id`,a.`worker_id`,CASE WHEN a.`status`='offered' THEN 'offered' WHEN a.`status`='rejected' THEN 'rejected' ELSE 'accepted' END,\n  CASE WHEN a.`status`='offered' THEN 'V2.2.1 演示派单，保留 24 小时响应窗口' WHEN a.`status`='rejected' THEN 'V2.2.1 演示师傅已拒绝并释放订单' ELSE 'V2.2.1 演示师傅已接单' END,\n  CASE WHEN a.`status`='offered' THEN 'admin' ELSE 'worker' END,IF(a.`status`='offered',NULL,a.`worker_id`),NULL,UTC_TIMESTAMP()\nFROM `assignments` a INNER JOIN `orders` o ON o.`id`=a.`order_id` WHERE o.`public_no` LIKE 'WO-DEMO-V221-%';\n\nUPDATE `orders` o INNER JOIN `assignments` a ON a.`order_id`=o.`id` AND a.`status`='rejected'\nSET o.`current_assignment_id`=NULL,o.`assigned_worker_id`=NULL,o.`assignment_status`='unassigned',o.`publish_status`='hidden'\nWHERE o.`public_no`='WO-DEMO-V221-06';\n\nINSERT INTO `appointment_records` (`order_id`,`worker_id`,`appointment_at`,`note`,`status`,`created_at`,`updated_at`)\nSELECT o.`id`,o.`assigned_worker_id`,DATE_ADD(UTC_TIMESTAMP(),INTERVAL 1 DAY),'演示预约；地点和联系信息均为虚构。','recorded',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-07';\n\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`warranty_months`,`warranty_expires_at`,`warranty_note`,`version`,`created_at`,`updated_at`)\nSELECT o.`id`,o.`assigned_worker_id`,'V2.2.1 演示完工状态；没有伪造完工照片或收款凭证。',IF(o.`fulfillment_status`='submitted','submitted','accepted'),o.`completion_submitted_at`,o.`accepted_at`,IF(o.`accepted_at` IS NULL,NULL,'user'),o.`warranty_months`,o.`warranty_expires_at`,o.`warranty_note`,1,COALESCE(o.`completion_submitted_at`,o.`accepted_at`),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no` LIKE 'WO-DEMO-V221-%' AND o.`completion_submitted_at` IS NOT NULL AND o.`assigned_worker_id` IS NOT NULL;\n\nINSERT INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`)\nSELECT o.`id`,'audit_supplement_timeout','pending',o.`version`,o.`supplement_due_at`,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-03';\n\nINSERT INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`)\nSELECT o.`id`,'assignment_timeout','pending',o.`version`,a.`accept_deadline_at`,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o INNER JOIN `assignments` a ON a.`order_id`=o.`id` AND a.`status`='offered' WHERE o.`public_no`='WO-DEMO-V221-05';\n\nINSERT INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`)\nSELECT o.`id`,'auto_accept_completion','pending',o.`version`,o.`auto_accept_at`,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no` IN ('WO-DEMO-V221-09','WO-DEMO-V221-10','WO-DEMO-V221-11');\n\nINSERT INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`)\nSELECT o.`id`,'auto_review_order','pending',o.`version`,o.`auto_review_at`,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-21';\n\nINSERT INTO `disputes` (`public_no`,`order_id`,`raised_by_type`,`raised_by_id`,`dispute_type`,`title`,`description`,`status`,`responsibility`,`opened_at`,`created_at`,`updated_at`)\nSELECT 'DSP-DEMO-V221-10',o.`id`,'user',o.`user_id`,'completion_quality','V2.2.1 演示施工质量争议','演示争议状态；仅文本占位，不代表已提交真实图片证据。','open','undetermined',UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-10';\n\nINSERT INTO `dispute_evidence` (`dispute_id`,`submitted_by_type`,`submitted_by_id`,`evidence_type`,`description`,`media_file_id`,`occurred_at`,`created_at`)\nSELECT d.`id`,'system',NULL,'note','演示说明：实际裁决请补充真实现场照片与沟通记录。',NULL,NULL,UTC_TIMESTAMP()\nFROM `disputes` d WHERE d.`public_no`='DSP-DEMO-V221-10';\n\nINSERT INTO `after_sales` (`public_no`,`order_id`,`user_id`,`type`,`description`,`warranty_months_snapshot`,`warranty_expires_at_snapshot`,`non_human_confirmed`,`evidence_media_ids_json`,`status`,`opened_at`,`created_at`,`updated_at`)\nSELECT 'AS-DEMO-V221-15',o.`id`,o.`user_id`,'warranty_repair','六个月保障期内的非人为维修申请演示；不附伪造维修照片。',o.`warranty_months`,o.`warranty_expires_at`,1,NULL,'open',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-15';\n\nINSERT INTO `after_sales` (`public_no`,`order_id`,`user_id`,`type`,`description`,`warranty_months_snapshot`,`warranty_expires_at_snapshot`,`non_human_confirmed`,`evidence_media_ids_json`,`status`,`opened_at`,`created_at`,`updated_at`)\nSELECT 'AS-DEMO-V221-18',o.`id`,o.`user_id`,'warranty_repair','自定义十八个月保障期的维修申请演示；当前处理中。',o.`warranty_months`,o.`warranty_expires_at`,1,NULL,'processing',UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-18';\n\n-- 预计服务费、正式应收、预缴超额与预约费余额均绑定到演示师傅的演示订单。\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`is_provisional`,`finalized_at`,`overpaid_cents`,`worker_credit_cents`,`status`,`due_at`,`settled_at`,`created_at`,`updated_at`)\nSELECT f.`receivable_no`,o.`id`,a.`worker_id`,a.`id`,crv.`id`,f.`final_amount_cents`,f.`booking_fee_cents`,1000,5000,f.`gross_cents`,f.`offset_cents`,f.`due_cents`,f.`paid_cents`,f.`is_provisional`,IF(f.`is_provisional`=1,NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL f.`finalized_days_ago` DAY)),f.`overpaid_cents`,f.`worker_credit_cents`,f.`status`,DATE_ADD(UTC_TIMESTAMP(),INTERVAL 3 DAY),IF(f.`status` IN ('settled','estimate_settled','paid'),DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 DAY),NULL),COALESCE(o.`completion_submitted_at`,o.`accepted_at`,UTC_TIMESTAMP()),UTC_TIMESTAMP()\nFROM (\n  SELECT 'COM-DEMO-V221-09' AS `receivable_no`,'WO-DEMO-V221-09' AS `order_no`,150000 AS `final_amount_cents`,5000 AS `booking_fee_cents`,15000 AS `gross_cents`,5000 AS `offset_cents`,10000 AS `due_cents`,3000 AS `paid_cents`,1 AS `is_provisional`,0 AS `finalized_days_ago`,0 AS `overpaid_cents`,0 AS `worker_credit_cents`,'estimate_paid' AS `status`\n  UNION ALL SELECT 'COM-DEMO-V221-10','WO-DEMO-V221-10',120000,5000,12000,5000,7000,0,1,0,0,0,'estimate'\n  UNION ALL SELECT 'COM-DEMO-V221-11','WO-DEMO-V221-11',80000,15000,8000,8000,0,0,1,0,0,7000,'estimate_settled'\n  UNION ALL SELECT 'COM-DEMO-V221-12','WO-DEMO-V221-12',120000,5000,12000,5000,7000,0,0,1,0,0,'pending'\n  UNION ALL SELECT 'COM-DEMO-V221-13','WO-DEMO-V221-13',100000,5000,10000,5000,5000,7000,0,2,2000,0,'paid'\n  UNION ALL SELECT 'COM-DEMO-V221-14','WO-DEMO-V221-14',80000,15000,8000,8000,0,0,0,3,0,7000,'settled'\n) f\nINNER JOIN `orders` o ON CAST(o.`public_no` AS BINARY)=CAST(f.`order_no` AS BINARY)\nINNER JOIN `assignments` a ON a.`order_id`=o.`id` AND a.`status` IN ('accepted','completed')\nINNER JOIN `commission_rule_versions` crv ON crv.`order_id`=o.`id` AND crv.`version_no`=1;\n\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'PAY-DEMO-V221-C09','commission',cr.`id`,o.`id`,w.`user_id`,'DEMO_WORKER_OPENID_V221','DEMO_APPID','DEMO_MCHID','v3','CNY',3000,'paid','DEMO_TX_V221_COMMISSION_09','演示预计服务费预缴 30 元，DEMO 交易，不是真实微信支付',UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()\nFROM `commission_receivables` cr INNER JOIN `orders` o ON o.`id`=cr.`order_id` INNER JOIN `worker_profiles` w ON w.`id`=cr.`worker_id` WHERE o.`public_no`='WO-DEMO-V221-09';\n\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'PAY-DEMO-V221-C13','commission',cr.`id`,o.`id`,w.`user_id`,'DEMO_WORKER_OPENID_V221','DEMO_APPID','DEMO_MCHID','v3','CNY',7000,'paid','DEMO_TX_V221_COMMISSION_13','演示预计服务费预缴 70 元，DEMO 交易，不是真实微信支付',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM `commission_receivables` cr INNER JOIN `orders` o ON o.`id`=cr.`order_id` INNER JOIN `worker_profiles` w ON w.`id`=cr.`worker_id` WHERE o.`public_no`='WO-DEMO-V221-13';\n\nINSERT INTO `commission_payments` (`receivable_id`,`payment_order_id`,`amount_cents`,`status`,`paid_at`,`created_at`)\nSELECT cr.`id`,p.`id`,p.`amount_cents`,'paid',p.`paid_at`,p.`created_at`\nFROM `commission_receivables` cr INNER JOIN `orders` o ON o.`id`=cr.`order_id` INNER JOIN `payment_orders` p ON p.`business_type`='commission' AND p.`business_id`=cr.`id`\nWHERE o.`public_no` IN ('WO-DEMO-V221-09','WO-DEMO-V221-13');\n\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`)\nSELECT cr.`worker_id`,\n  CASE o.`public_no` WHEN 'WO-DEMO-V221-11' THEN 'commission_estimate' WHEN 'WO-DEMO-V221-13' THEN 'commission_overpayment' ELSE 'commission_final_credit' END,\n  'credit',\n  CASE o.`public_no` WHEN 'WO-DEMO-V221-11' THEN 7000 WHEN 'WO-DEMO-V221-13' THEN 2000 ELSE 7000 END,\n  CASE o.`public_no` WHEN 'WO-DEMO-V221-11' THEN 0 WHEN 'WO-DEMO-V221-13' THEN 2000 ELSE 7000 END,\n  CASE o.`public_no` WHEN 'WO-DEMO-V221-11' THEN 7000 ELSE 0 END,\n  'commission',cr.`id`,CONCAT('demo:v221:commission:',RIGHT(o.`public_no`,2)),\n  CASE o.`public_no` WHEN 'WO-DEMO-V221-11' THEN '验收前预计服务费差额冻结演示' WHEN 'WO-DEMO-V221-13' THEN '预计服务费超出正式应收，差额退回师傅余额演示' ELSE '验收后预约费高于正式服务费，差额进入师傅余额演示' END,\n  'effective',UTC_TIMESTAMP()\nFROM `commission_receivables` cr INNER JOIN `orders` o ON o.`id`=cr.`order_id`\nWHERE o.`public_no` IN ('WO-DEMO-V221-11','WO-DEMO-V221-13','WO-DEMO-V221-14');\n\n-- 已完成的历史退款样例；退款号和微信退款号均明确标记 DEMO。\nINSERT INTO `order_cancel_requests` (`public_id`,`order_id`,`applicant_type`,`applicant_id`,`request_type`,`order_state_snapshot_json`,`reason_code`,`reason`,`status`,`requested_refund_cents`,`requested_at`,`closed_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2('demo-v221-cancel-20',256),26),o.`id`,'system',NULL,'auto_timeout_cancel','{\"audit_status\":\"approved\",\"payment_status\":\"refunded\",\"lifecycle_status\":\"cancelled\"}','seven_days_no_valid_quote','演示：未成交超时取消并退款。','approved',5000,DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY),DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY),DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY),UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`public_no`='WO-DEMO-V221-20';\n\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`cancel_request_id`,`amount_cents`,`reason`,`status`,`wechat_refund_id`,`requested_by_admin_id`,`requested_at`,`succeeded_at`,`created_at`,`updated_at`)\nSELECT 'REF-DEMO-V221-20',p.`id`,o.`id`,cr.`id`,5000,'演示退款成功，非真实资金交易。','succeeded','DEMO_REFUND_V221_20',NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY),DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY),DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY),UTC_TIMESTAMP()\nFROM `orders` o INNER JOIN `payment_orders` p ON p.`order_id`=o.`id` AND p.`business_type`='order_booking' INNER JOIN `order_cancel_requests` cr ON cr.`order_id`=o.`id`\nWHERE o.`public_no`='WO-DEMO-V221-20';\n\nINSERT INTO `order_cancel_decisions` (`cancel_request_id`,`order_id`,`decision`,`responsibility`,`reason`,`refund_amount_cents`,`run_empty_fee_cents`,`refund_id`,`decided_by`,`decided_at`,`created_at`)\nSELECT cr.`id`,o.`id`,'approved','timeout_unaccepted','演示：系统超时取消并已登记 DEMO 退款。',5000,0,r.`id`,NULL,DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY),DATE_SUB(UTC_TIMESTAMP(),INTERVAL 2 DAY)\nFROM `orders` o INNER JOIN `order_cancel_requests` cr ON cr.`order_id`=o.`id` INNER JOIN `refunds` r ON r.`cancel_request_id`=cr.`id`\nWHERE o.`public_no`='WO-DEMO-V221-20';\n\n-- 仅同步运行版本和演示数据种子版本；不改 demo.data_enabled，尊重线上原有开关。\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.2.1','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.seed_version','2.2.1','string','system',0,'当前全状态演示订单数据版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n","server/database/upgrades/2.2.2.sql":"-- 2026-09-15：V2.2.2 按已验证的旧版演示业务链重建数据，并补齐 V2.2.1 审计新增状态。\n-- 严格复用指定的现有下单用户与师傅，不创建替代用户、占位师傅或伪造真实交易凭证。\n-- 本脚本只删除 orders.is_demo=1 的订单链及明确带 V204/V213/V222 标记的演示提现流水，不修改真实业务数据。\nSET NAMES utf8mb4;\n\nSET @v222_customer_id=(SELECT `id` FROM `users` WHERE BINARY `public_id`=BINARY 'BE20FMBCSMG6924JK21TE0RJTP' LIMIT 1);\nSET @v222_worker_user_id=(SELECT `id` FROM `users` WHERE BINARY `public_id`=BINARY '4P6VCTD79R5B9QHYRWGNB7VBRG' LIMIT 1);\nSET @v222_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `user_id`=@v222_worker_user_id ORDER BY `id` DESC LIMIT 1);\nSET @v222_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\nSET @v222_schema_id=(SELECT `id` FROM `form_schema_versions` WHERE `status`='published' ORDER BY `version_no` DESC,`id` DESC LIMIT 1);\nSET @v222_qz=(SELECT `id` FROM `service_categories` WHERE BINARY `category_key`=BINARY 'wallpaper' LIMIT 1);\nSET @v222_qb=(SELECT `id` FROM `service_categories` WHERE BINARY `category_key`=BINARY 'wall_cloth' LIMIT 1);\nSET @v222_blm=(SELECT `id` FROM `service_categories` WHERE BINARY `category_key`=BINARY 'glass_film' LIMIT 1);\nSET @v222_jjm=(SELECT `id` FROM `service_categories` WHERE BINARY `category_key`=BINARY 'furniture_film' LIMIT 1);\nSET @v222_cl=(SELECT `id` FROM `service_categories` WHERE BINARY `category_key`=BINARY 'curtain' LIMIT 1);\nSET @v222_mf=(SELECT `id` FROM `service_categories` WHERE BINARY `category_key`=BINARY 'beauty_seam' LIMIT 1);\n\n-- 2026-09-15：在任何清理前强制校验两条现有主档；缺失时利用非空字段约束安全中止升级。\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('__upgrade_guard','v222_customer',IF(@v222_customer_id IS NULL,NULL,'指定下单用户已确认'),'V2.2.2 临时升级前置校验',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('__upgrade_guard','v222_worker',IF(@v222_worker_id IS NULL,NULL,'指定师傅档案已确认'),'V2.2.2 临时升级前置校验',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSET @v222_old_fk_checks=@@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\n\n-- 2026-09-15：先删除旧演示订单的所有子表，关联条件只认 is_demo，不依赖订单号文字。\nDELETE n FROM `notifications` n INNER JOIN `orders` o ON o.`is_demo`=1 AND CASE WHEN JSON_VALID(n.`data_json`) THEN CAST(JSON_UNQUOTE(JSON_EXTRACT(n.`data_json`,'$.order_id')) AS UNSIGNED) ELSE NULL END=o.`id`;\nDELETE mo FROM `message_outbox` mo INNER JOIN `orders` o ON o.`is_demo`=1 AND (mo.`business_key` LIKE CONCAT('%:order:',o.`id`,':%') OR CASE WHEN JSON_VALID(mo.`payload_json`) THEN CAST(JSON_UNQUOTE(JSON_EXTRACT(mo.`payload_json`,'$.order_id')) AS UNSIGNED) ELSE NULL END=o.`id`);\nDELETE sjc FROM `scheduled_job_claims` sjc WHERE EXISTS (SELECT 1 FROM `orders` o WHERE o.`is_demo`=1 AND (sjc.`business_key`=CONCAT('order:',o.`id`) OR sjc.`business_key` LIKE CONCAT('order:',o.`id`,':%')));\nDELETE sjf FROM `scheduled_job_failures` sjf WHERE EXISTS (SELECT 1 FROM `orders` o WHERE o.`is_demo`=1 AND (sjf.`business_key`=CONCAT('order:',o.`id`) OR sjf.`business_key` LIKE CONCAT('order:',o.`id`,':%')));\nDELETE rm FROM `review_media` rm INNER JOIN `reviews` r ON r.`id`=rm.`review_id` INNER JOIN `orders` o ON o.`id`=r.`order_id` AND o.`is_demo`=1;\nDELETE rr FROM `review_replies` rr INNER JOIN `reviews` r ON r.`id`=rr.`review_id` INNER JOIN `orders` o ON o.`id`=r.`order_id` AND o.`is_demo`=1;\nDELETE de FROM `dispute_evidence` de INNER JOIN `disputes` d ON d.`id`=de.`dispute_id` INNER JOIN `orders` o ON o.`id`=d.`order_id` AND o.`is_demo`=1;\n-- 2026-09-15：quote_items 通过 quote_version_id 关联报价版本，兼容当前及历史 MySQL 5.7 数据结构。\nDELETE qi FROM `quote_items` qi INNER JOIN `quote_versions` qv_cleanup ON qv_cleanup.`id`=qi.`quote_version_id` INNER JOIN `quotes` q ON q.`id`=qv_cleanup.`quote_id` INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nDELETE cp FROM `commission_payments` cp INNER JOIN `commission_receivables` cr ON cr.`id`=cp.`receivable_id` INNER JOIN `orders` o ON o.`id`=cr.`order_id` AND o.`is_demo`=1;\nDELETE ca FROM `commission_adjustments` ca INNER JOIN `commission_receivables` cr ON cr.`id`=ca.`receivable_id` INNER JOIN `orders` o ON o.`id`=cr.`order_id` AND o.`is_demo`=1;\nDELETE pn FROM `payment_notifications` pn INNER JOIN `payment_orders` p ON p.`id`=pn.`payment_order_id` INNER JOIN `orders` o ON o.`id`=p.`order_id` AND o.`is_demo`=1;\nDELETE ci FROM `change_items` ci INNER JOIN `change_requests` c ON c.`id`=ci.`change_request_id` INNER JOIN `orders` o ON o.`id`=c.`order_id` AND o.`is_demo`=1;\nDELETE cc FROM `change_confirmations` cc INNER JOIN `change_requests` c ON c.`id`=cc.`change_request_id` INNER JOIN `orders` o ON o.`id`=c.`order_id` AND o.`is_demo`=1;\nDELETE ah FROM `assignment_history` ah INNER JOIN `assignments` a ON a.`id`=ah.`assignment_id` INNER JOIN `orders` o ON o.`id`=a.`order_id` AND o.`is_demo`=1;\nDELETE od FROM `order_cancel_decisions` od INNER JOIN `orders` o ON o.`id`=od.`order_id` AND o.`is_demo`=1;\nDELETE rf FROM `refunds` rf INNER JOIN `orders` o ON o.`id`=rf.`order_id` AND o.`is_demo`=1;\nDELETE rec FROM `commission_receivables` rec INNER JOIN `orders` o ON o.`id`=rec.`order_id` AND o.`is_demo`=1;\nDELETE r FROM `reviews` r INNER JOIN `orders` o ON o.`id`=r.`order_id` AND o.`is_demo`=1;\nDELETE claim FROM `run_empty_fee_claims` claim INNER JOIN `orders` o ON o.`id`=claim.`order_id` AND o.`is_demo`=1;\nDELETE d FROM `disputes` d INNER JOIN `orders` o ON o.`id`=d.`order_id` AND o.`is_demo`=1;\nDELETE af FROM `after_sales` af INNER JOIN `orders` o ON o.`id`=af.`order_id` AND o.`is_demo`=1;\nDELETE oc FROM `order_cancel_requests` oc INNER JOIN `orders` o ON o.`id`=oc.`order_id` AND o.`is_demo`=1;\nDELETE cs FROM `completion_submissions` cs INNER JOIN `orders` o ON o.`id`=cs.`order_id` AND o.`is_demo`=1;\nDELETE delay_row FROM `offline_payment_delay_requests` delay_row INNER JOIN `orders` o ON o.`id`=delay_row.`order_id` AND o.`is_demo`=1;\nDELETE adjust_row FROM `offline_collection_adjustment_requests` adjust_row INNER JOIN `orders` o ON o.`id`=adjust_row.`order_id` AND o.`is_demo`=1;\nDELETE c FROM `change_requests` c INNER JOIN `orders` o ON o.`id`=c.`order_id` AND o.`is_demo`=1;\nDELETE ap FROM `appointment_records` ap INNER JOIN `orders` o ON o.`id`=ap.`order_id` AND o.`is_demo`=1;\nDELETE ea FROM `exceptional_arrivals` ea INNER JOIN `orders` o ON o.`id`=ea.`order_id` AND o.`is_demo`=1;\nDELETE org FROM `order_role_grants` org INNER JOIN `orders` o ON o.`id`=org.`order_id` AND o.`is_demo`=1;\nDELETE a FROM `assignments` a INNER JOIN `orders` o ON o.`id`=a.`order_id` AND o.`is_demo`=1;\nDELETE it FROM `invite_tokens` it INNER JOIN `orders` o ON o.`id`=it.`order_id` AND o.`is_demo`=1;\nDELETE sc FROM `share_contexts` sc INNER JOIN `orders` o ON o.`id`=sc.`order_id` AND o.`is_demo`=1;\nDELETE qs FROM `quote_selections` qs INNER JOIN `orders` o ON o.`id`=qs.`order_id` AND o.`is_demo`=1;\nDELETE qv FROM `quote_versions` qv INNER JOIN `quotes` q ON q.`id`=qv.`quote_id` INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nDELETE q FROM `quotes` q INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nDELETE crv FROM `commission_rule_versions` crv INNER JOIN `orders` o ON o.`id`=crv.`order_id` AND o.`is_demo`=1;\nDELETE p FROM `payment_orders` p INNER JOIN `orders` o ON o.`id`=p.`order_id` AND o.`is_demo`=1;\nDELETE mr FROM `merchant_risk_events` mr INNER JOIN `orders` o ON o.`id`=mr.`order_id` AND o.`is_demo`=1;\nDELETE dl FROM `order_deadlines` dl INNER JOIN `orders` o ON o.`id`=dl.`order_id` AND o.`is_demo`=1;\nDELETE ev FROM `order_events` ev INNER JOIN `orders` o ON o.`id`=ev.`order_id` AND o.`is_demo`=1;\nDELETE rev FROM `order_revisions` rev INNER JOIN `orders` o ON o.`id`=rev.`order_id` AND o.`is_demo`=1;\nDELETE ans FROM `order_answers` ans INNER JOIN `orders` o ON o.`id`=ans.`order_id` AND o.`is_demo`=1;\nDELETE addr FROM `order_addresses` addr INNER JOIN `orders` o ON o.`id`=addr.`order_id` AND o.`is_demo`=1;\nDELETE cat FROM `order_categories` cat INNER JOIN `orders` o ON o.`id`=cat.`order_id` AND o.`is_demo`=1;\nDELETE ml FROM `media_links` ml INNER JOIN `orders` o ON ml.`entity_type`='order' AND ml.`entity_id`=o.`id` AND o.`is_demo`=1;\nDELETE FROM `orders` WHERE `is_demo`=1;\nDELETE FROM `reconciliation_records` WHERE CAST(`internal_no` AS BINARY) LIKE BINARY 'PAY-V204-%' OR CAST(`internal_no` AS BINARY) LIKE BINARY 'PAY-V213-%' OR CAST(`internal_no` AS BINARY) LIKE BINARY 'PAY-V222-%' OR CAST(`internal_no` AS BINARY) LIKE BINARY 'PAY-DEMO-%' OR CAST(`internal_no` AS BINARY) LIKE BINARY 'REF-V204-%' OR CAST(`internal_no` AS BINARY) LIKE BINARY 'REF-V213-%' OR CAST(`internal_no` AS BINARY) LIKE BINARY 'REF-V222-%' OR CAST(`internal_no` AS BINARY) LIKE BINARY 'REF-DEMO-%';\n\n-- 2026-09-15：旧演示提现流水只按明确前缀清理，师傅真实余额和真实提现均保留。\nDELETE pa FROM `payout_adjustments` pa INNER JOIN `worker_payouts` wp ON wp.`id`=pa.`worker_payout_id` INNER JOIN `withdrawal_requests` wr ON wr.`id`=wp.`withdrawal_request_id` WHERE CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V204-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V213-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V222-%';\nDELETE wa FROM `withdrawal_allocations` wa INNER JOIN `withdrawal_requests` wr ON wr.`id`=wa.`withdrawal_request_id` WHERE CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V204-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V213-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V222-%';\nDELETE we FROM `withdrawal_events` we INNER JOIN `withdrawal_requests` wr ON wr.`id`=we.`withdrawal_request_id` WHERE CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V204-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V213-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V222-%';\nDELETE wp FROM `worker_payouts` wp INNER JOIN `withdrawal_requests` wr ON wr.`id`=wp.`withdrawal_request_id` WHERE CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V204-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V213-%' OR CAST(wr.`public_no` AS BINARY) LIKE BINARY 'WD-V222-%';\nDELETE FROM `withdrawal_requests` WHERE CAST(`public_no` AS BINARY) LIKE BINARY 'WD-V204-%' OR CAST(`public_no` AS BINARY) LIKE BINARY 'WD-V213-%' OR CAST(`public_no` AS BINARY) LIKE BINARY 'WD-V222-%';\nDELETE FROM `worker_balance_ledger` WHERE CAST(`idempotency_key` AS BINARY) LIKE BINARY 'v204:%' OR CAST(`idempotency_key` AS BINARY) LIKE BINARY 'v213:%' OR CAST(`idempotency_key` AS BINARY) LIKE BINARY 'v222:%';\n\nSET FOREIGN_KEY_CHECKS=@v222_old_fk_checks;\n\n-- 2026-09-15：十五笔演示订单均归属指定真实用户，覆盖付款、审核、补资料、报价、派单、履约、服务费、退款、争议与维修保障。\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,`wall_height_text`,`is_renovation`,`expected_visit_at`,`city`,`district`,`address_summary`,`address_ciphertext`,`lat`,`lng`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`order_source_type`,`audit_status`,`audit_note`,`audited_at`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`contact_revealed_at`,`completion_submitted_at`,`auto_accept_at`,`accepted_at`,`auto_review_at`,`cancelled_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`) VALUES\n('BXQZ202609151837',@v222_customer_id,@v222_schema_id,@v222_qz,'墙纸','墙纸','演示：待审核订单','预约费已支付，等待管理员审核。','45.00㎡','2.80m',1,NULL,'杭州市','西湖区','杭州市西湖区文二路120号3幢502室','杭州市西湖区文二路120号3幢502室',30.2819000,120.1280000,'陈女士','陈女士','13088880000','13088880000','consumer','pending',NULL,NULL,'hidden','waiting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()),\n('BXQB202609154726',@v222_customer_id,@v222_schema_id,@v222_qb,'墙布','墙布','演示：待补充资料','用户可从订单详情补充现场图片和文字。','60.00㎡','2.85m',1,NULL,'杭州市','拱墅区','杭州市拱墅区湖墅南路66号2幢701室','杭州市拱墅区湖墅南路66号2幢701室',30.3023000,120.1568000,'李先生','李先生','12011112222','12011112222','consumer','supplement_required','请补充发霉墙面近照和全景图。',UTC_TIMESTAMP()-INTERVAL 1 HOUR,'hidden','waiting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 5 HOUR,UTC_TIMESTAMP()),\n('BXQB202609156351',@v222_customer_id,@v222_schema_id,@v222_qb,'墙布','墙布','演示：师傅和平台共同报价','检查最多报价人数、师傅详情跳转和平台报价。','68.00㎡','2.85m',0,NULL,'杭州市','拱墅区','杭州市拱墅区莫干山路188号1幢601室','杭州市拱墅区莫干山路188号1幢601室',30.3115000,120.1532000,'郭女士','郭女士','13088880000','13088880000','consumer','approved',NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,'published','quoting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 6 DAY,NULL,NULL,NULL,NULL,NULL,NULL,NULL,3,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('BXBLM202609158047',@v222_customer_id,@v222_schema_id,@v222_blm,'玻璃膜','玻璃膜','演示：已接受平台报价','平台报价已接受，等待管理员安排或邀请师傅。','32.00㎡',NULL,0,NULL,'杭州市','滨江区','杭州市滨江区江南大道1888号1幢1102室','杭州市滨江区江南大道1888号1幢1102室',30.2084000,120.2121000,'王女士','王女士','13088880000','13088880000','consumer','approved',NULL,UTC_TIMESTAMP()-INTERVAL 2 DAY,'hidden','selected','unassigned','not_started','paid','none','none','active',78000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,NULL,NULL,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()),\n('BXCL202609152619',@v222_customer_id,@v222_schema_id,@v222_cl,'窗帘','窗帘','演示：已预约施工','师傅已接单，电话联系后约定明日上午上门。','4套',NULL,0,DATE_ADD(DATE(UTC_TIMESTAMP()),INTERVAL 1 DAY)+INTERVAL 9 HOUR,'杭州市','上城区','杭州市上城区庆春路58号6幢301室','杭州市上城区庆春路58号6幢301室',30.2581000,120.1833000,'赵女士','赵女士','13088880000','13088880000','consumer','approved',NULL,UTC_TIMESTAMP()-INTERVAL 3 DAY,'hidden','selected','accepted','scheduled','paid'