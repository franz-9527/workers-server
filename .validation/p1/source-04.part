ompleted','accepted','paid','none','none','completed',80000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 40 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 39 DAY,UTC_TIMESTAMP()-INTERVAL 35 DAY,UTC_TIMESTAMP()-INTERVAL 32 DAY,UTC_TIMESTAMP()-INTERVAL 32 DAY,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 32 DAY,11,1,UTC_TIMESTAMP()-INTERVAL 40 DAY,UTC_TIMESTAMP());\n\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`) SELECT `id`,`category_id`,`category_name_snapshot`,0,UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1 AND `category_id` IS NOT NULL;\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`)\nSELECT o.`id`,@v222_qz,'墙纸',20,UTC_TIMESTAMP() FROM `orders` o WHERE BINARY o.`public_no`=BINARY 'BXQB202609156351' AND @v222_qz IS NOT NULL\nON DUPLICATE KEY UPDATE `category_name_snapshot`=VALUES(`category_name_snapshot`),`sort_order`=VALUES(`sort_order`);\nINSERT INTO `order_addresses` (`order_id`,`province`,`city`,`district`,`address_summary`,`address_ciphertext`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`lat`,`lng`,`coordinate_system`,`created_at`,`updated_at`) SELECT `id`,'浙江省',`city`,`district`,`address_summary`,`address_ciphertext`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`lat`,`lng`,'GCJ-02',UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1;\n\n-- 2026-09-15：复用升级包中的三张压缩演示图，每笔订单都可直接检查图片展示。\nINSERT INTO `media_files` (`public_id`,`storage_disk`,`storage_key`,`mime_type`,`extension`,`size_bytes`,`width_px`,`height_px`,`sha256`,`compression_quality`,`metadata_json`,`status`,`reference_count`,`created_at`) VALUES\n(LEFT(SHA2('v222-material',256),26),'private_local','uploads/demo/order-material.jpg','image/jpeg','jpg',80804,900,675,'ab8fda1afebff029b6249570a4f7466150598cb4f20d6f092a585f74382fce51',82,'{\"demo\":true,\"evidence_valid\":false,\"purpose\":\"商品示例图\"}','active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('v222-wall',256),26),'private_local','uploads/demo/order-wall.jpg','image/jpeg','jpg',41075,900,675,'baa9fbd644cf266126cd79c894ef44731010311b736ac072b47412b479f3543b',82,'{\"demo\":true,\"evidence_valid\":false,\"purpose\":\"现场环境示例图\"}','active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('v222-completion',256),26),'private_local','uploads/demo/order-completion.jpg','image/jpeg','jpg',48207,900,675,'967ee65e75ca2d0c6d8f591ca856f476a5d2d88e57c41172431c885381d5675f',82,'{\"demo\":true,\"evidence_valid\":false,\"purpose\":\"完工展示示例图\"}','active',0,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `metadata_json`=VALUES(`metadata_json`),`status`='active',`pending_delete_at`=NULL,`deleted_at`=NULL;\nSET @v222_material=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-material.jpg' LIMIT 1);\nSET @v222_wall=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-wall.jpg' LIMIT 1);\nSET @v222_completion=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-completion.jpg' LIMIT 1);\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_at`) SELECT @v222_material,'order',`id`,'product',10,'system',UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1;\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_at`) SELECT @v222_wall,'order',`id`,'wall',20,'system',UTC_TIMESTAMP() FROM `orders` WHERE `is_demo`=1;\n\n-- 2026-09-15：报价与选择快照，师傅报价可点击进入原 record 师傅详情页。\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v222-worker-',o.`public_no`),256),26),o.`id`,'worker',@v222_worker_id,NULL,88000,5000,'师傅报价：包含基础墙面检查和铺贴施工。','active',1,UTC_TIMESTAMP()-INTERVAL 18 HOUR,UTC_TIMESTAMP() FROM `orders` o WHERE BINARY o.`public_no`=BINARY 'BXQB202609156351';\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v222-platform-',o.`public_no`),256),26),o.`id`,'platform',@v222_admin_id,92000,5000,'平台报价：接受后由管理员安排师傅。','active',1,UTC_TIMESTAMP()-INTERVAL 16 HOUR,UTC_TIMESTAMP() FROM `orders` o WHERE BINARY o.`public_no`=BINARY 'BXQB202609156351';\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`selected_at`,`created_at`,`updated_at`)\n-- 2026-09-15：待师傅接受的派单尚未开放联系方式，选择时间不得直接取可能为空的 contact_revealed_at。\nSELECT LEFT(SHA2(CONCAT('v222-selected-',o.`public_no`),256),26),o.`id`,IF(BINARY o.`public_no`=BINARY 'BXBLM202609158047','platform','worker'),IF(BINARY o.`public_no`=BINARY 'BXBLM202609158047',NULL,@v222_worker_id),IF(BINARY o.`public_no`=BINARY 'BXBLM202609158047',@v222_admin_id,NULL),o.`final_amount_cents`,o.`booking_fee_cents`,'V2.2.2 当前流程演示报价','selected',1,COALESCE(o.`contact_revealed_at`,o.`created_at`+INTERVAL 1 DAY),o.`created_at`+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM `orders` o WHERE CAST(o.`public_no` AS BINARY) IN ('BXBLM202609158047','BXCL202609152619','BXJJM202609157194','BXQZ202609153568','BXQZ202609159402','BXCL202609155841','BXQB202609157736','BXQB202609156420','BXJJM202609158504','BXBLM202609156937');\nINSERT INTO `quote_versions` (`quote_id`,`version_no`,`amount_cents`,`booking_fee_cents`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`rule_acknowledged_at`,`description`,`operator_type`,`operator_id`,`created_at`)\nSELECT q.`id`,1,q.`amount_cents`,q.`booking_fee_cents`,o.`commission_rate_bp`,o.`commission_min_cents`,q.`created_at`,q.`description`,IF(q.`quote_type`='platform','admin','worker'),IF(q.`quote_type`='platform',@v222_admin_id,@v222_worker_id),q.`created_at` FROM `quotes` q INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nINSERT INTO `quote_items` (`quote_version_id`,`item_name`,`quantity`,`unit_name`,`unit_price_cents`,`amount_cents`,`sort_order`,`created_at`)\nSELECT qv.`id`,'安装施工费',1.00,'项',qv.`amount_cents`,qv.`amount_cents`,10,qv.`created_at` FROM `quote_versions` qv INNER JOIN `quotes` q ON q.`id`=qv.`quote_id` INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nINSERT INTO `quote_selections` (`order_id`,`quote_id`,`quote_version_id`,`user_id`,`amount_cents_snapshot`,`booking_fee_cents_snapshot`,`status`,`selected_at`,`confirmed_at`)\nSELECT o.`id`,q.`id`,qv.`id`,@v222_customer_id,q.`amount_cents`,q.`booking_fee_cents`,'confirmed',q.`selected_at`,q.`selected_at` FROM `orders` o INNER JOIN `quotes` q ON q.`order_id`=o.`id` AND q.`status`='selected' INNER JOIN `quote_versions` qv ON qv.`quote_id`=q.`id` AND qv.`version_no`=1 WHERE o.`is_demo`=1;\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`locked_at`,`created_at`)\nSELECT o.`id`,1,o.`commission_rate_bp`,o.`commission_min_cents`,'default','V2.2.2 演示订单服务费快照',@v222_admin_id,IF(BINARY o.`public_no`=BINARY 'BXBLM202609158047','active','locked'),IF(BINARY o.`public_no`=BINARY 'BXBLM202609158047',NULL,o.`contact_revealed_at`),o.`created_at` FROM `orders` o WHERE o.`is_demo`=1 AND o.`quote_status`='selected';\n\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT CONCAT('PAY-V222-',RIGHT(o.`public_no`,4)),'order_booking',o.`id`,o.`id`,@v222_customer_id,'V222_CUSTOMER_OPENID','V222_APPID','V222_MCHID','v3','CNY',5000,IF(o.`lifecycle_status`='expired','refunded','paid'),CONCAT('V222_TX_',RIGHT(o.`public_no`,4)),'V2.2.2 演示预约费，不是真实微信交易',o.`created_at`+INTERVAL 10 MINUTE,o.`created_at`,UTC_TIMESTAMP() FROM `orders` o WHERE o.`is_demo`=1 AND o.`payment_status`<>'awaiting_payment';\n\nINSERT INTO `assignments` (`public_id`,`order_id`,`worker_id`,`quote_id`,`assignment_type`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`estimated_commission_cents`,`estimated_offline_collect_cents`,`estimated_net_income_cents`,`status`,`offered_at`,`accepted_at`,`created_by_admin_id`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v222-assignment-',o.`public_no`),256),26),o.`id`,@v222_worker_id,q.`id`,'worker_quote',crv.`id`,o.`final_amount_cents`,o.`booking_fee_cents`,o.`commission_rate_bp`,o.`commission_min_cents`,GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`),o.`final_amount_cents`-o.`booking_fee_cents`,o.`final_amount_cents`-GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`),IF(o.`fulfillment_status`='accepted','completed','accepted'),o.`created_at`+INTERVAL 1 DAY,o.`created_at`+INTERVAL 1 DAY,@v222_admin_id,o.`created_at`+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM `orders` o INNER JOIN `quotes` q ON q.`order_id`=o.`id` AND q.`status`='selected' INNER JOIN `commission_rule_versions` crv ON crv.`order_id`=o.`id` WHERE o.`is_demo`=1 AND BINARY o.`public_no`<>BINARY 'BXBLM202609158047' AND BINARY o.`public_no`<>BINARY 'BXQB202609156420';\n-- 2026-09-15：单独保留“已派单待师傅接单”，使 24 小时接单期限可直接测试。\nINSERT INTO `assignments` (`public_id`,`order_id`,`worker_id`,`quote_id`,`assignment_type`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`estimated_commission_cents`,`estimated_offline_collect_cents`,`estimated_net_income_cents`,`status`,`offered_at`,`accept_deadline_at`,`accepted_at`,`created_by_admin_id`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v222-offered-',o.`public_no`),256),26),o.`id`,@v222_worker_id,q.`id`,'worker_quote',crv.`id`,o.`final_amount_cents`,o.`booking_fee_cents`,o.`commission_rate_bp`,o.`commission_min_cents`,GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`),o.`final_amount_cents`-o.`booking_fee_cents`,o.`final_amount_cents`-GREATEST(ROUND(o.`final_amount_cents`*o.`commission_rate_bp`/10000),o.`commission_min_cents`),'offered',UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()+INTERVAL 23 HOUR,NULL,@v222_admin_id,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()\nFROM `orders` o INNER JOIN `quotes` q ON q.`order_id`=o.`id` AND q.`status`='selected' INNER JOIN `commission_rule_versions` crv ON crv.`order_id`=o.`id` WHERE BINARY o.`public_no`=BINARY 'BXQB202609156420';\nUPDATE `orders` o INNER JOIN `quotes` q ON q.`order_id`=o.`id` AND q.`status`='selected' LEFT JOIN `commission_rule_versions` crv ON crv.`order_id`=o.`id` LEFT JOIN `assignments` a ON a.`order_id`=o.`id` SET o.`selected_quote_id`=q.`id`,o.`commission_rule_version_id`=crv.`id`,o.`current_assignment_id`=a.`id`,o.`assigned_worker_id`=a.`worker_id` WHERE o.`is_demo`=1;\n\nSET @v222_platform_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXBLM202609158047');\nSET @v222_platform_rule=(SELECT `id` FROM `commission_rule_versions` WHERE `order_id`=@v222_platform_order LIMIT 1);\nINSERT INTO `invite_tokens` (`order_id`,`token_hash`,`purpose`,`created_by_admin_id`,`commission_rule_version_id`,`status`,`max_claims`,`claim_count`,`expires_at`,`created_at`) VALUES (@v222_platform_order,SHA2('V222-DEMO-INVITE-NOT-USABLE',256),'worker_assignment',@v222_admin_id,@v222_platform_rule,'active',1,0,UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\nINSERT INTO `share_contexts` (`order_id`,`context_type`,`token_hash`,`created_by_type`,`created_by_id`,`snapshot_json`,`status`,`expires_at`,`created_at`) VALUES (@v222_platform_order,'worker_invite',SHA2('V222-DEMO-SHARE-NOT-USABLE',256),'admin',@v222_admin_id,'{\"share_type\":\"worker_invite\",\"demo\":true}','active',UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\n\nSET @v222_scheduled=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXCL202609152619');\nINSERT INTO `appointment_records` (`order_id`,`worker_id`,`appointment_at`,`note`,`status`,`created_at`,`updated_at`) VALUES (@v222_scheduled,@v222_worker_id,DATE_ADD(DATE(UTC_TIMESTAMP()),INTERVAL 1 DAY)+INTERVAL 9 HOUR,'电话联系后约定明日上午上门。','recorded',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nSET @v222_adjust_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXJJM202609157194');\nSET @v222_adjust_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v222_adjust_order LIMIT 1);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`version`,`created_at`,`updated_at`) VALUES (@v222_adjust_order,@v222_worker_id,'家具膜施工完成，已添加时间地点水印。','submitted',UTC_TIMESTAMP()-INTERVAL 12 HOUR,1,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP());\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES (@v222_completion,'order',@v222_adjust_order,'completion',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 12 HOUR),(@v222_material,'order',@v222_adjust_order,'collection_receipt',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 11 HOUR);\nINSERT INTO `offline_collection_adjustment_requests` (`public_id`,`order_id`,`worker_id`,`assignment_id`,`original_total_cents`,`original_tail_cents`,`requested_total_cents`,`requested_tail_cents`,`reason`,`receipt_media_ids_json`,`status`,`review_note`,`submitted_at`,`reviewed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v222-offline-adjustment',256),26),@v222_adjust_order,@v222_worker_id,@v222_adjust_assignment,120000,115000,126000,121000,'现场增加了一面家具膜，按实际收款金额提交。',JSON_ARRAY(@v222_material),'auto_approved','系统预审自动通过，管理员可抽查驳回。',UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP());\nUPDATE `orders` SET `final_amount_cents`=126000,`updated_at`=UTC_TIMESTAMP() WHERE `id`=@v222_adjust_order;\nUPDATE `assignments` SET `final_amount_cents_snapshot`=126000,`estimated_commission_cents`=10080,`estimated_offline_collect_cents`=121000,`estimated_net_income_cents`=115920,`updated_at`=UTC_TIMESTAMP() WHERE `id`=@v222_adjust_assignment;\n\nSET @v222_overdue_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQZ202609153568');\nSET @v222_overdue_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v222_overdue_order LIMIT 1);\nSET @v222_overdue_rule=(SELECT `commission_rule_version_id` FROM `assignments` WHERE `id`=@v222_overdue_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES (@v222_overdue_order,@v222_worker_id,'墙纸施工完成，用户已验收。','accepted',UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 3 DAY,'auto_72h',1,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES (@v222_completion,'order',@v222_overdue_order,'completion',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 6 DAY),(@v222_material,'order',@v222_overdue_order,'collection_receipt',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`created_at`,`updated_at`) VALUES ('COM-V222-OVERDUE',@v222_overdue_order,@v222_worker_id,@v222_overdue_assignment,@v222_overdue_rule,110000,5000,1000,5000,11000,5000,6000,0,'overdue',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP());\nINSERT INTO `offline_payment_delay_requests` (`order_id`,`worker_id`,`amount_cents_snapshot`,`reason`,`expected_collect_at`,`status`,`reviewed_by`,`review_note`,`submitted_at`,`reviewed_at`,`created_at`,`updated_at`) VALUES (@v222_overdue_order,@v222_worker_id,105000,'商家超过约定日期仍未结清尾款。',UTC_TIMESTAMP()-INTERVAL 2 DAY,'bad_debt',@v222_admin_id,'演示：师傅确认对方不再支付，管理员标记坏账。',UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP());\n\nSET @v222_done_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQZ202609159402');\nSET @v222_done_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v222_done_order LIMIT 1);\nSET @v222_done_rule=(SELECT `commission_rule_version_id` FROM `assignments` WHERE `id`=@v222_done_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES (@v222_done_order,@v222_worker_id,'墙纸施工完成，用户评价满意。','accepted',UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,'user',1,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP());\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES (@v222_completion,'order',@v222_done_order,'completion',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 9 DAY),(@v222_material,'order',@v222_done_order,'collection_receipt',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 8 DAY);\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`settled_at`,`created_at`,`updated_at`) VALUES ('COM-V222-SETTLED',@v222_done_order,@v222_worker_id,@v222_done_assignment,@v222_done_rule,95000,5000,1000,5000,9500,5000,4500,4500,'settled',UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nSET @v222_receivable_done=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`) VALUES ('PAY-V222-COMMISSION','commission',@v222_receivable_done,@v222_done_order,@v222_worker_user_id,'V222_WORKER_OPENID','V222_APPID','V222_MCHID','v3','CNY',4500,'paid','V222_TX_COMMISSION','V2.2.2 演示平台服务费',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @v222_commission_payment=LAST_INSERT_ID();\nINSERT INTO `commission_payments` (`receivable_id`,`payment_order_id`,`amount_cents`,`status`,`paid_at`,`created_at`) VALUES (@v222_receivable_done,@v222_commission_payment,4500,'paid',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO `reviews` (`public_id`,`order_id`,`user_id`,`worker_id`,`rating`,`content`,`is_auto`,`status`,`reviewed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v222-review',256),26),@v222_done_order,@v222_customer_id,@v222_worker_id,5,'师傅沟通及时，施工细致，完工效果满意。',0,'visible',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @v222_review=LAST_INSERT_ID();\nINSERT INTO `review_media` (`review_id`,`media_file_id`,`sort_order`,`created_at`) VALUES (@v222_review,@v222_completion,10,UTC_TIMESTAMP()-INTERVAL 5 DAY);\n\n-- 2026-09-15：V2.2.1 审计新增链路：待补资料期限、派单 24 小时期限、完工预计服务费和维修保障。\nSET @v222_supplement_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQB202609154726');\nINSERT INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`) VALUES\n(@v222_supplement_order,'supplement_timeout','pending',2,UTC_TIMESTAMP()+INTERVAL 48 HOUR,UTC_TIMESTAMP(),UTC_TIMESTAMP());\nUPDATE `orders` SET `supplement_due_at`=UTC_TIMESTAMP()+INTERVAL 48 HOUR WHERE `id`=@v222_supplement_order;\n\nSET @v222_offered_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQB202609156420');\nSET @v222_offered_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v222_offered_order AND `status`='offered' LIMIT 1);\nINSERT INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`) VALUES\n(@v222_offered_order,'assignment_accept_timeout','pending',4,UTC_TIMESTAMP()+INTERVAL 23 HOUR,UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\nSET @v222_provisional_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXJJM202609158504');\nSET @v222_provisional_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v222_provisional_order LIMIT 1);\nSET @v222_provisional_rule=(SELECT `commission_rule_version_id` FROM `assignments` WHERE `id`=@v222_provisional_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`version`,`created_at`,`updated_at`) VALUES\n(@v222_provisional_order,@v222_worker_id,'家具膜施工完成，等待用户验收；演示图片不作为真实到场取证。','submitted',UTC_TIMESTAMP()-INTERVAL 8 HOUR,1,UTC_TIMESTAMP()-INTERVAL 8 HOUR,UTC_TIMESTAMP());\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES\n(@v222_completion,'order',@v222_provisional_order,'completion',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 8 HOUR);\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`is_provisional`,`status`,`due_at`,`created_at`,`updated_at`) VALUES\n('COM-V222-PROVISIONAL',@v222_provisional_order,@v222_worker_id,@v222_provisional_assignment,@v222_provisional_rule,150000,5000,1000,5000,15000,5000,10000,3000,1,'estimate_paid',NULL,UTC_TIMESTAMP()-INTERVAL 8 HOUR,UTC_TIMESTAMP());\nSET @v222_provisional_receivable=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`) VALUES\n('PAY-V222-PROVISIONAL','commission',@v222_provisional_receivable,@v222_provisional_order,@v222_worker_user_id,'V222_WORKER_OPENID','V222_APPID','V222_MCHID','v3','CNY',3000,'paid','V222_TX_PROVISIONAL','V2.2.2 演示预计服务费部分预缴，不是真实微信交易',UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP());\nSET @v222_provisional_payment=LAST_INSERT_ID();\nINSERT INTO `commission_payments` (`receivable_id`,`payment_order_id`,`amount_cents`,`status`,`paid_at`,`created_at`) VALUES\n(@v222_provisional_receivable,@v222_provisional_payment,3000,'paid',UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP()-INTERVAL 4 HOUR);\nINSERT INTO `order_deadlines` (`order_id`,`deadline_type`,`status`,`version`,`due_at`,`created_at`,`updated_at`) VALUES\n(@v222_provisional_order,'auto_accept','pending',7,UTC_TIMESTAMP()+INTERVAL 64 HOUR,UTC_TIMESTAMP()-INTERVAL 8 HOUR,UTC_TIMESTAMP());\n\nSET @v222_warranty_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXBLM202609156937');\nSET @v222_warranty_assignment=(SELECT `id` FROM `assignments` WHERE `order_id`=@v222_warranty_order LIMIT 1);\nSET @v222_warranty_rule=(SELECT `commission_rule_version_id` FROM `assignments` WHERE `id`=@v222_warranty_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`warranty_months`,`warranty_expires_at`,`warranty_note`,`version`,`created_at`,`updated_at`) VALUES\n(@v222_warranty_order,@v222_worker_id,'玻璃膜施工已完成并验收。','accepted',UTC_TIMESTAMP()-INTERVAL 35 DAY,UTC_TIMESTAMP()-INTERVAL 32 DAY,'user',6,UTC_TIMESTAMP()+INTERVAL 5 MONTH,'非人为施工质量问题提供六个月维修保障。',1,UTC_TIMESTAMP()-INTERVAL 35 DAY,UTC_TIMESTAMP());\nUPDATE `orders` SET `warranty_months`=6,`warranty_expires_at`=UTC_TIMESTAMP()+INTERVAL 5 MONTH,`warranty_note`='非人为施工质量问题提供六个月维修保障。' WHERE `id`=@v222_warranty_order;\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES\n(@v222_completion,'order',@v222_warranty_order,'completion',10,'worker',@v222_worker_id,UTC_TIMESTAMP()-INTERVAL 35 DAY);\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`is_provisional`,`finalized_at`,`status`,`due_at`,`settled_at`,`created_at`,`updated_at`) VALUES\n('COM-V222-WARRANTY',@v222_warranty_order,@v222_worker_id,@v222_warranty_assignment,@v222_warranty_rule,80000,5000,1000,5000,8000,5000,3000,3000,0,UTC_TIMESTAMP()-INTERVAL 32 DAY,'settled',UTC_TIMESTAMP()-INTERVAL 29 DAY,UTC_TIMESTAMP()-INTERVAL 31 DAY,UTC_TIMESTAMP()-INTERVAL 32 DAY,UTC_TIMESTAMP());\nSET @v222_warranty_receivable=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`) VALUES\n('PAY-V222-WARRANTY','commission',@v222_warranty_receivable,@v222_warranty_order,@v222_worker_user_id,'V222_WORKER_OPENID','V222_APPID','V222_MCHID','v3','CNY',3000,'paid','V222_TX_WARRANTY','V2.2.2 演示