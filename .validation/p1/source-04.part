tus`,`submitted_at`,`created_at`,`updated_at`) VALUES (@v204_submitted,@v204_worker_id,115000,'用户确认完工，但约定三天后支付线下尾款。',UTC_TIMESTAMP()+INTERVAL 3 DAY,'pending',UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP());\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`created_at`,`updated_at`) VALUES ('COM-V204-PENDING',@v204_submitted,@v204_worker_id,@v204_submitted_assignment,@v204_submitted_rule,120000,5000,1000,5000,12000,5000,7000,0,'pending',UTC_TIMESTAMP()+INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP());\nINSERT INTO media_links(media_file_id,entity_type,entity_id,purpose,sort_order,created_by_type,created_by_id,created_at) VALUES (@v204_completion,'order',@v204_submitted,'completion',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 12 HOUR),(@v204_material,'order',@v204_submitted,'collection_receipt',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 11 HOUR);\n\nSET @v204_done=(SELECT id FROM orders WHERE public_no='BXQZ202608286403');\nSET @v204_done_assignment=(SELECT id FROM assignments WHERE order_id=@v204_done LIMIT 1);\nSET @v204_done_rule=(SELECT commission_rule_version_id FROM assignments WHERE id=@v204_done_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES (@v204_done,@v204_worker_id,'墙纸施工完成，用户已验收。','accepted',UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,'auto_72h',1,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP());\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`settled_at`,`created_at`,`updated_at`) VALUES ('COM-V204-SETTLED',@v204_done,@v204_worker_id,@v204_done_assignment,@v204_done_rule,95000,5000,1000,5000,9500,5000,4500,4500,'settled',UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nSET @v204_receivable_done=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`) VALUES ('PAY-V204-COMMISSION','commission',@v204_receivable_done,@v204_done,@v204_worker_user_id,'V204_WORKER_OPENID','V204_APPID','V204_MCHID','v3','CNY',4500,'paid','V204_TX_COMMISSION','2.0.4 测试平台服务费',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @v204_commission_payment=LAST_INSERT_ID();\nINSERT INTO `commission_payments` (`receivable_id`,`payment_order_id`,`amount_cents`,`status`,`paid_at`,`created_at`) VALUES (@v204_receivable_done,@v204_commission_payment,4500,'paid',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO media_links(media_file_id,entity_type,entity_id,purpose,sort_order,created_by_type,created_by_id,created_at) VALUES (@v204_completion,'order',@v204_done,'completion',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 8 DAY),(@v204_material,'order',@v204_done,'collection_receipt',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 7 DAY);\nINSERT INTO `reviews` (`public_id`,`order_id`,`user_id`,`worker_id`,`rating`,`content`,`is_auto`,`status`,`reviewed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v204-review',256),26),@v204_done,@v204_customer_id,@v204_worker_id,5,'师傅沟通及时，施工细致，完工效果满意。',0,'visible',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @v204_review=LAST_INSERT_ID();\nINSERT INTO `review_media` (`review_id`,`media_file_id`,`sort_order`,`created_at`) VALUES (@v204_review,@v204_completion,10,UTC_TIMESTAMP()-INTERVAL 5 DAY);\n\nSET @v204_refund_order=(SELECT id FROM orders WHERE public_no='BXMF202608285871');\nSET @v204_refund_payment=(SELECT id FROM payment_orders WHERE order_id=@v204_refund_order LIMIT 1);\nINSERT INTO `order_cancel_requests` (`public_id`,`order_id`,`applicant_type`,`applicant_id`,`request_type`,`order_state_snapshot_json`,`reason_code`,`reason`,`status`,`requested_refund_cents`,`requested_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v204-cancel',256),26),@v204_refund_order,'user',@v204_customer_id,'cancel_refund','{\"fulfillment_status\":\"not_started\",\"payment_status\":\"paid\"}','schedule_changed','行程变化，申请部分退回预约费。','approved',2500,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP());\nSET @v204_cancel=LAST_INSERT_ID();\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`cancel_request_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`created_at`,`updated_at`) VALUES ('REF-V204-PENDING',@v204_refund_payment,@v204_refund_order,@v204_cancel,2500,'自定义部分退款 25.00 元','pending_review',@v204_admin_id,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP());\n\nSET @v204_expired=(SELECT id FROM orders WHERE public_no='BXQZ202608288315');\nSET @v204_expired_payment=(SELECT id FROM payment_orders WHERE order_id=@v204_expired LIMIT 1);\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`amount_cents`,`reason`,`status`,`requested_at`,`succeeded_at`,`created_at`,`updated_at`) VALUES ('REF-V204-DONE',@v204_expired_payment,@v204_expired,5000,'七天未接受报价自动取消并全额退款','succeeded',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 23 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nSET @v204_dispute=(SELECT id FROM orders WHERE public_no='BXQB202608282469');\nINSERT INTO `change_requests` (`public_id`,`order_id`,`worker_id`,`original_amount_cents`,`added_amount_cents`,`new_total_cents`,`reason`,`status`,`submitted_at`,`decided_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v204-change-rejected',256),26),@v204_dispute,@v204_worker_id,135000,20000,155000,'现场墙面基层破损严重，申请增加修补费用。','rejected',UTC_TIMESTAMP()-INTERVAL 6 HOUR,UTC_TIMESTAMP()-INTERVAL 5 HOUR,UTC_TIMESTAMP()-INTERVAL 6 HOUR,UTC_TIMESTAMP());\nSET @v204_change=LAST_INSERT_ID();\nINSERT INTO `change_confirmations` (`change_request_id`,`user_id`,`decision`,`note`,`created_at`) VALUES (@v204_change,@v204_customer_id,'rejected','不同意增加费用，双方继续协商。',UTC_TIMESTAMP()-INTERVAL 5 HOUR);\nINSERT INTO `disputes` (`public_no`,`order_id`,`raised_by_type`,`raised_by_id`,`dispute_type`,`title`,`description`,`status`,`responsibility`,`refund_amount_cents`,`run_empty_fee_cents`,`opened_at`,`created_at`,`updated_at`) VALUES ('DSP-V204-OPEN',@v204_dispute,'worker',@v204_worker_id,'change_rejected','施工加价协商未达成','用户拒绝加价后双方协商未果，等待管理员依据图片与沟通记录裁定。','open','undetermined',0,0,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP());\n\n-- 每笔订单写入能够直接说明流程变化的中文时间线，不再用“订单状态已更新”占位。\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT id,'booking_fee_paid_upfront',CONCAT('v204:paid:',id),'user',@v204_customer_id,JSON_OBJECT('amount_cents',5000),created_at+INTERVAL 10 MINUTE FROM orders;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT id,'order_submitted',CONCAT('v204:submitted:',id),'user',@v204_customer_id,JSON_OBJECT('message','预约费已支付，订单资料提交管理员审核'),created_at+INTERVAL 11 MINUTE FROM orders;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT id,'order_approved',CONCAT('v204:approved:',id),'admin',@v204_admin_id,JSON_OBJECT('message','管理员审核通过，订单公开进入报价阶段'),audited_at FROM orders WHERE audit_status='approved';\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT id,'order_supplement_required',CONCAT('v204:supplement:',id),'admin',@v204_admin_id,JSON_OBJECT('reason',audit_note),audited_at FROM orders WHERE audit_status='supplement_required';\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT order_id,IF(quote_type='platform','platform_quoted','worker_quoted'),CONCAT('v204:quote:',id),IF(quote_type='platform','admin','worker'),IF(quote_type='platform',@v204_admin_id,@v204_worker_id),JSON_OBJECT('amount_cents',amount_cents),created_at FROM quotes;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT order_id,'assignment_accepted',CONCAT('v204:assignment:',id),'worker',@v204_worker_id,JSON_OBJECT('message',CONCAT(@v204_worker_name,'已接单，双方完整联系方式自动开放')),accepted_at FROM assignments;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) VALUES\n(@v204_platform_order,'worker_invite_created',CONCAT('v204:invite:',@v204_platform_order),'admin',@v204_admin_id,JSON_OBJECT('message','管理员已生成邀请师傅分享，等待师傅领取'),UTC_TIMESTAMP()),\n(@v204_scheduled,'appointment_recorded',CONCAT('v204:appointment:',@v204_scheduled),'worker',@v204_worker_id,JSON_OBJECT('message','师傅电话联系后记录：明日上午上门'),UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@v204_submitted,'completion_submitted',CONCAT('v204:completion:',@v204_submitted),'worker',@v204_worker_id,JSON_OBJECT('photo_count',1),UTC_TIMESTAMP()-INTERVAL 12 HOUR),\n(@v204_submitted,'offline_collection_delayed',CONCAT('v204:delay:',@v204_submitted),'worker',@v204_worker_id,JSON_OBJECT('amount_cents',115000),UTC_TIMESTAMP()-INTERVAL 10 HOUR),\n(@v204_done,'auto_accepted_72h',CONCAT('v204:autoaccept:',@v204_done),'system',NULL,JSON_OBJECT('message','完工满72小时，系统自动确认验收'),UTC_TIMESTAMP()-INTERVAL 6 DAY),\n(@v204_done,'review_submitted',CONCAT('v204:review:',@v204_done),'user',@v204_customer_id,JSON_OBJECT('rating',5),UTC_TIMESTAMP()-INTERVAL 5 DAY),\n(@v204_done,'commission_paid',CONCAT('v204:commission:',@v204_done),'worker',@v204_worker_id,JSON_OBJECT('message','师傅已支付平台服务费 ¥45.00，账单结清'),UTC_TIMESTAMP()-INTERVAL 5 DAY),\n(@v204_refund_order,'cancel_approved',CONCAT('v204:cancel:',@v204_refund_order),'admin',@v204_admin_id,JSON_OBJECT('message','管理员同意取消订单，部分退款 ¥25.00 等待处理'),UTC_TIMESTAMP()-INTERVAL 40 MINUTE),\n(@v204_dispute,'change_requested',CONCAT('v204:change:',@v204_dispute),'worker',@v204_worker_id,JSON_OBJECT('added_amount_cents',20000,'new_total_cents',155000),UTC_TIMESTAMP()-INTERVAL 6 HOUR),\n(@v204_dispute,'change_rejected',CONCAT('v204:reject:',@v204_dispute),'user',@v204_customer_id,JSON_OBJECT('new_total_cents',135000),UTC_TIMESTAMP()-INTERVAL 5 HOUR),\n(@v204_dispute,'dispute_opened',CONCAT('v204:dispute:',@v204_dispute),'worker',@v204_worker_id,JSON_OBJECT('message','加价被拒绝且协商未果，师傅申请平台介入'),UTC_TIMESTAMP()-INTERVAL 3 HOUR),\n(@v204_expired,'auto_cancelled_7d',CONCAT('v204:expired:',@v204_expired),'system',NULL,JSON_OBJECT('message','订单超过7天未接受报价，系统自动取消'),UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@v204_expired,'refund_succeeded',CONCAT('v204:refunded:',@v204_expired),'system',NULL,JSON_OBJECT('amount_cents',5000),UTC_TIMESTAMP()-INTERVAL 23 HOUR);\n\n-- 2026-08-28：优先复用师傅原有支付宝账号；没有账号时只用现有脱敏资料建立明确的测试账号，不伪造真实姓名和手机号。\nSET @v204_payout_account=(SELECT `id` FROM `worker_payout_accounts` WHERE `worker_id`=@v204_worker_id AND `status`='active' ORDER BY `is_default` DESC,`id` LIMIT 1);\nINSERT INTO `worker_payout_accounts` (`worker_id`,`account_type`,`holder_name_masked`,`holder_name_ciphertext`,`account_masked`,`account_ciphertext`,`account_hmac`,`status`,`is_default`,`verified_at`,`created_at`,`updated_at`)\nSELECT w.`id`,'alipay',w.`display_name`,w.`display_name`,u.`mobile_masked`,u.`mobile_masked`,SHA2(CONCAT('V204-DEMO-ALIPAY-',u.`public_id`),256),'active',1,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `worker_profiles` w INNER JOIN `users` u ON u.`id`=w.`user_id` WHERE w.`id`=@v204_worker_id AND @v204_payout_account IS NULL;\nSET @v204_payout_account=(SELECT `id` FROM `worker_payout_accounts` WHERE `worker_id`=@v204_worker_id AND `status`='active' ORDER BY `is_default` DESC,`id` LIMIT 1);\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v204_worker_id,'run_empty_fee','credit',10000,10000,0,'test_adjustment',204,'v204:balance','跑空费进入余额测试','effective',UTC_TIMESTAMP()-INTERVAL 2 DAY);\nINSERT INTO `withdrawal_requests` (`public_no`,`worker_id`,`payout_account_id`,`amount_cents`,`account_type_snapshot`,`holder_name_masked_snapshot`,`holder_name_ciphertext_snapshot`,`account_masked_snapshot`,`account_ciphertext_snapshot`,`status`,`review_note`,`submitted_at`,`reviewed_at`,`created_at`,`updated_at`)\nSELECT 'WD-V204-PENDING',@v204_worker_id,p.`id`,3000,p.`account_type`,p.`holder_name_masked`,p.`holder_name_ciphertext`,p.`account_masked`,p.`account_ciphertext`,'pending','待管理员审核并人工支付宝转账',UTC_TIMESTAMP()-INTERVAL 1 HOUR,NULL,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP() FROM `worker_payout_accounts` p WHERE p.`id`=@v204_payout_account\nUNION ALL\nSELECT 'WD-V204-APPROVED',@v204_worker_id,p.`id`,2000,p.`account_type`,p.`holder_name_masked`,p.`holder_name_ciphertext`,p.`account_masked`,p.`account_ciphertext`,'approved','审核通过，等待管理员登记付款结果',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 20 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP() FROM `worker_payout_accounts` p WHERE p.`id`=@v204_payout_account;\n\nINSERT INTO `rating_summaries` (`worker_id`,`review_count`,`rating_sum`,`rating_average`,`five_star_count`,`updated_at`) VALUES (@v204_worker_id,1,5,5.00,1,UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE `review_count`=VALUES(`review_count`),`rating_sum`=VALUES(`rating_sum`),`rating_average`=VALUES(`rating_average`),`five_star_count`=VALUES(`five_star_count`),`updated_at`=VALUES(`updated_at`);\nUPDATE media_files m SET m.reference_count=(SELECT COUNT(*) FROM media_links l WHERE l.media_file_id=m.id) WHERE m.id IN (@v204_material,@v204_wall,@v204_completion);\n\nSELECT 'V2.0.4 管理操作、中文时间线及双测试身份全流程数据已重建' AS `升级结果`;\n","server/database/upgrades/2.0.5.sql":"-- 2026-08-29：V2.0.5 财务查询、补资料闭环、尾款坏账与师傅报价上限。\n-- 本迁移不清理订单、用户或师傅数据，可在 MySQL 5.7.44 重复执行。\nSET NAMES utf8mb4;\n\n-- 2026-08-29：旧云师傅图片按来源指纹只导入一次，失败可在下次登录或手动同步时重试。\nCREATE TABLE IF NOT EXISTS `worker_cloud_media_imports` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `worker_id` BIGINT UNSIGNED NOT NULL,\n  `source_hash` CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `source_reference` VARCHAR(1000) NOT NULL,\n  `media_file_id` BIGINT UNSIGNED NULL,\n  `status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n  `error_message` VARCHAR(500) NULL,\n  `imported_at` DATETIME NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_worker_cloud_media_source` (`worker_id`,`source_hash`),\n  KEY `idx_worker_cloud_media_file` (`media_file_id`),\n  KEY `idx_worker_cloud_media_status` (`status`,`updated_at`),\n  CONSTRAINT `fk_worker_cloud_media_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_cloud_media_file` FOREIGN KEY (`media_file_id`) REFERENCES `media_files` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-29：旧云师傅图片迁移记录';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.5','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order.max_worker_quotes','3','integer','order',1,'每笔订单最多允许多少名师傅同时报价',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order.id_watermark_text','仅限办理壁选业务使用','string','order',0,'身份证正反面图片合成保存的用途水印文字',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`value_type`=VALUES(`value_type`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-29：修复旧客户端只写取消申请、没有同步订单退款状态的问题。\nUPDATE `orders` o\nINNER JOIN `order_cancel_requests` r ON r.id=(SELECT r1.id FROM `order_cancel_requests` r1 WHERE r1.order_id=o.id ORDER BY r1.id DESC LIMIT 1)\nSET o.`refund_status`='pending_review',o.`publish_status`='hidden',o.`updated_at`=UTC_TIMESTAMP()\nWHERE r.`status` IN ('pending','processing') AND o.`refund_status` IN ('none','failed') AND o.`lifecycle_status`='active';\n\n-- 2026-08-29：旧的“待处理/已知悉/已处理/已驳回”都归并为已登记；以后只有坏账需管理员操作。\nUPDATE `offline_payment_delay_requests`\nSET `status`='reported',`reviewed_by`=NULL,`review_note`=NULL,`reviewed_at`=NULL,`updated_at`=UTC_TIMESTAMP()\nWHERE `status` IN ('pending','acknowledged','resolved','rejected');\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('offline_payment_delay_requests','status','尾款登记状态','已登记或已标记坏账',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('offline_payment_delay_requests','review_note','坏账说明','师傅放弃收款时由管理员填写',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('quotes','current_version','当前报价版本','师傅每次修改报价后递增',UTC_TIMESTAMP(),UTC_TIMESTAMP())\n,\n('worker_cloud_media_imports','source_hash','云图片来源指纹','防止旧云图片重复下载和重复占用服务器空间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_cloud_media_imports','status','图片迁移状态','待处理、成功或失败',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','profile_source','师傅资料权威来源','服务器主档或旧云兼容资料',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','cloud_worker_id','旧云师傅记录编号','用于屏蔽云地图重复标点并保留迁移映射',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n","server/database/upgrades/2.0.6.sql":"-- 2026-08-30：V2.0.6 师傅云开发主数据与 PHP 管理中转配置。\n-- 本迁移不删除、不迁移师傅资料；旧 worker 数据继续完整保留在云开发数据库。\nSET NAMES utf8mb4;\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.6','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.worker_admin_function','worker','string','wechat',0,'PHP 后台调用的师傅管理云函数名称',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.worker_admin_secret','','string','wechat',0,'PHP 与 worker 云函数共用的 HMAC 签名密钥；后台可生成 64 位随机值，按运营要求明文保存并回显',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n`setting_value`=IF(`setting_key`='app.version',VALUES(`setting_value`),`setting_value`),\n`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings`\nSET `description`='云开发环境 ID，师傅资料唯一主数据所在环境',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.cloud_env';\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('worker_profiles','cloud_worker_id','云端师傅主记录编号','关联云开发 worker 集合唯一主记录；公开资料不在 MySQL 重复保存',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','cloud_record_mode','云端记录模式','cloud_authoritative 表示云开发是唯一主数据',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','profile_source','师傅资料来源','cloud 表示完整资料实时从云开发读取',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','profile_json','旧版师傅资料兼容字段','V2.0.6 起不再作为师傅主档，新数据保持为空',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','cloud_snapshot_json','旧版云资料快照兼容字段','V2.0.6 起不再复制云端完整资料或图片，新数据保持为空',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n","server/database/upgrades/2.0.7.sql":"-- 2026-08-30：V2.0.7 维护开关、提现冻结修正与师傅云端筛选配套升级。\n-- 本迁移不删除用户、师傅、订单或支付数据，可在 MySQL 5.7.44 重复执行。\nSET NAMES utf8mb4;\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.7','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('development.pause_orders','0','boolean','development',1,'维护开关：暂停用户创建新订单，维护前已创建的草稿和进行中订单不受影响',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n`setting_value`=IF(`setting_key`='app.version',VALUES(`setting_value`),`setting_value`),\n`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-30：V2.0.4 测试提现曾只写申请、未写冻结流水。仅修正指定测试师傅当前仍待处理且缺少冻结流水的申请。\n-- 2026-08-30：修正版不再将 ascii_bin 的提现单号与 utf8mb4 中文拼接，兼容 MySQL 5.7 的严格排序规则检查。\nSET @v207_worker_id=(SELECT w.`id` FROM `worker_profiles` w INNER JOIN `users` u ON u.`id`=w.`user_id` WHERE u.`public_id`='4P6VCTD79R5B9QHYRWGNB7VBRG' ORDER BY w.`id` DESC LIMIT 1);\nSET @v207_missing_freeze=(\n  SELECT COALESCE(SUM(wr.`amount_cents`),0)\n  FROM `withdrawal_requests` wr\n  WHERE wr.`worker_id`=@v207_worker_id AND wr.`status` IN ('pending','approved','payment_failed')\n    AND NOT EXISTS (\n      SELECT 1 FROM `worker_balance_ledger` bl\n      WHERE bl.`worker_id`=wr.`worker_id` AND bl.`business_type`='withdrawal_request' AND bl.`business_id`=wr.`id`\n        AND bl.`entry_type`='withdrawal_freeze' AND bl.`status`='effective'\n    )\n);\nSET @v207_available=(SELECT COALESCE(SUM(`available_delta_cents`),0) FROM `worker_balance_ledger` WHERE `worker_id`=@v207_worker_id AND `status`='effective');\nSET @v207_test_topup=GREATEST(0,@v207_missing_freeze-@v207_available);\n\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`)\nSELECT @v207_worker_id,'test_adjustment','credit',@v207_test_topup,@v207_test_topup,0,'test_adjustment',207,'v207:withdrawal:test-topup','V2.0.7 提现测试余额校正','effective',UTC_TIMESTAMP()\nFROM DUAL WHERE @v207_worker_id IS NOT NULL AND @v207_test_topup>0\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`);\n\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`)\nSELECT wr.`worker_id`,'withdrawal_freeze','transfer',wr.`amount_cents`,-wr.`amount_cents`,wr.`amount_cents`,'withdrawal_request',wr.`id`,CONCAT('v207:withdrawal:freeze:',CAST(wr.`id` AS CHAR CHARACTER SET utf8mb4)),'V2.0.7 提现申请冻结余额修正','effective',wr.`submitted_at`\nFROM `withdrawal_requests` wr\nWHERE wr.`worker_id`=@v207_worker_id AND wr.`status` IN ('pending','approved','payment_failed')\n  AND NOT EXISTS (\n    SELECT 1 FROM `worker_balance_ledger` bl\n    WHERE bl.`worker_id`=wr.`worker_id` AND bl.`business_type`='withdrawal_request' AND bl.`business_id`=wr.`id`\n      AND bl.`entry_type`='withdrawal_freeze' AND bl.`status`='effective'\n  );\n\nINSERT IGNORE INTO `withdrawal_allocations` (`withdrawal_request_id`,`ledger_entry_id`,`amount_cents`,`created_at`)\nSELECT wr.`id`,bl.`id`,wr.`amount_cents`,UTC_TIMESTAMP()\nFROM `withdrawal_requests` wr\nINNER JOIN `worker_balance_ledger` bl ON bl.`worker_id`=wr.`worker_id` AND bl.`business_type`='withdrawal_request' AND bl.`business_id`=wr.`id` AND bl.`entry_type`='withdrawal_freeze' AND bl.`status`='effective'\nWHERE wr.`worker_id`=@v207_worker_id AND wr.`status` IN ('pending','approved','payment_failed');\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('worker_balance_ledger','frozen_delta_cents','冻结金额变动（分）','提现申请冻结为正，撤销、驳回或付款完成释放为负',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.0.7 维护开关、提现冻结金额及师傅云端管理配套升级完成' AS `升级结果`;\n","server/database/upgrades/2.0.8.sql":"-- 2026-08-31：V2.0.8 商家认证、行为识别、信息隔离及商家订单收款码。\n-- 兼容 MySQL 5.7.44；不清理既有用户、师傅、订单或财务数据。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_208_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_208_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='owner_mobile_base_hmac') THEN\n    ALTER TABLE `orders` ADD COLUMN `owner_mobile_base_hmac` CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL AFTER `contact_mobile_hmac`, ADD KEY `idx_orders_owner_mobile_base` (`owner_mobile_base_hmac`,`created_at`);\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='order_source_type') THEN\n    ALTER TABLE `orders` ADD COLUMN `order_source_type` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'consumer' AFTER `owner_mobile_base_hmac`, ADD KEY `idx_orders_source_created` (`order_source_type`,`created_at`);\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='merchant_profile_id') THEN\n    ALTER TABLE `orders` ADD COLUMN `merchant_profile_id` BIGINT UNSIGNED NULL AFTER `order_source_type`, ADD KEY `idx_orders_merchant_created` (`merchant_profile_id`,`created_at`);\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='merchant_risk_level') THEN\n    ALTER TABLE `orders` ADD COLUMN `merchant_risk_level` VARCHAR(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'none' AFTER `merchant_profile_id`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_208_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_208_schema`;\n\nCREATE TABLE IF NOT EXISTS `merchant_profiles` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `public_id` CHAR(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` BIGINT UNSIGNED NOT NULL,\n  `business_name` VARCHAR(160) NOT NULL DEFAULT '',\n  `legal_representative` VARCHAR(80) NOT NULL DEFAULT '',\n  `credit_code_masked` VARCHAR(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '',\n  `credit_code_ciphertext` TEXT NULL,\n  `credit_code_hmac` CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `business_scope` VARCHAR(1000) NULL,\n  `business_address` VARCHAR(500) NULL,\n  `materials_description` VARCHAR(500) NULL,\n  `license_media_file_id` BIGINT UNSIGNED NULL,\n  `verification_status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'none',\n  `recognition_level` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'consumer',\n  `risk_score` INT UNSIGNED NOT NULL DEFAULT 0,\n  `order_count_7d` INT UNSIGNED NOT NULL DEFAULT 0,\n  `same_phone_warning_count` INT UNSIGNED NOT NULL DEFAULT 0,\n  `review_reason` VARCHAR(500) NULL,\n  `submitted_at` DATETIME NULL,\n  `reviewed_at` DATETIME NULL,\n  `reviewed_by` BIGINT UNSIGNED NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_merchant_profiles_public` (`public_id`),\n  UNIQUE KEY `uq_merchant_profiles_user` (`user_id`),\n  UNIQUE KEY `uq_merchant_profiles_credit` (`credit_code_hmac`),\n  KEY `idx_merchant_profiles_status_updated` (`verification_status`,`updated_at`),\n  CONSTRAINT `fk_merchant_profiles_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_merchant_profiles_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-31：商家认证和行为识别主档';\n\nCREATE TABLE IF NOT EXISTS `merchant_risk_events` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `merchant_profile_id` BIGINT UNSIGNED NULL,\n  `user_id` BIGINT UNSIGNED NOT NULL,\n  `order_id` BIGINT UNSIGNED NULL,\n  `event_type` VARCHAR(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `risk_level` VARCHAR(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'medium',\n  `signal_value` INT NOT NULL DEFAULT 0,\n  `details_json` LONGTEXT NULL,\n  `status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'new',\n  `created_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  KEY `idx_merchant_risk_status_time` (`status`,`created_at`),\n  KEY `idx_merchant_risk_user_time` (`user_id`,`created_at`),\n  CONSTRAINT `fk_merchant_risk_profile` FOREIGN KEY (`merchant_profile_id`) REFERENCES `merchant_profiles` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_merchant_risk_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_merchant_risk_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-31：商家行为识别事件';\n\nCREATE TABLE IF NOT EXISTS `worker_collection_codes` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `public_id` CHAR(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `worker_id` BIGINT UNSIGNED NOT NULL,\n  `code_type` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'wechat',\n  `media_file_id` BIGINT UNSIGNED NULL,\n  `status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft',\n  `review_reason` VARCHAR(500) NULL,\n  `submitted_at` DATETIME NULL,\n  `reviewed_at` DATETIME NULL,\n  `reviewed_by` BIGINT UNSIGNED NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_worker_collection_codes_public` (`public_id`),\n  UNIQUE KEY `uq_worker_collection_codes_worker` (`worker_id`),\n  KEY `idx_worker_collection_codes_status` (`status`,`updated_at`),\n  CONSTRAINT `fk_worker_collection_codes_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_collection_codes_media` FOREIGN KEY (`media_file_id`) REFERENCES `media_files` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_collection_codes_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-31：商家订单线下收款码审核';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.8','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('commission.merchant_verified_rate_bp','800','integer','finance',0,'已认证商家订单平台服务费比例，万分比；默认 8.00%',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('commission.merchant_detected_rate_bp','1000','integer','finance',0,'行为识别商家订单平台服务费比例，万分比；默认 10.00%',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('commission.merchant_minimum_cents','5000','integer','finance',0,'商家订单最低平台服务费，单位分',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=IF(`setting_key`='app.version',VALUES(`setting_value`),`setting_value`),`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('orders','order_source_type','订单客户类型','consumer 普通用户订单，merchant 商家订单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','merchant_profile_id','商家档案编号','商家订单关联的商家认证或行为识别档案',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','merchant_risk_level','商家风控等级','none、medium 或 high',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','owner_mobile_base_hmac','业主手机号校验摘要','用于识别不同账号重复填写同一业主号码，不保存明文',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('merchant_profiles','verification_status','商家认证状态','未认证、草稿、待审核、已认证、驳回或暂停',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('merchant_profiles','recognition_level','商家识别等级','普通用户、疑似商家、行为确认商家或已认证商家',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_collection_codes','status','收款码审核状态','仅审核通过的收款码可向已完工商家订单展示',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.0.8 商家认证、信息隔离与商家订单收款码升级完成' AS `升级结果`;\n","server/database/upgrades/2.0.9.sql":"-- 2026-09-02：V2.0.9 完工水印、实际尾款审批、七牛存储和阿里云短信。\n\nSET @v209_has_metadata := (SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='media_files' AND COLUMN_NAME='metadata_json');\nSET @v209_sql := IF(@v209_has_metadata=0,'ALTER TABLE `media_files` ADD COLUMN `metadata_json` LONGTEXT NULL AFTER `compression_quality`','SELECT 1');\nPREPARE v209_stmt FROM @v209_sql; EXECUTE v209_stmt; DEALLOCATE PREPARE v209_stmt;\n\nCREATE TABLE IF NOT EXISTS `offline_collection_adjustment_requests` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `public_id` CHAR(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `order_id` BIGINT UNSIGNED NOT NULL,\n  `worker_id` BIGINT UNSIGNED NOT NULL,\n  `assignment_id` BIGINT UNSIGNED NOT NULL,\n  `original_total_cents` BIGINT UNSIGNED NOT NULL,\n  `original_tail_cents` BIGINT UNSIGNED NOT NULL,\n  `requested_total_cents` BIGINT UNSIGNED NOT NULL,\n  `requested_tail_cents` BIGINT UNSIGNED NOT NULL,\n  `reason` VARCHAR(500) NOT NULL,\n  `receipt_media_ids_json` LONGTEXT NOT NULL,\n  `status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n  `reviewed_by` BIGINT UNSIGNED NULL,\n  `review_note` VARCHAR(500) NULL,\n  `submitted_at` DATETIME NOT NULL,\n  `reviewed_at` DATETIME NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_offline_collection_adjustment_public` (`public_id`),\n  KEY `idx_offline_collection_adjustment_order` (`order_id`,`status`,`id`),\n  KEY `idx_offline_collection_adjustment_worker` (`worker_id`,`status`,`id`),\n  CONSTRAINT `fk_offline_collection_adjustment_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_offline_collection_adjustment_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_offline_collection_adjustment_assignment` FOREIGN KEY (`assignment_id`) REFERENCES `assignments` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_offline_collection_adjustment_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-09-02：实际尾款与凭证审批';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('sms.admin_mobile','','string','sms',0,'接收订单审核、退款和实际尾款待办的管理员手机号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('media.storage_disk','private_local','string','media',0,'新上传图片存储驱动：private_local 或 qiniu，历史文件不迁移',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.enabled','false','boolean','storage',0,'启用后且图片存储驱动为 qiniu 时，新上传压缩图写入七牛',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.access_key','','string','storage',0,'七牛 AccessKey，按运营要求明文保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.secret_key','','string','storage',0,'七牛 SecretKey，按运营要求明文保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.bucket','','string','storage',0,'七牛对象存储空间名称',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.domain','','string','storage',0,'七牛绑定的 HTTPS 访问域名，不含路径',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.region','z2','string','storage',0,'七牛存储区域',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.upload_host','','string','storage',0,'可选：七牛自定义上传域名，留空按区域自动选择',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.path_prefix','worker','string','storage',0,'七牛对象键统一前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.private_bucket','true','boolean','storage',0,'私有空间自动生成短期下载签名',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('app.version','2.0.9','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings` SET `setting_value`='aliyun',`description`='阿里云短信服务商标识 aliyun',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='sms.provider' AND (`setting_value`='' OR `setting_value`='aliyun');\nUPDATE `system_settings` SET `description`='短信 AccessKey ID，按运营要求明文保存并回显',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='sms.access_key_id';\nUPDATE `system_settings` SET `description`='短信 AccessKey Secret，按运营要求明文保存并回显',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='sms.access_key_secret';\nUPDATE `system_settings` SET `setting_value`='2.0.9',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('media_files','metadata_json','图片业务元数据','完工照水印时间、地点和坐标等核验信息',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('offline_collection_adjustment_requests','original_tail_cents','原尾款金额','审批前订单预计线下尾款，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('offline_collection_adjustment_requests','requested_tail_cents','实际尾款金额','师傅按收款凭证申报的实际线下尾款，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('offline_collection_adjustment_requests','receipt_media_ids_json','收款凭证快照','申请时关联的收款凭证媒体编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('offline_collection_adjustment_requests','status','审批状态','待审批、已核准或未核准',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.0.9 完工水印、实际尾款审批、七牛存储和阿里云短信升级完成' AS `升级结果`;\n","server/database/upgrades/2.1.0.sql":"-- 2026-09-02：V2.1.0 分通道消息、七牛 HTTP 分类路径、运营公告与云端列表缓存。\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('sms.event_switches','{\"order_ready_for_prepayment\":true,\"order_submitted\":true,\"order_approved\":true,\"order_supplement_required\":true,\"order_supplemented\":true,\"order_rejected\":true,\"worker_quoted\":true,\"worker_quote_updated\":true,\"platform_quoted\":true,\"quote_selected_pending_payment\":true,\"payment_reservation_released\":true,\"booking_fee_paid\":true,\"booking_fee_paid_upfront\":true,\"worker_assigned\":true,\"assignment_accepted\":true,\"appointment_recorded\":true,\"change_requested\":true,\"change_accepted\":true,\"change_rejected\":true,\"completion_submitted\":true,\"completion_accepted_by_user\":true,\"auto_completion_accepted\":true,\"auto_accepted_72h\":true,\"exceptional_arrival_reported\":true,\"offline_collection_delayed\":true,\"offline_collection_bad_debt\":true,\"cancel_requested\":true,\"cancel_approved\":true,\"admin_cancelled\":true,\"cancel_rejected\":true,\"auto_cancelled_7d\":true,\"refund_succeeded\":true,\"offline_collection_adjustment_requested\":true,\"offline_collection_adjustment_approved\":true,\"offline_collection_adjustment_rejected\":true,\"commission_receivable_created\":true,\"commission_paid\":true,\"dispute_opened\":true,\"dispute_resolved\":true,\"review_submitted\":true,\"auto_reviewed_5d\":true}','json','sms',0,'用户和师傅短信按业务环节独立启停',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wecom.webhook_enabled','false','boolean','wecom',0,'管理员待办改用企业微信群机器人通知',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wecom.webhook_url','','string','wecom',0,'企业微信群机器人 Webhook 完整地址，明文保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wecom.webhook_mention_mobile','','string','wecom',0,'可选：通知时提醒指定管理员手机号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wecom.event_switches','{\"order_submitted\":true,\"order_supplemented\":true,\"exceptional_arrival_reported\":true,\"offline_collection_delayed\":true,\"cancel_requested\":true,\"auto_cancelled_7d\":true,\"offline_collection_adjustment_requested\":true,\"dispute_opened\":true}','json','wecom',0,'管理员企业微信通知按业务环节独立启停',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.protocol','http','string','storage',0,'七牛上传与回源固定使用 HTTP；小程序经本站 HTTPS 图片接口代理',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.merchant_license','merchant-licenses','string','storage',0,'商家营业执照对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.worker_identity','worker-identities','string','storage',0,'师傅身份证对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.order','order-images','string','storage',0,'订单材料及现场图片对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.completion','completion-images','string','storage',0,'完工照片对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.collection_receipt','collection-receipts','string','storage',0,'实际尾款收款凭证对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.worker_collection_code','worker-collection-codes','string','storage',0,'师傅商家单收款码对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.review','review-images','string','storage',0,'评价图片对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('qiniu.prefix.general','other-images','string','storage',0,'其他图片对象路径前缀',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.enabled','false','boolean','announcement',0,'是否在指定小程序页面顶部显示公告',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.text','','string','announcement',0,'公告文字，最多五百字',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.link','','string','announcement',0,'可选小程序页面路径或 HTTPS 网页链接',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.worker_list_cache_seconds','60','integer','wechat',0,'后台云端师傅列表缓存秒数，资料变更后自动失效',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('app.version','2.1.0','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings` SET `setting_value`='http',`description`='七牛上传与回源固定使用 HTTP；小程序经本站 HTTPS 图片接口代理',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='qiniu.protocol';\nUPDATE `system_settings` SET `description`='七牛绑定的 HTTP 访问域名，不含路径',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='qiniu.domain';\nUPDATE `system_settings` SET `setting_value`='2.1.0',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('system_settings','sms.event_switches','短信发送环节开关','按订单业务环节启停用户和师傅短信',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('system_settings','wecom.event_switches','管理员通知环节开关','按订单业务环节启停企业微信机器人提醒',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.1.0 消息分流、七牛 HTTP 分类路径、公告和云端缓存升级完成' AS `升级结果`;\n","server/database/upgrades/2.1.1.sql":"-- 2026-09-02：V2.1.1 消息配置对比度、七牛云凭证与分页公告修复。\n\n-- 2026-09-02：保留 V2.1.0 已填写的全局公告，首次拆分时复制给四个页面，后续各自维护。\nSET @v211_announcement_enabled := COALESCE((SELECT `setting_value` FROM `system_settings` WHERE `setting_key`='announcement.enabled' LIMIT 1),'false');\nSET @v211_announcement_text := COALESCE((SELECT `setting_value` FROM `system_settings` WHERE `setting_key`='announcement.text' LIMIT 1),'');\nSET @v211_announcement_link := COALESCE((SELECT `setting_value` FROM `system_settings` WHERE `setting_key`='announcement.link' LIMIT 1),'');\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('announcement.order_submit.enabled',@v211_announcement_enabled,'boolean','announcement',0,'我要下单：是否显示页面顶部公告',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.order_submit.text',@v211_announcement_text,'string','announcement',0,'我要下单：页面顶部公告文字',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.order_submit.link',@v211_announcement_link,'string','announcement',0,'我要下单：可选跳转链接',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.order_hall.enabled',@v211_announcement_enabled,'boolean','announcement',0,'接单大厅：是否显示页面顶部公告',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.order_hall.text',@v211_announcement_text,'string','announcement',0,'接单大厅：页面顶部公告文字',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.order_hall.link',@v211_announcement_link,'string','announcement',0,'接单大厅：可选跳转链接',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.merchant_auth.enabled',@v211_announcement_enabled,'boolean','announcement',0,'商家认证：是否显示页面顶部公告',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.merchant_auth.text',@v211_announcement_text,'string','announcement',0,'商家认证：页面顶部公告文字',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.merchant_auth.link',@v211_announcement_link,'string','announcement',0,'商家认证：可选跳转链接',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.quote_orders.enabled',@v211_announcement_enabled,'boolean','announcement',0,'报价订单：是否显示页面顶部公告',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.quote_orders.text',@v211_announcement_text,'string','announcement',0,'报价订单：页面顶部公告文字',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('announcement.quote_orders.link',@v211_announcement_link,'string','announcement',0,'报价订单：可选跳转链接',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('app.version','2.1.1','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings` SET `setting_value`='2.1.1',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\nSELECT 'V2.1.1 消息配置、七牛云凭证和分页公告修复完成' AS `升级结果`;\n","server/database/upgrades/2.1.2.sql":"-- 2026-09-03：V2.1.2 取消订单复用、跑空费协商、双收款码与认证资料管理。\n\nCREATE TABLE IF NOT EXISTS `worker_collection_code_items` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `public_id` CHAR(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `worker_id` BIGINT UNSIGNED NOT NULL,\n  `code_type` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `media_file_id` BIGINT UNSIGNED NULL,\n  `status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft',\n  `review_reason` VARCHAR(500) NULL,\n  `submitted_at` DATETIME NULL,\n  `reviewed_at` DATETIME NULL,\n  `reviewed_by` BIGINT UNSIGNED NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_worker_collection_code_items_public` (`public_id`),\n  UNIQUE KEY `uq_worker_collection_code_items_worker_type` (`worker_id`,`code_type`),\n  KEY `idx_worker_collection_code_items_status` (`status`,`updated_at`),\n  CONSTRAINT `fk_worker_collection_code_items_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_collection_code_items_media` FOREIGN KEY (`media_file_id`) REFERENCES `media_files` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_collection_code_items_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-09-03：微信和支付宝商家单收款码';\n\n-- 2026-09-03：把旧版唯一收款码迁入双类型表，旧表保留用于回退。\nINSERT IGNORE INTO `worker_collection_code_items`\n(`public_id`,`worker_id`,`code_type`,`media_file_id`,`status`,`review_reason`,`submitted_at`,`reviewed_at`,`reviewed_by`,`created_at`,`updated_at`)\nSELECT `public_id`,`worker_id`,IF(`code_type`='alipay','alipay','wechat'),`media_file_id`,`status`,`review_reason`,`submitted_at`,`reviewed_at`,`reviewed_by`,`created_at`,`updated_at`\nFROM `worker_collection_codes`;\n\nCREATE TABLE IF NOT EXISTS `run_empty_fee_claims` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `public_id` CHAR(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `order_id` BIGINT UNSIGNED NOT NULL,\n  `change_request_id` BIGINT UNSIGNED NOT NULL,\n  `worker_id` BIGINT UNSIGNED NOT NULL,\n  `order_source_type` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'consumer',\n  `collection_mode` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'offline',\n  `amount_cents` BIGINT UNSIGNED NOT NULL,\n  `reason` VARCHAR(1000) NOT NULL,\n  `status` VARCHAR(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending_confirmation',\n  `user_note` VARCHAR(500) NULL,\n  `dispute_id` BIGINT UNSIGNED NULL,\n  `submitted_at` DATETIME NOT NULL,\n  `decided_at` DATETIME NULL,\n  `paid_at` DATETIME NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_run_empty_fee_claims_public` (`public_id`),\n  UNIQUE KEY `uq_run_empty_fee_claims_change` (`change_request_id`),\n  KEY `idx_run_empty_fee_claims_order_status` (`order_id`,`status`),\n  KEY `idx_run_empty_fee_claims_worker_status` (`worker_id`,`status`),\n  CONSTRAINT `fk_run_empty_fee_claims_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_run_empty_fee_claims_change` FOREIGN KEY (`change_request_id`) REFERENCES `change_requests` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_run_empty_fee_claims_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_run_empty_fee_claims_dispute` FOREIGN KEY (`dispute_id`) REFERENCES `disputes` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-09-03：拒绝加价后的跑空费协商和商家支付';\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('worker_collection_code_items','code_type','收款码类型','微信和支付宝两种收款码可同时存在',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_collection_code_items','status','收款码审核状态','草稿、待审核、已通过或已驳回',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('run_empty_fee_claims','collection_mode','跑空费收取方式','普通用户线下收取，商家订单线上支付',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('run_empty_fee_claims','amount_cents','跑空费金额','以分为单位保存师傅提出的跑空费',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('run_empty_fee_claims','status','跑空费处理状态','待确认、待支付、已支付、争议中或已取消',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-09-03：短信只保留需要用户或师傅及时操作的重要环节；自动验收和自动评价不再发送。\nUPDATE `system_settings` SET `setting_value`='{\"order_approved\":true,\"order_supplement_required\":true,\"order_rejected\":true,\"worker_quoted\":true,\"worker_quote_updated\":true,\"platform_quoted\":true,\"worker_assigned\":true,\"assignment_accepted\":true,\"change_requested\":true,\"change_accepted\":true,\"change_rejected\":true,\"completion_submitted\":true,\"cancel_requested\":true,\"cancel_approved\":true,\"cancel_rejected\":true,\"auto_cancelled_7d\":true,\"refund_succeeded\":true,\"offline_collection_adjustment_approved\":true,\"offline_collection_adjustment_rejected\":true,\"commission_receivable_created\":true,\"dispute_opened\":true,\"dispute_resolved\":true,\"run_empty_claim_submitted\":true,\"run_empty_claim_confirmed\":true,\"run_empty_claim_disputed\":true,\"run_empty_fee_paid\":true}',`description`='只向用户和师傅发送需要及时处理的重要订单短信',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='sms.event_switches';\nUPDATE `system_settings` SET `setting_value`='{\"order_submitted\":true,\"order_supplemented\":true,\"exceptional_arrival_reported\":true,\"cancel_requested\":true,\"offline_collection_adjustment_requested\":true,\"dispute_opened\":true,\"run_empty_claim_disputed\":true,\"worker_realname_submitted\":true,\"worker_collection_code_submitted\":true,\"merchant_auth_submitted\":true}',`description`='管理员企业微信只提醒需要人工处理的待办',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='wecom.event_switches';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.1.2','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings` SET `setting_value`='2.1.2',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\nSELECT 'V2.1.2 订单复用、跑空费协商、双收款码和认证管理升级完成' AS `升级结果`;\n","server/database/upgrades/2.1.3.sql":"-- 2026-09-04：V2.1.3 师傅审核一致性、单一收款码与当前订单财务演示数据重建。\n-- 本脚本只删除 orders.is_demo=1 的订单链及 V204/V213 标记的演示提现流水，不修改真实业务数据。\nSET NAMES utf8mb4;\n\nSET @v213_customer_id=(SELECT `id` FROM `users` WHERE BINARY `public_id`=BINARY 'BE20FMBCSMG6924JK21TE0RJTP' LIMIT 1);\nSET @v213_worker_user_id=(SELECT `id` FROM `users` WHERE BINARY `public_id`=BINARY '4P6VCTD79R5B9QHYRWGNB7VBRG' LIMIT 1);\nSET @v213_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `user_id`=@v213_worker_user_id ORDER BY `id` DESC LIMIT 1);\nSET @v213_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\nSET @v213_schema_id=(SELECT `id` FROM `form_schema_versions` WHERE `status`='published' ORDER BY `version_no` DESC,`id` DESC LIMIT 1);\nSET @v213_qz=(SELECT `id` FROM `service_categories` WHERE `category_key`='wallpaper' LIMIT 1);\nSET @v213_qb=(SELECT `id` FROM `service_categories` WHERE `category_key`='wall_cloth' LIMIT 1);\nSET @v213_blm=(SELECT `id` FROM `service_categories` WHERE `category_key`='glass_film' LIMIT 1);\nSET @v213_jjm=(SELECT `id` FROM `service_categories` WHERE `category_key`='furniture_film' LIMIT 1);\nSET @v213_cl=(SELECT `id` FROM `service_categories` WHERE `category_key`='curtain' LIMIT 1);\nSET @v213_mf=(SELECT `id` FROM `service_categories` WHERE `category_key`='beauty_seam' LIMIT 1);\n\nSET @v213_old_fk_checks=@@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\n\n-- 2026-09-04：先删除旧演示订单的所有子表，关联条件只认 is_demo，不依赖订单号文字。\nDELETE rm FROM `review_media` rm INNER JOIN `reviews` r ON r.`id`=rm.`review_id` INNER JOIN `orders` o ON o.`id`=r.`order_id` AND o.`is_demo`=1;\nDELETE rr FROM `review_replies` rr INNER JOIN `reviews` r ON r.`id`=rr.`review_id` INNER JOIN `orders` o ON o.`id`=r.`order_id` AND o.`is_demo`=1;\nDELETE de FROM `dispute_evidence` de INNER JOIN `disputes` d ON d.`id`=de.`dispute_id` INNER JOIN `orders` o ON o.`id`=d.`order_id` AND o.`is_demo`=1;\n-- 2026-09-04：quote_items 通过 quote_version_id 关联报价版本，兼容当前及历史 MySQL 5.7 数据结构。\nDELETE qi FROM `quote_items` qi INNER JOIN `quote_versions` qv_cleanup ON qv_cleanup.`id`=qi.`quote_version_id` INNER JOIN `quotes` q ON q.`id`=qv_cleanup.`quote_id` INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nDELETE cp FROM `commission_payments` cp INNER JOIN `commission_receivables` cr ON cr.`id`=cp.`receivable_id` INNER JOIN `orders` o ON o.`id`=cr.`order_id` AND o.`is_demo`=1;\nDELETE ca FROM `commission_adjustments` ca INNER JOIN `commission_receivables` cr ON cr.`id`=ca.`receivable_id` INNER JOIN `orders` o ON o.`id`=cr.`order_id` AND o.`is_demo`=1;\nDELETE pn FROM `payment_notifications` pn INNER JOIN `payment_orders` p ON p.`id`=pn.`payment_order_id` INNER JOIN `orders` o ON o.`id`=p.`order_id` AND o.`is_demo`=1;\nDELETE ci FROM `change_items` ci INNER JOIN `change_requests` c ON c.`id`=ci.`change_request_id` INNER JOIN `orders` o ON o.`id`=c.`order_id` AND o.`is_demo`=1;\nDELETE cc FROM `change_confirmations` cc INNER JOIN `change_requests` c ON c.`id`=cc.`change_request_id` INNER JOIN `orders` o ON o.`id`=c.`order_id` AND o.`is_demo`=1;\nDELETE ah FROM `assignment_history` ah INNER JOIN `assignments` a ON a.`id`=ah.`assignment_id` INNER JOIN `orders` o ON o.`id`=a.`order_id` AND o.`is_demo`=1;\nDELETE od FROM `order_cancel_decisions` od INNER JOIN `orders` o ON o.`id`=od.`order_id` AND o.`is_demo`=1;\nDELETE rf FROM `refunds` rf INNER JOIN `orders` o ON o.`id`=rf.`order_id` AND o.`is_demo`=1;\nDELETE rec FROM `commission_receivables` rec INNER JOIN `orders` o ON o.`id`=rec.`order_id` AND o.`is_demo`=1;\nDELETE r FROM `reviews` r INNER JOIN `orders` o ON o.`id`=r.`order_id` AND o.`is_demo`=1;\nDELETE claim FROM `run_empty_fee_claims` claim INNER JOIN `orders` o ON o.`id`=claim.`order_id` AND o.`is_demo`=1;\nDELETE d FROM `disputes` d INNER JOIN `orders` o ON o.`id`=d.`order_id` AND o.`is_demo`=1;\nDELETE af FROM `after_sales` af INNER JOIN `orders` o ON o.`id`=af.`order_id` AND o.`is_demo`=1;\nDELETE oc FROM `order_cancel_requests` oc INNER JOIN `orders` o ON o.`id`=oc.`order_id` AND o.`is_demo`=1;\nDELETE cs FROM `completion_submissions` cs INNER JOIN `orders` o ON o.`id`=cs.`order_id` AND o.`is_demo`=1;\nDELETE delay_row FROM `offline_payment_delay_requests` delay_row INNER JOIN `orders` o ON o.`id`=delay_row.`order_id` AND o.`is_demo`=1;\nDELETE adjust_row FROM `offline_collection_adjustment_requests` adjust_row INNER JOIN `orders` o ON o.`id`=adjust_row.`order_id` AND o.`is_demo`=1;\nDELETE c FROM `change_requests` c INNER JOIN `orders` o ON o.`id`=c.`order_id` AND o.`is_demo`=1;\nDELETE ap FROM `appointment_records` ap INNER JOIN `orders` o ON o.`id`=ap.`order_id` AND o.`is_demo`=1;\nDELETE ea FROM `exceptional_arrivals` ea INNER JOIN `orders` o ON o.`id`=ea.`order_id` AND o.`is_demo`=1;\nDELETE org FROM `order_role_grants` org INNER JOIN `orders` o ON o.`id`=org.`order_id` AND o.`is_demo`=1;\nDELETE a FROM `assignments` a INNER JOIN `orders` o ON o.`id`=a.`order_id` AND o.`is_demo`=1;\nDELETE it FROM `invite_tokens` it INNER JOIN `orders` o ON o.`id`=it.`order_id` AND o.`is_demo`=1;\nDELETE sc FROM `share_contexts` sc INNER JOIN `orders` o ON o.`id`=sc.`order_id` AND o.`is_demo`=1;\nDELETE qs FROM `quote_selections` qs INNER JOIN `orders` o ON o.`id`=qs.`order_id` AND o.`is_demo`=1;\nDELETE qv FROM `quote_versions` qv INNER JOIN `quotes` q ON q.`id`=qv.`quote_id` INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nDELETE q FROM `quotes` q INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nDELETE crv FROM `commission_rule_versions` crv INNER JOIN `orders` o ON o.`id`=crv.`order_id` AND o.`is_demo`=1;\nDELETE p FROM `payment_orders` p INNER JOIN `orders` o ON o.`id`=p.`order_id` AND o.`is_demo`=1;\nDELETE mr FROM `merchant_risk_events` mr INNER JOIN `orders` o ON o.`id`=mr.`order_id` AND o.`is_demo`=1;\nDELETE dl FROM `order_deadlines` dl INNER JOIN `orders` o ON o.`id`=dl.`order_id` AND o.`is_demo`=1;\nDELETE ev FROM `order_events` ev INNER JOIN `orders` o ON o.`id`=ev.`order_id` AND o.`is_demo`=1;\nDELETE rev FROM `order_revisions` rev INNER JOIN `orders` o ON o.`id`=rev.`order_id` AND o.`is_demo`=1;\nDELETE ans FROM `order_answers` ans INNER JOIN `orders` o ON o.`id`=ans.`order_id` AND o.`is_demo`=1;\nDELETE addr FROM `order_addresses` addr INNER JOIN `orders` o ON o.`id`=addr.`order_id` AND o.`is_demo`=1;\nDELETE cat FROM `order_categories` cat INNER JOIN `orders` o ON o.`id`=cat.`order_id` AND o.`is_demo`=1;\nDELETE ml FROM `media_links` ml INNER JOIN `orders` o ON ml.`entity_type`='order' AND ml.`entity_id`=o.`id` AND o.`is_demo`=1;\nDELETE FROM `orders` WHERE `is_demo`=1;\nDELETE FROM `reconciliation_records` WHERE `internal_no` LIKE 'PAY-V204-%' OR `internal_no` LIKE 'PAY-V213-%' OR `internal_no` LIKE 'REF-V204-%' OR `internal_no` LIKE 'REF-V213-%';\n\n-- 2026-09-04：旧演示提现流水只按明确前缀清理，师傅真实余额和真实提现均保留。\nDELETE pa FROM `payout_adjustments` pa INNER JOIN `worker_payouts` wp ON wp.`id`=pa.`worker_payout_id` INNER JOIN `withdrawal_requests` wr ON wr.`id`=wp.`withdrawal_request_id` WHERE wr.`public_no` LIKE 'WD-V204-%' OR wr.`public_no` LIKE 'WD-V213-%';\nDELETE wa FROM `withdrawal_allocations` wa INNER JOIN `withdrawal_requests` wr ON wr.`id`=wa.`withdrawal_request_id` WHERE wr.`public_no` LIKE 'WD-V204-%' OR wr.`public_no` LIKE 'WD-V213-%';\nDELETE we FROM `withdrawal_events` we INNER JOIN `withdrawal_requests` wr ON wr.`id`=we.`withdrawal_request_id` WHERE wr.`public_no` LIKE 'WD-V204-%' OR wr.`public_no` LIKE 'WD-V213-%';\nDELETE wp FROM `worker_payouts` wp INNER JOIN `withdrawal_requests` wr ON wr.`id`=wp.`withdrawal_request_id` WHERE wr.`public_no` LIKE 'WD-V204-%' OR wr.`public_no` LIKE 'WD-V213-%';\nDELETE FROM `withdrawal_requests` WHERE `public_no` LIKE 'WD-V204-%' OR `public_no` LIKE 'WD-V213-%';\nDELETE FROM `worker_balance_ledger` WHERE `idempotency_key` LIKE 'v204:%' OR `idempotency_key` LIKE 'v213:%';\n\nSET FOREIGN_KEY_CHECKS=@v213_old_fk_checks;\n\n-- 2026-09-04：十一笔演示订单均归属指定真实用户，覆盖审核、补资料、报价、派单、尾款、服务费、退款和跑空费争议。\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,`wall_height_text`,`is_renovation`,`expected_visit_at`,`city`,`district`,`address_summary`,`address_ciphertext`,`lat`,`lng`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`order_source_type`,`audit_status`,`audit_note`,`audited_at`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`contact_revealed_at`,`completion_submitted_at`,`auto_accept_at`,`accepted_at`,`auto_review_at`,`cancelled_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`) VALUES\n('BXQZ202609041837',@v213_customer_id,@v213_schema_id,@v213_qz,'墙纸','墙纸','演示：待审核订单','预约费已支付，等待管理员审核。','45.00㎡','2.80m',1,NULL,'杭州市','西湖区','杭州市西湖区文二路120号3幢502室','杭州市西湖区文二路120号3幢502室',30.2819000,120.1280000,'陈女士','陈女士','13088880000','13088880000','consumer','pending',NULL,NULL,'hidden','waiting','unass