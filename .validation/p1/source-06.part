T')!=='1'){fwrite(STDERR,\"Set MESSAGING_MIGRATION_MYSQL_TEST=1 for an isolated MySQL 5.7 test server.\\n\");exit(2);}\n$root=dirname(__DIR__,2);\nspl_autoload_register(static function(string $class)use($root):void{if(strpos($class,'WorkerAdmin\\\\')!==0)return;$p=$root.'/server/app/'.str_replace('\\\\','/',substr($class,12)).'.php';if(is_file($p))require_once $p;});\nfunction setting($key,$default=null){return $default;}\nfunction app_config($key,$default=null){return $GLOBALS['notification_cursor_config'][$key]??($key==='app.key'?str_repeat('fixture-only-',4):$default);}\nfunction write_log(...$args){$GLOBALS['logs'][]=$args;}\n$checks=0;\nfunction messageMysqlAssert(bool $ok,string $label):void{if(!$ok)throw new RuntimeException($label);++$GLOBALS['checks'];}\nfunction messageMysqlReject(callable $call,string $message):void{try{$call();throw new LogicException('expected rejection');}catch(RuntimeException $e){messageMysqlAssert(strpos($e->getMessage(),$message)!==false,'rejection '.$message);}}\n$config=['host'=>getenv('V250_DB_HOST')?:'127.0.0.1','port'=>(int)(getenv('V250_DB_PORT')?:3306),'username'=>getenv('V250_DB_USER')?:'root','password'=>getenv('V250_DB_PASSWORD')?:'','database'=>'worker_messaging_migration_test'];\n$server=new PDO('mysql:host='.$config['host'].';port='.$config['port'].';charset=utf8mb4',$config['username'],$config['password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);\nmessageMysqlAssert(strpos((string)$server->query('SELECT VERSION()')->fetchColumn(),'5.7.')===0,'MySQL 5.7 required');\n$created=false;\ntry{\n    $server->exec('CREATE DATABASE worker_messaging_migration_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');$created=true;\n    $db=new \\WorkerAdmin\\Core\\Database($config);$other=new \\WorkerAdmin\\Core\\Database($config);\n    $db->execute(\"CREATE TABLE notifications(id INT AUTO_INCREMENT PRIMARY KEY,public_id VARCHAR(80) UNIQUE,recipient_type VARCHAR(20),recipient_id INT,channel VARCHAR(30),template_key VARCHAR(80),title VARCHAR(80),content TEXT,data_json TEXT,read_at DATETIME NULL,created_at DATETIME) ENGINE=InnoDB\");\n    $db->execute(\"CREATE TABLE orders(id INT PRIMARY KEY,public_no VARCHAR(80),user_id INT,lifecycle_status VARCHAR(40),refund_status VARCHAR(40),audit_status VARCHAR(40),payment_status VARCHAR(40),fulfillment_status VARCHAR(40),dispute_status VARCHAR(40),selected_quote_id INT NULL,current_assignment_id INT NULL,assigned_worker_id INT NULL,assignment_status VARCHAR(40),updated_at DATETIME) ENGINE=InnoDB\");\n    $db->execute('CREATE TABLE quotes(id INT PRIMARY KEY,order_id INT,status VARCHAR(20)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE change_requests(id INT PRIMARY KEY,order_id INT,public_id VARCHAR(80),status VARCHAR(30),payment_status VARCHAR(40)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE run_empty_fee_claims(id INT PRIMARY KEY,order_id INT,status VARCHAR(30)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE assignments(id INT PRIMARY KEY,worker_id INT,status VARCHAR(30)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE after_sales(id INT PRIMARY KEY,order_id INT,type VARCHAR(40),status VARCHAR(30),resolution TEXT) ENGINE=InnoDB');\n    foreach([['user-1','user',42,'in_app'],['worker-1','worker',7,'in_app'],['other-user','user',99,'in_app'],['other-worker','worker',99,'in_app'],['external','user',42,'sms']]as $r){\n        $db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,created_at) VALUES(:id,:type,:recipient,:channel,'event','Title','Content','{\\\"order_id\\\":1}','2026-10-08 00:00:00')\",['id'=>$r[0],'type'=>$r[1],'recipient'=>$r[2],'channel'=>$r[3]]);\n    }\n    $db->execute(\"INSERT INTO orders VALUES(1,'MESSAGE-USER',42,'active','none','draft','awaiting_payment','none','none',NULL,NULL,NULL,'none',UTC_TIMESTAMP()),(2,'MESSAGE-WORKER',99,'active','none','approved','paid','none','none',NULL,12,7,'offered',UTC_TIMESTAMP()),(3,'MESSAGE-REPAIR',99,'completed','none','approved','paid','accepted','none',NULL,NULL,7,'accepted',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO assignments VALUES(12,7,'offered')\");$db->execute(\"INSERT INTO after_sales VALUES(1,3,'warranty_repair','open',NULL)\");\n    $db->execute(\"ALTER TABLE orders ADD is_demo TINYINT NOT NULL DEFAULT 0,ADD order_source_type VARCHAR(30) NOT NULL DEFAULT 'consumer',ADD workflow_profile VARCHAR(30) NOT NULL DEFAULT 'construction',ADD dispatch_mode VARCHAR(30) NOT NULL DEFAULT 'single'\");\n    $db->execute(\"ALTER TABLE quotes ADD worker_id INT NOT NULL DEFAULT 0\");\n    $db->execute(\"ALTER TABLE assignments ADD order_id INT NOT NULL DEFAULT 0\");\n    $db->execute(\"UPDATE assignments SET order_id=2 WHERE id=12\");\n    $db->execute(\"INSERT INTO assignments(id,worker_id,status,order_id) VALUES(14,7,'accepted',3)\");\n    $db->execute(\"UPDATE orders SET current_assignment_id=14 WHERE id=3\");\n    $db->execute(\"CREATE TABLE invite_tokens(order_id INT,claimed_worker_id INT,status VARCHAR(30))\");\n    $db->execute(\"CREATE TABLE order_events(order_id INT,event_type VARCHAR(100))\");\n    $db->execute(\"CREATE TABLE appointment_records(order_id INT,context_type VARCHAR(30))\");\n    $inbox=new \\WorkerAdmin\\Application\\Messaging\\NotificationInbox(new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseNotificationInboxRepository($db));\n    $actor=['user_id'=>42,'worker_id'=>7];$user=['user_id'=>42,'worker_id'=>null];\n    $rows=$inbox->list($actor,1);messageMysqlAssert(count($rows['items'])===2 && $rows['unread_count']===2,'only both trusted recipient identities visible');\n    messageMysqlAssert(array_column($rows['items'],'id')===['worker-1','user-1'],'stable id ordering');\n    messageMysqlAssert($rows['items'][0]['order_no']==='MESSAGE-USER' && $rows['items'][0]['created_at']==='2026-10-08 08:00','batched order resolution and timezone');\n    messageMysqlAssert(count($inbox->list($user,1)['items'])===1,'ordinary account cannot see worker message');\n    $summary=$inbox->summary($actor);messageMysqlAssert($summary['user_todo_count']===1 && $summary['worker_todo_count']===2 && $summary['todo_count']===3,'both role todo predicates');\n    messageMysqlAssert($summary['top_todo']['order_id']==='MESSAGE-REPAIR' && $summary['top_todo']['action']==='处理待维修','repair takes top todo priority');\n    messageMysqlAssert($summary['latest_notification']===['id'=>'worker-1','title'=>'Title','created_at'=>'2026-10-08T00:00:00+00:00'],'normal conversation has bounded title and exact UTC activity, no body');\n    messageMysqlAssert($inbox->summary($user)['latest_notification']['id']==='user-1','worker and external-channel notifications excluded for ordinary identity');\n    messageMysqlAssert($inbox->summary(['user_id'=>1000,'worker_id'=>null])['latest_notification']===null,'empty inbox does not fabricate activity');\n    messageMysqlReject(static function()use($inbox,$actor){$inbox->read($actor,'other-user');},'不属于');\n    messageMysqlReject(static function()use($inbox,$user){$inbox->read($user,'worker-1');},'不属于');\n    messageMysqlReject(static function()use($inbox,$actor){$inbox->read($actor,'external');},'不属于');\n    $inbox->read($actor,'user-1');$stamp=$db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='user-1'\");$inbox->read($actor,'user-1');\n    messageMysqlAssert($stamp!==null && $db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='user-1'\")===$stamp,'single read idempotent');\n    $changed=$inbox->readBatch($actor,['worker-1','other-user','external','worker-1']);messageMysqlAssert($changed['updated_count']===1,'batch ownership/channel filtering');\n    messageMysqlAssert($inbox->readBatch($actor,['worker-1'])['updated_count']===0,'repeat batch idempotent');\n    $db->execute('UPDATE notifications SET read_at=NULL');$inbox->readAll($user);\n    messageMysqlAssert((int)$db->fetchValue('SELECT COUNT(*) FROM notifications WHERE read_at IS NOT NULL')===1,'read all ordinary identity only');\n    $inbox->readAll($actor);messageMysqlAssert((int)$db->fetchValue('SELECT COUNT(*) FROM notifications WHERE read_at IS NOT NULL')===2,'read all both roles only');\n    messageMysqlAssert($inbox->summary($actor)['latest_notification']===$summary['latest_notification'],'read acknowledgements do not reorder normal conversation');\n    $through=$inbox->list($actor,1)['read_through_id'];\n    $db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,created_at) VALUES('new-during-read-all','user',42,'in_app','event','New',UTC_TIMESTAMP())\");\n    $inbox->readAll($actor,$through);\n    messageMysqlAssert($db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='new-during-read-all'\")===null,'new notifications beyond snapshot survive read all');\n    messageMysqlReject(static function()use($inbox,$actor):void{$inbox->readAll($actor,'other-user');},'范围');\n    $db->execute(\"DELETE FROM notifications WHERE public_id='new-during-read-all'\");\n    for($i=0;$i<22;$i++)$db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,created_at) VALUES(:id,'user',42,'in_app',UTC_TIMESTAMP())\",['id'=>'page-'.$i]);\n    messageMysqlAssert(count($inbox->list($actor,1)['items'])===20 && $inbox->list($actor,1)['has_more']===true,'page lookahead');\n    messageMysqlAssert(count($inbox->list($actor,2)['items'])===4 && $inbox->list($actor,2)['has_more']===false,'final page');\n    $first=$inbox->list($actor,1);$oldSecond=$inbox->list($actor,2,$first['read_through_id']);\n    $db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,created_at) VALUES('arrived-between-pages','user',42,'in_app',UTC_TIMESTAMP())\");\n    $stableSecond=$inbox->list($actor,2,$first['read_through_id']);\n    messageMysqlAssert(array_column($stableSecond['items'],'id')===array_column($oldSecond['items'],'id'),'notification range keeps page boundary stable during arrivals');\n    $inbox->readAll($actor,$first['read_through_id']);\n    messageMysqlAssert($db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='arrived-between-pages'\")===null,'pagination range also fences read-all');\n    $db->execute(\"DELETE FROM notifications WHERE public_id='arrived-between-pages'\");\n    $db->execute(\"CREATE TABLE message_outbox(id INT AUTO_INCREMENT PRIMARY KEY,topic VARCHAR(50),business_key VARCHAR(80),status VARCHAR(20),attempt_count INT DEFAULT 0,next_attempt_at DATETIME NULL,last_error TEXT,processed_at DATETIME NULL,created_at DATETIME,updated_at DATETIME,payload_json TEXT) ENGINE=InnoDB\");\n    $repo=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseMessageOutboxRepository($db);\n    $insert=static function(string $topic,string $status,int $attempt)use($db):int{return $db->insert(\"INSERT INTO message_outbox(topic,business_key,status,attempt_count,last_error,next_attempt_at,created_at,payload_json) VALUES(:topic,'key',:status,:attempt,'13800131234 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=Secret_Key',UTC_TIMESTAMP(),UTC_TIMESTAMP(),'{\\\"user_id\\\":42}')\",['topic'=>$topic,'status'=>$status,'attempt'=>$attempt]);};\n    $id=$insert('wechat_subscribe','failed',5);$repo->retry($id);$row=$db->fetch('SELECT * FROM message_outbox WHERE id=:id',['id'=>$id]);\n    messageMysqlAssert($row['status']==='pending' && (int)$row['attempt_count']===0 && $row['last_error']===null,'retry reset fields');\n    messageMysqlAssert($row['next_attempt_at']!==null && $row['processed_at']===null,'retry schedule state');\n    messageMysqlReject(static function()use($repo,$id){$repo->retry($id);},'仅可');\n    $id=$insert('aliyun_sms','failed',5);$repo->close($id);$row=$db->fetch('SELECT * FROM message_outbox WHERE id=:id',['id'=>$id]);\n    messageMysqlAssert($row['status']==='closed' && $row['next_attempt_at']===null && $row['last_error']!==null,'close stops schedule retains evidence');\n    messageMysqlReject(static function()use($repo,$id){$repo->close($id);},'仅可');\n    foreach([['aliyun_paid_sms','failed',5],['unknown','failed',5],['aliyun_sms','failed',4],['aliyun_sms','processing',5]]as $case){\n        $id=$insert(...$case);messageMysqlReject(static function()use($repo,$id){$repo->retry($id);},$case[0]==='aliyun_paid_sms'?'付费短信':($case[0]==='unknown'?'类型':'仅可'));\n        messageMysqlAssert($db->fetchValue('SELECT status FROM message_outbox WHERE id=:id',['id'=>$id])===$case[1],'rejected retry unchanged');\n    }\n    $id=$insert('aliyun_sms','failed',5);\n    try{$db->transaction(static function()use($repo,$id):void{$repo->retry($id);throw new RuntimeException('rollback sentinel');});}catch(RuntimeException $e){messageMysqlAssert($e->getMessage()==='rollback sentinel','outer rollback propagated');}\n    messageMysqlAssert($db->fetchValue('SELECT status FROM message_outbox WHERE id=:id',['id'=>$id])==='failed','joined transaction rolls back retry');\n    $other->execute('SET innodb_lock_wait_timeout=1');$otherRepo=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseMessageOutboxRepository($other);\n    $db->transaction(static function()use($db,$otherRepo,$id):void{\n        $db->fetch('SELECT id FROM message_outbox WHERE id=:id FOR UPDATE',['id'=>$id]);\n        messageMysqlReject(static function()use($otherRepo,$id){$otherRepo->retry($id);},'Lock wait timeout');\n        $db->execute(\"UPDATE message_outbox SET status='closed' WHERE id=:id\",['id'=>$id]);\n    });\n    messageMysqlReject(static function()use($otherRepo,$id){$otherRepo->retry($id);},'仅可');\n    messageMysqlAssert($other->fetchValue('SELECT status FROM message_outbox WHERE id=:id',['id'=>$id])==='closed','competing connection cannot revive closed row');\n    $dashboard=$repo->dashboard('', '',1);$display=implode(' ',array_column($dashboard['result']['rows'],'last_error_display'));\n    messageMysqlAssert(strpos($display,'13800131234')===false && strpos($display,'Secret_Key')===false && strpos($display,'地址已隐藏')!==false,'admin error display redaction');\n    $db->execute(\"CREATE TABLE sms_recipient_suppressions(id INT AUTO_INCREMENT PRIMARY KEY,mobile_hmac VARCHAR(80) UNIQUE,mobile_masked VARCHAR(30),reason VARCHAR(40),note TEXT,status VARCHAR(20),created_by_admin_id INT,created_at DATETIME,updated_at DATETIME) ENGINE=InnoDB\");\n    $repo->addSuppression('hash','138****1234','opt_out','note',9);$repo->addSuppression('hash','138****1234','manual','again',8);\n    messageMysqlAssert((int)$db->fetchValue('SELECT COUNT(*) FROM sms_recipient_suppressions')===1,'suppression duplicate upsert');\n    messageMysqlAssert((int)$db->fetchValue('SELECT created_by_admin_id FROM sms_recipient_suppressions')===8,'suppression admin recorded');\n    $repo->removeSuppression(1);messageMysqlAssert($db->fetchValue('SELECT status FROM sms_recipient_suppressions WHERE id=1')==='inactive','suppression removed');\n    $repo->addSuppression('hash','138****1234','manual','again',9);messageMysqlAssert(count($repo->dashboard('','',1,'suppressions')['suppressionResult']['rows'])===1,'active suppression projection');\n    $db->execute('CREATE TABLE scheduler_runs(id INT AUTO_INCREMENT PRIMARY KEY,job_name VARCHAR(80),status VARCHAR(30),started_at DATETIME,finished_at DATETIME,failure_count INT) ENGINE=InnoDB');\n    $db->execute(\"INSERT INTO scheduler_runs(job_name,status,started_at,failure_count) VALUES('sms_dispatch','success',UTC_TIMESTAMP(),0)\");\n    $insert('wechat_subscribe','pending',0);$subRepo=new \\WorkerAdmin\\Infrastructure\\Messaging\\DatabaseSubscriptionRepository($db);$diag=$subRepo->diagnose(42);\n    messageMysqlAssert($diag['pending_count']===2 && $diag['dispatcher_healthy']===true,'diagnostic scope and dispatcher health');\n    messageMysqlAssert($subRepo->diagnose(99)['pending_count']===0,'other actor diagnostic excludes messages');\n    $db->execute(\"CREATE TABLE system_settings(setting_key VARCHAR(100) PRIMARY KEY,setting_value TEXT,value_type VARCHAR(20),group_name VARCHAR(50),is_public TINYINT,description TEXT,updated_by INT NULL,created_at DATETIME,updated_at DATETIME) ENGINE=InnoDB\");\n    $saved=$subRepo->save(42,'reviewResult',false,'reject');messageMysqlAssert($saved['last_request_status']==='reject' && $saved['remaining_count']===0,'legacy quota adapter persistence');\n    messageMysqlAssert(isset($subRepo->preferences(42)['reviewResult']) && !$subRepo->preferences(99),'preferences scope');\n    $db->execute('RENAME TABLE message_outbox TO message_outbox_full');$warning=$repo->dashboard('','',1);\n    messageMysqlAssert($warning['schemaWarning']!=='' && !$warning['result']['rows'],'missing schema graceful page');\n    $db->execute('CREATE TABLE message_outbox(id INT PRIMARY KEY,topic VARCHAR(50),business_key VARCHAR(80),status VARCHAR(20)) ENGINE=InnoDB');\n    messageMysqlAssert($repo->dashboard('','',1)['schemaWarning']==='','optional columns fallback');\n    messageMysqlReject(static function()use($repo){$repo->retry(1);},'字段');\n\n    // S14 B/S uses the full official todo scopes and a single UNION snapshot.\n    $db->execute('DELETE FROM notifications');\n    $notice=static function(string $id,string $role,int $receiver,string $json)use($db):void{$db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,data_json,created_at) VALUES(:id,:role,:receiver,'in_app','event','S14',:data,UTC_TIMESTAMP())\",['id'=>$id,'role'=>$role,'receiver'=>$receiver,'data'=>$json]);};\n    $notice('b-user1','user',42,'{\"order_id\":1}');$notice('b-user2','user',42,'{\"order_id\":\"1\"}');\n    $notice('b-worker1','worker',7,'{\"order_id\":2}');$notice('b-worker2','worker',7,'{\"order_id\":2}');\n    foreach(['broken','{}','{\"order_id\":999999}','{\"order_id\":1.0}','{\"order_id\":\"01\"}'] as $i=>$data)$notice('standalone-'.$i,'user',42,$data);\n    $notice('unowned-worker','worker',7,'{\"order_id\":1}');$notice('other-account','user',99,'{}');\n    $s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===3 && $s['standalone_unread_count']===6,'B deduplicates todo/order notices and S retains malformed/unowned links: '.json_encode($s));\n    $db->execute(\"INSERT INTO assignments(id,worker_id,status,order_id) VALUES(13,7,'accepted',1)\");\n    $db->execute(\"UPDATE orders SET assigned_worker_id=7,current_assignment_id=13,assignment_status='accepted' WHERE id=1\");\n    $s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===4 && $s['standalone_unread_count']===5,'same order in two recipient identities stays two attention items');\n    $inbox->readAll($user);$s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===4 && $s['standalone_unread_count']===0,'reading user notices preserves worker attention and formal todos');\n    $inbox->readAll($actor);$s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===3,'reading notices never clears outstanding tasks');\n    $db->execute(\"UPDATE orders SET audit_status='approved',payment_status='paid' WHERE id=1\");\n    $db->execute(\"UPDATE assignments SET status='accepted' WHERE id=12\");$db->execute(\"UPDATE orders SET assignment_status='accepted' WHERE id=2\");\n    $db->execute(\"UPDATE after_sales SET status='resolved'\");\n    $s=$inbox->summary($actor);messageMysqlAssert($s['order_attention_count']===0,'formal business completion clears the last B item');\n    $db->execute(\"UPDATE orders SET order_source_type='platform',workflow_profile='construction',fulfillment_status='not_started' WHERE id=2\");\n    $db->execute(\"INSERT INTO order_events VALUES(2,'platform_measurement_pricing_reviewed'),(2,'platform_measurement_pricing_confirmed')\");\n    $s=$inbox->summary($actor);messageMysqlAssert($s['worker_todo_count']===1 && $s['order_attention_count']===1 && $s['top_todo']['action']==='预约施工','appointment todos use the order center scope');\n    $db->execute(\"INSERT INTO appointment_records VALUES(2,'service')\");\n    $db->execute(\"UPDATE orders SET order_source_type='platform' WHERE id=1\");\n    $db->execute(\"INSERT INTO order_events VALUES(1,'platform_measurement_pricing_reviewed')\");\n    $s=$inbox->summary($actor);messageMysqlAssert($s['user_todo_count']===1 && $s['order_attention_count']===1 && $s['top_todo']['action']==='确认平台报价','pricing confirmation todo is included');\n    $db->execute(\"UPDATE orders SET is_demo=1 WHERE id=1\");\n    messageMysqlAssert($inbox->summary($actor)['order_attention_count']===0 && $inbox->summary($actor+['is_demo_actor'=>true])['order_attention_count']===1,'demo and real attention scopes are isolated');\n\n\n    // U15: aggregate BEFORE pagination, immutable ID range, signed keyset and lazy thread history.\n    $db->execute('DELETE FROM notifications');$db->execute('UPDATE orders SET is_demo=0');\n    $seed=static function(string $id,string $role,int $recipient,string $json,string $time='2026-10-22 00:00:00',string $channel='in_app')use($db):void{\n        $db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,created_at) VALUES(:id,:role,:recipient,:channel,'event','U15','Owned fixture',:json,:time)\",\n            ['id'=>$id,'role'=>$role,'recipient'=>$recipient,'channel'=>$channel,'json'=>$json,'time'=>$time]);\n    };\n    for($i=0;$i<65;$i++)$seed('u15-single-'.$i,'user',42,'{}');\n    for($i=0;$i<75;$i++)$seed('u15-order-'.$i,'user',42,'{\"order_id\":1}','2026-10-23 00:00:00');\n    for($i=0;$i<5;$i++)$seed('u15-worker-'.$i,'worker',7,'{\"order_id\":\"1\"}','2026-10-23 00:00:00');\n    $seed('u15-private','user',99,'{}');$seed('u15-external','user',42,'{}','2026-10-23 01:00:00','sms');\n    $first=$inbox->threads($actor);\n    messageMysqlAssert($first['schema']===2&&count($first['items'])===20&&$first['has_more'],'thread page bounded lookahead');\n    $byKey=array_column($first['items'],null,'thread_key');\n    messageMysqlAssert($byKey['user:1']['thread_count']===75&&$byKey['user:1']['unread_count']===75,'all 75 messages summarized, not first raw page only');\n    messageMysqlAssert($byKey['worker:1']['thread_count']===5&&$byKey['worker:1']['order_no']==='MESSAGE-USER','same order identities remain independent');\n    $threadCursor=$byKey['user:1']['thread_cursor'];\n    $seed('u15-arrival','user',42,'{\"order_id\":1}','2026-10-24 00:00:00');\n    $all=$first['items'];$next=$first['next_cursor'];$pages=1;\n    while($next!==''){$page=$inbox->threads($actor,$next);$all=array_merge($all,$page['items']);$next=$page['next_cursor'];messageMysqlAssert(++$pages<10,'finite thread traversal');}\n    $keys=array_column($all,'thread_key');\n    messageMysqlAssert(count($all)===67&&count(array_unique($keys))===67,'equal timestamps traverse 67 unique threads without duplication or omissions');\n    messageMysqlAssert(!in_array('single:u15-private',$keys,true)&&!in_array('single:u15-external',$keys,true),'recipient and channel scope applied before grouping');\n    $messages=$inbox->threadMessages($actor,$threadCursor);\n    messageMysqlAssert(count($messages['items'])===20&&$messages['has_more'],'thread expanded lazily with 20 record page');\n    $visible=array_column($messages['items'],'id');\n    $inbox->readBatch($actor,$visible);\n    $history=$messages['items'];$next=$messages['next_cursor'];\n    while($next!==''){$page=$inbox->threadMessages($actor,$next);$history=array_merge($history,$page['items']);$next=$page['next_cursor'];}\n    messageMysqlAssert(count($history)===75&&count(array_unique(array_column($history,'id')))===75,'thread history has no duplicates; later arrival excluded');\n    messageMysqlAssert(!in_array('u15-arrival',array_column($history,'id'),true),'new same-thread notification is outside frozen range');\n    $fresh=array_column($inbox->threads($actor)['items'],null,'thread_key');\n    messageMysqlAssert($fresh['user:1']['thread_count']===76&&$fresh['user:1']['unread_count']===56,'only explicitly loaded 20 records marked read');\n    $beforeTodo=$inbox->summary($actor)['todo_count'];\n    $inbox->readRange($actor,$first['range_cursor']);\n    messageMysqlAssert($db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='u15-arrival'\")===null,'signed read-all cannot clear arrival');\n    messageMysqlAssert($db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='u15-private'\")===null&&$db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='u15-external'\")===null,'range read cannot acknowledge foreign or external notifications');\n    messageMysqlAssert($inbox->summary($actor)['todo_count']===$beforeTodo,'read-all never changes business todos');\n    foreach([[$user,$first['next_cursor']],[$actor+['is_demo_actor'=>true],$first['next_cursor']]] as [$receiver,$token]){\n        messageMysqlReject(static fn()=>$inbox->threads($receiver,$token),'范围');\n    }\n    messageMysqlReject(static fn()=>$inbox->threadMessages($actor,$first['next_cursor']),'范围');\n    messageMysqlReject(static fn()=>$inbox->readRange($actor,$threadCursor),'范围');\n    $tampered=substr($first['next_cursor'],0,-64).str_repeat('0',64);\n    messageMysqlReject(static fn()=>$inbox->threads($actor,$tampered),'范围');\n    messageMysqlReject(static fn()=>$inbox->threads($actor,str_repeat('a',2049)),'范围');\n    messageMysqlReject(static fn()=>$inbox->threadMessages($actor,''),'刷新');\n    $signer=new \\WorkerAdmin\\Infrastructure\\Messaging\\NotificationInboxCursor();\n    $expired=$signer->begin($actor,'0','0');$expired['exp']=time()-1;\n    messageMysqlReject(static fn()=>$inbox->threads($actor,$signer->seal($expired,'threads')),'范围');\n    $GLOBALS['notification_cursor_config']['app.env']='different-environment';\n    messageMysqlReject(static fn()=>$inbox->threads($actor,$first['next_cursor']),'范围');\n    unset($GLOBALS['notification_cursor_config']['app.env']);\n    $GLOBALS['notification_cursor_config']['app.key']='';\n    messageMysqlReject(static fn()=>$inbox->threads($actor),'暂不可用');\n    unset($GLOBALS['notification_cursor_config']['app.key']);\n    $db->execute(\"DELETE FROM notifications WHERE public_id='u15-single-0'\");\n    messageMysqlReject(static fn()=>$inbox->threads($actor,$first['next_cursor']),'范围');\n    $db->execute(\"UPDATE orders SET user_id=99 WHERE id=1\");\n    $userThreads=array_column($inbox->threads($user)['items'],null,'thread_key');\n    messageMysqlAssert($userThreads['user:1']['order_no']===''&&$userThreads['user:1']['thread_count']===76,'notification ownership never grants revoked order access');\n    foreach(['{\"order_id\":1.0}','{\"order_id\":\"01\"}','{\"order_id\":\"18446744073709551616\"}','broken'] as $i=>$json)$seed('u15-invalid-'.$i,'user',42,$json,'2026-10-24 01:00:00');\n    $invalid=array_column($inbox->threads($user)['items'],null,'thread_key');\n    for($i=0;$i<4;$i++)messageMysqlAssert(isset($invalid['single:u15-invalid-'.$i]),'noncanonical order association remains standalone');\n    $emptyActor=['user_id'=>123456,'worker_id'=>null];$empty=$inbox->threads($emptyActor);\n    messageMysqlAssert(!$empty['items']&&!$empty['has_more']&&$empty['next_cursor']==='','empty snapshot is well formed');\n    $seed('u15-after-empty','user',123456,'{}');$inbox->readRange($emptyActor,$empty['range_cursor']);\n    messageMysqlAssert($db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='u15-after-empty'\")===null,'empty snapshot read-all cannot clear first arrival');\n\n    echo 'Messaging migration MySQL: '.$checks.' checks passed.'.PHP_EOL;\n}finally{\n    if(isset($db) && $db->pdo()->inTransaction())$db->pdo()->rollBack();\n    if(isset($other) && $other->pdo()->inTransaction())$other->pdo()->rollBack();\n    if($created)$server->exec('DROP DATABASE worker_messaging_migration_test');\n}\n","server/tests/v250_transaction_mysql.php":"<?php\n\ndeclare(strict_types=1);\n\nif ((string)getenv('V250_PLATFORM_MYSQL_TEST') !== '1') {\n    fwrite(STDOUT, \"[SKIP] V250 MySQL transaction regression disabled.\\n\");\n    exit(0);\n}\n\n$root = dirname(__DIR__, 2);\nrequire_once $root . '/server/app/Core/Database.php';\n\nuse WorkerAdmin\\Core\\Database;\n\nfunction txAssert(bool $condition, string $label): void\n{\n    if (!$condition) {\n        fwrite(STDERR, '[FAIL] ' . $label . \"\\n\");\n        exit(1);\n    }\n    fwrite(STDOUT, '[PASS] ' . $label . \"\\n\");\n}\n\n$config = [\n    'host'=>(string)(getenv('V250_DB_HOST') ?: '127.0.0.1'),\n    'port'=>(int)(getenv('V250_DB_PORT') ?: 3306),\n    'database'=>(string)(getenv('V250_DB_NAME') ?: 'worker_test'),\n    'username'=>(string)(getenv('V250_DB_USER') ?: 'root'),\n    'password'=>(string)(getenv('V250_DB_PASSWORD') ?: 'root'),\n    'charset'=>'utf8mb4',\n];\n\n$db = new Database($config);\n$db->execute('DROP TABLE IF EXISTS v250_transaction_probe');\n$db->execute('CREATE TABLE v250_transaction_probe(id INT UNSIGNED NOT NULL AUTO_INCREMENT, marker VARCHAR(32) NOT NULL, PRIMARY KEY(id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4');\n\ntry {\n    $db->transaction(function (Database $db): void {\n        $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('outer_ok')\");\n        $db->transaction(function (Database $db): void {\n            $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('inner_ok')\");\n        });\n    });\n    txAssert((int)$db->fetchValue('SELECT COUNT(*) FROM v250_transaction_probe') === 2, '正常嵌套事务只由最外层提交');\n\n    $rollbackOnlyThrown = false;\n    try {\n        $db->transaction(function (Database $db): void {\n            $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('outer_before_fail')\");\n            try {\n                $db->transaction(function (Database $db): void {\n                    $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('inner_fail')\");\n                    throw new RuntimeException('inner failure');\n                });\n            } catch (RuntimeException $ignored) {\n                // 模拟业务层错误捕获：数据库仍必须阻止外层把部分事实提交。\n            }\n            $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('outer_after_catch')\");\n        });\n    } catch (RuntimeException $exception) {\n        $rollbackOnlyThrown = strpos($exception->getMessage(), '禁止提交部分业务结果') !== false;\n    }\n    txAssert($rollbackOnlyThrown, '内层失败被业务捕获后最外层仍强制 rollback-only');\n    txAssert((int)$db->fetchValue('SELECT COUNT(*) FROM v250_transaction_probe') === 2, 'rollback-only 未留下任何部分写入');\n\n    $db->transaction(function(Database $db):void{\n        $db->beforeCommit('same',static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('superseded_hook')\");});\n        $db->transaction(static function(Database $db):void{\n            $db->beforeCommit('same',static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('deduplicated_hook')\");});\n        });\n        txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='deduplicated_hook'\")===0,'预提交工作不会在内层事务提前运行');\n    });\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='deduplicated_hook'\")===1,'同键预提交工作合并一次');\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='superseded_hook'\")===0,'重复键使用最后登记的动作');\n    $failed=false;\n    try{$db->transaction(static function(Database $db):void{\n        $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('must_rollback')\");\n        $db->beforeCommit('fail',static function():void{throw new RuntimeException('fixture hook failure');});\n    });}catch(RuntimeException $error){$failed=$error->getMessage()==='fixture hook failure';}\n    txAssert($failed && (int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='must_rollback'\")===0,'预提交失败会回滚原业务写入');\n    $called=0;$failed=false;\n    try{$db->transaction(static function(Database $db)use(&$called):void{\n        try{$db->transaction(static function(Database $db)use(&$called):void{\n            $db->beforeCommit('cancelled',static function()use(&$called):void{$called++;});\n            throw new RuntimeException('fixture nested failure');\n        });}catch(RuntimeException $ignored){}\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed && $called===0,'rollback-only不执行已登记回调');\n    $failed=false;try{$db->beforeCommit('outside',static function():void{});}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed,'事务外登记被拒绝');\n    $failed=false;try{$db->transaction(static function(Database $db):void{\n        $db->beforeCommit('reentrant',static function(Database $db):void{$db->beforeCommit('nested',static function():void{});});\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed,'预提交执行中不得递归登记');\n    $failed=false;try{$db->transaction(static function(Database $db):void{\n        for($i=0;$i<129;$i++)$db->beforeCommit('bounded:'.$i,static function():void{});\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed,'预提交队列最多128个不同键');\n    $db->transaction(static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('after_hook_failure')\");});\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='after_hook_failure'\")===1,'失败回调不会泄漏到下一事务');\n    $db->transaction(static function(Database $db):void{\n        $db->beforeCommit('nested-write',static function(Database $db):void{\n            $db->transaction(static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('hook_nested_sql')\");});\n        });\n    });\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='hook_nested_sql'\")===1,'预提交动作内的嵌套SQL仍加入同一事务');\n    $failed=false;try{$db->transaction(static function(Database $db):void{\n        $db->beforeCommit('caught-hook-error',static function(Database $db):void{\n            try{$db->transaction(static function(Database $db):void{\n                $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('caught_hook_failure')\");throw new RuntimeException('fixture');\n            });}catch(RuntimeException $ignored){}\n        });\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed && (int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='caught_hook_failure'\")===0,'预提交内捕获的嵌套失败仍禁止外层提交');\n\n    $pdo1 = $db->pdo();\n    $db2 = new Database($config);\n    $pdo2 = $db2->pdo();\n    $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('lock_probe')\");\n    $lockId = (int)$pdo1->lastInsertId();\n    $pdo1->beginTransaction();\n    $stmt1 = $pdo1->prepare('SELECT id FROM v250_transaction_probe WHERE id=:id FOR UPDATE');\n    $stmt1->execute(['id'=>$lockId]);\n    $pdo2->exec('SET SESSION innodb_lock_wait_timeout=1');\n    $blocked = false;\n    try {\n        $stmt2 = $pdo2->prepare('SELECT id FROM v250_transaction_probe WHERE id=:id FOR UPDATE');\n        $stmt2->execute(['id'=>$lockId]);\n    } catch (Throwable $exception) {\n        $blocked = true;\n    }\n    if ($pdo1->inTransaction()) $pdo1->rollBack();\n    txAssert($blocked, 'MySQL 5.7 双连接 FOR UPDATE 会串行化同一业务行');\n} finally {\n    try { if ($db->pdo()->inTransaction()) $db->pdo()->rollBack(); } catch (Throwable $ignored) {}\n    try { $db->execute('DROP TABLE IF EXISTS v250_transaction_probe'); } catch (Throwable $ignored) {}\n}\n\necho \"V2.5.0 MySQL transaction/concurrency regression: OK\\n\";\n\n","tools/check-chat-release.py":"#!/usr/bin/env python3\n\"\"\"Fail-closed joint acceptance; fixture/source evidence cannot satisfy host/device gates.\"\"\"\nimport argparse, base64, hashlib, hmac, json, math, os, pathlib, re, sys, tempfile, time\nCASES=([f\"C{i:02}\" for i in range(1,48) if i!=20]+[f\"G{i:02}\" for i in range(1,17)]\n       +[f\"U{i:02}\" for i in list(range(1,10))+list(range(12,18))]+[f\"I{i:02}\" for i in range(1,9)]+[f\"AUD{i:02}\" for i in range(1,11)])\nAREAS=(\"automation\",\"devices\",\"capacity\",\"deployment\",\"channels\",\"recovery\")\ndef validate(e,revision):\n    failures=[]\n    def require(ok,code):\n        if not ok: failures.append(code)\n    require(e.get(\"schema\")==1,\"schema\")\n    require(e.get(\"environment\") in (\"test\",\"development\",\"production\") and bool(re.fullmatch(r\"[0-9a-f]{64}\",e.get(\"recovery_epoch\",\"\"))),\"environment_and_recovery_epoch\")\n    require(bool(re.fullmatch(r\"[0-9a-f]{40}\",revision)) and e.get(\"revision\")==revision,\"exact_revision\")\n    require(e.get(\"go_version\")==\"go1.27.3\" and e.get(\"database_version\")==\"2.7.0\",\"runtime_versions\")\n    require(e.get(\"release_authorized\") is True and isinstance(e.get(\"authorization_reference\"),str) and 5<=len(e.get(\"authorization_reference\",\"\"))<=512,\"human_release_authorization\")\n    cases=e.get(\"cases\",{})\n    for case in CASES:\n        row=cases.get(case,{})\n        require(row.get(\"status\")==\"passed\" and row.get(\"revision\")==revision and bool(row.get(\"evidence\")),case)\n    for area in AREAS:\n        row=e.get(area,{})\n        require(row.get(\"status\")==\"passed\" and row.get(\"revision\")==revision and bool(row.get(\"evidence\")),area)\n    a=e.get(\"automation\",{})\n    require(a.get(\"race\") is True and a.get(\"mysql57\") is True and a.get(\"php_version\")==\"8.3.36\"\n            and a.get(\"redis\") is True and a.get(\"source_verified\") is True,\"automation_contract\")\n    d=e.get(\"devices\",{})\n    devices=d.get(\"physical_devices\",[])\n    require(len(devices)>=2 and len({x.get(\"id\") for x in devices})>=2\n            and {\"ios\",\"android\"}<={x.get(\"platform\") for x in devices}\n            and all(x.get(\"physical\") is True and x.get(\"passed\") is True for x in devices),\"two_real_devices\")\n    require(d.get(\"weak_network\") is True and d.get(\"large_text\") is True and d.get(\"dark_mode\") is True\n            and d.get(\"album_permissions\") is True and d.get(\"safe_area\") is True,\"device_ui\")\n    c=e.get(\"capacity\",{})\n    require(c.get(\"environment\")==\"target_host\" and c.get(\"connections\")==[30,100,300]\n            and c.get(\"history_sizes\")==[1000,10000,100000]\n            and c.get(\"mixed_order_media_notifications\") is True,\"target_mixed_capacity\")\n    base=c.get(\"baseline_order_p95_ms\",0);mixed=c.get(\"mixed_order_p95_ms\",0);headroom=c.get(\"headroom_percent\",0)\n    numeric=all(type(v) in (int,float) and math.isfinite(v) for v in (base,mixed,headroom))\n    require(numeric and base>0 and 0<mixed<=base*1.10 and 30<=headroom<=100,\"order_budget_and_headroom\")\n    deploy=e.get(\"deployment\",{})\n    require(deploy.get(\"actual_sha\")==revision and deploy.get(\"source_dirty\") is False\n            and deploy.get(\"nonroot_processes\")==[\"serve\",\"worker\"] and deploy.get(\"private_internal_port\") is True\n            and deploy.get(\"php_routes_preserved\") is True and deploy.get(\"rollback_passed\") is True\n            and deploy.get(\"authenticated_wss\") is True,\"actual_deployment_and_rollback\")\n    channels=e.get(\"channels\",{})\n    require(channels.get(\"simulated\") is False and channels.get(\"private_media_expiry\") is True\n            and channels.get(\"platform_safety\") is True and channels.get(\"subscription_receipts\") is True\n            and channels.get(\"field_images_reviewed\") is True and channels.get(\"manual_wait_reviewed\") is True,\"actual_channels\")\n    recovery=e.get(\"recovery\",{})\n    require(recovery.get(\"independent_increment_complete\") is True and recovery.get(\"old_permissions_denied\") is True\n            and recovery.get(\"recall_not_revived\") is True and recovery.get(\"notification_not_resent\") is True\n            and recovery.get(\"wallet_not_recharged\") is True and recovery.get(\"gap_blocks_access\") is True,\"safe_incremental_restore\")\n    caps=e.get(\"capabilities\",[\"text\",\"images\",\"governance\",\"reminders\"])\n    require(isinstance(caps,list) and len(caps)==len(set(caps)) and set(caps)<=set((\"text\",\"images\",\"governance\",\"reminders\",\"audio\",\"video\")),\"capabilities\")\n    if isinstance(caps,list) and (\"audio\" in caps or \"video\" in caps):\n        required={5,6,8,9,11,12,13,14,15,16,18,19,20}\n        if \"video\" in caps: required.update((1,2,3,4,7,10,17))\n        for n in sorted(required):\n            case=\"AV\"+str(n).zfill(2);row=cases.get(case,{})\n            require(row.get(\"status\")==\"passed\" and row.get(\"revision\")==revision and bool(row.get(\"evidence\")),case)\n        require(channels.get(\"actual_asr_contract\") is True and channels.get(\"audio_callback_crypto\") is True,\"actual_av_channels\")\n        require(d.get(\"microphone_permissions\") is True and d.get(\"local_cache_after_cloud_expiry\") is True,\"actual_av_devices\")\n        if \"video\" in caps: require(channels.get(\"full_clip_review\") is True and channels.get(\"retained_frames\") is True,\"actual_video_review\")\n    return failures\ndef template():\n    e={\"schema\":1,\"revision\":\"\",\"environment\":\"test\",\"recovery_epoch\":\"\",\"go_version\":\"go1.27.3\",\"database_version\":\"2.7.0\",\n       \"release_authorized\":False,\"authorization_reference\":\"\",\n       \"cases\":{case:{\"status\":\"pending\",\"revision\":\"\",\"evidence\":\"\"} for case in CASES}}\n    for area in AREAS: e[area]={\"status\":\"pending\",\"revision\":\"\",\"evidence\":\"\"}\n    return e\ndef main():\n    p=argparse.ArgumentParser()\n    p.add_argument(\"--evidence\");p.add_argument(\"--revision\");p.add_argument(\"--template\",action=\"store_true\")\n    p.add_argument(\"--seal\");p.add_argument(\"--key-env\",default=\"CHAT_RELEASE_KEY\")\n    a=p.parse_args()\n    if a.template: print(json.dumps(template(),ensure_ascii=False,indent=2));return 0\n    if not a.evidence or not a.revision: p.error(\"--evidence and --revision are required\")\n    path=pathlib.Path(a.evidence)\n    if path.stat().st_size>1048576: raise ValueError(\"evidence too large\")\n    e=json.loads(path.read_bytes())\n    failures=validate(e,a.revision)\n    if a.seal and not failures:\n        if e.get(\"environment\") not in (\"test\",\"production\",\"development\") or not re.fullmatch(r\"[0-9a-f]{64}\",e.get(\"recovery_epoch\",\"\")):\n            raise ValueError(\"release environment/epoch\")\n        if not re.fullmatch(r\"CHAT_[A-Z0-9_]{1,60}\",a.key_env): raise ValueError(\"release key name\")\n        encoded=os.environ.get(a.key_env,\"\");key=base64.b64decode(encoded,validate=True)\n        if len(key)!=32 or base64.b64encode(key).decode()!=encoded: raise ValueError(\"release key\")\n        destination=pathlib.Path(a.seal)\n        if not destination.is_absolute() or destination.is_symlink(): raise ValueError(\"private absolute seal path\")\n        body=json.dumps({\"schema\":1,\"environment\":e[\"environment\"],\"epoch\":e[\"recovery_epoch\"],\"revision\":a.revision,\n            \"expires_at\":int(time.time())+86390,\"capabilities\":e.get(\"capabilities\",[\"text\",\"images\",\"governance\",\"reminders\"])},separators=(\",\",\":\")).encode()\n        envelope={\"payload\":base64.b64encode(body).decode(),\"mac\":hmac.new(key,body,\"sha256\").hexdigest()}\n        fd,name=tempfile.mkstemp(prefix=\".release-\",dir=destination.parent)\n        try:\n            os.fchmod(fd,0o640)\n            with os.fdopen(fd,\"w\") as out:\n                json.dump(envelope,out,separators=(\",\",\":\"));out.flush();os.fsync(out.fileno())\n            os.replace(name,destination)\n        finally:\n            if os.path.exists(name): os.unlink(name)\n    print(json.dumps({\"status\":\"blocked\" if failures else \"ready_for_authorized_release\",\"missing\":failures,\"deployment_executed\":False}))\n    return 1 if failures else 0\nif __name__==\"__main__\":\n    try: sys.exit(main())\n    except (OSError,ValueError,TypeError,KeyError,AttributeError):\n        print('{\"status\":\"blocked\",\"code\":\"CHAT_RELEASE_EVIDENCE_INVALID\"}');sys.exit(2)\n","tools/test-messaging-migration.php":"<?php\ndeclare(strict_types=1);\n$root=dirname(__DIR__);\nspl_autoload_register(static function(string $class) use($root): void {\n    if(strpos($class,'WorkerAdmin\\\\')!==0)return;\n    $path=$root.'/server/app/'.str_replace('\\\\','/',substr($class,12)).'.php';\n    if(is_file($path))require_once $path;\n});\n$checks=0;\nfunction messagingAssert(bool $ok,string $label): void { if(!$ok)throw new RuntimeException($label);++$GLOBALS['checks']; }\nfunction messagingReject(callable $call,string $message): void {\n    try{$call();throw new LogicException('Expected rejection');}catch(RuntimeException $e){messagingAssert(strpos($e->getMessage(),$message)!==false,'rejection: '.$message);}\n}\nfunction setting($key,$default=null){return $default;}\nfunction app_config($key,$default=null){return $default;}\nfunction request_id(){return 'messaging-test';}\nfunction admin_url($route,$params=[]){return '/admin/?route='.$route.'&'.http_build_query($params);}\nfunction flash($type,$message){$GLOBALS['flashes'][]=[$type,$message];}\nfinal class MessagingRedirect extends Exception {}\nfunction redirect($url){$GLOBALS['redirects'][]=$url;if(!empty($GLOBALS['terminateRedirect']))throw new MessagingRedirect($url);}\nfunction old_input($data){$GLOBALS['old']=$data;}\nfunction audit(...$args){$GLOBALS['audits'][]=$args;}\nfunction write_log(...$args){$GLOBALS['logs'][]=$args;}\nfunction view($name,$data){$GLOBALS['views'][]=[$name,$data];return 'rendered';}\nfinal class MessagingResponse extends Exception {\n    public array $payload; public int $status;\n    public function __construct(array $payload,int $status){parent::__construct('response');$this->payload=$payload;$this->status=$status;}\n}\nfunction json_response($data,$status=200){throw new MessagingResponse($data,$status);}\nfinal class MessagingInput {\n    public $context; private int $offset=0; public static string $body='{}';\n    public function stream_open($path,$mode,$options,&$opened){return $path==='php://input';}\n    public function stream_read($size){$s=substr(self::$body,$this->offset,$size);$this->offset+=strlen($s);return $s;}\n    public function stream_eof(){return $this->offset>=strlen(self::$body);}\n    public function stream_stat(){return [];}\n}\nfinal class MessagingSettings implements \\WorkerAdmin\\Contracts\\SettingsProvider {\n    public bool $configured=true;\n    public function get(string $key,$default=null){return $key==='wechat.miniapp_appid'?($this->configured?'test-app':''):$default;}\n    public function bool(string $key,bool $default=false):bool{return $default;}\n    public function int(string $key,int $default=0):int{return $default;}\n}\nfinal class MessagingActors implements \\WorkerAdmin\\Contracts\\ApiActorRepository {\n    public bool $found=true;public int $touches=0;\n    public function findByTokenHash(string $hash,string $appid):?array{return $this->found?['session_id'=>1,'user_id'=>42,'worker_id'=>7,'payer_openid'=>'ordinary']:null;}\n    public function touchSession(int $id):void{++$this->touches;}\n    public function findDemoActor(int $id):?array{return null;}\n    public function findTestActor(int $userId,int $instanceId):?array{return null;}\n    public function clearDemoActor(int $id):void{}\n    public function clearTestActor(int $id):void{}\n}\nfinal class MessagingInbox implements \\WorkerAdmin\\Contracts\\NotificationInboxRepository, \\WorkerAdmin\\Contracts\\NotificationThreadRepository {\n    public array $calls=[];\n    public function threads(array $actor,string $cursor=''):array{$this->calls[]=['threads',$actor,$cursor];return ['schema'=>2,'items'=>[]];}\n    public function threadMessages(array $actor,string $cursor):array{$this->calls[]=['messages',$actor,$cursor];return ['schema'=>2,'items'=>[]];}\n    public function readRange(array $actor,string $cursor):void{$this->calls[]=['range',$actor,$cursor];}\n    public function summary(array $actor):array{$this->calls[]=['summary',$actor];return ['unread_count'=>3];}\n    public function list(array $actor,int $page,string $throughId=''):array{$this->calls[]=['list',$actor,$page];return ['page'=>$page,'items'=>[]];}\n    public function read(array $actor,string $id):void{$this->calls[]=['read',$actor,$id];}\n    public function readBatch(array $actor,array $ids):int{$this->calls[]=['batch',$actor,$ids];return count($ids);}\n    public function readAll(array $actor,string $throughId=''):void{$this->calls[]=['all',$actor];}\n}\nfinal class MessagingSubscriptions implements \\WorkerAdmin\\Contracts\\SubscriptionRepository {\n    public array $saves=[];\n    public function definitions():array {\n        $base=['title'=>'Scene','description'=>'Description','template_id'=>'id','available'=>true,'global_enabled'=>true];\n        return ['user'=>$base+['recipient'=>'user'],'worker'=>$base+['recipient'=>'worker'],'reviewResult'=>$base+['recipient'=>'worker'],'long'=>$base+['recipient'=>'user','subscription_type'=>'long_term']];\n    }\n    public function preferences(int $id):array{return ['long'=>['remaining_count'=>10],'user'=>['remaining_count'=>-1]];}\n    public function save(int $id,string $key,bool $enabled,string $status):array{$this->saves[]=[$id,$key,$enabled,$status];return ['subscription_type'=>'one_time','authorization_status'=>$status];}\n    public function diagnose(int $id):array{return ['pending_count'=>$id];}\n}\nfinal class MessagingCipher implements \\WorkerAdmin\\Contracts\\PrivateValueCipher {\n    public function hmac(string $plain,string $context):string{return hash('sha256',$context.':'.$plain);}\n    public function encrypt(string $plain,string $context):?string{return $plain;}\n    public function decrypt(string $plain,string $context):string{return $plain;}\n}\nfinal class MessagingOutbox implements \\WorkerAdmin\\Contracts\\MessageOutboxRepository {\n    public array $calls=[]; public array $rows=[];\n    public function dashboard(string $status,string $q,int $page,string $tab='records'):array{$this->calls[]=['dashboard',$status,$q,$page,$tab];return ['result'=>['rows'=>$this->rows],'suppressionResult'=>['rows'=>[],'total'=>0,'page'=>1,'pages'=>1,'per_page'=>20]];}\n    public function retry(int $id):array{$this->calls[]=['retry',$id];return ['topic'=>'wechat_subscribe'];}\n    public function close(int $id):array{$this->calls[]=['close',$id];return ['topic'=>'aliyun_sms'];}\n    public function addSuppression(string $hash,string $masked,string $reason,string $note,int $admin):void{$this->calls[]=['add',$hash,$masked,$reason,$note,$admin];}\n    public function removeSuppression(int $id):array{$this->calls[]=['remove',$id];return ['mobile_masked'=>'138****1234'];}\n}\n$inboxRepo=new MessagingInbox();$inbox=new \\WorkerAdmin\\Application\\Messaging\\NotificationInbox($inboxRepo);\n$actor=['user_id'=>42,'worker_id'=>7];\nmessagingReject(static function()use($inbox,$actor){$inbox->read($actor,' ');},'请选择');\nmessagingReject(static function()use($inbox,$actor){$inbox->readBatch($actor,array_fill(0,51,'x'));},'50');\nmessagingReject(static function()use($inbox,$actor){$inbox->readBatch($actor,['',[]]);},'请选择');\nmessagingAssert(!$inboxRepo->calls,'invalid writes never reach repository');\nmessagingAssert($inbox->readBatch($actor,[' x ','x','y'])===['updated_count'=>2],'batch trims and deduplicates');\n$inbox->list($actor,99999);messagingAssert(end($inboxRepo->calls)[2]===10000,'page maximum');\n$inbox->list($actor,-1);messagingAssert(end($inboxRepo->calls)[2]===1,'page minimum');\n$settings=new MessagingSettings();$subRepo=new MessagingSubscriptions();$subs=new \\WorkerAdmin\\Application\\Messaging\\SubscriptionPreferences($subRepo,$settings);\n$user=['user_id'=>42,'worker_id'=>null];\nmessagingAssert(array_column($subs->status($user,false)['items'],'key')===['user','long'],'ordinary account hides worker scenes');\nmessagingAssert(array_column($subs->status($user,true)['items'],'key')===['user','reviewResult','long'],'application only allows review result exception');\n$items=$subs->status($actor,false)['items'];messagingAssert(count($items)===4 && $items[3]['remaining_count']===null && $items[0]['remaining_count']===0,'worker scenes and long term/count projection');\nmessagingReject(static function()use($subs,$user){$subs->save($user,['key'=>'worker']);},'没有师傅身份');\ntry{$subs->save($actor+['is_demo_actor'=>true],['key'=>'user']);throw new LogicException('demo allowed');}\ncatch(\\WorkerAdmin\\Domain\\Order\\OrderOperationException $e){messagingAssert($e->apiCode()==='DEMO_EXTERNAL_ACTION_BLOCKED' && $e->getCode()===403,'demo preference blocks before persistence');}\nmessagingAssert(!$subRepo->saves,'blocked preferences never saved');\n$subs->save($user,['key'=>'reviewResult','enabled'=>true,'authorization_status'=>'acceptWithAudio']);\nmessagingAssert($subRepo->saves[0][0]===42 && $subRepo->saves[0][1]==='reviewResult','onboarding subscription uses trusted actor');\n$outRepo=new MessagingOutbox();$console=new \\WorkerAdmin\\Application\\Messaging\\MessageOutboxConsole($outRepo,new \\WorkerAdmin\\Application\\Identity\\MobileNumberProtection(new MessagingCipher()));\nmessagingReject(static function()use($console){$console->close(1,'bad');},'5～200');\nmessagingReject(static function()use($console){$console->retry(0);},'编号');\nmessagingReject(static function()use($console){$console->addSuppression('bad','manual','',3);},'手机号');\nmessagingReject(static function()use($console){$console->addSuppression('13800131234','manual',str_repeat('字',301),3);},'300');\nmessagingAssert(!$outRepo->calls,'invalid admin commands never persist');\n$console->dashboard('bogus',str_repeat('字',110),-9,'bad-tab');$call=end($outRepo->calls);\nmessagingAssert($call[1]==='' && mb_strlen($call[2])===100 && $call[3]===1 && $call[4]==='records','dashboard filters and tab normalized');\n$outRepo->rows=[['topic'=>'wecom_webhook','business_key'=>'worker:42','_payload_json'=>json_encode(['event_type'=>'worker_profile_submitted','title'=>'新的师傅入驻资料待审核'],JSON_UNESCAPED_UNICODE)]];\n$dashboard=$console->dashboard('','',2,'suppressions');$call=end($outRepo->calls);\nmessagingAssert($call[3]===2 && $call[4]==='suppressions' && $dashboard['activeTab']==='suppressions','suppression tab and page preserved');\nmessagingAssert($dashboard['result']['rows'][0]['business_label']==='师傅入驻 / 资料审核' && !isset($dashboard['result']['rows'][0]['_payload_json']),'business label is readable and raw payload never reaches view');\n$outRepo->rows=[];\n$result=$console->addSuppression('+86 13800131234','bogus',' note ',3);$call=end($outRepo->calls);\nmessagingAssert($result===['masked'=>'138****1234','reason'=>'manual'] && $call[2]==='138****1234' && $call[4]==='note' && $call[5]===3,'suppression masks and retains admin identity');\nmessagingAssert($call[1]===hash('sha256','sms-recipient-mobile:13800131234'),'canonical privacy context');\nforeach(['pending','processing','processed','closed']as $status)messagingReject(static function()use($status){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>'aliyun_sms','status'=>$status,'attempt_count'=>5],'retry');},'仅可');\nmessagingReject(static function(){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>'aliyun_sms','status'=>'failed','attempt_count'=>4],'close');},'5 次');\nmessagingReject(static function(){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>'aliyun_paid_sms','status'=>'failed','attempt_count'=>5],'retry');},'付费短信');\nforeach(['aliyun_sms','wechat_subscribe','wecom_webhook']as $topic){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>$topic,'status'=>'failed','attempt_count'=>5],'retry');messagingAssert(true,'eligible general dead letter');}\n// Public API dispatch via Kernel, including status/error envelopes and trusted identity.\n$db=new \\WorkerAdmin\\Core\\Database(['database'=>'offline']);$actorRepo=new MessagingActors();$resolver=new \\WorkerAdmin\\Application\\Identity\\ApiActorResolver($actorRepo,$settings);\n$module=new \\WorkerAdmin\\Http\\Api\\Modules\\MessagingApiModule($db,$resolver,$inbox,$subs);\n$gate=new class implements \\WorkerAdmin\\Contracts\\RequestContentSecurityGate{public function inspect(string $route):void{throw new LogicException('message read does not need moderation');}};\n$kernel=new \\WorkerAdmin\\Http\\Api\\ApiKernel($db,[$module],$gate);\nfunction messagingDispatch($kernel,string $route,string $method,string $body='{}',string $token='valid'):MessagingResponse {\n    $_SERVER['REQUEST_METHOD']=$method;$_SERVER['HTTP_AUTHORIZATION']=$token==='valid'?'Bearer '.str_repeat('a',64):$token;MessagingInput::$body=$body;\n    try{$kernel->dispatch($route);throw new LogicException('no response');}catch(MessagingResponse $response){return $response;}\n}\nstream_wrapper_unregister('php');stream_wrapper_register('php',MessagingInput::class);\ntry{\n    $_GET=['page'=>2,'user_id'=>999,'worker_id'=>999];\n    $response=messagingDispatch($kernel,'notifications.list','GET');$call=end($inboxRepo->calls);\n    messagingAssert($response->status===200 && $call[1]['user_id']===42 && $call[1]['worker_id']===7,'client recipient IDs ignored');\n    $_GET['cursor']='opaque-range';\n    messagingAssert(messagingDispatch($kernel,'notifications.threads','GET')->payload['data']['schema']===2&&end($inboxRepo->calls)[1]['user_id']===42,'thread route uses resolved actor');\n    messagingAssert(messagingDispatch($kernel,'notifications.thread_messages','GET')->status===200&&end($inboxRepo->calls)[0]==='messages'&&end($inboxRepo->calls)[1]['user_id']===42&&end($inboxRepo->calls)[2]==='opaque-range','thread history route and opaque cursor');\n    messagingAssert(messagingDispatch($kernel,'notifications.read_all','POST','{\"range_cursor\":\"signed-range\"}')->status===200&&end($inboxRepo->calls)[0]==='range'&&end($inboxRepo->calls)[1]['worker_id']===7&&end($inboxRepo->calls)[2]==='signed-range','signed read-all takes precedence over legacy range');\n    $_GET['cursor']=['invalid'];\n    messagingAssert(messagingDispatch($kernel,'notifications.threads','GET')->payload['code']==='NOTIFICATION_RESYNC_REQUIRED','array cursor rejected without coercion');\n    messagingAssert(messagingDispatch($kernel,'notifications.read_all','POST','{\"range_cursor\":[]}')->payload['code']==='NOTIFICATION_RESYNC_REQUIRED','nonstring read range is not legacy read-all');\n    $_GET['cursor']='opaque-range';\n    messagingAssert(messagingDispatch($kernel,'notifications.thread_messages','POST')->status===405,'thread history method boundary');\n    messagingAssert(messagingDispatch($kernel,'notifications.threads','GET','{}','bad')->status===401,'threads require original bearer session');\n    messagingAssert(messagingDispatch($kernel,'notifications.summary','GET')->payload['data']['unread_count']===3,'summary envelope');\n    messagingAssert(messagingDispatch($kernel,'subscriptions.status','GET')->payload['ok']===true,'subscription status envelope');\n    messagingAssert(messagingDispatch($kernel,'subscriptions.diagnose','GET')->payload['data']['pending_count']===42,'diagnostic actor scope');\n    messagingAssert(messagingDispatch($kernel,'subscriptions.preference','POST','{\"key\":\"user\",\"enabled\":true,\"authorization_status\":\"accept\"}')->payload['ok']===true,'preference success envelope');\n    messagingAssert(messagingDispatch($kernel,'notifications.read','POST','{\"id\":\"one\"}')->payload['message']==='已标记为已读','single read copy');\n    messagingAssert(messagingDispatch($kernel,'notifications.read_batch','POST','{\"ids\":[\"x\",\"x\",\"y\"]}')->payload['data']['updated_count']===2,'batch envelope');\n    messagingAssert(messagingDispatch($kernel,'notifications.read_all','POST')->payload['message']==='未读消息已清除','read all copy');\n    messagingAssert(messagingDispatch($kernel,'notifications.read','POST','bad')->payload['code']==='NOTIFICATION_REQUIRED','legacy malformed body fallback');\n    messagingAssert(messagingDispatch($kernel,'notifications.list','POST')->status===405,'method boundary');\n    messagingAssert(messagingDispatch($kernel,'notifications.list','GET','{}','bad')->status===401,'invalid bearer');\n    $actorRepo->found=false;messagingAssert(messagingDispatch($kernel,'notifications.list','GET')->payload['code']==='UNAUTHORIZED','expired token');$actorRepo->found=true;\n    $settings->configured=false;$missing=messagingDispatch($kernel,'notifications.list','GET');messagingAssert($missing->status===503 && $missing->payload['code']==='MINIAPP_APPID_MISSING','legacy missing app config code');$settings->configured=true;\n}finally{stream_wrapper_restore('php');}\n// Public Admin Kernel applies first-password/CSRF before module permissions and commands.\n$auth=new class($db) extends \\WorkerAdmin\\Core\\Auth {\n    public bool $allowed=true;public bool $force=false;public array $permissions=[];\n    public function requireLogin(){}\n    public function user(){return ['id'=>9,'must_change_password'=>$this->force];}\n    public function requirePermission($p){$this->permissions[]=$p;if(!$this->allowed)throw new RuntimeException('permission denied');}\n};\n$csrf=new class extends \\WorkerAdmin\\Core\\Csrf {public bool $valid=true;public function verifyRequest(){if(!$this->valid)throw new RuntimeException('csrf invalid');}};\n$adminModule=new \\WorkerAdmin\\Http\\Admin\\Modules\\MessageOutboxAdminModule($db,$auth,$csrf,$console);\n$adminKernel=new \\WorkerAdmin\\Http\\Admin\\AdminKernel($db,$auth,$csrf,[$adminModule]);\n$_SERVER['REQUEST_METHOD']='GET';$_GET=['tab'=>'suppressions','page'=>'3'];ob_start();$adminKernel->dispatch('message-outbox');ob_end_clean();\n$call=end($outRepo->calls);$view=end($GLOBALS['views']);\nmessagingAssert(end($auth->permissions)==='settings.manage' && $view[0]==='admin/message-outbox' && $call[3]===3 && $call[4]==='suppressions' && $view[1]['activeTab']==='suppressions','dashboard permission, tab, page and view');\n$auth->allowed=false;$count=count($outRepo->calls);messagingReject(static function()use($adminKernel){$adminKernel->dispatch('message-outbox');},'permission');messagingAssert(count($outRepo->calls)===$count,'permission denies before read');$auth->allowed=true;\n$_SERVER['REQUEST_METHOD']='POST';$_GET=['id'=>'4'];$_POST=['_csrf'=>'secret','token'=>'secret','close_reason'=>'原因说明内容'];\n$adminKernel->dispatch('message-outbox.retry');messagingAssert(end($GLOBALS['audits'])[0]==='message.outbox.retry' && end($outRepo->calls)===['retry',4],'retry public route audit');\n$adminKernel->dispatch('message-outbox.close');messagingAssert(end($GLOBALS['audits'])[0]==='message.outbox.close' && end($outRepo->calls)===['close',4],'close public route audit');\n$_POST=['mobile'=>'13800131234','reason'=>'opt_out','note'=>'test'];$adminKernel->dispatch('message-outbox.suppression.add');messagingAssert(end($GLOBALS['audits'])[0]==='sms.suppression.add' && strpos((string)end($GLOBALS['redirects']),'tab=suppressions')!==false,'suppression add audit and tab return');\n$adminKernel->dispatch('message-outbox.suppression.remove');messagingAssert(end($GLOBALS['audits'])[0]==='sms.suppression.remove' && strpos((string)end($GLOBALS['redirects']),'tab=suppressions')!==false,'suppression remove audit and tab return');\n$_POST=['token'=>'secret','_csrf'=>'secret','close_reason'=>'bad'];$adminKernel->dispatch('message-outbox.close');messagingAssert(end($GLOBALS['flashes'])[0]==='danger' && !isset($GLOBALS['old']['token']) && !isset($GLOBALS['old']['_csrf']),'business error safely flashes and preserves only form input');\n// Guard redirects terminate in production. Throw a sentinel on guard-only calls to test before dispatch.\n$csrf->valid=false;$count=count($outRepo->calls);$GLOBALS['terminateRedirect']=true;\ntry{$adminKernel->dispatch('message-outbox.retry');throw new LogicException('missing csrf redirect');}catch(MessagingRedirect $e){}\n// The response boundary terminates the guarded request before module dispatch.\nmessagingAssert(count($outRepo->calls)===$count,'CSRF denies all business calls');\n$csrf->valid=true;$auth->force=true;\ntry{$adminKernel->dispatch('message-outbox.retry');throw new LogicException('missing password redirect');}catch(MessagingRedirect $e){messagingAssert(strpos($e->getMessage(),'profile')!==false,'forced password return');}\nmessagingAssert(count($outRepo->calls)===$count,'first password guard prevents business calls');\necho 'Messaging public boundary regression: '.$checks.' checks passed.'.PHP_EOL;","tools/test_chat_operations.py":"#!/usr/bin/env python3\nimport importlib.util,json,pathlib,tempfile,unittest,sys\nROOT=pathlib.Path(__file__).resolve().parents[1]\ndef module(name,path):\n    spec=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);return m\nrelease=module(\"chat_release\",ROOT/\"tools/check-chat-release.py\")\ncenter=module(\"chat_center\",ROOT/\"chat/scripts/test-center.py\")\narchive=module(\"chat_archive\",ROOT/\"chat/scripts/seal-binlogs.py\")\nclass ChatOperationsContract(unittest.TestCase):\n    def complete(self):\n        sha=\"a\"*40;e=release.template();e.update(revision=sha,environment=\"production\",recovery_epoch=\"b\"*64,release_authorized=True,authorization_reference=\"explicit human release task\")\n        for case in e[\"cases\"].values():case.update(status=\"passed\",revision=sha,evidence=\"private-reviewed-evidence\")\n        for area in release.AREAS:e[area].update(status=\"passed\",revision=sha,evidence=\"private-reviewed-evidence\")\n        e[\"automation\"].update(race=True,mysql57=True,php_version=\"8.3.36\",redis=True,source_verified=True)\n        e[\"devices\"].update(physical_devices=[{\"id\":\"device-a\",\"platform\":\"ios\",\"physical\":True,\"passed\":True},{\"id\":\"device-b\",\"platform\":\"android\",\"physical\":True,\"passed\":True}],weak_network=True,large_text=True,dark_mode=True,album_permissions=True,safe_area=True)\n        e[\"capacity\"].update(environment=\"target_host\",connections=[30,100,300],history_sizes=[1000,10000,100000],mixed_order_media_notifications=True,baseline_order_p95_ms=100,mixed_order_p95_ms=105,headroom_percent=35)\n        e[\"deployment\"].update(actual_sha=sha,source_dirty=False,nonroot_processes=[\"serve\",\"worker\"],private_internal_port=True,php_routes_preserved=True,rollback_passed=True,authenticated_wss=True)\n        e[\"channels\"].update(simulated=False,private_media_expiry=True,platform_safety=True,subscription_receipts=True,field_images_reviewed=True,manual_wait_reviewed=True)\n        e[\"recovery\"].update(independent_increment_complete=True,old_permissions_denied=True,recall_not_revived=True,notification_not_resent=True,wallet_not_recharged=True,gap_blocks_access=True)\n        return e,sha\n    def test_pending_template_cannot_release(self):\n        self.assertIn(\"human_release_authorization\",release.validate(release.template(),\"a\"*40))\n    def test_complete_schema_and_source_binding(self):\n        e,sha=self.complete();self.assertEqual([],release.validate(e,sha))\n        self.assertIn(\"exact_revision\",release.validate(e,\"b\"*40))\n        e[\"cases\"][\"C04\"][\"revision\"]=\"b\"*40\n        self.assertIn(\"C04\",release.validate(e,sha))\n    def test_simulations_cannot_satisfy_devices_channels_or_host(self):\n        e,sha=self.complete()\n        e[\"devices\"][\"physical_devices\"][0][\"physical\"]=False\n        e[\"capacity\"][\"environment\"]=\"isolated_runner\";e[\"channels\"][\"simulated\"]=True\n        failed=release.validate(e,sha)\n        for key in (\"two_real_devices\",\"target_mixed_capacity\",\"actual_channels\"):self.assertIn(key,failed)\n    def test_load_budget_and_recovery_gaps_block(self):\n        e,sha=self.complete();e[\"capacity\"][\"mixed_order_p95_ms\"]=120;e[\"recovery\"][\"independent_increment_complete\"]=False\n        failed=release.validate(e,sha)\n        self.assertIn(\"order_budget_and_headroom\",failed);self.assertIn(\"safe_incremental_restore\",failed)\n        e,sha=self.complete();e[\"capacity\"][\"baseline_order_p95_ms\"]=float(\"inf\")\n        self.assertIn(\"order_budget_and_headroom\",release.validate(e,sha))\n    def test_fixture_never_accepts_credentials_or_urls(self):\n        f={\"schema\":1,\"instance\":\"instance-a\",\"suite\":\"media\",\"environment\":\"test\",\"provider\":\"simulated\",\"order\":{\"workflow\":\"measurement\",\"source\":\"consumer\",\"dispatch\":\"single_grab\"},\"actors\":[\"worker\",\"customer\",\"platform_staff\"],\"image_counts\":[1,2,4,9]}\n        self.assertEqual(f,center.validate(f))\n        for key,value in ((\"provider\",\"real\"),(\"environment\",\"production\"),(\"suite\",\"../outside\")):\n            bad=dict(f);bad[key]=value\n            with self.assertRaises(ValueError):center.validate(bad)\n        f[\"access_token\"]=\"injected\"\n        with self.assertRaises(ValueError):center.validate(f)\n    def test_archive_gap_and_incomplete_tail_rejected_before_execution(self):\n        with tempfile.TemporaryDirectory() as d:\n            start={\"server_uuid\":\"a\"*8+\"-\"+\"b\"*4+\"-\"+\"c\"*4+\"-\"+\"d\"*4+\"-\"+\"e\"*12,\"file\":\"mysql-bin.000001\",\"position\":\"4\"}\n            end=dict(start,file=\"mysql-bin.000002\",position=\"200\")\n            with self.assertRaises(ValueError):archive.verify_range(start,end,d,sys.executable)\n            (pathlib.Path(d)/\"mysql-bin.000001\").write_bytes(b\"\\\\xfebin\")\n            with self.assertRaises(ValueError):archive.verify_range(start,start,d,sys.executable)\nif __name__==\"__main__\":unittest.main()\n"},"blob_shas":{"chat/build.sh":"c9d2e8c654fac590d6533b2dfaa9d6e31e3d1aaa","chat/cmd/chatd/main.go":"ecd53d4d9b8d37dd714e8148a8e606a52801870f","chat/config.example.json":"e447e5d76b6cbce670f6ab011ef32