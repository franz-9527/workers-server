/* Chat page toolbar and anchored operation menus. Avoid duplicating the system capsule's three-dot affordance. */
.chat-icon-tune{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23202526%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%207h10m4%200h2M4%2012h4m4%200h8M4%2017h2m4%200h10%22%2F%3E%3Ccircle%20cx%3D%2216%22%20cy%3D%227%22%20r%3D%222%22%2F%3E%3Ccircle%20cx%3D%2210%22%20cy%3D%2212%22%20r%3D%222%22%2F%3E%3Ccircle%20cx%3D%228%22%20cy%3D%2217%22%20r%3D%222%22%2F%3E%3C%2Fsvg%3E")}
.chat-page-toolbar{position:relative;z-index:2;display:flex;align-items:center;gap:12rpx;min-height:88rpx;box-sizing:border-box;background:#f7f7f7}
.chat-toolbar-copy{flex:1;min-width:0}
.chat-toolbar-title{font-size:30rpx;line-height:1.45;font-weight:600;color:#202526}
.chat-toolbar-sub{font-size:21rpx;line-height:1.45;color:#667075;margin-top:2rpx}
.chat-menu-trigger{flex:0 0 72rpx;width:72rpx;min-width:72rpx;min-height:72rpx;border-radius:14rpx}
.chat-menu-trigger .chat-icon{width:40rpx;height:40rpx}
.chat-menu-trigger:active{background:#e7eaeb}
.chat-operation-mask{position:fixed;left:0;right:0;bottom:0;top:88rpx;z-index:90;background:rgba(0,0,0,.14)}
.chat-operation-panel{position:absolute;top:8rpx;right:20rpx;width:430rpx;max-width:calc(100vw - 40rpx);overflow:hidden;border-radius:20rpx;background:#fff;color:#202526;box-shadow:0 14rpx 44rpx rgba(0,0,0,.2)}
.chat-operation-group{padding:16rpx}
.chat-operation-group+.chat-operation-group{border-top:1rpx solid #eceeef}
.chat-operation-label{padding:2rpx 8rpx 12rpx;font-size:20rpx;line-height:1.4;color:#8a969a}
.chat-operation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx}
.chat-operation-chip{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-height:86rpx;margin:0;padding:12rpx 14rpx;border-radius:14rpx;background:#f5f6f6;color:#263237;text-align:left;line-height:1.35}
.chat-operation-chip::after,.chat-operation-item::after{border:0}
.chat-operation-chip>text:first-child{font-size:25rpx;font-weight:600}
.chat-operation-chip>text:last-child{font-size:19rpx;color:#7c898e;margin-top:4rpx}
.chat-operation-chip.selected{background:#e2f4f5;color:#007782}
.chat-operation-chip.selected>text:last-child{color:#4d858b}
.chat-operation-list{display:flex;flex-direction:column}
.chat-operation-item{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:72rpx;margin:0;padding:12rpx 8rpx;background:transparent;color:#263237;font-size:25rpx;line-height:1.4;text-align:left}
.chat-operation-item+.chat-operation-item{border-top:1rpx solid #f0f1f1}
.chat-operation-item>text:last-child{color:#a1aaad;font-size:30rpx;font-weight:300}
@media(prefers-color-scheme:dark){
 .chat-page-toolbar{background:#1e1e1e}.chat-toolbar-title{color:#e8e8e8}.chat-toolbar-sub{color:#b2b8bb}.chat-menu-trigger:active{background:#303030}
 .chat-operation-mask{background:rgba(0,0,0,.34)}.chat-operation-panel{background:#252525;color:#e8e8e8;box-shadow:0 14rpx 44rpx rgba(0,0,0,.45)}
 .chat-operation-group+.chat-operation-group{border-color:#393939}.chat-operation-label{color:#9ca5a8}
 .chat-operation-chip{background:#303030;color:#e8e8e8}.chat-operation-chip>text:last-child{color:#aeb6b9}.chat-operation-chip.selected{background:#163f44;color:#8bdce5}.chat-operation-chip.selected>text:last-child{color:#8fc1c6}
 .chat-operation-item{color:#e8e8e8}.chat-operation-item+.chat-operation-item{border-color:#353535}.chat-operation-item>text:last-child{color:#929a9d}
}
/* Shared message long-press menu: compact WeChat-like dark anchor, original solid pictograms. */
.message-menu-mask{position:fixed;inset:0;z-index:120;background:transparent}
.message-menu{position:absolute;display:grid;max-width:calc(100vw - 24px);padding:6px;box-sizing:border-box;background:rgba(47,47,47,.98);color:#fff;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,.22);overflow:visible}
.message-menu::after{content:"";position:absolute;left:50%;width:0;height:0;transform:translateX(-50%);border-left:7px solid transparent;border-right:7px solid transparent}
.message-menu.is-above::after{bottom:-7px;border-top:7px solid rgba(47,47,47,.98)}
.message-menu.is-below::after{top:-7px;border-bottom:7px solid rgba(47,47,47,.98)}
.message-menu button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:100%;height:62px;min-width:0;min-height:0;margin:0;padding:7px 4px 6px;box-sizing:border-box;background:transparent;color:inherit;border-radius:6px;font-size:11px;font-weight:400;line-height:14px;white-space:nowrap}
.message-menu button::after{border:0}
.message-menu button:active{background:rgba(255,255,255,.1)}
.message-menu button.is-danger{color:#ffb3ac}
.message-menu-label{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
