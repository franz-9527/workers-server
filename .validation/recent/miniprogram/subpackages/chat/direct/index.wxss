@import "../../../style/chat-native.wxss";
page{background:#f5f7f8;color:#293a3f}
.page{min-height:100vh;box-sizing:border-box;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom))}
.heading{font-size:34rpx;font-weight:600}
.meta,.hint{font-size:25rpx;color:#66777b;line-height:1.55}
.hint{padding:16rpx 0}
.scene-toolbar{margin:-8rpx -8rpx 12rpx;padding:0 4rpx;background:transparent}
.scene-toolbar .chat-toolbar-copy{padding-right:8rpx}
.scene-toolbar .chat-toolbar-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.scene-toolbar .chat-toolbar-sub{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.scene-operation-mask{top:88rpx}
.scene-operation-panel{right:28rpx;max-height:72vh;overflow-y:auto}
.scene-operation-panel button[disabled]{opacity:.5}
.scene-operation-danger{color:#b34d45!important}
.scene-operation-done{color:#14724d!important}
.scene-status-banner{margin:4rpx 0 14rpx;padding:12rpx 16rpx;border-radius:12rpx;background:#eef3f3;color:#607277;font-size:23rpx;line-height:1.5}
.scene-status-banner.is-warning{background:#fff3e8;color:#8a6039}
.scene-history-action{display:flex;align-items:center;justify-content:center;width:auto;min-height:64rpx;margin:4rpx auto 12rpx;padding:8rpx 18rpx;background:transparent;color:#647b80;font-size:23rpx;line-height:1.4}
.scene-history-action::after{border:0}
.scene-inbox-toolbar{margin:-24rpx -28rpx 12rpx;padding:0 20rpx 0 28rpx;border-bottom:1rpx solid #ddd;background:#f7f7f7}
.scene-inbox-toolbar .chat-toolbar-sub{max-width:460rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.scene-inbox-mask{top:88rpx}
.scene-inbox-panel{right:20rpx}
.scene-inbox-list{margin:0 -28rpx;border-top:1rpx solid #eceeef}
.scene-inbox-row{display:flex;align-items:center;gap:20rpx;width:100%;min-height:140rpx;box-sizing:border-box;padding:20rpx 24rpx;background:#fff;border-bottom:1rpx solid #eceeef}
.scene-inbox-row:active{background:#eef8f9}
.scene-inbox-row.is-pinned{background:#f2f3f3}
.scene-inbox-row.is-disabled{opacity:.72}
.scene-inbox-avatar{position:relative;display:flex;align-items:center;justify-content:center;flex:0 0 96rpx;width:96rpx;height:96rpx;border-radius:16rpx;background:#daf3f6;color:#008d9c;font-size:40rpx}

.scene-inbox-unread{position:absolute;z-index:1;right:-9rpx;top:-9rpx;display:flex;align-items:center;justify-content:center;min-width:30rpx;height:30rpx;padding:0 7rpx;box-sizing:content-box;border:3rpx solid #fff;border-radius:20rpx;background:#ef5148;color:#fff;font-size:19rpx;line-height:30rpx}
.scene-inbox-attention-dot{position:absolute;z-index:1;right:-5rpx;top:-5rpx;width:18rpx;height:18rpx;border:4rpx solid #fff;border-radius:50%;background:#ef5148}
.scene-inbox-sync-warning{margin:0 -28rpx;padding:12rpx 24rpx;background:#fff5e9;color:#805016;font-size:22rpx;line-height:1.5}
.scene-inbox-body{flex:1 1 0%;min-width:0;overflow:hidden}
.scene-inbox-main{display:flex;align-items:center;gap:10rpx;width:100%;min-width:0}
.scene-inbox-title{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#263d42;font-size:30rpx;font-weight:500;line-height:1.45}
.scene-inbox-tag{display:inline-flex;align-items:center;flex:0 1 auto;max-width:120rpx;padding:2rpx 8rpx;border-radius:999rpx;background:#edf2f3;color:#62757a;font-size:19rpx;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.scene-inbox-preview{display:block;margin-top:7rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#667075;font-size:25rpx;line-height:1.5}
.scene-inbox-meta{display:flex;flex:0 0 auto;flex-direction:column;align-self:flex-start;align-items:flex-end;justify-content:flex-start;gap:8rpx;min-width:72rpx;max-width:120rpx;padding-top:4rpx;text-align:right}
.scene-inbox-state{font-size:21rpx;line-height:1.5;color:#75858a;white-space:nowrap}
.scene-inbox-clock{display:block;max-width:120rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#75858a;font-size:20rpx;line-height:1.5}
.scene-inbox-state.attention{color:#b76518}
.scene-inbox-state.done{color:#4e7a63}
.scene-inbox-empty{margin:0 -28rpx;padding:96rpx 28rpx 82rpx;text-align:center;color:#81959a;background:#f5f7f8}
.scene-inbox-empty-icon{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin:0 auto 22rpx;border-radius:26rpx;background:#e6f5f7;color:#15a5b4;font-size:48rpx}

.scene-inbox-empty-title{color:#576f74;font-size:28rpx;font-weight:600;line-height:1.5}
.scene-inbox-empty-desc{max-width:520rpx;margin:10rpx auto 0;color:#71858a;font-size:22rpx;line-height:1.6}
.scene-inbox-more{display:flex;align-items:center;justify-content:center;width:auto;min-height:76rpx;margin:18rpx auto 4rpx;padding:10rpx 22rpx;background:transparent;color:#54777d;font-size:23rpx;line-height:1.4}
.scene-inbox-more::after{border:0}
.item{background:#fff;border-radius:16rpx;padding:24rpx;margin-top:16rpx}
.actions{display:flex;flex-wrap:wrap;gap:14rpx;margin:18rpx 0}
.actions button,.send{margin:0}
.actions .selected,.send{color:#923f08;background:#fff0df}
.message{display:flex;flex-direction:row;align-items:flex-start;gap:14rpx;margin:20rpx 0}
.message.own{flex-direction:row-reverse}
.scene-message-avatar-frame{display:block;flex:0 0 72rpx;width:72rpx;height:72rpx;border-radius:10rpx;overflow:hidden}
.scene-message-avatar-frame:active{opacity:.68}
.scene-message-avatar{display:block;width:72rpx;height:72rpx}
.scene-message-main{display:flex;flex:1 1 auto;min-width:0;max-width:calc(100% - 86rpx);flex-direction:column;align-items:flex-start}
.message.own .scene-message-main{align-items:flex-end}
.bubble{display:block;margin-top:6rpx;padding:16rpx 22rpx;border-radius:14rpx;max-width:82%;overflow-wrap:anywhere;white-space:pre-wrap;background:#fff;color:#293a3f;font-size:28rpx;line-height:1.6;box-sizing:border-box}
.scene-message-main>.bubble,.scene-message-main>.quote-preview,.scene-message-main>.scene-image-bubble{max-width:100%}
.own .bubble{background:#fff0df}
.selection{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;margin:14rpx 0}
.selection image{width:100%;height:118rpx;border-radius:10rpx;background:#e9eeee}
.quote-preview{display:flex;flex-direction:column;align-items:flex-start;gap:2rpx;margin:6rpx 0 0;padding:8rpx 12rpx;min-height:0;max-width:82%;text-align:left;overflow:hidden;background:#f0f2f2;color:#627579;border-left:3rpx solid #9aa9ac;border-radius:7rpx}
.quote-preview::after{border:0}
.quote-preview[disabled]{opacity:.68}
.quote-label{font-size:20rpx;font-weight:600;line-height:1.4;color:#718488}
.quote-text{max-width:100%;font-size:22rpx;line-height:1.45;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow-wrap:anywhere}
.compose-quote{display:flex;align-items:center;gap:10rpx;margin:0 0 10rpx;padding:7rpx 6rpx 7rpx 10rpx;border-left:3rpx solid #c88a4e;border-radius:8rpx;background:#fff6ed;color:#6f5946}
.compose-quote-copy{display:flex;align-items:center;gap:9rpx;flex:1;min-width:0}
.compose-quote-label{flex:none;font-size:20rpx;font-weight:600;color:#8a6a4d}
.compose-quote-text{flex:1;min-width:0;font-size:22rpx;line-height:1.45;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.compose-quote-close{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;width:64rpx;min-width:64rpx;height:64rpx;min-height:64rpx;margin:0;padding:0;border-radius:50%;background:transparent;color:#84776c;font-size:36rpx;font-weight:300;line-height:1}
.compose-quote-close::after{border:0}

.scene-image-bubble{padding:0!important;background:transparent!important;max-width:82%}
.scene-image-grid{display:grid;gap:6rpx;width:max-content;max-width:100%}
.scene-image-grid.is-single{grid-template-columns:286rpx}
.scene-image-grid.is-few{grid-template-columns:repeat(2,174rpx)}
.scene-image-grid.is-many{grid-template-columns:repeat(3,114rpx)}
.scene-chat-image{display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;border-radius:12rpx;background:#e7ecee}
.scene-image-grid.is-single .scene-chat-image{width:286rpx;height:252rpx}
.scene-image-grid.is-few .scene-chat-image{width:174rpx;height:174rpx}
.scene-image-grid.is-many .scene-chat-image{width:114rpx;height:114rpx}
.scene-chat-image image{width:100%;height:100%;display:block}
.scene-image-placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:#7a898d;font-size:22rpx;background:linear-gradient(135deg,#eef2f3,#e2e8e9)}

.scene-compose{position:sticky;z-index:20;bottom:0;margin:24rpx -28rpx calc(-24rpx - env(safe-area-inset-bottom));padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:#f7f8f8;border-top:1rpx solid #dfe5e6;box-shadow:0 -8rpx 22rpx rgba(24,40,44,.04)}
.scene-composer-row{display:flex;align-items:center;gap:12rpx;width:100%;min-width:0}
.scene-composer-input{flex:1;min-width:0;height:72rpx;box-sizing:border-box;padding:0 20rpx;border-radius:10rpx;background:#fff;color:#293a3f;font-size:29rpx;line-height:72rpx}
.scene-composer-placeholder{color:#879397}
.scene-send,.scene-more{display:flex;align-items:center;justify-content:center;flex:none;height:72rpx;min-height:72rpx;margin:0;box-sizing:border-box;border-radius:10rpx;line-height:1}
.scene-send{width:112rpx;min-width:112rpx;padding:0 14rpx;background:#07a96b;color:#fff;font-size:28rpx;font-weight:500}
.scene-more{width:72rpx;min-width:72rpx;padding:0;background:#fff;color:#425056;font-size:38rpx;font-weight:300}.scene-more .chat-icon{width:34rpx;height:34rpx}
.scene-send::after,.scene-more::after{border:0}
.scene-send[disabled],.scene-more[disabled]{opacity:.48}
.scene-tools{display:flex;flex-wrap:wrap;width:100%;padding:20rpx 0 2rpx}
.scene-tool{display:flex;flex:0 0 25%;width:25%;min-width:0;max-width:25%;min-height:146rpx;box-sizing:border-box;align-items:center;justify-content:flex-start;flex-direction:column;gap:10rpx;margin:0;padding:8rpx 4rpx;background:transparent;color:#56666b;font-size:23rpx;line-height:1.4}
.scene-tool::after{border:0}
.scene-tool-icon{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;border-radius:18rpx;background:#fff;color:#55666b}.scene-tool-icon .chat-icon{width:40rpx;height:40rpx}
.scene-tool[disabled]{opacity:.42}
.scene-status{margin-top:10rpx;font-size:22rpx;line-height:1.5;color:#6d7c80;word-break:break-word}
.scene-inline-action{display:inline-flex;align-items:center;justify-content:flex-start;width:auto;min-height:56rpx;margin:6rpx 0 0;padding:4rpx 0;background:transparent;color:#74858a;font-size:21rpx;line-height:1.5;text-align:left}
.scene-inline-action::after{border:0}
.scene-image-draft{margin-top:12rpx;padding:14rpx 16rpx;border:1rpx solid #dde6e7;border-radius:14rpx;background:#fff}
.scene-image-draft-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx;font-size:22rpx;line-height:1.5;color:#66777b}
.scene-image-draft-head text:first-child{flex:none;font-weight:600;color:#46585d}
.scene-image-draft-head text:last-child{min-width:0;text-align:right}
.scene-image-actions{display:flex;gap:12rpx;margin-top:12rpx}
.scene-image-actions button{flex:1;min-height:64rpx;margin:0;padding:8rpx 12rpx;border-radius:10rpx;font-size:23rpx;line-height:1.4}
.scene-image-actions button::after{border:0}
.scene-image-send{background:#e8f5f0;color:#14724d}
.scene-image-cancel{background:#f1f3f3;color:#647378}


@media(max-width:340px){
 .scene-image-grid.is-single{grid-template-columns:250rpx}
 .scene-image-grid.is-single .scene-chat-image{width:250rpx;height:224rpx}
 .scene-image-grid.is-few{grid-template-columns:repeat(2,154rpx)}
 .scene-image-grid.is-few .scene-chat-image{width:154rpx;height:154rpx}
 .scene-image-grid.is-many{grid-template-columns:repeat(3,100rpx)}
 .scene-image-grid.is-many .scene-chat-image{width:100rpx;height:100rpx}
}
@media(prefers-color-scheme:dark){
 page{background:#171a1b;color:#e2edef}
 .page{color:#e2edef}
 .meta,.hint{color:#aeb9bd}
 .item{background:#252b2d}
 .bubble{background:#252b2d;color:#e2edef}
 .own .bubble{background:#49331f}
 .actions .selected,.send{background:#49331f;color:#f2bd83}
 .quote-preview{background:#202728;color:#b9c6c9;border-color:#71878c}
 .quote-label{color:#9eafb3}
 .compose-quote{background:#30261e;border-color:#a46c38;color:#e1c7ad}
 .compose-quote-label{color:#d0ab86}
 .compose-quote-close{color:#c8b8aa}
 .scene-chat-image{background:#293235}
 .scene-image-placeholder{background:#293235;color:#a6b5b9}
 .scene-compose{background:#1d2224;border-color:#30393b;box-shadow:0 -8rpx 22rpx rgba(0,0,0,.16)}
 .scene-composer-input,.scene-more,.scene-tool-icon,.scene-image-draft{background:#292f31;color:#e2edef}
 .scene-composer-placeholder{color:#8d9a9e}
 .scene-tool{color:#b4c0c3}
 .scene-status,.scene-inline-action,.scene-image-draft-head{color:#aeb9bd}
 .scene-image-draft{border-color:#344043}
 .scene-image-draft-head text:first-child{color:#d6e0e2}
 .scene-image-send{background:#214238;color:#a9e3c8}
 .scene-image-cancel{background:#2d3436;color:#bcc7c9}
 .scene-toolbar{background:transparent}.scene-operation-danger{color:#ef9b94!important}.scene-operation-done{color:#9ed7b6!important}
 .scene-status-banner{background:#242c2e;color:#b6c2c5}.scene-status-banner.is-warning{background:#3b2d22;color:#e6c39f}
 .scene-history-action{color:#a9bdc1}
 .scene-inbox-toolbar{background:#1e1e1e;border-color:#333}.scene-inbox-list{border-color:#303030}
 .scene-inbox-row{background:#191919;border-color:#303030}.scene-inbox-row:active{background:#303030}.scene-inbox-row.is-pinned{background:#252525}
 .scene-inbox-avatar{background:#19383d;color:#72dce6}
 .scene-inbox-unread{border-color:#191919}.scene-inbox-row.is-pinned .scene-inbox-unread{border-color:#252525}
 .scene-inbox-attention-dot{border-color:#191919}.scene-inbox-row.is-pinned .scene-inbox-attention-dot{border-color:#252525}
 .scene-inbox-sync-warning{background:#352b20;color:#ffd097}
 .scene-inbox-title{color:#e8e8e8}.scene-inbox-preview,.scene-inbox-state,.scene-inbox-clock{color:#b2b8bb}
 .scene-inbox-tag{background:#293234;color:#b9c6ca}.scene-inbox-state.attention{color:#f2bd83}.scene-inbox-state.done{color:#9dd0b3}
 .scene-inbox-empty{background:#171a1b;color:#aeb9bd}.scene-inbox-empty-icon{background:#19383d;color:#72dce6}
 .scene-inbox-empty-title{color:#d6e0e3}.scene-inbox-empty-desc,.scene-inbox-more{color:#a9bdc1}
}

