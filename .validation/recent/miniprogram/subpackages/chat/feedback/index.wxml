<view class="feedback-page">
  <view class="chat-page-toolbar feedback-toolbar">
    <view class="chat-toolbar-copy"><view class="chat-toolbar-title">{{filter==='unread'?'未读反馈':(filter==='pending'?'待处理反馈':(filter==='archived'?'已归档反馈':(filter==='hidden'?'已隐藏反馈':'用户反馈')))}}</view><view class="chat-toolbar-sub">{{pendingCount}} 项待处理<text wx:if="{{attentionCount}}"> · {{attentionCount}} 项需关注</text></view></view>
    <button class="chat-icon-button chat-menu-trigger" bindtap="toggleMenu" aria-label="{{showMenu?'收起筛选':'反馈筛选'}}"><text class="chat-icon chat-icon-tune"></text></button>
  </view>
  <view wx:if="{{showMenu}}" class="chat-operation-mask feedback-menu-mask" catchtap="closeMenu">
    <view class="chat-operation-panel feedback-menu-panel" catchtap="stopMenu" aria-label="反馈筛选">
      <view class="chat-operation-group"><view class="chat-operation-label">反馈状态</view><view class="chat-operation-grid">
        <button class="chat-operation-chip {{filter==='all'?'selected':''}}" data-filter="all" bindtap="filterList"><text>全部反馈</text><text>当前可见</text></button>
        <button class="chat-operation-chip {{filter==='unread'?'selected':''}}" data-filter="unread" bindtap="filterList"><text>未读</text><text>有新内容</text></button>
        <button class="chat-operation-chip {{filter==='pending'?'selected':''}}" data-filter="pending" bindtap="filterList"><text>待处理</text><text>尚未完成</text></button>
        <button class="chat-operation-chip {{filter==='archived'?'selected':''}}" data-filter="archived" bindtap="filterList"><text>已归档</text><text>历史反馈</text></button>
        <button class="chat-operation-chip {{filter==='hidden'?'selected':''}}" data-filter="hidden" bindtap="filterList"><text>已隐藏</text><text>隐藏反馈</text></button>
      </view></view>
    </view>
  </view>
  <view wx:if="{{error}}" class="feedback-warning">{{error}}</view>
  <view wx:if="{{loading && !items.length}}" class="feedback-empty">正在同步用户反馈</view>
  <view class="feedback-list">
    <view wx:for="{{items}}" wx:key="conversation_id" class="feedback-row {{item.handled?'is-handled':''}}" data-id="{{item.conversation_id}}" bindtap="openItem" role="button">
      <view class="feedback-avatar"><text class="cuIcon-commentfill"></text><view wx:if="{{item.unread_count}}" class="feedback-unread">{{item.unread_count>99?'99+':item.unread_count}}</view></view>
      <view class="feedback-body"><view class="feedback-main"><text class="feedback-title">{{item.ownerName}}</text><text wx:if="{{item.pinned}}" class="feedback-pin">已置顶</text><text class="feedback-state {{item.handled?'done':'pending'}}">{{item.handled?'已处理':'待处理'}}</text></view><view class="feedback-preview">{{item.preview}}</view></view>
      <view class="feedback-meta">{{item.activityLabel}}</view>
    </view>
  </view>
  <view wx:if="{{ready && !loading && !items.length && !error}}" class="feedback-empty">暂无{{filter==='unread'?'未读':(filter==='pending'?'待处理':(filter==='archived'?'已归档':(filter==='hidden'?'已隐藏':'')))}}反馈</view>
  <button wx:if="{{next}}" class="feedback-more" bindtap="more" disabled="{{loading}}">加载更多反馈</button>
</view>
