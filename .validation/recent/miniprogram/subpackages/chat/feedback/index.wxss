@import "../../../style/chat-native.wxss";
page{background:#ededed;color:#202526}.feedback-page{min-height:100vh;box-sizing:border-box;padding:0 0 calc(24rpx + env(safe-area-inset-bottom))}
.feedback-toolbar{padding:4rpx 20rpx 6rpx 28rpx;border-bottom:1rpx solid #ddd;background:#f7f7f7}.feedback-menu-mask{top:84rpx}.feedback-menu-panel{right:20rpx}
.feedback-warning{margin:18rpx 24rpx;padding:16rpx 18rpx;border-radius:12rpx;background:#fff5e9;color:#805016;font-size:23rpx;line-height:1.55}.feedback-list{background:#fff}
.feedback-row{display:flex;align-items:center;gap:18rpx;min-height:126rpx;padding:18rpx 24rpx;box-sizing:border-box;border-bottom:1rpx solid #eceeef;background:#fff}.feedback-row:active{background:#eef8f9}.feedback-row.is-handled{opacity:.82}
.feedback-avatar{position:relative;display:flex;align-items:center;justify-content:center;flex:0 0 82rpx;width:82rpx;height:82rpx;border-radius:18rpx;background:#fff0df;color:#a95e1c;font-size:36rpx}.feedback-unread{position:absolute;right:-9rpx;top:-9rpx;display:flex;align-items:center;justify-content:center;min-width:30rpx;height:30rpx;padding:0 7rpx;border:3rpx solid #fff;border-radius:20rpx;background:#ef5148;color:#fff;font-size:19rpx;line-height:30rpx;box-sizing:content-box}
.feedback-body{flex:1;min-width:0}.feedback-main{display:flex;align-items:center;gap:10rpx}.feedback-title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:28rpx;font-weight:600;color:#263d42}.feedback-state{flex:none;padding:2rpx 9rpx;border-radius:999rpx;font-size:19rpx;line-height:1.5}.feedback-state.pending{background:#fff0df;color:#a95e1c}.feedback-state.done{background:#e9f3ed;color:#4e7a63}
.feedback-preview{margin-top:7rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#667075;font-size:23rpx;line-height:1.5}.feedback-meta{flex:none;align-self:flex-start;max-width:110rpx;padding-top:5rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#75858a;font-size:20rpx}.feedback-empty{padding:110rpx 28rpx;text-align:center;color:#81959a;font-size:25rpx}.feedback-more{display:flex;align-items:center;justify-content:center;width:auto;min-height:76rpx;margin:18rpx auto;padding:10rpx 22rpx;background:transparent;color:#54777d;font-size:23rpx}.feedback-more::after{border:0}
@media(prefers-color-scheme:dark){page{background:#171a1b;color:#e5e8e9}.feedback-toolbar{background:#202526;border-color:#343b3d}.feedback-list,.feedback-row{background:#222829;border-color:#333b3d}.feedback-row:active{background:#293234}.feedback-title{color:#e2e8e9}.feedback-preview,.feedback-meta,.feedback-empty{color:#a4b2b6}.feedback-avatar{background:#49331f;color:#f2bd83}.feedback-unread{border-color:#222829}.feedback-warning{background:#352b20;color:#ffd097}.feedback-state.pending{background:#49331f;color:#f2bd83}.feedback-state.done{background:#263a30;color:#9bd0ad}}

.feedback-pin{flex:none;padding:2rpx 9rpx;border-radius:999rpx;background:#edf4f5;color:#55767c;font-size:19rpx;line-height:1.5}
@media(prefers-color-scheme:dark){.feedback-pin{background:#2d393b;color:#a7c1c6}}
