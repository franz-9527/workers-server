<view class="settings-page">
  <view wx:if="{{loading}}" class="settings-state">正在读取设置</view>
  <view wx:elif="{{error && !revision}}" class="settings-state is-error">{{error}}</view>
  <block wx:else>
    <view wx:if="{{error}}" class="settings-warning">{{error}}</view>
    <view class="settings-card">
      <view class="settings-title">反馈助手</view>
      <view class="settings-desc">这里设置平台反馈会话的展示名称和首次自动回复。仅当前反馈处理管理员可修改。</view>
      <label class="settings-field"><text>显示名称</text><input maxlength="40" value="{{name}}" bindinput="nameInput" disabled="{{saving}}" placeholder="平台反馈助手"/></label>
      <view class="settings-switch"><view><text>首次反馈自动回复</text><text>用户首次成功发送文字或图片后自动回复一次</text></view><switch checked="{{autoReplyEnabled}}" bindchange="autoReplyChange" disabled="{{saving}}" color="#00aebe"/></view>
      <label wx:if="{{autoReplyEnabled}}" class="settings-field"><text>自动回复内容</text><textarea maxlength="500" value="{{autoReplyText}}" bindinput="autoReplyInput" disabled="{{saving}}" placeholder="例如：已收到你的反馈，我们会尽快查看。"></textarea></label>
    </view>
    <view class="settings-note">图片跟随统一会话图片能力，不设反馈助手独立开关。反馈助手不开放实时语音或视频通话。</view>
    <button class="settings-save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存设置</button>
  </block>
</view>
