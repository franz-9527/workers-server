page{background:#f4f6f7;color:#263d42}.settings-page{min-height:100vh;box-sizing:border-box;padding:28rpx 24rpx calc(36rpx + env(safe-area-inset-bottom))}
.settings-card{padding:28rpx 26rpx;border-radius:20rpx;background:#fff}.settings-title{font-size:32rpx;font-weight:700}.settings-desc,.settings-note{margin-top:10rpx;color:#71858a;font-size:23rpx;line-height:1.65}.settings-field{display:block;margin-top:26rpx}.settings-field>text{display:block;margin-bottom:10rpx;font-size:25rpx;font-weight:600}.settings-field input,.settings-field textarea{width:100%;box-sizing:border-box;border:1rpx solid #dce4e6;border-radius:12rpx;background:#f8fafa;color:#263d42;font-size:28rpx}.settings-field input{height:82rpx;padding:0 18rpx}.settings-field textarea{min-height:200rpx;padding:18rpx;line-height:1.6}
.settings-switch{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:26rpx;padding:22rpx 0;border-top:1rpx solid #edf0f1;border-bottom:1rpx solid #edf0f1}.settings-switch>view{display:flex;flex-direction:column;gap:6rpx;min-width:0}.settings-switch>view text:first-child{font-size:26rpx;font-weight:600}.settings-switch>view text:last-child{color:#71858a;font-size:22rpx;line-height:1.5}.settings-note{margin:20rpx 8rpx}.settings-save{margin:28rpx 0 0;min-height:88rpx;border-radius:12rpx;background:#00aebe;color:#fff;font-size:28rpx}.settings-save[disabled]{opacity:.55}.settings-save::after{border:0}.settings-state,.settings-warning{padding:28rpx;border-radius:14rpx;background:#fff;color:#71858a;font-size:25rpx;line-height:1.6}.settings-state.is-error,.settings-warning{background:#fff5e9;color:#805016}.settings-warning{margin-bottom:18rpx}
@media(prefers-color-scheme:dark){page{background:#171a1b;color:#e5e8e9}.settings-card,.settings-state{background:#222829}.settings-title,.settings-field input,.settings-field textarea{color:#e5e8e9}.settings-desc,.settings-note,.settings-switch>view text:last-child{color:#a7b5b8}.settings-field input,.settings-field textarea{background:#1c2224;border-color:#39484b}.settings-switch{border-color:#343e40}.settings-warning,.settings-state.is-error{background:#352b20;color:#ffd097}}
