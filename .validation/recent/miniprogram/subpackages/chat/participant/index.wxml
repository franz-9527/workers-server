<view class="participant-page">
  <view wx:if="{{loading}}" class="participant-state">
    <text class="cuIcon-loading2 cuIconfont-spin"></text>
    <text>正在读取用户资料</text>
  </view>
  <view wx:elif="{{error}}" class="participant-state">
    <text class="cuIcon-warn"></text>
    <text>{{error}}</text>
    <button class="participant-retry" bindtap="retry">重新加载</button>
  </view>
  <block wx:else>
    <view class="participant-card">
      <image class="participant-avatar" src="{{avatarPath}}" mode="aspectFill" aria-hidden="true"/>
      <view class="participant-name">{{profile.displayName}}</view>
      <view class="participant-tags">
        <text wx:for="{{roleLabels}}" wx:key="*this" class="participant-tag">{{item}}</text>
      </view>
    </view>

    <view class="participant-section">
      <view class="participant-section-title">账号资料</view>
      <view class="participant-info-row">
        <text>聊天身份</text>
        <text>{{identityText}}</text>
      </view>
      <view wx:for="{{locationRows}}" wx:key="kind" class="participant-info-row">
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
      </view>
      <view wx:if="{{ipLocationNotice}}" class="participant-privacy-note participant-location-note">IP 属地根据最近登录网络推断，仅供参考。</view>
      <view class="participant-privacy-note">仅显示平台聊天中已核验的身份信息，不额外展示手机号、微信号等联系方式。</view>
    </view>

    <view wx:if="{{isWorker}}" class="participant-section">
      <view class="participant-section-title">师傅资料</view>
      <button wx:if="{{workerProfileTarget}}" class="participant-worker-link" bindtap="openWorkerProfile">
        <view>
          <text class="participant-worker-title">查看已发布的师傅信息</text>
          <text class="participant-worker-desc">技能、服务区域、案例与公开评价等</text>
        </view>
        <text class="participant-chevron">›</text>
      </button>
      <view wx:else class="participant-worker-empty">该师傅当前没有可公开查看的已发布资料。</view>
    </view>

    <view wx:if="{{canModerate}}" class="participant-section participant-admin-section">
      <view class="participant-section-title">管理员操作</view>
      <view class="participant-moderation-row">
        <view>
          <text class="participant-moderation-title">聊天权限</text>
          <text class="participant-moderation-status {{moderationStatus && moderationStatus.blocked ? 'is-blocked' : ''}}">{{moderationStatusText}}</text>
        </view>
        <button class="participant-manage-button" loading="{{moderationLoading}}" disabled="{{moderationLoading || moderationBusy}}" bindtap="openModeration">处置用户</button>
      </view>
      <view class="participant-admin-note">禁言只限制聊天消息、图片、语音与视频发送，不影响订单、付款、退款和售后。</view>
    </view>
  </block>
</view>

<view wx:if="{{moderationOpen}}" class="participant-sheet-mask" bindtap="closeModeration" catchtouchmove="noop">
  <view class="participant-sheet" catchtap="noop">
    <view class="participant-sheet-handle"></view>
    <view class="participant-sheet-head">
      <view>
        <text class="participant-sheet-title">处置用户</text>
        <text class="participant-sheet-subtitle">{{moderationStatusText}}</text>
      </view>
      <button class="participant-sheet-close" bindtap="closeModeration" aria-label="关闭">×</button>
    </view>
    <view class="participant-sheet-label">禁言时长</view>
    <view class="participant-duration-grid">
      <button class="participant-duration {{moderationMode === '86400' ? 'is-active' : ''}}" data-mode="86400" bindtap="selectModerationMode">1天</button>
      <button class="participant-duration {{moderationMode === '259200' ? 'is-active' : ''}}" data-mode="259200" bindtap="selectModerationMode">3天</button>
      <button class="participant-duration {{moderationMode === '604800' ? 'is-active' : ''}}" data-mode="604800" bindtap="selectModerationMode">7天</button>
      <button class="participant-duration {{moderationMode === 'custom' ? 'is-active' : ''}}" data-mode="custom" bindtap="selectModerationMode">自定义</button>
      <button class="participant-duration participant-duration-danger {{moderationMode === 'permanent' ? 'is-active' : ''}}" data-mode="permanent" bindtap="selectModerationMode">永久</button>
    </view>
    <view wx:if="{{moderationMode === 'custom'}}" class="participant-custom-duration">
      <input type="number" value="{{customHours}}" maxlength="3" bindinput="inputCustomHours"/>
      <text>小时</text>
      <text class="participant-custom-hint">1–720 小时</text>
    </view>
    <view class="participant-sheet-label">处置原因</view>
    <textarea class="participant-reason" value="{{moderationReason}}" maxlength="200" auto-height placeholder="填写禁言或解除依据，至少2个字" bindinput="inputModerationReason"></textarea>
    <button class="participant-confirm-button" loading="{{moderationBusy}}" disabled="{{moderationBusy}}" bindtap="confirmModeration">确认禁言</button>
    <button wx:if="{{moderationStatus && moderationStatus.blocked}}" class="participant-unban-button" loading="{{moderationBusy}}" disabled="{{moderationBusy}}" bindtap="unban">解除当前禁言</button>
  </view>
</view>
