IMIT 1 FOR UPDATE\",\n                ['id'=>$locked['current_assignment_id'],'order_id'=>$locked['id']]\n            );\n            if (!$old) throw new RuntimeException('原师傅指派状态已变化，请刷新后重试');\n\n            $quote = $db->fetch(\n                \"SELECT q.*,qv.id quote_version_id,qv.commission_rate_bp_snapshot,qv.commission_min_cents_snapshot,qv.rule_acknowledged_at\n                 FROM quotes q\n                 JOIN quote_versions qv ON qv.quote_id=q.id AND qv.version_no=q.current_version\n                 WHERE q.order_id=:order_id AND BINARY q.public_id=BINARY :public_id\n                   AND q.quote_type='worker' AND q.worker_id IS NOT NULL AND q.worker_id<>:old_worker\n                   AND q.status IN ('active','closed') LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$locked['id'],'public_id'=>$quotePublicId,'old_worker'=>$old['worker_id']]\n            );\n            if (!$quote) throw new RuntimeException('请选择该订单中另一位已报价师傅');\n\n            $worker = $db->fetch(\n                \"SELECT w.id,w.verification_status,u.status user_status\n                 FROM worker_profiles w JOIN users u ON u.id=w.user_id\n                 WHERE w.id=:worker_id LIMIT 1 FOR UPDATE\",\n                ['worker_id'=>$quote['worker_id']]\n            );\n            if (!$worker || (string)$worker['verification_status'] !== 'approved' || (string)$worker['user_status'] !== 'active') {\n                throw new RuntimeException('新师傅当前已不具备接单资格，请选择其他报价');\n            }\n\n            $rate = $quote['rule_acknowledged_at'] ? (int)$quote['commission_rate_bp_snapshot'] : (int)$locked['commission_rate_bp'];\n            $minimum = $quote['rule_acknowledged_at'] ? (int)$quote['commission_min_cents_snapshot'] : (int)$locked['commission_min_cents'];\n            $amount = (int)$quote['amount_cents'];\n            $booking = min($amount, (int)$locked['booking_fee_cents'], (int)$bookingPayment['amount_cents']);\n            $commission = $this->commissionAmount($amount, $rate, $minimum);\n            $ruleId = $this->ensureRuleVersion($db, $locked, $rate, $minimum);\n\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$old['id']]);\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'cancelled',:reason,'user',:actor_id,UTC_TIMESTAMP())\",\n                ['assignment_id'=>$old['id'],'order_id'=>$locked['id'],'worker_id'=>$old['worker_id'],'reason'=>'用户更换师傅：'.$reason,'actor_id'=>$actor['user_id']]\n            );\n            $db->execute(\n                \"UPDATE order_role_grants g JOIN worker_profiles w ON w.user_id=g.user_id\n                 SET g.status='revoked',g.revoked_at=UTC_TIMESTAMP()\n                 WHERE g.order_id=:order_id AND g.status='active' AND w.id=:worker_id\",\n                ['order_id'=>$locked['id'],'worker_id'=>$old['worker_id']]\n            );\n            $db->execute(\n                \"UPDATE quotes\n                 SET status=CASE WHEN id=:new_id THEN 'selected' WHEN id=:old_id THEN 'closed' ELSE status END,\n                     selected_at=CASE WHEN id=:new_time THEN UTC_TIMESTAMP() ELSE selected_at END,\n                     updated_at=UTC_TIMESTAMP()\n                 WHERE order_id=:order_id\",\n                ['new_id'=>$quote['id'],'old_id'=>$old['quote_id'] ?: 0,'new_time'=>$quote['id'],'order_id'=>$locked['id']]\n            );\n            $db->insert(\n                \"INSERT INTO quote_selections(order_id,quote_id,quote_version_id,user_id,amount_cents_snapshot,booking_fee_cents_snapshot,status,payment_expires_at,selected_at,confirmed_at)\n                 VALUES(:order_id,:quote_id,:version_id,:user_id,:amount,:booking,'confirmed',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['order_id'=>$locked['id'],'quote_id'=>$quote['id'],'version_id'=>$quote['quote_version_id'],'user_id'=>$actor['user_id'],'amount'=>$amount,'booking'=>$booking]\n            );\n\n            // 先按旧成交关系生成旧师傅通知，再切换订单当前师傅。\n            OrderNotificationService::queue(\n                $db,(int)$locked['id'],'worker-switch-old:'.$old['id'],'worker_replaced_by_user',\n                ['reason'=>$reason,'role'=>'old_worker','notify_recipients'=>['worker']]\n            );\n\n            $assignmentPublicId = \\public_id();\n            $assignmentId = $db->insert(\n                \"INSERT INTO assignments(public_id,order_id,worker_id,quote_id,assignment_type,commission_rule_version_id,\n                    final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,\n                    estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accept_deadline_at,created_at,updated_at)\n                 VALUES(:public_id,:order_id,:worker_id,:quote_id,'worker_quote',:rule_id,:amount,:booking,:rate,:minimum,:commission,:offline,:net,'offered',UTC_TIMESTAMP(),NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_id'=>$assignmentPublicId,'order_id'=>$locked['id'],'worker_id'=>$quote['worker_id'],'quote_id'=>$quote['id'],'rule_id'=>$ruleId,\n                    'amount'=>$amount,'booking'=>$booking,'rate'=>$rate,'minimum'=>$minimum,'commission'=>$commission,\n                    'offline'=>max(0,$amount-$booking),'net'=>$amount-$commission,\n                ]\n            );\n            $db->execute(\n                \"UPDATE orders SET selected_quote_id=:quote_id,final_amount_cents=:amount,assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,\n                        commission_rule_version_id=:rule_id,assignment_status='offered',contact_revealed_at=NULL,updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['quote_id'=>$quote['id'],'amount'=>$amount,'worker_id'=>$quote['worker_id'],'assignment_id'=>$assignmentId,'rule_id'=>$ruleId,'id'=>$locked['id']]\n            );\n            $this->autoAcceptWorkerQuoteAssignment(\n                $db,(int)$locked['id'],$assignmentId,(int)$quote['worker_id'],$ruleId,\n                '用户选择另一位已报价师傅，报价即视为承接意愿',(int)$actor['user_id']\n            );\n            $this->event($db, (int)$locked['id'], 'worker_replaced_by_user', 'user', (int)$actor['user_id'], [\n                'old_worker_id'=>(int)$old['worker_id'],'new_worker_id'=>(int)$quote['worker_id'],'reason'=>$reason,\n                'quote_id'=>(string)$quote['public_id'],'booking_payment_no'=>(string)$bookingPayment['public_no'],\n                'message'=>'用户在开工前更换已报价师傅，新师傅按其报价意愿自动接单；旧师傅后续订单访问权已撤销。',\n            ]);\n            return ['assignment_id'=>$assignmentPublicId,'quote_id'=>(string)$quote['public_id'],'amount_cents'=>$amount];\n        });\n\n        return [\n            'message'=>'已更换师傅，新师傅已按报价意愿自动接单；原师傅后续订单访问权限已撤销',\n            'data'=>$result,\n        ];\n    }\n\n    /** @param array<string,mixed> $order */\n    private function ensureRuleVersion(Database $db, array $order, int $rate, int $minimum): int\n    {\n        $ruleId = (int)($order['commission_rule_version_id'] ?? 0);\n        if ($ruleId > 0 && $db->fetchValue('SELECT id FROM commission_rule_versions WHERE id=:id AND order_id=:order_id LIMIT 1', ['id'=>$ruleId,'order_id'=>$order['id']])) {\n            return $ruleId;\n        }\n        $version = 1 + (int)$db->fetchValue('SELECT COALESCE(MAX(version_no),0) FROM commission_rule_versions WHERE order_id=:order_id', ['order_id'=>$order['id']]);\n        return $db->insert(\n            \"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,adjustment_type,status,locked_at,created_at)\n             VALUES(:order_id,:version,:rate,:minimum,'default','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['order_id'=>$order['id'],'version'=>$version,'rate'=>$rate,'minimum'=>$minimum]\n        );\n    }\n\n    private function autoAcceptWorkerQuoteAssignment(Database $db, int $orderId, int $assignmentId, int $workerId, int $ruleId, string $reason, int $actorUserId): void\n    {\n        $assignment = $db->fetch(\n            \"SELECT * FROM assignments WHERE id=:id AND order_id=:order_id AND worker_id=:worker_id FOR UPDATE\",\n            ['id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$workerId]\n        );\n        if (!$assignment || $assignment['assignment_type'] !== 'worker_quote') throw new RuntimeException('师傅报价指派不存在或状态异常');\n        if ($assignment['status'] !== 'offered') throw new RuntimeException('师傅报价指派状态已变化');\n        $db->execute(\"UPDATE assignments SET status='accepted',accepted_at=UTC_TIMESTAMP(),accept_deadline_at=NULL,updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$assignmentId]);\n        $db->execute(\n            \"UPDATE orders SET assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,assignment_status='accepted',publish_status='hidden',\n                    contact_revealed_at=COALESCE(contact_revealed_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:order_id\",\n            ['worker_id'=>$workerId,'assignment_id'=>$assignmentId,'order_id'=>$orderId]\n        );\n        if ($ruleId > 0) $db->execute('UPDATE commission_rule_versions SET locked_at=COALESCE(locked_at,UTC_TIMESTAMP()) WHERE id=:id', ['id'=>$ruleId]);\n        $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:order_id AND id<>:id AND status='offered'\", ['order_id'=>$orderId,'id'=>$assignmentId]);\n        $db->insert(\n            \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n             VALUES(:assignment_id,:order_id,:worker_id,'accepted',:reason,'system',:actor_id,UTC_TIMESTAMP())\",\n            ['assignment_id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$workerId,'reason'=>$reason,'actor_id'=>$actorUserId]\n        );\n        $this->event($db, $orderId, 'assignment_auto_accepted', 'system', 0, ['worker_id'=>$workerId,'source'=>'worker_quote','message'=>$reason]);\n        OrderNotificationService::queue($db, $orderId, 'worker-quote-auto-accepted:'.$assignmentId, 'assignment_accepted', ['auto_accepted'=>1,'source'=>'worker_quote']);\n    }\n\n    private function commissionAmount(int $amount, int $rateBp, int $minimum): int\n    {\n        if ($amount <= 0) return 0;\n        return min($amount, max((int)round($amount * $rateBp / 10000, 0, PHP_ROUND_HALF_UP), max(0,$minimum)));\n    }\n\n    /** @param array<string,mixed> $payload */\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n        $db->insert(\n            \"INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())\",\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$type.':'.$orderId.':'.bin2hex(random_bytes(6)),\n                'actor_type'=>$actorType,'actor_id'=>$actorId > 0 ? $actorId : null,'payload'=>is_string($json) ? $json : '{}',\n            ]\n        );\n    }\n}\n","server/app/Infrastructure/Scheduling/AssignmentTimeoutProcessor.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Scheduling;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/**\n * 派单/抢单占位超时的单笔正式处理器。\n *\n * 生产 scheduler 负责扫描候选，本类只锁定并处理一个 assignment。\n * testing 入口必须绑定一个 built test_instance，且只允许 demo 非审核样例订单。\n */\nfinal class AssignmentTimeoutProcessor\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db=$db;\n    }\n\n    public function expireProduction(int $assignmentId): bool\n    {\n        if($assignmentId<1)return false;\n        return $this->expire($assignmentId,0,null);\n    }\n\n    /** @return array<string,mixed> */\n    public function expireTestInstance(int $instanceId,bool $advanceClock=true): array\n    {\n        if(!TestingEnvironmentPolicy::active())throw new RuntimeException('派单超时实例执行只允许 testing 环境');\n        if($instanceId<1)throw new RuntimeException('测试实例无效');\n\n        $target=$this->db->fetch(\n            \"SELECT ti.id instance_id,ti.order_id,ti.order_no_snapshot,ti.scenario_key,ti.build_status,ti.archived_at,ti.deleted_at,\n                    o.public_no,o.is_demo,o.current_assignment_id,o.lifecycle_status,\n                    a.id assignment_id,a.status assignment_status,a.assignment_type,a.offered_at,a.accept_deadline_at\n             FROM test_instances ti\n             JOIN orders o ON o.id=ti.order_id\n             JOIN assignments a ON a.id=o.current_assignment_id AND a.order_id=o.id\n             WHERE ti.id=:instance\n             LIMIT 1\",\n            ['instance'=>$instanceId]\n        );\n        if(!$target\n            ||(string)$target['build_status']!=='built'\n            ||!empty($target['archived_at'])\n            ||!empty($target['deleted_at'])\n            ||(int)$target['is_demo']!==1\n            ||(string)$target['public_no']!==(string)$target['order_no_snapshot']\n            ||strpos((string)$target['public_no'],'BXDEMOHALL')===0\n            ||(string)$target['lifecycle_status']!=='active'\n            ||(string)$target['assignment_status']!=='offered'){\n            throw new RuntimeException('派单超时测试实例边界失败');\n        }\n\n        $deadline=$this->deadline((string)($target['accept_deadline_at']??''),(string)($target['offered_at']??''));\n        if($deadline===null)throw new RuntimeException('当前派单缺少可验证的接受截止时间');\n        $asOf=$advanceClock\n            ?gmdate('Y-m-d H:i:s',max(time(),strtotime($deadline.' UTC')+1))\n            :gmdate('Y-m-d H:i:s');\n\n        $expired=$this->expire((int)$target['assignment_id'],$instanceId,$asOf);\n        return[\n            'expired'=>$expired,\n            'assignment_id'=>(int)$target['assignment_id'],\n            'order_id'=>(int)$target['order_id'],\n            'assignment_type'=>(string)$target['assignment_type'],\n            'deadline_at'=>$deadline,\n            'as_of'=>$asOf,\n            'clock_fixture'=>$advanceClock,\n            'scope'=>'test_instance',\n        ];\n    }\n\n    private function expire(int $assignmentId,int $testInstanceId,?string $asOf): bool\n    {\n        return$this->db->transaction(function(Database $db)use($assignmentId,$testInstanceId,$asOf):bool{\n            if($testInstanceId>0&&!TestingEnvironmentPolicy::active())throw new RuntimeException('禁止跨测试域执行派单超时');\n\n            $params=['id'=>$assignmentId];\n            $dueSql='COALESCE(accept_deadline_at,DATE_ADD(offered_at,INTERVAL 24 HOUR))<=UTC_TIMESTAMP()';\n            if($testInstanceId>0){\n                $dueSql='COALESCE(accept_deadline_at,DATE_ADD(offered_at,INTERVAL 24 HOUR))<=:as_of';\n                $params['as_of']=$asOf;\n            }\n            $assignment=$db->fetch(\n                \"SELECT * FROM assignments\n                 WHERE id=:id AND status='offered' AND {$dueSql}\n                 FOR UPDATE\",\n                $params\n            );\n            if(!$assignment)return false;\n\n            if($testInstanceId>0){\n                $order=$db->fetch(\n                    \"SELECT o.*\n                     FROM orders o\n                     JOIN test_instances ti ON ti.id=:instance AND ti.order_id=o.id\n                     WHERE o.id=:id\n                       AND o.is_demo=1\n                       AND BINARY o.public_no=BINARY ti.order_no_snapshot\n                       AND ti.build_status='built'\n                       AND ti.archived_at IS NULL\n                       AND ti.deleted_at IS NULL\n                     FOR UPDATE\",\n                    ['instance'=>$testInstanceId,'id'=>$assignment['order_id']]\n                );\n                if(!$order||strpos((string)$order['public_no'],'BXDEMOHALL')===0)throw new RuntimeException('派单超时测试订单边界失败');\n                if((int)($order['current_assignment_id']??0)!==(int)$assignment['id'])throw new RuntimeException('当前测试指派已经变化');\n            }else{\n                $order=$db->fetch(\n                    'SELECT * FROM orders WHERE id=:id AND COALESCE(is_demo,0)=0 FOR UPDATE',\n                    ['id'=>$assignment['order_id']]\n                );\n            }\n\n            if(!$order||(string)$order['lifecycle_status']!=='active')return false;\n            if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n            }\n\n            $changed=$db->execute(\n                \"UPDATE assignments\n                 SET status='expired',rejected_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='offered'\",\n                ['id'=>$assignment['id']]\n            );\n            if($changed!==1)return false;\n\n            $timeoutReason=(string)$assignment['assignment_type']==='single_grab'\n                ?'抢单后未在规定时间提交报价，系统自动释放并重新开放抢单'\n                :'派单超过处理期限未处理，系统自动释放';\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'expired',:reason,'system',NULL,UTC_TIMESTAMP())\",\n                [\n                    'assignment_id'=>$assignment['id'],\n                    'order_id'=>$assignment['order_id'],\n                    'worker_id'=>$assignment['worker_id'],\n                    'reason'=>$timeoutReason,\n                ]\n            );\n\n            if((int)($order['current_assignment_id']??0)===(int)$assignment['id']){\n                if((string)$assignment['assignment_type']==='single_grab'){\n                    $db->execute(\n                        \"UPDATE orders\n                         SET current_assignment_id=NULL,assigned_worker_id=NULL,assignment_status='unassigned',\n                             publish_status='published',quote_status='waiting',contact_revealed_at=NULL,\n                             updated_at=UTC_TIMESTAMP(),version=version+1\n                         WHERE id=:id\",\n                        ['id'=>$order['id']]\n                    );\n                }else{\n                    $db->execute(\n                        \"UPDATE orders\n                         SET current_assignment_id=NULL,assigned_worker_id=NULL,assignment_status='unassigned',\n                             publish_status='hidden',contact_revealed_at=NULL,\n                             updated_at=UTC_TIMESTAMP(),version=version+1\n                         WHERE id=:id\",\n                        ['id'=>$order['id']]\n                    );\n                }\n            }\n\n            $db->execute(\n                \"UPDATE order_role_grants g\n                 JOIN worker_profiles w ON w.user_id=g.user_id\n                 SET g.status='revoked',g.revoked_at=UTC_TIMESTAMP()\n                 WHERE g.order_id=:order_id AND g.status='active' AND w.id=:worker_id\",\n                ['order_id'=>$order['id'],'worker_id'=>$assignment['worker_id']]\n            );\n\n            $payload=[\n                'assignment_id'=>(int)$assignment['id'],\n                'message'=>(string)$assignment['assignment_type']==='single_grab'\n                    ?'抢单后未在规定时间提交报价，系统已释放并重新开放抢单。'\n                    :'派单超过处理期限未处理，系统已自动释放。',\n            ];\n            if($testInstanceId>0){\n                $payload['test_instance_id']=$testInstanceId;\n                $payload['clock_fixture']=$asOf!==null;\n                $payload['as_of']=$asOf;\n            }\n            $this->recordOrderEvent($db,(int)$order['id'],(int)$order['version'],$payload);\n            return true;\n        });\n    }\n\n    private function recordOrderEvent(Database $db,int $orderId,int $version,array $payload): void\n    {\n        $eventKey='scheduler:assignment_timeout:order:'.$orderId.':v'.max(1,$version);\n        $db->execute(\n            \"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,'assignment_expired',:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",\n            [\n                'order_id'=>$orderId,\n                'event_key'=>substr($eventKey,0,128),\n                'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        OrderNotificationService::queue(\n            $db,\n            $orderId,\n            substr($eventKey,0,128),\n            'assignment_expired',\n            $payload\n        );\n    }\n\n    private function deadline(string $explicit,string $offeredAt): ?string\n    {\n        $explicit=trim($explicit);\n        if($explicit!==''){\n            $timestamp=strtotime($explicit.' UTC');\n            if($timestamp!==false)return gmdate('Y-m-d H:i:s',$timestamp);\n        }\n        $offeredAt=trim($offeredAt);\n        if($offeredAt==='')return null;\n        $timestamp=strtotime($offeredAt.' UTC');\n        return$timestamp===false?null:gmdate('Y-m-d H:i:s',$timestamp+86400);\n    }\n}\n","server/tests/chat_repair_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderNegotiationRepository;\n\n/** Reuses the full disposable install from chat_assignment_contract.php. */\nfunction chatRepairEpisodeContract(Database $db): void\n{\n    $db->execute(\"INSERT INTO orders(id,public_no,user_id,audit_status,lifecycle_status,payment_status,assignment_status,created_at,updated_at) VALUES(78,'CHAT-REPAIR',10001,'approved','active','paid','accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $rule=$db->insert(\"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,status,created_at) VALUES(78,1,1000,1000,'active',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at) VALUES(200,:public_id,78,10,'admin',:rule,20000,5000,1000,1000,2000,15000,18000,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>public_id(),'rule'=>$rule]);\n    $db->execute('UPDATE orders SET current_assignment_id=200,assigned_worker_id=10 WHERE id=78');\n    $bridge=new DatabaseOrderConversationBridge($db,true);\n    $db->transaction(static function()use($bridge):void{$bridge->synchronize(78);});\n    $db->transaction(static function(Database $db)use($bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=78\");$bridge->synchronize(78);});\n    $repair=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at) VALUES('CHAT-AFTER',78,10001,'warranty_repair','fixture','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_repair_episodes')===0,'processing application is not explicit chat acceptance');\n    $episodes=new DatabaseChatRepairEpisodes($db,true);\n    $outside=false;try{$episodes->acceptWorker(78,$repair,10);}catch(RuntimeException $e){$outside=true;}policyAssert($outside,'acceptance fact cannot escape original transaction');\n    $repo=new DatabaseOrderNegotiationRepository($db);\n    $actor=['user_id'=>10002,'worker_id'=>10];\n    $db->execute(\"CREATE TRIGGER fixture_repair_episode_failure BEFORE INSERT ON chat_repair_episodes FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;try{$repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','accepted','fixture');}catch(PDOException $e){$failed=($e->errorInfo[1]??0)===1644;}\n    $db->execute('DROP TRIGGER fixture_repair_episode_failure');\n    policyAssert($failed && $db->fetchValue('SELECT resolution FROM after_sales WHERE id=:id',['id'=>$repair])===null,'episode write failure rolls real repair acceptance back');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','accepted','fixture');\n    $first=(string)$db->fetchValue('SELECT id FROM chat_repair_episodes WHERE active_order_id=78');\n    policyAssert($first!=='' && $db->fetchValue('SELECT accepted_user_id FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==10002,'explicit acceptance binds actual assignment and user');\n    $same=$db->transaction(static function()use($episodes,$repair):?string{return $episodes->acceptWorker(78,$repair,10);});\n    policyAssert($same===$first && (int)$db->fetchValue('SELECT COUNT(*) FROM chat_repair_episodes')===1,'replayed acceptance does not invent a generation');\n    $firstSnapshot=json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=78'),true,32,JSON_THROW_ON_ERROR);\n    policyAssert($firstSnapshot['state']==='open' && $firstSnapshot['episode_key']==='assignment:200:repair:'.$first,'explicit acceptance opens only its new repair episode');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','complete','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==='closed','actual worker completion closes accepted episode');\n    policyAssert($db->fetchValue('SELECT status FROM after_sales WHERE id=:id',['id'=>$repair])==='resolved','original repair completion retained');\n    $closed=json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=78'),true,32,JSON_THROW_ON_ERROR);\n    policyAssert($closed['state']==='readonly' && $closed['episode_key']===$firstSnapshot['episode_key'],'completion retains the closing repair identity');\n    $db->transaction(static function()use($bridge):void{policyAssert($bridge->synchronize(78)===[],'completed repair never flaps back to service identity');});\n    $rejected=false;try{$db->transaction(static function()use($episodes,$repair):void{$episodes->acceptWorker(78,$repair,10);});}catch(RuntimeException $e){$rejected=true;}\n    policyAssert($rejected && (int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0,'resolved request cannot resurrect an accepted generation');\n    $next=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at) VALUES('CHAT-AFTER2',78,10001,'warranty_repair','fixture','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER2','accepted','fixture');\n    $second=(string)$db->fetchValue('SELECT id FROM chat_repair_episodes WHERE active_order_id=78');\n    policyAssert($second!==$first && $db->fetchValue('SELECT state FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==='closed','new request creates a new immutable generation');\n    $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderFulfillmentAuxiliaryRepository');\n    $auxiliary=$reflection->newInstanceWithoutConstructor();$property=$reflection->getProperty('db');$property->setAccessible(true);$property->setValue($auxiliary,$db);\n    $auxiliary->withdrawRepair(['user_id'=>10001],'CHAT-REPAIR','CHAT-AFTER2');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly','actual customer withdrawal closes the guard');\n    $db->transaction(static function()use($episodes,$next):void{$episodes->close(78,$next);});\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='closed'\")===2,'repeated closure is idempotent');\n    $third=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,resolution,opened_at,created_at,updated_at) VALUES('CHAT-AFTER3',78,10001,'warranty_repair','fixture','processing','用户申请平台介入：fixture',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO order_events(order_id,event_type,actor_type,actor_id,payload_json,created_at) VALUES(78,'repair_platform_intervention_requested','user',10001,:payload,UTC_TIMESTAMP())\",['payload'=>json_encode(['after_sale_id'=>'CHAT-AFTER3'],JSON_THROW_ON_ERROR)]);\n    $admin=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseAdminRepairResolutionRepository($db);\n    $operator=['channel'=>'mini_admin','user_id'=>10004];\n    $admin->resolve($operator,'CHAT-REPAIR','CHAT-AFTER3','continue','fixture');\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0\n        && $db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly','platform continue alone never impersonates worker acceptance');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER3','accepted','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='open','worker explicitly accepts after platform continue');\n    $admin->resolve($operator,'CHAT-REPAIR','CHAT-AFTER3','closed','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly'\n        && (int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0,'actual platform closure ends both guard and episode');\n    $disabled=new DatabaseChatRepairEpisodes(new Database([]));\n    policyAssert($disabled->acceptWorker(0,0,0)===null,'disabled episode writer does no IO');\n    echo \"售后明确受理、授权区间、完成/撤回/平台关闭、继续处理与回滚验证通过\\n\";\n}\n","server/app/Domain/Messaging/MessageOperationException.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nuse RuntimeException;\n\nfinal class MessageOperationException extends RuntimeException\n{\n    private string $apiCode;\n    public function __construct(string $message, string $apiCode, int $status = 422)\n    {\n        parent::__construct($message, $status);\n        $this->apiCode = $apiCode;\n    }\n    public function apiCode(): string { return $this->apiCode; }\n}\n","server/app/Contracts/MessageOutboxRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface MessageOutboxRepository\n{\n    public function dashboard(string $status, string $q, int $page, string $tab = 'records'): array;\n    public function retry(int $id): array;\n    public function close(int $id): array;\n    public function addSuppression(string $hmac, string $masked, string $reason, string $note, int $adminId): void;\n    public function removeSuppression(int $id): array;\n}\n","server/app/Domain/Messaging/MessageOutboxPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nuse RuntimeException;\n\nfinal class MessageOutboxPolicy\n{\n\n    /** Eligibility is checked against the row locked by the persistence operation. */\n    public static function requireDeadLetter(?array $row, string $operation): void\n    {\n        if ($row && $row['topic'] === 'aliyun_paid_sms' && $operation === 'retry') {\n            throw new RuntimeException('付费短信禁止从普通消息重试入口重新发送；仅允许用户在明确失败且费用已释放后重新发起。');\n        }\n        if (!$row || !in_array((string)$row['topic'], ['aliyun_sms','wecom_webhook','wechat_subscribe'], true)) {\n            throw new RuntimeException($operation === 'retry' ? '该消息类型不由通用消息调度器发送，请在对应业务页面处理。' : '该消息类型不支持在此结案，请在对应业务页面处理。');\n        }\n        if ($row['status'] !== 'failed' || (int)$row['attempt_count'] < 5) {\n            throw new RuntimeException($operation === 'retry' ? '仅可人工重试已达到 5 次自动重试上限的失败消息；请刷新页面确认当前状态。' : '仅可结案已达到 5 次自动重试上限的失败消息；请刷新页面确认当前状态。');\n        }\n    }\n}\n","server/app/Contracts/SubscriptionRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface SubscriptionRepository\n{\n    public function definitions(): array;\n    public function preferences(int $userId): array;\n    public function save(int $userId, string $key, bool $enabled, string $status): array;\n    public function diagnose(int $userId): array;\n}\n","server/app/Infrastructure/Messaging/SubscriptionCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\n\n\nfinal class SubscriptionCatalog\n{\n    use OrderSubscriptionDefinitionOperations;\n\n}\n","server/app/Contracts/PlatformOrderAdminRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface PlatformOrderAdminRepository\n{\n    /** @return array<string,mixed> */\n    public function dashboard(): array;\n\n    /** @param array<string,mixed> $command */\n    public function create(array $command, int $adminId): int;\n\n    public function publish(int $orderId, int $adminId, int $quoteDays): void;\n\n    public function selectQuote(int $orderId, int $quoteId, int $adminId): void;\n\n    /** @return array<string,mixed> */\n    public function createInvite(int $orderId, int $adminId, int $validDays): array;\n\n    public function revokeInvite(int $orderId, int $inviteId, int $adminId): void;\n}\n","server/app/Infrastructure/Persistence/PlatformOrderBookingPaymentVerifier.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\n/**\n * 平台承接单外部预付款核验。\n *\n * 平台承接单只允许 platform_managed：客户侧款项由外部渠道托管，系统不创建微信\n * order_booking/booking_fee 支付记录。普通客户（包含后台代下单）的微信预约费走普通订单\n * 支付链，绝不能进入本核验器。\n *\n * 调用方必须先在同一事务中锁定 orders 行；本类只核对平台专属资金事实，不发起支付/退款。\n */\nfinal class PlatformOrderBookingPaymentVerifier\n{\n    /**\n     * 返回当前可参与平台单结算的外部已收预付款金额。\n     *\n     * $expectedCents 为调用方已锁定的 order_platform_terms.booking_paid_cents；为兼容少量旧调用\n     * 允许传 null，此时直接从平台条款读取。customerFlowMode 仅用于验证，不再支持 miniapp_booking。\n     */\n    public function verifiedPaidCents(\n        Database $db,\n        int $orderId,\n        int $customerTotalCents,\n        ?int $expectedCents = null,\n        ?string $customerFlowMode = null\n    ): int {\n        if ($orderId <= 0 || $customerTotalCents <= 0) {\n            throw new OrderOperationException('平台承接订单金额或编号无效', 'PLATFORM_BOOKING_INVALID', 409);\n        }\n\n        $terms = null;\n        if ($expectedCents === null || trim((string)$customerFlowMode) === '') {\n            $terms = $db->fetch(\n                'SELECT customer_flow_mode,booking_paid_cents FROM order_platform_terms WHERE order_id=:order_id LIMIT 1 FOR UPDATE',\n                ['order_id'=>$orderId]\n            );\n            if (!$terms) {\n                throw new OrderOperationException('平台承接单缺少托管资金条款，请先修复订单数据', 'PLATFORM_TERMS_REQUIRED', 409);\n            }\n        }\n\n        $flow = trim((string)($customerFlowMode ?? ($terms['customer_flow_mode'] ?? '')));\n        if ($flow !== 'platform_managed') {\n            throw new OrderOperationException('平台承接单只允许平台托管模式；旧小程序预约模式必须先完成数据清理', 'PLATFORM_BOOKING_FLOW_INVALID', 409);\n        }\n\n        $externalPaid = $expectedCents !== null\n            ? $expectedCents\n            : (int)($terms['booking_paid_cents'] ?? 0);\n        if ($externalPaid < 0 || $externalPaid > $customerTotalCents) {\n            throw new OrderOperationException('平台外部已收预付款金额异常，请先核对订单资金条件', 'PLATFORM_BOOKING_AMOUNT_MISMATCH', 409);\n        }\n\n        // 平台托管单出现真实微信预约费，意味着订单来源/支付链串线或客户被重复收费。\n        $payments = $db->fetchAll(\n            \"SELECT id,amount_cents FROM payment_orders\n             WHERE order_id=:order_id AND business_type IN ('order_booking','booking_fee')\n               AND status='paid' ORDER BY id FOR UPDATE\",\n            ['order_id'=>$orderId]\n        );\n        if ($payments) {\n            throw new OrderOperationException(\n                '平台托管单检测到微信预约费付款，请先按资金异常核对；该笔款不能与外部预付款重复抵扣',\n                'PLATFORM_BOOKING_UNEXPECTED_PAYMENT',\n                409\n            );\n        }\n\n        return $externalPaid;\n    }\n}\n","server/app/Infrastructure/Messaging/SubscriptionQuotaStore.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\n\nfinal class SubscriptionQuotaStore\n{\n\n    public static function subscriptionPreferences(Database $db, int $userId): array\n    {\n        if ($userId < 1) return [];\n        $raw = (string) ($db->fetchValue('SELECT setting_value FROM system_settings WHERE setting_key=:key LIMIT 1', ['key'=>self::subscriptionPreferenceKey($userId)]) ?: '');\n        $decoded = $raw === '' ? [] : json_decode($raw, true);\n        if (!is_array($decoded)) return [];\n        // 无需新增表字段：旧 enabled/consumed 偏好在读取时补成计数模型，下次授权或消费即写回新结构。\n        $scenes = SubscriptionCatalog::subscriptionSceneDefinitions();\n        foreach ($decoded as $sceneKey => &$pref) {\n            if (!is_array($pref)) { $pref = []; continue; }\n            $scene = $scenes[$sceneKey] ?? [];\n            $type = trim((string)($pref['subscription_type'] ?? $scene['subscription_type'] ?? 'one_time'));\n            if (!in_array($type, ['one_time','long_term'], true)) $type = 'one_time';\n            $status = (string)($pref['authorization_status'] ?? '');\n            $legacyAccepted = !empty($pref['enabled']) && in_array($status, ['accept','acceptWithAudio','acceptWithAlert'], true);\n            if ($type === 'one_time') {\n                $remaining = array_key_exists('remaining_count', $pref) ? max(0, (int)$pref['remaining_count']) : ($legacyAccepted ? 1 : 0);\n                $pref['remaining_count'] = $remaining;\n                if (!array_key_exists('total_authorized_count', $pref)) $pref['total_authorized_count'] = $remaining;\n                // 一次性订阅的“拒绝”只代表本次没有新增额度，不应抹掉之前已经积累的可发送次数。\n                // 旧数据若出现 remaining_count>0 但状态为 reject/consumed，读取时恢复为可用。\n                if ($remaining > 0 && in_array($status, ['consumed','reject'], true)) $pref['authorization_status'] = 'accept';\n                if (!array_key_exists('last_request_status', $pref) && $status !== '') $pref['last_request_status'] = $status;\n            } else {\n                $pref['remaining_count'] = null;\n                if (!array_key_exists('total_authorized_count', $pref)) $pref['total_authorized_count'] = $legacyAccepted ? 1 : 0;\n            }\n            $pref['subscription_type'] = $type;\n        }\n        unset($pref);\n        return $decoded;\n    }\n\n    public static function saveSubscriptionPreference(Database $db, int $userId, string $sceneKey, bool $enabled, string $authorizationStatus): array\n    {\n        $scenes = SubscriptionCatalog::subscriptionSceneDefinitions();\n        if ($userId < 1 || !isset($scenes[$sceneKey])) throw new \\RuntimeException('订阅场景不存在。');\n        if ($enabled && empty($scenes[$sceneKey]['available'])) throw new \\RuntimeException('该订阅场景尚未在后台配置可用模板。');\n        $allowed = ['accept','acceptWithAudio','acceptWithAlert','reject','ban','filter','disabled','consumed','error',''];\n        if (!in_array($authorizationStatus, $allowed, true)) $authorizationStatus = $enabled ? 'accept' : 'disabled';\n        if ($enabled && $authorizationStatus === '') $authorizationStatus = 'accept';\n        $preferences = self::subscriptionPreferences($db, $userId);\n        $previous = is_array($preferences[$sceneKey] ?? null) ? $preferences[$sceneKey] : [];\n        $type = (string)($scenes[$sceneKey]['subscription_type'] ?? 'one_time');\n        $accepted = in_array($authorizationStatus, ['accept','acceptWithAudio','acceptWithAlert'], true);\n        $remaining = $type === 'one_time' ? max(0, (int)($previous['remaining_count'] ?? 0)) : null;\n        $total = max(0, (int)($previous['total_authorized_count'] ?? 0));\n        $effectiveStatus = $authorizationStatus;\n        if ($accepted) {\n            $enabled = true;\n            if ($type === 'one_time') $remaining++;\n            $total++;\n        } elseif ($type === 'one_time' && in_array($authorizationStatus, ['reject','filter'], true)) {\n            // reject 只是本次没有新增额度；filter 是微信因同标题过滤，本质也不是授权失效。\n            // 两种情况都保留之前已经积累的 remaining_count。\n            $enabled = $remaining > 0;\n            $effectiveStatus = $remaining > 0 ? 'accept' : $authorizationStatus;\n        } elseif (in_array($authorizationStatus, ['ban','disabled'], true)) {\n            $enabled = false;\n        } elseif ($type === 'one_time' && $remaining > 0) {\n            $enabled = true;\n            $effectiveStatus = 'accept';\n        }\n        $preferences[$sceneKey] = array_merge($previous, [\n            'enabled'=>(bool)$enabled,\n            'authorization_status'=>$effectiveStatus,\n            'last_request_status'=>$authorizationStatus,\n            'subscription_type'=>$type,\n            'remaining_count'=>$remaining,\n            'total_authorized_count'=>$total,\n            'template_id'=>(string)$scenes[$sceneKey]['template_id'],\n            'updated_at'=>gmdate('c'),\n        ]);\n        if ($accepted) $preferences[$sceneKey]['last_authorized_at'] = gmdate('c');\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,updated_by,created_at,updated_at) VALUES(:key,:value,'json','notification_user',0,'用户微信订阅消息偏好',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type='json',group_name='notification_user',is_public=0,updated_at=UTC_TIMESTAMP()\", ['key'=>self::subscriptionPreferenceKey($userId),'value'=>$json]);\n        return $preferences[$sceneKey];\n    }\n\n    public static function markSubscriptionConsumed(Database $db, int $userId, string $sceneKey): void\n    {\n        $preferences = self::subscriptionPreferences($db, $userId);\n        if (!isset($preferences[$sceneKey]) || !is_array($preferences[$sceneKey])) return;\n        $pref = $preferences[$sceneKey];\n        $type = (string)($pref['subscription_type'] ?? 'one_time');\n        if ($type === 'one_time') {\n            $remaining = max(0, (int)($pref['remaining_count'] ?? 0) - 1);\n            $pref['remaining_count'] = $remaining;\n            $pref['authorization_status'] = $remaining > 0 ? 'accept' : 'consumed';\n        } else {\n            $pref['authorization_status'] = 'accept';\n        }\n        $pref['last_consumed_at'] = gmdate('c');\n        $pref['updated_at'] = gmdate('c');\n        $preferences[$sceneKey] = $pref;\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute('UPDATE system_settings SET setting_value=:value,updated_at=UTC_TIMESTAMP() WHERE setting_key=:key', ['value'=>$json,'key'=>self::subscriptionPreferenceKey($userId)]);\n    }\n\n    public static function markSubscriptionPermissionUnavailable(Database $db, int $userId, string $sceneKey): void\n    {\n        $preferences = self::subscriptionPreferences($db, $userId);\n        if (!isset($preferences[$sceneKey]) || !is_array($preferences[$sceneKey])) return;\n        $pref = $preferences[$sceneKey];\n        if ((string)($pref['subscription_type'] ?? 'one_time') === 'one_time') $pref['remaining_count'] = 0;\n        $pref['authorization_status'] = 'consumed';\n        $pref['updated_at'] = gmdate('c');\n        $preferences[$sceneKey] = $pref;\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute('UPDATE system_settings SET setting_value=:value,updated_at=UTC_TIMESTAMP() WHERE setting_key=:key', ['value'=>$json,'key'=>self::subscriptionPreferenceKey($userId)]);\n    }\n\n    private static function subscriptionPreferenceKey(int $userId): string\n    {\n        return 'wechat.subscription.user.'.$userId;\n    }\n}\n","server/app/Infrastructure/Persistence/PlatformOrderPricingReviewReadiness.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\n/** 小程序详情与 Web 正常核价入口共用可操作条件。 */\nfinal class PlatformOrderPricingReviewReadiness\n{\n    public static function isReady(\\WorkerAdmin\\Core\\Database $db, int $orderId): bool\n    {\n        return (bool)$db->fetchValue(\n            \"SELECT 1\n             FROM orders o\n             JOIN order_measurement_states ms ON ms.order_id=o.id AND ms.result_status='accepted'\n             JOIN order_platform_terms t ON t.order_id=o.id\n                                        AND t.customer_flow_mode='platform_managed'\n                                        AND t.settlement_status='pending'\n                                        AND t.booking_paid_cents<=t.customer_contract_total_cents\n             JOIN assignments a ON a.id=o.current_assignment_id\n                               AND a.order_id=o.id\n                               AND a.worker_id=o.assigned_worker_id\n                               AND a.status='accepted'\n             WHERE o.id=:order_id\n               AND o.order_source_type='platform'\n               AND o.booking_fee_cents=0\n               AND o.workflow_profile='measurement'\n               AND o.lifecycle_status='active'\n               AND COALESCE(o.dispute_status,'none') IN ('','none','resolved')\n               AND COALESCE(o.refund_status,'none') IN ('','none','failed')\n               AND NOT EXISTS(\n                   SELECT 1 FROM payment_orders p\n                   WHERE p.order_id=o.id AND p.business_type IN ('order_booking','booking_fee') AND p.status='paid'\n               )\n               AND NOT EXISTS(SELECT 1 FROM disputes d WHERE d.order_id=o.id AND d.status IN ('open','pending','processing'))\n               AND NOT EXISTS(SELECT 1 FROM refunds r WHERE r.order_id=o.id AND r.status NOT IN ('failed','closed','cancelled','rejected','succeeded'))\n               AND NOT EXISTS(SELECT 1 FROM order_cancel_requests cr WHERE cr.order_id=o.id AND cr.status IN ('pending','processing'))\n               AND NOT EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND c.status IN ('pending','processing','negotiating'))\n               AND NOT EXISTS(SELECT 1 FROM after_sales s WHERE s.order_id=o.id AND s.status IN ('open','processing'))\n             LIMIT 1\",\n            ['order_id'=>$orderId]\n        );\n    }\n}\n","server/app/Services/OrderNotificationService.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionQuotaStore;\nuse WorkerAdmin\\Infrastructure\\Messaging\\OrderSubscriptionQueue;\nuse WorkerAdmin\\Infrastructure\\Messaging\\DatabaseNotificationProducer;\nuse WorkerAdmin\\Infrastructure\\Settings\\GlobalSettingsProvider;\nuse WorkerAdmin\\Application\\Messaging\\OrderNotificationPublisher;\nuse WorkerAdmin\\Application\\Messaging\\SubscriptionTestData;\n\nforeach([\n    'Contracts/NotificationProducer.php',\n    'Contracts/OrderNotificationPort.php',\n    'Contracts/SettingsProvider.php',\n    'Domain/Messaging/MessageEventCatalog.php',\n    'Domain/Messaging/OrderMessageDefinition.php',\n    'Domain/Messaging/WechatTemplateValue.php',\n    'Infrastructure/Messaging/OrderSubscriptionDefinitionOperations.php',\n    'Infrastructure/Messaging/SubscriptionCatalog.php',\n    'Infrastructure/Messaging/SubscriptionQuotaStore.php',\n    'Infrastructure/Messaging/OrderSubscriptionQueue.php',\n    'Infrastructure/Messaging/OrderNotificationProjector.php',\n    'Infrastructure/Messaging/DatabaseNotificationProducer.php',\n    'Infrastructure/Settings/GlobalSettingsProvider.php',\n    'Application/Messaging/OrderNotificationPublisher.php',\n    'Application/Messaging/SubscriptionTestData.php',\n    'Application/Messaging/MessageEventSwitches.php',\n] as $dependency)require_once __DIR__.'/../'.$dependency;\nunset($dependency);\n\nfinal class OrderNotificationService\n{\n    public static function queuePersistedEvent(Database $db, int $orderId, int $eventId, string $eventType, array $payload = []): void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->queuePersistedEvent($orderId,$eventId,$eventType,$payload);\n    }\n\n    public static function queueAdminTask(Database $db,string $eventKey,string $eventType,string $title,array $lines=[]):void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->adminTask($eventKey,$eventType,$title,$lines);\n    }\n\n    public static function queue(Database $db, int $orderId, string $eventKey, string $eventType, array $payload = []): void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->queue($orderId,$eventKey,$eventType,$payload);\n    }\n\n    public static function eventCatalog(): array { return MessageEventCatalog::all(); }\n    public static function eventSwitches(string $channel):array { return (new \\WorkerAdmin\\Application\\Messaging\\MessageEventSwitches(new GlobalSettingsProvider()))->forChannel($channel); }\n    public static function subscriptionPreferences(Database $db, int $userId): array { return SubscriptionQuotaStore::subscriptionPreferences($db,$userId); }\n    public static function saveSubscriptionPreference(Database $db, int $userId, string $sceneKey, bool $enabled, string $authorizationStatus): array { return SubscriptionQuotaStore::saveSubscriptionPreference($db,$userId,$sceneKey,$enabled,$authorizationStatus); }\n    public static function markSubscriptionConsumed(Database $db, int $userId, string $sceneKey): void { SubscriptionQuotaStore::markSubscriptionConsumed($db,$userId,$sceneKey); }\n    public static function markSubscriptionPermissionUnavailable(Database $db, int $userId, string $sceneKey): void { SubscriptionQuotaStore::markSubscriptionPermissionUnavailable($db,$userId,$sceneKey); }\n    public static function queueWorkerWithdrawalResult(Database $db,int $workerId,string $withdrawalNo,string $status,string $note='',int $amountCents=0):void { (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->withdrawalResult($workerId,$withdrawalNo,$status,$note,$amountCents); }\n    public static function queueWorkerReviewResult(Database $db, int $workerId, string $cloudId, string $decision, string $reason, string $workerName=''): void { (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->workerReviewResult($workerId,$cloudId,$decision,$reason,$workerName); }\n    public static function subscriptionTestEventOptions(string $sceneKey):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->subscriptionTestEventOptions($sceneKey); }\n    public static function subscriptionTestSampleValues(string $sceneKey):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->subscriptionTestSampleValues($sceneKey); }\n    public static function buildSubscriptionTestData(string $sceneKey,array $scene):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->buildSubscriptionTestData($sceneKey,$scene,$_POST); }\n    public static function enqueueSmsFallback(Database $db,array $fallback):bool { return OrderSubscriptionQueue::enqueueSmsFallback($db,$fallback); }\n\n    public static function subscriptionSceneDefinitions(): array { return SubscriptionCatalog::subscriptionSceneDefinitions(); }\n    public static function subscriptionSemanticLabels(): array { return SubscriptionCatalog::subscriptionSemanticLabels(); }\n    public static function subscriptionSemanticDescriptions(): array { return SubscriptionCatalog::subscriptionSemanticDescriptions(); }\n    public static function reviewResultFixedTemplateFields(): array { return SubscriptionCatalog::reviewResultFixedTemplateFields(); }\n    public static function subscriptionFixedValuePresets(string $wechatField,string $label=''): array { return SubscriptionCatalog::subscriptionFixedValuePresets($wechatField,$label); }\n    public static function inferSubscriptionTemplateBinding(array $scene,array $actual,array $previous=[]): array { return SubscriptionCatalog::inferSubscriptionTemplateBinding($scene,$actual,$previous); }\n    public static function recommendSubscriptionKeywords(array $scene,array $keywords): array { return SubscriptionCatalog::recommendSubscriptionKeywords($scene,$keywords); }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderNegotiationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderNegotiationRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\NegotiationPolicy;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\FulfillmentActor;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n// 2026-10-08：所有写操作先锁订单，再锁原业务记录；升级只创建一份现有平台争议。\nfinal class DatabaseOrderNegotiationRepository implements OrderNegotiationRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n\n    private function order(Database $db, array $actor, string $orderNo): array\n    {\n        $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :no FOR UPDATE', ['no'=>$orderNo]);\n        if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n        $owner = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n        $worker = (int)($actor['worker_id'] ?? 0) > 0 && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n        if (!$owner && !$worker) throw new OrderOperationException('只有订单双方可以处理协商', 'FORBIDDEN', 403);\n        return $order;\n    }\n\n    public function respond(array $actor, string $orderNo, string $kind, string $reference, string $decision, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$kind,$reference,$decision,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if (FulfillmentActor::assisted($actor) && ($kind!=='repair' || $decision!=='complete')) {\n                throw new OrderOperationException('协助入口只能提交维修处理结果','ASSISTANCE_NOT_ALLOWED',422);\n            }\n            if ($kind === 'refund') {\n                $request = $this->refund($db, (int)$order['id'], $reference);\n                $this->requireCounterparty($actor, $order, $request);\n                if ($decision === 'accepted') return (new DatabaseOrderCancellationRepository($db))->approveByAgreement($actor, $reference);\n                if ($decision !== 'rejected') throw new OrderOperationException('退款只能接受或拒绝', 'NEGOTIATION_RESPONSE_INVALID', 422);\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_rejected',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n            } elseif ($kind === 'repair') {\n                $this->requireWorker($actor, $order);\n                $repair = $db->fetch(\"SELECT * FROM after_sales WHERE order_id=:id AND BINARY public_no=BINARY :no AND type='warranty_repair' FOR UPDATE\", ['id'=>$order['id'],'no'=>$reference]);\n                if (!$repair || !in_array((string)$repair['status'], ['open','processing'], true)\n                    || strpos((string)$repair['resolution'], '用户申请平台介入') === 0 || strpos((string)$repair['resolution'], '平台主动介入') === 0 || strpos((string)$repair['resolution'], '师傅拒绝维修') === 0) {\n                    throw new OrderOperationException('维修已经响应、结束或平台介入', 'REPAIR_NOT_ACTIVE', 409);\n                }\n                if ($decision === 'accepted' && strpos((string)$repair['resolution'], '师傅接受维修') === 0) {\n                    throw new OrderOperationException('已经接受处理，请记录预约或完成维修', 'REPAIR_ALREADY_ACCEPTED', 409);\n                }\n                $resolution = ($decision === 'rejected' ? '师傅拒绝维修：' : ($decision === 'complete' ? '师傅已完成维修：' : '师傅接受维修：')).$note;\n                if (FulfillmentActor::assisted($actor)) $resolution='管理员补录维修处理结果：'.$note;\n                $db->execute(\"UPDATE after_sales SET status=:status,resolution=:resolution,closed_at=IF(:done=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                    ['status'=>$decision === 'complete' ? 'resolved' : 'processing','resolution'=>$resolution,'done'=>$decision === 'complete' ? 1 : 0,'id'=>$repair['id']]);\n                if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                    $episodes=new DatabaseChatRepairEpisodes($db,true);\n                    if($decision==='accepted') $episodes->acceptWorker((int)$order['id'],(int)$repair['id'],(int)$actor['worker_id']);\n                    else $episodes->close((int)$order['id'],(int)$repair['id']);\n                }\n            } elseif ($kind === 'dispute') {\n                $this->requireWorker($actor, $order);\n                $dispute = $db->fetch('SELECT * FROM disputes WHERE order_id=:id AND BINARY public_no=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                if (!$dispute || (string)$dispute['status'] !== 'negotiating' || !empty($dispute['resolution']) || $decision === 'complete') {\n                    throw new OrderOperationException('异议已经响应或不在协商阶段', 'DISPUTE_RESPONSE_NOT_ALLOWED', 409);\n                }\n                $db->execute('UPDATE disputes SET resolution=:note,updated_at=UTC_TIMESTAMP() WHERE id=:id',\n                    ['note'=>($decision === 'rejected' ? '师傅拒绝异议：' : '师傅接受异议，处理中：').$note,'id'=>$dispute['id']]);\n            } elseif ($kind === 'measurement') {\n                $this->requireWorker($actor, $order);\n                $state = $this->measurement($db, $order, $reference);\n                if ($decision !== 'rejected') throw new OrderOperationException('补测请直接补充成果后提交', 'MEASUREMENT_RESPONSE_INVALID', 422);\n                if ($state['status'] === 'rejected') throw new OrderOperationException('已拒绝本次补测', 'MEASUREMENT_ALREADY_REJECTED', 409);\n                $this->event($db, $order, $actor, 'measurement_rework_rejected', ['rework_id'=>$reference,'note'=>$note,'message'=>'师傅拒绝补测：'.$note]);\n            } else {\n                throw new OrderOperationException('加价请使用原有同意/拒绝入口', 'NEGOTIATION_RESPONSE_INVALID', 422);\n            }\n            // 补测拒绝已经记录专属事件并通知客户；不要再投递一次通用响应。\n            if ($kind !== 'measurement') {\n                $event = $kind === 'repair' ? ['accepted'=>'repair_worker_accepted','rejected'=>'repair_worker_rejected','complete'=>'repair_worker_completed'][$decision] : 'negotiation_responded';\n                $this->event($db, $order, $actor, $event, ['after_sale_id'=>$kind === 'repair' ? $reference : null,'kind'=>$kind,'reference'=>$reference,'decision'=>$decision,'note'=>$note,'message'=>FulfillmentActor::assisted($actor) ? '管理员已补录维修处理结果' : ($decision === 'complete' ? '师傅已提交维修处理结果' : ($decision === 'rejected' ? '对方拒绝方案，可继续协商或申请平台介入' : '对方已接受处理'))]);\n            }\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'decision'=>$decision];\n        });\n    }\n\n    public function proposeRefund(array $actor, string $orderNo, string $reference, int $amount, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reference,$amount,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n            if (!$request || (string)$request['status'] !== 'pending' || NegotiationPolicy::refundStatus((string)$request['reason_code']) !== 'rejected'\n                || (string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('拒绝后才能重新提出退款方案', 'REFUND_PROPOSAL_NOT_ALLOWED', 409);\n            $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n            // 报价式方案只记录双方意愿，执行时仍重新核对真实可退支付，不相信客户端金额。\n            $db->execute(\"UPDATE order_cancel_requests SET applicant_type=:type,applicant_id=:actor,requested_refund_cents=:amount,reason=:note,reason_code='bilateral_refund_pending',requested_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                ['type'=>$type,'actor'=>in_array($type,['user','mini_admin'],true) ? $actor['user_id'] : $actor['worker_id'],'amount'=>$amount,'note'=>$note,'id'=>$request['id']]);\n            $this->event($db, $order, $actor, 'cancel_requested', ['reference'=>$reference,'requested_refund_cents'=>$amount,'message'=>'双方重新提出退款方案，等待对方接受或拒绝']);\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'status'=>'pending'];\n        });\n    }\n\n    public function withdrawRefund(array $actor, string $orderNo, string $reference, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reference,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if ((string)$order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('订单已进入取消、退款或结束流程，不能撤回退款方案', 'REFUND_WITHDRAW_NOT_ALLOWED', 409);\n            }\n            $request = $db->fetch(\n                'SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE',\n                ['id'=>$order['id'],'no'=>$reference]\n            );\n            if (!$request || (string)$request['status'] !== 'pending'\n                || !in_array((string)$request['reason_code'], ['bilateral_refund_pending','bilateral_refund_rejected'], true)) {\n                throw new OrderOperationException('退款方案已进入平台处理、资金执行或已经结束，不能撤回', 'REFUND_WITHDRAW_NOT_ALLOWED', 409);\n            }\n\n            $userApplicant = (string)$request['applicant_type'] === 'user'\n                && (int)$request['applicant_id'] === (int)($actor['user_id'] ?? 0)\n                && (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n            $workerApplicant = (string)$request['applicant_type'] === 'worker'\n                && (int)$request['applicant_id'] === (int)($actor['worker_id'] ?? 0)\n                && (int)($actor['worker_id'] ?? 0) > 0\n                && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n            if (!$userApplicant && !$workerApplicant) {\n                throw new OrderOperationException('只有当前退款方案提出方可以撤回', 'REFUND_WITHDRAW_FORBIDDEN', 403);\n            }\n\n            if ($db->fetchValue(\n                \"SELECT id FROM refunds\n                 WHERE cancel_request_id=:request_id AND status NOT IN ('failed','closed','cancelled','rejected')\n                 LIMIT 1 FOR UPDATE\",\n                ['request_id'=>$request['id']]\n            )) {\n                throw new OrderOperationException('本方案已经产生退款资金记录，不能恢复履约', 'REFUND_WITHDRAW_FINANCE_STARTED', 409);\n            }\n\n            $snapshot = json_decode((string)($request['order_state_snapshot_json'] ?? ''), true);\n            if (!is_array($snapshot)) $snapshot = [];\n            $restoreRefund = (string)($snapshot['refund_status'] ?? 'none');\n            if (!in_array($restoreRefund, ['', 'none','failed'], true)) $restoreRefund = 'none';\n            if ($restoreRefund === '') $restoreRefund = 'none';\n            $restorePublish = (string)($snapshot['publish_status'] ?? 'hidden');\n            if (!in_array($restorePublish, ['published','hidden'], true)) $restorePublish = 'hidden';\n\n            $hasMeasurementLink = (bool)$db->fetchValue(\n                \"SELECT 1 FROM order_relations\n                 WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1 FOR UPDATE\",\n                ['id'=>$order['id']]\n            );\n            $hasActiveDispute = !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                || (bool)$db->fetchValue(\n                    \"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\",\n                    ['id'=>$order['id']]\n                );\n            if ($hasMeasurementLink || $hasActiveDispute) $restorePublish = 'hidden';\n\n            $changed = $db->execute(\n                \"UPDATE order_cancel_requests\n                 SET status='cancelled',reason_code='bilateral_refund_withdrawn',closed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='pending' AND reason_code IN ('bilateral_refund_pending','bilateral_refund_rejected')\",\n                ['id'=>$request['id']]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('退款方案状态已变化，请刷新', 'REFUND_WITHDRAW_CHANGED', 409);\n            }\n            $db->execute(\n                \"UPDATE orders\n                 SET refund_status=:refund_status,publish_status=:publish_status,version=version+1,updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND lifecycle_status='active'\",\n                ['refund_status'=>$restoreRefund,'publish_status'=>$restorePublish,'id'=>$order['id']]\n            );\n            $this->event($db, $order, $actor, 'negotiation_responded', [\n                'kind'=>'refund','reference'=>$reference,'decision'=>'withdrawn','note'=>$note,\n                'message'=>'退款方案已由提出方撤回，订单恢复继续履约',\n            ]);\n            return ['reference'=>$reference,'status'=>'withdrawn','order_resumed'=>true];\n        });\n    }\n\n    public function escalate(array $actor, string $orderNo, string $kind, string $reference, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$kind,$reference,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if ((string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('订单已结束', 'ORDER_NOT_ACTIVE', 409);\n            if ($kind === 'dispute') return (new DatabaseOrderDisputeRepository($db))->escalate($actor, $reference, $note);\n            if ($kind === 'repair') return (new DatabaseOrderRepairInterventionRepository($db))->request($actor, $orderNo, $reference, $note);\n            if ($kind === 'refund') {\n                $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                if (!$request || (string)$request['status'] !== 'pending') throw new OrderOperationException('退款方案已经结束', 'REFUND_PROPOSAL_NOT_FOUND', 409);\n                $eligibility = NegotiationPolicy::evaluate(NegotiationPolicy::refundStatus((string)$request['reason_code']), $request['requested_at']);\n                $this->requireEligible($eligibility);\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_escalated',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n                $this->event($db, $order, $actor, 'cancel_requested', ['message'=>'双方退款协商未解决，已申请平台介入','reference'=>$reference,'note'=>$note,'notify_recipients'=>['user','worker','admin']]);\n            } else {\n                if ($kind === 'change') {\n                    $change = $db->fetch('SELECT * FROM change_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                    $latest = $db->fetchValue('SELECT public_id FROM change_requests WHERE order_id=:id ORDER BY id DESC LIMIT 1', ['id'=>$order['id']]);\n                    if (!$change || $latest !== $reference || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                        throw new OrderOperationException('加价事项已失效或被新方案替代', 'CHANGE_NOT_ACTIVE', 409);\n                    }\n                    $eligibility = NegotiationPolicy::evaluate((string)$change['status'], $change['submitted_at']);\n                } elseif ($kind === 'measurement') {\n                    $this->requireOwner($actor, $order);\n                    $state = $this->measurement($db, $order, $reference);\n                    $eligibility = NegotiationPolicy::evaluate($state['status'], $state['opened_at']);\n                } else throw new OrderOperationException('协商类型不支持升级', 'NEGOTIATION_INVALID', 422);\n                $this->requireEligible($eligibility);\n                if (!in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                    || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\", ['id'=>$order['id']])) {\n                    throw new OrderOperationException('本单已有争议正在处理中', 'DISPUTE_ALREADY_ACTIVE', 409);\n                }\n                $disputeNo = \\business_no('DSP');\n                $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n                $db->insert(\"INSERT INTO disputes(public_no,order_id,raised_by_type,raised_by_id,dispute_type,title,description,status,responsibility,opened_at,created_at,updated_at)\n                    VALUES(:no,:order,:type,:actor,:kind,:title,:description,'open','undetermined',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['no'=>$disputeNo,'order'=>$order['id'],'type'=>$type,'actor'=>$type === 'user' ? $actor['user_id'] : $actor['worker_id'],'kind'=>$kind === 'change' ? 'fee_negotiation' : 'measurement_rework',\n                     'title'=>$kind === 'change' ? '加价协商未解决，申请平台介入' : '补测未解决，申请平台介入','description'=>'关联事项 '.$reference.'；'.$note]);\n                $db->execute(\"UPDATE orders SET dispute_status='open',publish_status='hidden' WHERE id=:id\", ['id'=>$order['id']]);\n                $this->event($db, $order, $actor, 'dispute_opened', ['dispute_no'=>$disputeNo,'reference'=>$reference,'intervention_reason'=>$eligibility['reason'],'message'=>'双方协商未解决，已申请平台介入','notify_recipients'=>['user','worker']]);\n                OrderNotificationService::queueAdminTask($db, 'dispute:'.$disputeNo, 'completion_dispute_opened', '双方协商未解决，申请平台介入', ['订单号'=>$orderNo,'事项'=>$kind,'协商说明'=>$note]);\n            }\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'status'=>'escalated','intervention_reason'=>$eligibility['reason']];\n        });\n    }\n\n    private function refund(Database $db, int $orderId, string $reference): array\n    {\n        $row = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$orderId,'no'=>$reference]);\n        if (!$row || (string)$row['status'] !== 'pending' || (string)$row['reason_code'] !== 'bilateral_refund_pending') throw new OrderOperationException('退款方案已经响应或不在协商阶段', 'REFUND_PROPOSAL_NOT_PENDING', 409);\n        return $row;\n    }\n\n    private function requireCounterparty(array $actor, array $order, array $request): void\n    {\n        if ((string)$request['applicant_type'] === 'user') $this->requireWorker($actor, $order);\n        elseif ((string)$request['applicant_type'] === 'worker') $this->requireOwner($actor, $order);\n        else throw new OrderOperationException('该退款需平台处理', 'REFUND_PROPOSAL_NOT_ALLOWED', 409);\n    }\n\n    private function requireWorker(array $actor, array $order): void\n    {\n        if ((int)($actor['worker_id'] ?? 0) < 1 || (int)$order['assigned_worker_id'] !== (int)$actor['worker_id']) throw new OrderOperationException('只能由成交师傅响应', 'FORBIDDEN', 403);\n    }\n    private function requireOwner(array $actor, array $order): void\n    {\n        if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) throw new OrderOperationException('只能由订单客户申请', 'FORBIDDEN', 403);\n    }\n    private function requireEligible(array $eligibility): void\n    {\n        if (empty($eligibility['eligible'])) throw new OrderOperationException('请先协商；对方拒绝或满48小时未解决后才可申请平台介入', 'NEGOTIATION_WAIT_REQUIRED', 409, $eligibility);\n    }\n    private function measurement(Database $db, array $order, string $reference): array\n    {\n        $state = $db->fetch('SELECT result_status FROM order_measurement_states WHERE order_id=:id FOR UPDATE', ['id'=>$order['id']]);\n        $rework = $db->fetch(\"SELECT id,created_at FROM order_events WHERE order_id=:id AND event_type='measurement_rework_requested' ORDER BY id DESC LIMIT 1\", ['id'=>$order['id']]);\n        if (!$state || !$rework || (string)$rework['id'] !== $reference || (string)$state['result_status'] !== 'editing'\n            || !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)) throw new OrderOperationException('补测已提交或正在平台处理中', 'MEASUREMENT_REWORK_NOT_ACTIVE', 409);\n        $rejected = $db->fetchValue(\"SELECT id FROM order_events WHERE order_id=:id AND event_type='measurement_rework_rejected' AND id>:rework LIMIT 1\", ['id'=>$order['id'],'rework'=>$rework['id']]);\n        return ['status'=>$rejected ? 'rejected' : 'pending','opened_at'=>$rework['created_at']];\n    }\n    private function event(Database $db, array $order, array $actor, string $event, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n        }\n        $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n        if (FulfillmentActor::assisted($actor)) { $type='mini_admin'; $payload += FulfillmentActor::metadata($actor); }\n        $key = $event.':'.$order['id'].':'.bin2hex(random_bytes(6));\n        $payload += ['notify_recipients'=>$type==='mini_admin' ? ['user','worker'] : [$type === 'user' ? 'worker' : 'user']];\n        $db->insert('INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order,:event,:key,:type,:actor,:payload,UTC_TIMESTAMP())',\n            ['order'=>$order['id'],'event'=>$event,'key'=>$key,'type'=>$type,'actor'=>$type === 'user' ? $actor['user_id'] : $actor['worker_id'],'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        OrderNotificationService::queue($db, (int)$order['id'], $key, $event, $payload);\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseAdminRepairResolutionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\AdminRepairResolutionRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/**\n * 平台介入维修裁定。\n *\n * mini_admin 的 users.id 只写带类型的 order_events，不写 after_sales.handled_by；\n * web_admin 的 admin_users.id 与 handled_by 外键同域，可作为后台处理人落库。\n * 资金补偿/退款继续走退款与争议领域，不在本仓储混合处理。\n */\nfinal class DatabaseAdminRepairResolutionRepository implements AdminRepairResolutionRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function resolve(\n        array $operator,\n        string $orderNo,\n        string $afterSaleNo,\n        string $decision,\n        string $note\n    ): array {\n        $channel = trim((string)($operator['channel'] ?? ''));\n        $operatorUserId = (int)($operator['user_id'] ?? 0);\n        if (!in_array($channel, ['mini_admin','web_admin'], true) || $operatorUserId < 1) {\n            throw new OrderOperationException('管理员身份无效', 'ADMIN_REQUIRED', 403);\n        }\n        if (!in_array($decision, ['continue','resolved','closed'], true)) {\n            throw new OrderOperationException('平台售后处理动作无效', 'REPAIR_PLATFORM_DECISION_INVALID', 422);\n        }\n\n        return $this->db->transaction(function (Database $db) use ($channel,$operatorUserId,$orderNo,$afterSaleNo,$decision,$note): array {\n            $order = $db->fetch(\n                'SELECT id,public_no,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $afterSale = $db->fetch(\n                \"SELECT * FROM after_sales\n                 WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair'\n                 LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id'],'public_no'=>$afterSaleNo]\n            );\n            if (!$afterSale) {\n                throw new OrderOperationException('维修售后不存在', 'REPAIR_NOT_FOUND', 404);\n            }\n            if (!in_array((string)$afterSale['status'], ['open','processing'], true)) {\n                throw new OrderOperationException('该售后已结束，请刷新', 'REPAIR_PLATFORM_REVIEW_CHANGED', 409);\n            }\n\n            $currentResolution = (string)($afterSale['resolution'] ?? '');\n            $alreadyContinued = strpos($currentResolution, '平台介入：要求继续维修：') === 0;\n            $hasIntervention = strpos($currentResolution, '用户申请平台介入') === 0;\n            if (!$hasIntervention) {\n                $hasIntervention = (bool)$db->fetchValue(\n                    \"SELECT 1 FROM order_events\n                     WHERE order_id=:order_id AND event_type='repair_platform_intervention_requested'\n                       AND payload_json LIKE :needle\n                     ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                    [\n                        'order_id'=>$order['id'],\n                        'needle'=>'%\"after_sale_id\":\"'.$afterSaleNo.'\"%',\n                    ]\n                );\n            }\n            if (!$hasIntervention) {\n                throw new OrderOperationException(\n                    '请先由用户按规则申请平台介入',\n                    'REPAIR_PLATFORM_INTERVENTION_REQUIRED',\n                    409\n                );\n            }\n            if ($decision === 'continue' && $alreadyContinued) {\n                throw new OrderOperationException(\n                    '平台已要求继续维修，请等待处理后再确认解决或关闭售后',\n                    'REPAIR_PLATFORM_CONTINUE_ALREADY_REQUESTED',\n                    409\n                );\n            }\n\n            $status = 'processing';\n            $resolution = '平台介入：要求继续维修：'.$note;\n            $eventType = 'repair_platform_continue';\n            $message = '平台介入后要求师傅继续维修：'.$note;\n            $closeNow = 0;\n            if ($decision === 'resolved') {\n                $status = 'resolved';\n                $resolution = '平台裁定：问题已解决：'.$note;\n                $eventType = 'repair_platform_resolved';\n                $message = '平台已确认本次售后问题解决：'.$note;\n                $closeNow = 1;\n            } elseif ($decision === 'closed') {\n                $status = 'closed';\n                $resolution = '平台裁定：关闭售后：'.$note;\n                $eventType = 'repair_platform_closed';\n                $message = '平台已关闭本次售后：'.$note;\n                $closeNow = 1;\n            }\n\n            $handledBy = $channel === 'web_admin' ? $operatorUserId : 0;\n            $changed = $db->execute(\n                \"UPDATE after_sales\n                 SET status=:status,resolution=:resolution,\n                     handled_by=IF(:handled_by>0,:handled_by,handled_by),\n                     closed_at=IF(:close_now=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status IN ('open','processing')\",\n                [\n                    'status'=>$status,\n                    'resolution'=>$resolution,\n                    'handled_by'=>$handledBy,\n                    'close_now'=>$closeNow,\n                    'id'=>$afterSale['id'],\n                ]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('该售后状态已变化，请刷新', 'REPAIR_PLATFORM_REVIEW_CHANGED', 409);\n            }\n\n            if ($closeNow === 1) {\n                if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                    (new DatabaseChatRepairEpisodes($db,true))->close((int)$order['id'],(int)$afterSale['id']);\n                }\n                // 售后结束后，尚未处理的维修电话公开申请不再有业务上下文，直接关闭为 rejected。\n                $db->execute(\n                    \"UPDATE order_worker_contact_reveal_requests\n                     SET status='rejected',review_note='售后已由平台结案',reviewed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                     WHERE order_id=:order_id AND after_sale_id=:after_sale_id AND context_type='repair' AND status='pending'\",\n                    ['order_id'=>$order['id'],'after_sale_id'=>$afterSale['id']]\n                );\n            }\n\n            $db->execute(\n                'UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id',\n                ['id'=>$order['id']]\n            );\n\n            $actorType = $channel === 'web_admin' ? 'admin' : 'mini_admin';\n            $eventKey = $eventType.':'.$order['id'].':'.bin2hex(random_bytes(6));\n            $payload = [\n                'after_sale_id'=>$afterSaleNo,\n                'decision'=>$decision,\n                'note'=>$note,\n                'message'=>$message,\n                'operator_channel'=>$channel,\n                'operator_user_id'=>$channel === 'mini_admin' ? $operatorUserId : null,\n                'operator_admin_id'=>$channel === 'web_admin' ? $operatorUserId : null,\n                'notify_recipients'=>['user','worker'],\n            ];\n            $db->insert(\n                'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n                 VALUES(:order_id,:event_type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n                [\n                    'order_id'=>$order['id'],\n                    'event_type'=>$eventType,\n                    'event_key'=>$eventKey,\n                    'actor_type'=>$actorType,\n                    'actor_id'=>$operatorUserId,\n                    'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n                ]\n            );\n            OrderNotificationService::queue($db, (int)$order['id'], $eventKey, $eventType, $payload);\n\n            return [\n                'order_id'=>(string)$order['public_no'],\n                'after_sale_id'=>$afterSaleNo,\n                'status'=>$status,\n                'decision'=>$decision,\n                'order_version'=>(int)$order['version'] + 1,\n            ];\n        });\n    }\n}\n","server/app/Services/MessageEventCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nrequire_once __DIR__.'/../Domain/Messaging/MessageEventCatalog.php';\n\nfinal class MessageEventCatalog\n{\n\n    public static function all(): array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::all(); }\n    public static function get(string $eventType): ?array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::get($eventType); }\n    public static function switches(string $channel, array $configured): array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::switches($channel,$configured); }\n    public static function enabled(string $channel, string $eventType, array $configured): bool { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::enabled($channel,$eventType,$configured); }\n}\n","server/app/Infrastructure/Messaging/DatabaseNotificationProducer.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\NotificationProducer;\n\nfinal class DatabaseNotificationProducer implements NotificationProducer\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db=$db; }\n    public function queue(int $orderId,string $key,string $type,array $payload=[]):void { OrderNotificationProjector::queue($this->db,$orderId,$key,$type,$payload); }\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void { OrderNotificationProjector::queueAdminTask($this->db,$key,$type,$title,$lines); }\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void { OrderNotificationProjector::queueWorkerWithdrawalResult($this->db,$workerId,$no,$status,$note,$amount); }\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void { OrderNotificationProjector::queueWorkerReviewResult($this->db,$workerId,$cloudId,$decision,$reason,$name); }\n}\n","server/app/Contracts/OrderQuoteSwitchRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderQuoteSwitchRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array{message:string,data:array<string,mixed>}\n     */\n    public function switchWorker(array $actor, string $orderPublicNo, string $quotePublicId, string $reason): array;\n}\n","server/app/Application/Messaging/MessageEventSwitches.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\n\nfinal class MessageEventSwitches\n{\n    private SettingsProvider $settings;\n    public function __construct(SettingsProvider $settings) { $this->settings=$settings; }\n    public function forChannel(string $channel):array\n    {\n        $key=$channel==='wecom'?'wecom.event_switches':($channel==='inapp'?'notification.internal_event_switches':'sms.event_switches');\n        $configured=$this->settings->get($key,[]);return MessageEventCatalog::switches($channel,is_array($configured)?$configured:[]);\n    }\n}\n","server/app/Application/Messaging/OrderNotificationPublisher.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse InvalidArgumentException;\nuse WorkerAdmin\\Contracts\\NotificationProducer;\nuse WorkerAdmin\\Contracts\\OrderNotificationPort;\n\nfinal class OrderNotificationPublisher implements OrderNotificationPort\n{\n    private NotificationProducer $producer;\n    public function __construct(NotificationProducer $producer) { $this->producer=$producer; }\n    public function queue(int $orderId,string $idempotencyKey,string $eventType,array $payload=[]):void { $this->producer->queue($orderId,$idempotencyKey,$eventType,$payload); }\n    public function queuePersistedEvent(int $orderId,int $eventId,string $type,array $payload=[]):void\n    { if($eventId<1)throw new InvalidArgumentException('通知必须关联已落库的订单事件');$this->queue($orderId,'order-event:'.$eventId,$type,$payload); }\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void { $this->producer->adminTask($key,$type,$title,$lines); }\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void { $this->producer->withdrawalResult($workerId,$no,$status,$note,$amount); }\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void { $this->producer->workerReviewResult($workerId,$cloudId,$decision,$reason,$name); }\n}\n","server/app/Application/Messaging/SubscriptionTestData.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\n\nfinal class SubscriptionTestData\n{\n    private SettingsProvider $settings;\n    public function __construct(SettingsProvider $settings) { $this->settings=$settings; }\n    public function subscriptionTestEventOptions(string $sceneKey):array\n    {\n        $options=[];\n        foreach(MessageEventCatalog::all() as $eventType=>$meta){\n            if(!is_array($meta)||(string)($meta['subscription_scene']??'')!==$sceneKey)continue;\n            $status=trim((string)($meta['status']??''));if($status==='')continue;\n            $label=trim((string)($meta['label']??''));if($label==='')$label=$status;\n            $options[(string)$eventType]=['label'=>$label,'status'=>$status];\n        }\n        return $options;\n    }\n\n    public function subscriptionTestSampleValues(string $sceneKey):array\n    {\n        $eventOptions= $this->subscriptionTestEventOptions($sceneKey);$first=$eventOptions?(array)reset($eventOptions):[];\n        $platformName=trim((string)$this->settings->get('site.name','壁选'));if($platformName==='')$platformName='壁选';\n        return [\n            'order_no'=>'TEST'.date('YmdHis'),\n            'status'=>(string)($first['status']??'测试通知'),\n            'time'=>date('Y-m-d H:i'),\n            'amount'=>'128.00',\n            'quote_party'=>'张师傅',\n            'platform_name'=>$platformName,\n            'merchant_name'=>'示例家居门店',\n            'worker_name'=>'张师傅',\n            'service_category'=>'墙布施工',\n            'order_title'=>'客厅墙布施工',\n            'service_address'=>'杭州市西湖区示例路',\n            'requirement_note'=>'墙面需先检查基层',\n            'audit_note'=>'资料齐全，审核通过',\n            'expected_visit_time'=>date('Y-m-d H:i',time()+86400),\n            'contact_name'=>'张**',\n            'appointment_time'=>date('Y-m-d H:i',time()+86400),\n            'appointment_note'=>'上门前请电话联系',\n        ];\n    }\n\n    public function buildSubscriptionTestData(string $sceneKey,array $scene,array $input=[]):array\n    {\n        if($sceneKey==='reviewResult'){\n            return [\n                'name1'=>['value'=>'测试师傅'],\n                'phone_number2'=>['value'=>'13800000000'],\n                'phrase3'=>['value'=>'测试通知'],\n                'thing5'=>['value'=>'后台订阅消息链路测试'],\n            ];\n        }\n        $fieldMap=is_array($scene['field_map']??null)?$scene['field_map']:[];\n        if(!$fieldMap)throw new \\RuntimeException('该订阅场景尚未配置字段映射，不能发送测试。');\n        $samples= $this->subscriptionTestSampleValues($sceneKey);\n        $eventOptions= $this->subscriptionTestEventOptions($sceneKey);\n        $eventPost=is_array($input['test_event_type']??null)?$input['test_event_type']:[];\n        $eventType=trim((string)($eventPost[$sceneKey]??''));\n        if($eventType!==''&&isset($eventOptions[$eventType]))$samples['status']=(string)$eventOptions[$eventType]['status'];\n        $valuesPost=is_array($input['test_values']??null)?($input['test_values'][$sceneKey]??[]):[];\n        if(is_array($valuesPost)){\n            foreach($valuesPost as $semantic=>$value){\n                $semantic=(string)$semantic;if(!array_key_exists($semantic,$samples)||is_array($value))continue;\n                // 有真实业务节点可选时，状态必须来自事件目录，避免“测试成功但生产不存在这种状态”。\n                if($semantic==='status'&&$eventOptions)continue;\n                $value=mb_substr(trim((string)$value),0,500);if($value!=='')$samples[$semantic]=$value;\n            }\n        }\n        $data=[];\n        foreach($fieldMap as $semantic=>$wechatKey){\n            $semantic=(string)$semantic;$wechatKey=trim((string)$wechatKey);\n            if($wechatKey===''||!array_key_exists($semantic,$samples))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,(string)$samples[$semantic]);\n            if($formatted===null||$formatted==='')throw new \\RuntimeException('测试字段 '.$semantic.' → '.$wechatKey.' 无法生成合法示例值，请检查字段映射或测试值。');\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $wechatKey=>$fixedValue){\n            $wechatKey=trim((string)$wechatKey);$fixedValue=trim((string)$fixedValue);\n            if($wechatKey===''||$fixedValue===''||isset($data[$wechatKey]))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,$fixedValue);\n            if($formatted===null||$formatted==='')throw new \\RuntimeException('固定字段 '.$wechatKey.' 无法生成合法测试值，请检查高级设置。');\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['template_fields']??[]) as $templateField)if(!isset($data[$templateField]))throw new \\RuntimeException('模板字段 '.$templateField.' 尚未配置数据来源，不能测试发送。');\n        if(!$data)throw new \\RuntimeException('没有可用于测试发送的模板字段。');\n        return $data;\n    }\n}\n","server/app/Infrastructure/Messaging/OrderSubscriptionQueue.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\OrderMessageDefinition;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\n\nfinal class OrderSubscriptionQueue\n{\n\n    public static function subscriptionBusinessValues(Database $db,int $orderId,string $eventType,array $definition,array $parameters):array\n    {\n        $row=$db->fetch(\"SELECT o.public_no,o.order_source_type,o.merchant_profile_id,o.category_name_snapshot,o.category_names_snapshot,o.title,o.description,o.audit_note,o.expected_visit_at,o.city,o.district,o.address_summary,o.assigned_worker_id,mp.business_name merchant_business_name,oa.address_summary address_snapshot,oa.contact_name_masked,wp.display_name worker_name FROM orders o LEFT JOIN merchant_profiles mp ON mp.id=o.merchant_profile_id LEFT JOIN order_addresses oa ON oa.order_id=o.id LEFT JOIN worker_profiles wp ON wp.id=o.assigned_worker_id WHERE o.id=:id LIMIT 1\",['id'=>$orderId]);\n        if(!$row)$row=[];\n        $appointment=$db->fetch(\"SELECT appointment_at,note,wait_customer_notice FROM appointment_records WHERE order_id=:id AND context_type='service' ORDER BY id DESC LIMIT 1\",['id'=>$orderId]);\n        if(!$appointment)$appointment=[];\n        $platformName=trim((string)\\setting('site.name','壁选'));\n        if($platformName==='')$platformName='壁选';\n        $serviceCategory=trim((string)($row['category_names_snapshot']??''));\n        if($serviceCategory===''||$serviceCategory==='不确定类目')$serviceCategory=trim((string)($row['category_name_snapshot']??''));\n        if($serviceCategory==='')$serviceCategory='施工服务';\n        $orderTitle=trim((string)($row['title']??''));if($orderTitle==='')$orderTitle=$serviceCategory;\n        $address=trim((string)($row['address_snapshot']??''));if($address==='')$address=trim((string)($row['address_summary']??''));\n        if($address==='')$address=trim((string)(($row['city']??'').($row['district']??'')));if($address==='')$address='请查看订单详情';\n        $merchantName=trim((string)($row['merchant_business_name']??''));if($merchantName==='')$merchantName=((string)($row['order_source_type']??'consumer')==='merchant'?'商家订单':'个人订单');\n        $workerName=trim((string)($row['worker_name']??''));if($workerName==='')$workerName='待安排师傅';\n        $requirement=trim((string)($row['description']??''));if($requirement==='')$requirement='无特殊要求';\n        $auditNote=trim((string)($row['audit_note']??''));if($auditNote==='')$auditNote='请查看订单详情';\n        $expectedVisit=trim((string)($row['expected_visit_at']??''));if($expectedVisit==='')$expectedVisit=(string)($parameters['time']??date('Y-m-d H:i'));\n        $appointmentTime=trim((string)($appointment['appointment_at']??''));if($appointmentTime==='')$appointmentTime=$expectedVisit;\n        $appointmentNote=trim((string)($appointment['note']??''));\n        if($appointmentNote==='')$appointmentNote=!empty($appointment['wait_customer_notice'])?'等待客户另行通知':'请查看订单详情';\n        $quoteParty=$eventType==='platform_quoted'?$platformName:($workerName==='待安排师傅'?'师傅报价':$workerName);\n        return [\n            'order_no'=>(string)($parameters['order_no']??($row['public_no']??'')),\n            'status'=>(string)($definition['status']??($parameters['status']??'')),\n            'time'=>(string)($parameters['time']??date('Y-m-d H:i')),\n            'amount'=>(string)($parameters['amount']??'0.00').'元',\n            'quote_party'=>$quoteParty,\n            'platform_name'=>$platformName,\n            'merchant_name'=>$merchantName,\n            'worker_name'=>$workerName,\n            'service_category'=>$serviceCategory,\n            'order_title'=>$orderTitle,\n            'service_address'=>$address,\n            'requirement_note'=>$requirement,\n            'audit_note'=>$auditNote,\n            'expected_visit_time'=>$expectedVisit,\n            'contact_name'=>trim((string)($row['contact_name_masked']??''))?:'订单联系人',\n            'appointment_time'=>$appointmentTime,\n            'appointment_note'=>$appointmentNote,\n        ];\n    }\n\n    public static function queueOrderSubscription(Database $db, int $orderId, string $eventKey, string $eventType, array $definition, array $order, array $parameters, array $smsFallback=[], string $sceneOverride=''): array\n    {\n        $sceneKey=$sceneOverride!==''?$sceneOverride:self::subscriptionSceneForEvent($eventType);if($sceneKey==='')return ['queued'=>false,'reason'=>'scene_missing'];\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes[$sceneKey]??null;\n        if(!$scene)return ['queued'=>false,'reason'=>'scene_missing'];\n        if(empty($scene['available'])||empty($scene['field_map']))return ['queued'=>false,'reason'=>(string)($scene['availability_reason']??'scene_unavailable')];\n        $recipient=(string)($scene['recipient']??'user');\n        if(!in_array($recipient,(array)($definition['recipients']??[]),true))return ['queued'=>false,'reason'=>'recipient_mismatch'];\n        $workerProfile=null;\n        if($recipient==='worker'){\n            if(empty($order['assigned_worker_id']))return ['queued'=>false,'reason'=>'worker_missing'];\n            $workerProfile=$db->fetch('SELECT user_id FROM worker_profiles WHERE id=:id LIMIT 1',['id'=>(int)$order['assigned_worker_id']]);\n            if(!$workerProfile)return ['queued'=>false,'reason'=>'worker_missing'];\n        }\n        $userId=$recipient==='worker'?(int)$workerProfile['user_id']:(int)$order['user_id'];\n        $pref=SubscriptionQuotaStore::subscriptionPreferences($db,$userId)[$sceneKey]??[];\n        $authorizationStatus=(string)($pref['authorization_status']??'');\n        $subscriptionType=(string)($scene['subscription_type']??'one_time');\n        if($subscriptionType==='one_time'){\n            if(in_array($authorizationStatus,['ban','disabled'],true))return ['queued'=>false,'reason'=>$authorizationStatus];\n            if(max(0,(int)($pref['remaining_count']??0))<1)return ['queued'=>false,'reason'=>'count_exhausted'];\n        }else{\n            if(empty($pref['enabled'])||!in_array($authorizationStatus,['accept','acceptWithAudio','acceptWithAlert'],true))return ['queued'=>false,'reason'=>'not_authorized'];\n        }\n        $openid=(string)$db->fetchValue(\"SELECT openid FROM wechat_identities WHERE user_id=:id AND status='active' ORDER BY id DESC LIMIT 1\",['id'=>$userId]);\n        if($openid==='')return ['queued'=>false,'reason'=>'openid_missing'];\n        $values=self::subscriptionBusinessValues($db,$orderId,$eventType,$definition,$parameters);\n        $data=[];\n        foreach((array)$scene['field_map'] as $semantic=>$wechatKey){\n            $wechatKey=trim((string)$wechatKey);\n            if(!isset($values[$semantic])||preg_match('/^[A-Za-z_]+\\d+$/',$wechatKey)!==1)continue;\n            $formatted=WechatTemplateValue::format($wechatKey,(string)$values[$semantic]);\n            if($formatted===null||$formatted==='')return ['queued'=>false,'reason'=>'template_data_invalid'];\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $wechatKey=>$fixedValue){\n            $wechatKey=trim((string)$wechatKey);$fixedValue=trim((string)$fixedValue);\n            if($wechatKey===''||$fixedValue===''||isset($data[$wechatKey]))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,$fixedValue);\n            if($formatted===null||$formatted==='')return ['queued'=>false,'reason'=>'template_data_invalid'];\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['template_fields']??[]) as $templateField)if(!isset($data[$templateField]))return ['queued'=>false,'reason'=>'template_data_missing'];\n        if(!$data)return ['queued'=>false,'reason'=>'template_data_missing'];\n        $page=$recipient==='worker'?'pages/workerOrder/detail?id=':'pages/userOrder/detail?id=';\n        self::enqueueWechatSubscribe($db,$eventKey.':'.$recipient.':wxsub',$userId,$sceneKey,$openid,(string)$scene['template_id'],$page.rawurlencode((string)$order['public_no']),$data,$smsFallback);\n        return ['queued'=>true,'reason'=>'queued'];\n    }\n\n    public static function queueWorkerOrderUpdateSupplement(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,bool $fallbackMode=false):void\n    {\n        if(!in_array('worker',(array)($definition['recipients']??[]),true)||empty($order['assigned_worker_id']))return;\n        $primaryKey=self::subscriptionSceneForEvent($eventType);\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();\n        $primary=$primaryKey!==''?($scenes[$primaryKey]??null):null;\n        if(is_array($primary)&&(string)($primary['recipient']??'user')==='worker')return;\n        $meta=MessageEventCatalog::get($eventType)??[];\n        $important=((string)($meta['priority']??'normal')==='important')||$eventType==='worker_assigned';\n        if(!$important)return;\n        $workerFallback=$fallbackMode\n            ? self::buildSubscriptionFallbackSmsPayload($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,'worker')\n            : null;\n        $result=self::queueOrderSubscription(\n            $db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,\n            is_array($workerFallback)?$workerFallback:[],\n            'worker_order_update'\n        );\n        if($fallbackMode&&empty($result['queued'])&&is_array($workerFallback)){\n            $workerFallback['fallback_reason']=(string)($result['reason']??'worker_subscription_unavailable');\n            self::enqueueSmsFallback($db,$workerFallback);\n        }\n    }\n\n    public static function subscriptionSceneForEvent(string $eventType): string\n    {\n        $meta = MessageEventCatalog::get($eventType);\n        return $meta ? (string)($meta['subscription_scene'] ?? '') : '';\n    }\n\n    public static function enqueueWechatSubscribe(Database $db,string $businessKey,int $userId,string $sceneKey,string $openid,string $templateId,string $page,array $data,array $smsFallback=[]):void\n    {\n        $payload=['user_id'=>$userId,'scene_key'=>$sceneKey,'openid'=>$openid,'template_id'=>$templateId,'page'=>$page,'data'=>$data];\n        if($smsFallback)$payload['sms_fallback']=$smsFallback;\n        $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wechat_subscribe',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($businessKey,0,128),'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n    }\n\n    public static function buildSubscriptionFallbackSmsPayload(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,string $recipientOverride=''):?array\n    {\n        $meta=MessageEventCatalog::get($eventType);\n        if(!$meta||empty($meta['sms_subscription_fallback']))return null;\n        $sceneKey=(string)($meta['subscription_scene']??'');if($sceneKey==='')return null;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes[$sceneKey]??null;if(!$scene)return null;\n        $recipient=in_array($recipientOverride,['user','worker'],true)?$recipientOverride:(string)($scene['recipient']??'user');\n        if(!in_array($recipient,(array)($definition['recipients']??[]),true))return null;\n        $recipientId=0;$mobile='';\n        if($recipient==='user'){\n            $recipientId=(int)$order['user_id'];\n            $mobile=\\decrypt_private_value((string)$order['user_mobile'],'user-mobile');\n        }elseif($recipient==='worker'&&!empty($order['assigned_worker_id'])){\n            $recipientId=(int)$order['assigned_worker_id'];\n            $row=$db->fetch('SELECT mobile_ciphertext FROM worker_profiles WHERE id=:id LIMIT 1',['id'=>$recipientId]);\n            $mobile=$row?\\decrypt_private_value((string)$row['mobile_ciphertext'],'worker-mobile'):'';\n        }\n        if($recipientId<1||$mobile==='')return null;\n        return [\n            'business_key'=>substr($eventKey.':'.$recipient.':'.$recipientId.':sms-fallback',0,128),\n            'mobile'=>$mobile,\n            'sms_scene'=>(string)$definition['scene'],\n            'parameters'=>$parameters,\n            'event_type'=>$eventType,\n            'order_id'=>$orderId,\n            'recipient_type'=>$recipient,\n            'recipient_id'=>$recipientId,\n            'delivery_mode'=>'subscription_fallback',\n        ];\n    }\n\n    public static function enqueueSmsFallback(Database $db,array $fallback):bool\n    {\n        $eventType=trim((string)($fallback['event_type']??''));\n        if($eventType===''||!\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)||!self::eventEnabled('sms.event_switches',$eventType))return false;\n        $meta=MessageEventCatalog::get($eventType);\n        if(!$meta||empty($meta['sms_subscription_fallback']))return false;\n        $smsScene=trim((string)($fallback['sms_scene']??''));if($smsScene==='')return false;\n        $templates=\\setting('sms.template_codes',[]);if(!is_array($templates))return false;\n        $configured=$templates[$smsScene]??'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        $mobile=trim((string)($fallback['mobile']??''));\n        $businessKey=trim((string)($fallback['business_key']??''));\n        if($templateCode===''||$mobile===''||$businessKey==='')return false;\n        $payload=[\n            'mobile'=>$mobile,\n            'template_code'=>$templateCode,\n            'parameters'=>is_array($fallback['parameters']??null)?$fallback['parameters']:[],\n            'event_type'=>$eventType,\n            'order_id'=>(int)($fallback['order_id']??0),\n            'recipient_type'=>(string)($fallback['recipient_type']??'user'),\n            'recipient_id'=>(int)($fallback['recipient_id']??0),\n            'delivery_mode'=>'subscription_fallback',\n            'fallback_reason'=>(string)($fallback['fallback_reason']??'wechat_unavailable'),\n        ];\n        $businessKey=substr($businessKey,0,128);\n        $affected=$db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('aliyun_sms',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n            'business_key'=>$businessKey,\n            'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n        ]);\n        if($affected===1)return true;\n        return (bool)$db->fetchValue(\"SELECT id FROM message_outbox WHERE topic='aliyun_sms' AND BINARY business_key=BINARY :business_key LIMIT 1\",['business_key'=>$businessKey]);\n    }\n\n    public static function eventEnabled(string $settingKey, string $eventType): bool\n    {\n        $channel = strpos($settingKey, 'wecom.') === 0 ? 'wecom' : (strpos($settingKey, 'notification.') === 0 ? 'inapp' : 'sms');\n        $configured = \\setting($settingKey, []);\n        return MessageEventCatalog::enabled($channel, $eventType, is_array($configured) ? $configured : []);\n    }\n}\n","server/app/Infrastructure/Settings/GlobalSettingsProvider.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Settings;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\n\n/**\n * 兼容现有 setting() 的基础设施适配器。\n */\nfinal class GlobalSettingsProvider implements SettingsProvider\n{\n    public function get(string $key, $default = null)\n    {\n        return \\setting($key, $default);\n    }\n\n    public function bool(string $key, bool $default = false): bool\n    {\n        $value = $this->get($key, $default);\n        if (is_bool($value)) {\n            return $value;\n        }\n        $filtered = filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE);\n        return $filtered === null ? $default : $filtered;\n    }\n\n    public function int(string $key, int $default = 0): int\n    {\n        $value = $this->get($key, $default);\n        return is_numeric($value) ? (int) $value : $default;\n    }\n}\n","server/app/Infrastructure/Persistence/PlatformOrderSettlementWriter.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\PlatformOrderSettlementPolicy;\n\n/**\n * 平台单验收的资金侧事务步骤。调用者必须已锁定 orders、order_platform_terms、assignments，\n * 并处于同一个事务；本类不单独提交事务、不生成虚假的客户支付记录。\n * 普通客户订单（包括后台代下单）不调用该类，也绝不创建普通订单服务费。\n */\nfinal class PlatformOrderSettlementWriter\n{\n    private PlatformOrderSettlementPolicy $policy;\n    private PlatformOrderBookingPaymentVerifier $bookingVerifier;\n\n    public function __construct()\n    {\n        $this->policy = new PlatformOrderSettlementPolicy();\n        $this->bookingVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    /**\n     * @param array<string,mixed> $order\n     * @param array<string,mixed> $terms\n     * @param array<string,mixed> $assignment\n     * @return array<string,int|string>\n     */\n    public function apply(Database $db, array $order, array $terms, array $assignment): array\n    {\n        $orderId = (int)($order['id'] ?? 0);\n        $workerId = (int)($order['assigned_worker_id'] ?? 0);\n        if ($orderId < 1 || (string)($order['order_source_type'] ?? '') !== 'platform'\n            || (int)($terms['order_id'] ?? 0) !== $orderId\n            || (string)($terms['customer_flow_mode'] ?? '') !== 'platform_managed'\n            || (int)($assignment['worker_id'] ?? 0) !== $workerId\n            || $workerId < 1\n            || (string)($assignment['status'] ?? '') !== 'accepted'\n            || (string)($terms['settlement_status'] ?? '') !== 'pending') {\n            throw new OrderOperationException('平台单结算关系或状态已变化，请刷新后重试', 'PLATFORM_SETTLEMENT_STATE_CHANGED', 409);\n        }\n        // 师傅现场收款凭证是客户向师傅付款的证据，不等同于师傅已向平台付清收入款。\n        $receiptCount = (int)$db->fetchValue(\n            \"SELECT COUNT(*) FROM media_links ml JOIN media_files mf ON mf.id=ml.media_file_id AND mf.status='active'\n             WHERE ml.entity_type='order' AND ml.entity_id=:order_id AND ml.purpose='collection_receipt'\",\n            ['order_id'=>$orderId]\n        );\n        if ($receiptCount < 1) {\n            throw new OrderOperationException('师傅尚未上传客户现场收款凭证，当前不能验收', 'COLLECTION_RECEIPT_REQUIRED', 409);\n        }\n\n        // booking_paid_cents 对平台单表示“外部渠道已实际收取的客户预付款”。\n        // orders.booking_fee_cents 属于普通订单微信预约费口径，平台单不得再读取或抵扣它。\n        $bookingPaid = $this->bookingVerifier->verifiedPaidCents(\n            $db,\n            $orderId,\n            (int)$terms['customer_contract_total_cents'],\n            (int)($terms['booking_paid_cents'] ?? 0),\n            'platform_managed'\n        );\n        $calculation = $this->policy->settlement(\n            (int)$terms['customer_contract_total_cents'],\n            (int)$terms['worker_labor_cents'],\n            $bookingPaid,\n            (string)$terms['worker_settlement_mode']\n        );\n        $platformReceivable = (int)$calculation['platform_receivable_cents'];\n        $workerCredit = (int)$calculation['worker_balance_credit_cents'];\n        $freezeDays = max(0, (int)$terms['worker_balance_freeze_days_snapshot']);\n        $status = $platformReceivable > 0 ? 'awaiting_platform_income' : 'settled';\n\n        $changed = $db->execute(\n            \"UPDATE order_platform_terms SET booking_paid_cents=:booking,customer_tail_cents=:tail,\n                    platform_receivable_cents=:platform_income,worker_balance_credit_cents=:worker_credit,\n                    settlement_status=:status,settled_at=IF(:settled_status='settled',UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n             WHERE order_id=:order_id AND settlement_status='pending' AND customer_flow_mode='platform_managed'\",\n            [\n                'booking'=>$calculation['booking_paid_cents'],\n                'tail'=>$calculation['customer_tail_cents'],\n                'platform_income'=>$platformReceivable,'worker_credit'=>$workerCredit,\n                'status'=>$status,'settled_status'=>$status,'order_id'=>$orderId,\n            ]\n        );\n        if ($changed !== 1) {\n            throw new OrderOperationException('平台结算已被处理，请刷新后重试', 'PLATFORM_SETTLEMENT_ALREADY_POSTED', 409);\n        }\n        $assignmentChanged = $db->execute(\n            \"UPDATE assignments SET status='completed',\n                    estimated_commission_cents=0,estimated_net_income_cents=:labor,updated_at=UTC_TIMESTAMP()\n             WHERE id=:id AND worker_id=:worker_id AND status='accepted'\",\n            ['labor'=>$terms['worker_labor_cents'],'id'=>$assignment['id'],'worker_id'=>$workerId]\n        );\n        if ($assignmentChanged !== 1) {\n            throw new OrderOperationException('成交师傅关系已变化，请刷新后重试', 'PLATFORM_ASSIGNMENT_CHANGED', 409);\n        }\n        if ($workerCredit > 0) {\n            $entry = $this->policy->workerBalanceEntry($workerCredit, $freezeDays);\n            $idempotencyKey = 'platform-order:'.$orderId.':worker-income';\n            $existing = $db->fetch(\n                'SELECT id FROM worker_balance_ledger WHERE idempotency_key=:key LIMIT 1 FOR UPDATE',\n                ['key'=>$idempotencyKey]\n            );\n            if ($existing) {\n                throw new OrderOperationException('师傅工费入账记录已存在，请先核对，禁止重复入账', 'PLATFORM_WORKER_CREDIT_ALREADY_POSTED', 409);\n            }\n            $inserted = $db->execute(\n                \"INSERT INTO worker_balance_ledger(worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                        business_type,business_id,idempotency_key,description,status,created_at)\n                 VALUES(:worker_id,:entry_type,'credit',:amount,:available,:frozen,'platform_order',:business_id,:key,:description,'effective',UTC_TIMESTAMP())\",\n                [\n                    'worker_id'=>$workerId,'entry_type'=>$entry['entry_type'],'amount'=>$workerCredit,\n                    'available'=>$entry['available_delta_cents'],'frozen'=>$entry['frozen_delta_cents'],\n                    'business_id'=>$orderId,'key'=>$idempotencyKey,\n                    'description'=>$freezeDays === 0 ? '平台承接单工费结算进入可提现余额' : '平台承接单工费进入冻结余额',\n                ]\n            );\n            if ($inserted !== 1) {\n                throw new OrderOperationException('师傅余额入账失败，验收已自动回滚', 'PLATFORM_WORKER_CREDIT_FAILED', 409);\n            }\n        }\n        return $calculation + [\n            'settlement_status'=>$status,\n            'worker_settlement_mode'=>(string)$terms['worker_settlement_mode'],\n            'freeze_days'=>$freezeDays,\n        ];\n    }\n}","server/app/Infrastructure/Scheduling/PlatformOrderAutoPublishTask.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Scheduling;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\OrderFormMediaRules;\nuse WorkerAdmin\\Infrastructure\\Persistence\\PlatformOrderBookingPaymentVerifier;\n\n/** V2.5.0 平台承接单自动发布。 */\nfinal class PlatformOrderAutoPublishTask\n{\n    private const JOB = 'platform_auto_publish';\n\n    private Database $db;\n    private int $limit;\n    private PlatformOrderBookingPaymentVerifier $prepaymentVerifier;\n\n    public function __construct(Database $db, int $limit = 100)\n    {\n        $this->db = $db;\n        $this->limit = max(1, min(500, $limit));\n        $this->prepaymentVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    public function run(): array\n    {\n        $runUuid = $this->uuidV4();\n        $runId = $this->db->insert(\n            \"INSERT INTO scheduler_runs(run_uuid,job_name,status,host_name,process_id,scanned_count,success_count,failure_count,started_at)\n             VALUES(:uuid,:job,'running',:host,:pid,0,0,0,UTC_TIMESTAMP())\",\n            ['uuid'=>$runUuid,'job'=>self::JOB,'host'=>substr((string)gethostname(),0,128),'pid'=>function_exists('getmypid')?(int)getmypid():null]\n        );\n        $startedAt = microtime(true);\n        $stats = ['scanned'=>0,'success'=>0,'failure'=>0];\n        $error = null;\n\n        try {\n            $cursorUpdatedAt = null;\n            $cursorId = 0;\n            do {\n                $cursorSql = '';\n                $params = [];\n                if ($cursorUpdatedAt !== null) {\n                    $cursorSql = ' AND (o.updated_at>:cursor_updated OR (o.updated_at=:cursor_updated_eq AND o.id>:cursor_id))';\n                    $params = ['cursor_updated'=>$cursorUpdatedAt,'cursor_updated_eq'=>$cursorUpdatedAt,'cursor_id'=>$cursorId];\n                }\n                $rows = $this->db->fetchAll(\n                    \"SELECT o.id,o.version,o.updated_at\n                     FROM orders o\n                     INNER JOIN order_platform_terms t ON t.order_id=o.id\n                     WHERE o.order_source_type='platform'\n                       AND t.customer_flow_mode='platform_managed'\n                       AND t.settlement_status='pending'\n                       AND t.customer_contract_total_cents>0\n                       AND t.booking_paid_cents<=t.customer_contract_total_cents\n                       AND o.booking_fee_cents=0\n                       AND COALESCE(o.is_demo,0)=0\n                       AND o.lifecycle_status='active'\n                       AND o.publish_status<>'published'\n                       AND o.audit_status IN ('pending','approved')\n                       AND COALESCE(o.refund_status,'none') IN ('','none')\n                       AND o.selected_quote_id IS NULL\n                       AND o.assigned_worker_id IS NULL\n                       AND o.current_assignment_id IS NULL\n                       AND o.quote_status IN ('waiting','quoting','collecting')\n                       AND NOT EXISTS(\n                           SELECT 1 FROM payment_orders p\n                           WHERE p.order_id=o.id AND p.business_type IN ('order_booking','booking_fee') AND p.status='paid'\n                       )\n                       AND NOT EXISTS(\n                           SELECT 1 FROM scheduled_job_failures f\n                           WHERE f.job_name='platform_auto_publish'\n                             AND f.business_key=CONCAT('order:',o.id)\n                             AND f.business_version=o.version\n                             AND f.resolved_at IS NULL\n                             AND f.next_retry_at>UTC_TIMESTAMP()\n                       )\n                       {$cursorSql}\n                     ORDER BY o.updated_at,o.id\n                     LIMIT {$this->limit}\",\n                    $params\n                );\n                if (!$rows) break;\n                $stats['scanned'] += count($rows);\n                foreach ($rows as $row) {\n                    $orderId = (int)$row['id'];\n                    $version = max(1,(int)$row['version']);\n                    try {\n                        if ($this->publishOne($orderId)) $stats['success']++;\n                    } catch (Throwable $exception) {\n                        $stats['failure']++;\n                        $this->recordFailure($runId,$orderId,$version,$exception);\n                    }\n                }\n                $last = $rows[count($rows)-1];\n                $cursorUpdatedAt = (string)$last['updated_at'];\n                $cursorId = (int)$last['id'];\n            } while (count($rows) === $this->limit);\n        } catch (Throwable $exception) {\n            $stats['failure']++;\n            $error = mb_substr($exception->getMessage(),0,4000);\n            $this->recordFailure($runId,0,1,$exception,'task:'.self::JOB);\n        }\n\n        if ($error === null && $stats['failure'] > 0) $error = '本批次有 '.$stats['failure'].' 笔平台承接单自动发布失败，请查看异常工作台。';\n        $status = $stats['failure'] > 0 ? 'failed' : 'success';\n        $this->db->execute(\n            \"UPDATE scheduler_runs SET status=:status,scanned_count=:scanned,success_count=:success,failure_count=:failure,finished_at=UTC_TIMESTAMP(),error_message=:error WHERE id=:id\",\n            ['status'=>$status,'scanned'=>$stats['scanned'],'success'=>$stats['success'],'failure'=>$stats['failure'],'error'=>$error,'id'=>$runId]\n        );\n        if ($status === 'success') {\n            $this->db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP() WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",['job'=>self::JOB,'key'=>'task:'.self::JOB]);\n        }\n        if ($stats['success'] === 0 && $stats['failure'] === 0) {\n            $this->db->execute(\"DELETE FROM scheduler_runs WHERE job_name=:job AND id<>:id AND status='success' AND success_count=0 AND failure_count=0\",['job'=>self::JOB,'id'=>$runId]);\n        }\n\n        return ['run_id'=>$runId,'run_uuid'=>$runUuid,'task'=>self::JOB,'status'=>$status,'scanned'=>$stats['scanned'],'success'=>$stats['success'],'failure'=>$stats['failure'],'duration_ms'=>(int)round((microtime(true)-$startedAt)*1000),'error'=>$error];\n    }\n\n    /**\n     * 管理员恢复入口只重检这一张订单，复用自动发布的完整锁内校验，不运行整批 scheduler。\n     * 已经发布视为幂等成功；当前业务条件不满足时只返回 not_ready，不伪造状态。\n     * @return array{ok:bool,status:string,message:string}\n     */\n    public function retryOrder(int $orderId): array\n    {\n        $order = $this->db->fetch('SELECT id,publish_status FROM orders WHERE id=:id LIMIT 1', ['id'=>$orderId]);\n        if (!$order) return ['ok'=>false,'status'=>'not_found','message'=>'订单不存在'];\n        if ((string)$order['publish_status'] === 'published') {\n            $this->db->execute(\n                \"UPDATE scheduled_job_failures SET resolved_at=COALESCE(resolved_at,UTC_TIMESTAMP())\n                 WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",\n                ['job'=>self::JOB,'key'=>'order:'.$orderId]\n            );\n            return ['ok'=>true,'status'=>'already_published','message'=>'订单已经发布，无需重复处理'];\n        }\n        try {\n            $published = $this->publishOne($orderId);\n        } catch (Throwable $exception) {\n            return ['ok'=>false,'status'=>'failed','message'=>mb_substr($exception->getMessage(),0,500)];\n        }\n        if (!$published) return ['ok'=>false,'status'=>'not_ready','message'=>'订单当前条件仍不满足自动发布，请按最新状态处理'];\n        return ['ok'=>true,'status'=>'published','message'=>'重新检查通过，订单已发布'];\n    }\n\n    private function publishOne(int $orderId): bool\n    {\n        return $this->db->transaction(function (Database $db) use ($orderId): bool {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents,t.settlement_status\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order\n                || (int)($order['is_demo']??0)!==0\n                || (string)$order['customer_flow_mode']!=='platform_managed'\n                || (string)$order['settlement_status']!=='pending'\n                || (int)$order['booking_fee_cents']!==0\n                || (int)$order['customer_contract_total_cents']<=0\n                || (int)$order['booking_paid_cents']>(int)$order['customer_contract_total_cents']\n                || (string)$order['lifecycle_status']!=='active'\n                || (string)$order['publish_status']==='published'\n                || !in_array((string)$order['audit_status'],['pending','approved'],true)\n                || !in_array((string)($order['refund_status']??'none'),['','none'],true)\n                || !empty($order['selected_quote_id'])\n                || !empty($order['assigned_worker_id'])\n                || !empty($order['current_assignment_id'])\n                || !in_array((string)$order['quote_status'],['waiting','quoting','collecting'],true)\n                || $this->hasBlockingBusiness($db,$orderId)) return false;\n            if ($order['lat']===null || $order['lng']===null) throw new RuntimeException('平台承接单缺少地图坐标，系统已停止自动发布，请补充地址后处理');\n            $mediaReadiness = OrderFormMediaRules::readiness($db,$orderId,(int)($order['form_schema_version_id']??0),(string)($order['workflow_profile']??'construction'));\n            if (empty($mediaReadiness['ready'])) return false;\n\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            $quoteDays = max(1,min(30,(int)\\setting('order.auto_cancel_days',7)));\n            $version = max(1,(int)$order['version']);\n            $changed = $db->execute(\n                \"UPDATE orders SET audit_status='approved',publish_status='published',quote_status='waiting',audited_at=COALESCE(audited_at,UTC_TIMESTAMP()),published_at=COALESCE(published_at,UTC_TIMESTAMP()),quote_deadline_at=COALESCE(quote_deadline_at,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$quoteDays} DAY)),audit_note='平台托管条件核验通过后系统自动发布',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id AND order_source_type='platform' AND booking_fee_cents=0 AND lifecycle_status='active' AND publish_status<>'published' AND selected_quote_id IS NULL AND assigned_worker_id IS NULL AND current_assignment_id IS NULL\",\n                ['id'=>$orderId]\n            );\n            if ($changed!==1) return false;\n\n            $eventKey='scheduler:'.self::JOB.':order:'.$orderId.':v'.$version;\n            $payload=json_encode(['quote_days'=>$quoteDays,'external_prepayment_cents'=>(int)$order['booking_paid_cents'],'message'=>'平台承接单托管条件与公共下单资料完整，系统自动审核并发布，无需管理员二次确认。'],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $db->execute(\"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,'platform_order_auto_published',:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",['order_id'=>$orderId,'event_key'=>substr($eventKey,0,128),'payload'=>is_string($payload)?$payload:'{}']);\n            $db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP() WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",['job'=>self::JOB,'key'=>'order:'.$orderId]);\n            return true;\n        });\n    }\n\n    private function hasBlockingBusiness(Database $db, int $orderId): bool\n    {\n        return (int)$db->fetchValue(\n            \"SELECT (EXISTS(SELECT 1 FROM disputes WHERE order_id=:id1 AND status IN ('open','pending','processing')) OR EXISTS(SELECT 1 FROM refunds WHERE order_id=:id2 AND status NOT IN ('failed','closed','cancelled','rejected')) OR EXISTS(SELECT 1 FROM order_cancel_requests WHERE order_id=:id3 AND status IN ('pending','processing')) OR EXISTS(SELECT 1 FROM change_requests WHERE order_id=:id4 AND status IN ('pending','processing','negotiating')) OR EXISTS(SELECT 1 FROM after_sales WHERE order_id=:id5 AND status IN ('open','processing'))) AS blocked\",\n            ['id1'=>$orderId,'id2'=>$orderId,'id3'=>$orderId,'id4'=>$orderId,'id5'=>$orderId]\n        )===1;\n    }\n\n    private function recordFailure(int $runId, int $orderId, int $version, Throwable $exception, ?string $businessKey=null): void\n    {\n        try {\n            $key=$businessKey??('order:'.$orderId);\n            $attempt=(int)$this->db->fetchValue(\"SELECT COALESCE(MAX(attempt_no),0)+1 FROM scheduled_job_failures WHERE job_name=:job AND business_key=:key AND business_version=:version\",['job'=>self::JOB,'key'=>$key,'version'=>max(1,$version)]);\n            $attempt=max(1,$attempt);\n            $minutes=min(1440,max(1,1<<min(10,max(0,$attempt-1))));\n            $this->db->execute(\n                \"INSERT INTO scheduled_job_failures(job_name,business_key,business_version,scheduler_run_id,attempt_no,error_class,error_message,next_retry_at,created_at) VALUES(:job,:key,:version,:run_id,:attempt,:error_class,:error_message,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$minutes} MINUTE),UTC_TIMESTAMP())\",\n                ['job'=>self::JOB,'key'=>substr($key,0,128),'version'=>max(1,$version),'run_id'=>$runId,'attempt'=>$attempt,'error_class'=>substr(get_class($exception),0,160),'error_message'=>mb_substr($exception->getMessage(),0,2000)]\n            );\n        } catch (Throwable $ignored) {}\n    }\n\n    private function uuidV4(): string\n    {\n        $data=random_bytes(16);\n        $data[6]=chr((ord($data[6])&0x0f)|0x40);\n        $data[8]=chr((ord($data[8])&0x3f)|0x80);\n        return vsprintf('%s%s-%s-%s-%s-%s%s%s',str_split(bin2hex($data),4));\n    }\n}\n","server/app/Infrastructure/Messaging/OrderSubscriptionDefinitionOperations.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\n\n/** Subscription metadata / mapping extracted from the frozen notification facade. */\ntrait OrderSubscriptionDefinitionOperations\n{\n    public static function subscriptionSceneDefinitions(): array\n    {\n        $scenes = [\n            'reviewResult' => ['title'=>'入驻审核结果通知','description'=>'师傅入驻审核完成后通知','template_id'=>'b7RKsUBxQu3BWwMEwzw-oFHkw1K9m4egjVFSLQ5rWMY','field_map'=>[],'field_semantics'=>[],'keywords'=>['师傅姓名','手机号','审核结果','说明'],'recipient'=>'worker'],\n            'order_audit' => ['title'=>'订单审核通知','description'=>'订单通过、补资料或审核未通过时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time','audit_note'],'keywords'=>['订单编号','审核结果','处理时间','审核说明']],\n            'quote_received' => ['title'=>'收到报价通知','description'=>'订单收到新的师傅或平台报价时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','amount','quote_party','time'],'keywords'=>['订单编号','报价金额','报价方','报价时间']],\n            'payment_success' => ['title'=>'预约费支付成功','description'=>'微信支付已有结果反馈，通常保留内部通知即可','template_id'=>'','field_map'=>[],'field_semantics'=>['amount','time','platform_name','order_no'],'keywords'=>['支付金额','付款时间','平台名称','订单编号'],'recommended'=>false],\n            'worker_assigned' => ['title'=>'师傅接单通知','description'=>'安排师傅或师傅确认接单时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','worker_name','requirement_note'],'keywords'=>['订单编号','师傅姓名','需求说明']],\n            'completion_submitted' => ['title'=>'完工待验收通知','description'=>'师傅提交完工后提醒用户验收','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','time','service_category'],'keywords'=>['订单编号','完工时间','服务类目']],\n            'refund_result' => ['title'=>'退款结果通知','description'=>'取消退款审核及退款结果','template_id'=>'','field_map'=>[],'field_semantics'=>['amount','status','order_no','time'],'keywords'=>['退款金额','退款状态','订单编号','处理时间']],\n            'payment_pending'=>['title'=>'待付款提醒','description'=>'报价确认或测量加费待付款','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','待办事项','时间']],\n            'fee_adjustment'=>['title'=>'费用调整待确认','description'=>'师傅申请调整费用，待用户确认','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','调整状态','时间']],\n            'supplement_reminder'=>['title'=>'补资料临期提醒','description'=>'订单补充资料的处理期限提醒','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理状态','提醒时间']],\n            'measurement_result'=>['title'=>'测量成果待确认','description'=>'测量师傅提交成果，待用户验收','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','成果状态','提交时间']],\n            'measurement_extension'=>['title'=>'测量冻结延期结果','description'=>'用户申请延长冻结期的审核结果','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理结果','时间']],\n            'repair_progress'=>['title'=>'维修进度提醒','description'=>'师傅拒绝、已预约或可申请平台介入','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','维修进度','时间']],\n            'dispute_progress'=>['title'=>'争议处理通知','description'=>'争议处理完成或关键结果更新时通知用户','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理状态','时间']],\n            'user_order_update'=>['title'=>'订单重要进度通知','description'=>'派单异常、平台取消、电话公开、跑空费等需要用户及时知道的重要订单变化','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','订单状态','更新时间'],'recipient'=>'user'],\n            'worker_order_update'=>['title'=>'师傅订单重要进度','description'=>'安排接单、退款/取消、费用处理或争议等需要师傅及时知道的订单变化','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','订单状态','更新时间'],'recipient'=>'worker'],\n            'worker_repair'=>['title'=>'新维修工单','description'=>'提醒师傅及时联系用户处理售后','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','维修任务','时间'],'recipient'=>'worker'],\n            'worker_rework'=>['title'=>'测量成果需补测','description'=>'用户要求师傅重新提交测量成果','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','补测状态','时间'],'recipient'=>'worker'],\n            'worker_commission_due'=>['title'=>'平台服务费待缴','description'=>'服务费账单生成，提醒师傅处理','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','amount','time'],'keywords'=>['订单号','费用金额','生成时间'],'recipient'=>'worker'],\n        ];\n        // V2.4.1：一次性订阅改为“剩余可发送次数”；长期订阅仅在微信公众平台真实模板具备长期资格时使用。\n        // important 仅用于小程序端“重要通知一键续收”，不改变后台事件优先级、短信分类或发送顺序。\n        $importantScenes = [\n            // 入驻审核 reviewResult 有独立提交埋点，不参与日常“一键续收”，避免审核完成后长期占用批量名额。\n            'order_audit','quote_received','worker_assigned','completion_submitted','refund_result',\n            'payment_pending','fee_adjustment','supplement_reminder','measurement_result','measurement_extension','repair_progress','dispute_progress',\n            'user_order_update','worker_order_update','worker_repair','worker_rework','worker_commission_due',\n        ];\n        foreach ($scenes as $sceneKey => &$scene) {\n            $scene['subscription_type'] = 'one_time';\n            $scene['template_title'] = '';\n            $scene['template_fields'] = [];\n            $scene['synced_template_id'] = '';\n            $scene['important'] = in_array($sceneKey, $importantScenes, true);\n        }\n        unset($scene);\n        $configured = \\setting('wechat.subscribe_template_ids', []);\n        if (is_array($configured)) {\n            foreach ($configured as $key => $row) {\n                if (!isset($scenes[$key])) continue;\n                if (is_string($row)) $scenes[$key]['template_id'] = trim($row);\n                elseif (is_array($row)) {\n                    $scenes[$key]['template_id'] = trim((string) ($row['template_id'] ?? $row['id'] ?? $scenes[$key]['template_id']));\n                    $scenes[$key]['template_title'] = mb_substr(trim((string)($row['template_title'] ?? '')),0,80);\n                    $scenes[$key]['synced_template_id'] = trim((string)($row['synced_template_id'] ?? ''));\n                    $scenes[$key]['template_fields'] = ($scenes[$key]['synced_template_id']!==''&&hash_equals($scenes[$key]['template_id'],$scenes[$key]['synced_template_id'])&&is_array($row['template_fields'] ?? null)) ? array_values(array_filter(array_map('strval',$row['template_fields']))) : [];\n                    $scenes[$key]['template_field_labels'] = is_array($row['template_field_labels'] ?? null) ? $row['template_field_labels'] : [];\n                    $fieldMap = is_array($row['field_map'] ?? null) ? $row['field_map'] : [];\n                    // 2.5.0：旧字段名在读取时无损迁移为明确语义；审核备注与订单需求必须按场景分开。\n                    if(isset($fieldMap['service_name'])&&!isset($fieldMap['service_category'])){$fieldMap['service_category']=$fieldMap['service_name'];unset($fieldMap['service_name']);}\n                    if(isset($fieldMap['remark'])){\n                        if($key==='order_audit'&&!isset($fieldMap['audit_note']))$fieldMap['audit_note']=$fieldMap['remark'];\n                        elseif(!isset($fieldMap['requirement_note']))$fieldMap['requirement_note']=$fieldMap['remark'];\n                        unset($fieldMap['remark']);\n                    }\n                    // 旧 payment_success 的 merchant_name 实际发送的是“壁选”，本质是平台名称，不是订单商家。\n                    if($key==='payment_success'&&isset($fieldMap['merchant_name'])&&!isset($fieldMap['platform_name'])){$fieldMap['platform_name']=$fieldMap['merchant_name'];unset($fieldMap['merchant_name']);}\n                    $scenes[$key]['field_map'] = $fieldMap;\n                    $scenes[$key]['field_defaults'] = is_array($row['field_defaults'] ?? null) ? $row['field_defaults'] : [];\n                    $subscriptionType = trim((string) ($row['subscription_type'] ?? 'one_time'));\n                    if (in_array($subscriptionType, ['one_time','long_term'], true)) $scenes[$key]['subscription_type'] = $subscriptionType;\n                }\n            }\n        }\n        $global = filter_var(\\setting('wechat.subscribe_enabled', true), FILTER_VALIDATE_BOOLEAN);\n        foreach ($scenes as $key => &$scene) {\n            $scene['key'] = $key;\n            $scene['global_enabled'] = $global;\n            $requiredSemantics = array_values(array_map('strval',(array)($scene['field_semantics']??[])));\n            $knownSemantics = array_fill_keys(array_keys(self::subscriptionSemanticLabels()), true);\n            $fieldMap = is_array($scene['field_map']??null) ? $scene['field_map'] : [];\n            $fieldDefaults = is_array($scene['field_defaults']??null) ? $scene['field_defaults'] : [];\n            $templateFields=is_array($scene['template_fields']??null)?array_values(array_map('strval',$scene['template_fields'])):[];\n            $mapComplete = true; $targets = [];\n            // 当前场景声明的 field_semantics 是“必须来源”，必须全部映射。\n            foreach($requiredSemantics as $semantic){\n                $target=trim((string)($fieldMap[$semantic]??''));\n                if($target===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            // 微信模板可能比业务场景多字段。允许使用系统已知业务字段补齐，但这些不是当前场景的必填语义。\n            foreach($fieldMap as $semantic=>$target){\n                $semantic=(string)$semantic;$target=trim((string)$target);\n                if(in_array($semantic,$requiredSemantics,true))continue;\n                if(!isset($knownSemantics[$semantic])||$target===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            foreach($fieldDefaults as $target=>$fixedValue){\n                $target=trim((string)$target);$fixedValue=trim((string)$fixedValue);\n                if($target===''||$fixedValue===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            if($templateFields){\n                foreach($templateFields as $templateField)if(!isset($targets[$templateField])){$mapComplete=false;break;}\n            }\n            $needsFieldMap = !empty($requiredSemantics)||!empty($templateFields);\n            // reviewResult 是项目已验证的固定模板，字段由专用发送代码固定生成，不走通用 field_map。\n            if($key==='reviewResult'){\n                $mapComplete=true;\n                if($templateFields){\n                    foreach(self::reviewResultFixedTemplateFields() as $fixedField){\n                        if(!in_array($fixedField,$templateFields,true)){$mapComplete=false;break;}\n                    }\n                }\n            }\n            $scene['configuration_complete'] = $scene['template_id'] !== '' && (!$needsFieldMap||$mapComplete);\n            $scene['available'] = $global && $scene['configuration_complete'];\n            $scene['availability_reason'] = $scene['template_id'] === '' ? 'template_missing' : ($needsFieldMap && !$mapComplete ? ($key==='reviewResult'?'fixed_template_mismatch':'field_map_missing') : ($global ? 'ready' : 'global_disabled'));\n        }\n        unset($scene);\n        return $scenes;\n    }\n\n    public static function subscriptionSemanticLabels(): array\n    {\n        return [\n            'order_no'=>'订单编号',\n            'status'=>'当前状态/处理结果',\n            'time'=>'状态更新时间',\n            'amount'=>'金额',\n            'quote_party'=>'报价方',\n            'platform_name'=>'平台名称',\n            'merchant_name'=>'商家名称',\n            'worker_name'=>'师傅姓名',\n            'service_category'=>'服务类目',\n            'order_title'=>'订单名称',\n            'service_address'=>'施工地址',\n            'requirement_note'=>'需求说明',\n            'audit_note'=>'审核说明',\n            'expected_visit_time'=>'期望上门时间',\n            'contact_name'=>'对接人',\n            'appointment_time'=>'预约时间',\n            'appointment_note'=>'预约说明',\n        ];\n    }\n\n    public static function subscriptionSemanticDescriptions(): array\n    {\n        return [\n            'order_no'=>'订单 public_no',\n            'status'=>'本次真实业务事件的状态文字',\n            'time'=>'本次消息生成时间',\n            'amount'=>'本次事件金额；无专项金额时使用订单成交金额',\n            'quote_party'=>'报价事件对应的师傅或平台',\n            'platform_name'=>'后台基础设置 site.name',\n            'merchant_name'=>'订单关联 merchant_profiles.business_name；普通用户订单显示“个人订单”',\n            'worker_name'=>'订单当前成交/指派师傅姓名',\n            'service_category'=>'orders.category_names_snapshot，等同用户下单选择的服务类目',\n            'order_title'=>'orders.title，订单标题/名称，不等同服务类目',\n            'service_address'=>'订单地址快照 order_addresses.address_summary',\n            'requirement_note'=>'orders.description，用户订单需求说明',\n            'audit_note'=>'orders.audit_note，管理员审核时填写的说明',\n            'expected_visit_time'=>'orders.expected_visit_at，用户下单填写的期望上门时间',\n            'contact_name'=>'订单地址快照中的脱敏对接人姓名',\n            'appointment_time'=>'该订单最近一次施工预约时间',\n            'appointment_note'=>'该订单最近一次施工预约说明',\n        ];\n    }\n\n    public static function reviewResultFixedTemplateFields(): array\n    {\n        return ['name1','phone_number2','phrase3','thing5'];\n    }\n\n    public static function subscriptionFixedValuePresets(string $wechatField,string $label=''): array\n    {\n        $label=trim($label);\n        if(preg_match('/温馨提示|提示|备注|说明/u',$label))return ['请查看小程序详情','请及时处理'];\n        return [];\n    }\n\n    public static function inferSubscriptionTemplateBinding(array $scene,array $actual,array $previous=[]): array\n    {\n        $fields=is_array($actual['fields']??null)?array_values(array_unique(array_filter(array_map('strval',$actual['fields'])))):[];\n        $labels=is_array($actual['field_labels']??null)?$actual['field_labels']:[];\n        $required=array_values(array_map('strval',(array)($scene['field_semantics']??[])));\n        $known=array_keys(self::subscriptionSemanticLabels());\n        // 必填语义优先匹配；模板额外字段可继续匹配系统已知业务字段。\n        $allowed=array_values(array_unique(array_merge($required,$known)));\n        $fieldMap=[];$defaults=[];$used=[];\n        $previousMap=is_array($previous['field_map']??null)?$previous['field_map']:[];\n        // 兼容旧配置后再参与自动识别，避免同步模板时把已经绑好的字段丢掉。\n        if(isset($previousMap['service_name'])&&!isset($previousMap['service_category'])){$previousMap['service_category']=$previousMap['service_name'];unset($previousMap['service_name']);}\n        if(isset($previousMap['remark'])){\n            if((string)($scene['key']??'')==='order_audit'&&!isset($previousMap['audit_note']))$previousMap['audit_note']=$previousMap['remark'];\n            elseif(!isset($previousMap['requirement_note']))$previousMap['requirement_note']=$previousMap['remark'];\n            unset($previousMap['remark']);\n        }\n        if((string)($scene['key']??'')==='payment_success'&&isset($previousMap['merchant_name'])&&!isset($previousMap['platform_name'])){$previousMap['platform_name']=$previousMap['merchant_name'];unset($previousMap['merchant_name']);}\n        $previousDefaults=is_array($previous['field_defaults']??null)?$previous['field_defaults']:[];\n        foreach($previousMap as $semantic=>$field){\n            $semantic=(string)$semantic;$field=trim((string)$field);\n            if(in_array($semantic,$allowed,true)&&in_array($field,$fields,true)&&!isset($used[$field])){$fieldMap[$semantic]=$field;$used[$field]=true;}\n        }\n        foreach($previousDefaults as $field=>$value){\n            $field=trim((string)$field);$value=trim((string)$value);\n            if($value!==''&&in_array($field,$fields,true)&&!isset($used[$field])){$defaults[$field]=$value;$used[$field]=true;}\n        }\n        $aliases=[\n            'order_no'=>['订单编号','订单号','服务单号','工单号','预约单号'],\n            'status'=>['订单状态','审核结果','处理状态','处理结果','退款状态','维修进度','进度','待办事项','调整状态','成果状态','补测状态','维修任务'],\n            'time'=>['处理时间','更新时间','提醒时间','提交时间','生成时间','报价时间','付款时间','完工时间','时间'],\n            'amount'=>['支付金额','退款金额','报价金额','费用金额','金额','费用'],\n            'quote_party'=>['报价方','报价人','报价师傅'],\n            'platform_name'=>['平台名称','服务平台','平台'],\n            'merchant_name'=>['商家名称','商户名称','门店名称','店铺名称','企业名称'],\n            'worker_name'=>['师傅姓名','服务人员','接单人','工作人员'],\n            'service_category'=>['服务类目','服务分类','施工类目','业务类目','类目','服务项目','服务内容'],\n            'order_title'=>['订单名称','订单标题','服务名称','项目名称'],\n            'service_address'=>['施工地址','服务地址','上门地址','安装地址','地址'],\n            'requirement_note'=>['需求说明','订单说明','施工要求','服务要求'],\n            'audit_note'=>['审核说明','审核备注','审核意见','驳回原因','备注','说明'],\n            'expected_visit_time'=>['期望上门时间','期望时间','期望日期','上门时间'],\n            'contact_name'=>['联系人','联系人姓名','对接人','客户姓名'],\n            'appointment_time'=>['预约时间','预约日期','上门预约'],\n            'appointment_note'=>['预约说明','预约备注'],\n        ];\n        // payment_success 的“商家/商户名称”历史上实际表达收款平台；仅该场景将二者优先解释为平台名称。\n        if((string)($scene['key']??'')==='payment_success')$aliases['platform_name']=array_merge(['商家名称','商户名称'],$aliases['platform_name']);\n        $normalize=static function(string $value):string{return mb_strtolower((string)(preg_replace('/[\\s：:（）()\\-—_\\/]+/u','',$value)??$value));};\n        foreach($fields as $field){\n            if(isset($used[$field]))continue;\n            $label=trim((string)($labels[$field]??''));$normalized=$normalize($label);\n            if($normalized==='')continue;\n            $best='';\n            foreach($allowed as $semantic){\n                if(isset($fieldMap[$semantic]))continue;\n                foreach($aliases[$semantic]??[] as $alias){\n                    $a=$normalize($alias);\n                    if($normalized===$a||mb_strpos($normalized,$a)!==false||mb_strpos($a,$normalized)!==false){$best=$semantic;break 2;}\n                }\n            }\n            if($best!==''){$fieldMap[$best]=$field;$used[$field]=true;continue;}\n\n        }\n        $unresolved=[];foreach($fields as $field)if(!isset($used[$field]))$unresolved[]=$field;\n        $missingSemantics=[];foreach($required as $semantic)if(empty($fieldMap[$semantic]))$missingSemantics[]=$semantic;\n        return ['field_map'=>$fieldMap,'field_defaults'=>$defaults,'unresolved_fields'=>$unresolved,'missing_semantics'=>$missingSemantics,'complete'=>!$unresolved&&!$missingSemantics];\n    }\n\n    public static function recommendSubscriptionKeywords(array $scene,array $keywords): array\n    {\n        $pseudo=['fields'=>[],'field_labels'=>[]];\n        foreach($keywords as $row){\n            if(!is_array($row))continue;\n            $kid=(int)($row['kid']??0);if($kid<1)continue;\n            $field='kid'.$kid;$pseudo['fields'][]=$field;$pseudo['field_labels'][$field]=(string)($row['name']??'');\n        }\n        $binding=self::inferSubscriptionTemplateBinding($scene,$pseudo,[]);\n        $recommended=[];\n        foreach(array_merge(array_values($binding['field_map']),array_keys($binding['field_defaults'])) as $field){\n            if(strpos((string)$field,'kid')===0)$recommended[]=(int)substr((string)$field,3);\n        }\n        return array_values(array_unique(array_filter($recommended,static function($id){return $id>0;})));\n    }\n}\n","server/app/Domain/Messaging/MessageEventCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\nrequire_once __DIR__.'/OrderProgressMessageCatalog.php';\n\n// 2026-10-08：统一协商事件仅通知另一方，升级后才通知管理员。\nfinal class MessageEventCatalog\n{\n    public static function all(): array\n    {\n        static $catalog = null;\n        if (is_array($catalog)) return $catalog;\n\n        $labels = [\n            'negotiation_responded'=>'对方响应协商','repair_worker_accepted'=>'师傅接受维修','measurement_rework_rejected'=>'师傅无法补测',\n            'order_ready_for_prepayment'=>'下单待支付预约费','order_submitted'=>'新订单待管理员审核','order_approved'=>'订单审核通过','order_supplement_required'=>'要求用户补充资料','order_supplemented'=>'用户已补充资料','order_rejected'=>'订单审核未通过',\n            'worker_quoted'=>'师傅首次报价','worker_quote_updated'=>'师傅修改报价','platform_quoted'=>'平台报价','quote_selected_pending_payment'=>'用户选择报价','payment_reservation_released'=>'支付超时释放报价','booking_fee_paid'=>'预约费支付成功','booking_fee_paid_upfront'=>'下单预约费支付成功',\n            'worker_assigned'=>'安排施工师傅','assignment_accepted'=>'师傅接单','assignment_rejected'=>'师傅拒绝派单','assignment_expired'=>'派单超时释放','appointment_recorded'=>'师傅登记预约','appointment_waiting_customer_notice'=>'师傅已响应预约，等待客户确认',\n            'change_requested'=>'师傅申请费用调整','change_accepted'=>'用户同意费用调整','change_rejected'=>'用户不同意费用调整','completion_submitted'=>'师傅提交完工','completion_accepted_by_user'=>'用户确认验收','auto_completion_accepted'=>'系统自动验收','auto_accepted_72h'=>'72小时自动验收',\n            'exceptional_arrival_reported'=>'师傅登记到场异常','offline_collection_delayed'=>'尾款延期登记','offline_collection_bad_debt'=>'尾款坏账','cancel_requested'=>'用户申请取消退款','cancel_approved'=>'取消退款通过','admin_cancelled'=>'平台强制取消','cancel_rejected'=>'取消退款驳回','auto_cancelled_7d'=>'七天自动取消','refund_succeeded'=>'退款成功',\n            'order_auto_preapproved'=>'新订单自动预审公开','offline_collection_adjustment_requested'=>'师傅提交实际尾款','offline_collection_adjustment_auto_approved'=>'实际尾款自动预审生效','offline_collection_adjustment_approved'=>'实际尾款复核通过','offline_collection_adjustment_rejected'=>'实际尾款驳回',\n            'commission_estimate_created'=>'预计服务费已生成','commission_receivable_finalized'=>'正式平台服务费已生成','commission_receivable_created'=>'平台服务费待缴','commission_paid'=>'平台服务费结清','commission_overdue'=>'平台服务费逾期',\n            'dispute_opened'=>'订单争议发起','completion_dispute_opened'=>'用户提交完工争议','dispute_resolved'=>'订单争议结案','review_submitted'=>'用户提交评价','auto_reviewed_5d'=>'系统自动评价',\n            'run_empty_claim_submitted'=>'商家跑空费待确认','run_empty_claim_confirmed'=>'商家已确认跑空费','run_empty_claim_disputed'=>'跑空费进入争议','run_empty_fee_paid'=>'商家已支付跑空费',\n            'worker_profile_submitted'=>'师傅发布/更新资料待审核','worker_realname_submitted'=>'师傅实名待审核','worker_collection_code_submitted'=>'旧版收款码待审核','worker_collection_code_auto_approved'=>'收款码自动预审后待抽查','merchant_auth_submitted'=>'商家认证待审核','withdrawal_submitted'=>'师傅提交提现申请',\n            'warranty_repair_requested'=>'用户提交维修申请','warranty_repair_withdrawn'=>'用户撤回维修申请','repair_worker_rejected'=>'师傅拒绝维修','repair_worker_completed'=>'师傅完成维修','repair_intervention_available'=>'维修超时可申请平台介入','repair_platform_intervention_requested'=>'用户申请平台介入维修','repair_platform_continue'=>'平台要求继续维修','repair_platform_resolved'=>'平台确认售后解决','repair_platform_closed'=>'平台关闭售后','repair_appointment_recorded'=>'师傅登记维修预约','repair_waiting_customer_notice'=>'师傅已响应维修，等待客户确认','worker_replaced_by_user'=>'用户更换成交师傅',\n            'supplement_deadline_reminder'=>'补资料期限提醒','supplement_timeout_refunded'=>'补资料超时退款',\n            'measurement_service_paid'=>'测量服务费支付成功','measurement_change_paid'=>'测量加费支付成功','measurement_change_accepted_pending_payment'=>'测量加费待付款','measurement_result_submitted'=>'测量成果待确认','measurement_rework_requested'=>'用户申请补测','measurement_result_accepted'=>'测量成果已确认','measurement_auto_accepted'=>'测量成果自动确认',\n            'measurement_hold_extension_requested'=>'测量冻结延期申请','measurement_hold_extension_approved'=>'测量冻结延期已通过','measurement_hold_extension_rejected'=>'测量冻结延期未通过','measurement_income_released'=>'测量费用已结算','measurement_construction_linked'=>'测量单已关联施工单',\n            'measurement_change_refund_created'=>'测量加费退款处理中','measurement_change_refunded'=>'测量加费退款成功','measurement_late_balance_refund_created'=>'测量尾款退款处理中','measurement_late_balance_refunded'=>'测量尾款退款成功',\n            'worker_contact_reveal_requested'=>'用户申请公开师傅电话','worker_contact_reveal_approved'=>'师傅电话公开申请已批准','worker_contact_reveal_rejected'=>'师傅电话公开申请未批准','worker_contact_reveal_cancelled'=>'师傅电话公开申请已取消',\n        ];\n\n        $normal = array_flip([\n            'order_approved','worker_assigned','assignment_accepted','appointment_recorded','booking_fee_paid','booking_fee_paid_upfront','measurement_service_paid','measurement_change_paid','refund_succeeded','measurement_change_refunded','measurement_late_balance_refunded','worker_quote_updated','payment_reservation_released','commission_estimate_created','run_empty_fee_paid','auto_cancelled_7d','repair_worker_completed','completion_accepted_by_user','commission_paid','review_submitted','auto_reviewed_5d','run_empty_fee_paid',\n            'order_auto_preapproved','offline_collection_adjustment_auto_approved','worker_collection_code_auto_approved',\n            'measurement_result_accepted','measurement_auto_accepted','measurement_income_released','measurement_construction_linked','worker_contact_reveal_cancelled','appointment_waiting_customer_notice','repair_waiting_customer_notice',\n            'warranty_repair_withdrawn','repair_worker_completed','repair_appointment_recorded','repair_platform_resolved','repair_platform_closed','measurement_hold_extension_approved','measurement_hold_extension_rejected','offline_collection_adjustment_approved','offline_collection_adjustment_rejected',\n        ]);\n        $definitions = [\n            'negotiation_responded'=>['对方已响应协商',['user','worker'],'order_status','user_order_update'],\n            'repair_worker_accepted'=>['师傅已接受维修',['user'],'order_status','repair_progress'],\n            'measurement_rework_rejected'=>['师傅无法补测，可继续协商',['user'],'order_status','user_order_update'],\n            'order_ready_for_prepayment'=>['订单待支付预约费',['user'],'order_status',''],\n            'order_submitted'=>['订单待审核',['admin'],'order_status',''],\n            'order_approved'=>['审核通过，开始报价',['user'],'order_status','order_audit'],\n            'order_supplement_required'=>['请补充订单资料',['user'],'order_status','order_audit'],\n            'order_supplemented'=>['用户已补充订单资料',['admin'],'order_status',''],\n            'order_rejected'=>['订单审核未通过',['user'],'order_status','order_audit'],\n            'worker_quoted'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'worker_quote_updated'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'platform_quoted'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'quote_selected_pending_payment'=>['已选报价，待支付预约费',['user'],'order_status','payment_pending'],\n            'payment_reservation_released'=>['支付超时，订单恢复报价',['user'],'order_status',''],\n            'booking_fee_paid'=>['预约费支付成功',['user'],'payment_success','payment_success'],\n            'booking_fee_paid_upfront'=>['预约费支付成功',['user'],'payment_success','payment_success'],\n            'worker_assigned'=>['已安排施工师傅',['worker','user'],'order_status','worker_assigned'],\n            'assignment_accepted'=>['师傅已接单',['user'],'order_status','worker_assigned'],\n            'assignment_rejected'=>['师傅已拒绝派单',['user','admin'],'order_status','user_order_update'],\n            'assignment_expired'=>['派单超时已释放',['user','worker','admin'],'order_status','user_order_update'],\n            'appointment_recorded'=>['已预约上门',['user'],'order_status',''],\n            'appointment_waiting_customer_notice'=>['师傅已联系，请确认预约',['user'],'order_status',''],\n            'change_requested'=>['费用调整待确认',['user'],'order_status','fee_adjustment'],\n            'change_accepted'=>['费用调整已同意',['worker'],'order_status','worker_order_update'],\n            'change_rejected'=>['费用调整未同意',['worker'],'order_status','worker_order_update'],\n            'completion_submitted'=>['完工待验收',['user'],'order_status','completion_submitted'],\n            'completion_accepted_by_user'=>['用户已验收',['worker'],'order_status',''],\n            'auto_completion_accepted'=>['订单已自动验收',['user'],'order_status',''],\n            'auto_accepted_72h'=>['订单已自动验收',['user'],'order_status',''],\n            'auto_reviewed_5d'=>['订单收到自动好评',['worker'],'order_status',''],\n            'warranty_repair_requested'=>['用户已提交维修申请，请及时联系处理',['worker'],'order_status','worker_repair'],\n            'warranty_repair_withdrawn'=>['用户已撤回维修申请',['worker'],'order_status',''],\n            'repair_worker_rejected'=>['师傅已拒绝维修，可申请平台介入',['user'],'order_status','repair_progress'],\n            'repair_worker_completed'=>['维修已完成',['user'],'order_status',''],\n            'repair_intervention_available'=>['维修超过48小时仍未完成，可申请平台介入',['user'],'order_status','repair_progress'],\n            'repair_platform_intervention_requested'=>['用户已申请平台介入维修',['worker'],'order_status','worker_order_update'],\n            'repair_platform_continue'=>['平台要求继续维修',['user','worker'],'order_status','repair_progress'],\n            'repair_platform_resolved'=>['平台确认售后问题已解决',['user','worker'],'order_status','repair_progress'],\n            'repair_platform_closed'=>['平台已关闭本次售后',['user','worker'],'order_status','repair_progress'],\n            'repair_appointment_recorded'=>['师傅已登记维修预约',['user'],'order_status','repair_progress'],\n            'repair_waiting_customer_notice'=>['师傅已联系，请确认维修预约',['user'],'order_status',''],\n            'worker_replaced_by_user'=>['订单已更换成交师傅',['worker','user'],'order_status',''],\n            'supplement_deadline_reminder'=>['补资料期限即将到期',['user'],'order_status','supplement_reminder'],\n            'supplement_timeout_refunded'=>['补资料超时已取消，退款处理中',['user','admin'],'order_status','refund_result'],\n            'commission_estimate_created'=>['预计服务费已生成',['worker'],'order_status',''],\n            'commission_receivable_finalized'=>['平台服务费已正式生成',['worker'],'order_status',''],\n            'exceptional_arrival_reported'=>['师傅已登记到场异常',['admin'],'order_status',''],\n            'offline_collection_delayed'=>['师傅已登记尾款延期',['admin'],'order_status',''],\n            'offline_collection_bad_debt'=>['线下尾款已标记坏账',['worker'],'order_status',''],\n            'cancel_requested'=>['订单申请退款',['user','worker','admin'],'order_status','worker_order_update'],\n            'cancel_approved'=>['取消退款已通过',['user','worker'],'order_status','refund_result'],\n            'admin_cancelled'=>['平台已取消订单',['user','worker'],'order_status','user_order_update'],\n            'cancel_rejected'=>['取消退款未通过',['user','worker'],'order_status','refund_result'],\n            'auto_cancelled_7d'=>['订单超期自动取消',['user','admin'],'order_status',''],\n            'refund_succeeded'=>['预约费退款成功',['user'],'order_status','refund_result'],\n            'worker_contact_reveal_approved'=>['师傅电话公开申请已批准',['user','worker'],'order_status','user_order_update'],\n            'worker_contact_reveal_rejected'=>['师傅电话公开申请未批准',['user'],'order_status','user_order_update'],\n            'worker_contact_reveal_cancelled'=>['师傅电话公开申请已取消',['user'],'order_status',''],\n            'offline_collection_adjustment_requested'=>['实际尾款待审批',['admin'],'order_status',''],\n            'offline_collection_adjustment_approved'=>['实际尾款已核准',['worker'],'order_status',''],\n            'offline_collection_adjustment_rejected'=>['实际尾款未核准',['worker'],'order_status',''],\n            'commission_receivable_created'=>['平台服务费待缴',['worker'],'order_status','worker_commission_due'],\n            'commission_paid'=>['平台服务费已结清',['worker'],'order_status',''],\n            'dispute_opened'=>['订单进入争议处理',['user','worker','admin'],'order_status','worker_order_update'],\n            'dispute_resolved'=>['订单争议已处理',['user','worker'],'order_status','dispute_progress'],\n            'review_submitted'=>['订单收到用户评价',['worker'],'order_status',''],\n            'run_empty_claim_submitted'=>['商家跑空费待确认',['user'],'order_status','user_order_update'],\n            'run_empty_claim_confirmed'=>['商家已确认跑空费',['worker'],'order_status','worker_order_update'],\n            'run_empty_claim_disputed'=>['跑空费进入争议处理',['user','worker','admin'],'order_status','user_order_update'],\n            'run_empty_fee_paid'=>['商家跑空费已支付',['worker'],'order_status',''],\n            'measurement_service_paid'=>['测量服务费支付成功',['user','worker'],'order_status',''],\n            'measurement_change_paid'=>['测量加费支付成功',['user','worker'],'order_status',''],\n            'measurement_change_accepted_pending_payment'=>['测量加费待付款',['user'],'order_status','payment_pending'],\n            'measurement_result_submitted'=>['测量成果待确认',['user'],'order_status','measurement_result'],\n            'measurement_rework_requested'=>['用户申请补测',['worker'],'order_status','worker_rework'],\n            'measurement_result_accepted'=>['测量成果已确认',['user','worker'],'order_status',''],\n            'measurement_auto_accepted'=>['测量成果已自动确认',['user','worker'],'order_status',''],\n            'measurement_hold_extension_approved'=>['测量冻结延期已通过',['user'],'order_status','measurement_extension'],\n            'measurement_hold_extension_rejected'=>['测量冻结延期未通过',['user'],'order_status','measurement_extension'],\n            'measurement_income_released'=>['测量费用已结算',['worker'],'order_status',''],\n            'measurement_construction_linked'=>['测量单已关联施工单',['user','worker'],'order_status',''],\n            'measurement_change_refund_created'=>['测量加费退款处理中',['user'],'order_status','user_order_update'],\n            'measurement_change_refunded'=>['测量加费退款成功',['user'],'order_status',''],\n            'measurement_late_balance_refund_created'=>['测量尾款退款处理中',['user'],'order_status','user_order_update'],\n            'measurement_late_balance_refunded'=>['测量尾款退款成功',['user'],'order_status',''],\n        ];\n        $smsRecommended = array_flip([\n            'order_supplement_required','worker_quoted','platform_quoted','change_requested',\n            'completion_submitted','measurement_result_submitted','measurement_rework_requested',\n            'warranty_repair_requested','repair_worker_rejected','supplement_deadline_reminder',\n            'commission_receivable_created','run_empty_claim_submitted',\n        ]);\n        $internalOnly = array_flip([\n            'booking_fee_paid','booking_fee_paid_upfront','measurement_service_paid','measurement_change_paid',\n            'completion_accepted_by_user','commission_estimate_created','commission_paid',\n            'repair_worker_completed','review_submitted','auto_reviewed_5d',\n            'measurement_result_accepted','measurement_auto_accepted','measurement_income_released',\n            'measurement_construction_linked','worker_contact_reveal_cancelled',\n        ]);\n        $wecomDefaults = array_flip([\n            'order_submitted','order_supplemented','assignment_rejected','assignment_expired','exceptional_arrival_reported','offline_collection_delayed','cancel_requested','auto_cancelled_7d',\n            'offline_collection_adjustment_requested','dispute_opened','run_empty_claim_disputed','worker_profile_submitted','worker_realname_submitted','merchant_auth_submitted','commission_overdue',\n            'withdrawal_submitted','worker_contact_reveal_requested','measurement_hold_extension_requested','completion_dispute_opened','repair_platform_intervention_requested','supplement_timeout_refunded',\n        ]);\n        $wecomNormalVisible = array_flip(['order_auto_preapproved','offline_collection_adjustment_auto_approved','worker_collection_code_auto_approved']);\n        $explicitWecom = array_flip(['worker_profile_submitted','worker_realname_submitted','worker_collection_code_submitted','worker_collection_code_auto_approved','merchant_auth_submitted','commission_overdue','withdrawal_submitted','worker_contact_reveal_requested','measurement_hold_extension_requested','completion_dispute_opened','repair_platform_intervention_requested','order_auto_preapproved','offline_collection_adjustment_auto_approved']);\n\n        $catalog = [];\n        foreach ($labels as $key => $label) {\n            $definition = $definitions[$key] ?? null;\n            $recipients = $definition ? $definition[1] : [];\n            $audienceLabel = in_array('user',$recipients,true) && in_array('worker',$recipients,true) ? '用户、师傅' : (in_array('worker',$recipients,true) ? '师傅' : (in_array('user',$recipients,true) ? '用户' : '管理员'));\n            $catalog[$key] = [\n                'key'=>$key,\n                'label'=>$label,\n                'priority'=>isset($normal[$key]) ? 'normal' : 'important',\n                'audience_label'=>$audienceLabel,\n                'status'=>$definition ? $definition[0] : '',\n                'recipients'=>$recipients,\n                'scene'=>$definition ? $definition[2] : '',\n                'subscription_scene'=>$definition ? $definition[3] : '',\n                'inapp_visible'=>$definition && (in_array('user',$recipients,true) || in_array('worker',$recipients,true)),\n                'internal_only'=>isset($internalOnly[$key]),\n                'sms_visible'=>$definition && (in_array('user',$recipients,true) || in_array('worker',$recipients,true)) && !isset($internalOnly[$key]),\n                'sms_default'=>isset($smsRecommended[$key]),\n                'sms_recommended'=>isset($smsRecommended[$key]),\n                'sms_delivery_mode'=>(!isset($smsRecommended[$key]) && $definition && trim((string)$definition[3])!=='')?'subscription_fallback':'independent',\n                'sms_subscription_fallback'=>!isset($smsRecommended[$key]) && $definition && trim((string)$definition[3])!=='',\n                'sms_priority'=>isset($smsRecommended[$key])?'important':'normal',\n                'wecom_visible'=>isset($explicitWecom[$key]) || in_array('admin',$recipients,true) || isset($wecomNormalVisible[$key]),\n                'wecom_default'=>isset($wecomDefaults[$key]),\n            ];\n        }\n\n        return $catalog += \\WorkerAdmin\\Domain\\Messaging\\OrderProgressMessageCatalog::all();\n    }\n\n    public static function get(string $eventType): ?array\n    {\n        $all = self::all();\n        return $all[$eventType] ?? null;\n    }\n\n    public static function switches(string $channel, array $configured): array\n    {\n        $all = self::all();\n        $visibleKey = $channel === 'wecom' ? 'wecom_visible' : ($channel === 'inapp' ? 'inapp_visible' : 'sms_visible');\n        $result = [];\n\n        foreach ($all as $eventKey => $meta) {\n            if (empty($meta[$visibleKey])) continue;\n            $saved = $configured[$eventKey] ?? null;\n            $enabled = $saved === null ? $channel === 'inapp' : filter_var(is_array($saved) ? ($saved['enabled'] ?? false) : $saved, FILTER_VALIDATE_BOOLEAN);\n            $extra = is_array($saved) ? $saved : [];\n            $extra['enabled'] = $enabled;\n            $extra['priority'] = (string) ($channel==='sms'?($meta['sms_priority']??'normal'):$meta['priority']);\n            $result[$eventKey] = $extra;\n        }\n        foreach ($configured as $eventKey => $saved) {\n            if (isset($result[$eventKey]) || isset($all[$eventKey])) continue;\n            $extra = is_array($saved) ? $saved : [];\n            $extra['enabled'] = filter_var(is_array($saved) ? ($saved['enabled'] ?? false) : $saved, FILTER_VALIDATE_BOOLEAN);\n            $extra['priority'] = isset($extra['priority']) && $extra['priority'] === 'normal' ? 'normal' : 'important';\n            $result[(string)$eventKey] = $extra;\n        }\n\n        return $result;\n    }\n\n    public static function enabled(string $channel, string $eventType, array $configured): bool\n    {\n        $switches = self::switches($channel, $configured);\n        return isset($switches[$eventType]) && !empty($switches[$eventType]['enabled']);\n    }\n}\n","server/app/Infrastructure/Safety/TestingEnvironmentPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Safety;\n\nuse RuntimeException;\n\n/**\n * 测试环境外部副作用统一安全边界。\n * 是否处于 testing 只由 config/installed.php 的 app.env 决定；可调参数来自后台 system_settings。\n */\nfinal class TestingEnvironmentPolicy\n{\n    public static function active(): bool\n    {\n        return strtolower(trim((string) \\app_config('app.env', 'production'))) === 'testing';\n    }\n\n    public static function qiniuUploadPrefix(string $configuredPrefix): string\n    {\n        $configuredPrefix=trim($configuredPrefix,'/');\n        if (!self::active()) return $configuredPrefix;\n        $prefix = trim((string) \\setting('testing.qiniu_path_prefix', 'test'), '/');\n        if ($prefix === '' || preg_match('#^[A-Za-z0-9._-]{1,40}$#', $prefix) !== 1 || strpos($prefix, '..') !== false) {\n            throw new RuntimeException('测试环境七牛根目录配置无效。');\n        }\n        if($configuredPrefix!==''&&strcasecmp($prefix,$configuredPrefix)===0){\n            throw new RuntimeException('测试环境七牛根目录不能与正式根目录相同。');\n        }\n        return $prefix;\n    }\n\n    public static function assertQiniuDeleteAllowed(string $key): void\n    {\n        if (!self::active()) return;\n        $prefix = self::qiniuUploadPrefix((string)\\setting('qiniu.path_prefix','upload'));\n        $normalized = ltrim(trim($key), '/');\n        if ($normalized === '' || strpos($normalized, $prefix . '/') !== 0) {\n            throw new RuntimeException('测试环境禁止删除非测试目录的七牛对象：仅允许 ' . $prefix . '/ 下的对象。');\n        }\n    }\n\n    public static function paymentEnabled(bool $configuredEnabled): bool\n    {\n        return self::active() ? false : $configuredEnabled;\n    }\n\n    public static function assertPaymentAllowed(string $operation, string $outTradeNo = '', string $outRefundNo = ''): void\n    {\n        if (self::active()) throw new RuntimeException('测试环境禁止真实微信支付、退款、查单和支付回调入账。');\n    }\n\n    public static function assertSmsRecipientAllowed(string $mobile): void\n    {\n        if (!self::active()) return;\n        if (!self::boolSetting('testing.sms_enabled', false)) {\n            throw new RuntimeException('测试环境真实短信总开关未开启。');\n        }\n        $mobile = preg_replace('/\\D+/', '', $mobile) ?? '';\n        $allowed = self::stringList('testing.allowed_sms_mobiles');\n        if ($mobile === '' || !in_array($mobile, $allowed, true)) {\n            throw new RuntimeException('测试环境禁止向非白名单手机号发送真实短信。');\n        }\n    }\n\n    public static function assertWechatRecipientAllowed(string $openid): void\n    {\n        if (!self::active()) return;\n        if (!self::boolSetting('testing.subscribe_enabled', false)) {\n            throw new RuntimeException('测试环境微信订阅消息总开关未开启。');\n        }\n        $openid = trim($openid);\n        $allowed = self::stringList('testing.allowed_wechat_openids');\n        if ($openid === '' || !in_array($openid, $allowed, true)) {\n            throw new RuntimeException('测试环境禁止向非白名单 OpenID 发送真实微信订阅消息。');\n        }\n    }\n\n    public static function adminAlertContent(string $content): string\n    {\n        if (!self::active()) return $content;\n        if (!self::boolSetting('testing.allow_wecom', false)) {\n            throw new RuntimeException('测试环境默认禁止企业微信机器人通知。');\n        }\n        return strpos($content, '【测试环境】') === 0 ? $content : \"【测试环境】\\n\" . $content;\n    }\n\n    public static function assertWechatAccountWriteAllowed(): void\n    {\n        if (self::active() && !self::boolSetting('testing.allow_wechat_account_writes', false)) {\n            throw new RuntimeException('测试环境默认禁止修改正式小程序的订阅模板配置。');\n        }\n    }\n\n    public static function assertCloudActionAllowed(string $action): void\n    {\n        if (!self::active()) return;\n        if (self::boolSetting('testing.allow_cloud_writes', false)) return;\n        $readOnly = [\n            'admin.health','admin.list','admin.detail','server.owner.get','server.nearbyMarkedWorkers',\n            'server.phoneSearchIds','server.phoneReveal','server.membershipStatus','server.publicWorkerSearch',\n        ];\n        if (!in_array($action, $readOnly, true)) {\n            throw new RuntimeException('测试环境禁止写入正式微信云开发环境：' . $action);\n        }\n    }\n\n    private static function boolSetting(string $key, bool $default): bool\n    {\n        return filter_var(\\setting($key, $default ? '1' : '0'), FILTER_VALIDATE_BOOLEAN);\n    }\n\n    private static function stringList(string $settingKey): array\n    {\n        $value = \\setting($settingKey, '');\n        if (is_string($value)) $value = preg_split('/[\\s,;]+/', $value) ?: [];\n        if (!is_array($value)) return [];\n        $rows = [];\n        foreach ($value as $item) {\n            $item = trim((string) $item);\n            if ($item !== '') $rows[] = $item;\n        }\n        return array_values(array_unique($rows));\n    }\n}\n","server/app/Contracts/AdminWorkbenchOperationsRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface AdminWorkbenchOperationsRepository\n{\n    /** @return array<string,mixed> */\n    public function reassignWorker(array $actor, string $orderNo, int $workerId, string $reason): array;\n\n    /** @return array<string,mixed> */\n    public function interveneRepair(array $actor, string $orderNo, string $afterSaleNo, string $reason): array;\n\n    /** @return array<string,mixed> */\n    public function retryPlatformAutoPublish(array $actor, string $orderNo, string $sourceId): array;\n\n    /** @return array<string,mixed> */\n    public function addInternalFollowup(array $actor, string $orderNo, string $note, ?string $followUpAt): array;\n\n    /** @return array<string,mixed> */\n    public function completeInternalFollowup(array $actor, string $orderNo, int $followupEventId, string $note): array;\n\n    /** @return array<int,array<string,mixed>> */\n    public function workerOptions(string $orderNo, string $keyword, int $limit): array;\n\n    /** @return array<int,array<string,mixed>> */\n    public function internalFollowups(string $orderNo, int $limit): array;\n}\n","server/app/Domain/Order/NegotiationPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\n\n// 2026-10-08：各类异常共用升级规则；拒绝和超时只开放申请，不自动生成平台待办。\nfinal class NegotiationPolicy\n{\n    public const WAIT_HOURS = 48;\n\n    public static function evaluate(string $status, ?string $openedAt, string $timezone = 'UTC', ?DateTimeImmutable $now = null): array\n    {\n        $result = ['eligible'=>false,'reason'=>'not_active','available_at'=>null,'wait_hours'=>self::WAIT_HOURS];\n        if ($status === 'rejected') return array_merge($result, ['eligible'=>true,'reason'=>'counterparty_rejected']);\n        if (!in_array($status, ['pending','accepted_processing'], true) || !$openedAt) return $result;\n        try {\n            $zone = new DateTimeZone($timezone ?: 'UTC');\n            $available = (new DateTimeImmutable($openedAt, $zone))->modify('+'.self::WAIT_HOURS.' hours');\n            $result['available_at'] = $available->format('Y-m-d H:i:s');\n            $result['eligible'] = ($now ?: new DateTimeImmutable('now', $zone)) >= $available;\n            $result['reason'] = $result['eligible'] ? 'response_timeout' : 'waiting_counterparty';\n        } catch (Throwable $exception) {\n            $result['reason'] = 'invalid_deadline';\n        }\n        return $result;\n    }\n\n    public static function refundStatus(string $reasonCode): string\n    {\n        return ['bilateral_refund_pending'=>'pending','bilateral_refund_rejected'=>'rejected',\n            'bilateral_refund_escalated'=>'escalated','bilateral_refund_execution_required'=>'escalated'][$reasonCode] ?? '';\n    }\n\n    public static function disputeStatus(?string $resolution): string\n    {\n        return strpos((string)$resolution, '师傅拒绝异议') === 0 ? 'rejected' : 'pending';\n    }\n}\n","server/app/Domain/Order/FulfillmentActor.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/** 领域事件的真实经办来源；协助字段只由已鉴权且重验指派的管理员用例构造。 */\nfinal class FulfillmentActor\n{\n    public static function assisted(array $actor): bool\n    {\n        return (int)($actor['user_id'] ?? 0)>0 && (int)($actor['worker_id'] ?? 0)>0\n            && (int)($actor['assistance_operator_id'] ?? 0)===(int)$actor['user_id']\n            && trim((string)($actor['assistance_assignment_id'] ?? ''))!=='';\n    }\n\n    public static function type(array $actor): string { return self::assisted($actor) ? 'mini_admin' : 'worker'; }\n    public static function id(array $actor): int { return (int)($actor[self::assisted($actor) ? 'user_id' : 'worker_id'] ?? 0); }\n\n    public static function metadata(array $actor): array\n    {\n        return !self::assisted($actor) ? [] : [\n            'assisted'=>true,'operator_channel'=>'mini_admin','operator_user_id'=>(int)$actor['user_id'],\n            'worker_id'=>(int)$actor['worker_id'],'assignment_id'=>(string)$actor['assistance_assignment_id'],\n            'occurred_at'=>(string)($actor['assistance_occurred_at'] ?? ''),\n        ];\n    }\n}\n","server/app/Infrastructure/Persistence/OrderFormMediaRules.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\n\n/**\n * order_submit 图片字段的统一规则读取与就绪判断。\n * 普通下单 finalize、图片上传与平台承接单发布必须使用同一字段映射。\n */\nfinal class OrderFormMediaRules\n{\n    /** @return array{active:bool,min:int,max:int,label:string} */\n    public static function rule(Database $db,int $schemaVersionId,string $purpose):array\n    {\n        $keys=['product'=>'material_images','wall'=>'wall_images'];\n        if($schemaVersionId<1||!isset($keys[$purpose]))return ['active'=>false,'min'=>0,'max'=>20,'label'=>'图片'];\n        $row=$db->fetch(\n            \"SELECT f.label,f.component_type,f.is_required,f.validation_json\n             FROM form_fields f\n             JOIN form_steps s ON s.id=f.step_id\n             WHERE s.schema_version_id=:version AND s.status='active' AND f.status='active' AND BINARY f.field_key=BINARY :field\n             LIMIT 1\",\n            ['version'=>$schemaVersionId,'field'=>$keys[$purpose]]\n        );\n        if(!$row||!in_array((string)$row['component_type'],['image','image_upload'],true)){\n            return ['active'=>false,'min'=>0,'max'=>20,'label'=>$purpose==='product'?'商品/材料图片':'现场环境/墙面图片'];\n        }\n        $validation=[];\n        if(is_string($row['validation_json']??null)&&$row['validation_json']!==''){\n            $decoded=json_decode((string)$row['validation_json'],true);\n            if(is_array($decoded))$validation=$decoded;\n        }\n        $max=max(1,min(20,(int)($validation['max_items']??20)));\n        $min=min($max,max(!empty($row['is_required'])?1:0,(int)($validation['min_items']??0)));\n        return ['active'=>true,'min'=>$min,'max'=>$max,'label'=>(string)($row['label']?:($purpose==='product'?'商品/材料图片':'现场环境/墙面图片'))];\n    }\n\n    /** @return array{ready:bool,reason:string,purpose:string,required:int,actual:int} */\n    public static function readiness(Database $db,int $orderId,int $schemaVersionId,string $workflowProfile):array\n    {\n        // 与普通订单 finalize 保持一致：测量单不要求施工材料/墙面图片。\n        if($workflowProfile==='measurement')return ['ready'=>true,'reason'=>'','purpose'=>'','required'=>0,'actual'=>0];\n        foreach(['product','wall'] as $purpose){\n            $rule=self::rule($db,$schemaVersionId,$purpose);\n            if(!$rule['active'])continue;\n            $count=(int)$db->fetchValue(\n                \"SELECT COUNT(*) FROM media_links\n                 WHERE entity_type='order' AND entity_id=:order_id AND purpose=:purpose\",\n                ['order_id'=>$orderId,'purpose'=>$purpose]\n            );\n            if($count<$rule['min']){\n                return ['ready'=>false,'reason'=>'“'.$rule['label'].'”至少需要上传 '.$rule['min'].' 张','purpose'=>$purpose,'required'=>$rule['min'],'actual'=>$count];\n            }\n            if($count>$rule['max']){\n                return ['ready'=>false,'reason'=>'“'.$rule['label'].'”最多允许 '.$rule['max'].' 张','purpose'=>$purpose,'required'=>$rule['max'],'actual'=>$count];\n            }\n        }\n        return ['ready'=>true,'reason'=>'','purpose'=>'','required'=>0,'actual'=>0];\n    }\n}\n","server/app/Contracts/OrderNotificationPort.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderNotificationPort\n{\n    public function queue(\n        int $orderId,\n        string $idempotencyKey,\n        string $eventType,\n        array $payload = []\n    ): void;\n}\n","server/app/Contracts/AdminRepairResolutionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\n/** 平台介入后的维修售后裁定端口；不承载退款、赔付或资金处理。 */\ninterface AdminRepairResolutionRepository\n{\n    /**\n     * @param array{channel:string,user_id:int} $operator\n     * @return array<string,mixed>\n     */\n    public function resolve(\n        array $operator,\n        string $orderNo,\n        string $afterSaleNo,\n        string $decision,\n        string $note\n    ): array;\n}\n","server/app/Domain/Messaging/OrderMessageDefinition.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nfinal class OrderMessageDefinition\n{\n    public static function definition(string $type, array $payload): ?array\n    {\n        $meta = MessageEventCatalog::get($type);\n        // 管理员恢复类事件只需要订单进度触达，不自动扩入短信/模板配置目录。\n        if (!$meta && $type === 'worker_replaced_by_admin') {\n            $meta = ['status'=>'平台已改派师傅，等待新师傅确认接单','recipients'=>['user','worker'],'scene'=>'order_status'];\n        }\n        if (!$meta && $type === 'repair_platform_intervention_started') {\n            $meta = ['status'=>'平台已主动介入维修售后','recipients'=>['user','worker'],'scene'=>'order_status'];\n        }\n        if (!$meta || trim((string)($meta['status'] ?? '')) === '' || empty($meta['recipients'])) return null;\n        if (!empty($payload['assisted']) && in_array($type,['completion_submitted','measurement_result_submitted','platform_measurement_result_submitted','platform_measurement_auto_confirmed','repair_worker_completed'],true)) {\n            $meta['status']=$type==='completion_submitted' ? '管理员已补录完工，等待客户验收'\n                : ($type==='repair_worker_completed' ? '管理员已补录维修处理结果' : '管理员已补录测量成果');\n            $meta['recipients']=['user','worker'];\n        }\n        if (!empty($payload['assisted']) && in_array($type, ['appointment_recorded','appointment_waiting_customer_notice','repair_appointment_recorded','repair_waiting_customer_notice'], true)) {\n            $meta['status'] = !empty($payload['wait_customer_notice']) ? '管理员补录联系结果：等待客户另行通知' : '管理员已补录预约';\n            $meta['recipients'] = ['user','worker'];\n        }\n        $amount = null;\n        foreach (['amount_cents','requested_tail_cents','new_amount_cents','added_amount_cents','total_amount_cents','refund_amount_cents'] as $amountKey) {\n            if (isset($payload[$amountKey]) && is_numeric($payload[$amountKey])) { $amount = (int)$payload[$amountKey]; break; }\n        }\n        $recipients = (array)$meta['recipients'];\n        if (isset($payload['notify_recipients']) && is_array($payload['notify_recipients'])) {\n            $requested = array_values(array_unique(array_map('strval', $payload['notify_recipients'])));\n            $recipients = array_values(array_intersect($recipients, $requested));\n        }\n        return [\n            'scene'=>(string)($meta['scene'] ?? 'order_status'),\n            'status'=>(string)$meta['status'],\n            'recipients'=>$recipients,\n            'amount_cents'=>$amount,\n        ];\n    }\n}\n","server/app/Domain/Order/PlatformOrderSettlementPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/**\n * V2.5.0 平台承接单纯金额规则。\n *\n * 不访问数据库、不读取配置、不处理 HTTP，供当前平台履约适配器以及后续统一\n * OrderFulfillment Application 复用，避免 worker_collect / platform_balance 的\n * 金额算法在多个入口各写一份。\n */\nfinal class PlatformOrderSettlementPolicy\n{\n    public const MODE_WORKER_COLLECT = 'worker_collect';\n    public const MODE_PLATFORM_BALANCE = 'platform_balance';\n\n    /**\n     * 兼容现有 extra_income_rate_bp_snapshot 单字段的规则编码。\n     * 0..10000 表示万分比；大于等于该偏移量表示“固定金额”，偏移后的值单位为分。\n     * 这样 V2.5.0 尚未正式运营时无需再拆一套加项结算表，且所有资金算法仍集中在领域层。\n     */\n    public const EXTRA_INCOME_FIXED_OFFSET = 1000000000;\n\n    /**\n     * @return array{booking_paid_cents:int,customer_tail_cents:int,platform_receivable_cents:int,worker_balance_credit_cents:int}\n     */\n    public function settlement(int $customerTotal, int $workerLabor, int $bookingPaid, string $mode): array\n    {\n        if ($customerTotal <= 0 || $workerLabor <= 0) {\n            throw new OrderOperationException('客户金额或师傅工费尚未确认', 'PLATFORM_SETTLEMENT_AMOUNT_REQUIRED', 409);\n        }\n        $this->assertMode($mode);\n\n        $bookingPaid = min($customerTotal, max(0, $bookingPaid));\n        $customerTail = max(0, $customerTotal - $bookingPaid);\n        $platformReceivable = $mode === self::MODE_PLATFORM_BALANCE\n            ? $customerTail\n            : $customerTotal - $workerLabor - $bookingPaid;\n        if ($platformReceivable < 0) {\n            throw new OrderOperationException(\n                '本单会形成负差额，请先与客户加收或处理加价后再验收',\n                'PLATFORM_SETTLEMENT_NEGATIVE',\n                409\n            );\n        }\n\n        return [\n            'booking_paid_cents' => $bookingPaid,\n            'customer_tail_cents' => $customerTail,\n            'platform_receivable_cents' => $platformReceivable,\n            'worker_balance_credit_cents' => $mode === self::MODE_PLATFORM_BALANCE ? $workerLabor : 0,\n        ];\n    }\n\n    /** @return array{platform_share_cents:int,worker_share_cents:int} */\n    public function splitExtraIncome(int $addedAmount, int $platformRuleValue): array\n    {\n        if ($addedAmount <= 0) {\n            throw new OrderOperationException('请输入正确的加价金额', 'PLATFORM_CHANGE_AMOUNT_INVALID', 422);\n        }\n\n        if ($platformRuleValue >= self::EXTRA_INCOME_FIXED_OFFSET) {\n            $fixed = max(0, $platformRuleValue - self::EXTRA_INCOME_FIXED_OFFSET);\n            if ($fixed > $addedAmount) {\n                throw new OrderOperationException('本次加项金额低于本单设置的固定平台收入，请先调整加项金额或平台收入规则', 'PLATFORM_CHANGE_BELOW_FIXED_INCOME', 422);\n            }\n            return [\n                'platform_share_cents' => $fixed,\n                'worker_share_cents' => $addedAmount - $fixed,\n            ];\n        }\n\n        $rate = max(0, min(10000, $platformRuleValue));\n        $platformShare = (int) round($addedAmount * $rate / 10000);\n        return [\n            'platform_share_cents' => $platformShare,\n            'worker_share_cents' => max(0, $addedAmount - $platformShare),\n        ];\n    }\n\n    /** @return array{available_delta_cents:int,frozen_delta_cents:int,entry_type:string} */\n    public function workerBalanceEntry(int $workerBalanceCredit, int $freezeDays): array\n    {\n        $credit = max(0, $workerBalanceCredit);\n        $days = max(0, $freezeDays);\n        return [\n            'available_delta_cents' => $days === 0 ? $credit : 0,\n            'frozen_delta_cents' => $days > 0 ? $credit : 0,\n            'entry_type' => $days === 0 ? 'platform_order_income' : 'platform_order_income_frozen',\n        ];\n    }\n\n    private function assertMode(string $mode): void\n    {\n        if (!in_array($mode, [self::MODE_WORKER_COLLECT, self::MODE_PLATFORM_BALANCE], true)) {\n            throw new OrderOperationException('平台承接单工费结算方式无效', 'PLATFORM_SETTLEMENT_MODE_INVALID', 409);\n        }\n    }\n}\n","server/app/Domain/Messaging/WechatTemplateValue.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\n\n\nfinal class WechatTemplateValue\n{\n\n    public static function format(string $wechatKey,string $value):?string\n    {\n        $value=trim((string)(preg_replace('/[\\x00-\\x1F\\x7F]+/u',' ',$value)??$value));\n        if($value==='')return null;\n        $prefix=strtolower((string)(preg_replace('/\\d+$/','',$wechatKey)??''));\n        if($prefix==='thing')return mb_substr($value,0,20);\n        if($prefix==='name')return mb_substr($value,0,32);\n        if($prefix==='phrase')return mb_substr($value,0,16);\n        if($prefix==='character_string'){\n            $ascii=(string)(preg_replace('/[^A-Za-z0-9_+\\-\\.\\/]/','',$value)??'');\n            return $ascii===''?null:substr($ascii,0,64);\n        }\n        if($prefix==='number'){\n            $number=(string)(preg_replace('/[^0-9.\\-]/','',$value)??'');\n            return $number===''?null:substr($number,0,32);\n        }\n        if($prefix==='letter'){\n            $letters=(string)(preg_replace('/[^A-Za-z]/','',$value)??'');\n            return $letters===''?null:substr($letters,0,32);\n        }\n        if($prefix==='symbol'){\n            $symbols=(string)(preg_replace('/[A-Za-z0-9\\x{4e00}-\\x{9fff}\\s]/u','',$value)??'');\n            return $symbols===''?null:mb_substr($symbols,0,5);\n        }\n        if($prefix==='phone_number'){\n            $phone=(string)(preg_replace('/[^0-9+\\-]/','',$value)??'');\n            return $phone===''?null:substr($phone,0,17);\n        }\n        if($prefix==='car_number')return mb_substr($value,0,12);\n        if($prefix==='amount'){\n            $number=(string)(preg_replace('/[^0-9.]/','',$value)??'');\n            if($number===''||!preg_match('/^\\d{1,8}(?:\\.\\d{1,2})?$/',$number))return null;\n            return '¥'.$number;\n        }\n        if($prefix==='time'){\n            if(preg_match('/(?:^|\\s)([0-2]\\d:[0-5]\\d)(?::[0-5]\\d)?$/',$value,$match)===1)return (string)$match[1];\n            return preg_match('/^([0-2]\\d:[0-5]\\d)(?::[0-5]\\d)?$/',$value,$match)===1?(string)$match[1]:null;\n        }\n        if($prefix==='date'){\n            if(preg_match('/(\\d{4}-[01]\\d-[0-3]\\d)/',$value,$match)===1)return (string)$match[1];\n            return null;\n        }\n        return mb_substr($value,0,20);\n    }\n}\n","server/app/Domain/Messaging/OrderProgressMessageCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\n/** 新订单持久化事件的纯消息目录；渠道是否启用仍由既有配置决定。 */\nfinal class OrderProgressMessageCatalog\n{\n    public static function all(): array\n    {\n        $labels = [\n            'platform_worker_quoted'=>'平台单工费报价待选择','platform_worker_quote_selected'=>'平台已选定成交师傅',\n            'platform_single_grab_accepted'=>'平台单抢单成交','platform_invite_fixed_price_accepted'=>'受邀师傅按工费成交','invite_claimed'=>'受邀师傅待接单',\n            'platform_measurement_auto_confirmed'=>'平台测量成果已确认，待核价','platform_measurement_confirmed'=>'客户确认平台测量成果',\n            'platform_measurement_pricing_reviewed'=>'平台施工核价已完成','platform_measurement_pricing_confirmed'=>'施工价格已确认，可预约',\n            'platform_change_requested'=>'平台单工费/加项待处理','platform_change_accepted'=>'客户已同意平台单加项','platform_change_rejected'=>'客户已拒绝平台单加项',\n            'platform_balance_change_approved'=>'平台工费增项已批准','platform_balance_change_rejected'=>'平台工费增项已驳回',\n            'platform_completion_accepted'=>'平台单已验收','platform_income_received'=>'平台收入款已核实','platform_pricing_quantity_adjusted'=>'实际用量与金额已更新',\n            'assignment_auto_accepted'=>'已报价师傅自动成交',\n        ];\n        $definitions = [\n            'platform_worker_quoted'=>['收到师傅工费报价，请选择成交师傅',['admin'],'order_status',''],\n            'platform_worker_quote_selected'=>['平台已选定成交师傅，请联系预约',['user','worker'],'order_status','worker_assigned'],\n            'platform_single_grab_accepted'=>['师傅已按约定工费成交',['user'],'order_status','worker_assigned'],\n            'platform_invite_fixed_price_accepted'=>['受邀师傅已按约定工费成交',['user'],'order_status','worker_assigned'],\n            'invite_claimed'=>['受邀师傅已领取订单，请确认接单',['worker'],'order_status','worker_assigned'],\n            'platform_measurement_auto_confirmed'=>['测量成果已确认，等待平台核价',['user','admin'],'order_status',''],\n            'platform_measurement_confirmed'=>['测量成果已确认，等待平台核价',['admin'],'order_status',''],\n            // 托管单核价由平台完成后立即生效；reviewed 仅保留内部审计，不再要求客户二次确认。\n            'platform_measurement_pricing_reviewed'=>['平台已完成测量后施工核价',['admin'],'order_status',''],\n            'platform_measurement_pricing_confirmed'=>['施工价格已确认，可以联系客户预约',['worker'],'order_status','worker_order_update'],\n            'platform_change_requested'=>['平台单费用调整待处理',['user','admin'],'order_status','fee_adjustment'],\n            'platform_change_accepted'=>['客户已同意订单外加项',['worker'],'order_status','worker_order_update'],\n            'platform_change_rejected'=>['客户已拒绝订单外加项',['worker'],'order_status','worker_order_update'],\n            'platform_balance_change_approved'=>['平台已批准工费增项',['worker'],'order_status','worker_order_update'],\n            'platform_balance_change_rejected'=>['平台已驳回工费增项',['worker'],'order_status','worker_order_update'],\n            'platform_completion_accepted'=>['平台单已验收，结算金额已生成',['worker'],'order_status',''],\n            'platform_income_received'=>['平台收入款已核实结清',['worker'],'order_status',''],\n            'platform_pricing_quantity_adjusted'=>['实际用量和客户金额已更新',['user'],'order_status',''],\n            'assignment_auto_accepted'=>['客户已选定您的报价，请联系预约',['worker'],'order_status','worker_order_update'],\n        ];\n        $normal = array('platform_worker_quote_selected', 'platform_single_grab_accepted', 'platform_invite_fixed_price_accepted', 'invite_claimed', 'platform_measurement_auto_confirmed', 'platform_measurement_confirmed', 'platform_completion_accepted', 'platform_income_received', 'platform_pricing_quantity_adjusted', 'assignment_auto_accepted');\n        $internal = array('platform_completion_accepted', 'platform_income_received', 'platform_pricing_quantity_adjusted', 'platform_measurement_auto_confirmed', 'platform_measurement_pricing_reviewed');\n        $catalog = [];\n        foreach ($definitions as $key=>$definition) {\n            $recipients=$definition[1]; $isInternal=in_array($key,$internal,true);\n            $fallback=$definition[3]!=='';\n            $catalog[$key]=[\n                'key'=>$key,'label'=>$labels[$key],\n                'priority'=>in_array($key,$normal,true)?'normal':'important',\n                'audience_label'=>in_array('user',$recipients,true)&&in_array('worker',$recipients,true)?'用户、师傅':(in_array('worker',$recipients,true)?'师傅':(in_array('user',$recipients,true)?'用户':'管理员')),\n                'status'=>$definition[0],'recipients'=>$recipients,'scene'=>$definition[2],'subscription_scene'=>$definition[3],\n                'inapp_visible'=>in_array('user',$recipients,true)||in_array('worker',$recipients,true),\n                'internal_only'=>$isInternal,\n                'sms_visible'=>!$isInternal&&(in_array('user',$recipients,true)||in_array('worker',$recipients,true)),\n                'sms_default'=>false,'sms_recommended'=>false,'sms_delivery_mode'=>$fallback?'subscription_fallback':'independent',\n                'sms_subscription_fallback'=>$fallback,'sms_priority'=>'normal',\n                'wecom_visible'=>in_array('admin',$recipients,true),'wecom_default'=>false,\n            ];\n        }\n        return $catalog;\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderDisputeRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderDisputeRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\NegotiationPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderDisputeRepository implements OrderDisputeRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function startNegotiation(array $actor, string $orderNo, string $description, array $evidenceIds): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$description,$evidenceIds): array {\n            $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE', ['public_no'=>$orderNo]);\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能为自己的订单提交异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$order['fulfillment_status'] !== 'submitted' || (string)$order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('只有待确认的服务结果可以提交异议', 'DISPUTE_NOT_ALLOWED', 409);\n            }\n            if (!in_array((string)($order['dispute_status'] ?? 'none'), ['','none','resolved'], true)\n                || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\", ['id'=>$order['id']])) {\n                throw new OrderOperationException('本单已有异议正在处理中', 'DISPUTE_ALREADY_ACTIVE', 409);\n            }\n\n            $params = ['order_id'=>$order['id']];\n            $marks = [];\n            foreach (array_values($evidenceIds) as $index=>$publicId) {\n                $key = 'media_'.$index;\n                $marks[] = ':'.$key;\n                $params[$key] = $publicId;\n            }\n            $mediaRows = $db->fetchAll(\n                \"SELECT m.id,m.public_id FROM media_files m\n                 JOIN media_links l ON l.media_file_id=m.id AND l.entity_type='order' AND l.entity_id=:order_id AND l.purpose='dispute_evidence'\n                 WHERE m.public_id IN (\".implode(',', $marks).\") AND m.status='active'\n                 GROUP BY m.id,m.public_id\",\n                $params\n            );\n            if (count($mediaRows) !== count($evidenceIds)) {\n                throw new OrderOperationException('异议证据图片无效，请重新上传后提交', 'DISPUTE_EVIDENCE_INVALID', 422);\n            }\n\n            $measurement = (string)($order['workflow_profile'] ?? 'construction') === 'measurement';\n            $disputeNo = 'DSP'.gmdate('ymdHis').strtoupper(bin2hex(random_bytes(4)));\n            $disputeId = $db->insert(\n                \"INSERT INTO disputes(public_no,order_id,raised_by_type,raised_by_id,dispute_type,title,description,status,responsibility,refund_amount_cents,run_empty_fee_cents,opened_at,created_at,updated_at)\n                 VALUES(:public_no,:order_id,'user',:user_id,:dispute_type,:title,:description,'negotiating','undetermined',0,0,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_no'=>$disputeNo,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                    'dispute_type'=>$measurement ? 'measurement_result' : 'completion_quality',\n                    'title'=>$measurement ? '测量成果异议协商中' : '完工异议协商中',\n                    'description'=>$description,\n                ]\n            );\n            foreach ($mediaRows as $row) {\n                $db->insert(\n                    \"INSERT INTO dispute_evidence(dispute_id,submitted_by_type,submitted_by_id,evidence_type,description,media_file_id,occurred_at,created_at)\n                     VALUES(:dispute_id,'user',:user_id,'photo',NULL,:media_id,NULL,UTC_TIMESTAMP())\",\n                    ['dispute_id'=>$disputeId,'user_id'=>$actor['user_id'],'media_id'=>$row['id']]\n                );\n            }\n            $db->execute(\n                \"UPDATE orders SET dispute_status='negotiating',publish_status='hidden',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n            $eventKey = $this->event($db, (int)$order['id'], 'dispute_negotiation_started', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$disputeNo,\n                'evidence_count'=>count($mediaRows),\n                'message'=>$measurement\n                    ? '用户提出测量成果异议，自动确认已暂停，请双方先自行沟通处理'\n                    : '用户提出完工异议，自动验收已暂停，请双方先自行沟通处理',\n            ], false);\n            $this->notifyWorkerNegotiation($db, $order, $eventKey, $measurement);\n            return ['id'=>$disputeNo,'status'=>'negotiating','admin_escalated'=>false];\n        });\n    }\n\n    public function escalate(array $actor, string $disputeNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$disputeNo,$note): array {\n            $seed = $db->fetch('SELECT order_id FROM disputes WHERE BINARY public_no=BINARY :no', ['no'=>$disputeNo]);\n            if (!$seed) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            $db->fetch('SELECT id FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $row = $db->fetch(\n                \"SELECT d.*,o.public_no order_no,o.user_id,o.id order_id,o.workflow_profile\n                 FROM disputes d JOIN orders o ON o.id=d.order_id\n                 WHERE BINARY d.public_no=BINARY :public_no FOR UPDATE\",\n                ['public_no'=>$disputeNo]\n            );\n            if (!$row) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            if ((int)$row['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能处理自己的订单异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$row['status'] !== 'negotiating') {\n                throw new OrderOperationException('该异议当前不能重复申请平台介入', 'DISPUTE_ESCALATE_NOT_ALLOWED', 409);\n            }\n            // 2026-10-08：直接 API 与页面使用同一升级条件，不能提交后立即绕过协商。\n            $eligibility = NegotiationPolicy::evaluate(NegotiationPolicy::disputeStatus($row['resolution'] ?? null), $row['opened_at'] ?? null);\n            if (empty($eligibility['eligible'])) {\n                throw new OrderOperationException('请先协商；师傅拒绝或满48小时未解决后才可申请平台介入', 'NEGOTIATION_WAIT_REQUIRED', 409, $eligibility);\n            }\n            if ($note !== '') {\n                $db->insert(\n                    \"INSERT INTO dispute_evidence(dispute_id,submitted_by_type,submitted_by_id,evidence_type,description,media_file_id,occurred_at,created_at)\n                     VALUES(:dispute_id,'user',:user_id,'note',:description,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['dispute_id'=>$row['id'],'user_id'=>$actor['user_id'],'description'=>$note]\n                );\n            }\n            $measurement = (string)($row['workflow_profile'] ?? 'construction') === 'measurement';\n            $db->execute(\n                \"UPDATE disputes SET status='open',title=:title,updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='negotiating'\",\n                ['title'=>$measurement ? '用户申请平台介入测量成果争议' : '用户申请平台介入完工争议','id'=>$row['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET dispute_status='open',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$row['order_id']]\n            );\n            // 平台待办只通过 queueAdminTask 产生一次；订单事件仅通知双方，避免管理员收到两条重复提醒。\n            $eventKey = $this->event($db, (int)$row['order_id'], 'dispute_opened', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$row['public_no'],\n                'dispute_type'=>$row['dispute_type'],\n                'message'=>'双方自行协商未解决，用户已申请平台介入',\n                'reason'=>$note,\n                'notify_recipients'=>['user','worker'],\n            ], true);\n            OrderNotificationService::queueAdminTask(\n                $db,\n                'dispute:'.$row['id'],\n                'completion_dispute_opened',\n                $measurement ? '用户申请平台介入测量成果争议' : '用户申请平台介入完工争议',\n                [\n                    '订单号'=>(string)$row['order_no'],\n                    '争议说明'=>(string)$row['description'],\n                    '补充说明'=>$note,\n                ]\n            );\n            return ['id'=>(string)$row['public_no'],'status'=>'open','admin_escalated'=>true,'event_key'=>$eventKey];\n        });\n    }\n\n    public function resolveByAgreement(array $actor, string $disputeNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$disputeNo,$note): array {\n            $seed = $db->fetch('SELECT order_id FROM disputes WHERE BINARY public_no=BINARY :no', ['no'=>$disputeNo]);\n            if (!$seed) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            $db->fetch('SELECT id FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $row = $db->fetch(\n                \"SELECT d.*,o.user_id,o.id order_id FROM disputes d JOIN orders o ON o.id=d.order_id\n                 WHERE BINARY d.public_no=BINARY :public_no FOR UPDATE\",\n                ['public_no'=>$disputeNo]\n            );\n            if (!$row) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            if ((int)$row['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能处理自己的订单异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$row['status'] !== 'negotiating') {\n                throw new OrderOperationException('平台已经介入或异议已经结束，不能自行关闭', 'DISPUTE_SELF_RESOLVE_NOT_ALLOWED', 409);\n            }\n            $resolution = '双方自行协商解决'.($note !== '' ? '：'.$note : '');\n            $db->execute(\n                \"UPDATE disputes SET status='resolved',responsibility='mutual',resolution=:resolution,resolved_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='negotiating'\",\n                ['resolution'=>$resolution,'id'=>$row['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET dispute_status='resolved',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$row['order_id']]\n            );\n            $this->event($db, (int)$row['order_id'], 'dispute_resolved', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$row['public_no'],\n                'resolution'=>$resolution,\n                'self_resolved'=>1,\n                'notify_recipients'=>['worker'],\n            ], true);\n            return ['id'=>(string)$row['public_no'],'status'=>'resolved','admin_escalated'=>false];\n        });\n    }\n\n    public function resolveByAdmin(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array {\n        $operation = function () use ($operator, $orderNo, $resolution, $responsibility, $refundCents, $runEmptyCents): array {\n            return $this->resolveByAdminUnderWriteGuard($operator, $orderNo, $resolution, $responsibility, $refundCents, $runEmptyCents);\n        };\n        if (($operator['channel'] ?? '') === 'web_admin') {\n            return (new DatabaseDemoOrderWriteGuard($this->db))->run($orderNo, $operation);\n        }\n        return $operation();\n    }\n\n    private function resolveByAdminUnderWriteGuard(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array {\n        $channel = (string)($operator['channel'] ?? '');\n        if ($channel === 'mini_admin') {\n            $operatorId = max(0, (int)($operator['user_id'] ?? 0));\n            $handledBy = null;\n        } elseif ($channel === 'web_admin') {\n            $operatorId = max(0, (int)($operator['admin_user_id'] ?? 0));\n            $handledBy = $operatorId;\n        } else {\n            throw new OrderOperationException('管理员操作来源无效', 'ADMIN_REQUIRED', 403);\n        }\n        if ($operatorId < 1) throw new OrderOperationException('管理员身份无效', 'ADMIN_REQUIRED', 403);\n        $refundCents = max(0, $refundCents);\n        $runEmptyCents = max(0, $runEmptyCents);\n        if ($channel === 'mini_admin' && ($refundCents > 0 || $runEmptyCents > 0)) {\n            throw new OrderOperationException('涉及退款或跑空费金额，请到网页后台处理', 'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED', 409);\n        }\n\n        return $this->db->transaction(function (Database $db) use (\n            $orderNo,$resolution,$responsibility,$refundCents,$runEmptyCents,$channel,$operatorId,$handledBy\n        ): array {\n            $order = $db->fetch(\n                'SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $dispute = $db->fetch(\n                \"SELECT * FROM disputes\n                 WHERE order_id=:order_id AND status IN ('open','processing')\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id']]\n            );\n            if (!$dispute) {\n                throw new OrderOperationException('当前没有待处理争议', 'DISPUTE_ADMIN_NOT_FOUND', 409);\n            }\n            if ($channel === 'mini_admin' && ((int)($dispute['refund_amount_cents'] ?? 0) > 0 || (int)($dispute['run_empty_fee_cents'] ?? 0) > 0)) {\n                throw new OrderOperationException(\n                    '该争议涉及退款或跑空费金额，请到网页后台处理',\n                    'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED',\n                    409\n                );\n            }\n\n            $financial = $refundCents > 0 || $runEmptyCents > 0;\n            $effectiveRefundCents = 0;\n            $autoRefundCents = 0;\n            $allocations = [\n                'refund_cents'=>0,\n                'outstanding_refund_cents'=>0,\n                'succeeded_refund_cents'=>0,\n                'runner_cents'=>0,\n            ];\n            $payment = null;\n            $availableBookingFee = 0;\n\n            if ($financial) {\n                if ($channel !== 'web_admin' || $handledBy === null) {\n                    throw new OrderOperationException('资金争议只能由网页后台裁定', 'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED', 409);\n                }\n                if ($this->isTerminalLifecycle((string)($order['lifecycle_status'] ?? ''))) {\n                    throw new OrderOperationException('已结束订单不能再次分配预约费，请核对已有退款和结算记录', 'DISPUTE_FINANCE_ORDER_CLOSED', 409);\n                }\n                $payment = $db->fetch(\n                    \"SELECT id,amount_cents FROM payment_orders\n                     WHERE order_id=:order_id AND business_type IN ('order_booking','booking_fee') AND status='paid'\n                     ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                    ['order_id'=>$order['id']]\n                );\n                $availableBookingFee = $payment\n                    ? ((int)($order['booking_fee_cents'] ?? 0) > 0\n                        ? min((int)$payment['amount_cents'], (int)$order['booking_fee_cents'])\n                        : (int)$payment['amount_cents'])\n                    : 0;\n                if ($refundCents + $runEmptyCents > $availableBookingFee) {\n                    throw new OrderOperationException('退款与跑空费合计不能超过本单实际支付的预约费', 'DISPUTE_FINANCE_EXCEEDS_BOOKING', 409);\n                }\n                $allocations = $payment\n                    ? $this->bookingFeeAllocations($db, (int)$payment['id'], (int)$order['id'])\n                    : $allocations;\n                if ($allocations['refund_cents'] + $allocations['runner_cents'] + $refundCents + $runEmptyCents > $availableBookingFee) {\n                    throw new OrderOperationException('该支付单已有退款或费用分配，剩余预约费不足', 'DISPUTE_FINANCE_ALREADY_ALLOCATED', 409);\n                }\n\n                // 资金裁定会终止本次履约；未判给师傅且尚未被占用的预约费必须全部回到退款，避免余额悬空。\n                $allocatedAfterDecision = $allocations['refund_cents'] + $allocations['runner_cents'] + $refundCents + $runEmptyCents;\n                $autoRefundCents = max(0, $availableBookingFee - $allocatedAfterDecision);\n                $effectiveRefundCents = $refundCents + $autoRefundCents;\n\n                if ($effectiveRefundCents > 0) {\n                    $db->insert(\n                        \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                         VALUES(:public_no,:payment_id,:order_id,NULL,:amount,:reason,'pending_review',:admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                        [\n                            'public_no'=>\\business_no('RF'),\n                            'payment_id'=>$payment['id'],\n                            'order_id'=>$order['id'],\n                            'amount'=>$effectiveRefundCents,\n                            'reason'=>mb_substr('争议裁定：'.$resolution, 0, 1000),\n                            'admin_id'=>$handledBy,\n                        ]\n                    );\n                }\n\n                if ($runEmptyCents > 0) {\n                    $workerId = !empty($order['assigned_worker_id'])\n                        ? (int)$order['assigned_worker_id']\n                        : (int)$db->fetchValue(\n                            \"SELECT worker_id FROM assignments\n                             WHERE order_id=:order_id\n                             ORDER BY CASE status WHEN 'accepted' THEN 1 WHEN 'completed' THEN 2 WHEN 'cancelled' THEN 3 WHEN 'offered' THEN 4 ELSE 5 END,id DESC\n                             LIMIT 1\",\n                            ['order_id'=>$order['id']]\n                        );\n                    if ($workerId < 1) {\n                        throw new OrderOperationException('订单没有可收取跑空费的师傅，请先核对指派记录', 'DISPUTE_RUN_EMPTY_WORKER_MISSING', 409);\n                    }\n                    $db->execute(\n                        \"INSERT INTO worker_balance_ledger(\n                            worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                            business_type,business_id,idempotency_key,description,status,created_by_admin_id,created_at\n                         ) VALUES(\n                            :worker_id,'run_empty_fee','credit',:amount,:available_delta,0,\n                            'dispute',:dispute_id,:idempotency_key,:description,'effective',:admin_id,UTC_TIMESTAMP()\n                         )\",\n                        [\n                            'worker_id'=>$workerId,\n                            'amount'=>$runEmptyCents,\n                            'available_delta'=>$runEmptyCents,\n                            'dispute_id'=>$dispute['id'],\n                            'idempotency_key'=>'dispute:'.$dispute['id'].':run_empty_fee',\n                            'description'=>mb_substr('争议裁定跑空费：'.$resolution, 0, 1000),\n                            'admin_id'=>$handledBy,\n                        ]\n                    );\n                }\n            }\n\n            $changed = $db->execute(\n                \"UPDATE disputes\n                 SET status='resolved',resolution=:resolution,responsibility=:responsibility,\n                     refund_amount_cents=:refund,run_empty_fee_cents=:runner,handled_by=:handled_by,\n                     resolved_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status IN ('open','processing')\",\n                [\n                    'resolution'=>$resolution,\n                    'responsibility'=>$responsibility,\n                    'refund'=>$effectiveRefundCents,\n                    'runner'=>$runEmptyCents,\n                    'handled_by'=>$handledBy,\n                    'id'=>$dispute['id'],\n                ]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('争议状态已变化，请刷新后重试', 'DISPUTE_ADMIN_CHANGED', 409);\n            }\n\n            if ($financial) {\n                // 取消风控必须在报价/指派失效前捕获原事实，并与争议裁定同一事务提交。\n                (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order, $responsibility, $runEmptyCents);\n                $hasOutstandingRefund = $allocations['outstanding_refund_cents'] + $effectiveRefundCents > 0;\n                $lifecycle = $hasOutstandingRefund ? 'cancel_approved_pending_refund' : 'cancelled';\n                $db->execute(\n                    \"UPDATE orders\n                     SET dispute_status='resolved',lifecycle_status=:lifecycle,publish_status='hidden',quote_status='cancelled',\n                         assignment_status='cancelled',fulfillment_status='cancelled',\n                         refund_status=IF(:has_refund=1,'pending_review',refund_status),\n                         cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),\n                         closed_at=IF(:close_now=1,COALESCE(closed_at,UTC_TIMESTAMP()),closed_at),\n                         updated_at=UTC_TIMESTAMP(),version=version+1\n                     WHERE id=:id\",\n                    [\n                        'lifecycle'=>$lifecycle,\n                        'has_refund'=>$hasOutstandingRefund ? 1 : 0,\n                        'close_now'=>$hasOutstandingRefund ? 0 : 1,\n                        'id'=>$order['id'],\n                    ]\n                );\n                $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=COALESCE(revoked_at,UTC_TIMESTAMP()) WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            } else {\n                $db->execute(\n                    \"UPDATE orders SET dispute_status='resolved',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n            }\n\n            $payload = [\n                'dispute_no'=>(string)$dispute['public_no'],\n                'message'=>'平台争议处理完成：'.$resolution,\n                'resolution'=>$resolution,\n                'responsibility'=>$responsibility,\n                'refund_cents'=>$effectiveRefundCents,\n                'run_empty_fee_cents'=>$runEmptyCents,\n                'auto_refund_cents'=>$autoRefundCents,\n                'operator_channel'=>$channel,\n                'notify_recipients'=>['user','worker'],\n            ];\n            if ($channel === 'mini_admin') $payload['operator_user_id'] = $operatorId;\n            else $payload['operator_admin_id'] = $operatorId;\n            $eventKey = $this->event($db, (int)$order['id'], 'dispute_resolved', $channel, $operatorId, $payload, true);\n\n            return [\n                'id'=>(string)$dispute['public_no'],\n                'status'=>'resolved',\n                'order_id'=>(int)$order['id'],\n                'refund_cents'=>$effectiveRefundCents,\n                'run_empty_fee_cents'=>$runEmptyCents,\n                'auto_refund_cents'=>$autoRefundCents,\n                'event_key'=>$eventKey,\n            ];\n        });\n    }\n\n    /** @return array{refund_cents:int,outstanding_refund_cents:int,succeeded_refund_cents:int,runner_cents:int} */\n    private function bookingFeeAllocations(Database $db, int $paymentId, int $orderId): array\n    {\n        $refundRows = $db->fetchAll(\n            \"SELECT id,amount_cents,status FROM refunds\n             WHERE payment_order_id=:payment_id\n               AND status NOT IN ('failed','closed','cancelled','rejected')\n             FOR UPDATE\",\n            ['payment_id'=>$paymentId]\n        );\n        $refundCents = 0;\n        $outstandingRefundCents = 0;\n        $succeededRefundCents = 0;\n        foreach ($refundRows as $row) {\n            $amount = max(0, (int)$row['amount_cents']);\n            $refundCents += $amount;\n            if ((string)$row['status'] === 'succeeded') $succeededRefundCents += $amount;\n            else $outstandingRefundCents += $amount;\n        }\n\n        $runnerCents = 0;\n        $paymentBusiness = (string)$db->fetchValue('SELECT business_type FROM payment_orders WHERE id=:id', ['id'=>$paymentId]);\n        if ($orderId > 0 && in_array($paymentBusiness, ['order_booking','booking_fee'], true)) {\n            $runnerRows = $db->fetchAll(\n                \"SELECT l.id,l.amount_cents\n                 FROM worker_balance_ledger l\n                 INNER JOIN disputes d ON d.id=l.business_id\n                 WHERE l.business_type='dispute'\n                   AND l.entry_type='run_empty_fee'\n                   AND l.status='effective'\n                   AND d.order_id=:order_id\n                 FOR UPDATE\",\n                ['order_id'=>$orderId]\n            );\n            foreach ($runnerRows as $row) $runnerCents += max(0, (int)$row['amount_cents']);\n        }\n        return [\n            'refund_cents'=>$refundCents,\n            'outstanding_refund_cents'=>$outstandingRefundCents,\n            'succeeded_refund_cents'=>$succeededRefundCents,\n            'runner_cents'=>$runnerCents,\n        ];\n    }\n\n    private function isTerminalLifecycle(string $status): bool\n    {\n        return strpos($status, 'cancel') === 0 || in_array($status, ['completed','closed','expired'], true);\n    }\n\n    private function notifyWorkerNegotiation(Database $db, array $order, string $eventKey, bool $measurement): void\n    {\n        $workerId = (int)($order['assigned_worker_id'] ?? 0);\n        if ($workerId < 1) return;\n        $data = json_encode(['order_id'=>(int)$order['id'],'event_key'=>$eventKey], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        if ($db->fetchValue(\n            \"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='dispute_negotiation_started' AND BINARY data_json=BINARY :data LIMIT 1\",\n            ['worker_id'=>$workerId,'data'=>$data]\n        )) return;\n        $db->insert(\n            \"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at)\n             VALUES(:public_id,'worker',:worker_id,'in_app','dispute_negotiation_started',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            [\n                'public_id'=>\\public_id(),\n                'worker_id'=>$workerId,\n                'title'=>$measurement ? '用户提出测量成果异议' : '用户提出完工异议',\n                'content'=>'订单 '.(string)$order['public_no'].'：用户对'.($measurement ? '测量成果' : '完工结果').'有异议，请先主动联系协商处理；协商不成时用户可再申请平台介入。',\n                'data'=>$data,\n            ]\n        );\n    }\n\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload, bool $notify): string\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey = $type.':'.$orderId.':'.bin2hex(random_bytes(6));\n        $db->insert(\n            'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$eventKey,'actor_type'=>$actorType,'actor_id'=>$actorId,\n                'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        if ($notify) OrderNotificationService::queue($db, $orderId, $eventKey, $type, $payload);\n        return $eventKey;\n    }\n}\n","server/app/Contracts/NotificationProducer.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface NotificationProducer\n{\n    public function queue(int $orderId,string $key,string $type,array $payload=[]):void;\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void;\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void;\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void;\n}\n","server/app/Contracts/OrderNegotiationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderNegotiationRepository\n{\n    public function respond(array $actor, string $orderNo, string $kind, string $reference, string $decision, string $note): array;\n    public function escalate(array $actor, string $orderNo, string $kind, string $reference, string $note): array;\n    public function proposeRefund(array $actor, string $orderNo, string $reference, int $amount, string $note): array;\n    public function withdrawRefund(array $actor, string $orderNo, string $reference, string $note): array;\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderRepairInterventionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderRepairInterventionRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\RepairInterventionPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderRepairInterventionRepository implements OrderRepairInterventionRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function request(array $actor, string $orderNo, string $afterSaleNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$afterSaleNo,$note): array {\n            $order = $db->fetch(\n                'SELECT id,public_no,user_id,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能为自己的维修申请平台介入', 'FORBIDDEN', 403);\n            }\n\n            $repair = $db->fetch(\n                \"SELECT id,public_no,status,resolution,opened_at\n                 FROM after_sales\n                 WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair'\n                 LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id'],'public_no'=>$afterSaleNo]\n            );\n            if (!$repair || !in_array((string)$repair['status'], ['open','processing'], true)) {\n                throw new OrderOperationException('维修申请不存在或已结束', 'REPAIR_NOT_ACTIVE', 409);\n            }\n\n            $eligibility = RepairInterventionPolicy::evaluate(\n                (string)$repair['status'],\n                $repair['resolution'] === null ? null : (string)$repair['resolution'],\n                $repair['opened_at'] === null ? null : (string)$repair['opened_at'],\n                'UTC'\n            );\n            if (!$eligibility['eligible']) {\n                if ((string)$eligibility['reason'] === 'already_escalated') {\n                    throw new OrderOperationException('已经申请平台介入，请勿重复提交', 'REPAIR_INTERVENTION_ALREADY_REQUESTED', 409);\n                }\n                $availableAt = (string)($eligibility['available_at'] ?? '');\n                throw new OrderOperationException(\n                    $availableAt !== ''\n                        ? '请先与师傅沟通处理；师傅未明确拒绝时，维修申请满 48 小时后（'.$availableAt.'）才可申请平台介入'\n                        : '请先与师傅沟通处理；师傅明确拒绝或维修申请满 48 小时后才可申请平台介入',\n                    'REPAIR_INTERVENTION_WAIT_REQUIRED',\n                    409,\n                    ['available_at'=>$availableAt,'wait_hours'=>RepairInterventionPolicy::WAIT_HOURS]\n                );\n            }\n\n            $resolution = '用户申请平台介入'.($note !== '' ? '：'.$note : '');\n            $db->execute(\n                \"UPDATE after_sales SET status='processing',resolution=:resolution,updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                ['resolution'=>$resolution,'id'=>$repair['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n\n            $eventKey = 'repair_platform_intervention_requested:'.$order['id'].':'.bin2hex(random_bytes(6));\n            $payload = [\n                'after_sale_id'=>(string)$repair['public_no'],\n                'message'=>'用户申请平台介入维修',\n                'note'=>$note,\n                'notify_recipients'=>['worker'],\n            ];\n            $db->insert(\n                'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,\\'user\\',:actor_id,:payload,UTC_TIMESTAMP())',\n                [\n                    'order_id'=>$order['id'],'type'=>'repair_platform_intervention_requested','event_key'=>$eventKey,\n                    'actor_id'=>$actor['user_id'],'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n                ]\n            );\n            OrderNotificationService::queue($db, (int)$order['id'], $eventKey, 'repair_platform_intervention_requested', $payload);\n            OrderNotificationService::queueAdminTask(\n                $db,\n                'after-sales:'.$repair['public_no'].':user-escalated',\n                'repair_platform_intervention_requested',\n                '用户申请平台介入维修',\n                ['订单号'=>(string)$order['public_no'],'售后编号'=>(string)$repair['public_no'],'用户说明'=>$note]\n            );\n\n            return [\n                'after_sale_id'=>(string)$repair['public_no'],\n                'status'=>'processing',\n                'intervention_reason'=>(string)$eligibility['reason'],\n            ];\n        });\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCancellationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderCancellationRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderCancellationRepository implements OrderCancellationRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function request(array $actor, string $orderNo, string $reason, string $reasonCode): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reason,$reasonCode): array {\n            $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE', ['public_no'=>$orderNo]);\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能取消自己的订单', 'FORBIDDEN', 403);\n            }\n            if ((string)$order['payment_status'] !== 'paid') {\n                throw new OrderOperationException('预约费尚未支付，不存在可退款款项；如不需要该订单可直接保留未付款状态', 'REFUND_NOT_AVAILABLE_BEFORE_PAYMENT', 409);\n            }\n            if ((string)$order['lifecycle_status'] !== 'active' || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                throw new OrderOperationException('该订单当前不能申请退款并取消订单', 'ORDER_NOT_CANCELLABLE', 409);\n            }\n            if ($db->fetchValue(\n                \"SELECT id FROM order_cancel_requests WHERE order_id=:id AND status IN ('pending','processing','approved') AND closed_at IS NULL LIMIT 1 FOR UPDATE\",\n                ['id'=>$order['id']]\n            )) {\n                throw new OrderOperationException('已经存在待处理的取消申请', 'CANCEL_REQUEST_ALREADY_OPEN', 409);\n            }\n\n            $payments = $this->refundablePayments($db, $order);\n            $refundAmount = array_sum(array_map(static function (array $row): int { return (int)$row['available_cents']; }, $payments));\n            $auto = $refundAmount > 0 && $this->canAutoApproveBeforeService($db, $order);\n            $requestPublicId = \\public_id();\n\n            if (!$auto) {\n                $db->insert(\n                    \"INSERT INTO order_cancel_requests(public_id,order_id,applicant_type,applicant_id,request_type,order_state_snapshot_json,reason_code,reason,status,requested_refund_cents,requested_at,created_at,updated_at)\n                     VALUES(:public_id,:order_id,'user',:user_id,'cancel_refund',:snapshot,:reason_code,:reason,'pending',:refund,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_id'=>$requestPublicId,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                        'snapshot'=>$this->snapshot($order),'reason_code'=>!empty($order['assigned_worker_id']) ? 'bilateral_refund_pending' : $reasonCode,'reason'=>$reason,'refund'=>$refundAmount,\n                    ]\n                );\n                $db->execute(\n                    \"UPDATE orders SET refund_status='pending_review',publish_status='hidden',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n                $this->event($db, (int)$order['id'], 'cancel_requested', 'user', (int)$actor['user_id'], [\n                    'requested_refund_cents'=>$refundAmount,\n                    'notify_recipients'=>!empty($order['assigned_worker_id']) ? ['worker'] : ['admin'],\n                    'message'=>!empty($order['assigned_worker_id']) ? '用户提出退款方案，请师傅先接受或拒绝；方案金额 ¥'.number_format($refundAmount/100, 2) : '用户申请退款取消，当前可退线上实收合计 ¥'.number_format($refundAmount/100, 2),\n                ]);\n                return ['request_id'=>$requestPublicId,'auto_approved'=>false,'bilateral_negotiation'=>!empty($order['assigned_worker_id']),'refund_cents'=>$refundAmount,'refund_count'=>0];\n            }\n\n            $requestId = $db->insert(\n                \"INSERT INTO order_cancel_requests(public_id,order_id,applicant_type,applicant_id,request_type,order_state_snapshot_json,reason_code,reason,status,requested_refund_cents,requested_at,created_at,updated_at)\n                 VALUES(:public_id,:order_id,'user',:user_id,'cancel_refund',:snapshot,'pre_service_auto_refund',:reason,'approved',:refund,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_id'=>$requestPublicId,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                    'snapshot'=>$this->snapshot($order),'reason'=>$reason,'refund'=>$refundAmount,\n                ]\n            );\n\n            return $this->approveRefund($db, $order, $requestId, $requestPublicId, $payments, $refundAmount, $reason, (int)$actor['user_id']);\n        });\n    }\n\n\n    // 2026-10-08：接受方案时锁内复核对方身份和资金；复用未成交自动退款的同一执行器。\n    public function approveByAgreement(array $actor, string $requestNo): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$requestNo): array {\n            $seed = $db->fetch('SELECT order_id FROM order_cancel_requests WHERE BINARY public_id=BINARY :no', ['no'=>$requestNo]);\n            if (!$seed) throw new OrderOperationException('退款方案不存在', 'REFUND_PROPOSAL_NOT_FOUND', 404);\n            $order = $db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE BINARY public_id=BINARY :no FOR UPDATE', ['no'=>$requestNo]);\n            $isWorker = (string)$request['applicant_type'] === 'user' && (int)($actor['worker_id'] ?? 0) > 0 && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n            $isUser = (string)$request['applicant_type'] === 'worker' && (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n            if (!$isWorker && !$isUser) throw new OrderOperationException('只能由方案的另一方接受', 'FORBIDDEN', 403);\n            if ((string)$request['status'] !== 'pending' || (string)$request['reason_code'] !== 'bilateral_refund_pending'\n                || (string)$order['lifecycle_status'] !== 'active' || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                throw new OrderOperationException('方案已经响应或订单状态已变化', 'REFUND_PROPOSAL_NOT_PENDING', 409);\n            }\n            $assignment = $db->fetch(\"SELECT id FROM assignments WHERE id=:id AND order_id=:order AND worker_id=:worker AND status='accepted' FOR UPDATE\", ['id'=>$order['current_assignment_id'] ?: 0,'order'=>$order['id'],'worker'=>$order['assigned_worker_id']]);\n            if (!$assignment) throw new OrderOperationException('成交师傅关系已变化', 'ASSIGNMENT_CHANGED', 409);\n            $payments = $this->refundablePayments($db, $order);\n            $amount = array_sum(array_column($payments, 'available_cents'));\n            // 已同意不等于能够随意分配资金：平台工费/跑空费/争议/已入账收入保持既有财务核验。\n            $blocked = (string)$order['order_source_type'] === 'platform' || $amount !== (int)$request['requested_refund_cents'] || $amount < 1\n                || !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                || (bool)$db->fetchValue(\"SELECT id FROM run_empty_fee_claims WHERE order_id=:id AND status NOT IN ('cancelled') LIMIT 1\", ['id'=>$order['id']])\n                || (bool)$db->fetchValue(\"SELECT l.id FROM worker_balance_ledger l WHERE l.status='effective' AND ((l.business_type IN ('order','platform_order','measurement_order','order_measurement') AND l.business_id=:id) OR (l.business_type='commission' AND l.business_id IN (SELECT id FROM commission_receivables WHERE order_id=:id)) OR (l.business_type='dispute' AND l.business_id IN (SELECT id FROM disputes WHERE order_id=:id))) LIMIT 1\", ['id'=>$order['id']]);\n            if ($blocked) {\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_execution_required',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n                // 双方已经接受取消/退款方案时，业务履约立即终止；这里只等待资金核账，不允许订单继续施工。\n                $db->execute(\n                    \"UPDATE orders\n                     SET lifecycle_status='cancel_approved_pending_refund',refund_status='pending_review',publish_status='hidden',\n                         quote_status='cancelled',assignment_status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),\n                         version=version+1,updated_at=UTC_TIMESTAMP()\n                     WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n                $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n                $this->event($db, (int)$order['id'], 'cancel_requested', $isWorker ? 'worker' : 'user', $isWorker ? (int)$actor['worker_id'] : (int)$actor['user_id'], [\n                    'message'=>'双方已接受退款方案，订单已停止履约；涉及资金分配或可退金额变化，需平台核账后执行退款','notify_recipients'=>['user','worker','admin'],\n                ]);\n                return ['request_id'=>$requestNo,'agreement_accepted'=>true,'execution_requires_platform'=>true];\n            }\n            $db->execute(\"UPDATE order_cancel_requests SET status='approved',reason_code='bilateral_refund_accepted',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n            return $this->approveRefund($db, $order, (int)$request['id'], $requestNo, $payments, $amount, '双方接受退款方案：'.$request['reason'], (int)$order['user_id'], true);\n        });\n    }\n\n    private function approveRefund(Database $db, array $order, int $requestId, string $requestPublicId, array $payments, int $refundAmount, string $reason, int $userId, bool $agreed = false): array\n    {\n            $refundIds = [];\n            $firstRefundId = null;\n            foreach ($payments as $payment) {\n                $amount = (int)$payment['available_cents'];\n                if ($amount < 1) continue;\n                $refundId = $db->insert(\n                    \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                     VALUES(:public_no,:payment_id,:order_id,:request_id,:amount,:reason,'pending_review',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_no'=>\\business_no('RF'),'payment_id'=>$payment['id'],'order_id'=>$order['id'],'request_id'=>$requestId,\n                        'amount'=>$amount,'reason'=>mb_substr('自动取消退款：'.$reason.'；原支付：'.(string)$payment['business_type'], 0, 1000),\n                    ]\n                );\n                if ($firstRefundId === null) $firstRefundId = $refundId;\n                $refundIds[] = $refundId;\n            }\n            if (!$refundIds) {\n                throw new OrderOperationException('当前没有可自动原路退款的实际支付，请转人工核对', 'AUTO_REFUND_PAYMENT_MISSING', 409);\n            }\n\n            // 2026-10-08：取消成立时保存失效前的报价/成交事实，与取消退款同事务提交。\n            (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order);\n\n            $db->execute(\n                \"UPDATE orders SET lifecycle_status='cancel_approved_pending_refund',refund_status='pending_review',publish_status='hidden',quote_status='cancelled',assignment_status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n            $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            $db->insert(\n                \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                 VALUES(:request_id,:order_id,'approved','user',:reason,:refund,0,:refund_id,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'request_id'=>$requestId,'order_id'=>$order['id'],\n                    'reason'=>mb_substr('系统执行已获准退款；原因：'.$reason, 0, 1000),\n                    'refund'=>$refundAmount,'refund_id'=>$firstRefundId,\n                ]\n            );\n            $this->event($db, (int)$order['id'], 'cancel_approved', 'system', 0, [\n                'refund_amount_cents'=>$refundAmount,'refund_count'=>count($refundIds),'auto_approved'=>1,\n                'requested_by_user_id'=>$userId,\n                'message'=>'系统已取消订单并登记 '.count($refundIds).' 笔原路退款，无需管理员审核',\n                'notify_recipients'=>$agreed ? ['user','worker'] : ['user'],\n            ]);\n            return ['request_id'=>$requestPublicId,'auto_approved'=>true,'refund_cents'=>$refundAmount,'refund_count'=>count($refundIds)];\n    }\n\n    public function review(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array {\n        $operation = function () use ($operator, $orderNo, $decision, $workerArrived, $responsibility, $reason, $refundCents): array {\n            return $this->reviewUnderWriteGuard($operator, $orderNo, $decision, $workerArrived, $responsibility, $reason, $refundCents);\n        };\n        if (($operator['channel'] ?? '') === 'web_admin') {\n            return (new DatabaseDemoOrderWriteGuard($this->db))->run($orderNo, $operation);\n        }\n        return $operation();\n    }\n\n    private function reviewUnderWriteGuard(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array {\n        $channel = (string)($operator['channel'] ?? '');\n        if ($channel === 'mini_admin') {\n            $operatorId = max(0, (int)($operator['user_id'] ?? 0));\n            $webAdminId = 0;\n        } elseif ($channel === 'web_admin') {\n            $operatorId = max(0, (int)($operator['admin_user_id'] ?? 0));\n            $webAdminId = $operatorId;\n        } else {\n            $operatorId = 0;\n            $webAdminId = 0;\n        }\n        if ($operatorId < 1) {\n            throw new OrderOperationException('管理员操作来源无效', 'ADMIN_REQUIRED', 403);\n        }\n        $decidedBy = $webAdminId > 0 ? $webAdminId : null;\n\n        return $this->db->transaction(function (Database $db) use ($orderNo,$decision,$workerArrived,$responsibility,$reason,$refundCents,$channel,$operatorId,$decidedBy): array {\n            $order = $db->fetch(\n                'SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $request = $db->fetch(\n                \"SELECT * FROM order_cancel_requests\n                 WHERE order_id=:order_id AND status='pending'\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id']]\n            );\n            if (!$request) {\n                throw new OrderOperationException('当前没有待审核退款申请', 'REFUND_REVIEW_CHANGED', 409);\n            }\n            if (in_array((string)$request['reason_code'], ['bilateral_refund_pending','bilateral_refund_rejected'], true)) {\n                throw new OrderOperationException('请先由订单双方申请平台介入', 'NEGOTIATION_NOT_ESCALATED', 409);\n            }\n            if ((string)$request['reason_code'] === 'bilateral_refund_execution_required') {\n                throw new OrderOperationException(\n                    '双方已经接受退款方案；当前涉及资金核账或历史入账，请到 Web 后台按真实资金记录执行，不能在小程序重新通过或拒绝',\n                    'REFUND_EXECUTION_WEB_REQUIRED',\n                    409\n                );\n            }\n\n            $needsArrival = !empty($order['assigned_worker_id'])\n                || in_array((string)($order['assignment_status'] ?? ''), ['offered','accepted','assigned'], true)\n                || in_array((string)($order['fulfillment_status'] ?? ''), ['scheduled','in_progress'], true);\n            if (!$needsArrival) $workerArrived = 'no';\n            if ($needsArrival && !in_array($workerArrived, ['yes','no'], true)) {\n                throw new OrderOperationException('请确认师傅是否已经上门', 'WORKER_ARRIVAL_REQUIRED', 422);\n            }\n            $responsibilityLabels = [\n                'worker'=>'师傅','user'=>'用户','platform'=>'平台','shared'=>'双方','unclear'=>'待定',\n            ];\n            $decisionReason = ($workerArrived === 'yes' ? '师傅已上门' : '师傅未上门')\n                .'；责任：'.$responsibilityLabels[$responsibility].'；'.$reason;\n\n            if ($decision === 'reject') {\n                $changed = $db->execute(\n                    \"UPDATE order_cancel_requests\n                     SET status='rejected',closed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                     WHERE id=:id AND status='pending'\",\n                    ['id'=>$request['id']]\n                );\n                if ($changed !== 1) {\n                    throw new OrderOperationException('退款申请状态已变化，请刷新', 'REFUND_REVIEW_CHANGED', 409);\n                }\n                $hasMeasurementLink = (bool)$db->fetchValue(\n                    \"SELECT 1 FROM order_relations\n                     WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1\",\n                    ['id'=>$order['id']]\n                );\n                $snapshot = $this->decodeSnapshot((string)($request['order_state_snapshot_json'] ?? ''));\n                $restorePublish = (string)($snapshot['publish_status'] ?? 'hidden');\n                if (!in_array($restorePublish, ['published','hidden'], true)) $restorePublish = 'hidden';\n                if ($hasMeasurementLink) $restorePublish = 'hidden';\n                $restoreRefund = (string)($snapshot['refund_status'] ?? 'none');\n                if (!in_array($restoreRefund, ['','none','failed'], true)) $restoreRefund = 'none';\n                if ($restoreRefund === '') $restoreRefund = 'none';\n                $db->execute(\n                    \"UPDATE orders\n                     SET refund_status=:refund_status,publish_status=:publish_status,\n                         updated_at=UTC_TIMESTAMP(),version=version+1\n                     WHERE id=:id\",\n                    [\n                        'refund_status'=>$restoreRefund,\n                        'publish_status'=>$restorePublish,\n                        'id'=>$order['id'],\n                    ]\n                );\n                $db->insert(\n                    \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                     VALUES(:request_id,:order_id,'rejected',:responsibility,:reason,0,0,NULL,:decided_by,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'request_id'=>$request['id'],'order_id'=>$order['id'],\n                        'responsibility'=>$responsibility,'reason'=>$decisionReason,'decided_by'=>$decidedBy,\n                    ]\n                );\n                $this->event($db, (int)$order['id'], 'cancel_rejected', $channel, $operatorId, [\n                    'message'=>'退款申请未通过：'.$decisionReason,\n                    'restored_publish_status'=>$restorePublish,\n                    'operator_channel'=>$channel,\n                    'operator_user_id'=>$channel === 'mini_admin' ? $operatorId : null,\n                    'operator_admin_id'=>$channel === 'web_admin' ? $operatorId : null,\n                    'notify_recipients'=>['user'],\n                ]);\n                return ['approved'=>false,'refund_cents'=>0,'refund_ids'=>[]];\n            }\n\n            if ($workerArrived === 'yes' && $responsibility !== 'worker') {\n                throw new OrderOperationException(\n                    '师傅已上门且不是师傅责任时，请拒绝退款并记录说明',\n                    'REFUND_ARRIVAL_RESPONSIBILITY_CONFLICT',\n                    422\n                );\n            }\n\n            $payments = $this->refundablePayments($db, $order);\n            $available = array_sum(array_map(static function (array $row): int {\n                return (int)$row['available_cents'];\n            }, $payments));\n            $requested = max(0, (int)$request['requested_refund_cents']);\n            $maxRefund = $requested > 0 ? min($available, $requested) : $available;\n            if ($maxRefund > 0 && $refundCents < 1) {\n                throw new OrderOperationException('请填写退款金额', 'REFUND_AMOUNT_REQUIRED', 422);\n            }\n            if ($refundCents > $maxRefund) {\n                throw new OrderOperationException(\n                    '退款金额超过当前可退线上余额 '.number_format($maxRefund/100, 2).' 元',\n                    'REFUND_AMOUNT_EXCEEDS_AVAILABLE',\n                    422,\n                    ['max_refund_cents'=>$maxRefund]\n                );\n            }\n\n            $remaining = $refundCents;\n            $refundIds = [];\n            $firstRefundId = null;\n            foreach ($payments as $payment) {\n                if ($remaining <= 0) break;\n                $part = min($remaining, (int)$payment['available_cents']);\n                if ($part < 1) continue;\n                $refundId = $db->insert(\n                    \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                     VALUES(:public_no,:payment_id,:order_id,:request_id,:amount,:reason,'pending_review',:requested_by_admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_no'=>\\business_no('RF'),\n                        'payment_id'=>$payment['id'],\n                        'order_id'=>$order['id'],\n                        'request_id'=>$request['id'],\n                        'amount'=>$part,\n                        'reason'=>$decisionReason.'；原支付：'.(string)$payment['business_type'],\n                        'requested_by_admin_id'=>$decidedBy,\n                    ]\n                );\n                if ($firstRefundId === null) $firstRefundId = $refundId;\n                $refundIds[] = $refundId;\n                $remaining -= $part;\n            }\n            if ($remaining > 0) {\n                throw new OrderOperationException(\n                    '退款拆分失败，当前原支付可退余额不足，请刷新后重试',\n                    'REFUND_SPLIT_BALANCE_CHANGED',\n                    409\n                );\n            }\n\n            // 先抢占 pending 取消申请，再推进订单；网络重试或并发请求只能有一个事务成功。\n            $requestChanged = $db->execute(\n                \"UPDATE order_cancel_requests\n                 SET status=:status,requested_refund_cents=:refund,\n                     closed_at=IF(:close_now=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='pending'\",\n                [\n                    'status'=>$refundCents > 0 ? 'processing' : 'approved',\n                    'refund'=>$refundCents,\n                    'close_now'=>$refundCents > 0 ? 0 : 1,\n                    'id'=>$request['id'],\n                ]\n            );\n            if ($requestChanged !== 1) {\n                throw new OrderOperationException('退款申请状态已变化，请刷新', 'REFUND_REVIEW_CHANGED', 409);\n            }\n\n            $lifecycle = $refundCents > 0 ? 'cancel_approved_pending_refund' : 'cancelled';\n            (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order, $responsibility);\n            $refundStatus = $refundCents > 0 ? 'pending_review' : 'none';\n            $db->execute(\n                \"UPDATE orders\n                 SET lifecycle_status=:lifecycle,refund_status=:refund_status,publish_status='hidden',\n                     quote_status='cancelled',assignment_status='cancelled',cancelled_at=UTC_TIMESTAMP(),\n                     closed_at=IF(:close_now=1,COALESCE(closed_at,UTC_TIMESTAMP()),closed_at),\n                     updated_at=UTC_TIMESTAMP(),version=version+1\n                 WHERE id=:id\",\n                [\n                    'lifecycle'=>$lifecycle,'refund_status'=>$refundStatus,\n                    'close_now'=>$refundCents > 0 ? 0 : 1,'id'=>$order['id'],\n                ]\n            );\n            $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            $db->insert(\n                \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                 VALUES(:request_id,:order_id,'approved',:responsibility,:reason,:refund,0,:refund_id,:decided_by,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'request_id'=>$request['id'],'order_id'=>$order['id'],'responsibility'=>$responsibility,\n                    'reason'=>$decisionReason,'refund'=>$refundCents,'refund_id'=>$firstRefundId,'decided_by'=>$decidedBy,\n                ]\n            );\n            $this->event($db, (int)$order['id'], 'cancel_approved', $channel, $operatorId, [\n                'refund_amount_cents'=>$refundCents,\n                'refund_count'=>count($refundIds),\n                'message'=>$refundCents > 0\n                    ? '退款审核通过，已按原支付单拆分为 '.count($refundIds).' 笔微信退款'\n                    : '取消申请通过，无线上款项需退',\n                'operator_channel'=>$channel,\n                'operator_user_id'=>$channel === 'mini_admin' ? $operatorId : null,\n                'operator_admin_id'=>$channel === 'web_admin' ? $operatorId : null,\n                'notify_recipients'=>['user'],\n            ]);\n            return ['approved'=>true,'refund_cents'=>$refundCents,'refund_ids'=>$refundIds];\n        });\n    }\n\n    /** @return array<int,array<string,mixed>> */\n    private function refundablePayments(Database $db, array $order): array\n    {\n        $measurement = (string)($order['workflow_profile'] ?? 'construction') === 'measurement';\n        $types = $measurement ? ['order_booking','booking_fee','measurement_balance','measurement_change'] : ['order_booking','booking_fee'];\n        $marks = [];\n        $params = ['order_id'=>$order['id']];\n        foreach ($types as $index=>$type) {\n            $key = 'type_'.$index;\n            $marks[] = ':'.$key;\n            $params[$key] = $type;\n        }\n        $rows = $db->fetchAll(\n            \"SELECT * FROM payment_orders WHERE order_id=:order_id AND business_type IN (\".implode(',', $marks).\") AND status IN ('paid','refunded')\n             ORDER BY CASE business_type WHEN 'measurement_change' THEN 1 WHEN 'measurement_balance' THEN 2 WHEN 'booking_fee' THEN 3 WHEN 'order_booking' THEN 4 ELSE 9 END,id DESC FOR UPDATE\",\n            $params\n        );\n        $runnerRemaining = (int)$db->fetchValue(\n            \"SELECT COALESCE(SUM(l.amount_cents),0) FROM worker_balance_ledger l\n             INNER JOIN disputes d ON d.id=l.business_id\n             WHERE l.business_type='dispute' AND l.entry_type='run_empty_fee' AND l.status='effective' AND d.order_id=:order_id\",\n            ['order_id'=>$order['id']]\n        );\n        $result = [];\n        foreach ($rows as $row) {\n            $refundAllocated = (int)$db->fetchValue(\n                \"SELECT COALESCE(SUM(amount_cents),0) FROM refunds WHERE payment_order_id=:payment_id AND status NOT IN ('failed','closed','cancelled','rejected')\",\n                ['payment_id'=>$row['id']]\n            );\n            $cap = max(0, (int)$row['amount_cents']);\n            if (in_array((string)$row['business_type'], ['order_booking','booking_fee'], true)) {\n                if ((int)($order['booking_fee_cents'] ?? 0) > 0) $cap = min($cap, (int)$order['booking_fee_cents']);\n                $runnerApplied = min($cap, max(0, $runnerRemaining));\n                $runnerRemaining = max(0, $runnerRemaining - $runnerApplied);\n            } else {\n                $runnerApplied = 0;\n            }\n            $available = max(0, $cap - $refundAllocated - $runnerApplied);\n            if ($available < 1) continue;\n            $row['available_cents'] = $available;\n            $result[] = $row;\n        }\n        return $result;\n    }\n\n    private function canAutoApproveBeforeService(Database $db, array $order): bool\n    {\n        if ((string)($order['order_source_type'] ?? 'consumer') !== 'consumer') return false;\n        if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) return false;\n        if (!empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) return false;\n        if (!empty($order['contact_revealed_at']) || !empty($order['completion_submitted_at']) || !empty($order['accepted_at'])) return false;\n        if (in_array((string)($order['fulfillment_status'] ?? ''), ['scheduled','in_progress','submitted','accepted'], true)) return false;\n\n        $blocked = (int)$db->fetchValue(\n            \"SELECT (\n                EXISTS(SELECT 1 FROM assignments WHERE order_id=:a LIMIT 1)\n                OR EXISTS(SELECT 1 FROM quote_selections WHERE order_id=:q LIMIT 1)\n                OR EXISTS(SELECT 1 FROM appointment_records WHERE order_id=:ap LIMIT 1)\n                OR EXISTS(SELECT 1 FROM change_requests WHERE order_id=:c LIMIT 1)\n                OR EXISTS(SELECT 1 FROM disputes WHERE order_id=:d LIMIT 1)\n                OR EXISTS(SELECT 1 FROM after_sales WHERE order_id=:s LIMIT 1)\n                OR EXISTS(SELECT 1 FROM run_empty_fee_claims WHERE order_id=:r LIMIT 1)\n            ) AS blocked\",\n            ['a'=>$order['id'],'q'=>$order['id'],'ap'=>$order['id'],'c'=>$order['id'],'d'=>$order['id'],'s'=>$order['id'],'r'=>$order['id']]\n        );\n        return $blocked === 0;\n    }\n\n    /** @return array<string,mixed> */\n    private function decodeSnapshot(string $json): array\n    {\n        $decoded = json_decode($json, true);\n        return is_array($decoded) ? $decoded : [];\n    }\n\n    private function snapshot(array $order): string\n    {\n        $json = json_encode([\n            'lifecycle_status'=>$order['lifecycle_status'] ?? null,\n            'fulfillment_status'=>$order['fulfillment_status'] ?? null,\n            'payment_status'=>$order['payment_status'] ?? null,\n            'workflow_profile'=>$order['workflow_profile'] ?? null,\n            'order_source_type'=>$order['order_source_type'] ?? null,\n            'refund_status'=>$order['refund_status'] ?? null,\n            'publish_status'=>$order['publish_status'] ?? null,\n            'quote_status'=>$order['quote_status'] ?? null,\n            'assignment_status'=>$order['assignment_status'] ?? null,\n            'selected_quote_id'=>$order['selected_quote_id'] ?? null,\n            'assigned_worker_id'=>$order['assigned_worker_id'] ?? null,\n        ], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        return is_string($json) ? $json : '{}';\n    }\n\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey = $type.':'.$orderId.':'.bin2hex(random_bytes(6));\n        $db->insert(\n            'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$eventKey,'actor_type'=>$actorType,\n                'actor_id'=>$actorId > 0 ? $actorId : null,\n                'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        OrderNotificationService::queue($db, $orderId, $eventKey, $type, $payload);\n    }\n}\n","server/app/Infrastructure/Messaging/OrderNotificationProjector.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\OrderMessageDefinition;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\nuse WorkerAdmin\\Infrastructure\\Testing\\TestMessageProjectionRecorder;\n\nfinal class OrderNotificationProjector\n{\n\n    public static function queueAdminTask(Database $db,string $eventKey,string $eventType,string $title,array $lines=[]):void\n    {\n        // 与订单事件的 demo 隔离保持一致：带订单号的演示/测试订单绝不能进入真实企业微信管理员待办。\n        // 无订单号的入驻、提现等独立业务仍沿用原有通知逻辑。\n        $orderNo=trim((string)($lines['订单号']??''));\n        if($orderNo!==''){\n            $isDemo=(int)$db->fetchValue('SELECT COALESCE(is_demo,0) FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);\n            if($isDemo===1)return;\n        }\n        if(!self::eventEnabled('wecom.event_switches',$eventType)||!\\filter_var(\\setting('wecom.webhook_enabled',false),FILTER_VALIDATE_BOOLEAN))return;\n        // 2026-09-22：机器人首行直接显示具体事项标题，不再套“壁选后台待办”等笼统标题。\n        $title=trim((string)(preg_replace('/[\\\\r\\\\n【】]+/u',' ',$title)??''));\n        if($title==='')$title=$eventType;\n        $title=mb_substr($title,0,40);\n        $content='【'.$title.'】';\n        foreach($lines as $label=>$value){$value=trim((string)$value);if($value!=='')$content.=\"\\n\".$label.'：'.$value;}\n        $orderId=0;\n        if(isset($lines['订单号'])&&trim((string)$lines['订单号'])!==''){\n            $orderId=(int)$db->fetchValue('SELECT id FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>(string)$lines['订单号']]);\n        }\n        $data=['content'=>$content,'event_type'=>$eventType,'title'=>$title,'action_path'=>self::adminActionPath($eventType,$orderId)];\n        $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wecom_webhook',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':admin:wecom',0,128),'payload'=>json_encode($data,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n    }\n\n    public static function queue(Database $db, int $orderId, string $eventKey, string $eventType, array $payload = []): void\n    {\n        $definition = OrderMessageDefinition::definition($eventType, $payload); if (!$definition) return;\n        $order = $db->fetch(\"SELECT o.public_no,o.user_id,o.assigned_worker_id,o.final_amount_cents,o.booking_fee_cents,o.is_demo,u.mobile_ciphertext user_mobile FROM orders o JOIN users u ON u.id=o.user_id WHERE o.id=:id\", ['id'=>$orderId]);\n        if (!$order) return;\n        $parameters = ['order_no'=>(string)$order['public_no'],'status'=>$definition['status'],'amount'=>number_format(((int)($definition['amount_cents'] ?? $order['final_amount_cents']))/100,2,'.',''),'time'=>date('Y-m-d H:i')];\n        // 内部通知是基础渠道，可单独关闭某类进度消息；不影响外部通知。\n        if (self::eventEnabled('notification.internal_event_switches', $eventType)) {\n            $noticeData = json_encode(['order_id' => (int) $orderId, 'event_key' => $eventKey], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n            foreach ($definition['recipients'] as $recipientType) {\n                if (!in_array($recipientType, ['user', 'worker'], true)) continue;\n                $recipientId = $recipientType === 'user' ? (int) $order['user_id'] : (int) ($order['assigned_worker_id'] ?? 0);\n                if ($recipientId < 1) continue;\n                $content = '订单 ' . $parameters['order_no'] . '：' . $definition['status'];\n                if (!empty($definition['amount_cents'])) $content .= '，金额 ' . $parameters['amount'] . ' 元';\n                $duplicate = $db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type=:recipient_type AND recipient_id=:recipient_id AND channel='in_app' AND template_key=:template_key AND BINARY data_json=BINARY :data_json LIMIT 1\", [\n                    'recipient_type' => $recipientType, 'recipient_id' => $recipientId, 'template_key' => $eventType, 'data_json' => $noticeData,\n                ]);\n                if (!$duplicate) {\n                    $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,:recipient_type,:recipient_id,'in_app',:template_key,:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\", [\n                        'public_id' => \\public_id(), 'recipient_type' => $recipientType, 'recipient_id' => $recipientId,\n                        'template_key' => $eventType, 'title' => $definition['status'], 'content' => $content, 'data' => $noticeData,\n                    ]);\n                }\n            }\n        }\n        // V2.2.7：演示订单只落站内消息，绝不进入企业微信、微信订阅或短信发件箱。\n        // 测试中心订单额外记录“应发但未真实投递”的模拟投影，不复用真实 message_outbox。\n        if(!empty($order['is_demo'])){\n            try{\n                TestMessageProjectionRecorder::capture($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters);\n            }catch(\\Throwable $exception){\n                \\write_log('test-center','['.date('c').'] message_projection_failed order_id='.$orderId.' event='.str_replace([\"\\r\",\"\\n\"],' ',$eventType).' '.$exception->getMessage().\"\\n\");\n            }\n            return;\n        }\n        // 2026-09-02：管理员通知独立进入企业微信机器人，不读取或发送管理员短信号码。\n        if (in_array('admin', $definition['recipients'], true) && self::eventEnabled('wecom.event_switches', $eventType)\n            && \\filter_var(\\setting('wecom.webhook_enabled', false), FILTER_VALIDATE_BOOLEAN)) {\n            $adminTitle=trim((string)($definition['admin_title']??$definition['status']??''));\n            $adminTitle=trim((string)(preg_replace('/[\\\\r\\\\n【】]+/u',' ',$adminTitle)??''));\n            if($adminTitle==='')$adminTitle=$eventType;\n            $adminTitle=mb_substr($adminTitle,0,40);\n            $content = \"【{$adminTitle}】\\n订单号：{$parameters['order_no']}\\n时间：{$parameters['time']}\";\n            if ((string)$definition['status'] !== $adminTitle) $content .= \"\\n状态：{$definition['status']}\";\n            if (!empty($definition['amount_cents'])) $content .= \"\\n金额：{$parameters['amount']} 元\";\n            $adminData=['content'=>$content,'event_type'=>$eventType,'order_id'=>$orderId,'title'=>$adminTitle,'action_path'=>self::adminActionPath($eventType,$orderId,(string)$order['public_no'])];\n            $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wecom_webhook',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':admin:wecom',0,128),'payload'=>json_encode($adminData,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        }\n        // 2026-10-01：外部触达分两种模式：\n        // 1) 建议/普通短信仍按开关独立发送；\n        // 2) “订阅补充短信”改为微信订阅优先，只有订阅不可用或最终失败时才进入短信队列。\n        $smsEnabled=\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('sms.event_switches',$eventType);\n        $eventMeta=MessageEventCatalog::get($eventType)??[];\n        $fallbackMode=$smsEnabled && (($eventMeta['sms_delivery_mode']??'independent')==='subscription_fallback');\n        $fallbackPayload=$fallbackMode\n            ? OrderSubscriptionQueue::buildSubscriptionFallbackSmsPayload($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters)\n            : null;\n        $subscription=OrderSubscriptionQueue::queueOrderSubscription(\n            $db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,\n            is_array($fallbackPayload)?$fallbackPayload:[]\n        );\n        // 同一事件对用户和师傅的外部提醒语义可能不同。若事件需要师傅及时知道、\n        // 但主订阅场景并不是师傅场景，则额外使用通用“师傅订单重要进度”模板补一条微信提醒。\n        OrderSubscriptionQueue::queueWorkerOrderUpdateSupplement($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$fallbackMode);\n        if($fallbackMode){\n            if(empty($subscription['queued'])&&is_array($fallbackPayload)){\n                $fallbackPayload['fallback_reason']=(string)($subscription['reason']??'subscription_unavailable');\n                OrderSubscriptionQueue::enqueueSmsFallback($db,$fallbackPayload);\n            }\n            return;\n        }\n\n        if(!$smsEnabled)return;\n        $templates=\\setting('sms.template_codes',[]);if(!is_array($templates))return;\n        $configured=$templates[$definition['scene']]??'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        if($templateCode==='')return;\n        $recipients=[];\n        foreach($definition['recipients'] as $recipient){\n            if($recipient==='user'){$mobile=\\decrypt_private_value((string)$order['user_mobile'],'user-mobile');if($mobile!=='')$recipients['user:'.(int)$order['user_id']]=[$mobile,'user',(int)$order['user_id']];}\n            elseif($recipient==='worker'&&!empty($order['assigned_worker_id'])){$row=$db->fetch('SELECT mobile_ciphertext FROM worker_profiles WHERE id=:id',['id'=>$order['assigned_worker_id']]);$mobile=$row?\\decrypt_private_value((string)$row['mobile_ciphertext'],'worker-mobile'):'';if($mobile!=='')$recipients['worker:'.(int)$order['assigned_worker_id']]=[$mobile,'worker',(int)$order['assigned_worker_id']];}\n        }\n        foreach($recipients as $key=>$recipient){\n            $data=['mobile'=>$recipient[0],'template_code'=>$templateCode,'parameters'=>$parameters,'event_type'=>$eventType,'order_id'=>$orderId,'recipient_type'=>$recipient[1],'recipient_id'=>$recipient[2]];\n            $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('aliyun_sms',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':'.$key,0,128),'payload'=>json_encode($data,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        }\n    }\n\n    public static function adminActionPath(string $eventType, int $orderId=0, string $orderNo=''): ?string\n    {\n        $routes=[\n            'platform_worker_quoted'=>'platform-orders',\n            'platform_change_requested'=>'platform-order-finance',\n            'merchant_auth_submitted'=>'merchants',\n            'worker_profile_submitted'=>'workers',\n            'worker_realname_submitted'=>'worker-credentials',\n            'worker_collection_code_submitted'=>'worker-credentials',\n            'worker_collection_code_auto_approved'=>'worker-credentials',\n            'withdrawal_submitted'=>'withdrawals',\n            'commission_overdue'=>'commissions',\n        ];\n        if (in_array($eventType, ['platform_measurement_auto_confirmed','platform_measurement_confirmed'], true) && $orderId > 0) {\n            return $orderNo !== '' ? '/admin/?route=platform-orders.pricing-review&order_no='.rawurlencode($orderNo) : '/admin/?route=platform-orders';\n        }\n        if(isset($routes[$eventType]))return '/admin/?route='.$routes[$eventType];\n        if($orderId>0)return '/admin/?route=orders.view&id='.$orderId;\n        return null;\n    }\n\n    public static function queueWorkerWithdrawalResult(Database $db,int $workerId,string $withdrawalNo,string $status,string $note='',int $amountCents=0):void\n    {\n        if($workerId<1||$withdrawalNo==='')return;\n        $labels=[\n            'approved'=>['提现审核通过','提现申请已审核通过，等待平台登记付款。'],\n            'rejected'=>['提现申请未通过','提现申请未通过，冻结金额已退回可用余额。'],\n            'paid'=>['提现已付款','平台已登记人工付款，请核对支付宝到账情况。'],\n            'payment_failed'=>['提现付款失败','人工付款未完成，请查看处理说明或等待平台重新处理。'],\n        ];\n        if(!isset($labels[$status]))return;\n        [$title,$content]=$labels[$status];\n        if($amountCents>0)$content.=' 金额 '.number_format($amountCents/100,2,'.','').' 元。';\n        $note=trim($note);if($note!=='')$content.=' 说明：'.mb_substr($note,0,120);\n        $data=json_encode(['withdrawal_no'=>$withdrawalNo,'status'=>$status],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $duplicate=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='withdrawal_result' AND BINARY data_json=BINARY :data LIMIT 1\",['worker_id'=>$workerId,'data'=>$data]);\n        if($duplicate)return;\n        $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:worker_id,'in_app','withdrawal_result',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n            'public_id'=>\\public_id(),'worker_id'=>$workerId,'title'=>$title,'content'=>$content,'data'=>$data,\n        ]);\n    }\n\n    public static function queueWorkerReviewResult(Database $db, int $workerId, string $cloudId, string $decision, string $reason, string $workerName=''): void\n    {\n        if ($workerId < 1) return;\n        $row = $db->fetch(\"SELECT w.user_id,w.display_name,u.mobile_ciphertext,(SELECT wi.openid FROM wechat_identities wi WHERE wi.user_id=w.user_id AND wi.status='active' ORDER BY wi.id DESC LIMIT 1) openid FROM worker_profiles w JOIN users u ON u.id=w.user_id WHERE w.id=:id LIMIT 1\", ['id'=>$workerId]);\n        if (!$row) return;\n        $labels=['approved'=>'审核通过','rejected'=>'审核未通过','suspended'=>'接单已暂停','pending'=>'等待审核'];\n        $status=$labels[$decision]??'审核状态已更新';\n        $dataJson=json_encode(['cloud_id'=>$cloudId,'review_status'=>$decision],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $duplicate=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:id AND channel='in_app' AND template_key='worker_profile_review_result' AND BINARY data_json=BINARY :data LIMIT 1\",['id'=>$workerId,'data'=>$dataJson]);\n        if(!$duplicate)$db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:recipient_id,'in_app','worker_profile_review_result',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>\\public_id(),'recipient_id'=>$workerId,'title'=>'师傅入驻'.$status,'content'=>$reason!==''?$status.'：'.mb_substr($reason,0,80):$status,'data'=>$dataJson]);\n        if(!in_array($decision,['approved','rejected','suspended'],true))return;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes['reviewResult'];$userId=(int)$row['user_id'];$pref=SubscriptionQuotaStore::subscriptionPreferences($db,$userId)['reviewResult']??[];\n        if(empty($scene['available']))return;\n        $authorizationStatus=(string)($pref['authorization_status']??'');\n        $subscriptionType=(string)($scene['subscription_type']??'one_time');\n        if($subscriptionType==='one_time'){\n            if(in_array($authorizationStatus,['ban','disabled'],true))return;\n            if(max(0,(int)($pref['remaining_count']??0))<1)return;\n        }else{\n            if(empty($pref['enabled'])||!in_array($authorizationStatus,['accept','acceptWithAudio','acceptWithAlert'],true))return;\n        }\n        $openid=trim((string)$row['openid']);$mobile=\\decrypt_private_value((string)$row['mobile_ciphertext'],'user-mobile');if($openid===''||$mobile==='')return;\n        $name=mb_substr(trim($workerName)!==''?trim($workerName):(string)$row['display_name'],0,10);\n        $thing=$decision==='approved'?'入驻审核已通过，请进入小程序查看。':($decision==='rejected'?'入驻审核未通过，请按处理说明修改。':'师傅接单状态已暂停，请查看处理说明。');\n        if($reason!=='')$thing=mb_substr($thing.' '.trim($reason),0,20);\n        OrderSubscriptionQueue::enqueueWechatSubscribe($db,'worker-review:'.$cloudId.':'.$decision.':'.gmdate('YmdHi'),$userId,'reviewResult',$openid,(string)$scene['template_id'],'pages/record/detail?id='.rawurlencode($cloudId),[\n            'name1'=>['value'=>$name?:'入驻师傅'],\n            'phone_number2'=>['value'=>$mobile],\n            'phrase3'=>['value'=>$status],\n            'thing5'=>['value'=>$thing],\n        ]);\n    }\n\n    public static function eventEnabled(string $settingKey, string $eventType): bool\n    {\n        $channel = strpos($settingKey, 'wecom.') === 0 ? 'wecom' : (strpos($settingKey, 'notification.') === 0 ? 'inapp' : 'sms');\n        $configured = \\setting($settingKey, []);\n        return MessageEventCatalog::enabled($channel, $eventType, is_array($configured) ? $configured : []);\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseDemoOrderWriteGuard.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\nfinal class DatabaseDemoOrderWriteGuard\n{\n    private Database $db;\n\n    public function __construct(Database $db) { $this->db = $db; }\n\n    public function run(string $orderNo, callable $operation): array\n    {\n        $params = ['lock_name'=>'wall_worker_admin_demo_guard'];\n        if ((int)$this->db->fetchValue('SELECT GET_LOCK(:lock_name,5)', $params) !== 1) {\n            throw new OrderOperationException('演示数据设置正在变更，请稍后重试。', 'DEMO_SETTING_BUSY', 409);\n        }\n        try {\n            // Locking read bypasses the HTTP settings cache and any earlier transaction snapshot.\n            $setting = $this->db->fetch(\n                \"SELECT setting_value FROM system_settings WHERE setting_key='demo.data_enabled' LOCK IN SHARE MODE\"\n            );\n            $enabled = !$setting || in_array(strtolower((string)$setting['setting_value']), ['1','true','yes','on'], true);\n            if (!$enabled) {\n                $order = $this->db->fetch(\n                    'SELECT is_demo,public_no FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',\n                    ['public_no'=>$orderNo]\n                );\n                if ($order && (!empty($order['is_demo']) || stripos((string)$order['public_no'], 'DEMO') !== false)) {\n                    throw new OrderOperationException('演示数据已关闭，该演示记录不可继续处理。', 'DEMO_DATA_DISABLED', 403);\n                }\n            }\n            return $operation();\n        } finally {\n            try { $this->db->fetchValue('SELECT RELEASE_LOCK(:lock_name)', $params); }\n            catch (Throwable $exception) { /* Connection close also releases the advisory lock. */ }\n        }\n    }\n}\n","server/app/Infrastructure/Testing/TestMessageProjectionRecorder.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Testing;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionCatalog;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\n\n/**\n * 测试订单消息投影记录器。\n *\n * 只记录“本来会尝试什么渠道”的测试证据，不写真实 message_outbox，\n * 不读取/保存手机号、OpenID、Webhook 等敏感投递地址。\n */\nfinal class TestMessageProjectionRecorder\n{\n    public static function capture(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters): void\n    {\n        if(!TestingEnvironmentPolicy::active()||!$db->tableExists('test_message_outbox'))return;\n        $instanceId=self::resolveInstanceId($db,$orderId);\n        if($instanceId<1)return;\n\n        $meta=MessageEventCatalog::get($eventType)??[];\n        foreach((array)($definition['recipients']??[]) as $recipientType){\n            if(!in_array($recipientType,['user','worker'],true))continue;\n            $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n            if($recipientId<1)continue;\n            $inappEnabled=self::eventEnabled('notification.internal_event_switches','inapp',$eventType);\n            self::record($db,$instanceId,$orderId,$eventKey,$eventType,'in_app',$recipientType,$recipientId,\n                $inappEnabled?'delivered':'config_disabled',$inappEnabled?'notification_created_or_deduplicated':'event_switch_disabled',\n                (string)($definition['scene']??''),[\n                    'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                    'amount'=>(string)($parameters['amount']??''),'delivery_mode'=>'internal',\n                ]);\n        }\n\n        self::captureSubscription($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$meta);\n        self::captureSms($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$meta);\n        self::captureWecom($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$parameters,$meta);\n    }\n\n    private static function captureSubscription(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,array $meta): void\n    {\n        $sceneKey=trim((string)($meta['subscription_scene']??''));\n        if($sceneKey==='')return;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();\n        $scene=$scenes[$sceneKey]??null;\n        $recipientType=is_array($scene)?(string)($scene['recipient']??'user'):'user';\n        if(!in_array($recipientType,(array)($definition['recipients']??[]),true))return;\n        $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n        if($recipientId<1)return;\n        $available=is_array($scene)&&!empty($scene['available'])&&!empty($scene['field_map']);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wechat_subscribe',$recipientType,$recipientId,\n            $available?'demo_suppressed':'config_disabled',\n            $available?'demo_order_external_delivery_suppressed':(string)($scene['availability_reason']??'scene_unavailable'),\n            $sceneKey,[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'subscription_type'=>(string)($scene['subscription_type']??''),'eligibility'=>'quota_and_authorization_not_consumed',\n            ]);\n\n        if($recipientType==='worker'||!in_array('worker',(array)($definition['recipients']??[]),true)||(int)($order['assigned_worker_id']??0)<1)return;\n        $important=((string)($meta['priority']??'normal')==='important')||$eventType==='worker_assigned';\n        if(!$important)return;\n        $supplement=$scenes['worker_order_update']??null;\n        $supplementAvailable=is_array($supplement)&&!empty($supplement['available'])&&!empty($supplement['field_map']);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wechat_subscribe','worker',(int)$order['assigned_worker_id'],\n            $supplementAvailable?'demo_suppressed':'config_disabled',\n            $supplementAvailable?'demo_order_external_delivery_suppressed':(string)($supplement['availability_reason']??'scene_unavailable'),\n            'worker_order_update',[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'supplement'=>true,'eligibility'=>'quota_and_authorization_not_consumed',\n            ]);\n    }\n\n    private static function captureSms(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,array $meta): void\n    {\n        if(empty($meta['sms_visible']))return;\n        $enabled=\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('sms.event_switches','sms',$eventType);\n        $templates=\\setting('sms.template_codes',[]);\n        $configured=is_array($templates)?($templates[(string)($definition['scene']??'')]??''):'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        $deliveryMode=(string)($meta['sms_delivery_mode']??'independent');\n        if(!$enabled||$templateCode===''){\n            $status='config_disabled';\n            $reason=$enabled?'template_missing':'channel_or_event_disabled';\n        }elseif($deliveryMode==='subscription_fallback'){\n            $status='not_run';\n            $reason='subscription_fallback_not_triggered_in_demo';\n        }else{\n            $status='demo_suppressed';\n            $reason='demo_order_external_delivery_suppressed';\n        }\n        foreach((array)($definition['recipients']??[]) as $recipientType){\n            if(!in_array($recipientType,['user','worker'],true))continue;\n            $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n            if($recipientId<1)continue;\n            self::record($db,$instanceId,$orderId,$eventKey,$eventType,'aliyun_sms',$recipientType,$recipientId,$status,$reason,(string)($definition['scene']??''),[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'delivery_mode'=>$deliveryMode,'template_configured'=>$templateCode!=='',\n            ]);\n        }\n    }\n\n    private static function captureWecom(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $parameters,array $meta): void\n    {\n        if(!in_array('admin',(array)($definition['recipients']??[]),true)||empty($meta['wecom_visible']))return;\n        $enabled=\\filter_var(\\setting('wecom.webhook_enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('wecom.event_switches','wecom',$eventType);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wecom_webhook','admin',0,\n            $enabled?'demo_suppressed':'config_disabled',$enabled?'demo_order_external_delivery_suppressed':'channel_or_event_disabled',\n            (string)($definition['scene']??''),[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n            ]);\n    }\n\n    private static function resolveInstanceId(Database $db,int $orderId): int\n    {\n        $direct=(int)$db->fetchValue(\"SELECT ti.id FROM test_instances ti JOIN orders o ON o.id=ti.order_id WHERE ti.order_id=:id AND o.is_demo=1 AND ti.deleted_at IS NULL LIMIT 1\",['id'=>$orderId]);\n        if($direct>0)return $direct;\n        if(!$db->tableExists('order_relations'))return 0;\n        return(int)$db->fetchValue(\"SELECT ti.id FROM order_relations r JOIN test_instances ti ON ti.order_id=r.parent_order_id JOIN orders child_order ON child_order.id=r.child_order_id WHERE r.child_order_id=:id AND r.relation_type='measurement_construction' AND r.status='active' AND child_order.is_demo=1 AND ti.deleted_at IS NULL LIMIT 1\",['id'=>$orderId]);\n    }\n\n    private static function eventEnabled(string $settingKey,string $channel,string $eventType): bool\n    {\n        $configured=\\setting($settingKey,[]);\n        return MessageEventCatalog::enabled($channel,$eventType,is_array($configured)?$configured:[]);\n    }\n\n    private static function record(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,string $channel,string $recipientType,int $recipientId,string $status,string $reason,string $sceneKey,array $payload): void\n    {\n        $businessIdentity=$eventKey.':'.$channel.':'.$recipientType.':'.$recipientId.':'.$sceneKey;\n        // Keep long event keys distinct: a raw 190-byte prefix can silently collide under INSERT IGNORE.\n        $businessKey=strlen($businessIdentity)<=190?$businessIdentity:substr($businessIdentity,0,125).':'.hash('sha256',$businessIdentity);\n        $db->execute(\"INSERT IGNORE INTO test_message_outbox(instance_id,order_id,business_key,event_key,event_type,channel,recipient_type,recipient_id,scene_key,projection_status,reason_code,payload_json,created_at) VALUES(:instance,:order_id,:business_key,:event_key,:event_type,:channel,:recipient_type,:recipient_id,:scene_key,:status,:reason,:payload,UTC_TIMESTAMP())\",[\n            'instance'=>$instanceId,'order_id'=>$orderId,'business_key'=>$businessKey,'event_key'=>substr($eventKey,0,160),\n            'event_type'=>substr($eventType,0,120),'channel'=>$channel,'recipient_type'=>$recipientType,'recipient_id'=>$recipientId>0?$recipientId:null,\n            'scene_key'=>substr($sceneKey,0,80),'status'=>$status,'reason'=>substr($reason,0,120),\n            'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n        ]);\n    }\n}\n","server/app/Contracts/OrderDisputeRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderDisputeRepository\n{\n    /** @param array<string,mixed> $actor @param string[] $evidenceIds @return array<string,mixed> */\n    public function startNegotiation(array $actor, string $orderNo, string $description, array $evidenceIds): array;\n\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function escalate(array $actor, string $disputeNo, string $note): array;\n\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function resolveByAgreement(array $actor, string $disputeNo, string $note): array;\n\n    /**\n     * @param array<string,mixed> $operator 带 channel 的管理员描述符；mini_admin 只能零金额结案，web_admin 可做资金裁定。\n     * @return array<string,mixed>\n     */\n    public function resolveByAdmin(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array;\n}\n","server/app/Contracts/OrderCancellationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCancellationRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array<string,mixed>\n     */\n    public function request(array $actor, string $orderNo, string $reason, string $reasonCode): array;\n\n    /**\n     * @param array<string,mixed> $operator 带 channel 的管理员描述符：mini_admin 使用 users.id，仅写 typed event；web_admin 使用 admin_users.id，可写 decided_by/requested_by_admin_id。\n     * @return array<string,mixed>\n     */\n    public function review(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array;\n}\n","server/app/Domain/Order/RepairInterventionPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\n\n/** 售后维修先由双方处理；师傅拒绝或超时后才允许升级平台。 */\nfinal class RepairInterventionPolicy\n{\n    public const WAIT_HOURS = 48;\n\n    /** @return array{eligible:bool,reason:string,available_at:?string,wait_hours:int} */\n    public static function evaluate(\n        string $status,\n        ?string $resolution,\n        ?string $openedAt,\n        string $timezone = 'UTC',\n        ?DateTimeImmutable $now = null\n    ): array {\n        $status = trim($status);\n        $resolution = trim((string)$resolution);\n        $openedAt = trim((string)$openedAt);\n        $result = ['eligible'=>false,'reason'=>'not_active','available_at'=>null,'wait_hours'=>self::WAIT_HOURS];\n\n        if (!in_array($status, ['open','processing'], true)) return $result;\n        if (strpos($resolution, '用户申请平台介入') === 0) {\n            $result['reason'] = 'already_escalated';\n            return $result;\n        }\n        if (strpos($resolution, '师傅拒绝维修') === 0) {\n            $result['eligible'] = true;\n            $result['reason'] = 'worker_rejected';\n            return $result;\n        }\n        if ($openedAt === '') {\n            $result['reason'] = 'opened_at_missing';\n            return $result;\n        }\n\n        try {\n            $zone = new DateTimeZone($timezone !== '' ? $timezone : 'UTC');\n            $opened = new DateTimeImmutable($openedAt, $zone);\n            $available = $opened->modify('+'.self::WAIT_HOURS.' hours');\n            $current = $now ?: new DateTimeImmutable('now', $zone);\n            $result['available_at'] = $available->format('Y-m-d H:i');\n            $result['eligible'] = $current >= $available;\n            $result['reason'] = $result['eligible'] ? 'response_timeout' : 'waiting_worker';\n            return $result;\n        } catch (Throwable $exception) {\n            $result['reason'] = 'opened_at_invalid';\n            return $result;\n        }\n    }\n}\n","server/app/Contracts/OrderRepairInterventionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderRepairInterventionRepository\n{\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function request(array $actor, string $orderNo, string $afterSaleNo, string $note): array;\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCancellationRiskRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\OrderCancellationRiskRepository;\nuse WorkerAdmin\\Domain\\Order\\CancellationRiskPolicy;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\n/** 2026-10-08：取消事实、原预约/取证信号与下单限制共用账号锁；不改变原退款执行器。 */\nfinal class DatabaseOrderCancellationRiskRepository implements OrderCancellationRiskRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db) { $this->db = $db; }\n\n    public function configuration(): array\n    {\n        $raw = $this->db->fetchValue('SELECT setting_value FROM system_settings WHERE setting_key=:key', ['key'=>'order.cancellation_risk']);\n        $input = json_decode((string)$raw, true);\n        return CancellationRiskPolicy::config(is_array($input) ? $input : []);\n    }\n\n    public function user(int $userId): ?array\n    { return $this->db->fetch('SELECT id,public_id,nickname FROM users WHERE id=:id', ['id'=>$userId]); }\n\n    public function saveConfiguration(array $rules): void\n    {\n        $this->db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,description,is_public,created_at,updated_at)\n            VALUES('order.cancellation_risk',:value,'json','order','频繁取消下单风控',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n            ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),updated_at=UTC_TIMESTAMP()\",\n            ['value'=>json_encode(CancellationRiskPolicy::config($rules),JSON_UNESCAPED_UNICODE)]);\n    }\n\n    public function state(int $userId): array\n    {\n        $row = $this->db->fetch('SELECT blocked_until,last_restriction_id,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n        $active = $row && !empty($row['blocked_until']) && $row['blocked_until'] > $row['now_utc'];\n        $until = $active ? (string)$row['blocked_until'] : null;\n        $local = $until ? (new \\DateTimeImmutable($until, new \\DateTimeZone('UTC')))->setTimezone(new \\DateTimeZone('Asia/Shanghai'))->format('Y-m-d H:i') : null;\n        return ['restricted'=>(bool)$active, 'expires_at_utc'=>$until, 'expires_at'=>$local,\n            'message'=>$active ? '当前已暂停新下单，将于'.$local.'自动恢复。如有误判，请联系客服核实解除。' : '',\n            'restriction_id'=>$active ? (int)$row['last_restriction_id'] : null];\n    }\n\n    // 调用方已有订单锁时按“订单→账号”顺序；草稿创建只锁账号，不锁其它已有订单。\n    public function assertCanSubmit(int $userId, ?array $order = null): void\n    {\n        if ($order !== null && !$this->eligible($order)) return;\n        $this->db->transaction(function () use ($userId): void {\n            $this->lockAccount($userId);\n            $state = $this->state($userId);\n            if ($state['restricted']) throw new OrderOperationException($state['message'], 'ORDER_SUBMISSION_RESTRICTED', 403, $state);\n        });\n    }\n\n    // 2026-10-08：支付回调只判断准入而不抛业务拒绝，确保真实到账仍然入账及原路退款。\n    public function canPublish(array $order): bool\n    {\n        if (!$this->eligible($order)) return true;\n        return $this->db->transaction(function () use ($order): bool {\n            $this->lockAccount((int)$order['user_id']);\n            return !$this->state((int)$order['user_id'])['restricted'];\n        });\n    }\n\n    /** 必须在订单失效报价/指派前、同一取消事务内调用；仅取消成立后该事务才会提交。 */\n    public function captureCancellation(array $order, string $responsibility = 'unclear', int $runEmptyCents = 0): void\n    {\n        if (!$this->eligible($order)) return;\n        $this->db->transaction(function () use ($order,$responsibility,$runEmptyCents): void {\n            $userId = (int)$order['user_id'];\n            $this->lockAccount($userId);\n            if (in_array($responsibility, ['worker','platform'], true)) {\n                $this->db->execute('UPDATE order_cancellation_risk_scores SET excluded_at=UTC_TIMESTAMP(),exclusion_reason=:reason,updated_at=UTC_TIMESTAMP() WHERE order_id=:id', ['reason'=>$responsibility.'责任免计分','id'=>$order['id']]);\n                return;\n            }\n            $quoted = (bool)$this->db->fetchValue(\"SELECT id FROM quotes WHERE order_id=:id AND worker_id>0 AND status IN ('active','selected') AND (expires_at IS NULL OR expires_at>UTC_TIMESTAMP()) LIMIT 1\", ['id'=>$order['id']]);\n            $dealt = !empty($order['selected_quote_id']) || (string)($order['assignment_status'] ?? '') === 'accepted';\n            $config = $this->configuration();\n            $base = CancellationRiskPolicy::score($quoted, $dealt, [], $runEmptyCents > 0, $config);\n            $snapshot = json_encode(['quoted'=>$quoted,'dealt'=>$dealt,'run_empty_cents'=>$runEmptyCents,\n                'assignment_id'=>$order['current_assignment_id'] ?? null,'worker_id'=>$order['assigned_worker_id'] ?? null,\n                'responsibility'=>$responsibility,'config'=>$config], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $this->db->execute(\"INSERT INTO order_cancellation_risk_scores(order_id,user_id,base_score,score,cancelled_at,snapshot_json,created_at,updated_at)\n                VALUES(:order_id,:user_id,:base,:base,COALESCE(:cancelled_at,UTC_TIMESTAMP()),:snapshot,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n                ON DUPLICATE KEY UPDATE base_score=GREATEST(base_score,VALUES(base_score)),updated_at=UTC_TIMESTAMP()\",\n                ['order_id'=>$order['id'],'user_id'=>$userId,'base'=>$base,'cancelled_at'=>$order['cancelled_at'] ?? null,'snapshot'=>$snapshot]);\n            $this->recalculateOrder((int)$order['id'], $config);\n            $this->evaluate($userId, $config);\n        });\n    }\n\n    /** 原电话、预约和异常入口写入；没有实际取消则只记录信号，不计分。 */\n    public function recordExistingSignal(int $orderId, int $workerId, string $kind, string $note = ''): void\n    {\n        if (!in_array($kind, ['dialed','contacted','complaint'], true)) throw new OrderOperationException('联系行为无效', 'RISK_SIGNAL_INVALID');\n        $this->db->transaction(function () use ($orderId,$workerId,$kind,$note): void {\n            $order = $this->db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$orderId]);\n            if (!$order || !$this->eligible($order)) return;\n            $workerUser = (int)$this->db->fetchValue('SELECT user_id FROM worker_profiles WHERE id=:id', ['id'=>$workerId]);\n            $participated = $this->db->fetchValue('SELECT id FROM quotes WHERE order_id=:id AND worker_id=:worker LIMIT 1', ['id'=>$orderId,'worker'=>$workerId])\n                || $this->db->fetchValue('SELECT id FROM assignments WHERE order_id=:id AND worker_id=:worker LIMIT 1', ['id'=>$orderId,'worker'=>$workerId]);\n            if ($workerId < 1 || !$participated || $workerUser === (int)$order['user_id']) throw new OrderOperationException('无权记录本单联系行为', 'FORBIDDEN', 403);\n            if ($kind !== 'complaint' && (string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('订单已结束，不能补记联系行为', 'ORDER_NOT_ACTIVE', 409);\n            $userId = (int)$order['user_id'];\n            $this->lockAccount($userId);\n            $this->db->execute(\"INSERT IGNORE INTO order_cancellation_risk_signals(order_id,worker_id,signal_type,note,created_at)\n                VALUES(:id,:worker,:kind,:note,UTC_TIMESTAMP())\", ['id'=>$orderId,'worker'=>$workerId,'kind'=>$kind,'note'=>mb_substr($note,0,500)]);\n            $config = $this->configuration();\n            $this->recalculateOrder($orderId, $config);\n            $this->evaluate($userId, $config);\n        });\n    }\n\n    public function recordDial(array $actor, string $publicNo): void\n    {\n        $this->db->transaction(function () use ($actor,$publicNo): void {\n            $order = $this->db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :no FOR UPDATE', ['no'=>$publicNo]);\n            $worker = (int)($actor['worker_id'] ?? 0);\n            if (!$order || $worker < 1 || (int)($order['assigned_worker_id'] ?? 0) !== $worker\n                || !$this->db->fetchValue(\"SELECT id FROM assignments WHERE id=:assignment AND order_id=:id AND worker_id=:worker AND status IN ('accepted','completed') LIMIT 1\", ['assignment'=>$order['current_assignment_id'] ?? 0,'id'=>$order['id'],'worker'=>$worker])) {\n                throw new OrderOperationException('接受本单后才能拨打业主电话', 'FORBIDDEN', 403);\n            }\n            // 已完成后的正常售后拨号不属于取消主订单的风险，不因限单阻止联系。\n            if ((string)$order['lifecycle_status'] === 'active') $this->recordExistingSignal((int)$order['id'], $worker, 'dialed');\n        });\n    }\n\n    public function reviewData(int $userId): array\n    {\n        $scores=$this->db->fetchAll('SELECT s.*,o.public_no FROM order_cancellation_risk_scores s JOIN orders o ON o.id=s.order_id WHERE s.user_id=:id ORDER BY s.cancelled_at DESC LIMIT 50', ['id'=>$userId]);\n        foreach ($scores as &$score) $score['signals']=$this->db->fetchAll('SELECT worker_id,signal_type,note,created_at,revoked_at FROM order_cancellation_risk_signals WHERE order_id=:id ORDER BY created_at,id', ['id'=>$score['order_id']]);\n        unset($score);\n        return ['state'=>$this->state($userId), 'scores'=>$scores,\n            'restrictions'=>$this->db->fetchAll('SELECT * FROM order_cancellation_risk_restrictions WHERE user_id=:id ORDER BY id DESC LIMIT 20', ['id'=>$userId])];\n    }\n\n    public function restrictManually(int $userId, int $adminId, int $days, string $reason): void\n    {\n        $days=max(1,min(30,$days));\n        $reason=trim($reason);\n        if ($userId<1 || $adminId<1) throw new OrderOperationException('用户或管理员无效', 'MANUAL_RESTRICTION_INVALID');\n        if (mb_strlen($reason)<2) throw new OrderOperationException('请填写人工限制原因', 'MANUAL_RESTRICTION_REASON_REQUIRED');\n        $this->db->transaction(function () use ($userId,$adminId,$days,$reason): void {\n            $account=$this->lockAccount($userId);\n            if (!empty($account['blocked_until']) && $account['blocked_until']>$account['now_utc']) {\n                throw new OrderOperationException('该用户当前已有生效中的下单限制，请先核实或解除', 'RESTRICTION_ALREADY_ACTIVE', 409);\n            }\n            $snapshot=json_encode(['rule_version'=>'manual-v1','source'=>'admin','admin_id'=>$adminId,'days'=>$days,'reason'=>mb_substr($reason,0,500)],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $id=$this->db->insert('INSERT INTO order_cancellation_risk_restrictions(user_id,starts_at,expires_at,snapshot_json) VALUES(:user,UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL '.(int)$days.' DAY),:snapshot)', ['user'=>$userId,'snapshot'=>$snapshot]);\n            $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=(SELECT expires_at FROM order_cancellation_risk_restrictions WHERE id=:restriction),last_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user', ['restriction'=>$id,'user'=>$userId]);\n        });\n    }\n\n    public function release(int $userId, int $adminId, string $reason, array $excludedOrderIds = [], ?int $expectedId = null): void\n    {\n        if ($adminId < 1 || mb_strlen(trim($reason)) < 2) throw new OrderOperationException('请填写解除原因', 'RELEASE_REASON_REQUIRED');\n        $this->db->transaction(function () use ($userId,$adminId,$reason,$excludedOrderIds,$expectedId): void {\n            $account = $this->lockAccount($userId);\n            $id = (int)($account['last_restriction_id'] ?? 0);\n            if ($id < 1 || ($expectedId !== null && $id !== $expectedId)) throw new OrderOperationException('限制记录已变化，请刷新重试', 'RESTRICTION_CHANGED', 409);\n            $restriction = $this->db->fetch('SELECT * FROM order_cancellation_risk_restrictions WHERE id=:id FOR UPDATE', ['id'=>$id]);\n            if (!empty($restriction['released_at'])) return;\n            foreach (array_unique(array_map('intval', $excludedOrderIds)) as $orderId) {\n                $this->db->execute('UPDATE order_cancellation_risk_scores SET excluded_at=UTC_TIMESTAMP(),exclusion_reason=:reason,updated_at=UTC_TIMESTAMP() WHERE order_id=:order AND user_id=:user', ['reason'=>mb_substr($reason,0,500),'order'=>$orderId,'user'=>$userId]);\n            }\n            if (!$this->manualRestriction($restriction)) $this->consume($userId,$id);\n            $this->db->execute('UPDATE order_cancellation_risk_restrictions SET released_at=UTC_TIMESTAMP(),released_by_admin_id=:admin,release_reason=:reason WHERE id=:id', ['admin'=>$adminId,'reason'=>mb_substr($reason,0,500),'id'=>$id]);\n            $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=NULL,updated_at=UTC_TIMESTAMP() WHERE user_id=:id', ['id'=>$userId]);\n        });\n    }\n\n    private function eligible(array $order): bool\n    {\n        return empty($order['is_demo']) && (string)($order['order_source_type'] ?? 'consumer') !== 'platform' && (int)($order['user_id'] ?? 0) > 0;\n    }\n\n    private function lockAccount(int $userId): array\n    {\n        $this->db->execute('INSERT INTO order_cancellation_risk_accounts(user_id,updated_at) VALUES(:id,UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE user_id=VALUES(user_id)', ['id'=>$userId]);\n        return $this->db->fetch('SELECT *,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n    }\n\n    private function recalculateOrder(int $orderId, array $config): void\n    {\n        $score = $this->db->fetch('SELECT base_score,cancelled_at FROM order_cancellation_risk_scores WHERE order_id=:id FOR UPDATE', ['id'=>$orderId]);\n        if (!$score) return;\n        $rows = $this->db->fetchAll(\"SELECT signal_type FROM order_cancellation_risk_signals WHERE order_id=:id AND revoked_at IS NULL\n            AND (signal_type='complaint' OR created_at<=:cancelled_at) FOR UPDATE\", ['id'=>$orderId,'cancelled_at'=>$score['cancelled_at']]);\n        $points = max((int)$score['base_score'], CancellationRiskPolicy::score(false,false,array_column($rows,'signal_type'),false,$config));\n        $this->db->execute('UPDATE order_cancellation_risk_scores SET score=:score,updated_at=UTC_TIMESTAMP() WHERE order_id=:id', ['score'=>$points,'id'=>$orderId]);\n    }\n\n    private function evaluate(int $userId, array $config): void\n    {\n        $account = $this->db->fetch('SELECT *,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n        if (!empty($account['blocked_until']) && $account['blocked_until'] > $account['now_utc']) {\n            $restriction=$this->db->fetch('SELECT snapshot_json FROM order_cancellation_risk_restrictions WHERE id=:id FOR UPDATE',['id'=>(int)$account['last_restriction_id']]);\n            if (!$this->manualRestriction($restriction ?: [])) $this->consume($userId,(int)$account['last_restriction_id']);\n            return;\n        }\n        // 使用当前读：取消事务此前可能已建立 RR 快照，账号锁等待后仍须看见另一单的最新提交。\n        $rows = $this->db->fetchAll('SELECT order_id,score,cancelled_at,snapshot_json FROM order_cancellation_risk_scores WHERE user_id=:id AND excluded_at IS NULL AND consumed_restriction_id IS NULL AND score>0 AND cancelled_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL '.$config['long_days'].' DAY) FOR UPDATE', ['id'=>$userId]);\n        $match = CancellationRiskPolicy::threshold($rows, (int)strtotime($account['now_utc'].' UTC'), $config);\n        if (!$match) return;\n        $facts=[];\n        foreach ($rows as $row) $facts[]=['order_id'=>$row['order_id'],\n            'cancellation'=>json_decode($row['snapshot_json'],true),\n            'signals'=>$this->db->fetchAll('SELECT worker_id,signal_type,note,created_at,revoked_at FROM order_cancellation_risk_signals WHERE order_id=:id FOR UPDATE',['id'=>$row['order_id']])];\n        $snapshot = json_encode(['rule_version'=>'2026-10-08','config'=>$config,'match'=>$match,'scores'=>$rows,'facts'=>$facts], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $id = $this->db->insert('INSERT INTO order_cancellation_risk_restrictions(user_id,starts_at,expires_at,snapshot_json) VALUES(:user,UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL 7 DAY),:snapshot)', ['user'=>$userId,'snapshot'=>$snapshot]);\n        $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=(SELECT expires_at FROM order_cancellation_risk_restrictions WHERE id=:restriction),last_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user', ['restriction'=>$id,'user'=>$userId]);\n        $this->consume($userId,$id);\n    }\n\n    private function manualRestriction(array $restriction): bool\n    {\n        $snapshot=json_decode((string)($restriction['snapshot_json'] ?? ''),true);\n        return is_array($snapshot) && ($snapshot['source'] ?? '')==='admin';\n    }\n\n    private function consume(int $userId, int $restrictionId): void\n    {\n        if ($restrictionId < 1) return;\n        $this->db->execute('UPDATE order_cancellation_risk_scores SET consumed_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user AND consumed_restriction_id IS NULL AND excluded_at IS NULL AND score>0', ['restriction'=>$restrictionId,'user'=>$userId]);\n    }\n}\n","server/app/Domain/Order/CancellationRiskPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/** 2026-10-08：同单最高分、不同订单数门槛与固定七天限制；不依赖数据库或通知。 */\nfinal class CancellationRiskPolicy\n{\n    public const DEFAULTS = ['quote'=>2, 'contact'=>4, 'deal'=>5, 'complaint'=>6, 'run_empty'=>6,\n        'short_days'=>7, 'short_orders'=>2, 'short_score'=>6, 'long_days'=>30, 'long_orders'=>3, 'long_score'=>10];\n\n    public static function config(array $input): array\n    {\n        $result = self::DEFAULTS;\n        foreach ($result as $key=>$default) {\n            if (isset($input[$key]) && is_numeric($input[$key])) {\n                $max = strpos($key, 'days') !== false ? 90 : 100;\n                $minimum = strpos($key, 'orders') !== false ? 2 : 1;\n                $result[$key] = max($minimum, min($max, (int)$input[$key]));\n            }\n        }\n        $result['long_days'] = max($result['short_days'], $result['long_days']);\n        return $result;\n    }\n\n    public static function score(bool $quoted, bool $dealt, array $signals, bool $runEmpty, array $config): int\n    {\n        $points = max($quoted ? $config['quote'] : 0, $dealt ? $config['deal'] : 0, $runEmpty ? $config['run_empty'] : 0);\n        if (in_array('dialed', $signals, true) || in_array('contacted', $signals, true)) $points = max($points, $config['contact']);\n        if (in_array('complaint', $signals, true)) $points = max($points, $config['complaint']);\n        return $points;\n    }\n\n    public static function threshold(array $rows, int $now, array $config): ?array\n    {\n        foreach (['short','long'] as $window) {\n            $cutoff = $now - $config[$window.'_days'] * 86400;\n            $orders = [];\n            foreach ($rows as $row) {\n                $at = strtotime((string)$row['cancelled_at'].' UTC');\n                if ($at !== false && $at >= $cutoff && $at <= $now && (int)$row['score'] > 0) {\n                    $id = (int)$row['order_id'];\n                    $orders[$id] = max($orders[$id] ?? 0, (int)$row['score']);\n                }\n            }\n            if (count($orders) >= $config[$window.'_orders'] && array_sum($orders) >= $config[$window.'_score']) {\n                return ['window'=>$window, 'days'=>$config[$window.'_days'], 'order_count'=>count($orders),\n                    'score'=>array_sum($orders), 'order_ids'=>array_keys($orders)];\n            }\n        }\n        return null;\n    }\n}\n","server/app/Contracts/OrderCancellationRiskRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCancellationRiskRepository\n{\n    public function configuration(): array;\n    public function saveConfiguration(array $rules): void;\n    public function user(int $userId): ?array;\n    public function state(int $userId): array;\n    public function recordDial(array $actor, string $publicNo): void;\n    public function reviewData(int $userId): array;\n    public function restrictManually(int $userId, int $adminId, int $days, string $reason): void;\n    public function release(int $userId, int $adminId, string $reason, array $excludedOrderIds = [], ?int $expectedId = null): void;\n}\n","server/tests/fixtures/schema-2.6.0.json":"{\n  \"repository\": \"franz-9527/workers\",\n  \"source_commit\": \"8fcae77245205bb47e9457c70e5c264ee013706f\",\n  \"git_blob\": \"d3f26c8ca95edc3242aa89f52fb0fdd20575c947\",\n  \"sha256\": \"2d8d088ef268ca3b7ddf3137098a366d95620561b1fd5a6a3a296f72e71dcf8e\",\n  \"version\": \"2.6.0\"\n}\n","server/tests/chat_schema_contract.php":"<?php\n\ndeclare(strict_types=1);\n\n// Check every historical checksum before touching an explicitly isolated database.\n$root = dirname(__DIR__,2);\n$manifest = json_decode((string)file_get_contents($root.'/server/database/upgrades/manifest.json'),true,64,JSON_THROW_ON_ERROR);\nforeach ($manifest['upgrades'] as $row) {\n    if (!hash_equals($row['checksum'],hash_file('sha256',$root.'/server/database/upgrades/'.$row['file']))) throw new RuntimeException('Historical SQL checksum mismatch: '.$row['version']);\n}\nif (!hash_equals($manifest['install_checksum'],hash_file('sha256',$root.'/server/database/database.sql'))) throw new RuntimeException('Install checksum mismatch');\n$last = end($manifest['upgrades']);\nif (trim((string)file_get_contents($root.'/server/VERSION')) !== $last['version']) throw new RuntimeException('Server version differs from manifest');\necho \"聊天安装与历史迁移校验通过\\n\";\nif (getenv('CHAT_AUTH_TEST_INTEGRATION') !== '1') { echo \"隔离数据库结构验证未启用\\n\"; exit; }\n\nrequire_once $root.'/server/app/Support/SqlScriptRunner.php';\nuse WorkerAdmin\\Support\\SqlScriptRunner;\n\n$address = (string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');\nif (preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$match) !== 1) throw new RuntimeException('Explicit loopback test endpoint required');\n$pdo = new PDO('mysql:host=127.0.0.1;port='.(int)$match[1].';charset=utf8mb4','root',(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),[\n    PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_EMULATE_PREPARES=>false,\n]);\n$pdo->exec(\"SET time_zone='+00:00'\");\n$runner = new SqlScriptRunner();\n$database = 'bixuan_test_chat_schema_'.bin2hex(random_bytes(6));\n$pdo->exec('CREATE DATABASE `'.$database.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\ntry {\n    $pdo->exec('USE `'.$database.'`');\n    $runner->runFile($pdo,$root.'/server/database/database.sql');\n    $before = [];\n    $tables = $pdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);\n    foreach ($tables as $table) $before[$table] = $pdo->query('SHOW CREATE TABLE `'.$table.'`')->fetch(PDO::FETCH_NUM)[1];\n    // Only one unreleased package follows the actually released 2.6.0.\n    if ($last['version']!=='2.7.0' || array_filter($manifest['upgrades'],static fn(array $r):bool=>version_compare($r['version'],'2.7.0','>'))) throw new RuntimeException('Unreleased package must stay at 2.7.0');\n    foreach (['2.6.0','2.7.0','2.7.0'] as $version) $runner->runFile($pdo,$root.'/server/database/upgrades/'.$version.'.sql');\n    $normalize=static fn(string $ddl):string=>(string)preg_replace('/ AUTO_INCREMENT=[0-9]+/','',$ddl);\n    $compare=static function()use($pdo,$before,$normalize):void{\n        $actual=$pdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);\n        $expected=array_keys($before);sort($actual);sort($expected);\n        if($actual!==$expected)throw new RuntimeException('Install/upgrade table set mismatch');\n        foreach($before as $table=>$ddl){$after=$pdo->query('SHOW CREATE TABLE `'.$table.'`')->fetch(PDO::FETCH_NUM)[1];if($normalize($after)!==$normalize($ddl))throw new RuntimeException('Install/upgrade schema mismatch: '.$table);}\n    };\n    $compare();\n    foreach (['chat_admin_sessions','chat_policy_guards','chat_business_events','chat_repair_episodes','chat_policy_refresh','chat_conversations','chat_members','chat_member_intervals','chat_member_reads','chat_user_preferences','chat_preference_accounts','chat_event_receipts','chat_restrictions','chat_send_intents','chat_messages','chat_message_changes','chat_text_checks','chat_risk_events','order_platform_terms','order_pricing_items','platform_order_refund_reviews','platform_order_manual_receipts','test_batches','test_instances','test_entry_tokens'] as $table) {\n        if ((int)$pdo->query('SELECT COUNT(*) FROM `'.$table.'`')->fetchColumn() !== 0) throw new RuntimeException('Fresh install contains session/test data');\n    }\n    // Archived immutable main/2.6.0 schema is a compressed test fixture, never\n    // an extra deployment migration or a generated approximation of old state.\n    $metadata=json_decode((string)file_get_contents(__DIR__.'/fixtures/schema-2.6.0.json'),true,16,JSON_THROW_ON_ERROR);\n    $legacy=gzdecode((string)file_get_contents(__DIR__.'/fixtures/schema-2.6.0.sql.gz'));\n    if($legacy===false||!hash_equals($metadata['sha256'],hash('sha256',$legacy)))throw new RuntimeException('2.6.0 fixture checksum mismatch');\n    $upgraded=$database.'_upgrade';$pdo->exec('CREATE DATABASE `'.$upgraded.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n    try{\n        $pdo->exec('USE `'.$upgraded.'`');$runner->run($pdo,$legacy,'immutable-2.6.0-baseline');\n        // Match a deployed 2.6.0 database including its released migration.\n        $runner->runFile($pdo,$root.'/server/database/upgrades/2.6.0.sql');\n        $pdo->exec(\"INSERT INTO users(id,public_id,nickname,status,created_at,updated_at) VALUES(902601,REPEAT('U',26),'升级保留账号','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        $pdo->exec(\"INSERT INTO user_wallets(user_id,available_cents,reserved_cents,created_at,updated_at) VALUES(902601,12345,0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        foreach([1,2] as $repeat)$runner->runFile($pdo,$root.'/server/database/upgrades/2.7.0.sql');\n        $compare();\n        if((string)$pdo->query('SELECT available_cents FROM user_wallets WHERE user_id=902601')->fetchColumn()!=='12345')throw new RuntimeException('Upgrade changed existing wallet data');\n        if((string)$pdo->query('SELECT nickname FROM users WHERE id=902601')->fetchColumn()!=='升级保留账号')throw new RuntimeException('Upgrade changed existing user data');\n        if((int)$pdo->query('SELECT COUNT(*) FROM chat_member_reads')->fetchColumn()!==0)throw new RuntimeException('Upgrade wrote read state');\n    }finally{$pdo->exec('USE `'.$database.'`');$pdo->exec('DROP DATABASE IF EXISTS `'.$upgraded.'`');}\n    echo \"真实2.6.0→2.7.0整包、重复升级、账号/钱包保留与新装结构一致通过\\n\";\n    $trigger=$pdo->query(\"SELECT COUNT(*) FROM information_schema.triggers WHERE trigger_schema=DATABASE() AND trigger_name='chat_admin_identity_revoke'\")->fetchColumn();\n    if ((int)$trigger !== 1) throw new RuntimeException('Admin revocation trigger missing');\n    $count=(int)$pdo->query(\"SELECT COUNT(*) FROM information_schema.triggers WHERE trigger_schema=DATABASE() AND trigger_name LIKE 'chat_staff_%'\")->fetchColumn();\n    if($count!==9)throw new RuntimeException('Platform authority revocation triggers missing');\n    if((int)$pdo->query('SELECT COUNT(*) FROM chat_staff_authority_versions')->fetchColumn()!==(int)$pdo->query('SELECT COUNT(*)+1 FROM users')->fetchColumn())throw new RuntimeException('Initial authority generations missing');\n    $pdo->beginTransaction();\n    try {\n        $pdo->exec(\"INSERT INTO admin_users(username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES('chat-schema-fixture','fixture','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        $adminID=(string)$pdo->lastInsertId();\n        $statement=$pdo->prepare(\"INSERT INTO chat_admin_sessions(admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(?,REPEAT('a',64),REPEAT('b',64),REPEAT('c',64),'[\\\"chat:audit\\\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())\");\n        $statement->execute([$adminID]);\n        $pdo->exec(\"UPDATE admin_users SET role='viewer' WHERE id=\".$adminID);\n        if ((int)$pdo->query('SELECT COUNT(*) FROM chat_admin_sessions WHERE revoked_at IS NOT NULL')->fetchColumn() !== 1) throw new RuntimeException('Fresh trigger failed to revoke');\n    } finally { $pdo->rollBack(); }\n    echo '隔离新装与重复迁移结构验证通过，表数='.count($tables).\"\\n\";\n} finally { $pdo->exec('DROP DATABASE IF EXISTS `'.$database.'`'); }","server/database/upgrades/1.0.0.sql":"-- 2026-08-14：V1.0.0 是首次安装基线，完整表结构由 server/database/database.sql 创建。\n-- 2026-08-14：在线升级器遇到已经安装的 V1.0.0 时应通过 schema_migrations 校验后跳过本文件。\n-- 2026-08-14：本文件保留为可重复执行的空迁移，便于统一升级包格式，升级器负责写入迁移结果。\n\nSET NAMES utf8mb4;\nSELECT 'V1.0.0 baseline is already provided by database.sql' AS `migration_message`;\n","server/database/upgrades/1.0.1.sql":"-- 2026-08-14：V1.0.1 扩充订单生命周期字段，兼容完整的待退款状态文本。\n-- 2026-08-14：重复执行 MODIFY 不会改变业务数据，适用于异常中断后的人工复核重试。\n\nSET NAMES utf8mb4;\n\nALTER TABLE `orders`\n  MODIFY `lifecycle_status` VARCHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active';\n\nSELECT 'V1.0.1 lifecycle_status expanded to VARCHAR(40)' AS `migration_message`;\n","server/database/upgrades/1.0.2.sql":"-- 2026-08-23：V1.0.2 后台管理体验、类目化订单号、支付配置与演示数据升级。\n-- 2026-08-23：脚本支持 MySQL 5.7.44 并可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_102_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_102_schema`()\nBEGIN\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='service_categories' AND column_name='order_code'\n  ) THEN\n    ALTER TABLE `service_categories`\n      ADD COLUMN `order_code` VARCHAR(8) CHARACTER SET ascii COLLATE ascii_bin NULL AFTER `category_key`;\n  END IF;\n\n  UPDATE `service_categories` SET `order_code`='QZ' WHERE `category_key`='wallpaper';\n  UPDATE `service_categories` SET `order_code`='QB' WHERE `category_key`='wall_cloth';\n  UPDATE `service_categories` SET `order_code`='BLM' WHERE `category_key`='glass_film';\n  UPDATE `service_categories` SET `order_code`='JJM' WHERE `category_key`='furniture_film';\n  UPDATE `service_categories` SET `order_code`='CL' WHERE `category_key`='curtain';\n  UPDATE `service_categories` SET `order_code`='MF' WHERE `category_key`='grout';\n  UPDATE `service_categories`\n    SET `order_code`=CONCAT('C',LEFT(UPPER(CONV(`id`,10,36)),7))\n    WHERE `order_code` IS NULL OR `order_code`='' OR `order_code`='QT';\n\n  ALTER TABLE `service_categories`\n    MODIFY `order_code` VARCHAR(8) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'QT';\n\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.statistics\n    WHERE table_schema=DATABASE() AND table_name='service_categories' AND index_name='uq_service_categories_order_code'\n  ) THEN\n    ALTER TABLE `service_categories`\n      ADD UNIQUE KEY `uq_service_categories_order_code` (`order_code`);\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_102_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_102_schema`;\n\n-- 2026-08-23：新增运营基础设置、微信普通商户 API v3、订阅消息和短信配置。\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('site.name','壁选师傅订单管理系统','string','site',1,'后台及后续小程序接口显示的系统名称',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('site.icp_no','','string','site',1,'网站底部展示的 ICP 备案号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('site.customer_service_phone','','string','site',1,'运营客服电话',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.miniapp_appid','wx8736899b027f2b3b','string','wechat',0,'微信小程序 AppID',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.miniapp_secret','','string','wechat',0,'微信小程序 AppSecret，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.cloud_env','worker-real','string','wechat',0,'旧云开发环境 ID，用于渐进同步',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.subscribe_enabled','false','boolean','notification',0,'是否启用微信订阅消息',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.subscribe_template_ids','{}','json','notification',0,'订阅消息场景与模板 ID 映射',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.enabled','false','boolean','payment',0,'是否启用微信支付真实接口',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.mchid','','string','payment',0,'微信支付普通商户号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.api_v3_key','','string','payment',0,'微信支付 API v3 密钥，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.merchant_serial_no','','string','payment',0,'商户 API 证书序列号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.private_key','','string','payment',0,'商户 API 私钥 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.platform_cert_serial','','string','payment',0,'微信支付平台证书序列号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.platform_certificate','','string','payment',0,'微信支付平台证书 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.notify_url','https://worker.20m.cc/api/wechat/pay/notify','string','payment',0,'预约费支付结果回调地址',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wechat.pay.refund_notify_url','https://worker.20m.cc/api/wechat/refund/notify','string','payment',0,'预约费退款结果回调地址',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.enabled','false','boolean','sms',0,'是否启用短信通知',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.provider','','string','sms',0,'短信服务商标识',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.access_key_id','','string','sms',0,'短信 AccessKey ID，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.access_key_secret','','string','sms',0,'短信 AccessKey Secret，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.sign_name','','string','sms',0,'短信签名',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.template_codes','{}','json','sms',0,'短信场景与模板编码映射',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-23：补充不同业务步骤、待退款、邀请、时间线和订单图片演示数据。\nSET @demo_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\nSET @demo_customer_id=(SELECT `id` FROM `users` WHERE `public_id` LIKE '%DEMO%' ORDER BY `id` LIMIT 1);\nSET @demo_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%' ORDER BY `id` LIMIT 1);\nSET @order_schema_version_id=(SELECT `id` FROM `form_schema_versions` WHERE `status`='published' ORDER BY `id` DESC LIMIT 1);\nSET @category_wallpaper=(SELECT `id` FROM `service_categories` WHERE `category_key`='wallpaper' LIMIT 1);\nSET @category_wall_cloth=(SELECT `id` FROM `service_categories` WHERE `category_key`='wall_cloth' LIMIT 1);\nSET @category_furniture=(SELECT `id` FROM `service_categories` WHERE `category_key`='furniture_film' LIMIT 1);\nSET @category_grout=(SELECT `id` FROM `service_categories` WHERE `category_key`='grout' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-AUDIT-102',@demo_customer_id,@order_schema_version_id,@category_grout,'美缝','待管理员审核的美缝订单（演示）','用户已提交资料，等待管理员审核。','杭州市','余杭区','余杭区未来科技城附近（演示）','张**','138******01','pending','hidden','waiting','unassigned','not_started','unpaid','none','none','active',0,5000,1000,5000,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL\nON DUPLICATE KEY UPDATE `updated_at`=UTC_TIMESTAMP();\nSET @demo_order_audit=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-AUDIT-102' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-PAY-102',@demo_customer_id,@order_schema_version_id,@category_wallpaper,'墙纸','已选报价待付预约费（演示）','用户已选择平台报价，尚未支付 50 元预约费。','杭州市','萧山区','萧山区市心路附近（演示）','张**','138******01','approved','hidden','selected','unassigned','not_started','awaiting_payment','none','none','active',68000,5000,1000,5000,2,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL\nON DUPLICATE KEY UPDATE `updated_at`=UTC_TIMESTAMP();\nSET @demo_order_pay=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-PAY-102' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`assigned_worker_id`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`contact_revealed_at`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-BUILD-102',@demo_customer_id,@order_schema_version_id,@category_wall_cloth,'墙布','师傅施工中的墙布订单（演示）','已电话预约并进场施工，施工前照片为非必填。','杭州市','临平区','临平区南苑附近（演示）','张**','138******01','approved','hidden','selected','info_released','in_progress','paid','none','none','active',@demo_worker_id,120000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 HOUR,4,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL AND @demo_worker_id IS NOT NULL\nON DUPLICATE KEY UPDATE `assigned_worker_id`=VALUES(`assigned_worker_id`),`updated_at`=UTC_TIMESTAMP();\nSET @demo_order_build=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-BUILD-102' LIMIT 1);\n\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`title`,`description`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`cancelled_at`,`version`,`created_at`,`updated_at`)\nSELECT 'WO-DEMO-REFUND-PENDING-102',@demo_customer_id,@order_schema_version_id,@category_furniture,'家具膜','取消后待退款订单（演示）','管理员已同意未上门取消，等待微信退款人工审核。','杭州市','钱塘区','钱塘区金沙大道附近（演示）','张**','138******01','approved','hidden','selected','unassigned','not_started','paid','pending_review','none','cancel_approved_pending_refund',76000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 HOUR,4,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_customer_id IS NOT NULL\nON DUPLICATE KEY UPDATE `refund_status`='pending_review',`lifecycle_status`='cancel_approved_pending_refund',`updated_at`=UTC_TIMESTAMP();\nSET @demo_order_refund_pending=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-REFUND-PENDING-102' LIMIT 1);\n\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`currency`,`amount_cents`,`status`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'PAY-DEMO-PENDING-102','booking_fee',@demo_order_refund_pending,@demo_order_refund_pending,@demo_customer_id,'CNY',5000,'paid','演示待退款预约费',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_order_refund_pending IS NOT NULL\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`status`='paid',`updated_at`=UTC_TIMESTAMP();\nSET @demo_payment_refund_pending=LAST_INSERT_ID();\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`created_at`,`updated_at`)\nSELECT 'REF-DEMO-PENDING-102',@demo_payment_refund_pending,@demo_order_refund_pending,5000,'管理员已同意取消，等待人工审核（演示）','pending_review',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_payment_refund_pending>0\nON DUPLICATE KEY UPDATE `status`='pending_review',`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-23：邀请记录覆盖有效、已领取两种状态，令牌为不可使用的演示哈希。\nSET @demo_hall_order=(SELECT `id` FROM `orders` WHERE `public_no`='WO-DEMO-HALL-8K3M2Q7X' LIMIT 1);\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`created_at`)\nSELECT @demo_hall_order,9,1200,5000,'admin_adjustment','分享前调整为 12%（演示）',@demo_admin_id,'active',UTC_TIMESTAMP()-INTERVAL 2 HOUR\nFROM DUAL WHERE @demo_hall_order IS NOT NULL\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`rate_bp`=1200,`status`='active';\nSET @demo_invite_rule=LAST_INSERT_ID();\nINSERT INTO `invite_tokens` (`order_id`,`token_hash`,`purpose`,`created_by_admin_id`,`commission_rule_version_id`,`status`,`max_claims`,`claim_count`,`expires_at`,`created_at`)\nSELECT @demo_hall_order,SHA2('V102_DEMO_INVITE_NOT_USABLE',256),'worker_assignment',@demo_admin_id,@demo_invite_rule,'active',1,0,UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 2 HOUR\nFROM DUAL WHERE @demo_hall_order IS NOT NULL\nON DUPLICATE KEY UPDATE `status`='active',`expires_at`=VALUES(`expires_at`);\n\n-- 2026-08-23：图片文件均为升级包内的压缩演示资源，用于后台图片模块验收。\nINSERT INTO `media_files` (`public_id`,`storage_disk`,`storage_key`,`mime_type`,`extension`,`size_bytes`,`width_px`,`height_px`,`sha256`,`compression_quality`,`status`,`reference_count`,`created_at`) VALUES\n  (LEFT(SHA2('demo-material-102',256),26),'private_local','storage/private/uploads/demo/order-material.png','image/png','png',181195,750,270,'52c6f8f13731acad90f77da0310c7b32a320580094f28817ac9d2842fb7f1874',80,'active',1,UTC_TIMESTAMP()),\n  (LEFT(SHA2('demo-wall-102',256),26),'private_local','storage/private/uploads/demo/order-wall.png','image/png','png',62655,500,400,'8190a8bb9b71229f241af3fef50ce702bc05f613a1bb7fb78d2e77fcaa586fb3',80,'active',1,UTC_TIMESTAMP()),\n  (LEFT(SHA2('demo-completion-102',256),26),'private_local','storage/private/uploads/demo/order-completion.png','image/png','png',18844,200,200,'30e0a1e015bcf26f8d0efff252679ad62449f099f649ce0662e5094f0be37137',80,'active',1,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`status`='active';\nSET @demo_media_material=(SELECT `id` FROM `media_files` WHERE `storage_key`='storage/private/uploads/demo/order-material.png' LIMIT 1);\nSET @demo_media_wall=(SELECT `id` FROM `media_files` WHERE `storage_key`='storage/private/uploads/demo/order-wall.png' LIMIT 1);\nSET @demo_media_completion=(SELECT `id` FROM `media_files` WHERE `storage_key`='storage/private/uploads/demo/order-completion.png' LIMIT 1);\nINSERT IGNORE INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`)\nSELECT @demo_media_material,'order',@demo_hall_order,'material',10,'system',NULL,UTC_TIMESTAMP() FROM DUAL WHERE @demo_hall_order IS NOT NULL\nUNION ALL SELECT @demo_media_wall,'order',@demo_hall_order,'wall',20,'system',NULL,UTC_TIMESTAMP() FROM DUAL WHERE @demo_hall_order IS NOT NULL\nUNION ALL SELECT @demo_media_completion,'order',@demo_order_build,'before_optional',10,'system',NULL,UTC_TIMESTAMP() FROM DUAL WHERE @demo_order_build IS NOT NULL;\n\nINSERT IGNORE INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) VALUES\n  (@demo_order_audit,'order_submitted','demo:102:audit:submitted','user',@demo_customer_id,'{\"message\":\"用户提交订单，等待管理员审核\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n  (@demo_order_pay,'quote_selected','demo:102:pay:selected','user',@demo_customer_id,'{\"message\":\"用户已接受平台报价，等待支付预约费\"}',UTC_TIMESTAMP()-INTERVAL 20 HOUR),\n  (@demo_order_build,'appointment_recorded','demo:102:build:appointment','worker',@demo_worker_id,'{\"message\":\"师傅电话预约上门时间\"}',UTC_TIMESTAMP()-INTERVAL 1 DAY),\n  (@demo_order_build,'work_started','demo:102:build:started','worker',@demo_worker_id,'{\"message\":\"师傅已开始施工\"}',UTC_TIMESTAMP()-INTERVAL 4 HOUR),\n  (@demo_order_refund_pending,'cancel_approved','demo:102:refund:approved','admin',@demo_admin_id,'{\"message\":\"管理员同意取消，预约费进入待退款审核\"}',UTC_TIMESTAMP()-INTERVAL 1 HOUR),\n  (@demo_hall_order,'invite_created','demo:102:invite:created','admin',@demo_admin_id,'{\"message\":\"管理员生成受邀师傅分享记录，服务费 12%\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR);\n\nSELECT 'V1.0.2 admin console, order codes, payment settings and demo workflow upgraded' AS `migration_message`;\n","server/database/upgrades/1.0.3.sql":"-- 2026-08-24：V1.0.3 微信小程序订单、支付退款与师傅结算闭环升级。\n-- 2026-08-24：补充报价快照、配置及演示流程修正，兼容 MySQL 5.7.44，可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_103_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_103_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='quote_versions' AND column_name='commission_rate_bp_snapshot') THEN\n    ALTER TABLE `quote_versions` ADD COLUMN `commission_rate_bp_snapshot` INT UNSIGNED NOT NULL DEFAULT 1000 AFTER `booking_fee_cents`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='quote_versions' AND column_name='commission_min_cents_snapshot') THEN\n    ALTER TABLE `quote_versions` ADD COLUMN `commission_min_cents_snapshot` BIGINT UNSIGNED NOT NULL DEFAULT 5000 AFTER `commission_rate_bp_snapshot`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='quote_versions' AND column_name='rule_acknowledged_at') THEN\n    ALTER TABLE `quote_versions` ADD COLUMN `rule_acknowledged_at` DATETIME NULL AFTER `commission_min_cents_snapshot`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_103_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_103_schema`;\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('app.version','1.0.3','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('commission.payment_due_days','3','integer','finance',0,'订单验收后师傅缴纳平台服务费的期限天数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('withdrawal.minimum_cents','100','integer','finance',0,'师傅单次最低提现金额，单位分',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings` SET `setting_value`='1.0.3',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\n-- 2026-08-23：V1.0.2 的无查询参数回调会被宝塔目录规则送回站点首页，只替换旧默认值，不覆盖商户自行配置。\nUPDATE `system_settings`\nSET `setting_value`='https://worker.20m.cc/api/?route=wechatpay.notify',`description`='支付结果回调地址，须指向同域 API 公开验签路由',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/wechat/pay/notify');\n\nUPDATE `system_settings`\nSET `setting_value`='https://worker.20m.cc/api/?route=wechatpay.refund_notify',`description`='退款结果回调地址，须指向同域 API 公开验签路由',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.refund_notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/wechat/refund/notify');\n\n-- 2026-08-24：统一图片键为相对 storage/private 的 uploads/...，修复旧演示图和后台图片重复拼目录。\nUPDATE `media_files`\nSET `storage_key`=SUBSTRING(`storage_key`,17)\nWHERE `storage_key` LIKE 'storage/private/uploads/%';\n\n-- 2026-08-24：首期不设置“开始施工”动作，旧演示订单改为电话预约后直接等待完工提交。\nUPDATE `orders`\nSET `title`='师傅已预约的墙布订单（演示）',`description`='已电话预约，施工前照片为非必填，完成后直接提交完工照。',`fulfillment_status`='scheduled',`updated_at`=UTC_TIMESTAMP()\nWHERE `public_no`='WO-DEMO-BUILD-102';\n\nUPDATE `order_events`\nSET `event_type`='before_photo_uploaded',`event_key`='demo:103:build:before-photo',`payload_json`='{\"message\":\"师傅上传了非必填施工前照片\"}'\nWHERE `event_key`='demo:102:build:started';\n\n-- 2026-08-24：补一条待平台跟进的尾款延期演示记录，便于升级后直接查看结算异常流程。\nINSERT INTO `offline_payment_delay_requests` (`order_id`,`worker_id`,`amount_cents_snapshot`,`reason`,`expected_collect_at`,`status`,`submitted_at`,`created_at`,`updated_at`)\nSELECT o.`id`,w.`id`,115000,'业主约定三天后补付线下尾款（演示）',UTC_TIMESTAMP()+INTERVAL 3 DAY,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `orders` o JOIN `worker_profiles` w ON w.`public_id`='01K2DEMOWORKER000000000001'\nWHERE o.`public_no`='WO-DEMO-BUILD-102'\n  AND NOT EXISTS (SELECT 1 FROM `offline_payment_delay_requests` d WHERE d.`order_id`=o.`id` AND d.`worker_id`=w.`id`);\n\nSELECT 'V1.0.3 mini-program order, WeChat Pay and worker settlement workflow upgraded' AS `migration_message`;\n","server/database/upgrades/1.0.4.sql":"-- 2026-08-24：V1.0.4 微信支付 v2/v3、师傅云资料快照与中文字段字典升级。\n-- 2026-08-24：兼容 MySQL 5.7.44，脚本可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_104_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_104_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='payment_orders' AND column_name='api_version') THEN\n    ALTER TABLE `payment_orders` ADD COLUMN `api_version` VARCHAR(8) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'v3' AFTER `mch_id`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_snapshot_json') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_snapshot_json` LONGTEXT NULL AFTER `cloud_worker_id`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_record_count') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_record_count` INT UNSIGNED NOT NULL DEFAULT 0 AFTER `cloud_snapshot_json`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_record_mode') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_record_mode` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'legacy' AFTER `cloud_record_count`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='cloud_last_synced_at') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `cloud_last_synced_at` DATETIME NULL AFTER `cloud_record_mode`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_104_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_104_schema`;\n\nCREATE TABLE IF NOT EXISTS `database_field_dictionary` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '字典主键',\n  `table_name` VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '数据表英文名',\n  `field_name` VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '字段英文名',\n  `chinese_name` VARCHAR(80) NOT NULL COMMENT '字段中文名',\n  `description` VARCHAR(255) NOT NULL DEFAULT '' COMMENT '业务说明',\n  `created_at` DATETIME NOT NULL COMMENT '创建时间',\n  `updated_at` DATETIME NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_database_field_dictionary_field` (`table_name`,`field_name`),\n  KEY `idx_database_field_dictionary_chinese` (`chinese_name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='数据库字段中文名字典';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','1.0.4','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.api_version','v3','string','payment',0,'新建支付单使用的接口版本：v2 或 v3',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.api_v2_key','','string','payment',0,'微信支付 API v2 密钥，32 位，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.v2_client_certificate','','string','payment',0,'API v2 退款使用的商户证书 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.pay.v2_client_key','','string','payment',0,'API v2 退款使用的证书私钥 PEM，加密保存',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\nUPDATE `system_settings` SET `setting_value`='1.0.4',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\n-- 2026-08-24：API v2 规范要求回调 URL 不携带参数，只替换系统旧默认值，不覆盖商户自定义域名。\nUPDATE `system_settings` SET `setting_value`='https://worker.20m.cc/api/wechatpay/notify',`description`='支付结果回调地址，API v2 不得携带查询参数',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/?route=wechatpay.notify');\nUPDATE `system_settings` SET `setting_value`='https://worker.20m.cc/api/wechatpay/refund-notify',`description`='退款结果回调地址，API v2 不得携带查询参数',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.pay.refund_notify_url' AND `setting_value` IN ('','https://worker.20m.cc/api/?route=wechatpay.refund_notify');\n\n-- 2026-08-24：英文物理字段保持 API 稳定，中文名集中维护，可在开发设置中查询。\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('users','id','用户ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','public_id','用户公开编号','对外可展示的用户编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','nickname','用户昵称','微信或本地昵称',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','avatar_url','用户头像','头像地址',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','mobile_masked','脱敏手机号','仅用于展示',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','status','用户状态','账号状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','cloud_user_id','云用户ID','旧云开发 user 记录ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('users','last_synced_at','最后同步时间','云数据最后同步时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','id','师傅ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','user_id','关联用户ID','一个用户唯一对应一份师傅档案',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','display_name','师傅姓名','师傅对外展示名称',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','verification_status','审核状态','pending/approved/rejected/suspended',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','city','居住城市','师傅居住城市',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','district','居住区县','师傅居住区县',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_worker_id','云师傅主记录ID','当前主记录的云数据库ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_snapshot_json','云资料快照','包含主记录和历史多条记录',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_record_count','云记录数','旧模式留存的 worker 记录数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_record_mode','发布记录模式','unique 或 legacy',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('worker_profiles','cloud_last_synced_at','云资料同步时间','该师傅资料的最后同步时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','id','订单ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','public_no','订单号','BX+类目拼音码+时间+随机数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','user_id','下单用户ID','订单所属用户',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','category_id','服务类目ID','关联可配置类目',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','title','订单标题','后台和大厅摘要',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','audit_status','审核状态','管理员审核状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','publish_status','大厅发布状态','是否在接单大厅展示',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','quote_status','报价状态','报价选择进度',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','fulfillment_status','施工状态','预约、完工与验收进度',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','payment_status','支付状态','50元预约费状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','refund_status','退款状态','退款审核和入账状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','lifecycle_status','订单生命周期','active/completed/cancelled 等',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','assigned_worker_id','指派师傅ID','当前最终履约师傅',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','final_amount_cents','订单总额（分）','最终确认价格',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','booking_fee_cents','预约费（分）','线上支付预约费',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('orders','commission_rate_bp','服务费比例（万分比）','1000 表示 10%',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('quotes','id','报价ID','报价主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('quotes','quote_type','报价类型','worker 师傅报价或 platform 平台报价',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('quotes','worker_id','报价师傅ID','平台报价可为空',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('quotes','status','报价状态','报价有效状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('payment_orders','id','支付单ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','public_no','商户支付单号','提交给微信支付的唯一单号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','business_type','支付业务类型','booking_fee 或 commission',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','payer_openid','付款人OpenID','小程序付款人',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','mch_id','微信商户号','创建支付单时快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','api_version','支付接口版本','v2 或 v3，退款沿用该值',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','amount_cents','支付金额（分）','不使用浮点数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','status','支付单状态','created/pending/paid/refunded/closed',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','wechat_prepay_id','微信预支付ID','requestPayment 签名使用',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('payment_orders','wechat_transaction_id','微信支付单号','微信交易号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('refunds','id','退款单ID','MySQL 内部主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('refunds','public_no','商户退款单号','提交给微信支付的唯一退款号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('refunds','amount_cents','退款金额（分）','本次退款金额',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('refunds','status','退款状态','审核、处理、成功或失败',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('system_settings','setting_key','设置键','程序稳定读取的英文键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('system_settings','setting_value','设置值','敏感值以 AES-GCM 密文保存',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('system_settings','group_name','设置分组','后台分块展示与独立保存',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('form_schemas','schema_key','表单编码','order_submit 为用户下单表单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('form_schemas','current_version','当前编辑版本','可指向未发布草稿',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('form_schema_versions','version_no','表单版本号','按发布版本回退查找',UTC_TIMESTAMP(),UTC_TIMESTAMP()),('form_schema_versions','status','版本状态','draft/published/archived',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V1.0.4 WeChat Pay v2/v3, worker cloud snapshots and Chinese field dictionary upgraded' AS `migration_message`;\n","server/database/upgrades/1.0.5.sql":"-- 2026-08-25：V1.0.5 多类目、实名认证、管理工作台及运营配置升级。\n-- 2026-08-25：兼容 MySQL 5.7.44；DDL 与数据补齐均可重复执行。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_105_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_105_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='category_names_snapshot') THEN\n    ALTER TABLE `orders` ADD COLUMN `category_names_snapshot` VARCHAR(255) NOT NULL DEFAULT '不确定类目' AFTER `category_name_snapshot`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='is_demo') THEN\n    ALTER TABLE `orders` ADD COLUMN `is_demo` TINYINT UNSIGNED NOT NULL DEFAULT 0 AFTER `version`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_105_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_105_schema`;\n\nCREATE TABLE IF NOT EXISTS `order_categories` (\n  `order_id` BIGINT UNSIGNED NOT NULL,\n  `category_id` BIGINT UNSIGNED NOT NULL,\n  `category_name_snapshot` VARCHAR(80) NOT NULL,\n  `sort_order` INT NOT NULL DEFAULT 0,\n  `created_at` DATETIME NOT NULL,\n  PRIMARY KEY (`order_id`,`category_id`),\n  KEY `idx_order_categories_category` (`category_id`,`order_id`),\n  CONSTRAINT `fk_order_categories_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_categories_category` FOREIGN KEY (`category_id`) REFERENCES `service_categories` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-25：订单多类目关系';\n\nCREATE TABLE IF NOT EXISTS `worker_real_name_verifications` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n  `worker_id` BIGINT UNSIGNED NOT NULL,\n  `real_name_masked` VARCHAR(80) NOT NULL DEFAULT '',\n  `real_name_ciphertext` TEXT NULL,\n  `id_number_masked` VARCHAR(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '',\n  `id_number_ciphertext` TEXT NULL,\n  `id_number_hmac` CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `status` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft',\n  `review_reason` VARCHAR(500) NULL,\n  `reviewed_by` BIGINT UNSIGNED NULL,\n  `submitted_at` DATETIME NULL,\n  `reviewed_at` DATETIME NULL,\n  `created_at` DATETIME NOT NULL,\n  `updated_at` DATETIME NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_worker_real_name_worker` (`worker_id`),\n  KEY `idx_worker_real_name_status` (`status`,`submitted_at`),\n  CONSTRAINT `fk_worker_real_name_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_real_name_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-25：师傅实名认证';\n\n-- 2026-08-25：旧单首类目自动转入关系表，原字段继续作为兼容字段和订单号类目码来源。\nINSERT IGNORE INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`)\nSELECT `id`,`category_id`,`category_name_snapshot`,0,COALESCE(`created_at`,UTC_TIMESTAMP()) FROM `orders` WHERE `category_id` IS NOT NULL;\nUPDATE `orders` SET `category_names_snapshot`=`category_name_snapshot` WHERE `category_names_snapshot`='' OR `category_names_snapshot`='不确定类目';\nUPDATE `orders` SET `is_demo`=1 WHERE `public_no` LIKE '%DEMO%';\nUPDATE form_fields SET label='是否拆旧翻新',updated_at=UTC_TIMESTAMP() WHERE field_key='is_renovation';\nUPDATE form_fields SET label='现场环境/墙面图片',updated_at=UTC_TIMESTAMP() WHERE field_key='wall_images';\nUPDATE order_answers SET field_label_snapshot='是否拆旧翻新',updated_at=UTC_TIMESTAMP() WHERE field_key_snapshot='is_renovation';\nUPDATE order_answers SET field_label_snapshot='现场环境/墙面图片',updated_at=UTC_TIMESTAMP() WHERE field_key_snapshot='wall_images';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','1.0.5','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.admin_openids','[\"oyAoh5UdSEEWJAQphBD05Uk6DMWg\"]','json','wechat',0,'可进入小程序管理员工作台的 OpenID 列表',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\nUPDATE `system_settings` SET `setting_value`='1.0.5',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='app.version';\n\n-- 2026-08-25：运营明确选择明文维护接口密钥；旧密文可继续读取，下一次在后台保存后写为明文。\nUPDATE `system_settings` SET `description`=REPLACE(`description`,'加密保存','明文保存'),`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key` REGEXP '(^wechat\\\\.|^sms\\\\.)' AND `description` LIKE '%加密保存%';\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('orders','category_names_snapshot','服务类目名称','多选类目名称快照，使用顿号分隔',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','is_demo','演示数据','1 表示仅供后台排查流程的演示订单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order_categories','order_id','订单ID','订单多类目关系中的订单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order_categories','category_id','服务类目ID','订单选择的一级类目',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('order_categories','category_name_snapshot','类目名称快照','下单时的类目中文名称',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','worker_id','师傅ID','实名认证所属师傅',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','real_name_masked','脱敏姓名','后台列表仅显示脱敏姓名',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','id_number_masked','脱敏身份证号','后台列表仅显示部分身份证号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','status','实名状态','draft/pending/approved/rejected',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-25：只清理带 DEMO 标记的业务链，再生成 V1.0.5 全状态基线；真实用户、真实订单和真实资金记录不受影响。\nDROP TEMPORARY TABLE IF EXISTS `worker_v105_demo_orders`;\nCREATE TEMPORARY TABLE `worker_v105_demo_orders` (`id` BIGINT UNSIGNED NOT NULL PRIMARY KEY) ENGINE=MEMORY\nSELECT `id` FROM `orders` WHERE `is_demo`=1 OR `public_no` LIKE '%DEMO%';\nDROP TEMPORARY TABLE IF EXISTS `worker_v105_demo_withdrawals`;\nCREATE TEMPORARY TABLE `worker_v105_demo_withdrawals` (`id` BIGINT UNSIGNED NOT NULL PRIMARY KEY) ENGINE=MEMORY\nSELECT `id` FROM `withdrawal_requests` WHERE `public_no` LIKE '%DEMO%';\n\nSET @worker_v105_old_fk_checks=@@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\nDELETE FROM `review_media` WHERE `review_id` IN (SELECT `id` FROM `reviews` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `review_replies` WHERE `review_id` IN (SELECT `id` FROM `reviews` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `dispute_evidence` WHERE `dispute_id` IN (SELECT `id` FROM `disputes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `quote_items` WHERE `quote_version_id` IN (SELECT `id` FROM `quote_versions` WHERE `quote_id` IN (SELECT `id` FROM `quotes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`)));\nDELETE FROM `quote_selections` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `quote_versions` WHERE `quote_id` IN (SELECT `id` FROM `quotes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `payment_notifications` WHERE `payment_order_id` IN (SELECT `id` FROM `payment_orders` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\n-- 2026-08-25：MySQL 5.7 同一语句不能二次打开同一个临时表，按关联来源拆成两条幂等删除。\nDELETE FROM `commission_payments` WHERE `receivable_id` IN (SELECT `id` FROM `commission_receivables` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `commission_payments` WHERE `payment_order_id` IN (SELECT `id` FROM `payment_orders` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `change_confirmations` WHERE `change_request_id` IN (SELECT `id` FROM `change_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`));\nDELETE FROM `order_cancel_decisions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `refunds` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `payment_orders` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `assignment_history` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `commission_receivables` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `reviews` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `disputes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `after_sales` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_cancel_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `completion_submissions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `offline_payment_delay_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `change_requests` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `appointment_records` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `exceptional_arrivals` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_role_grants` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `assignments` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `invite_tokens` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `share_contexts` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `commission_rule_versions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `quotes` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_deadlines` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_events` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_revisions` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_answers` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_addresses` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `order_categories` WHERE `order_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `media_links` WHERE `entity_type`='order' AND `entity_id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `orders` WHERE `id` IN (SELECT `id` FROM `worker_v105_demo_orders`);\nDELETE FROM `withdrawal_allocations` WHERE `withdrawal_request_id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`);\nDELETE FROM `withdrawal_events` WHERE `withdrawal_request_id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`);\nDELETE FROM `worker_payouts` WHERE `withdrawal_request_id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`) OR `public_no` LIKE '%DEMO%';\nDELETE FROM `worker_balance_ledger` WHERE `idempotency_key` LIKE 'demo:%';\nDELETE FROM `withdrawal_requests` WHERE `id` IN (SELECT `id` FROM `worker_v105_demo_withdrawals`);\nDELETE FROM `worker_payout_accounts` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%');\nDELETE FROM `media_links` WHERE `entity_type`='worker_verification' AND `entity_id` IN (SELECT `id` FROM `worker_real_name_verifications` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%'));\nDELETE FROM `worker_real_name_verifications` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%');\nDELETE FROM `rating_summaries` WHERE `worker_id` IN (SELECT `id` FROM `worker_profiles` WHERE `public_id` LIKE '%DEMO%');\nDELETE FROM `audit_logs` WHERE `request_id` LIKE 'DEMO-%';\nSET FOREIGN_KEY_CHECKS=@worker_v105_old_fk_checks;\n\nSET @demo_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\nSET @order_schema_version_id=(SELECT v.`id` FROM `form_schema_versions` v INNER JOIN `form_schemas` s ON s.`id`=v.`schema_id` WHERE s.`schema_key`='order_submit' AND v.`status`='published' ORDER BY v.`version_no` DESC LIMIT 1);\nSET @category_wallpaper=(SELECT `id` FROM `service_categories` WHERE `category_key`='wallpaper' LIMIT 1);\nSET @category_wall_cloth=(SELECT `id` FROM `service_categories` WHERE `category_key`='wall_cloth' LIMIT 1);\nSET @category_glass_film=(SELECT `id` FROM `service_categories` WHERE `category_key`='glass_film' LIMIT 1);\nSET @category_furniture_film=(SELECT `id` FROM `service_categories` WHERE `category_key`='furniture_film' LIMIT 1);\nSET @category_curtain=(SELECT `id` FROM `service_categories` WHERE `category_key`='curtain' LIMIT 1);\nSET @category_grout=(SELECT `id` FROM `service_categories` WHERE `category_key`='grout' LIMIT 1);\n\nINSERT INTO `users` (`public_id`,`nickname`,`mobile_masked`,`status`,`created_at`,`updated_at`) VALUES\n('01K2DEMOUSER00000000000001','演示业主','138******01','active',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('01K2DEMOWORKER000000000001','演示师傅','139******02','active',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('01K2DEMOPENDING0000000001','待审核演示师傅','137******03','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `nickname`=VALUES(`nickname`),`mobile_masked`=VALUES(`mobile_masked`),`status`='active',`updated_at`=UTC_TIMESTAMP();\nSET @demo_customer_id=(SELECT `id` FROM `users` WHERE `public_id`='01K2DEMOUSER00000000000001' LIMIT 1);\nSET @demo_worker_user_id=(SELECT `id` FROM `users` WHERE `public_id`='01K2DEMOWORKER000000000001' LIMIT 1);\nSET @demo_pending_user_id=(SELECT `id` FROM `users` WHERE `public_id`='01K2DEMOPENDING0000000001' LIMIT 1);\nINSERT INTO `worker_profiles` (`user_id`,`public_id`,`display_name`,`mobile_masked`,`verification_status`,`invited_only`,`city`,`district`,`address_masked`,`lat`,`lng`,`rating`,`completed_orders`,`verified_at`,`verified_by`,`created_at`,`updated_at`) VALUES\n(@demo_worker_user_id,'01K2DEMOWORKERPROFILE00001','王师傅（演示）','139******02','approved',0,'杭州市','西湖区','西湖区文三路附近',30.2741000,120.1551000,5.00,12,UTC_TIMESTAMP(),@demo_admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n(@demo_pending_user_id,'01K2DEMOPENDINGPROFILE001','李师傅（待审核演示）','137******03','pending',0,'杭州市','余杭区','余杭区附近',30.4188000,120.2994000,5.00,0,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `display_name`=VALUES(`display_name`),`verification_status`=VALUES(`verification_status`),`city`=VALUES(`city`),`district`=VALUES(`district`),`updated_at`=UTC_TIMESTAMP();\nSET @demo_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `public_id`='01K2DEMOWORKERPROFILE00001' LIMIT 1);\nSET @demo_pending_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `public_id`='01K2DEMOPENDINGPROFILE001' LIMIT 1);\nSET @demo_role_customer=(SELECT `id` FROM `roles` WHERE `role_key`='customer' LIMIT 1);\nSET @demo_role_worker=(SELECT `id` FROM `roles` WHERE `role_key`='worker' LIMIT 1);\nSET @demo_role_pending=(SELECT `id` FROM `roles` WHERE `role_key`='worker_pending' LIMIT 1);\nINSERT IGNORE INTO `user_roles` (`user_id`,`role_id`,`source`,`granted_by_admin_id`,`created_at`) VALUES\n(@demo_customer_id,@demo_role_customer,'demo_seed',@demo_admin_id,UTC_TIMESTAMP()),\n(@demo_worker_user_id,@demo_role_worker,'demo_seed',@demo_admin_id,UTC_TIMESTAMP()),\n(@demo_pending_user_id,@demo_role_pending,'demo_seed',@demo_admin_id,UTC_TIMESTAMP());\n\n-- 2026-08-25：订单状态覆盖待审核、大厅报价、待支付、履约争议、待验收、已完成、待退款、退款成功、过期和邀请接单。\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,`is_renovation`,`city`,`district`,`address_summary`,`lat`,`lng`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`assigned_worker_id`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`completion_submitted_at`,`accepted_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`) VALUES\n('WO-DEMO-AUDIT-102',@demo_customer_id,@order_schema_version_id,@category_grout,'美缝','美缝','待审核美缝订单（演示）','资料已提交，等待管理员审核。','约 80 米',0,'杭州市','余杭区','未来科技城附近（演示）',30.2800000,120.0200000,'张**','138******01','pending','hidden','waiting','unassigned','not_started','unpaid','none','none','active',NULL,0,5000,1000,5000,NULL,NULL,NULL,NULL,NULL,1,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()),\n('WO-DEMO-HALL-8K3M2Q7X',@demo_customer_id,@order_schema_version_id,@category_wallpaper,'墙纸','墙纸、墙布','墙纸与墙布组合施工（多类目演示）','大厅同时存在师傅报价与平台报价。','约 45 平方米',1,'杭州市','西湖区','文二路附近（演示）',30.2819000,120.1280000,'张**','138******01','approved','published','quoting','unassigned','not_started','unpaid','none','none','active',NULL,0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 6 DAY,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-PAY-102',@demo_customer_id,@order_schema_version_id,@category_wallpaper,'墙纸','墙纸','已选报价待付预约费（演示）','用户已选择报价，等待支付预约费。','约 30 平方米',0,'杭州市','萧山区','市心路附近（演示）',30.1700000,120.2500000,'张**','138******01','approved','hidden','selected_pending_payment','unassigned','not_started','awaiting_payment','none','none','active',NULL,68000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 6 DAY,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-BUILD-102',@demo_customer_id,@order_schema_version_id,@category_wall_cloth,'墙布','墙布','预约施工、尾款延期且有争议（演示）','用户拒绝加价，双方协商未果，等待管理员裁定。','约 90 平方米',1,'杭州市','临平区','南苑附近（演示）',30.4100000,120.3000000,'张**','138******01','approved','hidden','selected','info_released','scheduled','paid','none','open','active',@demo_worker_id,120000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()+INTERVAL 3 DAY,NULL,NULL,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-COMPLETE-105',@demo_customer_id,@order_schema_version_id,@category_curtain,'窗帘','窗帘','师傅已提交完工待验收（演示）','完工照已提交，72 小时后自动验收。','2 套',0,'杭州市','上城区','庆春路附近（演示）',30.2600000,120.1800000,'张**','138******01','approved','hidden','selected','assigned','submitted','paid','none','none','active',@demo_worker_id,90000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 5 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 20 HOUR,NULL,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-DONE-4T8Y6U2A',@demo_customer_id,@order_schema_version_id,@category_glass_film,'玻璃膜','玻璃膜','已验收评价与服务费账单（演示）','用于查看已完成、评价图片和服务费结算。','约 35 平方米',0,'杭州市','滨江区','江南大道附近（演示）',30.2000000,120.2100000,'张**','138******01','approved','hidden','selected','assigned','accepted','paid','none','none','completed',@demo_worker_id,100000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 12 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,7,1,UTC_TIMESTAMP()-INTERVAL 12 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-REFUND-PENDING-102',@demo_customer_id,@order_schema_version_id,@category_furniture_film,'家具膜','家具膜','取消后部分退款待审核（演示）','预约费 50 元，本次拟部分退款 25 元。','1 组',0,'杭州市','钱塘区','金沙大道附近（演示）',30.3000000,120.3500000,'张**','138******01','approved','hidden','selected','unassigned','not_started','paid','pending_review','none','cancel_approved_pending_refund',NULL,76000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-REFUND-7C3B9M5D',@demo_customer_id,@order_schema_version_id,@category_curtain,'窗帘','窗帘','已取消退款成功（演示）','未上门取消，预约费已原路退款。','1 套',0,'杭州市','上城区','湖滨附近（演示）',30.2500000,120.1700000,'张**','138******01','approved','hidden','cancelled','cancelled','cancelled','refunded','succeeded','resolved','cancelled',NULL,60000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 7 DAY,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 3 DAY,6,1,UTC_TIMESTAMP()-INTERVAL 7 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-EXPIRED-105',@demo_customer_id,@order_schema_version_id,NULL,'不确定类目','不确定类目','七天未成交自动取消（演示）','无报价或用户未接受报价，系统已到期取消。','待沟通',NULL,'杭州市','拱墅区','运河附近（演示）',30.3200000,120.1500000,'张**','138******01','approved','hidden','cancelled','unassigned','not_started','unpaid','none','none','expired',NULL,0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,2,1,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()),\n('WO-DEMO-I