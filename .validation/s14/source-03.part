MMENT '审核原因',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `submitted_at` datetime DEFAULT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `worker_verifications`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `submitted_snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '提交快照JSON',\n  MODIFY COLUMN `decision` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '处理决定',\n  MODIFY COLUMN `decision_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '决定原因',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间';\nALTER TABLE `help_categories`\n  MODIFY COLUMN `id` int unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '代码',\n  MODIFY COLUMN `name` varchar(80) NOT NULL COMMENT '名称',\n  MODIFY COLUMN `sort_order` int NOT NULL DEFAULT 0 COMMENT '排序值',\n  MODIFY COLUMN `homepage_featured` tinyint(1) NOT NULL DEFAULT 0 COMMENT '首页推荐',\n  MODIFY COLUMN `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `help_faqs`\n  MODIFY COLUMN `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '问答ID',\n  MODIFY COLUMN `category_id` int unsigned NOT NULL COMMENT '类目ID',\n  MODIFY COLUMN `question` varchar(255) NOT NULL COMMENT '问题',\n  MODIFY COLUMN `answer` text NOT NULL COMMENT '回答',\n  MODIFY COLUMN `aliases` text NULL COMMENT '别名',\n  MODIFY COLUMN `keywords` text NULL COMMENT '关键词',\n  MODIFY COLUMN `roles` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'all' COMMENT '适用角色',\n  MODIFY COLUMN `sort_order` int NOT NULL DEFAULT 0 COMMENT '排序值',\n  MODIFY COLUMN `is_featured` tinyint(1) NOT NULL DEFAULT 0 COMMENT '是否推荐',\n  MODIFY COLUMN `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft' COMMENT '状态',\n  MODIFY COLUMN `related_faq_ids` text NULL COMMENT '相关问答ID列表',\n  MODIFY COLUMN `business_entry_label` varchar(80) NOT NULL DEFAULT '' COMMENT '业务记录标签',\n  MODIFY COLUMN `business_entry_path` varchar(255) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT '业务记录路径',\n  MODIFY COLUMN `draft_payload` longtext NULL COMMENT '草稿内容',\n  MODIFY COLUMN `version` int unsigned NOT NULL DEFAULT 1 COMMENT '版本号',\n  MODIFY COLUMN `published_version` int unsigned NOT NULL DEFAULT 0 COMMENT '已发布版本',\n  MODIFY COLUMN `published_at` datetime NULL COMMENT '发布时间',\n  MODIFY COLUMN `created_by` int unsigned NULL COMMENT '创建人ID',\n  MODIFY COLUMN `updated_by` int unsigned NULL COMMENT '更新人ID',\n  MODIFY COLUMN `deleted_at` datetime NULL COMMENT '删除时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `help_faq_versions`\n  MODIFY COLUMN `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '问答ID',\n  MODIFY COLUMN `version` int unsigned NOT NULL COMMENT '版本号',\n  MODIFY COLUMN `snapshot_json` longtext NOT NULL COMMENT '快照JSON',\n  MODIFY COLUMN `action` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  MODIFY COLUMN `operator_admin_id` int unsigned