 (`public_no`,`order_id`,`user_id`,`type`,`description`,`warranty_months_snapshot`,`warranty_expires_at_snapshot`,`non_human_confirmed`,`evidence_media_ids_json`,`status`,`opened_at`,`created_at`,`updated_at`) VALUES\n('AS-V228-WARRANTY',@v228_warranty_order,@v228_user_id,'warranty_repair','玻璃膜边缘局部翘起，申请保障期内复查。',6,UTC_TIMESTAMP()+INTERVAL 5 MONTH,1,NULL,'open',UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP());\nINSERT INTO `order_events` (`order_id`,`event_type`,`actor_type`,`actor_id`,`payload_json`,`created_at`) VALUES (@v228_warranty_order,'warranty_repair_requested','user',@v228_user_id,'{\"message\":\"演示：用户提交维修申请，订单进入待维修阶段\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR);\nINSERT INTO `notifications` (`public_id`,`recipient_type`,`recipient_id`,`channel`,`template_key`,`title`,`content`,`data_json`,`status`,`scheduled_at`,`created_at`) VALUES (LEFT(SHA2('v228-warranty-worker-notice',256),26),'worker',@v228_worker_id,'in_app','warranty_repair_requested','待维修：用户已提交售后申请','演示订单收到维修申请，请尽快处理',CONCAT('{\"order_id\":',@v228_warranty_order,',\"event_key\":\"v228-demo-warranty\"}'),'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\nSET @v228_refund_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXCL202609155841');\nSET @v228_refund_payment=(SELECT `id` FROM `payment_orders` WHERE `order_id`=@v228_refund_order AND `business_type`='order_booking' LIMIT 1);\nINSERT INTO `order_cancel_requests` (`public_id`,`order_id`,`applicant_type`,`applicant_id`,`request_type`,`order_state_snapshot_json`,`reason_code`,`reason`,`status`,`requested_refund_cents`,`requested_at`,`closed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v228-cancel-pending',256),26),@v228_refund_order,'user',@v228_user_id,'cancel_refund','{\"fulfillment_status\":\"scheduled\",\"assignment_status\":\"accepted\",\"payment_status\":\"paid\"}','schedule_changed','行程变化，师傅确认尚未上门，申请退回部分预约费。','approved',2500,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP());\nSET @v228_cancel=LAST_INSERT_ID();\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`cancel_request_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`created_at`,`updated_at`) VALUES ('REF-V228-PENDING',@v228_refund_payment,@v228_refund_order,@v228_cancel,2500,'管理员核准部分退款25.00元','pending_review',@v228_admin_id,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP());\nSET @v228_refund_pending=LAST_INSERT_ID();\nINSERT INTO `order_cancel_decisions` (`cancel_request_id`,`order_id`,`decision`,`responsibility`,`reason`,`refund_amount_cents`,`run_empty_fee_cents`,`refund_id`,`decided_by`,`decided_at`,`created_at`) VALUES\n(@v228_cancel,@v228_refund_order,'approved','shared','师傅确认尚未上门，双方协商后核准退回25.00元。',2500,0,@v228_refund_pending,@v228_admin_id,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP()-INTERVAL 40 MINUTE);\n\nSET @v228_expired_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXMF202609151275');\nSET @v228_expired_payment=(SELECT `id` FROM `payment_orders` WHERE `order_id`=@v228_expired_order AND `business_type`='order_booking' LIMIT 1);\nINSERT INTO `order_cancel_requests` (`public_id`,`order_id`,`applicant_type`,`applicant_id`,`request_type`,`order_state_snapshot_json`,`reason_code`,`reason`,`status`,`requested_refund_cents`,`requested_at`,`closed_at`,`created_at`,`updated_at`) VALUES\n(LEFT(SHA2('v228-cancel-expired',256),26),@v228_expired_order,'system',NULL,'cancel_refund','{\"quote_status\":\"closed\",\"assignment_status\":\"unassigned\",\"payment_status\":\"paid\"}','quote_timeout','超过七天未接受报价，系统自动取消并发起全额退款。','approved',5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 23 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\nSET @v228_cancel_expired=LAST_INSERT_ID();\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`cancel_request_id`,`amount_cents`,`reason`,`status`,`wechat_refund_id`,`requested_at`,`succeeded_at`,`created_at`,`updated_at`) VALUES ('REF-V228-DONE',@v228_expired_payment,@v228_expired_order,@v228_cancel_expired,5000,'七天未接受报价自动取消并全额退款','succeeded','V228_REFUND_DONE',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 23 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\nSET @v228_refund_expired=LAST_INSERT_ID();\nINSERT INTO `order_cancel_decisions` (`cancel_request_id`,`order_id`,`decision`,`responsibility`,`reason`,`refund_amount_cents`,`run_empty_fee_cents`,`refund_id`,`decided_by`,`decided_at`,`created_at`) VALUES\n(@v228_cancel_expired,@v228_expired_order,'approved','platform','系统规则：七天未接受报价自动取消，全额退回预约费。',5000,0,@v228_refund_expired,NULL,UTC_TIMESTAMP()-INTERVAL 23 HOUR,UTC_TIMESTAMP()-INTERVAL 23 HOUR);\n\nSET @v228_dispute_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQB202609157736');\nINSERT INTO `change_requests` (`public_id`,`order_id`,`worker_id`,`original_amount_cents`,`added_amount_cents`,`new_total_cents`,`reason`,`status`,`submitted_at`,`decided_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v228-change-rejected',256),26),@v228_dispute_order,@v228_worker_id,135000,20000,155000,'现场墙面基层破损严重，需增加修补费用。','rejected',UTC_TIMESTAMP()-INTERVAL 6 HOUR,UTC_TIMESTAMP()-INTERVAL 5 HOUR,UTC_TIMESTAMP()-INTERVAL 6 HOUR,UTC_TIMESTAMP());\nSET @v228_change=LAST_INSERT_ID();\nINSERT INTO `change_confirmations` (`change_request_id`,`user_id`,`decision`,`note`,`created_at`) VALUES (@v228_change,@v228_user_id,'rejected','商家不同意增加费用，双方继续协商。',UTC_TIMESTAMP()-INTERVAL 5 HOUR);\nINSERT INTO `disputes` (`public_no`,`order_id`,`raised_by_type`,`raised_by_id`,`dispute_type`,`title`,`description`,`status`,`responsibility`,`refund_amount_cents`,`run_empty_fee_cents`,`opened_at`,`created_at`,`updated_at`) VALUES ('DSP-V228-OPEN',@v228_dispute_order,'worker',@v228_worker_id,'run_empty_fee','商家单跑空费争议','商家拒绝加价且不愿支付跑空费，师傅提交平台核查。','open','undetermined',0,8000,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP());\nSET @v228_dispute=LAST_INSERT_ID();\nINSERT INTO `run_empty_fee_claims` (`public_id`,`order_id`,`change_request_id`,`worker_id`,`order_source_type`,`collection_mode`,`amount_cents`,`reason`,`status`,`user_note`,`dispute_id`,`submitted_at`,`decided_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v228-run-empty',256),26),@v228_dispute_order,@v228_change,@v228_worker_id,'merchant','online',8000,'已到现场后发现基层无法按原方案施工，协商未达成。','disputed','商家不认可跑空费，申请平台处理。',@v228_dispute,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP());\n\n-- 2026-09-15：时间线使用具体中文流程说明，不生成笼统的“订单状态已更新”。\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT o.`id`,'booking_fee_paid_upfront',CONCAT('v228:paid:',o.`id`),'user',@v228_user_id,JSON_OBJECT('amount_cents',5000,'message','预约费50.00元已支付'),o.`created_at`+INTERVAL 10 MINUTE FROM `orders` o WHERE o.`is_demo`=1 AND o.`payment_status`<>'awaiting_payment';\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT o.`id`,'order_submitted',CONCAT('v228:submitted:',o.`id`),'user',@v228_user_id,JSON_OBJECT('message','订单资料已提交，预约费支付后进入自动预审'),o.`created_at`+INTERVAL 11 MINUTE FROM `orders` o WHERE o.`is_demo`=1 AND o.`audit_status`<>'draft';\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT o.`id`,'order_approved',CONCAT('v228:approved:',o.`id`),'admin',@v228_admin_id,JSON_OBJECT('message','管理员审核通过，订单进入报价或履约流程'),o.`audited_at` FROM `orders` o WHERE o.`is_demo`=1 AND o.`audit_status`='approved';\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT q.`order_id`,IF(q.`quote_type`='platform','platform_quoted','worker_quoted'),CONCAT('v228:quote:',q.`id`),IF(q.`quote_type`='platform','admin','worker'),IF(q.`quote_type`='platform',@v228_admin_id,@v228_worker_id),JSON_OBJECT('amount_cents',q.`amount_cents`),q.`created_at` FROM `quotes` q INNER JOIN `orders` o ON o.`id`=q.`order_id` AND o.`is_demo`=1;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) SELECT a.`order_id`,'assignment_accepted',CONCAT('v228:assignment:',a.`id`),'worker',@v228_worker_id,JSON_OBJECT('message','师傅已接单，完整业主信息已自动开放'),a.`accepted_at` FROM `assignments` a INNER JOIN `orders` o ON o.`id`=a.`order_id` AND o.`is_demo`=1 WHERE a.`accepted_at` IS NOT NULL;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) VALUES\n(@v228_platform_order,'worker_invite_created',CONCAT('v228:invite:',@v228_platform_order),'admin',@v228_admin_id,JSON_OBJECT('message','管理员已生成邀请师傅分享，等待师傅领取'),UTC_TIMESTAMP()),\n(@v228_scheduled,'appointment_recorded',CONCAT('v228:appointment:',@v228_scheduled),'worker',@v228_worker_id,JSON_OBJECT('message','师傅电话联系后记录：明日上午上门'),UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@v228_adjust_order,'completion_submitted',CONCAT('v228:completion:',@v228_adjust_order),'worker',@v228_worker_id,JSON_OBJECT('photo_count',1,'message','师傅已提交带时间地点水印的完工照'),UTC_TIMESTAMP()-INTERVAL 12 HOUR),\n(@v228_adjust_order,'offline_collection_adjustment_requested',CONCAT('v228:adjust:',@v228_adjust_order),'worker',@v228_worker_id,JSON_OBJECT('original_tail_cents',115000,'requested_tail_cents',121000),UTC_TIMESTAMP()-INTERVAL 10 HOUR),\n(@v228_overdue_order,'auto_accepted_72h',CONCAT('v228:autoaccept:',@v228_overdue_order),'system',NULL,JSON_OBJECT('message','完工满72小时，系统自动确认验收'),UTC_TIMESTAMP()-INTERVAL 3 DAY),\n(@v228_overdue_order,'commission_receivable_created',CONCAT('v228:commission-due:',@v228_overdue_order),'system',NULL,JSON_OBJECT('amount_cents',6000,'message','平台服务费抵扣预约费后尚需补缴60.00元'),UTC_TIMESTAMP()-INTERVAL 3 DAY),\n(@v228_done_order,'commission_paid',CONCAT('v228:commission-paid:',@v228_done_order),'worker',@v228_worker_id,JSON_OBJECT('amount_cents',4500,'message','师傅已支付平台服务45.00元，账单结清'),UTC_TIMESTAMP()-INTERVAL 5 DAY),\n(@v228_refund_order,'cancel_approved',CONCAT('v228:cancel:',@v228_refund_order),'admin',@v228_admin_id,JSON_OBJECT('amount_cents',2500,'message','师傅确认未上门，管理员已核准部分退款25.00元'),UTC_TIMESTAMP()-INTERVAL 40 MINUTE),\n(@v228_expired_order,'auto_cancelled_7d',CONCAT('v228:expired:',@v228_expired_order),'system',NULL,JSON_OBJECT('message','订单超过7天未接受报价，系统自动取消'),UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@v228_expired_order,'refund_succeeded',CONCAT('v228:refunded:',@v228_expired_order),'system',NULL,JSON_OBJECT('amount_cents',5000,'message','预约费50.00元已原路退回'),UTC_TIMESTAMP()-INTERVAL 23 HOUR),\n(@v228_dispute_order,'change_rejected',CONCAT('v228:change-rejected:',@v228_dispute_order),'user',@v228_user_id,JSON_OBJECT('message','商家已拒绝加价，双方自行协商未达成'),UTC_TIMESTAMP()-INTERVAL 5 HOUR),\n(@v228_dispute_order,'run_empty_claim_disputed',CONCAT('v228:run-empty:',@v228_dispute_order),'worker',@v228_worker_id,JSON_OBJECT('amount_cents',8000,'message','商家不愿支付跑空费80.00元，师傅申请平台介入'),UTC_TIMESTAMP()-INTERVAL 3 HOUR),\n(@v228_offered_order,'assignment_offered',CONCAT('v228:assignment-offered:',@v228_offered_order),'admin',@v228_admin_id,JSON_OBJECT('worker_id',@v228_worker_id,'deadline_hours',24,'message','管理员已派单，师傅需在24小时内接受或拒绝'),UTC_TIMESTAMP()-INTERVAL 1 HOUR),\n(@v228_provisional_order,'completion_submitted',CONCAT('v228:completion:',@v228_provisional_order),'worker',@v228_worker_id,JSON_OBJECT('photo_count',1,'message','师傅已提交完工照，订单进入72小时验收期'),UTC_TIMESTAMP()-INTERVAL 8 HOUR),\n(@v228_provisional_order,'commission_provisional_created',CONCAT('v228:commission-provisional:',@v228_provisional_order),'system',NULL,JSON_OBJECT('amount_due_cents',10000,'amount_paid_cents',3000,'message','系统生成预计服务费100.00元，师傅已提前支付30.00元，验收后正式化'),UTC_TIMESTAMP()-INTERVAL 4 HOUR),\n(@v228_warranty_order,'warranty_started',CONCAT('v228:warranty:',@v228_warranty_order),'system',NULL,JSON_OBJECT('months',6,'message','订单验收完成，六个月维修保障开始'),UTC_TIMESTAMP()-INTERVAL 32 DAY),\n(@v228_warranty_order,'warranty_repair_requested',CONCAT('v228:repair:',@v228_warranty_order),'user',@v228_user_id,JSON_OBJECT('message','用户在保障期内提交玻璃膜翘边维修申请'),UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n((SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQZ202609154817'),'order_draft_saved','v228:draft:BXQZ202609154817','user',@v228_user_id,JSON_OBJECT('message','订单资料已保存，等待支付预约费50.00元'),UTC_TIMESTAMP()-INTERVAL 35 MINUTE);\n\n-- 2026-09-15：提现演示同时覆盖待审核与已付款，冻结金额与台账变化严格对应。\nSET @v228_payout_account=(SELECT `id` FROM `worker_payout_accounts` WHERE `worker_id`=@v228_worker_id AND `status`='active' ORDER BY `is_default` DESC,`id` DESC LIMIT 1);\nINSERT INTO `worker_payout_accounts` (`worker_id`,`account_type`,`holder_name_masked`,`holder_name_ciphertext`,`account_masked`,`account_ciphertext`,`account_hmac`,`status`,`is_default`,`verified_at`,`created_at`,`updated_at`)\nSELECT w.`id`,'alipay',w.`display_name`,w.`display_name`,'13088880000','13088880000',SHA2(CONCAT('V228-DEMO-ALIPAY-',u.`public_id`),256),'active',1,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM `worker_profiles` w INNER JOIN `users` u ON u.`id`=w.`user_id` WHERE w.`id`=@v228_worker_id AND @v228_payout_account IS NULL;\nSET @v228_payout_account=(SELECT `id` FROM `worker_payout_accounts` WHERE `worker_id`=@v228_worker_id AND `status`='active' ORDER BY `is_default` DESC,`id` DESC LIMIT 1);\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v228_worker_id,'run_empty_fee','credit',30000,30000,0,'demo_adjustment',222001,'v228:balance:credit','V2.2.8 演示跑空费进入余额','effective',UTC_TIMESTAMP()-INTERVAL 3 DAY);\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v228_worker_id,'withdrawal_freeze','transfer',3000,-3000,3000,'withdrawal_request',222002,'v228:withdrawal:pending:freeze','V2.2.8 待审核提现冻结','effective',UTC_TIMESTAMP()-INTERVAL 2 HOUR);\nSET @v228_pending_freeze=LAST_INSERT_ID();\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v228_worker_id,'withdrawal_freeze','transfer',5000,-5000,5000,'withdrawal_request',222003,'v228:withdrawal:paid:freeze','V2.2.8 已付款提现冻结','effective',UTC_TIMESTAMP()-INTERVAL 2 DAY);\nSET @v228_paid_freeze=LAST_INSERT_ID();\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@v228_worker_id,'withdrawal_paid','debit',5000,0,-5000,'withdrawal_request',222003,'v228:withdrawal:paid:finish','V2.2.8 人工支付完成，扣减冻结金额','effective',UTC_TIMESTAMP()-INTERVAL 1 DAY);\nINSERT INTO `withdrawal_requests` (`public_no`,`worker_id`,`payout_account_id`,`amount_cents`,`account_type_snapshot`,`holder_name_masked_snapshot`,`holder_name_ciphertext_snapshot`,`account_masked_snapshot`,`account_ciphertext_snapshot`,`status`,`review_note`,`submitted_at`,`reviewed_at`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'WD-V228-PENDING',@v228_worker_id,p.`id`,3000,p.`account_type`,p.`holder_name_masked`,p.`holder_name_ciphertext`,p.`account_masked`,p.`account_ciphertext`,'pending','演示：等待管理员审核并人工转账',UTC_TIMESTAMP()-INTERVAL 2 HOUR,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP() FROM `worker_payout_accounts` p WHERE p.`id`=@v228_payout_account;\nSET @v228_withdraw_pending=LAST_INSERT_ID();\nINSERT INTO `withdrawal_requests` (`public_no`,`worker_id`,`payout_account_id`,`amount_cents`,`account_type_snapshot`,`holder_name_masked_snapshot`,`holder_name_ciphertext_snapshot`,`account_masked_snapshot`,`account_ciphertext_snapshot`,`status`,`reviewed_by`,`review_note`,`submitted_at`,`reviewed_at`,`paid_at`,`created_at`,`updated_at`)\nSELECT 'WD-V228-PAID',@v228_worker_id,p.`id`,5000,p.`account_type`,p.`holder_name_masked`,p.`holder_name_ciphertext`,p.`account_masked`,p.`account_ciphertext`,'paid',@v228_admin_id,'演示：已完成支付并登记支付宝流水号',UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()-INTERVAL 36 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP() FROM `worker_payout_accounts` p WHERE p.`id`=@v228_payout_account;\nSET @v228_withdraw_paid=LAST_INSERT_ID();\nINSERT INTO `withdrawal_allocations` (`withdrawal_request_id`,`ledger_entry_id`,`amount_cents`,`created_at`) VALUES (@v228_withdraw_pending,@v228_pending_freeze,3000,UTC_TIMESTAMP()-INTERVAL 2 HOUR),(@v228_withdraw_paid,@v228_paid_freeze,5000,UTC_TIMESTAMP()-INTERVAL 2 DAY);\nINSERT INTO `withdrawal_events` (`withdrawal_request_id`,`event_type`,`from_status`,`to_status`,`note`,`operator_type`,`operator_id`,`created_at`) VALUES\n(@v228_withdraw_pending,'submitted',NULL,'pending','师傅申请提现30.00元','worker',@v228_worker_id,UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n(@v228_withdraw_paid,'submitted',NULL,'pending','师傅申请提现50.00元','worker',@v228_worker_id,UTC_TIMESTAMP()-INTERVAL 2 DAY),\n(@v228_withdraw_paid,'approved','pending','approved','管理员审核通过','admin',@v228_admin_id,UTC_TIMESTAMP()-INTERVAL 36 HOUR),\n(@v228_withdraw_paid,'paid','approved','paid','支付宝人工转账完成','admin',@v228_admin_id,UTC_TIMESTAMP()-INTERVAL 1 DAY);\nINSERT INTO `worker_payouts` (`public_no`,`withdrawal_request_id`,`worker_id`,`amount_cents`,`channel`,`external_transaction_no`,`status`,`paid_by`,`paid_at`,`created_at`) VALUES ('PAYOUT-V228-PAID',@v228_withdraw_paid,@v228_worker_id,5000,'alipay_manual','ALI-V228-20260915-5831','paid',@v228_admin_id,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY);\n\n\n\n-- B 端演示订单从普通演示用户迁到独立演示商家，相关用户快照同步迁移。\nUPDATE `orders` SET `user_id`=@v228_merchant_user_id,`merchant_profile_id`=@v228_merchant_profile_id,`order_source_type`='merchant',`updated_at`=UTC_TIMESTAMP()\nWHERE `is_demo`=1 AND `order_source_type`='merchant';\nUPDATE `quote_selections` qs INNER JOIN `orders` o ON o.`id`=qs.`order_id` AND o.`is_demo`=1 AND o.`order_source_type`='merchant'\nSET qs.`user_id`=@v228_merchant_user_id;\nUPDATE `payment_orders` p INNER JOIN `orders` o ON o.`id`=p.`order_id` AND o.`is_demo`=1 AND o.`order_source_type`='merchant'\nSET p.`payer_user_id`=@v228_merchant_user_id,p.`payer_openid`='V228_MERCHANT_OPENID';\nUPDATE `order_events` e INNER JOIN `orders` o ON o.`id`=e.`order_id` AND o.`is_demo`=1 AND o.`order_source_type`='merchant'\nSET e.`actor_id`=@v228_merchant_user_id WHERE e.`actor_type`='user';\nUPDATE `change_confirmations` cc INNER JOIN `change_requests` cr ON cr.`id`=cc.`change_request_id`\nINNER JOIN `orders` o ON o.`id`=cr.`order_id` AND o.`is_demo`=1 AND o.`order_source_type`='merchant'\nSET cc.`user_id`=@v228_merchant_user_id;\n\n-- 报价即接单后，不再保留“师傅报价还要二次确认”的伪阶段；该场景改成“平台报价后管理员派单待师傅确认”。\nSET @v228_offered_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQB202609156420' LIMIT 1);\nUPDATE `orders` SET `title`='演示：平台报价后派单待师傅确认',`description`='平台报价已成交，管理员已安排演示师傅；此类非师傅主动报价仍需师傅确认。',`updated_at`=UTC_TIMESTAMP() WHERE `id`=@v228_offered_order;\nUPDATE `quotes` SET `quote_type`='platform',`worker_id`=NULL,`created_by_admin_id`=@v228_admin_id,`description`='平台报价：成交后由管理员安排师傅。',`updated_at`=UTC_TIMESTAMP() WHERE `order_id`=@v228_offered_order AND `status`='selected';\nUPDATE `quote_versions` qv INNER JOIN `quotes` q ON q.`id`=qv.`quote_id` AND q.`order_id`=@v228_offered_order\nSET qv.`operator_type`='admin',qv.`operator_id`=@v228_admin_id,qv.`description`='平台报价：成交后由管理员安排师傅。';\nUPDATE `assignments` SET `assignment_type`='platform',`status`='offered',`accepted_at`=NULL,`accept_deadline_at`=UTC_TIMESTAMP()+INTERVAL 23 HOUR,`updated_at`=UTC_TIMESTAMP() WHERE `order_id`=@v228_offered_order;\nUPDATE `order_events` SET `payload_json`=JSON_OBJECT('worker_id',@v228_worker_id,'deadline_hours',24,'message','平台报价成交后管理员已派单，师傅需确认接受或拒绝')\nWHERE `order_id`=@v228_offered_order AND `event_type`='assignment_offered';\n\n-- 选中“师傅主动报价”的订单均视为师傅已经接单，补一条清晰事件用于演示时间线。\nINSERT IGNORE INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT o.`id`,'assignment_auto_accepted',CONCAT('v228:auto-accepted:',o.`id`),'system',NULL,\n JSON_OBJECT('worker_id',a.`worker_id`,'source','worker_quote','message','师傅主动报价已表达承接意愿，用户选择后系统自动接单'),\n COALESCE(a.`accepted_at`,a.`created_at`)\nFROM `orders` o INNER JOIN `assignments` a ON a.`id`=o.`current_assignment_id`\nWHERE o.`is_demo`=1 AND a.`assignment_type`='worker_quote' AND a.`status` IN ('accepted','completed');\n\n-- V2.2.8 测量单演示矩阵：报价、待支付、待上门、测量中、待确认、冻结、延期、关联施工、已结算、已退款。\nINSERT INTO `measurement_orders`\n(`public_no`,`user_id`,`merchant_profile_id`,`source_type`,`title`,`description`,`province`,`city`,`district`,`address_summary`,`lat`,`lng`,`contact_name_masked`,`contact_mobile_masked`,`expected_visit_date`,`expected_visit_period`,`audit_status`,`publish_status`,`quote_status`,`payment_status`,`fulfillment_status`,`lifecycle_status`,`assigned_worker_id`,`quoted_amount_cents`,`service_rate_bp`,`service_min_cents`,`auto_accept_hours`,`default_freeze_days`,`max_freeze_days`,`published_at`,`paid_at`,`appointment_at`,`submitted_at`,`auto_accept_at`,`accepted_at`,`version`,`is_demo`,`created_at`,`updated_at`)\nVALUES\n('CL-DEMO-V228-01',@v228_user_id,NULL,'consumer','演示测量：报价中','公开在演示测量大厅，演示师傅已报价，用户尚未选择。','浙江省','杭州市','西湖区','文三路演示小区1幢101室',30.2741,120.1551,'演示用户','130****2201',CURRENT_DATE+INTERVAL 2 DAY,'morning','approved','published','quoting','unpaid','not_started','active',NULL,0,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 2 HOUR,NULL,NULL,NULL,NULL,NULL,1,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()),\n('CL-DEMO-V228-02',@v228_user_id,NULL,'consumer','演示测量：已选报价待支付','用户已选择演示师傅报价，等待支付全额测量费。','浙江省','杭州市','拱墅区','湖墅南路演示小区2幢202室',30.3023,120.1568,'演示用户','130****2201',CURRENT_DATE+INTERVAL 3 DAY,'afternoon','approved','hidden','selected','awaiting_payment','not_started','active',NULL,6800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,NULL,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-03',@v228_user_id,NULL,'consumer','演示测量：已付款待预约','测量费已支付，演示师傅可联系用户预约上门。','浙江省','杭州市','滨江区','江南大道演示小区3幢303室',30.2084,120.2121,'演示用户','130****2201',CURRENT_DATE+INTERVAL 1 DAY,'morning','approved','hidden','selected','paid','paid','active',@v228_worker_id,8800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,NULL,NULL,NULL,3,1,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-04',@v228_user_id,NULL,'consumer','演示测量：测量进行中','师傅已记录预约并建立空间，可查看尺寸单/现场图/标注图入口。','浙江省','杭州市','上城区','庆春路演示小区4幢404室',30.2581,120.1833,'演示用户','130****2201',CURRENT_DATE,'afternoon','approved','hidden','selected','paid','measuring','active',@v228_worker_id,10800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()+INTERVAL 3 HOUR,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-05',@v228_user_id,NULL,'consumer','演示测量：成果待确认','师傅已提交空间和标注图，等待用户确认，72小时后可自动确认。','浙江省','杭州市','余杭区','仓前街道演示小区5幢505室',30.2826,119.9969,'演示用户','130****2201',CURRENT_DATE-INTERVAL 1 DAY,'afternoon','approved','hidden','selected','paid','submitted','active',@v228_worker_id,12800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()-INTERVAL 8 HOUR,UTC_TIMESTAMP()+INTERVAL 64 HOUR,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-06',@v228_user_id,NULL,'consumer','演示测量：费用冻结中','用户已确认测量成果，师傅净收入在默认15天冻结期内。','浙江省','杭州市','萧山区','市心中路演示小区6幢606室',30.1831,120.2643,'演示用户','130****2201',CURRENT_DATE-INTERVAL 4 DAY,'morning','approved','hidden','selected','paid','accepted','settled_frozen',@v228_worker_id,15800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 4 DAY,6,1,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-07',@v228_merchant_user_id,@v228_merchant_profile_id,'merchant','演示测量：商家延长冻结','商家确认测量后延长冻结期，用于演示B端测量资料确认与延期。','浙江省','杭州市','西湖区','演示材料门店施工点7号',30.2819,120.1280,'演示商家','130****2202',CURRENT_DATE-INTERVAL 5 DAY,'morning','approved','hidden','selected','paid','accepted','settled_frozen',@v228_worker_id,18800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 10 DAY,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 7 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 6 DAY,7,1,UTC_TIMESTAMP()-INTERVAL 10 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-08',@v228_user_id,NULL,'consumer','演示测量：已关联施工单','测量成果仍在冻结期，已经关联到施工草稿并由原测量师傅继续报价。','浙江省','杭州市','西湖区','竞舟路演示小区8幢808室',30.2772,120.1087,'演示用户','130****2201',CURRENT_DATE-INTERVAL 6 DAY,'afternoon','approved','hidden','selected','paid','accepted','linked',@v228_worker_id,9800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 12 DAY,UTC_TIMESTAMP()-INTERVAL 11 DAY,UTC_TIMESTAMP()-INTERVAL 10 DAY,UTC_TIMESTAMP()-INTERVAL 9 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 8 DAY,8,1,UTC_TIMESTAMP()-INTERVAL 12 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-09',@v228_user_id,NULL,'consumer','演示测量：冻结已解冻结算','冻结期已结束，师傅净收入已转入可提现余额。','浙江省','杭州市','临平区','南苑街道演示小区9幢909室',30.4188,120.2994,'演示用户','130****2201',CURRENT_DATE-INTERVAL 20 DAY,'morning','approved','hidden','selected','paid','accepted','released',@v228_worker_id,11800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 25 DAY,UTC_TIMESTAMP()-INTERVAL 24 DAY,UTC_TIMESTAMP()-INTERVAL 23 DAY,UTC_TIMESTAMP()-INTERVAL 22 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 20 DAY,9,1,UTC_TIMESTAMP()-INTERVAL 25 DAY,UTC_TIMESTAMP()),\n('CL-DEMO-V228-10',@v228_user_id,NULL,'consumer','演示测量：取消退款完成','测量费支付后取消并完成演示退款，所有交易号均为DEMO标识。','浙江省','杭州市','富阳区','富春街道演示小区10幢1010室',30.0547,119.9511,'演示用户','130****2201',CURRENT_DATE-INTERVAL 3 DAY,'evening','approved','hidden','closed','refunded','paid','refunded',@v228_worker_id,7800,1000,5000,72,15,30,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,NULL,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\n\n-- 每张测量单均给演示师傅建立报价；报价状态与主表阶段一致。\nINSERT INTO `measurement_quotes` (`public_id`,`measurement_order_id`,`worker_id`,`amount_cents`,`description`,`status`,`current_version`,`selected_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v228-measure-quote-',m.`public_no`),256),26),m.`id`,@v228_worker_id,\n CASE RIGHT(m.`public_no`,2) WHEN '01' THEN 5800 WHEN '02' THEN 6800 WHEN '03' THEN 8800 WHEN '04' THEN 10800 WHEN '05' THEN 12800 WHEN '06' THEN 15800 WHEN '07' THEN 18800 WHEN '08' THEN 9800 WHEN '09' THEN 11800 ELSE 7800 END,\n '演示师傅测量报价：包含上门、空间尺寸记录、现场照片和标注图。',\n CASE WHEN RIGHT(m.`public_no`,2)='01' THEN 'active' WHEN RIGHT(m.`public_no`,2)='02' THEN 'reserved' ELSE 'selected' END,1,\n CASE WHEN RIGHT(m.`public_no`,2)='01' THEN NULL ELSE m.`created_at`+INTERVAL 2 HOUR END,\n m.`created_at`+INTERVAL 1 HOUR,UTC_TIMESTAMP()\nFROM `measurement_orders` m WHERE m.`is_demo`=1;\nINSERT INTO `measurement_quote_versions` (`measurement_quote_id`,`version_no`,`amount_cents`,`service_rate_bp_snapshot`,`service_min_cents_snapshot`,`description`,`operator_type`,`operator_id`,`created_at`)\nSELECT q.`id`,1,q.`amount_cents`,m.`service_rate_bp`,m.`service_min_cents`,q.`description`,'worker',@v228_worker_id,q.`created_at`\nFROM `measurement_quotes` q INNER JOIN `measurement_orders` m ON m.`id`=q.`measurement_order_id` AND m.`is_demo`=1;\nUPDATE `measurement_orders` m INNER JOIN `measurement_quotes` q ON q.`measurement_order_id`=m.`id`\nSET m.`selected_quote_id`=CASE WHEN m.`quote_status`='quoting' THEN NULL ELSE q.`id` END\nWHERE m.`is_demo`=1;\n\n-- 已付款/已退款测量阶段使用明显的演示支付号，不调用真实微信。\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT CONCAT('PAY-DEMO-M-',RIGHT(m.`public_no`,2)),'measurement_fee',m.`id`,NULL,m.`user_id`,\n IF(m.`source_type`='merchant','V228_MERCHANT_OPENID','V228_USER_OPENID'),'V228_APPID','V228_MCHID','v3','CNY',m.`quoted_amount_cents`,\n IF(m.`payment_status`='refunded','refunded','paid'),CONCAT('V228_MEASURE_TX_',RIGHT(m.`public_no`,2)),\n 'V2.2.8 演示测量费，不是真实微信交易',m.`paid_at`,m.`created_at`+INTERVAL 2 HOUR,UTC_TIMESTAMP()\nFROM `measurement_orders` m WHERE m.`is_demo`=1 AND m.`payment_status` IN ('paid','refunded');\nUPDATE `measurement_orders` m INNER JOIN `payment_orders` p ON p.`business_type`='measurement_fee' AND p.`business_id`=m.`id`\nSET m.`payment_order_id`=p.`id` WHERE m.`is_demo`=1;\n\n-- 进行中及之后的阶段补空间和演示图片。\nINSERT INTO `measurement_spaces` (`public_id`,`measurement_order_id`,`name`,`note`,`sort_order`,`status`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v228-space-living-',m.`public_no`),256),26),m.`id`,'客厅','演示：墙面长度、门窗洞口和高度已记录。',0,'active',m.`created_at`+INTERVAL 3 HOUR,UTC_TIMESTAMP()\nFROM `measurement_orders` m WHERE m.`is_demo`=1 AND RIGHT(m.`public_no`,2) IN ('04','05','06','07','08','09');\nINSERT INTO `measurement_spaces` (`public_id`,`measurement_order_id`,`name`,`note`,`sort_order`,`status`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v228-space-bedroom-',m.`public_no`),256),26),m.`id`,'主卧','演示：床头墙及阴阳角尺寸。',1,'active',m.`created_at`+INTERVAL 4 HOUR,UTC_TIMESTAMP()\nFROM `measurement_orders` m WHERE m.`is_demo`=1 AND RIGHT(m.`public_no`,2) IN ('05','06','07','08','09');\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`)\nSELECT @v228_wall,'measurement_space',s.`id`,'site_photo',0,'worker',@v228_worker_id,s.`created_at` FROM `measurement_spaces` s INNER JOIN `measurement_orders` m ON m.`id`=s.`measurement_order_id` AND m.`is_demo`=1;\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`)\nSELECT @v228_completion,'measurement_space',s.`id`,'annotated_photo',1,'worker',@v228_worker_id,s.`created_at`+INTERVAL 10 MINUTE FROM `measurement_spaces` s INNER JOIN `measurement_orders` m ON m.`id`=s.`measurement_order_id` AND m.`is_demo`=1 WHERE RIGHT(m.`public_no`,2) IN ('05','06','07','08','09');\n\n-- 冻结、延期、关联和已解冻结算。\nINSERT INTO `measurement_settlements` (`public_no`,`measurement_order_id`,`worker_id`,`payment_order_id`,`gross_amount_cents`,`refunded_amount_cents`,`service_rate_bp_snapshot`,`service_min_cents_snapshot`,`service_fee_cents`,`worker_net_cents`,`status`,`freeze_started_at`,`release_at`,`max_release_at`,`released_at`,`created_at`,`updated_at`)\nSELECT CONCAT('MS-DEMO-V228-',RIGHT(m.`public_no`,2)),m.`id`,@v228_worker_id,p.`id`,m.`quoted_amount_cents`,0,m.`service_rate_bp`,m.`service_min_cents`,\n GREATEST(ROUND(m.`quoted_amount_cents`*m.`service_rate_bp`/10000),m.`service_min_cents`),\n m.`quoted_amount_cents`-GREATEST(ROUND(m.`quoted_amount_cents`*m.`service_rate_bp`/10000),m.`service_min_cents`),\n IF(RIGHT(m.`public_no`,2)='09','released','frozen'),m.`accepted_at`,\n CASE WHEN RIGHT(m.`public_no`,2)='09' THEN UTC_TIMESTAMP()-INTERVAL 2 DAY ELSE UTC_TIMESTAMP()+INTERVAL 9 DAY END,\n CASE WHEN RIGHT(m.`public_no`,2)='09' THEN UTC_TIMESTAMP()-INTERVAL 1 DAY ELSE UTC_TIMESTAMP()+INTERVAL 24 DAY END,\n CASE WHEN RIGHT(m.`public_no`,2)='09' THEN UTC_TIMESTAMP()-INTERVAL 2 DAY ELSE NULL END,\n m.`accepted_at`,UTC_TIMESTAMP()\nFROM `measurement_orders` m INNER JOIN `payment_orders` p ON p.`business_type`='measurement_fee' AND p.`business_id`=m.`id`\nWHERE m.`is_demo`=1 AND RIGHT(m.`public_no`,2) IN ('06','07','08','09');\n\nSET @v228_measure_07=(SELECT `id` FROM `measurement_orders` WHERE BINARY `public_no`=BINARY 'CL-DEMO-V228-07');\nSET @v228_measure_settle_07=(SELECT `id` FROM `measurement_settlements` WHERE `measurement_order_id`=@v228_measure_07);\nINSERT INTO `measurement_freeze_extensions` (`measurement_order_id`,`settlement_id`,`requested_by_user_id`,`old_release_at`,`new_release_at`,`extension_days`,`reason`,`created_at`)\nSELECT @v228_measure_07,@v228_measure_settle_07,@v228_merchant_user_id,s.`release_at`,LEAST(s.`max_release_at`,s.`release_at`+INTERVAL 5 DAY),5,'演示商家需要等待施工方案确认，延长冻结5天。',UTC_TIMESTAMP()-INTERVAL 1 DAY\nFROM `measurement_settlements` s WHERE s.`id`=@v228_measure_settle_07;\nUPDATE `measurement_settlements` s INNER JOIN `measurement_freeze_extensions` e ON e.`settlement_id`=s.`id`\nSET s.`release_at`=e.`new_release_at`,s.`updated_at`=UTC_TIMESTAMP() WHERE s.`id`=@v228_measure_settle_07;\n\nSET @v228_measure_08=(SELECT `id` FROM `measurement_orders` WHERE BINARY `public_no`=BINARY 'CL-DEMO-V228-08');\nSET @v228_measure_settle_08=(SELECT `id` FROM `measurement_settlements` WHERE `measurement_order_id`=@v228_measure_08);\nSET @v228_link_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQZ202609154817' LIMIT 1);\nINSERT INTO `measurement_order_links` (`measurement_order_id`,`construction_order_id`,`worker_id`,`measurement_amount_cents_snapshot`,`requested_deduction_cents`,`agreed_deduction_cents`,`status`,`created_at`,`updated_at`)\nVALUES (@v228_measure_08,@v228_link_order,@v228_worker_id,9800,5000,5000,'active',UTC_TIMESTAMP()-INTERVAL 7 DAY,UTC_TIMESTAMP());\n\n-- 冻结余额/解冻余额只使用演示师傅；所有幂等键带 measurement-demo-v228 前缀。\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`)\nSELECT s.`worker_id`,'measurement_income','credit',s.`worker_net_cents`,0,s.`worker_net_cents`,'measurement_settlement',s.`id`,CONCAT('measurement-demo-v228:',s.`id`,':freeze'),'演示测量完成，净收入进入冻结余额','effective',s.`freeze_started_at`\nFROM `measurement_settlements` s INNER JOIN `measurement_orders` m ON m.`id`=s.`measurement_order_id` AND m.`is_demo`=1;\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`)\nSELECT s.`worker_id`,'measurement_release','transfer',s.`worker_net_cents`,s.`worker_net_cents`,-s.`worker_net_cents`,'measurement_settlement',s.`id`,CONCAT('measurement-demo-v228:',s.`id`,':release'),'演示测量冻结到期转入可提现余额','effective',s.`released_at`\nFROM `measurement_settlements` s INNER JOIN `measurement_orders` m ON m.`id`=s.`measurement_order_id` AND m.`is_demo`=1 WHERE s.`status`='released';\n\n-- 退款完成场景。\nSET @v228_measure_10=(SELECT `id` FROM `measurement_orders` WHERE BINARY `public_no`=BINARY 'CL-DEMO-V228-10');\nSET @v228_measure_pay_10=(SELECT `id` FROM `payment_orders` WHERE `business_type`='measurement_fee' AND `business_id`=@v228_measure_10 LIMIT 1);\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`amount_cents`,`reason`,`status`,`wechat_refund_id`,`requested_at`,`succeeded_at`,`created_at`,`updated_at`)\nVALUES ('REF-DEMO-M-V228-10',@v228_measure_pay_10,NULL,7800,'演示测量取消退款，不是真实微信退款','succeeded','V228_MEASURE_REFUND_10',UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP());\n\n-- 测量时间线，每个阶段都能直接在详情中核对。\nINSERT INTO `measurement_events` (`measurement_order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`message`,`payload_json`,`created_at`)\nSELECT m.`id`,'measurement_demo_stage',CONCAT('v228:measurement-stage:',m.`public_no`),'system',NULL,\n CONCAT('演示阶段：',m.`title`),JSON_OBJECT('is_demo',1,'status',m.`lifecycle_status`),m.`created_at`\nFROM `measurement_orders` m WHERE m.`is_demo`=1;\n\nUPDATE `media_files` mf SET mf.`reference_count`=(SELECT COUNT(*) FROM `media_links` ml WHERE ml.`media_file_id`=mf.`id`)\nWHERE mf.`id` IN (@v228_material,@v228_wall,@v228_completion);\n\n-- V2.2.8：额外一笔普通用户施工单专门覆盖“管理员已批准公开成交师傅电话”，不挤占原有15种施工流程。\nINSERT INTO `orders`\n(`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,`wall_height_text`,`is_renovation`,`expected_visit_at`,`city`,`district`,`address_summary`,`address_ciphertext`,`lat`,`lng`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`order_source_type`,`audit_status`,`audit_note`,`audited_at`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`contact_revealed_at`,`completion_submitted_at`,`auto_accept_at`,`accepted_at`,`auto_review_at`,`cancelled_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`)\nVALUES\n('BXQZ202609208228',@v228_user_id,@v228_schema_id,@v228_qz,'墙纸','墙纸','演示：师傅电话已审核公开','普通用户等待超过2小时且师傅未提交预约，管理员已批准当前施工场景公开电话。','40.00㎡','2.80m',0,NULL,'杭州市','西湖区','杭州市西湖区演示路228号2幢802室','杭州市西湖区演示路228号2幢802室',30.2741,120.1551,'演示用户','演示用户','13088882201','13088882201','consumer','approved',NULL,UTC_TIMESTAMP()-INTERVAL 4 HOUR,'hidden','selected','accepted','not_started','paid','none','none','active',88000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 HOUR,NULL,UTC_TIMESTAMP()-INTERVAL 3 HOUR,NULL,NULL,NULL,NULL,NULL,NULL,1,1,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP());\nSET @v228_contact_approved_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXQZ202609208228' LIMIT 1);\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`) VALUES (@v228_contact_approved_order,@v228_qz,'墙纸',0,UTC_TIMESTAMP());\nINSERT INTO `order_addresses` (`order_id`,`province`,`city`,`district`,`address_summary`,`address_ciphertext`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`lat`,`lng`,`coordinate_system`,`created_at`,`updated_at`)\nVALUES (@v228_contact_approved_order,'浙江省','杭州市','西湖区','杭州市西湖区演示路228号2幢802室','杭州市西湖区演示路228号2幢802室','演示用户','演示用户','13088882201','13088882201',30.2741,120.1551,'GCJ-02',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`selected_at`,`created_at`,`updated_at`)\nVALUES (LEFT(SHA2('v228-contact-approved-quote',256),26),@v228_contact_approved_order,'worker',@v228_worker_id,NULL,88000,5000,'演示师傅主动报价，用户选择后自动接单。','selected',1,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP());\nSET @v228_contact_approved_quote=LAST_INSERT_ID();\nINSERT INTO `quote_versions` (`quote_id`,`version_no`,`amount_cents`,`booking_fee_cents`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`rule_acknowledged_at`,`description`,`operator_type`,`operator_id`,`created_at`)\nVALUES (@v228_contact_approved_quote,1,88000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 3 HOUR,'演示：电话公开审批施工单报价。','worker',@v228_worker_id,UTC_TIMESTAMP()-INTERVAL 3 HOUR);\nSET @v228_contact_approved_qv=LAST_INSERT_ID();\nINSERT INTO `quote_items` (`quote_version_id`,`item_name`,`quantity`,`unit_name`,`unit_price_cents`,`amount_cents`,`sort_order`,`created_at`)\nVALUES (@v228_contact_approved_qv,'安装施工费',1.00,'项',88000,88000,10,UTC_TIMESTAMP()-INTERVAL 3 HOUR);\nINSERT INTO `quote_selections` (`order_id`,`quote_id`,`quote_version_id`,`user_id`,`amount_cents_snapshot`,`booking_fee_cents_snapshot`,`status`,`selected_at`,`confirmed_at`)\nVALUES (@v228_contact_approved_order,@v228_contact_approved_quote,@v228_contact_approved_qv,@v228_user_id,88000,5000,'confirmed',UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR);\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`locked_at`,`created_at`)\nVALUES (@v228_contact_approved_order,1,1000,5000,'default','V2.2.8 电话公开演示订单服务费快照',@v228_admin_id,'locked',UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 4 HOUR);\nSET @v228_contact_approved_rule=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nVALUES ('PAY-V228-CALL','order_booking',@v228_contact_approved_order,@v228_contact_approved_order,@v228_user_id,'V228_USER_OPENID','V228_APPID','V228_MCHID','v3','CNY',5000,'paid','V228_TX_CALL','V2.2.8 演示预约费，不是真实微信交易',UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP());\nINSERT INTO `assignments` (`public_id`,`order_id`,`worker_id`,`quote_id`,`assignment_type`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`estimated_commission_cents`,`estimated_offline_collect_cents`,`estimated_net_income_cents`,`status`,`offered_at`,`accepted_at`,`created_by_admin_id`,`created_at`,`updated_at`)\nVALUES (LEFT(SHA2('v228-contact-approved-assignment',256),26),@v228_contact_approved_order,@v228_worker_id,@v228_contact_approved_quote,'worker_quote',@v228_contact_approved_rule,88000,5000,1000,5000,8800,83000,79200,'accepted',UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,@v228_admin_id,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP());\nSET @v228_contact_approved_assignment=LAST_INSERT_ID();\nUPDATE `orders` SET `selected_quote_id`=@v228_contact_approved_quote,`commission_rule_version_id`=@v228_contact_approved_rule,`current_assignment_id`=@v228_contact_approved_assignment,`assigned_worker_id`=@v228_worker_id,`updated_at`=UTC_TIMESTAMP() WHERE `id`=@v228_contact_approved_order;\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nVALUES (@v228_contact_approved_order,'assignment_auto_accepted',CONCAT('v228:auto-accepted:',@v228_contact_approved_order),'system',NULL,JSON_OBJECT('worker_id',@v228_worker_id,'source','worker_quote','message','师傅主动报价已表达承接意愿，用户选择后系统自动接单'),UTC_TIMESTAMP()-INTERVAL 3 HOUR);\n\n-- V2.2.8 当前流程演示：维修“等待客户另行通知”、电话公开待审核/已批准均使用独立演示身份。\nSET @v228_warranty_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXBLM202609156937' LIMIT 1);\nSET @v228_warranty_after_sale=(SELECT `id` FROM `after_sales` WHERE `order_id`=@v228_warranty_order AND `type`='warranty_repair' ORDER BY `id` DESC LIMIT 1);\nINSERT INTO `appointment_records`\n(`order_id`,`worker_id`,`appointment_at`,`note`,`status`,`context_type`,`after_sale_id`,`wait_customer_notice`,`created_at`,`updated_at`)\nSELECT @v228_warranty_order,@v228_worker_id,NULL,'客户暂未确定维修时间，等待客户另行通知。','recorded','repair',@v228_warranty_after_sale,1,UTC_TIMESTAMP()-INTERVAL 30 MINUTE,UTC_TIMESTAMP()\nFROM DUAL WHERE @v228_warranty_order IS NOT NULL AND @v228_warranty_after_sale IS NOT NULL;\n\nSET @v228_contact_pending_order=(SELECT `id` FROM `orders` WHERE BINARY `public_no`=BINARY 'BXJJM202609158504' LIMIT 1);\nINSERT INTO `order_worker_contact_reveal_requests`\n(`public_no`,`order_id`,`user_id`,`worker_id`,`context_type`,`after_sale_id`,`reason`,`eligible_at`,`status`,`requested_at`,`created_at`,`updated_at`)\nSELECT 'PCR-DEMO-V228-PENDING',o.`id`,o.`user_id`,@v228_worker_id,'service',NULL,'演示：师傅超过2小时未联系，等待管理员审核。',UTC_TIMESTAMP()-INTERVAL 1 HOUR,'pending',UTC_TIMESTAMP()-INTERVAL 20 MINUTE,UTC_TIMESTAMP()-INTERVAL 20 MINUTE,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`id`=@v228_contact_pending_order AND o.`is_demo`=1;\n\nINSERT INTO `order_worker_contact_reveal_requests`\n(`public_no`,`order_id`,`user_id`,`worker_id`,`context_type`,`after_sale_id`,`reason`,`eligible_at`,`status`,`requested_at`,`reviewed_by`,`review_note`,`reviewed_at`,`created_at`,`updated_at`)\nSELECT 'PCR-DEMO-V228-APPROVED',o.`id`,o.`user_id`,@v228_worker_id,'service',NULL,'演示：超过2小时未联系申请公开电话。',UTC_TIMESTAMP()-INTERVAL 1 HOUR,'approved',UTC_TIMESTAMP()-INTERVAL 90 MINUTE,@v228_admin_id,'演示审核通过，仅当前施工场景可拨打。',UTC_TIMESTAMP()-INTERVAL 80 MINUTE,UTC_TIMESTAMP()-INTERVAL 90 MINUTE,UTC_TIMESTAMP()\nFROM `orders` o WHERE o.`id`=@v228_contact_approved_order AND o.`is_demo`=1 AND o.`order_source_type`='consumer';\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES ('demo.seed_version','2.2.8','string','system',0,'当前独立演示账号与全流程演示数据版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`='2.2.8',`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 老库若缺失演示开关则补齐；已有管理员选择必须保留，不能因升级强制重新开启。\nINSERT INTO `system_settings`\n(`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES ('demo.data_enabled','1','boolean','system',0,'是否在后台和管理员演示身份切换中显示独立演示数据',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `value_type`='boolean',`group_name`='system',`is_public`=0,`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('login_sessions','demo_actor_user_id','当前会话演示身份','仅管理员当前小程序登录会话可切换，NULL 表示真实管理员身份',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('measurement_orders','is_demo','演示测量单','1 表示仅供演示身份查看和操作，不进入真实测量大厅',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.2.8 demo data rebuilt and legacy demo leftovers cleaned' AS message;\n","server/database/upgrades/2.2.9.sql":"-- V2.2.9：测量业务回归统一 orders；使用图片成果、成果确认后冻结结算和一对一施工关联。\n-- 前置版本：2.2.8；MySQL 5.7.44；DDL 使用信息架构守卫，失败后仍禁止自动整段重试。\nSET NAMES utf8mb4;\n\nSET @v229_has_workflow := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='workflow_profile'\n);\nSET @v229_sql := IF(\n  @v229_has_workflow=0,\n  \"ALTER TABLE `orders` ADD COLUMN `workflow_profile` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'construction' COMMENT '订单工作流：construction施工、measurement测量' AFTER `form_schema_version_id`, ADD KEY `idx_orders_workflow_status` (`workflow_profile`,`lifecycle_status`,`id`)\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\nSET @v229_has_pending_measurement := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='pending_measurement_order_id'\n);\nSET @v229_sql := IF(\n  @v229_has_pending_measurement=0,\n  \"ALTER TABLE `orders` ADD COLUMN `pending_measurement_order_id` bigint unsigned NULL COMMENT '待正式关联的来源测量订单；草稿/待付款阶段不占一对一资格' AFTER `workflow_profile`, ADD KEY `idx_orders_pending_measurement` (`pending_measurement_order_id`)\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\nSET @v229_has_change_payment_status := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='change_requests' AND COLUMN_NAME='payment_status'\n);\nSET @v229_sql := IF(\n  @v229_has_change_payment_status=0,\n  \"ALTER TABLE `change_requests` ADD COLUMN `payment_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NULL COMMENT '在线加费支付状态；测量单 accepted 后 awaiting_payment/paid/refund_pending/refunded' AFTER `status`, ADD KEY `idx_change_payment_status` (`payment_status`,`order_id`,`id`)\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\n-- V2.2.9 最终报价结构：普通备注与结构化报价内容分列保存。\nSET @v229_has_quote_details := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='quotes' AND COLUMN_NAME='details_json'\n);\nSET @v229_sql := IF(\n  @v229_has_quote_details=0,\n  \"ALTER TABLE `quotes` ADD COLUMN `details_json` json NULL AFTER `description`\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\nSET @v229_has_quote_version_details := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='quote_versions' AND COLUMN_NAME='details_json'\n);\nSET @v229_sql := IF(\n  @v229_has_quote_version_details=0,\n  \"ALTER TABLE `quote_versions` ADD COLUMN `details_json` json NULL AFTER `description`\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\n-- V2.2.9 正式尾款调整模型：提交即自动预审，管理员只负责抽查确认或驳回回滚。\nALTER TABLE `offline_collection_adjustment_requests`\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'auto_approved';\n\nCREATE TABLE IF NOT EXISTS `order_measurement_states` (\n  `order_id` bigint unsigned NOT NULL,\n  `service_payment_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'unpaid',\n  `balance_payment_order_id` bigint unsigned NULL,\n  `result_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'editing',\n  `submitted_at` datetime NULL,\n  `auto_accept_at` datetime NULL,\n  `accepted_at` datetime NULL,\n  `settlement_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'none',\n  `gross_amount_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `refunded_amount_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `service_rate_bp_snapshot` int unsigned NOT NULL DEFAULT 0,\n  `service_min_cents_snapshot` bigint unsigned NOT NULL DEFAULT 0,\n  `service_fee_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `worker_net_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `hold_until` datetime NULL COMMENT '测量净收入冻结截止，同时是未关联时优惠施工关联资格截止',\n  `max_hold_until` datetime NULL COMMENT '普通延期最多可批准到此时间',\n  `settled_at` datetime NULL COMMENT '冻结资金实际释放到可用余额时间',\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`order_id`),\n  KEY `idx_order_measurement_state_auto_accept` (`result_status`,`auto_accept_at`,`order_id`),\n  KEY `idx_order_measurement_state_settlement` (`settlement_status`,`hold_until`,`order_id`),\n  KEY `idx_order_measurement_state_payment` (`service_payment_status`,`balance_payment_order_id`),\n  CONSTRAINT `fk_order_measurement_state_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_measurement_state_payment` FOREIGN KEY (`balance_payment_order_id`) REFERENCES `payment_orders` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 统一订单下的测量模块状态';\n\nSET @v229_has_hold_until := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='order_measurement_states' AND COLUMN_NAME='hold_until'\n);\nSET @v229_sql := IF(\n  @v229_has_hold_until=0,\n  \"ALTER TABLE `order_measurement_states` ADD COLUMN `hold_until` datetime NULL COMMENT '测量净收入冻结截止，同时是未关联时优惠施工关联资格截止' AFTER `worker_net_cents`, ADD KEY `idx_order_measurement_hold` (`settlement_status`,`hold_until`,`order_id`)\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\nSET @v229_has_max_hold_until := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='order_measurement_states' AND COLUMN_NAME='max_hold_until'\n);\nSET @v229_sql := IF(\n  @v229_has_max_hold_until=0,\n  \"ALTER TABLE `order_measurement_states` ADD COLUMN `max_hold_until` datetime NULL COMMENT '普通延期最多可批准到此时间' AFTER `hold_until`\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\n-- CREATE TABLE IF NOT EXISTS 不会补齐已存在表的最终列；这里只校验 V2.2.9 正式结构。\nSET @v229_has_settled_at := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='order_measurement_states' AND COLUMN_NAME='settled_at'\n);\nSET @v229_sql := IF(\n  @v229_has_settled_at=0,\n  \"ALTER TABLE `order_measurement_states` ADD COLUMN `settled_at` datetime NULL COMMENT '冻结资金实际释放到可用余额时间' AFTER `max_hold_until`\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\nCREATE TABLE IF NOT EXISTS `order_measurement_hold_extensions` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `order_id` bigint unsigned NOT NULL,\n  `requested_by_user_id` bigint unsigned NOT NULL,\n  `old_hold_until` datetime NOT NULL,\n  `requested_hold_until` datetime NOT NULL,\n  `approved_hold_until` datetime NULL,\n  `reason` varchar(500) NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n  `reviewed_by` bigint unsigned NULL,\n  `review_note` varchar(500) NULL,\n  `reviewed_at` datetime NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_measurement_hold_extension_public` (`public_id`),\n  KEY `idx_measurement_hold_extension_order` (`order_id`,`status`,`id`),\n  CONSTRAINT `fk_measurement_hold_extension_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 测量冻结延期申请及审核';\n\nCREATE TABLE IF NOT EXISTS `order_measurement_spaces` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `order_id` bigint unsigned NOT NULL,\n  `name` varchar(120) NOT NULL,\n  `sort_order` int NOT NULL DEFAULT 0,\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_order_measurement_spaces_public_id` (`public_id`),\n  KEY `idx_order_measurement_spaces_order` (`order_id`,`status`,`sort_order`,`id`),\n  CONSTRAINT `fk_order_measurement_spaces_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 测量图片成果空间';\n\nCREATE TABLE IF NOT EXISTS `order_relations` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `relation_type` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `parent_order_id` bigint unsigned NOT NULL COMMENT '测量订单',\n  `child_order_id` bigint unsigned NOT NULL COMMENT '施工订单',\n  `worker_id` bigint unsigned NOT NULL COMMENT '原测量师傅',\n  `measurement_amount_cents_snapshot` bigint unsigned NOT NULL DEFAULT 0,\n  `requested_discount_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `agreed_discount_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_order_relations_parent_type` (`relation_type`,`parent_order_id`),\n  UNIQUE KEY `uq_order_relations_child_type` (`relation_type`,`child_order_id`),\n  KEY `idx_order_relations_worker` (`worker_id`,`status`,`id`),\n  CONSTRAINT `fk_order_relations_parent` FOREIGN KEY (`parent_order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_relations_child` FOREIGN KEY (`child_order_id`) REFERENCES `orders` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_relations_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 通用订单关系，首期测量施工严格一对一';\n\n-- V2.2.9 正式动态表单协议：类目统一使用 category_ids，图片数量统一使用 min_items/max_items。\n-- 全新安装基线已没有 form_fields.category_id；重复执行迁移时必须跳过旧列数据搬迁。\nSET @v229_has_form_category_id := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='form_fields' AND COLUMN_NAME='category_id'\n);\nSET @v229_sql := IF(\n  @v229_has_form_category_id>0,\n  \"UPDATE `form_fields`\n   SET `ui_config_json`=JSON_SET(\n         CASE WHEN JSON_VALID(`ui_config_json`) THEN COALESCE(`ui_config_json`,'{}') ELSE '{}' END,\n         '$.category_ids',JSON_ARRAY(`category_id`)\n       ),\n       `category_id`=NULL,\n       `updated_at`=UTC_TIMESTAMP()\n   WHERE `category_id` IS NOT NULL\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\nUPDATE `form_fields` f\nINNER JOIN `form_steps` s ON s.`id`=f.`step_id`\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nSET f.`field_key`='category_ids',\n    f.`data_type`='json',\n    f.`updated_at`=UTC_TIMESTAMP()\nWHERE BINARY fs.`schema_key`=BINARY 'order_submit'\n  AND BINARY f.`field_key`=BINARY 'category_id';\n\nUPDATE `form_fields`\nSET `validation_json`=CASE\n      WHEN JSON_VALID(`validation_json`) THEN\n        JSON_REMOVE(\n          JSON_SET(\n            `validation_json`,\n            '$.min_items',\n              COALESCE(\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.min_items')) AS UNSIGNED),\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.min')) AS UNSIGNED),\n                IF(`is_required`=1,1,0)\n              ),\n            '$.max_items',\n              COALESCE(\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.max_items')) AS UNSIGNED),\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.max')) AS UNSIGNED),\n                CASE\n                  WHEN BINARY `field_key`=BINARY 'material_images' THEN 9\n                  WHEN BINARY `field_key`=BINARY 'wall_images' THEN 12\n                  ELSE 20\n                END\n              )\n          ),\n          '$.min','$.max'\n        )\n      ELSE JSON_OBJECT(\n        'min_items',IF(`is_required`=1,1,0),\n        'max_items',CASE\n          WHEN BINARY `field_key`=BINARY 'material_images' THEN 9\n          WHEN BINARY `field_key`=BINARY 'wall_images' THEN 12\n          ELSE 20\n        END\n      )\n    END,\n    `updated_at`=UTC_TIMESTAMP()\nWHERE `component_type` IN ('image','image_upload');\n\n-- 适用类目已迁入 ui_config.category_ids，删除不再使用的单类目物理列。\nSET @v229_has_form_category_id := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='form_fields' AND COLUMN_NAME='category_id'\n);\nSET @v229_sql := IF(\n  @v229_has_form_category_id>0,\n  \"ALTER TABLE `form_fields` DROP FOREIGN KEY `fk_form_fields_category`, DROP INDEX `idx_form_fields_category`, DROP COLUMN `category_id`\",\n  \"SELECT 1\"\n);\nPREPARE v229_stmt FROM @v229_sql;\nEXECUTE v229_stmt;\nDEALLOCATE PREPARE v229_stmt;\n\nSET @v229_form_schema_id := (\n  SELECT `id` FROM `form_schemas` WHERE BINARY `schema_key`=BINARY 'order_submit' LIMIT 1\n);\nSET @v229_form_version_id := (\n  SELECT `id` FROM `form_schema_versions`\n  WHERE `schema_id`=@v229_form_schema_id AND `status`='published'\n  ORDER BY `version_no` DESC,`id` DESC LIMIT 1\n);\nSET @v229_form_step_id := (\n  SELECT `id` FROM `form_steps`\n  WHERE `schema_version_id`=@v229_form_version_id AND `status`='active'\n  ORDER BY `sort_order`,`id` LIMIT 1\n);\n\nINSERT INTO `form_fields`\n  (`step_id`,`field_key`,`label`,`component_type`,`data_type`,`placeholder`,`help_text`,`is_required`,`default_value_json`,`validation_json`,`ui_config_json`,`sort_order`,`status`,`created_at`,`updated_at`)\nSELECT\n  @v229_form_step_id,'workflow_profile','是否已有材料','radio','string','','已有材料可直接施工；未购买材料可先预约测量',1,'\"construction\"','{}','{\"system_semantic\":\"workflow_profile\"}',5,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM DUAL\nWHERE @v229_form_step_id IS NOT NULL\n  AND NOT EXISTS (\n    SELECT 1 FROM `form_fields` f\n    INNER JOIN `form_steps` s ON s.`id`=f.`step_id`\n    WHERE s.`schema_version_id`=@v229_form_version_id\n      AND BINARY f.`field_key`=BINARY 'workflow_profile'\n  );\n\nSET @v229_workflow_field_id := (\n  SELECT f.`id` FROM `form_fields` f\n  INNER JOIN `form_steps` s ON s.`id`=f.`step_id`\n  WHERE s.`schema_version_id`=@v229_form_version_id\n    AND BINARY f.`field_key`=BINARY 'workflow_profile'\n  ORDER BY f.`id` DESC LIMIT 1\n);\n\nINSERT INTO `form_options`\n  (`field_id`,`option_key`,`label`,`value_text`,`sort_order`,`is_default`,`status`,`extra_json`,`created_at`,`updated_at`)\nSELECT @v229_workflow_field_id,'construction','已有材料，直接施工','construction',10,1,'active','{\"workflow_profile\":\"construction\"}',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM DUAL\nWHERE @v229_workflow_field_id IS NOT NULL\n  AND NOT EXISTS (SELECT 1 FROM `form_options` WHERE `field_id`=@v229_workflow_field_id AND BINARY `value_text`=BINARY 'construction');\n\nINSERT INTO `form_options`\n  (`field_id`,`option_key`,`label`,`value_text`,`sort_order`,`is_default`,`status`,`extra_json`,`created_at`,`updated_at`)\nSELECT @v229_workflow_field_id,'measurement','未买材料，先上门测量','measurement',20,0,'active','{\"workflow_profile\":\"measurement\"}',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM DUAL\nWHERE @v229_workflow_field_id IS NOT NULL\n  AND NOT EXISTS (SELECT 1 FROM `form_options` WHERE `field_id`=@v229_workflow_field_id AND BINARY `value_text`=BINARY 'measurement');\n\n-- V2.2.9：测量/施工差异完全交给可视化表单联动规则；小程序不再硬编码两套下单首步。\n-- 下面只为当前已存在的施工专属字段预置“workflow_profile=measurement 时隐藏”规则，\n-- 管理员后续仍可在表单设计器中可视化调整、删除或新增规则。\nINSERT INTO `form_rules`\n  (`schema_version_id`,`rule_key`,`name`,`trigger_field_id`,`operator`,`compare_value_json`,`action_type`,`target_field_id`,`action_payload_json`,`priority`,`status`,`created_at`,`updated_at`)\nSELECT @v229_form_version_id,\n       CONCAT('v229_measure_hide_',f.`field_key`),\n       CONCAT('测量时隐藏：',f.`label`),\n       @v229_workflow_field_id,\n       'equals',\n       '\"measurement\"',\n       'hide',\n       f.`id`,\n       NULL,\n       20,\n       'active',\n       UTC_TIMESTAMP(),\n       UTC_TIMESTAMP()\nFROM `form_fields` f\nINNER JOIN `form_steps` s ON s.`id`=f.`step_id`\nWHERE s.`schema_version_id`=@v229_form_version_id\n  AND @v229_workflow_field_id IS NOT NULL\n  AND f.`field_key` IN ('category_ids','quantity','wall_height','is_renovation','material_images')\n  AND NOT EXISTS (\n    SELECT 1 FROM `form_rules` r\n    WHERE r.`schema_version_id`=@v229_form_version_id\n      AND BINARY r.`rule_key`=BINARY CONCAT('v229_measure_hide_',f.`field_key`)\n  );\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('app.version','2.2.9','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`='2.2.9',`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('measurement.default_freeze_days','15','integer','measurement',1,'测量成果确认后师傅净收入默认冻结天数；冻结期内可创建唯一优惠施工关联',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('measurement.max_freeze_days','30','integer','measurement',1,'测量费普通延期后的最长总冻结天数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('measurement.auto_accept_hours','72','integer','measurement',1,'师傅提交测量成果后自动确认小时数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('measurement.payment_expire_minutes','30','integer','measurement',1,'选中测量师傅或测量现场加费后的支付有效分钟数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `value_type`=VALUES(`value_type`),\n  `group_name`=VALUES(`group_name`),\n  `description`=VALUES(`description`),\n  `updated_at`=UTC_TIMESTAMP();\n\n-- V2.2.9：用户充值消费钱包与附近师傅付费短信触达。\nCREATE TABLE IF NOT EXISTS `user_wallets` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `user_id` bigint unsigned NOT NULL,\n  `available_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `reserved_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `version` int unsigned NOT NULL DEFAULT 1,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_user_wallets_user` (`user_id`),\n  CONSTRAINT `fk_user_wallets_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 用户不可提现充值消费钱包';\n\nCREATE TABLE IF NOT EXISTS `user_wallet_ledger` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` bigint unsigned NOT NULL,\n  `entry_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `direction` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `amount_cents` bigint unsigned NOT NULL,\n  `available_delta_cents` bigint NOT NULL DEFAULT 0,\n  `reserved_delta_cents` bigint NOT NULL DEFAULT 0,\n  `available_after_cents` bigint unsigned NOT NULL,\n  `reserved_after_cents` bigint unsigned NOT NULL,\n  `reference_type` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `reference_id` bigint unsigned NULL,\n  `idempotency_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `description` varchar(500) NOT NULL DEFAULT '',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'effective',\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_user_wallet_ledger_public` (`public_no`),\n  UNIQUE KEY `uq_user_wallet_ledger_idempotency` (`idempotency_key`),\n  KEY `idx_user_wallet_ledger_user_time` (`user_id`,`id`),\n  KEY `idx_user_wallet_ledger_reference` (`reference_type`,`reference_id`),\n  CONSTRAINT `fk_user_wallet_ledger_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 用户钱包不可变台账';\n\nCREATE TABLE IF NOT EXISTS `user_wallet_recharges` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` bigint unsigned NOT NULL,\n  `amount_cents` bigint unsigned NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'created',\n  `payment_order_id` bigint unsigned NULL,\n  `client_request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `paid_at` datetime NULL,\n  `closed_at` datetime NULL,\n  `refunded_at` datetime NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_user_wallet_recharges_public` (`public_no`),\n  UNIQUE KEY `uq_user_wallet_recharges_payment` (`payment_order_id`),\n  UNIQUE KEY `uq_user_wallet_recharges_request` (`user_id`,`client_request_id`),\n  KEY `idx_user_wallet_recharges_user_time` (`user_id`,`id`),\n  KEY `idx_user_wallet_recharges_status_time` (`status`,`updated_at`),\n  CONSTRAINT `fk_user_wallet_recharges_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_user_wallet_recharges_payment` FOREIGN KEY (`payment_order_id`) REFERENCES `payment_orders` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 用户钱包微信充值业务单';\n\nCREATE TABLE IF NOT EXISTS `user_wallet_reservations` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` bigint unsigned NOT NULL,\n  `amount_cents` bigint unsigned NOT NULL,\n  `business_type` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `business_id` bigint unsigned NOT NULL,\n  `business_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'held',\n  `expires_at` datetime NOT NULL,\n  `consumed_at` datetime NULL,\n  `released_at` datetime NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_user_wallet_reservations_public` (`public_no`),\n  UNIQUE KEY `uq_user_wallet_reservations_business` (`business_type`,`business_key`),\n  KEY `idx_user_wallet_reservations_user_status` (`user_id`,`status`,`expires_at`),\n  CONSTRAINT `fk_user_wallet_reservations_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 用户钱包逐条业务预占';\n\nCREATE TABLE IF NOT EXISTS `order_worker_sms_batches` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `order_id` bigint unsigned NOT NULL,\n  `user_id` bigint unsigned NOT NULL,\n  `client_request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `pricing_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `unit_fee_cents_snapshot` bigint unsigned NOT NULL,\n  `confirmed_max_total_cents` bigint unsigned NOT NULL,\n  `requested_count` tinyint unsigned NOT NULL,\n  `valid_count` tinyint unsigned NOT NULL DEFAULT 0,\n  `initial_held_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `charged_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `released_cents` bigint unsigned NOT NULL DEFAULT 0,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'prepared',\n  `created_at` datetime NOT NULL,\n  `completed_at` datetime NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_order_worker_sms_batches_public` (`public_no`),\n  UNIQUE KEY `uq_order_worker_sms_batches_request` (`user_id`,`order_id`,`client_request_id`),\n  KEY `idx_order_worker_sms_batches_order` (`order_id`,`id`),\n  KEY `idx_order_worker_sms_batches_user` (`user_id`,`id`),\n  KEY `idx_order_worker_sms_batches_status` (`status`,`updated_at`),\n  CONSTRAINT `fk_order_worker_sms_batches_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_worker_sms_batches_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 附近师傅付费短信发送批次';\n\nCREATE TABLE IF NOT EXISTS `order_worker_sms_invites` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `batch_id` bigint unsigned NOT NULL,\n  `order_id` bigint unsigned NOT NULL,\n  `user_id` bigint unsigned NOT NULL,\n  `candidate_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `worker_id` bigint unsigned NULL,\n  `cloud_worker_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `worker_identity_key` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `active_dedupe_key` char(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `retry_of_invite_id` bigint unsigned NULL,\n  `worker_name_snapshot` varchar(80) NOT NULL DEFAULT '',\n  `mobile_masked_snapshot` varchar(32) NOT NULL DEFAULT '',\n  `mobile_ciphertext_snapshot` text NULL,\n  `mobile_hmac_snapshot` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `distance_m_snapshot` int unsigned NOT NULL,\n  `fee_cents_snapshot` bigint unsigned NOT NULL,\n  `delivery_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'prepared',\n  `billing_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'held',\n  `outbox_id` bigint unsigned NULL,\n  `aliyun_biz_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `aliyun_request_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `provider_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `error_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `error_message_safe` varchar(500) NULL,\n  `wallet_reservation_id` bigint unsigned NULL,\n  `receipt_attempt_count` smallint unsigned NOT NULL DEFAULT 0,\n  `next_receipt_check_at` datetime NULL,\n  `receipt_deadline_at` datetime NULL,\n  `attempted_at` datetime NULL,\n  `provider_accepted_at` datetime NULL,\n  `delivered_at` datetime NULL,\n  `failed_at` datetime NULL,\n  `charged_at` datetime NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_order_worker_sms_invites_public` (`public_no`),\n  UNIQUE KEY `uq_order_worker_sms_invites_active_dedupe` (`active_dedupe_key`),\n  UNIQUE KEY `uq_order_worker_sms_invites_reservation` (`wallet_reservation_id`),\n  UNIQUE KEY `uq_order_worker_sms_invites_outbox` (`outbox_id`),\n  KEY `idx_order_worker_sms_invites_batch` (`batch_id`,`id`),\n  KEY `idx_order_worker_sms_invites_order` (`order_id`,`delivery_status`),\n  KEY `idx_order_worker_sms_invites_receipt` (`delivery_status`,`next_receipt_check_at`),\n  KEY `idx_order_worker_sms_invites_mobile` (`mobile_hmac_snapshot`,`created_at`),\n  KEY `idx_order_worker_sms_invites_worker` (`worker_id`,`order_id`),\n  CONSTRAINT `fk_order_worker_sms_invites_batch` FOREIGN KEY (`batch_id`) REFERENCES `order_worker_sms_batches` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_worker_sms_invites_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_worker_sms_invites_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_worker_sms_invites_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_worker_sms_invites_retry` FOREIGN KEY (`retry_of_invite_id`) REFERENCES `order_worker_sms_invites` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_worker_sms_invites_reservation` FOREIGN KEY (`wallet_reservation_id`) REFERENCES `user_wallet_reservations` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_order_worker_sms_invites_outbox` FOREIGN KEY (`outbox_id`) REFERENCES `message_outbox` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 附近师傅单条付费短信事实';\n\nCREATE TABLE IF NOT EXISTS `sms_recipient_suppressions` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `mobile_masked` varchar(32) NOT NULL DEFAULT '',\n  `reason` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `note` varchar(500) NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `created_by_admin_id` bigint unsigned NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_sms_recipient_suppressions_mobile` (`mobile_hmac`),\n  KEY `idx_sms_recipient_suppressions_status` (`status`,`updated_at`),\n  CONSTRAINT `fk_sms_recipient_suppressions_admin` FOREIGN KEY (`created_by_admin_id`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 短信号码抑制名单';\n\n-- MySQL 5.7 没有 ADD INDEX IF NOT EXISTS，使用 information_schema 保持迁移可重复执行。\nSET @v229_worker_geo_index_exists := (\n  SELECT COUNT(*) FROM information_schema.statistics\n  WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND index_name='idx_worker_profiles_status_geo'\n);\nSET @v229_worker_geo_index_sql := IF(\n  @v229_worker_geo_index_exists=0,\n  'ALTER TABLE `worker_profiles` ADD KEY `idx_worker_profiles_status_geo` (`verification_status`,`coordinate_system`,`lat`,`lng`)',\n  'SELECT 1'\n);\nPREPARE v229_worker_geo_stmt FROM @v229_worker_geo_index_sql;\nEXECUTE v229_worker_geo_stmt;\nDEALLOCATE PREPARE v229_worker_geo_stmt;\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('wallet.recharge_min_cents','10','integer','wallet',0,'用户余额单笔最低充值金额，单位分，最低不得小于10分',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wallet.recharge_max_cents','500000','integer','wallet',0,'用户余额单笔最高充值金额，单位分，默认5000元',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wallet.recharge_expire_minutes','30','integer','wallet',0,'用户余额充值支付单展示有效分钟数；迟到真实到账仍需入账',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('wallet.recharge_hourly_limit','10','integer','wallet',0,'单用户每小时最多创建充值业务单数量',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.user_worker_invite_fee_cents','10','integer','sms',0,'附近师傅短信邀请费，每位一次邀请收费，单位分',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.user_worker_invite_receipt_wait_hours','24','integer','sms',0,'付费短信等待最终送达回执最长小时数，超时未确认成功则释放预占',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.user_worker_invite_daily_mobile_limit','5','integer','sms',0,'同一手机号每天最多接受附近订单短信邀请次数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.user_worker_invite_user_hourly_batches','5','integer','sms',0,'单用户每小时最多创建附近短信批次数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.user_worker_invite_retry_cooldown_minutes','60','integer','sms',0,'明确失败并释放资金后再次邀请同一目标的最短冷却分钟数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `value_type`=VALUES(`value_type`),\n  `group_name`=VALUES(`group_name`),\n  `is_public`=VALUES(`is_public`),\n  `description`=VALUES(`description`),\n  `updated_at`=UTC_TIMESTAMP();\n\n-- V2.2.9：师傅公开资料手机号查看只允许会员/管理员，由服务端授权并留脱敏审计。\nCREATE TABLE IF NOT EXISTS `user_membership_grants` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` bigint unsigned NOT NULL,\n  `cloud_card_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `activation_code_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `cloud_proof_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `starts_at` datetime NOT NULL,\n  `expires_at` datetime NOT NULL,\n  `granted_by` bigint unsigned NOT NULL,\n  `revoked_by` bigint unsigned NULL,\n  `revoked_at` datetime NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_user_membership_grants_public` (`public_no`),\n  KEY `idx_user_membership_grants_user_status` (`user_id`,`status`,`expires_at`),\n  KEY `idx_user_membership_grants_card` (`cloud_card_id`),\n  CONSTRAINT `fk_user_membership_grants_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_user_membership_grants_granted_by` FOREIGN KEY (`granted_by`) REFERENCES `admin_users` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_user_membership_grants_revoked_by` FOREIGN KEY (`revoked_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 后台会员激活码授权台账';\n\nCREATE TABLE IF NOT EXISTS `worker_phone_reveal_logs` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `viewer_user_id` bigint unsigned NOT NULL,\n  `viewer_role` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `worker_cloud_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `reason_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '',\n  `ip_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_worker_phone_reveal_logs_public` (`public_no`),\n  KEY `idx_worker_phone_reveal_logs_viewer_time` (`viewer_user_id`,`created_at`),\n  KEY `idx_worker_phone_reveal_logs_worker_time` (`worker_cloud_id`,`created_at`),\n  KEY `idx_worker_phone_reveal_logs_mobile_time` (`mobile_hmac`,`created_at`),\n  CONSTRAINT `fk_worker_phone_reveal_logs_user` FOREIGN KEY (`viewer_user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.2.9 师傅手机号查看脱敏审计';\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('worker.phone_reveal_enabled','1','boolean','worker',0,'师傅公开资料手机号查看总开关；关闭后会员和管理员都不能查看',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('worker.phone_reveal_member_enabled','1','boolean','worker',0,'允许后台已开通且通过服务器本地授权与云端会员绑定双重校验的有效会员查看师傅手机号；用户无需输入激活码',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('worker.phone_reveal_admin_enabled','1','boolean','worker',0,'允许真实小程序管理员查看师傅手机号；受总开关约束，不限制查看数量，每次成功查看均写脱敏审计',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('worker.phone_reveal_member_24h_limit','8','integer','worker',0,'有效会员滚动24小时最多查看不同师傅手机号数量；重复查看同一师傅不重复计数；0表示不允许查看',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('sms.user_worker_invite_unregistered_hide_after_count','10','integer','sms',0,'同一手机号累计进入短信发送流程达到该次数仍未形成师傅入驻档案时，不再作为历史标记候选展示；0表示不隐藏',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `value_type`=VALUES(`value_type`),\n  `group_name`=VALUES(`group_name`),\n  `is_public`=VALUES(`is_public`),\n  `description`=VALUES(`description`),\n  `updated_at`=UTC_TIMESTAMP();\n\n-- 分页公告已由 V2.1.1 完成一次性迁移；V2.2.9 起只保留页面级配置。\nDELETE FROM `system_settings`\nWHERE `setting_key` IN ('announcement.enabled','announcement.text','announcement.link');\n\n-- V2.2.9：大厅远距离报价二次确认、审核后师傅资料修改频率均由后台配置。\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('hall.quote_distance_confirm_km','30','integer','hall',1,'师傅报价时，当前定位距离（无当前定位时回退居住地址距离）超过该公里数，必须先确认远距离再进行最终报价确认',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('worker.profile_edit_limit_count','1','integer','worker',0,'师傅资料曾审核通过后，在限制周期内最多允许提交修改的次数；0 表示不限制',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('worker.profile_edit_period_days','30','integer','worker',0,'师傅资料审核通过后的修改次数统计周期，默认 30 天；首次入驻从未审核通过前不受限制',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `value_type`=VALUES(`value_type`),\n  `group_name`=VALUES(`group_name`),\n  `is_public`=VALUES(`is_public`),\n  `description`=VALUES(`description`),\n  `updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `database_field_dictionary`\n  (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nVALUES\n  ('orders','workflow_profile','订单工作流','construction 施工；measurement 测量。两类业务共用 orders 主档',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('orders','pending_measurement_order_id','待关联测量订单','仅施工草稿/待付款阶段保存来源引用；预约费支付成功时才原子创建一对一 order_relations',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_measurement_states','result_status','测量成果状态','editing、submitted、accepted；首期成果确认后整体锁定',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_measurement_states','settlement_status','测量结算状态','none、frozen、released；成果确认后先冻结，hold_until 到期且无财务阻断时才释放',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_measurement_states','hold_until','冻结/关联资格截止','成果确认后写入；到期前未正式关联可创建唯一优惠施工单，已关联后到期只释放测量资金',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_measurement_states','max_hold_until','最长冻结截止','普通用户/商家申请延期经管理员审核后，hold_until 不得超过本字段',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_measurement_states','settled_at','资金释放时间','冻结期到期且无阻断后，师傅净收入从冻结余额转入可用余额的实际时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_relations','relation_type','订单关联类型','V2.2.9 首期使用 measurement_construction 严格一对一',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('quotes','details_json','结构化报价内容','施工范围、排除项目、可上门时间和报价前提的 JSON 数据',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('quote_versions','details_json','结构化报价版本内容','每次报价版本对应的结构化报价 JSON 快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('offline_collection_adjustment_requests','status','复核状态','auto_approved 自动预审、approved 已复核、rejected 已驳回',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `chinese_name`=VALUES(`chinese_name`),\n  `description`=VALUES(`description`),\n  `updated_at`=UTC_TIMESTAMP();\n\n-- V2.2.9：项目尚未正式运营，不保留旧独立测量系统兼容层。\n-- 先清理旧测量系统写入通用表的测试痕迹，再按外键从子表到父表删除旧 8 张表。\nDELETE FROM `notifications`\nWHERE JSON_VALID(`data_json`)\n  AND JSON_EXTRACT(`data_json`,'$.measurement_id') IS NOT NULL;\n\nDELETE FROM `worker_balance_ledger`\nWHERE BINARY `business_type`=BINARY 'measurement_settlement';\n\nDELETE pn\nFROM `payment_notifications` pn\nINNER JOIN `payment_orders` p ON p.`id`=pn.`payment_order_id`\nWHERE BINARY p.`business_type`=BINARY 'measurement_fee';\n\nDELETE cp\nFROM `commission_payments` cp\nINNER JOIN `payment_orders` p ON p.`id`=cp.`payment_order_id`\nWHERE BINARY p.`business_type`=BINARY 'measurement_fee';\n\nDELETE r\nFROM `refunds` r\nINNER JOIN `payment_orders` p ON p.`id`=r.`payment_order_id`\nWHERE BINARY p.`business_type`=BINARY 'measurement_fee';\n\n-- 旧测量图片只允许来自 measurement_space；先把对应媒体引用数重算并标记孤儿文件待清理。\nUPDATE `media_files` mf\nINNER JOIN (\n  SELECT `media_file_id`,\n         COUNT(*) AS `total_refs`,\n         SUM(CASE WHEN BINARY `entity_type`=BINARY 'measurement_space' THEN 1 ELSE 0 END) AS `legacy_refs`\n  FROM `media_links`\n  GROUP BY `media_file_id`\n  HAVING `legacy_refs`>0\n) x ON x.`media_file_id`=mf.`id`\nSET mf.`reference_count`=GREATEST(x.`total_refs`-x.`legacy_refs`,0),\n    mf.`status`=IF(x.`total_refs`-x.`legacy_refs`<=0,'pending_delete',mf.`status`),\n    mf.`pending_delete_at`=IF(x.`total_refs`-x.`legacy_refs`<=0,COALESCE(mf.`pending_delete_at`,DATE_ADD(UTC_TIMESTAMP(),INTERVAL 1 DAY)),mf.`pending_delete_at`);\n\nDELETE FROM `media_links`\nWHERE BINARY `entity_type`=BINARY 'measurement_space';\n\nDROP TABLE IF EXISTS `measurement_freeze_extensions`;\nDROP TABLE IF EXISTS `measurement_quote_versions`;\nDROP TABLE IF EXISTS `measurement_settlements`;\nDROP TABLE IF EXISTS `measurement_order_links`;\nDROP TABLE IF EXISTS `measurement_events`;\nDROP TABLE IF EXISTS `measurement_spaces`;\nDROP TABLE IF EXISTS `measurement_quotes`;\nDROP TABLE IF EXISTS `measurement_orders`;\n\nDELETE FROM `payment_orders`\nWHERE BINARY `business_type`=BINARY 'measurement_fee';\n\nDELETE FROM `system_settings`\nWHERE `setting_key` IN (\n  'measurement.service_rate_bp',\n  'measurement.service_min_cents',\n  'measurement.max_worker_quotes',\n  'measurement.pause_orders',\n  'measurement.pause_quotes',\n  'qiniu.prefix.measurement'\n);\n\n-- 独立测量表已删除，字段字典也必须同步收敛，避免后台继续展示不存在的旧表字段。\nDELETE FROM `database_field_dictionary`\nWHERE `table_name` IN (\n  'measurement_orders',\n  'measurement_quotes',\n  'measurement_quote_versions',\n  'measurement_spaces',\n  'measurement_settlements',\n  'measurement_freeze_extensions',\n  'measurement_order_links',\n  'measurement_events'\n);\n\n-- V2.2.9 预发布业务数据重置：项目尚未正式运营，清空订单、财务、站内通知及其派生业务数据。\n-- 明确保留：system_settings、service_categories、动态表单、users / merchant_profiles / worker_profiles、\n-- 师傅审核/实名/技能/收款资料、微信身份映射、管理员与权限数据。\n-- 演示身份主档保留，但演示业务种子置空；后续演示数据使用独立文档/独立种子维护，不再与正式版本迁移强绑定。\nSET @v229_business_reset_fk_checks := @@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\n\nUPDATE `login_sessions` SET `demo_actor_user_id`=NULL WHERE `demo_actor_user_id` IS NOT NULL;\n\nDELETE FROM `message_outbox`;\nDELETE FROM `notifications`;\nDELETE FROM `scheduled_job_claims`;\nDELETE FROM `scheduled_job_failures`;\nDELETE FROM `idempotency_keys`;\n\nDELETE FROM `order_worker_sms_invites`;\nDELETE FROM `order_worker_sms_batches`;\n\nDELETE FROM `payout_adjustments`;\nDELETE FROM `withdrawal_allocations`;\nDELETE FROM `withdrawal_events`;\nDELETE FROM `worker_payouts`;\nDELETE FROM `withdrawal_requests`;\nDELETE FROM `worker_balance_ledger`;\n\nDELETE FROM `user_wallet_ledger`;\nDELETE FROM `user_wallet_recharges`;\nDELETE FROM `user_wallet_reservations`;\nDELETE FROM `user_wallets`;\n\nDELETE FROM `reconciliation_records`;\nDELETE FROM `payment_notifications`;\nDELETE FROM `commission_payments`;\nDELETE FROM `commission_adjustments`;\nDELETE FROM `commission_receivables`;\nDELETE FROM `commission_rule_versions`;\nDELETE FROM `refunds`;\nDELETE FROM `payment_orders`;\n\nDELETE FROM `review_media`;\nDELETE FROM `review_replies`;\nDELETE FROM `reviews`;\nDELETE FROM `rating_summaries`;\nDELETE FROM `dispute_evidence`;\nDELETE FROM `disputes`;\nDELETE FROM `run_empty_fee_claims`;\nDELETE FROM `after_sales`;\nDELETE FROM `order_cancel_decisions`;\nDELETE FROM `order_cancel_requests`;\nDELETE FROM `completion_submissions`;\nDELETE FROM `offline_payment_delay_requests`;\nDELETE FROM `offline_collection_adjustment_requests`;\nDELETE FROM `change_items`;\nDELETE FROM `change_confirmations`;\nDELETE FROM `change_requests`;\nDELETE FROM `appointment_records`;\nDELETE FROM `exceptional_arrivals`;\nDELETE FROM `assignment_history`;\nDELETE FROM `assignments`;\nDELETE FROM `order_role_grants`;\nDELETE FROM `invite_tokens`;\nDELETE FROM `share_contexts`;\nDELETE FROM `quote_items`;\nDELETE FROM `quote_selections`;\nDELETE FROM `quote_versions`;\nDELETE FROM `quotes`;\nDELETE FROM `merchant_risk_events`;\nDELETE FROM `order_deadlines`;\nDELETE FROM `order_events`;\nDELETE FROM `order_revisions`;\nDELETE FROM `order_answers`;\nDELETE FROM `order_addresses`;\nDELETE FROM `order_categories`;\nDELETE FROM `order_worker_contact_reveal_requests`;\nDELETE FROM `order_measurement_hold_extensions`;\nDELETE FROM `order_measurement_spaces`;\nDELETE FROM `order_measurement_states`;\nDELETE FROM `order_relations`;\n\n-- 先记住订单/评价/售后/争议/测量业务图片，再删除业务引用。\n-- 若同一媒体仍被师傅资料等保留对象引用，则只删业务关系，不删媒体主档。\nDROP TEMPORARY TABLE IF EXISTS `v229_business_media_ids`;\nCREATE TEMPORARY TABLE `v229_business_media_ids` (`media_file_id` BIGINT UNSIGNED NOT NULL PRIMARY KEY) ENGINE=MEMORY;\n\nINSERT IGNORE INTO `v229_business_media_ids` (`media_file_id`)\nSELECT `media_file_id` FROM `media_links`\nWHERE BINARY `entity_type` IN (BINARY 'order',BINARY 'review',BINARY 'after_sale',BINARY 'dispute',BINARY 'measurement_space');\n\nDELETE FROM `media_links`\nWHERE BINARY `entity_type` IN (BINARY 'order',BINARY 'review',BINARY 'after_sale',BINARY 'dispute',BINARY 'measurement_space');\n\nDELETE mf FROM `media_files` mf\nINNER JOIN `v229_business_media_ids` x ON x.`media_file_id`=mf.`id`\nLEFT JOIN `media_links` ml ON ml.`media_file_id`=mf.`id`\nWHERE ml.`id` IS NULL;\nDROP TEMPORARY TABLE IF EXISTS `v229_business_media_ids`;\n\nDELETE FROM `orders`;\n\n-- 清理订单/财务/演示初始化留下的审计痕迹，但保留师傅管理、管理员安全等审计。\nDELETE FROM `audit_logs`\nWHERE CAST(`request_id` AS BINARY) LIKE BINARY 'DEMO-%'\n   OR CAST(`action` AS BINARY) LIKE BINARY 'demo_%'\n   OR BINARY `entity_type` IN (BINARY 'order',BINARY 'payment_order',BINARY 'refund',BINARY 'commission_receivable',BINARY 'withdrawal_request',BINARY 'worker_payout',BINARY 'user_wallet',BINARY 'user_wallet_recharge',BINARY 'message_outbox');\n\nUPDATE `media_files` mf\nSET mf.`reference_count`=(SELECT COUNT(*) FROM `media_links` ml WHERE ml.`media_file_id`=mf.`id`);\n\nSET FOREIGN_KEY_CHECKS=@v229_business_reset_fk_checks;\n\n-- 演示业务种子与演示身份解耦。actor 配置为空时由 API 自动解析最新有效独立演示主档。\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('demo.seed_version','','string','system',0,'当前演示业务种子版本；空值表示仅保留演示身份主档、未生成演示订单/财务/通知数据',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.actor_user_public_id','','string','system',0,'演示用户固定 public_id；空值时自动解析最新有效独立演示用户',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.actor_merchant_public_id','','string','system',0,'演示商家固定 public_id；空值时自动解析最新有效独立演示商家',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.actor_worker_public_id','','string','system',0,'演示师傅固定 public_id；空值时自动解析最新有效独立演示师傅',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n`setting_value`=IF(BINARY VALUES(`setting_key`)=BINARY 'demo.seed_version','',`setting_value`),\n`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-09-22：补齐当前代码真实会产生的管理员企业微信事件。\n-- 使用 JSON_INSERT 只补缺失键，绝不覆盖管理员已经保存的开关选择；新结构同时记录 enabled / priority。\nINSERT IGNORE INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('wecom.event_switches','{}','json','wecom',0,'管理员企业微信通知环节；按重要/普通分级展示',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\nUPDATE `system_settings`\nSET `setting_value`=JSON_INSERT(\n    IF(JSON_VALID(`setting_value`),`setting_value`,'{}'),\n    '$.order_submitted',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.order_supplemented',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.assignment_rejected',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.assignment_expired',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.exceptional_arrival_reported',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.offline_collection_delayed',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.cancel_requested',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.auto_cancelled_7d',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.offline_collection_adjustment_requested',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.dispute_opened',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.run_empty_claim_disputed',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.worker_profile_submitted',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.worker_realname_submitted',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.merchant_auth_submitted',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.commission_overdue',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.withdrawal_submitted',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.worker_contact_reveal_requested',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.measurement_hold_extension_requested',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.completion_dispute_opened',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.repair_platform_intervention_requested',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.supplement_timeout_refunded',JSON_OBJECT('enabled',TRUE,'priority','important'),\n    '$.order_auto_preapproved',JSON_OBJECT('enabled',FALSE,'priority','normal'),\n    '$.offline_collection_adjustment_auto_approved',JSON_OBJECT('enabled',FALSE,'priority','normal'),\n    '$.worker_collection_code_auto_approved',JSON_OBJECT('enabled',FALSE,'priority','normal')\n),\n`value_type`='json',\n`group_name`='wecom',\n`description`='管理员企业微信通知环节；重要消息默认展开，普通消息默认折叠',\n`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wecom.event_switches';\n\n-- V2.2.9：微信发送接口只接受 formal / trial / developer；兼容旧后台曾保存的 release / develop。\nUPDATE `system_settings`\nSET `setting_value`=CASE\n    WHEN BINARY `setting_value`=BINARY 'release' THEN 'formal'\n    WHEN BINARY `setting_value`=BINARY 'develop' THEN 'developer'\n    ELSE `setting_value`\nEND,\n`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.miniapp_env_version'\n  AND BINARY `setting_value` IN (BINARY 'release',BINARY 'develop');\n\n-- withdrawal_result 从未接入真实发送链路，移除旧占位，避免继续诱导用户授权无效场景。\nUPDATE `system_settings`\nSET `setting_value`=JSON_REMOVE(`setting_value`,'$.withdrawal_result'),\n    `updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='wechat.subscribe_template_ids'\n  AND JSON_VALID(`setting_value`)\n  AND JSON_CONTAINS_PATH(`setting_value`,'one','$.withdrawal_result');\n\nSELECT 'V2.2.9 unified measurement order foundation ready; pre-release business data reset complete' AS message;\n","server/database/upgrades/2.4.0.sql":"-- V2.4.0：帮助中心数据化、搜索与后台逐条管理。\n-- 前置版本：2.2.9；MySQL 5.7.44；V2.4.0 预发布阶段直接重建帮助中心预览表。\nSET NAMES utf8mb4;\n\n-- 2026-09-28：施工订单支持“多师傅报价 / 单师傅抢单”两种接单方式。\n-- V2.4.0 尚未正式发布，但开发库可能已执行过本文件，因此这里仍按 MySQL 5.7 可重复执行方式补列。\nSET @v240_dispatch_mode_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='dispatch_mode'\n);\nSET @v240_dispatch_mode_ddl := IF(\n  @v240_dispatch_mode_exists > 0,\n  'SELECT 1',\n  'ALTER TABLE `orders` ADD COLUMN `dispatch_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT ''multi_quote'' COMMENT ''施工接单方式：multi_quote多师傅报价、single_grab单师傅抢单'' AFTER `workflow_profile`'\n);\nPREPARE v240_dispatch_mode_stmt FROM @v240_dispatch_mode_ddl;\nEXECUTE v240_dispatch_mode_stmt;\nDEALLOCATE PREPARE v240_dispatch_mode_stmt;\nUPDATE `orders` SET `dispatch_mode`='multi_quote' WHERE `dispatch_mode` IS NULL OR `dispatch_mode` NOT IN ('multi_quote','single_grab');\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nSELECT 'orders','dispatch_mode','接单方式','multi_quote=多师傅报价；single_grab=单师傅抢单，抢单后先联系用户再报价',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nWHERE NOT EXISTS (\n  SELECT 1 FROM `database_field_dictionary` WHERE `table_name`='orders' AND `field_name`='dispatch_mode'\n);\n\n\n-- 2026-09-29：期望费用支持“总价金额 / 单价文本”；仅总价可在 single_grab 抢单时直接成交，单价绝不参与金额计算。\n-- 2.4.0 尚未正式发布，但开发库可能已执行过旧“预期价格”草稿，因此只做一次干净改名，不长期保留旧字段。\nSET @v240_old_expected_price_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='expected_price_cents'\n);\nSET @v240_expected_fee_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='expected_fee_cents'\n);\nSET @v240_expected_fee_rename := IF(\n  @v240_old_expected_price_exists > 0 AND @v240_expected_fee_exists = 0,\n  'ALTER TABLE `orders` CHANGE COLUMN `expected_price_cents` `expected_fee_cents` bigint unsigned NULL COMMENT ''用户下单期望总价金额（分）；仅total使用并可在single_grab中直接成交''',\n  'SELECT 1'\n);\nPREPARE v240_expected_fee_rename_stmt FROM @v240_expected_fee_rename;\nEXECUTE v240_expected_fee_rename_stmt;\nDEALLOCATE PREPARE v240_expected_fee_rename_stmt;\n\nSET @v240_expected_fee_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='expected_fee_cents'\n);\nSET @v240_expected_fee_add := IF(\n  @v240_expected_fee_exists > 0,\n  'SELECT 1',\n  'ALTER TABLE `orders` ADD COLUMN `expected_fee_cents` bigint unsigned NULL COMMENT ''用户下单期望总价金额（分）；仅total使用并可在single_grab中直接成交'' AFTER `dispatch_mode`'\n);\nPREPARE v240_expected_fee_add_stmt FROM @v240_expected_fee_add;\nEXECUTE v240_expected_fee_add_stmt;\nDEALLOCATE PREPARE v240_expected_fee_add_stmt;\n\nSET @v240_expected_fee_text_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='expected_fee_text'\n);\nSET @v240_expected_fee_text_add := IF(\n  @v240_expected_fee_text_exists > 0,\n  'SELECT 1',\n  'ALTER TABLE `orders` ADD COLUMN `expected_fee_text` varchar(500) COLLATE utf8mb4_unicode_ci NULL COMMENT ''用户填写的期望单价说明文本；仅unit使用，不参与金额计算'' AFTER `expected_fee_cents`'\n);\nPREPARE v240_expected_fee_text_add_stmt FROM @v240_expected_fee_text_add;\nEXECUTE v240_expected_fee_text_add_stmt;\nDEALLOCATE PREPARE v240_expected_fee_text_add_stmt;\n\n-- 若开发库曾部分执行过新旧两版草稿，先把旧值补到新列，再彻底删除旧列。\nSET @v240_old_expected_price_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='expected_price_cents'\n);\nSET @v240_expected_fee_merge := IF(\n  @v240_old_expected_price_exists > 0,\n  'UPDATE `orders` SET `expected_fee_cents`=COALESCE(`expected_fee_cents`,`expected_price_cents`)',\n  'SELECT 1'\n);\nPREPARE v240_expected_fee_merge_stmt FROM @v240_expected_fee_merge;\nEXECUTE v240_expected_fee_merge_stmt;\nDEALLOCATE PREPARE v240_expected_fee_merge_stmt;\nSET @v240_expected_fee_drop_old := IF(\n  @v240_old_expected_price_exists > 0,\n  'ALTER TABLE `orders` DROP COLUMN `expected_price_cents`',\n  'SELECT 1'\n);\nPREPARE v240_expected_fee_drop_old_stmt FROM @v240_expected_fee_drop_old;\nEXECUTE v240_expected_fee_drop_old_stmt;\nDEALLOCATE PREPARE v240_expected_fee_drop_old_stmt;\n\nSET @v240_expected_fee_type_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='orders' AND COLUMN_NAME='expected_fee_type'\n);\nSET @v240_expected_fee_type_add := IF(\n  @v240_expected_fee_type_exists > 0,\n  'SELECT 1',\n  'ALTER TABLE `orders` ADD COLUMN `expected_fee_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NULL COMMENT ''期望费用计价方式：total总价、unit单价'' AFTER `dispatch_mode`'\n);\nPREPARE v240_expected_fee_type_add_stmt FROM @v240_expected_fee_type_add;\nEXECUTE v240_expected_fee_type_add_stmt;\nDEALLOCATE PREPARE v240_expected_fee_type_add_stmt;\n\nUPDATE `orders`\nSET `expected_fee_type`=CASE WHEN `expected_fee_cents` IS NULL THEN NULL ELSE 'total' END\nWHERE `expected_fee_type` IS NULL OR `expected_fee_type` NOT IN ('total','unit');\n\n-- 2.4.0 仍处开发期：此前试做的“单价金额”转换成只读文本后清空 cents，彻底断开金额语义。\nUPDATE `orders`\nSET `expected_fee_text`=COALESCE(NULLIF(TRIM(`expected_fee_text`),''),CONCAT('原单价 ',TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(CAST(`expected_fee_cents`/100 AS DECIMAL(18,2)) AS CHAR))),'元'))\nWHERE `expected_fee_type`='unit' AND `expected_fee_cents` IS NOT NULL;\nUPDATE `orders` SET `expected_fee_cents`=NULL WHERE `expected_fee_type`='unit';\n\nDELETE FROM `database_field_dictionary`\nWHERE `table_name`='orders' AND `field_name` IN ('expected_price_cents','expected_fee_type','expected_fee_cents','expected_fee_text');\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('orders','expected_fee_type','期望费用计价方式','total=总价金额；unit=单价文本。仅total参与single_grab直接成交',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','expected_fee_cents','期望总价（分）','仅total使用；用户期望总价可用于single_grab直接成交',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','expected_fee_text','期望单价说明','仅unit使用；可按材料分别填写不同单位，纯文本展示，不参与任何金额计算',UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\n-- 2026-09-29：尚未正式运营，order_submit 不保留开发期 V2 草稿；本版直接修改已发布 V1 配置。\n-- 删除 V2+ 草稿会由外键级联清理其步骤、字段、选项和规则；V1 继续作为小程序实际读取的唯一已发布版本。\nDELETE v FROM `form_schema_versions` v\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nWHERE fs.`schema_key`='order_submit' AND v.`version_no`>1 AND v.`status`='draft';\n\nUPDATE `form_schema_versions` v\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nSET v.`status`='published'\nWHERE fs.`schema_key`='order_submit' AND v.`version_no`=1;\n\nUPDATE `form_schemas` fs\nINNER JOIN `form_schema_versions` v1 ON v1.`schema_id`=fs.`id` AND v1.`version_no`=1\nSET fs.`current_version`=1,fs.`status`='published',fs.`updated_at`=UTC_TIMESTAMP()\nWHERE fs.`schema_key`='order_submit';\n\nDELETE r FROM `form_rules` r\nINNER JOIN `form_schema_versions` v ON v.`id`=r.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nWHERE fs.`schema_key`='order_submit' AND r.`rule_key` IN ('v240_measure_hide_expected_price','v240_measure_hide_expected_fee');\n\nDELETE oldf FROM `form_fields` oldf\nINNER JOIN `form_steps` s ON s.`id`=oldf.`step_id`\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nINNER JOIN `form_fields` nf ON nf.`step_id`=oldf.`step_id` AND nf.`field_key`='expected_fee'\nWHERE fs.`schema_key`='order_submit' AND oldf.`field_key`='expected_price';\n\nUPDATE `form_fields` f\nINNER JOIN `form_steps` s ON s.`id`=f.`step_id`\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nLEFT JOIN `form_fields` nf ON nf.`step_id`=f.`step_id` AND nf.`field_key`='expected_fee'\nSET f.`field_key`='expected_fee',f.`updated_at`=UTC_TIMESTAMP()\nWHERE fs.`schema_key`='order_submit' AND f.`field_key`='expected_price' AND nf.`id` IS NULL;\n\nDELETE f FROM `form_fields` f\nINNER JOIN `form_steps` s ON s.`id`=f.`step_id`\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nWHERE fs.`schema_key`='order_submit' AND f.`field_key`='expected_fee' AND s.`step_key`<>'product_info';\n\nINSERT INTO `form_fields`\n(`step_id`,`field_key`,`label`,`component_type`,`data_type`,`placeholder`,`help_text`,`is_required`,`default_value_json`,`validation_json`,`ui_config_json`,`sort_order`,`status`,`created_at`,`updated_at`)\nSELECT s.`id`,'expected_fee','期望费用','text','string','填写期望总价或材料单价',\n       '选填。总价按整数元填写；单价可按材料填写，成交以总价为准。',\n       0,NULL,'{\"max_length\":500}','{\"fee_modes\":[\"total\",\"unit\"],\"default_fee_mode\":\"total\",\"total_integer_only\":true,\"unit_options\":[\"元/平\",\"元/㎡\",\"元/卷\",\"元/米\",\"元/延米\",\"元/个\",\"元/套\",\"元/张\",\"元/扇\"]}',150,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `form_steps` s\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nWHERE fs.`schema_key`='order_submit' AND s.`step_key`='product_info'\n  AND NOT EXISTS (SELECT 1 FROM `form_fields` f WHERE f.`step_id`=s.`id` AND f.`field_key`='expected_fee');\n\nUPDATE `form_fields` f\nINNER JOIN `form_steps` s ON s.`id`=f.`step_id`\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nSET f.`label`='期望费用',f.`component_type`='text',f.`data_type`='string',f.`placeholder`='填写期望总价或材料单价',\n    f.`help_text`='选填。总价按整数元填写；单价可按材料填写，成交以总价为准。',\n    f.`is_required`=0,f.`validation_json`='{\"max_length\":500}',\n    f.`ui_config_json`='{\"fee_modes\":[\"total\",\"unit\"],\"default_fee_mode\":\"total\",\"total_integer_only\":true,\"unit_options\":[\"元/平\",\"元/㎡\",\"元/卷\",\"元/米\",\"元/延米\",\"元/个\",\"元/套\",\"元/张\",\"元/扇\"]}',\n    f.`sort_order`=150,f.`status`='active',f.`updated_at`=UTC_TIMESTAMP()\nWHERE fs.`schema_key`='order_submit' AND s.`step_key`='product_info' AND f.`field_key`='expected_fee';\n-- 2026-09-29：前端填写说明只保留用户决策所需信息。\n-- 图片压缩、地址加密、未选类目的内部流转等实现细节仍照常执行，但不再作为用户填写提示。\nUPDATE `form_fields` f\nINNER JOIN `form_steps` s ON s.`id`=f.`step_id`\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nSET f.`placeholder`=CASE f.`field_key`\n      WHEN 'category_ids' THEN '可多选，不确定可暂不选择'\n      WHEN 'material_images' THEN '上传材料或商品图片'\n      WHEN 'wall_images' THEN '上传墙面或现场照片'\n      WHEN 'service_address' THEN '选择实际上门地址'\n      WHEN 'expected_fee' THEN '填写期望总价或材料单价'\n      ELSE f.`placeholder` END,\n    f.`help_text`=CASE f.`field_key`\n      WHEN 'category_ids' THEN NULL\n      WHEN 'material_images' THEN '请尽量拍清材料款式和规格'\n      WHEN 'wall_images' THEN '请拍清破损、发霉、楼梯或造型等情况'\n      WHEN 'service_address' THEN NULL\n      WHEN 'expected_fee' THEN '选填。总价按整数元填写；单价可按材料填写，成交以总价为准。'\n      ELSE f.`help_text` END,\n    f.`updated_at`=UTC_TIMESTAMP()\nWHERE fs.`schema_key`='order_submit' AND v.`version_no`=1\n  AND f.`field_key` IN ('category_ids','material_images','wall_images','service_address','expected_fee');\n\nUPDATE `form_schemas`\nSET `description`='小程序下单页配置，统一通过可视化设计器维护',`updated_at`=UTC_TIMESTAMP()\nWHERE `schema_key`='order_submit';\n\n\nUPDATE `order_answers`\nSET `field_key_snapshot`='expected_fee',`field_label_snapshot`='期望费用'\nWHERE `field_key_snapshot`='expected_price';\n\nINSERT INTO `form_rules`\n(`schema_version_id`,`rule_key`,`name`,`trigger_field_id`,`operator`,`compare_value_json`,`action_type`,`target_field_id`,`action_payload_json`,`priority`,`status`,`created_at`,`updated_at`)\nSELECT v.`id`,'v240_measure_hide_expected_fee','测量时隐藏：期望费用',wf.`id`,'equals','\"measurement\"','hide',ef.`id`,NULL,25,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM `form_schema_versions` v\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nINNER JOIN `form_steps` ws ON ws.`schema_version_id`=v.`id`\nINNER JOIN `form_fields` wf ON wf.`step_id`=ws.`id` AND wf.`field_key`='workflow_profile'\nINNER JOIN `form_steps` es ON es.`schema_version_id`=v.`id`\nINNER JOIN `form_fields` ef ON ef.`step_id`=es.`id` AND ef.`field_key`='expected_fee'\nWHERE fs.`schema_key`='order_submit'\n  AND NOT EXISTS (SELECT 1 FROM `form_rules` r WHERE r.`schema_version_id`=v.`id` AND r.`rule_key`='v240_measure_hide_expected_fee');\n\n\n-- V2.4.0 尚未正式发布：直接重建帮助中心预览结构，不兼容此前开发中的 2.4.0 草稿表。\nSET FOREIGN_KEY_CHECKS=0;\nDROP TABLE IF EXISTS `help_search_logs`;\nDROP TABLE IF EXISTS `help_faq_versions`;\nDROP TABLE IF EXISTS `help_faqs`;\nDROP TABLE IF EXISTS `help_categories`;\nSET FOREIGN_KEY_CHECKS=1;\n\nCREATE TABLE IF NOT EXISTS `help_categories` (\n  `id` int unsigned NOT NULL AUTO_INCREMENT,\n  `code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `name` varchar(80) NOT NULL,\n  `sort_order` int NOT NULL DEFAULT 0,\n  `homepage_featured` tinyint(1) NOT NULL DEFAULT 0,\n  `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`), UNIQUE KEY `uq_help_category_code` (`code`),\n  KEY `idx_help_category_status_sort` (`status`,`sort_order`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心业务场景';\n\nCREATE TABLE IF NOT EXISTS `help_faqs` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `category_id` int unsigned NOT NULL,\n  `question` varchar(255) NOT NULL,\n  `answer` text NOT NULL,\n  `aliases` text NULL,\n  `keywords` text NULL,\n  `roles` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'all',\n  `sort_order` int NOT NULL DEFAULT 0,\n  `is_featured` tinyint(1) NOT NULL DEFAULT 0,\n  `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft',\n  `related_faq_ids` text NULL,\n  `business_entry_label` varchar(80) NOT NULL DEFAULT '',\n  `business_entry_path` varchar(255) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '',\n  `draft_payload` longtext NULL,\n  `version` int unsigned NOT NULL DEFAULT 1,\n  `published_version` int unsigned NOT NULL DEFAULT 0,\n  `published_at` datetime NULL,\n  `created_by` int unsigned NULL,\n  `updated_by` int unsigned NULL,\n  `deleted_at` datetime NULL,\n  `created_at` datetime NOT NULL,\n  `updated_at` datetime NOT NULL,\n  PRIMARY KEY (`id`), UNIQUE KEY `uq_help_faq_id` (`faq_id`),\n  KEY `idx_help_faq_public` (`status`,`deleted_at`,`category_id`,`sort_order`,`id`),\n  KEY `idx_help_faq_updated` (`updated_at`,`id`),\n  CONSTRAINT `fk_help_faq_category` FOREIGN KEY (`category_id`) REFERENCES `help_categories` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心问答';\n\nCREATE TABLE IF NOT EXISTS `help_faq_versions` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `version` int unsigned NOT NULL,\n  `snapshot_json` longtext NOT NULL,\n  `action` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `operator_admin_id` int unsigned NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`id`), UNIQUE KEY `uq_help_faq_version` (`faq_id`,`version`),\n  KEY `idx_help_version_created` (`created_at`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心发布版本审计';\n\nCREATE TABLE IF NOT EXISTS `help_search_logs` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `query_text` varchar(120) NOT NULL DEFAULT '',\n  `query_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `role_key` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'all',\n  `result_count` int unsigned NOT NULL DEFAULT 0,\n  `clicked_faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NULL,\n  `created_at` datetime NOT NULL,\n  PRIMARY KEY (`id`), KEY `idx_help_search_zero` (`result_count`,`created_at`), KEY `idx_help_search_hash` (`query_hash`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心脱敏搜索日志';\n\n\n-- 文档第 5 节 83 条问答先以草稿迁入；管理员发布前不会进入小程序公开接口。\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('find','找师傅',10,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('order','下单',20,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('payment','报价付款',30,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('construction','施工',40,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('measurement','测量',50,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('refund','退款',60,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('aftersales','售后',70,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('account','账号安全',80,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('finance','余额结算',90,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A01',id,'我第一次使用，需要做什么？','进入小程序后按提示完成登录；需要使用手机号功能时再授权手机号。找师傅可在首页用“地图搜索”或“文字搜索”，下单、查看消息和账户信息可从底部导航或“我的”进入。',NULL,'登录 手机号 第一次使用','all',10,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A02',id,'地图搜索和文字搜索有什么区别？','地图搜索适合按施工地点看附近师傅；文字搜索可输入城市、地址或昵称。搜索结果只是查找线索，是否能报价或承接订单仍以订单页面与师傅资格为准。',NULL,'地图搜索 文字搜索 找师傅','all',20,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A03',id,'定位失败怎么办？','在微信或手机系统设置中允许小程序使用位置，再回到页面重试。仍失败时可用文字搜索或手动选择地址；接单大厅无法取得当前位置时会按最新发布等可用方式展示。',NULL,'定位 位置 权限 地址','all',30,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A04',id,'地图上没有师傅，是系统故障吗？','先核对搜索城市、位置权限和地图范围，并尝试缩小地图或用文字搜索。地图只展示符合展示条件的资料；附近暂时没有结果时，可通过订单流程等待报价。',NULL,'地图 师傅 无结果','all',40,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A05',id,'地图距离和师傅实际位置为何不同？','页面展示的是约距离或资料中的位置，不是实时行程或精确门牌。报价、预约和上门时间应以双方沟通及订单记录为准。',NULL,'距离 位置 师傅','all',50,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A06',id,'为什么要授权手机号？','手机号用于需要验证身份或联系的业务。微信登录与手机号授权是两步；未授权时可先浏览开放内容，但手机号相关操作可能无法完成。可在“我的 → 设置 → 账号与个人信息”检查。',NULL,'手机号 授权 登录','all',60,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A07',id,'在哪看消息和待办？','打开“我的 → 消息与待办”。“待我处理”显示当前仍需操作的订单事项，“全部消息”显示通知；操作完成后，待办会按订单最新状态更新。',NULL,'消息 待办 通知','all',70,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A08',id,'收不到微信订阅通知怎么办？','在“我的 → 设置 → 消息通知”查看该场景是否可用并开启，同时检查“微信通知设置”。微信订阅通知可能需要再次授权；订单是否待处理仍应以站内“消息与待办”和订单详情为准。',NULL,'订阅通知 微信通知 消息','all',80,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A09',id,'如何联系客服？','在订单详情点击“联系客服”；找师傅或下单前也可通过首页客服入口咨询。涉及订单时请提供订单号和问题描述，不要发送卡密或无关个人信息。',NULL,'客服 联系客服','all',90,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A10',id,'“一口价订单”“报价订单”“旧版工单”有什么区别？','“一口价订单”是保留的原商品/服务入口；新下单、报价和测量在“报价订单”中查看；师傅的历史安装工单可从“施工订单 → 旧版工单”进入。不同入口的状态和付款记录不应混看。',NULL,'一口价 报价订单 旧版工单 历史订单','all',100,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B01',id,'如何发布施工订单？','从底部“发布”进入下单页，选服务类目，填写施工地址、联系人、需求和页面要求的图片，确认规则后提交并支付页面显示的预约费。订单支付成功后才进入审核；审核通过后按当前规则进入报价阶段。',NULL,'发布施工 下单 预约费','user',110,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B02',id,'如何发布测量订单？','在同一个下单页选择“测量”，填写测量地址、联系人、期望时间等信息并支付预约费。测量单和施工单都在“报价订单”中查看，卡片会标明“测量”。',NULL,'测量订单 量房 下单','user',120,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B03',id,'为什么提交后还不能被师傅看到？','订单须完成预约费支付并通过审核，且处于允许公开报价的阶段，才会进入接单大厅。打开“我的 → 报价订单 → 订单详情”查看付款、审核或补资料提示。',NULL,'审核 接单大厅 师傅看不到','user',130,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B04',id,'审核要求补资料，怎么处理？','进入订单详情，查看审核意见，点击“补充订单资料”，按提示补充说明或图片并重新提交。重新提交后等待审核结果。',NULL,'补资料 审核','user',140,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B05',id,'预约费会收几次？','同一笔订单的预约费只收一次。施工单在选择报价时不重复收取；测量单选中报价后，只补测量总价与已有效支付预约费之间的差额。最终金额以当前订单详情和支付页为准。',NULL,'预约费 预付款 次数','user',150,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B06',id,'付款成功但页面仍显示待支付怎么办？','返回订单详情刷新并查看支付状态，避免连续创建多笔付款。若微信已扣款而订单仍未更新，保存支付记录并联系客服核查；是否到账由服务端确认的支付结果决定。',NULL,'付款 支付 微信扣款','user',160,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B07',id,'怎样比较师傅报价？','在订单详情查看报价金额、服务包含/不包含、可上门时间、报价前提、师傅资料及评价，再选择适合自己的报价。系统不会替您自动挑选师傅。',NULL,'报价 比较 选择师傅','user',170,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B08',id,'没有人报价怎么办？','确认订单已付款并审核通过，可补充清晰的施工照片和需求；订单仍在待报价阶段时，可查看“通知附近师傅”是否可用。候选和短信价格以弹窗为准，发送短信不保证对方一定报价。',NULL,'没人报价 通知附近师傅 短信','user',180,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B09',id,'“通知附近师傅”如何收费？','在本人订单的待报价阶段选择候选并确认页面单价，费用先从“我的余额”预占；仅短信最终确认送达时扣费，明确失败或无法确认送达时释放预占。同一订单已通知的目标不会重复收费发送。',NULL,'短信费 通知附近师傅 余额 预占','user',190,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B10',id,'为什么附近师傅列表里有人不能选？','候选可能已通知、当前不符合报价资格、订单报价名额已满，或提交前资格发生变化。请看候选旁的提示；提交时失效的候选不会预占费用或发送。',NULL,'附近师傅 候选 不能选','user',200,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B11',id,'选中报价后，师傅会自动接单吗？','师傅主动报价被您选中后，满足相应支付条件即按订单流程承接；平台派单或邀请师傅仍需对方确认。查看订单详情中的当前状态和预约信息。',NULL,'选中报价 自动接单 派单','user',210,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B12',id,'师傅何时能看到我的电话和详细地址？','报价阶段联系方式受保护；选中师傅或平台完成派单后，才按履约需要开放。商家订单的师傅电话另有保护规则，不会因选择报价就直接公开。',NULL,'电话 地址 联系方式 隐私','user',220,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B13',id,'如何确认上门时间？','与承接师傅沟通后，以订单详情记录的预约时间或“等待客户另行通知”为准。时间变化时请双方在订单中更新，避免只在聊天中约定。',NULL,'预约 上门时间','user',230,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B14',id,'师傅到场后要求加钱，我该怎么处理？','先核对原报价的包含范围。师傅应在订单中提交费用变更和原因，您在详情中选择同意或拒绝；测量加费须完成相应支付才增加成交额。对变更有异议时先保留证据并联系客服。',NULL,'加钱 加费 费用变更','user',240,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B15',id,'如何验收完工？','师傅提交完工与照片后，进入订单详情核对施工结果，再按页面提示确认验收或提出异议。页面可能显示自动确认时间，请及时处理。',NULL,'验收 完工','user',250,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B16',id,'施工有问题，怎么申请维修或售后？','在订单详情查看“申请维修保障”是否可用，按提示描述问题并提交证据。测量成果确认后发现漏项、尺寸或图片问题，可从同一订单的“申请测量售后”进入。',NULL,'维修 售后 测量售后','user',260,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B17',id,'如何申请退款或取消？','在订单详情点击“申请退款”或相应取消入口，填写原因并查看处理状态。退款是否可用、金额及去向取决于当前订单阶段、支付记录和平台处理结果；不要把未到账的微信退款视为已完成。',NULL,'退款 取消订单','user',270,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='refund' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B18',id,'订单争议如何处理？','在详情中提交异议和现场证据，或联系平台客服。争议处理中请保留订单内的报价、变更、照片与沟通记录；平台会按订单事实和规则处理。',NULL,'争议 异议 证据','user',280,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B19',id,'能直接看到师傅完整手机号吗？','师傅公开资料中的号码受保护。普通下单用户按订单阶段和当前联系权限联系师傅；商家订单不提供直接公开师傅电话的入口，必要时通过订单客服协助。',NULL,'师傅手机号 电话 隐私','user',290,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C01',id,'测量报价金额包含预约费吗？','测量报价是总价，已有效支付的预约费计入其中。选定师傅后，支付剩余差额才正式成交；付款取消或超时不会把已付预约费当作差额扣掉。',NULL,'测量 报价 预约费','user',300,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C02',id,'在哪里看测量成果？','打开测量订单详情，查看师傅提交的空间和图片，包括手写测量单、标注图和现场照片。成果有问题时先在确认前提出补测或异议。',NULL,'测量成果 标注图','user',310,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C03',id,'师傅用量房工具画的图会自动上传吗？','不会。标注工具先保存在师傅本地；师傅明确点击上传后，图片才会进入订单成果。您看不到图片时，可提醒师傅检查是否已上传并提交。',NULL,'量房工具 自动上传 标注','user',320,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C04',id,'确认测量成果后发现问题怎么办？','从测量订单详情发起测量售后并上传问题证据。确认后的成果会锁定，不通过再次直接编辑原成果解决。',NULL,'测量售后 成果问题','user',330,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C05',id,'测量完成后如何下施工单？','从符合条件的测量订单进入关联施工下单，核对预填的地址和联系人，重新填写施工材料、类目和需求。只有施工预约费支付成功，才正式建立一对一关联；打开草稿不占用资格。',NULL,'关联施工 测量单 下施工单','user',340,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C06',id,'能把一张测量单关联多张施工单吗？','当前只能一对一。关联施工只供原测量师傅报价，且须符合相同地址、有效期等条件；需要另找师傅时，可新建普通施工订单。',NULL,'一对一 关联施工','user',350,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C07',id,'测量费会自动抵施工费吗？','不会自动抵扣，默认 0 元。原测量师傅与您商议后在关联施工报价中填写实际抵扣额，订单会展示金额；更换师傅的新普通订单不继承该抵扣。',NULL,'测量费 抵扣 施工费','user',360,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C08',id,'测量款为何还显示冻结？','测量成果确认后，师傅收入按订单规则进入冻结期；有有效售后、退款或争议时也可能暂缓释放。具体到期时间和状态请看测量订单详情。',NULL,'测量款 冻结','user',370,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C09',id,'“我的余额”是什么？','这是用户充值后用于平台当前支持服务的消费余额。它与师傅“结算工钱”完全独立；同一个账号兼具师傅身份也不会自动合并或互转。',NULL,'我的余额 用户余额','user',380,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C10',id,'用户余额能付预约费、测量补款或提现吗？','当前不能。预约费、测量补款、加费等按订单支付页走微信支付；用户余额目前可用于符合条件的附近师傅短信费，不支持提现、转账或购买会员。',NULL,'余额 预约费 提现 会员','user',390,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C11',id,'充值后余额没变怎么办？','在“我的 → 我的余额”查看明细并刷新。余额以服务器确认微信支付真实到账为准；若微信已扣款但页面长时间未更新，请保留支付凭证并联系客服。',NULL,'充值 余额没变','user',400,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C12',id,'短信费为何先显示预占？','发送后需等待短信送达结果。最终确认送达才扣费；失败或无法确认送达会释放预占。可在订单通知状态及余额明细中查看变化。',NULL,'短信费 预占 余额','user',410,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C13',id,'旧版一口价订单在哪里看？','从“我的 → 一口价订单”进入。新报价/测量订单在“我的 → 报价订单”；两类订单的付款与状态以各自页面为准。',NULL,'旧版 一口价订单 历史订单','user',420,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D01',id,'如何申请师傅入驻？','打开“我的 → 师傅入驻”，点击“立即申请入驻”，填写施工类型、技能、服务地区、照片等资料并提交审核。页面有审核微信二维码，可用于资料核对和反馈。',NULL,'师傅入驻 申请','worker',430,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D02',id,'如何查看审核进度或驳回原因？','在“我的 → 师傅入驻”查看资料卡片的状态和处理说明。审核时间以实际处理为准；资料被驳回后按说明修改并重新提交。',NULL,'师傅审核 驳回','worker',440,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D03',id,'修改入驻资料会怎样？','从“师傅入驻 → 修改入驻资料”编辑原档案；提交后需要重新审核。已通过后的修改可能受后台次数或周期限制，页面会显示是否可改及下一次可修改时间。',NULL,'修改资料 重新审核','worker',450,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D04',id,'审核通过了，为什么地图上还没有我？','先核对入驻状态、展示资料和服务位置，返回地图刷新。若状态已通过且仍不显示，请将入驻资料与页面情况反馈客服；地图展示与能否对某单报价是两项判断。',NULL,'地图 师傅 审核通过','worker',460,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D05',id,'任何登录用户都能看接单大厅吗？','正常登录的小程序用户可浏览公开报价阶段订单；浏览不代表能报价。大厅只展示当前仍允许公开的订单，选中报价、进入履约、退款或售后等阶段后会移出。',NULL,'接单大厅 浏览 报价','worker',470,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D06',id,'为什么我能看订单却不能报价？','报价需正式师傅审核通过、当前未暂停报价、没有逾期平台服务费，并满足该订单的实时限制。受邀专用身份不能在普通大厅报价；自己的订单也不能给自己报价。以详情页的禁报原因提示为准。',NULL,'不能报价 报价资格','worker',480,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D07',id,'如何提交或修改报价？','在接单大厅打开可报价订单，查看服务范围、地址概况和现场资料，点击“填写报价”；填写总价、包含/不包含范围、可上门时间及前提后提交。还处于可编辑阶段时，详情页会显示“修改报价”。',NULL,'提交报价 修改报价','worker',490,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D08',id,'为什么报价后看不到用户完整电话？','报价阶段联系方式受保护。用户选中您或平台完成派单后，才按当前订单履约权限开放；公开大厅不会提供精确门牌和原始坐标。',NULL,'用户电话 地址 隐私','worker',500,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D09',id,'报价被选中后还要点确认接单吗？','主动报价被选中并满足支付条件后会按流程自动承接；平台派单或邀请订单须在“施工订单”详情中按时接受或拒绝。受邀订单请到相应分类查看。',NULL,'确认接单 自动接单','worker',510,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D10',id,'接到派单但没及时确认会怎样？','派单详情会显示接受截止时间；超过时间可能自动释放。请在“我的 → 施工订单”及时处理，不能仅凭微信消息判断订单仍归您。',NULL,'派单 确认 超时','worker',520,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D11',id,'在哪里看我的施工和测量订单？','打开“我的 → 施工订单”，按来源和状态切换；施工、测量、平台派单及受邀工单集中在这里。历史安装工单从“旧版工单”进入。',NULL,'施工订单 测量订单','worker',530,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D12',id,'上门时间如何记录？','与客户确认后，在师傅订单详情的“预约上门”记录或修改时间；若客户暂未确定，可按页面允许的方式记录等待通知。',NULL,'预约上门 时间','worker',540,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D13',id,'现场情况与报价不符，如何加费？','先与客户沟通，再在订单详情提交费用变更、金额与原因。只有客户按流程同意，测量加费还完成相应支付后，金额才会生效；不能只靠电话约定改动订单金额。',NULL,'加费 费用变更','worker',550,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D14',id,'如何提交完工？','在施工订单详情上传至少一张完工照片，填写必要说明和维修保障信息后提交。用户随后验收或提出异议；页面会显示可能的自动验收时间。',NULL,'提交完工 完工照片','worker',560,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D15',id,'做测量单要提交哪些成果？','在订单详情按空间上传手写测量单、标注图、现场照片等成果，检查完整后提交给用户确认。量房工具的本地标注不会自动上传到订单。',NULL,'测量成果 标注图 手写测量','worker',570,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D16',id,'客户说没收到测量标注图怎么办？','检查标注是否仅保存在本地，并在测量订单中明确上传、提交。已经提交后仍缺图，可在成果确认前按订单提示补充或补测。',NULL,'测量标注图 上传','worker',580,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D17',id,'原测量单关联施工时由谁报价？','关联施工单仅原测量师傅可报价。报价时可与用户商议测量费抵扣额，默认 0 元；不能把测量费自动当作施工预付款。',NULL,'关联施工 报价 测量师傅','worker',590,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D18',id,'到场后无法施工或联系不上客户怎么办？','在订单详情使用“无法联系或无法施工/测量”入口，按提示上传带时间和位置的现场证据并说明情况。涉及跑空费时，普通用户单先线下协商；商家单按页面提交商家确认或进入争议。',NULL,'无法施工 联系不上 跑空费','worker',600,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D19',id,'用户申请维修或测量售后后，我在哪里处理？','从“消息与待办”或“施工订单”进入原订单，查看当前售后要求并按订单详情响应。售后处理不改变原订单已完成的历史事实。',NULL,'维修 售后 师傅处理','worker',610,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E01',id,'平台服务费怎么计算？','报价页和订单详情会展示适用费率、最低服务费及预计净收入；预约费可用于抵扣最终服务费。最终账单按成交金额、费用变更和验收后的订单事实计算，以“结算工钱”中的账单为准。',NULL,'平台服务费 费率 净收入','worker',620,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E02',id,'服务费逾期有什么影响？','正式账单逾期未结清时，可能不能新报价或接受新派单。进入“我的 → 结算工钱 → 待结算”查看账单并按页面提示支付。',NULL,'服务费 逾期 报价','worker',630,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E03',id,'“我的余额”与“结算工钱”有何区别？','“我的余额”是作为下单用户充值的消费余额；“结算工钱”是师傅履约收入、服务费账单和可提现金额。两边不能自动抵扣或互转。',NULL,'余额 结算工钱','worker',640,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E04',id,'怎么申请提现？','打开“我的 → 结算工钱”，先完成实名认证并绑定与实名一致的支付宝收款账号；满足页面显示的最低金额和可提现余额后提交申请。平台审核后人工支付宝付款，状态在“提现记录”中查看。',NULL,'提现 支付宝 实名','worker',650,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E05',id,'实名认证还没通过，能先绑定支付宝吗？','可以先绑定账号，但申请提现前须通过实名认证，支付宝姓名也要与认证姓名一致。审核不通过时按页面原因修改后再提交。',NULL,'实名认证 支付宝 提现','worker',660,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E06',id,'为什么提现金额低于收入？','部分收入可能尚未结算、处于冻结期，或已申请提现；测量收入确认后也有冻结规则。查看“结算工钱”的可提现余额、冻结金额、明细和提现记录。',NULL,'提现金额 冻结 可提现','worker',670,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E07',id,'商家单的收款码要怎么用？','在“结算工钱”上传微信或支付宝收款码并等待审核；订单页面只展示一张已审核的码，供该商家订单完工后线下尾款收取。收款金额和凭证以订单当前流程为准。',NULL,'商家单 收款码 尾款','worker',680,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E08',id,'线下尾款没按时收到怎么办？','正常收款无须额外报告；只有延期时在师傅订单详情登记预计收款日期和原因。金额与预计不符时按页面提交实际尾款和收款凭证，不能自行改写原订单金额。',NULL,'尾款 延期 收款','worker',690,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E09',id,'有人用平台资料打营销电话怎么办？','记录来电时间、号码和相关证据，通过客服反馈。不要在帮助中心或公开评论中粘贴自己的完整手机号；平台按记录核查。',NULL,'营销电话 隐私 安全','worker',700,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F01',id,'如何申请商家认证？','在“我的 → 商家认证”上传营业执照，填写商家名称和经营地址后提交。页面会显示审核状态与原因；通过后的具体服务费优惠以页面和订单快照为准。',NULL,'商家认证 营业执照','merchant',710,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F02',id,'旧门店资料能当作商家认证吗？','不能直接等同。商家认证页展示旧门店资料供兼容查看；新的经营身份与优惠以当前“商家认证”的审核结果为准。',NULL,'旧门店 商家认证','merchant',720,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F03',id,'商家下单与普通用户下单有何不同？','仍从统一下单页提交并在“报价订单”查看。平台按提交时的商家身份和订单规则生成快照；商家相关费率、联系与结款方式以该订单详情为准，后续身份变化不自动重写旧订单。',NULL,'商家下单 普通用户 订单','merchant',730,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F04',id,'商家订单能直接看师傅手机号吗？','商家订单不提供直接公开师傅完整号码的入口。请使用订单内已有的联系流程；争议处理中确需协助时，通过订单客服说明原因。',NULL,'商家订单 师傅手机号','merchant',740,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F05',id,'商家订单尾款怎么支付？','施工订单详情可能展示经平台审核的师傅收款码，用于完工后的线下尾款；请核对订单金额和收款信息并保留凭证。测量补款、加费等需要线上支付的项目仍按订单页面操作。',NULL,'商家 尾款 收款码','merchant',750,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F06',id,'师傅提交跑空费后我怎么处理？','在订单详情查看金额、原因及现场证据，选择同意并按页面支付，或不同意并转争议。普通用户单的处理方式与商家单不同，请按本单页面提示操作。',NULL,'跑空费 商家 争议','merchant',760,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F07',id,'商家和师傅的资金或联系方式会混在一起吗？','不会。商家身份、师傅身份和下单用户身份可在同一账号并存，但订单费用、用户充值余额、师傅结算余额及联系方式分别按当前业务权限处理。',NULL,'多身份 资金 联系方式','merchant',770,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G01',id,'在哪里查看会员状态？','打开“我的 → 设置 → 会员服务”，查看是否已开通及有效期。历史会员可能显示兼容状态；是否能使用某项权益，还要以当前权限与后台配置为准。',NULL,'会员状态 有效期','member',780,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G02',id,'怎样开通会员、价格是多少？','从“设置 → 会员服务”查看当前可用的开通方式与页面价格；如页面没有可用购买/激活入口，请联系客服。旧帮助页的固定价格不是当前通用承诺。',NULL,'开通会员 价格','member',790,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G03',id,'会员能查看所有师傅的号码吗？','只有后台有效会员且当前手机号查看功能开放时，才能在师傅详情按页面授权查看；还需受滚动 24 小时不同师傅数量上限约束。受保护或缺失的号码不会因开通会员而被强行公开。',NULL,'会员 师傅号码 手机号','member',800,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G04',id,'提示额度用完是什么意思？','额度按过去 24 小时查看过的不同师傅计数，同一师傅在窗口内重复查看不再占一个新名额。上限由后台配置，详情页提示的剩余额度和原因是准确信息。',NULL,'额度 24小时 查看手机号','member',810,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G05',id,'已经开通会员，为什么仍不能查看号码？','先核对会员有效期、微信登录和手机号授权，再看师傅详情的具体提示；也可能是后台暂时关闭、额度已满或师傅无有效号码。不要通过其他账号或非平台方式绕过限制。',NULL,'会员 不能查看号码','member',820,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G06',id,'会员和用户充值余额有关联吗？','两者独立。用户充值不会自动开通会员，用户余额当前也不能购买会员；会员资格不等于师傅工钱、用户钱包或订单款项。',NULL,'会员 用户余额 充值','member',830,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\n\n\n-- 2026-09-29：计划任务日志瘦身。\n-- 旧实现每分钟为全部子任务各写一行，即使完全没有业务数据也写入，长期会形成几十万条空成功记录。\n-- 这些记录不是业务流水；失败记录和有实际扫描/处理的记录全部保留。\nDELETE FROM `scheduler_runs`\nWHERE `status`='success'\n  AND `scanned_count`=0\n  AND `success_count`=0\n  AND `failure_count`=0;\n\n-- 2026-09-29：删除当前服务端运行代码没有读写入口的未落地结构。\n-- worker_collection_codes 暂时保留；其与新表的合并属于第三类结构调整，本版按要求不处理。\nSET @v240_has_upload_fk := (\n  SELECT COUNT(*) FROM information_schema.REFERENTIAL_CONSTRAINTS\n  WHERE CONSTRAINT_SCHEMA=DATABASE() AND TABLE_NAME='media_files' AND CONSTRAINT_NAME='fk_media_files_upload_session'\n);\nSET @v240_drop_upload_fk_sql := IF(@v240_has_upload_fk>0,'ALTER TABLE media_files DROP FOREIGN KEY fk_media_files_upload_session','SELECT 1');\nPREPARE v240_cleanup_stmt FROM @v240_drop_upload_fk_sql; EXECUTE v240_cleanup_stmt; DEALLOCATE PREPARE v240_cleanup_stmt;\n\nSET @v240_has_upload_idx := (\n  SELECT COUNT(*) FROM information_schema.STATISTICS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='media_files' AND INDEX_NAME='fk_media_files_upload_session'\n);\nSET @v240_drop_upload_idx_sql := IF(@v240_has_upload_idx>0,'ALTER TABLE media_files DROP INDEX fk_media_files_upload_session','SELECT 1');\nPREPARE v240_cleanup_stmt FROM @v240_drop_upload_idx_sql; EXECUTE v240_cleanup_stmt; DEALLOCATE PREPARE v240_cleanup_stmt;\n\nSET @v240_has_upload_col := (\n  SELECT COUNT(*) FROM information_schema.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='media_files' AND COLUMN_NAME='upload_session_id'\n);\nSET @v240_drop_upload_col_sql := IF(@v240_has_upload_col>0,'ALTER TABLE media_files DROP COLUMN upload_session_id','SELECT 1');\nPREPARE v240_cleanup_stmt FROM @v240_drop_upload_col_sql; EXECUTE v240_cleanup_stmt; DEALLOCATE PREPARE v240_cleanup_stmt;\n\nDROP TABLE IF EXISTS\n  `api_request_logs`,`change_items`,`cloud_sync_attempts`,`commission_adjustments`,\n  `payout_adjustments`,`quote_items`,`reconciliation_records`,`subscription_preferences`,\n  `upload_sessions`,`worker_locations`,`worker_skills`,`worker_cloud_media_imports`;\n\nDELETE FROM `database_field_dictionary`\nWHERE `table_name` IN (\n  'api_request_logs','change_items','cloud_sync_attempts','commission_adjustments',\n  'payout_adjustments','quote_items','reconciliation_records','subscription_preferences',\n  'upload_sessions','worker_locations','worker_skills','worker_cloud_media_imports'\n);\n\nDELETE FROM `database_field_dictionary` WHERE `table_name`='form_fields' AND `field_name`='category_id';\n\n-- 2026-09-29：全部保留表的物理字段补充中文 COMMENT，phpMyAdmin 可直接查看中文说明。\nALTER TABLE `admin_users`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `username` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '登录账号',\n  MODIFY COLUMN `password_hash` varchar(255) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '密码哈希',\n  MODIFY COLUMN `real_name` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '真实姓名',\n  MODIFY COLUMN `role` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'operator' COMMENT '角色',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `must_change_password` tinyint(3) unsigned NOT NULL DEFAULT '1' COMMENT '是否必须修改密码',\n  MODIFY COLUMN `failed_attempts` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '登录失败次数',\n  MODIFY COLUMN `locked_until` datetime DEFAULT NULL COMMENT '锁定截止时间',\n  MODIFY COLUMN `last_login_at` datetime DEFAULT NULL COMMENT '最后登录时间',\n  MODIFY COLUMN `last_login_ip` varchar(45) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '最后登录IP',\n  MODIFY COLUMN `password_changed_at` datetime DEFAULT NULL COMMENT '密码修改时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `after_sales`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '类型',\n  MODIFY COLUMN `description` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '描述',\n  MODIFY COLUMN `warranty_months_snapshot` smallint(5) unsigned DEFAULT NULL COMMENT '保修月数快照',\n  MODIFY COLUMN `warranty_expires_at_snapshot` datetime DEFAULT NULL COMMENT '保修到期时间快照',\n  MODIFY COLUMN `non_human_confirmed` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否确认非人为原因',\n  MODIFY COLUMN `evidence_media_ids_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '证据媒体ID列表JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT '状态',\n  MODIFY COLUMN `handled_by` bigint(20) unsigned DEFAULT NULL COMMENT '处理管理员ID',\n  MODIFY COLUMN `resolution` text COLLATE utf8mb4_unicode_ci COMMENT '处理结果',\n  MODIFY COLUMN `opened_at` datetime NOT NULL COMMENT '开启时间',\n  MODIFY COLUMN `closed_at` datetime DEFAULT NULL COMMENT '关闭时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `appointment_records`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `appointment_at` datetime DEFAULT NULL COMMENT '预约时间',\n  MODIFY COLUMN `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备注',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'recorded' COMMENT '状态',\n  MODIFY COLUMN `context_type` varchar(16) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'service' COMMENT '预约上下文：service施工、repair维修',\n  MODIFY COLUMN `after_sale_id` bigint(20) unsigned DEFAULT NULL COMMENT '维修上下文对应售后记录',\n  MODIFY COLUMN `wait_customer_notice` tinyint(1) NOT NULL DEFAULT '0' COMMENT '1等待客户另行通知',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `assignment_history`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `assignment_id` bigint(20) unsigned NOT NULL COMMENT '派单ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `action` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  MODIFY COLUMN `reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '原因',\n  MODIFY COLUMN `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作者类型',\n  MODIFY COLUMN `actor_id` bigint(20) unsigned DEFAULT NULL COMMENT '操作者ID',\n  MODIFY COLUMN `snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '快照JSON',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `assignments`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `quote_id` bigint(20) unsigned DEFAULT NULL COMMENT '报价ID',\n  MODIFY COLUMN `invite_token_id` bigint(20) unsigned DEFAULT NULL COMMENT '邀请令牌ID',\n  MODIFY COLUMN `assignment_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '派单类型',\n  MODIFY COLUMN `commission_rule_version_id` bigint(20) unsigned NOT NULL COMMENT '服务费规则版本ID',\n  MODIFY COLUMN `final_amount_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '最终金额（分）快照',\n  MODIFY COLUMN `booking_fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '预约费（分）快照',\n  MODIFY COLUMN `commission_rate_bp_snapshot` int(10) unsigned NOT NULL COMMENT '服务费比例（万分比）快照',\n  MODIFY COLUMN `commission_min_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '最低服务费（分）快照',\n  MODIFY COLUMN `estimated_commission_cents` bigint(20) unsigned NOT NULL COMMENT '预计服务费（分）',\n  MODIFY COLUMN `estimated_offline_collect_cents` bigint(20) unsigned NOT NULL COMMENT '预计线下收款（分）',\n  MODIFY COLUMN `estimated_net_income_cents` bigint(20) NOT NULL COMMENT '预计净额收入（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'offered' COMMENT '状态',\n  MODIFY COLUMN `offered_at` datetime NOT NULL COMMENT '报价时间',\n  MODIFY COLUMN `accept_deadline_at` datetime DEFAULT NULL COMMENT '接受截止时间',\n  MODIFY COLUMN `accepted_at` datetime DEFAULT NULL COMMENT '接受时间',\n  MODIFY COLUMN `rejected_at` datetime DEFAULT NULL COMMENT '驳回时间',\n  MODIFY COLUMN `cancelled_at` datetime DEFAULT NULL COMMENT '取消时间',\n  MODIFY COLUMN `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建管理员ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `audit_logs`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '请求ID',\n  MODIFY COLUMN `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作者类型',\n  MODIFY COLUMN `actor_id` bigint(20) unsigned DEFAULT NULL COMMENT '操作者ID',\n  MODIFY COLUMN `actor_name_snapshot` varchar(80) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '操作者名称快照',\n  MODIFY COLUMN `action` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  MODIFY COLUMN `entity_type` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '实体类型',\n  MODIFY COLUMN `entity_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '实体ID',\n  MODIFY COLUMN `before_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '变更前JSON',\n  MODIFY COLUMN `after_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '变更后JSON',\n  MODIFY COLUMN `reason` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '原因',\n  MODIFY COLUMN `ip_address` varchar(45) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT 'IP地址',\n  MODIFY COLUMN `user_agent` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '客户端User-Agent',\n  MODIFY COLUMN `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'success' COMMENT '结果',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `change_confirmations`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `change_request_id` bigint(20) unsigned NOT NULL COMMENT '变更请求ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `decision` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '处理决定',\n  MODIFY COLUMN `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备注',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `change_requests`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `original_amount_cents` bigint(20) unsigned NOT NULL COMMENT '原始金额（分）',\n  MODIFY COLUMN `added_amount_cents` bigint(20) unsigned NOT NULL COMMENT '增加金额（分）',\n  MODIFY COLUMN `new_total_cents` bigint(20) unsigned NOT NULL COMMENT '新总计（分）',\n  MODIFY COLUMN `reason` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原因',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `payment_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '在线加费支付状态；测量单 accepted 后 awaiting_payment/paid/refund_pending/refunded',\n  MODIFY COLUMN `expires_at` datetime DEFAULT NULL COMMENT '到期时间',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `decided_at` datetime DEFAULT NULL COMMENT '决定时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `cloud_identity_mappings`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `wechat_identity_id` bigint(20) unsigned DEFAULT NULL COMMENT '微信身份ID',\n  MODIFY COLUMN `cloud_user_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '云端用户ID',\n  MODIFY COLUMN `cloud_worker_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '云端师傅ID',\n  MODIFY COLUMN `source_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '来源版本',\n  MODIFY COLUMN `source_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '来源摘要',\n  MODIFY COLUMN `sync_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '同步状态',\n  MODIFY COLUMN `last_synced_at` datetime DEFAULT NULL COMMENT '最后同步时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `commission_payments`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `receivable_id` bigint(20) unsigned NOT NULL COMMENT '应收ID',\n  MODIFY COLUMN `payment_order_id` bigint(20) unsigned NOT NULL COMMENT '支付订单ID',\n  MODIFY COLUMN `amount_cents` bigint(20) unsigned NOT NULL COMMENT '金额（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `paid_at` datetime DEFAULT NULL COMMENT '已支付时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `commission_receivables`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `assignment_id` bigint(20) unsigned NOT NULL COMMENT '派单ID',\n  MODIFY COLUMN `commission_rule_version_id` bigint(20) unsigned NOT NULL COMMENT '服务费规则版本ID',\n  MODIFY COLUMN `final_amount_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '最终金额（分）快照',\n  MODIFY COLUMN `booking_fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '预约费（分）快照',\n  MODIFY COLUMN `rate_bp_snapshot` int(10) unsigned NOT NULL COMMENT '比例（万分比）快照',\n  MODIFY COLUMN `min_fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '最低费用（分）快照',\n  MODIFY COLUMN `gross_commission_cents` bigint(20) unsigned NOT NULL COMMENT '总额服务费（分）',\n  MODIFY COLUMN `booking_fee_offset_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '预约费用抵扣（分）',\n  MODIFY COLUMN `amount_due_cents` bigint(20) unsigned NOT NULL COMMENT '金额截止（分）',\n  MODIFY COLUMN `amount_paid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '金额已支付（分）',\n  MODIFY COLUMN `is_provisional` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否暂定',\n  MODIFY COLUMN `finalized_at` datetime DEFAULT NULL COMMENT '定稿时间',\n  MODIFY COLUMN `overpaid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '多付（分）',\n  MODIFY COLUMN `worker_credit_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '师傅入账（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `due_at` datetime DEFAULT NULL COMMENT '截止时间',\n  MODIFY COLUMN `settled_at` datetime DEFAULT NULL COMMENT '结算时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `commission_rule_versions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `version_no` int(10) unsigned NOT NULL COMMENT '版本编号',\n  MODIFY COLUMN `rate_bp` int(10) unsigned NOT NULL DEFAULT '1000' COMMENT '比例（万分比）',\n  MODIFY COLUMN `min_fee_cents` bigint(20) unsigned NOT NULL DEFAULT '5000' COMMENT '最低费用（分）',\n  MODIFY COLUMN `adjustment_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'default' COMMENT '调整类型',\n  MODIFY COLUMN `adjustment_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '调整原因',\n  MODIFY COLUMN `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建管理员ID',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `locked_at` datetime DEFAULT NULL COMMENT '锁定时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `completion_submissions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `description` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '描述',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'submitted' COMMENT '状态',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `accepted_at` datetime DEFAULT NULL COMMENT '接受时间',\n  MODIFY COLUMN `accepted_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '接受类型',\n  MODIFY COLUMN `warranty_months` smallint(5) unsigned DEFAULT NULL COMMENT '保修月数',\n  MODIFY COLUMN `warranty_expires_at` datetime DEFAULT NULL COMMENT '保修到期时间',\n  MODIFY COLUMN `warranty_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '保修备注',\n  MODIFY COLUMN `version` int(10) unsigned NOT NULL DEFAULT '1' COMMENT '版本号',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `database_field_dictionary`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '字典主键',\n  MODIFY COLUMN `table_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '数据表英文名',\n  MODIFY COLUMN `field_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '字段英文名',\n  MODIFY COLUMN `chinese_name` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '字段中文名',\n  MODIFY COLUMN `description` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '业务说明',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `dispute_evidence`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `dispute_id` bigint(20) unsigned NOT NULL COMMENT '争议ID',\n  MODIFY COLUMN `submitted_by_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '提交人类型',\n  MODIFY COLUMN `submitted_by_id` bigint(20) unsigned DEFAULT NULL COMMENT '提交人ID',\n  MODIFY COLUMN `evidence_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '证据类型',\n  MODIFY COLUMN `description` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '描述',\n  MODIFY COLUMN `media_file_id` bigint(20) unsigned DEFAULT NULL COMMENT '媒体文件ID',\n  MODIFY COLUMN `occurred_at` datetime DEFAULT NULL COMMENT '发生时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `disputes`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `raised_by_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '发起人类型',\n  MODIFY COLUMN `raised_by_id` bigint(20) unsigned DEFAULT NULL COMMENT '发起人ID',\n  MODIFY COLUMN `dispute_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '争议类型',\n  MODIFY COLUMN `title` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '标题',\n  MODIFY COLUMN `description` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '描述',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT '状态',\n  MODIFY COLUMN `responsibility` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'undetermined' COMMENT '责任归属',\n  MODIFY COLUMN `resolution` text COLLATE utf8mb4_unicode_ci COMMENT '处理结果',\n  MODIFY COLUMN `refund_amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '退款金额（分）',\n  MODIFY COLUMN `run_empty_fee_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '运行空费用（分）',\n  MODIFY COLUMN `handled_by` bigint(20) unsigned DEFAULT NULL COMMENT '处理管理员ID',\n  MODIFY COLUMN `opened_at` datetime NOT NULL COMMENT '开启时间',\n  MODIFY COLUMN `resolved_at` datetime DEFAULT NULL COMMENT '解决时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `exceptional_arrivals`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `exception_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '异常类型',\n  MODIFY COLUMN `description` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '描述',\n  MODIFY COLUMN `lat` decimal(10,7) DEFAULT NULL COMMENT '纬度',\n  MODIFY COLUMN `lng` decimal(11,7) DEFAULT NULL COMMENT '经度',\n  MODIFY COLUMN `coordinate_system` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'GCJ-02' COMMENT '坐标系',\n  MODIFY COLUMN `evidence_media_ids_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '证据媒体ID列表JSON',\n  MODIFY COLUMN `watermark_metadata_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '水印元数据JSON',\n  MODIFY COLUMN `arrived_at` datetime NOT NULL COMMENT '到场时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `form_fields`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `step_id` bigint(20) unsigned NOT NULL COMMENT '步骤ID',\n  MODIFY COLUMN `field_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '字段键',\n  MODIFY COLUMN `label` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '标签',\n  MODIFY COLUMN `component_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '组件类型',\n  MODIFY COLUMN `data_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'string' COMMENT '数据类型',\n  MODIFY COLUMN `placeholder` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '占位提示',\n  MODIFY COLUMN `help_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '帮助文本',\n  MODIFY COLUMN `is_required` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否必填',\n  MODIFY COLUMN `default_value_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '默认值JSON',\n  MODIFY COLUMN `validation_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '校验JSON',\n  MODIFY COLUMN `ui_config_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '界面配置JSON',\n  MODIFY COLUMN `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `form_options`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `field_id` bigint(20) unsigned NOT NULL COMMENT '字段ID',\n  MODIFY COLUMN `option_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '选项键',\n  MODIFY COLUMN `label` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '标签',\n  MODIFY COLUMN `value_text` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '值文本',\n  MODIFY COLUMN `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  MODIFY COLUMN `is_default` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否默认',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `extra_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '扩展JSON',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `form_rules`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `schema_version_id` bigint(20) unsigned NOT NULL COMMENT '表单版本ID',\n  MODIFY COLUMN `rule_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '规则键',\n  MODIFY COLUMN `name` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '名称',\n  MODIFY COLUMN `trigger_field_id` bigint(20) unsigned NOT NULL COMMENT '触发字段ID',\n  MODIFY COLUMN `operator` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'equals' COMMENT '操作人',\n  MODIFY COLUMN `compare_value_json` longtext COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '比较值JSON',\n  MODIFY COLUMN `action_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作类型',\n  MODIFY COLUMN `target_field_id` bigint(20) unsigned DEFAULT NULL COMMENT '目标字段ID',\n  MODIFY COLUMN `action_payload_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '操作数据JSON',\n  MODIFY COLUMN `priority` int(11) NOT NULL DEFAULT '0' COMMENT '优先级',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `form_schema_versions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `schema_id` bigint(20) unsigned NOT NULL COMMENT '表单ID',\n  MODIFY COLUMN `version_no` int(10) unsigned NOT NULL COMMENT '版本编号',\n  MODIFY COLUMN `snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '快照JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft' COMMENT '状态',\n  MODIFY COLUMN `published_by` bigint(20) unsigned DEFAULT NULL COMMENT '发布人ID',\n  MODIFY COLUMN `published_at` datetime DEFAULT NULL COMMENT '发布时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `form_schemas`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `schema_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '结构键',\n  MODIFY COLUMN `name` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '名称',\n  MODIFY COLUMN `description` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '描述',\n  MODIFY COLUMN `current_version` int(10) unsigned NOT NULL DEFAULT '1' COMMENT '当前版本号',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft' COMMENT '状态',\n  MODIFY COLUMN `created_by` bigint(20) unsigned DEFAULT NULL COMMENT '创建人ID',\n  MODIFY COLUMN `updated_by` bigint(20) unsigned DEFAULT NULL COMMENT '更新人ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `form_steps`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `schema_version_id` bigint(20) unsigned NOT NULL COMMENT '表单版本ID',\n  MODIFY COLUMN `step_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '步骤键',\n  MODIFY COLUMN `title` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '标题',\n  MODIFY COLUMN `description` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '描述',\n  MODIFY COLUMN `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `idempotency_keys`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作者类型',\n  MODIFY COLUMN `actor_id` bigint(20) unsigned NOT NULL COMMENT '操作者ID',\n  MODIFY COLUMN `action` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  MODIFY COLUMN `idempotency_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '幂等键',\n  MODIFY COLUMN `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '请求摘要',\n  MODIFY COLUMN `response_status` int(10) unsigned DEFAULT NULL COMMENT '响应状态',\n  MODIFY COLUMN `response_body` longtext COLLATE utf8mb4_unicode_ci COMMENT '响应请求体',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'processing' COMMENT '状态',\n  MODIFY COLUMN `expires_at` datetime NOT NULL COMMENT '到期时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `completed_at` datetime DEFAULT NULL COMMENT '完成时间';\nALTER TABLE `invite_tokens`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `token_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '令牌摘要',\n  MODIFY COLUMN `purpose` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'worker_assignment' COMMENT '用途',\n  MODIFY COLUMN `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建管理员ID',\n  MODIFY COLUMN `claimed_by_user_id` bigint(20) unsigned DEFAULT