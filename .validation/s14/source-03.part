OLLATE utf8mb4_unicode_ci COMMENT '最后错误',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `processed_at` datetime DEFAULT NULL COMMENT '已处理时间';\nALTER TABLE `notifications`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `recipient_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '接收人类型',\n  MODIFY COLUMN `recipient_id` bigint(20) unsigned NOT NULL COMMENT '接收人ID',\n  MODIFY COLUMN `channel` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'in_app' COMMENT '渠道',\n  MODIFY COLUMN `template_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '模板键',\n  MODIFY COLUMN `title` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '标题',\n  MODIFY COLUMN `content` varchar(2000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '内容',\n  MODIFY COLUMN `data_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '数据JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `scheduled_at` datetime DEFAULT NULL COMMENT '计划任务时间',\n  MODIFY COLUMN `sent_at` datetime DEFAULT NULL COMMENT '发送时间',\n  MODIFY COLUMN `read_at` datetime DEFAULT NULL COMMENT '阅读时间',\n  MODIFY COLUMN `failure_message` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '失败信息',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `offline_collection_adjustment_requests`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `assignment_id` bigint(20) unsigned NOT NULL COMMENT '派单ID',\n  MODIFY COLUMN `original_total_cents` bigint(20) unsigned NOT NULL COMMENT '原始总计（分）',\n  MODIFY COLUMN `original_tail_cents` bigint(20) unsigned NOT NULL COMMENT '原始尾款（分）',\n  MODIFY COLUMN `requested_total_cents` bigint(20) unsigned NOT NULL COMMENT '申请总计（分）',\n  MODIFY COLUMN `requested_tail_cents` bigint(20) unsigned NOT NULL COMMENT '申请尾款（分）',\n  MODIFY COLUMN `reason` varchar(500) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原因',\n  MODIFY COLUMN `receipt_media_ids_json` longtext COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '回执媒体ID列表JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'auto_approved' COMMENT '状态',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `review_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核备注',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `offline_payment_delay_requests`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `amount_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '金额（分）快照',\n  MODIFY COLUMN `reason` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原因',\n  MODIFY COLUMN `expected_collect_at` datetime DEFAULT NULL COMMENT '期望收款时间',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'reported' COMMENT '状态',\n  MODIFY COLUMN `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  MODIFY COLUMN `review_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核备注',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_addresses`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `province` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '省份',\n  MODIFY COLUMN `city` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '城市',\n  MODIFY COLUMN `district` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '区县',\n  MODIFY COLUMN `address_summary` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '地址摘要',\n  MODIFY COLUMN `address_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '地址密文',\n  MODIFY COLUMN `address_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '地址HMAC摘要',\n  MODIFY COLUMN `contact_name_masked` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '联系人名称脱敏值',\n  MODIFY COLUMN `contact_name_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '联系人名称密文',\n  MODIFY COLUMN `contact_mobile_masked` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '联系人手机号脱敏值',\n  MODIFY COLUMN `contact_mobile_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '联系人手机号密文',\n  MODIFY COLUMN `contact_mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '联系人手机号HMAC摘要',\n  MODIFY COLUMN `lat` decimal(10,7) DEFAULT NULL COMMENT '纬度',\n  MODIFY COLUMN `lng` decimal(11,7) DEFAULT NULL COMMENT '经度',\n  MODIFY COLUMN `coordinate_system` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'GCJ-02' COMMENT '坐标系',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `order_answers`\n  