LT '' COMMENT '原因代码',\n  MODIFY COLUMN `ip_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT 'IPHMAC摘要',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `worker_profiles`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `display_name` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '显示名称',\n  MODIFY COLUMN `mobile_masked` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '手机号脱敏值',\n  MODIFY COLUMN `mobile_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '手机号密文',\n  MODIFY COLUMN `mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '手机号HMAC摘要',\n  MODIFY COLUMN `verification_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '认证状态',\n  MODIFY COLUMN `invited_only` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否仅邀请',\n  MODIFY COLUMN `city` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '城市',\n  MODIFY COLUMN `district` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '区县',\n  MODIFY COLUMN `address_masked` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '地址脱敏值',\n  MODIFY COLUMN `address_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '地址密文',\n  MODIFY COLUMN `lat` decimal(10,7) DEFAULT NULL COMMENT '纬度',\n  MODIFY COLUMN `lng` decimal(11,7) DEFAULT NULL COMMENT '经度',\n  MODIFY COLUMN `coordinate_system` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'GCJ-02' COMMENT '坐标系',\n  MODIFY COLUMN `rating` decimal(3,2) unsigned NOT NULL DEFAULT '5.00' COMMENT '评价',\n  MODIFY COLUMN `completed_orders` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '已完成订单数',\n  MODIFY COLUMN `profile_json` longtext COLLATE utf8mb