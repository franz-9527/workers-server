ascii COLLATE ascii_bin DEFAULT NULL COMMENT '执行主机',\n  MODIFY COLUMN `process_id` int(10) unsigned DEFAULT NULL COMMENT '进程ID',\n  MODIFY COLUMN `scanned_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '扫描数量',\n  MODIFY COLUMN `success_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '成功数量',\n  MODIFY COLUMN `failure_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '失败数量',\n  MODIFY COLUMN `started_at` datetime NOT NULL COMMENT '开始时间',\n  MODIFY COLUMN `finished_at` datetime DEFAULT NULL COMMENT '结束时间',\n  MODIFY COLUMN `error_message` text COLLATE utf8mb4_unicode_ci COMMENT '错误信息',\n  ENGINE=InnoDB;\nALTER TABLE `schema_migrations`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `version` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '版本号',\n  MODIFY COLUMN `migration_name` varchar(190) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '迁移名称',\n  MODIFY COLUMN `checksum_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'SHA-256校验值',\n  MODIFY COLUMN `execution_ms` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '执行耗时（毫秒）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'success' COMMENT '状态',\n  MODIFY COLUMN `error_message` text COLLATE utf8mb4_unicode_ci COMMENT '错误信息',\n  MODIFY COLUMN `applied_by` bigint(20) unsigned DEFAULT NULL COMMENT '执行人ID',\n  MODIFY COLUMN `applied_at` datetime NOT NULL COMMENT '执行时间';\nALTER TABLE `service_categories`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `parent_id` bigint(20) unsigned DEFAULT NULL COMMENT '父级ID',\n  MODIFY COLUMN `category_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '类目键',\n  MODIFY COLUMN `order_code` varchar(8) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'QT' COMMENT '订单代码',\n  MODIFY COLUMN `name` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '名称',\n  MODIFY COLUM