TE ascii_bin NOT NULL DEFAULT 'private_local' COMMENT '存储磁盘',\n  MODIFY COLUMN `storage_key` varchar(500) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '存储键',\n  MODIFY COLUMN `mime_type` varchar(100) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'MIME类型',\n  MODIFY COLUMN `extension` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '扩展名',\n  MODIFY COLUMN `size_bytes` bigint(20) unsigned NOT NULL COMMENT '文件大小（字节）',\n  MODIFY COLUMN `width_px` int(10) unsigned DEFAULT NULL COMMENT '宽度像素',\n  MODIFY COLUMN `height_px` int(10) unsigned DEFAULT NULL COMMENT '高度像素',\n  MODIFY COLUMN `sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'SHA-256摘要',\n  MODIFY COLUMN `compression_quality` int(10) unsigned DEFAULT NULL COMMENT '压缩质量',\n  MODIFY COLUMN `metadata_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '元数据JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `reference_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '引用数量',\n  MODIFY COLUMN `pending_delete_at` datetime DEFAULT NULL COMMENT '待删除时间',\n  MODIFY COLUMN `deleted_at` datetime DEFAULT NULL COMMENT '删除时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `media_links`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `media_file_id` bigint(20) unsigned NOT NULL COMMENT '媒体文件ID',\n  MODIFY COLUMN `entity_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '实体类型',\n  MODIFY COLUMN `entity_id` bigint(20) unsigned NOT NULL COMMENT '实体ID',\n  MODIFY COLUMN `purpose` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '用途',\n  MODIFY COLUMN `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  MODIFY COLUMN `created_by_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '创建操作人类型',\n  MODIFY COLUMN `created_by_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建操作人ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `merchant_profiles`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `business_name` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '业务名称',\n  MODIFY COLUMN `legal_representative` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '法人代表',\n  MODIFY COLUMN `credit_code_masked` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT '入账代码脱敏值',\n  MODIFY COLUMN `credit_code_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '入账代码密文',\n  MODIFY COLUMN `credit_code_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '入账代码HMAC摘要',\n  MODIFY COLUMN `business_scope` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '业务范围',\n  MODIFY COLUMN `business_address` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '业务地址',\n  MODIFY COLUMN `materials_description` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '材料描述',\n  MODIFY COLUMN `license_media_file_id` bigint(20) unsigned DEFAULT NULL COMMENT '营业执照媒体文件ID',\n  MODIFY COLUMN `verification_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'none' COMMENT '认证状态',\n  MODIFY COLUMN `recognition_level` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'consumer' COMMENT '识别等级',\n  MODIFY COLUMN `risk_score` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '风险评分',\n  MODIFY COLUMN `order_count_7d` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '近7天订单数',\n  MODIFY COLUMN `same_phone_warning_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '相同电话警告数量',\n  MODIFY COLUMN `review_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核原因'