量',\n  MODIFY COLUMN `next_receipt_check_at` datetime DEFAULT NULL COMMENT '下次回执检查时间',\n  MODIFY COLUMN `receipt_deadline_at` datetime DEFAULT NULL COMMENT '回执截止时间',\n  MODIFY COLUMN `attempted_at` datetime DEFAULT NULL COMMENT '尝试时间',\n  MODIFY COLUMN `provider_accepted_at` datetime DEFAULT NULL COMMENT '服务商接受时间',\n  MODIFY COLUMN `delivered_at` datetime DEFAULT NULL COMMENT '送达时间',\n  MODIFY COLUMN `failed_at` datetime DEFAULT NULL COMMENT '失败时间',\n  MODIFY COLUMN `charged_at` datetime DEFAULT NULL COMMENT '扣费时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `orders`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `form_schema_version_id` bigint(20) unsigned DEFAULT NULL COMMENT '表单结构版本ID',\n  MODIFY COLUMN `workflow_profile` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'construction' COMMENT '订单工作流：construction施工、measurement测量',\n  MODIFY COLUMN `dispatch_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'multi_quote' COMMENT '施工接单方式：multi_quote多师傅报价、single_grab单师傅抢单',\n  MODIFY COLUMN `expected_fee_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '期望费用计价方式：total总价金额、unit单价文本',\n  MODIFY COLUMN `expected_fee_cents` bigint(20) unsigned DEFAULT NULL COMMENT '用户下单期望总价金额（分）；仅total使用并可在single_grab中直接成交',\n  MODIFY COLUMN `expected_fee_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '用户填写的期望单价说明文本；仅unit使用，不参与金额计算',\n  MODIFY COLUMN `pending_measurement_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '待正式关联的来源测量订单；草稿/待付款阶段不占一对一资格',\n  MODIFY COLUMN `category_id` bigint(20) unsigned DEFAULT NULL COMMENT '类目ID',\n  MODIFY COLUMN `category_name_snapshot` varchar(