_required'=>['请补充订单资料',['user'],'order_status','order_audit'],\n            'order_supplemented'=>['用户已补充订单资料',['admin'],'order_status',''],\n            'order_rejected'=>['订单审核未通过',['user'],'order_status','order_audit'],\n            'worker_quoted'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'worker_quote_updated'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'platform_quoted'=>['收到新报价',['user'],'quote_received','quote_received'],\n            'quote_selected_pending_payment'=>['已选报价，待支付预约费',['user'],'order_status','payment_pending'],\n            'payment_reservation_released'=>['支付超时，订单恢复报价',['user'],'order_status',''],\n            'booking_fee_paid'=>['预约费支付成功',['user'],'payment_success','payment_success'],\n            'booking_fee_paid_upfront'=>['预约费支付成功',['user'],'payment_success','payment_success'],\n            'worker_assigned'=>['已安排施工师傅',['worker','user'],'order_status','worker_assigned'],\n            'assignment_accepted'=>['师傅已接单',['user'],'order_status','worker_assigned'],\n            'assignment_rejected'=>['师傅已拒绝派单',['user','admin'],'order_status','user_order_update'],\n            'assignment_expired'=>['派单超时已释放',['user','worker','admin'],'order_status','user_order_update'],\n            'appointment_recorded'=>['已预约上门',['user'],'order_status',''],\n            'appointment_waiting_customer_notice'=>['师傅已联系，请确认预约',['user'],'order_status',''],\n            'change_requested'=>['费用调整待确认',['user'],'order_status','fee_adjustment'],\n            'change_accepted'=>['费用调整已同意',['worker'],'order_status','worker_order_update'],\n            'change_rejected'=>['费用调整未同意',['worker'],'order_status','worker_order_update'],\n            'completion_submitted'=>['完工待验收',['user'],'order_status','completion_submitted'],\n            'completion_accepted_by_user'=>['用户已验收',['worker'],'order_status',''],\n            'auto_completion_accepted'=>['订单已自动验收',['user'],'order_status',''],\n            'auto_accepted_72h'=>['订单已自动验收',['user'],'order_status',''],\n            'auto_reviewed_5d'=>['订单收到自动好评',['worker'],'order_status',''],\n            'warranty_repair_requested'=>['用户已提交维修申请，请及时联系处理',['worker'],'order_status','worker_repair'],\n            'warranty_repair_withdrawn'=>['用户已撤回维修申请',['worker'],'order_status',''],\n            'repair_worker_rejected'=>['师傅已拒绝维修，可申请平台介入',['user'],'order_status','repair_progress'],\n            'repair_worker_completed'=>['维修已完成',['user'],'order_status',''],\n            'repair_intervention_available'=>['维修超过48小时仍未完成，可申请平台介入',['user'],'order_status','repair_progress'],\n            'repair_platform_intervention_requested'=>['用户已申请平台介入维修',['worker'],'order_status','worker_order_update'],\n            'repair_platform_continue'=>['平台要求继续维修',['user','worker'],'order_status','repair_progress'],\n            'repair_platform_resolved'=>['平台确认售后问题已解决',['user','worker'],'order_status','repair_progress'],\n            'repair_platform_closed'=>['平台已关闭本次售后',['user','worker'],'order_status','repair_progress'],\n            'repair_appointment_recorded'=>['师傅已登记维修预约',['user'],'order_status','repair_progress'],\n            'repair_waiting_customer_notice'=>['师傅已联系，请确认维修预约',['user'],'order_status',''],\n            'worker_replaced_by_user'=>['订单已更换成交师傅',['worker','user'],'order_status',''],\n            'supplement_deadline_reminder'=>['补资料期限即将到期',['user'],'order_status','supplement_reminder'],\n            'supplement_timeout_refunded'=>['补资料超时已取消，退款处理中',['user','admin'],'order_status','refund_result'],\n            'commission_estimate_created'=>['预计服务费已生成',['worker'],'order_status',''],\n            'commission_receivable_finalized'=>['平台服务费已正式生成',['worker'],'order_status',''],\n            'exceptional_arrival_reported'=>['师傅已登记到场异常',['admin'],'order_status',''],\n            'offline_collection_delayed'=>['师傅已登记尾款延期',['admin'],'order_status',''],\n            'offline_collection_bad_debt'=>['线下尾款已标记坏账',['worker'],'order_status',''],\n            'cancel_requested'=>['订单申请退款',['user','worker','admin'],'order_status','worker_order_update'],\n            'cancel_approved'=>['取消退款已通过',['user','worker'],'order_status','refund_result'],\n            'admin_cancelled'=>['平台已取消订单',['user','worker'],'order_status','user_order_update'],\n            'cancel_rejected'=>['取消退款未通过',['user','worker'],'order_status','refund_result'],\n            'auto_cancelled_7d'=>['订单超期自动取消',['user','admin'],'order_status',''],\n            'refund_succeeded'=>['预约费退款成功',['user'],'order_status','refund_result'],\n            'worker_contact_reveal_approved'=>['师傅电话公开申请已批准',['user','worker'],'order_status','user_order_update'],\n            'worker_contact_reveal_rejected'=>['师傅电话公开申请未批准',['user'],'order_status','user_order_update'],\n            'worker_contact_reveal_cancelled'=>['师傅电话公开申请已取消',['user'],'order_status',''],\n            'offline_collection_adjustment_requested'=>['实际尾款待审批',['admin'],'order_status',''],\n            'offline_collection_adjustment_approved'=>['实际尾款已核准',['worker'],'order_status',''],\n            'offline_collection_adjustment_rejected'=>['实际尾款未核准',['worker'],'order_status',''],\n            'commission_receivable_created'=>['平台服务费待缴',['worker'],'order_status','worker_commission_due'],\n            'commission_paid'=>['平台服务费已结清',['worker'],'order_status',''],\n            'dispute_opened'=>['订单进入争议处理',['user','worker','admin'],'order_status','worker_order_update'],\n            'dispute_resolved'=>['订单争议已处理',['user','worker'],'order_status','dispute_progress'],\n            'review_submitted'=>['订单收到用户评价',['worker'],'order_status',''],\n            'run_empty_claim_submitted'=>['商家跑空费待确认',['user'],'order_status','user_order_update'],\n            'run_empty_claim_confirmed'=>['商家已确认跑空费',['worker'],'order_status','worker_order_update'],\n            'run_empty_claim_disputed'=>['跑空费进入争议处理',['user','worker','admin'],'order_status','user_order_update'],\n            'run_empty_fee_paid'=>['商家跑空费已支付',['worker'],'order_status',''],\n            'measurement_service_paid'=>['测量服务费支付成功',['user','worker'],'order_status',''],\n            'measurement_change_paid'=>['测量加费支付成功',['user','worker'],'order_status',''],\n            'measurement_change_accepted_pending_payment'=>['测量加费待付款',['user'],'order_status','payment_pending'],\n            'measurement_result_submitted'=>['测量成果待确认',['user'],'order_status','measurement_result'],\n            'measurement_rework_requested'=>['用户申请补测',['worker'],'order_status','worker_rework'],\n            'measurement_result_accepted'=>['测量成果已确认',['user','worker'],'order_status',''],\n            'measurement_auto_accepted'=>['测量成果已自动确认',['user','worker'],'order_status',''],\n            'measurement_hold_extension_approved'=>['测量冻结延期已通过',['user'],'order_status','measurement_extension'],\n            'measurement_hold_extension_rejected'=>['测量冻结延期未通过',['user'],'order_status','measurement_extension'],\n            'measurement_income_released'=>['测量费用已结算',['worker'],'order_status',''],\n            'measurement_construction_linked'=>['测量单已关联施工单',['user','worker'],'order_status',''],\n            'measurement_change_refund_created'=>['测量加费退款处理中',['user'],'order_status','user_order_update'],\n            'measurement_change_refunded'=>['测量加费退款成功',['user'],'order_status',''],\n            'measurement_late_balance_refund_created'=>['测量尾款退款处理中',['user'],'order_status','user_order_update'],\n            'measurement_late_balance_refunded'=>['测量尾款退款成功',['user'],'order_status',''],\n        ];\n        $smsRecommended = array_flip([\n            'order_supplement_required','worker_quoted','platform_quoted','change_requested',\n            'completion_submitted','measurement_result_submitted','measurement_rework_requested',\n            'warranty_repair_requested','repair_worker_rejected','supplement_deadline_reminder',\n            'commission_receivable_created','run_empty_claim_submitted',\n        ]);\n        $internalOnly = array_flip([\n            'booking_fee_paid','booking_fee_paid_upfront','measurement_service_paid','measurement_change_paid',\n            'completion_accepted_by_user','commission_estimate_created','commission_paid',\n            'repair_worker_completed','review_submitted','auto_reviewed_5d',\n            'measurement_result_accepted','measurement_auto_accepted','measurement_income_released',\n            'measurement_construction_linked','worker_contact_reveal_cancelled',\n        ]);\n        $wecomDefaults = array_flip([\n            'order_submitted','order_supplemented','assignment_rejected','assignment_expired','exceptional_arrival_reported','offline_collection_delayed','cancel_requested','auto_cancelled_7d',\n            'offline_collection_adjustment_requested','dispute_opened','run_empty_claim_disputed','worker_profile_submitted','worker_realname_submitted','merchant_auth_submitted','commission_overdue',\n            'withdrawal_submitted','worker_contact_reveal_requested','measurement_hold_extension_requested','completion_dispute_opened','repair_platform_intervention_requested','supplement_timeout_refunded',\n        ]);\n        $wecomNormalVisible = array_flip(['order_auto_preapproved','offline_collection_adjustment_auto_approved','worker_collection_code_auto_approved']);\n        $explicitWecom = array_flip(['worker_profile_submitted','worker_realname_submitted','worker_collection_code_submitted','worker_collection_code_auto_approved','merchant_auth_submitted','commission_overdue','withdrawal_submitted','worker_contact_reveal_requested','measurement_hold_extension_requested','completion_dispute_opened','repair_platform_intervention_requested','order_auto_preapproved','offline_collection_adjustment_auto_approved']);\n\n        $catalog = [];\n        foreach ($labels as $key => $label) {\n            $definition = $definitions[$key] ?? null;\n            $recipients = $definition ? $definition[1] : [];\n            $audienceLabel = in_array('user',$recipients,true) && in_array('worker',$recipients,true) ? '用户、师傅' : (in_array('worker',$recipients,true) ? '师傅' : (in_array('user',$recipients,true) ? '用户' : '管理员'));\n            $catalog[$key] = [\n                'key'=>$key,\n                'label'=>$label,\n                'priority'=>isset($normal[$key]) ? 'normal' : 'important',\n                'audience_label'=>$audienceLabel,\n                'status'=>$definition ? $definition[0] : '',\n                'recipients'=>$recipients,\n                'scene'=>$definition ? $definition[2] : '',\n                'subscription_scene'=>$definition ? $definition[3] : '',\n                'inapp_visible'=>$definition && (in_array('user',$recipients,true) || in_array('worker',$recipients,true)),\n                'internal_only'=>isset($internalOnly[$key]),\n                'sms_visible'=>$definition && (in_array('user',$recipients,true) || in_array('worker',$recipients,true)) && !isset($internalOnly[$key]),\n                'sms_default'=>isset($smsRecommended[$key]),\n                'sms_recommended'=>isset($smsRecommended[$key]),\n                'sms_delivery_mode'=>(!isset($smsRecommended[$key]) && $definition && trim((string)$definition[3])!=='')?'subscription_fallback':'independent',\n                'sms_subscription_fallback'=>!isset($smsRecommended[$key]) && $definition && trim((string)$definition[3])!=='',\n                'sms_priority'=>isset($smsRecommended[$key])?'important':'normal',\n                'wecom_visible'=>isset($explicitWecom[$key]) || in_array('admin',$recipients,true) || isset($wecomNormalVisible[$key]),\n                'wecom_default'=>isset($wecomDefaults[$key]),\n            ];\n        }\n\n        return $catalog += \\WorkerAdmin\\Domain\\Messaging\\OrderProgressMessageCatalog::all();\n    }\n\n    public static function get(string $eventType): ?array\n    {\n        $all = self::all();\n        return $all[$eventType] ?? null;\n    }\n\n    public static function switches(string $channel, array $configured): array\n    {\n        $all = self::all();\n        $visibleKey = $channel === 'wecom' ? 'wecom_visible' : ($channel === 'inapp' ? 'inapp_visible' : 'sms_visible');\n        $result = [];\n\n        foreach ($all as $eventKey => $meta) {\n            if (empty($meta[$visibleKey])) continue;\n            $saved = $configured[$eventKey] ?? null;\n            $enabled = $saved === null ? $channel === 'inapp' : filter_var(is_array($saved) ? ($saved['enabled'] ?? false) : $saved, FILTER_VALIDATE_BOOLEAN);\n            $extra = is_array($saved) ? $saved : [];\n            $extra['enabled'] = $enabled;\n            $extra['priority'] = (string) ($channel==='sms'?($meta['sms_priority']??'normal'):$meta['priority']);\n            $result[$eventKey] = $extra;\n        }\n        foreach ($configured as $eventKey => $saved) {\n            if (isset($result[$eventKey]) || isset($all[$eventKey])) continue;\n            $extra = is_array($saved) ? $saved : [];\n            $extra['enabled'] = filter_var(is_array($saved) ? ($saved['enabled'] ?? false) : $saved, FILTER_VALIDATE_BOOLEAN);\n            $extra['priority'] = isset($extra['priority']) && $extra['priority'] === 'normal' ? 'normal' : 'important';\n            $result[(string)$eventKey] = $extra;\n        }\n\n        return $result;\n    }\n\n    public static function enabled(string $channel, string $eventType, array $configured): bool\n    {\n        $switches = self::switches($channel, $configured);\n        return isset($switches[$eventType]) && !empty($switches[$eventType]['enabled']);\n    }\n}\n","server/app/Infrastructure/Safety/TestingEnvironmentPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Safety;\n\nuse RuntimeException;\n\n/**\n * 测试环境外部副作用统一安全边界。\n * 是否处于 testing 只由 config/installed.php 的 app.env 决定；可调参数来自后台 system_settings。\n */\nfinal class TestingEnvironmentPolicy\n{\n    public static function active(): bool\n    {\n        return strtolower(trim((string) \\app_config('app.env', 'production'))) === 'testing';\n    }\n\n    public static function qiniuUploadPrefix(string $configuredPrefix): string\n    {\n        $configuredPrefix=trim($configuredPrefix,'/');\n        if (!self::active()) return $configuredPrefix;\n        $prefix = trim((string) \\setting('testing.qiniu_path_prefix', 'test'), '/');\n        if ($prefix === '' || preg_match('#^[A-Za-z0-9._-]{1,40}$#', $prefix) !== 1 || strpos($prefix, '..') !== false) {\n            throw new RuntimeException('测试环境七牛根目录配置无效。');\n        }\n        if($configuredPrefix!==''&&strcasecmp($prefix,$configuredPrefix)===0){\n            throw new RuntimeException('测试环境七牛根目录不能与正式根目录相同。');\n        }\n        return $prefix;\n    }\n\n    public static function assertQiniuDeleteAllowed(string $key): void\n    {\n        if (!self::active()) return;\n        $prefix = self::qiniuUploadPrefix((string)\\setting('qiniu.path_prefix','upload'));\n        $normalized = ltrim(trim($key), '/');\n        if ($normalized === '' || strpos($normalized, $prefix . '/') !== 0) {\n            throw new RuntimeException('测试环境禁止删除非测试目录的七牛对象：仅允许 ' . $prefix . '/ 下的对象。');\n        }\n    }\n\n    public static function paymentEnabled(bool $configuredEnabled): bool\n    {\n        return self::active() ? false : $configuredEnabled;\n    }\n\n    public static function assertPaymentAllowed(string $operation, string $outTradeNo = '', string $outRefundNo = ''): void\n    {\n        if (self::active()) throw new RuntimeException('测试环境禁止真实微信支付、退款、查单和支付回调入账。');\n    }\n\n    public static function assertSmsRecipientAllowed(string $mobile): void\n    {\n        if (!self::active()) return;\n        if (!self::boolSetting('testing.sms_enabled', false)) {\n            throw new RuntimeException('测试环境真实短信总开关未开启。');\n        }\n        $mobile = preg_replace('/\\D+/', '', $mobile) ?? '';\n        $allowed = self::stringList('testing.allowed_sms_mobiles');\n        if ($mobile === '' || !in_array($mobile, $allowed, true)) {\n            throw new RuntimeException('测试环境禁止向非白名单手机号发送真实短信。');\n        }\n    }\n\n    public static function assertWechatRecipientAllowed(string $openid): void\n    {\n        if (!self::active()) return;\n        if (!self::boolSetting('testing.subscribe_enabled', false)) {\n            throw new RuntimeException('测试环境微信订阅消息总开关未开启。');\n        }\n        $openid = trim($openid);\n        $allowed = self::stringList('testing.allowed_wechat_openids');\n        if ($openid === '' || !in_array($openid, $allowed, true)) {\n            throw new RuntimeException('测试环境禁止向非白名单 OpenID 发送真实微信订阅消息。');\n        }\n    }\n\n    public static function adminAlertContent(string $content): string\n    {\n        if (!self::active()) return $content;\n        if (!self::boolSetting('testing.allow_wecom', false)) {\n            throw new RuntimeException('测试环境默认禁止企业微信机器人通知。');\n        }\n        return strpos($content, '【测试环境】') === 0 ? $content : \"【测试环境】\\n\" . $content;\n    }\n\n    public static function assertWechatAccountWriteAllowed(): void\n    {\n        if (self::active() && !self::boolSetting('testing.allow_wechat_account_writes', false)) {\n            throw new RuntimeException('测试环境默认禁止修改正式小程序的订阅模板配置。');\n        }\n    }\n\n    public static function assertCloudActionAllowed(string $action): void\n    {\n        if (!self::active()) return;\n        if (self::boolSetting('testing.allow_cloud_writes', false)) return;\n        $readOnly = [\n            'admin.health','admin.list','admin.detail','server.owner.get','server.nearbyMarkedWorkers',\n            'server.phoneSearchIds','server.phoneReveal','server.membershipStatus','server.publicWorkerSearch',\n        ];\n        if (!in_array($action, $readOnly, true)) {\n            throw new RuntimeException('测试环境禁止写入正式微信云开发环境：' . $action);\n        }\n    }\n\n    private static function boolSetting(string $key, bool $default): bool\n    {\n        return filter_var(\\setting($key, $default ? '1' : '0'), FILTER_VALIDATE_BOOLEAN);\n    }\n\n    private static function stringList(string $settingKey): array\n    {\n        $value = \\setting($settingKey, '');\n        if (is_string($value)) $value = preg_split('/[\\s,;]+/', $value) ?: [];\n        if (!is_array($value)) return [];\n        $rows = [];\n        foreach ($value as $item) {\n            $item = trim((string) $item);\n            if ($item !== '') $rows[] = $item;\n        }\n        return array_values(array_unique($rows));\n    }\n}\n","server/app/Contracts/AdminWorkbenchOperationsRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface AdminWorkbenchOperationsRepository\n{\n    /** @return array<string,mixed> */\n    public function reassignWorker(array $actor, string $orderNo, int $workerId, string $reason): array;\n\n    /** @return array<string,mixed> */\n    public function interveneRepair(array $actor, string $orderNo, string $afterSaleNo, string $reason): array;\n\n    /** @return array<string,mixed> */\n    public function retryPlatformAutoPublish(array $actor, string $orderNo, string $sourceId): array;\n\n    /** @return array<string,mixed> */\n    public function addInternalFollowup(array $actor, string $orderNo, string $note, ?string $followUpAt): array;\n\n    /** @return array<string,mixed> */\n    public function completeInternalFollowup(array $actor, string $orderNo, int $followupEventId, string $note): array;\n\n    /** @return array<int,array<string,mixed>> */\n    public function workerOptions(string $orderNo, string $keyword, int $limit): array;\n\n    /** @return array<int,array<string,mixed>> */\n    public function internalFollowups(string $orderNo, int $limit): array;\n}\n","server/app/Domain/Order/NegotiationPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\n\n// 2026-10-08：各类异常共用升级规则；拒绝和超时只开放申请，不自动生成平台待办。\nfinal class NegotiationPolicy\n{\n    public const WAIT_HOURS = 48;\n\n    public static function evaluate(string $status, ?string $openedAt, string $timezone = 'UTC', ?DateTimeImmutable $now = null): array\n    {\n        $result = ['eligible'=>false,'reason'=>'not_active','available_at'=>null,'wait_hours'=>self::WAIT_HOURS];\n        if ($status === 'rejected') return array_merge($result, ['eligible'=>true,'reason'=>'counterparty_rejected']);\n        if (!in_array($status, ['pending','accepted_processing'], true) || !$openedAt) return $result;\n        try {\n            $zone = new DateTimeZone($timezone ?: 'UTC');\n            $available = (new DateTimeImmutable($openedAt, $zone))->modify('+'.self::WAIT_HOURS.' hours');\n            $result['available_at'] = $available->format('Y-m-d H:i:s');\n            $result['eligible'] = ($now ?: new DateTimeImmutable('now', $zone)) >= $available;\n            $result['reason'] = $result['eligible'] ? 'response_timeout' : 'waiting_counterparty';\n        } catch (Throwable $exception) {\n            $result['reason'] = 'invalid_deadline';\n        }\n        return $result;\n    }\n\n    public static function refundStatus(string $reasonCode): string\n    {\n        return ['bilateral_refund_pending'=>'pending','bilateral_refund_rejected'=>'rejected',\n            'bilateral_refund_escalated'=>'escalated','bilateral_refund_execution_required'=>'escalated'][$reasonCode] ?? '';\n    }\n\n    public static function disputeStatus(?string $resolution): string\n    {\n        return strpos((string)$resolution, '师傅拒绝异议') === 0 ? 'rejected' : 'pending';\n    }\n}\n","server/app/Domain/Order/FulfillmentActor.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/** 领域事件的真实经办来源；协助字段只由已鉴权且重验指派的管理员用例构造。 */\nfinal class FulfillmentActor\n{\n    public static function assisted(array $actor): bool\n    {\n        return (int)($actor['user_id'] ?? 0)>0 && (int)($actor['worker_id'] ?? 0)>0\n            && (int)($actor['assistance_operator_id'] ?? 0)===(int)$actor['user_id']\n            && trim((string)($actor['assistance_assignment_id'] ?? ''))!=='';\n    }\n\n    public static function type(array $actor): string { return self::assisted($actor) ? 'mini_admin' : 'worker'; }\n    public static function id(array $actor): int { return (int)($actor[self::assisted($actor) ? 'user_id' : 'worker_id'] ?? 0); }\n\n    public static function metadata(array $actor): array\n    {\n        return !self::assisted($actor) ? [] : [\n            'assisted'=>true,'operator_channel'=>'mini_admin','operator_user_id'=>(int)$actor['user_id'],\n            'worker_id'=>(int)$actor['worker_id'],'assignment_id'=>(string)$actor['assistance_assignment_id'],\n            'occurred_at'=>(string)($actor['assistance_occurred_at'] ?? ''),\n        ];\n    }\n}\n","server/app/Infrastructure/Persistence/OrderFormMediaRules.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\n\n/**\n * order_submit 图片字段的统一规则读取与就绪判断。\n * 普通下单 finalize、图片上传与平台承接单发布必须使用同一字段映射。\n */\nfinal class OrderFormMediaRules\n{\n    /** @return array{active:bool,min:int,max:int,label:string} */\n    public static function rule(Database $db,int $schemaVersionId,string $purpose):array\n    {\n        $keys=['product'=>'material_images','wall'=>'wall_images'];\n        if($schemaVersionId<1||!isset($keys[$purpose]))return ['active'=>false,'min'=>0,'max'=>20,'label'=>'图片'];\n        $row=$db->fetch(\n            \"SELECT f.label,f.component_type,f.is_required,f.validation_json\n             FROM form_fields f\n             JOIN form_steps s ON s.id=f.step_id\n             WHERE s.schema_version_id=:version AND s.status='active' AND f.status='active' AND BINARY f.field_key=BINARY :field\n             LIMIT 1\",\n            ['version'=>$schemaVersionId,'field'=>$keys[$purpose]]\n        );\n        if(!$row||!in_array((string)$row['component_type'],['image','image_upload'],true)){\n            return ['active'=>false,'min'=>0,'max'=>20,'label'=>$purpose==='product'?'商品/材料图片':'现场环境/墙面图片'];\n        }\n        $validation=[];\n        if(is_string($row['validation_json']??null)&&$row['validation_json']!==''){\n            $decoded=json_decode((string)$row['validation_json'],true);\n            if(is_array($decoded))$validation=$decoded;\n        }\n        $max=max(1,min(20,(int)($validation['max_items']??20)));\n        $min=min($max,max(!empty($row['is_required'])?1:0,(int)($validation['min_items']??0)));\n        return ['active'=>true,'min'=>$min,'max'=>$max,'label'=>(string)($row['label']?:($purpose==='product'?'商品/材料图片':'现场环境/墙面图片'))];\n    }\n\n    /** @return array{ready:bool,reason:string,purpose:string,required:int,actual:int} */\n    public static function readiness(Database $db,int $orderId,int $schemaVersionId,string $workflowProfile):array\n    {\n        // 与普通订单 finalize 保持一致：测量单不要求施工材料/墙面图片。\n        if($workflowProfile==='measurement')return ['ready'=>true,'reason'=>'','purpose'=>'','required'=>0,'actual'=>0];\n        foreach(['product','wall'] as $purpose){\n            $rule=self::rule($db,$schemaVersionId,$purpose);\n            if(!$rule['active'])continue;\n            $count=(int)$db->fetchValue(\n                \"SELECT COUNT(*) FROM media_links\n                 WHERE entity_type='order' AND entity_id=:order_id AND purpose=:purpose\",\n                ['order_id'=>$orderId,'purpose'=>$purpose]\n            );\n            if($count<$rule['min']){\n                return ['ready'=>false,'reason'=>'“'.$rule['label'].'”至少需要上传 '.$rule['min'].' 张','purpose'=>$purpose,'required'=>$rule['min'],'actual'=>$count];\n            }\n            if($count>$rule['max']){\n                return ['ready'=>false,'reason'=>'“'.$rule['label'].'”最多允许 '.$rule['max'].' 张','purpose'=>$purpose,'required'=>$rule['max'],'actual'=>$count];\n            }\n        }\n        return ['ready'=>true,'reason'=>'','purpose'=>'','required'=>0,'actual'=>0];\n    }\n}\n","server/app/Contracts/OrderNotificationPort.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderNotificationPort\n{\n    public function queue(\n        int $orderId,\n        string $idempotencyKey,\n        string $eventType,\n        array $payload = []\n    ): void;\n}\n","server/app/Contracts/AdminRepairResolutionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\n/** 平台介入后的维修售后裁定端口；不承载退款、赔付或资金处理。 */\ninterface AdminRepairResolutionRepository\n{\n    /**\n     * @param array{channel:string,user_id:int} $operator\n     * @return array<string,mixed>\n     */\n    public function resolve(\n        array $operator,\n        string $orderNo,\n        string $afterSaleNo,\n        string $decision,\n        string $note\n    ): array;\n}\n","server/app/Domain/Messaging/OrderMessageDefinition.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nfinal class OrderMessageDefinition\n{\n    public static function definition(string $type, array $payload): ?array\n    {\n        $meta = MessageEventCatalog::get($type);\n        // 管理员恢复类事件只需要订单进度触达，不自动扩入短信/模板配置目录。\n        if (!$meta && $type === 'worker_replaced_by_admin') {\n            $meta = ['status'=>'平台已改派师傅，等待新师傅确认接单','recipients'=>['user','worker'],'scene'=>'order_status'];\n        }\n        if (!$meta && $type === 'repair_platform_intervention_started') {\n            $meta = ['status'=>'平台已主动介入维修售后','recipients'=>['user','worker'],'scene'=>'order_status'];\n        }\n        if (!$meta || trim((string)($meta['status'] ?? '')) === '' || empty($meta['recipients'])) return null;\n        if (!empty($payload['assisted']) && in_array($type,['completion_submitted','measurement_result_submitted','platform_measurement_result_submitted','platform_measurement_auto_confirmed','repair_worker_completed'],true)) {\n            $meta['status']=$type==='completion_submitted' ? '管理员已补录完工，等待客户验收'\n                : ($type==='repair_worker_completed' ? '管理员已补录维修处理结果' : '管理员已补录测量成果');\n            $meta['recipients']=['user','worker'];\n        }\n        if (!empty($payload['assisted']) && in_array($type, ['appointment_recorded','appointment_waiting_customer_notice','repair_appointment_recorded','repair_waiting_customer_notice'], true)) {\n            $meta['status'] = !empty($payload['wait_customer_notice']) ? '管理员补录联系结果：等待客户另行通知' : '管理员已补录预约';\n            $meta['recipients'] = ['user','worker'];\n        }\n        $amount = null;\n        foreach (['amount_cents','requested_tail_cents','new_amount_cents','added_amount_cents','total_amount_cents','refund_amount_cents'] as $amountKey) {\n            if (isset($payload[$amountKey]) && is_numeric($payload[$amountKey])) { $amount = (int)$payload[$amountKey]; break; }\n        }\n        $recipients = (array)$meta['recipients'];\n        if (isset($payload['notify_recipients']) && is_array($payload['notify_recipients'])) {\n            $requested = array_values(array_unique(array_map('strval', $payload['notify_recipients'])));\n            $recipients = array_values(array_intersect($recipients, $requested));\n        }\n        return [\n            'scene'=>(string)($meta['scene'] ?? 'order_status'),\n            'status'=>(string)$meta['status'],\n            'recipients'=>$recipients,\n            'amount_cents'=>$amount,\n        ];\n    }\n}\n","server/app/Domain/Order/PlatformOrderSettlementPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/**\n * V2.5.0 平台承接单纯金额规则。\n *\n * 不访问数据库、不读取配置、不处理 HTTP，供当前平台履约适配器以及后续统一\n * OrderFulfillment Application 复用，避免 worker_collect / platform_balance 的\n * 金额算法在多个入口各写一份。\n */\nfinal class PlatformOrderSettlementPolicy\n{\n    public const MODE_WORKER_COLLECT = 'worker_collect';\n    public const MODE_PLATFORM_BALANCE = 'platform_balance';\n\n    /**\n     * 兼容现有 extra_income_rate_bp_snapshot 单字段的规则编码。\n     * 0..10000 表示万分比；大于等于该偏移量表示“固定金额”，偏移后的值单位为分。\n     * 这样 V2.5.0 尚未正式运营时无需再拆一套加项结算表，且所有资金算法仍集中在领域层。\n     */\n    public const EXTRA_INCOME_FIXED_OFFSET = 1000000000;\n\n    /**\n     * @return array{booking_paid_cents:int,customer_tail_cents:int,platform_receivable_cents:int,worker_balance_credit_cents:int}\n     */\n    public function settlement(int $customerTotal, int $workerLabor, int $bookingPaid, string $mode): array\n    {\n        if ($customerTotal <= 0 || $workerLabor <= 0) {\n            throw new OrderOperationException('客户金额或师傅工费尚未确认', 'PLATFORM_SETTLEMENT_AMOUNT_REQUIRED', 409);\n        }\n        $this->assertMode($mode);\n\n        $bookingPaid = min($customerTotal, max(0, $bookingPaid));\n        $customerTail = max(0, $customerTotal - $bookingPaid);\n        $platformReceivable = $mode === self::MODE_PLATFORM_BALANCE\n            ? $customerTail\n            : $customerTotal - $workerLabor - $bookingPaid;\n        if ($platformReceivable < 0) {\n            throw new OrderOperationException(\n                '本单会形成负差额，请先与客户加收或处理加价后再验收',\n                'PLATFORM_SETTLEMENT_NEGATIVE',\n                409\n            );\n        }\n\n        return [\n            'booking_paid_cents' => $bookingPaid,\n            'customer_tail_cents' => $customerTail,\n            'platform_receivable_cents' => $platformReceivable,\n            'worker_balance_credit_cents' => $mode === self::MODE_PLATFORM_BALANCE ? $workerLabor : 0,\n        ];\n    }\n\n    /** @return array{platform_share_cents:int,worker_share_cents:int} */\n    public function splitExtraIncome(int $addedAmount, int $platformRuleValue): array\n    {\n        if ($addedAmount <= 0) {\n            throw new OrderOperationException('请输入正确的加价金额', 'PLATFORM_CHANGE_AMOUNT_INVALID', 422);\n        }\n\n        if ($platformRuleValue >= self::EXTRA_INCOME_FIXED_OFFSET) {\n            $fixed = max(0, $platformRuleValue - self::EXTRA_INCOME_FIXED_OFFSET);\n            if ($fixed > $addedAmount) {\n                throw new OrderOperationException('本次加项金额低于本单设置的固定平台收入，请先调整加项金额或平台收入规则', 'PLATFORM_CHANGE_BELOW_FIXED_INCOME', 422);\n            }\n            return [\n                'platform_share_cents' => $fixed,\n                'worker_share_cents' => $addedAmount - $fixed,\n            ];\n        }\n\n        $rate = max(0, min(10000, $platformRuleValue));\n        $platformShare = (int) round($addedAmount * $rate / 10000);\n        return [\n            'platform_share_cents' => $platformShare,\n            'worker_share_cents' => max(0, $addedAmount - $platformShare),\n        ];\n    }\n\n    /** @return array{available_delta_cents:int,frozen_delta_cents:int,entry_type:string} */\n    public function workerBalanceEntry(int $workerBalanceCredit, int $freezeDays): array\n    {\n        $credit = max(0, $workerBalanceCredit);\n        $days = max(0, $freezeDays);\n        return [\n            'available_delta_cents' => $days === 0 ? $credit : 0,\n            'frozen_delta_cents' => $days > 0 ? $credit : 0,\n            'entry_type' => $days === 0 ? 'platform_order_income' : 'platform_order_income_frozen',\n        ];\n    }\n\n    private function assertMode(string $mode): void\n    {\n        if (!in_array($mode, [self::MODE_WORKER_COLLECT, self::MODE_PLATFORM_BALANCE], true)) {\n            throw new OrderOperationException('平台承接单工费结算方式无效', 'PLATFORM_SETTLEMENT_MODE_INVALID', 409);\n        }\n    }\n}\n","server/app/Domain/Messaging/WechatTemplateValue.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\n\n\nfinal class WechatTemplateValue\n{\n\n    public static function format(string $wechatKey,string $value):?string\n    {\n        $value=trim((string)(preg_replace('/[\\x00-\\x1F\\x7F]+/u',' ',$value)??$value));\n        if($value==='')return null;\n        $prefix=strtolower((string)(preg_replace('/\\d+$/','',$wechatKey)??''));\n        if($prefix==='thing')return mb_substr($value,0,20);\n        if($prefix==='name')return mb_substr($value,0,32);\n        if($prefix==='phrase')return mb_substr($value,0,16);\n        if($prefix==='character_string'){\n            $ascii=(string)(preg_replace('/[^A-Za-z0-9_+\\-\\.\\/]/','',$value)??'');\n            return $ascii===''?null:substr($ascii,0,64);\n        }\n        if($prefix==='number'){\n            $number=(string)(preg_replace('/[^0-9.\\-]/','',$value)??'');\n            return $number===''?null:substr($number,0,32);\n        }\n        if($prefix==='letter'){\n            $letters=(string)(preg_replace('/[^A-Za-z]/','',$value)??'');\n            return $letters===''?null:substr($letters,0,32);\n        }\n        if($prefix==='symbol'){\n            $symbols=(string)(preg_replace('/[A-Za-z0-9\\x{4e00}-\\x{9fff}\\s]/u','',$value)??'');\n            return $symbols===''?null:mb_substr($symbols,0,5);\n        }\n        if($prefix==='phone_number'){\n            $phone=(string)(preg_replace('/[^0-9+\\-]/','',$value)??'');\n            return $phone===''?null:substr($phone,0,17);\n        }\n        if($prefix==='car_number')return mb_substr($value,0,12);\n        if($prefix==='amount'){\n            $number=(string)(preg_replace('/[^0-9.]/','',$value)??'');\n            if($number===''||!preg_match('/^\\d{1,8}(?:\\.\\d{1,2})?$/',$number))return null;\n            return '¥'.$number;\n        }\n        if($prefix==='time'){\n            if(preg_match('/(?:^|\\s)([0-2]\\d:[0-5]\\d)(?::[0-5]\\d)?$/',$value,$match)===1)return (string)$match[1];\n            return preg_match('/^([0-2]\\d:[0-5]\\d)(?::[0-5]\\d)?$/',$value,$match)===1?(string)$match[1]:null;\n        }\n        if($prefix==='date'){\n            if(preg_match('/(\\d{4}-[01]\\d-[0-3]\\d)/',$value,$match)===1)return (string)$match[1];\n            return null;\n        }\n        return mb_substr($value,0,20);\n    }\n}\n","server/app/Domain/Messaging/OrderProgressMessageCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\n/** 新订单持久化事件的纯消息目录；渠道是否启用仍由既有配置决定。 */\nfinal class OrderProgressMessageCatalog\n{\n    public static function all(): array\n    {\n        $labels = [\n            'platform_worker_quoted'=>'平台单工费报价待选择','platform_worker_quote_selected'=>'平台已选定成交师傅',\n            'platform_single_grab_accepted'=>'平台单抢单成交','platform_invite_fixed_price_accepted'=>'受邀师傅按工费成交','invite_claimed'=>'受邀师傅待接单',\n            'platform_measurement_auto_confirmed'=>'平台测量成果已确认，待核价','platform_measurement_confirmed'=>'客户确认平台测量成果',\n            'platform_measurement_pricing_reviewed'=>'平台施工核价已完成','platform_measurement_pricing_confirmed'=>'施工价格已确认，可预约',\n            'platform_change_requested'=>'平台单工费/加项待处理','platform_change_accepted'=>'客户已同意平台单加项','platform_change_rejected'=>'客户已拒绝平台单加项',\n            'platform_balance_change_approved'=>'平台工费增项已批准','platform_balance_change_rejected'=>'平台工费增项已驳回',\n            'platform_completion_accepted'=>'平台单已验收','platform_income_received'=>'平台收入款已核实','platform_pricing_quantity_adjusted'=>'实际用量与金额已更新',\n            'assignment_auto_accepted'=>'已报价师傅自动成交',\n        ];\n        $definitions = [\n            'platform_worker_quoted'=>['收到师傅工费报价，请选择成交师傅',['admin'],'order_status',''],\n            'platform_worker_quote_selected'=>['平台已选定成交师傅，请联系预约',['user','worker'],'order_status','worker_assigned'],\n            'platform_single_grab_accepted'=>['师傅已按约定工费成交',['user'],'order_status','worker_assigned'],\n            'platform_invite_fixed_price_accepted'=>['受邀师傅已按约定工费成交',['user'],'order_status','worker_assigned'],\n            'invite_claimed'=>['受邀师傅已领取订单，请确认接单',['worker'],'order_status','worker_assigned'],\n            'platform_measurement_auto_confirmed'=>['测量成果已确认，等待平台核价',['user','admin'],'order_status',''],\n            'platform_measurement_confirmed'=>['测量成果已确认，等待平台核价',['admin'],'order_status',''],\n            // 托管单核价由平台完成后立即生效；reviewed 仅保留内部审计，不再要求客户二次确认。\n            'platform_measurement_pricing_reviewed'=>['平台已完成测量后施工核价',['admin'],'order_status',''],\n            'platform_measurement_pricing_confirmed'=>['施工价格已确认，可以联系客户预约',['worker'],'order_status','worker_order_update'],\n            'platform_change_requested'=>['平台单费用调整待处理',['user','admin'],'order_status','fee_adjustment'],\n            'platform_change_accepted'=>['客户已同意订单外加项',['worker'],'order_status','worker_order_update'],\n            'platform_change_rejected'=>['客户已拒绝订单外加项',['worker'],'order_status','worker_order_update'],\n            'platform_balance_change_approved'=>['平台已批准工费增项',['worker'],'order_status','worker_order_update'],\n            'platform_balance_change_rejected'=>['平台已驳回工费增项',['worker'],'order_status','worker_order_update'],\n            'platform_completion_accepted'=>['平台单已验收，结算金额已生成',['worker'],'order_status',''],\n            'platform_income_received'=>['平台收入款已核实结清',['worker'],'order_status',''],\n            'platform_pricing_quantity_adjusted'=>['实际用量和客户金额已更新',['user'],'order_status',''],\n            'assignment_auto_accepted'=>['客户已选定您的报价，请联系预约',['worker'],'order_status','worker_order_update'],\n        ];\n        $normal = array('platform_worker_quote_selected', 'platform_single_grab_accepted', 'platform_invite_fixed_price_accepted', 'invite_claimed', 'platform_measurement_auto_confirmed', 'platform_measurement_confirmed', 'platform_completion_accepted', 'platform_income_received', 'platform_pricing_quantity_adjusted', 'assignment_auto_accepted');\n        $internal = array('platform_completion_accepted', 'platform_income_received', 'platform_pricing_quantity_adjusted', 'platform_measurement_auto_confirmed', 'platform_measurement_pricing_reviewed');\n        $catalog = [];\n        foreach ($definitions as $key=>$definition) {\n            $recipients=$definition[1]; $isInternal=in_array($key,$internal,true);\n            $fallback=$definition[3]!=='';\n            $catalog[$key]=[\n                'key'=>$key,'label'=>$labels[$key],\n                'priority'=>in_array($key,$normal,true)?'normal':'important',\n                'audience_label'=>in_array('user',$recipients,true)&&in_array('worker',$recipients,true)?'用户、师傅':(in_array('worker',$recipients,true)?'师傅':(in_array('user',$recipients,true)?'用户':'管理员')),\n                'status'=>$definition[0],'recipients'=>$recipients,'scene'=>$definition[2],'subscription_scene'=>$definition[3],\n                'inapp_visible'=>in_array('user',$recipients,true)||in_array('worker',$recipients,true),\n                'internal_only'=>$isInternal,\n                'sms_visible'=>!$isInternal&&(in_array('user',$recipients,true)||in_array('worker',$recipients,true)),\n                'sms_default'=>false,'sms_recommended'=>false,'sms_delivery_mode'=>$fallback?'subscription_fallback':'independent',\n                'sms_subscription_fallback'=>$fallback,'sms_priority'=>'normal',\n                'wecom_visible'=>in_array('admin',$recipients,true),'wecom_default'=>false,\n            ];\n        }\n        return $catalog;\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderDisputeRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderDisputeRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\NegotiationPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderDisputeRepository implements OrderDisputeRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function startNegotiation(array $actor, string $orderNo, string $description, array $evidenceIds): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$description,$evidenceIds): array {\n            $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE', ['public_no'=>$orderNo]);\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能为自己的订单提交异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$order['fulfillment_status'] !== 'submitted' || (string)$order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('只有待确认的服务结果可以提交异议', 'DISPUTE_NOT_ALLOWED', 409);\n            }\n            if (!in_array((string)($order['dispute_status'] ?? 'none'), ['','none','resolved'], true)\n                || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\", ['id'=>$order['id']])) {\n                throw new OrderOperationException('本单已有异议正在处理中', 'DISPUTE_ALREADY_ACTIVE', 409);\n            }\n\n            $params = ['order_id'=>$order['id']];\n            $marks = [];\n            foreach (array_values($evidenceIds) as $index=>$publicId) {\n                $key = 'media_'.$index;\n                $marks[] = ':'.$key;\n                $params[$key] = $publicId;\n            }\n            $mediaRows = $db->fetchAll(\n                \"SELECT m.id,m.public_id FROM media_files m\n                 JOIN media_links l ON l.media_file_id=m.id AND l.entity_type='order' AND l.entity_id=:order_id AND l.purpose='dispute_evidence'\n                 WHERE m.public_id IN (\".implode(',', $marks).\") AND m.status='active'\n                 GROUP BY m.id,m.public_id\",\n                $params\n            );\n            if (count($mediaRows) !== count($evidenceIds)) {\n                throw new OrderOperationException('异议证据图片无效，请重新上传后提交', 'DISPUTE_EVIDENCE_INVALID', 422);\n            }\n\n            $measurement = (string)($order['workflow_profile'] ?? 'construction') === 'measurement';\n            $disputeNo = 'DSP'.gmdate('ymdHis').strtoupper(bin2hex(random_bytes(4)));\n            $disputeId = $db->insert(\n                \"INSERT INTO disputes(public_no,order_id,raised_by_type,raised_by_id,dispute_type,title,description,status,responsibility,refund_amount_cents,run_empty_fee_cents,opened_at,created_at,updated_at)\n                 VALUES(:public_no,:order_id,'user',:user_id,:dispute_type,:title,:description,'negotiating','undetermined',0,0,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_no'=>$disputeNo,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                    'dispute_type'=>$measurement ? 'measurement_result' : 'completion_quality',\n                    'title'=>$measurement ? '测量成果异议协商中' : '完工异议协商中',\n                    'description'=>$description,\n                ]\n            );\n            foreach ($mediaRows as $row) {\n                $db->insert(\n                    \"INSERT INTO dispute_evidence(dispute_id,submitted_by_type,submitted_by_id,evidence_type,description,media_file_id,occurred_at,created_at)\n                     VALUES(:dispute_id,'user',:user_id,'photo',NULL,:media_id,NULL,UTC_TIMESTAMP())\",\n                    ['dispute_id'=>$disputeId,'user_id'=>$actor['user_id'],'media_id'=>$row['id']]\n                );\n            }\n            $db->execute(\n                \"UPDATE orders SET dispute_status='negotiating',publish_status='hidden',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n            $eventKey = $this->event($db, (int)$order['id'], 'dispute_negotiation_started', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$disputeNo,\n                'evidence_count'=>count($mediaRows),\n                'message'=>$measurement\n                    ? '用户提出测量成果异议，自动确认已暂停，请双方先自行沟通处理'\n                    : '用户提出完工异议，自动验收已暂停，请双方先自行沟通处理',\n            ], false);\n            $this->notifyWorkerNegotiation($db, $order, $eventKey, $measurement);\n            return ['id'=>$disputeNo,'status'=>'negotiating','admin_escalated'=>false];\n        });\n    }\n\n    public function escalate(array $actor, string $disputeNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$disputeNo,$note): array {\n            $seed = $db->fetch('SELECT order_id FROM disputes WHERE BINARY public_no=BINARY :no', ['no'=>$disputeNo]);\n            if (!$seed) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            $db->fetch('SELECT id FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $row = $db->fetch(\n                \"SELECT d.*,o.public_no order_no,o.user_id,o.id order_id,o.workflow_profile\n                 FROM disputes d JOIN orders o ON o.id=d.order_id\n                 WHERE BINARY d.public_no=BINARY :public_no FOR UPDATE\",\n                ['public_no'=>$disputeNo]\n            );\n            if (!$row) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            if ((int)$row['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能处理自己的订单异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$row['status'] !== 'negotiating') {\n                throw new OrderOperationException('该异议当前不能重复申请平台介入', 'DISPUTE_ESCALATE_NOT_ALLOWED', 409);\n            }\n            // 2026-10-08：直接 API 与页面使用同一升级条件，不能提交后立即绕过协商。\n            $eligibility = NegotiationPolicy::evaluate(NegotiationPolicy::disputeStatus($row['resolution'] ?? null), $row['opened_at'] ?? null);\n            if (empty($eligibility['eligible'])) {\n                throw new OrderOperationException('请先协商；师傅拒绝或满48小时未解决后才可申请平台介入', 'NEGOTIATION_WAIT_REQUIRED', 409, $eligibility);\n            }\n            if ($note !== '') {\n                $db->insert(\n                    \"INSERT INTO dispute_evidence(dispute_id,submitted_by_type,submitted_by_id,evidence_type,description,media_file_id,occurred_at,created_at)\n                     VALUES(:dispute_id,'user',:user_id,'note',:description,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['dispute_id'=>$row['id'],'user_id'=>$actor['user_id'],'description'=>$note]\n                );\n            }\n            $measurement = (string)($row['workflow_profile'] ?? 'construction') === 'measurement';\n            $db->execute(\n                \"UPDATE disputes SET status='open',title=:title,updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='negotiating'\",\n                ['title'=>$measurement ? '用户申请平台介入测量成果争议' : '用户申请平台介入完工争议','id'=>$row['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET dispute_status='open',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$row['order_id']]\n            );\n            // 平台待办只通过 queueAdminTask 产生一次；订单事件仅通知双方，避免管理员收到两条重复提醒。\n            $eventKey = $this->event($db, (int)$row['order_id'], 'dispute_opened', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$row['public_no'],\n                'dispute_type'=>$row['dispute_type'],\n                'message'=>'双方自行协商未解决，用户已申请平台介入',\n                'reason'=>$note,\n                'notify_recipients'=>['user','worker'],\n            ], true);\n            OrderNotificationService::queueAdminTask(\n                $db,\n                'dispute:'.$row['id'],\n                'completion_dispute_opened',\n                $measurement ? '用户申请平台介入测量成果争议' : '用户申请平台介入完工争议',\n                [\n                    '订单号'=>(string)$row['order_no'],\n                    '争议说明'=>(string)$row['description'],\n                    '补充说明'=>$note,\n                ]\n            );\n            return ['id'=>(string)$row['public_no'],'status'=>'open','admin_escalated'=>true,'event_key'=>$eventKey];\n        });\n    }\n\n    public function resolveByAgreement(array $actor, string $disputeNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$disputeNo,$note): array {\n            $seed = $db->fetch('SELECT order_id FROM disputes WHERE BINARY public_no=BINARY :no', ['no'=>$disputeNo]);\n            if (!$seed) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            $db->fetch('SELECT id FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $row = $db->fetch(\n                \"SELECT d.*,o.user_id,o.id order_id FROM disputes d JOIN orders o ON o.id=d.order_id\n                 WHERE BINARY d.public_no=BINARY :public_no FOR UPDATE\",\n                ['public_no'=>$disputeNo]\n            );\n            if (!$row) throw new OrderOperationException('异议记录不存在', 'DISPUTE_NOT_FOUND', 404);\n            if ((int)$row['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能处理自己的订单异议', 'FORBIDDEN', 403);\n            }\n            if ((string)$row['status'] !== 'negotiating') {\n                throw new OrderOperationException('平台已经介入或异议已经结束，不能自行关闭', 'DISPUTE_SELF_RESOLVE_NOT_ALLOWED', 409);\n            }\n            $resolution = '双方自行协商解决'.($note !== '' ? '：'.$note : '');\n            $db->execute(\n                \"UPDATE disputes SET status='resolved',responsibility='mutual',resolution=:resolution,resolved_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='negotiating'\",\n                ['resolution'=>$resolution,'id'=>$row['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET dispute_status='resolved',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$row['order_id']]\n            );\n            $this->event($db, (int)$row['order_id'], 'dispute_resolved', 'user', (int)$actor['user_id'], [\n                'dispute_no'=>$row['public_no'],\n                'resolution'=>$resolution,\n                'self_resolved'=>1,\n                'notify_recipients'=>['worker'],\n            ], true);\n            return ['id'=>(string)$row['public_no'],'status'=>'resolved','admin_escalated'=>false];\n        });\n    }\n\n    public function resolveByAdmin(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array {\n        $operation = function () use ($operator, $orderNo, $resolution, $responsibility, $refundCents, $runEmptyCents): array {\n            return $this->resolveByAdminUnderWriteGuard($operator, $orderNo, $resolution, $responsibility, $refundCents, $runEmptyCents);\n        };\n        if (($operator['channel'] ?? '') === 'web_admin') {\n            return (new DatabaseDemoOrderWriteGuard($this->db))->run($orderNo, $operation);\n        }\n        return $operation();\n    }\n\n    private function resolveByAdminUnderWriteGuard(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array {\n        $channel = (string)($operator['channel'] ?? '');\n        if ($channel === 'mini_admin') {\n            $operatorId = max(0, (int)($operator['user_id'] ?? 0));\n            $handledBy = null;\n        } elseif ($channel === 'web_admin') {\n            $operatorId = max(0, (int)($operator['admin_user_id'] ?? 0));\n            $handledBy = $operatorId;\n        } else {\n            throw new OrderOperationException('管理员操作来源无效', 'ADMIN_REQUIRED', 403);\n        }\n        if ($operatorId < 1) throw new OrderOperationException('管理员身份无效', 'ADMIN_REQUIRED', 403);\n        $refundCents = max(0, $refundCents);\n        $runEmptyCents = max(0, $runEmptyCents);\n        if ($channel === 'mini_admin' && ($refundCents > 0 || $runEmptyCents > 0)) {\n            throw new OrderOperationException('涉及退款或跑空费金额，请到网页后台处理', 'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED', 409);\n        }\n\n        return $this->db->transaction(function (Database $db) use (\n            $orderNo,$resolution,$responsibility,$refundCents,$runEmptyCents,$channel,$operatorId,$handledBy\n        ): array {\n            $order = $db->fetch(\n                'SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $dispute = $db->fetch(\n                \"SELECT * FROM disputes\n                 WHERE order_id=:order_id AND status IN ('open','processing')\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id']]\n            );\n            if (!$dispute) {\n                throw new OrderOperationException('当前没有待处理争议', 'DISPUTE_ADMIN_NOT_FOUND', 409);\n            }\n            if ($channel === 'mini_admin' && ((int)($dispute['refund_amount_cents'] ?? 0) > 0 || (int)($dispute['run_empty_fee_cents'] ?? 0) > 0)) {\n                throw new OrderOperationException(\n                    '该争议涉及退款或跑空费金额，请到网页后台处理',\n                    'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED',\n                    409\n                );\n            }\n\n            $financial = $refundCents > 0 || $runEmptyCents > 0;\n            $effectiveRefundCents = 0;\n            $autoRefundCents = 0;\n            $allocations = [\n                'refund_cents'=>0,\n                'outstanding_refund_cents'=>0,\n                'succeeded_refund_cents'=>0,\n                'runner_cents'=>0,\n            ];\n            $payment = null;\n            $availableBookingFee = 0;\n\n            if ($financial) {\n                if ($channel !== 'web_admin' || $handledBy === null) {\n                    throw new OrderOperationException('资金争议只能由网页后台裁定', 'DISPUTE_ADMIN_FINANCIAL_REVIEW_REQUIRED', 409);\n                }\n                if ($this->isTerminalLifecycle((string)($order['lifecycle_status'] ?? ''))) {\n                    throw new OrderOperationException('已结束订单不能再次分配预约费，请核对已有退款和结算记录', 'DISPUTE_FINANCE_ORDER_CLOSED', 409);\n                }\n                $payment = $db->fetch(\n                    \"SELECT id,amount_cents FROM payment_orders\n                     WHERE order_id=:order_id AND business_type IN ('order_booking','booking_fee') AND status='paid'\n                     ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                    ['order_id'=>$order['id']]\n                );\n                $availableBookingFee = $payment\n                    ? ((int)($order['booking_fee_cents'] ?? 0) > 0\n                        ? min((int)$payment['amount_cents'], (int)$order['booking_fee_cents'])\n                        : (int)$payment['amount_cents'])\n                    : 0;\n                if ($refundCents + $runEmptyCents > $availableBookingFee) {\n                    throw new OrderOperationException('退款与跑空费合计不能超过本单实际支付的预约费', 'DISPUTE_FINANCE_EXCEEDS_BOOKING', 409);\n                }\n                $allocations = $payment\n                    ? $this->bookingFeeAllocations($db, (int)$payment['id'], (int)$order['id'])\n                    : $allocations;\n                if ($allocations['refund_cents'] + $allocations['runner_cents'] + $refundCents + $runEmptyCents > $availableBookingFee) {\n                    throw new OrderOperationException('该支付单已有退款或费用分配，剩余预约费不足', 'DISPUTE_FINANCE_ALREADY_ALLOCATED', 409);\n                }\n\n                // 资金裁定会终止本次履约；未判给师傅且尚未被占用的预约费必须全部回到退款，避免余额悬空。\n                $allocatedAfterDecision = $allocations['refund_cents'] + $allocations['runner_cents'] + $refundCents + $runEmptyCents;\n                $autoRefundCents = max(0, $availableBookingFee - $allocatedAfterDecision);\n                $effectiveRefundCents = $refundCents + $autoRefundCents;\n\n                if ($effectiveRefundCents > 0) {\n                    $db->insert(\n                        \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                         VALUES(:public_no,:payment_id,:order_id,NULL,:amount,:reason,'pending_review',:admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                        [\n                            'public_no'=>\\business_no('RF'),\n                            'payment_id'=>$payment['id'],\n                            'order_id'=>$order['id'],\n                            'amount'=>$effectiveRefundCents,\n                            'reason'=>mb_substr('争议裁定：'.$resolution, 0, 1000),\n                            'admin_id'=>$handledBy,\n                        ]\n                    );\n                }\n\n                if ($runEmptyCents > 0) {\n                    $workerId = !empty($order['assigned_worker_id'])\n                        ? (int)$order['assigned_worker_id']\n                        : (int)$db->fetchValue(\n                            \"SELECT worker_id FROM assignments\n                             WHERE order_id=:order_id\n                             ORDER BY CASE status WHEN 'accepted' THEN 1 WHEN 'completed' THEN 2 WHEN 'cancelled' THEN 3 WHEN 'offered' THEN 4 ELSE 5 END,id DESC\n                             LIMIT 1\",\n                            ['order_id'=>$order['id']]\n                        );\n                    if ($workerId < 1) {\n                        throw new OrderOperationException('订单没有可收取跑空费的师傅，请先核对指派记录', 'DISPUTE_RUN_EMPTY_WORKER_MISSING', 409);\n                    }\n                    $db->execute(\n                        \"INSERT INTO worker_balance_ledger(\n                            worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                            business_type,business_id,idempotency_key,description,status,created_by_admin_id,created_at\n                         ) VALUES(\n                            :worker_id,'run_empty_fee','credit',:amount,:available_delta,0,\n                            'dispute',:dispute_id,:idempotency_key,:description,'effective',:admin_id,UTC_TIMESTAMP()\n                         )\",\n                        [\n                            'worker_id'=>$workerId,\n                            'amount'=>$runEmptyCents,\n                            'available_delta'=>$runEmptyCents,\n                            'dispute_id'=>$dispute['id'],\n                            'idempotency_key'=>'dispute:'.$dispute['id'].':run_empty_fee',\n                            'description'=>mb_substr('争议裁定跑空费：'.$resolution, 0, 1000),\n                            'admin_id'=>$handledBy,\n                        ]\n                    );\n                }\n            }\n\n            $changed = $db->execute(\n                \"UPDATE disputes\n                 SET status='resolved',resolution=:resolution,responsibility=:responsibility,\n                     refund_amount_cents=:refund,run_empty_fee_cents=:runner,handled_by=:handled_by,\n                     resolved_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status IN ('open','processing')\",\n                [\n                    'resolution'=>$resolution,\n                    'responsibility'=>$responsibility,\n                    'refund'=>$effectiveRefundCents,\n                    'runner'=>$runEmptyCents,\n                    'handled_by'=>$handledBy,\n                    'id'=>$dispute['id'],\n                ]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('争议状态已变化，请刷新后重试', 'DISPUTE_ADMIN_CHANGED', 409);\n            }\n\n            if ($financial) {\n                // 取消风控必须在报价/指派失效前捕获原事实，并与争议裁定同一事务提交。\n                (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order, $responsibility, $runEmptyCents);\n                $hasOutstandingRefund = $allocations['outstanding_refund_cents'] + $effectiveRefundCents > 0;\n                $lifecycle = $hasOutstandingRefund ? 'cancel_approved_pending_refund' : 'cancelled';\n                $db->execute(\n                    \"UPDATE orders\n                     SET dispute_status='resolved',lifecycle_status=:lifecycle,publish_status='hidden',quote_status='cancelled',\n                         assignment_status='cancelled',fulfillment_status='cancelled',\n                         refund_status=IF(:has_refund=1,'pending_review',refund_status),\n                         cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),\n                         closed_at=IF(:close_now=1,COALESCE(closed_at,UTC_TIMESTAMP()),closed_at),\n                         updated_at=UTC_TIMESTAMP(),version=version+1\n                     WHERE id=:id\",\n                    [\n                        'lifecycle'=>$lifecycle,\n                        'has_refund'=>$hasOutstandingRefund ? 1 : 0,\n                        'close_now'=>$hasOutstandingRefund ? 0 : 1,\n                        'id'=>$order['id'],\n                    ]\n                );\n                $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=COALESCE(revoked_at,UTC_TIMESTAMP()) WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            } else {\n                $db->execute(\n                    \"UPDATE orders SET dispute_status='resolved',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n            }\n\n            $payload = [\n                'dispute_no'=>(string)$dispute['public_no'],\n                'message'=>'平台争议处理完成：'.$resolution,\n                'resolution'=>$resolution,\n                'responsibility'=>$responsibility,\n                'refund_cents'=>$effectiveRefundCents,\n                'run_empty_fee_cents'=>$runEmptyCents,\n                'auto_refund_cents'=>$autoRefundCents,\n                'operator_channel'=>$channel,\n                'notify_recipients'=>['user','worker'],\n            ];\n            if ($channel === 'mini_admin') $payload['operator_user_id'] = $operatorId;\n            else $payload['operator_admin_id'] = $operatorId;\n            $eventKey = $this->event($db, (int)$order['id'], 'dispute_resolved', $channel, $operatorId, $payload, true);\n\n            return [\n                'id'=>(string)$dispute['public_no'],\n                'status'=>'resolved',\n                'order_id'=>(int)$order['id'],\n                'refund_cents'=>$effectiveRefundCents,\n                'run_empty_fee_cents'=>$runEmptyCents,\n                'auto_refund_cents'=>$autoRefundCents,\n                'event_key'=>$eventKey,\n            ];\n        });\n    }\n\n    /** @return array{refund_cents:int,outstanding_refund_cents:int,succeeded_refund_cents:int,runner_cents:int} */\n    private function bookingFeeAllocations(Database $db, int $paymentId, int $orderId): array\n    {\n        $refundRows = $db->fetchAll(\n            \"SELECT id,amount_cents,status FROM refunds\n             WHERE payment_order_id=:payment_id\n               AND status NOT IN ('failed','closed','cancelled','rejected')\n             FOR UPDATE\",\n            ['payment_id'=>$paymentId]\n        );\n        $refundCents = 0;\n        $outstandingRefundCents = 0;\n        $succeededRefundCents = 0;\n        foreach ($refundRows as $row) {\n            $amount = max(0, (int)$row['amount_cents']);\n            $refundCents += $amount;\n            if ((string)$row['status'] === 'succeeded') $succeededRefundCents += $amount;\n            else $outstandingRefundCents += $amount;\n        }\n\n        $runnerCents = 0;\n        $paymentBusiness = (string)$db->fetchValue('SELECT business_type FROM payment_orders WHERE id=:id', ['id'=>$paymentId]);\n        if ($orderId > 0 && in_array($paymentBusiness, ['order_booking','booking_fee'], true)) {\n            $runnerRows = $db->fetchAll(\n                \"SELECT l.id,l.amount_cents\n                 FROM worker_balance_ledger l\n                 INNER JOIN disputes d ON d.id=l.business_id\n                 WHERE l.business_type='dispute'\n                   AND l.entry_type='run_empty_fee'\n                   AND l.status='effective'\n                   AND d.order_id=:order_id\n                 FOR UPDATE\",\n                ['order_id'=>$orderId]\n            );\n            foreach ($runnerRows as $row) $runnerCents += max(0, (int)$row['amount_cents']);\n        }\n        return [\n            'refund_cents'=>$refundCents,\n            'outstanding_refund_cents'=>$outstandingRefundCents,\n            'succeeded_refund_cents'=>$succeededRefundCents,\n            'runner_cents'=>$runnerCents,\n        ];\n    }\n\n    private function isTerminalLifecycle(string $status): bool\n    {\n        return strpos($status, 'cancel') === 0 || in_array($status, ['completed','closed','expired'], true);\n    }\n\n    private function notifyWorkerNegotiation(Database $db, array $order, string $eventKey, bool $measurement): void\n    {\n        $workerId = (int)($order['assigned_worker_id'] ?? 0);\n        if ($workerId < 1) return;\n        $data = json_encode(['order_id'=>(int)$order['id'],'event_key'=>$eventKey], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        if ($db->fetchValue(\n            \"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='dispute_negotiation_started' AND BINARY data_json=BINARY :data LIMIT 1\",\n            ['worker_id'=>$workerId,'data'=>$data]\n        )) return;\n        $db->insert(\n            \"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at)\n             VALUES(:public_id,'worker',:worker_id,'in_app','dispute_negotiation_started',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            [\n                'public_id'=>\\public_id(),\n                'worker_id'=>$workerId,\n                'title'=>$measurement ? '用户提出测量成果异议' : '用户提出完工异议',\n                'content'=>'订单 '.(string)$order['public_no'].'：用户对'.($measurement ? '测量成果' : '完工结果').'有异议，请先主动联系协商处理；协商不成时用户可再申请平台介入。',\n                'data'=>$data,\n            ]\n        );\n    }\n\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload, bool $notify): string\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey = $type.':'.$orderId.':'.bin2hex(random_bytes(6));\n        $db->insert(\n            'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$eventKey,'actor_type'=>$actorType,'actor_id'=>$actorId,\n                'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        if ($notify) OrderNotificationService::queue($db, $orderId, $eventKey, $type, $payload);\n        return $eventKey;\n    }\n}\n","server/app/Contracts/NotificationProducer.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface NotificationProducer\n{\n    public function queue(int $orderId,string $key,string $type,array $payload=[]):void;\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void;\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void;\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void;\n}\n","server/app/Contracts/OrderNegotiationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderNegotiationRepository\n{\n    public function respond(array $actor, string $orderNo, string $kind, string $reference, string $decision, string $note): array;\n    public function escalate(array $actor, string $orderNo, string $kind, string $reference, string $note): array;\n    public function proposeRefund(array $actor, string $orderNo, string $reference, int $amount, string $note): array;\n    public function withdrawRefund(array $actor, string $orderNo, string $reference, string $note): array;\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderRepairInterventionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderRepairInterventionRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\RepairInterventionPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderRepairInterventionRepository implements OrderRepairInterventionRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function request(array $actor, string $orderNo, string $afterSaleNo, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$afterSaleNo,$note): array {\n            $order = $db->fetch(\n                'SELECT id,public_no,user_id,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能为自己的维修申请平台介入', 'FORBIDDEN', 403);\n            }\n\n            $repair = $db->fetch(\n                \"SELECT id,public_no,status,resolution,opened_at\n                 FROM after_sales\n                 WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair'\n                 LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id'],'public_no'=>$afterSaleNo]\n            );\n            if (!$repair || !in_array((string)$repair['status'], ['open','processing'], true)) {\n                throw new OrderOperationException('维修申请不存在或已结束', 'REPAIR_NOT_ACTIVE', 409);\n            }\n\n            $eligibility = RepairInterventionPolicy::evaluate(\n                (string)$repair['status'],\n                $repair['resolution'] === null ? null : (string)$repair['resolution'],\n                $repair['opened_at'] === null ? null : (string)$repair['opened_at'],\n                'UTC'\n            );\n            if (!$eligibility['eligible']) {\n                if ((string)$eligibility['reason'] === 'already_escalated') {\n                    throw new OrderOperationException('已经申请平台介入，请勿重复提交', 'REPAIR_INTERVENTION_ALREADY_REQUESTED', 409);\n                }\n                $availableAt = (string)($eligibility['available_at'] ?? '');\n                throw new OrderOperationException(\n                    $availableAt !== ''\n                        ? '请先与师傅沟通处理；师傅未明确拒绝时，维修申请满 48 小时后（'.$availableAt.'）才可申请平台介入'\n                        : '请先与师傅沟通处理；师傅明确拒绝或维修申请满 48 小时后才可申请平台介入',\n                    'REPAIR_INTERVENTION_WAIT_REQUIRED',\n                    409,\n                    ['available_at'=>$availableAt,'wait_hours'=>RepairInterventionPolicy::WAIT_HOURS]\n                );\n            }\n\n            $resolution = '用户申请平台介入'.($note !== '' ? '：'.$note : '');\n            $db->execute(\n                \"UPDATE after_sales SET status='processing',resolution=:resolution,updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                ['resolution'=>$resolution,'id'=>$repair['id']]\n            );\n            $db->execute(\n                \"UPDATE orders SET updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n\n            $eventKey = 'repair_platform_intervention_requested:'.$order['id'].':'.bin2hex(random_bytes(6));\n            $payload = [\n                'after_sale_id'=>(string)$repair['public_no'],\n                'message'=>'用户申请平台介入维修',\n                'note'=>$note,\n                'notify_recipients'=>['worker'],\n            ];\n            $db->insert(\n                'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,\\'user\\',:actor_id,:payload,UTC_TIMESTAMP())',\n                [\n                    'order_id'=>$order['id'],'type'=>'repair_platform_intervention_requested','event_key'=>$eventKey,\n                    'actor_id'=>$actor['user_id'],'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n                ]\n            );\n            OrderNotificationService::queue($db, (int)$order['id'], $eventKey, 'repair_platform_intervention_requested', $payload);\n            OrderNotificationService::queueAdminTask(\n                $db,\n                'after-sales:'.$repair['public_no'].':user-escalated',\n                'repair_platform_intervention_requested',\n                '用户申请平台介入维修',\n                ['订单号'=>(string)$order['public_no'],'售后编号'=>(string)$repair['public_no'],'用户说明'=>$note]\n            );\n\n            return [\n                'after_sale_id'=>(string)$repair['public_no'],\n                'status'=>'processing',\n                'intervention_reason'=>(string)$eligibility['reason'],\n            ];\n        });\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCancellationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderCancellationRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseOrderCancellationRepository implements OrderCancellationRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function request(array $actor, string $orderNo, string $reason, string $reasonCode): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reason,$reasonCode): array {\n            $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE', ['public_no'=>$orderNo]);\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n            if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n                throw new OrderOperationException('只能取消自己的订单', 'FORBIDDEN', 403);\n            }\n            if ((string)$order['payment_status'] !== 'paid') {\n                throw new OrderOperationException('预约费尚未支付，不存在可退款款项；如不需要该订单可直接保留未付款状态', 'REFUND_NOT_AVAILABLE_BEFORE_PAYMENT', 409);\n            }\n            if ((string)$order['lifecycle_status'] !== 'active' || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                throw new OrderOperationException('该订单当前不能申请退款并取消订单', 'ORDER_NOT_CANCELLABLE', 409);\n            }\n            if ($db->fetchValue(\n                \"SELECT id FROM order_cancel_requests WHERE order_id=:id AND status IN ('pending','processing','approved') AND closed_at IS NULL LIMIT 1 FOR UPDATE\",\n                ['id'=>$order['id']]\n            )) {\n                throw new OrderOperationException('已经存在待处理的取消申请', 'CANCEL_REQUEST_ALREADY_OPEN', 409);\n            }\n\n            $payments = $this->refundablePayments($db, $order);\n            $refundAmount = array_sum(array_map(static function (array $row): int { return (int)$row['available_cents']; }, $payments));\n            $auto = $refundAmount > 0 && $this->canAutoApproveBeforeService($db, $order);\n            $requestPublicId = \\public_id();\n\n            if (!$auto) {\n                $db->insert(\n                    \"INSERT INTO order_cancel_requests(public_id,order_id,applicant_type,applicant_id,request_type,order_state_snapshot_json,reason_code,reason,status,requested_refund_cents,requested_at,created_at,updated_at)\n                     VALUES(:public_id,:order_id,'user',:user_id,'cancel_refund',:snapshot,:reason_code,:reason,'pending',:refund,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_id'=>$requestPublicId,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                        'snapshot'=>$this->snapshot($order),'reason_code'=>!empty($order['assigned_worker_id']) ? 'bilateral_refund_pending' : $reasonCode,'reason'=>$reason,'refund'=>$refundAmount,\n                    ]\n                );\n                $db->execute(\n                    \"UPDATE orders SET refund_status='pending_review',publish_status='hidden',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n                $this->event($db, (int)$order['id'], 'cancel_requested', 'user', (int)$actor['user_id'], [\n                    'requested_refund_cents'=>$refundAmount,\n                    'notify_recipients'=>!empty($order['assigned_worker_id']) ? ['worker'] : ['admin'],\n                    'message'=>!empty($order['assigned_worker_id']) ? '用户提出退款方案，请师傅先接受或拒绝；方案金额 ¥'.number_format($refundAmount/100, 2) : '用户申请退款取消，当前可退线上实收合计 ¥'.number_format($refundAmount/100, 2),\n                ]);\n                return ['request_id'=>$requestPublicId,'auto_approved'=>false,'bilateral_negotiation'=>!empty($order['assigned_worker_id']),'refund_cents'=>$refundAmount,'refund_count'=>0];\n            }\n\n            $requestId = $db->insert(\n                \"INSERT INTO order_cancel_requests(public_id,order_id,applicant_type,applicant_id,request_type,order_state_snapshot_json,reason_code,reason,status,requested_refund_cents,requested_at,created_at,updated_at)\n                 VALUES(:public_id,:order_id,'user',:user_id,'cancel_refund',:snapshot,'pre_service_auto_refund',:reason,'approved',:refund,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_id'=>$requestPublicId,'order_id'=>$order['id'],'user_id'=>$actor['user_id'],\n                    'snapshot'=>$this->snapshot($order),'reason'=>$reason,'refund'=>$refundAmount,\n                ]\n            );\n\n            return $this->approveRefund($db, $order, $requestId, $requestPublicId, $payments, $refundAmount, $reason, (int)$actor['user_id']);\n        });\n    }\n\n\n    // 2026-10-08：接受方案时锁内复核对方身份和资金；复用未成交自动退款的同一执行器。\n    public function approveByAgreement(array $actor, string $requestNo): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$requestNo): array {\n            $seed = $db->fetch('SELECT order_id FROM order_cancel_requests WHERE BINARY public_id=BINARY :no', ['no'=>$requestNo]);\n            if (!$seed) throw new OrderOperationException('退款方案不存在', 'REFUND_PROPOSAL_NOT_FOUND', 404);\n            $order = $db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$seed['order_id']]);\n            $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE BINARY public_id=BINARY :no FOR UPDATE', ['no'=>$requestNo]);\n            $isWorker = (string)$request['applicant_type'] === 'user' && (int)($actor['worker_id'] ?? 0) > 0 && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n            $isUser = (string)$request['applicant_type'] === 'worker' && (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n            if (!$isWorker && !$isUser) throw new OrderOperationException('只能由方案的另一方接受', 'FORBIDDEN', 403);\n            if ((string)$request['status'] !== 'pending' || (string)$request['reason_code'] !== 'bilateral_refund_pending'\n                || (string)$order['lifecycle_status'] !== 'active' || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                throw new OrderOperationException('方案已经响应或订单状态已变化', 'REFUND_PROPOSAL_NOT_PENDING', 409);\n            }\n            $assignment = $db->fetch(\"SELECT id FROM assignments WHERE id=:id AND order_id=:order AND worker_id=:worker AND status='accepted' FOR UPDATE\", ['id'=>$order['current_assignment_id'] ?: 0,'order'=>$order['id'],'worker'=>$order['assigned_worker_id']]);\n            if (!$assignment) throw new OrderOperationException('成交师傅关系已变化', 'ASSIGNMENT_CHANGED', 409);\n            $payments = $this->refundablePayments($db, $order);\n            $amount = array_sum(array_column($payments, 'available_cents'));\n            // 已同意不等于能够随意分配资金：平台工费/跑空费/争议/已入账收入保持既有财务核验。\n            $blocked = (string)$order['order_source_type'] === 'platform' || $amount !== (int)$request['requested_refund_cents'] || $amount < 1\n                || !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                || (bool)$db->fetchValue(\"SELECT id FROM run_empty_fee_claims WHERE order_id=:id AND status NOT IN ('cancelled') LIMIT 1\", ['id'=>$order['id']])\n                || (bool)$db->fetchValue(\"SELECT l.id FROM worker_balance_ledger l WHERE l.status='effective' AND ((l.business_type IN ('order','platform_order','measurement_order','order_measurement') AND l.business_id=:id) OR (l.business_type='commission' AND l.business_id IN (SELECT id FROM commission_receivables WHERE order_id=:id)) OR (l.business_type='dispute' AND l.business_id IN (SELECT id FROM disputes WHERE order_id=:id))) LIMIT 1\", ['id'=>$order['id']]);\n            if ($blocked) {\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_execution_required',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n                // 双方已经接受取消/退款方案时，业务履约立即终止；这里只等待资金核账，不允许订单继续施工。\n                $db->execute(\n                    \"UPDATE orders\n                     SET lifecycle_status='cancel_approved_pending_refund',refund_status='pending_review',publish_status='hidden',\n                         quote_status='cancelled',assignment_status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),\n                         version=version+1,updated_at=UTC_TIMESTAMP()\n                     WHERE id=:id\",\n                    ['id'=>$order['id']]\n                );\n                $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=COALESCE(cancelled_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n                $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n                $this->event($db, (int)$order['id'], 'cancel_requested', $isWorker ? 'worker' : 'user', $isWorker ? (int)$actor['worker_id'] : (int)$actor['user_id'], [\n                    'message'=>'双方已接受退款方案，订单已停止履约；涉及资金分配或可退金额变化，需平台核账后执行退款','notify_recipients'=>['user','worker','admin'],\n                ]);\n                return ['request_id'=>$requestNo,'agreement_accepted'=>true,'execution_requires_platform'=>true];\n            }\n            $db->execute(\"UPDATE order_cancel_requests SET status='approved',reason_code='bilateral_refund_accepted',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n            return $this->approveRefund($db, $order, (int)$request['id'], $requestNo, $payments, $amount, '双方接受退款方案：'.$request['reason'], (int)$order['user_id'], true);\n        });\n    }\n\n    private function approveRefund(Database $db, array $order, int $requestId, string $requestPublicId, array $payments, int $refundAmount, string $reason, int $userId, bool $agreed = false): array\n    {\n            $refundIds = [];\n            $firstRefundId = null;\n            foreach ($payments as $payment) {\n                $amount = (int)$payment['available_cents'];\n                if ($amount < 1) continue;\n                $refundId = $db->insert(\n                    \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                     VALUES(:public_no,:payment_id,:order_id,:request_id,:amount,:reason,'pending_review',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_no'=>\\business_no('RF'),'payment_id'=>$payment['id'],'order_id'=>$order['id'],'request_id'=>$requestId,\n                        'amount'=>$amount,'reason'=>mb_substr('自动取消退款：'.$reason.'；原支付：'.(string)$payment['business_type'], 0, 1000),\n                    ]\n                );\n                if ($firstRefundId === null) $firstRefundId = $refundId;\n                $refundIds[] = $refundId;\n            }\n            if (!$refundIds) {\n                throw new OrderOperationException('当前没有可自动原路退款的实际支付，请转人工核对', 'AUTO_REFUND_PAYMENT_MISSING', 409);\n            }\n\n            // 2026-10-08：取消成立时保存失效前的报价/成交事实，与取消退款同事务提交。\n            (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order);\n\n            $db->execute(\n                \"UPDATE orders SET lifecycle_status='cancel_approved_pending_refund',refund_status='pending_review',publish_status='hidden',quote_status='cancelled',assignment_status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['id'=>$order['id']]\n            );\n            $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            $db->insert(\n                \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                 VALUES(:request_id,:order_id,'approved','user',:reason,:refund,0,:refund_id,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'request_id'=>$requestId,'order_id'=>$order['id'],\n                    'reason'=>mb_substr('系统执行已获准退款；原因：'.$reason, 0, 1000),\n                    'refund'=>$refundAmount,'refund_id'=>$firstRefundId,\n                ]\n            );\n            $this->event($db, (int)$order['id'], 'cancel_approved', 'system', 0, [\n                'refund_amount_cents'=>$refundAmount,'refund_count'=>count($refundIds),'auto_approved'=>1,\n                'requested_by_user_id'=>$userId,\n                'message'=>'系统已取消订单并登记 '.count($refundIds).' 笔原路退款，无需管理员审核',\n                'notify_recipients'=>$agreed ? ['user','worker'] : ['user'],\n            ]);\n            return ['request_id'=>$requestPublicId,'auto_approved'=>true,'refund_cents'=>$refundAmount,'refund_count'=>count($refundIds)];\n    }\n\n    public function review(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array {\n        $operation = function () use ($operator, $orderNo, $decision, $workerArrived, $responsibility, $reason, $refundCents): array {\n            return $this->reviewUnderWriteGuard($operator, $orderNo, $decision, $workerArrived, $responsibility, $reason, $refundCents);\n        };\n        if (($operator['channel'] ?? '') === 'web_admin') {\n            return (new DatabaseDemoOrderWriteGuard($this->db))->run($orderNo, $operation);\n        }\n        return $operation();\n    }\n\n    private function reviewUnderWriteGuard(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array {\n        $channel = (string)($operator['channel'] ?? '');\n        if ($channel === 'mini_admin') {\n            $operatorId = max(0, (int)($operator['user_id'] ?? 0));\n            $webAdminId = 0;\n        } elseif ($channel === 'web_admin') {\n            $operatorId = max(0, (int)($operator['admin_user_id'] ?? 0));\n            $webAdminId = $operatorId;\n        } else {\n            $operatorId = 0;\n            $webAdminId = 0;\n        }\n        if ($operatorId < 1) {\n            throw new OrderOperationException('管理员操作来源无效', 'ADMIN_REQUIRED', 403);\n        }\n        $decidedBy = $webAdminId > 0 ? $webAdminId : null;\n\n        return $this->db->transaction(function (Database $db) use ($orderNo,$decision,$workerArrived,$responsibility,$reason,$refundCents,$channel,$operatorId,$decidedBy): array {\n            $order = $db->fetch(\n                'SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $request = $db->fetch(\n                \"SELECT * FROM order_cancel_requests\n                 WHERE order_id=:order_id AND status='pending'\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id']]\n            );\n            if (!$request) {\n                throw new OrderOperationException('当前没有待审核退款申请', 'REFUND_REVIEW_CHANGED', 409);\n            }\n            if (in_array((string)$request['reason_code'], ['bilateral_refund_pending','bilateral_refund_rejected'], true)) {\n                throw new OrderOperationException('请先由订单双方申请平台介入', 'NEGOTIATION_NOT_ESCALATED', 409);\n            }\n            if ((string)$request['reason_code'] === 'bilateral_refund_execution_required') {\n                throw new OrderOperationException(\n                    '双方已经接受退款方案；当前涉及资金核账或历史入账，请到 Web 后台按真实资金记录执行，不能在小程序重新通过或拒绝',\n                    'REFUND_EXECUTION_WEB_REQUIRED',\n                    409\n                );\n            }\n\n            $needsArrival = !empty($order['assigned_worker_id'])\n                || in_array((string)($order['assignment_status'] ?? ''), ['offered','accepted','assigned'], true)\n                || in_array((string)($order['fulfillment_status'] ?? ''), ['scheduled','in_progress'], true);\n            if (!$needsArrival) $workerArrived = 'no';\n            if ($needsArrival && !in_array($workerArrived, ['yes','no'], true)) {\n                throw new OrderOperationException('请确认师傅是否已经上门', 'WORKER_ARRIVAL_REQUIRED', 422);\n            }\n            $responsibilityLabels = [\n                'worker'=>'师傅','user'=>'用户','platform'=>'平台','shared'=>'双方','unclear'=>'待定',\n            ];\n            $decisionReason = ($workerArrived === 'yes' ? '师傅已上门' : '师傅未上门')\n                .'；责任：'.$responsibilityLabels[$responsibility].'；'.$reason;\n\n            if ($decision === 'reject') {\n                $changed = $db->execute(\n                    \"UPDATE order_cancel_requests\n                     SET status='rejected',closed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                     WHERE id=:id AND status='pending'\",\n                    ['id'=>$request['id']]\n                );\n                if ($changed !== 1) {\n                    throw new OrderOperationException('退款申请状态已变化，请刷新', 'REFUND_REVIEW_CHANGED', 409);\n                }\n                $hasMeasurementLink = (bool)$db->fetchValue(\n                    \"SELECT 1 FROM order_relations\n                     WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1\",\n                    ['id'=>$order['id']]\n                );\n                $snapshot = $this->decodeSnapshot((string)($request['order_state_snapshot_json'] ?? ''));\n                $restorePublish = (string)($snapshot['publish_status'] ?? 'hidden');\n                if (!in_array($restorePublish, ['published','hidden'], true)) $restorePublish = 'hidden';\n                if ($hasMeasurementLink) $restorePublish = 'hidden';\n                $restoreRefund = (string)($snapshot['refund_status'] ?? 'none');\n                if (!in_array($restoreRefund, ['','none','failed'], true)) $restoreRefund = 'none';\n                if ($restoreRefund === '') $restoreRefund = 'none';\n                $db->execute(\n                    \"UPDATE orders\n                     SET refund_status=:refund_status,publish_status=:publish_status,\n                         updated_at=UTC_TIMESTAMP(),version=version+1\n                     WHERE id=:id\",\n                    [\n                        'refund_status'=>$restoreRefund,\n                        'publish_status'=>$restorePublish,\n                        'id'=>$order['id'],\n                    ]\n                );\n                $db->insert(\n                    \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                     VALUES(:request_id,:order_id,'rejected',:responsibility,:reason,0,0,NULL,:decided_by,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'request_id'=>$request['id'],'order_id'=>$order['id'],\n                        'responsibility'=>$responsibility,'reason'=>$decisionReason,'decided_by'=>$decidedBy,\n                    ]\n                );\n                $this->event($db, (int)$order['id'], 'cancel_rejected', $channel, $operatorId, [\n                    'message'=>'退款申请未通过：'.$decisionReason,\n                    'restored_publish_status'=>$restorePublish,\n                    'operator_channel'=>$channel,\n                    'operator_user_id'=>$channel === 'mini_admin' ? $operatorId : null,\n                    'operator_admin_id'=>$channel === 'web_admin' ? $operatorId : null,\n                    'notify_recipients'=>['user'],\n                ]);\n                return ['approved'=>false,'refund_cents'=>0,'refund_ids'=>[]];\n            }\n\n            if ($workerArrived === 'yes' && $responsibility !== 'worker') {\n                throw new OrderOperationException(\n                    '师傅已上门且不是师傅责任时，请拒绝退款并记录说明',\n                    'REFUND_ARRIVAL_RESPONSIBILITY_CONFLICT',\n                    422\n                );\n            }\n\n            $payments = $this->refundablePayments($db, $order);\n            $available = array_sum(array_map(static function (array $row): int {\n                return (int)$row['available_cents'];\n            }, $payments));\n            $requested = max(0, (int)$request['requested_refund_cents']);\n            $maxRefund = $requested > 0 ? min($available, $requested) : $available;\n            if ($maxRefund > 0 && $refundCents < 1) {\n                throw new OrderOperationException('请填写退款金额', 'REFUND_AMOUNT_REQUIRED', 422);\n            }\n            if ($refundCents > $maxRefund) {\n                throw new OrderOperationException(\n                    '退款金额超过当前可退线上余额 '.number_format($maxRefund/100, 2).' 元',\n                    'REFUND_AMOUNT_EXCEEDS_AVAILABLE',\n                    422,\n                    ['max_refund_cents'=>$maxRefund]\n                );\n            }\n\n            $remaining = $refundCents;\n            $refundIds = [];\n            $firstRefundId = null;\n            foreach ($payments as $payment) {\n                if ($remaining <= 0) break;\n                $part = min($remaining, (int)$payment['available_cents']);\n                if ($part < 1) continue;\n                $refundId = $db->insert(\n                    \"INSERT INTO refunds(public_no,payment_order_id,order_id,cancel_request_id,amount_cents,reason,status,requested_by_admin_id,requested_at,created_at,updated_at)\n                     VALUES(:public_no,:payment_id,:order_id,:request_id,:amount,:reason,'pending_review',:requested_by_admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'public_no'=>\\business_no('RF'),\n                        'payment_id'=>$payment['id'],\n                        'order_id'=>$order['id'],\n                        'request_id'=>$request['id'],\n                        'amount'=>$part,\n                        'reason'=>$decisionReason.'；原支付：'.(string)$payment['business_type'],\n                        'requested_by_admin_id'=>$decidedBy,\n                    ]\n                );\n                if ($firstRefundId === null) $firstRefundId = $refundId;\n                $refundIds[] = $refundId;\n                $remaining -= $part;\n            }\n            if ($remaining > 0) {\n                throw new OrderOperationException(\n                    '退款拆分失败，当前原支付可退余额不足，请刷新后重试',\n                    'REFUND_SPLIT_BALANCE_CHANGED',\n                    409\n                );\n            }\n\n            // 先抢占 pending 取消申请，再推进订单；网络重试或并发请求只能有一个事务成功。\n            $requestChanged = $db->execute(\n                \"UPDATE order_cancel_requests\n                 SET status=:status,requested_refund_cents=:refund,\n                     closed_at=IF(:close_now=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='pending'\",\n                [\n                    'status'=>$refundCents > 0 ? 'processing' : 'approved',\n                    'refund'=>$refundCents,\n                    'close_now'=>$refundCents > 0 ? 0 : 1,\n                    'id'=>$request['id'],\n                ]\n            );\n            if ($requestChanged !== 1) {\n                throw new OrderOperationException('退款申请状态已变化，请刷新', 'REFUND_REVIEW_CHANGED', 409);\n            }\n\n            $lifecycle = $refundCents > 0 ? 'cancel_approved_pending_refund' : 'cancelled';\n            (new DatabaseOrderCancellationRiskRepository($db))->captureCancellation($order, $responsibility);\n            $refundStatus = $refundCents > 0 ? 'pending_review' : 'none';\n            $db->execute(\n                \"UPDATE orders\n                 SET lifecycle_status=:lifecycle,refund_status=:refund_status,publish_status='hidden',\n                     quote_status='cancelled',assignment_status='cancelled',cancelled_at=UTC_TIMESTAMP(),\n                     closed_at=IF(:close_now=1,COALESCE(closed_at,UTC_TIMESTAMP()),closed_at),\n                     updated_at=UTC_TIMESTAMP(),version=version+1\n                 WHERE id=:id\",\n                [\n                    'lifecycle'=>$lifecycle,'refund_status'=>$refundStatus,\n                    'close_now'=>$refundCents > 0 ? 0 : 1,'id'=>$order['id'],\n                ]\n            );\n            $db->execute(\"UPDATE quotes SET status='cancelled',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('active','selected')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('offered','accepted')\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:id AND status='active'\", ['id'=>$order['id']]);\n            $db->execute(\"UPDATE order_deadlines SET status='cancelled',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('pending','blocked','claimed')\", ['id'=>$order['id']]);\n            $db->insert(\n                \"INSERT INTO order_cancel_decisions(cancel_request_id,order_id,decision,responsibility,reason,refund_amount_cents,run_empty_fee_cents,refund_id,decided_by,decided_at,created_at)\n                 VALUES(:request_id,:order_id,'approved',:responsibility,:reason,:refund,0,:refund_id,:decided_by,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'request_id'=>$request['id'],'order_id'=>$order['id'],'responsibility'=>$responsibility,\n                    'reason'=>$decisionReason,'refund'=>$refundCents,'refund_id'=>$firstRefundId,'decided_by'=>$decidedBy,\n                ]\n            );\n            $this->event($db, (int)$order['id'], 'cancel_approved', $channel, $operatorId, [\n                'refund_amount_cents'=>$refundCents,\n                'refund_count'=>count($refundIds),\n                'message'=>$refundCents > 0\n                    ? '退款审核通过，已按原支付单拆分为 '.count($refundIds).' 笔微信退款'\n                    : '取消申请通过，无线上款项需退',\n                'operator_channel'=>$channel,\n                'operator_user_id'=>$channel === 'mini_admin' ? $operatorId : null,\n                'operator_admin_id'=>$channel === 'web_admin' ? $operatorId : null,\n                'notify_recipients'=>['user'],\n            ]);\n            return ['approved'=>true,'refund_cents'=>$refundCents,'refund_ids'=>$refundIds];\n        });\n    }\n\n    /** @return array<int,array<string,mixed>> */\n    private function refundablePayments(Database $db, array $order): array\n    {\n        $measurement = (string)($order['workflow_profile'] ?? 'construction') === 'measurement';\n        $types = $measurement ? ['order_booking','booking_fee','measurement_balance','measurement_change'] : ['order_booking','booking_fee'];\n        $marks = [];\n        $params = ['order_id'=>$order['id']];\n        foreach ($types as $index=>$type) {\n            $key = 'type_'.$index;\n            $marks[] = ':'.$key;\n            $params[$key] = $type;\n        }\n        $rows = $db->fetchAll(\n            \"SELECT * FROM payment_orders WHERE order_id=:order_id AND business_type IN (\".implode(',', $marks).\") AND status IN ('paid','refunded')\n             ORDER BY CASE business_type WHEN 'measurement_change' THEN 1 WHEN 'measurement_balance' THEN 2 WHEN 'booking_fee' THEN 3 WHEN 'order_booking' THEN 4 ELSE 9 END,id DESC FOR UPDATE\",\n            $params\n        );\n        $runnerRemaining = (int)$db->fetchValue(\n            \"SELECT COALESCE(SUM(l.amount_cents),0) FROM worker_balance_ledger l\n             INNER JOIN disputes d ON d.id=l.business_id\n             WHERE l.business_type='dispute' AND l.entry_type='run_empty_fee' AND l.status='effective' AND d.order_id=:order_id\",\n            ['order_id'=>$order['id']]\n        );\n        $result = [];\n        foreach ($rows as $row) {\n            $refundAllocated = (int)$db->fetchValue(\n                \"SELECT COALESCE(SUM(amount_cents),0) FROM refunds WHERE payment_order_id=:payment_id AND status NOT IN ('failed','closed','cancelled','rejected')\",\n                ['payment_id'=>$row['id']]\n            );\n            $cap = max(0, (int)$row['amount_cents']);\n            if (in_array((string)$row['business_type'], ['order_booking','booking_fee'], true)) {\n                if ((int)($order['booking_fee_cents'] ?? 0) > 0) $cap = min($cap, (int)$order['booking_fee_cents']);\n                $runnerApplied = min($cap, max(0, $runnerRemaining));\n                $runnerRemaining = max(0, $runnerRemaining - $runnerApplied);\n            } else {\n                $runnerApplied = 0;\n            }\n            $available = max(0, $cap - $refundAllocated - $runnerApplied);\n            if ($available < 1) continue;\n            $row['available_cents'] = $available;\n            $result[] = $row;\n        }\n        return $result;\n    }\n\n    private function canAutoApproveBeforeService(Database $db, array $order): bool\n    {\n        if ((string)($order['order_source_type'] ?? 'consumer') !== 'consumer') return false;\n        if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) return false;\n        if (!empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) return false;\n        if (!empty($order['contact_revealed_at']) || !empty($order['completion_submitted_at']) || !empty($order['accepted_at'])) return false;\n        if (in_array((string)($order['fulfillment_status'] ?? ''), ['scheduled','in_progress','submitted','accepted'], true)) return false;\n\n        $blocked = (int)$db->fetchValue(\n            \"SELECT (\n                EXISTS(SELECT 1 FROM assignments WHERE order_id=:a LIMIT 1)\n                OR EXISTS(SELECT 1 FROM quote_selections WHERE order_id=:q LIMIT 1)\n                OR EXISTS(SELECT 1 FROM appointment_records WHERE order_id=:ap LIMIT 1)\n                OR EXISTS(SELECT 1 FROM change_requests WHERE order_id=:c LIMIT 1)\n                OR EXISTS(SELECT 1 FROM disputes WHERE order_id=:d LIMIT 1)\n                OR EXISTS(SELECT 1 FROM after_sales WHERE order_id=:s LIMIT 1)\n                OR EXISTS(SELECT 1 FROM run_empty_fee_claims WHERE order_id=:r LIMIT 1)\n            ) AS blocked\",\n            ['a'=>$order['id'],'q'=>$order['id'],'ap'=>$order['id'],'c'=>$order['id'],'d'=>$order['id'],'s'=>$order['id'],'r'=>$order['id']]\n        );\n        return $blocked === 0;\n    }\n\n    /** @return array<string,mixed> */\n    private function decodeSnapshot(string $json): array\n    {\n        $decoded = json_decode($json, true);\n        return is_array($decoded) ? $decoded : [];\n    }\n\n    private function snapshot(array $order): string\n    {\n        $json = json_encode([\n            'lifecycle_status'=>$order['lifecycle_status'] ?? null,\n            'fulfillment_status'=>$order['fulfillment_status'] ?? null,\n            'payment_status'=>$order['payment_status'] ?? null,\n            'workflow_profile'=>$order['workflow_profile'] ?? null,\n            'order_source_type'=>$order['order_source_type'] ?? null,\n            'refund_status'=>$order['refund_status'] ?? null,\n            'publish_status'=>$order['publish_status'] ?? null,\n            'quote_status'=>$order['quote_status'] ?? null,\n            'assignment_status'=>$order['assignment_status'] ?? null,\n            'selected_quote_id'=>$order['selected_quote_id'] ?? null,\n            'assigned_worker_id'=>$order['assigned_worker_id'] ?? null,\n        ], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        return is_string($json) ? $json : '{}';\n    }\n\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey = $type.':'.$orderId.':'.bin2hex(random_bytes(6));\n        $db->insert(\n            'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$eventKey,'actor_type'=>$actorType,\n                'actor_id'=>$actorId > 0 ? $actorId : null,\n                'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        OrderNotificationService::queue($db, $orderId, $eventKey, $type, $payload);\n    }\n}\n","server/app/Infrastructure/Messaging/OrderNotificationProjector.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\OrderMessageDefinition;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\nuse WorkerAdmin\\Infrastructure\\Testing\\TestMessageProjectionRecorder;\n\nfinal class OrderNotificationProjector\n{\n\n    public static function queueAdminTask(Database $db,string $eventKey,string $eventType,string $title,array $lines=[]):void\n    {\n        // 与订单事件的 demo 隔离保持一致：带订单号的演示/测试订单绝不能进入真实企业微信管理员待办。\n        // 无订单号的入驻、提现等独立业务仍沿用原有通知逻辑。\n        $orderNo=trim((string)($lines['订单号']??''));\n        if($orderNo!==''){\n            $isDemo=(int)$db->fetchValue('SELECT COALESCE(is_demo,0) FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);\n            if($isDemo===1)return;\n        }\n        if(!self::eventEnabled('wecom.event_switches',$eventType)||!\\filter_var(\\setting('wecom.webhook_enabled',false),FILTER_VALIDATE_BOOLEAN))return;\n        // 2026-09-22：机器人首行直接显示具体事项标题，不再套“壁选后台待办”等笼统标题。\n        $title=trim((string)(preg_replace('/[\\\\r\\\\n【】]+/u',' ',$title)??''));\n        if($title==='')$title=$eventType;\n        $title=mb_substr($title,0,40);\n        $content='【'.$title.'】';\n        foreach($lines as $label=>$value){$value=trim((string)$value);if($value!=='')$content.=\"\\n\".$label.'：'.$value;}\n        $orderId=0;\n        if(isset($lines['订单号'])&&trim((string)$lines['订单号'])!==''){\n            $orderId=(int)$db->fetchValue('SELECT id FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>(string)$lines['订单号']]);\n        }\n        $data=['content'=>$content,'event_type'=>$eventType,'title'=>$title,'action_path'=>self::adminActionPath($eventType,$orderId)];\n        $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wecom_webhook',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':admin:wecom',0,128),'payload'=>json_encode($data,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n    }\n\n    public static function queue(Database $db, int $orderId, string $eventKey, string $eventType, array $payload = []): void\n    {\n        $definition = OrderMessageDefinition::definition($eventType, $payload); if (!$definition) return;\n        $order = $db->fetch(\"SELECT o.public_no,o.user_id,o.assigned_worker_id,o.final_amount_cents,o.booking_fee_cents,o.is_demo,u.mobile_ciphertext user_mobile FROM orders o JOIN users u ON u.id=o.user_id WHERE o.id=:id\", ['id'=>$orderId]);\n        if (!$order) return;\n        $parameters = ['order_no'=>(string)$order['public_no'],'status'=>$definition['status'],'amount'=>number_format(((int)($definition['amount_cents'] ?? $order['final_amount_cents']))/100,2,'.',''),'time'=>date('Y-m-d H:i')];\n        // 内部通知是基础渠道，可单独关闭某类进度消息；不影响外部通知。\n        if (self::eventEnabled('notification.internal_event_switches', $eventType)) {\n            $noticeData = json_encode(['order_id' => (int) $orderId, 'event_key' => $eventKey], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n            foreach ($definition['recipients'] as $recipientType) {\n                if (!in_array($recipientType, ['user', 'worker'], true)) continue;\n                $recipientId = $recipientType === 'user' ? (int) $order['user_id'] : (int) ($order['assigned_worker_id'] ?? 0);\n                if ($recipientId < 1) continue;\n                $content = '订单 ' . $parameters['order_no'] . '：' . $definition['status'];\n                if (!empty($definition['amount_cents'])) $content .= '，金额 ' . $parameters['amount'] . ' 元';\n                $duplicate = $db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type=:recipient_type AND recipient_id=:recipient_id AND channel='in_app' AND template_key=:template_key AND BINARY data_json=BINARY :data_json LIMIT 1\", [\n                    'recipient_type' => $recipientType, 'recipient_id' => $recipientId, 'template_key' => $eventType, 'data_json' => $noticeData,\n                ]);\n                if (!$duplicate) {\n                    $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,:recipient_type,:recipient_id,'in_app',:template_key,:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\", [\n                        'public_id' => \\public_id(), 'recipient_type' => $recipientType, 'recipient_id' => $recipientId,\n                        'template_key' => $eventType, 'title' => $definition['status'], 'content' => $content, 'data' => $noticeData,\n                    ]);\n                }\n            }\n        }\n        // V2.2.7：演示订单只落站内消息，绝不进入企业微信、微信订阅或短信发件箱。\n        // 测试中心订单额外记录“应发但未真实投递”的模拟投影，不复用真实 message_outbox。\n        if(!empty($order['is_demo'])){\n            try{\n                TestMessageProjectionRecorder::capture($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters);\n            }catch(\\Throwable $exception){\n                \\write_log('test-center','['.date('c').'] message_projection_failed order_id='.$orderId.' event='.str_replace([\"\\r\",\"\\n\"],' ',$eventType).' '.$exception->getMessage().\"\\n\");\n            }\n            return;\n        }\n        // 2026-09-02：管理员通知独立进入企业微信机器人，不读取或发送管理员短信号码。\n        if (in_array('admin', $definition['recipients'], true) && self::eventEnabled('wecom.event_switches', $eventType)\n            && \\filter_var(\\setting('wecom.webhook_enabled', false), FILTER_VALIDATE_BOOLEAN)) {\n            $adminTitle=trim((string)($definition['admin_title']??$definition['status']??''));\n            $adminTitle=trim((string)(preg_replace('/[\\\\r\\\\n【】]+/u',' ',$adminTitle)??''));\n            if($adminTitle==='')$adminTitle=$eventType;\n            $adminTitle=mb_substr($adminTitle,0,40);\n            $content = \"【{$adminTitle}】\\n订单号：{$parameters['order_no']}\\n时间：{$parameters['time']}\";\n            if ((string)$definition['status'] !== $adminTitle) $content .= \"\\n状态：{$definition['status']}\";\n            if (!empty($definition['amount_cents'])) $content .= \"\\n金额：{$parameters['amount']} 元\";\n            $adminData=['content'=>$content,'event_type'=>$eventType,'order_id'=>$orderId,'title'=>$adminTitle,'action_path'=>self::adminActionPath($eventType,$orderId,(string)$order['public_no'])];\n            $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wecom_webhook',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':admin:wecom',0,128),'payload'=>json_encode($adminData,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        }\n        // 2026-10-01：外部触达分两种模式：\n        // 1) 建议/普通短信仍按开关独立发送；\n        // 2) “订阅补充短信”改为微信订阅优先，只有订阅不可用或最终失败时才进入短信队列。\n        $smsEnabled=\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('sms.event_switches',$eventType);\n        $eventMeta=MessageEventCatalog::get($eventType)??[];\n        $fallbackMode=$smsEnabled && (($eventMeta['sms_delivery_mode']??'independent')==='subscription_fallback');\n        $fallbackPayload=$fallbackMode\n            ? OrderSubscriptionQueue::buildSubscriptionFallbackSmsPayload($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters)\n            : null;\n        $subscription=OrderSubscriptionQueue::queueOrderSubscription(\n            $db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,\n            is_array($fallbackPayload)?$fallbackPayload:[]\n        );\n        // 同一事件对用户和师傅的外部提醒语义可能不同。若事件需要师傅及时知道、\n        // 但主订阅场景并不是师傅场景，则额外使用通用“师傅订单重要进度”模板补一条微信提醒。\n        OrderSubscriptionQueue::queueWorkerOrderUpdateSupplement($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$fallbackMode);\n        if($fallbackMode){\n            if(empty($subscription['queued'])&&is_array($fallbackPayload)){\n                $fallbackPayload['fallback_reason']=(string)($subscription['reason']??'subscription_unavailable');\n                OrderSubscriptionQueue::enqueueSmsFallback($db,$fallbackPayload);\n            }\n            return;\n        }\n\n        if(!$smsEnabled)return;\n        $templates=\\setting('sms.template_codes',[]);if(!is_array($templates))return;\n        $configured=$templates[$definition['scene']]??'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        if($templateCode==='')return;\n        $recipients=[];\n        foreach($definition['recipients'] as $recipient){\n            if($recipient==='user'){$mobile=\\decrypt_private_value((string)$order['user_mobile'],'user-mobile');if($mobile!=='')$recipients['user:'.(int)$order['user_id']]=[$mobile,'user',(int)$order['user_id']];}\n            elseif($recipient==='worker'&&!empty($order['assigned_worker_id'])){$row=$db->fetch('SELECT mobile_ciphertext FROM worker_profiles WHERE id=:id',['id'=>$order['assigned_worker_id']]);$mobile=$row?\\decrypt_private_value((string)$row['mobile_ciphertext'],'worker-mobile'):'';if($mobile!=='')$recipients['worker:'.(int)$order['assigned_worker_id']]=[$mobile,'worker',(int)$order['assigned_worker_id']];}\n        }\n        foreach($recipients as $key=>$recipient){\n            $data=['mobile'=>$recipient[0],'template_code'=>$templateCode,'parameters'=>$parameters,'event_type'=>$eventType,'order_id'=>$orderId,'recipient_type'=>$recipient[1],'recipient_id'=>$recipient[2]];\n            $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('aliyun_sms',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($eventKey.':'.$key,0,128),'payload'=>json_encode($data,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        }\n    }\n\n    public static function adminActionPath(string $eventType, int $orderId=0, string $orderNo=''): ?string\n    {\n        $routes=[\n            'platform_worker_quoted'=>'platform-orders',\n            'platform_change_requested'=>'platform-order-finance',\n            'merchant_auth_submitted'=>'merchants',\n            'worker_profile_submitted'=>'workers',\n            'worker_realname_submitted'=>'worker-credentials',\n            'worker_collection_code_submitted'=>'worker-credentials',\n            'worker_collection_code_auto_approved'=>'worker-credentials',\n            'withdrawal_submitted'=>'withdrawals',\n            'commission_overdue'=>'commissions',\n        ];\n        if (in_array($eventType, ['platform_measurement_auto_confirmed','platform_measurement_confirmed'], true) && $orderId > 0) {\n            return $orderNo !== '' ? '/admin/?route=platform-orders.pricing-review&order_no='.rawurlencode($orderNo) : '/admin/?route=platform-orders';\n        }\n        if(isset($routes[$eventType]))return '/admin/?route='.$routes[$eventType];\n        if($orderId>0)return '/admin/?route=orders.view&id='.$orderId;\n        return null;\n    }\n\n    public static function queueWorkerWithdrawalResult(Database $db,int $workerId,string $withdrawalNo,string $status,string $note='',int $amountCents=0):void\n    {\n        if($workerId<1||$withdrawalNo==='')return;\n        $labels=[\n            'approved'=>['提现审核通过','提现申请已审核通过，等待平台登记付款。'],\n            'rejected'=>['提现申请未通过','提现申请未通过，冻结金额已退回可用余额。'],\n            'paid'=>['提现已付款','平台已登记人工付款，请核对支付宝到账情况。'],\n            'payment_failed'=>['提现付款失败','人工付款未完成，请查看处理说明或等待平台重新处理。'],\n        ];\n        if(!isset($labels[$status]))return;\n        [$title,$content]=$labels[$status];\n        if($amountCents>0)$content.=' 金额 '.number_format($amountCents/100,2,'.','').' 元。';\n        $note=trim($note);if($note!=='')$content.=' 说明：'.mb_substr($note,0,120);\n        $data=json_encode(['withdrawal_no'=>$withdrawalNo,'status'=>$status],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $duplicate=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='withdrawal_result' AND BINARY data_json=BINARY :data LIMIT 1\",['worker_id'=>$workerId,'data'=>$data]);\n        if($duplicate)return;\n        $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:worker_id,'in_app','withdrawal_result',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n            'public_id'=>\\public_id(),'worker_id'=>$workerId,'title'=>$title,'content'=>$content,'data'=>$data,\n        ]);\n    }\n\n    public static function queueWorkerReviewResult(Database $db, int $workerId, string $cloudId, string $decision, string $reason, string $workerName=''): void\n    {\n        if ($workerId < 1) return;\n        $row = $db->fetch(\"SELECT w.user_id,w.display_name,u.mobile_ciphertext,(SELECT wi.openid FROM wechat_identities wi WHERE wi.user_id=w.user_id AND wi.status='active' ORDER BY wi.id DESC LIMIT 1) openid FROM worker_profiles w JOIN users u ON u.id=w.user_id WHERE w.id=:id LIMIT 1\", ['id'=>$workerId]);\n        if (!$row) return;\n        $labels=['approved'=>'审核通过','rejected'=>'审核未通过','suspended'=>'接单已暂停','pending'=>'等待审核'];\n        $status=$labels[$decision]??'审核状态已更新';\n        $dataJson=json_encode(['cloud_id'=>$cloudId,'review_status'=>$decision],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $duplicate=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:id AND channel='in_app' AND template_key='worker_profile_review_result' AND BINARY data_json=BINARY :data LIMIT 1\",['id'=>$workerId,'data'=>$dataJson]);\n        if(!$duplicate)$db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:recipient_id,'in_app','worker_profile_review_result',:title,:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>\\public_id(),'recipient_id'=>$workerId,'title'=>'师傅入驻'.$status,'content'=>$reason!==''?$status.'：'.mb_substr($reason,0,80):$status,'data'=>$dataJson]);\n        if(!in_array($decision,['approved','rejected','suspended'],true))return;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes['reviewResult'];$userId=(int)$row['user_id'];$pref=SubscriptionQuotaStore::subscriptionPreferences($db,$userId)['reviewResult']??[];\n        if(empty($scene['available']))return;\n        $authorizationStatus=(string)($pref['authorization_status']??'');\n        $subscriptionType=(string)($scene['subscription_type']??'one_time');\n        if($subscriptionType==='one_time'){\n            if(in_array($authorizationStatus,['ban','disabled'],true))return;\n            if(max(0,(int)($pref['remaining_count']??0))<1)return;\n        }else{\n            if(empty($pref['enabled'])||!in_array($authorizationStatus,['accept','acceptWithAudio','acceptWithAlert'],true))return;\n        }\n        $openid=trim((string)$row['openid']);$mobile=\\decrypt_private_value((string)$row['mobile_ciphertext'],'user-mobile');if($openid===''||$mobile==='')return;\n        $name=mb_substr(trim($workerName)!==''?trim($workerName):(string)$row['display_name'],0,10);\n        $thing=$decision==='approved'?'入驻审核已通过，请进入小程序查看。':($decision==='rejected'?'入驻审核未通过，请按处理说明修改。':'师傅接单状态已暂停，请查看处理说明。');\n        if($reason!=='')$thing=mb_substr($thing.' '.trim($reason),0,20);\n        OrderSubscriptionQueue::enqueueWechatSubscribe($db,'worker-review:'.$cloudId.':'.$decision.':'.gmdate('YmdHi'),$userId,'reviewResult',$openid,(string)$scene['template_id'],'pages/record/detail?id='.rawurlencode($cloudId),[\n            'name1'=>['value'=>$name?:'入驻师傅'],\n            'phone_number2'=>['value'=>$mobile],\n            'phrase3'=>['value'=>$status],\n            'thing5'=>['value'=>$thing],\n        ]);\n    }\n\n    public static function eventEnabled(string $settingKey, string $eventType): bool\n    {\n        $channel = strpos($settingKey, 'wecom.') === 0 ? 'wecom' : (strpos($settingKey, 'notification.') === 0 ? 'inapp' : 'sms');\n        $configured = \\setting($settingKey, []);\n        return MessageEventCatalog::enabled($channel, $eventType, is_array($configured) ? $configured : []);\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseDemoOrderWriteGuard.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\nfinal class DatabaseDemoOrderWriteGuard\n{\n    private Database $db;\n\n    public function __construct(Database $db) { $this->db = $db; }\n\n    public function run(string $orderNo, callable $operation): array\n    {\n        $params = ['lock_name'=>'wall_worker_admin_demo_guard'];\n        if ((int)$this->db->fetchValue('SELECT GET_LOCK(:lock_name,5)', $params) !== 1) {\n            throw new OrderOperationException('演示数据设置正在变更，请稍后重试。', 'DEMO_SETTING_BUSY', 409);\n        }\n        try {\n            // Locking read bypasses the HTTP settings cache and any earlier transaction snapshot.\n            $setting = $this->db->fetch(\n                \"SELECT setting_value FROM system_settings WHERE setting_key='demo.data_enabled' LOCK IN SHARE MODE\"\n            );\n            $enabled = !$setting || in_array(strtolower((string)$setting['setting_value']), ['1','true','yes','on'], true);\n            if (!$enabled) {\n                $order = $this->db->fetch(\n                    'SELECT is_demo,public_no FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',\n                    ['public_no'=>$orderNo]\n                );\n                if ($order && (!empty($order['is_demo']) || stripos((string)$order['public_no'], 'DEMO') !== false)) {\n                    throw new OrderOperationException('演示数据已关闭，该演示记录不可继续处理。', 'DEMO_DATA_DISABLED', 403);\n                }\n            }\n            return $operation();\n        } finally {\n            try { $this->db->fetchValue('SELECT RELEASE_LOCK(:lock_name)', $params); }\n            catch (Throwable $exception) { /* Connection close also releases the advisory lock. */ }\n        }\n    }\n}\n","server/app/Infrastructure/Testing/TestMessageProjectionRecorder.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Testing;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionCatalog;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\n\n/**\n * 测试订单消息投影记录器。\n *\n * 只记录“本来会尝试什么渠道”的测试证据，不写真实 message_outbox，\n * 不读取/保存手机号、OpenID、Webhook 等敏感投递地址。\n */\nfinal class TestMessageProjectionRecorder\n{\n    public static function capture(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters): void\n    {\n        if(!TestingEnvironmentPolicy::active()||!$db->tableExists('test_message_outbox'))return;\n        $instanceId=self::resolveInstanceId($db,$orderId);\n        if($instanceId<1)return;\n\n        $meta=MessageEventCatalog::get($eventType)??[];\n        foreach((array)($definition['recipients']??[]) as $recipientType){\n            if(!in_array($recipientType,['user','worker'],true))continue;\n            $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n            if($recipientId<1)continue;\n            $inappEnabled=self::eventEnabled('notification.internal_event_switches','inapp',$eventType);\n            self::record($db,$instanceId,$orderId,$eventKey,$eventType,'in_app',$recipientType,$recipientId,\n                $inappEnabled?'delivered':'config_disabled',$inappEnabled?'notification_created_or_deduplicated':'event_switch_disabled',\n                (string)($definition['scene']??''),[\n                    'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                    'amount'=>(string)($parameters['amount']??''),'delivery_mode'=>'internal',\n                ]);\n        }\n\n        self::captureSubscription($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$meta);\n        self::captureSms($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$order,$parameters,$meta);\n        self::captureWecom($db,$instanceId,$orderId,$eventKey,$eventType,$definition,$parameters,$meta);\n    }\n\n    private static function captureSubscription(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,array $meta): void\n    {\n        $sceneKey=trim((string)($meta['subscription_scene']??''));\n        if($sceneKey==='')return;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();\n        $scene=$scenes[$sceneKey]??null;\n        $recipientType=is_array($scene)?(string)($scene['recipient']??'user'):'user';\n        if(!in_array($recipientType,(array)($definition['recipients']??[]),true))return;\n        $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n        if($recipientId<1)return;\n        $available=is_array($scene)&&!empty($scene['available'])&&!empty($scene['field_map']);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wechat_subscribe',$recipientType,$recipientId,\n            $available?'demo_suppressed':'config_disabled',\n            $available?'demo_order_external_delivery_suppressed':(string)($scene['availability_reason']??'scene_unavailable'),\n            $sceneKey,[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'subscription_type'=>(string)($scene['subscription_type']??''),'eligibility'=>'quota_and_authorization_not_consumed',\n            ]);\n\n        if($recipientType==='worker'||!in_array('worker',(array)($definition['recipients']??[]),true)||(int)($order['assigned_worker_id']??0)<1)return;\n        $important=((string)($meta['priority']??'normal')==='important')||$eventType==='worker_assigned';\n        if(!$important)return;\n        $supplement=$scenes['worker_order_update']??null;\n        $supplementAvailable=is_array($supplement)&&!empty($supplement['available'])&&!empty($supplement['field_map']);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wechat_subscribe','worker',(int)$order['assigned_worker_id'],\n            $supplementAvailable?'demo_suppressed':'config_disabled',\n            $supplementAvailable?'demo_order_external_delivery_suppressed':(string)($supplement['availability_reason']??'scene_unavailable'),\n            'worker_order_update',[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'supplement'=>true,'eligibility'=>'quota_and_authorization_not_consumed',\n            ]);\n    }\n\n    private static function captureSms(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,array $meta): void\n    {\n        if(empty($meta['sms_visible']))return;\n        $enabled=\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('sms.event_switches','sms',$eventType);\n        $templates=\\setting('sms.template_codes',[]);\n        $configured=is_array($templates)?($templates[(string)($definition['scene']??'')]??''):'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        $deliveryMode=(string)($meta['sms_delivery_mode']??'independent');\n        if(!$enabled||$templateCode===''){\n            $status='config_disabled';\n            $reason=$enabled?'template_missing':'channel_or_event_disabled';\n        }elseif($deliveryMode==='subscription_fallback'){\n            $status='not_run';\n            $reason='subscription_fallback_not_triggered_in_demo';\n        }else{\n            $status='demo_suppressed';\n            $reason='demo_order_external_delivery_suppressed';\n        }\n        foreach((array)($definition['recipients']??[]) as $recipientType){\n            if(!in_array($recipientType,['user','worker'],true))continue;\n            $recipientId=$recipientType==='user'?(int)($order['user_id']??0):(int)($order['assigned_worker_id']??0);\n            if($recipientId<1)continue;\n            self::record($db,$instanceId,$orderId,$eventKey,$eventType,'aliyun_sms',$recipientType,$recipientId,$status,$reason,(string)($definition['scene']??''),[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n                'delivery_mode'=>$deliveryMode,'template_configured'=>$templateCode!=='',\n            ]);\n        }\n    }\n\n    private static function captureWecom(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,array $definition,array $parameters,array $meta): void\n    {\n        if(!in_array('admin',(array)($definition['recipients']??[]),true)||empty($meta['wecom_visible']))return;\n        $enabled=\\filter_var(\\setting('wecom.webhook_enabled',false),FILTER_VALIDATE_BOOLEAN)\n            && self::eventEnabled('wecom.event_switches','wecom',$eventType);\n        self::record($db,$instanceId,$orderId,$eventKey,$eventType,'wecom_webhook','admin',0,\n            $enabled?'demo_suppressed':'config_disabled',$enabled?'demo_order_external_delivery_suppressed':'channel_or_event_disabled',\n            (string)($definition['scene']??''),[\n                'status'=>(string)($definition['status']??''),'order_no'=>(string)($parameters['order_no']??''),\n            ]);\n    }\n\n    private static function resolveInstanceId(Database $db,int $orderId): int\n    {\n        $direct=(int)$db->fetchValue(\"SELECT ti.id FROM test_instances ti JOIN orders o ON o.id=ti.order_id WHERE ti.order_id=:id AND o.is_demo=1 AND ti.deleted_at IS NULL LIMIT 1\",['id'=>$orderId]);\n        if($direct>0)return $direct;\n        if(!$db->tableExists('order_relations'))return 0;\n        return(int)$db->fetchValue(\"SELECT ti.id FROM order_relations r JOIN test_instances ti ON ti.order_id=r.parent_order_id JOIN orders child_order ON child_order.id=r.child_order_id WHERE r.child_order_id=:id AND r.relation_type='measurement_construction' AND r.status='active' AND child_order.is_demo=1 AND ti.deleted_at IS NULL LIMIT 1\",['id'=>$orderId]);\n    }\n\n    private static function eventEnabled(string $settingKey,string $channel,string $eventType): bool\n    {\n        $configured=\\setting($settingKey,[]);\n        return MessageEventCatalog::enabled($channel,$eventType,is_array($configured)?$configured:[]);\n    }\n\n    private static function record(Database $db,int $instanceId,int $orderId,string $eventKey,string $eventType,string $channel,string $recipientType,int $recipientId,string $status,string $reason,string $sceneKey,array $payload): void\n    {\n        $businessIdentity=$eventKey.':'.$channel.':'.$recipientType.':'.$recipientId.':'.$sceneKey;\n        // Keep long event keys distinct: a raw 190-byte prefix can silently collide under INSERT IGNORE.\n        $businessKey=strlen($businessIdentity)<=190?$businessIdentity:substr($businessIdentity,0,125).':'.hash('sha256',$businessIdentity);\n        $db->execute(\"INSERT IGNORE INTO test_message_outbox(instance_id,order_id,business_key,event_key,event_type,channel,recipient_type,recipient_id,scene_key,projection_status,reason_code,payload_json,created_at) VALUES(:instance,:order_id,:business_key,:event_key,:event_type,:channel,:recipient_type,:recipient_id,:scene_key,:status,:reason,:payload,UTC_TIMESTAMP())\",[\n            'instance'=>$instanceId,'order_id'=>$orderId,'business_key'=>$businessKey,'event_key'=>substr($eventKey,0,160),\n            'event_type'=>substr($eventType,0,120),'channel'=>$channel,'recipient_type'=>$recipientType,'recipient_id'=>$recipientId>0?$recipientId:null,\n            'scene_key'=>substr($sceneKey,0,80),'status'=>$status,'reason'=>substr($reason,0,120),\n            'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n        ]);\n    }\n}\n","server/app/Contracts/OrderDisputeRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderDisputeRepository\n{\n    /** @param array<string,mixed> $actor @param string[] $evidenceIds @return array<string,mixed> */\n    public function startNegotiation(array $actor, string $orderNo, string $description, array $evidenceIds): array;\n\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function escalate(array $actor, string $disputeNo, string $note): array;\n\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function resolveByAgreement(array $actor, string $disputeNo, string $note): array;\n\n    /**\n     * @param array<string,mixed> $operator 带 channel 的管理员描述符；mini_admin 只能零金额结案，web_admin 可做资金裁定。\n     * @return array<string,mixed>\n     */\n    public function resolveByAdmin(\n        array $operator,\n        string $orderNo,\n        string $resolution,\n        string $responsibility,\n        int $refundCents = 0,\n        int $runEmptyCents = 0\n    ): array;\n}\n","server/app/Contracts/OrderCancellationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCancellationRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array<string,mixed>\n     */\n    public function request(array $actor, string $orderNo, string $reason, string $reasonCode): array;\n\n    /**\n     * @param array<string,mixed> $operator 带 channel 的管理员描述符：mini_admin 使用 users.id，仅写 typed event；web_admin 使用 admin_users.id，可写 decided_by/requested_by_admin_id。\n     * @return array<string,mixed>\n     */\n    public function review(\n        array $operator,\n        string $orderNo,\n        string $decision,\n        string $workerArrived,\n        string $responsibility,\n        string $reason,\n        int $refundCents\n    ): array;\n}\n","server/app/Domain/Order/RepairInterventionPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\n\n/** 售后维修先由双方处理；师傅拒绝或超时后才允许升级平台。 */\nfinal class RepairInterventionPolicy\n{\n    public const WAIT_HOURS = 48;\n\n    /** @return array{eligible:bool,reason:string,available_at:?string,wait_hours:int} */\n    public static function evaluate(\n        string $status,\n        ?string $resolution,\n        ?string $openedAt,\n        string $timezone = 'UTC',\n        ?DateTimeImmutable $now = null\n    ): array {\n        $status = trim($status);\n        $resolution = trim((string)$resolution);\n        $openedAt = trim((string)$openedAt);\n        $result = ['eligible'=>false,'reason'=>'not_active','available_at'=>null,'wait_hours'=>self::WAIT_HOURS];\n\n        if (!in_array($status, ['open','processing'], true)) return $result;\n        if (strpos($resolution, '用户申请平台介入') === 0) {\n            $result['reason'] = 'already_escalated';\n            return $result;\n        }\n        if (strpos($resolution, '师傅拒绝维修') === 0) {\n            $result['eligible'] = true;\n            $result['reason'] = 'worker_rejected';\n            return $result;\n        }\n        if ($openedAt === '') {\n            $result['reason'] = 'opened_at_missing';\n            return $result;\n        }\n\n        try {\n            $zone = new DateTimeZone($timezone !== '' ? $timezone : 'UTC');\n            $opened = new DateTimeImmutable($openedAt, $zone);\n            $available = $opened->modify('+'.self::WAIT_HOURS.' hours');\n            $current = $now ?: new DateTimeImmutable('now', $zone);\n            $result['available_at'] = $available->format('Y-m-d H:i');\n            $result['eligible'] = $current >= $available;\n            $result['reason'] = $result['eligible'] ? 'response_timeout' : 'waiting_worker';\n            return $result;\n        } catch (Throwable $exception) {\n            $result['reason'] = 'opened_at_invalid';\n            return $result;\n        }\n    }\n}\n","server/app/Contracts/OrderRepairInterventionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderRepairInterventionRepository\n{\n    /** @param array<string,mixed> $actor @return array<string,mixed> */\n    public function request(array $actor, string $orderNo, string $afterSaleNo, string $note): array;\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCancellationRiskRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\OrderCancellationRiskRepository;\nuse WorkerAdmin\\Domain\\Order\\CancellationRiskPolicy;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\n/** 2026-10-08：取消事实、原预约/取证信号与下单限制共用账号锁；不改变原退款执行器。 */\nfinal class DatabaseOrderCancellationRiskRepository implements OrderCancellationRiskRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db) { $this->db = $db; }\n\n    public function configuration(): array\n    {\n        $raw = $this->db->fetchValue('SELECT setting_value FROM system_settings WHERE setting_key=:key', ['key'=>'order.cancellation_risk']);\n        $input = json_decode((string)$raw, true);\n        return CancellationRiskPolicy::config(is_array($input) ? $input : []);\n    }\n\n    public function user(int $userId): ?array\n    { return $this->db->fetch('SELECT id,public_id,nickname FROM users WHERE id=:id', ['id'=>$userId]); }\n\n    public function saveConfiguration(array $rules): void\n    {\n        $this->db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,description,is_public,created_at,updated_at)\n            VALUES('order.cancellation_risk',:value,'json','order','频繁取消下单风控',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n            ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),updated_at=UTC_TIMESTAMP()\",\n            ['value'=>json_encode(CancellationRiskPolicy::config($rules),JSON_UNESCAPED_UNICODE)]);\n    }\n\n    public function state(int $userId): array\n    {\n        $row = $this->db->fetch('SELECT blocked_until,last_restriction_id,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n        $active = $row && !empty($row['blocked_until']) && $row['blocked_until'] > $row['now_utc'];\n        $until = $active ? (string)$row['blocked_until'] : null;\n        $local = $until ? (new \\DateTimeImmutable($until, new \\DateTimeZone('UTC')))->setTimezone(new \\DateTimeZone('Asia/Shanghai'))->format('Y-m-d H:i') : null;\n        return ['restricted'=>(bool)$active, 'expires_at_utc'=>$until, 'expires_at'=>$local,\n            'message'=>$active ? '当前已暂停新下单，将于'.$local.'自动恢复。如有误判，请联系客服核实解除。' : '',\n            'restriction_id'=>$active ? (int)$row['last_restriction_id'] : null];\n    }\n\n    // 调用方已有订单锁时按“订单→账号”顺序；草稿创建只锁账号，不锁其它已有订单。\n    public function assertCanSubmit(int $userId, ?array $order = null): void\n    {\n        if ($order !== null && !$this->eligible($order)) return;\n        $this->db->transaction(function () use ($userId): void {\n            $this->lockAccount($userId);\n            $state = $this->state($userId);\n            if ($state['restricted']) throw new OrderOperationException($state['message'], 'ORDER_SUBMISSION_RESTRICTED', 403, $state);\n        });\n    }\n\n    // 2026-10-08：支付回调只判断准入而不抛业务拒绝，确保真实到账仍然入账及原路退款。\n    public function canPublish(array $order): bool\n    {\n        if (!$this->eligible($order)) return true;\n        return $this->db->transaction(function () use ($order): bool {\n            $this->lockAccount((int)$order['user_id']);\n            return !$this->state((int)$order['user_id'])['restricted'];\n        });\n    }\n\n    /** 必须在订单失效报价/指派前、同一取消事务内调用；仅取消成立后该事务才会提交。 */\n    public function captureCancellation(array $order, string $responsibility = 'unclear', int $runEmptyCents = 0): void\n    {\n        if (!$this->eligible($order)) return;\n        $this->db->transaction(function () use ($order,$responsibility,$runEmptyCents): void {\n            $userId = (int)$order['user_id'];\n            $this->lockAccount($userId);\n            if (in_array($responsibility, ['worker','platform'], true)) {\n                $this->db->execute('UPDATE order_cancellation_risk_scores SET excluded_at=UTC_TIMESTAMP(),exclusion_reason=:reason,updated_at=UTC_TIMESTAMP() WHERE order_id=:id', ['reason'=>$responsibility.'责任免计分','id'=>$order['id']]);\n                return;\n            }\n            $quoted = (bool)$this->db->fetchValue(\"SELECT id FROM quotes WHERE order_id=:id AND worker_id>0 AND status IN ('active','selected') AND (expires_at IS NULL OR expires_at>UTC_TIMESTAMP()) LIMIT 1\", ['id'=>$order['id']]);\n            $dealt = !empty($order['selected_quote_id']) || (string)($order['assignment_status'] ?? '') === 'accepted';\n            $config = $this->configuration();\n            $base = CancellationRiskPolicy::score($quoted, $dealt, [], $runEmptyCents > 0, $config);\n            $snapshot = json_encode(['quoted'=>$quoted,'dealt'=>$dealt,'run_empty_cents'=>$runEmptyCents,\n                'assignment_id'=>$order['current_assignment_id'] ?? null,'worker_id'=>$order['assigned_worker_id'] ?? null,\n                'responsibility'=>$responsibility,'config'=>$config], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $this->db->execute(\"INSERT INTO order_cancellation_risk_scores(order_id,user_id,base_score,score,cancelled_at,snapshot_json,created_at,updated_at)\n                VALUES(:order_id,:user_id,:base,:base,COALESCE(:cancelled_at,UTC_TIMESTAMP()),:snapshot,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n                ON DUPLICATE KEY UPDATE base_score=GREATEST(base_score,VALUES(base_score)),updated_at=UTC_TIMESTAMP()\",\n                ['order_id'=>$order['id'],'user_id'=>$userId,'base'=>$base,'cancelled_at'=>$order['cancelled_at'] ?? null,'snapshot'=>$snapshot]);\n            $this->recalculateOrder((int)$order['id'], $config);\n            $this->evaluate($userId, $config);\n        });\n    }\n\n    /** 原电话、预约和异常入口写入；没有实际取消则只记录信号，不计分。 */\n    public function recordExistingSignal(int $orderId, int $workerId, string $kind, string $note = ''): void\n    {\n        if (!in_array($kind, ['dialed','contacted','complaint'], true)) throw new OrderOperationException('联系行为无效', 'RISK_SIGNAL_INVALID');\n        $this->db->transaction(function () use ($orderId,$workerId,$kind,$note): void {\n            $order = $this->db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$orderId]);\n            if (!$order || !$this->eligible($order)) return;\n            $workerUser = (int)$this->db->fetchValue('SELECT user_id FROM worker_profiles WHERE id=:id', ['id'=>$workerId]);\n            $participated = $this->db->fetchValue('SELECT id FROM quotes WHERE order_id=:id AND worker_id=:worker LIMIT 1', ['id'=>$orderId,'worker'=>$workerId])\n                || $this->db->fetchValue('SELECT id FROM assignments WHERE order_id=:id AND worker_id=:worker LIMIT 1', ['id'=>$orderId,'worker'=>$workerId]);\n            if ($workerId < 1 || !$participated || $workerUser === (int)$order['user_id']) throw new OrderOperationException('无权记录本单联系行为', 'FORBIDDEN', 403);\n            if ($kind !== 'complaint' && (string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('订单已结束，不能补记联系行为', 'ORDER_NOT_ACTIVE', 409);\n            $userId = (int)$order['user_id'];\n            $this->lockAccount($userId);\n            $this->db->execute(\"INSERT IGNORE INTO order_cancellation_risk_signals(order_id,worker_id,signal_type,note,created_at)\n                VALUES(:id,:worker,:kind,:note,UTC_TIMESTAMP())\", ['id'=>$orderId,'worker'=>$workerId,'kind'=>$kind,'note'=>mb_substr($note,0,500)]);\n            $config = $this->configuration();\n            $this->recalculateOrder($orderId, $config);\n            $this->evaluate($userId, $config);\n        });\n    }\n\n    public function recordDial(array $actor, string $publicNo): void\n    {\n        $this->db->transaction(function () use ($actor,$publicNo): void {\n            $order = $this->db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :no FOR UPDATE', ['no'=>$publicNo]);\n            $worker = (int)($actor['worker_id'] ?? 0);\n            if (!$order || $worker < 1 || (int)($order['assigned_worker_id'] ?? 0) !== $worker\n                || !$this->db->fetchValue(\"SELECT id FROM assignments WHERE id=:assignment AND order_id=:id AND worker_id=:worker AND status IN ('accepted','completed') LIMIT 1\", ['assignment'=>$order['current_assignment_id'] ?? 0,'id'=>$order['id'],'worker'=>$worker])) {\n                throw new OrderOperationException('接受本单后才能拨打业主电话', 'FORBIDDEN', 403);\n            }\n            // 已完成后的正常售后拨号不属于取消主订单的风险，不因限单阻止联系。\n            if ((string)$order['lifecycle_status'] === 'active') $this->recordExistingSignal((int)$order['id'], $worker, 'dialed');\n        });\n    }\n\n    public function reviewData(int $userId): array\n    {\n        $scores=$this->db->fetchAll('SELECT s.*,o.public_no FROM order_cancellation_risk_scores s JOIN orders o ON o.id=s.order_id WHERE s.user_id=:id ORDER BY s.cancelled_at DESC LIMIT 50', ['id'=>$userId]);\n        foreach ($scores as &$score) $score['signals']=$this->db->fetchAll('SELECT worker_id,signal_type,note,created_at,revoked_at FROM order_cancellation_risk_signals WHERE order_id=:id ORDER BY created_at,id', ['id'=>$score['order_id']]);\n        unset($score);\n        return ['state'=>$this->state($userId), 'scores'=>$scores,\n            'restrictions'=>$this->db->fetchAll('SELECT * FROM order_cancellation_risk_restrictions WHERE user_id=:id ORDER BY id DESC LIMIT 20', ['id'=>$userId])];\n    }\n\n    public function restrictManually(int $userId, int $adminId, int $days, string $reason): void\n    {\n        $days=max(1,min(30,$days));\n        $reason=trim($reason);\n        if ($userId<1 || $adminId<1) throw new OrderOperationException('用户或管理员无效', 'MANUAL_RESTRICTION_INVALID');\n        if (mb_strlen($reason)<2) throw new OrderOperationException('请填写人工限制原因', 'MANUAL_RESTRICTION_REASON_REQUIRED');\n        $this->db->transaction(function () use ($userId,$adminId,$days,$reason): void {\n            $account=$this->lockAccount($userId);\n            if (!empty($account['blocked_until']) && $account['blocked_until']>$account['now_utc']) {\n                throw new OrderOperationException('该用户当前已有生效中的下单限制，请先核实或解除', 'RESTRICTION_ALREADY_ACTIVE', 409);\n            }\n            $snapshot=json_encode(['rule_version'=>'manual-v1','source'=>'admin','admin_id'=>$adminId,'days'=>$days,'reason'=>mb_substr($reason,0,500)],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $id=$this->db->insert('INSERT INTO order_cancellation_risk_restrictions(user_id,starts_at,expires_at,snapshot_json) VALUES(:user,UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL '.(int)$days.' DAY),:snapshot)', ['user'=>$userId,'snapshot'=>$snapshot]);\n            $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=(SELECT expires_at FROM order_cancellation_risk_restrictions WHERE id=:restriction),last_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user', ['restriction'=>$id,'user'=>$userId]);\n        });\n    }\n\n    public function release(int $userId, int $adminId, string $reason, array $excludedOrderIds = [], ?int $expectedId = null): void\n    {\n        if ($adminId < 1 || mb_strlen(trim($reason)) < 2) throw new OrderOperationException('请填写解除原因', 'RELEASE_REASON_REQUIRED');\n        $this->db->transaction(function () use ($userId,$adminId,$reason,$excludedOrderIds,$expectedId): void {\n            $account = $this->lockAccount($userId);\n            $id = (int)($account['last_restriction_id'] ?? 0);\n            if ($id < 1 || ($expectedId !== null && $id !== $expectedId)) throw new OrderOperationException('限制记录已变化，请刷新重试', 'RESTRICTION_CHANGED', 409);\n            $restriction = $this->db->fetch('SELECT * FROM order_cancellation_risk_restrictions WHERE id=:id FOR UPDATE', ['id'=>$id]);\n            if (!empty($restriction['released_at'])) return;\n            foreach (array_unique(array_map('intval', $excludedOrderIds)) as $orderId) {\n                $this->db->execute('UPDATE order_cancellation_risk_scores SET excluded_at=UTC_TIMESTAMP(),exclusion_reason=:reason,updated_at=UTC_TIMESTAMP() WHERE order_id=:order AND user_id=:user', ['reason'=>mb_substr($reason,0,500),'order'=>$orderId,'user'=>$userId]);\n            }\n            if (!$this->manualRestriction($restriction)) $this->consume($userId,$id);\n            $this->db->execute('UPDATE order_cancellation_risk_restrictions SET released_at=UTC_TIMESTAMP(),released_by_admin_id=:admin,release_reason=:reason WHERE id=:id', ['admin'=>$adminId,'reason'=>mb_substr($reason,0,500),'id'=>$id]);\n            $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=NULL,updated_at=UTC_TIMESTAMP() WHERE user_id=:id', ['id'=>$userId]);\n        });\n    }\n\n    private function eligible(array $order): bool\n    {\n        return empty($order['is_demo']) && (string)($order['order_source_type'] ?? 'consumer') !== 'platform' && (int)($order['user_id'] ?? 0) > 0;\n    }\n\n    private function lockAccount(int $userId): array\n    {\n        $this->db->execute('INSERT INTO order_cancellation_risk_accounts(user_id,updated_at) VALUES(:id,UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE user_id=VALUES(user_id)', ['id'=>$userId]);\n        return $this->db->fetch('SELECT *,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n    }\n\n    private function recalculateOrder(int $orderId, array $config): void\n    {\n        $score = $this->db->fetch('SELECT base_score,cancelled_at FROM order_cancellation_risk_scores WHERE order_id=:id FOR UPDATE', ['id'=>$orderId]);\n        if (!$score) return;\n        $rows = $this->db->fetchAll(\"SELECT signal_type FROM order_cancellation_risk_signals WHERE order_id=:id AND revoked_at IS NULL\n            AND (signal_type='complaint' OR created_at<=:cancelled_at) FOR UPDATE\", ['id'=>$orderId,'cancelled_at'=>$score['cancelled_at']]);\n        $points = max((int)$score['base_score'], CancellationRiskPolicy::score(false,false,array_column($rows,'signal_type'),false,$config));\n        $this->db->execute('UPDATE order_cancellation_risk_scores SET score=:score,updated_at=UTC_TIMESTAMP() WHERE order_id=:id', ['score'=>$points,'id'=>$orderId]);\n    }\n\n    private function evaluate(int $userId, array $config): void\n    {\n        $account = $this->db->fetch('SELECT *,UTC_TIMESTAMP() now_utc FROM order_cancellation_risk_accounts WHERE user_id=:id FOR UPDATE', ['id'=>$userId]);\n        if (!empty($account['blocked_until']) && $account['blocked_until'] > $account['now_utc']) {\n            $restriction=$this->db->fetch('SELECT snapshot_json FROM order_cancellation_risk_restrictions WHERE id=:id FOR UPDATE',['id'=>(int)$account['last_restriction_id']]);\n            if (!$this->manualRestriction($restriction ?: [])) $this->consume($userId,(int)$account['last_restriction_id']);\n            return;\n        }\n        // 使用当前读：取消事务此前可能已建立 RR 快照，账号锁等待后仍须看见另一单的最新提交。\n        $rows = $this->db->fetchAll('SELECT order_id,score,cancelled_at,snapshot_json FROM order_cancellation_risk_scores WHERE user_id=:id AND excluded_at IS NULL AND consumed_restriction_id IS NULL AND score>0 AND cancelled_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL '.$config['long_days'].' DAY) FOR UPDATE', ['id'=>$userId]);\n        $match = CancellationRiskPolicy::threshold($rows, (int)strtotime($account['now_utc'].' UTC'), $config);\n        if (!$match) return;\n        $facts=[];\n        foreach ($rows as $row) $facts[]=['order_id'=>$row['order_id'],\n            'cancellation'=>json_decode($row['snapshot_json'],true),\n            'signals'=>$this->db->fetchAll('SELECT worker_id,signal_type,note,created_at,revoked_at FROM order_cancellation_risk_signals WHERE order_id=:id FOR UPDATE',['id'=>$row['order_id']])];\n        $snapshot = json_encode(['rule_version'=>'2026-10-08','config'=>$config,'match'=>$match,'scores'=>$rows,'facts'=>$facts], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $id = $this->db->insert('INSERT INTO order_cancellation_risk_restrictions(user_id,starts_at,expires_at,snapshot_json) VALUES(:user,UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL 7 DAY),:snapshot)', ['user'=>$userId,'snapshot'=>$snapshot]);\n        $this->db->execute('UPDATE order_cancellation_risk_accounts SET blocked_until=(SELECT expires_at FROM order_cancellation_risk_restrictions WHERE id=:restriction),last_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user', ['restriction'=>$id,'user'=>$userId]);\n        $this->consume($userId,$id);\n    }\n\n    private function manualRestriction(array $restriction): bool\n    {\n        $snapshot=json_decode((string)($restriction['snapshot_json'] ?? ''),true);\n        return is_array($snapshot) && ($snapshot['source'] ?? '')==='admin';\n    }\n\n    private function consume(int $userId, int $restrictionId): void\n    {\n        if ($restrictionId < 1) return;\n        $this->db->execute('UPDATE order_cancellation_risk_scores SET consumed_restriction_id=:restriction,updated_at=UTC_TIMESTAMP() WHERE user_id=:user AND consumed_restriction_id IS NULL AND excluded_at IS NULL AND score>0', ['restriction'=>$restrictionId,'user'=>$userId]);\n    }\n}\n","server/app/Domain/Order/CancellationRiskPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\n/** 2026-10-08：同单最高分、不同订单数门槛与固定七天限制；不依赖数据库或通知。 */\nfinal class CancellationRiskPolicy\n{\n    public const DEFAULTS = ['quote'=>2, 'contact'=>4, 'deal'=>5, 'complaint'=>6, 'run_empty'=>6,\n        'short_days'=>7, 'short_orders'=>2, 'short_score'=>6, 'long_days'=>30, 'long_orders'=>3, 'long_score'=>10];\n\n    public static function config(array $input): array\n    {\n        $result = self::DEFAULTS;\n        foreach ($result as $key=>$default) {\n            if (isset($input[$key]) && is_numeric($input[$key])) {\n                $max = strpos($key, 'days') !== false ? 90 : 100;\n                $minimum = strpos($key, 'orders') !== false ? 2 : 1;\n                $result[$key] = max($minimum, min($max, (int)$input[$key]));\n            }\n        }\n        $result['long_days'] = max($result['short_days'], $result['long_days']);\n        return $result;\n    }\n\n    public static function score(bool $quoted, bool $dealt, array $signals, bool $runEmpty, array $config): int\n    {\n        $points = max($quoted ? $config['quote'] : 0, $dealt ? $config['deal'] : 0, $runEmpty ? $config['run_empty'] : 0);\n        if (in_array('dialed', $signals, true) || in_array('contacted', $signals, true)) $points = max($points, $config['contact']);\n        if (in_array('complaint', $signals, true)) $points = max($points, $config['complaint']);\n        return $points;\n    }\n\n    public static function threshold(array $rows, int $now, array $config): ?array\n    {\n        foreach (['short','long'] as $window) {\n            $cutoff = $now - $config[$window.'_days'] * 86400;\n            $orders = [];\n            foreach ($rows as $row) {\n                $at = strtotime((string)$row['cancelled_at'].' UTC');\n                if ($at !== false && $at >= $cutoff && $at <= $now && (int)$row['score'] > 0) {\n                    $id = (int)$row['order_id'];\n                    $orders[$id] = max($orders[$id] ?? 0, (int)$row['score']);\n                }\n            }\n            if (count($orders) >= $config[$window.'_orders'] && array_sum($orders) >= $config[$window.'_score']) {\n                return ['window'=>$window, 'days'=>$config[$window.'_days'], 'order_count'=>count($orders),\n                    'score'=>array_sum($orders), 'order_ids'=>array_keys($orders)];\n            }\n        }\n        return null;\n    }\n}\n","server/app/Contracts/OrderCancellationRiskRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCancellationRiskRepository\n{\n    public function configuration(): array;\n    public function saveConfiguration(array $rules): void;\n    public function user(int $userId): ?array;\n    public function state(int $userId): array;\n    public function recordDial(array $actor, string $publicNo): void;\n    public function reviewData(int $userId): array;\n    public function restrictManually(int $userId, int $adminId, int $days, string $reason): void;\n    public function release(int $userId, int $adminId, string $reason, array $excludedOrderIds = [], ?int $expectedId = null): void;\n}\n","server/VERSION":"2.7.0\n","chat/internal/message/preferences.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"math\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrPreferenceConflict = errors.New(\"CHAT_PREFERENCE_CONFLICT\")\nvar ErrPinLimit = errors.New(\"CHAT_PIN_LIMIT\")\n\ntype Preferences struct {\n\tMemberVersion   string   `json:\"member_version\"`\n\tPinned          bool     `json:\"pinned\"`\n\tPinnedVersion   ports.ID `json:\"pinned_version\"`\n\tLater           bool     `json:\"later\"`\n\tLaterVersion    ports.ID `json:\"later_version\"`\n\tAccountRevision ports.ID `json:\"account_revision\"`\n}\ntype PreferenceRequest struct {\n\tConversationID ports.ID\n\tMemberVersion  string\n\tField          string\n\tValue          bool\n\tExpected       ports.ID\n}\n\nfunc preferenceLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, id ports.ID, g ports.Grant) (Preferences, error) {\n\tout := Preferences{MemberVersion: memberHash(g.MemberKey), PinnedVersion: \"0\", LaterVersion: \"0\", AccountRevision: \"0\"}\n\tvar hash string\n\terr := tx.QueryRowContext(ctx, `SELECT member_key_hash,pinned,CAST(pinned_version AS CHAR),later,CAST(later_version AS CHAR) FROM chat_user_preferences WHERE conversation_id=? AND actor_id=?`, string(id), string(p.ActorID)).Scan(&hash, &out.Pinned, &out.PinnedVersion, &out.Later, &out.LaterVersion)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif hash != out.MemberVersion {\n\t\tout.Pinned = false\n\t\tout.Later = false\n\t\tout.PinnedVersion = \"0\"\n\t\tout.LaterVersion = \"0\"\n\t}\n\treturn out, nil\n}\nfunc accountRevision(ctx context.Context, db interface {\n\tQueryRowContext(context.Context, string, ...any) *sql.Row\n}, actor ports.ID) (ports.ID, error) {\n\tvar revision ports.ID\n\terr := db.QueryRowContext(ctx, `SELECT CAST(revision AS CHAR) FROM chat_preference_accounts WHERE actor_id=?`, string(actor)).Scan(&revision)\n\tif err == sql.ErrNoRows {\n\t\treturn \"0\", nil\n\t}\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn revision, nil\n}\nfunc (s *HistoryService) Preferences(ctx context.Context, p ports.Principal, id ports.ID) (Preferences, error) {\n\tif !validID(id) || p.Environment != s.environment {\n\t\treturn Preferences{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout, err := preferenceLocked(ctx, tx, p, id, g)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout.AccountRevision, err = accountRevision(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Preferences{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// SetPreference serializes this actor's preference writes after the existing\n// guard/login/conversation lock order. Independent fields never overwrite each\n// other. A retry may repeat only the immediate same-value version transition.\nfunc (s *HistoryService) SetPreference(ctx context.Context, p ports.Principal, q PreferenceRequest) (Preferences, error) {\n\tif !validID(q.ConversationID) || p.Environment != s.environment || !q.Expected.Valid() || !memberVersionPattern.MatchString(q.MemberVersion) || (q.Field != \"pinned\" && q.Field != \"later\") {\n\t\treturn Preferences{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"})\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tif memberHash(g.MemberKey) != q.MemberVersion {\n\t\treturn Preferences{}, ErrResync\n\t}\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_preference_accounts(actor_id,revision,updated_at) VALUES(?,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(p.ActorID))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\trevision, err := accountRevision(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout, err := preferenceLocked(ctx, tx, p, q.ConversationID, g)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout.AccountRevision = revision\n\tversion, value := out.PinnedVersion, out.Pinned\n\tif q.Field == \"later\" {\n\t\tversion, value = out.LaterVersion, out.Later\n\t}\n\tif q.Expected != version {\n\t\tif !(value == q.Value && number(version) > 0 && number(q.Expected) == number(version)-1) {\n\t\t\treturn out, ErrPreferenceConflict\n\t\t}\n\t\tif !time.Now().Before(p.ExpiresAt) {\n\t\t\treturn Preferences{}, policy.ErrDenied\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tif value == q.Value {\n\t\tif !time.Now().Before(p.ExpiresAt) {\n\t\t\treturn Preferences{}, policy.ErrDenied\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tif number(version) == math.MaxUint64 || number(revision) == math.MaxUint64 {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif q.Field == \"pinned\" && q.Value {\n\t\t// Only current projected generations consume a pin slot. PHP authorization\n\t\t// is still rechecked for every returned row; this count grants no access.\n\t\tvar count int\n\t\terr = tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM (SELECT p.conversation_id FROM chat_user_preferences p JOIN chat_members m ON m.conversation_id=p.conversation_id AND m.actor_id=p.actor_id WHERE p.actor_id=? AND p.pinned=1 AND m.actor_kind='mini' AND m.can_read=1 AND p.member_key_hash=SHA2(m.member_key,256) LIMIT 10) active_pins`, string(p.ActorID)).Scan(&count)\n\t\tif err != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\tif count >= 10 {\n\t\t\treturn out, ErrPinLimit\n\t\t}\n\t}\n\tif q.Field == \"pinned\" {\n\t\tout.Pinned = q.Value\n\t\tout.PinnedVersion = decimal(number(version) + 1)\n\t} else {\n\t\tout.Later = q.Value\n\t\tout.LaterVersion = decimal(number(version) + 1)\n\t}\n\tout.AccountRevision = decimal(number(revision) + 1)\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) VALUES(?,?,?,?,?,?,?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE member_key_hash=VALUES(member_key_hash),pinned=VALUES(pinned),pinned_version=VALUES(pinned_version),later=VALUES(later),later_version=VALUES(later_version),updated_at=VALUES(updated_at)`, string(q.ConversationID), string(p.ActorID), out.MemberVersion, out.Pinned, string(out.PinnedVersion), out.Later, string(out.LaterVersion))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\t_, err = tx.ExecContext(ctx, `UPDATE chat_preference_accounts SET revision=?,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(out.AccountRevision), string(p.ActorID))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Preferences{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n","chat/internal/message/preferences_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"regexp\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar memberVersionPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)\n\n// Both transports use the same closed schema. No account/role override,\n// muted/hidden flag, read_seq, batch object, duplicate key or null is accepted.\nfunc decodePreference(raw []byte, write bool) (PreferenceRequest, error) {\n\tvar q PreferenceRequest\n\tif len(raw) > 4096 || !utf8.Valid(raw) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\ttoken, err := d.Token()\n\tif err != nil || token != json.Delim('{') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\ttoken, err = d.Token()\n\t\tkey, ok := token.(string)\n\t\tif err != nil || !ok || seen[key] {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tseen[key] = true\n\t\tvar field json.RawMessage\n\t\tif d.Decode(&field) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tif key == \"value\" && write {\n\t\t\tif !bytes.Equal(field, []byte(\"true\")) && !bytes.Equal(field, []byte(\"false\")) {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Value = bytes.Equal(field, []byte(\"true\"))\n\t\t\tcontinue\n\t\t}\n\t\tvar value string\n\t\tif len(field) < 2 || field[0] != '\"' || !validSurrogates(field) || json.Unmarshal(field, &value) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tswitch key {\n\t\tcase \"conversation_id\":\n\t\t\tq.ConversationID = ports.ID(value)\n\t\tcase \"member_version\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.MemberVersion = value\n\t\tcase \"field\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Field = value\n\t\tcase \"expected_version\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Expected = ports.ID(value)\n\t\tdefault:\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\ttoken, err = d.Token()\n\tif err != nil || token != json.Delim('}') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif _, err = d.Token(); err != io.EOF || !validID(q.ConversationID) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif write && (len(seen) != 5 || !seen[\"value\"] || !memberVersionPattern.MatchString(q.MemberVersion) || !q.Expected.Valid() || (q.Field != \"pinned\" && q.Field != \"later\")) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif !write && len(seen) != 1 {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\n","chat/internal/message/preferences_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync\"\n\t\"testing\"\n)\n\nfunc prefRequest(id ports.ID, p Preferences, field string, value bool) PreferenceRequest {\n\tversion := p.PinnedVersion\n\tif field == \"later\" {\n\t\tversion = p.LaterVersion\n\t}\n\treturn PreferenceRequest{id, p.MemberVersion, field, value, version}\n}\nfunc TestMySQLS14IndependentFieldsRetryAndReadIsolation(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 4)\n\tp := principal(\"10202\")\n\tinitial, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || initial.Pinned || initial.Later || initial.AccountRevision != \"0\" {\n\t\tt.Fatal(initial, e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_user_preferences\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_preference_accounts\") != \"0\" {\n\t\tt.Fatal(\"read creates preferences\")\n\t}\n\tstart := make(chan struct{})\n\terrs := make(chan error, 2)\n\tfor _, field := range []string{\"pinned\", \"later\"} {\n\t\tgo func(field string) {\n\t\t\t<-start\n\t\t\t_, err := h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, field, true))\n\t\t\terrs <- err\n\t\t}(field)\n\t}\n\tclose(start)\n\tfor n := 0; n < 2; n++ {\n\t\tif err := <-errs; err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tcurrent, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || !current.Pinned || !current.Later || current.PinnedVersion != \"1\" || current.LaterVersion != \"1\" || current.AccountRevision != \"2\" {\n\t\tt.Fatal(current, e)\n\t}\n\trepeated, e := h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, \"pinned\", true))\n\tif e != nil || repeated.AccountRevision != \"2\" {\n\t\tt.Fatal(\"lost-response retry\", repeated, e)\n\t}\n\tconflict := prefRequest(r.ConversationID, initial, \"pinned\", false)\n\tif _, e = h.SetPreference(f.ctx, p, conflict); e != ErrPreferenceConflict {\n\t\tt.Fatal(\"stale overwrite\", e)\n\t}\n\t_, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"pinned\", false))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, \"pinned\", true)); e != ErrPreferenceConflict {\n\t\tt.Fatal(\"ABA retry\", e)\n\t}\n\tu, e := h.Unread(f.ctx, p, r.ConversationID)\n\tif e != nil || !u.Preferences.Later || u.Preferences.Pinned || u.Preferences.AccountRevision != \"3\" {\n\t\tt.Fatal(u, e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != \"0\" {\n\t\tt.Fatal(\"preference writes read seq\")\n\t}\n\tboot := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID}, \"bootstrap\")\n\tif _, e = h.Acknowledge(f.ctx, p, r.ConversationID, boot.SyncCursor); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcurrent, e = h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || !current.Later {\n\t\tt.Fatal(\"read cleared later\", current, e)\n\t}\n\tother, e := h.Preferences(f.ctx, principal(\"10203\"), r.ConversationID)\n\tif e != nil || other.Pinned || other.Later {\n\t\tt.Fatal(\"other actor inherited preference\", other, e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, principal(\"10201\"), prefRequest(r.ConversationID, current, \"later\", false)); e == nil {\n\t\tt.Fatal(\"outsider mutated\")\n\t}\n\tf.php(\"close\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\t// Readonly policy still permits changing one's own organizational preference.\n\tcurrent, e = h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"pinned\", true)); e != nil {\n\t\tt.Fatal(\"readonly blocked preference\", e)\n\t}\n\tf.php(\"repair\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tnext, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || next.Pinned || next.Later || next.MemberVersion == initial.MemberVersion {\n\t\tt.Fatal(\"generation inherited preference\", next, e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"later\", false)); e != ErrResync {\n\t\tt.Fatal(\"old generation updated new preference\", e)\n\t}\n}\nfunc TestMySQLS14DigestRevisionAndTransports(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 1)\n\tp := principal(\"10202\")\n\tf.php(\"sync\", \"402\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpage, e := h.DigestsCursor(f.ctx, p, \"\", 1)\n\tif e != nil || !page.HasMore || page.PreferenceRevision != \"0\" {\n\t\tt.Fatal(page, e)\n\t}\n\tinitial, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tbody := fmt.Sprintf(`{\"conversation_id\":\"%s\",\"member_version\":\"%s\",\"field\":\"later\",\"value\":true,\"expected_version\":\"0\"}`, r.ConversationID, initial.MemberVersion)\n\tcommands := SocketCommands{History: h}\n\t_, out, e := commands.Execute(f.ctx, p, \"conversation.preference\", json.RawMessage(body))\n\tif e != nil || !out.(Preferences).Later {\n\t\tt.Fatal(out, e)\n\t}\n\tif _, e = h.DigestsCursor(f.ctx, p, page.NextCursor, 1); e != ErrResync {\n\t\tt.Fatal(\"mixed preference cursor\", e)\n\t}\n\tpage, e = h.DigestsCursor(f.ctx, p, \"\", 20)\n\tif e != nil || page.PreferenceRevision != \"1\" {\n\t\tt.Fatal(page, e)\n\t}\n\tfound := false\n\tfor _, row := range page.Items {\n\t\tif row.ConversationID == r.ConversationID {\n\t\t\tfound = row.Unread.Preferences.Later && row.Unread.Preferences.AccountRevision == \"1\"\n\t\t}\n\t}\n\tif !found {\n\t\tt.Fatal(\"digest lost preference\")\n\t}\n\tfor _, key := range []string{\"muted\", \"hidden\", \"read_seq\", \"actor_id\"} {\n\t\traw := fmt.Sprintf(`{\"conversation_id\":\"%s\",\"%s\":true}`, r.ConversationID, key)\n\t\tif _, _, e = commands.Execute(f.ctx, p, \"conversation.preference\", json.RawMessage(raw)); e == nil {\n\t\t\tt.Fatal(\"forged socket field\", key)\n\t\t}\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, e = h.Preferences(f.ctx, p, r.ConversationID); e == nil {\n\t\tt.Fatal(\"revoked session read preferences\")\n\t}\n\tif _, _, e = commands.Execute(context.Background(), p, \"conversation.preference\", json.RawMessage(body)); e == nil {\n\t\tt.Fatal(\"revoked session updated\")\n\t}\n}\nfunc TestMySQLS14PinBudgetAcrossConversations(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 0)\n\tp := principal(\"10202\")\n\tf.php(\"sync\", \"402\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tsecond, e := f.store.FindOrder(f.ctx, p, \"402\", \"402\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor n := 1; n <= 9; n++ {\n\t\tid := 1000 + n\n\t\tkey := fmt.Sprintf(\"budget-member-%d\", n)\n\t\tf.exec(`INSERT INTO chat_conversations(id,conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at) VALUES(?,'order',?,?,?,1,REPEAT('a',64),'budget','open',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, id, fmt.Sprintf(\"budget:%d\", n), id, id)\n\t\tf.exec(`INSERT INTO chat_members(conversation_id,actor_id,actor_kind,role,member_key,can_read,can_send) VALUES(?,10202,'mini','worker',?,1,1)`, id, key)\n\t\tf.exec(`INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) VALUES(?,10202,?,1,1,0,0,UTC_TIMESTAMP(6))`, id, memberHash(key))\n\t}\n\tstart := make(chan struct{})\n\terrs := make(chan error, 2)\n\tvar wg sync.WaitGroup\n\tfor _, id := range []ports.ID{r.ConversationID, second} {\n\t\tinitial, e := h.Preferences(f.ctx, p, id)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\twg.Add(1)\n\t\tgo func(id ports.ID, initial Preferences) {\n\t\t\tdefer wg.Done()\n\t\t\t<-start\n\t\t\t_, err := h.SetPreference(f.ctx, p, prefRequest(id, initial, \"pinned\", true))\n\t\t\terrs <- err\n\t\t}(id, initial)\n\t}\n\tclose(start)\n\twg.Wait()\n\tclose(errs)\n\taccepted, limited := 0, 0\n\tfor err := range errs {\n\t\tif err == nil {\n\t\t\taccepted++\n\t\t} else if err == ErrPinLimit {\n\t\t\tlimited++\n\t\t} else {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif accepted != 1 || limited != 1 || f.text(\"SELECT COUNT(*) FROM chat_user_preferences WHERE pinned=1\") != \"10\" {\n\t\tt.Fatal(\"pin budget race\", accepted, limited)\n\t}\n\t// Removed projection generations no longer occupy usable pin capacity.\n\tf.exec(\"UPDATE chat_members SET can_read=0 WHERE conversation_id=1001\")\n\tfor _, id := range []ports.ID{r.ConversationID, second} {\n\t\tinitial, e := h.Preferences(f.ctx, p, id)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif !initial.Pinned {\n\t\t\tif _, e = h.SetPreference(f.ctx, p, prefRequest(id, initial, \"pinned\", true)); e != nil {\n\t\t\t\tt.Fatal(\"stale pin consumed capacity\", e)\n\t\t\t}\n\t\t}\n\t}\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCenterRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderCenterRepository;\nuse WorkerAdmin\\Core\\Database;\n\nfinal class DatabaseOrderCenterRepository implements OrderCenterRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    // Shared SQL scope for lists and attention counts; no page-size approximation.\n    public static function scope(array $actor, string $kind, string $status, string $keyword = ''): array\n    {\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        $params = ['own_worker_id' => $workerId];\n\n        if ($kind === 'mine') {\n            $where = \"o.user_id=:center_user_id AND o.lifecycle_status<>'archived'\";\n            $params['center_user_id'] = (int)$actor['user_id'];\n        } else {\n            if ($workerId < 1) return ['1=0', []];\n            $where = \"o.lifecycle_status<>'archived' AND (\n                EXISTS(SELECT 1 FROM quotes q0 WHERE q0.order_id=o.id AND q0.worker_id=:center_quote_worker AND q0.status IN ('active','selected'))\n                OR EXISTS(SELECT 1 FROM assignments a0 WHERE a0.order_id=o.id AND a0.worker_id=:center_assignment_worker AND a0.status IN ('offered','accepted'))\n                OR EXISTS(SELECT 1 FROM invite_tokens it0 WHERE it0.order_id=o.id AND it0.claimed_worker_id=:center_invite_worker AND it0.status='claimed')\n                OR (o.assigned_worker_id=:center_refund_worker AND o.refund_status IN ('pending_review','approved','processing','refunding','succeeded'))\n            )\";\n            $params['center_quote_worker'] = $workerId;\n            $params['center_assignment_worker'] = $workerId;\n            $params['center_invite_worker'] = $workerId;\n            $params['center_refund_worker'] = $workerId;\n        }\n\n        $where .= !empty($actor['is_demo_actor']) ? ' AND o.is_demo=1' : ' AND o.is_demo=0';\n        $keyword = trim($keyword);\n        if ($kind === 'mine' && $keyword !== '') {\n            $pattern = '%' . $keyword . '%';\n            // PDO 原生预处理下不复用同名占位符；所有权条件已经在前面固定为当前 user_id。\n            $where .= \" AND (\n                o.public_no LIKE :center_keyword_no\n                OR CONCAT_WS(' ',COALESCE(o.title,''),COALESCE(o.category_names_snapshot,''),COALESCE(o.category_name_snapshot,''),COALESCE(o.district,''),COALESCE(o.address_summary,'')) LIKE :center_keyword_text\n            )\";\n            $params['center_keyword_no'] = $pattern;\n            $params['center_keyword_text'] = $pattern;\n        }\n        $activeRepairSql = \"EXISTS(SELECT 1 FROM after_sales ar_active WHERE ar_active.order_id=o.id AND ar_active.type='warranty_repair' AND ar_active.status IN ('open','processing'))\";\n        $pricingAwaitingCustomerSql = \"o.order_source_type='platform'\n            AND EXISTS(SELECT 1 FROM order_events pre WHERE pre.order_id=o.id AND pre.event_type='platform_measurement_pricing_reviewed')\n            AND NOT EXISTS(SELECT 1 FROM order_events pce WHERE pce.order_id=o.id AND pce.event_type='platform_measurement_pricing_confirmed')\";\n        $constructionAppointmentTodoSql = \"o.order_source_type='platform'\n            AND o.workflow_profile='construction'\n            AND o.fulfillment_status='not_started'\n            AND EXISTS(SELECT 1 FROM order_events prc WHERE prc.order_id=o.id AND prc.event_type='platform_measurement_pricing_reviewed')\n            AND EXISTS(SELECT 1 FROM order_events pcc WHERE pcc.order_id=o.id AND pcc.event_type='platform_measurement_pricing_confirmed')\n            AND NOT EXISTS(SELECT 1 FROM appointment_records pac WHERE pac.order_id=o.id AND pac.context_type='service')\";\n\n        if ($status === 'todo') {\n            if ($kind === 'mine') {\n                $where .= \" AND o.lifecycle_status='active' AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND (\n                    o.audit_status='supplement_required'\n                    OR (o.audit_status='draft' AND o.payment_status='awaiting_payment')\n                    OR ({$pricingAwaitingCustomerSql})\n                    OR (o.fulfillment_status='submitted' AND o.dispute_status NOT IN ('open','processing'))\n                    OR (o.audit_status='approved' AND o.selected_quote_id IS NULL AND EXISTS(SELECT 1 FROM quotes qt WHERE qt.order_id=o.id AND qt.status='active'))\n                    OR EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')))\n                    OR EXISTS(SELECT 1 FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment'))\n                )\";\n            } else {\n                $where .= \" AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND (\n                    (o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL AND EXISTS(\n                        SELECT 1 FROM assignments atodo WHERE atodo.id=o.current_assignment_id AND atodo.worker_id=:todo_worker AND atodo.status='offered'\n                    ))\n                    OR (o.lifecycle_status='active' AND o.assigned_worker_id=:todo_construction_worker AND o.assignment_status='accepted' AND ({$constructionAppointmentTodoSql}))\n                    OR (o.lifecycle_status='active' AND o.order_source_type='platform' AND o.dispatch_mode='multi_quote'\n                        AND o.selected_quote_id IS NULL\n                        AND EXISTS(SELECT 1 FROM invite_tokens ittodo WHERE ittodo.order_id=o.id AND ittodo.claimed_worker_id=:todo_invite_worker AND ittodo.status='claimed')\n                        AND NOT EXISTS(SELECT 1 FROM quotes qtodo WHERE qtodo.order_id=o.id AND qtodo.worker_id=:todo_quote_worker AND qtodo.status IN ('active','selected'))\n                    )\n                    OR (o.assigned_worker_id=:todo_repair_worker AND EXISTS(\n                        SELECT 1 FROM after_sales astodo WHERE astodo.order_id=o.id AND astodo.type='warranty_repair'\n                        AND (astodo.status='open' OR (astodo.status='processing' AND (astodo.resolution IS NULL OR (astodo.resolution NOT LIKE '师傅拒绝维修%' AND astodo.resolution NOT LIKE '用户申请平台介入%'))))\n                    ))\n                )\";\n                $params['todo_worker'] = $workerId;\n                $params['todo_construction_worker'] = $workerId;\n                $params['todo_invite_worker'] = $workerId;\n                $params['todo_quote_worker'] = $workerId;\n                $params['todo_repair_worker'] = $workerId;\n            }\n        } elseif ($status === 'supplement') {\n            $where .= $kind === 'mine'\n                ? \" AND o.audit_status='supplement_required' AND o.lifecycle_status='active'\"\n                : ' AND 1=0';\n        } elseif ($status === 'quoting') {\n            $where .= $kind === 'mine'\n                ? \" AND o.audit_status='approved' AND o.lifecycle_status='active' AND o.selected_quote_id IS NULL AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\"\n                : \" AND o.lifecycle_status='active' AND o.assignment_status<>'accepted' AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\";\n        } elseif ($status === 'progress') {\n            if ($kind === 'mine') {\n                $where .= \" AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND ((o.lifecycle_status='active' AND o.selected_quote_id IS NOT NULL AND o.fulfillment_status<>'accepted') OR {$activeRepairSql})\";\n            } else {\n                $where .= \" AND o.assigned_worker_id=:progress_worker AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND ((o.assignment_status='accepted' AND o.lifecycle_status='active' AND o.fulfillment_status<>'accepted') OR {$activeRepairSql})\";\n                $params['progress_worker'] = $workerId;\n            }\n        } elseif ($status === 'completed') {\n            if ($kind === 'mine') {\n                $where .= \" AND (o.fulfillment_status='accepted' OR o.lifecycle_status='completed') AND NOT {$activeRepairSql}\";\n            } else {\n                $where .= \" AND o.assigned_worker_id=:completed_worker AND (o.fulfillment_status='accepted' OR o.lifecycle_status='completed') AND NOT {$activeRepairSql}\";\n                $params['completed_worker'] = $workerId;\n            }\n        } elseif ($status === 'refunding') {\n            $where .= \" AND (o.refund_status IN ('pending_review','approved','processing','refunding') OR o.lifecycle_status='cancel_approved_pending_refund')\";\n        }\n\n        return [$where,$params];\n    }\n\n    public function page(array $actor, string $kind, string $status, int $page, int $limit, string $keyword = ''): array\n    {\n        $page = max(1, $page);\n        $limit = max(1, min(50, $limit));\n        $offset = ($page - 1) * $limit;\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        if ($kind !== 'mine' && $workerId < 1) return ['rows'=>[], 'has_more'=>false];\n        [$where,$params] = self::scope($actor,$kind,$status,$keyword);\n        $params['invite_worker_flag'] = $workerId;\n        $params['invite_worker_lookup'] = $workerId;\n        $params['invite_token_worker_lookup'] = $workerId;\n        $params['invite_quote_worker_lookup'] = $workerId;\n        $sql = \"SELECT o.*,\n                    (SELECT COUNT(*) FROM quotes q WHERE q.order_id=o.id AND q.status IN ('active','selected')) quote_count,\n                    (SELECT q.amount_cents FROM quotes q WHERE q.order_id=o.id AND q.worker_id=:own_worker_id ORDER BY q.id DESC LIMIT 1) own_quote_cents,\n                    (SELECT mf.public_id FROM media_links ml JOIN media_files mf ON mf.id=ml.media_file_id AND mf.status='active'\n                     WHERE ml.entity_type='order' AND ml.entity_id=o.id\n                     ORDER BY FIELD(ml.purpose,'product','wall','completion','before_optional'),ml.sort_order,ml.id LIMIT 1) cover_media_id,\n                    (SELECT c.public_id FROM change_requests c WHERE c.order_id=o.id AND c.status='pending' ORDER BY c.id DESC LIMIT 1) pending_change_id,\n                    (SELECT rc.status FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment') ORDER BY rc.id DESC LIMIT 1) pending_run_empty_status,\n                    (SELECT COUNT(*) FROM after_sales ast WHERE ast.order_id=o.id AND ast.type='warranty_repair' AND (ast.status='open' OR (ast.status='processing' AND (ast.resolution IS NULL OR (ast.resolution NOT LIKE '师傅拒绝维修%' AND ast.resolution NOT LIKE '用户申请平台介入%'))))) pending_repair_count,\n                    (SELECT ast2.status FROM after_sales ast2 WHERE ast2.order_id=o.id AND ast2.type='warranty_repair' AND ast2.status IN ('open','processing') ORDER BY ast2.id DESC LIMIT 1) active_repair_status,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr WHERE pr.order_id=o.id AND pr.event_type='platform_measurement_pricing_reviewed')\n                        THEN 1 ELSE 0 END platform_pricing_reviewed,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr2 WHERE pr2.order_id=o.id AND pr2.event_type='platform_measurement_pricing_reviewed')\n                        AND NOT EXISTS(SELECT 1 FROM order_events pc2 WHERE pc2.order_id=o.id AND pc2.event_type='platform_measurement_pricing_confirmed')\n                        THEN 1 ELSE 0 END platform_pricing_confirmation_pending,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pc3 WHERE pc3.order_id=o.id AND pc3.event_type='platform_measurement_pricing_confirmed')\n                        THEN 1 ELSE 0 END platform_pricing_confirmed,\n                    CASE WHEN EXISTS(SELECT 1 FROM appointment_records pas WHERE pas.order_id=o.id AND pas.context_type='service')\n                        THEN 1 ELSE 0 END service_appointment_exists,\n                    CASE WHEN :invite_worker_flag>0 AND (\n                        EXISTS(SELECT 1 FROM assignments ai WHERE ai.order_id=o.id AND ai.worker_id=:invite_worker_lookup AND ai.assignment_type='invite')\n                        OR EXISTS(SELECT 1 FROM invite_tokens iti WHERE iti.order_id=o.id AND iti.claimed_worker_id=:invite_token_worker_lookup AND iti.status='claimed')\n                    ) THEN 1 ELSE 0 END is_invited,\n                    CASE WHEN o.order_source_type='platform' AND o.dispatch_mode='multi_quote' AND o.selected_quote_id IS NULL\n                        AND EXISTS(SELECT 1 FROM invite_tokens itr WHERE itr.order_id=o.id AND itr.claimed_worker_id=:invite_token_worker_lookup2 AND itr.status='claimed')\n                        AND NOT EXISTS(SELECT 1 FROM quotes qir WHERE qir.order_id=o.id AND qir.worker_id=:invite_quote_worker_lookup AND qir.status IN ('active','selected'))\n                        THEN 1 ELSE 0 END invite_requires_quote\n                FROM orders o WHERE {$where}\n                ORDER BY o.updated_at DESC,o.id DESC\n                LIMIT \" . ($limit + 1) . ' OFFSET ' . $offset;\n        $params['invite_token_worker_lookup2'] = $workerId;\n        $rows = $this->db->fetchAll($sql, $params);\n        $hasMore = count($rows) > $limit;\n        if ($hasMore) $rows = array_slice($rows, 0, $limit);\n        return ['rows' => $rows, 'has_more' => $hasMore];\n    }\n\n    public function supplementCount(array $actor, string $kind): int\n    {\n        if ($kind !== 'mine') return 0;\n        return (int)$this->db->fetchValue(\n            \"SELECT COUNT(*) FROM orders WHERE user_id=:user_id AND audit_status='supplement_required' AND lifecycle_status='active'\",\n            ['user_id' => (int)$actor['user_id']]\n        );\n    }\n\n    public function todoCount(array $actor, string $kind): int\n    {\n        if ($kind === 'mine') {\n            return (int)$this->db->fetchValue(\n                \"SELECT COUNT(*) FROM orders o\n                 WHERE o.user_id=:user_id AND o.lifecycle_status='active'\n                   AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\n                   AND (\n                     o.audit_status='supplement_required'\n                     OR (o.audit_status='draft' AND o.payment_status='awaiting_payment')\n                     OR (o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr WHERE pr.order_id=o.id AND pr.event_type='platform_measurement_pricing_reviewed')\n                        AND NOT EXISTS(SELECT 1 FROM order_events pc WHERE pc.order_id=o.id AND pc.event_type='platform_measurement_pricing_confirmed'))\n                     OR (o.fulfillment_status='submitted' AND o.dispute_status NOT IN ('open','processing'))\n                     OR (o.audit_status='approved' AND o.selected_quote_id IS NULL AND EXISTS(SELECT 1 FROM quotes q WHERE q.order_id=o.id AND q.status='active'))\n                     OR EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')))\n                     OR EXISTS(SELECT 1 FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment'))\n                   )\",\n                ['user_id' => (int)$actor['user_id']]\n            );\n        }\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        if ($workerId < 1) return 0;\n        return (int)$this->db->fetchValue(\n            \"SELECT COUNT(*) FROM orders o\n             WHERE o.refund_status NOT IN ('pending_review','approved','processing','refunding')\n               AND (\n                 (o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL AND EXISTS(\n                    SELECT 1 FROM assignments atc WHERE atc.id=o.current_assignment_id AND atc.worker_id=:worker_id AND atc.status='offered'\n                 ))\n                 OR (o.lifecycle_status='active' AND o.assigned_worker_id=:construction_worker_id AND o.assignment_status='accepted'\n                    AND o.order_source_type='platform' AND o.workflow_profile='construction' AND o.fulfillment_status='not_started'\n                    AND EXISTS(SELECT 1 FROM order_events prc WHERE prc.order_id=o.id AND prc.event_type='platform_measurement_pricing_reviewed')\n                    AND EXISTS(SELECT 1 FROM order_events pcc WHERE pcc.order_id=o.id AND pcc.event_type='platform_measurement_pricing_confirmed')\n                    AND NOT EXISTS(SELECT 1 FROM appointment_records pac WHERE pac.order_id=o.id AND pac.context_type='service'))\n                 OR (o.lifecycle_status='active' AND o.order_source_type='platform' AND o.dispatch_mode='multi_quote'\n                    AND o.selected_quote_id IS NULL\n                    AND EXISTS(SELECT 1 FROM invite_tokens itc WHERE itc.order_id=o.id AND itc.claimed_worker_id=:invite_worker_id AND itc.status='claimed')\n                    AND NOT EXISTS(SELECT 1 FROM quotes qic WHERE qic.order_id=o.id AND qic.worker_id=:quote_worker_id AND qic.status IN ('active','selected'))\n                 )\n                 OR (o.assigned_worker_id=:repair_worker_id AND EXISTS(\n                    SELECT 1 FROM after_sales ascnt WHERE ascnt.order_id=o.id AND ascnt.type='warranty_repair'\n                    AND (ascnt.status='open' OR (ascnt.status='processing' AND (ascnt.resolution IS NULL OR (ascnt.resolution NOT LIKE '师傅拒绝维修%' AND ascnt.resolution NOT LIKE '用户申请平台介入%'))))\n                 ))\n               )\",\n            [\n                'worker_id' => $workerId,\n                'construction_worker_id' => $workerId,\n                'invite_worker_id' => $workerId,\n                'quote_worker_id' => $workerId,\n                'repair_worker_id' => $workerId,\n            ]\n        );\n    }\n}","server/app/Contracts/OrderCenterRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCenterRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array{rows:array<int,array<string,mixed>>,has_more:bool}\n     */\n    public function page(array $actor, string $kind, string $status, int $page, int $limit, string $keyword = ''): array;\n\n    /** @param array<string,mixed> $actor */\n    public function supplementCount(array $actor, string $kind): int;\n\n    /** @param array<string,mixed> $actor */\n    public function todoCount(array $actor, string $kind): int;\n}\n"},"blob_shas":{"chat/build.sh":"c9d2e8c654fac590d6533b2dfaa9d6e31e3d1aaa","chat/cmd/chatd/main.go":"ecd53d4d9b8d37dd714e8148a8e606a52801870f","chat/go.mod":"9e5d6b33a9a9fd732dcd518a1e8a8a3c7af2deba","chat/go.sum":"fb24675236722882b2484e1d8be224fa18a08a0e","chat/internal/auth/auth_test.go":"ee4c10778cc9abd6326ed781f4e924379c137eb3","chat/internal/auth/config.go":"0e0744e04da056a2450467411c085136ab