ch->switchWorker(['user_id'=>10001],'CHAT-ASG',$quotePublic,'fixture');}catch(PDOException $error){$failed=($error->errorInfo[1]??0)===1644;}\n        $db->execute('DROP TRIGGER fixture_switch_event_failure');\n        policyAssert($failed && (int)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77')===$offered,'guard failure rolls actual customer switch back');\n        policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM assignments')===$count && $db->fetchValue('SELECT status FROM assignments WHERE id=:id',['id'=>$offered])==='offered','failed switch preserves assignment history and current offer');\n        $switch->switchWorker(['user_id'=>10001],'CHAT-ASG',$quotePublic,'fixture');\n        $current=(int)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77');\n        policyAssert($current!==100 && $current!==$offered && $db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=:id',['id'=>$current])==='open','same original worker returns on independent accepted scope');\n        policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='readonly','returning worker never reopens original scope');\n        policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards WHERE state='open'\")===1,'only one active assignment scope');\n        $workbench->reassignWorker(['user_id'=>10004],'CHAT-ASG',20,'fixture timeout');\n        $expiring=(int)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77');\n        $db->execute('UPDATE assignments SET accept_deadline_at=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 HOUR) WHERE id=:id',['id'=>$expiring]);\n        policyAssert((new AssignmentTimeoutProcessor($db))->expireProduction($expiring),'actual production timeout executes');\n        policyAssert($db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77')===null && $db->fetchValue('SELECT status FROM assignments WHERE id=:id',['id'=>$expiring])==='expired','timeout clears current assignment');\n        policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards WHERE state='open'\")===0,'timeout never invents a grant');\n        echo \"完整新装库的真实管理员改派、客户换回、故障回滚与指派超时验证通过\\n\";\n        require_once __DIR__.'/chat_repair_contract.php';\n        chatRepairEpisodeContract($db);\n        chatPlatformStaffContract($db,$config);\n        require_once __DIR__.'/chat_platform_contract.php';\n        chatPlatformLifecycleContract($db,$config);\n    } finally {$admin->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n}\n\n/** Real source tables from database.sql; no miniature imitation of staff SQL. */\nfunction chatPlatformStaffContract(Database $db,array $config): void\n{\n    $staffReader=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatPlatformStaff($db);\n    $outside=false;try{$staffReader->readLocked();}catch(RuntimeException $error){$outside=true;}\n    policyAssert($outside,'platform staff requires owning transaction');\n    $write=static function(string $key,string $value,string $type='string')use($db):void{\n        $db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,created_at,updated_at)\n            VALUES(:key,:value,:type,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n            ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type=VALUES(value_type)\",['key'=>$key,'value'=>$value,'type'=>$type]);\n    };\n    $identity=static function(int $user,string $app,string $openid,string $status='active')use($db):int{\n        return $db->insert(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at)\n            VALUES(:user,:app,:openid,:status,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['user'=>$user,'app'=>$app,'openid'=>$openid,'status'=>$status]);\n    };\n    $read=static function()use($db,$staffReader):array{return $db->transaction(static function()use($staffReader):array{return $staffReader->readLocked();});};\n    foreach([10101,10102,10103,10104] as $id)$db->execute(\"INSERT INTO users(id,public_id,status,created_at,updated_at) VALUES(:id,:public,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id,'public'=>public_id()]);\n    $write('wechat.miniapp_appid','chat-staff-app');\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\",\"Disabled\",\"WrongApp\"]','json');\n    $identity(10101,'chat-staff-app','StaffA');$identity(10102,'chat-staff-app','StaffB');\n    $identity(10103,'chat-staff-app','Disabled');$identity(10104,'other-app','WrongApp');\n    $db->execute(\"UPDATE users SET status='disabled' WHERE id=10103\");\n    $expected=['10101','10102'];\n    policyAssert(array_column($read(),'actor_id')===$expected,'only current active configured mini identities, bounded and ordered');\n    $write('wechat.admin_openids',\" StaffB，StaffA  StaffA\\n\");\n    policyAssert(array_column($read(),'actor_id')===$expected,'legacy delimiter normalization matches existing mini-admin authority');\n    $write('wechat.admin_openids','[\"StaffA\",\"staffb\"]','json');\n    policyAssert(array_column($read(),'actor_id')===['10101'],'OpenID comparisons are exact, not database case folding');\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\"]','json');\n    $newIdentity=$identity(10101,'chat-staff-app','NonAdminLatest');\n    policyAssert(array_column($read(),'actor_id')===['10102'],'old configured identity cannot override latest active app identity');\n    $db->execute(\"UPDATE wechat_identities SET status='revoked' WHERE id=:id\",['id'=>$newIdentity]);\n    policyAssert(array_column($read(),'actor_id')===$expected,'latest active identity matches original repository rule');\n    foreach([['[[\"StaffA\"]]','json'],['[\"StaffA\",{}]','string'],['{\"broken\"','json'],['enc:v1:unusable','string'],['1','integer']] as [$value,$type]){\n        $write('wechat.admin_openids',$value,$type);policyAssert($read()===[],'invalid configuration fails closed without scalar coercion');\n    }\n    $write('wechat.admin_openids',json_encode(range(1,9)),'json');policyAssert($read()===[],'non-string admin IDs rejected');\n    $write('wechat.admin_openids',json_encode(array_map('strval',range(1,9))),'json');policyAssert($read()===[],'over-budget staff configuration cannot grant partial list');\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\"]','json');\n    $other=new Database($config);\n    $db->transaction(static function(Database $db)use($other,$staffReader):void{\n        $db->fetchValue(\"SELECT setting_value FROM system_settings WHERE setting_key='wechat.admin_openids'\");\n        $other->execute(\"UPDATE system_settings SET setting_value='[\\\"StaffB\\\"]' WHERE setting_key='wechat.admin_openids'\");\n        policyAssert(array_column($staffReader->readLocked(),'actor_id')===['10102'],'configuration source bypasses stale transaction snapshots');\n    });\n    $write('wechat.admin_openids','[\"StaffA\",\"StaffB\"]','json');\n    $db->transaction(static function(Database $db)use($other,$staffReader,$identity):void{\n        $db->fetchValue('SELECT MAX(id) FROM wechat_identities WHERE user_id=10101');\n        $other->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10101,'chat-staff-app','NewerNonAdmin','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n        policyAssert(array_column($staffReader->readLocked(),'actor_id')===['10102'],'latest identity read also bypasses stale transaction snapshots');\n    });\n    $other->execute(\"UPDATE wechat_identities SET status='revoked' WHERE openid='NewerNonAdmin'\");\n    $other->execute('SET SESSION innodb_lock_wait_timeout=1');\n    foreach([\n        \"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\",\n        \"UPDATE wechat_identities SET status='revoked' WHERE user_id=10101 AND openid='StaffA'\",\n        \"UPDATE users SET status='disabled' WHERE id=10101\",\n    ] as $mutation){\n        $db->transaction(static function()use($other,$staffReader,$mutation):void{\n            $staffReader->readLocked();$blocked=false;\n            try{$other->execute($mutation);}catch(PDOException $error){$blocked=($error->errorInfo[1]??0)===1205;}\n            policyAssert($blocked,'source shared locks serialize actual staff revocation mutations');\n        });\n    }\n    policyAssert(array_column($read(),'actor_id')===$expected,'failed concurrent mutation preserves authority');\n    // Actual source/config changes are observable; integration hooks are c3.b.\n    $write('wechat.admin_openids','[\"StaffB\"]','json');\n    policyAssert(array_column($read(),'actor_id')===['10102'],'removed administrator disappears immediately from fresh candidate facts');\n    $db->execute(\"UPDATE wechat_identities SET status='revoked' WHERE user_id=10102 AND openid='StaffB'\");\n    policyAssert($read()===[],'revoked identity cannot create a staff candidate');\n    $platformCount=(int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards g JOIN orders o ON o.id=g.order_id WHERE o.order_source_type='platform'\");\n    policyAssert($platformCount===0,'candidate reader never writes or grants production platform scope');\n    echo \"平台工作人员真实设置/微信身份/状态、最新快照及共享锁专项通过\\n\";\n}\n","server/tests/v250_transaction_mysql.php":"<?php\n\ndeclare(strict_types=1);\n\nif ((string)getenv('V250_PLATFORM_MYSQL_TEST') !== '1') {\n    fwrite(STDOUT, \"[SKIP] V250 MySQL transaction regression disabled.\\n\");\n    exit(0);\n}\n\n$root = dirname(__DIR__, 2);\nrequire_once $root . '/server/app/Core/Database.php';\n\nuse WorkerAdmin\\Core\\Database;\n\nfunction txAssert(bool $condition, string $label): void\n{\n    if (!$condition) {\n        fwrite(STDERR, '[FAIL] ' . $label . \"\\n\");\n        exit(1);\n    }\n    fwrite(STDOUT, '[PASS] ' . $label . \"\\n\");\n}\n\n$config = [\n    'host'=>(string)(getenv('V250_DB_HOST') ?: '127.0.0.1'),\n    'port'=>(int)(getenv('V250_DB_PORT') ?: 3306),\n    'database'=>(string)(getenv('V250_DB_NAME') ?: 'worker_test'),\n    'username'=>(string)(getenv('V250_DB_USER') ?: 'root'),\n    'password'=>(string)(getenv('V250_DB_PASSWORD') ?: 'root'),\n    'charset'=>'utf8mb4',\n];\n\n$db = new Database($config);\n$db->execute('DROP TABLE IF EXISTS v250_transaction_probe');\n$db->execute('CREATE TABLE v250_transaction_probe(id INT UNSIGNED NOT NULL AUTO_INCREMENT, marker VARCHAR(32) NOT NULL, PRIMARY KEY(id)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4');\n\ntry {\n    $db->transaction(function (Database $db): void {\n        $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('outer_ok')\");\n        $db->transaction(function (Database $db): void {\n            $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('inner_ok')\");\n        });\n    });\n    txAssert((int)$db->fetchValue('SELECT COUNT(*) FROM v250_transaction_probe') === 2, '正常嵌套事务只由最外层提交');\n\n    $rollbackOnlyThrown = false;\n    try {\n        $db->transaction(function (Database $db): void {\n            $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('outer_before_fail')\");\n            try {\n                $db->transaction(function (Database $db): void {\n                    $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('inner_fail')\");\n                    throw new RuntimeException('inner failure');\n                });\n            } catch (RuntimeException $ignored) {\n                // 模拟业务层错误捕获：数据库仍必须阻止外层把部分事实提交。\n            }\n            $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('outer_after_catch')\");\n        });\n    } catch (RuntimeException $exception) {\n        $rollbackOnlyThrown = strpos($exception->getMessage(), '禁止提交部分业务结果') !== false;\n    }\n    txAssert($rollbackOnlyThrown, '内层失败被业务捕获后最外层仍强制 rollback-only');\n    txAssert((int)$db->fetchValue('SELECT COUNT(*) FROM v250_transaction_probe') === 2, 'rollback-only 未留下任何部分写入');\n\n    $db->transaction(function(Database $db):void{\n        $db->beforeCommit('same',static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('superseded_hook')\");});\n        $db->transaction(static function(Database $db):void{\n            $db->beforeCommit('same',static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('deduplicated_hook')\");});\n        });\n        txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='deduplicated_hook'\")===0,'预提交工作不会在内层事务提前运行');\n    });\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='deduplicated_hook'\")===1,'同键预提交工作合并一次');\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='superseded_hook'\")===0,'重复键使用最后登记的动作');\n    $failed=false;\n    try{$db->transaction(static function(Database $db):void{\n        $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('must_rollback')\");\n        $db->beforeCommit('fail',static function():void{throw new RuntimeException('fixture hook failure');});\n    });}catch(RuntimeException $error){$failed=$error->getMessage()==='fixture hook failure';}\n    txAssert($failed && (int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='must_rollback'\")===0,'预提交失败会回滚原业务写入');\n    $called=0;$failed=false;\n    try{$db->transaction(static function(Database $db)use(&$called):void{\n        try{$db->transaction(static function(Database $db)use(&$called):void{\n            $db->beforeCommit('cancelled',static function()use(&$called):void{$called++;});\n            throw new RuntimeException('fixture nested failure');\n        });}catch(RuntimeException $ignored){}\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed && $called===0,'rollback-only不执行已登记回调');\n    $failed=false;try{$db->beforeCommit('outside',static function():void{});}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed,'事务外登记被拒绝');\n    $failed=false;try{$db->transaction(static function(Database $db):void{\n        $db->beforeCommit('reentrant',static function(Database $db):void{$db->beforeCommit('nested',static function():void{});});\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed,'预提交执行中不得递归登记');\n    $failed=false;try{$db->transaction(static function(Database $db):void{\n        for($i=0;$i<129;$i++)$db->beforeCommit('bounded:'.$i,static function():void{});\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed,'预提交队列最多128个不同键');\n    $db->transaction(static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('after_hook_failure')\");});\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='after_hook_failure'\")===1,'失败回调不会泄漏到下一事务');\n    $db->transaction(static function(Database $db):void{\n        $db->beforeCommit('nested-write',static function(Database $db):void{\n            $db->transaction(static function(Database $db):void{$db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('hook_nested_sql')\");});\n        });\n    });\n    txAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='hook_nested_sql'\")===1,'预提交动作内的嵌套SQL仍加入同一事务');\n    $failed=false;try{$db->transaction(static function(Database $db):void{\n        $db->beforeCommit('caught-hook-error',static function(Database $db):void{\n            try{$db->transaction(static function(Database $db):void{\n                $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('caught_hook_failure')\");throw new RuntimeException('fixture');\n            });}catch(RuntimeException $ignored){}\n        });\n    });}catch(RuntimeException $error){$failed=true;}\n    txAssert($failed && (int)$db->fetchValue(\"SELECT COUNT(*) FROM v250_transaction_probe WHERE marker='caught_hook_failure'\")===0,'预提交内捕获的嵌套失败仍禁止外层提交');\n\n    $pdo1 = $db->pdo();\n    $db2 = new Database($config);\n    $pdo2 = $db2->pdo();\n    $db->execute(\"INSERT INTO v250_transaction_probe(marker) VALUES('lock_probe')\");\n    $lockId = (int)$pdo1->lastInsertId();\n    $pdo1->beginTransaction();\n    $stmt1 = $pdo1->prepare('SELECT id FROM v250_transaction_probe WHERE id=:id FOR UPDATE');\n    $stmt1->execute(['id'=>$lockId]);\n    $pdo2->exec('SET SESSION innodb_lock_wait_timeout=1');\n    $blocked = false;\n    try {\n        $stmt2 = $pdo2->prepare('SELECT id FROM v250_transaction_probe WHERE id=:id FOR UPDATE');\n        $stmt2->execute(['id'=>$lockId]);\n    } catch (Throwable $exception) {\n        $blocked = true;\n    }\n    if ($pdo1->inTransaction()) $pdo1->rollBack();\n    txAssert($blocked, 'MySQL 5.7 双连接 FOR UPDATE 会串行化同一业务行');\n} finally {\n    try { if ($db->pdo()->inTransaction()) $db->pdo()->rollBack(); } catch (Throwable $ignored) {}\n    try { $db->execute('DROP TABLE IF EXISTS v250_transaction_probe'); } catch (Throwable $ignored) {}\n}\n\necho \"V2.5.0 MySQL transaction/concurrency regression: OK\\n\";\n\n","server/app/Infrastructure/Persistence/DatabaseMessageOutboxRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse Throwable;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\MessageOutboxRepository;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy;\n\nfinal class DatabaseMessageOutboxRepository implements MessageOutboxRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function schema(): array\n    {\n        try {\n            $exists = (int) $this->db->fetchValue(\"SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='message_outbox'\");\n            if ($exists < 1) {\n                return [\n                    'ready' => false,\n                    'columns' => [],\n                    'message' => '消息发送记录表尚未建立，请先在系统升级页完成当前版本数据库升级。',\n                ];\n            }\n\n            $columnRows = $this->db->fetchAll('SHOW COLUMNS FROM message_outbox');\n            $columns = [];\n            foreach ($columnRows as $columnRow) {\n                $field = (string) ($columnRow['Field'] ?? $columnRow['field'] ?? '');\n                if ($field !== '') $columns[$field] = true;\n            }\n            $required = ['id', 'topic', 'business_key', 'status'];\n            $missing = array_values(array_filter($required, static function (string $field) use ($columns): bool {\n                return !isset($columns[$field]);\n            }));\n            if ($missing) {\n                \\write_log('admin-message-outbox', '[' . date('c') . '] schema missing columns: ' . implode(',', $missing) . \"\\n\");\n                return [\n                    'ready' => false,\n                    'columns' => $columns,\n                    'message' => '消息发送记录表结构与当前版本不一致，请先完成数据库升级后再查看。',\n                ];\n            }\n            return ['ready' => true, 'columns' => $columns, 'message' => ''];\n        } catch (Throwable $exception) {\n            \\write_log('admin-message-outbox', '[' . date('c') . '] schema read failed: ' . mb_substr($exception->getMessage(), 0, 500) . \"\\n\");\n            return [\n                'ready' => false,\n                'columns' => [],\n                'message' => '消息发送记录暂时无法读取，请检查数据库升级状态后重试。',\n            ];\n        }\n    }\n\n    public function dashboard(string $status, string $q, int $page, string $tab = 'records'): array\n    {\n        $result = ['rows'=>[], 'total'=>0, 'page'=>1, 'pages'=>1, 'per_page'=>20];\n        $suppressionResult = ['rows'=>[], 'total'=>0, 'page'=>1, 'pages'=>1, 'per_page'=>20];\n        $failedCount = 0;\n        $schema = $this->schema();\n        $schemaWarning = (string) ($schema['message'] ?? '');\n\n        if (!empty($schema['ready'])) {\n            $columns = (array) ($schema['columns'] ?? []);\n            $has = static function (string $field) use ($columns): bool { return isset($columns[$field]); };\n            try {\n                $where = ['1=1'];\n                $params = [];\n                if ($status !== '') {\n                    $where[] = 'm.status=:status';\n                    $params['status'] = $status;\n                }\n                if ($q !== '') {\n                    $like = '%' . $q . '%';\n                    $searchParts = ['CAST(m.business_key AS CHAR CHARACTER SET utf8mb4) COLLATE utf8mb4_general_ci LIKE :q_key'];\n                    $params['q_key'] = $like;\n                    if ($has('last_error')) {\n                        $searchParts[] = 'CAST(m.last_error AS CHAR CHARACTER SET utf8mb4) COLLATE utf8mb4_general_ci LIKE :q_error';\n                        $params['q_error'] = $like;\n                    }\n                    if ($has('payload_json')) {\n                        $searchParts[] = 'CAST(m.payload_json AS CHAR CHARACTER SET utf8mb4) COLLATE utf8mb4_general_ci LIKE :q_payload';\n                        $params['q_payload'] = $like;\n                    }\n                    $where[] = '(' . implode(' OR ', $searchParts) . ')';\n                }\n\n                $paidSmsReady = $this->db->tableExists('order_worker_sms_invites') && $this->db->tableExists('order_worker_sms_batches');\n                $select = [\n                    'm.id', 'm.topic', 'm.business_key', 'm.status',\n                    $has('payload_json') ? 'm.payload_json AS _payload_json' : 'NULL AS _payload_json',\n                    $has('attempt_count') ? 'm.attempt_count' : '0 AS attempt_count',\n                    $has('next_attempt_at') ? 'm.next_attempt_at' : 'NULL AS next_attempt_at',\n                    $has('last_error') ? 'm.last_error' : 'NULL AS last_error',\n                    $has('created_at') ? 'm.created_at' : 'NULL AS created_at',\n                    $has('processed_at') ? 'm.processed_at' : ($has('updated_at') ? 'm.updated_at AS processed_at' : 'NULL AS processed_at'),\n                ];\n                $join = '';\n                if ($paidSmsReady) {\n                    $select[] = 'psi.delivery_status AS paid_delivery_status';\n                    $select[] = 'psi.billing_status AS paid_billing_status';\n                    $select[] = 'psi.worker_name_snapshot AS paid_worker_name';\n                    $select[] = 'psi.fee_cents_snapshot AS paid_fee_cents';\n                    $select[] = 'psb.public_no AS paid_batch_no';\n                    $join = ' LEFT JOIN order_worker_sms_invites psi ON psi.outbox_id=m.id LEFT JOIN order_worker_sms_batches psb ON psb.id=psi.batch_id';\n                } else {\n                    $select[] = 'NULL AS paid_delivery_status';\n                    $select[] = 'NULL AS paid_billing_status';\n                    $select[] = 'NULL AS paid_worker_name';\n                    $select[] = 'NULL AS paid_fee_cents';\n                    $select[] = 'NULL AS paid_batch_no';\n                }\n                $result = $this->paginate(\n                    'SELECT ' . implode(',', $select) . ' FROM message_outbox m' . $join . ' WHERE ' . implode(' AND ', $where) . ' ORDER BY m.id DESC',\n                    'SELECT COUNT(*) FROM message_outbox m WHERE ' . implode(' AND ', $where),\n                    $params, $tab === 'records' ? $page : 1\n                );\n\n                foreach ($result['rows'] as &$messageRow) {\n                    $safeError = (string) ($messageRow['last_error'] ?? '');\n                    $safeError = preg_replace('/(?<!\\\\d)1[3-9]\\\\d{9}(?!\\\\d)/', '1**********', $safeError);\n                    $safeError = preg_replace('#https?://qyapi\\\\.weixin\\\\.qq\\\\.com/cgi-bin/webhook/send\\\\?key=[A-Za-z0-9_-]+#i', '企业微信 Webhook 地址已隐藏', $safeError);\n                    $messageRow['last_error_display'] = mb_substr((string) $safeError, 0, 1000);\n                }\n                unset($messageRow);\n\n                if ($has('attempt_count')) {\n                    $failedCount = (int) $this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic IN ('aliyun_sms','wecom_webhook','wechat_subscribe') AND status='failed' AND attempt_count>=5\");\n                }\n            } catch (Throwable $exception) {\n                \\write_log('admin-message-outbox', '[' . date('c') . '] list read failed: ' . mb_substr($exception->getMessage(), 0, 500) . \"\\n\");\n                $result = ['rows'=>[], 'total'=>0, 'page'=>1, 'pages'=>1, 'per_page'=>20];\n                $failedCount = 0;\n                $schemaWarning = '消息发送记录读取失败。后台其他功能不受影响，请检查数据库升级状态或服务器日志后重试。';\n            }\n        }\n\n        if($this->db->tableExists('sms_recipient_suppressions')){\n            try{\n                $suppressionResult=$this->paginate(\n                    \"SELECT id,mobile_masked,reason,note,status,created_at,updated_at FROM sms_recipient_suppressions WHERE status='active' ORDER BY id DESC\",\n                    \"SELECT COUNT(*) FROM sms_recipient_suppressions WHERE status='active'\",\n                    [], $tab === 'suppressions' ? $page : 1\n                );\n            }catch(Throwable $exception){\n                \\write_log('admin-sms-suppression','['.date('c').'] list failed: '.mb_substr($exception->getMessage(),0,500).\"\\n\");\n            }\n        }\n\n        return [\n            'result'=>$result,\n            'suppressionResult'=>$suppressionResult,\n            'status'=>$status,\n            'q'=>$q,\n            'failedCount'=>$failedCount,\n            'schemaWarning'=>$schemaWarning,\n        ];\n\n    }\n\n    public function retry(int $id): array\n    {\n        $schema = $this->schema();\n        $columns = (array) ($schema['columns'] ?? []);\n        if (empty($schema['ready']) || !isset($columns['attempt_count'])) {\n            throw new RuntimeException((string)(($schema['message'] ?? '') ?: '消息发送记录表缺少重试字段，请先完成数据库升级。'));\n        }\n\n        $message = $this->db->transaction(function (Database $db) use ($id, $columns) {\n            $row = $db->fetch('SELECT id,topic,status,attempt_count FROM message_outbox WHERE id=:id FOR UPDATE', ['id' => $id]);\n            MessageOutboxPolicy::requireDeadLetter($row, 'retry');\n            $sets = [\"status='pending'\", 'attempt_count=0'];\n            if (isset($columns['next_attempt_at'])) $sets[] = 'next_attempt_at=UTC_TIMESTAMP()';\n            if (isset($columns['last_error'])) $sets[] = 'last_error=NULL';\n            if (isset($columns['processed_at'])) $sets[] = 'processed_at=NULL';\n            $changed = $db->execute('UPDATE message_outbox SET ' . implode(',', $sets) . \" WHERE id=:id AND status='failed' AND attempt_count>=5\", ['id' => $id]);\n            if ($changed !== 1) throw new RuntimeException('消息状态已变化，没有重复加入重试队列。');\n            return $row;\n        });\n        return $message;\n    }\n\n    public function close(int $id): array\n    {\n        $schema = $this->schema();\n        $columns = (array) ($schema['columns'] ?? []);\n        if (empty($schema['ready']) || !isset($columns['attempt_count'])) {\n            throw new RuntimeException((string)(($schema['message'] ?? '') ?: '消息发送记录表缺少结案所需字段，请先完成数据库升级。'));\n        }\n\n        $message = $this->db->transaction(function (Database $db) use ($id, $columns) {\n            $row = $db->fetch('SELECT id,topic,status,attempt_count FROM message_outbox WHERE id=:id FOR UPDATE', ['id' => $id]);\n            MessageOutboxPolicy::requireDeadLetter($row, 'close');\n            $sets = [\"status='closed'\"];\n            if (isset($columns['next_attempt_at'])) $sets[] = 'next_attempt_at=NULL';\n            $changed = $db->execute('UPDATE message_outbox SET ' . implode(',', $sets) . \" WHERE id=:id AND status='failed' AND attempt_count>=5\", ['id' => $id]);\n            if ($changed !== 1) throw new RuntimeException('消息状态已变化，没有执行结案。');\n            return $row;\n        });\n        return $message;\n    }\n\n    public function addSuppression(string $hmac, string $masked, string $reason, string $note, int $adminId): void\n    {\n        if(!$this->db->tableExists('sms_recipient_suppressions')){\n            throw new RuntimeException('短信抑制名单表尚未建立，请先完成数据库升级。');\n        }\n        $this->db->execute(\n            \"INSERT INTO sms_recipient_suppressions\n             (mobile_hmac,mobile_masked,reason,note,status,created_by_admin_id,created_at,updated_at)\n             VALUES(:hmac,:masked,:reason,:note,'active',:admin,UTC_TIMESTAMP(),UTC_TIMESTAMP())\n             ON DUPLICATE KEY UPDATE mobile_masked=VALUES(mobile_masked),reason=VALUES(reason),note=VALUES(note),\n                                     status='active',created_by_admin_id=VALUES(created_by_admin_id),updated_at=UTC_TIMESTAMP()\",\n            ['hmac'=>$hmac,'masked'=>$masked,'reason'=>$reason,'note'=>$note!==''?$note:null,'admin'=>$adminId]\n        );\n    }\n\n    public function removeSuppression(int $id): array\n    {\n        $row=$this->db->fetch('SELECT id,mobile_masked,status FROM sms_recipient_suppressions WHERE id=:id LIMIT 1',['id'=>$id]);\n        if(!$row)throw new RuntimeException('抑制名单记录不存在。');\n        $this->db->execute(\n            \"UPDATE sms_recipient_suppressions SET status='inactive',updated_at=UTC_TIMESTAMP() WHERE id=:id AND status='active'\",\n            ['id'=>$id]\n        );\n        return $row;\n    }\n    private function paginate($sql, $countSql, array $params, int $page)\n    {\n        $page=max(1,$page); $perPage=20; $total=(int)$this->db->fetchValue($countSql,$params); $pages=max(1,(int)ceil($total/$perPage)); $page=min($page,$pages); $offset=($page-1)*$perPage;\n        $rows=$this->db->fetchAll($sql.' LIMIT '.$perPage.' OFFSET '.$offset,$params);\n        return ['rows'=>$rows,'total'=>$total,'page'=>$page,'pages'=>$pages,'per_page'=>$perPage];\n    }\n}\n","server/app/Infrastructure/Messaging/DatabaseSubscriptionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\SubscriptionRepository;\n\n\nfinal class DatabaseSubscriptionRepository implements SubscriptionRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function definitions(): array { return SubscriptionCatalog::subscriptionSceneDefinitions(); }\n    public function preferences(int $userId): array { return SubscriptionQuotaStore::subscriptionPreferences($this->db, $userId); }\n    public function save(int $userId, string $key, bool $enabled, string $status): array\n    { return SubscriptionQuotaStore::saveSubscriptionPreference($this->db, $userId, $key, $enabled, $status); }\n    public function diagnose(int $userId): array\n    {\n        $where=\"topic='wechat_subscribe' AND JSON_VALID(payload_json) AND CAST(JSON_UNQUOTE(JSON_EXTRACT(payload_json,'$.user_id')) AS UNSIGNED)=:user_id\";\n        $pending=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE \".$where.\" AND status IN ('pending','processing')\",['user_id'=>$userId]);\n        $processed24h=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE \".$where.\" AND status='processed' AND processed_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 DAY)\",['user_id'=>$userId]);\n        $failed24h=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE \".$where.\" AND status='failed' AND created_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 DAY)\",['user_id'=>$userId]);\n        $lastError=(string)($this->db->fetchValue(\"SELECT last_error FROM message_outbox WHERE \".$where.\" AND status='failed' AND last_error IS NOT NULL ORDER BY id DESC LIMIT 1\",['user_id'=>$userId])?:'');\n        $lastErrorCode='';\n        if($lastError!==''&&preg_match('/微信订阅消息发送失败（(\\d+)）/u',$lastError,$match)===1)$lastErrorCode=(string)($match[1]??'');\n        $dispatcherRecent=(int)$this->db->fetchValue(\"SELECT COUNT(*) FROM scheduler_runs WHERE job_name='sms_dispatch' AND started_at>=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 10 MINUTE)\")>0;\n        $dispatcherLast=$this->db->fetch(\"SELECT status,started_at,finished_at,failure_count FROM scheduler_runs WHERE job_name='sms_dispatch' ORDER BY id DESC LIMIT 1\");\n        $dispatcherHealthy=$dispatcherRecent&&((string)($dispatcherLast['status']??'')==='success');\n        return [\n            'subscribe_enabled'=>filter_var(\\setting('wechat.subscribe_enabled',true),FILTER_VALIDATE_BOOLEAN),\n            'appid_configured'=>trim((string)\\setting('wechat.miniapp_appid',''))!=='',\n            'secret_configured'=>trim((string)\\setting('wechat.miniapp_secret',''))!=='',\n            'env_version'=>(string)\\setting('wechat.miniapp_env_version','formal'),\n            'dispatcher_recent'=>$dispatcherRecent,\n            'dispatcher_healthy'=>$dispatcherHealthy,\n            'dispatcher_last_status'=>(string)($dispatcherLast['status']??''),\n            'dispatcher_last_at'=>(string)($dispatcherLast['started_at']??''),\n            'pending_count'=>$pending,\n            'processed_24h'=>$processed24h,\n            'failed_24h'=>$failed24h,\n            'last_failure_code'=>$lastErrorCode,\n        ];\n\n    }\n}\n","server/app/Domain/Order/OrderOperationException.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Order;\n\nuse RuntimeException;\nuse Throwable;\n\nfinal class OrderOperationException extends RuntimeException\n{\n    private string $apiCode;\n    /** @var array<string,mixed> */\n    private array $data;\n\n    /** @param array<string,mixed> $data */\n    public function __construct(string $message, string $apiCode, int $httpStatus = 422, array $data = [], ?Throwable $previous = null)\n    {\n        parent::__construct($message, $httpStatus, $previous);\n        $this->apiCode = $apiCode;\n        $this->data = $data;\n    }\n\n    public function apiCode(): string\n    {\n        return $this->apiCode;\n    }\n\n    /** @return array<string,mixed> */\n    public function data(): array\n    {\n        return $this->data;\n    }\n}\n","server/app/Infrastructure/Persistence/OrderAutomaticAcceptanceWriter.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n\n/** 自动验收事务步骤；调用者负责锁订单、到期/风险校验及任务领取。与测试限定入口共用。 */\nfinal class OrderAutomaticAcceptanceWriter\n{\n    public function apply(Database $db,array $order,callable $recordEvent,callable $finalizeCommission): void\n    {\n        $orderId=(int)$order['id'];$businessVersion=max(1,(int)$order['version']);\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $updated = $db->execute(\n            \"UPDATE orders SET fulfillment_status='accepted',lifecycle_status='completed',auto_accept_at=COALESCE(auto_accept_at,DATE_ADD(completion_submitted_at,INTERVAL 72 HOUR)),accepted_at=UTC_TIMESTAMP(),auto_review_at=DATE_ADD(UTC_TIMESTAMP(),INTERVAL 5 DAY),closed_at=COALESCE(closed_at,UTC_TIMESTAMP()),version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id AND accepted_at IS NULL AND lifecycle_status='active'\",\n            ['id' => $orderId]\n        );\n        if ($updated !== 1) {\n            throw new RuntimeException('订单状态已变化，自动验收未写入。');\n        }\n\n        $versionAfter = (int) $order['version'] + 1;\n        $db->execute(\n            \"UPDATE completion_submissions SET status='accepted',accepted_at=COALESCE(accepted_at,UTC_TIMESTAMP()),accepted_type='auto_72h',updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND status IN ('submitted','pending','pending_acceptance')\",\n            ['id' => $orderId]\n        );\n        $db->execute(\n            \"UPDATE order_deadlines SET status='completed',processed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:id AND deadline_type IN ('auto_accept','auto_accept_completion') AND status IN ('pending','blocked','claimed')\",\n            ['id' => $orderId]\n        );\n        $db->execute(\n            \"INSERT INTO order_deadlines(order_id,deadline_type,status,version,due_at,created_at,updated_at) VALUES (:order_id,'auto_review_order','pending',:version,DATE_ADD(UTC_TIMESTAMP(),INTERVAL 5 DAY),UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE status='pending',due_at=VALUES(due_at),block_reason=NULL,processed_at=NULL,updated_at=UTC_TIMESTAMP()\",\n            ['order_id' => $orderId, 'version' => $versionAfter]\n        );\n        $recordEvent($db, $orderId, 'auto_accepted_72h', 'auto_accept_completion', $businessVersion, [\n            'message' => '师傅提交完工满 72 小时，系统自动确认验收。',\n        ]);\n        // 三种来源共用同一订单自动验收状态机，平台单则走平台收入款与工费结算，\n        // 绝不能创建普通订单佣金；与客户手动验收共用同一个资金写入器。\n        if ((string)($order['order_source_type'] ?? '') === 'platform') {\n            $platformTerms = $db->fetch(\n                'SELECT * FROM order_platform_terms WHERE order_id=:id FOR UPDATE',\n                ['id'=>$orderId]\n            );\n            $platformAssignment = $db->fetch(\n                \"SELECT * FROM assignments WHERE id=:id AND worker_id=:worker_id AND status='accepted' FOR UPDATE\",\n                ['id'=>$order['current_assignment_id'] ?: 0, 'worker_id'=>$order['assigned_worker_id'] ?: 0]\n            );\n            if (!$platformTerms || !$platformAssignment) {\n                throw new RuntimeException('平台单自动验收时成交关系或结算条件不存在');\n            }\n            $settlement = (new PlatformOrderSettlementWriter())->apply($db, $order, $platformTerms, $platformAssignment);\n            $recordEvent($db, $orderId, 'platform_auto_accepted_settlement',\n                'auto_accept_platform_settlement', $businessVersion, [\n                    'customer_tail_cents'=>$settlement['customer_tail_cents'],\n                    'booking_paid_cents'=>$settlement['booking_paid_cents'],\n                    'worker_labor_cents'=>(int)$platformTerms['worker_labor_cents'],\n                    'platform_receivable_cents'=>$settlement['platform_receivable_cents'],\n                    'worker_balance_credit_cents'=>$settlement['worker_balance_credit_cents'],\n                    'settlement_status'=>$settlement['settlement_status'],\n                ]);\n        } else {\n            // 普通订单仍按原流程生成/正式化服务费。\n            $finalizeCommission($db,$orderId);\n        }\n        if(!empty($order['assigned_worker_id'])){$count=(int)$db->fetchValue('SELECT COUNT(*) FROM orders WHERE assigned_worker_id=:worker_id AND accepted_at IS NOT NULL',['worker_id'=>$order['assigned_worker_id']]);$db->execute('UPDATE worker_profiles SET completed_orders=:count,updated_at=UTC_TIMESTAMP() WHERE id=:id',['count'=>$count,'id'=>$order['assigned_worker_id']]);}\n    }\n}\n","server/app/Infrastructure/Persistence/SchedulerOrderEventWriter.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/** Existing scheduler event semantics, now outside the frozen legacy service. */\nfinal class SchedulerOrderEventWriter\n{\n    public function record(Database $db,int $orderId,string $eventType,string $jobName,int $version,array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $eventKey=substr('scheduler:'.$jobName.':order:'.$orderId.':v'.max(1,$version),0,128);\n        $db->execute(\n            \"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,:event_type,:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'event_type'=>$eventType,'event_key'=>$eventKey,\n                'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)]\n        );\n        OrderNotificationService::queue($db,$orderId,$eventKey,$eventType,$payload);\n    }\n}\n","server/app/Infrastructure/Persistence/OrdinaryMeasurementAcceptanceWriter.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n\n/**\n * 普通测量成果确认后的统一资金与终态写入。\n *\n * 调用者负责锁定 order / measurement state / assignment，以及 actor、到期和异常阻断校验。\n */\nfinal class OrdinaryMeasurementAcceptanceWriter\n{\n    /** @return array{gross_amount_cents:int,service_fee_cents:int,worker_net_cents:int,freeze_days:int,max_freeze_days:int} */\n    public function apply(\n        Database $db,\n        array $order,\n        array $assignment,\n        int $autoReviewDays,\n        int $freezeDays,\n        int $maxFreezeDays,\n        callable $recordEvent,\n        string $eventType,\n        string $message\n    ): array {\n        $orderId=(int)($order['id']??0);\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        if($orderId<1||(string)($order['workflow_profile']??'')!=='measurement'||(string)($order['order_source_type']??'consumer')==='platform'){\n            throw new RuntimeException('普通测量确认写入器收到无效订单');\n        }\n        if((int)($assignment['worker_id']??0)<1||(string)($assignment['status']??'')!=='accepted'){\n            throw new RuntimeException('普通测量确认缺少 accepted assignment');\n        }\n\n        $gross=max(0,(int)($order['final_amount_cents']??0));\n        $paid=(int)$db->fetchValue(\n            \"SELECT COALESCE(SUM(amount_cents),0)\n             FROM payment_orders\n             WHERE order_id=:order_id\n               AND business_type IN ('order_booking','measurement_balance','measurement_change')\n               AND status='paid'\",\n            ['order_id'=>$orderId]\n        );\n        if($gross<1||$paid<$gross){\n            throw new RuntimeException('测量服务款尚未全部到账，不能确认');\n        }\n\n        $rate=max(0,min(10000,(int)($assignment['commission_rate_bp_snapshot']??0)));\n        $minimum=max(0,(int)($assignment['commission_min_cents_snapshot']??0));\n        $fee=$this->commissionAmount($gross,$rate,$minimum);\n        $net=max(0,$gross-$fee);\n        $autoReviewDays=max(1,min(30,$autoReviewDays));\n        $freezeDays=max(1,min(36500,$freezeDays));\n        $maxFreezeDays=max($freezeDays,min(36500,$maxFreezeDays));\n\n        $updated=$db->execute(\n            \"UPDATE order_measurement_states\n             SET result_status='accepted',\n                 accepted_at=UTC_TIMESTAMP(),\n                 settlement_status='frozen',\n                 gross_amount_cents=:gross,\n                 service_rate_bp_snapshot=:rate,\n                 service_min_cents_snapshot=:minimum,\n                 service_fee_cents=:fee,\n                 worker_net_cents=:net,\n                 hold_until=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$freezeDays} DAY),\n                 max_hold_until=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$maxFreezeDays} DAY),\n                 settled_at=NULL,\n                 updated_at=UTC_TIMESTAMP()\n             WHERE order_id=:order_id AND result_status='submitted'\",\n            [\n                'gross'=>$gross,\n                'rate'=>$rate,\n                'minimum'=>$minimum,\n                'fee'=>$fee,\n                'net'=>$net,\n                'order_id'=>$orderId,\n            ]\n        );\n        if($updated!==1)throw new RuntimeException('测量成果状态已变化，确认未写入');\n\n        if($net>0){\n            $db->execute(\n                \"INSERT IGNORE INTO worker_balance_ledger(\n                    worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                    business_type,business_id,idempotency_key,description,status,created_at\n                 ) VALUES(\n                    :worker_id,'measurement_income_frozen','credit',:amount,0,:frozen,\n                    'order_measurement',:business_id,:key,:description,'effective',UTC_TIMESTAMP()\n                 )\",\n                [\n                    'worker_id'=>(int)$assignment['worker_id'],\n                    'amount'=>$net,\n                    'frozen'=>$net,\n                    'business_id'=>$orderId,\n                    'key'=>'order-measurement:'.$orderId.':frozen',\n                    'description'=>$eventType==='measurement_auto_accepted'\n                        ?'测量成果自动确认，净收入进入冻结余额'\n                        :'测量成果确认，净收入进入冻结余额',\n                ]\n            );\n        }\n\n        $db->execute(\n            \"UPDATE assignments SET status='completed',updated_at=UTC_TIMESTAMP()\n             WHERE id=:id AND status='accepted'\",\n            ['id'=>(int)$assignment['id']]\n        );\n        $orderUpdated=$db->execute(\n            \"UPDATE orders\n             SET fulfillment_status='accepted',\n                 lifecycle_status='completed',\n                 accepted_at=UTC_TIMESTAMP(),\n                 auto_review_at=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$autoReviewDays} DAY),\n                 closed_at=COALESCE(closed_at,UTC_TIMESTAMP()),\n                 version=version+1,\n                 updated_at=UTC_TIMESTAMP()\n             WHERE id=:id AND lifecycle_status='active' AND fulfillment_status='submitted'\",\n            ['id'=>$orderId]\n        );\n        if($orderUpdated!==1)throw new RuntimeException('测量订单状态已变化，确认未写入');\n\n        $db->insert(\n            \"INSERT INTO order_deadlines(order_id,deadline_type,status,version,due_at,created_at,updated_at)\n             VALUES(:order_id,'auto_review','pending',:version,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$autoReviewDays} DAY),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'version'=>(int)$order['version']+1]\n        );\n\n        $payload=[\n            'gross_amount_cents'=>$gross,\n            'service_fee_cents'=>$fee,\n            'worker_net_cents'=>$net,\n            'freeze_days'=>$freezeDays,\n            'message'=>$message,\n        ];\n        $recordEvent($db,$orderId,$eventType,(int)$order['version']+1,$payload);\n\n        return[\n            'gross_amount_cents'=>$gross,\n            'service_fee_cents'=>$fee,\n            'worker_net_cents'=>$net,\n            'freeze_days'=>$freezeDays,\n            'max_freeze_days'=>$maxFreezeDays,\n        ];\n    }\n\n    private function commissionAmount(int $amount,int $rateBp,int $minimum): int\n    {\n        if($amount<=0||$rateBp<=0)return 0;\n        return min($amount,max((int)round($amount*$rateBp/10000,0,PHP_ROUND_HALF_UP),max(0,$minimum)));\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseAdminWorkbenchOperationsRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\nuse WorkerAdmin\\Contracts\\AdminWorkbenchOperationsRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Infrastructure\\Scheduling\\PlatformOrderAutoPublishTask;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\nfinal class DatabaseAdminWorkbenchOperationsRepository implements AdminWorkbenchOperationsRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db){$this->db=$db;}\n\n    public function reassignWorker(array $actor,string $orderNo,int $workerId,string $reason):array\n    {\n        $miniUserId=(int)($actor['user_id']??0);\n        return $this->db->transaction(function(Database $db)use($orderNo,$workerId,$reason,$miniUserId):array{\n            $order=$db->fetch(\"SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE\",['public_no'=>$orderNo]);\n            if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n            if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                (new DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n            }\n            if((string)$order['lifecycle_status']!=='active'||in_array((string)$order['fulfillment_status'],['submitted','accepted'],true))throw new OrderOperationException('完工已提交、已验收或已结束的订单不能直接改派','ADMIN_REASSIGN_STAGE_BLOCKED',409);\n            if(!in_array((string)($order['refund_status']??'none'),['','none'],true)\n                ||(bool)$db->fetchValue(\"SELECT 1 FROM refunds WHERE order_id=:id AND status NOT IN ('failed','closed','cancelled','rejected') LIMIT 1\",['id'=>$order['id']])\n                ||(bool)$db->fetchValue(\"SELECT 1 FROM order_cancel_requests WHERE order_id=:id AND status IN ('pending','processing') LIMIT 1\",['id'=>$order['id']]))throw new OrderOperationException('订单正在取消或退款处理中，不能直接改派','ADMIN_REASSIGN_FINANCE_BLOCKED',409);\n            if((bool)$db->fetchValue(\"SELECT 1 FROM change_requests WHERE order_id=:id AND status IN ('pending','processing','negotiating') LIMIT 1\",['id'=>$order['id']]))throw new OrderOperationException('订单存在待确认的费用调整，请先处理后再改派','ADMIN_REASSIGN_CHANGE_BLOCKED',409);\n            if((string)($order['order_source_type']??'')==='platform'){$settlement=(string)$db->fetchValue('SELECT settlement_status FROM order_platform_terms WHERE order_id=:id LIMIT 1',['id'=>$order['id']]);if($settlement!==''&&$settlement!=='pending')throw new OrderOperationException('平台单已进入结算阶段，不能直接改派','ADMIN_REASSIGN_SETTLEMENT_BLOCKED',409);}\n\n            $assignmentId=(int)($order['current_assignment_id']??0);\n            $old=$assignmentId>0?$db->fetch(\"SELECT a.*,w.user_id old_worker_user_id,w.display_name old_worker_name FROM assignments a JOIN worker_profiles w ON w.id=a.worker_id WHERE a.id=:id AND a.order_id=:order_id FOR UPDATE\",['id'=>$assignmentId,'order_id'=>$order['id']]):null;\n            if(!$old||!in_array((string)$old['status'],['offered','accepted'],true))throw new OrderOperationException('当前没有可改派的有效师傅指派','ADMIN_REASSIGN_ASSIGNMENT_REQUIRED',409);\n            if((int)$old['worker_id']===$workerId)throw new OrderOperationException('请选择另一位师傅','ADMIN_REASSIGN_SAME_WORKER',409);\n\n            $worker=$db->fetch(\"SELECT w.id,w.user_id,w.public_id,w.display_name,w.verification_status,w.cloud_record_mode,u.status user_status FROM worker_profiles w JOIN users u ON u.id=w.user_id WHERE w.id=:id LIMIT 1 FOR UPDATE\",['id'=>$workerId]);\n            if(!$worker||(string)$worker['verification_status']!=='approved'||(string)$worker['user_status']!=='active')throw new OrderOperationException('新师傅不存在、未审核通过或账号不可用','ADMIN_REASSIGN_WORKER_UNAVAILABLE',422);\n            $orderIsDemo=!empty($order['is_demo']);$workerIsDemo=(string)($worker['cloud_record_mode']??'')==='demo_local';if($orderIsDemo!==$workerIsDemo)throw new OrderOperationException('演示与真实数据环境不能互相改派','DEMO_DATA_BOUNDARY',403);\n            $measurementWorker=$db->fetchValue(\"SELECT worker_id FROM order_relations WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1\",['id'=>$order['id']]);\n            if($measurementWorker!==false&&(int)$measurementWorker!==$workerId)throw new OrderOperationException('关联测量单施工仍绑定原测量师傅；如需更换请新建普通施工单','MEASUREMENT_WORKER_BOUND',409);\n\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id AND status IN ('offered','accepted')\",['id'=>$old['id']]);\n            $db->insert(\"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,snapshot_json,created_at) VALUES(:assignment_id,:order_id,:worker_id,'reassigned',:reason,'mini_admin',:actor_id,:snapshot,UTC_TIMESTAMP())\",[\n                'assignment_id'=>$old['id'],'order_id'=>$order['id'],'worker_id'=>$old['worker_id'],'reason'=>$reason,'actor_id'=>$miniUserId,'snapshot'=>$this->json(['reassigned_to_worker_id'=>$workerId])\n            ]);\n            $db->execute(\"UPDATE order_role_grants SET status='revoked',revoked_at=UTC_TIMESTAMP() WHERE order_id=:order_id AND user_id=:user_id AND status='active'\",['order_id'=>$order['id'],'user_id'=>$old['old_worker_user_id']]);\n            $db->execute(\"UPDATE order_worker_contact_reveal_requests SET status='cancelled',review_note='订单已由管理员改派其他师傅',reviewed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:order_id AND worker_id=:worker_id AND status='pending'\",['order_id'=>$order['id'],'worker_id'=>$old['worker_id']]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:order_id AND status IN ('active','claimed')\",['order_id'=>$order['id']]);\n\n            $acceptHours=max(1,min(72,(int)(function_exists('setting')?\\setting('order.assignment_accept_hours',24):24)));\n            $newAssignmentId=$db->insert(\"INSERT INTO assignments(public_id,order_id,worker_id,quote_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accept_deadline_at,created_by_admin_id,created_at,updated_at) VALUES(:public_id,:order_id,:worker_id,NULL,'admin',:rule_id,:final_amount,:booking_fee,:rate,:minimum,:commission,:offline,:net,'offered',UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$acceptHours} HOUR),NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n                'public_id'=>\\public_id(),'order_id'=>$order['id'],'worker_id'=>$workerId,'rule_id'=>$old['commission_rule_version_id']?:null,'final_amount'=>$old['final_amount_cents_snapshot'],'booking_fee'=>$old['booking_fee_cents_snapshot'],'rate'=>$old['commission_rate_bp_snapshot'],'minimum'=>$old['commission_min_cents_snapshot'],'commission'=>$old['estimated_commission_cents'],'offline'=>$old['estimated_offline_collect_cents'],'net'=>$old['estimated_net_income_cents']\n            ]);\n            $db->insert(\"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,snapshot_json,created_at) VALUES(:assignment_id,:order_id,:worker_id,'offered',:reason,'mini_admin',:actor_id,:snapshot,UTC_TIMESTAMP())\",[\n                'assignment_id'=>$newAssignmentId,'order_id'=>$order['id'],'worker_id'=>$workerId,'reason'=>$reason,'actor_id'=>$miniUserId,'snapshot'=>$this->json(['reassigned_from_worker_id'=>(int)$old['worker_id'],'requires_worker_acceptance'=>true])\n            ]);\n            $db->execute(\"UPDATE orders SET current_assignment_id=:assignment_id,assigned_worker_id=:worker_id,assignment_status='offered',fulfillment_status='not_started',contact_revealed_at=NULL,updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",['assignment_id'=>$newAssignmentId,'worker_id'=>$workerId,'id'=>$order['id']]);\n\n            $eventKey='admin-reassign:'.$order['id'].':'.$newAssignmentId;\n            $payload=['message'=>'平台已改派师傅；新师傅仍需本人确认接单','old_worker_id'=>(int)$old['worker_id'],'old_worker_name'=>(string)$old['old_worker_name'],'new_worker_id'=>$workerId,'new_worker_name'=>(string)$worker['display_name'],'reason'=>$reason,'operator_user_id'=>$miniUserId,'notify_recipients'=>['user','worker']];\n            $db->insert(\"INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,'worker_replaced_by_admin',:event_key,'mini_admin',:actor_id,:payload,UTC_TIMESTAMP())\",['order_id'=>$order['id'],'event_key'=>substr($eventKey,0,128),'actor_id'=>$miniUserId,'payload'=>$this->json($payload)]);\n            OrderNotificationService::queue($db,(int)$order['id'],$eventKey,'worker_replaced_by_admin',$payload);\n\n            $oldNoticeData=$this->json(['order_id'=>(int)$order['id'],'event_key'=>$eventKey,'reassigned_to_worker_id'=>$workerId]);\n            $oldNoticeExists=$db->fetchValue(\"SELECT id FROM notifications WHERE recipient_type='worker' AND recipient_id=:worker_id AND channel='in_app' AND template_key='worker_replaced_by_admin_old' AND BINARY data_json=BINARY :data LIMIT 1\",['worker_id'=>$old['worker_id'],'data'=>$oldNoticeData]);\n            if(!$oldNoticeExists){\n                $db->insert(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,status,scheduled_at,created_at) VALUES(:public_id,'worker',:worker_id,'in_app','worker_replaced_by_admin_old','订单已由平台改派',:content,:data,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n                    'public_id'=>\\public_id(),'worker_id'=>$old['worker_id'],'content'=>'订单 '.(string)$order['public_no'].' 已由平台改派其他师傅，本单访问权限已收回。原因：'.mb_substr($reason,0,120),'data'=>$oldNoticeData,\n                ]);\n            }\n            return ['order_id'=>(string)$order['public_no'],'assignment_id'=>$newAssignmentId,'old_worker'=>['id'=>(int)$old['worker_id'],'name'=>(string)$old['old_worker_name']],'new_worker'=>['id'=>$workerId,'name'=>(string)$worker['display_name']],'assignment_status'=>'offered','requires_worker_acceptance'=>true];\n        });\n    }\n\n    public function interveneRepair(array $actor,string $orderNo,string $afterSaleNo,string $reason):array\n    {\n        $miniUserId=(int)($actor['user_id']??0);\n        return $this->db->transaction(function(Database $db)use($orderNo,$afterSaleNo,$reason,$miniUserId):array{\n            $order=$db->fetch('SELECT id,public_no,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n            $repair=$db->fetch(\"SELECT id,public_no,status,resolution FROM after_sales WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair' LIMIT 1 FOR UPDATE\",['order_id'=>$order['id'],'public_no'=>$afterSaleNo]);\n            if(!$repair||!in_array((string)$repair['status'],['open','processing'],true))throw new OrderOperationException('维修申请不存在或已结束','REPAIR_NOT_ACTIVE',409);\n            $already=strpos((string)($repair['resolution']??''),'平台主动介入：')===0||(bool)$db->fetchValue(\"SELECT 1 FROM order_events WHERE order_id=:order_id AND event_type='repair_platform_intervention_started' AND payload_json LIKE :needle LIMIT 1\",['order_id'=>$order['id'],'needle'=>'%\\\"after_sale_id\\\":\\\"'.$afterSaleNo.'\\\"%']);\n            if($already)return ['order_id'=>$orderNo,'after_sale_id'=>$afterSaleNo,'status'=>'processing','already_intervened'=>true];\n            $db->execute(\"UPDATE after_sales SET status='processing',resolution=:resolution,updated_at=UTC_TIMESTAMP() WHERE id=:id\",['resolution'=>'平台主动介入：'.$reason,'id'=>$repair['id']]);\n            $db->execute('UPDATE orders SET updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id',['id'=>$order['id']]);\n            $eventKey='admin-repair-intervention:'.$repair['id'];$payload=['after_sale_id'=>$afterSaleNo,'reason'=>$reason,'message'=>'平台已主动介入本次维修售后','operator_user_id'=>$miniUserId,'notify_recipients'=>['user','worker']];\n            $db->insert(\"INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,'repair_platform_intervention_started',:event_key,'mini_admin',:actor_id,:payload,UTC_TIMESTAMP())\",['order_id'=>$order['id'],'event_key'=>$eventKey,'actor_id'=>$miniUserId,'payload'=>$this->json($payload)]);\n            OrderNotificationService::queue($db,(int)$order['id'],$eventKey,'repair_platform_intervention_started',$payload);\n            return ['order_id'=>$orderNo,'after_sale_id'=>$afterSaleNo,'status'=>'processing','already_intervened'=>false];\n        });\n    }\n\n    public function retryPlatformAutoPublish(array $actor,string $orderNo,string $sourceId):array\n    {\n        $order=$this->db->fetch(\"SELECT id,public_no,order_source_type,publish_status FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1\",['public_no'=>$orderNo]);\n        if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);if((string)$order['order_source_type']!=='platform')throw new OrderOperationException('只有平台承接单支持自动发布恢复','AUTO_PUBLISH_RETRY_NOT_PLATFORM',409);\n        $failure=$this->db->fetch(\"SELECT id FROM scheduled_job_failures WHERE job_name='platform_auto_publish' AND business_key=:business_key AND resolved_at IS NULL ORDER BY id DESC LIMIT 1\",['business_key'=>'order:'.(int)$order['id']]);\n        if($sourceId!==''&&$failure&&ctype_digit($sourceId)&&(int)$failure['id']!==(int)$sourceId)throw new OrderOperationException('该失败事项已经变化，请刷新后重试','ADMIN_RETRY_STALE_TASK',409);\n        $result=(new PlatformOrderAutoPublishTask($this->db,1))->retryOrder((int)$order['id']);if(empty($result['ok']))throw new OrderOperationException((string)($result['message']??'当前条件仍不满足自动发布'),'ADMIN_RETRY_NOT_READY',409);\n        $this->internalRevision((int)$order['id'],'admin_internal_recovery',(int)($actor['user_id']??0),['note'=>'管理员手动重新检查平台自动发布','result'=>(string)($result['status']??'')]);\n        return ['order_id'=>$orderNo]+$result;\n    }\n\n    public function addInternalFollowup(array $actor,string $orderNo,string $note,?string $followUpAt):array\n    {\n        $order=$this->db->fetch('SELECT id,public_no FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n        $utc=$this->normalizeFollowupTime($followUpAt);$revisionId=$this->internalRevision((int)$order['id'],'admin_internal_followup',(int)($actor['user_id']??0),['note'=>$note,'follow_up_at'=>$utc]);\n        return ['order_id'=>$orderNo,'followup_event_id'=>$revisionId,'note'=>$note,'follow_up_at'=>$utc,'completed'=>false];\n    }\n\n    public function completeInternalFollowup(array $actor,string $orderNo,int $followupEventId,string $note):array\n    {\n        $order=$this->db->fetch('SELECT id,public_no FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n        $followup=$this->db->fetch(\"SELECT id FROM order_revisions WHERE id=:id AND order_id=:order_id AND operator_type='mini_admin' AND JSON_UNQUOTE(JSON_EXTRACT(changes_json,'$.kind'))='admin_internal_followup' LIMIT 1\",['id'=>$followupEventId,'order_id'=>$order['id']]);\n        if(!$followup)throw new OrderOperationException('跟进事项不存在','ADMIN_FOLLOWUP_NOT_FOUND',404);\n        $completed=(bool)$this->db->fetchValue(\"SELECT 1 FROM order_revisions WHERE order_id=:order_id AND operator_type='mini_admin' AND CAST(JSON_UNQUOTE(JSON_EXTRACT(changes_json,'$.completed_of')) AS UNSIGNED)=:completed_of LIMIT 1\",['order_id'=>$order['id'],'completed_of'=>$followupEventId]);\n        if(!$completed)$this->internalRevision((int)$order['id'],'admin_internal_followup_completed',(int)($actor['user_id']??0),['completed_of'=>$followupEventId,'note'=>$note]);\n        return ['order_id'=>$orderNo,'followup_event_id'=>$followupEventId,'completed'=>true];\n    }\n\n    public function workerOptions(string $orderNo,string $keyword,int $limit):array\n    {\n        $order=$this->db->fetch('SELECT id,is_demo,assigned_worker_id FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if(!$order)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);\n        $limit=max(1,min(50,$limit));$params=[];$where=[\"w.verification_status='approved'\",\"u.status='active'\",!empty($order['is_demo'])?\"w.cloud_record_mode='demo_local'\":\"COALESCE(w.cloud_record_mode,'')<>'demo_local'\"];\n        if($keyword!==''){$where[]='(w.display_name LIKE :q_name OR w.public_id LIKE :q_public OR w.mobile_masked LIKE :q_mobile)';$like='%'.mb_substr($keyword,0,50).'%';$params=['q_name'=>$like,'q_public'=>$like,'q_mobile'=>$like];}\n        $rows=$this->db->fetchAll(\"SELECT w.id,w.public_id,w.display_name,w.mobile_masked,w.verification_status FROM worker_profiles w JOIN users u ON u.id=w.user_id WHERE \".implode(' AND ',$where).\" ORDER BY (w.id=:current_worker) DESC,w.id DESC LIMIT {$limit}\",$params+['current_worker'=>(int)($order['assigned_worker_id']??0)]);\n        foreach($rows as &$row){$row['id']=(int)$row['id'];$row['is_current']=$row['id']===(int)($order['assigned_worker_id']??0);}unset($row);return $rows;\n    }\n\n    public function internalFollowups(string $orderNo,int $limit):array\n    {\n        $orderId=(int)$this->db->fetchValue('SELECT id FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1',['public_no'=>$orderNo]);if($orderId<1)throw new OrderOperationException('订单不存在','ORDER_NOT_FOUND',404);$limit=max(1,min(50,$limit));\n        $rows=$this->db->fetchAll(\"SELECT r.id,r.changes_json,r.created_at,r.operator_id,EXISTS(SELECT 1 FROM order_revisions c WHERE c.order_id=r.order_id AND c.operator_type='mini_admin' AND CAST(JSON_UNQUOTE(JSON_EXTRACT(c.changes_json,'$.completed_of')) AS UNSIGNED)=r.id) completed FROM order_revisions r WHERE r.order_id=:order_id AND r.operator_type='mini_admin' AND JSON_UNQUOTE(JSON_EXTRACT(r.changes_json,'$.kind'))='admin_internal_followup' ORDER BY r.id DESC LIMIT {$limit}\",['order_id'=>$orderId]);\n        $items=[];$now=time();foreach($rows as $row){$payload=json_decode((string)$row['changes_json'],true);if(!is_array($payload))$payload=[];$followAt=trim((string)($payload['follow_up_at']??''));$ts=$followAt!==''?strtotime($followAt.' UTC'):false;$items[]=['id'=>(int)$row['id'],'note'=>(string)($payload['note']??''),'follow_up_at'=>$followAt?:null,'created_at'=>(string)$row['created_at'],'operator_user_id'=>(int)($row['operator_id']??0),'completed'=>(bool)$row['completed'],'due'=>!(bool)$row['completed']&&$ts!==false&&$ts<=$now];}return $items;\n    }\n\n    private function normalizeFollowupTime(?string $value):?string\n    {\n        $value=trim((string)$value);if($value==='')return null;try{$timezone=(string)(function_exists('app_config')?\\app_config('app.timezone','Asia/Shanghai'):'Asia/Shanghai');return(new DateTimeImmutable($value,new DateTimeZone($timezone)))->setTimezone(new DateTimeZone('UTC'))->format('Y-m-d H:i:s');}catch(Throwable $e){throw new OrderOperationException('跟进时间格式不正确','ADMIN_FOLLOWUP_TIME_INVALID',422);}\n    }\n\n    private function internalRevision(int $orderId,string $kind,int $actorId,array $payload):int\n    {\n        $version=(int)$this->db->fetchValue('SELECT version FROM orders WHERE id=:id LIMIT 1',['id'=>$orderId]);$changes=['kind'=>$kind]+$payload+['visibility'=>'internal'];\n        return $this->db->insert(\"INSERT INTO order_revisions(order_id,version_before,version_after,changes_json,reason,operator_type,operator_id,created_at) VALUES(:order_id,:version_before,:version_after,:changes,:reason,'mini_admin',:operator_id,UTC_TIMESTAMP())\",['order_id'=>$orderId,'version_before'=>$version,'version_after'=>$version,'changes'=>$this->json($changes),'reason'=>$kind==='admin_internal_followup'?'管理员内部跟进':($kind==='admin_internal_followup_completed'?'管理员完成内部跟进':'管理员恢复操作'),'operator_id'=>$actorId]);\n    }\n\n    private function json(array $payload):string{$json=json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);return is_string($json)?$json:'{}';}\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderQuoteSwitchRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Contracts\\OrderQuoteSwitchRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/** 开工前更换已报价师傅；不产生新的报价金额，也不修改真实预约费支付记录。 */\nfinal class DatabaseOrderQuoteSwitchRepository implements OrderQuoteSwitchRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function switchWorker(array $actor, string $orderPublicNo, string $quotePublicId, string $reason): array\n    {\n        $order = $this->db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :public_no LIMIT 1', ['public_no'=>$orderPublicNo]);\n        if (!$order || (int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) {\n            throw new OrderOperationException('只能更换自己订单的师傅', 'FORBIDDEN', 403);\n        }\n        if ((string)($order['order_source_type'] ?? '') === 'platform') {\n            throw new OrderOperationException('平台承接单由平台安排履约师傅，客户不能直接更换', 'PLATFORM_ORDER_ADMIN_ASSIGNS_WORKER', 409);\n        }\n        if ((string)($order['workflow_profile'] ?? 'construction') === 'measurement') {\n            throw new OrderOperationException('测量成交后不直接更换师傅，如无法继续请走售后处理', 'MEASUREMENT_SWITCH_REQUIRES_AFTERSALE', 409);\n        }\n\n        $result = $this->db->transaction(function (Database $db) use ($actor,$order,$quotePublicId,$reason): array {\n            $locked = $db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE', ['id'=>$order['id']]);\n            if (!$locked || $locked['lifecycle_status'] !== 'active' || $locked['payment_status'] !== 'paid'\n                || empty($locked['current_assignment_id']) || empty($locked['assigned_worker_id'])) {\n                throw new RuntimeException('当前订单不满足更换师傅条件');\n            }\n            if ((string)($locked['order_source_type'] ?? '') === 'platform') throw new RuntimeException('平台承接单由平台安排履约师傅');\n            if (in_array((string)$locked['fulfillment_status'], ['scheduled','in_progress','submitted','accepted'], true)) {\n                throw new RuntimeException('已预约、开工或完工后不能直接更换师傅，请联系平台介入');\n            }\n            if ($db->fetchValue('SELECT id FROM appointment_records WHERE order_id=:id LIMIT 1', ['id'=>$locked['id']])\n                || $db->fetchValue('SELECT id FROM change_requests WHERE order_id=:id LIMIT 1', ['id'=>$locked['id']])\n                || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('open','processing') LIMIT 1\", ['id'=>$locked['id']])) {\n                throw new RuntimeException('订单已产生预约、费用变更或争议，不能直接更换师傅，请联系平台处理');\n            }\n\n            $bookingPayment = $db->fetch(\n                \"SELECT id,public_no,amount_cents FROM payment_orders\n                 WHERE order_id=:order_id AND business_type='order_booking' AND status='paid'\n                 ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$locked['id']]\n            );\n            if (!$bookingPayment) throw new RuntimeException('真实预约费支付记录不存在，暂不能更换师傅');\n\n            $old = $db->fetch(\n                \"SELECT * FROM assignments WHERE id=:id AND order_id=:order_id AND status IN ('offered','accepted') LIMIT 1 FOR UPDATE\",\n                ['id'=>$locked['current_assignment_id'],'order_id'=>$locked['id']]\n            );\n            if (!$old) throw new RuntimeException('原师傅指派状态已变化，请刷新后重试');\n\n            $quote = $db->fetch(\n                \"SELECT q.*,qv.id quote_version_id,qv.commission_rate_bp_snapshot,qv.commission_min_cents_snapshot,qv.rule_acknowledged_at\n                 FROM quotes q\n                 JOIN quote_versions qv ON qv.quote_id=q.id AND qv.version_no=q.current_version\n                 WHERE q.order_id=:order_id AND BINARY q.public_id=BINARY :public_id\n                   AND q.quote_type='worker' AND q.worker_id IS NOT NULL AND q.worker_id<>:old_worker\n                   AND q.status IN ('active','closed') LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$locked['id'],'public_id'=>$quotePublicId,'old_worker'=>$old['worker_id']]\n            );\n            if (!$quote) throw new RuntimeException('请选择该订单中另一位已报价师傅');\n\n            $worker = $db->fetch(\n                \"SELECT w.id,w.verification_status,u.status user_status\n                 FROM worker_profiles w JOIN users u ON u.id=w.user_id\n                 WHERE w.id=:worker_id LIMIT 1 FOR UPDATE\",\n                ['worker_id'=>$quote['worker_id']]\n            );\n            if (!$worker || (string)$worker['verification_status'] !== 'approved' || (string)$worker['user_status'] !== 'active') {\n                throw new RuntimeException('新师傅当前已不具备接单资格，请选择其他报价');\n            }\n\n            $rate = $quote['rule_acknowledged_at'] ? (int)$quote['commission_rate_bp_snapshot'] : (int)$locked['commission_rate_bp'];\n            $minimum = $quote['rule_acknowledged_at'] ? (int)$quote['commission_min_cents_snapshot'] : (int)$locked['commission_min_cents'];\n            $amount = (int)$quote['amount_cents'];\n            $booking = min($amount, (int)$locked['booking_fee_cents'], (int)$bookingPayment['amount_cents']);\n            $commission = $this->commissionAmount($amount, $rate, $minimum);\n            $ruleId = $this->ensureRuleVersion($db, $locked, $rate, $minimum);\n\n            $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$old['id']]);\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'cancelled',:reason,'user',:actor_id,UTC_TIMESTAMP())\",\n                ['assignment_id'=>$old['id'],'order_id'=>$locked['id'],'worker_id'=>$old['worker_id'],'reason'=>'用户更换师傅：'.$reason,'actor_id'=>$actor['user_id']]\n            );\n            $db->execute(\n                \"UPDATE order_role_grants g JOIN worker_profiles w ON w.user_id=g.user_id\n                 SET g.status='revoked',g.revoked_at=UTC_TIMESTAMP()\n                 WHERE g.order_id=:order_id AND g.status='active' AND w.id=:worker_id\",\n                ['order_id'=>$locked['id'],'worker_id'=>$old['worker_id']]\n            );\n            $db->execute(\n                \"UPDATE quotes\n                 SET status=CASE WHEN id=:new_id THEN 'selected' WHEN id=:old_id THEN 'closed' ELSE status END,\n                     selected_at=CASE WHEN id=:new_time THEN UTC_TIMESTAMP() ELSE selected_at END,\n                     updated_at=UTC_TIMESTAMP()\n                 WHERE order_id=:order_id\",\n                ['new_id'=>$quote['id'],'old_id'=>$old['quote_id'] ?: 0,'new_time'=>$quote['id'],'order_id'=>$locked['id']]\n            );\n            $db->insert(\n                \"INSERT INTO quote_selections(order_id,quote_id,quote_version_id,user_id,amount_cents_snapshot,booking_fee_cents_snapshot,status,payment_expires_at,selected_at,confirmed_at)\n                 VALUES(:order_id,:quote_id,:version_id,:user_id,:amount,:booking,'confirmed',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['order_id'=>$locked['id'],'quote_id'=>$quote['id'],'version_id'=>$quote['quote_version_id'],'user_id'=>$actor['user_id'],'amount'=>$amount,'booking'=>$booking]\n            );\n\n            // 先按旧成交关系生成旧师傅通知，再切换订单当前师傅。\n            OrderNotificationService::queue(\n                $db,(int)$locked['id'],'worker-switch-old:'.$old['id'],'worker_replaced_by_user',\n                ['reason'=>$reason,'role'=>'old_worker','notify_recipients'=>['worker']]\n            );\n\n            $assignmentPublicId = \\public_id();\n            $assignmentId = $db->insert(\n                \"INSERT INTO assignments(public_id,order_id,worker_id,quote_id,assignment_type,commission_rule_version_id,\n                    final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,\n                    estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accept_deadline_at,created_at,updated_at)\n                 VALUES(:public_id,:order_id,:worker_id,:quote_id,'worker_quote',:rule_id,:amount,:booking,:rate,:minimum,:commission,:offline,:net,'offered',UTC_TIMESTAMP(),NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'public_id'=>$assignmentPublicId,'order_id'=>$locked['id'],'worker_id'=>$quote['worker_id'],'quote_id'=>$quote['id'],'rule_id'=>$ruleId,\n                    'amount'=>$amount,'booking'=>$booking,'rate'=>$rate,'minimum'=>$minimum,'commission'=>$commission,\n                    'offline'=>max(0,$amount-$booking),'net'=>$amount-$commission,\n                ]\n            );\n            $db->execute(\n                \"UPDATE orders SET selected_quote_id=:quote_id,final_amount_cents=:amount,assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,\n                        commission_rule_version_id=:rule_id,assignment_status='offered',contact_revealed_at=NULL,updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id\",\n                ['quote_id'=>$quote['id'],'amount'=>$amount,'worker_id'=>$quote['worker_id'],'assignment_id'=>$assignmentId,'rule_id'=>$ruleId,'id'=>$locked['id']]\n            );\n            $this->autoAcceptWorkerQuoteAssignment(\n                $db,(int)$locked['id'],$assignmentId,(int)$quote['worker_id'],$ruleId,\n                '用户选择另一位已报价师傅，报价即视为承接意愿',(int)$actor['user_id']\n            );\n            $this->event($db, (int)$locked['id'], 'worker_replaced_by_user', 'user', (int)$actor['user_id'], [\n                'old_worker_id'=>(int)$old['worker_id'],'new_worker_id'=>(int)$quote['worker_id'],'reason'=>$reason,\n                'quote_id'=>(string)$quote['public_id'],'booking_payment_no'=>(string)$bookingPayment['public_no'],\n                'message'=>'用户在开工前更换已报价师傅，新师傅按其报价意愿自动接单；旧师傅后续订单访问权已撤销。',\n            ]);\n            return ['assignment_id'=>$assignmentPublicId,'quote_id'=>(string)$quote['public_id'],'amount_cents'=>$amount];\n        });\n\n        return [\n            'message'=>'已更换师傅，新师傅已按报价意愿自动接单；原师傅后续订单访问权限已撤销',\n            'data'=>$result,\n        ];\n    }\n\n    /** @param array<string,mixed> $order */\n    private function ensureRuleVersion(Database $db, array $order, int $rate, int $minimum): int\n    {\n        $ruleId = (int)($order['commission_rule_version_id'] ?? 0);\n        if ($ruleId > 0 && $db->fetchValue('SELECT id FROM commission_rule_versions WHERE id=:id AND order_id=:order_id LIMIT 1', ['id'=>$ruleId,'order_id'=>$order['id']])) {\n            return $ruleId;\n        }\n        $version = 1 + (int)$db->fetchValue('SELECT COALESCE(MAX(version_no),0) FROM commission_rule_versions WHERE order_id=:order_id', ['order_id'=>$order['id']]);\n        return $db->insert(\n            \"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,adjustment_type,status,locked_at,created_at)\n             VALUES(:order_id,:version,:rate,:minimum,'default','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['order_id'=>$order['id'],'version'=>$version,'rate'=>$rate,'minimum'=>$minimum]\n        );\n    }\n\n    private function autoAcceptWorkerQuoteAssignment(Database $db, int $orderId, int $assignmentId, int $workerId, int $ruleId, string $reason, int $actorUserId): void\n    {\n        $assignment = $db->fetch(\n            \"SELECT * FROM assignments WHERE id=:id AND order_id=:order_id AND worker_id=:worker_id FOR UPDATE\",\n            ['id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$workerId]\n        );\n        if (!$assignment || $assignment['assignment_type'] !== 'worker_quote') throw new RuntimeException('师傅报价指派不存在或状态异常');\n        if ($assignment['status'] !== 'offered') throw new RuntimeException('师傅报价指派状态已变化');\n        $db->execute(\"UPDATE assignments SET status='accepted',accepted_at=UTC_TIMESTAMP(),accept_deadline_at=NULL,updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$assignmentId]);\n        $db->execute(\n            \"UPDATE orders SET assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,assignment_status='accepted',publish_status='hidden',\n                    contact_revealed_at=COALESCE(contact_revealed_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:order_id\",\n            ['worker_id'=>$workerId,'assignment_id'=>$assignmentId,'order_id'=>$orderId]\n        );\n        if ($ruleId > 0) $db->execute('UPDATE commission_rule_versions SET locked_at=COALESCE(locked_at,UTC_TIMESTAMP()) WHERE id=:id', ['id'=>$ruleId]);\n        $db->execute(\"UPDATE assignments SET status='cancelled',cancelled_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE order_id=:order_id AND id<>:id AND status='offered'\", ['order_id'=>$orderId,'id'=>$assignmentId]);\n        $db->insert(\n            \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n             VALUES(:assignment_id,:order_id,:worker_id,'accepted',:reason,'system',:actor_id,UTC_TIMESTAMP())\",\n            ['assignment_id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$workerId,'reason'=>$reason,'actor_id'=>$actorUserId]\n        );\n        $this->event($db, $orderId, 'assignment_auto_accepted', 'system', 0, ['worker_id'=>$workerId,'source'=>'worker_quote','message'=>$reason]);\n        OrderNotificationService::queue($db, $orderId, 'worker-quote-auto-accepted:'.$assignmentId, 'assignment_accepted', ['auto_accepted'=>1,'source'=>'worker_quote']);\n    }\n\n    private function commissionAmount(int $amount, int $rateBp, int $minimum): int\n    {\n        if ($amount <= 0) return 0;\n        return min($amount, max((int)round($amount * $rateBp / 10000, 0, PHP_ROUND_HALF_UP), max(0,$minimum)));\n    }\n\n    /** @param array<string,mixed> $payload */\n    private function event(Database $db, int $orderId, string $type, string $actorType, int $actorId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n        $db->insert(\n            \"INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,:type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())\",\n            [\n                'order_id'=>$orderId,'type'=>$type,'event_key'=>$type.':'.$orderId.':'.bin2hex(random_bytes(6)),\n                'actor_type'=>$actorType,'actor_id'=>$actorId > 0 ? $actorId : null,'payload'=>is_string($json) ? $json : '{}',\n            ]\n        );\n    }\n}\n","server/app/Infrastructure/Scheduling/AssignmentTimeoutProcessor.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Scheduling;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/**\n * 派单/抢单占位超时的单笔正式处理器。\n *\n * 生产 scheduler 负责扫描候选，本类只锁定并处理一个 assignment。\n * testing 入口必须绑定一个 built test_instance，且只允许 demo 非审核样例订单。\n */\nfinal class AssignmentTimeoutProcessor\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db=$db;\n    }\n\n    public function expireProduction(int $assignmentId): bool\n    {\n        if($assignmentId<1)return false;\n        return $this->expire($assignmentId,0,null);\n    }\n\n    /** @return array<string,mixed> */\n    public function expireTestInstance(int $instanceId,bool $advanceClock=true): array\n    {\n        if(!TestingEnvironmentPolicy::active())throw new RuntimeException('派单超时实例执行只允许 testing 环境');\n        if($instanceId<1)throw new RuntimeException('测试实例无效');\n\n        $target=$this->db->fetch(\n            \"SELECT ti.id instance_id,ti.order_id,ti.order_no_snapshot,ti.scenario_key,ti.build_status,ti.archived_at,ti.deleted_at,\n                    o.public_no,o.is_demo,o.current_assignment_id,o.lifecycle_status,\n                    a.id assignment_id,a.status assignment_status,a.assignment_type,a.offered_at,a.accept_deadline_at\n             FROM test_instances ti\n             JOIN orders o ON o.id=ti.order_id\n             JOIN assignments a ON a.id=o.current_assignment_id AND a.order_id=o.id\n             WHERE ti.id=:instance\n             LIMIT 1\",\n            ['instance'=>$instanceId]\n        );\n        if(!$target\n            ||(string)$target['build_status']!=='built'\n            ||!empty($target['archived_at'])\n            ||!empty($target['deleted_at'])\n            ||(int)$target['is_demo']!==1\n            ||(string)$target['public_no']!==(string)$target['order_no_snapshot']\n            ||strpos((string)$target['public_no'],'BXDEMOHALL')===0\n            ||(string)$target['lifecycle_status']!=='active'\n            ||(string)$target['assignment_status']!=='offered'){\n            throw new RuntimeException('派单超时测试实例边界失败');\n        }\n\n        $deadline=$this->deadline((string)($target['accept_deadline_at']??''),(string)($target['offered_at']??''));\n        if($deadline===null)throw new RuntimeException('当前派单缺少可验证的接受截止时间');\n        $asOf=$advanceClock\n            ?gmdate('Y-m-d H:i:s',max(time(),strtotime($deadline.' UTC')+1))\n            :gmdate('Y-m-d H:i:s');\n\n        $expired=$this->expire((int)$target['assignment_id'],$instanceId,$asOf);\n        return[\n            'expired'=>$expired,\n            'assignment_id'=>(int)$target['assignment_id'],\n            'order_id'=>(int)$target['order_id'],\n            'assignment_type'=>(string)$target['assignment_type'],\n            'deadline_at'=>$deadline,\n            'as_of'=>$asOf,\n            'clock_fixture'=>$advanceClock,\n            'scope'=>'test_instance',\n        ];\n    }\n\n    private function expire(int $assignmentId,int $testInstanceId,?string $asOf): bool\n    {\n        return$this->db->transaction(function(Database $db)use($assignmentId,$testInstanceId,$asOf):bool{\n            if($testInstanceId>0&&!TestingEnvironmentPolicy::active())throw new RuntimeException('禁止跨测试域执行派单超时');\n\n            $params=['id'=>$assignmentId];\n            $dueSql='COALESCE(accept_deadline_at,DATE_ADD(offered_at,INTERVAL 24 HOUR))<=UTC_TIMESTAMP()';\n            if($testInstanceId>0){\n                $dueSql='COALESCE(accept_deadline_at,DATE_ADD(offered_at,INTERVAL 24 HOUR))<=:as_of';\n                $params['as_of']=$asOf;\n            }\n            $assignment=$db->fetch(\n                \"SELECT * FROM assignments\n                 WHERE id=:id AND status='offered' AND {$dueSql}\n                 FOR UPDATE\",\n                $params\n            );\n            if(!$assignment)return false;\n\n            if($testInstanceId>0){\n                $order=$db->fetch(\n                    \"SELECT o.*\n                     FROM orders o\n                     JOIN test_instances ti ON ti.id=:instance AND ti.order_id=o.id\n                     WHERE o.id=:id\n                       AND o.is_demo=1\n                       AND BINARY o.public_no=BINARY ti.order_no_snapshot\n                       AND ti.build_status='built'\n                       AND ti.archived_at IS NULL\n                       AND ti.deleted_at IS NULL\n                     FOR UPDATE\",\n                    ['instance'=>$testInstanceId,'id'=>$assignment['order_id']]\n                );\n                if(!$order||strpos((string)$order['public_no'],'BXDEMOHALL')===0)throw new RuntimeException('派单超时测试订单边界失败');\n                if((int)($order['current_assignment_id']??0)!==(int)$assignment['id'])throw new RuntimeException('当前测试指派已经变化');\n            }else{\n                $order=$db->fetch(\n                    'SELECT * FROM orders WHERE id=:id AND COALESCE(is_demo,0)=0 FOR UPDATE',\n                    ['id'=>$assignment['order_id']]\n                );\n            }\n\n            if(!$order||(string)$order['lifecycle_status']!=='active')return false;\n            if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n            }\n\n            $changed=$db->execute(\n                \"UPDATE assignments\n                 SET status='expired',rejected_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='offered'\",\n                ['id'=>$assignment['id']]\n            );\n            if($changed!==1)return false;\n\n            $timeoutReason=(string)$assignment['assignment_type']==='single_grab'\n                ?'抢单后未在规定时间提交报价，系统自动释放并重新开放抢单'\n                :'派单超过处理期限未处理，系统自动释放';\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'expired',:reason,'system',NULL,UTC_TIMESTAMP())\",\n                [\n                    'assignment_id'=>$assignment['id'],\n                    'order_id'=>$assignment['order_id'],\n                    'worker_id'=>$assignment['worker_id'],\n                    'reason'=>$timeoutReason,\n                ]\n            );\n\n            if((int)($order['current_assignment_id']??0)===(int)$assignment['id']){\n                if((string)$assignment['assignment_type']==='single_grab'){\n                    $db->execute(\n                        \"UPDATE orders\n                         SET current_assignment_id=NULL,assigned_worker_id=NULL,assignment_status='unassigned',\n                             publish_status='published',quote_status='waiting',contact_revealed_at=NULL,\n                             updated_at=UTC_TIMESTAMP(),version=version+1\n                         WHERE id=:id\",\n                        ['id'=>$order['id']]\n                    );\n                }else{\n                    $db->execute(\n                        \"UPDATE orders\n                         SET current_assignment_id=NULL,assigned_worker_id=NULL,assignment_status='unassigned',\n                             publish_status='hidden',contact_revealed_at=NULL,\n                             updated_at=UTC_TIMESTAMP(),version=version+1\n                         WHERE id=:id\",\n                        ['id'=>$order['id']]\n                    );\n                }\n            }\n\n            $db->execute(\n                \"UPDATE order_role_grants g\n                 JOIN worker_profiles w ON w.user_id=g.user_id\n                 SET g.status='revoked',g.revoked_at=UTC_TIMESTAMP()\n                 WHERE g.order_id=:order_id AND g.status='active' AND w.id=:worker_id\",\n                ['order_id'=>$order['id'],'worker_id'=>$assignment['worker_id']]\n            );\n\n            $payload=[\n                'assignment_id'=>(int)$assignment['id'],\n                'message'=>(string)$assignment['assignment_type']==='single_grab'\n                    ?'抢单后未在规定时间提交报价，系统已释放并重新开放抢单。'\n                    :'派单超过处理期限未处理，系统已自动释放。',\n            ];\n            if($testInstanceId>0){\n                $payload['test_instance_id']=$testInstanceId;\n                $payload['clock_fixture']=$asOf!==null;\n                $payload['as_of']=$asOf;\n            }\n            $this->recordOrderEvent($db,(int)$order['id'],(int)$order['version'],$payload);\n            return true;\n        });\n    }\n\n    private function recordOrderEvent(Database $db,int $orderId,int $version,array $payload): void\n    {\n        $eventKey='scheduler:assignment_timeout:order:'.$orderId.':v'.max(1,$version);\n        $db->execute(\n            \"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,'assignment_expired',:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",\n            [\n                'order_id'=>$orderId,\n                'event_key'=>substr($eventKey,0,128),\n                'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n            ]\n        );\n        OrderNotificationService::queue(\n            $db,\n            $orderId,\n            substr($eventKey,0,128),\n            'assignment_expired',\n            $payload\n        );\n    }\n\n    private function deadline(string $explicit,string $offeredAt): ?string\n    {\n        $explicit=trim($explicit);\n        if($explicit!==''){\n            $timestamp=strtotime($explicit.' UTC');\n            if($timestamp!==false)return gmdate('Y-m-d H:i:s',$timestamp);\n        }\n        $offeredAt=trim($offeredAt);\n        if($offeredAt==='')return null;\n        $timestamp=strtotime($offeredAt.' UTC');\n        return$timestamp===false?null:gmdate('Y-m-d H:i:s',$timestamp+86400);\n    }\n}\n","server/tests/chat_repair_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderNegotiationRepository;\n\n/** Reuses the full disposable install from chat_assignment_contract.php. */\nfunction chatRepairEpisodeContract(Database $db): void\n{\n    $db->execute(\"INSERT INTO orders(id,public_no,user_id,audit_status,lifecycle_status,payment_status,assignment_status,created_at,updated_at) VALUES(78,'CHAT-REPAIR',10001,'approved','active','paid','accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $rule=$db->insert(\"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,status,created_at) VALUES(78,1,1000,1000,'active',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at) VALUES(200,:public_id,78,10,'admin',:rule,20000,5000,1000,1000,2000,15000,18000,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public_id'=>public_id(),'rule'=>$rule]);\n    $db->execute('UPDATE orders SET current_assignment_id=200,assigned_worker_id=10 WHERE id=78');\n    $bridge=new DatabaseOrderConversationBridge($db,true);\n    $db->transaction(static function()use($bridge):void{$bridge->synchronize(78);});\n    $db->transaction(static function(Database $db)use($bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=78\");$bridge->synchronize(78);});\n    $repair=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at) VALUES('CHAT-AFTER',78,10001,'warranty_repair','fixture','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_repair_episodes')===0,'processing application is not explicit chat acceptance');\n    $episodes=new DatabaseChatRepairEpisodes($db,true);\n    $outside=false;try{$episodes->acceptWorker(78,$repair,10);}catch(RuntimeException $e){$outside=true;}policyAssert($outside,'acceptance fact cannot escape original transaction');\n    $repo=new DatabaseOrderNegotiationRepository($db);\n    $actor=['user_id'=>10002,'worker_id'=>10];\n    $db->execute(\"CREATE TRIGGER fixture_repair_episode_failure BEFORE INSERT ON chat_repair_episodes FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;try{$repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','accepted','fixture');}catch(PDOException $e){$failed=($e->errorInfo[1]??0)===1644;}\n    $db->execute('DROP TRIGGER fixture_repair_episode_failure');\n    policyAssert($failed && $db->fetchValue('SELECT resolution FROM after_sales WHERE id=:id',['id'=>$repair])===null,'episode write failure rolls real repair acceptance back');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','accepted','fixture');\n    $first=(string)$db->fetchValue('SELECT id FROM chat_repair_episodes WHERE active_order_id=78');\n    policyAssert($first!=='' && $db->fetchValue('SELECT accepted_user_id FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==10002,'explicit acceptance binds actual assignment and user');\n    $same=$db->transaction(static function()use($episodes,$repair):?string{return $episodes->acceptWorker(78,$repair,10);});\n    policyAssert($same===$first && (int)$db->fetchValue('SELECT COUNT(*) FROM chat_repair_episodes')===1,'replayed acceptance does not invent a generation');\n    $firstSnapshot=json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=78'),true,32,JSON_THROW_ON_ERROR);\n    policyAssert($firstSnapshot['state']==='open' && $firstSnapshot['episode_key']==='assignment:200:repair:'.$first,'explicit acceptance opens only its new repair episode');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER','complete','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==='closed','actual worker completion closes accepted episode');\n    policyAssert($db->fetchValue('SELECT status FROM after_sales WHERE id=:id',['id'=>$repair])==='resolved','original repair completion retained');\n    $closed=json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=78'),true,32,JSON_THROW_ON_ERROR);\n    policyAssert($closed['state']==='readonly' && $closed['episode_key']===$firstSnapshot['episode_key'],'completion retains the closing repair identity');\n    $db->transaction(static function()use($bridge):void{policyAssert($bridge->synchronize(78)===[],'completed repair never flaps back to service identity');});\n    $rejected=false;try{$db->transaction(static function()use($episodes,$repair):void{$episodes->acceptWorker(78,$repair,10);});}catch(RuntimeException $e){$rejected=true;}\n    policyAssert($rejected && (int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0,'resolved request cannot resurrect an accepted generation');\n    $next=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at) VALUES('CHAT-AFTER2',78,10001,'warranty_repair','fixture','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER2','accepted','fixture');\n    $second=(string)$db->fetchValue('SELECT id FROM chat_repair_episodes WHERE active_order_id=78');\n    policyAssert($second!==$first && $db->fetchValue('SELECT state FROM chat_repair_episodes WHERE id=:id',['id'=>$first])==='closed','new request creates a new immutable generation');\n    $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderFulfillmentAuxiliaryRepository');\n    $auxiliary=$reflection->newInstanceWithoutConstructor();$property=$reflection->getProperty('db');$property->setAccessible(true);$property->setValue($auxiliary,$db);\n    $auxiliary->withdrawRepair(['user_id'=>10001],'CHAT-REPAIR','CHAT-AFTER2');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly','actual customer withdrawal closes the guard');\n    $db->transaction(static function()use($episodes,$next):void{$episodes->close(78,$next);});\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='closed'\")===2,'repeated closure is idempotent');\n    $third=(int)$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,resolution,opened_at,created_at,updated_at) VALUES('CHAT-AFTER3',78,10001,'warranty_repair','fixture','processing','用户申请平台介入：fixture',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO order_events(order_id,event_type,actor_type,actor_id,payload_json,created_at) VALUES(78,'repair_platform_intervention_requested','user',10001,:payload,UTC_TIMESTAMP())\",['payload'=>json_encode(['after_sale_id'=>'CHAT-AFTER3'],JSON_THROW_ON_ERROR)]);\n    $admin=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseAdminRepairResolutionRepository($db);\n    $operator=['channel'=>'mini_admin','user_id'=>10004];\n    $admin->resolve($operator,'CHAT-REPAIR','CHAT-AFTER3','continue','fixture');\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0\n        && $db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly','platform continue alone never impersonates worker acceptance');\n    $repo->respond($actor,'CHAT-REPAIR','repair','CHAT-AFTER3','accepted','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='open','worker explicitly accepts after platform continue');\n    $admin->resolve($operator,'CHAT-REPAIR','CHAT-AFTER3','closed','fixture');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=78')==='readonly'\n        && (int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_repair_episodes WHERE state='active'\")===0,'actual platform closure ends both guard and episode');\n    $disabled=new DatabaseChatRepairEpisodes(new Database([]));\n    policyAssert($disabled->acceptWorker(0,0,0)===null,'disabled episode writer does no IO');\n    echo \"售后明确受理、授权区间、完成/撤回/平台关闭、继续处理与回滚验证通过\\n\";\n}\n","server/app/Domain/Messaging/MessageOperationException.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nuse RuntimeException;\n\nfinal class MessageOperationException extends RuntimeException\n{\n    private string $apiCode;\n    public function __construct(string $message, string $apiCode, int $status = 422)\n    {\n        parent::__construct($message, $status);\n        $this->apiCode = $apiCode;\n    }\n    public function apiCode(): string { return $this->apiCode; }\n}\n","server/app/Contracts/MessageOutboxRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface MessageOutboxRepository\n{\n    public function dashboard(string $status, string $q, int $page, string $tab = 'records'): array;\n    public function retry(int $id): array;\n    public function close(int $id): array;\n    public function addSuppression(string $hmac, string $masked, string $reason, string $note, int $adminId): void;\n    public function removeSuppression(int $id): array;\n}\n","server/app/Domain/Messaging/MessageOutboxPolicy.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\n\nuse RuntimeException;\n\nfinal class MessageOutboxPolicy\n{\n\n    /** Eligibility is checked against the row locked by the persistence operation. */\n    public static function requireDeadLetter(?array $row, string $operation): void\n    {\n        if ($row && $row['topic'] === 'aliyun_paid_sms' && $operation === 'retry') {\n            throw new RuntimeException('付费短信禁止从普通消息重试入口重新发送；仅允许用户在明确失败且费用已释放后重新发起。');\n        }\n        if (!$row || !in_array((string)$row['topic'], ['aliyun_sms','wecom_webhook','wechat_subscribe'], true)) {\n            throw new RuntimeException($operation === 'retry' ? '该消息类型不由通用消息调度器发送，请在对应业务页面处理。' : '该消息类型不支持在此结案，请在对应业务页面处理。');\n        }\n        if ($row['status'] !== 'failed' || (int)$row['attempt_count'] < 5) {\n            throw new RuntimeException($operation === 'retry' ? '仅可人工重试已达到 5 次自动重试上限的失败消息；请刷新页面确认当前状态。' : '仅可结案已达到 5 次自动重试上限的失败消息；请刷新页面确认当前状态。');\n        }\n    }\n}\n","server/app/Contracts/SubscriptionRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface SubscriptionRepository\n{\n    public function definitions(): array;\n    public function preferences(int $userId): array;\n    public function save(int $userId, string $key, bool $enabled, string $status): array;\n    public function diagnose(int $userId): array;\n}\n","server/app/Infrastructure/Messaging/SubscriptionCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\n\n\nfinal class SubscriptionCatalog\n{\n    use OrderSubscriptionDefinitionOperations;\n\n}\n","server/app/Contracts/PlatformOrderAdminRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface PlatformOrderAdminRepository\n{\n    /** @return array<string,mixed> */\n    public function dashboard(): array;\n\n    /** @param array<string,mixed> $command */\n    public function create(array $command, int $adminId): int;\n\n    public function publish(int $orderId, int $adminId, int $quoteDays): void;\n\n    public function selectQuote(int $orderId, int $quoteId, int $adminId): void;\n\n    /** @return array<string,mixed> */\n    public function createInvite(int $orderId, int $adminId, int $validDays): array;\n\n    public function revokeInvite(int $orderId, int $inviteId, int $adminId): void;\n}\n","server/app/Infrastructure/Persistence/PlatformOrderBookingPaymentVerifier.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\n/**\n * 平台承接单外部预付款核验。\n *\n * 平台承接单只允许 platform_managed：客户侧款项由外部渠道托管，系统不创建微信\n * order_booking/booking_fee 支付记录。普通客户（包含后台代下单）的微信预约费走普通订单\n * 支付链，绝不能进入本核验器。\n *\n * 调用方必须先在同一事务中锁定 orders 行；本类只核对平台专属资金事实，不发起支付/退款。\n */\nfinal class PlatformOrderBookingPaymentVerifier\n{\n    /**\n     * 返回当前可参与平台单结算的外部已收预付款金额。\n     *\n     * $expectedCents 为调用方已锁定的 order_platform_terms.booking_paid_cents；为兼容少量旧调用\n     * 允许传 null，此时直接从平台条款读取。customerFlowMode 仅用于验证，不再支持 miniapp_booking。\n     */\n    public function verifiedPaidCents(\n        Database $db,\n        int $orderId,\n        int $customerTotalCents,\n        ?int $expectedCents = null,\n        ?string $customerFlowMode = null\n    ): int {\n        if ($orderId <= 0 || $customerTotalCents <= 0) {\n            throw new OrderOperationException('平台承接订单金额或编号无效', 'PLATFORM_BOOKING_INVALID', 409);\n        }\n\n        $terms = null;\n        if ($expectedCents === null || trim((string)$customerFlowMode) === '') {\n            $terms = $db->fetch(\n                'SELECT customer_flow_mode,booking_paid_cents FROM order_platform_terms WHERE order_id=:order_id LIMIT 1 FOR UPDATE',\n                ['order_id'=>$orderId]\n            );\n            if (!$terms) {\n                throw new OrderOperationException('平台承接单缺少托管资金条款，请先修复订单数据', 'PLATFORM_TERMS_REQUIRED', 409);\n            }\n        }\n\n        $flow = trim((string)($customerFlowMode ?? ($terms['customer_flow_mode'] ?? '')));\n        if ($flow !== 'platform_managed') {\n            throw new OrderOperationException('平台承接单只允许平台托管模式；旧小程序预约模式必须先完成数据清理', 'PLATFORM_BOOKING_FLOW_INVALID', 409);\n        }\n\n        $externalPaid = $expectedCents !== null\n            ? $expectedCents\n            : (int)($terms['booking_paid_cents'] ?? 0);\n        if ($externalPaid < 0 || $externalPaid > $customerTotalCents) {\n            throw new OrderOperationException('平台外部已收预付款金额异常，请先核对订单资金条件', 'PLATFORM_BOOKING_AMOUNT_MISMATCH', 409);\n        }\n\n        // 平台托管单出现真实微信预约费，意味着订单来源/支付链串线或客户被重复收费。\n        $payments = $db->fetchAll(\n            \"SELECT id,amount_cents FROM payment_orders\n             WHERE order_id=:order_id AND business_type IN ('order_booking','booking_fee')\n               AND status='paid' ORDER BY id FOR UPDATE\",\n            ['order_id'=>$orderId]\n        );\n        if ($payments) {\n            throw new OrderOperationException(\n                '平台托管单检测到微信预约费付款，请先按资金异常核对；该笔款不能与外部预付款重复抵扣',\n                'PLATFORM_BOOKING_UNEXPECTED_PAYMENT',\n                409\n            );\n        }\n\n        return $externalPaid;\n    }\n}\n","server/app/Infrastructure/Messaging/SubscriptionQuotaStore.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\n\nfinal class SubscriptionQuotaStore\n{\n\n    public static function subscriptionPreferences(Database $db, int $userId): array\n    {\n        if ($userId < 1) return [];\n        $raw = (string) ($db->fetchValue('SELECT setting_value FROM system_settings WHERE setting_key=:key LIMIT 1', ['key'=>self::subscriptionPreferenceKey($userId)]) ?: '');\n        $decoded = $raw === '' ? [] : json_decode($raw, true);\n        if (!is_array($decoded)) return [];\n        // 无需新增表字段：旧 enabled/consumed 偏好在读取时补成计数模型，下次授权或消费即写回新结构。\n        $scenes = SubscriptionCatalog::subscriptionSceneDefinitions();\n        foreach ($decoded as $sceneKey => &$pref) {\n            if (!is_array($pref)) { $pref = []; continue; }\n            $scene = $scenes[$sceneKey] ?? [];\n            $type = trim((string)($pref['subscription_type'] ?? $scene['subscription_type'] ?? 'one_time'));\n            if (!in_array($type, ['one_time','long_term'], true)) $type = 'one_time';\n            $status = (string)($pref['authorization_status'] ?? '');\n            $legacyAccepted = !empty($pref['enabled']) && in_array($status, ['accept','acceptWithAudio','acceptWithAlert'], true);\n            if ($type === 'one_time') {\n                $remaining = array_key_exists('remaining_count', $pref) ? max(0, (int)$pref['remaining_count']) : ($legacyAccepted ? 1 : 0);\n                $pref['remaining_count'] = $remaining;\n                if (!array_key_exists('total_authorized_count', $pref)) $pref['total_authorized_count'] = $remaining;\n                // 一次性订阅的“拒绝”只代表本次没有新增额度，不应抹掉之前已经积累的可发送次数。\n                // 旧数据若出现 remaining_count>0 但状态为 reject/consumed，读取时恢复为可用。\n                if ($remaining > 0 && in_array($status, ['consumed','reject'], true)) $pref['authorization_status'] = 'accept';\n                if (!array_key_exists('last_request_status', $pref) && $status !== '') $pref['last_request_status'] = $status;\n            } else {\n                $pref['remaining_count'] = null;\n                if (!array_key_exists('total_authorized_count', $pref)) $pref['total_authorized_count'] = $legacyAccepted ? 1 : 0;\n            }\n            $pref['subscription_type'] = $type;\n        }\n        unset($pref);\n        return $decoded;\n    }\n\n    public static function saveSubscriptionPreference(Database $db, int $userId, string $sceneKey, bool $enabled, string $authorizationStatus): array\n    {\n        $scenes = SubscriptionCatalog::subscriptionSceneDefinitions();\n        if ($userId < 1 || !isset($scenes[$sceneKey])) throw new \\RuntimeException('订阅场景不存在。');\n        if ($enabled && empty($scenes[$sceneKey]['available'])) throw new \\RuntimeException('该订阅场景尚未在后台配置可用模板。');\n        $allowed = ['accept','acceptWithAudio','acceptWithAlert','reject','ban','filter','disabled','consumed','error',''];\n        if (!in_array($authorizationStatus, $allowed, true)) $authorizationStatus = $enabled ? 'accept' : 'disabled';\n        if ($enabled && $authorizationStatus === '') $authorizationStatus = 'accept';\n        $preferences = self::subscriptionPreferences($db, $userId);\n        $previous = is_array($preferences[$sceneKey] ?? null) ? $preferences[$sceneKey] : [];\n        $type = (string)($scenes[$sceneKey]['subscription_type'] ?? 'one_time');\n        $accepted = in_array($authorizationStatus, ['accept','acceptWithAudio','acceptWithAlert'], true);\n        $remaining = $type === 'one_time' ? max(0, (int)($previous['remaining_count'] ?? 0)) : null;\n        $total = max(0, (int)($previous['total_authorized_count'] ?? 0));\n        $effectiveStatus = $authorizationStatus;\n        if ($accepted) {\n            $enabled = true;\n            if ($type === 'one_time') $remaining++;\n            $total++;\n        } elseif ($type === 'one_time' && in_array($authorizationStatus, ['reject','filter'], true)) {\n            // reject 只是本次没有新增额度；filter 是微信因同标题过滤，本质也不是授权失效。\n            // 两种情况都保留之前已经积累的 remaining_count。\n            $enabled = $remaining > 0;\n            $effectiveStatus = $remaining > 0 ? 'accept' : $authorizationStatus;\n        } elseif (in_array($authorizationStatus, ['ban','disabled'], true)) {\n            $enabled = false;\n        } elseif ($type === 'one_time' && $remaining > 0) {\n            $enabled = true;\n            $effectiveStatus = 'accept';\n        }\n        $preferences[$sceneKey] = array_merge($previous, [\n            'enabled'=>(bool)$enabled,\n            'authorization_status'=>$effectiveStatus,\n            'last_request_status'=>$authorizationStatus,\n            'subscription_type'=>$type,\n            'remaining_count'=>$remaining,\n            'total_authorized_count'=>$total,\n            'template_id'=>(string)$scenes[$sceneKey]['template_id'],\n            'updated_at'=>gmdate('c'),\n        ]);\n        if ($accepted) $preferences[$sceneKey]['last_authorized_at'] = gmdate('c');\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,updated_by,created_at,updated_at) VALUES(:key,:value,'json','notification_user',0,'用户微信订阅消息偏好',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type='json',group_name='notification_user',is_public=0,updated_at=UTC_TIMESTAMP()\", ['key'=>self::subscriptionPreferenceKey($userId),'value'=>$json]);\n        return $preferences[$sceneKey];\n    }\n\n    public static function markSubscriptionConsumed(Database $db, int $userId, string $sceneKey): void\n    {\n        $preferences = self::subscriptionPreferences($db, $userId);\n        if (!isset($preferences[$sceneKey]) || !is_array($preferences[$sceneKey])) return;\n        $pref = $preferences[$sceneKey];\n        $type = (string)($pref['subscription_type'] ?? 'one_time');\n        if ($type === 'one_time') {\n            $remaining = max(0, (int)($pref['remaining_count'] ?? 0) - 1);\n            $pref['remaining_count'] = $remaining;\n            $pref['authorization_status'] = $remaining > 0 ? 'accept' : 'consumed';\n        } else {\n            $pref['authorization_status'] = 'accept';\n        }\n        $pref['last_consumed_at'] = gmdate('c');\n        $pref['updated_at'] = gmdate('c');\n        $preferences[$sceneKey] = $pref;\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute('UPDATE system_settings SET setting_value=:value,updated_at=UTC_TIMESTAMP() WHERE setting_key=:key', ['value'=>$json,'key'=>self::subscriptionPreferenceKey($userId)]);\n    }\n\n    public static function markSubscriptionPermissionUnavailable(Database $db, int $userId, string $sceneKey): void\n    {\n        $preferences = self::subscriptionPreferences($db, $userId);\n        if (!isset($preferences[$sceneKey]) || !is_array($preferences[$sceneKey])) return;\n        $pref = $preferences[$sceneKey];\n        if ((string)($pref['subscription_type'] ?? 'one_time') === 'one_time') $pref['remaining_count'] = 0;\n        $pref['authorization_status'] = 'consumed';\n        $pref['updated_at'] = gmdate('c');\n        $preferences[$sceneKey] = $pref;\n        $json = json_encode($preferences, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n        $db->execute('UPDATE system_settings SET setting_value=:value,updated_at=UTC_TIMESTAMP() WHERE setting_key=:key', ['value'=>$json,'key'=>self::subscriptionPreferenceKey($userId)]);\n    }\n\n    private static function subscriptionPreferenceKey(int $userId): string\n    {\n        return 'wechat.subscription.user.'.$userId;\n    }\n}\n","server/app/Infrastructure/Persistence/PlatformOrderPricingReviewReadiness.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\n/** 小程序详情与 Web 正常核价入口共用可操作条件。 */\nfinal class PlatformOrderPricingReviewReadiness\n{\n    public static function isReady(\\WorkerAdmin\\Core\\Database $db, int $orderId): bool\n    {\n        return (bool)$db->fetchValue(\n            \"SELECT 1\n             FROM orders o\n             JOIN order_measurement_states ms ON ms.order_id=o.id AND ms.result_status='accepted'\n             JOIN order_platform_terms t ON t.order_id=o.id\n                                        AND t.customer_flow_mode='platform_managed'\n                                        AND t.settlement_status='pending'\n                                        AND t.booking_paid_cents<=t.customer_contract_total_cents\n             JOIN assignments a ON a.id=o.current_assignment_id\n                               AND a.order_id=o.id\n                               AND a.worker_id=o.assigned_worker_id\n                               AND a.status='accepted'\n             WHERE o.id=:order_id\n               AND o.order_source_type='platform'\n               AND o.booking_fee_cents=0\n               AND o.workflow_profile='measurement'\n               AND o.lifecycle_status='active'\n               AND COALESCE(o.dispute_status,'none') IN ('','none','resolved')\n               AND COALESCE(o.refund_status,'none') IN ('','none','failed')\n               AND NOT EXISTS(\n                   SELECT 1 FROM payment_orders p\n                   WHERE p.order_id=o.id AND p.business_type IN ('order_booking','booking_fee') AND p.status='paid'\n               )\n               AND NOT EXISTS(SELECT 1 FROM disputes d WHERE d.order_id=o.id AND d.status IN ('open','pending','processing'))\n               AND NOT EXISTS(SELECT 1 FROM refunds r WHERE r.order_id=o.id AND r.status NOT IN ('failed','closed','cancelled','rejected','succeeded'))\n               AND NOT EXISTS(SELECT 1 FROM order_cancel_requests cr WHERE cr.order_id=o.id AND cr.status IN ('pending','processing'))\n               AND NOT EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND c.status IN ('pending','processing','negotiating'))\n               AND NOT EXISTS(SELECT 1 FROM after_sales s WHERE s.order_id=o.id AND s.status IN ('open','processing'))\n             LIMIT 1\",\n            ['order_id'=>$orderId]\n        );\n    }\n}\n","server/app/Services/OrderNotificationService.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionCatalog;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionQuotaStore;\nuse WorkerAdmin\\Infrastructure\\Messaging\\OrderSubscriptionQueue;\nuse WorkerAdmin\\Infrastructure\\Messaging\\DatabaseNotificationProducer;\nuse WorkerAdmin\\Infrastructure\\Settings\\GlobalSettingsProvider;\nuse WorkerAdmin\\Application\\Messaging\\OrderNotificationPublisher;\nuse WorkerAdmin\\Application\\Messaging\\SubscriptionTestData;\n\nforeach([\n    'Contracts/NotificationProducer.php',\n    'Contracts/OrderNotificationPort.php',\n    'Contracts/SettingsProvider.php',\n    'Domain/Messaging/MessageEventCatalog.php',\n    'Domain/Messaging/OrderMessageDefinition.php',\n    'Domain/Messaging/WechatTemplateValue.php',\n    'Infrastructure/Messaging/OrderSubscriptionDefinitionOperations.php',\n    'Infrastructure/Messaging/SubscriptionCatalog.php',\n    'Infrastructure/Messaging/SubscriptionQuotaStore.php',\n    'Infrastructure/Messaging/OrderSubscriptionQueue.php',\n    'Infrastructure/Messaging/OrderNotificationProjector.php',\n    'Infrastructure/Messaging/DatabaseNotificationProducer.php',\n    'Infrastructure/Settings/GlobalSettingsProvider.php',\n    'Application/Messaging/OrderNotificationPublisher.php',\n    'Application/Messaging/SubscriptionTestData.php',\n    'Application/Messaging/MessageEventSwitches.php',\n] as $dependency)require_once __DIR__.'/../'.$dependency;\nunset($dependency);\n\nfinal class OrderNotificationService\n{\n    public static function queuePersistedEvent(Database $db, int $orderId, int $eventId, string $eventType, array $payload = []): void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->queuePersistedEvent($orderId,$eventId,$eventType,$payload);\n    }\n\n    public static function queueAdminTask(Database $db,string $eventKey,string $eventType,string $title,array $lines=[]):void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->adminTask($eventKey,$eventType,$title,$lines);\n    }\n\n    public static function queue(Database $db, int $orderId, string $eventKey, string $eventType, array $payload = []): void\n    {\n        (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->queue($orderId,$eventKey,$eventType,$payload);\n    }\n\n    public static function eventCatalog(): array { return MessageEventCatalog::all(); }\n    public static function eventSwitches(string $channel):array { return (new \\WorkerAdmin\\Application\\Messaging\\MessageEventSwitches(new GlobalSettingsProvider()))->forChannel($channel); }\n    public static function subscriptionPreferences(Database $db, int $userId): array { return SubscriptionQuotaStore::subscriptionPreferences($db,$userId); }\n    public static function saveSubscriptionPreference(Database $db, int $userId, string $sceneKey, bool $enabled, string $authorizationStatus): array { return SubscriptionQuotaStore::saveSubscriptionPreference($db,$userId,$sceneKey,$enabled,$authorizationStatus); }\n    public static function markSubscriptionConsumed(Database $db, int $userId, string $sceneKey): void { SubscriptionQuotaStore::markSubscriptionConsumed($db,$userId,$sceneKey); }\n    public static function markSubscriptionPermissionUnavailable(Database $db, int $userId, string $sceneKey): void { SubscriptionQuotaStore::markSubscriptionPermissionUnavailable($db,$userId,$sceneKey); }\n    public static function queueWorkerWithdrawalResult(Database $db,int $workerId,string $withdrawalNo,string $status,string $note='',int $amountCents=0):void { (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->withdrawalResult($workerId,$withdrawalNo,$status,$note,$amountCents); }\n    public static function queueWorkerReviewResult(Database $db, int $workerId, string $cloudId, string $decision, string $reason, string $workerName=''): void { (new OrderNotificationPublisher(new DatabaseNotificationProducer($db)))->workerReviewResult($workerId,$cloudId,$decision,$reason,$workerName); }\n    public static function subscriptionTestEventOptions(string $sceneKey):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->subscriptionTestEventOptions($sceneKey); }\n    public static function subscriptionTestSampleValues(string $sceneKey):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->subscriptionTestSampleValues($sceneKey); }\n    public static function buildSubscriptionTestData(string $sceneKey,array $scene):array { return (new SubscriptionTestData(new GlobalSettingsProvider()))->buildSubscriptionTestData($sceneKey,$scene,$_POST); }\n    public static function enqueueSmsFallback(Database $db,array $fallback):bool { return OrderSubscriptionQueue::enqueueSmsFallback($db,$fallback); }\n\n    public static function subscriptionSceneDefinitions(): array { return SubscriptionCatalog::subscriptionSceneDefinitions(); }\n    public static function subscriptionSemanticLabels(): array { return SubscriptionCatalog::subscriptionSemanticLabels(); }\n    public static function subscriptionSemanticDescriptions(): array { return SubscriptionCatalog::subscriptionSemanticDescriptions(); }\n    public static function reviewResultFixedTemplateFields(): array { return SubscriptionCatalog::reviewResultFixedTemplateFields(); }\n    public static function subscriptionFixedValuePresets(string $wechatField,string $label=''): array { return SubscriptionCatalog::subscriptionFixedValuePresets($wechatField,$label); }\n    public static function inferSubscriptionTemplateBinding(array $scene,array $actual,array $previous=[]): array { return SubscriptionCatalog::inferSubscriptionTemplateBinding($scene,$actual,$previous); }\n    public static function recommendSubscriptionKeywords(array $scene,array $keywords): array { return SubscriptionCatalog::recommendSubscriptionKeywords($scene,$keywords); }\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderNegotiationRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderNegotiationRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\NegotiationPolicy;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\FulfillmentActor;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n// 2026-10-08：所有写操作先锁订单，再锁原业务记录；升级只创建一份现有平台争议。\nfinal class DatabaseOrderNegotiationRepository implements OrderNegotiationRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n\n    private function order(Database $db, array $actor, string $orderNo): array\n    {\n        $order = $db->fetch('SELECT * FROM orders WHERE BINARY public_no=BINARY :no FOR UPDATE', ['no'=>$orderNo]);\n        if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n        $owner = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n        $worker = (int)($actor['worker_id'] ?? 0) > 0 && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n        if (!$owner && !$worker) throw new OrderOperationException('只有订单双方可以处理协商', 'FORBIDDEN', 403);\n        return $order;\n    }\n\n    public function respond(array $actor, string $orderNo, string $kind, string $reference, string $decision, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$kind,$reference,$decision,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if (FulfillmentActor::assisted($actor) && ($kind!=='repair' || $decision!=='complete')) {\n                throw new OrderOperationException('协助入口只能提交维修处理结果','ASSISTANCE_NOT_ALLOWED',422);\n            }\n            if ($kind === 'refund') {\n                $request = $this->refund($db, (int)$order['id'], $reference);\n                $this->requireCounterparty($actor, $order, $request);\n                if ($decision === 'accepted') return (new DatabaseOrderCancellationRepository($db))->approveByAgreement($actor, $reference);\n                if ($decision !== 'rejected') throw new OrderOperationException('退款只能接受或拒绝', 'NEGOTIATION_RESPONSE_INVALID', 422);\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_rejected',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n            } elseif ($kind === 'repair') {\n                $this->requireWorker($actor, $order);\n                $repair = $db->fetch(\"SELECT * FROM after_sales WHERE order_id=:id AND BINARY public_no=BINARY :no AND type='warranty_repair' FOR UPDATE\", ['id'=>$order['id'],'no'=>$reference]);\n                if (!$repair || !in_array((string)$repair['status'], ['open','processing'], true)\n                    || strpos((string)$repair['resolution'], '用户申请平台介入') === 0 || strpos((string)$repair['resolution'], '平台主动介入') === 0 || strpos((string)$repair['resolution'], '师傅拒绝维修') === 0) {\n                    throw new OrderOperationException('维修已经响应、结束或平台介入', 'REPAIR_NOT_ACTIVE', 409);\n                }\n                if ($decision === 'accepted' && strpos((string)$repair['resolution'], '师傅接受维修') === 0) {\n                    throw new OrderOperationException('已经接受处理，请记录预约或完成维修', 'REPAIR_ALREADY_ACCEPTED', 409);\n                }\n                $resolution = ($decision === 'rejected' ? '师傅拒绝维修：' : ($decision === 'complete' ? '师傅已完成维修：' : '师傅接受维修：')).$note;\n                if (FulfillmentActor::assisted($actor)) $resolution='管理员补录维修处理结果：'.$note;\n                $db->execute(\"UPDATE after_sales SET status=:status,resolution=:resolution,closed_at=IF(:done=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                    ['status'=>$decision === 'complete' ? 'resolved' : 'processing','resolution'=>$resolution,'done'=>$decision === 'complete' ? 1 : 0,'id'=>$repair['id']]);\n                if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                    $episodes=new DatabaseChatRepairEpisodes($db,true);\n                    if($decision==='accepted') $episodes->acceptWorker((int)$order['id'],(int)$repair['id'],(int)$actor['worker_id']);\n                    else $episodes->close((int)$order['id'],(int)$repair['id']);\n                }\n            } elseif ($kind === 'dispute') {\n                $this->requireWorker($actor, $order);\n                $dispute = $db->fetch('SELECT * FROM disputes WHERE order_id=:id AND BINARY public_no=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                if (!$dispute || (string)$dispute['status'] !== 'negotiating' || !empty($dispute['resolution']) || $decision === 'complete') {\n                    throw new OrderOperationException('异议已经响应或不在协商阶段', 'DISPUTE_RESPONSE_NOT_ALLOWED', 409);\n                }\n                $db->execute('UPDATE disputes SET resolution=:note,updated_at=UTC_TIMESTAMP() WHERE id=:id',\n                    ['note'=>($decision === 'rejected' ? '师傅拒绝异议：' : '师傅接受异议，处理中：').$note,'id'=>$dispute['id']]);\n            } elseif ($kind === 'measurement') {\n                $this->requireWorker($actor, $order);\n                $state = $this->measurement($db, $order, $reference);\n                if ($decision !== 'rejected') throw new OrderOperationException('补测请直接补充成果后提交', 'MEASUREMENT_RESPONSE_INVALID', 422);\n                if ($state['status'] === 'rejected') throw new OrderOperationException('已拒绝本次补测', 'MEASUREMENT_ALREADY_REJECTED', 409);\n                $this->event($db, $order, $actor, 'measurement_rework_rejected', ['rework_id'=>$reference,'note'=>$note,'message'=>'师傅拒绝补测：'.$note]);\n            } else {\n                throw new OrderOperationException('加价请使用原有同意/拒绝入口', 'NEGOTIATION_RESPONSE_INVALID', 422);\n            }\n            // 补测拒绝已经记录专属事件并通知客户；不要再投递一次通用响应。\n            if ($kind !== 'measurement') {\n                $event = $kind === 'repair' ? ['accepted'=>'repair_worker_accepted','rejected'=>'repair_worker_rejected','complete'=>'repair_worker_completed'][$decision] : 'negotiation_responded';\n                $this->event($db, $order, $actor, $event, ['after_sale_id'=>$kind === 'repair' ? $reference : null,'kind'=>$kind,'reference'=>$reference,'decision'=>$decision,'note'=>$note,'message'=>FulfillmentActor::assisted($actor) ? '管理员已补录维修处理结果' : ($decision === 'complete' ? '师傅已提交维修处理结果' : ($decision === 'rejected' ? '对方拒绝方案，可继续协商或申请平台介入' : '对方已接受处理'))]);\n            }\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'decision'=>$decision];\n        });\n    }\n\n    public function proposeRefund(array $actor, string $orderNo, string $reference, int $amount, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reference,$amount,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n            if (!$request || (string)$request['status'] !== 'pending' || NegotiationPolicy::refundStatus((string)$request['reason_code']) !== 'rejected'\n                || (string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('拒绝后才能重新提出退款方案', 'REFUND_PROPOSAL_NOT_ALLOWED', 409);\n            $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n            // 报价式方案只记录双方意愿，执行时仍重新核对真实可退支付，不相信客户端金额。\n            $db->execute(\"UPDATE order_cancel_requests SET applicant_type=:type,applicant_id=:actor,requested_refund_cents=:amount,reason=:note,reason_code='bilateral_refund_pending',requested_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP() WHERE id=:id\",\n                ['type'=>$type,'actor'=>in_array($type,['user','mini_admin'],true) ? $actor['user_id'] : $actor['worker_id'],'amount'=>$amount,'note'=>$note,'id'=>$request['id']]);\n            $this->event($db, $order, $actor, 'cancel_requested', ['reference'=>$reference,'requested_refund_cents'=>$amount,'message'=>'双方重新提出退款方案，等待对方接受或拒绝']);\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'status'=>'pending'];\n        });\n    }\n\n    public function withdrawRefund(array $actor, string $orderNo, string $reference, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$reference,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if ((string)$order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('订单已进入取消、退款或结束流程，不能撤回退款方案', 'REFUND_WITHDRAW_NOT_ALLOWED', 409);\n            }\n            $request = $db->fetch(\n                'SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE',\n                ['id'=>$order['id'],'no'=>$reference]\n            );\n            if (!$request || (string)$request['status'] !== 'pending'\n                || !in_array((string)$request['reason_code'], ['bilateral_refund_pending','bilateral_refund_rejected'], true)) {\n                throw new OrderOperationException('退款方案已进入平台处理、资金执行或已经结束，不能撤回', 'REFUND_WITHDRAW_NOT_ALLOWED', 409);\n            }\n\n            $userApplicant = (string)$request['applicant_type'] === 'user'\n                && (int)$request['applicant_id'] === (int)($actor['user_id'] ?? 0)\n                && (int)$order['user_id'] === (int)($actor['user_id'] ?? 0);\n            $workerApplicant = (string)$request['applicant_type'] === 'worker'\n                && (int)$request['applicant_id'] === (int)($actor['worker_id'] ?? 0)\n                && (int)($actor['worker_id'] ?? 0) > 0\n                && (int)$order['assigned_worker_id'] === (int)$actor['worker_id'];\n            if (!$userApplicant && !$workerApplicant) {\n                throw new OrderOperationException('只有当前退款方案提出方可以撤回', 'REFUND_WITHDRAW_FORBIDDEN', 403);\n            }\n\n            if ($db->fetchValue(\n                \"SELECT id FROM refunds\n                 WHERE cancel_request_id=:request_id AND status NOT IN ('failed','closed','cancelled','rejected')\n                 LIMIT 1 FOR UPDATE\",\n                ['request_id'=>$request['id']]\n            )) {\n                throw new OrderOperationException('本方案已经产生退款资金记录，不能恢复履约', 'REFUND_WITHDRAW_FINANCE_STARTED', 409);\n            }\n\n            $snapshot = json_decode((string)($request['order_state_snapshot_json'] ?? ''), true);\n            if (!is_array($snapshot)) $snapshot = [];\n            $restoreRefund = (string)($snapshot['refund_status'] ?? 'none');\n            if (!in_array($restoreRefund, ['', 'none','failed'], true)) $restoreRefund = 'none';\n            if ($restoreRefund === '') $restoreRefund = 'none';\n            $restorePublish = (string)($snapshot['publish_status'] ?? 'hidden');\n            if (!in_array($restorePublish, ['published','hidden'], true)) $restorePublish = 'hidden';\n\n            $hasMeasurementLink = (bool)$db->fetchValue(\n                \"SELECT 1 FROM order_relations\n                 WHERE child_order_id=:id AND relation_type='measurement_construction' AND status='active' LIMIT 1 FOR UPDATE\",\n                ['id'=>$order['id']]\n            );\n            $hasActiveDispute = !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                || (bool)$db->fetchValue(\n                    \"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\",\n                    ['id'=>$order['id']]\n                );\n            if ($hasMeasurementLink || $hasActiveDispute) $restorePublish = 'hidden';\n\n            $changed = $db->execute(\n                \"UPDATE order_cancel_requests\n                 SET status='cancelled',reason_code='bilateral_refund_withdrawn',closed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status='pending' AND reason_code IN ('bilateral_refund_pending','bilateral_refund_rejected')\",\n                ['id'=>$request['id']]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('退款方案状态已变化，请刷新', 'REFUND_WITHDRAW_CHANGED', 409);\n            }\n            $db->execute(\n                \"UPDATE orders\n                 SET refund_status=:refund_status,publish_status=:publish_status,version=version+1,updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND lifecycle_status='active'\",\n                ['refund_status'=>$restoreRefund,'publish_status'=>$restorePublish,'id'=>$order['id']]\n            );\n            $this->event($db, $order, $actor, 'negotiation_responded', [\n                'kind'=>'refund','reference'=>$reference,'decision'=>'withdrawn','note'=>$note,\n                'message'=>'退款方案已由提出方撤回，订单恢复继续履约',\n            ]);\n            return ['reference'=>$reference,'status'=>'withdrawn','order_resumed'=>true];\n        });\n    }\n\n    public function escalate(array $actor, string $orderNo, string $kind, string $reference, string $note): array\n    {\n        return $this->db->transaction(function (Database $db) use ($actor,$orderNo,$kind,$reference,$note): array {\n            $order = $this->order($db, $actor, $orderNo);\n            if ((string)$order['lifecycle_status'] !== 'active') throw new OrderOperationException('订单已结束', 'ORDER_NOT_ACTIVE', 409);\n            if ($kind === 'dispute') return (new DatabaseOrderDisputeRepository($db))->escalate($actor, $reference, $note);\n            if ($kind === 'repair') return (new DatabaseOrderRepairInterventionRepository($db))->request($actor, $orderNo, $reference, $note);\n            if ($kind === 'refund') {\n                $request = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                if (!$request || (string)$request['status'] !== 'pending') throw new OrderOperationException('退款方案已经结束', 'REFUND_PROPOSAL_NOT_FOUND', 409);\n                $eligibility = NegotiationPolicy::evaluate(NegotiationPolicy::refundStatus((string)$request['reason_code']), $request['requested_at']);\n                $this->requireEligible($eligibility);\n                $db->execute(\"UPDATE order_cancel_requests SET reason_code='bilateral_refund_escalated',updated_at=UTC_TIMESTAMP() WHERE id=:id\", ['id'=>$request['id']]);\n                $this->event($db, $order, $actor, 'cancel_requested', ['message'=>'双方退款协商未解决，已申请平台介入','reference'=>$reference,'note'=>$note,'notify_recipients'=>['user','worker','admin']]);\n            } else {\n                if ($kind === 'change') {\n                    $change = $db->fetch('SELECT * FROM change_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$order['id'],'no'=>$reference]);\n                    $latest = $db->fetchValue('SELECT public_id FROM change_requests WHERE order_id=:id ORDER BY id DESC LIMIT 1', ['id'=>$order['id']]);\n                    if (!$change || $latest !== $reference || in_array((string)$order['fulfillment_status'], ['submitted','accepted'], true)) {\n                        throw new OrderOperationException('加价事项已失效或被新方案替代', 'CHANGE_NOT_ACTIVE', 409);\n                    }\n                    $eligibility = NegotiationPolicy::evaluate((string)$change['status'], $change['submitted_at']);\n                } elseif ($kind === 'measurement') {\n                    $this->requireOwner($actor, $order);\n                    $state = $this->measurement($db, $order, $reference);\n                    $eligibility = NegotiationPolicy::evaluate($state['status'], $state['opened_at']);\n                } else throw new OrderOperationException('协商类型不支持升级', 'NEGOTIATION_INVALID', 422);\n                $this->requireEligible($eligibility);\n                if (!in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)\n                    || $db->fetchValue(\"SELECT id FROM disputes WHERE order_id=:id AND status IN ('negotiating','open','pending','processing') LIMIT 1 FOR UPDATE\", ['id'=>$order['id']])) {\n                    throw new OrderOperationException('本单已有争议正在处理中', 'DISPUTE_ALREADY_ACTIVE', 409);\n                }\n                $disputeNo = \\business_no('DSP');\n                $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n                $db->insert(\"INSERT INTO disputes(public_no,order_id,raised_by_type,raised_by_id,dispute_type,title,description,status,responsibility,opened_at,created_at,updated_at)\n                    VALUES(:no,:order,:type,:actor,:kind,:title,:description,'open','undetermined',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['no'=>$disputeNo,'order'=>$order['id'],'type'=>$type,'actor'=>$type === 'user' ? $actor['user_id'] : $actor['worker_id'],'kind'=>$kind === 'change' ? 'fee_negotiation' : 'measurement_rework',\n                     'title'=>$kind === 'change' ? '加价协商未解决，申请平台介入' : '补测未解决，申请平台介入','description'=>'关联事项 '.$reference.'；'.$note]);\n                $db->execute(\"UPDATE orders SET dispute_status='open',publish_status='hidden' WHERE id=:id\", ['id'=>$order['id']]);\n                $this->event($db, $order, $actor, 'dispute_opened', ['dispute_no'=>$disputeNo,'reference'=>$reference,'intervention_reason'=>$eligibility['reason'],'message'=>'双方协商未解决，已申请平台介入','notify_recipients'=>['user','worker']]);\n                OrderNotificationService::queueAdminTask($db, 'dispute:'.$disputeNo, 'completion_dispute_opened', '双方协商未解决，申请平台介入', ['订单号'=>$orderNo,'事项'=>$kind,'协商说明'=>$note]);\n            }\n            $db->execute('UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id', ['id'=>$order['id']]);\n            return ['reference'=>$reference,'status'=>'escalated','intervention_reason'=>$eligibility['reason']];\n        });\n    }\n\n    private function refund(Database $db, int $orderId, string $reference): array\n    {\n        $row = $db->fetch('SELECT * FROM order_cancel_requests WHERE order_id=:id AND BINARY public_id=BINARY :no FOR UPDATE', ['id'=>$orderId,'no'=>$reference]);\n        if (!$row || (string)$row['status'] !== 'pending' || (string)$row['reason_code'] !== 'bilateral_refund_pending') throw new OrderOperationException('退款方案已经响应或不在协商阶段', 'REFUND_PROPOSAL_NOT_PENDING', 409);\n        return $row;\n    }\n\n    private function requireCounterparty(array $actor, array $order, array $request): void\n    {\n        if ((string)$request['applicant_type'] === 'user') $this->requireWorker($actor, $order);\n        elseif ((string)$request['applicant_type'] === 'worker') $this->requireOwner($actor, $order);\n        else throw new OrderOperationException('该退款需平台处理', 'REFUND_PROPOSAL_NOT_ALLOWED', 409);\n    }\n\n    private function requireWorker(array $actor, array $order): void\n    {\n        if ((int)($actor['worker_id'] ?? 0) < 1 || (int)$order['assigned_worker_id'] !== (int)$actor['worker_id']) throw new OrderOperationException('只能由成交师傅响应', 'FORBIDDEN', 403);\n    }\n    private function requireOwner(array $actor, array $order): void\n    {\n        if ((int)$order['user_id'] !== (int)($actor['user_id'] ?? 0)) throw new OrderOperationException('只能由订单客户申请', 'FORBIDDEN', 403);\n    }\n    private function requireEligible(array $eligibility): void\n    {\n        if (empty($eligibility['eligible'])) throw new OrderOperationException('请先协商；对方拒绝或满48小时未解决后才可申请平台介入', 'NEGOTIATION_WAIT_REQUIRED', 409, $eligibility);\n    }\n    private function measurement(Database $db, array $order, string $reference): array\n    {\n        $state = $db->fetch('SELECT result_status FROM order_measurement_states WHERE order_id=:id FOR UPDATE', ['id'=>$order['id']]);\n        $rework = $db->fetch(\"SELECT id,created_at FROM order_events WHERE order_id=:id AND event_type='measurement_rework_requested' ORDER BY id DESC LIMIT 1\", ['id'=>$order['id']]);\n        if (!$state || !$rework || (string)$rework['id'] !== $reference || (string)$state['result_status'] !== 'editing'\n            || !in_array((string)($order['dispute_status'] ?? 'none'), ['', 'none','resolved'], true)) throw new OrderOperationException('补测已提交或正在平台处理中', 'MEASUREMENT_REWORK_NOT_ACTIVE', 409);\n        $rejected = $db->fetchValue(\"SELECT id FROM order_events WHERE order_id=:id AND event_type='measurement_rework_rejected' AND id>:rework LIMIT 1\", ['id'=>$order['id'],'rework'=>$rework['id']]);\n        return ['status'=>$rejected ? 'rejected' : 'pending','opened_at'=>$rework['created_at']];\n    }\n    private function event(Database $db, array $order, array $actor, string $event, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule((int)$order['id']);\n        }\n        $type = (int)$order['user_id'] === (int)($actor['user_id'] ?? 0) ? 'user' : 'worker';\n        if (FulfillmentActor::assisted($actor)) { $type='mini_admin'; $payload += FulfillmentActor::metadata($actor); }\n        $key = $event.':'.$order['id'].':'.bin2hex(random_bytes(6));\n        $payload += ['notify_recipients'=>$type==='mini_admin' ? ['user','worker'] : [$type === 'user' ? 'worker' : 'user']];\n        $db->insert('INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order,:event,:key,:type,:actor,:payload,UTC_TIMESTAMP())',\n            ['order'=>$order['id'],'event'=>$event,'key'=>$key,'type'=>$type,'actor'=>$type === 'user' ? $actor['user_id'] : $actor['worker_id'],'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n        OrderNotificationService::queue($db, (int)$order['id'], $key, $event, $payload);\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseAdminRepairResolutionRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\AdminRepairResolutionRepository;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Services\\OrderNotificationService;\n\n/**\n * 平台介入维修裁定。\n *\n * mini_admin 的 users.id 只写带类型的 order_events，不写 after_sales.handled_by；\n * web_admin 的 admin_users.id 与 handled_by 外键同域，可作为后台处理人落库。\n * 资金补偿/退款继续走退款与争议领域，不在本仓储混合处理。\n */\nfinal class DatabaseAdminRepairResolutionRepository implements AdminRepairResolutionRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    public function resolve(\n        array $operator,\n        string $orderNo,\n        string $afterSaleNo,\n        string $decision,\n        string $note\n    ): array {\n        $channel = trim((string)($operator['channel'] ?? ''));\n        $operatorUserId = (int)($operator['user_id'] ?? 0);\n        if (!in_array($channel, ['mini_admin','web_admin'], true) || $operatorUserId < 1) {\n            throw new OrderOperationException('管理员身份无效', 'ADMIN_REQUIRED', 403);\n        }\n        if (!in_array($decision, ['continue','resolved','closed'], true)) {\n            throw new OrderOperationException('平台售后处理动作无效', 'REPAIR_PLATFORM_DECISION_INVALID', 422);\n        }\n\n        return $this->db->transaction(function (Database $db) use ($channel,$operatorUserId,$orderNo,$afterSaleNo,$decision,$note): array {\n            $order = $db->fetch(\n                'SELECT id,public_no,version FROM orders WHERE BINARY public_no=BINARY :public_no FOR UPDATE',\n                ['public_no'=>$orderNo]\n            );\n            if (!$order) throw new OrderOperationException('订单不存在', 'ORDER_NOT_FOUND', 404);\n\n            $afterSale = $db->fetch(\n                \"SELECT * FROM after_sales\n                 WHERE order_id=:order_id AND BINARY public_no=BINARY :public_no AND type='warranty_repair'\n                 LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$order['id'],'public_no'=>$afterSaleNo]\n            );\n            if (!$afterSale) {\n                throw new OrderOperationException('维修售后不存在', 'REPAIR_NOT_FOUND', 404);\n            }\n            if (!in_array((string)$afterSale['status'], ['open','processing'], true)) {\n                throw new OrderOperationException('该售后已结束，请刷新', 'REPAIR_PLATFORM_REVIEW_CHANGED', 409);\n            }\n\n            $currentResolution = (string)($afterSale['resolution'] ?? '');\n            $alreadyContinued = strpos($currentResolution, '平台介入：要求继续维修：') === 0;\n            $hasIntervention = strpos($currentResolution, '用户申请平台介入') === 0;\n            if (!$hasIntervention) {\n                $hasIntervention = (bool)$db->fetchValue(\n                    \"SELECT 1 FROM order_events\n                     WHERE order_id=:order_id AND event_type='repair_platform_intervention_requested'\n                       AND payload_json LIKE :needle\n                     ORDER BY id DESC LIMIT 1 FOR UPDATE\",\n                    [\n                        'order_id'=>$order['id'],\n                        'needle'=>'%\"after_sale_id\":\"'.$afterSaleNo.'\"%',\n                    ]\n                );\n            }\n            if (!$hasIntervention) {\n                throw new OrderOperationException(\n                    '请先由用户按规则申请平台介入',\n                    'REPAIR_PLATFORM_INTERVENTION_REQUIRED',\n                    409\n                );\n            }\n            if ($decision === 'continue' && $alreadyContinued) {\n                throw new OrderOperationException(\n                    '平台已要求继续维修，请等待处理后再确认解决或关闭售后',\n                    'REPAIR_PLATFORM_CONTINUE_ALREADY_REQUESTED',\n                    409\n                );\n            }\n\n            $status = 'processing';\n            $resolution = '平台介入：要求继续维修：'.$note;\n            $eventType = 'repair_platform_continue';\n            $message = '平台介入后要求师傅继续维修：'.$note;\n            $closeNow = 0;\n            if ($decision === 'resolved') {\n                $status = 'resolved';\n                $resolution = '平台裁定：问题已解决：'.$note;\n                $eventType = 'repair_platform_resolved';\n                $message = '平台已确认本次售后问题解决：'.$note;\n                $closeNow = 1;\n            } elseif ($decision === 'closed') {\n                $status = 'closed';\n                $resolution = '平台裁定：关闭售后：'.$note;\n                $eventType = 'repair_platform_closed';\n                $message = '平台已关闭本次售后：'.$note;\n                $closeNow = 1;\n            }\n\n            $handledBy = $channel === 'web_admin' ? $operatorUserId : 0;\n            $changed = $db->execute(\n                \"UPDATE after_sales\n                 SET status=:status,resolution=:resolution,\n                     handled_by=IF(:handled_by>0,:handled_by,handled_by),\n                     closed_at=IF(:close_now=1,UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n                 WHERE id=:id AND status IN ('open','processing')\",\n                [\n                    'status'=>$status,\n                    'resolution'=>$resolution,\n                    'handled_by'=>$handledBy,\n                    'close_now'=>$closeNow,\n                    'id'=>$afterSale['id'],\n                ]\n            );\n            if ($changed !== 1) {\n                throw new OrderOperationException('该售后状态已变化，请刷新', 'REPAIR_PLATFORM_REVIEW_CHANGED', 409);\n            }\n\n            if ($closeNow === 1) {\n                if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n                    (new DatabaseChatRepairEpisodes($db,true))->close((int)$order['id'],(int)$afterSale['id']);\n                }\n                // 售后结束后，尚未处理的维修电话公开申请不再有业务上下文，直接关闭为 rejected。\n                $db->execute(\n                    \"UPDATE order_worker_contact_reveal_requests\n                     SET status='rejected',review_note='售后已由平台结案',reviewed_at=UTC_TIMESTAMP(),updated_at=UTC_TIMESTAMP()\n                     WHERE order_id=:order_id AND after_sale_id=:after_sale_id AND context_type='repair' AND status='pending'\",\n                    ['order_id'=>$order['id'],'after_sale_id'=>$afterSale['id']]\n                );\n            }\n\n            $db->execute(\n                'UPDATE orders SET version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id',\n                ['id'=>$order['id']]\n            );\n\n            $actorType = $channel === 'web_admin' ? 'admin' : 'mini_admin';\n            $eventKey = $eventType.':'.$order['id'].':'.bin2hex(random_bytes(6));\n            $payload = [\n                'after_sale_id'=>$afterSaleNo,\n                'decision'=>$decision,\n                'note'=>$note,\n                'message'=>$message,\n                'operator_channel'=>$channel,\n                'operator_user_id'=>$channel === 'mini_admin' ? $operatorUserId : null,\n                'operator_admin_id'=>$channel === 'web_admin' ? $operatorUserId : null,\n                'notify_recipients'=>['user','worker'],\n            ];\n            $db->insert(\n                'INSERT INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at)\n                 VALUES(:order_id,:event_type,:event_key,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())',\n                [\n                    'order_id'=>$order['id'],\n                    'event_type'=>$eventType,\n                    'event_key'=>$eventKey,\n                    'actor_type'=>$actorType,\n                    'actor_id'=>$operatorUserId,\n                    'payload'=>json_encode($payload, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n                ]\n            );\n            OrderNotificationService::queue($db, (int)$order['id'], $eventKey, $eventType, $payload);\n\n            return [\n                'order_id'=>(string)$order['public_no'],\n                'after_sale_id'=>$afterSaleNo,\n                'status'=>$status,\n                'decision'=>$decision,\n                'order_version'=>(int)$order['version'] + 1,\n            ];\n        });\n    }\n}\n","server/app/Services/MessageEventCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nrequire_once __DIR__.'/../Domain/Messaging/MessageEventCatalog.php';\n\nfinal class MessageEventCatalog\n{\n\n    public static function all(): array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::all(); }\n    public static function get(string $eventType): ?array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::get($eventType); }\n    public static function switches(string $channel, array $configured): array { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::switches($channel,$configured); }\n    public static function enabled(string $channel, string $eventType, array $configured): bool { return \\WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog::enabled($channel,$eventType,$configured); }\n}\n","server/app/Infrastructure/Messaging/DatabaseNotificationProducer.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\NotificationProducer;\n\nfinal class DatabaseNotificationProducer implements NotificationProducer\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db=$db; }\n    public function queue(int $orderId,string $key,string $type,array $payload=[]):void { OrderNotificationProjector::queue($this->db,$orderId,$key,$type,$payload); }\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void { OrderNotificationProjector::queueAdminTask($this->db,$key,$type,$title,$lines); }\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void { OrderNotificationProjector::queueWorkerWithdrawalResult($this->db,$workerId,$no,$status,$note,$amount); }\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void { OrderNotificationProjector::queueWorkerReviewResult($this->db,$workerId,$cloudId,$decision,$reason,$name); }\n}\n","server/app/Contracts/OrderQuoteSwitchRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderQuoteSwitchRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array{message:string,data:array<string,mixed>}\n     */\n    public function switchWorker(array $actor, string $orderPublicNo, string $quotePublicId, string $reason): array;\n}\n","server/app/Application/Messaging/MessageEventSwitches.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\n\nfinal class MessageEventSwitches\n{\n    private SettingsProvider $settings;\n    public function __construct(SettingsProvider $settings) { $this->settings=$settings; }\n    public function forChannel(string $channel):array\n    {\n        $key=$channel==='wecom'?'wecom.event_switches':($channel==='inapp'?'notification.internal_event_switches':'sms.event_switches');\n        $configured=$this->settings->get($key,[]);return MessageEventCatalog::switches($channel,is_array($configured)?$configured:[]);\n    }\n}\n","server/app/Application/Messaging/OrderNotificationPublisher.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse InvalidArgumentException;\nuse WorkerAdmin\\Contracts\\NotificationProducer;\nuse WorkerAdmin\\Contracts\\OrderNotificationPort;\n\nfinal class OrderNotificationPublisher implements OrderNotificationPort\n{\n    private NotificationProducer $producer;\n    public function __construct(NotificationProducer $producer) { $this->producer=$producer; }\n    public function queue(int $orderId,string $idempotencyKey,string $eventType,array $payload=[]):void { $this->producer->queue($orderId,$idempotencyKey,$eventType,$payload); }\n    public function queuePersistedEvent(int $orderId,int $eventId,string $type,array $payload=[]):void\n    { if($eventId<1)throw new InvalidArgumentException('通知必须关联已落库的订单事件');$this->queue($orderId,'order-event:'.$eventId,$type,$payload); }\n    public function adminTask(string $key,string $type,string $title,array $lines=[]):void { $this->producer->adminTask($key,$type,$title,$lines); }\n    public function withdrawalResult(int $workerId,string $no,string $status,string $note='',int $amount=0):void { $this->producer->withdrawalResult($workerId,$no,$status,$note,$amount); }\n    public function workerReviewResult(int $workerId,string $cloudId,string $decision,string $reason,string $name=''):void { $this->producer->workerReviewResult($workerId,$cloudId,$decision,$reason,$name); }\n}\n","server/app/Application/Messaging/SubscriptionTestData.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\n\nfinal class SubscriptionTestData\n{\n    private SettingsProvider $settings;\n    public function __construct(SettingsProvider $settings) { $this->settings=$settings; }\n    public function subscriptionTestEventOptions(string $sceneKey):array\n    {\n        $options=[];\n        foreach(MessageEventCatalog::all() as $eventType=>$meta){\n            if(!is_array($meta)||(string)($meta['subscription_scene']??'')!==$sceneKey)continue;\n            $status=trim((string)($meta['status']??''));if($status==='')continue;\n            $label=trim((string)($meta['label']??''));if($label==='')$label=$status;\n            $options[(string)$eventType]=['label'=>$label,'status'=>$status];\n        }\n        return $options;\n    }\n\n    public function subscriptionTestSampleValues(string $sceneKey):array\n    {\n        $eventOptions= $this->subscriptionTestEventOptions($sceneKey);$first=$eventOptions?(array)reset($eventOptions):[];\n        $platformName=trim((string)$this->settings->get('site.name','壁选'));if($platformName==='')$platformName='壁选';\n        return [\n            'order_no'=>'TEST'.date('YmdHis'),\n            'status'=>(string)($first['status']??'测试通知'),\n            'time'=>date('Y-m-d H:i'),\n            'amount'=>'128.00',\n            'quote_party'=>'张师傅',\n            'platform_name'=>$platformName,\n            'merchant_name'=>'示例家居门店',\n            'worker_name'=>'张师傅',\n            'service_category'=>'墙布施工',\n            'order_title'=>'客厅墙布施工',\n            'service_address'=>'杭州市西湖区示例路',\n            'requirement_note'=>'墙面需先检查基层',\n            'audit_note'=>'资料齐全，审核通过',\n            'expected_visit_time'=>date('Y-m-d H:i',time()+86400),\n            'contact_name'=>'张**',\n            'appointment_time'=>date('Y-m-d H:i',time()+86400),\n            'appointment_note'=>'上门前请电话联系',\n        ];\n    }\n\n    public function buildSubscriptionTestData(string $sceneKey,array $scene,array $input=[]):array\n    {\n        if($sceneKey==='reviewResult'){\n            return [\n                'name1'=>['value'=>'测试师傅'],\n                'phone_number2'=>['value'=>'13800000000'],\n                'phrase3'=>['value'=>'测试通知'],\n                'thing5'=>['value'=>'后台订阅消息链路测试'],\n            ];\n        }\n        $fieldMap=is_array($scene['field_map']??null)?$scene['field_map']:[];\n        if(!$fieldMap)throw new \\RuntimeException('该订阅场景尚未配置字段映射，不能发送测试。');\n        $samples= $this->subscriptionTestSampleValues($sceneKey);\n        $eventOptions= $this->subscriptionTestEventOptions($sceneKey);\n        $eventPost=is_array($input['test_event_type']??null)?$input['test_event_type']:[];\n        $eventType=trim((string)($eventPost[$sceneKey]??''));\n        if($eventType!==''&&isset($eventOptions[$eventType]))$samples['status']=(string)$eventOptions[$eventType]['status'];\n        $valuesPost=is_array($input['test_values']??null)?($input['test_values'][$sceneKey]??[]):[];\n        if(is_array($valuesPost)){\n            foreach($valuesPost as $semantic=>$value){\n                $semantic=(string)$semantic;if(!array_key_exists($semantic,$samples)||is_array($value))continue;\n                // 有真实业务节点可选时，状态必须来自事件目录，避免“测试成功但生产不存在这种状态”。\n                if($semantic==='status'&&$eventOptions)continue;\n                $value=mb_substr(trim((string)$value),0,500);if($value!=='')$samples[$semantic]=$value;\n            }\n        }\n        $data=[];\n        foreach($fieldMap as $semantic=>$wechatKey){\n            $semantic=(string)$semantic;$wechatKey=trim((string)$wechatKey);\n            if($wechatKey===''||!array_key_exists($semantic,$samples))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,(string)$samples[$semantic]);\n            if($formatted===null||$formatted==='')throw new \\RuntimeException('测试字段 '.$semantic.' → '.$wechatKey.' 无法生成合法示例值，请检查字段映射或测试值。');\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $wechatKey=>$fixedValue){\n            $wechatKey=trim((string)$wechatKey);$fixedValue=trim((string)$fixedValue);\n            if($wechatKey===''||$fixedValue===''||isset($data[$wechatKey]))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,$fixedValue);\n            if($formatted===null||$formatted==='')throw new \\RuntimeException('固定字段 '.$wechatKey.' 无法生成合法测试值，请检查高级设置。');\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['template_fields']??[]) as $templateField)if(!isset($data[$templateField]))throw new \\RuntimeException('模板字段 '.$templateField.' 尚未配置数据来源，不能测试发送。');\n        if(!$data)throw new \\RuntimeException('没有可用于测试发送的模板字段。');\n        return $data;\n    }\n}\n","server/app/Infrastructure/Messaging/OrderSubscriptionQueue.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\MessageEventCatalog;\nuse WorkerAdmin\\Domain\\Messaging\\OrderMessageDefinition;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\n\nfinal class OrderSubscriptionQueue\n{\n\n    public static function subscriptionBusinessValues(Database $db,int $orderId,string $eventType,array $definition,array $parameters):array\n    {\n        $row=$db->fetch(\"SELECT o.public_no,o.order_source_type,o.merchant_profile_id,o.category_name_snapshot,o.category_names_snapshot,o.title,o.description,o.audit_note,o.expected_visit_at,o.city,o.district,o.address_summary,o.assigned_worker_id,mp.business_name merchant_business_name,oa.address_summary address_snapshot,oa.contact_name_masked,wp.display_name worker_name FROM orders o LEFT JOIN merchant_profiles mp ON mp.id=o.merchant_profile_id LEFT JOIN order_addresses oa ON oa.order_id=o.id LEFT JOIN worker_profiles wp ON wp.id=o.assigned_worker_id WHERE o.id=:id LIMIT 1\",['id'=>$orderId]);\n        if(!$row)$row=[];\n        $appointment=$db->fetch(\"SELECT appointment_at,note,wait_customer_notice FROM appointment_records WHERE order_id=:id AND context_type='service' ORDER BY id DESC LIMIT 1\",['id'=>$orderId]);\n        if(!$appointment)$appointment=[];\n        $platformName=trim((string)\\setting('site.name','壁选'));\n        if($platformName==='')$platformName='壁选';\n        $serviceCategory=trim((string)($row['category_names_snapshot']??''));\n        if($serviceCategory===''||$serviceCategory==='不确定类目')$serviceCategory=trim((string)($row['category_name_snapshot']??''));\n        if($serviceCategory==='')$serviceCategory='施工服务';\n        $orderTitle=trim((string)($row['title']??''));if($orderTitle==='')$orderTitle=$serviceCategory;\n        $address=trim((string)($row['address_snapshot']??''));if($address==='')$address=trim((string)($row['address_summary']??''));\n        if($address==='')$address=trim((string)(($row['city']??'').($row['district']??'')));if($address==='')$address='请查看订单详情';\n        $merchantName=trim((string)($row['merchant_business_name']??''));if($merchantName==='')$merchantName=((string)($row['order_source_type']??'consumer')==='merchant'?'商家订单':'个人订单');\n        $workerName=trim((string)($row['worker_name']??''));if($workerName==='')$workerName='待安排师傅';\n        $requirement=trim((string)($row['description']??''));if($requirement==='')$requirement='无特殊要求';\n        $auditNote=trim((string)($row['audit_note']??''));if($auditNote==='')$auditNote='请查看订单详情';\n        $expectedVisit=trim((string)($row['expected_visit_at']??''));if($expectedVisit==='')$expectedVisit=(string)($parameters['time']??date('Y-m-d H:i'));\n        $appointmentTime=trim((string)($appointment['appointment_at']??''));if($appointmentTime==='')$appointmentTime=$expectedVisit;\n        $appointmentNote=trim((string)($appointment['note']??''));\n        if($appointmentNote==='')$appointmentNote=!empty($appointment['wait_customer_notice'])?'等待客户另行通知':'请查看订单详情';\n        $quoteParty=$eventType==='platform_quoted'?$platformName:($workerName==='待安排师傅'?'师傅报价':$workerName);\n        return [\n            'order_no'=>(string)($parameters['order_no']??($row['public_no']??'')),\n            'status'=>(string)($definition['status']??($parameters['status']??'')),\n            'time'=>(string)($parameters['time']??date('Y-m-d H:i')),\n            'amount'=>(string)($parameters['amount']??'0.00').'元',\n            'quote_party'=>$quoteParty,\n            'platform_name'=>$platformName,\n            'merchant_name'=>$merchantName,\n            'worker_name'=>$workerName,\n            'service_category'=>$serviceCategory,\n            'order_title'=>$orderTitle,\n            'service_address'=>$address,\n            'requirement_note'=>$requirement,\n            'audit_note'=>$auditNote,\n            'expected_visit_time'=>$expectedVisit,\n            'contact_name'=>trim((string)($row['contact_name_masked']??''))?:'订单联系人',\n            'appointment_time'=>$appointmentTime,\n            'appointment_note'=>$appointmentNote,\n        ];\n    }\n\n    public static function queueOrderSubscription(Database $db, int $orderId, string $eventKey, string $eventType, array $definition, array $order, array $parameters, array $smsFallback=[], string $sceneOverride=''): array\n    {\n        $sceneKey=$sceneOverride!==''?$sceneOverride:self::subscriptionSceneForEvent($eventType);if($sceneKey==='')return ['queued'=>false,'reason'=>'scene_missing'];\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes[$sceneKey]??null;\n        if(!$scene)return ['queued'=>false,'reason'=>'scene_missing'];\n        if(empty($scene['available'])||empty($scene['field_map']))return ['queued'=>false,'reason'=>(string)($scene['availability_reason']??'scene_unavailable')];\n        $recipient=(string)($scene['recipient']??'user');\n        if(!in_array($recipient,(array)($definition['recipients']??[]),true))return ['queued'=>false,'reason'=>'recipient_mismatch'];\n        $workerProfile=null;\n        if($recipient==='worker'){\n            if(empty($order['assigned_worker_id']))return ['queued'=>false,'reason'=>'worker_missing'];\n            $workerProfile=$db->fetch('SELECT user_id FROM worker_profiles WHERE id=:id LIMIT 1',['id'=>(int)$order['assigned_worker_id']]);\n            if(!$workerProfile)return ['queued'=>false,'reason'=>'worker_missing'];\n        }\n        $userId=$recipient==='worker'?(int)$workerProfile['user_id']:(int)$order['user_id'];\n        $pref=SubscriptionQuotaStore::subscriptionPreferences($db,$userId)[$sceneKey]??[];\n        $authorizationStatus=(string)($pref['authorization_status']??'');\n        $subscriptionType=(string)($scene['subscription_type']??'one_time');\n        if($subscriptionType==='one_time'){\n            if(in_array($authorizationStatus,['ban','disabled'],true))return ['queued'=>false,'reason'=>$authorizationStatus];\n            if(max(0,(int)($pref['remaining_count']??0))<1)return ['queued'=>false,'reason'=>'count_exhausted'];\n        }else{\n            if(empty($pref['enabled'])||!in_array($authorizationStatus,['accept','acceptWithAudio','acceptWithAlert'],true))return ['queued'=>false,'reason'=>'not_authorized'];\n        }\n        $openid=(string)$db->fetchValue(\"SELECT openid FROM wechat_identities WHERE user_id=:id AND status='active' ORDER BY id DESC LIMIT 1\",['id'=>$userId]);\n        if($openid==='')return ['queued'=>false,'reason'=>'openid_missing'];\n        $values=self::subscriptionBusinessValues($db,$orderId,$eventType,$definition,$parameters);\n        $data=[];\n        foreach((array)$scene['field_map'] as $semantic=>$wechatKey){\n            $wechatKey=trim((string)$wechatKey);\n            if(!isset($values[$semantic])||preg_match('/^[A-Za-z_]+\\d+$/',$wechatKey)!==1)continue;\n            $formatted=WechatTemplateValue::format($wechatKey,(string)$values[$semantic]);\n            if($formatted===null||$formatted==='')return ['queued'=>false,'reason'=>'template_data_invalid'];\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $wechatKey=>$fixedValue){\n            $wechatKey=trim((string)$wechatKey);$fixedValue=trim((string)$fixedValue);\n            if($wechatKey===''||$fixedValue===''||isset($data[$wechatKey]))continue;\n            $formatted=WechatTemplateValue::format($wechatKey,$fixedValue);\n            if($formatted===null||$formatted==='')return ['queued'=>false,'reason'=>'template_data_invalid'];\n            $data[$wechatKey]=['value'=>$formatted];\n        }\n        foreach((array)($scene['template_fields']??[]) as $templateField)if(!isset($data[$templateField]))return ['queued'=>false,'reason'=>'template_data_missing'];\n        if(!$data)return ['queued'=>false,'reason'=>'template_data_missing'];\n        $page=$recipient==='worker'?'pages/workerOrder/detail?id=':'pages/userOrder/detail?id=';\n        self::enqueueWechatSubscribe($db,$eventKey.':'.$recipient.':wxsub',$userId,$sceneKey,$openid,(string)$scene['template_id'],$page.rawurlencode((string)$order['public_no']),$data,$smsFallback);\n        return ['queued'=>true,'reason'=>'queued'];\n    }\n\n    public static function queueWorkerOrderUpdateSupplement(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,bool $fallbackMode=false):void\n    {\n        if(!in_array('worker',(array)($definition['recipients']??[]),true)||empty($order['assigned_worker_id']))return;\n        $primaryKey=self::subscriptionSceneForEvent($eventType);\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();\n        $primary=$primaryKey!==''?($scenes[$primaryKey]??null):null;\n        if(is_array($primary)&&(string)($primary['recipient']??'user')==='worker')return;\n        $meta=MessageEventCatalog::get($eventType)??[];\n        $important=((string)($meta['priority']??'normal')==='important')||$eventType==='worker_assigned';\n        if(!$important)return;\n        $workerFallback=$fallbackMode\n            ? self::buildSubscriptionFallbackSmsPayload($db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,'worker')\n            : null;\n        $result=self::queueOrderSubscription(\n            $db,$orderId,$eventKey,$eventType,$definition,$order,$parameters,\n            is_array($workerFallback)?$workerFallback:[],\n            'worker_order_update'\n        );\n        if($fallbackMode&&empty($result['queued'])&&is_array($workerFallback)){\n            $workerFallback['fallback_reason']=(string)($result['reason']??'worker_subscription_unavailable');\n            self::enqueueSmsFallback($db,$workerFallback);\n        }\n    }\n\n    public static function subscriptionSceneForEvent(string $eventType): string\n    {\n        $meta = MessageEventCatalog::get($eventType);\n        return $meta ? (string)($meta['subscription_scene'] ?? '') : '';\n    }\n\n    public static function enqueueWechatSubscribe(Database $db,string $businessKey,int $userId,string $sceneKey,string $openid,string $templateId,string $page,array $data,array $smsFallback=[]):void\n    {\n        $payload=['user_id'=>$userId,'scene_key'=>$sceneKey,'openid'=>$openid,'template_id'=>$templateId,'page'=>$page,'data'=>$data];\n        if($smsFallback)$payload['sms_fallback']=$smsFallback;\n        $db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('wechat_subscribe',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['business_key'=>substr($businessKey,0,128),'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES)]);\n    }\n\n    public static function buildSubscriptionFallbackSmsPayload(Database $db,int $orderId,string $eventKey,string $eventType,array $definition,array $order,array $parameters,string $recipientOverride=''):?array\n    {\n        $meta=MessageEventCatalog::get($eventType);\n        if(!$meta||empty($meta['sms_subscription_fallback']))return null;\n        $sceneKey=(string)($meta['subscription_scene']??'');if($sceneKey==='')return null;\n        $scenes=SubscriptionCatalog::subscriptionSceneDefinitions();$scene=$scenes[$sceneKey]??null;if(!$scene)return null;\n        $recipient=in_array($recipientOverride,['user','worker'],true)?$recipientOverride:(string)($scene['recipient']??'user');\n        if(!in_array($recipient,(array)($definition['recipients']??[]),true))return null;\n        $recipientId=0;$mobile='';\n        if($recipient==='user'){\n            $recipientId=(int)$order['user_id'];\n            $mobile=\\decrypt_private_value((string)$order['user_mobile'],'user-mobile');\n        }elseif($recipient==='worker'&&!empty($order['assigned_worker_id'])){\n            $recipientId=(int)$order['assigned_worker_id'];\n            $row=$db->fetch('SELECT mobile_ciphertext FROM worker_profiles WHERE id=:id LIMIT 1',['id'=>$recipientId]);\n            $mobile=$row?\\decrypt_private_value((string)$row['mobile_ciphertext'],'worker-mobile'):'';\n        }\n        if($recipientId<1||$mobile==='')return null;\n        return [\n            'business_key'=>substr($eventKey.':'.$recipient.':'.$recipientId.':sms-fallback',0,128),\n            'mobile'=>$mobile,\n            'sms_scene'=>(string)$definition['scene'],\n            'parameters'=>$parameters,\n            'event_type'=>$eventType,\n            'order_id'=>$orderId,\n            'recipient_type'=>$recipient,\n            'recipient_id'=>$recipientId,\n            'delivery_mode'=>'subscription_fallback',\n        ];\n    }\n\n    public static function enqueueSmsFallback(Database $db,array $fallback):bool\n    {\n        $eventType=trim((string)($fallback['event_type']??''));\n        if($eventType===''||!\\filter_var(\\setting('sms.enabled',false),FILTER_VALIDATE_BOOLEAN)||!self::eventEnabled('sms.event_switches',$eventType))return false;\n        $meta=MessageEventCatalog::get($eventType);\n        if(!$meta||empty($meta['sms_subscription_fallback']))return false;\n        $smsScene=trim((string)($fallback['sms_scene']??''));if($smsScene==='')return false;\n        $templates=\\setting('sms.template_codes',[]);if(!is_array($templates))return false;\n        $configured=$templates[$smsScene]??'';\n        $templateCode=is_array($configured)?(string)(($configured['template_code']??'')?:($configured['template_id']??'')?:($configured['code']??'')):(string)$configured;\n        $mobile=trim((string)($fallback['mobile']??''));\n        $businessKey=trim((string)($fallback['business_key']??''));\n        if($templateCode===''||$mobile===''||$businessKey==='')return false;\n        $payload=[\n            'mobile'=>$mobile,\n            'template_code'=>$templateCode,\n            'parameters'=>is_array($fallback['parameters']??null)?$fallback['parameters']:[],\n            'event_type'=>$eventType,\n            'order_id'=>(int)($fallback['order_id']??0),\n            'recipient_type'=>(string)($fallback['recipient_type']??'user'),\n            'recipient_id'=>(int)($fallback['recipient_id']??0),\n            'delivery_mode'=>'subscription_fallback',\n            'fallback_reason'=>(string)($fallback['fallback_reason']??'wechat_unavailable'),\n        ];\n        $businessKey=substr($businessKey,0,128);\n        $affected=$db->execute(\"INSERT IGNORE INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('aliyun_sms',:business_key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",[\n            'business_key'=>$businessKey,\n            'payload'=>json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES),\n        ]);\n        if($affected===1)return true;\n        return (bool)$db->fetchValue(\"SELECT id FROM message_outbox WHERE topic='aliyun_sms' AND BINARY business_key=BINARY :business_key LIMIT 1\",['business_key'=>$businessKey]);\n    }\n\n    public static function eventEnabled(string $settingKey, string $eventType): bool\n    {\n        $channel = strpos($settingKey, 'wecom.') === 0 ? 'wecom' : (strpos($settingKey, 'notification.') === 0 ? 'inapp' : 'sms');\n        $configured = \\setting($settingKey, []);\n        return MessageEventCatalog::enabled($channel, $eventType, is_array($configured) ? $configured : []);\n    }\n}\n","server/app/Infrastructure/Settings/GlobalSettingsProvider.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Settings;\n\nuse WorkerAdmin\\Contracts\\SettingsProvider;\n\n/**\n * 兼容现有 setting() 的基础设施适配器。\n */\nfinal class GlobalSettingsProvider implements SettingsProvider\n{\n    public function get(string $key, $default = null)\n    {\n        return \\setting($key, $default);\n    }\n\n    public function bool(string $key, bool $default = false): bool\n    {\n        $value = $this->get($key, $default);\n        if (is_bool($value)) {\n            return $value;\n        }\n        $filtered = filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE);\n        return $filtered === null ? $default : $filtered;\n    }\n\n    public function int(string $key, int $default = 0): int\n    {\n        $value = $this->get($key, $default);\n        return is_numeric($value) ? (int) $value : $default;\n    }\n}\n","server/app/Infrastructure/Persistence/PlatformOrderSettlementWriter.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Order\\PlatformOrderSettlementPolicy;\n\n/**\n * 平台单验收的资金侧事务步骤。调用者必须已锁定 orders、order_platform_terms、assignments，\n * 并处于同一个事务；本类不单独提交事务、不生成虚假的客户支付记录。\n * 普通客户订单（包括后台代下单）不调用该类，也绝不创建普通订单服务费。\n */\nfinal class PlatformOrderSettlementWriter\n{\n    private PlatformOrderSettlementPolicy $policy;\n    private PlatformOrderBookingPaymentVerifier $bookingVerifier;\n\n    public function __construct()\n    {\n        $this->policy = new PlatformOrderSettlementPolicy();\n        $this->bookingVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    /**\n     * @param array<string,mixed> $order\n     * @param array<string,mixed> $terms\n     * @param array<string,mixed> $assignment\n     * @return array<string,int|string>\n     */\n    public function apply(Database $db, array $order, array $terms, array $assignment): array\n    {\n        $orderId = (int)($order['id'] ?? 0);\n        $workerId = (int)($order['assigned_worker_id'] ?? 0);\n        if ($orderId < 1 || (string)($order['order_source_type'] ?? '') !== 'platform'\n            || (int)($terms['order_id'] ?? 0) !== $orderId\n            || (string)($terms['customer_flow_mode'] ?? '') !== 'platform_managed'\n            || (int)($assignment['worker_id'] ?? 0) !== $workerId\n            || $workerId < 1\n            || (string)($assignment['status'] ?? '') !== 'accepted'\n            || (string)($terms['settlement_status'] ?? '') !== 'pending') {\n            throw new OrderOperationException('平台单结算关系或状态已变化，请刷新后重试', 'PLATFORM_SETTLEMENT_STATE_CHANGED', 409);\n        }\n        // 师傅现场收款凭证是客户向师傅付款的证据，不等同于师傅已向平台付清收入款。\n        $receiptCount = (int)$db->fetchValue(\n            \"SELECT COUNT(*) FROM media_links ml JOIN media_files mf ON mf.id=ml.media_file_id AND mf.status='active'\n             WHERE ml.entity_type='order' AND ml.entity_id=:order_id AND ml.purpose='collection_receipt'\",\n            ['order_id'=>$orderId]\n        );\n        if ($receiptCount < 1) {\n            throw new OrderOperationException('师傅尚未上传客户现场收款凭证，当前不能验收', 'COLLECTION_RECEIPT_REQUIRED', 409);\n        }\n\n        // booking_paid_cents 对平台单表示“外部渠道已实际收取的客户预付款”。\n        // orders.booking_fee_cents 属于普通订单微信预约费口径，平台单不得再读取或抵扣它。\n        $bookingPaid = $this->bookingVerifier->verifiedPaidCents(\n            $db,\n            $orderId,\n            (int)$terms['customer_contract_total_cents'],\n            (int)($terms['booking_paid_cents'] ?? 0),\n            'platform_managed'\n        );\n        $calculation = $this->policy->settlement(\n            (int)$terms['customer_contract_total_cents'],\n            (int)$terms['worker_labor_cents'],\n            $bookingPaid,\n            (string)$terms['worker_settlement_mode']\n        );\n        $platformReceivable = (int)$calculation['platform_receivable_cents'];\n        $workerCredit = (int)$calculation['worker_balance_credit_cents'];\n        $freezeDays = max(0, (int)$terms['worker_balance_freeze_days_snapshot']);\n        $status = $platformReceivable > 0 ? 'awaiting_platform_income' : 'settled';\n\n        $changed = $db->execute(\n            \"UPDATE order_platform_terms SET booking_paid_cents=:booking,customer_tail_cents=:tail,\n                    platform_receivable_cents=:platform_income,worker_balance_credit_cents=:worker_credit,\n                    settlement_status=:status,settled_at=IF(:settled_status='settled',UTC_TIMESTAMP(),NULL),updated_at=UTC_TIMESTAMP()\n             WHERE order_id=:order_id AND settlement_status='pending' AND customer_flow_mode='platform_managed'\",\n            [\n                'booking'=>$calculation['booking_paid_cents'],\n                'tail'=>$calculation['customer_tail_cents'],\n                'platform_income'=>$platformReceivable,'worker_credit'=>$workerCredit,\n                'status'=>$status,'settled_status'=>$status,'order_id'=>$orderId,\n            ]\n        );\n        if ($changed !== 1) {\n            throw new OrderOperationException('平台结算已被处理，请刷新后重试', 'PLATFORM_SETTLEMENT_ALREADY_POSTED', 409);\n        }\n        $assignmentChanged = $db->execute(\n            \"UPDATE assignments SET status='completed',\n                    estimated_commission_cents=0,estimated_net_income_cents=:labor,updated_at=UTC_TIMESTAMP()\n             WHERE id=:id AND worker_id=:worker_id AND status='accepted'\",\n            ['labor'=>$terms['worker_labor_cents'],'id'=>$assignment['id'],'worker_id'=>$workerId]\n        );\n        if ($assignmentChanged !== 1) {\n            throw new OrderOperationException('成交师傅关系已变化，请刷新后重试', 'PLATFORM_ASSIGNMENT_CHANGED', 409);\n        }\n        if ($workerCredit > 0) {\n            $entry = $this->policy->workerBalanceEntry($workerCredit, $freezeDays);\n            $idempotencyKey = 'platform-order:'.$orderId.':worker-income';\n            $existing = $db->fetch(\n                'SELECT id FROM worker_balance_ledger WHERE idempotency_key=:key LIMIT 1 FOR UPDATE',\n                ['key'=>$idempotencyKey]\n            );\n            if ($existing) {\n                throw new OrderOperationException('师傅工费入账记录已存在，请先核对，禁止重复入账', 'PLATFORM_WORKER_CREDIT_ALREADY_POSTED', 409);\n            }\n            $inserted = $db->execute(\n                \"INSERT INTO worker_balance_ledger(worker_id,entry_type,direction,amount_cents,available_delta_cents,frozen_delta_cents,\n                        business_type,business_id,idempotency_key,description,status,created_at)\n                 VALUES(:worker_id,:entry_type,'credit',:amount,:available,:frozen,'platform_order',:business_id,:key,:description,'effective',UTC_TIMESTAMP())\",\n                [\n                    'worker_id'=>$workerId,'entry_type'=>$entry['entry_type'],'amount'=>$workerCredit,\n                    'available'=>$entry['available_delta_cents'],'frozen'=>$entry['frozen_delta_cents'],\n                    'business_id'=>$orderId,'key'=>$idempotencyKey,\n                    'description'=>$freezeDays === 0 ? '平台承接单工费结算进入可提现余额' : '平台承接单工费进入冻结余额',\n                ]\n            );\n            if ($inserted !== 1) {\n                throw new OrderOperationException('师傅余额入账失败，验收已自动回滚', 'PLATFORM_WORKER_CREDIT_FAILED', 409);\n            }\n        }\n        return $calculation + [\n            'settlement_status'=>$status,\n            'worker_settlement_mode'=>(string)$terms['worker_settlement_mode'],\n            'freeze_days'=>$freezeDays,\n        ];\n    }\n}","server/app/Infrastructure/Scheduling/PlatformOrderAutoPublishTask.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Scheduling;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\OrderFormMediaRules;\nuse WorkerAdmin\\Infrastructure\\Persistence\\PlatformOrderBookingPaymentVerifier;\n\n/** V2.5.0 平台承接单自动发布。 */\nfinal class PlatformOrderAutoPublishTask\n{\n    private const JOB = 'platform_auto_publish';\n\n    private Database $db;\n    private int $limit;\n    private PlatformOrderBookingPaymentVerifier $prepaymentVerifier;\n\n    public function __construct(Database $db, int $limit = 100)\n    {\n        $this->db = $db;\n        $this->limit = max(1, min(500, $limit));\n        $this->prepaymentVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    public function run(): array\n    {\n        $runUuid = $this->uuidV4();\n        $runId = $this->db->insert(\n            \"INSERT INTO scheduler_runs(run_uuid,job_name,status,host_name,process_id,scanned_count,success_count,failure_count,started_at)\n             VALUES(:uuid,:job,'running',:host,:pid,0,0,0,UTC_TIMESTAMP())\",\n            ['uuid'=>$runUuid,'job'=>self::JOB,'host'=>substr((string)gethostname(),0,128),'pid'=>function_exists('getmypid')?(int)getmypid():null]\n        );\n        $startedAt = microtime(true);\n        $stats = ['scanned'=>0,'success'=>0,'failure'=>0];\n        $error = null;\n\n        try {\n            $cursorUpdatedAt = null;\n            $cursorId = 0;\n            do {\n                $cursorSql = '';\n                $params = [];\n                if ($cursorUpdatedAt !== null) {\n                    $cursorSql = ' AND (o.updated_at>:cursor_updated OR (o.updated_at=:cursor_updated_eq AND o.id>:cursor_id))';\n                    $params = ['cursor_updated'=>$cursorUpdatedAt,'cursor_updated_eq'=>$cursorUpdatedAt,'cursor_id'=>$cursorId];\n                }\n                $rows = $this->db->fetchAll(\n                    \"SELECT o.id,o.version,o.updated_at\n                     FROM orders o\n                     INNER JOIN order_platform_terms t ON t.order_id=o.id\n                     WHERE o.order_source_type='platform'\n                       AND t.customer_flow_mode='platform_managed'\n                       AND t.settlement_status='pending'\n                       AND t.customer_contract_total_cents>0\n                       AND t.booking_paid_cents<=t.customer_contract_total_cents\n                       AND o.booking_fee_cents=0\n                       AND COALESCE(o.is_demo,0)=0\n                       AND o.lifecycle_status='active'\n                       AND o.publish_status<>'published'\n                       AND o.audit_status IN ('pending','approved')\n                       AND COALESCE(o.refund_status,'none') IN ('','none')\n                       AND o.selected_quote_id IS NULL\n                       AND o.assigned_worker_id IS NULL\n                       AND o.current_assignment_id IS NULL\n                       AND o.quote_status IN ('waiting','quoting','collecting')\n                       AND NOT EXISTS(\n                           SELECT 1 FROM payment_orders p\n                           WHERE p.order_id=o.id AND p.business_type IN ('order_booking','booking_fee') AND p.status='paid'\n                       )\n                       AND NOT EXISTS(\n                           SELECT 1 FROM scheduled_job_failures f\n                           WHERE f.job_name='platform_auto_publish'\n                             AND f.business_key=CONCAT('order:',o.id)\n                             AND f.business_version=o.version\n                             AND f.resolved_at IS NULL\n                             AND f.next_retry_at>UTC_TIMESTAMP()\n                       )\n                       {$cursorSql}\n                     ORDER BY o.updated_at,o.id\n                     LIMIT {$this->limit}\",\n                    $params\n                );\n                if (!$rows) break;\n                $stats['scanned'] += count($rows);\n                foreach ($rows as $row) {\n                    $orderId = (int)$row['id'];\n                    $version = max(1,(int)$row['version']);\n                    try {\n                        if ($this->publishOne($orderId)) $stats['success']++;\n                    } catch (Throwable $exception) {\n                        $stats['failure']++;\n                        $this->recordFailure($runId,$orderId,$version,$exception);\n                    }\n                }\n                $last = $rows[count($rows)-1];\n                $cursorUpdatedAt = (string)$last['updated_at'];\n                $cursorId = (int)$last['id'];\n            } while (count($rows) === $this->limit);\n        } catch (Throwable $exception) {\n            $stats['failure']++;\n            $error = mb_substr($exception->getMessage(),0,4000);\n            $this->recordFailure($runId,0,1,$exception,'task:'.self::JOB);\n        }\n\n        if ($error === null && $stats['failure'] > 0) $error = '本批次有 '.$stats['failure'].' 笔平台承接单自动发布失败，请查看异常工作台。';\n        $status = $stats['failure'] > 0 ? 'failed' : 'success';\n        $this->db->execute(\n            \"UPDATE scheduler_runs SET status=:status,scanned_count=:scanned,success_count=:success,failure_count=:failure,finished_at=UTC_TIMESTAMP(),error_message=:error WHERE id=:id\",\n            ['status'=>$status,'scanned'=>$stats['scanned'],'success'=>$stats['success'],'failure'=>$stats['failure'],'error'=>$error,'id'=>$runId]\n        );\n        if ($status === 'success') {\n            $this->db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP() WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",['job'=>self::JOB,'key'=>'task:'.self::JOB]);\n        }\n        if ($stats['success'] === 0 && $stats['failure'] === 0) {\n            $this->db->execute(\"DELETE FROM scheduler_runs WHERE job_name=:job AND id<>:id AND status='success' AND success_count=0 AND failure_count=0\",['job'=>self::JOB,'id'=>$runId]);\n        }\n\n        return ['run_id'=>$runId,'run_uuid'=>$runUuid,'task'=>self::JOB,'status'=>$status,'scanned'=>$stats['scanned'],'success'=>$stats['success'],'failure'=>$stats['failure'],'duration_ms'=>(int)round((microtime(true)-$startedAt)*1000),'error'=>$error];\n    }\n\n    /**\n     * 管理员恢复入口只重检这一张订单，复用自动发布的完整锁内校验，不运行整批 scheduler。\n     * 已经发布视为幂等成功；当前业务条件不满足时只返回 not_ready，不伪造状态。\n     * @return array{ok:bool,status:string,message:string}\n     */\n    public function retryOrder(int $orderId): array\n    {\n        $order = $this->db->fetch('SELECT id,publish_status FROM orders WHERE id=:id LIMIT 1', ['id'=>$orderId]);\n        if (!$order) return ['ok'=>false,'status'=>'not_found','message'=>'订单不存在'];\n        if ((string)$order['publish_status'] === 'published') {\n            $this->db->execute(\n                \"UPDATE scheduled_job_failures SET resolved_at=COALESCE(resolved_at,UTC_TIMESTAMP())\n                 WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",\n                ['job'=>self::JOB,'key'=>'order:'.$orderId]\n            );\n            return ['ok'=>true,'status'=>'already_published','message'=>'订单已经发布，无需重复处理'];\n        }\n        try {\n            $published = $this->publishOne($orderId);\n        } catch (Throwable $exception) {\n            return ['ok'=>false,'status'=>'failed','message'=>mb_substr($exception->getMessage(),0,500)];\n        }\n        if (!$published) return ['ok'=>false,'status'=>'not_ready','message'=>'订单当前条件仍不满足自动发布，请按最新状态处理'];\n        return ['ok'=>true,'status'=>'published','message'=>'重新检查通过，订单已发布'];\n    }\n\n    private function publishOne(int $orderId): bool\n    {\n        return $this->db->transaction(function (Database $db) use ($orderId): bool {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents,t.settlement_status\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order\n                || (int)($order['is_demo']??0)!==0\n                || (string)$order['customer_flow_mode']!=='platform_managed'\n                || (string)$order['settlement_status']!=='pending'\n                || (int)$order['booking_fee_cents']!==0\n                || (int)$order['customer_contract_total_cents']<=0\n                || (int)$order['booking_paid_cents']>(int)$order['customer_contract_total_cents']\n                || (string)$order['lifecycle_status']!=='active'\n                || (string)$order['publish_status']==='published'\n                || !in_array((string)$order['audit_status'],['pending','approved'],true)\n                || !in_array((string)($order['refund_status']??'none'),['','none'],true)\n                || !empty($order['selected_quote_id'])\n                || !empty($order['assigned_worker_id'])\n                || !empty($order['current_assignment_id'])\n                || !in_array((string)$order['quote_status'],['waiting','quoting','collecting'],true)\n                || $this->hasBlockingBusiness($db,$orderId)) return false;\n            if ($order['lat']===null || $order['lng']===null) throw new RuntimeException('平台承接单缺少地图坐标，系统已停止自动发布，请补充地址后处理');\n            $mediaReadiness = OrderFormMediaRules::readiness($db,$orderId,(int)($order['form_schema_version_id']??0),(string)($order['workflow_profile']??'construction'));\n            if (empty($mediaReadiness['ready'])) return false;\n\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            $quoteDays = max(1,min(30,(int)\\setting('order.auto_cancel_days',7)));\n            $version = max(1,(int)$order['version']);\n            $changed = $db->execute(\n                \"UPDATE orders SET audit_status='approved',publish_status='published',quote_status='waiting',audited_at=COALESCE(audited_at,UTC_TIMESTAMP()),published_at=COALESCE(published_at,UTC_TIMESTAMP()),quote_deadline_at=COALESCE(quote_deadline_at,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$quoteDays} DAY)),audit_note='平台托管条件核验通过后系统自动发布',updated_at=UTC_TIMESTAMP(),version=version+1 WHERE id=:id AND order_source_type='platform' AND booking_fee_cents=0 AND lifecycle_status='active' AND publish_status<>'published' AND selected_quote_id IS NULL AND assigned_worker_id IS NULL AND current_assignment_id IS NULL\",\n                ['id'=>$orderId]\n            );\n            if ($changed!==1) return false;\n\n            $eventKey='scheduler:'.self::JOB.':order:'.$orderId.':v'.$version;\n            $payload=json_encode(['quote_days'=>$quoteDays,'external_prepayment_cents'=>(int)$order['booking_paid_cents'],'message'=>'平台承接单托管条件与公共下单资料完整，系统自动审核并发布，无需管理员二次确认。'],JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);\n            $db->execute(\"INSERT IGNORE INTO order_events(order_id,event_type,event_key,actor_type,actor_id,payload_json,created_at) VALUES(:order_id,'platform_order_auto_published',:event_key,'system',NULL,:payload,UTC_TIMESTAMP())\",['order_id'=>$orderId,'event_key'=>substr($eventKey,0,128),'payload'=>is_string($payload)?$payload:'{}']);\n            $db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP() WHERE job_name=:job AND business_key=:key AND resolved_at IS NULL\",['job'=>self::JOB,'key'=>'order:'.$orderId]);\n            return true;\n        });\n    }\n\n    private function hasBlockingBusiness(Database $db, int $orderId): bool\n    {\n        return (int)$db->fetchValue(\n            \"SELECT (EXISTS(SELECT 1 FROM disputes WHERE order_id=:id1 AND status IN ('open','pending','processing')) OR EXISTS(SELECT 1 FROM refunds WHERE order_id=:id2 AND status NOT IN ('failed','closed','cancelled','rejected')) OR EXISTS(SELECT 1 FROM order_cancel_requests WHERE order_id=:id3 AND status IN ('pending','processing')) OR EXISTS(SELECT 1 FROM change_requests WHERE order_id=:id4 AND status IN ('pending','processing','negotiating')) OR EXISTS(SELECT 1 FROM after_sales WHERE order_id=:id5 AND status IN ('open','processing'))) AS blocked\",\n            ['id1'=>$orderId,'id2'=>$orderId,'id3'=>$orderId,'id4'=>$orderId,'id5'=>$orderId]\n        )===1;\n    }\n\n    private function recordFailure(int $runId, int $orderId, int $version, Throwable $exception, ?string $businessKey=null): void\n    {\n        try {\n            $key=$businessKey??('order:'.$orderId);\n            $attempt=(int)$this->db->fetchValue(\"SELECT COALESCE(MAX(attempt_no),0)+1 FROM scheduled_job_failures WHERE job_name=:job AND business_key=:key AND business_version=:version\",['job'=>self::JOB,'key'=>$key,'version'=>max(1,$version)]);\n            $attempt=max(1,$attempt);\n            $minutes=min(1440,max(1,1<<min(10,max(0,$attempt-1))));\n            $this->db->execute(\n                \"INSERT INTO scheduled_job_failures(job_name,business_key,business_version,scheduler_run_id,attempt_no,error_class,error_message,next_retry_at,created_at) VALUES(:job,:key,:version,:run_id,:attempt,:error_class,:error_message,DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$minutes} MINUTE),UTC_TIMESTAMP())\",\n                ['job'=>self::JOB,'key'=>substr($key,0,128),'version'=>max(1,$version),'run_id'=>$runId,'attempt'=>$attempt,'error_class'=>substr(get_class($exception),0,160),'error_message'=>mb_substr($exception->getMessage(),0,2000)]\n            );\n        } catch (Throwable $ignored) {}\n    }\n\n    private function uuidV4(): string\n    {\n        $data=random_bytes(16);\n        $data[6]=chr((ord($data[6])&0x0f)|0x40);\n        $data[8]=chr((ord($data[8])&0x3f)|0x80);\n        return vsprintf('%s%s-%s-%s-%s-%s%s%s',str_split(bin2hex($data),4));\n    }\n}\n","server/app/Infrastructure/Messaging/OrderSubscriptionDefinitionOperations.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\n\nuse WorkerAdmin\\Core\\Database;\n\n/** Subscription metadata / mapping extracted from the frozen notification facade. */\ntrait OrderSubscriptionDefinitionOperations\n{\n    public static function subscriptionSceneDefinitions(): array\n    {\n        $scenes = [\n            'reviewResult' => ['title'=>'入驻审核结果通知','description'=>'师傅入驻审核完成后通知','template_id'=>'b7RKsUBxQu3BWwMEwzw-oFHkw1K9m4egjVFSLQ5rWMY','field_map'=>[],'field_semantics'=>[],'keywords'=>['师傅姓名','手机号','审核结果','说明'],'recipient'=>'worker'],\n            'order_audit' => ['title'=>'订单审核通知','description'=>'订单通过、补资料或审核未通过时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time','audit_note'],'keywords'=>['订单编号','审核结果','处理时间','审核说明']],\n            'quote_received' => ['title'=>'收到报价通知','description'=>'订单收到新的师傅或平台报价时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','amount','quote_party','time'],'keywords'=>['订单编号','报价金额','报价方','报价时间']],\n            'payment_success' => ['title'=>'预约费支付成功','description'=>'微信支付已有结果反馈，通常保留内部通知即可','template_id'=>'','field_map'=>[],'field_semantics'=>['amount','time','platform_name','order_no'],'keywords'=>['支付金额','付款时间','平台名称','订单编号'],'recommended'=>false],\n            'worker_assigned' => ['title'=>'师傅接单通知','description'=>'安排师傅或师傅确认接单时通知','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','worker_name','requirement_note'],'keywords'=>['订单编号','师傅姓名','需求说明']],\n            'completion_submitted' => ['title'=>'完工待验收通知','description'=>'师傅提交完工后提醒用户验收','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','time','service_category'],'keywords'=>['订单编号','完工时间','服务类目']],\n            'refund_result' => ['title'=>'退款结果通知','description'=>'取消退款审核及退款结果','template_id'=>'','field_map'=>[],'field_semantics'=>['amount','status','order_no','time'],'keywords'=>['退款金额','退款状态','订单编号','处理时间']],\n            'payment_pending'=>['title'=>'待付款提醒','description'=>'报价确认或测量加费待付款','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','待办事项','时间']],\n            'fee_adjustment'=>['title'=>'费用调整待确认','description'=>'师傅申请调整费用，待用户确认','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','调整状态','时间']],\n            'supplement_reminder'=>['title'=>'补资料临期提醒','description'=>'订单补充资料的处理期限提醒','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理状态','提醒时间']],\n            'measurement_result'=>['title'=>'测量成果待确认','description'=>'测量师傅提交成果，待用户验收','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','成果状态','提交时间']],\n            'measurement_extension'=>['title'=>'测量冻结延期结果','description'=>'用户申请延长冻结期的审核结果','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理结果','时间']],\n            'repair_progress'=>['title'=>'维修进度提醒','description'=>'师傅拒绝、已预约或可申请平台介入','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','维修进度','时间']],\n            'dispute_progress'=>['title'=>'争议处理通知','description'=>'争议处理完成或关键结果更新时通知用户','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','处理状态','时间']],\n            'user_order_update'=>['title'=>'订单重要进度通知','description'=>'派单异常、平台取消、电话公开、跑空费等需要用户及时知道的重要订单变化','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','订单状态','更新时间'],'recipient'=>'user'],\n            'worker_order_update'=>['title'=>'师傅订单重要进度','description'=>'安排接单、退款/取消、费用处理或争议等需要师傅及时知道的订单变化','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','订单状态','更新时间'],'recipient'=>'worker'],\n            'worker_repair'=>['title'=>'新维修工单','description'=>'提醒师傅及时联系用户处理售后','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','维修任务','时间'],'recipient'=>'worker'],\n            'worker_rework'=>['title'=>'测量成果需补测','description'=>'用户要求师傅重新提交测量成果','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','status','time'],'keywords'=>['订单号','补测状态','时间'],'recipient'=>'worker'],\n            'worker_commission_due'=>['title'=>'平台服务费待缴','description'=>'服务费账单生成，提醒师傅处理','template_id'=>'','field_map'=>[],'field_semantics'=>['order_no','amount','time'],'keywords'=>['订单号','费用金额','生成时间'],'recipient'=>'worker'],\n        ];\n        // V2.4.1：一次性订阅改为“剩余可发送次数”；长期订阅仅在微信公众平台真实模板具备长期资格时使用。\n        // important 仅用于小程序端“重要通知一键续收”，不改变后台事件优先级、短信分类或发送顺序。\n        $importantScenes = [\n            // 入驻审核 reviewResult 有独立提交埋点，不参与日常“一键续收”，避免审核完成后长期占用批量名额。\n            'order_audit','quote_received','worker_assigned','completion_submitted','refund_result',\n            'payment_pending','fee_adjustment','supplement_reminder','measurement_result','measurement_extension','repair_progress','dispute_progress',\n            'user_order_update','worker_order_update','worker_repair','worker_rework','worker_commission_due',\n        ];\n        foreach ($scenes as $sceneKey => &$scene) {\n            $scene['subscription_type'] = 'one_time';\n            $scene['template_title'] = '';\n            $scene['template_fields'] = [];\n            $scene['synced_template_id'] = '';\n            $scene['important'] = in_array($sceneKey, $importantScenes, true);\n        }\n        unset($scene);\n        $configured = \\setting('wechat.subscribe_template_ids', []);\n        if (is_array($configured)) {\n            foreach ($configured as $key => $row) {\n                if (!isset($scenes[$key])) continue;\n                if (is_string($row)) $scenes[$key]['template_id'] = trim($row);\n                elseif (is_array($row)) {\n                    $scenes[$key]['template_id'] = trim((string) ($row['template_id'] ?? $row['id'] ?? $scenes[$key]['template_id']));\n                    $scenes[$key]['template_title'] = mb_substr(trim((string)($row['template_title'] ?? '')),0,80);\n                    $scenes[$key]['synced_template_id'] = trim((string)($row['synced_template_id'] ?? ''));\n                    $scenes[$key]['template_fields'] = ($scenes[$key]['synced_template_id']!==''&&hash_equals($scenes[$key]['template_id'],$scenes[$key]['synced_template_id'])&&is_array($row['template_fields'] ?? null)) ? array_values(array_filter(array_map('strval',$row['template_fields']))) : [];\n                    $scenes[$key]['template_field_labels'] = is_array($row['template_field_labels'] ?? null) ? $row['template_field_labels'] : [];\n                    $fieldMap = is_array($row['field_map'] ?? null) ? $row['field_map'] : [];\n                    // 2.5.0：旧字段名在读取时无损迁移为明确语义；审核备注与订单需求必须按场景分开。\n                    if(isset($fieldMap['service_name'])&&!isset($fieldMap['service_category'])){$fieldMap['service_category']=$fieldMap['service_name'];unset($fieldMap['service_name']);}\n                    if(isset($fieldMap['remark'])){\n                        if($key==='order_audit'&&!isset($fieldMap['audit_note']))$fieldMap['audit_note']=$fieldMap['remark'];\n                        elseif(!isset($fieldMap['requirement_note']))$fieldMap['requirement_note']=$fieldMap['remark'];\n                        unset($fieldMap['remark']);\n                    }\n                    // 旧 payment_success 的 merchant_name 实际发送的是“壁选”，本质是平台名称，不是订单商家。\n                    if($key==='payment_success'&&isset($fieldMap['merchant_name'])&&!isset($fieldMap['platform_name'])){$fieldMap['platform_name']=$fieldMap['merchant_name'];unset($fieldMap['merchant_name']);}\n                    $scenes[$key]['field_map'] = $fieldMap;\n                    $scenes[$key]['field_defaults'] = is_array($row['field_defaults'] ?? null) ? $row['field_defaults'] : [];\n                    $subscriptionType = trim((string) ($row['subscription_type'] ?? 'one_time'));\n                    if (in_array($subscriptionType, ['one_time','long_term'], true)) $scenes[$key]['subscription_type'] = $subscriptionType;\n                }\n            }\n        }\n        $global = filter_var(\\setting('wechat.subscribe_enabled', true), FILTER_VALIDATE_BOOLEAN);\n        foreach ($scenes as $key => &$scene) {\n            $scene['key'] = $key;\n            $scene['global_enabled'] = $global;\n            $requiredSemantics = array_values(array_map('strval',(array)($scene['field_semantics']??[])));\n            $knownSemantics = array_fill_keys(array_keys(self::subscriptionSemanticLabels()), true);\n            $fieldMap = is_array($scene['field_map']??null) ? $scene['field_map'] : [];\n            $fieldDefaults = is_array($scene['field_defaults']??null) ? $scene['field_defaults'] : [];\n            $templateFields=is_array($scene['template_fields']??null)?array_values(array_map('strval',$scene['template_fields'])):[];\n            $mapComplete = true; $targets = [];\n            // 当前场景声明的 field_semantics 是“必须来源”，必须全部映射。\n            foreach($requiredSemantics as $semantic){\n                $target=trim((string)($fieldMap[$semantic]??''));\n                if($target===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            // 微信模板可能比业务场景多字段。允许使用系统已知业务字段补齐，但这些不是当前场景的必填语义。\n            foreach($fieldMap as $semantic=>$target){\n                $semantic=(string)$semantic;$target=trim((string)$target);\n                if(in_array($semantic,$requiredSemantics,true))continue;\n                if(!isset($knownSemantics[$semantic])||$target===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            foreach($fieldDefaults as $target=>$fixedValue){\n                $target=trim((string)$target);$fixedValue=trim((string)$fixedValue);\n                if($target===''||$fixedValue===''||preg_match('/^[A-Za-z_]+\\d+$/',$target)!==1||isset($targets[$target])||($templateFields&&!in_array($target,$templateFields,true))){$mapComplete=false;continue;}\n                $targets[$target]=true;\n            }\n            if($templateFields){\n                foreach($templateFields as $templateField)if(!isset($targets[$templateField])){$mapComplete=false;break;}\n            }\n            $needsFieldMap = !empty($requiredSemantics)||!empty($templateFields);\n            // reviewResult 是项目已验证的固定模板，字段由专用发送代码固定生成，不走通用 field_map。\n            if($key==='reviewResult'){\n                $mapComplete=true;\n                if($templateFields){\n                    foreach(self::reviewResultFixedTemplateFields() as $fixedField){\n                        if(!in_array($fixedField,$templateFields,true)){$mapComplete=false;break;}\n                    }\n                }\n            }\n            $scene['configuration_complete'] = $scene['template_id'] !== '' && (!$needsFieldMap||$mapComplete);\n            $scene['available'] = $global && $scene['configuration_complete'];\n            $scene['availability_reason'] = $scene['template_id'] === '' ? 'template_missing' : ($needsFieldMap && !$mapComplete ? ($key==='reviewResult'?'fixed_template_mismatch':'field_map_missing') : ($global ? 'ready' : 'global_disabled'));\n        }\n        unset($scene);\n        return $scenes;\n    }\n\n    public static function subscriptionSemanticLabels(): array\n    {\n        return [\n            'order_no'=>'订单编号',\n            'status'=>'当前状态/处理结果',\n            'time'=>'状态更新时间',\n            'amount'=>'金额',\n            'quote_party'=>'报价方',\n            'platform_name'=>'平台名称',\n            'merchant_name'=>'商家名称',\n            'worker_name'=>'师傅姓名',\n            'service_category'=>'服务类目',\n            'order_title'=>'订单名称',\n            'service_address'=>'施工地址',\n            'requirement_note'=>'需求说明',\n            'audit_note'=>'审核说明',\n            'expected_visit_time'=>'期望上门时间',\n            'contact_name'=>'对接人',\n            'appointment_time'=>'预约时间',\n            'appointment_note'=>'预约说明',\n        ];\n    }\n\n    public static function subscriptionSemanticDescriptions(): array\n    {\n        return [\n            'order_no'=>'订单 public_no',\n            'status'=>'本次真实业务事件的状态文字',\n            'time'=>'本次消息生成时间',\n            'amount'=>'本次事件金额；无专项金额时使用订单成交金额',\n            'quote_party'=>'报价事件对应的师傅或平台',\n            'platform_name'=>'后台基础设置 site.name',\n            'merchant_name'=>'订单关联 merchant_profiles.business_name；普通用户订单显示“个人订单”',\n            'worker_name'=>'订单当前成交/指派师傅姓名',\n            'service_category'=>'orders.category_names_snapshot，等同用户下单选择的服务类目',\n            'order_title'=>'orders.title，订单标题/名称，不等同服务类目',\n            'service_address'=>'订单地址快照 order_addresses.address_summary',\n            'requirement_note'=>'orders.description，用户订单需求说明',\n            'audit_note'=>'orders.audit_note，管理员审核时填写的说明',\n            'expected_visit_time'=>'orders.expected_visit_at，用户下单填写的期望上门时间',\n            'contact_name'=>'订单地址快照中的脱敏对接人姓名',\n            'appointment_time'=>'该订单最近一次施工预约时间',\n            'appointment_note'=>'该订单最近一次施工预约说明',\n        ];\n    }\n\n    public static function reviewResultFixedTemplateFields(): array\n    {\n        return ['name1','phone_number2','phrase3','thing5'];\n    }\n\n    public static function subscriptionFixedValuePresets(string $wechatField,string $label=''): array\n    {\n        $label=trim($label);\n        if(preg_match('/温馨提示|提示|备注|说明/u',$label))return ['请查看小程序详情','请及时处理'];\n        return [];\n    }\n\n    public static function inferSubscriptionTemplateBinding(array $scene,array $actual,array $previous=[]): array\n    {\n        $fields=is_array($actual['fields']??null)?array_values(array_unique(array_filter(array_map('strval',$actual['fields'])))):[];\n        $labels=is_array($actual['field_labels']??null)?$actual['field_labels']:[];\n        $required=array_values(array_map('strval',(array)($scene['field_semantics']??[])));\n        $known=array_keys(self::subscriptionSemanticLabels());\n        // 必填语义优先匹配；模板额外字段可继续匹配系统已知业务字段。\n        $allowed=array_values(array_unique(array_merge($required,$known)));\n        $fieldMap=[];$defaults=[];$used=[];\n        $previousMap=is_array($previous['field_map']??null)?$previous['field_map']:[];\n        // 兼容旧配置后再参与自动识别，避免同步模板时把已经绑好的字段丢掉。\n        if(isset($previousMap['service_name'])&&!isset($previousMap['service_category'])){$previousMap['service_category']=$previousMap['service_name'];unset($previousMap['service_name']);}\n        if(isset($previousMap['remark'])){\n            if((string)($scene['key']??'')==='order_audit'&&!isset($previousMap['audit_note']))$previousMap['audit_note']=$previousMap['remark'];\n            elseif(!isset($previousMap['requirement_note']))$previousMap['requirement_note']=$previousMap['remark'];\n            unset($previousMap['remark']);\n        }\n        if((string)($scene['key']??'')==='payment_success'&&isset($previousMap['merchant_name'])&&!isset($previousMap['platform_name'])){$previousMap['platform_name']=$previousMap['merchant_name'];unset($previousMap['merchant_name']);}\n        $previousDefaults=is_array($previous['field_defaults']??null)?$previous['field_defaults']:[];\n        foreach($previousMap as $semantic=>$field){\n            $semantic=(string)$semantic;$field=trim((string)$field);\n            if(in_array($semantic,$allowed,true)&&in_array($field,$fields,true)&&!isset($used[$field])){$fieldMap[$semantic]=$field;$used[$field]=true;}\n        }\n        foreach($previousDefaults as $field=>$value){\n            $field=trim((string)$field);$value=trim((string)$value);\n            if($value!==''&&in_array($field,$fields,true)&&!isset($used[$field])){$defaults[$field]=$value;$used[$field]=true;}\n        }\n        $aliases=[\n            'order_no'=>['订单编号','订单号','服务单号','工单号','预约单号'],\n            'status'=>['订单状态','审核结果','处理状态','处理结果','退款状态','维修进度','进度','待办事项','调整状态','成果状态','补测状态','维修任务'],\n            'time'=>['处理时间','更新时间','提醒时间','提交时间','生成时间','报价时间','付款时间','完工时间','时间'],\n            'amount'=>['支付金额','退款金额','报价金额','费用金额','金额','费用'],\n            'quote_party'=>['报价方','报价人','报价师傅'],\n            'platform_name'=>['平台名称','服务平台','平台'],\n            'merchant_name'=>['商家名称','商户名称','门店名称','店铺名称','企业名称'],\n            'worker_name'=>['师傅姓名','服务人员','接单人','工作人员'],\n            'service_category'=>['服务类目','服务分类','施工类目','业务类目','类目','服务项目','服务内容'],\n            'order_title'=>['订单名称','订单标题','服务名称','项目名称'],\n            'service_address'=>['施工地址','服务地址','上门地址','安装地址','地址'],\n            'requirement_note'=>['需求说明','订单说明','施工要求','服务要求'],\n            'audit_note'=>['审核说明','审核备注','审核意见','驳回原因','备注','说明'],\n            'expected_visit_time'=>['期望上门时间','期望时间','期望日期','上门时间'],\n            'contact_name'=>['联系人','联系人姓名','对接人','客户姓名'],\n            'appointment_time'=>['预约时间','预约日期','上门预约'],\n            'appointment_note'=>['预约说明','预约备注'],\n        ];\n        // payment_success 的“商家/商户名称”历史上实际表达收款平台；仅该场景将二者优先解释为平台名称。\n        if((string)($scene['key']??'')==='payment_success')$aliases['platform_name']=array_merge(['商家名称','商户名称'],$aliases['platform_name']);\n        $normalize=static function(string $value):string{return mb_strtolower((string)(preg_replace('/[\\s：:（）()\\-—_\\/]+/u','',$value)??$value));};\n        foreach($fields as $field){\n            if(isset($used[$field]))continue;\n            $label=trim((string)($labels[$field]??''));$normalized=$normalize($label);\n            if($normalized==='')continue;\n            $best='';\n            foreach($allowed as $semantic){\n                if(isset($fieldMap[$semantic]))continue;\n                foreach($aliases[$semantic]??[] as $alias){\n                    $a=$normalize($alias);\n                    if($normalized===$a||mb_strpos($normalized,$a)!==false||mb_strpos($a,$normalized)!==false){$best=$semantic;break 2;}\n                }\n            }\n            if($best!==''){$fieldMap[$best]=$field;$used[$field]=true;continue;}\n\n        }\n        $unresolved=[];foreach($fields as $field)if(!isset($used[$field]))$unresolved[]=$field;\n        $missingSemantics=[];foreach($required as $semantic)if(empty($fieldMap[$semantic]))$missingSemantics[]=$semantic;\n        return ['field_map'=>$fieldMap,'field_defaults'=>$defaults,'unresolved_fields'=>$unresolved,'missing_semantics'=>$missingSemantics,'complete'=>!$unresolved&&!$missingSemantics];\n    }\n\n    public static function recommendSubscriptionKeywords(array $scene,array $keywords): array\n    {\n        $pseudo=['fields'=>[],'field_labels'=>[]];\n        foreach($keywords as $row){\n            if(!is_array($row))continue;\n            $kid=(int)($row['kid']??0);if($kid<1)continue;\n            $field='kid'.$kid;$pseudo['fields'][]=$field;$pseudo['field_labels'][$field]=(string)($row['name']??'');\n        }\n        $binding=self::inferSubscriptionTemplateBinding($scene,$pseudo,[]);\n        $recommended=[];\n        foreach(array_merge(array_values($binding['field_map']),array_keys($binding['field_defaults'])) as $field){\n            if(strpos((string)$field,'kid')===0)$recommended[]=(int)substr((string)$field,3);\n        }\n        return array_values(array_unique(array_filter($recommended,static function($id){return $id>0;})));\n    }\n}\n","server/app/Domain/Messaging/MessageEventCatalog.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Messaging;\nrequire_once __DIR__.'/OrderProgressMessageCatalog.php';\n\n// 2026-10-08：统一协商事件仅通知另一方，升级后才通知管理员。\nfinal class MessageEventCatalog\n{\n    public static function all(): array\n    {\n        static $catalog = null;\n        if (is_array($catalog)) return $catalog;\n\n        $labels = [\n            'negotiation_responded'=>'对方响应协商','repair_worker_accepted'=>'师傅接受维修','measurement_rework_rejected'=>'师傅无法补测',\n            'order_ready_for_prepayment'=>'下单待支付预约费','order_submitted'=>'新订单待管理员审核','order_approved'=>'订单审核通过','order_supplement_required'=>'要求用户补充资料','order_supplemented'=>'用户已补充资料','order_rejected'=>'订单审核未通过',\n            'worker_quoted'=>'师傅首次报价','worker_quote_updated'=>'师傅修改报价','platform_quoted'=>'平台报价','quote_selected_pending_payment'=>'用户选择报价','payment_reservation_released'=>'支付超时释放报价','booking_fee_paid'=>'预约费支付成功','booking_fee_paid_upfront'=>'下单预约费支付成功',\n            'worker_assigned'=>'安排施工师傅','assignment_accepted'=>'师傅接单','assignment_rejected'=>'师傅拒绝派单','assignment_expired'=>'派单超时释放','appointment_recorded'=>'师傅登记预约','appointment_waiting_customer_notice'=>'师傅已响应预约，等待客户确认',\n            'change_requested'=>'师傅申请费用调整','change_accepted'=>'用户同意费用调整','change_rejected'=>'用户不同意费用调整','completion_submitted'=>'师傅提交完工','completion_accepted_by_user'=>'用户确认验收','auto_completion_accepted'=>'系统自动验收','auto_accepted_72h'=>'72小时自动验收',\n            'exceptional_arrival_reported'=>'师傅登记到场异常','offline_collection_delayed'=>'尾款延期登记','offline_collection_bad_debt'=>'尾款坏账','cancel_requested'=>'用户申请取消退款','cancel_approved'=>'取消退款通过','admin_cancelled'=>'平台强制取消','cancel_rejected'=>'取消退款驳回','auto_cancelled_7d'=>'七天自动取消','refund_succeeded'=>'退款成功',\n            'order_auto_preapproved'=>'新订单自动预审公开','offline_collection_adjustment_requested'=>'师傅提交实际尾款','offline_collection_adjustment_auto_approved'=>'实际尾款自动预审生效','offline_collection_adjustment_approved'=>'实际尾款复核通过','offline_collection_adjustment_rejected'=>'实际尾款驳回',\n            'commission_estimate_created'=>'预计服务费已生成','commission_receivable_finalized'=>'正式平台服务费已生成','commission_receivable_created'=>'平台服务费待缴','commission_paid'=>'平台服务费结清','commission_overdue'=>'平台服务费逾期',\n            'dispute_opened'=>'订单争议发起','completion_dispute_opened'=>'用户提交完工争议','dispute_resolved'=>'订单争议结案','review_submitted'=>'用户提交评价','auto_reviewed_5d'=>'系统自动评价',\n            'run_empty_claim_submitted'=>'商家跑空费待确认','run_empty_claim_confirmed'=>'商家已确认跑空费','run_empty_claim_disputed'=>'跑空费进入争议','run_empty_fee_paid'=>'商家已支付跑空费',\n            'worker_profile_submitted'=>'师傅发布/更新资料待审核','worker_realname_submitted'=>'师傅实名待审核','worker_collection_code_submitted'=>'旧版收款码待审核','worker_collection_code_auto_approved'=>'收款码自动预审后待抽查','merchant_auth_submitted'=>'商家认证待审核','withdrawal_submitted'=>'师傅提交提现申请',\n            'warranty_repair_requested'=>'用户提交维修申请','warranty_repair_withdrawn'=>'用户撤回维修申请','repair_worker_rejected'=>'师傅拒绝维修','repair_worker_completed'=>'师傅完成维修','repair_intervention_available'=>'维修超时可申请平台介入','repair_platform_intervention_requested'=>'用户申请平台介入维修','repair_platform_continue'=>'平台要求继续维修','repair_platform_resolved'=>'平台确认售后解决','repair_platform_closed'=>'平台关闭售后','repair_appointment_recorded'=>'师傅登记维修预约','repair_waiting_customer_notice'=>'师傅已响应维修，等待客户确认','worker_replaced_by_user'=>'用户更换成交师傅',\n            'supplement_deadline_reminder'=>'补资料期限提醒','supplement_timeout_refunded'=>'补资料超时退款',\n            'measurement_service_paid'=>'测量服务费支付成功','measurement_change_paid'=>'测量加费支付成功','measurement_change_accepted_pending_payment'=>'测量加费待付款','measurement_result_submitted'=>'测量成果待确认','measurement_rework_requested'=>'用户申请补测','measurement_result_accepted'=>'测量成果已确认','measurement_auto_accepted'=>'测量成果自动确认',\n            'measurement_hold_extension_requested'=>'测量冻结延期申请','measurement_hold_extension_approved'=>'测量冻结延期已通过','measurement_hold_extension_rejected'=>'测量冻结延期未通过','measurement_income_released'=>'测量费用已结算','measurement_construction_linked'=>'测量单已关联施工单',\n            'measurement_change_refund_created'=>'测量加费退款处理中','measurement_change_refunded'=>'测量加费退款成功','measurement_late_balance_refund_created'=>'测量尾款退款处理中','measurement_late_balance_refunded'=>'测量尾款退款成功',\n            'worker_contact_reveal_requested'=>'用户申请公开师傅电话','worker_conta