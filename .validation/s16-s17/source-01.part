TAMP(),UTC_TIMESTAMP()),\n('help_faqs','status','状态','状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','related_faq_ids','相关问答ID列表','相关问答ID列表',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','business_entry_label','业务记录标签','业务记录标签',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','business_entry_path','业务记录路径','业务记录路径',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','draft_payload','草稿内容','草稿内容',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','version','版本号','版本号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','published_version','已发布版本','已发布版本',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','published_at','发布时间','发布时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','created_by','创建人ID','创建人ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','updated_by','更新人ID','更新人ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','deleted_at','删除时间','删除时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faqs','updated_at','更新时间','更新时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','faq_id','问答ID','问答ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','version','版本号','版本号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','snapshot_json','快照JSON','快照JSON',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','action','操作','操作',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','operator_admin_id','操作人管理员ID','操作人管理员ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_faq_versions','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','query_text','查询文本','查询文本',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','query_hash','查询摘要','查询摘要',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','role_key','角色键','角色键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','result_count','结果数量','结果数量',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','clicked_faq_id','点击问答ID','点击问答ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\n-- V2.4.0 BASELINE EXTENSION END\n\n-- V2.5.0 review rating dictionary seed\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('reviews','attitude_rating','服务态度评分','订单评价中的服务态度星级，1-5星',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('reviews','craft_rating','施工手艺评分','订单评价中的施工手艺星级，1-5星',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-10-08：取消风控与七天下单限制；账号锁、同单事实及解除审计独立于退款状态。\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_accounts (\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  blocked_until datetime DEFAULT NULL COMMENT '新下单限制结束时间（UTC）',\n  last_restriction_id bigint unsigned DEFAULT NULL COMMENT '最近限制审计ID',\n  updated_at datetime NOT NULL COMMENT '更新时间（UTC）',\n  PRIMARY KEY (user_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_signals (\n  id bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  order_id bigint unsigned NOT NULL COMMENT '取消订单ID',\n  worker_id bigint unsigned NOT NULL COMMENT '参与师傅ID',\n  signal_type varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原操作信号：dialed拨号、contacted预约联系、complaint异常投诉',\n  note varchar(500) NOT NULL DEFAULT '' COMMENT '原提交说明',\n  created_at datetime NOT NULL COMMENT '创建时间（UTC）',\n  revoked_at datetime DEFAULT NULL COMMENT '信号撤销时间',\n  PRIMARY KEY (id),\n  UNIQUE KEY uq_cancel_risk_signal (order_id,worker_id,signal_type)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_scores (\n  order_id bigint unsigned NOT NULL COMMENT '取消订单ID',\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  base_score smallint unsigned NOT NULL DEFAULT 0 COMMENT '取消前报价成交跑空最高分',\n  score smallint unsigned NOT NULL DEFAULT 0 COMMENT '同单所有有效事实最高分',\n  cancelled_at datetime NOT NULL COMMENT '取消成立时间（UTC）',\n  snapshot_json longtext NOT NULL COMMENT '取消事实或处罚规则命中快照',\n  consumed_restriction_id bigint unsigned DEFAULT NULL COMMENT '消耗本单计分的限制ID；防止旧单重复封禁',\n  excluded_at datetime DEFAULT NULL COMMENT '客服或责任裁定排除时间',\n  exclusion_reason varchar(500) DEFAULT NULL COMMENT '计分排除原因',\n  created_at datetime NOT NULL COMMENT '创建时间（UTC）',\n  updated_at datetime NOT NULL COMMENT '更新时间（UTC）',\n  PRIMARY KEY (order_id),\n  KEY idx_cancel_risk_user_time (user_id,cancelled_at),\n  KEY idx_cancel_risk_user_unused (user_id,consumed_restriction_id,excluded_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_restrictions (\n  id bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  starts_at datetime NOT NULL COMMENT '限制开始时间（UTC）',\n  expires_at datetime NOT NULL COMMENT '限制结束时间（UTC）',\n  snapshot_json longtext NOT NULL COMMENT '取消事实或处罚规则命中快照',\n  released_at datetime DEFAULT NULL COMMENT '客服解除时间（UTC）',\n  released_by_admin_id bigint unsigned DEFAULT NULL COMMENT '解除管理员ID',\n  release_reason varchar(500) DEFAULT NULL COMMENT '客服解除核实说明',\n  PRIMARY KEY (id),\n  KEY idx_cancel_risk_restriction_user (user_id,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n  ('order_cancellation_risk_accounts','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','blocked_until','新下单限制结束时间（UTC）','新下单限制结束时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','last_restriction_id','最近限制审计ID','最近限制审计ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','updated_at','更新时间（UTC）','更新时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','order_id','取消订单ID','取消订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','worker_id','参与师傅ID','参与师傅ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','signal_type','原操作信号：dialed拨号、contacted预约联系、complaint异常投诉','原操作信号：dialed拨号、contacted预约联系、complaint异常投诉',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','note','原提交说明','原提交说明',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','created_at','创建时间（UTC）','创建时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','revoked_at','信号撤销时间','信号撤销时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','order_id','取消订单ID','取消订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','base_score','取消前报价成交跑空最高分','取消前报价成交跑空最高分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','score','同单所有有效事实最高分','同单所有有效事实最高分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','cancelled_at','取消成立时间（UTC）','取消成立时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','snapshot_json','取消事实或处罚规则命中快照','取消事实或处罚规则命中快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','consumed_restriction_id','消耗本单计分的限制ID；防止旧单重复封禁','消耗本单计分的限制ID；防止旧单重复封禁',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','excluded_at','客服或责任裁定排除时间','客服或责任裁定排除时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','exclusion_reason','计分排除原因','计分排除原因',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','created_at','创建时间（UTC）','创建时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','updated_at','更新时间（UTC）','更新时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','starts_at','限制开始时间（UTC）','限制开始时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','expires_at','限制结束时间（UTC）','限制结束时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','snapshot_json','取消事实或处罚规则命中快照','取消事实或处罚规则命中快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','released_at','客服解除时间（UTC）','客服解除时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','released_by_admin_id','解除管理员ID','解除管理员ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','release_reason','客服解除核实说明','客服解除核实说明',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE chinese_name=VALUES(chinese_name),description=VALUES(description),updated_at=UTC_TIMESTAMP();\n\n-- Current empty identity/testing table exports from isolated MySQL 5.7.42.\nDROP TABLE IF EXISTS `chat_admin_sessions`;\nCREATE TABLE `chat_admin_sessions` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '聊天后台会话ID',\n  `admin_id` bigint(20) unsigned NOT NULL COMMENT '原后台管理员ID',\n  `session_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '环境绑定的PHP Session摘要',\n  `session_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '随机会话撤销版本',\n  `authority_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '角色密码及scope快照摘要',\n  `scopes_json` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '限权scope JSON数组',\n  `expires_at` datetime NOT NULL COMMENT '最晚凭证到期时间UTC',\n  `revoked_at` datetime DEFAULT NULL COMMENT '原Session登出或撤销时间UTC',\n  `created_at` datetime NOT NULL COMMENT '创建时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_admin_session_hash` (`session_hash`),\n  KEY `idx_chat_admin_actor_expiry` (`admin_id`,`expires_at`),\n  KEY `idx_chat_admin_expiry` (`expires_at`),\n  CONSTRAINT `fk_chat_admin_actor` FOREIGN KEY (`admin_id`) REFERENCES `admin_users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP后台聊天凭证会话，Go只读';\n\nDROP TABLE IF EXISTS `test_assertion_results`;\nCREATE TABLE `test_assertion_results` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `run_id` bigint(20) unsigned DEFAULT NULL,\n  `assertion_group` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `assertion_key` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `expected_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `actual_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `details_json` text COLLATE utf8mb4_unicode_ci,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  KEY `idx_test_assertions_instance` (`instance_id`,`id`),\n  KEY `idx_test_assertions_run` (`run_id`,`id`),\n  KEY `idx_test_assertions_status` (`status`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心断言结果';\n\nDROP TABLE IF EXISTS `test_batches`;\nCREATE TABLE `test_batches` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `create_request_key` varchar(80) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `code_sha` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `app_version` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `environment` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `archived_at` datetime DEFAULT NULL,\n  `cleanup_at` datetime DEFAULT NULL,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_batches_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_batches_request` (`created_by_admin_id`,`create_request_key`),\n  KEY `idx_test_batches_status_created` (`status`,`created_at`),\n  KEY `idx_test_batches_admin_created` (`created_by_admin_id`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心批次元数据';\n\nDROP TABLE IF EXISTS `test_entry_tokens`;\nCREATE TABLE `test_entry_tokens` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `token_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `actor_role` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_user_id` bigint(20) unsigned NOT NULL,\n  `actor_worker_id` bigint(20) unsigned DEFAULT NULL,\n  `worker_slot` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `page_key` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `expires_at` datetime NOT NULL,\n  `used_at` datetime DEFAULT NULL,\n  `used_by_session_id` bigint(20) unsigned DEFAULT NULL,\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_entry_public` (`public_id`),\n  UNIQUE KEY `uniq_test_entry_hash` (`token_hash`),\n  KEY `idx_test_entry_instance_status` (`instance_id`,`status`,`expires_at`),\n  KEY `idx_test_entry_session` (`used_by_session_id`,`used_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心一次性小程序短期入口；只保存 token 摘要';\n\nDROP TABLE IF EXISTS `test_instances`;\nCREATE TABLE `test_instances` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `batch_id` bigint(20) unsigned NOT NULL,\n  `scenario_key` varchar(160) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `scenario_version` int(10) unsigned NOT NULL DEFAULT '1',\n  `order_id` bigint(20) unsigned DEFAULT NULL,\n  `order_no_snapshot` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `params_json` text COLLATE utf8mb4_unicode_ci,\n  `params_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `build_mode` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'preset',\n  `build_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'building',\n  `verification_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n  `source_instance_id` bigint(20) unsigned DEFAULT NULL,\n  `rebuilt_from_instance_id` bigint(20) unsigned DEFAULT NULL,\n  `version` int(10) unsigned NOT NULL DEFAULT '1',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  `archived_at` datetime DEFAULT NULL,\n  `deleted_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_instances_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_instances_order_id` (`order_id`),\n  KEY `idx_test_instances_batch` (`batch_id`,`id`),\n  KEY `idx_test_instances_scenario` (`scenario_key`,`build_status`,`created_at`),\n  KEY `idx_test_instances_verification` (`verification_status`,`created_at`),\n  KEY `idx_test_instances_source` (`source_instance_id`),\n  KEY `idx_test_instances_rebuilt` (`rebuilt_from_instance_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心场景实例';\n\nDROP TABLE IF EXISTS `test_media_facts`;\nCREATE TABLE `test_media_facts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `media_file_id` bigint(20) unsigned NOT NULL,\n  `purpose` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `storage_key_snapshot` varchar(500) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_media_instance_file` (`instance_id`,`media_file_id`),\n  KEY `idx_test_media_file` (`media_file_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心创建媒体归属，用于精确清理';\n\nDROP TABLE IF EXISTS `test_message_outbox`;\nCREATE TABLE `test_message_outbox` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `order_id` bigint(20) unsigned NOT NULL,\n  `business_key` varchar(190) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `event_key` varchar(160) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `event_type` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `channel` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `recipient_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `recipient_id` bigint(20) unsigned DEFAULT NULL,\n  `scene_key` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `projection_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `reason_code` varchar(120) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `payload_json` text COLLATE utf8mb4_unicode_ci,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_message_business` (`instance_id`,`business_key`),\n  KEY `idx_test_message_instance_created` (`instance_id`,`created_at`),\n  KEY `idx_test_message_event_channel` (`event_type`,`channel`,`projection_status`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心消息模拟投影；绝不进入真实外部投递队列';\n\nDROP TABLE IF EXISTS `test_participants`;\nCREATE TABLE `test_participants` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `slot_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` bigint(20) unsigned DEFAULT NULL,\n  `worker_id` bigint(20) unsigned DEFAULT NULL,\n  `expected_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_participant_slot` (`instance_id`,`slot_key`),\n  KEY `idx_test_participant_user` (`user_id`),\n  KEY `idx_test_participant_worker` (`worker_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试实例参与者 slot 映射；主档可由多个实例共享';\n\nDROP TABLE IF EXISTS `test_payment_facts`;\nCREATE TABLE `test_payment_facts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `payment_order_id` bigint(20) unsigned NOT NULL,\n  `simulation_request_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `business_type` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `amount_cents` bigint(20) unsigned NOT NULL,\n  `simulated_provider` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'internal_test',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'paid',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_payment_order` (`payment_order_id`),\n  UNIQUE KEY `uniq_test_payment_request` (`simulation_request_key`),\n  KEY `idx_test_payment_instance` (`instance_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='testing 内部支付事实来源登记；绝非微信交易';\n\nDROP TABLE IF EXISTS `test_runs`;\nCREATE TABLE `test_runs` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `action_key` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_role` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'admin',\n  `operation_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'preset',\n  `idempotency_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `before_summary_json` text COLLATE utf8mb4_unicode_ci,\n  `after_summary_json` text COLLATE utf8mb4_unicode_ci,\n  `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'running',\n  `error_code` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `error_message` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `duration_ms` int(10) unsigned DEFAULT NULL,\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `started_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `finished_at` datetime DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_runs_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_runs_idempotency` (`instance_id`,`idempotency_key`),\n  KEY `idx_test_runs_instance_created` (`instance_id`,`created_at`),\n  KEY `idx_test_runs_result_created` (`result`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心动作执行记录';\n\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TRIGGER `chat_admin_identity_revoke` AFTER UPDATE ON `admin_users`\nFOR EACH ROW UPDATE `chat_admin_sessions`\nSET `revoked_at`=COALESCE(`revoked_at`,UTC_TIMESTAMP())\nWHERE `admin_id`=NEW.id AND `revoked_at` IS NULL\n  AND (NOT (OLD.role <=> NEW.role) OR NOT (OLD.status <=> NEW.status)\n       OR NOT (OLD.password_hash <=> NEW.password_hash)\n       OR NOT (OLD.must_change_password <=> NEW.must_change_password));\nINSERT INTO database_field_dictionary (table_name,field_name,chinese_name,description,created_at,updated_at) VALUES\n('login_sessions','test_actor_expires_at','测试身份到期时间','到期后 API actor 解析自动清除临时身份','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('login_sessions','test_actor_user_id','测试实例临时身份','仅 testing 的真实管理员小程序会话可通过一次性测试入口临时绑定；正式环境解析时忽略并清除','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('login_sessions','test_instance_id','测试实例临时绑定','短期测试会话只能访问此实例归属的客户或 test_participants 师傅身份','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_assertion_results','status','断言结果','passed/failed/skipped/not_applicable/blocked','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_batches','create_request_key','测试创建请求键','同一管理员的场景生成请求幂等键','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_entry_tokens','status','入口票据状态','active/used/expired/revoked；used 后不可再次兑换','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_entry_tokens','token_hash','短期入口摘要','一次性入口只保存 SHA-256 摘要，不保存明文 token','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_instances','order_id','测试主订单ID','测试实例主要查看订单；M1 一实例一订单，删除后置空保留 tombstone','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_instances','scenario_key','测试场景键','代码版本化场景模板稳定标识，不包含应用版本号','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_instances','verification_status','测试检查状态','pending/passed/failed/blocked','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_media_facts','media_file_id','测试媒体ID','测试中心创建并可安全删除的媒体主档，不得指向正式业务媒体','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_message_outbox','business_key','消息模拟幂等键','按测试实例、业务事件、渠道、收件人和场景去重，业务重试不得重复生成相同投影','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_message_outbox','projection_status','消息模拟状态','delivered/config_disabled/demo_suppressed/not_applicable/environment_blocked/simulated/failed/not_run；模拟消息绝不进入真实 dispatcher','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_participants','slot_key','测试参与者槽位','例如 worker_1/worker_2/pending_worker；用于页面测试与清理归属','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_payment_facts','payment_order_id','内部模拟支付单ID','仅 testing 内部支付适配器登记；对应 payment_orders 不得具有微信 prepay/transaction_id','2026-10-21 17:43:27','2026-10-21 17:43:27'),\n('test_runs','idempotency_key','测试动作幂等键','同一实例同一动作请求的幂等保护键','2026-10-21 17:43:27','2026-10-21 17:43:27')\nON DUPLICATE KEY UPDATE chinese_name=VALUES(chinese_name),description=VALUES(description);\n\n-- 隔离MySQL实际导出的空授权表，无业务订单或消息。\nDROP TABLE IF EXISTS `chat_policy_guards`;\nCREATE TABLE `chat_policy_guards` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '栅栏ID',\n  `scope_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '订单与不可变指派代次',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '不可变指派ID',\n  `policy_version` bigint(20) unsigned NOT NULL COMMENT '同scope单调权限版本',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'open可发或readonly只读',\n  `active_order_id` bigint(20) unsigned GENERATED ALWAYS AS (if((`state` = 'open'),`order_id`,NULL)) STORED COMMENT '同订单仅一个可发scope',\n  `snapshot_json` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'PHP权威身份与授权区间快照',\n  `snapshot_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '无版本快照指纹用于幂等',\n  `updated_at` datetime NOT NULL COMMENT '更新时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_policy_scope` (`scope_key`),\n  UNIQUE KEY `uq_chat_policy_active_order` (`active_order_id`),\n  KEY `idx_chat_policy_order` (`order_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP单写订单聊天权限栅栏，Go只读和取共享锁';\n\nDROP TABLE IF EXISTS `chat_business_events`;\nCREATE TABLE `chat_business_events` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '扫描定位ID，不等于已提交水位',\n  `event_id` char(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '随机稳定业务事件ID',\n  `aggregate_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '会话作用域',\n  `aggregate_version` bigint(20) unsigned NOT NULL COMMENT '该scope权限版本',\n  `schema_version` int(10) unsigned NOT NULL COMMENT '事件协议版本',\n  `event_type` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '事件类型',\n  `payload_json` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '版本化完整授权快照',\n  `created_at` datetime NOT NULL COMMENT '提交时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_business_event` (`event_id`),\n  UNIQUE KEY `uq_chat_business_scope_version` (`aggregate_key`,`aggregate_version`),\n  KEY `idx_chat_business_created` (`created_at`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP订单事务事件，Go不修改消费状态';\n\n-- 隔离MySQL实际导出的空授权表，无业务订单或消息。\nDROP TABLE IF EXISTS `chat_repair_episodes`;\nCREATE TABLE `chat_repair_episodes` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '不可变售后受理代次',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '受理时不可变指派ID',\n  `after_sale_id` bigint(20) unsigned NOT NULL COMMENT '售后申请ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '明确受理的师傅ID',\n  `accepted_user_id` bigint(20) unsigned NOT NULL COMMENT '师傅对应真实小程序用户ID',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'active或closed，closed不复活',\n  `active_order_id` bigint(20) unsigned GENERATED ALWAYS AS (if((`state` = 'active'),`order_id`,NULL)) STORED COMMENT '同订单仅一个有效受理区间',\n  `accepted_at` datetime NOT NULL COMMENT '原受理事务内UTC时间',\n  `closed_at` datetime DEFAULT NULL COMMENT '结束UTC时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_repair_active_order` (`active_order_id`),\n  KEY `idx_chat_repair_request` (`order_id`,`after_sale_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP单写售后明确受理事实，不从processing或事件文字推断授权';\n\n\n-- V2.10.0：平台工作人员权限代次及有界授权恢复。PHP单写，Go只读。\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\n\n-- 修复历史新装基线遗漏的平台专属表；已有升级库保持原表及资金数据。\nCREATE TABLE IF NOT EXISTS `order_platform_terms` (\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `customer_flow_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'platform_managed' COMMENT '客户参与方式：platform_managed平台托管、miniapp_booking小程序预约',\n  `customer_pricing_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'fixed_total' COMMENT '客户计价方式：fixed_total固定总价、itemized明细计价',\n  `customer_contract_total_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户当前最终成交金额（分）',\n  `worker_settlement_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'worker_collect' COMMENT '师傅工费结算：worker_collect师傅代收、platform_balance平台余额',\n  `worker_labor_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '当前最终师傅工费（分）',\n  `extra_income_rate_bp_snapshot` int(10) unsigned NOT NULL DEFAULT '2000' COMMENT '订单外加项平台收入比例快照（万分比）',\n  `booking_paid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '最终结算时平台已收预约费快照（分）',\n  `customer_tail_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户现场剩余应付（分）',\n  `platform_receivable_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '平台收入款待收金额（分）',\n  `worker_balance_credit_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '应进入师傅余额金额（分）',\n  `worker_balance_freeze_days_snapshot` smallint(5) unsigned NOT NULL DEFAULT '0' COMMENT '师傅余额冻结天数快照',\n  `settlement_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '平台承接单结算状态',\n  `settled_at` datetime DEFAULT NULL COMMENT '结算完成时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`order_id`),\n  KEY `idx_platform_terms_settlement` (`settlement_status`,`updated_at`),\n  CONSTRAINT `fk_platform_terms_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单专属计价与结算条件';\n\nCREATE TABLE IF NOT EXISTS `order_pricing_items` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `item_source` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'base' COMMENT '明细来源：base基础开单、change订单外加项',\n  `change_request_id` bigint(20) unsigned DEFAULT NULL COMMENT '关联费用调整申请ID',\n  `description` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '施工项目/描述',\n  `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '项目说明',\n  `quantity` decimal(12,3) DEFAULT NULL COMMENT '数量/实际用量',\n  `unit` varchar(24) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '计价单位',\n  `unit_price_cents` bigint(20) unsigned DEFAULT NULL COMMENT '单价（分）',\n  `amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '项目金额（分）',\n  `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  KEY `idx_pricing_items_order_sort` (`order_id`,`status`,`sort_order`,`id`),\n  KEY `idx_pricing_items_change` (`change_request_id`),\n  CONSTRAINT `fk_pricing_items_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_pricing_items_change` FOREIGN KEY (`change_request_id`) REFERENCES `change_requests` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单结构化开单明细';\n\nCREATE TABLE IF NOT EXISTS `platform_order_refund_reviews` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '退款财务复核单ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '关联平台承接订单ID',\n  `refund_id` bigint(20) unsigned NOT NULL COMMENT '原真实退款单ID（一退款只处理一次）',\n  `refund_amount_cents` bigint(20) unsigned NOT NULL COMMENT '建档时退款成功金额快照（分）',\n  `worker_labor_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时师傅工费快照（分）',\n  `worker_balance_credit_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时实际应入师傅余额快照（分）',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT 'open待判责、awaiting_recovery待实际追偿、resolved核账结束',\n  `responsibility` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'undetermined' COMMENT 'undetermined待定、platform平台、worker师傅、shared分担',\n  `worker_recovery_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '人工判定应由师傅补交金额（分）',\n  `recovered_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已核对真实到账的线下追偿累计金额（分）',\n  `decision_note` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '责任判定的事实依据',\n  `recovery_reference` varchar(120) COLLATE utf8mb4_bin DEFAULT NULL COMMENT '最近一次已核实的追偿交易流水号（完整逐笔凭证见人工收款台账）',\n  `recovery_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '线下真实追偿核验说明',\n  `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '发起核账管理员ID',\n  `decided_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '判责管理员ID',\n  `resolved_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核实结清管理员ID',\n  `created_at` datetime NOT NULL COMMENT '建档时间',\n  `decided_at` datetime DEFAULT NULL COMMENT '判责时间',\n  `resolved_at` datetime DEFAULT NULL COMMENT '核账结束时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_platform_refund_review_refund` (`refund_id`),\n  UNIQUE KEY `uq_platform_refund_review_recovery` (`recovery_reference`),\n  KEY `idx_platform_refund_review_order_status` (`order_id`,`status`),\n  KEY `idx_platform_refund_review_status_created` (`status`,`created_at`),\n  CONSTRAINT `fk_platform_refund_review_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_platform_refund_review_refund` FOREIGN KEY (`refund_id`) REFERENCES `refunds` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台单已验收后退款资金判责与线下追偿人工核账';\n\nCREATE TABLE IF NOT EXISTS `platform_order_manual_receipts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '实际外部收款凭证ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '所属平台订单',\n  `refund_review_id` bigint(20) unsigned DEFAULT NULL COMMENT '追偿对应退款复核单；平台收入款时为空',\n  `income_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '仅平台收入款填写的订单ID，唯一防重复核销',\n  `receipt_kind` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'platform_income平台收入款、refund_recovery退款追偿',\n  `amount_cents` bigint(20) unsigned NOT NULL COMMENT '本笔人工核验实际到账分数',\n  `payment_reference` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '银行或第三方支付实际收款编号；全类型唯一',\n  `verification_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '人工核实凭据及渠道说明',\n  `verified_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核验管理员ID',\n  `verified_at` datetime NOT NULL COMMENT '实际核验记录时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_manual_receipt_reference` (`payment_reference`),\n  UNIQUE KEY `uq_manual_income_order` (`income_order_id`),\n  KEY `idx_manual_receipt_review` (`refund_review_id`,`verified_at`),\n  KEY `idx_manual_receipt_order` (`order_id`,`verified_at`),\n  CONSTRAINT `fk_manual_receipt_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_manual_receipt_review` FOREIGN KEY (`refund_review_id`) REFERENCES `platform_order_refund_reviews` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台外部收款人工核验逐笔凭证，不代表微信支付或钱包入账';\n\nCREATE TABLE IF NOT EXISTS `chat_staff_authority_versions` (\n  `user_id` bigint(20) unsigned NOT NULL COMMENT '0为管理员配置，其余为真实用户；删除后保留代次',\n  `authority_version` bigint(20) unsigned NOT NULL DEFAULT 1 COMMENT '只增不减，移除再加入不得复用',\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP权限源同事务更新，Go取共享锁校验';\nINSERT IGNORE INTO `chat_staff_authority_versions` (`user_id`,`authority_version`) VALUES (0,1);\nINSERT IGNORE INTO `chat_staff_authority_versions` (`user_id`,`authority_version`) SELECT id,1 FROM users;\n\nCREATE TABLE IF NOT EXISTS `chat_policy_refresh` (\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID，不存消息内容',\n  `checked_at` datetime NOT NULL COMMENT '上次检查UTC',\n  `next_check_at` datetime NOT NULL COMMENT '下一次可检查UTC',\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'success或failed',\n  PRIMARY KEY (`order_id`),\n  KEY `idx_chat_policy_refresh_due` (`next_check_at`,`order_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP授权投影恢复游标，不承担即时撤权';\n\n-- 单语句触发器，覆盖Web/小程序/CLI/SQL维护，且回滚与原身份写入一致。\nDROP TRIGGER IF EXISTS `chat_staff_settings_insert`;\nCREATE TRIGGER `chat_staff_settings_insert` AFTER INSERT ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND NEW.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid');\nDROP TRIGGER IF EXISTS `chat_staff_settings_update`;\nCREATE TRIGGER `chat_staff_settings_update` AFTER UPDATE ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND (OLD.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid') OR NEW.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid'))\nAND (NOT (BINARY OLD.setting_key <=> BINARY NEW.setting_key) OR NOT (BINARY OLD.setting_value <=> BINARY NEW.setting_value) OR NOT (BINARY OLD.value_type <=> BINARY NEW.value_type));\nDROP TRIGGER IF EXISTS `chat_staff_settings_delete`;\nCREATE TRIGGER `chat_staff_settings_delete` AFTER DELETE ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND OLD.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid');\nDROP TRIGGER IF EXISTS `chat_staff_user_insert`;\nCREATE TRIGGER `chat_staff_user_insert` AFTER INSERT ON `users`\nFOR EACH ROW INSERT INTO chat_staff_authority_versions(user_id,authority_version) VALUES(NEW.id,1)\nON DUPLICATE KEY UPDATE authority_version=authority_version+1;\nDROP TRIGGER IF EXISTS `chat_staff_user_update`;\nCREATE TRIGGER `chat_staff_user_update` AFTER UPDATE ON `users`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id IN (OLD.id,NEW.id) AND (NOT (OLD.id <=> NEW.id) OR NOT (OLD.status <=> NEW.status));\nDROP TRIGGER IF EXISTS `chat_staff_user_delete`;\nCREATE TRIGGER `chat_staff_user_delete` AFTER DELETE ON `users`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=OLD.id;\nDROP TRIGGER IF EXISTS `chat_staff_wechat_insert`;\nCREATE TRIGGER `chat_staff_wechat_insert` AFTER INSERT ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=NEW.user_id;\nDROP TRIGGER IF EXISTS `chat_staff_wechat_update`;\nCREATE TRIGGER `chat_staff_wechat_update` AFTER UPDATE ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id IN (OLD.user_id,NEW.user_id)\nAND (NOT (OLD.user_id <=> NEW.user_id) OR NOT (OLD.app_id <=> NEW.app_id) OR NOT (OLD.openid <=> NEW.openid) OR NOT (OLD.status <=> NEW.status));\nDROP TRIGGER IF EXISTS `chat_staff_wechat_delete`;\nCREATE TRIGGER `chat_staff_wechat_delete` AFTER DELETE ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=OLD.user_id;\n\n-- V2.11.0：Go单写会话/成员权限版本区间与事件租约；不创建消息或启用聊天。\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_conversations` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立会话ID，不等于订单ID',\n  `conversation_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前仅order',\n  `scope_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP提供的不可变订单指派作用域',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '可信订单绑定，不直接授予权限',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '不可变指派绑定',\n  `policy_version` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已连续应用的PHP权限版本',\n  `snapshot_hash` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '已应用快照指纹',\n  `episode_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP授权业务区间代次',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'open或readonly；pending仅事务内',\n  `created_at` datetime(6) NOT NULL COMMENT '建立时间UTC',\n  `updated_at` datetime(6) NOT NULL COMMENT '投影更新时间UTC，不是消息活跃时间',\n  `last_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '同会话已提交封闭消息高水位',\n  `last_change_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '同会话已提交封闭变更高水位',\n  `last_message_id` bigint(20) unsigned DEFAULT NULL COMMENT '最后正式消息ID，无待审占位',\n  `last_message_at` datetime(6) DEFAULT NULL COMMENT '最后正式消息提交UTC',\n  `sync_floor_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '消息补收已清理范围上界，不含可补收起点',\n  `change_floor_seq` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '安全变更已清理范围上界，不含可补收起点',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_conversation_scope` (`conversation_type`,`scope_key`),\n  UNIQUE KEY `uq_chat_conversation_binding` (`conversation_type`,`order_id`,`assignment_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写独立会话与可信业务绑定';\n\nCREATE TABLE IF NOT EXISTS `chat_members` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实用户ID，当前仅小程序身份',\n  `actor_kind` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前仅mini，不接受后台审计成员',\n  `role` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'customer/worker/platform_staff',\n  `member_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '包含episode和工作人员配置/用户代次',\n  `can_read` tinyint(1) NOT NULL COMMENT '最近应用快照的读取资格，仍需当前栅栏交集',\n  `can_send` tinyint(1) NOT NULL COMMENT '最近应用快照的发送资格，仍需当前栅栏交集',\n  PRIMARY KEY (`conversation_id`,`actor_id`),\n  KEY `idx_chat_member_actor` (`actor_id`,`can_read`,`conversation_id`),\n  CONSTRAINT `fk_chat_member_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写当前成员投影，不复制用户账号';\n\nCREATE TABLE IF NOT EXISTS `chat_member_intervals` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实用户ID',\n  `member_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '不可变授权身份代次',\n  `start_version` bigint(20) unsigned NOT NULL COMMENT '可读消息权限版本下界，包含',\n  `end_version` bigint(20) unsigned DEFAULT NULL COMMENT '可读消息权限版本上界，不包含；空表示尚未闭合',\n  `open_actor_id` bigint(20) unsigned GENERATED ALWAYS AS (IF(`end_version` IS NULL,`actor_id`,NULL)) STORED COMMENT '每会话每人最多一个未闭合区间',\n  PRIMARY KEY (`conversation_id`,`actor_id`,`start_version`),\n  UNIQUE KEY `uq_chat_interval_open` (`conversation_id`,`open_actor_id`),\n  CONSTRAINT `fk_chat_interval_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写历史授权版本区间，禁止用处理时seq补权';\n\nCREATE TABLE IF NOT EXISTS `chat_event_receipts` (\n  `event_id` char(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP原始不可变事件ID',\n  `aggregate_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原始会话作用域',\n  `aggregate_version` bigint(20) unsigned NOT NULL COMMENT '原始PHP权限版本',\n  `payload_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '领取时原始事件指纹',\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'processing/retry/done/rejected',\n  `attempts` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '领取次数，有界递增',\n  `lease_owner` char(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '每次领取随机独立所有者',\n  `lease_until` datetime(6) DEFAULT NULL COMMENT '服务端租约截止UTC',\n  `next_attempt_at` datetime(6) NOT NULL COMMENT '失败退避后可重试时间UTC',\n  `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '稳定诊断码，不存正文或SQL',\n  `completed_at` datetime(6) DEFAULT NULL COMMENT '与会话投影同事务完成UTC',\n  PRIMARY KEY (`event_id`),\n  UNIQUE KEY `uq_chat_receipt_scope_version` (`aggregate_key`,`aggregate_version`),\n  KEY `idx_chat_receipt_retry` (`status`,`next_attempt_at`),\n  KEY `idx_chat_receipt_lease` (`status`,`lease_until`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写消费回执/租约，PHP事件表只读';\n\n-- V2.12.0 S06 Go单写消息基础，默认关闭\nCREATE TABLE IF NOT EXISTS `chat_restrictions` (\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实mini用户ID，永久稳定锁行，不得删除',\n  `permanent` tinyint(1) NOT NULL DEFAULT '0' COMMENT '永久禁发；不限制合法查询与原业务',\n  `blocked_until` datetime(6) DEFAULT NULL COMMENT '限时禁发截止UTC，空且非永久表示未限制',\n  `version` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '限制变更单调代次，后续管理写入需递增',\n  `updated_at` datetime(6) NOT NULL COMMENT '限制更新时间UTC',\n  PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写账号发送限制与稳定锁，不能按有无禁令加锁';\n\nCREATE TABLE IF NOT EXISTS `chat_send_intents` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '服务端发送意图ID',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '授权会话ID',\n  `client_message_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '10位Unix秒点32位小写hex随机数，不随重试变化',\n  `fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '版本化完整正文结构SHA256，不存被拒绝正文',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'checking/retryable/rejected/accepted',\n  `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '安全稳定诊断码，无规则证据',\n  `message_id` bigint(20) unsigned DEFAULT NULL COMMENT '已提交正式消息ID，拒绝为空',\n  `lease_owner` char(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '当前检查随机所有者，旧所有者不能发布',\n  `lease_until` datetime(6) DEFAULT NULL COMMENT '10秒有界审核所有权截止UTC',\n  `attempts` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '最多8次检查尝试，耗尽不自动换ID补发',\n  `action_expires_at` datetime(6) NOT NULL COMMENT 'ID创建秒加24小时，发布前再次校验',\n  `retain_until` datetime(6) NOT NULL COMMENT '至少动作截止后30天；独立于正文TTL，本阶段不清理',\n  `created_at` datetime(6) NOT NULL COMMENT '首次创建UTC',\n  `updated_at` datetime(6) NOT NULL COMMENT '状态更新时间UTC',\n  `risk_event_id` bigint(20) unsigned DEFAULT NULL COMMENT '风险或疑似复核事件ID，仅本人最小结果返回，不展开证据',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_send_client` (`sender_id`,`conversation_id`,`client_message_id`),\n  KEY `idx_chat_send_pending` (`sender_id`,`state`,`lease_until`),\n  KEY `idx_chat_send_retention` (`retain_until`),\n  CONSTRAINT `fk_chat_send_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写发送意图与最小幂等结果，审核中不占消息seq';\n\nCREATE TABLE IF NOT EXISTS `chat_messages` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立正式消息ID，对外字符串',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `seq` bigint(20) unsigned NOT NULL COMMENT '会话锁内按提交顺序分配，拒绝不占号',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `client_message_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原客户端动作ID',\n  `policy_version` bigint(20) unsigned NOT NULL COMMENT '最终提交时PHP权限版本，不可回填改写',\n  `message_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '本阶段仅text',\n  `text_body` text COLLATE utf8mb4_unicode_ci COMMENT '原始UTF8正文，普通查询必须按安全状态过滤',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'published/recalled/blocked，普通结果不返回正文',\n  `state_version` bigint(20) unsigned NOT NULL DEFAULT '1' COMMENT '安全状态单调版本',\n  `safety_rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '通过必需审核的版本',\n  `created_at` datetime(6) NOT NULL COMMENT '正式发布UTC',\n  `reply_to_message_id` bigint(20) unsigned DEFAULT NULL COMMENT '同会话单层引用，仅服务端安全投影',\n  `edited_from_recalled_message_id` bigint(20) unsigned DEFAULT NULL COMMENT '同作者已撤回直接来源，不可变',\n  `reedit_depth` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '重新编辑来源深度，最多8',\n  `recalled_at` datetime(6) DEFAULT NULL COMMENT '作者撤回提交UTC，正文仅受控证据留存',\n  `reply_to_item_id` bigint(20) unsigned DEFAULT NULL COMMENT '同会话图片合集稳定条目引用',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_message_seq` (`conversation_id`,`seq`),\n  UNIQUE KEY `uq_chat_message_client` (`sender_id`,`conversation_id`,`client_message_id`),\n  KEY `idx_chat_unread` (`conversation_id`,`state`,`seq`,`sender_id`,`policy_version`),\n  CONSTRAINT `fk_chat_message_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写已提交消息，无审核占位，历史按权限版本裁剪';\n\nCREATE TABLE IF NOT EXISTS `chat_message_changes` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `change_seq` bigint(20) unsigned NOT NULL COMMENT '会话共享提交锁内分配的封闭变更游标',\n  `message_id` bigint(20) unsigned NOT NULL COMMENT '变更所属正式消息ID',\n  `state_version` bigint(20) unsigned NOT NULL COMMENT '消息安全状态版本',\n  `change_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前message.accepted，后续撤回等同事务追加',\n  `created_at` datetime(6) NOT NULL COMMENT '提交UTC',\n  PRIMARY KEY (`conversation_id`,`change_seq`),\n  CONSTRAINT `fk_chat_change_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`),\n  CONSTRAINT `fk_chat_change_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写消息安全变更，S08再接同步分页接口';\n\n-- V2.13.0 S07 Go单写审核与证据\nCREATE TABLE IF NOT EXISTS `chat_text_checks` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '短窗口检查顺序，同作者稳定锁内登记',\n  `intent_id` bigint(20) unsigned NOT NULL COMMENT '逻辑发送动作ID，重试不追加片段',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '仅限本会话上下文，不跨群跟踪',\n  `fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '完整不可变发送内容指纹',\n  `normalized_text` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '受限业务短窗口证据，不进入普通日志或普通API',\n  `cache_key` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '环境AppID身份代次场景规则及指纹联合去重键',\n  `pass_until` datetime(6) DEFAULT NULL COMMENT '仅明确官方pass缓存五分钟，不延长原判定',\n  `created_at` datetime(6) NOT NULL COMMENT '首次动作登记UTC，重试不刷新窗口',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_text_intent` (`intent_id`),\n  KEY `idx_chat_text_context` (`sender_id`,`conversation_id`,`created_at`,`id`),\n  KEY `idx_chat_text_pass` (`cache_key`,`pass_until`),\n  KEY `idx_chat_text_expiry` (`created_at`),\n  CONSTRAINT `fk_chat_text_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写两分钟最近五动作检测，十分钟后有界清理';\n\nCREATE TABLE IF NOT EXISTS `chat_risk_events` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立风险事件ID，仅作者安全结果可引用',\n  `intent_id` bigint(20) unsigned NOT NULL COMMENT '逻辑发送动作唯一，不因重试累计违规',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '原会话ID',\n  `content_fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原始完整内容结构指纹',\n  `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '完整检测规则版本',\n  `provider` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '官方内容安全或本地私单检测来源',\n  `reason_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '稳定规则码，不向普通接口输出命中详情',\n  `provider_trace` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '受限供应商追踪标识，不存整包响应',\n  `risk_level` tinyint(3) unsigned NOT NULL COMMENT '1疑似待复核，2明确拦截；不直接作财务处置',\n  `confirmed` tinyint(1) NOT NULL COMMENT '仅明确拦截记确认风险；审核故障不建风险',\n  `disposition` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'rejected或review_pending，不自动补发',\n  `review_state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT 'S19复核接续状态，当前无处理接口',\n  `text_evidence` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原文只在受控业务证据中，未来独立权限审计读取',\n  `context_evidence` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '仅拆条命中的有界上下文，含动作ID指纹和规范化片段；普通接口不展开',\n  `retain_until` datetime(6) NOT NULL COMMENT '至少覆盖原动作最小结果保留窗，当前不清理证据',\n  `created_at` datetime(6) NOT NULL COMMENT '与发送者终态同事务提交UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_risk_intent` (`intent_id`),\n  KEY `idx_chat_risk_actor` (`sender_id`,`confirmed`,`created_at`),\n  KEY `idx_chat_risk_review` (`review_state`,`created_at`,`id`),\n  CONSTRAINT `fk_chat_risk_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写风险证据和复核接续；普通API不返回原文，不自动罚款封号';\n\nCREATE TABLE `chat_member_reads` (\n `conversation_id` bigint(20) unsigned NOT NULL,\n `actor_id` bigint(20) unsigned NOT NULL,\n `member_key_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `read_seq` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`conversation_id`,`actor_id`),\n CONSTRAINT `fk_chat_read_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写会话已读水位，身份代次隔离';\n\n-- CHAT_SECTION preferences\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_preference_accounts` (\n `actor_id` bigint(20) unsigned NOT NULL,\n `revision` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写账号偏好修订与并发串行锁，不授予会话权限';\nCREATE TABLE IF NOT EXISTS `chat_user_preferences` (\n `conversation_id` bigint(20) unsigned NOT NULL,\n `actor_id` bigint(20) unsigned NOT NULL,\n `member_key_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `pinned` tinyint(1) NOT NULL DEFAULT 0,\n `pinned_version` bigint(20) unsigned NOT NULL DEFAULT 0,\n `later` tinyint(1) NOT NULL DEFAULT 0,\n `later_version` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`conversation_id`,`actor_id`),\n KEY `idx_chat_preferences_actor` (`actor_id`,`pinned`,`conversation_id`),\n CONSTRAINT `fk_chat_preferences_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写本人置顶和稍后处理，字段独立版本，成员代次隔离';\n-- CHAT_END preferences\n\nCREATE TABLE IF NOT EXISTS `chat_image_uploads` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `actor_id` bigint(20) unsigned NOT NULL,\n `conversation_id` bigint(20) unsigned NOT NULL,\n `upload_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `object_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `source_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `declared_bytes` bigint(20) unsigned NOT NULL,\n `state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `attempts` tinyint(3) unsigned NOT NULL DEFAULT 0,\n `lease_owner` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `lease_until` datetime(6) DEFAULT NULL,\n `source_cleaned` tinyint(1) NOT NULL DEFAULT 0,\n `source_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `main_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `thumb_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `main_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `thumb_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `mime_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `width_px` int unsigned DEFAULT NULL,\n `height_px` int unsigned DEFAULT NULL,\n `method` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `qr_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `qr_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `anti_diversion_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `optional_ocr_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `legal_hold` tinyint(1) NOT NULL DEFAULT 0,\n `expires_at` datetime(6) NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n UNIQUE KEY `uq_chat_image_upload` (`actor_id`,`conversation_id`,`upload_id`),\n UNIQUE KEY `uq_chat_image_object` (`object_version`),\n KEY `idx_chat_image_work` (`state`,`lease_until`,`id`),\n KEY `idx_chat_image_quota` (`actor_id`,`expires_at`),\n CONSTRAINT `fk_chat_image_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写私有图片任务；对象不可覆盖；原图临时保留';\n\nCREATE TABLE IF NOT EXISTS `chat_image_bundles` (\n `intent_id` bigint(20) unsigned NOT NULL,\n `principal_json` text COLLATE utf8mb4_unicode_ci NOT NULL,\n `manifest_json` text COLLATE utf8mb4_unicode_ci NOT NULL,\n `manifest_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `revision` int unsigned NOT NULL,\n `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `review_state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `review_version` bigint(20) unsigned NOT NULL DEFAULT 1,\n `reviewer_id` bigint(20) unsigned DEFAULT NULL,\n `review_lease_until` datetime(6) DEFAULT NULL,\n `general_safety_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `anti_diversion_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `review_reason` varchar(600) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n `submitted_at` datetime(6) NOT NULL,\n `expires_at` datetime(6) NOT NULL,\n PRIMARY KEY (`intent_id`),\n KEY `idx_chat_image_review` (`review_state`,`submitted_at`,`intent_id`),\n CONSTRAINT `fk_chat_image_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写已确认图片发送及整组人工预审；选择上传不建立意图';\n\nCREATE TABLE IF NOT EXISTS `chat_image_items` (\n `message_id` bigint(20) unsigned NOT NULL,\n `item_id` bigint(20) unsigned NOT NULL,\n `ordinal` tinyint(3) unsigned NOT NULL,\n `object_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n PRIMARY KEY (`message_id`,`item_id`),\n UNIQUE KEY `uq_chat_image_ordinal` (`message_id`,`ordinal`),\n KEY `idx_chat_image_reference` (`item_id`),\n CONSTRAINT `fk_chat_image_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`),\n CONSTRAINT `fk_chat_image_item` FOREIGN KEY (`item_id`) REFERENCES `chat_image_uploads` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='一个图片消息下有序不可变条目；item_id为附件ID';\n\nCREATE TABLE IF NOT EXISTS `chat_image_audit` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `intent_id` bigint(20) unsigned NOT NULL,\n `admin_id` bigint(20) unsigned NOT NULL,\n `action` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `item_id` bigint(20) unsigned DEFAULT NULL,\n `review_version` bigint(20) unsigned NOT NULL,\n `manifest_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `reason` varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n KEY `idx_chat_image_audit` (`intent_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go追加图片预审/取件审计，无URL或原文';\n\nCREATE TABLE IF NOT EXISTS `chat_image_objects` (\n `object_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `upload_id` bigint(20) unsigned NOT NULL,\n `sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`object_key`),\n KEY `idx_chat_image_object_age` (`created_at`,`upload_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go处理件清理账本，网络写入前登记';\n\nCREATE TABLE IF NOT EXISTS `chat_image_reports` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `reporter_id` bigint(20) unsigned NOT NULL,\n `conversation_id` bigint(20) unsigned NOT NULL,\n `message_id` bigint(20) unsigned NOT NULL,\n `item_id` bigint(20) unsigned NOT NULL DEFAULT 0,\n `reason` varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n `state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n UNIQUE KEY `uq_chat_image_report` (`reporter_id`,`message_id`,`item_id`),\n KEY `idx_chat_image_report_queue` (`state`,`created_at`,`id`),\n CONSTRAINT `fk_chat_image_report_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go图片单图或整组举报，保留条目顺序，S19接续治理';\n","server/database/upgrades/2.7.0.sql":"-- V2.7.0：从已发布2.6.0升级的聊天整包；S01～S09共用一个未发布版本。\n-- 不开启功能、不回填订单、不发送通知；DDL失败保持维护态，不自动整段重跑。\n\n-- CHAT_SECTION identity\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\n\nCREATE TABLE IF NOT EXISTS `chat_admin_sessions` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '聊天后台会话ID',\n  `admin_id` bigint(20) unsigned NOT NULL COMMENT '原后台管理员ID',\n  `session_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '环境绑定的PHP Session摘要',\n  `session_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '随机会话撤销版本',\n  `authority_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '角色密码及scope快照摘要',\n  `scopes_json` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '限权scope JSON数组',\n  `expires_at` datetime NOT NULL COMMENT '最晚凭证到期时间UTC',\n  `revoked_at` datetime DEFAULT NULL COMMENT '原Session登出或撤销时间UTC',\n  `created_at` datetime NOT NULL COMMENT '创建时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_admin_session_hash` (`session_hash`),\n  KEY `idx_chat_admin_actor_expiry` (`admin_id`,`expires_at`),\n  KEY `idx_chat_admin_expiry` (`expires_at`),\n  CONSTRAINT `fk_chat_admin_actor` FOREIGN KEY (`admin_id`) REFERENCES `admin_users` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP后台聊天凭证会话，Go只读';\n\n-- 同步撤销所有PHP账号写入口（含SQL维护）；不向Go授予后台密码表读取权限。\n-- 单语句trigger，无DELIMITER/BEGIN语法；原账号修改与撤销属于同一MySQL事务。\nDROP TRIGGER IF EXISTS `chat_admin_identity_revoke`;\nCREATE TRIGGER `chat_admin_identity_revoke` AFTER UPDATE ON `admin_users`\nFOR EACH ROW UPDATE `chat_admin_sessions`\nSET `revoked_at`=COALESCE(`revoked_at`,UTC_TIMESTAMP())\nWHERE `admin_id`=NEW.id AND `revoked_at` IS NULL\n  AND (NOT (OLD.role <=> NEW.role) OR NOT (OLD.status <=> NEW.status)\n       OR NOT (OLD.password_hash <=> NEW.password_hash)\n       OR NOT (OLD.must_change_password <=> NEW.must_change_password));\n-- CHAT_END identity\n\n-- CHAT_SECTION policy\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_policy_guards` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '栅栏ID',\n  `scope_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '订单与不可变指派代次',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '不可变指派ID',\n  `policy_version` bigint(20) unsigned NOT NULL COMMENT '同scope单调权限版本',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'open可发或readonly只读',\n  `active_order_id` bigint(20) unsigned GENERATED ALWAYS AS (IF(`state`='open',`order_id`,NULL)) STORED COMMENT '同订单仅一个可发scope',\n  `snapshot_json` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'PHP权威身份与授权区间快照',\n  `snapshot_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '无版本快照指纹用于幂等',\n  `updated_at` datetime NOT NULL COMMENT '更新时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_policy_scope` (`scope_key`),\n  UNIQUE KEY `uq_chat_policy_active_order` (`active_order_id`),\n  KEY `idx_chat_policy_order` (`order_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP单写订单聊天权限栅栏，Go只读和取共享锁';\n\nCREATE TABLE IF NOT EXISTS `chat_business_events` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '扫描定位ID，不等于已提交水位',\n  `event_id` char(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '随机稳定业务事件ID',\n  `aggregate_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '会话作用域',\n  `aggregate_version` bigint(20) unsigned NOT NULL COMMENT '该scope权限版本',\n  `schema_version` int(10) unsigned NOT NULL COMMENT '事件协议版本',\n  `event_type` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '事件类型',\n  `payload_json` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '版本化完整授权快照',\n  `created_at` datetime NOT NULL COMMENT '提交时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_business_event` (`event_id`),\n  UNIQUE KEY `uq_chat_business_scope_version` (`aggregate_key`,`aggregate_version`),\n  KEY `idx_chat_business_created` (`created_at`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP订单事务事件，Go不修改消费状态';\n-- CHAT_END policy\n\n-- CHAT_SECTION repair\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_repair_episodes` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '不可变售后受理代次',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '受理时不可变指派ID',\n  `after_sale_id` bigint(20) unsigned NOT NULL COMMENT '售后申请ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '明确受理的师傅ID',\n  `accepted_user_id` bigint(20) unsigned NOT NULL COMMENT '师傅对应真实小程序用户ID',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'active或closed，closed不复活',\n  `active_order_id` bigint(20) unsigned GENERATED ALWAYS AS (IF(`state`='active',`order_id`,NULL)) STORED COMMENT '同订单仅一个有效受理区间',\n  `accepted_at` datetime NOT NULL COMMENT '原受理事务内UTC时间',\n  `closed_at` datetime DEFAULT NULL COMMENT '结束UTC时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_repair_active_order` (`active_order_id`),\n  KEY `idx_chat_repair_request` (`order_id`,`after_sale_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP单写售后明确受理事实，不从processing或事件文字推断授权';\n-- CHAT_END repair\n\n-- CHAT_SECTION staff\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\n\n-- 修复历史新装基线遗漏的平台专属表；已有升级库保持原表及资金数据。\nCREATE TABLE IF NOT EXISTS `order_platform_terms` (\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `customer_flow_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'platform_managed' COMMENT '客户参与方式：platform_managed平台托管、miniapp_booking小程序预约',\n  `customer_pricing_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'fixed_total' COMMENT '客户计价方式：fixed_total固定总价、itemized明细计价',\n  `customer_contract_total_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户当前最终成交金额（分）',\n  `worker_settlement_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'worker_collect' COMMENT '师傅工费结算：worker_collect师傅代收、platform_balance平台余额',\n  `worker_labor_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '当前最终师傅工费（分）',\n  `extra_income_rate_bp_snapshot` int(10) unsigned NOT NULL DEFAULT '2000' COMMENT '订单外加项平台收入比例快照（万分比）',\n  `booking_paid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '最终结算时平台已收预约费快照（分）',\n  `customer_tail_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户现场剩余应付（分）',\n  `platform_receivable_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '平台收入款待收金额（分）',\n  `worker_balance_credit_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '应进入师傅余额金额（分）',\n  `worker_balance_freeze_days_snapshot` smallint(5) unsigned NOT NULL DEFAULT '0' COMMENT '师傅余额冻结天数快照',\n  `settlement_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '平台承接单结算状态',\n  `settled_at` datetime DEFAULT NULL COMMENT '结算完成时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`order_id`),\n  KEY `idx_platform_terms_settlement` (`settlement_status`,`updated_at`),\n  CONSTRAINT `fk_platform_terms_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单专属计价与结算条件';\n\nCREATE TABLE IF NOT EXISTS `order_pricing_items` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `item_source` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'base' COMMENT '明细来源：base基础开单、change订单外加项',\n  `change_request_id` bigint(20) unsigned DEFAULT NULL COMMENT '关联费用调整申请ID',\n  `description` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '施工项目/描述',\n  `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '项目说明',\n  `quantity` decimal(12,3) DEFAULT NULL COMMENT '数量/实际用量',\n  `unit` varchar(24) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '计价单位',\n  `unit_price_cents` bigint(20) unsigned DEFAULT NULL COMMENT '单价（分）',\n  `amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '项目金额（分）',\n  `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  KEY `idx_pricing_items_order_sort` (`order_id`,`status`,`sort_order`,`id`),\n  KEY `idx_pricing_items_change` (`change_request_id`),\n  CONSTRAINT `fk_pricing_items_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_pricing_items_change` FOREIGN KEY (`change_request_id`) REFERENCES `change_requests` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单结构化开单明细';\n\nCREATE TABLE IF NOT EXISTS `platform_order_refund_reviews` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '退款财务复核单ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '关联平台承接订单ID',\n  `refund_id` bigint(20) unsigned NOT NULL COMMENT '原真实退款单ID（一退款只处理一次）',\n  `refund_amount_cents` bigint(20) unsigned NOT NULL COMMENT '建档时退款成功金额快照（分）',\n  `worker_labor_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时师傅工费快照（分）',\n  `worker_balance_credit_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时实际应入师傅余额快照（分）',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT 'open待判责、awaiting_recovery待实际追偿、resolved核账结束',\n  `responsibility` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'undetermined' COMMENT 'undetermined待定、platform平台、worker师傅、shared分担',\n  `worker_recovery_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '人工判定应由师傅补交金额（分）',\n  `recovered_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已核对真实到账的线下追偿累计金额（分）',\n  `decision_note` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '责任判定的事实依据',\n  `recovery_reference` varchar(120) COLLATE utf8mb4_bin DEFAULT NULL COMMENT '最近一次已核实的追偿交易流水号（完整逐笔凭证见人工收款台账）',\n  `recovery_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '线下真实追偿核验说明',\n  `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '发起核账管理员ID',\n  `decided_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '判责管理员ID',\n  `resolved_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核实结清管理员ID',\n  `created_at` datetime NOT NULL COMMENT '建档时间',\n  `decided_at` datetime DEFAULT NULL COMMENT '判责时间',\n  `resolved_at` datetime DEFAULT NULL COMMENT '核账结束时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_platform_refund_review_refund` (`refund_id`),\n  UNIQUE KEY `uq_platform_refund_review_recovery` (`recovery_reference`),\n  KEY `idx_platform_refund_review_order_status` (`order_id`,`status`),\n  KEY `idx_platform_refund_review_status_created` (`status`,`created_at`),\n  CONSTRAINT `fk_platform_refund_review_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_platform_refund_review_refund` FOREIGN KEY (`refund_id`) REFERENCES `refunds` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台单已验收后退款资金判责与线下追偿人工核账';\n\nCREATE TABLE IF NOT EXISTS `platform_order_manual_receipts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '实际外部收款凭证ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '所属平台订单',\n  `refund_review_id` bigint(20) unsigned DEFAULT NULL COMMENT '追偿对应退款复核单；平台收入款时为空',\n  `income_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '仅平台收入款填写的订单ID，唯一防重复核销',\n  `receipt_kind` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'platform_income平台收入款、refund_recovery退款追偿',\n  `amount_cents` bigint(20) unsigned NOT NULL COMMENT '本笔人工核验实际到账分数',\n  `payment_reference` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '银行或第三方支付实际收款编号；全类型唯一',\n  `verification_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '人工核实凭据及渠道说明',\n  `verified_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核验管理员ID',\n  `verified_at` datetime NOT NULL COMMENT '实际核验记录时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_manual_receipt_reference` (`payment_reference`),\n  UNIQUE KEY `uq_manual_income_order` (`income_order_id`),\n  KEY `idx_manual_receipt_review` (`refund_review_id`,`verified_at`),\n  KEY `idx_manual_receipt_order` (`order_id`,`verified_at`),\n  CONSTRAINT `fk_manual_receipt_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_manual_receipt_review` FOREIGN KEY (`refund_review_id`) REFERENCES `platform_order_refund_reviews` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台外部收款人工核验逐笔凭证，不代表微信支付或钱包入账';\n\nCREATE TABLE IF NOT EXISTS `chat_staff_authority_versions` (\n  `user_id` bigint(20) unsigned NOT NULL COMMENT '0为管理员配置，其余为真实用户；删除后保留代次',\n  `authority_version` bigint(20) unsigned NOT NULL DEFAULT 1 COMMENT '只增不减，移除再加入不得复用',\n  PRIMARY KEY (`user_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP权限源同事务更新，Go取共享锁校验';\nINSERT IGNORE INTO `chat_staff_authority_versions` (`user_id`,`authority_version`) VALUES (0,1);\nINSERT IGNORE INTO `chat_staff_authority_versions` (`user_id`,`authority_version`) SELECT id,1 FROM users;\n\nCREATE TABLE IF NOT EXISTS `chat_policy_refresh` (\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID，不存消息内容',\n  `checked_at` datetime NOT NULL COMMENT '上次检查UTC',\n  `next_check_at` datetime NOT NULL COMMENT '下一次可检查UTC',\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'success或failed',\n  PRIMARY KEY (`order_id`),\n  KEY `idx_chat_policy_refresh_due` (`next_check_at`,`order_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PHP授权投影恢复游标，不承担即时撤权';\n\n-- 单语句触发器，覆盖Web/小程序/CLI/SQL维护，且回滚与原身份写入一致。\nDROP TRIGGER IF EXISTS `chat_staff_settings_insert`;\nCREATE TRIGGER `chat_staff_settings_insert` AFTER INSERT ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND NEW.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid');\nDROP TRIGGER IF EXISTS `chat_staff_settings_update`;\nCREATE TRIGGER `chat_staff_settings_update` AFTER UPDATE ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND (OLD.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid') OR NEW.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid'))\nAND (NOT (BINARY OLD.setting_key <=> BINARY NEW.setting_key) OR NOT (BINARY OLD.setting_value <=> BINARY NEW.setting_value) OR NOT (BINARY OLD.value_type <=> BINARY NEW.value_type));\nDROP TRIGGER IF EXISTS `chat_staff_settings_delete`;\nCREATE TRIGGER `chat_staff_settings_delete` AFTER DELETE ON `system_settings`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id=0 AND OLD.setting_key IN ('wechat.admin_openids','wechat.miniapp_appid');\nDROP TRIGGER IF EXISTS `chat_staff_user_insert`;\nCREATE TRIGGER `chat_staff_user_insert` AFTER INSERT ON `users`\nFOR EACH ROW INSERT INTO chat_staff_authority_versions(user_id,authority_version) VALUES(NEW.id,1)\nON DUPLICATE KEY UPDATE authority_version=authority_version+1;\nDROP TRIGGER IF EXISTS `chat_staff_user_update`;\nCREATE TRIGGER `chat_staff_user_update` AFTER UPDATE ON `users`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id IN (OLD.id,NEW.id) AND (NOT (OLD.id <=> NEW.id) OR NOT (OLD.status <=> NEW.status));\nDROP TRIGGER IF EXISTS `chat_staff_user_delete`;\nCREATE TRIGGER `chat_staff_user_delete` AFTER DELETE ON `users`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=OLD.id;\nDROP TRIGGER IF EXISTS `chat_staff_wechat_insert`;\nCREATE TRIGGER `chat_staff_wechat_insert` AFTER INSERT ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=NEW.user_id;\nDROP TRIGGER IF EXISTS `chat_staff_wechat_update`;\nCREATE TRIGGER `chat_staff_wechat_update` AFTER UPDATE ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1\nWHERE user_id IN (OLD.user_id,NEW.user_id)\nAND (NOT (OLD.user_id <=> NEW.user_id) OR NOT (OLD.app_id <=> NEW.app_id) OR NOT (OLD.openid <=> NEW.openid) OR NOT (OLD.status <=> NEW.status));\nDROP TRIGGER IF EXISTS `chat_staff_wechat_delete`;\nCREATE TRIGGER `chat_staff_wechat_delete` AFTER DELETE ON `wechat_identities`\nFOR EACH ROW UPDATE chat_staff_authority_versions SET authority_version=authority_version+1 WHERE user_id=OLD.user_id;\n-- CHAT_END staff\n\n-- CHAT_SECTION conversation\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_conversations` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立会话ID，不等于订单ID',\n  `conversation_type` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前仅order',\n  `scope_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP提供的不可变订单指派作用域',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '可信订单绑定，不直接授予权限',\n  `assignment_id` bigint(20) unsigned NOT NULL COMMENT '不可变指派绑定',\n  `policy_version` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已连续应用的PHP权限版本',\n  `snapshot_hash` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '已应用快照指纹',\n  `episode_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP授权业务区间代次',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'open或readonly；pending仅事务内',\n  `created_at` datetime(6) NOT NULL COMMENT '建立时间UTC',\n  `updated_at` datetime(6) NOT NULL COMMENT '投影更新时间UTC，不是消息活跃时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_conversation_scope` (`conversation_type`,`scope_key`),\n  UNIQUE KEY `uq_chat_conversation_binding` (`conversation_type`,`order_id`,`assignment_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写独立会话与可信业务绑定';\n\nCREATE TABLE IF NOT EXISTS `chat_members` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实用户ID，当前仅小程序身份',\n  `actor_kind` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前仅mini，不接受后台审计成员',\n  `role` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'customer/worker/platform_staff',\n  `member_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '包含episode和工作人员配置/用户代次',\n  `can_read` tinyint(1) NOT NULL COMMENT '最近应用快照的读取资格，仍需当前栅栏交集',\n  `can_send` tinyint(1) NOT NULL COMMENT '最近应用快照的发送资格，仍需当前栅栏交集',\n  PRIMARY KEY (`conversation_id`,`actor_id`),\n  KEY `idx_chat_member_actor` (`actor_id`,`can_read`,`conversation_id`),\n  CONSTRAINT `fk_chat_member_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写当前成员投影，不复制用户账号';\n\nCREATE TABLE IF NOT EXISTS `chat_member_intervals` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实用户ID',\n  `member_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '不可变授权身份代次',\n  `start_version` bigint(20) unsigned NOT NULL COMMENT '可读消息权限版本下界，包含',\n  `end_version` bigint(20) unsigned DEFAULT NULL COMMENT '可读消息权限版本上界，不包含；空表示尚未闭合',\n  `open_actor_id` bigint(20) unsigned GENERATED ALWAYS AS (IF(`end_version` IS NULL,`actor_id`,NULL)) STORED COMMENT '每会话每人最多一个未闭合区间',\n  PRIMARY KEY (`conversation_id`,`actor_id`,`start_version`),\n  UNIQUE KEY `uq_chat_interval_open` (`conversation_id`,`open_actor_id`),\n  CONSTRAINT `fk_chat_interval_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写历史授权版本区间，禁止用处理时seq补权';\n\nCREATE TABLE IF NOT EXISTS `chat_event_receipts` (\n  `event_id` char(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'PHP原始不可变事件ID',\n  `aggregate_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原始会话作用域',\n  `aggregate_version` bigint(20) unsigned NOT NULL COMMENT '原始PHP权限版本',\n  `payload_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '领取时原始事件指纹',\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'processing/retry/done/rejected',\n  `attempts` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '领取次数，有界递增',\n  `lease_owner` char(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '每次领取随机独立所有者',\n  `lease_until` datetime(6) DEFAULT NULL COMMENT '服务端租约截止UTC',\n  `next_attempt_at` datetime(6) NOT NULL COMMENT '失败退避后可重试时间UTC',\n  `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '稳定诊断码，不存正文或SQL',\n  `completed_at` datetime(6) DEFAULT NULL COMMENT '与会话投影同事务完成UTC',\n  PRIMARY KEY (`event_id`),\n  UNIQUE KEY `uq_chat_receipt_scope_version` (`aggregate_key`,`aggregate_version`),\n  KEY `idx_chat_receipt_retry` (`status`,`next_attempt_at`),\n  KEY `idx_chat_receipt_lease` (`status`,`lease_until`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写消费回执/租约，PHP事件表只读';\n-- CHAT_END conversation\n\n-- CHAT_SECTION messages\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\n\nSET @chat_s06_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_conversations' AND COLUMN_NAME='last_seq')=0, 'ALTER TABLE `chat_conversations` ADD COLUMN `last_seq` bigint(20) unsigned NOT NULL DEFAULT ''0'' COMMENT ''同会话已提交封闭消息高水位''', 'SELECT 1');\nPREPARE chat_s06_stmt FROM @chat_s06_ddl;\nEXECUTE chat_s06_stmt;\nDEALLOCATE PREPARE chat_s06_stmt;\n\nSET @chat_s06_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_conversations' AND COLUMN_NAME='last_change_seq')=0, 'ALTER TABLE `chat_conversations` ADD COLUMN `last_change_seq` bigint(20) unsigned NOT NULL DEFAULT ''0'' COMMENT ''同会话已提交封闭变更高水位''', 'SELECT 1');\nPREPARE chat_s06_stmt FROM @chat_s06_ddl;\nEXECUTE chat_s06_stmt;\nDEALLOCATE PREPARE chat_s06_stmt;\n\nSET @chat_s06_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_conversations' AND COLUMN_NAME='last_message_id')=0, 'ALTER TABLE `chat_conversations` ADD COLUMN `last_message_id` bigint(20) unsigned DEFAULT NULL COMMENT ''最后正式消息ID，无待审占位''', 'SELECT 1');\nPREPARE chat_s06_stmt FROM @chat_s06_ddl;\nEXECUTE chat_s06_stmt;\nDEALLOCATE PREPARE chat_s06_stmt;\n\nSET @chat_s06_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_conversations' AND COLUMN_NAME='last_message_at')=0, 'ALTER TABLE `chat_conversations` ADD COLUMN `last_message_at` datetime(6) DEFAULT NULL COMMENT ''最后正式消息提交UTC''', 'SELECT 1');\nPREPARE chat_s06_stmt FROM @chat_s06_ddl;\nEXECUTE chat_s06_stmt;\nDEALLOCATE PREPARE chat_s06_stmt;\n\nCREATE TABLE IF NOT EXISTS `chat_restrictions` (\n  `actor_id` bigint(20) unsigned NOT NULL COMMENT '真实mini用户ID，永久稳定锁行，不得删除',\n  `permanent` tinyint(1) NOT NULL DEFAULT '0' COMMENT '永久禁发；不限制合法查询与原业务',\n  `blocked_until` datetime(6) DEFAULT NULL COMMENT '限时禁发截止UTC，空且非永久表示未限制',\n  `version` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '限制变更单调代次，后续管理写入需递增',\n  `updated_at` datetime(6) NOT NULL COMMENT '限制更新时间UTC',\n  PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写账号发送限制与稳定锁，不能按有无禁令加锁';\n\nCREATE TABLE IF NOT EXISTS `chat_send_intents` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '服务端发送意图ID',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '授权会话ID',\n  `client_message_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '10位Unix秒点32位小写hex随机数，不随重试变化',\n  `fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '版本化完整正文结构SHA256，不存被拒绝正文',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'checking/retryable/rejected/accepted',\n  `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '安全稳定诊断码，无规则证据',\n  `message_id` bigint(20) unsigned DEFAULT NULL COMMENT '已提交正式消息ID，拒绝为空',\n  `lease_owner` char(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '当前检查随机所有者，旧所有者不能发布',\n  `lease_until` datetime(6) DEFAULT NULL COMMENT '10秒有界审核所有权截止UTC',\n  `attempts` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '最多8次检查尝试，耗尽不自动换ID补发',\n  `action_expires_at` datetime(6) NOT NULL COMMENT 'ID创建秒加24小时，发布前再次校验',\n  `retain_until` datetime(6) NOT NULL COMMENT '至少动作截止后30天；独立于正文TTL，本阶段不清理',\n  `created_at` datetime(6) NOT NULL COMMENT '首次创建UTC',\n  `updated_at` datetime(6) NOT NULL COMMENT '状态更新时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_send_client` (`sender_id`,`conversation_id`,`client_message_id`),\n  KEY `idx_chat_send_pending` (`sender_id`,`state`,`lease_until`),\n  KEY `idx_chat_send_retention` (`retain_until`),\n  CONSTRAINT `fk_chat_send_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写发送意图与最小幂等结果，审核中不占消息seq';\n\nCREATE TABLE IF NOT EXISTS `chat_messages` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立正式消息ID，对外字符串',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `seq` bigint(20) unsigned NOT NULL COMMENT '会话锁内按提交顺序分配，拒绝不占号',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `client_message_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原客户端动作ID',\n  `policy_version` bigint(20) unsigned NOT NULL COMMENT '最终提交时PHP权限版本，不可回填改写',\n  `message_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '本阶段仅text',\n  `text_body` text COLLATE utf8mb4_unicode_ci COMMENT '原始UTF8正文，普通查询必须按安全状态过滤',\n  `state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'published/recalled/blocked，普通结果不返回正文',\n  `state_version` bigint(20) unsigned NOT NULL DEFAULT '1' COMMENT '安全状态单调版本',\n  `safety_rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '通过必需审核的版本',\n  `created_at` datetime(6) NOT NULL COMMENT '正式发布UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_message_seq` (`conversation_id`,`seq`),\n  UNIQUE KEY `uq_chat_message_client` (`sender_id`,`conversation_id`,`client_message_id`),\n  CONSTRAINT `fk_chat_message_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写已提交消息，无审核占位，历史按权限版本裁剪';\n\nCREATE TABLE IF NOT EXISTS `chat_message_changes` (\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '所属会话ID',\n  `change_seq` bigint(20) unsigned NOT NULL COMMENT '会话共享提交锁内分配的封闭变更游标',\n  `message_id` bigint(20) unsigned NOT NULL COMMENT '变更所属正式消息ID',\n  `state_version` bigint(20) unsigned NOT NULL COMMENT '消息安全状态版本',\n  `change_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '当前message.accepted，后续撤回等同事务追加',\n  `created_at` datetime(6) NOT NULL COMMENT '提交UTC',\n  PRIMARY KEY (`conversation_id`,`change_seq`),\n  CONSTRAINT `fk_chat_change_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`),\n  CONSTRAINT `fk_chat_change_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写消息安全变更，S08再接同步分页接口';\n-- CHAT_END messages\n\n-- CHAT_SECTION moderation\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\n\nSET @chat_s07_ddl=IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_send_intents' AND COLUMN_NAME='risk_event_id')=0,'ALTER TABLE `chat_send_intents` ADD COLUMN `risk_event_id` bigint(20) unsigned DEFAULT NULL COMMENT ''风险或疑似复核事件ID，仅本人最小结果返回，不展开证据''','SELECT 1');\nPREPARE chat_s07_stmt FROM @chat_s07_ddl;\nEXECUTE chat_s07_stmt;\nDEALLOCATE PREPARE chat_s07_stmt;\n\nCREATE TABLE IF NOT EXISTS `chat_text_checks` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '短窗口检查顺序，同作者稳定锁内登记',\n  `intent_id` bigint(20) unsigned NOT NULL COMMENT '逻辑发送动作ID，重试不追加片段',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '仅限本会话上下文，不跨群跟踪',\n  `fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '完整不可变发送内容指纹',\n  `normalized_text` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '受限业务短窗口证据，不进入普通日志或普通API',\n  `cache_key` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '环境AppID身份代次场景规则及指纹联合去重键',\n  `pass_until` datetime(6) DEFAULT NULL COMMENT '仅明确官方pass缓存五分钟，不延长原判定',\n  `created_at` datetime(6) NOT NULL COMMENT '首次动作登记UTC，重试不刷新窗口',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_text_intent` (`intent_id`),\n  KEY `idx_chat_text_context` (`sender_id`,`conversation_id`,`created_at`,`id`),\n  KEY `idx_chat_text_pass` (`cache_key`,`pass_until`),\n  KEY `idx_chat_text_expiry` (`created_at`),\n  CONSTRAINT `fk_chat_text_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写两分钟最近五动作检测，十分钟后有界清理';\n\nCREATE TABLE IF NOT EXISTS `chat_risk_events` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '独立风险事件ID，仅作者安全结果可引用',\n  `intent_id` bigint(20) unsigned NOT NULL COMMENT '逻辑发送动作唯一，不因重试累计违规',\n  `sender_id` bigint(20) unsigned NOT NULL COMMENT '真实mini发送者ID',\n  `conversation_id` bigint(20) unsigned NOT NULL COMMENT '原会话ID',\n  `content_fingerprint` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原始完整内容结构指纹',\n  `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '完整检测规则版本',\n  `provider` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '官方内容安全或本地私单检测来源',\n  `reason_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '稳定规则码，不向普通接口输出命中详情',\n  `provider_trace` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '受限供应商追踪标识，不存整包响应',\n  `risk_level` tinyint(3) unsigned NOT NULL COMMENT '1疑似待复核，2明确拦截；不直接作财务处置',\n  `confirmed` tinyint(1) NOT NULL COMMENT '仅明确拦截记确认风险；审核故障不建风险',\n  `disposition` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'rejected或review_pending，不自动补发',\n  `review_state` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT 'S19复核接续状态，当前无处理接口',\n  `text_evidence` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原文只在受控业务证据中，未来独立权限审计读取',\n  `context_evidence` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '仅拆条命中的有界上下文，含动作ID指纹和规范化片段；普通接口不展开',\n  `retain_until` datetime(6) NOT NULL COMMENT '至少覆盖原动作最小结果保留窗，当前不清理证据',\n  `created_at` datetime(6) NOT NULL COMMENT '与发送者终态同事务提交UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_chat_risk_intent` (`intent_id`),\n  KEY `idx_chat_risk_actor` (`sender_id`,`confirmed`,`created_at`),\n  KEY `idx_chat_risk_review` (`review_state`,`created_at`,`id`),\n  CONSTRAINT `fk_chat_risk_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写风险证据和复核接续；普通API不返回原文，不自动罚款封号';\n-- CHAT_END moderation\n\n-- CHAT_SECTION history\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\n\nSET @chat_s08_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_conversations' AND COLUMN_NAME='sync_floor_seq')=0, 'ALTER TABLE `chat_conversations` ADD COLUMN `sync_floor_seq` bigint(20) unsigned NOT NULL DEFAULT ''0'' COMMENT ''消息补收已清理范围上界，不含可补收起点''', 'SELECT 1');\nPREPARE chat_s08_stmt FROM @chat_s08_ddl;\nEXECUTE chat_s08_stmt;\nDEALLOCATE PREPARE chat_s08_stmt;\n\nSET @chat_s08_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_conversations' AND COLUMN_NAME='change_floor_seq')=0, 'ALTER TABLE `chat_conversations` ADD COLUMN `change_floor_seq` bigint(20) unsigned NOT NULL DEFAULT ''0'' COMMENT ''安全变更已清理范围上界，不含可补收起点''', 'SELECT 1');\nPREPARE chat_s08_stmt FROM @chat_s08_ddl;\nEXECUTE chat_s08_stmt;\nDEALLOCATE PREPARE chat_s08_stmt;\n-- CHAT_END history\n\n-- CHAT_SECTION read\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_member_reads` (\n `conversation_id` bigint(20) unsigned NOT NULL,\n `actor_id` bigint(20) unsigned NOT NULL,\n `member_key_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `read_seq` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`conversation_id`,`actor_id`),\n CONSTRAINT `fk_chat_read_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写会话已读水位，身份代次隔离';\n\nSET @chat_unread_ddl = IF((SELECT COUNT(*) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_messages' AND INDEX_NAME='idx_chat_unread')=0, 'ALTER TABLE `chat_messages` ADD KEY `idx_chat_unread` (`conversation_id`,`state`,`seq`,`sender_id`,`policy_version`)', 'SELECT 1');\nPREPARE chat_unread_stmt FROM @chat_unread_ddl;\nEXECUTE chat_unread_stmt;\nDEALLOCATE PREPARE chat_unread_stmt;\n-- CHAT_END read\n\n-- CHAT_SECTION preferences\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_preference_accounts` (\n `actor_id` bigint(20) unsigned NOT NULL,\n `revision` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`actor_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写账号偏好修订与并发串行锁，不授予会话权限';\nCREATE TABLE IF NOT EXISTS `chat_user_preferences` (\n `conversation_id` bigint(20) unsigned NOT NULL,\n `actor_id` bigint(20) unsigned NOT NULL,\n `member_key_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `pinned` tinyint(1) NOT NULL DEFAULT 0,\n `pinned_version` bigint(20) unsigned NOT NULL DEFAULT 0,\n `later` tinyint(1) NOT NULL DEFAULT 0,\n `later_version` bigint(20) unsigned NOT NULL DEFAULT 0,\n `updated_at` datetime(6) NOT NULL,\n PRIMARY KEY (`conversation_id`,`actor_id`),\n KEY `idx_chat_preferences_actor` (`actor_id`,`pinned`,`conversation_id`),\n CONSTRAINT `fk_chat_preferences_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写本人置顶和稍后处理，字段独立版本，成员代次隔离';\n-- CHAT_END preferences\n\n-- CHAT_SECTION references\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nSET @chat_s15_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_messages' AND COLUMN_NAME='reply_to_message_id')=0, 'ALTER TABLE `chat_messages` ADD COLUMN `reply_to_message_id` bigint(20) unsigned DEFAULT NULL COMMENT ''同会话单层引用，仅服务端安全投影''', 'SELECT 1');\nPREPARE chat_s15_stmt FROM @chat_s15_ddl;\nEXECUTE chat_s15_stmt;\nDEALLOCATE PREPARE chat_s15_stmt;\n\nSET @chat_s15_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_messages' AND COLUMN_NAME='edited_from_recalled_message_id')=0, 'ALTER TABLE `chat_messages` ADD COLUMN `edited_from_recalled_message_id` bigint(20) unsigned DEFAULT NULL COMMENT ''同作者已撤回直接来源，不可变''', 'SELECT 1');\nPREPARE chat_s15_stmt FROM @chat_s15_ddl;\nEXECUTE chat_s15_stmt;\nDEALLOCATE PREPARE chat_s15_stmt;\n\nSET @chat_s15_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_messages' AND COLUMN_NAME='reedit_depth')=0, 'ALTER TABLE `chat_messages` ADD COLUMN `reedit_depth` tinyint(3) unsigned NOT NULL DEFAULT ''0'' COMMENT ''重新编辑来源深度，最多8''', 'SELECT 1');\nPREPARE chat_s15_stmt FROM @chat_s15_ddl;\nEXECUTE chat_s15_stmt;\nDEALLOCATE PREPARE chat_s15_stmt;\n\nSET @chat_s15_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_messages' AND COLUMN_NAME='recalled_at')=0, 'ALTER TABLE `chat_messages` ADD COLUMN `recalled_at` datetime(6) DEFAULT NULL COMMENT ''作者撤回提交UTC，正文仅受控证据留存''', 'SELECT 1');\nPREPARE chat_s15_stmt FROM @chat_s15_ddl;\nEXECUTE chat_s15_stmt;\nDEALLOCATE PREPARE chat_s15_stmt;\n\n-- CHAT_END references\n\n-- CHAT_SECTION images\nSET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS `chat_image_uploads` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `actor_id` bigint(20) unsigned NOT NULL,\n `conversation_id` bigint(20) unsigned NOT NULL,\n `upload_id` varchar(43) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `object_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `source_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `declared_bytes` bigint(20) unsigned NOT NULL,\n `state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `error_code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `attempts` tinyint(3) unsigned NOT NULL DEFAULT 0,\n `lease_owner` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `lease_until` datetime(6) DEFAULT NULL,\n `source_cleaned` tinyint(1) NOT NULL DEFAULT 0,\n `source_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `main_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `thumb_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `main_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `thumb_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `mime_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `width_px` int unsigned DEFAULT NULL,\n `height_px` int unsigned DEFAULT NULL,\n `method` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `qr_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `qr_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `anti_diversion_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `optional_ocr_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `legal_hold` tinyint(1) NOT NULL DEFAULT 0,\n `expires_at` datetime(6) NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n UNIQUE KEY `uq_chat_image_upload` (`actor_id`,`conversation_id`,`upload_id`),\n UNIQUE KEY `uq_chat_image_object` (`object_version`),\n KEY `idx_chat_image_work` (`state`,`lease_until`,`id`),\n KEY `idx_chat_image_quota` (`actor_id`,`expires_at`),\n CONSTRAINT `fk_chat_image_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `chat_conversations` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写私有图片任务；对象不可覆盖；原图临时保留';\n\nCREATE TABLE IF NOT EXISTS `chat_image_bundles` (\n `intent_id` bigint(20) unsigned NOT NULL,\n `principal_json` text COLLATE utf8mb4_unicode_ci NOT NULL,\n `manifest_json` text COLLATE utf8mb4_unicode_ci NOT NULL,\n `manifest_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `revision` int unsigned NOT NULL,\n `rule_version` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `review_state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `review_version` bigint(20) unsigned NOT NULL DEFAULT 1,\n `reviewer_id` bigint(20) unsigned DEFAULT NULL,\n `review_lease_until` datetime(6) DEFAULT NULL,\n `general_safety_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `anti_diversion_result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n `review_reason` varchar(600) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n `submitted_at` datetime(6) NOT NULL,\n `expires_at` datetime(6) NOT NULL,\n PRIMARY KEY (`intent_id`),\n KEY `idx_chat_image_review` (`review_state`,`submitted_at`,`intent_id`),\n CONSTRAINT `fk_chat_image_intent` FOREIGN KEY (`intent_id`) REFERENCES `chat_send_intents` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go单写已确认图片发送及整组人工预审；选择上传不建立意图';\n\nCREATE TABLE IF NOT EXISTS `chat_image_items` (\n `message_id` bigint(20) unsigned NOT NULL,\n `item_id` bigint(20) unsigned NOT NULL,\n `ordinal` tinyint(3) unsigned NOT NULL,\n `object_version` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n PRIMARY KEY (`message_id`,`item_id`),\n UNIQUE KEY `uq_chat_image_ordinal` (`message_id`,`ordinal`),\n KEY `idx_chat_image_reference` (`item_id`),\n CONSTRAINT `fk_chat_image_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`),\n CONSTRAINT `fk_chat_image_item` FOREIGN KEY (`item_id`) REFERENCES `chat_image_uploads` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='一个图片消息下有序不可变条目；item_id为附件ID';\n\nCREATE TABLE IF NOT EXISTS `chat_image_audit` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `intent_id` bigint(20) unsigned NOT NULL,\n `admin_id` bigint(20) unsigned NOT NULL,\n `action` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `item_id` bigint(20) unsigned DEFAULT NULL,\n `review_version` bigint(20) unsigned NOT NULL,\n `manifest_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `reason` varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n KEY `idx_chat_image_audit` (`intent_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go追加图片预审/取件审计，无URL或原文';\n\nSET @chat_s16_ddl = IF((SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='chat_messages' AND COLUMN_NAME='reply_to_item_id')=0, 'ALTER TABLE `chat_messages` ADD COLUMN `reply_to_item_id` bigint(20) unsigned DEFAULT NULL COMMENT ''同会话图片合集稳定条目引用''', 'SELECT 1');\nPREPARE chat_s16_stmt FROM @chat_s16_ddl;\nEXECUTE chat_s16_stmt;\nDEALLOCATE PREPARE chat_s16_stmt;\nCREATE TABLE IF NOT EXISTS `chat_image_objects` (\n `object_key` varchar(240) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `upload_id` bigint(20) unsigned NOT NULL,\n `sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`object_key`),\n KEY `idx_chat_image_object_age` (`created_at`,`upload_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go处理件清理账本，网络写入前登记';\n\nCREATE TABLE IF NOT EXISTS `chat_image_reports` (\n `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n `reporter_id` bigint(20) unsigned NOT NULL,\n `conversation_id` bigint(20) unsigned NOT NULL,\n `message_id` bigint(20) unsigned NOT NULL,\n `item_id` bigint(20) unsigned NOT NULL DEFAULT 0,\n `reason` varchar(600) COLLATE utf8mb4_unicode_ci NOT NULL,\n `state` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n `created_at` datetime(6) NOT NULL,\n PRIMARY KEY (`id`),\n UNIQUE KEY `uq_chat_image_report` (`reporter_id`,`message_id`,`item_id`),\n KEY `idx_chat_image_report_queue` (`state`,`created_at`,`id`),\n CONSTRAINT `fk_chat_image_report_message` FOREIGN KEY (`message_id`) REFERENCES `chat_messages` (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Go图片单图或整组举报，保留条目顺序，S19接续治理';\n\n-- CHAT_END images\n","server/app/Infrastructure/Persistence/DatabaseOrderConversationBridge.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Chat\\OrderConversationPolicy;\n\n/** Called inside the owning order transaction; never opens an independent transaction. */\nfinal class DatabaseOrderConversationBridge\n{\n    private Database $db;\n    private OrderConversationPolicy $policy;\n    private bool $enabled;\n    public function __construct(Database $db, bool $enabled=false)\n    { $this->db=$db;$this->enabled=$enabled;$this->policy=new OrderConversationPolicy(); }\n\n    /** Coalesce every event for this order until the original transaction's final facts exist. */\n    public function schedule(int $orderID): void\n    {\n        if (!$this->enabled) return;\n        if ($orderID<1) throw new RuntimeException('聊天授权订单编号无效');\n        $this->db->beforeCommit('chat-policy:'.$orderID,function()use($orderID):void{$this->synchronize($orderID);});\n    }\n\n    /** @return string[] changed scope keys; no messages/Go tables/notifications are written. */\n    public function synchronize(int $orderID,bool $apply=true): array\n    {\n        if ($apply && !$this->enabled) return [];\n        if ($orderID<1 || !$this->db->pdo()->inTransaction()) throw new RuntimeException('聊天授权必须加入原订单事务');\n        // Lock order first, then current authority reads, then the guard. Plain\n        // reads could reuse an earlier REPEATABLE READ snapshot and grant stale accounts.\n        $order=$this->db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE',['id'=>$orderID]);\n        if (!$order) throw new RuntimeException('聊天授权订单不存在');\n        $assignment=$this->db->fetch(\n            'SELECT a.*,CAST(w.user_id AS CHAR) worker_user_id,u.status worker_user_status\n             FROM assignments a JOIN worker_profiles w ON w.id=a.worker_id\n             JOIN users u ON u.id=w.user_id WHERE a.id=:id AND a.order_id=:order_id LIMIT 1 LOCK IN SHARE MODE',\n            ['id'=>$order['current_assignment_id'] ?? 0,'order_id'=>$orderID]\n        );\n        $customer=$this->db->fetch('SELECT status FROM users WHERE id=:id LIMIT 1 LOCK IN SHARE MODE',['id'=>$order['user_id']]);\n        $facts=[\n            'order_id'=>(string)$orderID,'customer_id'=>(string)$order['user_id'],\n            'customer_status'=>(string)($customer['status'] ?? ''),'is_demo'=>(int)$order['is_demo'],\n            'workflow_profile'=>(string)$order['workflow_profile'],'order_source_type'=>(string)$order['order_source_type'],\n            'lifecycle_status'=>(string)$order['lifecycle_status'],'payment_status'=>(string)$order['payment_status'],\n            'assignment_status'=>(string)$order['assignment_status'],\n            'current_assignment_id'=>(string)($order['current_assignment_id'] ?? ''),\n            'assigned_worker_id'=>(string)($order['assigned_worker_id'] ?? ''),\n            'assignment_id'=>(string)($assignment['id'] ?? ''),'assignment_order_id'=>(string)($assignment['order_id'] ?? ''),\n            'worker_id'=>(string)($assignment['worker_id'] ?? ''),'worker_user_id'=>(string)($assignment['worker_user_id'] ?? ''),\n            'worker_user_status'=>(string)($assignment['worker_user_status'] ?? ''),\n            'assignment_record_status'=>(string)($assignment['status'] ?? ''),'assignment_accepted_at'=>$assignment['accepted_at'] ?? null,\n        ];\n        if ($facts['order_source_type']==='platform') {\n            $terms=$this->db->fetch('SELECT customer_flow_mode FROM order_platform_terms WHERE order_id=:id LOCK IN SHARE MODE',['id'=>$orderID]);\n            $facts['customer_flow_mode']=(string)($terms['customer_flow_mode']??'');\n            $facts['booking_fee_cents']=(int)($order['booking_fee_cents']??-1);\n            $facts=array_merge($facts,(new DatabaseChatPlatformStaff($this->db))->readAuthorityLocked());\n        }\n        if($facts['lifecycle_status']==='completed' && $facts['workflow_profile']==='construction'\n            && in_array($facts['order_source_type'],['consumer','merchant','platform'],true)) {\n            $episode=$this->db->fetch(\n                'SELECT e.*,a.order_id repair_order_id,a.user_id repair_user_id,a.type repair_type,\n                    a.status repair_status,a.closed_at repair_closed_at\n                 FROM chat_repair_episodes e JOIN after_sales a ON a.id=e.after_sale_id\n                 WHERE e.active_order_id=:id LIMIT 1 LOCK IN SHARE MODE',['id'=>$orderID]\n            );\n            if($episode)$facts['repair_episode']=$episode;\n        }\n        $snapshot=$this->policy->evaluate($facts);\n        // Bounded display facts travel with the same immutable PHP authority hash.\n        $context=['public_no'=>(string)$order['public_no'],\n            'title'=>mb_substr((string)preg_replace('/[\\\\p{Cc}\\\\p{Cf}]+/u',' ',(string)($order['title']??'')),0,120,'UTF-8'),\n            'workflow'=>(string)$order['workflow_profile']];\n        $open=$this->db->fetch('SELECT * FROM chat_policy_guards WHERE active_order_id=:id FOR UPDATE',['id'=>$orderID]);\n        $changed=[];\n        if ($open && (!$snapshot || $open['scope_key'] !== $snapshot['scope_key'])) {\n            $closed=json_decode((string)$open['snapshot_json'],true,32,JSON_THROW_ON_ERROR);\n            $closed['state']='readonly';\n            $closed['order_context']=$context;\n            foreach ($closed['members'] as &$member) $member['can_send']=false;\n            unset($member);\n            if ($this->persist($closed,$open,$apply)) $changed[]=$closed['scope_key'];\n        }\n        if ($snapshot) {\n            $existing=$this->db->fetch('SELECT * FROM chat_policy_guards WHERE scope_key=:scope FOR UPDATE',['scope'=>$snapshot['scope_key']]);\n            $previous=$existing?json_decode((string)$existing['snapshot_json'],true,32,JSON_THROW_ON_ERROR):null;\n            // Never manufacture historical membership during a backfill/late event.\n            if (!$existing && $snapshot['state']==='readonly') return $changed;\n            // Keep the closing repair identity, rather than silently replacing it\n            // with the old service episode. S05 needs that precise boundary.\n            if($previous && $snapshot['state']==='readonly') {\n                $snapshot=$previous;$snapshot['state']='readonly';\n                foreach($snapshot['members'] as &$member)$member['can_send']=false;unset($member);\n            }\n            // Only an explicit, different accepted repair generation can reopen.\n            if ($existing && $existing['state']==='readonly' && $snapshot['state']==='open') {\n                $newRepair=isset($facts['repair_episode']) && $snapshot['episode_key']!==$previous['episode_key'];\n                if(!$newRepair){$snapshot=$previous;$snapshot['state']='readonly';foreach ($snapshot['members'] as &$member)$member['can_send']=false;unset($member);}\n            }\n            $snapshot['order_context']=$context;\n            if ($this->persist($snapshot,$existing,$apply)) $changed[]=$snapshot['scope_key'];\n        }\n        if($apply && $facts['order_source_type']==='platform') {\n            $this->db->execute(\"INSERT INTO chat_policy_refresh(order_id,checked_at,next_check_at,status)\n                VALUES(:id,UTC_TIMESTAMP(),UTC_TIMESTAMP()+INTERVAL 60 SECOND,'success')\n                ON DUPLICATE KEY UPDATE checked_at=VALUES(checked_at),next_check_at=VALUES(next_check_at),status='success'\",['id'=>$orderID]);\n        }\n        return $changed;\n    }\n\n    private function persist(array $snapshot, ?array $existing,bool $apply): bool\n    {\n        $json=json_encode($snapshot,JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);\n        if (strlen($json)>16384) throw new RuntimeException('聊天授权快照超过上限');\n        $hash=hash('sha256',$json);\n        if ($existing && hash_equals((string)$existing['snapshot_hash'],$hash)) return false;\n        if (!$apply) return true;\n        $params=['scope'=>$snapshot['scope_key'],'order_id'=>$snapshot['order_id'],'assignment_id'=>$snapshot['assignment_id'],\n            'state'=>$snapshot['state'],'json'=>$json,'hash'=>$hash];\n        if (!$existing) {\n            $this->db->execute('INSERT INTO chat_policy_guards(scope_key,order_id,assignment_id,policy_version,state,snapshot_json,snapshot_hash,updated_at)\n                VALUES(:scope,:order_id,:assignment_id,1,:state,:json,:hash,UTC_TIMESTAMP())',$params);\n        } else {\n            unset($params['order_id'],$params['assignment_id']);$params['expected']=(string)$existing['policy_version'];\n            $count=$this->db->execute('UPDATE chat_policy_guards SET state=:state,snapshot_json=:json,snapshot_hash=:hash,policy_version=policy_version+1,updated_at=UTC_TIMESTAMP()\n                WHERE scope_key=:scope AND policy_version=:expected',$params);\n            if ($count!==1) throw new RuntimeException('聊天授权版本已变化');\n        }\n        $version=(string)$this->db->fetchValue('SELECT CAST(policy_version AS CHAR) FROM chat_policy_guards WHERE scope_key=:scope',['scope'=>$snapshot['scope_key']]);\n        $payload=json_encode(['schema_version'=>1,'policy_version'=>$version,'snapshot'=>$snapshot],JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);\n        $this->db->execute(\"INSERT INTO chat_business_events(event_id,aggregate_key,aggregate_version,schema_version,event_type,payload_json,created_at)\n            VALUES(:event_id,:scope,:version,1,'chat.policy.changed',:payload,UTC_TIMESTAMP())\",\n            ['event_id'=>bin2hex(random_bytes(16)),'scope'=>$snapshot['scope_key'],'version'=>$version,'payload'=>$payload]);\n        return true;\n    }\n}\n","server/app/Contracts/NotificationInboxRepository.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Contracts;\ninterface NotificationInboxRepository\n{\n    public function summary(array $actor): array;\n    public function list(array $actor, int $page, string $throughId = ''): array;\n    public function read(array $actor, string $publicId): void;\n    public function readBatch(array $actor, array $ids): int;\n    public function readAll(array $actor, string $throughId = ''): void;\n}\n","server/app/Application/Messaging/NotificationInbox.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Messaging;\n\nuse WorkerAdmin\\Contracts\\NotificationInboxRepository;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOperationException;\n\nfinal class NotificationInbox\n{\n    private NotificationInboxRepository $repository;\n    public function __construct(NotificationInboxRepository $repository) { $this->repository = $repository; }\n    public function summary(array $actor): array { return $this->repository->summary($actor); }\n    public function list(array $actor, int $page, string $throughId = ''): array\n    {\n        if(strlen($throughId)>80)throw new MessageOperationException('通知范围无效','NOTIFICATION_RANGE_INVALID');\n        return $this->repository->list($actor,max(1,min(10000,$page)),trim($throughId));\n    }\n    public function read(array $actor, string $id): void\n    {\n        $id = trim($id);\n        if ($id === '') throw new MessageOperationException('请选择要查看的消息', 'NOTIFICATION_REQUIRED');\n        $this->repository->read($actor, $id);\n    }\n    public function readBatch(array $actor, array $rawIds): array\n    {\n        if (count($rawIds) > 50) throw new MessageOperationException('单次最多标记 50 条消息', 'NOTIFICATION_BATCH_LIMIT');\n        $ids = [];\n        foreach ($rawIds as $value) {\n            if (!is_scalar($value)) continue;\n            $value = trim((string)$value);\n            if ($value !== '' && !in_array($value, $ids, true)) $ids[] = $value;\n        }\n        if (!$ids) throw new MessageOperationException('请选择要查看的消息', 'NOTIFICATION_REQUIRED');\n        return ['updated_count' => $this->repository->readBatch($actor, $ids)];\n    }\n    public function readAll(array $actor, string $throughId = ''): void\n    {\n        if (strlen($throughId)>80) throw new MessageOperationException('通知范围无效','NOTIFICATION_RANGE_INVALID');\n        $this->repository->readAll($actor,trim($throughId));\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseNotificationInboxRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse DateTimeImmutable;\nuse DateTimeZone;\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\NotificationInboxRepository;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOperationException;\n\nfinal class DatabaseNotificationInboxRepository implements NotificationInboxRepository\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function summary(array $actor): array\n    {\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        // One bounded projection for the normal-notification conversation; never load bodies.\n        $latest = $this->db->fetch(\"SELECT n.public_id,n.title,n.created_at FROM notifications n WHERE n.channel='in_app' AND ((n.recipient_type='user' AND n.recipient_id=:user_id) OR (n.recipient_type='worker' AND :worker_enabled>0 AND n.recipient_id=:worker_id)) ORDER BY n.created_at DESC,n.id DESC LIMIT 1\", [\n            'user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId,\n        ]);\n        $unreadCount = (int) $this->db->fetchValue(\"SELECT COUNT(*) FROM notifications n WHERE n.channel='in_app' AND n.read_at IS NULL AND ((n.recipient_type='user' AND n.recipient_id=:user_id) OR (n.recipient_type='worker' AND :worker_enabled>0 AND n.recipient_id=:worker_id))\", [\n            'user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId,\n        ]);\n\n        [$userWhere,$userParams] = DatabaseOrderCenterRepository::scope($actor,'mine','todo');\n        $userTodoCount = (int) $this->db->fetchValue('SELECT COUNT(*) FROM orders o WHERE ' . $userWhere, $userParams);\n        $userTop = $this->db->fetch(\"SELECT o.public_no,o.audit_status,o.payment_status,o.fulfillment_status,(o.order_source_type='platform' AND EXISTS(SELECT 1 FROM order_events apr WHERE apr.order_id=o.id AND apr.event_type='platform_measurement_pricing_reviewed') AND NOT EXISTS(SELECT 1 FROM order_events apc WHERE apc.order_id=o.id AND apc.event_type='platform_measurement_pricing_confirmed')) pending_pricing,(SELECT c.public_id FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')) ORDER BY c.id DESC LIMIT 1) pending_change_id,(SELECT rc.status FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment') ORDER BY rc.id DESC LIMIT 1) pending_run_empty_status,CASE WHEN o.audit_status='draft' AND o.payment_status='awaiting_payment' THEN 95 WHEN EXISTS(SELECT 1 FROM run_empty_fee_claims rp WHERE rp.order_id=o.id AND rp.status='awaiting_payment') THEN 95 WHEN o.audit_status='supplement_required' THEN 85 WHEN EXISTS(SELECT 1 FROM change_requests cp WHERE cp.order_id=o.id AND (cp.status='pending' OR (cp.status='accepted' AND cp.payment_status='awaiting_payment'))) THEN 80 WHEN EXISTS(SELECT 1 FROM run_empty_fee_claims rc2 WHERE rc2.order_id=o.id AND rc2.status='pending_confirmation') THEN 80 WHEN o.fulfillment_status='submitted' THEN 75 ELSE 70 END todo_priority FROM orders o WHERE \" . $userWhere . \" ORDER BY todo_priority DESC,o.updated_at DESC,o.id DESC LIMIT 1\", $userParams);\n        $userTodo = null;\n        if ($userTop) {\n            if ($userTop['audit_status'] === 'supplement_required') $action = '补充订单资料';\n            elseif ($userTop['audit_status'] === 'draft' && $userTop['payment_status'] === 'awaiting_payment') $action = '支付预约费';\n            elseif (!empty($userTop['pending_pricing'])) $action = '确认平台报价';\n            elseif (!empty($userTop['pending_change_id'])) $action = '处理费用调整';\n            elseif (($userTop['pending_run_empty_status'] ?? '') === 'pending_confirmation') $action = '确认跑空费';\n            elseif (($userTop['pending_run_empty_status'] ?? '') === 'awaiting_payment') $action = '支付跑空费';\n            elseif ($userTop['fulfillment_status'] === 'submitted') $action = '确认完工';\n            else $action = '选择报价';\n            $userTodo = ['order_id' => (string) $userTop['public_no'], 'action' => $action, 'role' => '我的下单', 'detail_page' => 'user', 'priority' => (int) $userTop['todo_priority']];\n        }\n\n        $workerTodoCount = 0;\n        $workerTodo = null;\n        if ($workerId > 0) {\n            [$workerWhere,$workerParams] = DatabaseOrderCenterRepository::scope($actor,'worker','todo');\n            $workerTodoCount = (int) $this->db->fetchValue('SELECT COUNT(*) FROM orders o WHERE ' . $workerWhere, $workerParams);\n            $workerTop = $this->db->fetch(\"SELECT o.public_no,o.assignment_status,o.dispatch_mode,(SELECT COUNT(*) FROM after_sales ast WHERE ast.order_id=o.id AND ast.type='warranty_repair' AND (ast.status='open' OR (ast.status='processing' AND (ast.resolution IS NULL OR (ast.resolution NOT LIKE '师傅拒绝维修%' AND ast.resolution NOT LIKE '用户申请平台介入%'))))) pending_repair_count FROM orders o WHERE \" . $workerWhere . \" ORDER BY pending_repair_count DESC,o.updated_at DESC,o.id DESC LIMIT 1\", $workerParams);\n            if ($workerTop) {\n                $repair = (int) ($workerTop['pending_repair_count'] ?? 0) > 0;\n                $workerTodo = ['order_id' => (string) $workerTop['public_no'], 'action' => $repair ? '处理待维修' : ($workerTop['assignment_status']==='accepted'?'预约施工':($workerTop['dispatch_mode']==='multi_quote'?'提交报价':'确认接单')), 'role' => '我的接单', 'detail_page' => 'worker', 'priority' => $repair ? 100 : 90];\n            }\n        }\n\n        $topTodo = $userTodo;\n        if ($workerTodo && (!$topTodo || (int) $workerTodo['priority'] > (int) $topTodo['priority'])) $topTodo = $workerTodo;\n        $attention = $this->attention($actor);\n        return [\n            'attention_schema' => 1,\n            'order_attention_count' => $attention['order_attention_count'],\n            'standalone_unread_count' => $attention['standalone_unread_count'],\n            'unread_count' => $unreadCount,\n            'todo_count' => $userTodoCount + $workerTodoCount,\n            'user_todo_count' => $userTodoCount,\n            'worker_todo_count' => $workerTodoCount,\n            'top_todo' => $topTodo,\n            'latest_notification' => $latest ? [\n                'id' => (string) $latest['public_id'],\n                'title' => (string) $latest['title'],\n                'created_at' => (new DateTimeImmutable((string) $latest['created_at'], new DateTimeZone('UTC')))->format(DATE_ATOM),\n            ] : null,\n        ];\n\n    }\n\n\n    private function attention(array $actor): array\n    {\n        [$userTodo,$userParams] = DatabaseOrderCenterRepository::scope($actor,'mine','todo');\n        [$workerTodo,$workerParams] = DatabaseOrderCenterRepository::scope($actor,'worker','todo');\n        [$userRead,$userReadParams] = DatabaseOrderCenterRepository::scope($actor,'mine','all');\n        [$workerRead,$workerReadParams] = DatabaseOrderCenterRepository::scope($actor,'worker','all');\n        $workerId=(int)($actor['worker_id']??0);\n        // Only a canonical internal order ID and the current receiver's order\n        // scope can merge a notice into B. Invalid/missing/unowned links stay S.\n        $orderId=\"JSON_UNQUOTE(JSON_EXTRACT(IF(JSON_VALID(n.data_json),n.data_json,'{}'),'$.order_id'))\";\n        $orderType=\"JSON_TYPE(JSON_EXTRACT(IF(JSON_VALID(n.data_json),n.data_json,'{}'),'$.order_id'))\";\n        $match=\"{$orderType} IN ('INTEGER','STRING') AND {$orderId} REGEXP '^[1-9][0-9]{0,19}$' AND o.id=CAST({$orderId} AS UNSIGNED) AND BINARY CAST(o.id AS CHAR)=BINARY {$orderId}\n            AND ((n.recipient_type='user' AND ({$userRead})) OR (n.recipient_type='worker' AND ({$workerRead})))\";\n        $owned=\"n.channel='in_app' AND n.read_at IS NULL AND ((n.recipient_type='user' AND n.recipient_id=:attention_user) OR (n.recipient_type='worker' AND :attention_worker_enabled>0 AND n.recipient_id=:attention_worker))\";\n        // UNION deduplicates identity+order across todos and any number of\n        // order notices. Kind separates unrelated notification IDs from orders.\n        $sql=\"SELECT COALESCE(SUM(kind='order'),0) order_attention_count,COALESCE(SUM(kind='standalone'),0) standalone_unread_count FROM (\n            SELECT 'order' kind,'user' identity_kind,o.id item_id FROM orders o WHERE {$userTodo}\n            UNION SELECT 'order','worker',o.id FROM orders o WHERE {$workerTodo}\n            UNION SELECT IF(o.id IS NULL,'standalone','order'),n.recipient_type,IF(o.id IS NULL,n.id,o.id)\n                FROM notifications n LEFT JOIN orders o ON {$match} WHERE {$owned}\n        ) attention_items\";\n        $params=$userParams+$workerParams+$userReadParams+$workerReadParams+['attention_user'=>(int)$actor['user_id'],'attention_worker_enabled'=>$workerId,'attention_worker'=>$workerId];\n        $row=$this->db->fetch($sql,$params);\n        return ['order_attention_count'=>(int)$row['order_attention_count'],'standalone_unread_count'=>(int)$row['standalone_unread_count']];\n    }\n\n    public function list(array $actor, int $page, string $throughId = ''): array\n    {\n        $limit = 20;\n        $offset = ($page - 1) * $limit;\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        $where = \"n.channel='in_app' AND ( (n.recipient_type='user' AND n.recipient_id=:user_id) OR (n.recipient_type='worker' AND :worker_enabled>0 AND n.recipient_id=:worker_id) )\";\n        $params = ['user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId];\n        // Capture the range before loading the list, not after it. Later pages\n        // retain the same owned public ID so arrivals cannot shift offsets.\n        $boundary=$this->db->fetch('SELECT n.id,n.public_id FROM notifications n WHERE '.$where.($throughId!==''?' AND n.public_id=:through_id':'').' ORDER BY n.id DESC LIMIT 1',$throughId!==''?$params+['through_id'=>$throughId]:$params);\n        if($throughId!==''&&!$boundary)throw new MessageOperationException('通知范围已失效，请刷新后重试','NOTIFICATION_RANGE_INVALID',404);\n        $throughId=$boundary?(string)$boundary['public_id']:'';\n        $unreadCount = (int) $this->db->fetchValue('SELECT COUNT(*) FROM notifications n WHERE ' . $where . ' AND n.read_at IS NULL', $params);\n        $rows = $this->db->fetchAll('SELECT n.public_id,n.recipient_type,n.template_key,n.title,n.content,n.data_json,n.read_at,n.created_at FROM notifications n WHERE ' . $where . ' AND n.id<=:range_cutoff ORDER BY n.created_at DESC,n.id DESC LIMIT ' . ($limit + 1) . ' OFFSET ' . $offset, $params+['range_cutoff'=>$boundary?(int)$boundary['id']:0]);\n        $hasMore = count($rows) > $limit;\n        $rows = array_slice($rows, 0, $limit);\n        // V2.2.3：先解析本页关联订单，再一次性批量取订单号，避免每条通知额外执行一次 SQL。\n        $preparedRows = []; $orderIds = [];\n        foreach ($rows as $row) {\n            $data = (json_decode((string)($row['data_json'] ?? ''), true) ?: []);\n            $orderId = is_array($data) ? (int) ($data['order_id'] ?? 0) : 0;\n            if ($orderId > 0) $orderIds[$orderId] = true;\n            $preparedRows[] = ['row' => $row, 'order_id' => $orderId];\n        }\n        $orderNoById = [];\n        if ($orderIds) {\n            $safeIds = array_map('intval', array_keys($orderIds));\n            foreach ($this->db->fetchAll('SELECT id,public_no FROM orders WHERE id IN (' . implode(',', $safeIds) . ')') as $orderRow) {\n                $orderNoById[(int) $orderRow['id']] = (string) $orderRow['public_no'];\n            }\n        }\n        $items = [];\n        foreach ($preparedRows as $prepared) {\n            $row = $prepared['row']; $orderId = (int) $prepared['order_id'];\n            $items[] = [\n                'id' => (string) $row['public_id'], 'recipient_type' => (string) $row['recipient_type'],\n                'template_key' => (string) $row['template_key'], 'title' => (string) $row['title'],\n                'content' => (string) $row['content'], 'read' => !empty($row['read_at']),\n                'created_at' => $this->localTime($row['created_at']), 'order_id' => $orderId,\n                'order_no' => $orderNoById[$orderId] ?? '', 'detail_page' => $row['recipient_type'] === 'worker' ? 'worker' : 'user',\n            ];\n        }\n        return ['items' => $items, 'page' => $page, 'has_more' => $hasMore, 'unread_count' => $unreadCount, 'read_through_id'=>$throughId];\n\n    }\n\n    public function read(array $actor, string $publicId): void\n    {\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        $params = ['public_id' => $publicId, 'user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId];\n        $owned = $this->db->fetchValue(\"SELECT id FROM notifications WHERE public_id=:public_id AND channel='in_app' AND ((recipient_type='user' AND recipient_id=:user_id) OR (recipient_type='worker' AND :worker_enabled>0 AND recipient_id=:worker_id)) LIMIT 1\", $params);\n        if (!$owned) throw new MessageOperationException('消息不存在或不属于当前账号', 'NOTIFICATION_NOT_FOUND', 404);\n        $this->db->execute(\"UPDATE notifications SET read_at=COALESCE(read_at,UTC_TIMESTAMP()) WHERE id=:id\", ['id' => (int) $owned]);\n\n    }\n\n    public function readBatch(array $actor, array $ids): int\n    {\n        $workerId = !empty($actor['worker_id']) ? (int) $actor['worker_id'] : 0;\n        $marks = [];\n        $params = ['user_id' => (int) $actor['user_id'], 'worker_enabled' => $workerId, 'worker_id' => $workerId];\n        foreach ($ids as $index => $publicId) {\n            $key = 'notification_' . $index;\n            $marks[] = ':' . $key;\n            $params[$key] = $publicId;\n        }\n        $changed = $this->db->execute(\"UPDATE notifications SET read_at=COALESCE(read_at,UTC_TIMESTAMP()) WHERE public_id IN (\" . implode(',', $marks) . \") AND channel='in_app' AND ((recipient_type='user' AND recipient_id=:user_id) OR (recipient_type='worker' AND :worker_enabled>0 AND recipient_id=:worker_id))\", $params);\n        return $changed;\n\n    }\n\n    public function readAll(array $actor, string $throughId = ''): void\n    {\n        $workerId=!empty($actor['worker_id'])?(int)$actor['worker_id']:0;\n        $params=['user_id'=>(int)$actor['user_id'],'worker_enabled'=>$workerId,'worker_id'=>$workerId];\n        $where=\"channel='in_app' AND ((recipient_type='user' AND recipient_id=:user_id) OR (recipient_type='worker' AND :worker_enabled>0 AND recipient_id=:worker_id))\";\n        if($throughId!==''){\n            $cutoff=$this->db->fetchValue('SELECT id FROM notifications WHERE '.$where.' AND public_id=:through_id LIMIT 1',$params+['through_id'=>$throughId]);\n            if(!$cutoff)throw new MessageOperationException('通知范围已失效，请刷新后重试','NOTIFICATION_RANGE_INVALID',404);\n        }else{\n            // Old clients also receive a server-side cutoff before the UPDATE.\n            $cutoff=$this->db->fetchValue('SELECT COALESCE(MAX(id),0) FROM notifications WHERE '.$where,$params);\n        }\n        $this->db->execute('UPDATE notifications SET read_at=UTC_TIMESTAMP() WHERE '.$where.' AND read_at IS NULL AND id<=:cutoff',$params+['cutoff'=>(int)$cutoff]);\n    }\n\n    private function localTime($value): ?string\n    {\n        if (!$value) return null;\n        try {\n            return (new DateTimeImmutable((string) $value, new DateTimeZone('UTC')))->setTimezone(new DateTimeZone((string) \\app_config('app.timezone', 'Asia/Shanghai')))->format('Y-m-d H:i');\n        } catch (Throwable $exception) { return (string) $value; }\n    }\n}\n","server/app/Http/Api/Modules/MessagingApiModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Api\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Api\\ApiModule;\nuse WorkerAdmin\\Foundation\\ApplicationContainer;\nuse WorkerAdmin\\Foundation\\MessagingApplicationContainer;\nuse WorkerAdmin\\Application\\Identity\\ApiActorResolver;\nuse WorkerAdmin\\Application\\Messaging\\NotificationInbox;\nuse WorkerAdmin\\Application\\Messaging\\SubscriptionPreferences;\nuse WorkerAdmin\\Domain\\Messaging\\MessageOperationException;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n/** Subscription settings and the signed-in actor's notification inbox. */\nfinal class MessagingApiModule implements ApiModule\n{\n    private const ROUTES = [\n        'announcement.current'=>'GET',\n        'subscriptions.status'=>'GET', 'subscriptions.diagnose'=>'GET', 'subscriptions.preference'=>'POST',\n        'notifications.summary'=>'GET', 'notifications.list'=>'GET', 'notifications.read'=>'POST',\n        'notifications.read_batch'=>'POST', 'notifications.read_all'=>'POST',\n    ];\n    private \\WorkerAdmin\\Application\\Messaging\\AnnouncementQuery $announcement;\n    private ApiActorResolver $actors;\n    private NotificationInbox $inbox;\n    private SubscriptionPreferences $subscriptions;\n    public function __construct(Database $db, ?ApiActorResolver $actors=null, ?NotificationInbox $inbox=null, ?SubscriptionPreferences $subscriptions=null)\n    {\n        $container = new MessagingApplicationContainer($db);\n        $this->announcement=new \\WorkerAdmin\\Application\\Messaging\\AnnouncementQuery((new ApplicationContainer($db))->settings());\n        $this->actors = $actors ?: (new ApplicationContainer($db))->apiActorResolver();\n        $this->inbox = $inbox ?: $container->inbox();\n        $this->subscriptions = $subscriptions ?: $container->subscriptions();\n    }\n    public function supports(string $route): bool { return isset(self::ROUTES[$route]); }\n    public function requiresContentSecurity(string $route): bool { return false; }\n    public function dispatch(string $route): void\n    {\n        if (!$this->supports($route)) { $this->fail('接口不存在', 'NOT_FOUND', 404); return; }\n        $header = trim((string)($_SERVER['HTTP_AUTHORIZATION'] ?? ''));\n        if ($header === '' && function_exists('getallheaders')) {\n            $headers = getallheaders();\n            $header = trim((string)($headers['Authorization'] ?? $headers['authorization'] ?? ''));\n        }\n        if (preg_match('/^Bearer\\s+([A-Fa-f0-9]{64})$/', $header, $matches) !== 1) { $this->fail('请重新登录','UNAUTHORIZED',401); return; }\n        try { $actor = $this->actors->resolve($matches[1]); }\n        catch (RuntimeException $exception) {\n            $status = in_array($exception->getCode(), [401,403,503], true) ? (int)$exception->getCode() : 401;\n            $this->fail($exception->getMessage(), $status === 503 ? 'MINIAPP_APPID_MISSING' : 'UNAUTHORIZED', $status);\n            return;\n        }\n        try {\n            // The demo boundary precedes method/body validation, as in the old dispatch.\n            if ($route === 'subscriptions.preference' && !empty($actor['is_demo_actor'])) {\n                $this->subscriptions->save($actor, []);\n            }\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== self::ROUTES[$route]) {\n                $this->fail('请求方式不正确','METHOD_NOT_ALLOWED',405); return;\n            }\n            $raw = self::ROUTES[$route] === 'POST' ? file_get_contents('php://input') : '';\n            // Retain the legacy empty/malformed-body fallback for these existing endpoints.\n            $body = json_decode(is_string($raw) ? $raw : '', true);\n            $body = is_array($body) ? $body : [];\n            if ($route === 'subscriptions.preference') { \\json_response(['ok'=>true] + $this->subscriptions->save($actor, $body)); return; }\n            if ($route === 'announcement.current') $data=$this->announcement->current((string)($_GET['scene']??''));\n            elseif ($route === 'subscriptions.status') $data = $this->subscriptions->status($actor, (string)($_GET['include_application'] ?? '') === '1');\n            elseif ($route === 'subscriptions.diagnose') $data = $this->subscriptions->diagnose($actor);\n            elseif ($route === 'notifications.summary') $data = $this->inbox->summary($actor);\n            elseif ($route === 'notifications.list') $data = $this->inbox->list($actor, (int)($_GET['page'] ?? 1), (string)($_GET['through_id'] ?? ''));\n            elseif ($route === 'notifications.read_batch') $data = $this->inbox->readBatch($actor, is_array($body['ids'] ?? null) ? $body['ids'] : []);\n            elseif ($route === 'notifications.read') {\n                $this->inbox->read($actor, (string)($body['id'] ?? ''));\n                \\json_response(['ok'=>true,'message'=>'已标记为已读']); return;\n            } else {\n                $this->inbox->readAll($actor, (string)($body['through_id'] ?? ''));\n                \\json_response(['ok'=>true,'message'=>'未读消息已清除']); return;\n            }\n            $result = ['ok'=>true,'data'=>$data];\n            if ($route === 'notifications.read_batch') $result['message'] = '消息已标记为已读';\n            \\json_response($result);\n        } catch (MessageOperationException $exception) {\n            $this->fail($exception->getMessage(), $exception->apiCode(), (int)$exception->getCode());\n        } catch (OrderOperationException $exception) {\n            $this->fail($exception->getMessage(), $exception->apiCode(), (int)$exception->getCode());\n        }\n    }\n    private function fail(string $message, string $code, int $status): void\n    { \\json_response(['ok'=>false,'code'=>$code,'message'=>$message,'request_id'=>\\request_id()], $status); }\n}\n","tools/test-messaging-migration.php":"<?php\ndeclare(strict_types=1);\n$root=dirname(__DIR__);\nspl_autoload_register(static function(string $class) use($root): void {\n    if(strpos($class,'WorkerAdmin\\\\')!==0)return;\n    $path=$root.'/server/app/'.str_replace('\\\\','/',substr($class,12)).'.php';\n    if(is_file($path))require_once $path;\n});\n$checks=0;\nfunction messagingAssert(bool $ok,string $label): void { if(!$ok)throw new RuntimeException($label);++$GLOBALS['checks']; }\nfunction messagingReject(callable $call,string $message): void {\n    try{$call();throw new LogicException('Expected rejection');}catch(RuntimeException $e){messagingAssert(strpos($e->getMessage(),$message)!==false,'rejection: '.$message);}\n}\nfunction setting($key,$default=null){return $default;}\nfunction app_config($key,$default=null){return $default;}\nfunction request_id(){return 'messaging-test';}\nfunction admin_url($route,$params=[]){return '/admin/?route='.$route.'&'.http_build_query($params);}\nfunction flash($type,$message){$GLOBALS['flashes'][]=[$type,$message];}\nfinal class MessagingRedirect extends Exception {}\nfunction redirect($url){$GLOBALS['redirects'][]=$url;if(!empty($GLOBALS['terminateRedirect']))throw new MessagingRedirect($url);}\nfunction old_input($data){$GLOBALS['old']=$data;}\nfunction audit(...$args){$GLOBALS['audits'][]=$args;}\nfunction write_log(...$args){$GLOBALS['logs'][]=$args;}\nfunction view($name,$data){$GLOBALS['views'][]=[$name,$data];return 'rendered';}\nfinal class MessagingResponse extends Exception {\n    public array $payload; public int $status;\n    public function __construct(array $payload,int $status){parent::__construct('response');$this->payload=$payload;$this->status=$status;}\n}\nfunction json_response($data,$status=200){throw new MessagingResponse($data,$status);}\nfinal class MessagingInput {\n    public $context; private int $offset=0; public static string $body='{}';\n    public function stream_open($path,$mode,$options,&$opened){return $path==='php://input';}\n    public function stream_read($size){$s=substr(self::$body,$this->offset,$size);$this->offset+=strlen($s);return $s;}\n    public function stream_eof(){return $this->offset>=strlen(self::$body);}\n    public function stream_stat(){return [];}\n}\nfinal class MessagingSettings implements \\WorkerAdmin\\Contracts\\SettingsProvider {\n    public bool $configured=true;\n    public function get(string $key,$default=null){return $key==='wechat.miniapp_appid'?($this->configured?'test-app':''):$default;}\n    public function bool(string $key,bool $default=false):bool{return $default;}\n    public function int(string $key,int $default=0):int{return $default;}\n}\nfinal class MessagingActors implements \\WorkerAdmin\\Contracts\\ApiActorRepository {\n    public bool $found=true;public int $touches=0;\n    public function findByTokenHash(string $hash,string $appid):?array{return $this->found?['session_id'=>1,'user_id'=>42,'worker_id'=>7,'payer_openid'=>'ordinary']:null;}\n    public function touchSession(int $id):void{++$this->touches;}\n    public function findDemoActor(int $id):?array{return null;}\n    public function findTestActor(int $userId,int $instanceId):?array{return null;}\n    public function clearDemoActor(int $id):void{}\n    public function clearTestActor(int $id):void{}\n}\nfinal class MessagingInbox implements \\WorkerAdmin\\Contracts\\NotificationInboxRepository {\n    public array $calls=[];\n    public function summary(array $actor):array{$this->calls[]=['summary',$actor];return ['unread_count'=>3];}\n    public function list(array $actor,int $page,string $throughId=''):array{$this->calls[]=['list',$actor,$page];return ['page'=>$page,'items'=>[]];}\n    public function read(array $actor,string $id):void{$this->calls[]=['read',$actor,$id];}\n    public function readBatch(array $actor,array $ids):int{$this->calls[]=['batch',$actor,$ids];return count($ids);}\n    public function readAll(array $actor,string $throughId=''):void{$this->calls[]=['all',$actor];}\n}\nfinal class MessagingSubscriptions implements \\WorkerAdmin\\Contracts\\SubscriptionRepository {\n    public array $saves=[];\n    public function definitions():array {\n        $base=['title'=>'Scene','description'=>'Description','template_id'=>'id','available'=>true,'global_enabled'=>true];\n        return ['user'=>$base+['recipient'=>'user'],'worker'=>$base+['recipient'=>'worker'],'reviewResult'=>$base+['recipient'=>'worker'],'long'=>$base+['recipient'=>'user','subscription_type'=>'long_term']];\n    }\n    public function preferences(int $id):array{return ['long'=>['remaining_count'=>10],'user'=>['remaining_count'=>-1]];}\n    public function save(int $id,string $key,bool $enabled,string $status):array{$this->saves[]=[$id,$key,$enabled,$status];return ['subscription_type'=>'one_time','authorization_status'=>$status];}\n    public function diagnose(int $id):array{return ['pending_count'=>$id];}\n}\nfinal class MessagingCipher implements \\WorkerAdmin\\Contracts\\PrivateValueCipher {\n    public function hmac(string $plain,string $context):string{return hash('sha256',$context.':'.$plain);}\n    public function encrypt(string $plain,string $context):?string{return $plain;}\n    public function decrypt(string $plain,string $context):string{return $plain;}\n}\nfinal class MessagingOutbox implements \\WorkerAdmin\\Contracts\\MessageOutboxRepository {\n    public array $calls=[]; public array $rows=[];\n    public function dashboard(string $status,string $q,int $page,string $tab='records'):array{$this->calls[]=['dashboard',$status,$q,$page,$tab];return ['result'=>['rows'=>$this->rows],'suppressionResult'=>['rows'=>[],'total'=>0,'page'=>1,'pages'=>1,'per_page'=>20]];}\n    public function retry(int $id):array{$this->calls[]=['retry',$id];return ['topic'=>'wechat_subscribe'];}\n    public function close(int $id):array{$this->calls[]=['close',$id];return ['topic'=>'aliyun_sms'];}\n    public function addSuppression(string $hash,string $masked,string $reason,string $note,int $admin):void{$this->calls[]=['add',$hash,$masked,$reason,$note,$admin];}\n    public function removeSuppression(int $id):array{$this->calls[]=['remove',$id];return ['mobile_masked'=>'138****1234'];}\n}\n$inboxRepo=new MessagingInbox();$inbox=new \\WorkerAdmin\\Application\\Messaging\\NotificationInbox($inboxRepo);\n$actor=['user_id'=>42,'worker_id'=>7];\nmessagingReject(static function()use($inbox,$actor){$inbox->read($actor,' ');},'请选择');\nmessagingReject(static function()use($inbox,$actor){$inbox->readBatch($actor,array_fill(0,51,'x'));},'50');\nmessagingReject(static function()use($inbox,$actor){$inbox->readBatch($actor,['',[]]);},'请选择');\nmessagingAssert(!$inboxRepo->calls,'invalid writes never reach repository');\nmessagingAssert($inbox->readBatch($actor,[' x ','x','y'])===['updated_count'=>2],'batch trims and deduplicates');\n$inbox->list($actor,99999);messagingAssert(end($inboxRepo->calls)[2]===10000,'page maximum');\n$inbox->list($actor,-1);messagingAssert(end($inboxRepo->calls)[2]===1,'page minimum');\n$settings=new MessagingSettings();$subRepo=new MessagingSubscriptions();$subs=new \\WorkerAdmin\\Application\\Messaging\\SubscriptionPreferences($subRepo,$settings);\n$user=['user_id'=>42,'worker_id'=>null];\nmessagingAssert(array_column($subs->status($user,false)['items'],'key')===['user','long'],'ordinary account hides worker scenes');\nmessagingAssert(array_column($subs->status($user,true)['items'],'key')===['user','reviewResult','long'],'application only allows review result exception');\n$items=$subs->status($actor,false)['items'];messagingAssert(count($items)===4 && $items[3]['remaining_count']===null && $items[0]['remaining_count']===0,'worker scenes and long term/count projection');\nmessagingReject(static function()use($subs,$user){$subs->save($user,['key'=>'worker']);},'没有师傅身份');\ntry{$subs->save($actor+['is_demo_actor'=>true],['key'=>'user']);throw new LogicException('demo allowed');}\ncatch(\\WorkerAdmin\\Domain\\Order\\OrderOperationException $e){messagingAssert($e->apiCode()==='DEMO_EXTERNAL_ACTION_BLOCKED' && $e->getCode()===403,'demo preference blocks before persistence');}\nmessagingAssert(!$subRepo->saves,'blocked preferences never saved');\n$subs->save($user,['key'=>'reviewResult','enabled'=>true,'authorization_status'=>'acceptWithAudio']);\nmessagingAssert($subRepo->saves[0][0]===42 && $subRepo->saves[0][1]==='reviewResult','onboarding subscription uses trusted actor');\n$outRepo=new MessagingOutbox();$console=new \\WorkerAdmin\\Application\\Messaging\\MessageOutboxConsole($outRepo,new \\WorkerAdmin\\Application\\Identity\\MobileNumberProtection(new MessagingCipher()));\nmessagingReject(static function()use($console){$console->close(1,'bad');},'5～200');\nmessagingReject(static function()use($console){$console->retry(0);},'编号');\nmessagingReject(static function()use($console){$console->addSuppression('bad','manual','',3);},'手机号');\nmessagingReject(static function()use($console){$console->addSuppression('13800131234','manual',str_repeat('字',301),3);},'300');\nmessagingAssert(!$outRepo->calls,'invalid admin commands never persist');\n$console->dashboard('bogus',str_repeat('字',110),-9,'bad-tab');$call=end($outRepo->calls);\nmessagingAssert($call[1]==='' && mb_strlen($call[2])===100 && $call[3]===1 && $call[4]==='records','dashboard filters and tab normalized');\n$outRepo->rows=[['topic'=>'wecom_webhook','business_key'=>'worker:42','_payload_json'=>json_encode(['event_type'=>'worker_profile_submitted','title'=>'新的师傅入驻资料待审核'],JSON_UNESCAPED_UNICODE)]];\n$dashboard=$console->dashboard('','',2,'suppressions');$call=end($outRepo->calls);\nmessagingAssert($call[3]===2 && $call[4]==='suppressions' && $dashboard['activeTab']==='suppressions','suppression tab and page preserved');\nmessagingAssert($dashboard['result']['rows'][0]['business_label']==='师傅入驻 / 资料审核' && !isset($dashboard['result']['rows'][0]['_payload_json']),'business label is readable and raw payload never reaches view');\n$outRepo->rows=[];\n$result=$console->addSuppression('+86 13800131234','bogus',' note ',3);$call=end($outRepo->calls);\nmessagingAssert($result===['masked'=>'138****1234','reason'=>'manual'] && $call[2]==='138****1234' && $call[4]==='note' && $call[5]===3,'suppression masks and retains admin identity');\nmessagingAssert($call[1]===hash('sha256','sms-recipient-mobile:13800131234'),'canonical privacy context');\nforeach(['pending','processing','processed','closed']as $status)messagingReject(static function()use($status){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>'aliyun_sms','status'=>$status,'attempt_count'=>5],'retry');},'仅可');\nmessagingReject(static function(){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>'aliyun_sms','status'=>'failed','attempt_count'=>4],'close');},'5 次');\nmessagingReject(static function(){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>'aliyun_paid_sms','status'=>'failed','attempt_count'=>5],'retry');},'付费短信');\nforeach(['aliyun_sms','wechat_subscribe','wecom_webhook']as $topic){\\WorkerAdmin\\Domain\\Messaging\\MessageOutboxPolicy::requireDeadLetter(['topic'=>$topic,'status'=>'failed','attempt_count'=>5],'retry');messagingAssert(true,'eligible general dead letter');}\n// Public API dispatch via Kernel, including status/error envelopes and trusted identity.\n$db=new \\WorkerAdmin\\Core\\Database(['database'=>'offline']);$actorRepo=new MessagingActors();$resolver=new \\WorkerAdmin\\Application\\Identity\\ApiActorResolver($actorRepo,$settings);\n$module=new \\WorkerAdmin\\Http\\Api\\Modules\\MessagingApiModule($db,$resolver,$inbox,$subs);\n$gate=new class implements \\WorkerAdmin\\Contracts\\RequestContentSecurityGate{public function inspect(string $route):void{throw new LogicException('message read does not need moderation');}};\n$kernel=new \\WorkerAdmin\\Http\\Api\\ApiKernel($db,[$module],$gate);\nfunction messagingDispatch($kernel,string $route,string $method,string $body='{}',string $token='valid'):MessagingResponse {\n    $_SERVER['REQUEST_METHOD']=$method;$_SERVER['HTTP_AUTHORIZATION']=$token==='valid'?'Bearer '.str_repeat('a',64):$token;MessagingInput::$body=$body;\n    try{$kernel->dispatch($route);throw new LogicException('no response');}catch(MessagingResponse $response){return $response;}\n}\nstream_wrapper_unregister('php');stream_wrapper_register('php',MessagingInput::class);\ntry{\n    $_GET=['page'=>2,'user_id'=>999,'worker_id'=>999];\n    $response=messagingDispatch($kernel,'notifications.list','GET');$call=end($inboxRepo->calls);\n    messagingAssert($response->status===200 && $call[1]['user_id']===42 && $call[1]['worker_id']===7,'client recipient IDs ignored');\n    messagingAssert(messagingDispatch($kernel,'notifications.summary','GET')->payload['data']['unread_count']===3,'summary envelope');\n    messagingAssert(messagingDispatch($kernel,'subscriptions.status','GET')->payload['ok']===true,'subscription status envelope');\n    messagingAssert(messagingDispatch($kernel,'subscriptions.diagnose','GET')->payload['data']['pending_count']===42,'diagnostic actor scope');\n    messagingAssert(messagingDispatch($kernel,'subscriptions.preference','POST','{\"key\":\"user\",\"enabled\":true,\"authorization_status\":\"accept\"}')->payload['ok']===true,'preference success envelope');\n    messagingAssert(messagingDispatch($kernel,'notifications.read','POST','{\"id\":\"one\"}')->payload['message']==='已标记为已读','single read copy');\n    messagingAssert(messagingDispatch($kernel,'notifications.read_batch','POST','{\"ids\":[\"x\",\"x\",\"y\"]}')->payload['data']['updated_count']===2,'batch envelope');\n    messagingAssert(messagingDispatch($kernel,'notifications.read_all','POST')->payload['message']==='未读消息已清除','read all copy');\n    messagingAssert(messagingDispatch($kernel,'notifications.read','POST','bad')->payload['code']==='NOTIFICATION_REQUIRED','legacy malformed body fallback');\n    messagingAssert(messagingDispatch($kernel,'notifications.list','POST')->status===405,'method boundary');\n    messagingAssert(messagingDispatch($kernel,'notifications.list','GET','{}','bad')->status===401,'invalid bearer');\n    $actorRepo->found=false;messagingAssert(messagingDispatch($kernel,'notifications.list','GET')->payload['code']==='UNAUTHORIZED','expired token');$actorRepo->found=true;\n    $settings->configured=false;$missing=messagingDispatch($kernel,'notifications.list','GET');messagingAssert($missing->status===503 && $missing->payload['code']==='MINIAPP_APPID_MISSING','legacy missing app config code');$settings->configured=true;\n}finally{stream_wrapper_restore('php');}\n// Public Admin Kernel applies first-password/CSRF before module permissions and commands.\n$auth=new class($db) extends \\WorkerAdmin\\Core\\Auth {\n    public bool $allowed=true;public bool $force=false;public array $permissions=[];\n    public function requireLogin(){}\n    public function user(){return ['id'=>9,'must_change_password'=>$this->force];}\n    public function requirePermission($p){$this->permissions[]=$p;if(!$this->allowed)throw new RuntimeException('permission denied');}\n};\n$csrf=new class extends \\WorkerAdmin\\Core\\Csrf {public bool $valid=true;public function verifyRequest(){if(!$this->valid)throw new RuntimeException('csrf invalid');}};\n$adminModule=new \\WorkerAdmin\\Http\\Admin\\Modules\\MessageOutboxAdminModule($db,$auth,$csrf,$console);\n$adminKernel=new \\WorkerAdmin\\Http\\Admin\\AdminKernel($db,$auth,$csrf,[$adminModule]);\n$_SERVER['REQUEST_METHOD']='GET';$_GET=['tab'=>'suppressions','page'=>'3'];ob_start();$adminKernel->dispatch('message-outbox');ob_end_clean();\n$call=end($outRepo->calls);$view=end($GLOBALS['views']);\nmessagingAssert(end($auth->permissions)==='settings.manage' && $view[0]==='admin/message-outbox' && $call[3]===3 && $call[4]==='suppressions' && $view[1]['activeTab']==='suppressions','dashboard permission, tab, page and view');\n$auth->allowed=false;$count=count($outRepo->calls);messagingReject(static function()use($adminKernel){$adminKernel->dispatch('message-outbox');},'permission');messagingAssert(count($outRepo->calls)===$count,'permission denies before read');$auth->allowed=true;\n$_SERVER['REQUEST_METHOD']='POST';$_GET=['id'=>'4'];$_POST=['_csrf'=>'secret','token'=>'secret','close_reason'=>'原因说明内容'];\n$adminKernel->dispatch('message-outbox.retry');messagingAssert(end($GLOBALS['audits'])[0]==='message.outbox.retry' && end($outRepo->calls)===['retry',4],'retry public route audit');\n$adminKernel->dispatch('message-outbox.close');messagingAssert(end($GLOBALS['audits'])[0]==='message.outbox.close' && end($outRepo->calls)===['close',4],'close public route audit');\n$_POST=['mobile'=>'13800131234','reason'=>'opt_out','note'=>'test'];$adminKernel->dispatch('message-outbox.suppression.add');messagingAssert(end($GLOBALS['audits'])[0]==='sms.suppression.add' && strpos((string)end($GLOBALS['redirects']),'tab=suppressions')!==false,'suppression add audit and tab return');\n$adminKernel->dispatch('message-outbox.suppression.remove');messagingAssert(end($GLOBALS['audits'])[0]==='sms.suppression.remove' && strpos((string)end($GLOBALS['redirects']),'tab=suppressions')!==false,'suppression remove audit and tab return');\n$_POST=['token'=>'secret','_csrf'=>'secret','close_reason'=>'bad'];$adminKernel->dispatch('message-outbox.close');messagingAssert(end($GLOBALS['flashes'])[0]==='danger' && !isset($GLOBALS['old']['token']) && !isset($GLOBALS['old']['_csrf']),'business error safely flashes and preserves only form input');\n// Guard redirects terminate in production. Throw a sentinel on guard-only calls to test before dispatch.\n$csrf->valid=false;$count=count($outRepo->calls);$GLOBALS['terminateRedirect']=true;\ntry{$adminKernel->dispatch('message-outbox.retry');throw new LogicException('missing csrf redirect');}catch(MessagingRedirect $e){}\n// The response boundary terminates the guarded request before module dispatch.\nmessagingAssert(count($outRepo->calls)===$count,'CSRF denies all business calls');\n$csrf->valid=true;$auth->force=true;\ntry{$adminKernel->dispatch('message-outbox.retry');throw new LogicException('missing password redirect');}catch(MessagingRedirect $e){messagingAssert(strpos($e->getMessage(),'profile')!==false,'forced password return');}\nmessagingAssert(count($outRepo->calls)===$count,'first password guard prevents business calls');\necho 'Messaging public boundary regression: '.$checks.' checks passed.'.PHP_EOL;","server/tests/v250_messaging_migration_mysql.php":"<?php\ndeclare(strict_types=1);\n// Explicit opt-in; refuses existing schema and removes only the schema created by this run.\nif(getenv('MESSAGING_MIGRATION_MYSQL_TEST')!=='1'){fwrite(STDERR,\"Set MESSAGING_MIGRATION_MYSQL_TEST=1 for an isolated MySQL 5.7 test server.\\n\");exit(2);}\n$root=dirname(__DIR__,2);\nspl_autoload_register(static function(string $class)use($root):void{if(strpos($class,'WorkerAdmin\\\\')!==0)return;$p=$root.'/server/app/'.str_replace('\\\\','/',substr($class,12)).'.php';if(is_file($p))require_once $p;});\nfunction setting($key,$default=null){return $default;}\nfunction app_config($key,$default=null){return $default;}\nfunction write_log(...$args){$GLOBALS['logs'][]=$args;}\n$checks=0;\nfunction messageMysqlAssert(bool $ok,string $label):void{if(!$ok)throw new RuntimeException($label);++$GLOBALS['checks'];}\nfunction messageMysqlReject(callable $call,string $message):void{try{$call();throw new LogicException('expected rejection');}catch(RuntimeException $e){messageMysqlAssert(strpos($e->getMessage(),$message)!==false,'rejection '.$message);}}\n$config=['host'=>getenv('V250_DB_HOST')?:'127.0.0.1','port'=>(int)(getenv('V250_DB_PORT')?:3306),'username'=>getenv('V250_DB_USER')?:'root','password'=>getenv('V250_DB_PASSWORD')?:'','database'=>'worker_messaging_migration_test'];\n$server=new PDO('mysql:host='.$config['host'].';port='.$config['port'].';charset=utf8mb4',$config['username'],$config['password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);\nmessageMysqlAssert(strpos((string)$server->query('SELECT VERSION()')->fetchColumn(),'5.7.')===0,'MySQL 5.7 required');\n$created=false;\ntry{\n    $server->exec('CREATE DATABASE worker_messaging_migration_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');$created=true;\n    $db=new \\WorkerAdmin\\Core\\Database($config);$other=new \\WorkerAdmin\\Core\\Database($config);\n    $db->execute(\"CREATE TABLE notifications(id INT AUTO_INCREMENT PRIMARY KEY,public_id VARCHAR(80) UNIQUE,recipient_type VARCHAR(20),recipient_id INT,channel VARCHAR(30),template_key VARCHAR(80),title VARCHAR(80),content TEXT,data_json TEXT,read_at DATETIME NULL,created_at DATETIME) ENGINE=InnoDB\");\n    $db->execute(\"CREATE TABLE orders(id INT PRIMARY KEY,public_no VARCHAR(80),user_id INT,lifecycle_status VARCHAR(40),refund_status VARCHAR(40),audit_status VARCHAR(40),payment_status VARCHAR(40),fulfillment_status VARCHAR(40),dispute_status VARCHAR(40),selected_quote_id INT NULL,current_assignment_id INT NULL,assigned_worker_id INT NULL,assignment_status VARCHAR(40),updated_at DATETIME) ENGINE=InnoDB\");\n    $db->execute('CREATE TABLE quotes(id INT PRIMARY KEY,order_id INT,status VARCHAR(20)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE change_requests(id INT PRIMARY KEY,order_id INT,public_id VARCHAR(80),status VARCHAR(30),payment_status VARCHAR(40)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE run_empty_fee_claims(id INT PRIMARY KEY,order_id INT,status VARCHAR(30)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE assignments(id INT PRIMARY KEY,worker_id INT,status VARCHAR(30)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE after_sales(id INT PRIMARY KEY,order_id INT,type VARCHAR(40),status VARCHAR(30),resolution TEXT) ENGINE=InnoDB');\n    foreach([['user-1','user',42,'in_app'],['worker-1','worker',7,'in_app'],['other-user','user',99,'in_app'],['other-worker','worker',99,'in_app'],['external','user',42,'sms']]as $r){\n        $db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,content,data_json,created_at) VALUES(:id,:type,:recipient,:channel,'event','Title','Content','{\\\"order_id\\\":1}','2026-10-08 00:00:00')\",['id'=>$r[0],'type'=>$r[1],'recipient'=>$r[2],'channel'=>$r[3]]);\n    }\n    $db->execute(\"INSERT INTO orders VALUES(1,'MESSAGE-USER',42,'active','none','draft','awaiting_payment','none','none',NULL,NULL,NULL,'none',UTC_TIMESTAMP()),(2,'MESSAGE-WORKER',99,'active','none','approved','paid','none','none',NULL,12,7,'offered',UTC_TIMESTAMP()),(3,'MESSAGE-REPAIR',99,'completed','none','approved','paid','accepted','none',NULL,NULL,7,'accepted',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO assignments VALUES(12,7,'offered')\");$db->execute(\"INSERT INTO after_sales VALUES(1,3,'warranty_repair','open',NULL)\");\n    $db->execute(\"ALTER TABLE orders ADD is_demo TINYINT NOT NULL DEFAULT 0,ADD order_source_type VARCHAR(30) NOT NULL DEFAULT 'consumer',ADD workflow_profile VARCHAR(30) NOT NULL DEFAULT 'construction',ADD dispatch_mode VARCHAR(30) NOT NULL DEFAULT 'single'\");\n    $db->execute(\"ALTER TABLE quotes ADD worker_id INT NOT NULL DEFAULT 0\");\n    $db->execute(\"ALTER TABLE assignments ADD order_id INT NOT NULL DEFAULT 0\");\n    $db->execute(\"UPDATE assignments SET order_id=2 WHERE id=12\");\n    $db->execute(\"INSERT INTO assignments(id,worker_id,status,order_id) VALUES(14,7,'accepted',3)\");\n    $db->execute(\"UPDATE orders SET current_assignment_id=14 WHERE id=3\");\n    $db->execute(\"CREATE TABLE invite_tokens(order_id INT,claimed_worker_id INT,status VARCHAR(30))\");\n    $db->execute(\"CREATE TABLE order_events(order_id INT,event_type VARCHAR(100))\");\n    $db->execute(\"CREATE TABLE appointment_records(order_id INT,context_type VARCHAR(30))\");\n    $inbox=new \\WorkerAdmin\\Application\\Messaging\\NotificationInbox(new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseNotificationInboxRepository($db));\n    $actor=['user_id'=>42,'worker_id'=>7];$user=['user_id'=>42,'worker_id'=>null];\n    $rows=$inbox->list($actor,1);messageMysqlAssert(count($rows['items'])===2 && $rows['unread_count']===2,'only both trusted recipient identities visible');\n    messageMysqlAssert(array_column($rows['items'],'id')===['worker-1','user-1'],'stable id ordering');\n    messageMysqlAssert($rows['items'][0]['order_no']==='MESSAGE-USER' && $rows['items'][0]['created_at']==='2026-10-08 08:00','batched order resolution and timezone');\n    messageMysqlAssert(count($inbox->list($user,1)['items'])===1,'ordinary account cannot see worker message');\n    $summary=$inbox->summary($actor);messageMysqlAssert($summary['user_todo_count']===1 && $summary['worker_todo_count']===2 && $summary['todo_count']===3,'both role todo predicates');\n    messageMysqlAssert($summary['top_todo']['order_id']==='MESSAGE-REPAIR' && $summary['top_todo']['action']==='处理待维修','repair takes top todo priority');\n    messageMysqlAssert($summary['latest_notification']===['id'=>'worker-1','title'=>'Title','created_at'=>'2026-10-08T00:00:00+00:00'],'normal conversation has bounded title and exact UTC activity, no body');\n    messageMysqlAssert($inbox->summary($user)['latest_notification']['id']==='user-1','worker and external-channel notifications excluded for ordinary identity');\n    messageMysqlAssert($inbox->summary(['user_id'=>1000,'worker_id'=>null])['latest_notification']===null,'empty inbox does not fabricate activity');\n    messageMysqlReject(static function()use($inbox,$actor){$inbox->read($actor,'other-user');},'不属于');\n    messageMysqlReject(static function()use($inbox,$user){$inbox->read($user,'worker-1');},'不属于');\n    messageMysqlReject(static function()use($inbox,$actor){$inbox->read($actor,'external');},'不属于');\n    $inbox->read($actor,'user-1');$stamp=$db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='user-1'\");$inbox->read($actor,'user-1');\n    messageMysqlAssert($stamp!==null && $db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='user-1'\")===$stamp,'single read idempotent');\n    $changed=$inbox->readBatch($actor,['worker-1','other-user','external','worker-1']);messageMysqlAssert($changed['updated_count']===1,'batch ownership/channel filtering');\n    messageMysqlAssert($inbox->readBatch($actor,['worker-1'])['updated_count']===0,'repeat batch idempotent');\n    $db->execute('UPDATE notifications SET read_at=NULL');$inbox->readAll($user);\n    messageMysqlAssert((int)$db->fetchValue('SELECT COUNT(*) FROM notifications WHERE read_at IS NOT NULL')===1,'read all ordinary identity only');\n    $inbox->readAll($actor);messageMysqlAssert((int)$db->fetchValue('SELECT COUNT(*) FROM notifications WHERE read_at IS NOT NULL')===2,'read all both roles only');\n    messageMysqlAssert($inbox->summary($actor)['latest_notification']===$summary['latest_notification'],'read acknowledgements do not reorder normal conversation');\n    $through=$inbox->list($actor,1)['read_through_id'];\n    $db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,created_at) VALUES('new-during-read-all','user',42,'in_app','event','New',UTC_TIMESTAMP())\");\n    $inbox->readAll($actor,$through);\n    messageMysqlAssert($db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='new-during-read-all'\")===null,'new notifications beyond snapshot survive read all');\n    messageMysqlReject(static function()use($inbox,$actor):void{$inbox->readAll($actor,'other-user');},'范围');\n    $db->execute(\"DELETE FROM notifications WHERE public_id='new-during-read-all'\");\n    for($i=0;$i<22;$i++)$db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,created_at) VALUES(:id,'user',42,'in_app',UTC_TIMESTAMP())\",['id'=>'page-'.$i]);\n    messageMysqlAssert(count($inbox->list($actor,1)['items'])===20 && $inbox->list($actor,1)['has_more']===true,'page lookahead');\n    messageMysqlAssert(count($inbox->list($actor,2)['items'])===4 && $inbox->list($actor,2)['has_more']===false,'final page');\n    $first=$inbox->list($actor,1);$oldSecond=$inbox->list($actor,2,$first['read_through_id']);\n    $db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,created_at) VALUES('arrived-between-pages','user',42,'in_app',UTC_TIMESTAMP())\");\n    $stableSecond=$inbox->list($actor,2,$first['read_through_id']);\n    messageMysqlAssert(array_column($stableSecond['items'],'id')===array_column($oldSecond['items'],'id'),'notification range keeps page boundary stable during arrivals');\n    $inbox->readAll($actor,$first['read_through_id']);\n    messageMysqlAssert($db->fetchValue(\"SELECT read_at FROM notifications WHERE public_id='arrived-between-pages'\")===null,'pagination range also fences read-all');\n    $db->execute(\"DELETE FROM notifications WHERE public_id='arrived-between-pages'\");\n    $db->execute(\"CREATE TABLE message_outbox(id INT AUTO_INCREMENT PRIMARY KEY,topic VARCHAR(50),business_key VARCHAR(80),status VARCHAR(20),attempt_count INT DEFAULT 0,next_attempt_at DATETIME NULL,last_error TEXT,processed_at DATETIME NULL,created_at DATETIME,updated_at DATETIME,payload_json TEXT) ENGINE=InnoDB\");\n    $repo=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseMessageOutboxRepository($db);\n    $insert=static function(string $topic,string $status,int $attempt)use($db):int{return $db->insert(\"INSERT INTO message_outbox(topic,business_key,status,attempt_count,last_error,next_attempt_at,created_at,payload_json) VALUES(:topic,'key',:status,:attempt,'13800131234 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=Secret_Key',UTC_TIMESTAMP(),UTC_TIMESTAMP(),'{\\\"user_id\\\":42}')\",['topic'=>$topic,'status'=>$status,'attempt'=>$attempt]);};\n    $id=$insert('wechat_subscribe','failed',5);$repo->retry($id);$row=$db->fetch('SELECT * FROM message_outbox WHERE id=:id',['id'=>$id]);\n    messageMysqlAssert($row['status']==='pending' && (int)$row['attempt_count']===0 && $row['last_error']===null,'retry reset fields');\n    messageMysqlAssert($row['next_attempt_at']!==null && $row['processed_at']===null,'retry schedule state');\n    messageMysqlReject(static function()use($repo,$id){$repo->retry($id);},'仅可');\n    $id=$insert('aliyun_sms','failed',5);$repo->close($id);$row=$db->fetch('SELECT * FROM message_outbox WHERE id=:id',['id'=>$id]);\n    messageMysqlAssert($row['status']==='closed' && $row['next_attempt_at']===null && $row['last_error']!==null,'close stops schedule retains evidence');\n    messageMysqlReject(static function()use($repo,$id){$repo->close($id);},'仅可');\n    foreach([['aliyun_paid_sms','failed',5],['unknown','failed',5],['aliyun_sms','failed',4],['aliyun_sms','processing',5]]as $case){\n        $id=$insert(...$case);messageMysqlReject(static function()use($repo,$id){$repo->retry($id);},$case[0]==='aliyun_paid_sms'?'付费短信':($case[0]==='unknown'?'类型':'仅可'));\n        messageMysqlAssert($db->fetchValue('SELECT status FROM message_outbox WHERE id=:id',['id'=>$id])===$case[1],'rejected retry unchanged');\n    }\n    $id=$insert('aliyun_sms','failed',5);\n    try{$db->transaction(static function()use($repo,$id):void{$repo->retry($id);throw new RuntimeException('rollback sentinel');});}catch(RuntimeException $e){messageMysqlAssert($e->getMessage()==='rollback sentinel','outer rollback propagated');}\n    messageMysqlAssert($db->fetchValue('SELECT status FROM message_outbox WHERE id=:id',['id'=>$id])==='failed','joined transaction rolls back retry');\n    $other->execute('SET innodb_lock_wait_timeout=1');$otherRepo=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseMessageOutboxRepository($other);\n    $db->transaction(static function()use($db,$otherRepo,$id):void{\n        $db->fetch('SELECT id FROM message_outbox WHERE id=:id FOR UPDATE',['id'=>$id]);\n        messageMysqlReject(static function()use($otherRepo,$id){$otherRepo->retry($id);},'Lock wait timeout');\n        $db->execute(\"UPDATE message_outbox SET status='closed' WHERE id=:id\",['id'=>$id]);\n    });\n    messageMysqlReject(static function()use($otherRepo,$id){$otherRepo->retry($id);},'仅可');\n    messageMysqlAssert($other->fetchValue('SELECT status FROM message_outbox WHERE id=:id',['id'=>$id])==='closed','competing connection cannot revive closed row');\n    $dashboard=$repo->dashboard('', '',1);$display=implode(' ',array_column($dashboard['result']['rows'],'last_error_display'));\n    messageMysqlAssert(strpos($display,'13800131234')===false && strpos($display,'Secret_Key')===false && strpos($display,'地址已隐藏')!==false,'admin error display redaction');\n    $db->execute(\"CREATE TABLE sms_recipient_suppressions(id INT AUTO_INCREMENT PRIMARY KEY,mobile_hmac VARCHAR(80) UNIQUE,mobile_masked VARCHAR(30),reason VARCHAR(40),note TEXT,status VARCHAR(20),created_by_admin_id INT,created_at DATETIME,updated_at DATETIME) ENGINE=InnoDB\");\n    $repo->addSuppression('hash','138****1234','opt_out','note',9);$repo->addSuppression('hash','138****1234','manual','again',8);\n    messageMysqlAssert((int)$db->fetchValue('SELECT COUNT(*) FROM sms_recipient_suppressions')===1,'suppression duplicate upsert');\n    messageMysqlAssert((int)$db->fetchValue('SELECT created_by_admin_id FROM sms_recipient_suppressions')===8,'suppression admin recorded');\n    $repo->removeSuppression(1);messageMysqlAssert($db->fetchValue('SELECT status FROM sms_recipient_suppressions WHERE id=1')==='inactive','suppression removed');\n    $repo->addSuppression('hash','138****1234','manual','again',9);messageMysqlAssert(count($repo->dashboard('','',1,'suppressions')['suppressionResult']['rows'])===1,'active suppression projection');\n    $db->execute('CREATE TABLE scheduler_runs(id INT AUTO_INCREMENT PRIMARY KEY,job_name VARCHAR(80),status VARCHAR(30),started_at DATETIME,finished_at DATETIME,failure_count INT) ENGINE=InnoDB');\n    $db->execute(\"INSERT INTO scheduler_runs(job_name,status,started_at,failure_count) VALUES('sms_dispatch','success',UTC_TIMESTAMP(),0)\");\n    $insert('wechat_subscribe','pending',0);$subRepo=new \\WorkerAdmin\\Infrastructure\\Messaging\\DatabaseSubscriptionRepository($db);$diag=$subRepo->diagnose(42);\n    messageMysqlAssert($diag['pending_count']===2 && $diag['dispatcher_healthy']===true,'diagnostic scope and dispatcher health');\n    messageMysqlAssert($subRepo->diagnose(99)['pending_count']===0,'other actor diagnostic excludes messages');\n    $db->execute(\"CREATE TABLE system_settings(setting_key VARCHAR(100) PRIMARY KEY,setting_value TEXT,value_type VARCHAR(20),group_name VARCHAR(50),is_public TINYINT,description TEXT,updated_by INT NULL,created_at DATETIME,updated_at DATETIME) ENGINE=InnoDB\");\n    $saved=$subRepo->save(42,'reviewResult',false,'reject');messageMysqlAssert($saved['last_request_status']==='reject' && $saved['remaining_count']===0,'legacy quota adapter persistence');\n    messageMysqlAssert(isset($subRepo->preferences(42)['reviewResult']) && !$subRepo->preferences(99),'preferences scope');\n    $db->execute('RENAME TABLE message_outbox TO message_outbox_full');$warning=$repo->dashboard('','',1);\n    messageMysqlAssert($warning['schemaWarning']!=='' && !$warning['result']['rows'],'missing schema graceful page');\n    $db->execute('CREATE TABLE message_outbox(id INT PRIMARY KEY,topic VARCHAR(50),business_key VARCHAR(80),status VARCHAR(20)) ENGINE=InnoDB');\n    messageMysqlAssert($repo->dashboard('','',1)['schemaWarning']==='','optional columns fallback');\n    messageMysqlReject(static function()use($repo){$repo->retry(1);},'字段');\n\n    // S14 B/S uses the full official todo scopes and a single UNION snapshot.\n    $db->execute('DELETE FROM notifications');\n    $notice=static function(string $id,string $role,int $receiver,string $json)use($db):void{$db->execute(\"INSERT INTO notifications(public_id,recipient_type,recipient_id,channel,template_key,title,data_json,created_at) VALUES(:id,:role,:receiver,'in_app','event','S14',:data,UTC_TIMESTAMP())\",['id'=>$id,'role'=>$role,'receiver'=>$receiver,'data'=>$json]);};\n    $notice('b-user1','user',42,'{\"order_id\":1}');$notice('b-user2','user',42,'{\"order_id\":\"1\"}');\n    $notice('b-worker1','worker',7,'{\"order_id\":2}');$notice('b-worker2','worker',7,'{\"order_id\":2}');\n    foreach(['broken','{}','{\"order_id\":999999}','{\"order_id\":1.0}','{\"order_id\":\"01\"}'] as $i=>$data)$notice('standalone-'.$i,'user',42,$data);\n    $notice('unowned-worker','worker',7,'{\"order_id\":1}');$notice('other-account','user',99,'{}');\n    $s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===3 && $s['standalone_unread_count']===6,'B deduplicates todo/order notices and S retains malformed/unowned links: '.json_encode($s));\n    $db->execute(\"INSERT INTO assignments(id,worker_id,status,order_id) VALUES(13,7,'accepted',1)\");\n    $db->execute(\"UPDATE orders SET assigned_worker_id=7,current_assignment_id=13,assignment_status='accepted' WHERE id=1\");\n    $s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===4 && $s['standalone_unread_count']===5,'same order in two recipient identities stays two attention items');\n    $inbox->readAll($user);$s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===4 && $s['standalone_unread_count']===0,'reading user notices preserves worker attention and formal todos');\n    $inbox->readAll($actor);$s=$inbox->summary($actor);\n    messageMysqlAssert($s['order_attention_count']===3,'reading notices never clears outstanding tasks');\n    $db->execute(\"UPDATE orders SET audit_status='approved',payment_status='paid' WHERE id=1\");\n    $db->execute(\"UPDATE assignments SET status='accepted' WHERE id=12\");$db->execute(\"UPDATE orders SET assignment_status='accepted' WHERE id=2\");\n    $db->execute(\"UPDATE after_sales SET status='resolved'\");\n    $s=$inbox->summary($actor);messageMysqlAssert($s['order_attention_count']===0,'formal business completion clears the last B item');\n    $db->execute(\"UPDATE orders SET order_source_type='platform',workflow_profile='construction',fulfillment_status='not_started' WHERE id=2\");\n    $db->execute(\"INSERT INTO order_events VALUES(2,'platform_measurement_pricing_reviewed'),(2,'platform_measurement_pricing_confirmed')\");\n    $s=$inbox->summary($actor);messageMysqlAssert($s['worker_todo_count']===1 && $s['order_attention_count']===1 && $s['top_todo']['action']==='预约施工','appointment todos use the order center scope');\n    $db->execute(\"INSERT INTO appointment_records VALUES(2,'service')\");\n    $db->execute(\"UPDATE orders SET order_source_type='platform' WHERE id=1\");\n    $db->execute(\"INSERT INTO order_events VALUES(1,'platform_measurement_pricing_reviewed')\");\n    $s=$inbox->summary($actor);messageMysqlAssert($s['user_todo_count']===1 && $s['order_attention_count']===1 && $s['top_todo']['action']==='确认平台报价','pricing confirmation todo is included');\n    $db->execute(\"UPDATE orders SET is_demo=1 WHERE id=1\");\n    messageMysqlAssert($inbox->summary($actor)['order_attention_count']===0 && $inbox->summary($actor+['is_demo_actor'=>true])['order_attention_count']===1,'demo and real attention scopes are isolated');\n\n    echo 'Messaging migration MySQL: '.$checks.' checks passed.'.PHP_EOL;\n}finally{\n    if(isset($db) && $db->pdo()->inTransaction())$db->pdo()->rollBack();\n    if(isset($other) && $other->pdo()->inTransaction())$other->pdo()->rollBack();\n    if($created)$server->exec('DROP DATABASE worker_messaging_migration_test');\n}\n","server/tests/chat_platform_fixture.php":"<?php\n\ndeclare(strict_types=1);\n\nspl_autoload_register(static function(string $class):void{\n    $prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)!==0)return;\n    $file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';\n    if(is_file($file))require_once $file;\n});\nfunction public_id():string{return strtoupper(bin2hex(random_bytes(13)));}\nrequire_once __DIR__.'/chat_platform_contract.php';\n$name=(string)getenv('CHAT_POLICY_FIXTURE_DATABASE');$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');$action=$argv[1]??'';\n$orderID=(int)($argv[2]??401);\nif(!in_array($orderID,[401,402,403],true)||($orderID!==401&&$action!=='sync'))throw new RuntimeException('Explicit fixture order required');\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'||preg_match('/^bixuan_test_policy_platform_[a-z0-9]+$/D',$name)!==1\n    ||preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$m)!==1||!in_array($action,['init','sync','close','repair','repair-close','config-blocked','user-blocked','attention-seed'],true))throw new RuntimeException('Explicit isolated platform fixture required');\n$db=new \\WorkerAdmin\\Core\\Database(['host'=>'127.0.0.1','port'=>(int)$m[1],'database'=>$name,'username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4']);\nif($action==='init'){\n    (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n    chatPlatformSeed($db);\n}\n$db->execute('SET SESSION innodb_lock_wait_timeout=1');\ntry{\n    $db->transaction(static function(\\WorkerAdmin\\Core\\Database $db)use($action,$orderID):void{\n        if($action==='config-blocked')$db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");\n        elseif($action==='user-blocked')$db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");\n        else{\n            if($action==='attention-seed'){\n                for($i=1;$i<=125;$i++){\n                    $id=5000+$i;\n                    $db->execute(\"INSERT INTO orders(id,public_no,user_id,workflow_profile,order_source_type,audit_status,publish_status,lifecycle_status,payment_status,assignment_status,booking_fee_cents,final_amount_cents,created_at,updated_at) VALUES(:id,:no,10204,'construction','platform','approved','hidden','active','not_required','accepted',0,12000,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id,'no'=>'CHAT-ATTENTION-'.$id]);\n                    $db->execute(\"INSERT INTO order_platform_terms(order_id,customer_flow_mode,customer_contract_total_cents,worker_labor_cents,created_at,updated_at) VALUES(:id,'platform_managed',12000,10000,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id]);\n                    $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at) SELECT :id,:public,:order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at FROM assignments WHERE id=401\",['id'=>$id,'public'=>public_id(),'order_id'=>$id]);\n                    $db->execute(\"UPDATE orders SET current_assignment_id=:id,assigned_worker_id=30 WHERE id=:id\",['id'=>$id]);\n                    (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->synchronize($id);\n                }\n                return;\n            }\n            if($action==='close')$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=401\");\n            if($action==='repair'){\n                $repair=$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at)\n                    VALUES('CHAT-GO-REPAIR',401,10204,'warranty_repair','测试售后','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n                (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->acceptWorker(401,(int)$repair,30);\n            }elseif($action==='repair-close'){\n                $repair=(int)$db->fetchValue(\"SELECT id FROM after_sales WHERE public_no='CHAT-GO-REPAIR'\");\n                $db->execute(\"UPDATE after_sales SET status='resolved',closed_at=UTC_TIMESTAMP() WHERE id=:id\",['id'=>$repair]);\n                (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->close(401,$repair);\n            }\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge($db,true))->synchronize($orderID);\n        }\n    });\n    if(strpos($action,'blocked')!==false)throw new RuntimeException('Missing authority shared lock');\n    echo \"committed\\n\";\n}catch(PDOException $error){\n    if(strpos($action,'blocked')===false||($error->errorInfo[1]??0)!==1205)throw new RuntimeException('Platform fixture SQL failed; code='.(string)($error->errorInfo[1]??0));\n    echo \"blocked\\n\";\n}\n","server/tests/chat_platform_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatPolicyMaintenance;\n\n/** Reused by the PHP and Go real-MySQL suites; no copied application SQL. */\nfunction chatPlatformSeed(Database $db): void\n{\n    foreach([10201=>'active',10202=>'active',10203=>'active',10204=>'platform_unbound'] as $id=>$status){\n        $db->execute(\"INSERT INTO users(id,public_id,status,created_at,updated_at) VALUES(:id,:public,:status,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id,'public'=>public_id(),'status'=>$status]);\n    }\n    $db->execute(\"INSERT INTO worker_profiles(id,user_id,public_id,display_name,verification_status,created_at,updated_at) VALUES(30,10202,:public,'测试师傅','approved',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>public_id()]);\n    foreach(['wechat.miniapp_appid'=>'chat-platform-app','wechat.admin_openids'=>'[\"PlatformStaff\"]'] as $key=>$value){\n        $db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,created_at,updated_at)\n            VALUES(:key,:value,'string',UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type='string'\",['key'=>$key,'value'=>$value]);\n    }\n    $db->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10203,'chat-platform-app','PlatformStaff','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    foreach([401=>'construction',402=>'construction',403=>'measurement',404=>'construction',405=>'construction',406=>'construction'] as $id=>$profile){\n        $bound=in_array($id,[402,404],true);$ordinary=$id===404;$unassigned=$id===406;$offered=$id===405;\n        $db->execute(\"INSERT INTO orders(id,public_no,user_id,workflow_profile,order_source_type,audit_status,publish_status,lifecycle_status,payment_status,assignment_status,booking_fee_cents,final_amount_cents,quote_deadline_at,created_at,updated_at)\n            VALUES(:id,:no,:user,:profile,:source,'approved',:publish,:life,:payment,:assignment,0,12000,UTC_TIMESTAMP()+INTERVAL 1 DAY,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['id'=>$id,'no'=>'CHAT-PLATFORM-'.$id,'user'=>$bound?10201:10204,'profile'=>$profile,'source'=>$ordinary?'consumer':'platform','publish'=>$unassigned?'published':'hidden','life'=>$ordinary?'completed':'active','payment'=>$ordinary?'paid':'not_required','assignment'=>$unassigned?'unassigned':($offered?'offered':'accepted')]);\n        if(!$ordinary)$db->execute(\"INSERT INTO order_platform_terms(order_id,customer_flow_mode,customer_contract_total_cents,worker_labor_cents,created_at,updated_at) VALUES(:id,'platform_managed',12000,10000,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['id'=>$id]);\n        if($unassigned)continue;\n        $rule=$db->insert(\"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,status,created_at) VALUES(:id,1,0,0,'active',UTC_TIMESTAMP())\",['id'=>$id]);\n        $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at)\n            VALUES(:id,:public,:order_id,30,'admin',:rule,10000,0,0,0,0,10000,10000,:status,UTC_TIMESTAMP(),:accepted,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n            ['id'=>$id,'public'=>public_id(),'order_id'=>$id,'rule'=>$rule,'status'=>$offered?'offered':'accepted','accepted'=>$offered?null:gmdate('Y-m-d H:i:s')]);\n        $db->execute('UPDATE orders SET current_assignment_id=:assignment,assigned_worker_id=30 WHERE id=:id',['assignment'=>$id,'id'=>$id]);\n    }\n}\n\nfunction chatPlatformLifecycleContract(Database $db,array $config): void\n{\n    chatPlatformSeed($db);$bridge=new DatabaseOrderConversationBridge($db,true);\n    $sync=static function(int $id)use($db,$bridge):array{return $db->transaction(static function()use($bridge,$id):array{return $bridge->synchronize($id);});};\n    $snapshot=static function(int $id)use($db):array{return json_decode((string)$db->fetchValue('SELECT snapshot_json FROM chat_policy_guards WHERE order_id=:id ORDER BY id DESC LIMIT 1',['id'=>$id]),true,32,JSON_THROW_ON_ERROR);};\n    $maintenance=new DatabaseChatPolicyMaintenance($db);\n    policyAssert($maintenance->preflight()['revocation_triggers']===9,'enablement check verifies real trigger sources and authority seeds');\n    $db->execute('DROP TRIGGER chat_staff_wechat_update');\n    $rejected=false;try{$maintenance->backfill(400,2,false);}catch(RuntimeException $error){$rejected=true;}\n    policyAssert($rejected,'missing revocation trigger blocks preview/apply, not a permissive fallback');\n    require_once __DIR__.'/chat_migration_fixture.php';chatFixtureMigration($db->pdo(),'staff');\n    $before=(int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards');\n    $preview=$maintenance->backfill(400,2,false);\n    policyAssert($preview['scanned']===2 && $preview['has_more'] && $preview['next_after']===402,'bounded dry-run and stable resumable cursor');\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards')===$before,'dry-run performs no policy/event/refresh writes');\n    $maintenance->backfill(400,100,true);\n    policyAssert($snapshot(401)['schema_version']===2 && array_column($snapshot(401)['members'],'actor_id')===['10202','10203'],'real unbound platform scope has worker and named platform staff only');\n    policyAssert(count($snapshot(402)['members'])===3 && $snapshot(403)['state']==='open','bound platform and measurement share the policy');\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards WHERE order_id IN (404,405)')===0,'historical completed orders and unaccepted offers are not backfilled');\n    policyAssert($sync(401)===[],'platform projection repeats without incrementing policy version');\n    $initial=$snapshot(401);\n    $epoch=(string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"platformstaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    policyAssert((string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0')!==$epoch,'case-only OpenID edits revoke even on unicode_ci settings columns');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    $epoch=(string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0');\n    try{$db->transaction(static function(Database $db):void{$db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");throw new RuntimeException('rollback fixture');});}catch(RuntimeException $error){}\n    policyAssert((string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=0')===$epoch,'configuration epoch rolls back with original settings');\n    $db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");\n    $sync(401);policyAssert(count($snapshot(401)['members'])===1 && !$snapshot(401)['members'][0]['can_send'],'unbound worker waits safely when no platform staff is available');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    $sync(401);policyAssert($snapshot(401)['state']==='open' && $snapshot(401)['staff_config_version']!==$initial['staff_config_version'],'remove/re-add uses a new staff interval, without a business reopen');\n    $beforeStaff=$snapshot(401)['members'][1]['authority_version'];\n    $db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");\n    $db->execute(\"UPDATE users SET status='active' WHERE id=10203\");\n    $sync(401);policyAssert($snapshot(401)['members'][1]['authority_version']!==$beforeStaff,'disable/re-enable never resurrects original staff authority generation');\n    $epoch=(string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=10203');\n    $db->execute(\"UPDATE users SET nickname='测试工作人员' WHERE id=10203\");\n    policyAssert((string)$db->fetchValue('SELECT authority_version FROM chat_staff_authority_versions WHERE user_id=10203')===$epoch,'non-authority profile edits do not churn staff generations');\n\n    // Execute the real platform quote selection transaction, including failure\n    // injection at its deferred authority write. Only notification delivery is fake.\n    $quote=$db->insert(\"INSERT INTO quotes(public_id,order_id,quote_type,worker_id,amount_cents,booking_fee_cents,status,current_version,created_at,updated_at)\n        VALUES(:public,406,'worker',30,10000,0,'active',1,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>public_id()]);\n    $cipher=new class implements \\WorkerAdmin\\Contracts\\PrivateValueCipher {\n        public function hmac(string $plainText,string $context):string{return hash('sha256',$plainText);}\n        public function encrypt(string $plainText,string $context):?string{return $plainText;}\n        public function decrypt(string $cipherText,string $context):string{return $cipherText;}\n    };\n    $adminRepo=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabasePlatformOrderAdminRepository($db,$cipher);\n    $db->execute(\"CREATE TRIGGER fixture_platform_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;try{$adminRepo->selectQuote(406,(int)$quote,0);}catch(PDOException $error){$failed=($error->errorInfo[1]??0)===1644;}\n    $db->execute('DROP TRIGGER fixture_platform_failure');\n    policyAssert($failed && $db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=406')===null,'authority failure rolls real platform deal back');\n    policyAssert($db->fetchValue('SELECT status FROM quotes WHERE id=:id',['id'=>$quote])==='active','failed deal preserves quote status');\n    $adminRepo->selectQuote(406,(int)$quote,0);\n    policyAssert($snapshot(406)['state']==='open' && $db->fetchValue('SELECT status FROM quotes WHERE id=:id',['id'=>$quote])==='selected','actual platform deal creates the guarded assignment');\n\n    // Run every newly wired production event outlet against final transaction\n    // facts; method signatures stay the actual repository contracts.\n    foreach(['DatabasePlatformOrderAdminRepository','DatabasePlatformOrderFinanceRepository','DatabasePlatformOrderCustomerShareRepository',\n        'PlatformPricingAwareOrderMeasurementCompletionRepository','PlatformOrderRefundReviewWriter'] as $i=>$class){\n        $assignment=510+$i;\n        $db->execute(\"INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at)\n            SELECT :id,:public,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM assignments WHERE id=401\",['id'=>$assignment,'public'=>public_id()]);\n        $db->execute(\"UPDATE orders SET lifecycle_status='active',current_assignment_id=:id WHERE id=401\",['id'=>$assignment]);$sync(401);\n        $db->transaction(static function(Database $db)use($class):void{\n            $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\'.$class);$repo=$reflection->newInstanceWithoutConstructor();\n            $event=$reflection->getMethod('event');$event->setAccessible(true);\n            $db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=401\");\n            if(in_array($class,['DatabasePlatformOrderCustomerShareRepository','PlatformPricingAwareOrderMeasurementCompletionRepository'],true))$event->invoke($repo,$db,401,'fixture_platform_closed','system',0,[]);\n            else $event->invoke($repo,$db,401,'fixture_platform_closed',0,[]);\n        });\n        policyAssert($snapshot(401)['state']==='readonly',$class.' closes policy in the owner transaction');\n    }\n    $closed=$snapshot(401);\n    $db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");$sync(401);\n    policyAssert($snapshot(401)===$closed,'completed historical roster is never replaced by a fresh staff list');\n    $db->execute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\");\n    // A real explicitly accepted platform repair may open a NEW episode.\n    $db->execute(\"UPDATE assignments SET status='completed' WHERE id=:id\",['id'=>$closed['assignment_id']]);\n    $db->execute(\"UPDATE orders SET assignment_status='completed' WHERE id=401\");\n    $repair=$db->insert(\"INSERT INTO after_sales(public_no,order_id,user_id,type,description,status,opened_at,created_at,updated_at)\n        VALUES('CHAT-PLATFORM-REPAIR',401,10204,'warranty_repair','测试售后','processing',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n    $episodes=new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true);\n    $db->transaction(static function()use($episodes,$repair):void{$episodes->acceptWorker(401,(int)$repair,30);});\n    policyAssert($snapshot(401)['state']==='open' && strpos($snapshot(401)['episode_key'],':repair:')!==false,'explicit platform repair acceptance opens only its immutable generation');\n    $db->transaction(static function(Database $db)use($episodes,$repair):void{$db->execute(\"UPDATE after_sales SET status='resolved',closed_at=UTC_TIMESTAMP() WHERE id=:id\",['id'=>$repair]);$episodes->close(401,(int)$repair);});\n    policyAssert($snapshot(401)['state']==='readonly','platform repair closure retains history only');\n\n    // Refresh remains bounded and recovers a revoked roster without new chat\n    // messages. A broken row backs off; a later healthy row still completes.\n    $db->execute(\"UPDATE chat_policy_refresh SET next_check_at=DATE_SUB(UTC_TIMESTAMP(),INTERVAL 1 MINUTE) WHERE order_id IN (402,403,406)\");\n    $db->execute(\"CREATE TRIGGER fixture_refresh_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $db->execute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\");\n    $run=$maintenance->refresh(1);policyAssert($run['scanned']===1 && $run['failure']===1,'refresh hard limit and failure audit');\n    $db->execute('DROP TRIGGER fixture_refresh_failure');\n    $run=$maintenance->refresh(2);policyAssert($run['scanned']===2 && $run['failure']===0,'failed first row cannot starve later orders');\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM scheduled_job_failures WHERE job_name='chat_policy_refresh' AND resolved_at IS NULL\")===1,'refresh failure remains visible for repair');\n    $GLOBALS['chat_policy_fixture_enabled']=false;\n    policyAssert($maintenance->refresh()['scanned']===0,'disabled maintenance is independent of chat tables');\n    $blocked=false;try{$maintenance->backfill(0,1,true);}catch(RuntimeException $error){$blocked=true;}policyAssert($blocked,'apply refuses disabled order policy');\n    $GLOBALS['chat_policy_fixture_enabled']=true;\n    echo \"平台真实成交/回滚、入口关闭、售后、撤权代次及分页回填/恢复专项通过\\n\";\n}\n","server/tests/chat_migration_fixture.php":"<?php\n\ndeclare(strict_types=1);\n\n// Minimal policy/identity fixtures use named sections of the actual release\n// package. The full 2.6.0 -> 2.7.0 path is separately tested against real schema.\nfunction chatFixtureMigration(PDO $pdo, string $section): void\n{\n    if (getenv('CHAT_AUTH_TEST_INTEGRATION') !== '1'\n        || !in_array($section,['identity','policy','repair','staff'],true)) {\n        throw new RuntimeException('Explicit isolated chat fixture required');\n    }\n    $sql=(string)file_get_contents(dirname(__DIR__).'/database/upgrades/2.7.0.sql');\n    $start='-- CHAT_SECTION '.$section.\"\\n\";$end='-- CHAT_END '.$section;\n    $parts=explode($start,$sql);\n    if(count($parts)!==2 || count(explode($end,$parts[1]))!==2)throw new RuntimeException('Chat migration section missing');\n    (new \\WorkerAdmin\\Support\\SqlScriptRunner())->run($pdo,explode($end,$parts[1])[0],'2.7.0.sql:'.$section);\n}\n","server/tests/chat_text_security_contract.php":"<?php\n\ndeclare(strict_types=1);\n\n// Pure isolated coordinator tests. No real AppSecret, WeChat or notifications.\n$root=dirname(__DIR__,2);\nspl_autoload_register(static function(string $class)use($root):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)!==0)return;$path=$root.'/server/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($path))require_once $path;});\nuse WorkerAdmin\\Infrastructure\\External\\WeChatAccessTokenProvider;\nfunction app_config(string $key,$default=null){return $GLOBALS['s07_settings'][$key]??$default;}\nfunction setting(string $key,$default=null){return $GLOBALS['s07_settings'][$key]??$default;}\nfunction base_path(string $path=''):string{return $GLOBALS['s07_root'].($path!==''?'/'.$path:'');}\nfunction s07_assert(bool $ok,string $message):void{if(!$ok)throw new RuntimeException($message);}\nfunction s07_remove(string $dir):void{foreach(scandir($dir)?:[] as $name){if($name==='.'||$name==='..')continue;$path=$dir.'/'.$name;if(is_dir($path)&&!is_link($path))s07_remove($path);else unlink($path);}rmdir($dir);}\nfunction s07_provider(string $directory,string $secret='fixture-secret',?callable $request=null,string $environment='test'):WeChatAccessTokenProvider{\n return new WeChatAccessTokenProvider($environment,'chat-platform-app',$secret,$directory.'/tokens',$directory.'/export',$request??static function():array{return ['access_token'=>'s07_fixture_official_token','expires_in'=>7200];});\n}\n$mode=$argv[1]??'';\nif(in_array($mode,['--child','--export'],true)){\n $directory=$argv[2]??'';\n if(!is_dir($directory)||is_link($directory)||preg_match('/^bixuan-s07-[a-zA-Z0-9]+$/D',basename($directory))!==1)throw new RuntimeException('Explicit S07 fixture directory required');\n if($mode==='--export'){\n  if(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1')throw new RuntimeException('Explicit integration fixture required');\n  s07_provider($directory)->get();echo \"exported\\n\";exit;\n }\n $provider=s07_provider($directory,'fixture-secret',static function()use($directory):array{\n  file_put_contents($directory.'/requests','refresh\\n',FILE_APPEND|LOCK_EX);usleep(200000);\n  return ['access_token'=>'s07_fixture_official_token','expires_in'=>7200];\n });\n $provider->get();echo \"ok\\n\";exit;\n}\n$directory=sys_get_temp_dir().'/bixuan-s07-'.bin2hex(random_bytes(6));mkdir($directory,0700);\ntry{\n // Eight independent PHP processes contend for the same credential lock.\n $processes=[];\n for($i=0;$i<8;$i++){\n  $pipes=[];$process=proc_open([PHP_BINARY,__FILE__,'--child',$directory],[0=>['pipe','r'],1=>['pipe','w'],2=>['pipe','w']],$pipes);\n  s07_assert(is_resource($process),'child startup');fclose($pipes[0]);$processes[]=[$process,$pipes];\n }\n foreach($processes as [$process,$pipes]){$out=stream_get_contents($pipes[1]);$error=stream_get_contents($pipes[2]);fclose($pipes[1]);fclose($pipes[2]);s07_assert(proc_close($process)===0&&trim($out)==='ok','concurrent credential child failed: '.$error);}\n s07_assert(substr_count((string)file_get_contents($directory.'/requests'),'refresh')===1,'multiple concurrent refreshers');\n $provider=s07_provider($directory);$token=$provider->get();$export=$provider->exportPath();$data=json_decode((string)file_get_contents($export),true);\n s07_assert($data['env']==='test'&&$data['app_id']==='chat-platform-app'&&$data['generation']===$provider->generation($token),'export scope/generation');\n s07_assert(!array_key_exists('credential_hash',$data)&&strpos(json_encode($data),'fixture-secret')===false,'AppSecret exported');\n s07_assert((fileperms($export)&0777)===0640,'export mode');\n s07_assert($provider->metadata()['status']==='ready','read-only export preflight');\n chmod($export,0644);clearstatcache(true,$export);try{$provider->metadata();throw new LogicException('insecure export reported ready');}catch(RuntimeException $expected){}\n $provider->get();clearstatcache(true,$export);s07_assert((fileperms($export)&0777)===0640,'coordinator did not repair export permissions');\n $generation=$provider->generation($token);s07_assert($provider->rejectGeneration(str_repeat('a',64))===false,'unrelated invalidation');\n s07_assert($provider->rejectGeneration($generation),'rejected generation not invalidated');\n $revoked=json_decode((string)file_get_contents($export),true);s07_assert($revoked['token']===''&&$revoked['expires_at']===0,'revocation must stop cached Go generation');\n $fresh=s07_provider($directory,'fixture-secret',static function():array{return ['access_token'=>'s07_fixture_rotated_token','expires_in'=>7200];});$fresh->get();\n s07_assert($provider->rejectGeneration($generation)===false,'late invalidation erased a newer token');\n // TTL must never be inflated; valid old token survives a refresh outage.\n $shortDir=$directory.'/short';mkdir($shortDir,0700);\n $short=s07_provider($shortDir,'fixture-secret',static function():array{return ['access_token'=>'s07_fixture_short_token','expires_in'=>60];});$short->get();$shortData=json_decode((string)file_get_contents($short->exportPath()),true);\n s07_assert($shortData['expires_at']-$shortData['issued_at']===60,'provider TTL extended');\n $failing=s07_provider($shortDir,'fixture-secret',static function():array{throw new RuntimeException('secret fixture must not leak');});s07_assert($failing->get()==='s07_fixture_short_token','valid credential outage fallback');\n $expiry=json_decode((string)file_get_contents($short->exportPath()),true);s07_assert($expiry['expires_at']===$shortData['expires_at'],'fallback extended expiry');\n foreach(glob($shortDir.'/tokens/*.json')?:[] as $file){$row=json_decode((string)file_get_contents($file),true);$row['issued_at']=time()-100;$row['expires_at']=time()-1;file_put_contents($file,json_encode($row));}\n try{$failing->get();throw new LogicException('expired credential used');}catch(RuntimeException $e){s07_assert(strpos($e->getMessage(),'secret fixture')===false,'raw credential transport error leaked');}\n // A changed AppSecret cannot reuse the previous configuration cache.\n $rotated=s07_provider($directory,'new-fixture-secret',static function():array{return ['access_token'=>'s07_fixture_new_secret','expires_in'=>7200];});s07_assert($rotated->get()==='s07_fixture_new_secret','secret rotation reused old credential');\n $other=s07_provider($directory,'new-fixture-secret',static function():array{return ['access_token'=>'s07_fixture_production','expires_in'=>7200];},'production');s07_assert($other->get()==='s07_fixture_production','cross-environment credential collision');\n // All five legacy callers use the same coordinator cache, including the\n // subscription Infrastructure adapter. No constructor injection in runtime.\n $GLOBALS['s07_root']=$directory.'/legacy';mkdir($GLOBALS['s07_root'],0700);\n $GLOBALS['s07_settings']=['app.env'=>'test','wechat.miniapp_appid'=>'chat-platform-app','wechat.miniapp_secret'=>'fixture-secret','chat.safety_credential_export_enabled'=>true];\n $legacy=new WeChatAccessTokenProvider('test','chat-platform-app','fixture-secret',base_path('storage/private/wechat-tokens'),base_path('storage/private/chat-credentials'),static function():array{return ['access_token'=>'s07_fixture_shared_legacy','expires_in'=>7200];});$legacy->get();\n foreach(['Services\\\\WeChatContentSecurityService','Services\\\\WeChatCloudSyncService','Services\\\\MiniProgramCodeService','Services\\\\WorkerCloudGatewayService','Infrastructure\\\\External\\\\WeChatSubscribeGateway'] as $name){\n  $class='WorkerAdmin\\\\'.$name;$object=new $class();$method=new ReflectionMethod($class,'accessToken');s07_assert($method->invoke($object)==='s07_fixture_shared_legacy','legacy caller has independent refresh path: '.$name);\n }\n echo \"S07统一凭证并发、代次撤销、真实TTL、失效关闭、环境隔离及五个PHP调用方通过\\n\";\n}finally{s07_remove($directory);}\n","server/tests/chat_policy_fixture.php":"<?php\n\ndeclare(strict_types=1);\n\n// Child process for Go's real shared-lock test. Never load application config.\nrequire_once dirname(__DIR__).'/app/Core/Database.php';\nrequire_once dirname(__DIR__).'/app/Domain/Chat/OrderConversationPolicy.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseOrderConversationBridge.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseChatRepairEpisodes.php';\nrequire_once dirname(__DIR__).'/app/Support/SqlScriptRunner.php';\n\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Support\\SqlScriptRunner;\n\n$name=(string)getenv('CHAT_POLICY_FIXTURE_DATABASE');\n$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');\n$action=$argv[1]??'';\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1' || preg_match('/^bixuan_test_policy_go_[a-z0-9]+$/D',$name)!==1\n    || preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$match)!==1 || !in_array($action,['init','close','close-blocked','repair','repair-close'],true)) throw new RuntimeException('Explicit isolated policy fixture required');\n$db=new Database(['host'=>'127.0.0.1','port'=>(int)$match[1],'database'=>$name,'username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4']);\nif($action==='init') {\n    $db->execute('CREATE TABLE after_sales(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,user_id BIGINT UNSIGNED,type VARCHAR(32),status VARCHAR(24),closed_at DATETIME NULL) ENGINE=InnoDB');\n    require_once __DIR__.'/chat_migration_fixture.php';foreach(['policy','repair'] as $section)chatFixtureMigration($db->pdo(),$section);\n}\n$db->execute('SET SESSION innodb_lock_wait_timeout=1');\ntry {\n    $db->transaction(static function(Database $db)use($action):void {\n        $db->fetch('SELECT id FROM orders WHERE id=77 FOR UPDATE');\n        if($action!=='init') $db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");\n        if($action==='repair') {\n            $db->execute(\"INSERT INTO after_sales VALUES(500,77,1,'warranty_repair','processing',NULL)\");\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->acceptWorker(77,500,10);\n        } elseif($action==='repair-close') {\n            $db->execute(\"UPDATE after_sales SET status='resolved',closed_at=UTC_TIMESTAMP() WHERE id=500\");\n            (new \\WorkerAdmin\\Infrastructure\\Persistence\\DatabaseChatRepairEpisodes($db,true))->close(77,500);\n        }\n        (new DatabaseOrderConversationBridge($db,true))->schedule(77);\n    });\n    if($action==='close-blocked') throw new RuntimeException('Shared lock was not held');\n    echo \"committed\\n\";\n} catch(PDOException $error) {\n    if($action!=='close-blocked' || ($error->errorInfo[1]??0)!==1205) throw new RuntimeException('Policy fixture SQL failed');\n    echo \"blocked\\n\";\n}\n","server/tests/chat_policy_contract.php":"<?php\n\ndeclare(strict_types=1);\n\nrequire_once dirname(__DIR__).'/app/Domain/Chat/OrderConversationPolicy.php';\nrequire_once dirname(__DIR__).'/app/Core/Database.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseOrderConversationBridge.php';\nrequire_once dirname(__DIR__).'/app/Support/SqlScriptRunner.php';\nrequire_once dirname(__DIR__).'/app/Contracts/SettingsProvider.php';\nrequire_once dirname(__DIR__).'/app/Domain/Identity/AdminActorPolicy.php';\nrequire_once dirname(__DIR__).'/app/Application/Identity/ActorCapabilityResolver.php';\nrequire_once dirname(__DIR__).'/app/Infrastructure/Persistence/DatabaseChatPlatformStaff.php';\nuse WorkerAdmin\\Domain\\Chat\\OrderConversationPolicy;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseOrderConversationBridge;\nuse WorkerAdmin\\Support\\SqlScriptRunner;\n\nfunction policyAssert(bool $ok,string $label): void { if (!$ok) throw new RuntimeException($label); }\nfunction app_config($key,$default=null) { return $key==='chat.order_policy_enabled' ? ($GLOBALS['chat_policy_fixture_enabled'] ?? false) : $default; }\n\nif (($argv[1] ?? '')==='--hold-guard') {\n    $input=json_decode((string)fgets(STDIN,4096),true,32,JSON_THROW_ON_ERROR);\n    policyAssert(($input['config']['host'] ?? '')==='127.0.0.1' && strpos($input['config']['database'] ?? '','bixuan_test_policy_')===0,'isolated child endpoint');\n    $child=new Database($input['config']);$pdo=$child->pdo();$pdo->beginTransaction();\n    try {\n        $child->fetch('SELECT policy_version FROM chat_policy_guards WHERE scope_key=:scope LOCK IN SHARE MODE',['scope'=>$input['scope']]);\n        echo \"locked\\n\";fflush(STDOUT);\n        $read=[STDIN];$write=[];$except=[];if (stream_select($read,$write,$except,5)>0) fgets(STDIN);\n    } finally { $pdo->rollBack(); }\n    exit;\n}\n\n$facts=['order_id'=>'77','customer_id'=>'1','customer_status'=>'active','is_demo'=>0,\n    'workflow_profile'=>'construction','order_source_type'=>'consumer','lifecycle_status'=>'active','payment_status'=>'paid',\n    'assignment_status'=>'accepted','current_assignment_id'=>'100','assigned_worker_id'=>'10',\n    'assignment_id'=>'100','assignment_order_id'=>'77','worker_id'=>'10','worker_user_id'=>'2',\n    'worker_user_status'=>'active','assignment_record_status'=>'accepted','assignment_accepted_at'=>'2026-10-21 00:00:00'];\n$policy=new OrderConversationPolicy();$snapshot=$policy->evaluate($facts);\npolicyAssert($snapshot!==null && $snapshot['scope_key']==='order:77:assignment:100' && $snapshot['state']==='open','normal accepted grant');\npolicyAssert($snapshot['members'][1]['actor_id']==='2' && $snapshot['can_invite']===false,'worker is a user, no invites');\n$released=$facts;$released['assignment_status']='info_released';policyAssert($policy->evaluate($released)===$snapshot,'explicit contact release preserves accepted chat authority');\n$measurement=$facts;$measurement['workflow_profile']='measurement';policyAssert($policy->evaluate($measurement)!==null,'measurement reuses same policy');\n$grab=$facts;$grab['dispatch_mode']='single_grab';policyAssert($policy->evaluate($grab)===$snapshot,'fixed grab shares final assignment authority');\n$merchant=$facts;$merchant['order_source_type']='merchant';policyAssert($policy->evaluate($merchant)!==null,'merchant ordinary order');\n$self=$facts;$self['worker_user_id']='1';policyAssert($policy->evaluate($self)===null,'self assignment cannot invent another participant');\nforeach (['payment_status'=>'unpaid','assignment_record_status'=>'offered','assignment_status'=>'offered',\n    'current_assignment_id'=>'99','assigned_worker_id'=>'11','assignment_order_id'=>'78','customer_status'=>'platform_unbound',\n    'worker_user_status'=>'disabled','order_source_type'=>'platform','lifecycle_status'=>'unknown','workflow_profile'=>'unknown','is_demo'=>1,\n    'assignment_id'=>'01','customer_id'=>'18446744073709551616'] as $key=>$value) {\n    $bad=$facts;$bad[$key]=$value;policyAssert($policy->evaluate($bad)===null,'fail closed '.$key);\n}\n$completed=$facts;$completed['lifecycle_status']='completed';policyAssert($policy->evaluate($completed)['state']==='readonly','completed is readonly');\n$repair=$completed;\n$repair['repair_episode']=['id'=>'900','after_sale_id'=>'500','order_id'=>'77','assignment_id'=>'100','worker_id'=>'10','accepted_user_id'=>'2',\n    'repair_order_id'=>'77','repair_user_id'=>'1','state'=>'active','accepted_at'=>'2026-10-22 00:00:00','closed_at'=>null,\n    'repair_type'=>'warranty_repair','repair_status'=>'processing','repair_closed_at'=>null];\npolicyAssert($policy->evaluate($repair)['episode_key']==='assignment:100:repair:900','explicit repair generation grants a distinct episode');\nforeach(['id'=>'0','assignment_id'=>'99','accepted_user_id'=>'3','repair_user_id'=>'3','repair_order_id'=>'78','state'=>'closed',\n    'accepted_at'=>null,'repair_type'=>'unknown','repair_status'=>'resolved','repair_closed_at'=>'2026-10-22 01:00:00'] as $key=>$value){\n    $bad=$repair;$bad['repair_episode'][$key]=$value;policyAssert($policy->evaluate($bad)===null,'repair rejects '.$key);\n}\n$big=$facts;$big['order_id']='18446744073709551615';$big['assignment_order_id']=$big['order_id'];policyAssert(strpos($policy->evaluate($big)['scope_key'],$big['order_id'])!==false,'UINT64 strings remain exact');\n$platform=$facts;\n$platform['order_source_type']='platform';$platform['payment_status']='not_required';\n$platform['customer_flow_mode']='platform_managed';$platform['booking_fee_cents']=0;\n$platform['customer_status']='platform_unbound';\n$staff=['actor_id'=>'3','kind'=>'mini','status'=>'active','is_mini_admin'=>true,'authority_version'=>'1'];\n$platform['platform_staff']=[$staff];$platform['staff_config_version']='1';\n$candidate=$policy->evaluatePlatform($platform);\npolicyAssert($candidate!==null && $candidate['schema_version']===2 && $candidate['members'][0]['role']==='worker'\n    && $candidate['members'][1]['role']==='platform_staff','unbound customer replaced only by real staff');\npolicyAssert(!in_array('1',array_column($candidate['members'],'actor_id'),true),'placeholder customer never becomes a member');\npolicyAssert($policy->evaluate($platform)===$candidate,'production platform policy uses the same authority contract');\n$alone=$platform;$alone['platform_staff']=[];policyAssert(!$policy->evaluate($alone)['members'][0]['can_send'],'no staff/customer means no writable peer, no fabricated customer');\nforeach(['construction','measurement'] as $profile)foreach(['multi_quote','single_grab'] as $dispatch){\n    $case=$platform;$case['workflow_profile']=$profile;$case['dispatch_mode']=$dispatch;\n    policyAssert($policy->evaluatePlatform($case)!==null,'platform profiles and dispatch modes share accepted assignment authority');\n}\n$bound=$platform;$bound['customer_status']='active';\npolicyAssert(count($policy->evaluatePlatform($bound)['members'])===3,'bound customer, worker and staff retain explicit roles');\n$bound['platform_staff']=[];policyAssert(count($policy->evaluatePlatform($bound)['members'])===2,'bound customer needs no invented staff');\n$collision=$platform;$collision['platform_staff']=[$staff,$staff,array_replace($staff,['actor_id'=>'2'])];\npolicyAssert(count($policy->evaluatePlatform($collision)['members'])===2,'duplicate staff and worker/admin overlap never duplicate or elevate member');\n$collision=$bound;$collision['platform_staff']=[array_replace($staff,['actor_id'=>'1'])];\npolicyAssert($policy->evaluatePlatform($collision)['members'][0]['role']==='customer','customer/admin overlap retains customer identity');\nforeach(['staff_config_version'=>'0','customer_status'=>'disabled','customer_flow_mode'=>'unknown','booking_fee_cents'=>1,\n    'payment_status'=>'paid','current_assignment_id'=>'99','assigned_worker_id'=>'11','assignment_order_id'=>'78',\n    'assignment_record_status'=>'offered','assignment_status'=>'offered','assignment_accepted_at'=>null,\n    'worker_user_status'=>'disabled','lifecycle_status'=>'unknown','is_demo'=>1,'repair_episode'=>[]] as $key=>$value){\n    $case=$platform;$case[$key]=$value;policyAssert($policy->evaluatePlatform($case)===null,'platform rejects '.$key);\n}\nforeach(['kind'=>'admin','status'=>'disabled','is_mini_admin'=>false,'actor_id'=>'01'] as $key=>$value){\n    $case=$platform;$case['platform_staff'][0][$key]=$value;policyAssert($policy->evaluatePlatform($case)===null,'staff rejects '.$key);\n}\n$limit=$bound;$limit['platform_staff']=[];\nfor($i=3;$i<=10;$i++)$limit['platform_staff'][]=array_replace($staff,['actor_id'=>(string)$i]);\npolicyAssert(count($policy->evaluatePlatform($limit)['members'])===10,'bounded ten-member candidate');\n$limit['platform_staff'][]=array_replace($staff,['actor_id'=>'11']);policyAssert($policy->evaluatePlatform($limit)===null,'no partial grants beyond group budget');\nforeach(['completed','cancelled','closed','refunded','cancel_approved_pending_refund'] as $state){\n    $case=$platform;$case['lifecycle_status']=$state;\n    $closed=$policy->evaluatePlatform($case);policyAssert($closed['state']==='readonly' && !in_array(true,array_column($closed['members'],'can_send'),true),'platform terminal read-only '.$state);\n}\necho \"平台托管身份与权限代次矩阵通过\\n\";\npolicyAssert((new DatabaseOrderConversationBridge(new Database([])))->synchronize(0)===[],'disabled bridge performs no IO');\necho \"聊天订单策略矩阵通过\\n\";\nif (getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1') {echo \"隔离授权事务验证未启用\\n\";exit;}\n\npolicyAssert(preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR'),$match)===1,'explicit isolated endpoint');\n$config=['host'=>'127.0.0.1','port'=>(int)$match[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$admin=new Database($config);$name='bixuan_test_policy_'.bin2hex(random_bytes(5));$admin->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$db=new Database($config);$bridge=new DatabaseOrderConversationBridge($db,true);\n$user='bxchat_test_'.bin2hex(random_bytes(6));$pw=bin2hex(random_bytes(16));$host=(string)(getenv('CHAT_AUTH_TEST_MYSQL_USER_HOST') ?: '127.0.0.1');\npolicyAssert(in_array($host,['127.0.0.1','%'],true),'fixture host');\ntry {\n    $db->execute('CREATE TABLE users(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE worker_profiles(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE assignments(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,worker_id BIGINT UNSIGNED,status VARCHAR(24),accepted_at DATETIME) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE orders(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED,is_demo TINYINT,workflow_profile VARCHAR(24),order_source_type VARCHAR(24),lifecycle_status VARCHAR(40),payment_status VARCHAR(24),assignment_status VARCHAR(24),current_assignment_id BIGINT UNSIGNED,assigned_worker_id BIGINT UNSIGNED) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE after_sales(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,user_id BIGINT UNSIGNED,type VARCHAR(32),status VARCHAR(24),closed_at DATETIME NULL) ENGINE=InnoDB');\n    require_once __DIR__.'/chat_migration_fixture.php';foreach ([1,2] as $unused) foreach(['policy','repair'] as $section)chatFixtureMigration($db->pdo(),$section);\n    $db->execute(\"INSERT INTO users VALUES(1,'active'),(2,'active')\");$db->execute('INSERT INTO worker_profiles VALUES(10,2)');\n    $db->execute(\"INSERT INTO assignments VALUES(100,77,10,'accepted',UTC_TIMESTAMP()),(101,77,10,'accepted',UTC_TIMESTAMP()),(102,77,10,'offered',NULL),(103,77,10,'accepted',UTC_TIMESTAMP()),(104,77,10,'accepted',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO orders VALUES(77,1,0,'construction','consumer','active','paid','accepted',100,10)\");\n    // Exercise real event outlets, isolating only the outbound notification port.\n    class ChatNotificationFixture {\n        public static int $calls=0;\n        public static function queuePersistedEvent(...$args):void{self::$calls++;}\n        public static function queue(...$args):void{self::$calls++;}\n    }\n    class_alias(ChatNotificationFixture::class,'WorkerAdmin\\\\Services\\\\OrderNotificationService');\n    foreach(['Contracts/OrderDealRepository.php','Contracts/OrderQuoteSelectionRepository.php',\n        'Infrastructure/Persistence/OrderDealAssignmentOperations.php','Infrastructure/Persistence/OrderDealQuoteOperations.php',\n        'Infrastructure/Persistence/DatabaseOrderDealRepository.php','Infrastructure/Persistence/DatabaseOrderQuoteSelectionRepository.php',\n        'Infrastructure/Persistence/DatabaseOrderPaidPaymentSettlement.php'] as $file)require_once dirname(__DIR__).'/app/'.$file;\n    $db->execute('CREATE TABLE order_events(id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,order_id BIGINT UNSIGNED,event_type VARCHAR(64),event_key VARCHAR(128) NULL,actor_type VARCHAR(24),actor_id BIGINT UNSIGNED,payload_json TEXT,created_at DATETIME) ENGINE=InnoDB');\n    $db->execute('CREATE TABLE run_empty_fee_claims(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB');\n    $db->execute(\"INSERT INTO run_empty_fee_claims VALUES(55,'paid')\");\n    $rejected=false;try {$bridge->synchronize(77);} catch(RuntimeException $e) {$rejected=true;}\n    policyAssert($rejected && !$db->pdo()->inTransaction(),'missing original transaction is rejected');\n    $sync=static function()use($db,$bridge):array{return $db->transaction(static function()use($bridge):array{return $bridge->synchronize(77);});};\n    $db->execute(\"UPDATE orders SET payment_status='unpaid' WHERE id=77\");\n    $GLOBALS['chat_policy_fixture_enabled']=true;\n    $db->transaction(static function(Database $db)use($bridge):void{\n        $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderDealRepository');$repository=$reflection->newInstanceWithoutConstructor();\n        $event=$reflection->getMethod('event');$event->setAccessible(true);$event->invoke($repository,$db,77,'assignment_accepted','system',0,[]);\n        $db->transaction(static function(Database $db)use($bridge):void{\n            $bridge->schedule(77);\n            $db->execute(\"UPDATE orders SET payment_status='paid' WHERE id=77\");\n        });\n        policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_policy_guards')===0,'projection waits until all outer writes');\n    });\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='open' && $sync()===[],'precommit reads final facts and remains idempotent');\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM chat_business_events')===1,'no duplicate event');\n    foreach ([78=>201,79=>202] as $order=>$assignment) {\n        $db->execute(\"INSERT INTO assignments VALUES(:id,:order_id,10,'accepted',UTC_TIMESTAMP())\",['id'=>$assignment,'order_id'=>$order]);\n        $db->execute(\"INSERT INTO orders VALUES(:id,1,0,'construction','consumer','active','paid','accepted',:assignment,10)\",['id'=>$order,'assignment'=>$assignment]);\n        $db->transaction(static function(Database $db)use($order):void{\n            if ($order===78) {\n                $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderQuoteSelectionRepository');$repository=$reflection->newInstanceWithoutConstructor();\n                $method=$reflection->getMethod('event');$method->setAccessible(true);$method->invoke($repository,$db,$order,'booking_fee_paid','system',0,[]);\n            } else {\n                $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderPaidPaymentSettlement');$repository=$reflection->newInstanceWithoutConstructor();\n                $property=$reflection->getProperty('db');$property->setAccessible(true);$property->setValue($repository,$db);\n                $repository->settle('run_empty_fee',['order_id'=>$order,'business_id'=>55,'payer_user_id'=>1]);\n            }\n        });\n        policyAssert($db->fetchValue(\"SELECT state FROM chat_policy_guards WHERE order_id=:id\",['id'=>$order])==='open','each production outlet schedules its own policy');\n        $db->transaction(static function(Database $db)use($bridge,$order):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=:id\",['id'=>$order]);$bridge->synchronize($order);});\n    }\n    policyAssert(ChatNotificationFixture::$calls===2,'notification port isolated while real order outlets ran');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='readonly','close commits guard');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='active' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=100')==='readonly','same episode cannot silently reopen');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute('UPDATE orders SET current_assignment_id=101 WHERE id=77');$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=101')==='open','same worker new assignment is new scope');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET current_assignment_id=102,assignment_status='offered' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert((int)$db->fetchValue(\"SELECT COUNT(*) FROM chat_policy_guards WHERE state='open'\")===0,'offered assignment closes former scope');\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET current_assignment_id=103,assignment_status='accepted' WHERE id=77\");$bridge->synchronize(77);});\n    $db->execute(\"CREATE TRIGGER fixture_event_failure BEFORE INSERT ON chat_business_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'\");\n    $failed=false;\n    try {$db->transaction(static function()use($db,$bridge):void{$db->execute('UPDATE orders SET current_assignment_id=104 WHERE id=77');$bridge->schedule(77);});} catch(PDOException $e) {$failed=($e->errorInfo[1] ?? 0)===1644;}\n    policyAssert($failed && (string)$db->fetchValue('SELECT current_assignment_id FROM orders WHERE id=77')==='103','event failure rolls back order and guard');\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=103')==='open','rollback did not close current guard');\n    $db->execute('DROP TRIGGER fixture_event_failure');\n\n    $admin->execute(\"CREATE USER '\".$user.\"'@'\".$host.\"' IDENTIFIED BY '\".$pw.\"'\");\n    foreach (['chat_policy_guards','chat_business_events'] as $table) $admin->execute(\"GRANT SELECT ON `\".$name.\"`.\".$table.\" TO '\".$user.\"'@'\".$host.\"'\");\n    $readConfig=$config;$readConfig['username']=$user;$readConfig['password']=$pw;$reader=new Database($readConfig);\n    $denied=false;try {$reader->execute(\"UPDATE chat_policy_guards SET state='open'\");}catch(Throwable $e){$denied=true;}policyAssert($denied,'Go cannot write PHP guards');\n    $runtime=(string)(getenv('CHAT_AUTH_TEST_PHP') ?: PHP_BINARY);\n    $process=proc_open([$runtime,__FILE__,'--hold-guard'],[['pipe','r'],['pipe','w'],['pipe','w']],$pipes);\n    policyAssert(is_resource($process),'shared-lock fixture process');\n    try {\n        fwrite($pipes[0],json_encode(['config'=>$readConfig,'scope'=>'order:77:assignment:103'],JSON_THROW_ON_ERROR).\"\\n\");fflush($pipes[0]);\n        policyAssert(trim((string)fgets($pipes[1]))==='locked','Go SELECT-only shared lock established');\n        $db->execute('SET SESSION innodb_lock_wait_timeout=1');$blocked=false;\n        try {$db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");$bridge->synchronize(77);});}catch(PDOException $e){$blocked=($e->errorInfo[1] ?? 0)===1205;}\n        policyAssert($blocked && $db->fetchValue('SELECT lifecycle_status FROM orders WHERE id=77')==='active','shared lock prevents close committing ahead of send');\n        fwrite($pipes[0],\"release\\n\");fflush($pipes[0]);\n    } finally {foreach($pipes as $pipe)fclose($pipe);proc_close($process);}\n    $db->transaction(static function()use($db,$bridge):void{$db->execute(\"UPDATE orders SET lifecycle_status='completed' WHERE id=77\");$bridge->synchronize(77);});\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE assignment_id=103')==='readonly','close succeeds after shared lease ends');\n    require_once __DIR__.'/chat_closure_contract.php';\n    chatClosureContract($db,$bridge);\n    require_once __DIR__.'/chat_assignment_contract.php';\n    chatAssignmentContract($config);\n    $db->execute(\"INSERT INTO assignments(id,order_id,worker_id,status,accepted_at) VALUES(1300,1300,10,'accepted',UTC_TIMESTAMP())\");\n    $db->execute(\"INSERT INTO orders(id,user_id,is_demo,workflow_profile,order_source_type,lifecycle_status,payment_status,assignment_status,current_assignment_id,assigned_worker_id) VALUES(1300,1,0,'construction','consumer','active','paid','accepted',1300,10)\");\n    $db->transaction(static function()use($bridge):void{$bridge->synchronize(1300);});\n    $other=new Database($config);\n    $db->transaction(static function(Database $db)use($bridge,$other):void{\n        policyAssert($db->fetchValue('SELECT status FROM users WHERE id=2')==='active','establish old repeatable-read view');\n        $other->execute(\"UPDATE users SET status='disabled' WHERE id=2\");\n        policyAssert($db->fetchValue('SELECT status FROM users WHERE id=2')==='active','plain SQL still sees stale view');\n        $bridge->schedule(1300);\n    });\n    policyAssert($db->fetchValue('SELECT state FROM chat_policy_guards WHERE order_id=1300')==='readonly','final projection uses current account facts despite earlier snapshot');\n    $other->execute(\"UPDATE users SET status='active' WHERE id=2\");\n    $env=getenv();$env['V250_PLATFORM_MYSQL_TEST']='1';$env['V250_DB_HOST']='127.0.0.1';$env['V250_DB_PORT']=(string)$config['port'];\n    $env['V250_DB_NAME']=$name;$env['V250_DB_USER']='root';$env['V250_DB_PASSWORD']=$config['password'];\n    $transactionTest=proc_open([$runtime,__DIR__.'/v250_transaction_mysql.php'],[STDIN,STDOUT,STDERR],$unused,null,$env);\n    policyAssert(is_resource($transactionTest) && proc_close($transactionTest)===0,'existing transaction regression');\n    $db->execute('DROP TABLE chat_business_events');$db->execute('DROP TABLE chat_policy_guards');$GLOBALS['chat_policy_fixture_enabled']=false;\n    $before=(int)$db->fetchValue('SELECT COUNT(*) FROM order_events');\n    $db->transaction(static function(Database $db):void{\n        $reflection=new ReflectionClass('WorkerAdmin\\\\Infrastructure\\\\Persistence\\\\DatabaseOrderDealRepository');$repository=$reflection->newInstanceWithoutConstructor();\n        $event=$reflection->getMethod('event');$event->setAccessible(true);$event->invoke($repository,$db,77,'fixture_disabled','system',0,[]);\n    });\n    policyAssert((int)$db->fetchValue('SELECT COUNT(*) FROM order_events')===$before+1,'disabled chat leaves original event path independent of chat tables');\n    echo \"隔离授权幂等、回滚、改派及共享锁并发验证通过\\n\";\n} finally {\n    $admin->execute('DROP DATABASE IF EXISTS `'.$name.'`');\n    $admin->execute(\"DROP USER IF EXISTS '\".$user.\"'@'\".$host.\"'\");\n}\n","server/app/Core/Database.php":"<?php\n\nnamespace WorkerAdmin\\Core;\n\nuse PDO;\nuse PDOException;\nuse RuntimeException;\nuse Throwable;\n\nclass Database\n{\n    private $config;\n    private $pdo;\n    private $transactionDepth = 0;\n    private $transactionRollbackOnly = false;\n    private array $beforeCommitCallbacks = [];\n    private bool $runningBeforeCommit = false;\n\n    // 2026-08-14：统一 PDO 连接并强制真实预处理，兼容 MySQL 5.7.44。\n    public function __construct(array $config)\n    {\n        $this->config = $config;\n    }\n\n    public function pdo()\n    {\n        if ($this->pdo instanceof PDO) {\n            return $this->pdo;\n        }\n        if (!extension_loaded('pdo_mysql')) {\n            throw new RuntimeException('服务器未安装 pdo_mysql 扩展。');\n        }\n\n        $host = isset($this->config['host']) ? $this->config['host'] : '127.0.0.1';\n        $port = isset($this->config['port']) ? (int) $this->config['port'] : 3306;\n        $database = isset($this->config['database']) ? $this->config['database'] : '';\n        $charset = isset($this->config['charset']) ? $this->config['charset'] : 'utf8mb4';\n        if ($database === '') {\n            throw new RuntimeException('数据库名称尚未配置。');\n        }\n\n        $dsn = sprintf('mysql:host=%s;port=%d;dbname=%s;charset=%s', $host, $port, $database, $charset);\n        try {\n            $this->pdo = new PDO($dsn, (string) $this->config['username'], (string) $this->config['password'], [\n                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,\n                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,\n                PDO::ATTR_EMULATE_PREPARES => false,\n                PDO::ATTR_STRINGIFY_FETCHES => false,\n                PDO::ATTR_TIMEOUT => 5,\n            ]);\n            $this->pdo->exec(\"SET SESSION sql_mode='STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'\");\n            $this->pdo->exec(\"SET time_zone='+00:00'\");\n        } catch (PDOException $exception) {\n            throw new RuntimeException('数据库连接失败，请检查安装配置。', 0, $exception);\n        }\n\n        return $this->pdo;\n    }\n\n    /**\n     * MySQL 原生预处理不允许在同一条 SQL 中重复使用同名占位符。\n     * 这里仅展开重复命名参数，继续保持 ATTR_EMULATE_PREPARES=false，避免各业务控制器重复踩坑。\n     */\n    private function prepareAndExecute($sql, array $params = [])\n    {\n        list($sql, $params) = $this->expandDuplicateNamedParameters((string) $sql, $params);\n        $statement = $this->pdo()->prepare($sql);\n        $statement->execute($params);\n        return $statement;\n    }\n\n    private function expandDuplicateNamedParameters($sql, array $params)\n    {\n        if (!$params || strpos($sql, ':') === false) {\n            return [$sql, $params];\n        }\n\n        $normalized = [];\n        foreach ($params as $key => $value) {\n            $normalized[ltrim((string) $key, ':')] = $value;\n        }\n        $seen = [];\n        $expanded = [];\n        $rewritten = preg_replace_callback('/(?<!:):([A-Za-z_][A-Za-z0-9_]*)\\b/', function ($match) use (&$seen, &$expanded, $normalized) {\n            $name = $match[1];\n            if (!array_key_exists($name, $normalized)) {\n                return $match[0];\n            }\n            $index = isset($seen[$name]) ? ++$seen[$name] : ($seen[$name] = 1);\n            $target = $index === 1 ? $name : $name . '__dup' . $index;\n            $expanded[$target] = $normalized[$name];\n            return ':' . $target;\n        }, $sql);\n\n        // 保留未出现在 SQL 中的参数会触发 HY093；因此只传递实际匹配到的命名参数。\n        // 本项目数据库层统一使用命名参数，若 SQL 没有匹配到占位符则沿用原参数以便显式暴露调用错误。\n        return [$rewritten, $expanded ?: $params];\n    }\n\n    public function fetch($sql, array $params = [])\n    {\n        $statement = $this->prepareAndExecute($sql, $params);\n        $row = $statement->fetch();\n        return $row === false ? null : $row;\n    }\n\n    public function fetchAll($sql, array $params = [])\n    {\n        return $this->prepareAndExecute($sql, $params)->fetchAll();\n    }\n\n    public function fetchValue($sql, array $params = [])\n    {\n        return $this->prepareAndExecute($sql, $params)->fetchColumn();\n    }\n\n    public function execute($sql, array $params = [])\n    {\n        return $this->prepareAndExecute($sql, $params)->rowCount();\n    }\n\n    public function insert($sql, array $params = [])\n    {\n        $this->execute($sql, $params);\n        return (int) $this->pdo()->lastInsertId();\n    }\n\n    /**\n     * 共享连接的事务加入语义：只有最外层真正 begin/commit；内层 transaction 加入当前事务。\n     * 任一内层回调抛错都会把整笔用例标记 rollback-only，即使上层业务误捕获异常，也禁止提交部分结果。\n     */\n    public function transaction(callable $callback)\n    {\n        $pdo = $this->pdo();\n        $outermost = $this->transactionDepth === 0;\n\n        if ($outermost) {\n            $pdo->beginTransaction();\n            $this->transactionRollbackOnly = false;\n            $this->beforeCommitCallbacks = [];\n        }\n        $this->transactionDepth++;\n\n        try {\n            $result = $callback($this);\n\n            if (!$outermost) {\n                $this->transactionDepth--;\n                return $result;\n            }\n\n            if ($this->transactionRollbackOnly) {\n                throw new RuntimeException('事务已因内部失败标记为回滚，禁止提交部分业务结果。');\n            }\n\n            $this->runningBeforeCommit = true;\n            ksort($this->beforeCommitCallbacks,SORT_STRING);\n            foreach ($this->beforeCommitCallbacks as $beforeCommit) $beforeCommit($this);\n            $this->runningBeforeCommit = false;\n            if ($this->transactionRollbackOnly) throw new RuntimeException('事务已因内部失败标记为回滚，禁止提交部分业务结果。');\n            $this->transactionDepth--;\n            $pdo->commit();\n            $this->resetTransactionState();\n            return $result;\n        } catch (Throwable $exception) {\n            if ($this->transactionDepth > 0) {\n                $this->transactionDepth--;\n            }\n            $this->transactionRollbackOnly = true;\n\n            if ($outermost) {\n                if ($pdo->inTransaction()) {\n                    $pdo->rollBack();\n                }\n                $this->resetTransactionState();\n            }\n            throw $exception;\n        }\n    }\n\n    /** Register bounded DML work after all outer/nested writes, before the same commit. */\n    public function beforeCommit(string $key, callable $callback): void\n    {\n        if ($this->transactionDepth<1 || !$this->pdo()->inTransaction() || $this->runningBeforeCommit\n            || $key==='' || strlen($key)>96 || (!isset($this->beforeCommitCallbacks[$key]) && count($this->beforeCommitCallbacks)>=128)) {\n            throw new RuntimeException('预提交动作必须在原事务内登记且不得递归或超过上限');\n        }\n        $this->beforeCommitCallbacks[$key]=$callback;\n    }\n\n    private function resetTransactionState()\n    {\n        $this->transactionDepth = 0;\n        $this->transactionRollbackOnly = false;\n        $this->beforeCommitCallbacks = [];\n        $this->runningBeforeCommit = false;\n    }\n\n    public function tableExists($table)\n    {\n        $count = $this->fetchValue(\n            'SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = :table',\n            ['table' => $table]\n        );\n        return (int) $count > 0;\n    }\n\n    public function columnExists($table, $column)\n    {\n        $count = $this->fetchValue(\n            'SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = :table AND column_name = :column',\n            ['table' => $table, 'column' => $column]\n        );\n        return (int) $count > 0;\n    }\n}\n\n","server/app/Support/SqlScriptRunner.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Support;\n\nuse PDO;\nuse PDOStatement;\nuse RuntimeException;\nuse Throwable;\n\n/**\n * 2026-08-14：无 Composer 环境下的 MySQL 脚本解析与执行器。\n */\nfinal class SqlScriptRunner\n{\n    /**\n     * 2026-08-14：读取并执行 SQL 文件，返回可记录到升级历史中的统计数据。\n     *\n     * @return array{file:string,checksum:string,statements:int,execution_ms:int}\n     */\n    public function runFile(PDO $pdo, string $file): array\n    {\n        $realFile = realpath($file);\n        if ($realFile === false || !is_file($realFile) || !is_readable($realFile)) {\n            throw new SqlScriptException('SQL 文件不存在或不可读。');\n        }\n\n        $sql = file_get_contents($realFile);\n        if ($sql === false) {\n            throw new SqlScriptException('SQL 文件读取失败。');\n        }\n\n        $rawChecksum = hash('sha256', $sql);\n        $result = $this->run($pdo, $sql, $realFile);\n        $result['checksum'] = $rawChecksum;\n        return $result;\n    }\n\n    /**\n     * 2026-08-14：执行 SQL 文本；单条失败时给出序号和安全摘要，避免泄露连接信息。\n     *\n     * @return array{file:string,checksum:string,statements:int,execution_ms:int}\n     */\n    public function run(PDO $pdo, string $sql, string $sourceName = 'inline.sql'): array\n    {\n        $sql = $this->removeUtf8Bom($sql);\n        if (trim($sql) === '') {\n            throw new SqlScriptException('SQL 脚本内容为空。');\n        }\n\n        $startedAt = microtime(true);\n        $statements = $this->splitStatements($sql);\n        $executed = 0;\n\n        foreach ($statements as $index => $statement) {\n            if (trim($statement) === '' || !$this->hasExecutableSql($statement)) {\n                continue;\n            }\n\n            try {\n                $this->executeStatement($pdo, $statement);\n                ++$executed;\n            } catch (Throwable $exception) {\n                $number = $index + 1;\n                $summary = $this->statementSummary($statement);\n                throw new SqlScriptException(\n                    sprintf('SQL 第 %d 条执行失败（%s）：%s', $number, $summary, $exception->getMessage()),\n                    0,\n                    $exception\n                );\n            }\n        }\n\n        return [\n            'file' => $sourceName,\n            'checksum' => hash('sha256', $sql),\n            'statements' => $executed,\n            'execution_ms' => (int) round((microtime(true) - $startedAt) * 1000),\n        ];\n    }\n\n    /**\n     * 2026-08-14：按 MySQL 语法状态拆分语句，兼容字符串、注释及 DELIMITER 指令。\n     *\n     * @return string[]\n     */\n    public function splitStatements(string $sql): array\n    {\n        $length = strlen($sql);\n        $delimiter = ';';\n        $buffer = '';\n        $statements = [];\n        $quote = null;\n        $lineComment = false;\n        $blockComment = false;\n        $lineStart = true;\n\n        for ($position = 0; $position < $length; ++$position) {\n            $character = $sql[$position];\n            $next = $position + 1 < $length ? $sql[$position + 1] : '';\n\n            if ($lineComment) {\n                $buffer .= $character;\n                if ($character === \"\\n\") {\n                    $lineComment = false;\n                    $lineStart = true;\n                }\n                continue;\n            }\n\n            if ($blockComment) {\n                $buffer .= $character;\n                if ($character === '*' && $next === '/') {\n                    $buffer .= '/';\n                    ++$position;\n                    $blockComment = false;\n                }\n                continue;\n            }\n\n            if ($quote !== null) {\n                $buffer .= $character;\n                if ($character === '\\\\' && $quote !== '`' && $next !== '') {\n                    $buffer .= $next;\n                    ++$position;\n                    continue;\n                }\n                if ($character === $quote) {\n                    if ($next === $quote) {\n                        $buffer .= $next;\n                        ++$position;\n                    } else {\n                        $quote = null;\n                    }\n                }\n                $lineStart = $character === \"\\n\";\n                continue;\n            }\n\n            if ($lineStart) {\n                $remaining = substr($sql, $position);\n                if (preg_match('/^[ \\t]*DELIMITER[ \\t]+([^\\r\\n]+)[\\r\\n]*/i', $remaining, $match) === 1) {\n                    $newDelimiter = trim($match[1]);\n                    if ($newDelimiter === '') {\n                        throw new SqlScriptException('DELIMITER 指令缺少分隔符。');\n                    }\n                    $delimiter = $newDelimiter;\n                    $position += strlen($match[0]) - 1;\n                    $lineStart = true;\n                    continue;\n                }\n            }\n\n            if ($character === '-' && $next === '-' && $this->isDashComment($sql, $position)) {\n                $buffer .= '--';\n                ++$position;\n                $lineComment = true;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($character === '#') {\n                $buffer .= $character;\n                $lineComment = true;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($character === '/' && $next === '*') {\n                $buffer .= '/*';\n                ++$position;\n                $blockComment = true;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($character === \"'\" || $character === '\"' || $character === '`') {\n                $quote = $character;\n                $buffer .= $character;\n                $lineStart = false;\n                continue;\n            }\n\n            if ($delimiter !== '' && substr($sql, $position, strlen($delimiter)) === $delimiter) {\n                if (trim($buffer) !== '') {\n                    $statements[] = trim($buffer);\n                }\n                $buffer = '';\n                $position += strlen($delimiter) - 1;\n                $lineStart = false;\n                continue;\n            }\n\n            $buffer .= $character;\n            if ($character === \"\\n\" || $character === \"\\r\") {\n                $lineStart = true;\n            } elseif ($character !== ' ' && $character !== \"\\t\") {\n                $lineStart = false;\n            }\n        }\n\n        if ($quote !== null) {\n            throw new SqlScriptException('SQL 脚本包含未闭合的字符串或标识符。');\n        }\n        if ($blockComment) {\n            throw new SqlScriptException('SQL 脚本包含未闭合的块注释。');\n        }\n        if (trim($buffer) !== '') {\n            $statements[] = trim($buffer);\n        }\n\n        return $statements;\n    }\n\n    /**\n     * 2026-08-14：MySQL 的双横线注释要求其后为空白或文件结束。\n     */\n    private function isDashComment(string $sql, int $position): bool\n    {\n        $after = $position + 2;\n        return !isset($sql[$after]) || ctype_space($sql[$after]);\n    }\n\n    /**\n     * 2026-09-24：可能返回结果集的语句统一使用 query，并完整消费全部 rowset。\n     *\n     * MySQL PREPARE/EXECUTE 的 EXECUTE 可能动态执行 SELECT；若错误地交给 PDO::exec()，\n     * mysqlnd 会保留未消费结果，下一条语句即触发 SQLSTATE HY000/2014。\n     */\n    private function executeStatement(PDO $pdo, string $statement): void\n    {\n        $command = preg_replace('/\\A(?:\\s+|--[^\\r\\n]*(?:\\r?\\n|\\z)|#[^\\r\\n]*(?:\\r?\\n|\\z)|\\/\\*(?!\\!)[\\s\\S]*?\\*\\/)*\\s*/', '', $statement);\n        $command = is_string($command) ? $command : $statement;\n        if (preg_match('/^(SELECT|SHOW|DESCRIBE|DESC|EXPLAIN|CALL|EXECUTE)\\b/i', $command) === 1) {\n            $result = $pdo->query($statement);\n            if ($result === false) {\n                throw new SqlScriptException('SQL 查询执行失败且未返回 PDOStatement。');\n            }\n            $this->drainResultSets($result);\n            return;\n        }\n        $pdo->exec($statement);\n    }\n\n    /**\n     * 2026-09-24：消费当前结果集及后续全部 rowset，确保连接可安全执行下一条 SQL。\n     */\n    private function drainResultSets(PDOStatement $statement): void\n    {\n        try {\n            do {\n                if ($statement->columnCount() > 0) {\n                    while ($statement->fetch(PDO::FETCH_NUM) !== false) {\n                        // 升级脚本只关心执行成功与否；结果内容无需保留。\n                    }\n                }\n            } while ($statement->nextRowset());\n        } finally {\n            $statement->closeCursor();\n        }\n    }\n\n    /**\n     * 2026-08-14：跳过文件末尾的纯说明注释，同时保留 MySQL 可执行版本注释。\n     */\n    private function hasExecutableSql(string $statement): bool\n    {\n        $withoutComments = preg_replace(\n            '/--[^\\r\\n]*(?:\\r?\\n|\\z)|#[^\\r\\n]*(?:\\r?\\n|\\z)|\\/\\*(?!\\!)[\\s\\S]*?\\*\\//',\n            '',\n            $statement\n        );\n        return is_string($withoutComments) && trim($withoutComments) !== '';\n    }\n\n    /**\n     * 2026-08-14：去除 UTF-8 BOM，避免第一条语句无法识别。\n     */\n    private function removeUtf8Bom(string $sql): string\n    {\n        return substr($sql, 0, 3) === \"\\xEF\\xBB\\xBF\" ? substr($sql, 3) : $sql;\n    }\n\n    /**\n     * 2026-08-14：错误页面只显示一行有限长度摘要。\n     */\n    private function statementSummary(string $statement): string\n    {\n        $redacted = preg_replace('/\\'(?:\\\\\\\\.|\\'\\'|[^\\'])*\\'/s', \"'…'\", $statement);\n        $redacted = is_string($redacted) ? preg_replace('/\"(?:\\\\\\\\.|\"\"|[^\"])*\"/s', '\"…\"', $redacted) : $statement;\n        $summary = preg_replace('/\\s+/u', ' ', trim(is_string($redacted) ? $redacted : $statement));\n        if (!is_string($summary)) {\n            return '无法生成摘要';\n        }\n        if (function_exists('mb_substr')) {\n            return mb_substr($summary, 0, 120, 'UTF-8');\n        }\n        return substr($summary, 0, 120);\n    }\n}\n\n/**\n * 2026-08-14：为安装器和升级页提供可区分的脚本异常类型。\n */\nfinal class SqlScriptException extends RuntimeException\n{\n}\n","server/app/Infrastructure/Persistence/DatabaseChatRepairEpisodes.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n\n/** Called only after the owning PHP repair command has authorized its actor. */\nfinal class DatabaseChatRepairEpisodes\n{\n    private Database $db;\n    private bool $enabled;\n    public function __construct(Database $db,bool $enabled=false){$this->db=$db;$this->enabled=$enabled;}\n\n    /** Record the worker's explicit acceptance, never infer it from processing. */\n    public function acceptWorker(int $orderId,int $afterSaleId,int $workerId): ?string\n    {\n        if(!$this->enabled)return null;\n        $order=$this->lockOrder($orderId);\n        // Unsupported order profiles retain their existing repair workflow.\n        // They never gain a chat episode until their own S04 policy is defined.\n        if((int)$order['is_demo']!==0 || (string)$order['workflow_profile']!=='construction'\n            || !in_array((string)$order['order_source_type'],['consumer','merchant','platform'],true))return null;\n        $assignment=$this->db->fetch(\n            'SELECT a.*,w.user_id worker_user_id,u.status worker_user_status FROM assignments a\n             JOIN worker_profiles w ON w.id=a.worker_id JOIN users u ON u.id=w.user_id\n             WHERE a.id=:id AND a.order_id=:order_id FOR UPDATE',\n            ['id'=>$order['current_assignment_id']??0,'order_id'=>$orderId]\n        );\n        $repair=$this->db->fetch('SELECT * FROM after_sales WHERE id=:id AND order_id=:order_id FOR UPDATE',['id'=>$afterSaleId,'order_id'=>$orderId]);\n        $customer=$this->db->fetch('SELECT status FROM users WHERE id=:id LOCK IN SHARE MODE',['id'=>$order['user_id']]);\n        $platform=(string)$order['order_source_type']==='platform';\n        $terms=$platform?$this->db->fetch('SELECT customer_flow_mode FROM order_platform_terms WHERE order_id=:id LOCK IN SHARE MODE',['id'=>$orderId]):null;\n        if((int)$order['is_demo']!==0 || (string)$order['lifecycle_status']!=='completed'\n            || (string)$order['payment_status']!==($platform?'not_required':'paid') || (string)$order['workflow_profile']!=='construction'\n            || ($platform && (($terms['customer_flow_mode']??'')!=='platform_managed' || (int)$order['booking_fee_cents']!==0))\n            || !$assignment || (int)$assignment['worker_id']!==$workerId || (int)($order['assigned_worker_id']??0)!==$workerId\n            || !in_array((string)$assignment['status'],['accepted','completed'],true) || empty($assignment['accepted_at'])\n            || (string)$assignment['worker_user_status']!=='active'\n            || !in_array($customer['status']??'', $platform?['active','platform_unbound']:['active'],true)\n            || (string)$assignment['worker_user_id']===(string)$order['user_id']\n            || !$repair || (string)$repair['type']!=='warranty_repair' || (string)$repair['status']!=='processing'\n            || !empty($repair['closed_at']) || (string)$repair['user_id']!==(string)$order['user_id']) {\n            throw new RuntimeException('售后聊天受理事实不满足真实订单与指派边界');\n        }\n        $current=$this->db->fetch('SELECT * FROM chat_repair_episodes WHERE active_order_id=:id FOR UPDATE',['id'=>$orderId]);\n        if($current){\n            if((string)$current['assignment_id']!==(string)$assignment['id'] || (int)$current['after_sale_id']!==$afterSaleId\n                || (int)$current['worker_id']!==$workerId || (string)$current['accepted_user_id']!==(string)$assignment['worker_user_id']) {\n                throw new RuntimeException('订单已有其他有效售后受理区间');\n            }\n            (new DatabaseOrderConversationBridge($this->db,true))->schedule($orderId);\n            return (string)$current['id'];\n        }\n        $id=$this->db->insert(\"INSERT INTO chat_repair_episodes(order_id,assignment_id,after_sale_id,worker_id,accepted_user_id,state,accepted_at)\n            VALUES(:order_id,:assignment_id,:after_sale_id,:worker_id,:user_id,'active',UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'assignment_id'=>$assignment['id'],'after_sale_id'=>$afterSaleId,'worker_id'=>$workerId,'user_id'=>$assignment['worker_user_id']]);\n        (new DatabaseOrderConversationBridge($this->db,true))->schedule($orderId);\n        return (string)$id;\n    }\n\n    /** A future acceptance must INSERT a new immutable episode, never reopen this row. */\n    public function close(int $orderId,int $afterSaleId): void\n    {\n        if(!$this->enabled)return;\n        $this->lockOrder($orderId);\n        $this->db->execute(\"UPDATE chat_repair_episodes SET state='closed',closed_at=UTC_TIMESTAMP()\n            WHERE order_id=:order_id AND after_sale_id=:after_sale_id AND state='active'\",['order_id'=>$orderId,'after_sale_id'=>$afterSaleId]);\n        (new DatabaseOrderConversationBridge($this->db,true))->schedule($orderId);\n    }\n\n    private function lockOrder(int $id): array\n    {\n        if($id<1 || !$this->db->pdo()->inTransaction())throw new RuntimeException('售后聊天事实必须加入原订单事务');\n        $order=$this->db->fetch('SELECT * FROM orders WHERE id=:id FOR UPDATE',['id'=>$id]);\n        if(!$order)throw new RuntimeException('售后订单不存在');\n        return $order;\n    }\n}\n","server/app/Infrastructure/Persistence/DatabaseChatPolicyMaintenance.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse InvalidArgumentException;\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\n\n/** Bounded, resumable PHP projection only; never creates a Go message or interval. */\nfinal class DatabaseChatPolicyMaintenance\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db=$db; }\n\n    /** Read-only enablement gate; it neither toggles features nor changes epochs. */\n    public function preflight(): array\n    {\n        $expected=['chat_staff_settings_insert'=>'system_settings','chat_staff_settings_update'=>'system_settings','chat_staff_settings_delete'=>'system_settings',\n            'chat_staff_user_insert'=>'users','chat_staff_user_update'=>'users','chat_staff_user_delete'=>'users',\n            'chat_staff_wechat_insert'=>'wechat_identities','chat_staff_wechat_update'=>'wechat_identities','chat_staff_wechat_delete'=>'wechat_identities'];\n        $rows=$this->db->fetchAll(\"SELECT TRIGGER_NAME,EVENT_OBJECT_TABLE,ACTION_TIMING,EVENT_MANIPULATION\n            FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA=DATABASE() AND TRIGGER_NAME LIKE 'chat_staff_%'\");\n        $actual=[];\n        foreach($rows as $row){\n            $name=(string)$row['TRIGGER_NAME'];\n            if(!isset($expected[$name]))continue;\n            if($row['ACTION_TIMING']!=='AFTER' || strtolower((string)$row['EVENT_MANIPULATION'])!==substr($name,strrpos($name,'_')+1)\n                || $row['EVENT_OBJECT_TABLE']!==$expected[$name])throw new RuntimeException('工作人员撤权触发器定义不匹配');\n            $actual[$name]=true;\n        }\n        if(count($actual)!==count($expected))throw new RuntimeException('工作人员撤权触发器缺失或不可核验');\n        $tables=['chat_policy_guards','chat_business_events','chat_repair_episodes','chat_staff_authority_versions','chat_policy_refresh',\n            'order_platform_terms','order_pricing_items','platform_order_refund_reviews','platform_order_manual_receipts'];\n        foreach($tables as $table)if(!$this->db->tableExists($table))throw new RuntimeException('聊天授权依赖表缺失');\n        $config=$this->db->fetchValue('SELECT CAST(authority_version AS CHAR) FROM chat_staff_authority_versions WHERE user_id=0');\n        $missing=(int)$this->db->fetchValue('SELECT COUNT(*) FROM users u LEFT JOIN chat_staff_authority_versions a ON a.user_id=u.id WHERE a.user_id IS NULL OR a.authority_version=0');\n        if(!$config || $config==='0' || $missing>0)throw new RuntimeException('聊天权限代次种子缺失');\n        return ['ready'=>true,'schema_target'=>'2.7.0','revocation_triggers'=>count($actual),'policy_enabled'=>$this->enabled()];\n    }\n\n    public function backfill(int $after,int $limit=100,bool $apply=false): array\n    {\n        if($after<0 || $limit<1 || $limit>100) throw new InvalidArgumentException('回填游标无效或每批超过100笔');\n        if($apply && !$this->enabled()) throw new RuntimeException('订单聊天授权开关未启用，不能执行回填');\n        $this->preflight();\n        $rows=$this->db->fetchAll(\"SELECT o.id FROM orders o WHERE o.id>:after AND o.is_demo=0\n            AND ((o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL)\n                OR EXISTS(SELECT 1 FROM chat_policy_guards g WHERE g.order_id=o.id)\n                OR EXISTS(SELECT 1 FROM chat_repair_episodes e WHERE e.active_order_id=o.id))\n            ORDER BY o.id LIMIT \".($limit+1),['after'=>$after]);\n        $more=count($rows)>$limit;$rows=array_slice($rows,0,$limit);\n        $result=['mode'=>$apply?'apply':'dry_run','scanned'=>0,'changed'=>0,'next_after'=>$after,'has_more'=>$more];\n        foreach($rows as $row){\n            $id=(int)$row['id'];\n            $scopes=$this->db->transaction(function()use($id,$apply):array{\n                return (new DatabaseOrderConversationBridge($this->db,$apply))->synchronize($id,$apply);\n            });\n            $result['scanned']++;$result['changed']+=count($scopes);$result['next_after']=$id;\n        }\n        return $result;\n    }\n\n    /** Existing all scheduler calls once; LIMIT is a hard per-run budget. */\n    public function refresh(int $limit=100): array\n    {\n        $limit=max(1,min(100,$limit));\n        $result=['task'=>'chat_policy_refresh','status'=>'success','scanned'=>0,'success'=>0,'failure'=>0];\n        if(!$this->enabled())return $result;\n        if((int)$this->db->fetchValue(\"SELECT GET_LOCK(CONCAT('chat-policy:',SHA1(DATABASE())),0)\")!==1){$result['status']='skipped';return $result;}\n        try{\n            $rows=$this->db->fetchAll(\"SELECT g.order_id FROM chat_policy_guards g\n                JOIN orders o ON o.id=g.order_id AND o.order_source_type='platform' AND o.is_demo=0\n                LEFT JOIN chat_policy_refresh r ON r.order_id=g.order_id\n                WHERE g.state='open' AND (r.order_id IS NULL OR r.next_check_at<=UTC_TIMESTAMP())\n                ORDER BY COALESCE(r.next_check_at,'1970-01-01'),g.order_id LIMIT {$limit}\");\n            foreach($rows as $row){\n                $id=(int)$row['order_id'];$result['scanned']++;\n                try{\n                    $this->db->transaction(function()use($id):void{(new DatabaseOrderConversationBridge($this->db,true))->synchronize($id);});\n                    $result['success']++;\n                    $this->db->execute(\"UPDATE scheduled_job_failures SET resolved_at=UTC_TIMESTAMP()\n                        WHERE job_name='chat_policy_refresh' AND business_key=:key AND resolved_at IS NULL\",['key'=>'order:'.$id]);\n                }catch(Throwable $error){\n                    $result['failure']++;$result['status']='failed';\n                    // A broken first row cannot starve later work. No SQL, token,\n                    // identity list or message content is copied to diagnostics.\n                    $this->db->execute(\"INSERT INTO chat_policy_refresh(order_id,checked_at,next_check_at,status)\n                        VALUES(:id,UTC_TIMESTAMP(),UTC_TIMESTAMP()+INTERVAL 5 MINUTE,'failed')\n                        ON DUPLICATE KEY UPDATE checked_at=VALUES(checked_at),next_check_at=VALUES(next_check_at),status='failed'\",['id'=>$id]);\n                    $this->db->execute(\"INSERT INTO scheduled_job_failures(job_name,business_key,business_version,error_class,error_message,next_retry_at,created_at)\n                        VALUES('chat_policy_refresh',:key,1,'CHAT_POLICY_REFRESH_FAILED','聊天授权投影恢复失败，请检查事务与升级状态',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())\",['key'=>'order:'.$id]);\n                }\n            }\n        }finally{$this->db->fetchValue(\"SELECT RELEASE_LOCK(CONCAT('chat-policy:',SHA1(DATABASE())))\");}\n        return $result;\n    }\n\n    private function enabled(): bool\n    {return function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true;}\n}\n","server/app/Contracts/PrivateValueCipher.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\n/**\n * 隐私字段加密/哈希端口。业务层不直接依赖全局加密函数。\n */\ninterface PrivateValueCipher\n{\n    public function hmac(string $plainText, string $context): string;\n\n    public function encrypt(string $plainText, string $context): ?string;\n\n    public function decrypt(string $cipherText, string $context): string;\n}\n","server/app/Infrastructure/Persistence/DatabasePlatformOrderAdminRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse PDOException;\nuse WorkerAdmin\\Contracts\\PlatformOrderAdminRepository;\nuse WorkerAdmin\\Contracts\\PrivateValueCipher;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\n\nfinal class DatabasePlatformOrderAdminRepository implements PlatformOrderAdminRepository\n{\n    private const UNBOUND_CLOUD_USER_ID = 'platform-order-unbound-v250';\n\n    private Database $db;\n    private PrivateValueCipher $cipher;\n    private PlatformOrderBookingPaymentVerifier $prepaymentVerifier;\n\n    public function __construct(Database $db, PrivateValueCipher $cipher)\n    {\n        $this->db = $db;\n        $this->cipher = $cipher;\n        $this->prepaymentVerifier = new PlatformOrderBookingPaymentVerifier();\n    }\n\n    public function dashboard(): array\n    {\n        $rows = $this->db->fetchAll(\n            \"SELECT o.id,o.public_no,o.title,o.category_name_snapshot,o.city,o.district,o.address_summary,o.lat,o.lng,\n                    o.payment_status,o.audit_status,o.publish_status,o.quote_status,o.assignment_status,o.fulfillment_status,o.lifecycle_status,\n                    o.workflow_profile,o.dispatch_mode,o.booking_fee_cents,o.expected_fee_type,o.expected_fee_cents,o.final_amount_cents,o.selected_quote_id,\n                    o.assigned_worker_id,o.current_assignment_id,o.quote_deadline_at,o.created_at,o.updated_at,u.nickname,u.mobile_masked,u.status customer_user_status,\n                    t.customer_flow_mode,t.customer_pricing_mode,t.customer_contract_total_cents,t.booking_paid_cents AS external_prepayment_cents,\n                    t.worker_settlement_mode,t.worker_labor_cents,t.extra_income_rate_bp_snapshot,t.customer_tail_cents,t.platform_receivable_cents,\n                    t.worker_balance_credit_cents,t.settlement_status,\n                    ms.order_id measurement_state_id,ms.result_status measurement_status,\n                    w.display_name AS worker_name\n             FROM orders o\n             INNER JOIN order_platform_terms t ON t.order_id=o.id\n             INNER JOIN users u ON u.id=o.user_id\n             LEFT JOIN order_measurement_states ms ON ms.order_id=o.id\n             LEFT JOIN worker_profiles w ON w.id=o.assigned_worker_id\n             WHERE o.order_source_type='platform'\n             ORDER BY o.id DESC LIMIT 100\"\n        );\n\n        foreach ($rows as &$row) {\n            $row['customer_bound'] = (string)($row['customer_user_status'] ?? '') !== 'platform_unbound';\n            $row['fulfillment_mode'] = !empty($row['measurement_state_id']) ? 'measure_then_install' : 'direct_install';\n            $row['measurement_status'] = !empty($row['measurement_state_id']) ? (string)$row['measurement_status'] : 'not_required';\n            $row['customer_flow_mode'] = (string)$row['customer_flow_mode'];\n            $row['can_review_platform_pricing'] = (string)($row['workflow_profile'] ?? '') === 'measurement'\n                && $row['measurement_status'] === 'accepted'\n                && PlatformOrderPricingReviewReadiness::isReady($this->db, (int)$row['id']);\n        }\n        unset($row);\n\n        $quotesByOrder = [];\n        $invitesByOrder = [];\n        if ($rows) {\n            $params = [];\n            $marks = [];\n            foreach ($rows as $index => $row) {\n                $key = 'order_' . $index;\n                $marks[] = ':' . $key;\n                $params[$key] = (int)$row['id'];\n            }\n            $quoted = $this->db->fetchAll(\n                \"SELECT q.id,q.order_id,q.public_id,q.amount_cents,q.description,q.status,q.updated_at,w.display_name,w.verification_status\n                 FROM quotes q INNER JOIN worker_profiles w ON w.id=q.worker_id\n                 WHERE q.quote_type='worker' AND q.order_id IN (\" . implode(',', $marks) . \")\n                 ORDER BY q.order_id DESC,q.amount_cents ASC,q.id ASC\",\n                $params\n            );\n            foreach ($quoted as $quote) $quotesByOrder[(int)$quote['order_id']][] = $quote;\n\n            $invites = $this->db->fetchAll(\n                \"SELECT i.id,i.order_id,i.status,i.max_claims,i.claim_count,i.expires_at,i.created_at,i.claimed_at,\n                        i.claimed_worker_id,w.display_name claimed_worker_name\n                 FROM invite_tokens i\n                 LEFT JOIN worker_profiles w ON w.id=i.claimed_worker_id\n                 WHERE i.purpose='worker_assignment' AND i.order_id IN (\" . implode(',', $marks) . \")\n                 ORDER BY i.order_id DESC,i.id DESC\",\n                $params\n            );\n            foreach ($invites as $invite) $invitesByOrder[(int)$invite['order_id']][] = $invite;\n        }\n\n        return [\n            'rows'=>$rows,\n            'quotesByOrder'=>$quotesByOrder,\n            'invitesByOrder'=>$invitesByOrder,\n            'users'=>$this->db->fetchAll(\"SELECT id,nickname,mobile_masked,public_id FROM users WHERE status='active' ORDER BY id DESC LIMIT 200\"),\n            'categories'=>$this->db->fetchAll(\"SELECT id,name,order_code FROM service_categories WHERE status='active' ORDER BY sort_order ASC,id ASC\"),\n        ];\n    }\n\n    public function create(array $command, int $adminId): int\n    {\n        if ((string)($command['customer_flow_mode'] ?? '') !== 'platform_managed') {\n            throw new OrderOperationException('平台承接单只允许平台托管模式。', 'PLATFORM_CUSTOMER_FLOW_INVALID', 422);\n        }\n        $requestedUserId = (int)($command['user_id'] ?? 0);\n        if ($requestedUserId > 0) {\n            $user = $this->db->fetch(\"SELECT id,nickname,status FROM users WHERE id=:id AND status='active' LIMIT 1\", ['id'=>$requestedUserId]);\n            if (!$user) throw new OrderOperationException('选择的客户账号不存在或不可用。', 'PLATFORM_USER_NOT_FOUND', 422);\n            $userId = (int)$user['id'];\n        } else {\n            $userId = $this->ensureUnboundCustomerUser();\n        }\n        $category = $this->db->fetch(\"SELECT id,name,order_code FROM service_categories WHERE id=:id AND status='active' LIMIT 1\", ['id'=>$command['category_id']]);\n        if (!$category) throw new OrderOperationException('请选择有效服务类目。', 'PLATFORM_CATEGORY_NOT_FOUND', 422);\n\n        // 与普通/代下单共用同一 order_submit 版本，不允许误取其他表单的最新 published 版本。\n        $schemaVersionId = (int)$this->db->fetchValue(\n            \"SELECT v.id FROM form_schema_versions v\n             INNER JOIN form_schemas s ON s.id=v.schema_id\n             WHERE BINARY s.schema_key=BINARY 'order_submit' AND v.status='published'\n             ORDER BY v.version_no DESC,v.id DESC LIMIT 1\"\n        );\n        if ($schemaVersionId < 1) {\n            throw new OrderOperationException('管理员尚未发布普通下单表单，暂不能创建平台承接单。', 'FORM_NOT_PUBLISHED', 503);\n        }\n\n        $province = mb_substr(trim((string)($command['province'] ?? '')), 0, 64);\n        $city = mb_substr(trim((string)($command['city'] ?? '')), 0, 64);\n        $district = mb_substr(trim((string)($command['district'] ?? '')), 0, 64);\n        $detailAddress = mb_substr(trim((string)($command['address'] ?? '')), 0, 255);\n        $fullAddress = trim(implode('', [$province,$city,$district,$detailAddress]));\n        $baseMobile = preg_match('/^(1\\d{10})/u', (string)$command['contact_mobile'], $mobileMatch) === 1\n            ? (string)$mobileMatch[1]\n            : (string)$command['contact_mobile'];\n        $maskedMobile = $this->maskContactMobile((string)$command['contact_mobile']);\n        [$lat,$lng,$locationSource,$mapPointName,$mapPointAddress] = $this->resolveLocation($command);\n        $expectedFeeType = $command['dispatch_mode'] === 'single_grab' ? 'total' : null;\n        $expectedFeeCents = $command['dispatch_mode'] === 'single_grab' ? (int)$command['worker_labor_cents'] : null;\n        $measureFirst = (string)($command['fulfillment_mode'] ?? 'direct_install') === 'measure_then_install';\n        $externalPrepayment = max(0, (int)($command['external_prepayment_cents'] ?? 0));\n\n        return $this->db->transaction(function (Database $db) use ($command,$userId,$category,$schemaVersionId,$province,$city,$district,$detailAddress,$fullAddress,$baseMobile,$maskedMobile,$expectedFeeType,$expectedFeeCents,$measureFirst,$adminId,$lat,$lng,$locationSource,$mapPointName,$mapPointAddress,$externalPrepayment): int {\n            $orderId = 0;\n            for ($attempt = 0; $attempt < 10; $attempt++) {\n                $publicNo = \\order_business_no((string)($category['order_code'] ?? 'QT'));\n                try {\n                    $orderId = $db->insert(\n                        \"INSERT INTO orders(public_no,user_id,form_schema_version_id,workflow_profile,dispatch_mode,expected_fee_type,expected_fee_cents,category_id,category_name_snapshot,category_names_snapshot,title,description,city,district,address_summary,address_ciphertext,address_hmac,lat,lng,contact_name_masked,contact_name_ciphertext,contact_mobile_masked,contact_mobile_ciphertext,contact_mobile_hmac,owner_mobile_base_hmac,order_source_type,audit_status,publish_status,quote_status,assignment_status,fulfillment_status,payment_status,refund_status,dispute_status,lifecycle_status,final_amount_cents,booking_fee_cents,commission_rate_bp,commission_min_cents,quote_deadline_at,version,created_at,updated_at)\n                         VALUES(:public_no,:user_id,:schema_version_id,'construction',:dispatch_mode,:expected_fee_type,:expected_fee_cents,:category_id,:category_name,:category_name,:title,:description,:city,:district,:address_summary,:address_ciphertext,:address_hmac,:lat,:lng,:contact_name_masked,:contact_name_ciphertext,:contact_mobile_masked,:contact_mobile_ciphertext,:contact_mobile_hmac,:owner_hmac,'platform','pending','hidden','waiting','unassigned','not_started','not_required','none','none','active',:customer_total,0,0,0,NULL,1,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                        [\n                            'public_no'=>$publicNo,\n                            'user_id'=>$userId,\n                            'schema_version_id'=>$schemaVersionId,\n                            'dispatch_mode'=>$command['dispatch_mode'],\n                            'expected_fee_type'=>$expectedFeeType,\n                            'expected_fee_cents'=>$expectedFeeCents,\n                            'category_id'=>$category['id'],\n                            'category_name'=>$category['name'],\n                            'title'=>$command['title'],\n                            'description'=>$command['description'] !== '' ? $command['description'] : null,\n                            'city'=>$city,\n                            'district'=>$district,\n                            'address_summary'=>$detailAddress,\n                            'address_ciphertext'=>$this->cipher->encrypt($fullAddress, 'order-address'),\n                            'address_hmac'=>$this->cipher->hmac($fullAddress, 'order-address'),\n                            'lat'=>$lat,\n                            'lng'=>$lng,\n                            'contact_name_masked'=>\\mask_private_name($command['contact_name']),\n                            'contact_name_ciphertext'=>$this->cipher->encrypt($command['contact_name'], 'order-contact-name'),\n                            'contact_mobile_masked'=>$maskedMobile,\n                            'contact_mobile_ciphertext'=>$this->cipher->encrypt($command['contact_mobile'], 'order-contact-mobile'),\n                            'contact_mobile_hmac'=>$this->cipher->hmac($command['contact_mobile'], 'order-contact-mobile'),\n                            'owner_hmac'=>$this->cipher->hmac($baseMobile, 'owner-mobile-base'),\n                            'customer_total'=>$command['customer_total_cents'],\n                        ]\n                    );\n                    break;\n                } catch (PDOException $exception) {\n                    if ((string)$exception->getCode() !== '23000' || $attempt === 9) throw $exception;\n                }\n            }\n            if ($orderId < 1) throw new OrderOperationException('订单号生成失败，请重试。', 'PLATFORM_ORDER_CREATE_FAILED', 409);\n\n            $db->insert(\n                \"INSERT INTO order_categories(order_id,category_id,category_name_snapshot,sort_order,created_at)\n                 VALUES(:order_id,:category_id,:category_name,0,UTC_TIMESTAMP())\",\n                ['order_id'=>$orderId,'category_id'=>$category['id'],'category_name'=>$category['name']]\n            );\n            $db->insert(\n                \"INSERT INTO order_addresses(order_id,province,city,district,address_summary,address_ciphertext,address_hmac,contact_name_masked,contact_name_ciphertext,contact_mobile_masked,contact_mobile_ciphertext,contact_mobile_hmac,lat,lng,coordinate_system,created_at,updated_at)\n                 VALUES(:order_id,:province,:city,:district,:address_summary,:address_ciphertext,:address_hmac,:contact_name_masked,:contact_name_ciphertext,:contact_mobile_masked,:contact_mobile_ciphertext,:contact_mobile_hmac,:lat,:lng,'GCJ-02',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'order_id'=>$orderId,\n                    'province'=>$province,\n                    'city'=>$city,\n                    'district'=>$district,\n                    'address_summary'=>$detailAddress,\n                    'address_ciphertext'=>$this->cipher->encrypt($fullAddress, 'order-address'),\n                    'address_hmac'=>$this->cipher->hmac($fullAddress, 'order-address'),\n                    'contact_name_masked'=>\\mask_private_name($command['contact_name']),\n                    'contact_name_ciphertext'=>$this->cipher->encrypt($command['contact_name'], 'order-contact-name'),\n                    'contact_mobile_masked'=>$maskedMobile,\n                    'contact_mobile_ciphertext'=>$this->cipher->encrypt($command['contact_mobile'], 'order-contact-mobile'),\n                    'contact_mobile_hmac'=>$this->cipher->hmac($command['contact_mobile'], 'order-contact-mobile'),\n                    'lat'=>$lat,'lng'=>$lng,\n                ]\n            );\n            $db->insert(\n                \"INSERT INTO order_platform_terms(order_id,customer_flow_mode,customer_pricing_mode,customer_contract_total_cents,worker_settlement_mode,worker_labor_cents,extra_income_rate_bp_snapshot,booking_paid_cents,worker_balance_freeze_days_snapshot,settlement_status,created_at,updated_at)\n                 VALUES(:order_id,'platform_managed',:pricing_mode,:customer_total,:settlement_mode,:worker_labor,:extra_rate,:external_prepayment,:freeze_days,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                [\n                    'order_id'=>$orderId,'pricing_mode'=>$command['customer_pricing_mode'],'customer_total'=>$command['customer_total_cents'],\n                    'settlement_mode'=>$command['worker_settlement_mode'],'worker_labor'=>$command['worker_labor_cents'],\n                    'extra_rate'=>$command['extra_income_rate_bp'],'external_prepayment'=>$externalPrepayment,\n                    'freeze_days'=>$command['worker_balance_freeze_days'],\n                ]\n            );\n            if ($measureFirst) {\n                $db->insert(\n                    \"INSERT INTO order_measurement_states(order_id,service_payment_status,result_status,settlement_status,created_at,updated_at)\n                     VALUES(:order_id,'not_required','editing','not_applicable',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['order_id'=>$orderId]\n                );\n            }\n            foreach ($command['pricing_items'] as $index => $item) {\n                $db->insert(\n                    \"INSERT INTO order_pricing_items(order_id,item_source,description,note,quantity,unit,unit_price_cents,amount_cents,sort_order,status,created_at,updated_at)\n                     VALUES(:order_id,'base',:description,:note,:quantity,:unit,:unit_price,:amount,:sort_order,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    [\n                        'order_id'=>$orderId,'description'=>$item['description'],'note'=>$item['note'] !== '' ? $item['note'] : null,\n                        'quantity'=>$item['quantity'],'unit'=>$item['unit'],'unit_price'=>$item['unit_price_cents'],'amount'=>$item['amount_cents'],'sort_order'=>$index + 1,\n                    ]\n                );\n            }\n            $this->event($db, $orderId, 'platform_order_created', $adminId, [\n                'operator_channel'=>(string)($command['operator_channel'] ?? 'web_admin'),\n                'operator_user_id'=>(int)($command['operator_user_id'] ?? 0),\n                'customer_bound'=>(int)($command['user_id'] ?? 0) > 0,\n                'customer_flow_mode'=>'platform_managed',\n                'fulfillment_mode'=>(string)$command['fulfillment_mode'],\n                'customer_total_cents'=>(int)$command['customer_total_cents'],\n                'external_prepayment_cents'=>$externalPrepayment,\n                'dispatch_mode'=>$command['dispatch_mode'],\n                'worker_settlement_mode'=>$command['worker_settlement_mode'],\n                'location_source'=>$locationSource,'lat'=>$lat,'lng'=>$lng,\n                'map_point_name'=>$mapPointName,'map_point_address'=>$mapPointAddress,'text_address'=>$fullAddress,\n            ]);\n            return $orderId;\n        });\n    }\n\n    public function publish(int $orderId, int $adminId, int $quoteDays): void\n    {\n        $this->db->transaction(function (Database $db) use ($orderId,$adminId,$quoteDays): void {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order) throw new OrderOperationException('平台承接单不存在。', 'PLATFORM_ORDER_NOT_FOUND', 404);\n            if ((string)$order['customer_flow_mode'] !== 'platform_managed' || (int)$order['booking_fee_cents'] !== 0) {\n                throw new OrderOperationException('平台单资金口径仍含旧预约模式，不能发布。', 'PLATFORM_BOOKING_FLOW_INVALID', 409);\n            }\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            if ($order['lifecycle_status'] !== 'active' || !empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) {\n                throw new OrderOperationException('当前订单阶段不能发布。', 'PLATFORM_PUBLISH_NOT_ALLOWED', 409);\n            }\n            if ((string)$order['publish_status'] === 'published') {\n                throw new OrderOperationException('平台承接单已经发布，请勿重复刷新报价截止时间。', 'PLATFORM_ALREADY_PUBLISHED', 409);\n            }\n            if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) {\n                throw new OrderOperationException('订单存在退款状态，不能重新发布。', 'PLATFORM_REFUND_BLOCKS_PUBLISH', 409);\n            }\n            if ($order['lat'] === null || $order['lng'] === null) {\n                throw new OrderOperationException('施工地址缺少地图坐标，请先补充地图选点。', 'PLATFORM_LOCATION_REQUIRED', 409);\n            }\n            $changed = $db->execute(\n                \"UPDATE orders SET audit_status='approved',publish_status='published',quote_status='waiting',audited_at=UTC_TIMESTAMP(),published_at=UTC_TIMESTAMP(),quote_deadline_at=DATE_ADD(UTC_TIMESTAMP(),INTERVAL {$quoteDays} DAY),audit_note='平台托管条件核验通过后人工异常修复发布',updated_at=UTC_TIMESTAMP(),version=version+1\n                 WHERE id=:id AND publish_status<>'published' AND selected_quote_id IS NULL AND assigned_worker_id IS NULL AND current_assignment_id IS NULL\",\n                ['id'=>$orderId]\n            );\n            if ($changed !== 1) throw new OrderOperationException('订单发布状态已变化，请刷新后重试。', 'PLATFORM_PUBLISH_RACE', 409);\n            $this->event($db, $orderId, 'platform_order_published', $adminId, ['quote_days'=>$quoteDays]);\n        });\n    }\n\n    public function selectQuote(int $orderId, int $quoteId, int $adminId): void\n    {\n        $this->db->transaction(function (Database $db) use ($orderId,$quoteId,$adminId): void {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents,t.worker_settlement_mode\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order) throw new OrderOperationException('平台承接单不存在。', 'PLATFORM_ORDER_NOT_FOUND', 404);\n            if ($order['dispatch_mode'] !== 'multi_quote') throw new OrderOperationException('只有师傅报价模式可以由平台选择报价。', 'PLATFORM_QUOTE_MODE_REQUIRED', 409);\n            if ((string)$order['customer_flow_mode'] !== 'platform_managed' || (int)$order['booking_fee_cents'] !== 0\n                || $order['audit_status'] !== 'approved' || $order['publish_status'] !== 'published' || $order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('订单尚未满足平台托管/发布条件或已经结束。', 'PLATFORM_ORDER_NOT_READY', 409);\n            }\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            if (!empty($order['quote_deadline_at']) && strtotime((string)$order['quote_deadline_at'].' UTC') <= time()) {\n                throw new OrderOperationException('本单报价期限已经结束，不能再选择师傅。', 'PLATFORM_QUOTE_DEADLINE_PASSED', 409);\n            }\n            if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) {\n                throw new OrderOperationException('订单存在退款状态，不能选择师傅。', 'PLATFORM_REFUND_BLOCKS_DEAL', 409);\n            }\n            if (!empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) {\n                throw new OrderOperationException('该订单已经成交，请勿重复选择。', 'PLATFORM_ORDER_ALREADY_ASSIGNED', 409);\n            }\n\n            $quote = $db->fetch(\n                \"SELECT q.*,w.display_name FROM quotes q INNER JOIN worker_profiles w ON w.id=q.worker_id\n                 WHERE q.id=:quote_id AND q.order_id=:order_id AND q.quote_type='worker' AND q.status='active' FOR UPDATE\",\n                ['quote_id'=>$quoteId,'order_id'=>$orderId]\n            );\n            if (!$quote) throw new OrderOperationException('师傅报价不存在或已经失效。', 'PLATFORM_QUOTE_NOT_FOUND', 404);\n            $labor = max(0, (int)$quote['amount_cents']);\n            if ($labor <= 0) throw new OrderOperationException('师傅工费无效。', 'PLATFORM_LABOR_INVALID', 409);\n            if ($order['worker_settlement_mode'] === 'worker_collect'\n                && (int)$order['customer_contract_total_cents'] - $labor - (int)$order['booking_paid_cents'] < 0) {\n                throw new OrderOperationException('选择该报价会形成负差额，请先调整客户价格或让师傅修改报价。', 'PLATFORM_SETTLEMENT_NEGATIVE', 409);\n            }\n\n            $nextVersion = 1 + (int)$db->fetchValue('SELECT COALESCE(MAX(version_no),0) FROM commission_rule_versions WHERE order_id=:order_id', ['order_id'=>$orderId]);\n            $ruleId = $db->insert(\n                \"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,adjustment_type,adjustment_reason,created_by_admin_id,status,locked_at,created_at)\n                 VALUES(:order_id,:version,0,0,'platform_order','平台承接单不重复收取普通平台服务费',:admin_id,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['order_id'=>$orderId,'version'=>$nextVersion,'admin_id'=>$adminId ?: null]\n            );\n            $assignmentId = $db->insert(\n                \"INSERT INTO assignments(public_id,order_id,worker_id,quote_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,booking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,estimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_by_admin_id,created_at,updated_at)\n                 VALUES(:public_id,:order_id,:worker_id,:quote_id,'worker_quote',:rule_id,:labor,0,0,0,0,0,:labor,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),:admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['public_id'=>\\public_id(),'order_id'=>$orderId,'worker_id'=>$quote['worker_id'],'quote_id'=>$quoteId,'rule_id'=>$ruleId,'labor'=>$labor,'admin_id'=>$adminId ?: null]\n            );\n            $db->execute(\n                \"UPDATE quotes SET status=IF(id=:selected_id,'selected','closed'),selected_at=IF(id=:selected_time,UTC_TIMESTAMP(),selected_at),updated_at=UTC_TIMESTAMP()\n                 WHERE order_id=:order_id AND quote_type='worker' AND status='active'\",\n                ['selected_id'=>$quoteId,'selected_time'=>$quoteId,'order_id'=>$orderId]\n            );\n            $changed = $db->execute(\n                \"UPDATE orders SET selected_quote_id=:quote_id,assigned_worker_id=:worker_id,current_assignment_id=:assignment_id,\n                         commission_rule_version_id=:rule_id,commission_rate_bp=0,commission_min_cents=0,quote_status='selected',assignment_status='accepted',publish_status='hidden',\n                         contact_revealed_at=COALESCE(contact_revealed_at,UTC_TIMESTAMP()),updated_at=UTC_TIMESTAMP(),version=version+1\n                 WHERE id=:order_id AND selected_quote_id IS NULL AND assigned_worker_id IS NULL AND current_assignment_id IS NULL\",\n                ['quote_id'=>$quoteId,'worker_id'=>$quote['worker_id'],'assignment_id'=>$assignmentId,'rule_id'=>$ruleId,'order_id'=>$orderId]\n            );\n            if ($changed !== 1) throw new OrderOperationException('该订单刚刚已被其他操作成交，请刷新。', 'PLATFORM_ORDER_DEAL_RACE', 409);\n            $db->execute('UPDATE order_platform_terms SET worker_labor_cents=:labor,updated_at=UTC_TIMESTAMP() WHERE order_id=:order_id', ['labor'=>$labor,'order_id'=>$orderId]);\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:order_id AND purpose='worker_assignment' AND status='active'\", ['order_id'=>$orderId]);\n            $db->insert(\n                \"INSERT INTO assignment_history(assignment_id,order_id,worker_id,action,reason,actor_type,actor_id,created_at)\n                 VALUES(:assignment_id,:order_id,:worker_id,'accepted','平台承接单：师傅主动报价被平台选中后自动成交','admin',:actor_id,UTC_TIMESTAMP())\",\n                ['assignment_id'=>$assignmentId,'order_id'=>$orderId,'worker_id'=>$quote['worker_id'],'actor_id'=>$adminId ?: null]\n            );\n            $this->event($db, $orderId, 'platform_worker_quote_selected', $adminId, [\n                'quote_id'=>$quote['public_id'],'worker_id'=>(int)$quote['worker_id'],'worker_labor_cents'=>$labor,\n            ]);\n        });\n    }\n\n    public function createInvite(int $orderId, int $adminId, int $validDays): array\n    {\n        $plainToken = rtrim(strtr(base64_encode(random_bytes(24)), '+/', '-_'), '=');\n        return $this->db->transaction(function (Database $db) use ($orderId,$adminId,$validDays,$plainToken): array {\n            $order = $db->fetch(\n                \"SELECT o.*,t.customer_flow_mode,t.customer_contract_total_cents,t.booking_paid_cents\n                 FROM orders o INNER JOIN order_platform_terms t ON t.order_id=o.id\n                 WHERE o.id=:id AND o.order_source_type='platform' FOR UPDATE\",\n                ['id'=>$orderId]\n            );\n            if (!$order) throw new OrderOperationException('平台承接单不存在。', 'PLATFORM_ORDER_NOT_FOUND', 404);\n            if ((string)$order['customer_flow_mode'] !== 'platform_managed' || (int)$order['booking_fee_cents'] !== 0\n                || $order['audit_status'] !== 'approved' || $order['publish_status'] !== 'published' || $order['lifecycle_status'] !== 'active') {\n                throw new OrderOperationException('只有托管条件完整、已发布且仍在接单阶段的平台单可以邀请师傅。', 'PLATFORM_INVITE_NOT_ALLOWED', 409);\n            }\n            $this->prepaymentVerifier->verifiedPaidCents($db,$orderId,(int)$order['customer_contract_total_cents'],(int)$order['booking_paid_cents'],'platform_managed');\n            if (!in_array((string)$order['quote_status'], ['waiting','quoting','collecting'], true)\n                || !empty($order['selected_quote_id']) || !empty($order['assigned_worker_id']) || !empty($order['current_assignment_id'])) {\n                throw new OrderOperationException('该平台单已经成交或不再接收师傅。', 'PLATFORM_INVITE_NOT_ALLOWED', 409);\n            }\n            if (!in_array((string)($order['refund_status'] ?? 'none'), ['', 'none'], true)) {\n                throw new OrderOperationException('该订单存在退款状态，不能继续邀请师傅。', 'PLATFORM_REFUND_BLOCKS_INVITE', 409);\n            }\n            if (empty($order['quote_deadline_at']) || strtotime((string)$order['quote_deadline_at'].' UTC') <= time()) {\n                throw new OrderOperationException('本单报价期限已经结束，不能再生成邀请。', 'PLATFORM_QUOTE_DEADLINE_PASSED', 409);\n            }\n\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE order_id=:order_id AND purpose='worker_assignment' AND status='active'\", ['order_id'=>$orderId]);\n            $ruleId = (int)$db->fetchValue(\n                \"SELECT id FROM commission_rule_versions WHERE order_id=:order_id AND adjustment_type='platform_order' AND status='active' ORDER BY version_no DESC,id DESC LIMIT 1 FOR UPDATE\",\n                ['order_id'=>$orderId]\n            );\n            if ($ruleId < 1) {\n                $nextVersion = 1 + (int)$db->fetchValue('SELECT COALESCE(MAX(version_no),0) FROM commission_rule_versions WHERE order_id=:order_id', ['order_id'=>$orderId]);\n                $ruleId = $db->insert(\n                    \"INSERT INTO commission_rule_versions(order_id,version_no,rate_bp,min_fee_cents,adjustment_type,adjustment_reason,created_by_admin_id,status,locked_at,created_at)\n                     VALUES(:order_id,:version,0,0,'platform_order','平台承接单受邀师傅不重复收取普通服务费',:admin_id,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                    ['order_id'=>$orderId,'version'=>$nextVersion,'admin_id'=>$adminId ?: null]\n                );\n            }\n            $expiresAt = gmdate('Y-m-d H:i:s', min(\n                time() + max(1, min(30, $validDays)) * 86400,\n                (int)strtotime((string)$order['quote_deadline_at'].' UTC')\n            ));\n            $inviteId = $db->insert(\n                \"INSERT INTO invite_tokens(order_id,token_hash,purpose,created_by_admin_id,commission_rule_version_id,status,max_claims,claim_count,expires_at,created_at)\n                 VALUES(:order_id,:token_hash,'worker_assignment',:admin_id,:rule_id,'active',1,0,:expires_at,UTC_TIMESTAMP())\",\n                [\n                    'order_id'=>$orderId,'token_hash'=>hash('sha256',$plainToken),'admin_id'=>$adminId ?: null,\n                    'rule_id'=>$ruleId,'expires_at'=>$expiresAt,\n                ]\n            );\n            $this->event($db, $orderId, 'platform_worker_invite_created', $adminId, [\n                'invite_id'=>$inviteId,'dispatch_mode'=>(string)$order['dispatch_mode'],'expires_at'=>$expiresAt,\n                'message'=>(string)$order['dispatch_mode']==='multi_quote'\n                    ? '受邀只是触达渠道，领取后仍需提交师傅工费报价'\n                    : '一口价平台单领取邀请即按既定师傅工费成交',\n            ]);\n            return [\n                'order_id'=>$orderId,'order_no'=>(string)$order['public_no'],'invite_id'=>$inviteId,\n                'token'=>$plainToken,'expires_at'=>$expiresAt,'dispatch_mode'=>(string)$order['dispatch_mode'],\n            ];\n        });\n    }\n\n    public function revokeInvite(int $orderId, int $inviteId, int $adminId): void\n    {\n        $this->db->transaction(function (Database $db) use ($orderId,$inviteId,$adminId): void {\n            $invite = $db->fetch(\n                \"SELECT i.id,i.status,o.order_source_type FROM invite_tokens i JOIN orders o ON o.id=i.order_id\n                 WHERE i.id=:invite_id AND i.order_id=:order_id FOR UPDATE\",\n                ['invite_id'=>$inviteId,'order_id'=>$orderId]\n            );\n            if (!$invite || (string)$invite['order_source_type'] !== 'platform') {\n                throw new OrderOperationException('平台邀请不存在。', 'PLATFORM_INVITE_NOT_FOUND', 404);\n            }\n            if ((string)$invite['status'] !== 'active') return;\n            $db->execute(\"UPDATE invite_tokens SET status='revoked' WHERE id=:id AND status='active'\", ['id'=>$inviteId]);\n            $this->event($db,$orderId,'platform_worker_invite_revoked',$adminId,['invite_id'=>$inviteId]);\n        });\n    }\n\n    private function ensureUnboundCustomerUser(): int\n    {\n        $id = (int)$this->db->fetchValue(\"SELECT id FROM users WHERE cloud_user_id=:cloud_id LIMIT 1\", ['cloud_id'=>self::UNBOUND_CLOUD_USER_ID]);\n        if ($id > 0) return $id;\n        try {\n            $id = $this->db->insert(\n                \"INSERT INTO users(public_id,nickname,mobile_masked,status,cloud_user_id,created_at,updated_at)\n                 VALUES(:public_id,'平台待绑定客户','','platform_unbound',:cloud_id,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",\n                ['public_id'=>\\public_id(),'cloud_id'=>self::UNBOUND_CLOUD_USER_ID]\n            );\n        } catch (PDOException $exception) {\n            if ((string)$exception->getCode() !== '23000') throw $exception;\n            $id = (int)$this->db->fetchValue(\"SELECT id FROM users WHERE cloud_user_id=:cloud_id LIMIT 1\", ['cloud_id'=>self::UNBOUND_CLOUD_USER_ID]);\n        }\n        if ($id < 1) throw new OrderOperationException('待绑定客户占位账号初始化失败，请重试。', 'PLATFORM_UNBOUND_CUSTOMER_INIT_FAILED', 500);\n        return $id;\n    }\n\n    /** @param array<string,mixed> $command @return array{0:float,1:float,2:string,3:string,4:string} */\n    private function resolveLocation(array $command): array\n    {\n        $lat = isset($command['lat']) && is_numeric($command['lat']) ? (float)$command['lat'] : null;\n        $lng = isset($command['lng']) && is_numeric($command['lng']) ? (float)$command['lng'] : null;\n        if ($lat === null || $lng === null || $lat < -90 || $lat > 90 || $lng < -180 || $lng > 180) {\n            throw new OrderOperationException('平台承接单必须先完成地图选点。', 'PLATFORM_LOCATION_REQUIRED', 422);\n        }\n        $mapName = mb_substr(trim((string)($command['map_point_name'] ?? '')), 0, 160);\n        $mapAddress = mb_substr(trim((string)($command['map_point_address'] ?? '')), 0, 255);\n        return [$lat,$lng,'map_picker',$mapName,$mapAddress];\n    }\n\n    private function maskContactMobile(string $mobile): string\n    {\n        if (preg_match('/^(1\\d{2})\\d{4}(\\d{4})(.*)$/u', $mobile, $matches) === 1) {\n            return $matches[1] . '****' . $matches[2] . $matches[3];\n        }\n        return $mobile;\n    }\n\n    private function event(Database $db, int $orderId, string $eventType, int $adminId, array $payload): void\n    {\n        if (function_exists('app_config') && \\app_config('chat.order_policy_enabled',false)===true) {\n            (new DatabaseOrderConversationBridge($db,true))->schedule($orderId);\n        }\n        $mini = ($payload['operator_channel'] ?? '') === 'mini_admin';\n        $actorId = $mini ? (int)($payload['operator_user_id'] ?? 0) : $adminId;\n        $encoded = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n        $eventId = $db->insert(\n            \"INSERT INTO order_events(order_id,event_type,actor_type,actor_id,payload_json,created_at)\n             VALUES(:order_id,:event_type,:actor_type,:actor_id,:payload,UTC_TIMESTAMP())\",\n            ['order_id'=>$orderId,'event_type'=>$eventType,'actor_type'=>$mini ? 'mini_admin' : 'admin','actor_id'=>$actorId > 0 ? $actorId : null,'payload'=>is_string($encoded) ? $encoded : '{}']\n        );\n        \\WorkerAdmin\\Services\\OrderNotificationService::queuePersistedEvent($db, $orderId, $eventId, $eventType, $payload);\n    }\n}\n","server/app/Infrastructure/External/WeChatAccessTokenProvider.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\External;\n\nuse RuntimeException;\nuse Throwable;\n\n/** One cross-process refresh coordinator for every PHP caller; Go never owns AppSecret. */\nfinal class WeChatAccessTokenProvider\n{\n    private string $environment;\n    private string $appId;\n    private string $secret;\n    private string $directory;\n    private ?string $exportDirectory;\n    private $request;\n\n    public function __construct(string $environment,string $appId,#[\\SensitiveParameter] string $secret,string $directory,?string $exportDirectory=null,?callable $request=null)\n    {\n        if(!in_array($environment,['production','development','test'],true)||preg_match('/^[A-Za-z0-9_-]{1,64}$/D',$appId)!==1||$secret==='')throw new RuntimeException('微信统一凭证配置不可用');\n        $this->environment=$environment;$this->appId=$appId;$this->secret=$secret;\n        $this->directory=$directory;$this->exportDirectory=$exportDirectory;$this->request=$request;\n    }\n\n    public static function fromSettings(): self\n    {\n        $env=(string)\\app_config('app.env','production');if($env==='testing')$env='test';\n        return new self($env,trim((string)\\setting('wechat.miniapp_appid','')),trim((string)\\setting('wechat.miniapp_secret','')),\n            \\base_path('storage/private/wechat-tokens'),\\app_config('chat.safety_credential_export_enabled',false)===true?\\base_path('storage/private/chat-credentials'):null);\n    }\n\n    public function get(): string\n    {\n        $this->ensureDirectory($this->directory,0700);\n        $cached=$this->read();\n        if($this->valid($cached,300)&&$this->exportMatches($cached)){ return $cached['token']; }\n        $lock=$this->lock($cached);\n        if($lock===null){ return $cached['token']; }\n        try{\n            $cached=$this->read();\n            if($this->valid($cached,300)){ $this->export($cached);return $cached['token']; }\n            if(!$this->valid($cached,5))$this->revokeExport();\n            $started=time();\n            try{\n                $response=$this->request!==null?($this->request)($this->appId,$this->secret):$this->requestToken();\n                if(!is_array($response)||isset($response['errcode'])&&$response['errcode']!==0\n                    ||!is_string($response['access_token']??null)||preg_match('/^[A-Za-z0-9_-]{10,2048}$/D',$response['access_token'])!==1\n                    ||!is_int($response['expires_in']??null)||$response['expires_in']<1||$response['expires_in']>7200)throw new RuntimeException('微信统一凭证响应不可用');\n                // Never extend a provider TTL with max(600, expires_in).\n                $next=['schema_version'=>1,'env'=>$this->environment,'app_id'=>$this->appId,'token'=>$response['access_token'],\n                    'issued_at'=>$started,'expires_at'=>$started+$response['expires_in'],'credential_hash'=>$this->credentialHash()];\n                if(!$this->valid($next,5))throw new RuntimeException('微信统一凭证剩余有效期不足');\n                $this->write($this->cachePath(),$next,0600);\n                $this->export($next);\n                return $next['token'];\n            }catch(Throwable $error){\n                // A failed refresh does not invent a new expiry or discard a\n                // still-valid credential. Rejected/rotated credentials fail this.\n                if($this->valid($cached,5)){ $this->export($cached);return $cached['token']; }\n                throw new RuntimeException('微信统一凭证暂不可用');\n            }\n        }finally{flock($lock,LOCK_UN);fclose($lock);}\n    }\n\n    /** Only invalidate the exact generation actually rejected by a caller. */\n    public function rejectGeneration(string $generation): bool\n    {\n        if(preg_match('/^[a-f0-9]{64}$/D',$generation)!==1)return false;\n        $this->ensureDirectory($this->directory,0700);$lock=$this->lock(null);\n        try{\n            $cached=$this->read();\n            if(!is_array($cached)||!hash_equals($this->generation($cached['token']),$generation))return false;\n            if(is_file($this->cachePath())&&!unlink($this->cachePath()))throw new RuntimeException('微信统一凭证撤销失败');\n            if($this->exportDirectory!==null){$this->revokeExport();}\n            return true;\n        }finally{flock($lock,LOCK_UN);fclose($lock);}\n    }\n    public function reject(#[\\SensitiveParameter] string $usedToken): bool\n    {\n        return $usedToken!==''&&$this->rejectGeneration($this->generation($usedToken));\n    }\n    public function generation(#[\\SensitiveParameter] string $token): string {return hash('sha256',$this->environment.\"\\n\".$this->appId.\"\\n\".$token);}\n    public function exportPath(): string\n    {\n        if($this->exportDirectory===null)throw new RuntimeException('聊天凭证导出未启用');\n        return $this->exportDirectory.DIRECTORY_SEPARATOR.$this->environment.'-'.hash('sha256',$this->appId).'.json';\n    }\n    /** Read-only preflight, including permissions and exact current configuration. */\n    public function metadata(): array\n    {\n        $cached=$this->read();\n        if(!$this->valid($cached,5)||!$this->exportMatches($cached))throw new RuntimeException('微信聊天导出凭证不可用');\n        return ['status'=>'ready','credential_file'=>$this->exportPath(),'env'=>$this->environment,'generation'=>$this->generation($cached['token']),'expires_at'=>$cached['expires_at']];\n    }\n    private function credentialHash(): string {return hash('sha256',$this->environment.\"\\n\".$this->appId.\"\\n\".$this->secret);}\n    private function cachePath(): string {return $this->directory.DIRECTORY_SEPARATOR.hash('sha256',$this->environment.\"\\n\".$this->appId).'.json';}\n    private function read(): ?array\n    {\n        $path=$this->cachePath();clearstatcache(true,$path);\n        if(is_link($path)||!is_file($path)||filesize($path)>4096)return null;\n        $data=json_decode((string)@file_get_contents($path),true);\n        return $this->valid($data,0)?$data:null;\n    }\n    private function valid(#[\\SensitiveParameter] $data,int $margin): bool\n    {\n        return is_array($data)&&($data['schema_version']??null)===1&&($data['env']??null)===$this->environment&&($data['app_id']??null)===$this->appId\n            &&is_string($data['token']??null)&&preg_match('/^[A-Za-z0-9_-]{10,2048}$/D',$data['token'])===1\n            &&is_int($data['issued_at']??null)&&$data['issued_at']<=time()+5&&is_int($data['expires_at']??null)&&$data['expires_at']>time()+$margin\n            &&$data['expires_at']>$data['issued_at']&&$data['expires_at']-$data['issued_at']<=7200\n            &&is_string($data['credential_hash']??null)&&hash_equals($this->credentialHash(),$data['credential_hash']);\n    }\n    private function lock(#[\\SensitiveParameter] ?array $fallback)\n    {\n        $path=$this->cachePath().'.lock';if(is_link($path))throw new RuntimeException('微信统一凭证锁不可用');\n        $handle=@fopen($path,'c+');if($handle===false)throw new RuntimeException('微信统一凭证锁不可用');@chmod($path,0600);\n        $until=microtime(true)+1.0;\n        do{\n            if(flock($handle,LOCK_EX|LOCK_NB))return $handle;\n            if($this->valid($fallback,5)){fclose($handle);return null;}\n            usleep(20000);\n        }while(microtime(true)<$until);\n        fclose($handle);throw new RuntimeException('微信统一凭证刷新繁忙');\n    }\n    private function revokeExport(): void\n    {\n        if($this->exportDirectory===null)return;\n        $this->ensureDirectory($this->exportDirectory,0750);\n        $this->write($this->exportPath(),['schema_version'=>1,'env'=>$this->environment,'app_id'=>$this->appId,'token'=>'','issued_at'=>time(),'expires_at'=>0,'generation'=>''],0640);\n    }\n    private function exportMatches(#[\\SensitiveParameter] array $cached): bool\n    {\n        if($this->exportDirectory===null)return true;\n        $file=$this->exportPath();if(is_link($file)||!is_file($file)||filesize($file)>4096||(fileperms($file)&0027)!==0||(fileperms(dirname($file))&0022)!==0)return false;\n        $data=json_decode((string)@file_get_contents($file),true);\n        return is_array($data)&&($data['schema_version']??null)===1&&($data['env']??null)===$this->environment&&($data['app_id']??null)===$this->appId&&($data['token']??null)===$cached['token']&&($data['issued_at']??null)===$cached['issued_at']&&($data['generation']??'')===$this->generation($cached['token'])&&($data['expires_at']??0)===$cached['expires_at'];\n    }\n    private function export(#[\\SensitiveParameter] array $cached): void\n    {\n        if($this->exportDirectory===null)return;\n        $this->ensureDirectory($this->exportDirectory,0750);\n        $data=['schema_version'=>1,'env'=>$this->environment,'app_id'=>$this->appId,'token'=>$cached['token'],\n            'issued_at'=>$cached['issued_at'],'expires_at'=>$cached['expires_at'],'generation'=>$this->generation($cached['token'])];\n        $this->write($this->exportPath(),$data,0640);\n    }\n    private function ensureDirectory(string $directory,int $mode): void\n    {\n        if(is_link($directory)||!is_dir($directory)&&!@mkdir($directory,$mode,true)&&!is_dir($directory))throw new RuntimeException('微信统一凭证目录不可用');\n        clearstatcache(true,$directory);$permissions=fileperms($directory);\n        if($permissions===false||($permissions&0022)!==0)throw new RuntimeException('微信统一凭证目录权限过宽');\n    }\n    private function write(string $path,#[\\SensitiveParameter] array $data,int $mode): void\n    {\n        if(is_link($path))throw new RuntimeException('微信统一凭证文件不可用');\n        $temporary=dirname($path).DIRECTORY_SEPARATOR.'.token-'.bin2hex(random_bytes(8));\n        $handle=@fopen($temporary,'x');if($handle===false)throw new RuntimeException('微信统一凭证保存失败');\n        try{\n            if(!chmod($temporary,$mode))throw new RuntimeException('微信统一凭证权限设置失败');\n            $json=json_encode($data,JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);\n            if(fwrite($handle,$json)!==strlen($json)||!fflush($handle))throw new RuntimeException('微信统一凭证保存失败');\n            fclose($handle);$handle=null;\n            if(!rename($temporary,$path