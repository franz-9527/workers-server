 (`verified_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：师傅资料';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `worker_profiles` WRITE;\n/*!40000 ALTER TABLE `worker_profiles` DISABLE KEYS */;\nINSERT INTO `worker_profiles` VALUES (1,2,'01K2DEMOWORKERPROFILE00001','王师傅（演示）','139******02',NULL,NULL,'suspended',0,'杭州市','西湖区','西湖区文三路附近',NULL,30.2741000,120.1551000,'GCJ-02',5.00,12,NULL,'cloud',NULL,NULL,0,'legacy',NULL,'2026-09-21 13:34:33',NULL,NULL,'2026-09-21 13:34:33','2026-09-21 13:34:34'),(2,3,'01K2DEMOPENDINGPROFILE001','李师傅（待审核演示）','137******03',NULL,NULL,'suspended',0,'杭州市','余杭区','余杭区附近',NULL,30.4188000,120.2994000,'GCJ-02',5.00,0,NULL,'cloud',NULL,NULL,0,'legacy',NULL,NULL,NULL,NULL,'2026-09-21 13:34:33','2026-09-21 13:34:34'),(4,7,'01K2DEMOV227WORKERPROF0001','演示师傅','130****2203',NULL,NULL,'suspended',0,'杭州市','西湖区','西湖区文三路附近（演示）',NULL,30.2741000,120.1551000,'GCJ-02',5.00,0,'{\\\"skills\\\":[\\\"墙纸\\\",\\\"墙布\\\",\\\"玻璃膜\\\",\\\"家具膜\\\",\\\"窗帘\\\",\\\"美缝\\\"],\\\"source\\\":\\\"v2.2.7_demo\\\",\\\"readonly\\\":true}','server',NULL,NULL,0,'demo_local',NULL,'2026-09-21 13:34:33',NULL,NULL,'2026-09-21 13:34:33','2026-09-21 13:34:34'),(5,10,'01K2DEMOV228WORKERPROF0001','演示师傅','130****2203','13088882203',NULL,'approved',0,'杭州市','西湖区','西湖区文三路附近（演示）',NULL,30.2741000,120.1551000,'GCJ-02',4.98,18,'{\\\"skills\\\":[\\\"墙纸\\\",\\\"墙布\\\",\\\"玻璃膜\\\",\\\"家具膜\\\",\\\"窗帘\\\",\\\"美缝\\\"],\\\"source\\\":\\\"v2.2.8_demo\\\",\\\"readonly\\\":true}','server',NULL,NULL,0,'demo_local',NULL,'2026-09-21 13:34:34',NULL,NULL,'2026-09-21 13:34:34','2026-09-21 13:34:34');\n/*!40000 ALTER TABLE `worker_profiles` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `worker_real_name_verifications`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `worker_real_name_verifications` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  `real_name_masked` varchar(80) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '实名名称脱敏值',\n  `real_name_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT '实名名称密文',\n  `id_number_masked` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT 'ID号码脱敏值',\n  `id_number_ciphertext` text COLLATE utf8mb4_unicode_ci COMMENT 'ID号码密文',\n  `id_number_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT 'ID号码HMAC摘要',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft' COMMENT '状态',\n  `review_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '审核原因',\n  `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  `submitted_at` datetime DEFAULT NULL COMMENT '提交时间',\n  `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_worker_real_name_worker` (`worker_id`),\n  KEY `idx_worker_real_name_status` (`status`,`submitted_at`),\n  KEY `fk_worker_real_name_admin` (`reviewed_by`),\n  CONSTRAINT `fk_worker_real_name_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_real_name_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-25：师傅实名认证';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `worker_real_name_verifications` WRITE;\n/*!40000 ALTER TABLE `worker_real_name_verifications` DISABLE KEYS */;\nINSERT INTO `worker_real_name_verifications` VALUES (1,1,'王**','DEMO_ONLY_NOT_DECRYPTABLE','330***********1234','DEMO_ONLY_NOT_DECRYPTABLE','1fdf48c662357241f5ec574546b7699122b4e47f8c17498b6c4ad0dc1eb2e705','approved','V1.0.5 已通过实名认证演示',NULL,'2026-09-11 13:34:33','2026-09-12 13:34:33','2026-09-11 13:34:33','2026-09-21 13:34:33'),(2,2,'李**','DEMO_ONLY_NOT_DECRYPTABLE','330***********5678','DEMO_ONLY_NOT_DECRYPTABLE','1dc31593f316befe7f5f19dd0827793d3d16b5f70495c8e7b267654760508c05','pending',NULL,NULL,'2026-09-21 12:34:33',NULL,'2026-09-21 12:34:33','2026-09-21 13:34:33');\n/*!40000 ALTER TABLE `worker_real_name_verifications` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `worker_verifications`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `worker_verifications` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  `submitted_snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '提交快照JSON',\n  `decision` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '处理决定',\n  `decision_reason` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '决定原因',\n  `reviewed_by` bigint(20) unsigned DEFAULT NULL COMMENT '审核人ID',\n  `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  `reviewed_at` datetime DEFAULT NULL COMMENT '审核时间',\n  PRIMARY KEY (`id`),\n  KEY `idx_worker_verifications_worker_time` (`worker_id`,`submitted_at`),\n  KEY `fk_worker_verifications_admin` (`reviewed_by`),\n  CONSTRAINT `fk_worker_verifications_admin` FOREIGN KEY (`reviewed_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_worker_verifications_worker` FOREIGN KEY (`worker_id`) REFERENCES `worker_profiles` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：师傅审核历史';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `worker_verifications` WRITE;\n/*!40000 ALTER TABLE `worker_verifications` DISABLE KEYS */;\n/*!40000 ALTER TABLE `worker_verifications` ENABLE KEYS */;\nUNLOCK TABLES;\n/*!40103 SET TIME_ZONE=@OLD_TIME_ZONE */;\n\n/*!40101 SET SQL_MODE=@OLD_SQL_MODE */;\n/*!40014 SET FOREIGN_KEY_CHECKS=@OLD_FOREIGN_KEY_CHECKS */;\n/*!40014 SET UNIQUE_CHECKS=@OLD_UNIQUE_CHECKS */;\n/*!40101 SET CHARACTER_SET_CLIENT=@OLD_CHARACTER_SET_CLIENT */;\n/*!40101 SET CHARACTER_SET_RESULTS=@OLD_CHARACTER_SET_RESULTS */;\n/*!40101 SET COLLATION_CONNECTION=@OLD_COLLATION_CONNECTION */;\n/*!40111 SET SQL_NOTES=@OLD_SQL_NOTES */;\n\n\n\n\n\n-- V2.2.9 FINAL BASELINE NORMALIZATION BEGIN\n-- 适用类目迁入 ui_config.category_ids 后，正式结构不再保留 form_fields.category_id。\nUPDATE `form_fields`\nSET `ui_config_json`=JSON_SET(\n      CASE WHEN JSON_VALID(`ui_config_json`) THEN COALESCE(`ui_config_json`,'{}') ELSE '{}' END,\n      '$.category_ids',JSON_ARRAY(`category_id`)\n    ),\n    `category_id`=NULL,\n    `updated_at`=UTC_TIMESTAMP()\nWHERE `category_id` IS NOT NULL;\n\nUPDATE `form_fields` f\nINNER JOIN `form_steps` s ON s.`id`=f.`step_id`\nINNER JOIN `form_schema_versions` v ON v.`id`=s.`schema_version_id`\nINNER JOIN `form_schemas` fs ON fs.`id`=v.`schema_id`\nSET f.`field_key`='category_ids',\n    f.`data_type`='json',\n    f.`updated_at`=UTC_TIMESTAMP()\nWHERE BINARY fs.`schema_key`=BINARY 'order_submit'\n  AND BINARY f.`field_key`=BINARY 'category_id';\n\nUPDATE `form_fields`\nSET `validation_json`=CASE\n      WHEN JSON_VALID(`validation_json`) THEN\n        JSON_REMOVE(\n          JSON_SET(\n            `validation_json`,\n            '$.min_items',\n              COALESCE(\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.min_items')) AS UNSIGNED),\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.min')) AS UNSIGNED),\n                IF(`is_required`=1,1,0)\n              ),\n            '$.max_items',\n              COALESCE(\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.max_items')) AS UNSIGNED),\n                CAST(JSON_UNQUOTE(JSON_EXTRACT(`validation_json`,'$.max')) AS UNSIGNED),\n                CASE\n                  WHEN BINARY `field_key`=BINARY 'material_images' THEN 9\n                  WHEN BINARY `field_key`=BINARY 'wall_images' THEN 12\n                  ELSE 20\n                END\n              )\n          ),\n          '$.min','$.max'\n        )\n      ELSE JSON_OBJECT(\n        'min_items',IF(`is_required`=1,1,0),\n        'max_items',CASE\n          WHEN BINARY `field_key`=BINARY 'material_images' THEN 9\n          WHEN BINARY `field_key`=BINARY 'wall_images' THEN 12\n          ELSE 20\n        END\n      )\n    END,\n    `updated_at`=UTC_TIMESTAMP()\nWHERE `component_type` IN ('image','image_upload');\n\nALTER TABLE `form_fields`\n  DROP FOREIGN KEY `fk_form_fields_category`,\n  DROP INDEX `idx_form_fields_category`,\n  DROP COLUMN `category_id`;\n\nINSERT INTO `database_field_dictionary`\n  (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nVALUES\n  ('quotes','details_json','结构化报价内容','施工范围、排除项目、可上门时间和报价前提的 JSON 数据',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('quote_versions','details_json','结构化报价版本内容','每次报价版本对应的结构化报价 JSON 快照',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `chinese_name`=VALUES(`chinese_name`),\n  `description`=VALUES(`description`),\n  `updated_at`=UTC_TIMESTAMP();\n-- V2.2.9 FINAL BASELINE NORMALIZATION END\n\n-- V2.2.9 BASELINE BUSINESS RESET BEGIN\n-- V2.2.9 预发布业务数据重置：项目尚未正式运营，清空订单、财务、站内通知及其派生业务数据。\n-- 明确保留：system_settings、service_categories、动态表单、users / merchant_profiles / worker_profiles、\n-- 师傅审核/实名/技能/收款资料、微信身份映射、管理员与权限数据。\n-- 演示身份主档保留，但演示业务种子置空；后续演示数据使用独立文档/独立种子维护，不再与正式版本迁移强绑定。\nSET @v229_business_reset_fk_checks := @@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\n\nUPDATE `login_sessions` SET `demo_actor_user_id`=NULL WHERE `demo_actor_user_id` IS NOT NULL;\n\nDELETE FROM `message_outbox`;\nDELETE FROM `notifications`;\nDELETE FROM `scheduled_job_claims`;\nDELETE FROM `scheduled_job_failures`;\nDELETE FROM `idempotency_keys`;\n\nDELETE FROM `order_worker_sms_invites`;\nDELETE FROM `order_worker_sms_batches`;\n\nDELETE FROM `withdrawal_allocations`;\nDELETE FROM `withdrawal_events`;\nDELETE FROM `worker_payouts`;\nDELETE FROM `withdrawal_requests`;\nDELETE FROM `worker_balance_ledger`;\n\nDELETE FROM `user_wallet_ledger`;\nDELETE FROM `user_wallet_recharges`;\nDELETE FROM `user_wallet_reservations`;\nDELETE FROM `user_wallets`;\n\nDELETE FROM `payment_notifications`;\nDELETE FROM `commission_payments`;\n\nDELETE FROM `commission_receivables`;\nDELETE FROM `commission_rule_versions`;\nDELETE FROM `refunds`;\nDELETE FROM `payment_orders`;\n\nDELETE FROM `review_media`;\nDELETE FROM `review_replies`;\nDELETE FROM `reviews`;\nDELETE FROM `rating_summaries`;\nDELETE FROM `dispute_evidence`;\nDELETE FROM `disputes`;\nDELETE FROM `run_empty_fee_claims`;\nDELETE FROM `after_sales`;\nDELETE FROM `order_cancel_decisions`;\nDELETE FROM `order_cancel_requests`;\nDELETE FROM `completion_submissions`;\nDELETE FROM `offline_payment_delay_requests`;\nDELETE FROM `offline_collection_adjustment_requests`;\n\nDELETE FROM `change_confirmations`;\nDELETE FROM `change_requests`;\nDELETE FROM `appointment_records`;\nDELETE FROM `exceptional_arrivals`;\nDELETE FROM `assignment_history`;\nDELETE FROM `assignments`;\nDELETE FROM `order_role_grants`;\nDELETE FROM `invite_tokens`;\nDELETE FROM `share_contexts`;\n\nDELETE FROM `quote_selections`;\nDELETE FROM `quote_versions`;\nDELETE FROM `quotes`;\nDELETE FROM `merchant_risk_events`;\nDELETE FROM `order_deadlines`;\nDELETE FROM `order_events`;\nDELETE FROM `order_revisions`;\nDELETE FROM `order_answers`;\nDELETE FROM `order_addresses`;\nDELETE FROM `order_categories`;\nDELETE FROM `order_worker_contact_reveal_requests`;\nDELETE FROM `order_measurement_hold_extensions`;\nDELETE FROM `order_measurement_spaces`;\nDELETE FROM `order_measurement_states`;\nDELETE FROM `order_relations`;\n\n-- 先记住订单/评价/售后/争议/测量业务图片，再删除业务引用。\n-- 若同一媒体仍被师傅资料等保留对象引用，则只删业务关系，不删媒体主档。\nDROP TEMPORARY TABLE IF EXISTS `v229_business_media_ids`;\nCREATE TEMPORARY TABLE `v229_business_media_ids` (`media_file_id` BIGINT UNSIGNED NOT NULL PRIMARY KEY) ENGINE=MEMORY;\n\nINSERT IGNORE INTO `v229_business_media_ids` (`media_file_id`)\nSELECT `media_file_id` FROM `media_links`\nWHERE BINARY `entity_type` IN (BINARY 'order',BINARY 'review',BINARY 'after_sale',BINARY 'dispute',BINARY 'measurement_space');\n\nDELETE FROM `media_links`\nWHERE BINARY `entity_type` IN (BINARY 'order',BINARY 'review',BINARY 'after_sale',BINARY 'dispute',BINARY 'measurement_space');\n\nDELETE mf FROM `media_files` mf\nINNER JOIN `v229_business_media_ids` x ON x.`media_file_id`=mf.`id`\nLEFT JOIN `media_links` ml ON ml.`media_file_id`=mf.`id`\nWHERE ml.`id` IS NULL;\nDROP TEMPORARY TABLE IF EXISTS `v229_business_media_ids`;\n\nDELETE FROM `orders`;\n\n-- 清理订单/财务/演示初始化留下的审计痕迹，但保留师傅管理、管理员安全等审计。\nDELETE FROM `audit_logs`\nWHERE CAST(`request_id` AS BINARY) LIKE BINARY 'DEMO-%'\n   OR CAST(`action` AS BINARY) LIKE BINARY 'demo_%'\n   OR BINARY `entity_type` IN (BINARY 'order',BINARY 'payment_order',BINARY 'refund',BINARY 'commission_receivable',BINARY 'withdrawal_request',BINARY 'worker_payout',BINARY 'user_wallet',BINARY 'user_wallet_recharge',BINARY 'message_outbox');\n\nUPDATE `media_files` mf\nSET mf.`reference_count`=(SELECT COUNT(*) FROM `media_links` ml WHERE ml.`media_file_id`=mf.`id`);\n\nSET FOREIGN_KEY_CHECKS=@v229_business_reset_fk_checks;\n\n-- 演示业务种子与演示身份解耦。actor 配置为空时由 API 自动解析最新有效独立演示主档。\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('demo.seed_version','','string','system',0,'当前演示业务种子版本；空值表示仅保留演示身份主档、未生成演示订单/财务/通知数据',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.actor_user_public_id','','string','system',0,'演示用户固定 public_id；空值时自动解析最新有效独立演示用户',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.actor_merchant_public_id','','string','system',0,'演示商家固定 public_id；空值时自动解析最新有效独立演示商家',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.actor_worker_public_id','','string','system',0,'演示师傅固定 public_id；空值时自动解析最新有效独立演示师傅',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n`setting_value`=IF(BINARY VALUES(`setting_key`)=BINARY 'demo.seed_version','',`setting_value`),\n`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n-- V2.2.9 BASELINE BUSINESS RESET END\n\n-- V2.4.0 BASELINE EXTENSION BEGIN\n-- V2.4.0：帮助中心数据化、搜索与后台逐条管理。\n-- 首次安装基线：MySQL 5.7.44；直接创建 V2.4.0 最终帮助中心结构。\nSET NAMES utf8mb4;\n\nCREATE TABLE IF NOT EXISTS `help_categories` (\n  `id` int unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `code` varchar(48) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '代码',\n  `name` varchar(80) NOT NULL COMMENT '名称',\n  `sort_order` int NOT NULL DEFAULT 0 COMMENT '排序值',\n  `homepage_featured` tinyint(1) NOT NULL DEFAULT 0 COMMENT '首页推荐',\n  `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`), UNIQUE KEY `uq_help_category_code` (`code`),\n  KEY `idx_help_category_status_sort` (`status`,`sort_order`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心业务场景';\n\nCREATE TABLE IF NOT EXISTS `help_faqs` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '问答ID',\n  `category_id` int unsigned NOT NULL COMMENT '类目ID',\n  `question` varchar(255) NOT NULL COMMENT '问题',\n  `answer` text NOT NULL COMMENT '回答',\n  `aliases` text NULL COMMENT '别名',\n  `keywords` text NULL COMMENT '关键词',\n  `roles` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'all' COMMENT '适用角色',\n  `sort_order` int NOT NULL DEFAULT 0 COMMENT '排序值',\n  `is_featured` tinyint(1) NOT NULL DEFAULT 0 COMMENT '是否推荐',\n  `status` varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'draft' COMMENT '状态',\n  `related_faq_ids` text NULL COMMENT '相关问答ID列表',\n  `business_entry_label` varchar(80) NOT NULL DEFAULT '' COMMENT '业务记录标签',\n  `business_entry_path` varchar(255) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT '业务记录路径',\n  `draft_payload` longtext NULL COMMENT '草稿内容',\n  `version` int unsigned NOT NULL DEFAULT 1 COMMENT '版本号',\n  `published_version` int unsigned NOT NULL DEFAULT 0 COMMENT '已发布版本',\n  `published_at` datetime NULL COMMENT '发布时间',\n  `created_by` int unsigned NULL COMMENT '创建人ID',\n  `updated_by` int unsigned NULL COMMENT '更新人ID',\n  `deleted_at` datetime NULL COMMENT '删除时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`), UNIQUE KEY `uq_help_faq_id` (`faq_id`),\n  KEY `idx_help_faq_public` (`status`,`deleted_at`,`category_id`,`sort_order`,`id`),\n  KEY `idx_help_faq_updated` (`updated_at`,`id`),\n  CONSTRAINT `fk_help_faq_category` FOREIGN KEY (`category_id`) REFERENCES `help_categories` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心问答';\n\nCREATE TABLE IF NOT EXISTS `help_faq_versions` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '问答ID',\n  `version` int unsigned NOT NULL COMMENT '版本号',\n  `snapshot_json` longtext NOT NULL COMMENT '快照JSON',\n  `action` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  `operator_admin_id` int unsigned NULL COMMENT '操作人管理员ID',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  PRIMARY KEY (`id`), UNIQUE KEY `uq_help_faq_version` (`faq_id`,`version`),\n  KEY `idx_help_version_created` (`created_at`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心发布版本审计';\n\nCREATE TABLE IF NOT EXISTS `help_search_logs` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `query_text` varchar(120) NOT NULL DEFAULT '' COMMENT '查询文本',\n  `query_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '查询摘要',\n  `role_key` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'all' COMMENT '角色键',\n  `result_count` int unsigned NOT NULL DEFAULT 0 COMMENT '结果数量',\n  `clicked_faq_id` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NULL COMMENT '点击问答ID',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  PRIMARY KEY (`id`), KEY `idx_help_search_zero` (`result_count`,`created_at`), KEY `idx_help_search_hash` (`query_hash`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.4.0 帮助中心脱敏搜索日志';\n\n\n-- 文档第 5 节 83 条问答先以草稿迁入；管理员发布前不会进入小程序公开接口。\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('find','找师傅',10,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('order','下单',20,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('payment','报价付款',30,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('construction','施工',40,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('measurement','测量',50,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('refund','退款',60,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('aftersales','售后',70,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('account','账号安全',80,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_categories(code,name,sort_order,homepage_featured,status,created_at,updated_at) VALUES('finance','余额结算',90,0,'active',UTC_TIMESTAMP(),UTC_TIMESTAMP());\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A01',id,'我第一次使用，需要做什么？','进入小程序后按提示完成登录；需要使用手机号功能时再授权手机号。找师傅可在首页用“地图搜索”或“文字搜索”，下单、查看消息和账户信息可从底部导航或“我的”进入。',NULL,'登录 手机号 第一次使用','all',10,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A02',id,'地图搜索和文字搜索有什么区别？','地图搜索适合按施工地点看附近师傅；文字搜索可输入城市、地址或昵称。搜索结果只是查找线索，是否能报价或承接订单仍以订单页面与师傅资格为准。',NULL,'地图搜索 文字搜索 找师傅','all',20,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A03',id,'定位失败怎么办？','在微信或手机系统设置中允许小程序使用位置，再回到页面重试。仍失败时可用文字搜索或手动选择地址；接单大厅无法取得当前位置时会按最新发布等可用方式展示。',NULL,'定位 位置 权限 地址','all',30,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A04',id,'地图上没有师傅，是系统故障吗？','先核对搜索城市、位置权限和地图范围，并尝试缩小地图或用文字搜索。地图只展示符合展示条件的资料；附近暂时没有结果时，可通过订单流程等待报价。',NULL,'地图 师傅 无结果','all',40,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A05',id,'地图距离和师傅实际位置为何不同？','页面展示的是约距离或资料中的位置，不是实时行程或精确门牌。报价、预约和上门时间应以双方沟通及订单记录为准。',NULL,'距离 位置 师傅','all',50,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A06',id,'为什么要授权手机号？','手机号用于需要验证身份或联系的业务。微信登录与手机号授权是两步；未授权时可先浏览开放内容，但手机号相关操作可能无法完成。可在“我的 → 设置 → 账号与个人信息”检查。',NULL,'手机号 授权 登录','all',60,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A07',id,'在哪看消息和待办？','打开“我的 → 消息与待办”。“待我处理”显示当前仍需操作的订单事项，“全部消息”显示通知；操作完成后，待办会按订单最新状态更新。',NULL,'消息 待办 通知','all',70,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A08',id,'收不到微信订阅通知怎么办？','在“我的 → 设置 → 消息通知”查看该场景是否可用并开启，同时检查“微信通知设置”。微信订阅通知可能需要再次授权；订单是否待处理仍应以站内“消息与待办”和订单详情为准。',NULL,'订阅通知 微信通知 消息','all',80,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A09',id,'如何联系客服？','在订单详情点击“联系客服”；找师傅或下单前也可通过首页客服入口咨询。涉及订单时请提供订单号和问题描述，不要发送卡密或无关个人信息。',NULL,'客服 联系客服','all',90,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'A10',id,'“一口价订单”“报价订单”“旧版工单”有什么区别？','“一口价订单”是保留的原商品/服务入口；新下单、报价和测量在“报价订单”中查看；师傅的历史安装工单可从“施工订单 → 旧版工单”进入。不同入口的状态和付款记录不应混看。',NULL,'一口价 报价订单 旧版工单 历史订单','all',100,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B01',id,'如何发布施工订单？','从底部“发布”进入下单页，选服务类目，填写施工地址、联系人、需求和页面要求的图片，确认规则后提交并支付页面显示的预约费。订单支付成功后才进入审核；审核通过后按当前规则进入报价阶段。',NULL,'发布施工 下单 预约费','user',110,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B02',id,'如何发布测量订单？','在同一个下单页选择“测量”，填写测量地址、联系人、期望时间等信息并支付预约费。测量单和施工单都在“报价订单”中查看，卡片会标明“测量”。',NULL,'测量订单 量房 下单','user',120,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B03',id,'为什么提交后还不能被师傅看到？','订单须完成预约费支付并通过审核，且处于允许公开报价的阶段，才会进入接单大厅。打开“我的 → 报价订单 → 订单详情”查看付款、审核或补资料提示。',NULL,'审核 接单大厅 师傅看不到','user',130,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B04',id,'审核要求补资料，怎么处理？','进入订单详情，查看审核意见，点击“补充订单资料”，按提示补充说明或图片并重新提交。重新提交后等待审核结果。',NULL,'补资料 审核','user',140,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B05',id,'预约费会收几次？','同一笔订单的预约费只收一次。施工单在选择报价时不重复收取；测量单选中报价后，只补测量总价与已有效支付预约费之间的差额。最终金额以当前订单详情和支付页为准。',NULL,'预约费 预付款 次数','user',150,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B06',id,'付款成功但页面仍显示待支付怎么办？','返回订单详情刷新并查看支付状态，避免连续创建多笔付款。若微信已扣款而订单仍未更新，保存支付记录并联系客服核查；是否到账由服务端确认的支付结果决定。',NULL,'付款 支付 微信扣款','user',160,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B07',id,'怎样比较师傅报价？','在订单详情查看报价金额、服务包含/不包含、可上门时间、报价前提、师傅资料及评价，再选择适合自己的报价。系统不会替您自动挑选师傅。',NULL,'报价 比较 选择师傅','user',170,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B08',id,'没有人报价怎么办？','确认订单已付款并审核通过，可补充清晰的施工照片和需求；订单仍在待报价阶段时，可查看“通知附近师傅”是否可用。候选和短信价格以弹窗为准，发送短信不保证对方一定报价。',NULL,'没人报价 通知附近师傅 短信','user',180,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B09',id,'“通知附近师傅”如何收费？','在本人订单的待报价阶段选择候选并确认页面单价，费用先从“我的余额”预占；仅短信最终确认送达时扣费，明确失败或无法确认送达时释放预占。同一订单已通知的目标不会重复收费发送。',NULL,'短信费 通知附近师傅 余额 预占','user',190,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B10',id,'为什么附近师傅列表里有人不能选？','候选可能已通知、当前不符合报价资格、订单报价名额已满，或提交前资格发生变化。请看候选旁的提示；提交时失效的候选不会预占费用或发送。',NULL,'附近师傅 候选 不能选','user',200,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B11',id,'选中报价后，师傅会自动接单吗？','师傅主动报价被您选中后，满足相应支付条件即按订单流程承接；平台派单或邀请师傅仍需对方确认。查看订单详情中的当前状态和预约信息。',NULL,'选中报价 自动接单 派单','user',210,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B12',id,'师傅何时能看到我的电话和详细地址？','报价阶段联系方式受保护；选中师傅或平台完成派单后，才按履约需要开放。商家订单的师傅电话另有保护规则，不会因选择报价就直接公开。',NULL,'电话 地址 联系方式 隐私','user',220,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B13',id,'如何确认上门时间？','与承接师傅沟通后，以订单详情记录的预约时间或“等待客户另行通知”为准。时间变化时请双方在订单中更新，避免只在聊天中约定。',NULL,'预约 上门时间','user',230,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B14',id,'师傅到场后要求加钱，我该怎么处理？','先核对原报价的包含范围。师傅应在订单中提交费用变更和原因，您在详情中选择同意或拒绝；测量加费须完成相应支付才增加成交额。对变更有异议时先保留证据并联系客服。',NULL,'加钱 加费 费用变更','user',240,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B15',id,'如何验收完工？','师傅提交完工与照片后，进入订单详情核对施工结果，再按页面提示确认验收或提出异议。页面可能显示自动确认时间，请及时处理。',NULL,'验收 完工','user',250,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B16',id,'施工有问题，怎么申请维修或售后？','在订单详情查看“申请维修保障”是否可用，按提示描述问题并提交证据。测量成果确认后发现漏项、尺寸或图片问题，可从同一订单的“申请测量售后”进入。',NULL,'维修 售后 测量售后','user',260,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B17',id,'如何申请退款或取消？','在订单详情点击“申请退款”或相应取消入口，填写原因并查看处理状态。退款是否可用、金额及去向取决于当前订单阶段、支付记录和平台处理结果；不要把未到账的微信退款视为已完成。',NULL,'退款 取消订单','user',270,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='refund' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B18',id,'订单争议如何处理？','在详情中提交异议和现场证据，或联系平台客服。争议处理中请保留订单内的报价、变更、照片与沟通记录；平台会按订单事实和规则处理。',NULL,'争议 异议 证据','user',280,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'B19',id,'能直接看到师傅完整手机号吗？','师傅公开资料中的号码受保护。普通下单用户按订单阶段和当前联系权限联系师傅；商家订单不提供直接公开师傅电话的入口，必要时通过订单客服协助。',NULL,'师傅手机号 电话 隐私','user',290,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C01',id,'测量报价金额包含预约费吗？','测量报价是总价，已有效支付的预约费计入其中。选定师傅后，支付剩余差额才正式成交；付款取消或超时不会把已付预约费当作差额扣掉。',NULL,'测量 报价 预约费','user',300,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C02',id,'在哪里看测量成果？','打开测量订单详情，查看师傅提交的空间和图片，包括手写测量单、标注图和现场照片。成果有问题时先在确认前提出补测或异议。',NULL,'测量成果 标注图','user',310,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C03',id,'师傅用量房工具画的图会自动上传吗？','不会。标注工具先保存在师傅本地；师傅明确点击上传后，图片才会进入订单成果。您看不到图片时，可提醒师傅检查是否已上传并提交。',NULL,'量房工具 自动上传 标注','user',320,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C04',id,'确认测量成果后发现问题怎么办？','从测量订单详情发起测量售后并上传问题证据。确认后的成果会锁定，不通过再次直接编辑原成果解决。',NULL,'测量售后 成果问题','user',330,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C05',id,'测量完成后如何下施工单？','从符合条件的测量订单进入关联施工下单，核对预填的地址和联系人，重新填写施工材料、类目和需求。只有施工预约费支付成功，才正式建立一对一关联；打开草稿不占用资格。',NULL,'关联施工 测量单 下施工单','user',340,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C06',id,'能把一张测量单关联多张施工单吗？','当前只能一对一。关联施工只供原测量师傅报价，且须符合相同地址、有效期等条件；需要另找师傅时，可新建普通施工订单。',NULL,'一对一 关联施工','user',350,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C07',id,'测量费会自动抵施工费吗？','不会自动抵扣，默认 0 元。原测量师傅与您商议后在关联施工报价中填写实际抵扣额，订单会展示金额；更换师傅的新普通订单不继承该抵扣。',NULL,'测量费 抵扣 施工费','user',360,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C08',id,'测量款为何还显示冻结？','测量成果确认后，师傅收入按订单规则进入冻结期；有有效售后、退款或争议时也可能暂缓释放。具体到期时间和状态请看测量订单详情。',NULL,'测量款 冻结','user',370,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C09',id,'“我的余额”是什么？','这是用户充值后用于平台当前支持服务的消费余额。它与师傅“结算工钱”完全独立；同一个账号兼具师傅身份也不会自动合并或互转。',NULL,'我的余额 用户余额','user',380,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C10',id,'用户余额能付预约费、测量补款或提现吗？','当前不能。预约费、测量补款、加费等按订单支付页走微信支付；用户余额目前可用于符合条件的附近师傅短信费，不支持提现、转账或购买会员。',NULL,'余额 预约费 提现 会员','user',390,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C11',id,'充值后余额没变怎么办？','在“我的 → 我的余额”查看明细并刷新。余额以服务器确认微信支付真实到账为准；若微信已扣款但页面长时间未更新，请保留支付凭证并联系客服。',NULL,'充值 余额没变','user',400,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C12',id,'短信费为何先显示预占？','发送后需等待短信送达结果。最终确认送达才扣费；失败或无法确认送达会释放预占。可在订单通知状态及余额明细中查看变化。',NULL,'短信费 预占 余额','user',410,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'C13',id,'旧版一口价订单在哪里看？','从“我的 → 一口价订单”进入。新报价/测量订单在“我的 → 报价订单”；两类订单的付款与状态以各自页面为准。',NULL,'旧版 一口价订单 历史订单','user',420,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='find' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D01',id,'如何申请师傅入驻？','打开“我的 → 师傅入驻”，点击“立即申请入驻”，填写施工类型、技能、服务地区、照片等资料并提交审核。页面有审核微信二维码，可用于资料核对和反馈。',NULL,'师傅入驻 申请','worker',430,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D02',id,'如何查看审核进度或驳回原因？','在“我的 → 师傅入驻”查看资料卡片的状态和处理说明。审核时间以实际处理为准；资料被驳回后按说明修改并重新提交。',NULL,'师傅审核 驳回','worker',440,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D03',id,'修改入驻资料会怎样？','从“师傅入驻 → 修改入驻资料”编辑原档案；提交后需要重新审核。已通过后的修改可能受后台次数或周期限制，页面会显示是否可改及下一次可修改时间。',NULL,'修改资料 重新审核','worker',450,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D04',id,'审核通过了，为什么地图上还没有我？','先核对入驻状态、展示资料和服务位置，返回地图刷新。若状态已通过且仍不显示，请将入驻资料与页面情况反馈客服；地图展示与能否对某单报价是两项判断。',NULL,'地图 师傅 审核通过','worker',460,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D05',id,'任何登录用户都能看接单大厅吗？','正常登录的小程序用户可浏览公开报价阶段订单；浏览不代表能报价。大厅只展示当前仍允许公开的订单，选中报价、进入履约、退款或售后等阶段后会移出。',NULL,'接单大厅 浏览 报价','worker',470,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D06',id,'为什么我能看订单却不能报价？','报价需正式师傅审核通过、当前未暂停报价、没有逾期平台服务费，并满足该订单的实时限制。受邀专用身份不能在普通大厅报价；自己的订单也不能给自己报价。以详情页的禁报原因提示为准。',NULL,'不能报价 报价资格','worker',480,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D07',id,'如何提交或修改报价？','在接单大厅打开可报价订单，查看服务范围、地址概况和现场资料，点击“填写报价”；填写总价、包含/不包含范围、可上门时间及前提后提交。还处于可编辑阶段时，详情页会显示“修改报价”。',NULL,'提交报价 修改报价','worker',490,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D08',id,'为什么报价后看不到用户完整电话？','报价阶段联系方式受保护。用户选中您或平台完成派单后，才按当前订单履约权限开放；公开大厅不会提供精确门牌和原始坐标。',NULL,'用户电话 地址 隐私','worker',500,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D09',id,'报价被选中后还要点确认接单吗？','主动报价被选中并满足支付条件后会按流程自动承接；平台派单或邀请订单须在“施工订单”详情中按时接受或拒绝。受邀订单请到相应分类查看。',NULL,'确认接单 自动接单','worker',510,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D10',id,'接到派单但没及时确认会怎样？','派单详情会显示接受截止时间；超过时间可能自动释放。请在“我的 → 施工订单”及时处理，不能仅凭微信消息判断订单仍归您。',NULL,'派单 确认 超时','worker',520,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='payment' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D11',id,'在哪里看我的施工和测量订单？','打开“我的 → 施工订单”，按来源和状态切换；施工、测量、平台派单及受邀工单集中在这里。历史安装工单从“旧版工单”进入。',NULL,'施工订单 测量订单','worker',530,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D12',id,'上门时间如何记录？','与客户确认后，在师傅订单详情的“预约上门”记录或修改时间；若客户暂未确定，可按页面允许的方式记录等待通知。',NULL,'预约上门 时间','worker',540,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D13',id,'现场情况与报价不符，如何加费？','先与客户沟通，再在订单详情提交费用变更、金额与原因。只有客户按流程同意，测量加费还完成相应支付后，金额才会生效；不能只靠电话约定改动订单金额。',NULL,'加费 费用变更','worker',550,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D14',id,'如何提交完工？','在施工订单详情上传至少一张完工照片，填写必要说明和维修保障信息后提交。用户随后验收或提出异议；页面会显示可能的自动验收时间。',NULL,'提交完工 完工照片','worker',560,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='construction' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D15',id,'做测量单要提交哪些成果？','在订单详情按空间上传手写测量单、标注图、现场照片等成果，检查完整后提交给用户确认。量房工具的本地标注不会自动上传到订单。',NULL,'测量成果 标注图 手写测量','worker',570,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D16',id,'客户说没收到测量标注图怎么办？','检查标注是否仅保存在本地，并在测量订单中明确上传、提交。已经提交后仍缺图，可在成果确认前按订单提示补充或补测。',NULL,'测量标注图 上传','worker',580,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D17',id,'原测量单关联施工时由谁报价？','关联施工单仅原测量师傅可报价。报价时可与用户商议测量费抵扣额，默认 0 元；不能把测量费自动当作施工预付款。',NULL,'关联施工 报价 测量师傅','worker',590,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='measurement' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D18',id,'到场后无法施工或联系不上客户怎么办？','在订单详情使用“无法联系或无法施工/测量”入口，按提示上传带时间和位置的现场证据并说明情况。涉及跑空费时，普通用户单先线下协商；商家单按页面提交商家确认或进入争议。',NULL,'无法施工 联系不上 跑空费','worker',600,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'D19',id,'用户申请维修或测量售后后，我在哪里处理？','从“消息与待办”或“施工订单”进入原订单，查看当前售后要求并按订单详情响应。售后处理不改变原订单已完成的历史事实。',NULL,'维修 售后 师傅处理','worker',610,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E01',id,'平台服务费怎么计算？','报价页和订单详情会展示适用费率、最低服务费及预计净收入；预约费可用于抵扣最终服务费。最终账单按成交金额、费用变更和验收后的订单事实计算，以“结算工钱”中的账单为准。',NULL,'平台服务费 费率 净收入','worker',620,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E02',id,'服务费逾期有什么影响？','正式账单逾期未结清时，可能不能新报价或接受新派单。进入“我的 → 结算工钱 → 待结算”查看账单并按页面提示支付。',NULL,'服务费 逾期 报价','worker',630,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E03',id,'“我的余额”与“结算工钱”有何区别？','“我的余额”是作为下单用户充值的消费余额；“结算工钱”是师傅履约收入、服务费账单和可提现金额。两边不能自动抵扣或互转。',NULL,'余额 结算工钱','worker',640,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E04',id,'怎么申请提现？','打开“我的 → 结算工钱”，先完成实名认证并绑定与实名一致的支付宝收款账号；满足页面显示的最低金额和可提现余额后提交申请。平台审核后人工支付宝付款，状态在“提现记录”中查看。',NULL,'提现 支付宝 实名','worker',650,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E05',id,'实名认证还没通过，能先绑定支付宝吗？','可以先绑定账号，但申请提现前须通过实名认证，支付宝姓名也要与认证姓名一致。审核不通过时按页面原因修改后再提交。',NULL,'实名认证 支付宝 提现','worker',660,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E06',id,'为什么提现金额低于收入？','部分收入可能尚未结算、处于冻结期，或已申请提现；测量收入确认后也有冻结规则。查看“结算工钱”的可提现余额、冻结金额、明细和提现记录。',NULL,'提现金额 冻结 可提现','worker',670,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E07',id,'商家单的收款码要怎么用？','在“结算工钱”上传微信或支付宝收款码并等待审核；订单页面只展示一张已审核的码，供该商家订单完工后线下尾款收取。收款金额和凭证以订单当前流程为准。',NULL,'商家单 收款码 尾款','worker',680,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E08',id,'线下尾款没按时收到怎么办？','正常收款无须额外报告；只有延期时在师傅订单详情登记预计收款日期和原因。金额与预计不符时按页面提交实际尾款和收款凭证，不能自行改写原订单金额。',NULL,'尾款 延期 收款','worker',690,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'E09',id,'有人用平台资料打营销电话怎么办？','记录来电时间、号码和相关证据，通过客服反馈。不要在帮助中心或公开评论中粘贴自己的完整手机号；平台按记录核查。',NULL,'营销电话 隐私 安全','worker',700,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F01',id,'如何申请商家认证？','在“我的 → 商家认证”上传营业执照，填写商家名称和经营地址后提交。页面会显示审核状态与原因；通过后的具体服务费优惠以页面和订单快照为准。',NULL,'商家认证 营业执照','merchant',710,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F02',id,'旧门店资料能当作商家认证吗？','不能直接等同。商家认证页展示旧门店资料供兼容查看；新的经营身份与优惠以当前“商家认证”的审核结果为准。',NULL,'旧门店 商家认证','merchant',720,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F03',id,'商家下单与普通用户下单有何不同？','仍从统一下单页提交并在“报价订单”查看。平台按提交时的商家身份和订单规则生成快照；商家相关费率、联系与结款方式以该订单详情为准，后续身份变化不自动重写旧订单。',NULL,'商家下单 普通用户 订单','merchant',730,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='order' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F04',id,'商家订单能直接看师傅手机号吗？','商家订单不提供直接公开师傅完整号码的入口。请使用订单内已有的联系流程；争议处理中确需协助时，通过订单客服说明原因。',NULL,'商家订单 师傅手机号','merchant',740,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F05',id,'商家订单尾款怎么支付？','施工订单详情可能展示经平台审核的师傅收款码，用于完工后的线下尾款；请核对订单金额和收款信息并保留凭证。测量补款、加费等需要线上支付的项目仍按订单页面操作。',NULL,'商家 尾款 收款码','merchant',750,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='finance' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F06',id,'师傅提交跑空费后我怎么处理？','在订单详情查看金额、原因及现场证据，选择同意并按页面支付，或不同意并转争议。普通用户单的处理方式与商家单不同，请按本单页面提示操作。',NULL,'跑空费 商家 争议','merchant',760,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='aftersales' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'F07',id,'商家和师傅的资金或联系方式会混在一起吗？','不会。商家身份、师傅身份和下单用户身份可在同一账号并存，但订单费用、用户充值余额、师傅结算余额及联系方式分别按当前业务权限处理。',NULL,'多身份 资金 联系方式','merchant',770,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G01',id,'在哪里查看会员状态？','打开“我的 → 设置 → 会员服务”，查看是否已开通及有效期。历史会员可能显示兼容状态；是否能使用某项权益，还要以当前权限与后台配置为准。',NULL,'会员状态 有效期','member',780,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G02',id,'怎样开通会员、价格是多少？','从“设置 → 会员服务”查看当前可用的开通方式与页面价格；如页面没有可用购买/激活入口，请联系客服。旧帮助页的固定价格不是当前通用承诺。',NULL,'开通会员 价格','member',790,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G03',id,'会员能查看所有师傅的号码吗？','只有后台有效会员且当前手机号查看功能开放时，才能在师傅详情按页面授权查看；还需受滚动 24 小时不同师傅数量上限约束。受保护或缺失的号码不会因开通会员而被强行公开。',NULL,'会员 师傅号码 手机号','member',800,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G04',id,'提示额度用完是什么意思？','额度按过去 24 小时查看过的不同师傅计数，同一师傅在窗口内重复查看不再占一个新名额。上限由后台配置，详情页提示的剩余额度和原因是准确信息。',NULL,'额度 24小时 查看手机号','member',810,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G05',id,'已经开通会员，为什么仍不能查看号码？','先核对会员有效期、微信登录和手机号授权，再看师傅详情的具体提示；也可能是后台暂时关闭、额度已满或师傅无有效号码。不要通过其他账号或非平台方式绕过限制。',NULL,'会员 不能查看号码','member',820,1,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\nINSERT IGNORE INTO help_faqs(faq_id,category_id,question,answer,aliases,keywords,roles,sort_order,is_featured,status,related_faq_ids,business_entry_label,business_entry_path,draft_payload,version,published_version,published_at,created_by,updated_by,deleted_at,created_at,updated_at) SELECT 'G06',id,'会员和用户充值余额有关联吗？','两者独立。用户充值不会自动开通会员，用户余额当前也不能购买会员；会员资格不等于师傅工钱、用户钱包或订单款项。',NULL,'会员 用户余额 充值','member',830,0,'draft',NULL,'','',NULL,1,0,NULL,NULL,NULL,NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM help_categories WHERE code='account' LIMIT 1;\n\n-- V2.4.0 migration end.\nDELETE FROM `database_field_dictionary` WHERE `table_name`='form_fields' AND `field_name`='category_id';\n\n-- 2026-09-29：数据库物理字段中文注释与后台字段字典统一补齐。\nINSERT IGNORE INTO `database_field_dictionary`(`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('admin_users','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','username','登录账号','登录账号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','password_hash','密码哈希','密码哈希',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','real_name','真实姓名','真实姓名',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','role','角色','角色',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','status','状态','状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','must_change_password','是否必须修改密码','是否必须修改密码',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','failed_attempts','登录失败次数','登录失败次数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','locked_until','锁定截止时间','锁定截止时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','last_login_at','最后登录时间','最后登录时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','last_login_ip','最后登录IP','最后登录IP',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','password_changed_at','密码修改时间','密码修改时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('admin_users','updated_at','更新时间','更新时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('after_sales','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('after_sales','public_no','业务编号','业务编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('after_sales','order_id','订单ID','订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('after_sales','user_id','用户ID','用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('after_sales','type','类型','类型',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('after_sales','description','描述','描述',UTC_TIMESTAMP(),UTC_TIMESTAM