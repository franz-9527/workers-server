f1b73181500408411e779fd34b4bed0ad343c\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"curl\",\n        \"gd\",\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"retry_failed\": true,\n      \"install_baseline\": true,\n      \"description\": \"维修提交后自动进入维修中并归属原成交师傅，师傅仅可完成或拒绝，平台介入由用户发起；同步优化消息、师傅详情、发布页和提交配置体验；修复 system_settings 迁移字段名错误，failed 迁移可按纯数据策略安全重试。\"\n    },\n    {\n      \"version\": \"2.2.6\",\n      \"name\": \"师傅订单阶段导航与下单页可视化配置\",\n      \"file\": \"2.2.6.sql\",\n      \"checksum\": \"745076e71bd17cd67f7316b05459a4efd6365c35efb20c58ee7e82d1465c18f5\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"curl\",\n        \"gd\",\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"retry_failed\": true,\n      \"install_baseline\": true,\n      \"description\": \"师傅订单底部改为流程阶段导航；接单大厅突出当日上门；保护非真实师傅历史字段结构；下单页配置支持多类目、独立拖拽设计器和条件逻辑；小程序更新弹窗去重。\"\n    },\n    {\n      \"version\": \"2.2.7\",\n      \"name\": \"测量单、图片标注与冻结抵扣\",\n      \"file\": \"2.2.7.sql\",\n      \"checksum\": \"f56b4e7470c46d458bb03abe3ed39ecb1593bb8ebc93fd3d5a9a004e3bdd83ed\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"curl\",\n        \"gd\",\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"以 V2.2.6 为升级前置：新增独立测量单、师傅测量报价与空间图片、全额微信支付、冻结结算、最长30天延长及同地址同师傅施工关联；前端测量发布统一并入“我要下单”；低风险施工单可配置自动预审；师傅主动报价成交后自动接单；重建独立演示用户/商家/师傅并隔离生产数据、外部副作用和计划任务。迁移包含 DDL，失败后禁止自动整段重试。\"\n    },\n    {\n      \"version\": \"2.2.8\",\n      \"name\": \"维修撤回、电话隐私、预约响应与演示数据重建\",\n      \"file\": \"2.2.8.sql\",\n      \"checksum\": \"2d62daf7be3fb450a6ff698153902457b6346e3b4dcde9211279e22464314c3e\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"curl\",\n        \"gd\",\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"在 V2.2.7 基础上增加维修撤回、用户侧成交师傅电话默认隐藏中间5位且脱敏时不生成拨打入口、施工/维修满2小时无响应后管理员审批公开、商家联系方式隔离，以及师傅预约“等待客户另行通知”上下文；同时按 V2.2.8 重建独立演示用户/商家/师傅，清理历史真实测试账号上仅可由 demo:/v204:/v213:/v222:/v224:/v227: 等明确演示标识识别的余额、提现和孤儿消息。迁移包含 appointment_records DDL、电话公开审批表和演示数据重建，失败后禁止自动整段重试。\"\n    },\n    {\n      \"version\": \"2.2.9\",\n      \"name\": \"测量业务回归统一订单内核\",\n      \"file\": \"2.2.9.sql\",\n      \"checksum\": \"c4ae68aa6717ce9256fbbeaedf6b59ba52c8088e52481fcd712972a4e0a0e706\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"curl\",\n        \"gd\",\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"统一测量工作流回归 orders 主档，并增加用户钱包、附近师傅付费短信、会员与手机号保护、远距离报价确认及师傅资料修改频率控制；正式协议统一使用 category_ids、min_items/max_items 与 quotes.details_json，清理 V2.2.9 开发草稿兼容及旧全局公告配置；本版尚未正式运营，升级末尾按预发布策略清空订单、财务、站内通知及派生业务数据，保留系统设置和师傅管理主档。\"\n    },\n    {\n      \"version\": \"2.4.0\",\n      \"name\": \"帮助中心数据化、双接单模式与期望费用\",\n      \"file\": \"2.4.0.sql\",\n      \"checksum\": \"a513ed536c0242462fecc99e01e36c9cb08e7e9b5387d92cb82edb699e542c0a\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"帮助中心、双接单模式、期望费用与 V1 可视化下单设计器；上线前同步清理当前运行代码无引用的未落地结构，修复 scheduler_runs 每分钟空日志无限增长，并清理现有空成功日志后重建表空间；全部保留表字段增加中文 COMMENT 和字段字典。第三类表合并本版不处理。\"\n    },\n    {\n      \"version\": \"2.4.1\",\n      \"name\": \"微信OCR、门店公开联系方式与表单展示配置\",\n      \"file\": \"2.4.1.sql\",\n      \"checksum\": \"07affa2c194dcdc6c4ebcd0356b075a6f0e582162c60dffed2762c5f705fa43f\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"完整加密保存实名认证/营业执照 OCR 字段和微信原始回包，增加本地 OCR 额度台账；新增门店手机号公开设置，并为表单版本增加前端展示配置以支持非必填资料折叠。\"\n    },\n    {\n      \"version\": \"2.5.0\",\n      \"name\": \"双维度评价与平台承接单\",\n      \"file\": \"2.5.0.sql\",\n      \"checksum\": \"a8fb5669fafcfbf5ea24afd338c534229b9921e10b5310af611ead60cb871bb3\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"评价拆分为服务态度与施工手艺双维度；平台承接单继续复用统一 orders 内核，新增结构化计价/结算、customer_flow_mode 客户参与方式、平台测量后核价确认衔接，以及默认平台收入比例与余额冻结设置。新增取消行为计分、七天下单限制、原拨号/预约/异常入口信号及客服解除审计表。V2.5.0 迁移同时写入 BXDEMOHALL01-06 六条 is_demo=1 接单大厅审核展示样例，仅补最小订单、类目、测量和平台条件，不创建真实支付、消息、退款、结算或钱包流水。迁移包含 DDL，失败后禁止自动整段重试；兼容已成功执行的经核验历史 checksum：注释差异版，以及正式结构和业务迁移完全一致但未追加可选 BXDEMOHALL 样例的旧版；不重跑历史迁移、不补写演示订单，不放宽当前脚本校验。\",\n      \"retry_failed\": false,\n      \"accepted_applied_checksums\": [\n        \"391814af1a34f7d451664b6640843009175432ab51c3ab1788add73e10b492cd\",\n        \"042fc8d8ea74f95ee5ff410b9ec7e16c3928448a39df72d0a719f31c9a7ab894\"\n      ]\n    },\n    {\n      \"version\": \"2.6.0\",\n      \"name\": \"后台测试中心与可回收场景数据工厂\",\n      \"file\": \"2.6.0.sql\",\n      \"checksum\": \"a5579951d24b766f3d571d1c3a0487c8ec1932f35788a81e6b0c8254e067dc06\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"新增 testing-only 后台测试中心运行元数据、内部预约费模拟事实、测试参与者、媒体归属、消息模拟投影及一次性短期小程序测试入口；支持普通施工/测量、抢单、平台承接、代下单与定向邀请等测试场景的一键生成、真实业务动作、断言、复制、重建和所有权证明式清理。审核展示样例 BXDEMOHALL01-06 始终只读，外部消息只记录应发未投递证据，正式环境写操作硬阻断。迁移包含 DDL，失败后禁止自动整段重试。\"\n    },\n    {\n      \"version\": \"2.7.0\",\n      \"name\": \"订单聊天整包结构与权限、消息及已读基础\",\n      \"file\": \"2.7.0.sql\",\n      \"checksum\": \"a6367f120984983f2674e4caac511e1e27d77b4adc7a680ac4814e1ddfb0818a\",\n      \"min_php\": \"8.3.36\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"retry_failed\": false,\n      \"install_baseline\": true,\n      \"description\": \"2.6.0之后尚未发布的S01～S17结构收敛为一次2.7.0升级：PHP身份/订单权限/工作人员撤权、Go会话/发送/审核/双游标/已读水位与未读索引、字段独立版本的会话偏好、同会话引用、撤回与有界重新编辑来源、私有图片上传/任务/逐图和整组预审/原子发布与清理账本。各阶段继续修改本未发布包，不按开发单元新增版本。保留全部已发布2.6.0及更早SQL校验值，默认不开启、不回填、不发送；DDL失败不自动整段重跑。\"\n    }\n  ]\n}\n","chat/internal/message/preferences.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"math\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrPreferenceConflict = errors.New(\"CHAT_PREFERENCE_CONFLICT\")\nvar ErrPinLimit = errors.New(\"CHAT_PIN_LIMIT\")\n\ntype Preferences struct {\n\tMemberVersion   string   `json:\"member_version\"`\n\tPinned          bool     `json:\"pinned\"`\n\tPinnedVersion   ports.ID `json:\"pinned_version\"`\n\tLater           bool     `json:\"later\"`\n\tLaterVersion    ports.ID `json:\"later_version\"`\n\tAccountRevision ports.ID `json:\"account_revision\"`\n}\ntype PreferenceRequest struct {\n\tConversationID ports.ID\n\tMemberVersion  string\n\tField          string\n\tValue          bool\n\tExpected       ports.ID\n}\n\nfunc preferenceLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, id ports.ID, g ports.Grant) (Preferences, error) {\n\tout := Preferences{MemberVersion: memberHash(g.MemberKey), PinnedVersion: \"0\", LaterVersion: \"0\", AccountRevision: \"0\"}\n\tvar hash string\n\terr := tx.QueryRowContext(ctx, `SELECT member_key_hash,pinned,CAST(pinned_version AS CHAR),later,CAST(later_version AS CHAR) FROM chat_user_preferences WHERE conversation_id=? AND actor_id=?`, string(id), string(p.ActorID)).Scan(&hash, &out.Pinned, &out.PinnedVersion, &out.Later, &out.LaterVersion)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif hash != out.MemberVersion {\n\t\tout.Pinned = false\n\t\tout.Later = false\n\t\tout.PinnedVersion = \"0\"\n\t\tout.LaterVersion = \"0\"\n\t}\n\treturn out, nil\n}\nfunc accountRevision(ctx context.Context, db interface {\n\tQueryRowContext(context.Context, string, ...any) *sql.Row\n}, actor ports.ID) (ports.ID, error) {\n\tvar revision ports.ID\n\terr := db.QueryRowContext(ctx, `SELECT CAST(revision AS CHAR) FROM chat_preference_accounts WHERE actor_id=?`, string(actor)).Scan(&revision)\n\tif err == sql.ErrNoRows {\n\t\treturn \"0\", nil\n\t}\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn revision, nil\n}\nfunc (s *HistoryService) Preferences(ctx context.Context, p ports.Principal, id ports.ID) (Preferences, error) {\n\tif !validID(id) || p.Environment != s.environment {\n\t\treturn Preferences{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout, err := preferenceLocked(ctx, tx, p, id, g)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout.AccountRevision, err = accountRevision(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Preferences{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// SetPreference serializes this actor's preference writes after the existing\n// guard/login/conversation lock order. Independent fields never overwrite each\n// other. A retry may repeat only the immediate same-value version transition.\nfunc (s *HistoryService) SetPreference(ctx context.Context, p ports.Principal, q PreferenceRequest) (Preferences, error) {\n\tif !validID(q.ConversationID) || p.Environment != s.environment || !q.Expected.Valid() || !memberVersionPattern.MatchString(q.MemberVersion) || (q.Field != \"pinned\" && q.Field != \"later\") {\n\t\treturn Preferences{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"})\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tif memberHash(g.MemberKey) != q.MemberVersion {\n\t\treturn Preferences{}, ErrResync\n\t}\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_preference_accounts(actor_id,revision,updated_at) VALUES(?,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(p.ActorID))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\trevision, err := accountRevision(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout, err := preferenceLocked(ctx, tx, p, q.ConversationID, g)\n\tif err != nil {\n\t\treturn Preferences{}, err\n\t}\n\tout.AccountRevision = revision\n\tversion, value := out.PinnedVersion, out.Pinned\n\tif q.Field == \"later\" {\n\t\tversion, value = out.LaterVersion, out.Later\n\t}\n\tif q.Expected != version {\n\t\tif !(value == q.Value && number(version) > 0 && number(q.Expected) == number(version)-1) {\n\t\t\treturn out, ErrPreferenceConflict\n\t\t}\n\t\tif !time.Now().Before(p.ExpiresAt) {\n\t\t\treturn Preferences{}, policy.ErrDenied\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tif value == q.Value {\n\t\tif !time.Now().Before(p.ExpiresAt) {\n\t\t\treturn Preferences{}, policy.ErrDenied\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tif number(version) == math.MaxUint64 || number(revision) == math.MaxUint64 {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif q.Field == \"pinned\" && q.Value {\n\t\t// Only current projected generations consume a pin slot. PHP authorization\n\t\t// is still rechecked for every returned row; this count grants no access.\n\t\tvar count int\n\t\terr = tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM (SELECT p.conversation_id FROM chat_user_preferences p JOIN chat_members m ON m.conversation_id=p.conversation_id AND m.actor_id=p.actor_id WHERE p.actor_id=? AND p.pinned=1 AND m.actor_kind='mini' AND m.can_read=1 AND p.member_key_hash=SHA2(m.member_key,256) LIMIT 10) active_pins`, string(p.ActorID)).Scan(&count)\n\t\tif err != nil {\n\t\t\treturn Preferences{}, ports.ErrUnavailable\n\t\t}\n\t\tif count >= 10 {\n\t\t\treturn out, ErrPinLimit\n\t\t}\n\t}\n\tif q.Field == \"pinned\" {\n\t\tout.Pinned = q.Value\n\t\tout.PinnedVersion = decimal(number(version) + 1)\n\t} else {\n\t\tout.Later = q.Value\n\t\tout.LaterVersion = decimal(number(version) + 1)\n\t}\n\tout.AccountRevision = decimal(number(revision) + 1)\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) VALUES(?,?,?,?,?,?,?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE member_key_hash=VALUES(member_key_hash),pinned=VALUES(pinned),pinned_version=VALUES(pinned_version),later=VALUES(later),later_version=VALUES(later_version),updated_at=VALUES(updated_at)`, string(q.ConversationID), string(p.ActorID), out.MemberVersion, out.Pinned, string(out.PinnedVersion), out.Later, string(out.LaterVersion))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\t_, err = tx.ExecContext(ctx, `UPDATE chat_preference_accounts SET revision=?,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(out.AccountRevision), string(p.ActorID))\n\tif err != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Preferences{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Preferences{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n","chat/internal/message/preferences_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"regexp\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar memberVersionPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)\n\n// Both transports use the same closed schema. No account/role override,\n// muted/hidden flag, read_seq, batch object, duplicate key or null is accepted.\nfunc decodePreference(raw []byte, write bool) (PreferenceRequest, error) {\n\tvar q PreferenceRequest\n\tif len(raw) > 4096 || !utf8.Valid(raw) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\ttoken, err := d.Token()\n\tif err != nil || token != json.Delim('{') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\ttoken, err = d.Token()\n\t\tkey, ok := token.(string)\n\t\tif err != nil || !ok || seen[key] {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tseen[key] = true\n\t\tvar field json.RawMessage\n\t\tif d.Decode(&field) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tif key == \"value\" && write {\n\t\t\tif !bytes.Equal(field, []byte(\"true\")) && !bytes.Equal(field, []byte(\"false\")) {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Value = bytes.Equal(field, []byte(\"true\"))\n\t\t\tcontinue\n\t\t}\n\t\tvar value string\n\t\tif len(field) < 2 || field[0] != '\"' || !validSurrogates(field) || json.Unmarshal(field, &value) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tswitch key {\n\t\tcase \"conversation_id\":\n\t\t\tq.ConversationID = ports.ID(value)\n\t\tcase \"member_version\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.MemberVersion = value\n\t\tcase \"field\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Field = value\n\t\tcase \"expected_version\":\n\t\t\tif !write {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tq.Expected = ports.ID(value)\n\t\tdefault:\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\ttoken, err = d.Token()\n\tif err != nil || token != json.Delim('}') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif _, err = d.Token(); err != io.EOF || !validID(q.ConversationID) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif write && (len(seen) != 5 || !seen[\"value\"] || !memberVersionPattern.MatchString(q.MemberVersion) || !q.Expected.Valid() || (q.Field != \"pinned\" && q.Field != \"later\")) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif !write && len(seen) != 1 {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\n","chat/internal/message/preferences_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync\"\n\t\"testing\"\n)\n\nfunc prefRequest(id ports.ID, p Preferences, field string, value bool) PreferenceRequest {\n\tversion := p.PinnedVersion\n\tif field == \"later\" {\n\t\tversion = p.LaterVersion\n\t}\n\treturn PreferenceRequest{id, p.MemberVersion, field, value, version}\n}\nfunc TestMySQLS14IndependentFieldsRetryAndReadIsolation(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 4)\n\tp := principal(\"10202\")\n\tinitial, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || initial.Pinned || initial.Later || initial.AccountRevision != \"0\" {\n\t\tt.Fatal(initial, e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_user_preferences\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_preference_accounts\") != \"0\" {\n\t\tt.Fatal(\"read creates preferences\")\n\t}\n\tstart := make(chan struct{})\n\terrs := make(chan error, 2)\n\tfor _, field := range []string{\"pinned\", \"later\"} {\n\t\tgo func(field string) {\n\t\t\t<-start\n\t\t\t_, err := h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, field, true))\n\t\t\terrs <- err\n\t\t}(field)\n\t}\n\tclose(start)\n\tfor n := 0; n < 2; n++ {\n\t\tif err := <-errs; err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tcurrent, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || !current.Pinned || !current.Later || current.PinnedVersion != \"1\" || current.LaterVersion != \"1\" || current.AccountRevision != \"2\" {\n\t\tt.Fatal(current, e)\n\t}\n\trepeated, e := h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, \"pinned\", true))\n\tif e != nil || repeated.AccountRevision != \"2\" {\n\t\tt.Fatal(\"lost-response retry\", repeated, e)\n\t}\n\tconflict := prefRequest(r.ConversationID, initial, \"pinned\", false)\n\tif _, e = h.SetPreference(f.ctx, p, conflict); e != ErrPreferenceConflict {\n\t\tt.Fatal(\"stale overwrite\", e)\n\t}\n\t_, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"pinned\", false))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, initial, \"pinned\", true)); e != ErrPreferenceConflict {\n\t\tt.Fatal(\"ABA retry\", e)\n\t}\n\tu, e := h.Unread(f.ctx, p, r.ConversationID)\n\tif e != nil || !u.Preferences.Later || u.Preferences.Pinned || u.Preferences.AccountRevision != \"3\" {\n\t\tt.Fatal(u, e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != \"0\" {\n\t\tt.Fatal(\"preference writes read seq\")\n\t}\n\tboot := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID}, \"bootstrap\")\n\tif _, e = h.Acknowledge(f.ctx, p, r.ConversationID, boot.SyncCursor); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcurrent, e = h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || !current.Later {\n\t\tt.Fatal(\"read cleared later\", current, e)\n\t}\n\tother, e := h.Preferences(f.ctx, principal(\"10203\"), r.ConversationID)\n\tif e != nil || other.Pinned || other.Later {\n\t\tt.Fatal(\"other actor inherited preference\", other, e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, principal(\"10201\"), prefRequest(r.ConversationID, current, \"later\", false)); e == nil {\n\t\tt.Fatal(\"outsider mutated\")\n\t}\n\tf.php(\"close\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\t// Readonly policy still permits changing one's own organizational preference.\n\tcurrent, e = h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"pinned\", true)); e != nil {\n\t\tt.Fatal(\"readonly blocked preference\", e)\n\t}\n\tf.php(\"repair\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tnext, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil || next.Pinned || next.Later || next.MemberVersion == initial.MemberVersion {\n\t\tt.Fatal(\"generation inherited preference\", next, e)\n\t}\n\tif _, e = h.SetPreference(f.ctx, p, prefRequest(r.ConversationID, current, \"later\", false)); e != ErrResync {\n\t\tt.Fatal(\"old generation updated new preference\", e)\n\t}\n}\nfunc TestMySQLS14DigestRevisionAndTransports(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 1)\n\tp := principal(\"10202\")\n\tf.php(\"sync\", \"402\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpage, e := h.DigestsCursor(f.ctx, p, \"\", 1)\n\tif e != nil || !page.HasMore || page.PreferenceRevision != \"0\" {\n\t\tt.Fatal(page, e)\n\t}\n\tinitial, e := h.Preferences(f.ctx, p, r.ConversationID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tbody := fmt.Sprintf(`{\"conversation_id\":\"%s\",\"member_version\":\"%s\",\"field\":\"later\",\"value\":true,\"expected_version\":\"0\"}`, r.ConversationID, initial.MemberVersion)\n\tcommands := SocketCommands{History: h}\n\t_, out, e := commands.Execute(f.ctx, p, \"conversation.preference\", json.RawMessage(body))\n\tif e != nil || !out.(Preferences).Later {\n\t\tt.Fatal(out, e)\n\t}\n\tif _, e = h.DigestsCursor(f.ctx, p, page.NextCursor, 1); e != ErrResync {\n\t\tt.Fatal(\"mixed preference cursor\", e)\n\t}\n\tpage, e = h.DigestsCursor(f.ctx, p, \"\", 20)\n\tif e != nil || page.PreferenceRevision != \"1\" {\n\t\tt.Fatal(page, e)\n\t}\n\tfound := false\n\tfor _, row := range page.Items {\n\t\tif row.ConversationID == r.ConversationID {\n\t\t\tfound = row.Unread.Preferences.Later && row.Unread.Preferences.AccountRevision == \"1\"\n\t\t}\n\t}\n\tif !found {\n\t\tt.Fatal(\"digest lost preference\")\n\t}\n\tfor _, key := range []string{\"muted\", \"hidden\", \"read_seq\", \"actor_id\"} {\n\t\traw := fmt.Sprintf(`{\"conversation_id\":\"%s\",\"%s\":true}`, r.ConversationID, key)\n\t\tif _, _, e = commands.Execute(f.ctx, p, \"conversation.preference\", json.RawMessage(raw)); e == nil {\n\t\t\tt.Fatal(\"forged socket field\", key)\n\t\t}\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, e = h.Preferences(f.ctx, p, r.ConversationID); e == nil {\n\t\tt.Fatal(\"revoked session read preferences\")\n\t}\n\tif _, _, e = commands.Execute(context.Background(), p, \"conversation.preference\", json.RawMessage(body)); e == nil {\n\t\tt.Fatal(\"revoked session updated\")\n\t}\n}\nfunc TestMySQLS14PinBudgetAcrossConversations(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 0)\n\tp := principal(\"10202\")\n\tf.php(\"sync\", \"402\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tsecond, e := f.store.FindOrder(f.ctx, p, \"402\", \"402\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor n := 1; n <= 9; n++ {\n\t\tid := 1000 + n\n\t\tkey := fmt.Sprintf(\"budget-member-%d\", n)\n\t\tf.exec(`INSERT INTO chat_conversations(id,conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at) VALUES(?,'order',?,?,?,1,REPEAT('a',64),'budget','open',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, id, fmt.Sprintf(\"budget:%d\", n), id, id)\n\t\tf.exec(`INSERT INTO chat_members(conversation_id,actor_id,actor_kind,role,member_key,can_read,can_send) VALUES(?,10202,'mini','worker',?,1,1)`, id, key)\n\t\tf.exec(`INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) VALUES(?,10202,?,1,1,0,0,UTC_TIMESTAMP(6))`, id, memberHash(key))\n\t}\n\tstart := make(chan struct{})\n\terrs := make(chan error, 2)\n\tvar wg sync.WaitGroup\n\tfor _, id := range []ports.ID{r.ConversationID, second} {\n\t\tinitial, e := h.Preferences(f.ctx, p, id)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\twg.Add(1)\n\t\tgo func(id ports.ID, initial Preferences) {\n\t\t\tdefer wg.Done()\n\t\t\t<-start\n\t\t\t_, err := h.SetPreference(f.ctx, p, prefRequest(id, initial, \"pinned\", true))\n\t\t\terrs <- err\n\t\t}(id, initial)\n\t}\n\tclose(start)\n\twg.Wait()\n\tclose(errs)\n\taccepted, limited := 0, 0\n\tfor err := range errs {\n\t\tif err == nil {\n\t\t\taccepted++\n\t\t} else if err == ErrPinLimit {\n\t\t\tlimited++\n\t\t} else {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif accepted != 1 || limited != 1 || f.text(\"SELECT COUNT(*) FROM chat_user_preferences WHERE pinned=1\") != \"10\" {\n\t\tt.Fatal(\"pin budget race\", accepted, limited)\n\t}\n\t// Removed projection generations no longer occupy usable pin capacity.\n\tf.exec(\"UPDATE chat_members SET can_read=0 WHERE conversation_id=1001\")\n\tfor _, id := range []ports.ID{r.ConversationID, second} {\n\t\tinitial, e := h.Preferences(f.ctx, p, id)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif !initial.Pinned {\n\t\t\tif _, e = h.SetPreference(f.ctx, p, prefRequest(id, initial, \"pinned\", true)); e != nil {\n\t\t\t\tt.Fatal(\"stale pin consumed capacity\", e)\n\t\t\t}\n\t\t}\n\t}\n}\n","server/tests/fixtures/schema-2.6.0.sql.gz":"H4sIAAAAAAACA+y9aXMbyZUo+t2/As8RL6ieQauxE/ANR4ymW+ORpxdPL353\n7vUNdAEokGWBAIyFas6