en' COMMENT '状态',\n  MODIFY COLUMN `responsibility` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'undetermined' COMMENT '责任归属',\n  MODIFY COLUMN `resolution` text COLLATE utf8mb4_unicode_ci COMMENT '处理结果',\n  MODIFY COLUMN `refund_amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '退款金额（分）',\n  MODIFY COLUMN `run_empty_fee_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '运行空费用（分）',\n  MODIFY COLUMN `handled_by` bigint(20) unsigned DEFAULT NULL COMMENT '处理管理员ID',\n  MODIFY COLUMN `opened_at` datetime NOT NULL COMMENT '开启时间',\n  MODIFY COLUMN `resolved_at` datetime DEFAULT NULL COMMENT '解决时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `exceptional_arrivals`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `exception_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '异常类型',\n  MODIFY COLUMN `description` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '描述',\n  MODIFY COLUMN `lat` decimal(10,7) DEFAULT NULL COMMENT '纬度',\n  MODIFY COLUMN `lng` decimal(11,7) DEFAULT NULL COMMENT '经度',\n  MODIFY COLUMN `coordinate_system` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'GCJ-02' COMMENT '坐标系',\n  MODIFY COLUMN `evidence_media_ids_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '证据媒体ID列表JSON',\n  MODIFY COLUMN `watermark_metadata_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '水印元数据JSON',\n  MODIFY COLUMN `arrived_at` datetime NOT NULL COMMENT '到场时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `form_fields`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `step_id` bigint(20) unsigned NOT NULL COMMENT '步