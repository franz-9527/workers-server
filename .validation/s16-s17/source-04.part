ed NOT NULL COMMENT '师傅ID',\n  MODIFY COLUMN `amount_cents` bigint(20) unsigned NOT NULL COMMENT '金额（分）',\n  MODIFY COLUMN `channel` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'alipay_manual' COMMENT '渠道',\n  MODIFY COLUMN `external_transaction_no` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '外部交易编号',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'paid' COMMENT '状态',\n  MODIFY COLUMN `proof_media_id` bigint(20) unsigned DEFAULT NULL COMMENT '凭证媒体ID',\n  MODIFY COLUMN `paid_by` bigint(20) unsigned DEFAULT NULL COMMENT '已支付操作人',\n  MODIFY COLUMN `paid_at` datetime NOT NULL COMMENT '已支付时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `worker_phone_reveal_logs`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `viewer_user_id` bigint(20) unsigned NOT NULL COMMENT '查看者用户ID',\n  MODIFY COLUMN `viewer_role` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '查看者角色',\n  MODIFY COLUMN `worker_cloud_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '师傅云端ID',\n  MODIFY COLUMN `mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '手机号HMAC摘要',\n  MODIFY COLUMN `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '结果',\n  MODIFY COLUMN `reason_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT '原因代码',\n  MODIFY COLUMN `ip_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT 'IPHMAC摘要',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `worker_profiles`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `public_id` char(26)