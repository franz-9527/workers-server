ascii_bin DEFAULT NULL COMMENT '微信退款ID',\n  MODIFY COLUMN `failure_code` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '失败代码',\n  MODIFY COLUMN `failure_message` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '失败信息',\n  MODIFY COLUMN `requested_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '申请操作人管理员ID',\n  MODIFY COLUMN `requested_at` datetime NOT NULL COMMENT '申请时间',\n  MODIFY COLUMN `succeeded_at` datetime DEFAULT NULL COMMENT '成功时间',\n  MODIFY COLUMN `closed_at` datetime DEFAULT NULL COMMENT '关闭时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `review_media`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `review_id` bigint(20) unsigned NOT NULL COMMENT '审核ID',\n  MODIFY COLUMN `media_file_id` bigint(20) unsigned NOT NULL COMMENT '媒体文件ID',\n  MODIFY COLUMN `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `review_replies`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `review_id` bigint(20) unsigned NOT NULL COMMENT '审核ID',\n  MODIFY COLUMN `replier_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '回复人类型',\n  MODIFY COLUMN `replier_id` bigint(20) unsigned DEFAULT NULL COMMENT '回复人ID',\n  MODIFY COLUMN `content` varchar(2000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '内容',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'visible' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `reviews`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',