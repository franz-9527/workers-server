 NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `entry_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '流水类型',\n  MODIFY COLUMN `direction` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '收支方向',\n  MODIFY COLUMN `amount_cents` bigint(20) unsigned NOT NULL COMMENT '金额（分）',\n  MODIFY COLUMN `available_delta_cents` bigint(20) NOT NULL DEFAULT '0' COMMENT '可用余额变动（分）',\n  MODIFY COLUMN `reserved_delta_cents` bigint(20) NOT NULL DEFAULT '0' COMMENT '预留余额变动（分）',\n  MODIFY COLUMN `available_after_cents` bigint(20) unsigned NOT NULL COMMENT '可用售后（分）',\n  MODIFY COLUMN `reserved_after_cents` bigint(20) unsigned NOT NULL COMMENT '预留售后（分）',\n  MODIFY COLUMN `reference_type` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '引用类型',\n  MODIFY COLUMN `reference_id` bigint(20) unsigned DEFAULT NULL COMMENT '引用ID',\n  MODIFY COLUMN `idempotency_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '幂等键',\n  MODIFY COLUMN `description` varchar(500) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '描述',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'effective' COMMENT '状态',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `user_wallet_recharges`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_no` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `amount_cents` bigint(20) unsigned NOT NULL COMMENT '金额（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'created' COMMENT '状态',\n  MODIFY COLUMN `payment_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '支付订单ID',\n  MODIFY COLUMN `client_request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '客户端请求ID',\n  MODIFY COLUMN `paid_at` datetime DEFAULT NU