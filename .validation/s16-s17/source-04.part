730a31bc3f40c0ffc2027a24bbc30d19ff1932\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"完善订单资料编辑、报价阶段与成交来源展示，完工后直接上传线下收款凭证并支付服务费，加入接单/报价维护开关，使用 MySQL 5.7 安全 JOIN 清理并重建全状态演示数据。\"\n    },\n    {\n      \"version\": \"2.0.4\",\n      \"name\": \"管理操作、中文时间线与测试数据重建\",\n      \"file\": \"2.0.4.sql\",\n      \"checksum\": \"a2932eae48ea8b3700302567755bb1b24fafdc4ba2a6b47eaf7f69b50b8381a7\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"retry_failed\": true,\n      \"install_baseline\": true,\n      \"description\": \"精简管理员工作台审核与分享操作，订单时间线改为具体中文流程；按上线前测试要求清空旧订单和师傅财务业务链，只保留指定下单用户与师傅用户并重建十种测试场景。\"\n    },\n    {\n      \"version\": \"2.0.5\",\n      \"name\": \"财务闭环、师傅迁移与地图修复\",\n      \"file\": \"2.0.5.sql\",\n      \"checksum\": \"a65df6f7821f3d7da75e6f7ceb0ec2a75f4db7db83309cadf310b4f5dd6e2f1e\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"增加财务查询、补资料、尾款坏账、报价人数和身份证水印；新增旧云已审核师傅唯一迁移与图片压缩归档，并修复地图审核、详情路由和接单大厅排序。\"\n    },\n    {\n      \"version\": \"2.0.6\",\n      \"name\": \"师傅云开发主数据与后台安全中转\",\n      \"file\": \"2.0.6.sql\",\n      \"checksum\": \"949ab990a3429704d4f487546390ddc918d2064ad6fdce0af483d66c8d958b16\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"师傅完整资料继续保存在云开发 worker 集合，PHP 后台经签名云函数直接管理并可生成密钥；旧公开记录保持原状态，公开图片直接上传云存储。\"\n    },\n    {\n      \"version\": \"2.0.7\",\n      \"name\": \"维护开关、提现冻结与真实师傅管理\",\n      \"file\": \"2.0.7.sql\",\n      \"checksum\": \"75c3318429c420817200ec03d670bc6f3452809e01e4582e2c63995fb06b9597\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"retry_failed\": true,\n      \"install_baseline\": true,\n      \"description\": \"新增暂停用户下单，修正指定测试师傅提现冻结流水并兼容 MySQL 5.7 混合排序规则；失败后允许安全重试。师傅后台仅读取 oyAoh 真实 OpenID，并完善更新时间排序、跳页、地址和中文字段。\"\n    },\n    {\n      \"version\": \"2.0.8\",\n      \"name\": \"商家认证、信息隔离与商家订单结算\",\n      \"file\": \"2.0.8.sql\",\n      \"checksum\": \"63561a4be75ee47139e3a2086583711dca6419270a94e658cc6e48736ed3ff13\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"新增营业执照商家认证、行为识别、普通用户与商家订单分流、商家和师傅联系方式互盲、商家独立服务费及师傅商家单收款码审核。\"\n    },\n    {\n      \"version\": \"2.0.9\",\n      \"name\": \"完工水印、实际尾款审批与云存储短信\",\n      \"file\": \"2.0.9.sql\",\n      \"checksum\": \"4affd46de751e2f39c99b9bb73f7c5817b3b9a0bda5f950f3b6070acc7af24eb\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"curl\",\n        \"gd\",\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"新增完工照时间地点水印、实际尾款与凭证审批、师傅官方图片编辑、七牛云存储和阿里云短信可靠通知。\"\n    },\n    {\n      \"version\": \"2.1.0\",\n      \"name\": \"消息分流、HTTP 分类存储与公告管理\",\n      \"file\": \"2.1.0.sql\",\n      \"checksum\": \"8a2747b22d1691b63f2cec00a2f2c3b94a82afebf9dbce568e21cbd295f83a6f\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [\n        \"curl\",\n        \"gd\",\n        \"openssl\"\n      ],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"短信按业务环节独立启停，管理员通知改用企业微信群机器人；七牛使用 HTTP 分类路径并经本站 HTTPS 代理，新增公告、师傅私密资料页和云端列表缓存。\"\n    },\n    {\n      \"version\": \"2.1.1\",\n      \"name\": \"消息对比度、七牛云凭证与师傅地址修复\",\n      \"file\": \"2.1.1.sql\",\n      \"checksum\": \"d3ebf08238af50da3375a82c002f7ef