N `order_source_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'consumer' COMMENT '订单来源类型',\n  MODIFY COLUMN `collection_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'offline' COMMENT '收款方式',\n  MODIFY COLUMN `amount_cents` bigint(20) unsigned NOT NULL COMMENT '金额（分）',\n  MODIFY COLUMN `reason` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '原因',\n  MODIFY COLUMN `evidence_media_ids_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '证据媒体ID列表JSON',\n  MODIFY COLUMN `watermark_metadata_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '水印元数据JSON',\n  MODIFY COLUMN `status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending_confirmation' COMMENT '状态',\n  MODIFY COLUMN `user_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '用户备注',\n  MODIFY COLUMN `dispute_id` bigint(20) unsigned DEFAULT NULL COMMENT '争议ID',\n  MODIFY COLUMN `submitted_at` datetime NOT NULL COMMENT '提交时间',\n  MODIFY COLUMN `decided_at` datetime DEFAULT NULL COMMENT '决定时间',\n  MODIFY COLUMN `paid_at` datetime DEFAULT NULL COMMENT '已支付时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `scheduled_job_claims`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `job_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '任务名称',\n  MODIFY COLUMN `business_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务键',\n  MODIFY COLUMN `business_version` int(10) unsigned NOT NULL DEFAULT '1' COMMENT '业务版本',\n  MODIFY COLUMN `scheduler_run_id` bigint(20) unsigned DEFAULT NULL COMMENT '计划任务运行ID',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'claimed' COMMENT '状态',\n  MODIFY COLUMN `claimed_at` datetime NOT NULL COMMENT '领取时间',\n  MODIFY COLUMN `completed_at` datetime DEFAULT NULL COMMENT '完成时间',\n  MODIFY COLUMN `result_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '结果JSON';\nALTER TABLE `scheduled_job_failures`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `job_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '任务名称',\n  MODIFY COLUMN `business_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务键',\n  MODIFY COLUMN `business_version` int(10) unsigned NOT NULL DEFAULT '1' COMMENT '业务版本',\n  MODIFY COLUMN `scheduler_run_id` bigint(20) unsigned DEFAULT NULL COMMENT '计划任务运行ID',\n  MODIFY COLUMN `attempt_no` int(10) unsigned NOT NULL DEFAULT '1' COMMENT '尝试编号',\n  MODIFY COLUMN `error_class` varchar(191) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '错误类型',\n  MODIFY COLUMN `error_message` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '错误信息',\n  MODIFY COLUMN `next_retry_at` datetime DEFAULT NULL COMMENT '下次重试时间',\n  MODIFY COLUMN `resolved_at` datetime DEFAULT NULL COMMENT '解决时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `scheduler_runs`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `run_uuid` char(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '运行UUID',\n  MODIFY COLUMN `job_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '任务名称',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'running' COMMENT '状态',\n  MODIFY COLUMN `host_name` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '执行主机',\n  MODIFY COLUMN `process_id` int(10) unsigned DEFAULT NULL COMMENT '进程ID',\n  MODIFY COLUMN `scanned_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '扫描数量',\n  MODIFY COLUMN `success_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '成功数量',\n  MODIFY COLUMN `failure_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '失败数量',\n  MODIFY COLUMN `started