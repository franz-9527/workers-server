ssage_type,omitempty\"`\n ItemID ports.ID `json:\"item_id,omitempty\"`\n Ordinal int `json:\"ordinal,omitempty\"`\n Count int `json:\"count,omitempty\"`\n\tID       ports.ID `json:\"message_id,omitempty\"`\n\tSenderID ports.ID `json:\"sender_id,omitempty\"`\n\tState    string   `json:\"state\"`\n\tVersion  ports.ID `json:\"state_version,omitempty\"`\n\tText     *string  `json:\"text,omitempty\"`\n}\n\nfunc nullableID(id ports.ID) any {\n\tif id == \"\" {\n\t\treturn nil\n\t}\n\treturn string(id)\n}\n\nconst retainedTarget = `m.seq>(SELECT sync_floor_seq FROM chat_conversations WHERE id=m.conversation_id) AND m.seq<=(SELECT last_seq FROM chat_conversations WHERE id=m.conversation_id)`\n\n// Called before inspection and again inside the final publication lock. No\n// client snapshot or remembered authorization can authorize a source.\nfunc validateReferences(ctx context.Context, tx *sql.Tx, p ports.Principal, q Request, g ports.Grant) (int, error) {\n\tdepth := 0\n\tfor _, ref := range []struct {\n\t\tid     ports.ID\n\t\tedited bool\n\t}{{q.ReplyTo, false}, {q.EditedFrom, true}} {\n\t\tif ref.id == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tvar state, kind, sender string\n\t\tvar previous int\n\t\terr := tx.QueryRowContext(ctx, `SELECT m.state,m.message_type,CAST(m.sender_id AS CHAR),m.reedit_depth FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn, string(q.ConversationID), string(ref.id), string(g.Version), string(p.ActorID)).Scan(&state, &kind, &sender, &previous)\n\t\tif err == sql.ErrNoRows {\n\t\t\treturn 0, ErrReference\n\t\t}\n\t\tif err != nil {\n\t\t\treturn 0, ports.ErrUnavailable\n\t\t}\n\t\tif ref.edited {\n\t\t\tif state != \"recalled\" || kind != \"text\" || sender != string(p.ActorID) {\n\t\t\t\treturn 0, ErrReference\n\t\t\t}\n\t\t\tif previous >= maxReeditDepth {\n\t\t\t\treturn 0, ErrReeditLimit\n\t\t\t}\n\t\t\tdepth = previous + 1\n\t\t} else if state != \"published\" {\n   return 0, ErrReference\n  }else if q.ReplyItem!=\"\"{\n   if kind!=\"image_album\"&&kind!=\"image\"{return 0,ErrReference}\n   var count int;if tx.QueryRowContext(ctx,`SELECT COUNT(*) FROM chat_image_items WHERE message_id=? AND item_id=?`,string(ref.id),string(q.ReplyItem)).Scan(&count)!=nil||count!=1{return 0,ErrReference}\n  }\n\t}\n\treturn depth, nil\n}\n\n// Hydrates at most 100 distinct targets for one bounded page. No nested\n// references and no recalled/blocked text are selected, even for the author.\nfunc hydrateReferences(ctx context.Context, tx *sql.Tx, p ports.Principal, g ports.Grant, id ports.ID, views []*MessageView) error {\n\tids := map[ports.ID]bool{}\n\tfor _, v := range views {\n\t\tif v.State == \"published\" {\n\t\t\tif v.ReplyTo != \"\" {\n\t\t\t\tids[v.ReplyTo] = true\n\t\t\t}\n\t\t\tif v.EditedFrom != \"\" {\n\t\t\t\tids[v.EditedFrom] = true\n\t\t\t}\n\t\t}\n\t}\n\tif len(ids) == 0 {\n\t\treturn nil\n\t}\n\tif len(ids) > 100 {\n\t\treturn ports.ErrInvalid\n\t}\n\tmarks := make([]string, 0, len(ids))\n\targs := []any{string(g.Version), string(p.ActorID), string(id)}\n\tfor target := range ids {\n\t\tmarks = append(marks, \"?\")\n\t\targs = append(args, string(target))\n\t}\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),m.state,CAST(m.state_version AS CHAR),m.message_type,(SELECT COUNT(*) FROM chat_image_items ci WHERE ci.message_id=m.id),CASE WHEN m.state='published' AND m.message_type='text' THEN LEFT(m.text_body,160) ELSE NULL END,`+visibleColumn+` FROM chat_messages m WHERE m.conversation_id=? AND `+retainedTarget+` AND m.id IN (`+strings.Join(marks, \",\")+`)`, args...)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttype target struct {\n\t\tref     ReferenceView\n\t\tseq     ports.ID\n\t\tvisible bool\n\t}\n\ttargets := map[ports.ID]target{}\n\tfor rows.Next() {\n\t\tvar t target\n\t\tvar text sql.NullString\n\t\tif rows.Scan(&t.ref.ID, &t.seq, &t.ref.SenderID, &t.ref.State, &t.ref.Version,&t.ref.Type,&t.ref.Count, &text, &t.visible) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif t.ref.State==\"published\"&&(t.ref.Type==\"image\"||t.ref.Type==\"image_album\"){value:=\"[图片]\";if t.ref.Type==\"image_album\"{value=\"[图片合集]\"};t.ref.Text=&value}\n if t.ref.State == \"published\" && text.Valid {\n\t\t\ts := text.String\n\t\t\tt.ref.Text = &s\n\t\t}\n\t\ttargets[t.ref.ID] = t\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\titemOrdinals:=map[ports.ID]map[ports.ID]int{}\n itemArgs:=[]any{};for id:=range ids{itemArgs=append(itemArgs,string(id))}\n itemRows,itemErr:=tx.QueryContext(ctx,`SELECT CAST(message_id AS CHAR),CAST(item_id AS CHAR),ordinal FROM chat_image_items WHERE message_id IN (`+strings.Join(marks,\",\")+`)`,itemArgs...)\n if itemErr!=nil{return ports.ErrUnavailable}\n for itemRows.Next(){var mid,item ports.ID;var ordinal int;if itemRows.Scan(&mid,&item,&ordinal)!=nil{itemRows.Close();return ports.ErrUnavailable};if itemOrdinals[mid]==nil{itemOrdinals[mid]=map[ports.ID]int{}};itemOrdinals[mid][item]=ordinal}\n itemErr=itemRows.Err();itemRows.Close();if itemErr!=nil{return ports.ErrUnavailable}\n for _, v := range views {\n  if v.State != \"published\" {\n\t\t\tv.Reply = nil\n\t\t\tv.EditedSource = nil\n\t\t\tcontinue\n\t\t}\n\t\tfor _, slot := range []struct {\n\t\t\tid     ports.ID\n\t\t\tout    **ReferenceView\n\t\t\tedited bool\n\t\t}{{v.ReplyTo, &v.Reply, false}, {v.EditedFrom, &v.EditedSource, true}} {\n\t\t\tif slot.id == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tref := ReferenceView{State: \"unavailable\"}\n\t\t\tt, ok := targets[slot.id]\n\t\t\tif ok && t.visible && number(t.seq) < number(v.Seq) {\n\t\t\t\tref = t.ref\n\t\t\t\tif ref.State != \"published\" {\n\t\t\t\t\tref.Text = nil\n\t\t\t\t}\n\t\t\t\tif ref.State != \"published\" && ref.State != \"recalled\" {\n\t\t\t\t\tref.State = \"unavailable\"\n\t\t\t\t\tref.Text = nil\n\t\t\t\t}\n\t\t\t\tif !slot.edited&&v.ReplyItem!=\"\"&&ref.State==\"published\"{if ordinal,ok:=itemOrdinals[slot.id][v.ReplyItem];ok{ref.ItemID=v.ReplyItem;ref.Ordinal=ordinal}}\n if slot.edited {\n\t\t\t\t\tref.Text = nil\n\t\t\t\t}\n\t\t\t}\n\t\t\t*slot.out = &ref\n\t\t}\n\t}\n\treturn nil\n}\nfunc decodeRecall(raw []byte) (HistoryRequest, error) {\n\tq, e := decodeHistory(raw)\n\tif e != nil {\n\t\treturn q, e\n\t}\n\tvar fields map[string]json.RawMessage\n\tif json.Unmarshal(raw, &fields) != nil || len(fields) != 2 || fields[\"conversation_id\"] == nil || fields[\"message_id\"] == nil || !validID(q.TargetID) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\n\n// Recall uses current READ authority and the conversation commit lock. It\n// never takes the send restriction gate or advances last_seq/read_seq.\nfunc (s *Service) Recall(ctx context.Context, p ports.Principal, id, target ports.ID) (MessageView, error) {\n\tif !validID(id) || !validID(target) {\n\t\treturn MessageView{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn MessageView{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif e != nil {\n\t\treturn MessageView{}, e\n\t}\n\tvar v MessageView\n\tvar allowed bool\n\te = tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),CAST(m.policy_version AS CHAR),m.message_type,m.state,CAST(m.state_version AS CHAR),m.created_at,TIMESTAMPDIFF(MICROSECOND,m.created_at,UTC_TIMESTAMP(6)) BETWEEN 0 AND 120000000 FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn, string(id), string(target), string(g.Version), string(p.ActorID)).Scan(&v.ID, &v.Seq, &v.SenderID, &v.PolicyVersion, &v.Type, &v.State, &v.StateVersion, &v.CreatedAt, &allowed)\n\tif e == sql.ErrNoRows {\n\t\treturn MessageView{}, ErrRecall\n\t}\n\tif e != nil {\n\t\treturn MessageView{}, ports.ErrUnavailable\n\t}\n\tif v.SenderID != p.ActorID || (v.Type != \"text\"&&v.Type!=\"image\"&&v.Type!=\"image_album\") || (v.State != \"published\" && v.State != \"recalled\") {\n\t\treturn MessageView{}, ErrRecall\n\t}\n\tchanged := v.State == \"published\"\n\tif changed {\n\t\tif !allowed {\n\t\t\treturn MessageView{}, ErrRecallWindow\n\t\t}\n\t\tvar change uint64\n\t\tif tx.QueryRowContext(ctx, `SELECT last_change_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&change) != nil || change == ^uint64(0) || number(v.StateVersion) == ^uint64(0) {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tversion := number(v.StateVersion) + 1\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_messages SET state='recalled',state_version=?,recalled_at=UTC_TIMESTAMP(6) WHERE id=? AND conversation_id=?`, version, string(target), string(id)); e != nil {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,?,'message.recalled',UTC_TIMESTAMP(6))`, string(id), change+1, string(target), version); e != nil {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_change_seq=? WHERE id=?`, change+1, string(id)); e != nil {\n\t\t\treturn MessageView{}, ports.ErrUnavailable\n\t\t}\n\t\tv.State = \"recalled\"\n\t\tv.StateVersion = decimal(version)\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn MessageView{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn MessageView{}, ports.ErrUnavailable\n\t}\n\tif changed && s.publisher != nil {\n\t\tevent := ports.CommittedMessage{ConversationID: id, Seq: v.Seq, PolicyVersion: g.Version}\n\t\tif publisher, ok := s.publisher.(interface{ Changed(ports.CommittedMessage) }); ok {\n\t\t\tpublisher.Changed(event)\n\t\t} else {\n\t\t\ts.publisher.Committed(event)\n\t\t}\n\t}\n\treturn v, nil\n}\n","server/app/Infrastructure/Persistence/DatabaseOrderCenterRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Infrastructure\\Persistence;\n\nuse WorkerAdmin\\Contracts\\OrderCenterRepository;\nuse WorkerAdmin\\Core\\Database;\n\nfinal class DatabaseOrderCenterRepository implements OrderCenterRepository\n{\n    private Database $db;\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    // Shared SQL scope for lists and attention counts; no page-size approximation.\n    public static function scope(array $actor, string $kind, string $status, string $keyword = ''): array\n    {\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        $params = ['own_worker_id' => $workerId];\n\n        if ($kind === 'mine') {\n            $where = \"o.user_id=:center_user_id AND o.lifecycle_status<>'archived'\";\n            $params['center_user_id'] = (int)$actor['user_id'];\n        } else {\n            if ($workerId < 1) return ['1=0', []];\n            $where = \"o.lifecycle_status<>'archived' AND (\n                EXISTS(SELECT 1 FROM quotes q0 WHERE q0.order_id=o.id AND q0.worker_id=:center_quote_worker AND q0.status IN ('active','selected'))\n                OR EXISTS(SELECT 1 FROM assignments a0 WHERE a0.order_id=o.id AND a0.worker_id=:center_assignment_worker AND a0.status IN ('offered','accepted'))\n                OR EXISTS(SELECT 1 FROM invite_tokens it0 WHERE it0.order_id=o.id AND it0.claimed_worker_id=:center_invite_worker AND it0.status='claimed')\n                OR (o.assigned_worker_id=:center_refund_worker AND o.refund_status IN ('pending_review','approved','processing','refunding','succeeded'))\n            )\";\n            $params['center_quote_worker'] = $workerId;\n            $params['center_assignment_worker'] = $workerId;\n            $params['center_invite_worker'] = $workerId;\n            $params['center_refund_worker'] = $workerId;\n        }\n\n        $where .= !empty($actor['is_demo_actor']) ? ' AND o.is_demo=1' : ' AND o.is_demo=0';\n        $keyword = trim($keyword);\n        if ($kind === 'mine' && $keyword !== '') {\n            $pattern = '%' . $keyword . '%';\n            // PDO 原生预处理下不复用同名占位符；所有权条件已经在前面固定为当前 user_id。\n            $where .= \" AND (\n                o.public_no LIKE :center_keyword_no\n                OR CONCAT_WS(' ',COALESCE(o.title,''),COALESCE(o.category_names_snapshot,''),COALESCE(o.category_name_snapshot,''),COALESCE(o.district,''),COALESCE(o.address_summary,'')) LIKE :center_keyword_text\n            )\";\n            $params['center_keyword_no'] = $pattern;\n            $params['center_keyword_text'] = $pattern;\n        }\n        $activeRepairSql = \"EXISTS(SELECT 1 FROM after_sales ar_active WHERE ar_active.order_id=o.id AND ar_active.type='warranty_repair' AND ar_active.status IN ('open','processing'))\";\n        $pricingAwaitingCustomerSql = \"o.order_source_type='platform'\n            AND EXISTS(SELECT 1 FROM order_events pre WHERE pre.order_id=o.id AND pre.event_type='platform_measurement_pricing_reviewed')\n            AND NOT EXISTS(SELECT 1 FROM order_events pce WHERE pce.order_id=o.id AND pce.event_type='platform_measurement_pricing_confirmed')\";\n        $constructionAppointmentTodoSql = \"o.order_source_type='platform'\n            AND o.workflow_profile='construction'\n            AND o.fulfillment_status='not_started'\n            AND EXISTS(SELECT 1 FROM order_events prc WHERE prc.order_id=o.id AND prc.event_type='platform_measurement_pricing_reviewed')\n            AND EXISTS(SELECT 1 FROM order_events pcc WHERE pcc.order_id=o.id AND pcc.event_type='platform_measurement_pricing_confirmed')\n            AND NOT EXISTS(SELECT 1 FROM appointment_records pac WHERE pac.order_id=o.id AND pac.context_type='service')\";\n\n        if ($status === 'todo') {\n            if ($kind === 'mine') {\n                $where .= \" AND o.lifecycle_status='active' AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND (\n                    o.audit_status='supplement_required'\n                    OR (o.audit_status='draft' AND o.payment_status='awaiting_payment')\n                    OR ({$pricingAwaitingCustomerSql})\n                    OR (o.fulfillment_status='submitted' AND o.dispute_status NOT IN ('open','processing'))\n                    OR (o.audit_status='approved' AND o.selected_quote_id IS NULL AND EXISTS(SELECT 1 FROM quotes qt WHERE qt.order_id=o.id AND qt.status='active'))\n                    OR EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')))\n                    OR EXISTS(SELECT 1 FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment'))\n                )\";\n            } else {\n                $where .= \" AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND (\n                    (o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL AND EXISTS(\n                        SELECT 1 FROM assignments atodo WHERE atodo.id=o.current_assignment_id AND atodo.worker_id=:todo_worker AND atodo.status='offered'\n                    ))\n                    OR (o.lifecycle_status='active' AND o.assigned_worker_id=:todo_construction_worker AND o.assignment_status='accepted' AND ({$constructionAppointmentTodoSql}))\n                    OR (o.lifecycle_status='active' AND o.order_source_type='platform' AND o.dispatch_mode='multi_quote'\n                        AND o.selected_quote_id IS NULL\n                        AND EXISTS(SELECT 1 FROM invite_tokens ittodo WHERE ittodo.order_id=o.id AND ittodo.claimed_worker_id=:todo_invite_worker AND ittodo.status='claimed')\n                        AND NOT EXISTS(SELECT 1 FROM quotes qtodo WHERE qtodo.order_id=o.id AND qtodo.worker_id=:todo_quote_worker AND qtodo.status IN ('active','selected'))\n                    )\n                    OR (o.assigned_worker_id=:todo_repair_worker AND EXISTS(\n                        SELECT 1 FROM after_sales astodo WHERE astodo.order_id=o.id AND astodo.type='warranty_repair'\n                        AND (astodo.status='open' OR (astodo.status='processing' AND (astodo.resolution IS NULL OR (astodo.resolution NOT LIKE '师傅拒绝维修%' AND astodo.resolution NOT LIKE '用户申请平台介入%'))))\n                    ))\n                )\";\n                $params['todo_worker'] = $workerId;\n                $params['todo_construction_worker'] = $workerId;\n                $params['todo_invite_worker'] = $workerId;\n                $params['todo_quote_worker'] = $workerId;\n                $params['todo_repair_worker'] = $workerId;\n            }\n        } elseif ($status === 'supplement') {\n            $where .= $kind === 'mine'\n                ? \" AND o.audit_status='supplement_required' AND o.lifecycle_status='active'\"\n                : ' AND 1=0';\n        } elseif ($status === 'quoting') {\n            $where .= $kind === 'mine'\n                ? \" AND o.audit_status='approved' AND o.lifecycle_status='active' AND o.selected_quote_id IS NULL AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\"\n                : \" AND o.lifecycle_status='active' AND o.assignment_status<>'accepted' AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\";\n        } elseif ($status === 'progress') {\n            if ($kind === 'mine') {\n                $where .= \" AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND ((o.lifecycle_status='active' AND o.selected_quote_id IS NOT NULL AND o.fulfillment_status<>'accepted') OR {$activeRepairSql})\";\n            } else {\n                $where .= \" AND o.assigned_worker_id=:progress_worker AND o.refund_status NOT IN ('pending_review','approved','processing','refunding') AND ((o.assignment_status='accepted' AND o.lifecycle_status='active' AND o.fulfillment_status<>'accepted') OR {$activeRepairSql})\";\n                $params['progress_worker'] = $workerId;\n            }\n        } elseif ($status === 'completed') {\n            if ($kind === 'mine') {\n                $where .= \" AND (o.fulfillment_status='accepted' OR o.lifecycle_status='completed') AND NOT {$activeRepairSql}\";\n            } else {\n                $where .= \" AND o.assigned_worker_id=:completed_worker AND (o.fulfillment_status='accepted' OR o.lifecycle_status='completed') AND NOT {$activeRepairSql}\";\n                $params['completed_worker'] = $workerId;\n            }\n        } elseif ($status === 'refunding') {\n            $where .= \" AND (o.refund_status IN ('pending_review','approved','processing','refunding') OR o.lifecycle_status='cancel_approved_pending_refund')\";\n        }\n\n        return [$where,$params];\n    }\n\n    public function page(array $actor, string $kind, string $status, int $page, int $limit, string $keyword = ''): array\n    {\n        $page = max(1, $page);\n        $limit = max(1, min(50, $limit));\n        $offset = ($page - 1) * $limit;\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        if ($kind !== 'mine' && $workerId < 1) return ['rows'=>[], 'has_more'=>false];\n        [$where,$params] = self::scope($actor,$kind,$status,$keyword);\n        $params['invite_worker_flag'] = $workerId;\n        $params['invite_worker_lookup'] = $workerId;\n        $params['invite_token_worker_lookup'] = $workerId;\n        $params['invite_quote_worker_lookup'] = $workerId;\n        $sql = \"SELECT o.*,\n                    (SELECT COUNT(*) FROM quotes q WHERE q.order_id=o.id AND q.status IN ('active','selected')) quote_count,\n                    (SELECT q.amount_cents FROM quotes q WHERE q.order_id=o.id AND q.worker_id=:own_worker_id ORDER BY q.id DESC LIMIT 1) own_quote_cents,\n                    (SELECT mf.public_id FROM media_links ml JOIN media_files mf ON mf.id=ml.media_file_id AND mf.status='active'\n                     WHERE ml.entity_type='order' AND ml.entity_id=o.id\n                     ORDER BY FIELD(ml.purpose,'product','wall','completion','before_optional'),ml.sort_order,ml.id LIMIT 1) cover_media_id,\n                    (SELECT c.public_id FROM change_requests c WHERE c.order_id=o.id AND c.status='pending' ORDER BY c.id DESC LIMIT 1) pending_change_id,\n                    (SELECT rc.status FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment') ORDER BY rc.id DESC LIMIT 1) pending_run_empty_status,\n                    (SELECT COUNT(*) FROM after_sales ast WHERE ast.order_id=o.id AND ast.type='warranty_repair' AND (ast.status='open' OR (ast.status='processing' AND (ast.resolution IS NULL OR (ast.resolution NOT LIKE '师傅拒绝维修%' AND ast.resolution NOT LIKE '用户申请平台介入%'))))) pending_repair_count,\n                    (SELECT ast2.status FROM after_sales ast2 WHERE ast2.order_id=o.id AND ast2.type='warranty_repair' AND ast2.status IN ('open','processing') ORDER BY ast2.id DESC LIMIT 1) active_repair_status,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr WHERE pr.order_id=o.id AND pr.event_type='platform_measurement_pricing_reviewed')\n                        THEN 1 ELSE 0 END platform_pricing_reviewed,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr2 WHERE pr2.order_id=o.id AND pr2.event_type='platform_measurement_pricing_reviewed')\n                        AND NOT EXISTS(SELECT 1 FROM order_events pc2 WHERE pc2.order_id=o.id AND pc2.event_type='platform_measurement_pricing_confirmed')\n                        THEN 1 ELSE 0 END platform_pricing_confirmation_pending,\n                    CASE WHEN o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pc3 WHERE pc3.order_id=o.id AND pc3.event_type='platform_measurement_pricing_confirmed')\n                        THEN 1 ELSE 0 END platform_pricing_confirmed,\n                    CASE WHEN EXISTS(SELECT 1 FROM appointment_records pas WHERE pas.order_id=o.id AND pas.context_type='service')\n                        THEN 1 ELSE 0 END service_appointment_exists,\n                    CASE WHEN :invite_worker_flag>0 AND (\n                        EXISTS(SELECT 1 FROM assignments ai WHERE ai.order_id=o.id AND ai.worker_id=:invite_worker_lookup AND ai.assignment_type='invite')\n                        OR EXISTS(SELECT 1 FROM invite_tokens iti WHERE iti.order_id=o.id AND iti.claimed_worker_id=:invite_token_worker_lookup AND iti.status='claimed')\n                    ) THEN 1 ELSE 0 END is_invited,\n                    CASE WHEN o.order_source_type='platform' AND o.dispatch_mode='multi_quote' AND o.selected_quote_id IS NULL\n                        AND EXISTS(SELECT 1 FROM invite_tokens itr WHERE itr.order_id=o.id AND itr.claimed_worker_id=:invite_token_worker_lookup2 AND itr.status='claimed')\n                        AND NOT EXISTS(SELECT 1 FROM quotes qir WHERE qir.order_id=o.id AND qir.worker_id=:invite_quote_worker_lookup AND qir.status IN ('active','selected'))\n                        THEN 1 ELSE 0 END invite_requires_quote\n                FROM orders o WHERE {$where}\n                ORDER BY o.updated_at DESC,o.id DESC\n                LIMIT \" . ($limit + 1) . ' OFFSET ' . $offset;\n        $params['invite_token_worker_lookup2'] = $workerId;\n        $rows = $this->db->fetchAll($sql, $params);\n        $hasMore = count($rows) > $limit;\n        if ($hasMore) $rows = array_slice($rows, 0, $limit);\n        return ['rows' => $rows, 'has_more' => $hasMore];\n    }\n\n    public function supplementCount(array $actor, string $kind): int\n    {\n        if ($kind !== 'mine') return 0;\n        return (int)$this->db->fetchValue(\n            \"SELECT COUNT(*) FROM orders WHERE user_id=:user_id AND audit_status='supplement_required' AND lifecycle_status='active'\",\n            ['user_id' => (int)$actor['user_id']]\n        );\n    }\n\n    public function todoCount(array $actor, string $kind): int\n    {\n        if ($kind === 'mine') {\n            return (int)$this->db->fetchValue(\n                \"SELECT COUNT(*) FROM orders o\n                 WHERE o.user_id=:user_id AND o.lifecycle_status='active'\n                   AND o.refund_status NOT IN ('pending_review','approved','processing','refunding')\n                   AND (\n                     o.audit_status='supplement_required'\n                     OR (o.audit_status='draft' AND o.payment_status='awaiting_payment')\n                     OR (o.order_source_type='platform'\n                        AND EXISTS(SELECT 1 FROM order_events pr WHERE pr.order_id=o.id AND pr.event_type='platform_measurement_pricing_reviewed')\n                        AND NOT EXISTS(SELECT 1 FROM order_events pc WHERE pc.order_id=o.id AND pc.event_type='platform_measurement_pricing_confirmed'))\n                     OR (o.fulfillment_status='submitted' AND o.dispute_status NOT IN ('open','processing'))\n                     OR (o.audit_status='approved' AND o.selected_quote_id IS NULL AND EXISTS(SELECT 1 FROM quotes q WHERE q.order_id=o.id AND q.status='active'))\n                     OR EXISTS(SELECT 1 FROM change_requests c WHERE c.order_id=o.id AND (c.status='pending' OR (c.status='accepted' AND c.payment_status='awaiting_payment')))\n                     OR EXISTS(SELECT 1 FROM run_empty_fee_claims rc WHERE rc.order_id=o.id AND rc.status IN ('pending_confirmation','awaiting_payment'))\n                   )\",\n                ['user_id' => (int)$actor['user_id']]\n            );\n        }\n        $workerId = (int)($actor['worker_id'] ?? 0);\n        if ($workerId < 1) return 0;\n        return (int)$this->db->fetchValue(\n            \"SELECT COUNT(*) FROM orders o\n             WHERE o.refund_status NOT IN ('pending_review','approved','processing','refunding')\n               AND (\n                 (o.lifecycle_status='active' AND o.current_assignment_id IS NOT NULL AND EXISTS(\n                    SELECT 1 FROM assignments atc WHERE atc.id=o.current_assignment_id AND atc.worker_id=:worker_id AND atc.status='offered'\n                 ))\n                 OR (o.lifecycle_status='active' AND o.assigned_worker_id=:construction_worker_id AND o.assignment_status='accepted'\n                    AND o.order_source_type='platform' AND o.workflow_profile='construction' AND o.fulfillment_status='not_started'\n                    AND EXISTS(SELECT 1 FROM order_events prc WHERE prc.order_id=o.id AND prc.event_type='platform_measurement_pricing_reviewed')\n                    AND EXISTS(SELECT 1 FROM order_events pcc WHERE pcc.order_id=o.id AND pcc.event_type='platform_measurement_pricing_confirmed')\n                    AND NOT EXISTS(SELECT 1 FROM appointment_records pac WHERE pac.order_id=o.id AND pac.context_type='service'))\n                 OR (o.lifecycle_status='active' AND o.order_source_type='platform' AND o.dispatch_mode='multi_quote'\n                    AND o.selected_quote_id IS NULL\n                    AND EXISTS(SELECT 1 FROM invite_tokens itc WHERE itc.order_id=o.id AND itc.claimed_worker_id=:invite_worker_id AND itc.status='claimed')\n                    AND NOT EXISTS(SELECT 1 FROM quotes qic WHERE qic.order_id=o.id AND qic.worker_id=:quote_worker_id AND qic.status IN ('active','selected'))\n                 )\n                 OR (o.assigned_worker_id=:repair_worker_id AND EXISTS(\n                    SELECT 1 FROM after_sales ascnt WHERE ascnt.order_id=o.id AND ascnt.type='warranty_repair'\n                    AND (ascnt.status='open' OR (ascnt.status='processing' AND (ascnt.resolution IS NULL OR (ascnt.resolution NOT LIKE '师傅拒绝维修%' AND ascnt.resolution NOT LIKE '用户申请平台介入%'))))\n                 ))\n               )\",\n            [\n                'worker_id' => $workerId,\n                'construction_worker_id' => $workerId,\n                'invite_worker_id' => $workerId,\n                'quote_worker_id' => $workerId,\n                'repair_worker_id' => $workerId,\n            ]\n        );\n    }\n}","server/app/Contracts/OrderCenterRepository.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface OrderCenterRepository\n{\n    /**\n     * @param array<string,mixed> $actor\n     * @return array{rows:array<int,array<string,mixed>>,has_more:bool}\n     */\n    public function page(array $actor, string $kind, string $status, int $page, int $limit, string $keyword = ''): array;\n\n    /** @param array<string,mixed> $actor */\n    public function supplementCount(array $actor, string $kind): int;\n\n    /** @param array<string,mixed> $actor */\n    public function todoCount(array $actor, string $kind): int;\n}\n","chat/internal/message/media.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrMedia = errors.New(\"CHAT_MEDIA_UNAVAILABLE\")\nvar ErrMediaVersion = errors.New(\"CHAT_MEDIA_VERSION_CONFLICT\")\n\nconst ImageRule = \"images-manual-v1\"\nconst MediaTTL = time.Hour\nconst MaxImageBytes = 8 << 20\nconst MaxImagePixels = 20000000\n\n// Storage keys are generated here, never supplied by a caller or callback.\ntype UploadGrant struct {\n\tAttachmentID  ports.ID `json:\"attachment_id\"`\n\tObjectVersion string   `json:\"object_version\"`\n\tKey           string   `json:\"key\"`\n\tToken         string   `json:\"token\"`\n\tHost          string   `json:\"host\"`\n\tExpiresAt     int64    `json:\"expires_at\"`\n\tState         string   `json:\"state\"`\n}\ntype ImageStorage interface {\n\tGrant(context.Context, string, int64) (string, string, error)\n\tRead(context.Context, string, int64) ([]byte, error)\n\tPut(context.Context, string, []byte, string) error\n\tSign(context.Context, string, time.Duration) (string, error)\n\tDelete(context.Context, string) error\n}\ntype ProcessedImage struct {\n\tMain, Thumb                                              []byte\n\tMIME, Method, QRStatus, QRDecision, QRVersion, OCRStatus string\n\tWidth, Height                                            int\n}\ntype ImageProcessor interface {\n\tProcess(context.Context, []byte) (ProcessedImage, error)\n}\ntype MediaItem struct {\n\tAttachmentID  ports.ID `json:\"attachment_id\"`\n\tObjectVersion string   `json:\"object_version\"`\n\tOrdinal       int      `json:\"ordinal\"`\n\tItemID        ports.ID `json:\"item_id,omitempty\"`\n}\ntype ImageView struct {\n\tItemID  ports.ID `json:\"item_id\"`\n\tOrdinal int      `json:\"ordinal\"`\n\tWidth   int      `json:\"width\"`\n\tHeight  int      `json:\"height\"`\n}\ntype MediaStatus struct {\n\tResult\n\tRevision     int               `json:\"revision\"`\n\tManifestHash string            `json:\"manifest_hash\"`\n\tItems        []MediaItemStatus `json:\"items\"`\n\tExpiresAt    time.Time         `json:\"expires_at\"`\n}\ntype MediaItemStatus struct {\n\tMediaItem\n\tState string `json:\"state\"`\n\tCode  string `json:\"code,omitempty\"`\n}\ntype MediaService struct {\n\tbase        *Service\n\tstorage     ImageStorage\n\tprocessor   ImageProcessor\n\tenvironment string\n}\n\nfunc NewMediaService(base *Service, storage ImageStorage, processor ImageProcessor, env string) (*MediaService, error) {\n\tif base == nil || storage == nil || processor == nil || (env != \"test\" && env != \"development\" && env != \"production\") {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &MediaService{base, storage, processor, env}, nil\n}\nfunc (s *Service) WithMedia(m *MediaService) *Service { copy := *s; copy.media = m; return &copy }\nfunc randomMedia() string {\n\tvar b [32]byte\n\tif _, e := rand.Read(b[:]); e != nil {\n\t\treturn \"\"\n\t}\n\treturn hex.EncodeToString(b[:])\n}\nfunc mediaHash(b []byte) string { v := sha256.Sum256(b); return hex.EncodeToString(v[:]) }\nfunc mediaFingerprint(q Request) (string, error) {\n\tif !validID(q.ConversationID) || !validClient(q.ClientMessageID) || q.Text != \"\" || q.EditedFrom != \"\" || q.Revision < 1 || q.Revision > 10000 || len(q.Items) < 1 || len(q.Items) > 9 ||\n\t\t(len(q.Items) == 1 && q.MessageType != \"image\") || (len(q.Items) > 1 && q.MessageType != \"image_album\") || q.ReplyTo != \"\" && !validID(q.ReplyTo) || q.ReplyItem != \"\" && (!validID(q.ReplyItem) || q.ReplyTo == \"\") {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tseen := map[ports.ID]bool{}\n\tfor i, v := range q.Items {\n\t\tif !validID(v.AttachmentID) || len(v.ObjectVersion) != 64 || v.Ordinal != i || v.ItemID != \"\" || seen[v.AttachmentID] {\n\t\t\treturn \"\", ports.ErrInvalid\n\t\t}\n\t\tif _, e := hex.DecodeString(v.ObjectVersion); e != nil {\n\t\t\treturn \"\", ports.ErrInvalid\n\t\t}\n\t\tseen[v.AttachmentID] = true\n\t}\n\tb, err := json.Marshal(struct {\n\t\tSchema    int\n\t\tType      string\n\t\tRevision  int\n\t\tItems     []MediaItem\n\t\tReply     ports.ID `json:\"reply,omitempty\"`\n\t\tReplyItem ports.ID `json:\"reply_item,omitempty\"`\n\t}{3, q.MessageType, q.Revision, q.Items, q.ReplyTo, q.ReplyItem})\n\tif err != nil {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\treturn mediaHash(b), nil\n}\n\n// Allocation is idempotent by a timestamped upload action. No allocation or\n// upload implies a send. Per-actor quota is serialized by the restriction row.\nfunc (m *MediaService) Upload(ctx context.Context, p ports.Principal, cid ports.ID, uploadID string, size int64) (UploadGrant, error) {\n\tif !validID(cid) || !validClient(uploadID) || !active(uploadID, time.Now()) || size < 1 || size > MaxImageBytes {\n\t\treturn UploadGrant{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn UploadGrant{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.authorize(ctx, tx, p, cid); e != nil {\n\t\treturn UploadGrant{}, e\n\t}\n\tvar id ports.ID\n\tvar version, key string\n\tvar declared int64\n\tvar live bool\n\tvar state string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),object_version,source_key,declared_bytes,state,expires_at>UTC_TIMESTAMP(6) FROM chat_image_uploads WHERE actor_id=? AND conversation_id=? AND upload_id=? FOR UPDATE`, string(p.ActorID), string(cid), uploadID).Scan(&id, &version, &key, &declared, &state, &live)\n\tif e == sql.ErrNoRows {\n\t\tvar count int\n\t\tvar bytes int64\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*),COALESCE(SUM(declared_bytes),0) FROM chat_image_uploads WHERE actor_id=? AND expires_at>UTC_TIMESTAMP(6)`, string(p.ActorID)).Scan(&count, &bytes) != nil {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tif count >= 18 || bytes+size > 72<<20 {\n\t\t\treturn UploadGrant{}, ports.ErrBusy\n\t\t}\n\t\tversion = randomMedia()\n\t\tif version == \"\" {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tkey = \"chat/\" + m.environment + \"/\" + string(p.ActorID) + \"/\" + version + \"/source\"\n\t\tres, err := tx.ExecContext(ctx, `INSERT INTO chat_image_uploads(actor_id,conversation_id,upload_id,object_version,source_key,declared_bytes,state,expires_at,created_at) VALUES(?,?,?,?,?,?,'uploading',?,UTC_TIMESTAMP(6))`, string(p.ActorID), string(cid), uploadID, version, key, size, expires(uploadID))\n\t\tif err != nil {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tn, err := res.LastInsertId()\n\t\tif err != nil {\n\t\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t\t}\n\t\tid = ports.ID(fmt.Sprint(n))\n\t} else if e != nil {\n\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t} else if !live {\n\t\treturn UploadGrant{}, ErrExpired\n\t} else if declared != size {\n\t\treturn UploadGrant{}, ErrConflict\n\t}\n\tif tx.Commit() != nil {\n\t\treturn UploadGrant{}, ports.ErrUnavailable\n\t}\n\tif state == \"processed\" || state == \"blocked\" {\n\t\treturn UploadGrant{AttachmentID: id, ObjectVersion: version, State: state}, nil\n\t}\n\ttoken, host, e := m.storage.Grant(ctx, key, size)\n\tif e != nil {\n\t\treturn UploadGrant{}, ErrMedia\n\t}\n\treturn UploadGrant{AttachmentID: id, ObjectVersion: version, Key: key, Token: token, Host: host, ExpiresAt: time.Now().Add(5 * time.Minute).Unix(), State: \"uploading\"}, nil\n}\nfunc (m *MediaService) Uploaded(ctx context.Context, p ports.Principal, cid, id ports.ID) (MediaItemStatus, error) {\n\tif !validID(cid) || !validID(id) {\n\t\treturn MediaItemStatus{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaItemStatus{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.authorize(ctx, tx, p, cid); e != nil {\n\t\treturn MediaItemStatus{}, e\n\t}\n\tvar v MediaItemStatus\n\tv.AttachmentID = id\n\tvar live bool\n\tvar attempts int\n\te = tx.QueryRowContext(ctx, `SELECT object_version,state,expires_at>UTC_TIMESTAMP(6),attempts FROM chat_image_uploads WHERE id=? AND actor_id=? AND conversation_id=? FOR UPDATE`, string(id), string(p.ActorID), string(cid)).Scan(&v.ObjectVersion, &v.State, &live, &attempts)\n\tif e != nil {\n\t\treturn v, ErrMedia\n\t}\n\tif !live {\n\t\treturn v, ErrExpired\n\t}\n\tif v.State == \"uploading\" || v.State == \"check_unavailable\" {\n\t\tif attempts >= 8 {\n\t\t\treturn v, ErrCheck\n\t\t}\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET state='queued',error_code=NULL WHERE id=?`, string(id)); e != nil {\n\t\t\treturn v, ports.ErrUnavailable\n\t\t}\n\t\tv.State = \"queued\"\n\t}\n\tif tx.Commit() != nil {\n\t\treturn v, ports.ErrUnavailable\n\t}\n\treturn v, nil\n}\nfunc (m *MediaService) Send(ctx context.Context, p ports.Principal, q Request) (Result, error) {\n\tfp, e := mediaFingerprint(q)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Same source ID cannot collide with a text action, even after ban or expiry.\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"}); e != nil {\n\t\treturn Result{}, e\n\t}\n\told, e := m.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif old != nil {\n\t\tif old.result.State == \"canceled\" {\n\t\t\tif tx.Commit() != nil {\n\t\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t\t}\n\t\t\treturn old.result, nil\n\t\t}\n\t\tif old.fingerprint != fp {\n\t\t\treturn Result{}, ErrConflict\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn old.result, nil\n\t}\n\ttx.Rollback()\n\tif !active(q.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\ttx, e = m.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := m.base.authorize(ctx, tx, p, q.ConversationID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\told, e = m.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif old != nil {\n\t\tif old.fingerprint != fp {\n\t\t\treturn Result{}, ErrConflict\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn old.result, nil\n\t}\n\tif _, e = validateReferences(ctx, tx, p, q, g); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar pending int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_send_intents WHERE sender_id=? AND state IN ('checking','review_pending','retryable') AND action_expires_at>UTC_TIMESTAMP(6)`, string(p.ActorID)).Scan(&pending) != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif pending >= 4 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tearliest := time.Now().UTC().Add(MediaTTL)\n\tfor _, v := range q.Items {\n\t\tvar version, state string\n\t\tvar live bool\n\t\tvar expiry time.Time\n\t\te = tx.QueryRowContext(ctx, `SELECT object_version,state,expires_at>UTC_TIMESTAMP(6),expires_at FROM chat_image_uploads WHERE id=? AND actor_id=? AND conversation_id=? LOCK IN SHARE MODE`, string(v.AttachmentID), string(p.ActorID), string(q.ConversationID)).Scan(&version, &state, &live, &expiry)\n\t\tif e != nil || !live || version != v.ObjectVersion {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t\tif state == \"blocked\" {\n\t\t\treturn Result{}, ErrBlocked\n\t\t}\n\t\tif expiry.Before(earliest) {\n\t\t\tearliest = expiry\n\t\t}\n\t}\n\tdeadline := earliest\n\tif end := expires(q.ClientMessageID); end.Before(deadline) {\n\t\tdeadline = end\n\t}\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,action_expires_at,retain_until,created_at,updated_at) VALUES(?,?,?,?,'checking',?,?,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(q.ConversationID), q.ClientMessageID, fp, deadline, expires(q.ClientMessageID).Add(MinimumRetention))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tn, e := res.LastInsertId()\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tprincipal, _ := json.Marshal(p)\n\tmanifest, _ := json.Marshal(q)\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_image_bundles(intent_id,principal_json,manifest_json,manifest_hash,revision,rule_version,review_state,review_version,submitted_at,expires_at) VALUES(?,?,?,?,?,?,'waiting',1,UTC_TIMESTAMP(6),?)`, n, string(principal), string(manifest), fp, q.Revision, ImageRule, deadline)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\treturn Result{ClientMessageID: q.ClientMessageID, State: \"checking\"}, nil\n}\n","chat/internal/message/media_worker.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Run is sequential: one image/helper at a time, including retries. Deployers\n// must run one worker until a global resource limiter is introduced.\nfunc (m *MediaService) Run(ctx context.Context) {\n\ttick := time.NewTicker(time.Second)\n\tdefer tick.Stop()\n\tfor {\n\t\tif ctx.Err() != nil {\n\t\t\treturn\n\t\t}\n\t\t_ = m.ProcessOne(ctx)\n\t\t_ = m.Advance(ctx)\n\t\t_ = m.CleanOne(ctx)\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t}\n\t}\n}\nfunc (m *MediaService) ProcessOne(ctx context.Context) error {\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tvar id ports.ID\n\tvar key, version string\n\tvar size int64\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),source_key,object_version,declared_bytes FROM chat_image_uploads WHERE (state='queued' OR state='checking' AND lease_until<UTC_TIMESTAMP(6)) AND attempts<8 AND expires_at>UTC_TIMESTAMP(6) ORDER BY id LIMIT 1 FOR UPDATE`).Scan(&id, &key, &version, &size)\n\tif e == sql.ErrNoRows {\n\t\treturn nil\n\t}\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\towner := randomMedia()\n\tif owner == \"\" {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET state='checking',lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 90 SECOND,attempts=attempts+1 WHERE id=?`, owner, string(id)); e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\twork, cancel := context.WithTimeout(ctx, 60*time.Second)\n\tdefer cancel()\n\traw, e := m.storage.Read(work, key, MaxImageBytes)\n\tvar out ProcessedImage\n\tif e == nil && int64(len(raw)) != size {\n\t\te = ErrMedia\n\t}\n\tif e == nil {\n\t\tout, e = m.processor.Process(work, raw)\n\t}\n\tif e != nil {\n\t\treturn m.imageFailure(ctx, id, owner)\n\t}\n\tif len(out.Main) == 0 || len(out.Thumb) == 0 || len(out.Main) > MaxImageBytes || len(out.Thumb) > 1<<20 || out.Width < 1 || out.Height < 1 || int64(out.Width)*int64(out.Height) > MaxImagePixels ||\n\t\t(out.MIME != \"image/jpeg\" && out.MIME != \"image/png\" && out.MIME != \"image/webp\") ||\n\t\t(out.QRStatus != \"completed\" && out.QRStatus != \"unavailable\") || (out.QRDecision != \"clear\" && out.QRDecision != \"review\" && out.QRDecision != \"blocked\") ||\n\t\t(out.OCRStatus != \"not_run\" && out.OCRStatus != \"unavailable\") || !rulePattern.MatchString(out.QRVersion) || !rulePattern.MatchString(out.Method) {\n\t\treturn m.imageFailure(ctx, id, owner)\n\t}\n\tmainHash, thumbHash := mediaHash(out.Main), mediaHash(out.Thumb)\n\tprefix := key[:len(key)-len(\"source\")]\n\tmainKey, thumbKey := prefix+mainHash+\"/main\", prefix+thumbHash+\"/thumb\"\n\tfor _, v := range []struct{ key, hash string }{{mainKey, mainHash}, {thumbKey, thumbHash}} {\n\t\tif _, e = m.base.db.ExecContext(ctx, `INSERT INTO chat_image_objects(object_key,upload_id,sha256,created_at) VALUES(?,?,?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE object_key=object_key`, v.key, string(id), v.hash); e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\tif e = m.storage.Put(work, mainKey, out.Main, out.MIME); e == nil {\n\t\te = m.storage.Put(work, thumbKey, out.Thumb, \"image/jpeg\")\n\t}\n\tif e != nil {\n\t\treturn m.imageFailure(ctx, id, owner)\n\t}\n\tstate := \"processed\"\n\tif out.QRDecision == \"blocked\" {\n\t\tstate = \"blocked\"\n\t}\n\tres, e := m.base.db.ExecContext(ctx, `UPDATE chat_image_uploads SET state=?,source_sha256=?,main_key=?,thumb_key=?,main_sha256=?,thumb_sha256=?,mime_type=?,width_px=?,height_px=?,method=?,qr_status=?,qr_version=?,anti_diversion_result=?,optional_ocr_status=?,rule_version=?,lease_owner=NULL,lease_until=NULL,error_code=NULL WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6)`, state, mediaHash(raw), mainKey, thumbKey, mainHash, thumbHash, out.MIME, out.Width, out.Height, out.Method, out.QRStatus, out.QRVersion, out.QRDecision, out.OCRStatus, ImageRule, string(id), owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := res.RowsAffected()\n\tif n != 1 {\n\t\treturn ports.ErrBusy\n\t}\n\t// Source is temporary; only tested delivery artifacts are available to readers.\n\tif m.storage.Delete(ctx, key) == nil {\n\t\t_, _ = m.base.db.ExecContext(ctx, `UPDATE chat_image_uploads SET source_cleaned=1 WHERE id=?`, string(id))\n\t}\n\treturn nil\n}\nfunc (m *MediaService) imageFailure(ctx context.Context, id ports.ID, owner string) error {\n\t_, e := m.base.db.ExecContext(ctx, `UPDATE chat_image_uploads SET state='check_unavailable',error_code='CHAT_CHECK_UNAVAILABLE',lease_owner=NULL,lease_until=NULL WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, string(id), owner)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn ErrCheck\n}\n\n// Advance never creates messages. Manual mode requires full-image general\n// safety AND ordered group anti-diversion review, even when QR found nothing.\nfunc (m *MediaService) Advance(ctx context.Context) error {\n\trows, e := m.base.db.QueryContext(ctx, `SELECT CAST(b.intent_id AS CHAR) FROM chat_image_bundles b JOIN chat_send_intents i ON i.id=b.intent_id WHERE i.state IN ('checking','review_pending','retryable') ORDER BY b.intent_id LIMIT 20`)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tif err := m.advanceOne(ctx, id); err != nil && err != ErrMedia && err != ErrCheck && err != policy.ErrDenied && err != ErrRestricted && err != ErrExpired {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\nfunc (m *MediaService) advanceOne(ctx context.Context, id ports.ID) error {\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn e\n\t}\n\tdefer tx.Rollback()\n\tvar raw, review, rule, state string\n\tvar live bool\n\tif tx.QueryRowContext(ctx, `SELECT state FROM chat_send_intents WHERE id=? FOR UPDATE`, string(id)).Scan(&state) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\te = tx.QueryRowContext(ctx, `SELECT b.manifest_json,b.review_state,b.rule_version,i.state,b.expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles b JOIN chat_send_intents i ON i.id=b.intent_id WHERE b.intent_id=? FOR UPDATE`, string(id)).Scan(&raw, &review, &rule, &state, &live)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif state == \"accepted\" || state == \"rejected\" || state == \"canceled\" {\n\t\treturn nil\n\t}\n\tvar q Request\n\tif json.Unmarshal([]byte(raw), &q) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tnext, code := \"checking\", \"\"\n\tif review == \"rejected\" {\n\t\tnext, code = \"rejected\", ErrBlocked.Error()\n\t} else if !live {\n\t\tnext, code = \"rejected\", ErrExpired.Error()\n\t} else if rule != ImageRule {\n\t\tnext, code = \"rejected\", ErrMediaVersion.Error()\n\t} else {\n\t\tready := true\n\t\tfor _, v := range q.Items {\n\t\t\tvar st, rv string\n\t\t\tif tx.QueryRowContext(ctx, `SELECT state,COALESCE(rule_version,'') FROM chat_image_uploads WHERE id=? AND object_version=?`, string(v.AttachmentID), v.ObjectVersion).Scan(&st, &rv) != nil {\n\t\t\t\treturn ErrMedia\n\t\t\t}\n\t\t\tif st == \"blocked\" {\n\t\t\t\tnext, code = \"rejected\", ErrBlocked.Error()\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif st == \"check_unavailable\" {\n\t\t\t\tnext, code = \"retryable\", ErrCheck.Error()\n\t\t\t\tready = false\n\t\t\t}\n\t\t\tif st != \"processed\" || rv != ImageRule {\n\t\t\t\tready = false\n\t\t\t}\n\t\t}\n\t\tif ready {\n\t\t\tnext = \"review_pending\"\n\t\t\tif review == \"waiting\" {\n\t\t\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_image_bundles SET review_state='pending',review_version=review_version+1 WHERE intent_id=?`, string(id)); e != nil {\n\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=NULLIF(?,''),updated_at=UTC_TIMESTAMP(6) WHERE id=?`, next, code, string(id)); e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif live && review == \"approved\" {\n\t\t_, e = m.Publish(ctx, id)\n\t\treturn e\n\t}\n\treturn nil\n}\nfunc (m *MediaService) workerPrincipal(ctx context.Context, id ports.ID) (ports.Principal, Request, error) {\n\tvar raw, manifest string\n\tvar p ports.Principal\n\tvar q Request\n\tif m.base.db.QueryRowContext(ctx, `SELECT principal_json,manifest_json FROM chat_image_bundles WHERE intent_id=?`, string(id)).Scan(&raw, &manifest) != nil || json.Unmarshal([]byte(raw), &p) != nil || json.Unmarshal([]byte(manifest), &q) != nil {\n\t\treturn p, q, ErrMedia\n\t}\n\tif p.Kind != \"mini\" || p.Environment != m.environment {\n\t\treturn p, q, policy.ErrDenied\n\t}\n\tvar expiry int64\n\tif err := m.base.db.QueryRowContext(ctx, `SELECT UNIX_TIMESTAMP(expires_at) FROM login_sessions WHERE id=? AND user_id=? AND status='active'`, string(p.SourceID), string(p.ActorID)).Scan(&expiry); err != nil {\n\t\tif err == sql.ErrNoRows {\n\t\t\treturn p, q, policy.ErrDenied\n\t\t}\n\t\treturn p, q, ports.ErrUnavailable\n\t}\n\t// Refresh only the short-lived access deadline of the already-confirmed\n\t// action; LockAuthority still validates original source/session generation.\n\tp.ExpiresAt = time.Unix(expiry, 0)\n\treturn p, q, nil\n}\nfunc (m *MediaService) Publish(ctx context.Context, id ports.ID) (Result, error) {\n\tp, q, e := m.workerPrincipal(ctx, id)\n\tif e != nil {\n\t\tif e == policy.ErrDenied {\n\t\t\tm.rejectMedia(ctx, id, e.Error())\n\t\t}\n\t\treturn Result{}, e\n\t}\n\tfp, e := mediaFingerprint(q)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Verify exact delivered bytes before taking business locks; immutable keys\n\t// prohibit changes between this verification and commit.\n\tfor _, v := range q.Items {\n\t\tvar main, thumb, mh, th string\n\t\tif m.base.db.QueryRowContext(ctx, `SELECT main_key,thumb_key,main_sha256,thumb_sha256 FROM chat_image_uploads WHERE id=? AND object_version=? AND state='processed' AND rule_version=?`, string(v.AttachmentID), v.ObjectVersion, ImageRule).Scan(&main, &thumb, &mh, &th) != nil {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t\tfor _, object := range []struct{ key, hash string }{{main, mh}, {thumb, th}} {\n\t\t\tb, err := m.storage.Read(ctx, object.key, MaxImageBytes)\n\t\t\tif err != nil || mediaHash(b) != object.hash {\n\t\t\t\treturn Result{}, ErrMedia\n\t\t\t}\n\t\t}\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tg, e := m.base.authorize(ctx, tx, p, q.ConversationID)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\tif e == ErrRestricted || e == policy.ErrDenied {\n\t\t\tm.rejectMedia(ctx, id, e.Error())\n\t\t}\n\t\treturn Result{}, e\n\t}\n\ti, e := m.base.lookup(ctx, tx, p, q.ConversationID, q.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif i == nil || i.id != id || i.fingerprint != fp {\n\t\treturn Result{}, ErrConflict\n\t}\n\tif i.result.State == \"accepted\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn i.result, nil\n\t}\n\tif i.result.State == \"rejected\" || i.result.State == \"canceled\" {\n\t\treturn i.result, nil\n\t}\n\tvar hash, review, rule, general, anti string\n\tvar live bool\n\te = tx.QueryRowContext(ctx, `SELECT manifest_hash,review_state,rule_version,COALESCE(general_safety_result,''),COALESCE(anti_diversion_result,''),submitted_at IS NOT NULL AND expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles WHERE intent_id=? FOR UPDATE`, string(id)).Scan(&hash, &review, &rule, &general, &anti, &live)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif !live || !active(q.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif hash != fp || rule != ImageRule || review != \"approved\" || general != \"passed\" || anti != \"passed\" {\n\t\treturn Result{}, ErrMedia\n\t}\n\tif _, e = validateReferences(ctx, tx, p, q, g); e != nil {\n\t\ttx.Rollback()\n\t\tm.rejectMedia(ctx, id, e.Error())\n\t\treturn Result{}, e\n\t}\n\tfor _, v := range q.Items {\n\t\tvar version, state, rule string\n\t\tvar live bool\n\t\tif tx.QueryRowContext(ctx, `SELECT object_version,state,COALESCE(rule_version,''),expires_at>UTC_TIMESTAMP(6) FROM chat_image_uploads WHERE id=? AND actor_id=? AND conversation_id=? LOCK IN SHARE MODE`, string(v.AttachmentID), string(p.ActorID), string(q.ConversationID)).Scan(&version, &state, &rule, &live) != nil || !live || version != v.ObjectVersion || state != \"processed\" || rule != ImageRule {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t}\n\tvar seq, change uint64\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=?`, string(q.ConversationID)).Scan(&seq, &change) != nil || seq == ^uint64(0) || change == ^uint64(0) {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tseq++\n\tchange++\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_messages(conversation_id,seq,sender_id,client_message_id,policy_version,message_type,state,state_version,safety_rule_version,created_at,reply_to_message_id,reply_to_item_id) VALUES(?,?,?,?,?,?,'published',1,?,UTC_TIMESTAMP(6),?,?)`, string(q.ConversationID), seq, string(p.ActorID), q.ClientMessageID, string(g.Version), q.MessageType, ImageRule, nullableID(q.ReplyTo), nullableID(q.ReplyItem))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tmid, e := res.LastInsertId()\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tfor _, v := range q.Items {\n\t\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_image_items(message_id,item_id,ordinal,object_version) VALUES(?,?,?,?)`, mid, string(v.AttachmentID), v.Ordinal, v.ObjectVersion); e != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t}\n\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,1,'message.accepted',UTC_TIMESTAMP(6))`, string(q.ConversationID), change, mid); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_seq=?,last_change_seq=?,last_message_id=?,last_message_at=UTC_TIMESTAMP(6) WHERE id=?`, seq, change, mid, string(q.ConversationID)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='accepted',message_id=?,error_code=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, mid, string(id)); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tvar liveCommit bool\n\tif tx.QueryRowContext(ctx, `SELECT expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles WHERE intent_id=?`, string(id)).Scan(&liveCommit) != nil || !liveCommit || !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif m.base.publisher != nil {\n\t\tm.base.publisher.Committed(ports.CommittedMessage{ConversationID: q.ConversationID, Seq: decimal(seq), PolicyVersion: g.Version})\n\t}\n\treturn Result{ClientMessageID: q.ClientMessageID, State: \"accepted\", MessageID: ports.ID(fmt.Sprint(mid)), Seq: decimal(seq), PolicyVersion: g.Version, StateVersion: \"1\", MessageState: \"published\"}, nil\n}\n\nfunc (m *MediaService) rejectMedia(ctx context.Context, id ports.ID, code string) {\n\t_, _ = m.base.db.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state IN ('checking','retryable','review_pending')`, code, string(id))\n}\n","chat/internal/message/media_review.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype ImageReview struct {\n\tIntentID     ports.ID          `json:\"intent_id\"`\n\tVersion      ports.ID          `json:\"expected_version\"`\n\tManifestHash string            `json:\"manifest_hash\"`\n\tSubmittedAt  time.Time         `json:\"submitted_at\"`\n\tExpiresAt    time.Time         `json:\"expires_at\"`\n\tState        string            `json:\"review_state\"`\n\tItems        []MediaItemStatus `json:\"items\"`\n}\n\nfunc (m *MediaService) admin(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif p.Environment != m.environment {\n\t\treturn auth.ErrUnauthorized\n\t}\n\ta, e := auth.NewMySQLSource(m.base.db)\n\tif e != nil {\n\t\treturn e\n\t}\n\treturn a.ValidateMediaAdminLocked(ctx, tx, p)\n}\nfunc (m *MediaService) Reviews(ctx context.Context, p ports.Principal, after ports.ID) ([]ImageReview, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tdefer tx.Rollback()\n\tif e = m.admin(ctx, tx, p); e != nil {\n\t\treturn nil, e\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(b.intent_id AS CHAR),CAST(b.review_version AS CHAR),b.manifest_hash,b.submitted_at,b.expires_at,b.review_state,b.manifest_json FROM chat_image_bundles b JOIN chat_send_intents i ON i.id=b.intent_id WHERE b.intent_id>? AND b.review_state IN ('pending','claimed') AND b.expires_at>UTC_TIMESTAMP(6) AND i.state='review_pending' ORDER BY b.intent_id LIMIT 20`, string(after))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tlist := []ImageReview{}\n\tfor rows.Next() {\n\t\tvar v ImageReview\n\t\tvar raw string\n\t\tif rows.Scan(&v.IntentID, &v.Version, &v.ManifestHash, &v.SubmittedAt, &v.ExpiresAt, &v.State, &raw) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tvar q Request\n\t\tif json.Unmarshal([]byte(raw), &q) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tfor _, i := range q.Items {\n\t\t\ti.ItemID = i.AttachmentID\n\t\t\tv.Items = append(v.Items, MediaItemStatus{MediaItem: i, State: \"review_pending\"})\n\t\t}\n\t\tlist = append(list, v)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil || tx.Commit() != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn list, nil\n}\nfunc imageAudit(ctx context.Context, tx *sql.Tx, id ports.ID, p ports.Principal, action, reason, hash string, version ports.ID, item ports.ID) error {\n\t_, e := tx.ExecContext(ctx, `INSERT INTO chat_image_audit(intent_id,admin_id,action,review_version,manifest_hash,reason,item_id,created_at) VALUES(?,?,?,?,?,?,?,UTC_TIMESTAMP(6))`, string(id), string(p.ActorID), action, string(version), hash, reason, nullableID(item))\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (m *MediaService) Review(ctx context.Context, p ports.Principal, id, expected ports.ID, action, reason string, general, group bool) (ImageReview, error) {\n\tif !validID(id) || !validID(expected) || (action != \"claim\" && action != \"approve\" && action != \"reject\") || utf8.RuneCountInString(reason) < 2 || utf8.RuneCountInString(reason) > 200 {\n\t\treturn ImageReview{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn ImageReview{}, e\n\t}\n\tdefer tx.Rollback()\n\tif e = m.admin(ctx, tx, p); e != nil {\n\t\treturn ImageReview{}, e\n\t}\n\tvar v ImageReview\n\tv.IntentID = id\n\tvar raw, rule string\n\tvar reviewer sql.NullString\n\tvar lease, live bool\n\te = tx.QueryRowContext(ctx, `SELECT CAST(review_version AS CHAR),manifest_hash,submitted_at,expires_at,review_state,manifest_json,rule_version,CAST(reviewer_id AS CHAR),COALESCE(review_lease_until>UTC_TIMESTAMP(6),0),expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles WHERE intent_id=? FOR UPDATE`, string(id)).Scan(&v.Version, &v.ManifestHash, &v.SubmittedAt, &v.ExpiresAt, &v.State, &raw, &rule, &reviewer, &lease, &live)\n\tif e != nil || v.Version != expected || !live || rule != ImageRule {\n\t\treturn v, ErrMediaVersion\n\t}\n\tvar q Request\n\tif json.Unmarshal([]byte(raw), &q) != nil {\n\t\treturn v, ports.ErrUnavailable\n\t}\n\tif action == \"claim\" {\n\t\tif v.State != \"pending\" && !(v.State == \"claimed\" && (!lease || reviewer.String == string(p.ActorID))) {\n\t\t\treturn v, ErrMediaVersion\n\t\t}\n\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_image_bundles SET review_state='claimed',reviewer_id=?,review_lease_until=UTC_TIMESTAMP(6)+INTERVAL 5 MINUTE,review_version=review_version+1 WHERE intent_id=?`, string(p.ActorID), string(id))\n\t\tv.State = \"claimed\"\n\t} else {\n\t\tif v.State != \"claimed\" || !lease || reviewer.String != string(p.ActorID) {\n\t\t\treturn v, ErrMediaVersion\n\t\t}\n\t\tif action == \"approve\" {\n\t\t\tif !general || !group {\n\t\t\t\treturn v, ports.ErrInvalid\n\t\t\t}\n\t\t\tfor _, item := range q.Items {\n\t\t\t\tvar viewed int\n\t\t\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_image_audit WHERE intent_id=? AND admin_id=? AND review_version=? AND action='view' AND item_id=? AND manifest_hash=?`, string(id), string(p.ActorID), string(expected), string(item.AttachmentID), v.ManifestHash).Scan(&viewed) != nil || viewed == 0 {\n\t\t\t\t\treturn v, ErrMedia\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tnext := \"approved\"\n\t\tresult := \"passed\"\n\t\tif action == \"reject\" {\n\t\t\tnext = \"rejected\"\n\t\t\tresult = \"blocked\"\n\t\t}\n\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_image_bundles SET review_state=?,general_safety_result=?,anti_diversion_result=?,review_reason=?,review_version=review_version+1,review_lease_until=NULL WHERE intent_id=?`, next, result, result, reason, string(id))\n\t\tv.State = next\n\t}\n\tif e != nil {\n\t\treturn v, ports.ErrUnavailable\n\t}\n\tif e = imageAudit(ctx, tx, id, p, action, reason, v.ManifestHash, expected, \"\"); e != nil {\n\t\treturn v, e\n\t}\n\tv.Version = decimal(number(v.Version) + 1)\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn v, auth.ErrUnauthorized\n\t}\n\tif tx.Commit() != nil {\n\t\treturn v, ports.ErrUnavailable\n\t}\n\t// Publication is a separate canonical authority/intent transaction. Approval\n\t// never impersonates the user or overrides cancel/expiry/closure/logout.\n\n\treturn v, nil\n}\n","chat/internal/message/media_delivery.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc hydrateImages(ctx context.Context, tx *sql.Tx, views []*MessageView) error {\n\tids := []string{}\n\targs := []any{}\n\tbyID := map[ports.ID][]*MessageView{}\n\tfor _, v := range views {\n\t\tv.Images = nil\n\t\tif v.State == \"published\" && (v.Type == \"image\" || v.Type == \"image_album\") {\n\t\t\tif len(byID[v.ID]) == 0 {\n\t\t\t\tids = append(ids, \"?\")\n\t\t\t\targs = append(args, string(v.ID))\n\t\t\t}\n\t\t\tbyID[v.ID] = append(byID[v.ID], v)\n\t\t}\n\t}\n\tif len(ids) == 0 {\n\t\treturn nil\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(i.message_id AS CHAR),CAST(i.item_id AS CHAR),i.ordinal,u.width_px,u.height_px FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id IN (`+strings.Join(ids, \",\")+`) ORDER BY i.message_id,i.ordinal`, args...)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer rows.Close()\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tvar v ImageView\n\t\tif rows.Scan(&id, &v.ItemID, &v.Ordinal, &v.Width, &v.Height) != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tfor _, parent := range byID[id] {\n\t\t\tif len(parent.Images) >= 9 {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\tparent.Images = append(parent.Images, v)\n\t\t\tparent.ImageCount = len(parent.Images)\n\t\t}\n\t}\n\tif rows.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (m *MediaService) URL(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, thumb bool) (string, error) {\n\tif !validID(cid) || !validID(mid) || !validID(item) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tdefer tx.Rollback()\n\tg, e := m.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tvar key string\n\tcolumn := \"u.main_key\"\n\tif thumb {\n\t\tcolumn = \"u.thumb_key\"\n\t}\n\te = tx.QueryRowContext(ctx, `SELECT `+column+` FROM chat_messages m JOIN chat_image_items i ON i.message_id=m.id JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE m.conversation_id=? AND m.id=? AND i.item_id=? AND m.state='published' AND m.message_type IN ('image','image_album') AND `+retainedTarget+` AND `+visibleColumn, string(cid), string(mid), string(item), string(g.Version), string(p.ActorID)).Scan(&key)\n\tif e != nil || key == \"\" {\n\t\treturn \"\", ErrMedia\n\t}\n\turl, e := m.storage.Sign(ctx, key, 60*time.Second)\n\tif e != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn url, nil\n}\nfunc (m *MediaService) ReviewURL(ctx context.Context, p ports.Principal, id, version, item ports.ID) (string, error) {\n\tif !validID(id) || !validID(version) || !validID(item) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tdefer tx.Rollback()\n\tif e = m.admin(ctx, tx, p); e != nil {\n\t\treturn \"\", e\n\t}\n\tvar raw, hash string\n\te = tx.QueryRowContext(ctx, `SELECT manifest_json,manifest_hash FROM chat_image_bundles WHERE intent_id=? AND review_version=? AND reviewer_id=? AND review_state='claimed' AND review_lease_until>UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6) AND rule_version=? AND EXISTS(SELECT 1 FROM chat_send_intents i WHERE i.id=chat_image_bundles.intent_id AND i.state='review_pending') FOR UPDATE`, string(id), string(version), string(p.ActorID), ImageRule).Scan(&raw, &hash)\n\tif e != nil {\n\t\treturn \"\", ErrMediaVersion\n\t}\n\tvar q Request\n\tif json.Unmarshal([]byte(raw), &q) != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tfound := \"\"\n\tfor _, v := range q.Items {\n\t\tif v.AttachmentID == item {\n\t\t\tfound = v.ObjectVersion\n\t\t}\n\t}\n\tif found == \"\" {\n\t\treturn \"\", ErrMedia\n\t}\n\tvar key string\n\tif tx.QueryRowContext(ctx, `SELECT main_key FROM chat_image_uploads WHERE id=? AND object_version=? AND state='processed' AND rule_version=?`, string(item), found, ImageRule).Scan(&key) != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\turl, e := m.storage.Sign(ctx, key, 60*time.Second)\n\tif e != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tif e = imageAudit(ctx, tx, id, p, \"view\", \"发布前完整图片检查\", hash, version, item); e != nil {\n\t\treturn \"\", e\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn url, nil\n}\nfunc (m *MediaService) Status(ctx context.Context, p ports.Principal, cid ports.ID, client string, cancel bool) (MediaStatus, error) {\n\tif !validID(cid) || !validClient(client) {\n\t\treturn MediaStatus{}, ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn MediaStatus{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = m.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"}); e != nil {\n\t\treturn MediaStatus{}, e\n\t}\n\ti, e := m.base.lookup(ctx, tx, p, cid, client)\n\tif e != nil {\n\t\treturn MediaStatus{}, e\n\t}\n\t// A cancellation tombstone serializes against first submit via the\n\t// conversation lock. An unknown action can never be resurrected afterward.\n\tif i == nil && cancel {\n\t\tif !active(client, time.Now()) {\n\t\t\treturn MediaStatus{}, ErrExpired\n\t\t}\n\t\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,error_code,action_expires_at,retain_until,created_at,updated_at) VALUES(?,?,?,?,'canceled','CHAT_ACTION_CANCELED',?,?,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(cid), client, strings.Repeat(\"0\", 64), expires(client), expires(client).Add(MinimumRetention))\n\t\tif e != nil || tx.Commit() != nil {\n\t\t\treturn MediaStatus{}, ports.ErrUnavailable\n\t\t}\n\t\treturn MediaStatus{Result: Result{ClientMessageID: client, State: \"canceled\", Code: \"CHAT_ACTION_CANCELED\"}}, nil\n\t}\n\tif i == nil {\n\t\treturn MediaStatus{}, ErrUnknown\n\t}\n\tresult := MediaStatus{Result: i.result, Items: []MediaItemStatus{}}\n\tif i.result.State == \"accepted\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t\treturn result, nil\n\t}\n\tvar raw, review string\n\tvar live bool\n\te = tx.QueryRowContext(ctx, `SELECT manifest_json,revision,manifest_hash,expires_at,review_state,expires_at>UTC_TIMESTAMP(6) FROM chat_image_bundles WHERE intent_id=? FOR UPDATE`, string(i.id)).Scan(&raw, &result.Revision, &result.ManifestHash, &result.ExpiresAt, &review, &live)\n\tif e == sql.ErrNoRows && i.result.State == \"canceled\" {\n\t\tif tx.Commit() != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t\treturn result, nil\n\t}\n\tif e != nil {\n\t\treturn result, ErrMedia\n\t}\n\tif cancel && i.result.State != \"rejected\" && i.result.State != \"canceled\" {\n\t\tresult.State = \"canceled\"\n\t\tresult.Code = \"CHAT_ACTION_CANCELED\"\n\t}\n\tif !live && result.State != \"canceled\" && result.State != \"rejected\" {\n\t\tresult.State = \"rejected\"\n\t\tresult.Code = ErrExpired.Error()\n\t}\n\tif result.State != i.result.State {\n\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, result.State, result.Code, string(i.id)); e != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t}\n\tvar q Request\n\tif json.Unmarshal([]byte(raw), &q) != nil {\n\t\treturn result, ports.ErrUnavailable\n\t}\n\tfor _, v := range q.Items {\n\t\tvar row MediaItemStatus\n\t\trow.MediaItem = v\n\t\trow.ItemID = v.AttachmentID\n\t\tif tx.QueryRowContext(ctx, `SELECT state,COALESCE(error_code,'') FROM chat_image_uploads WHERE id=?`, string(v.AttachmentID)).Scan(&row.State, &row.Code) != nil {\n\t\t\treturn result, ports.ErrUnavailable\n\t\t}\n\t\tresult.Items = append(result.Items, row)\n\t}\n\tif tx.Commit() != nil {\n\t\treturn result, ports.ErrUnavailable\n\t}\n\treturn result, nil\n}\nfunc (m *MediaService) Pending(ctx context.Context, p ports.Principal, cid ports.ID) ([]MediaStatus, error) {\n\tif _, e := m.base.conversations.Authorize(ctx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"}); e != nil {\n\t\treturn nil, e\n\t}\n\trows, e := m.base.db.QueryContext(ctx, `SELECT i.client_message_id FROM chat_send_intents i JOIN chat_image_bundles b ON b.intent_id=i.id WHERE i.sender_id=? AND i.conversation_id=? AND i.state IN ('checking','review_pending','retryable') AND b.expires_at>UTC_TIMESTAMP(6) ORDER BY i.id DESC LIMIT 20`, string(p.ActorID), string(cid))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tclients := []string{}\n\tfor rows.Next() {\n\t\tvar client string\n\t\tif rows.Scan(&client) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tclients = append(clients, client)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tout := []MediaStatus{}\n\tfor _, client := range clients {\n\t\tv, err := m.Status(ctx, p, cid, client, false)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tout = append(out, v)\n\t}\n\treturn out, nil\n}\n","chat/internal/message/media_cleanup.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Cleanup is bounded and retryable; legal hold and every published reference\n// protect delivery objects. Minimal action/audit facts are retained separately.\nfunc (m *MediaService) CleanOne(ctx context.Context) error {\n\tvar key string\n\te := m.base.db.QueryRowContext(ctx, `SELECT o.object_key FROM chat_image_objects o JOIN chat_image_uploads u ON u.id=o.upload_id WHERE o.created_at<UTC_TIMESTAMP(6)-INTERVAL 1 DAY AND u.legal_hold=0 AND (u.lease_until IS NULL OR u.lease_until<UTC_TIMESTAMP(6)) AND ((o.object_key<>COALESCE(u.main_key,'') AND o.object_key<>COALESCE(u.thumb_key,'')) OR (u.expires_at<UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_image_items i WHERE i.item_id=u.id))) ORDER BY o.created_at LIMIT 1`).Scan(&key)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif e == nil {\n\t\tif e = m.storage.Delete(ctx, key); e != nil {\n\t\t\treturn ErrMedia\n\t\t}\n\t\tif _, e = m.base.db.ExecContext(ctx, `DELETE FROM chat_image_objects WHERE object_key=?`, key); e != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\t// Retry source deletion independently of delivered-object references.\n\tvar sourceID ports.ID\n\tvar sourceKey string\n\tif err := m.base.db.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),source_key FROM chat_image_uploads WHERE state IN ('processed','blocked') AND source_cleaned=0 AND legal_hold=0 ORDER BY id LIMIT 1`).Scan(&sourceID, &sourceKey); err == nil {\n\t\tif err = m.storage.Delete(ctx, sourceKey); err == nil {\n\t\t\t_, _ = m.base.db.ExecContext(ctx, `UPDATE chat_image_uploads SET source_cleaned=1 WHERE id=? AND legal_hold=0`, string(sourceID))\n\t\t}\n\t}\n\tvar id ports.ID\n\tvar source string\n\te = m.base.db.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),source_key FROM chat_image_uploads u WHERE expires_at<UTC_TIMESTAMP(6) AND legal_hold=0 AND state<>'cleaned' AND (lease_until IS NULL OR lease_until<UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_image_items i WHERE i.item_id=u.id) AND NOT EXISTS(SELECT 1 FROM chat_image_objects o WHERE o.upload_id=u.id) ORDER BY id LIMIT 1`).Scan(&id, &source)\n\tif e == sql.ErrNoRows {\n\t\treturn nil\n\t}\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif e = m.storage.Delete(ctx, source); e != nil {\n\t\treturn ErrMedia\n\t}\n\t_, e = m.base.db.ExecContext(ctx, `UPDATE chat_image_uploads SET state='cleaned',source_sha256=NULL WHERE id=? AND legal_hold=0`, string(id))\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/media_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Reject duplicate keys at EVERY depth; DisallowUnknownFields alone accepts\n// duplicate nested keys, which cannot define an immutable ordered manifest.\nfunc uniqueImageJSON(d *json.Decoder, depth int) bool {\n\tif depth > 12 {\n\t\treturn false\n\t}\n\tt, e := d.Token()\n\tif e != nil {\n\t\treturn false\n\t}\n\tswitch t {\n\tcase json.Delim('{'):\n\t\tseen := map[string]bool{}\n\t\tfor d.More() {\n\t\t\tv, e := d.Token()\n\t\t\tkey, ok := v.(string)\n\t\t\tif e != nil || !ok || seen[key] {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tseen[key] = true\n\t\t\tif !uniqueImageJSON(d, depth+1) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\tv, e := d.Token()\n\t\treturn e == nil && v == json.Delim('}')\n\tcase json.Delim('['):\n\t\tn := 0\n\t\tfor d.More() {\n\t\t\tn++\n\t\t\tif n > 50 || !uniqueImageJSON(d, depth+1) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t}\n\t\tv, e := d.Token()\n\t\treturn e == nil && v == json.Delim(']')\n\t}\n\treturn true\n}\nfunc strictImageJSON(raw []byte, target any) bool {\n\tif !utf8.Valid(raw) || len(raw) == 0 || raw[0] != '{' || !validSurrogates(raw) {\n\t\treturn false\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\tif !uniqueImageJSON(d, 0) {\n\t\treturn false\n\t}\n\tif _, e := d.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\td = json.NewDecoder(bytes.NewReader(raw))\n\td.DisallowUnknownFields()\n\treturn d.Decode(target) == nil\n}\nfunc decodeMediaSend(raw []byte) (Request, error) {\n\tvar q Request\n\tif !strictImageJSON(raw, &q) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tvar fields map[string]json.RawMessage\n\tjson.Unmarshal(raw, &fields)\n\tvar items []map[string]json.RawMessage\n\tif json.Unmarshal(fields[\"items\"], &items) != nil {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tfor _, item := range items {\n\t\tvalue := item[\"ordinal\"]\n\t\tif len(item) != 3 || len(value) == 0 || value[0] < '0' || value[0] > '9' {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\t_, e := mediaFingerprint(q)\n\treturn q, e\n}\n\ntype imageAction struct {\n\tConversationID ports.ID `json:\"conversation_id,omitempty\"`\n\tUploadID       string   `json:\"upload_id,omitempty\"`\n\tSize           int64    `json:\"size_bytes,omitempty\"`\n\tAttachmentID   ports.ID `json:\"attachment_id,omitempty\"`\n\tClientID       string   `json:\"client_message_id,omitempty\"`\n\tMessageID      ports.ID `json:\"message_id,omitempty\"`\n\tItemID         ports.ID `json:\"item_id,omitempty\"`\n\tThumbnail      bool     `json:\"thumbnail,omitempty\"`\n\tIntentID       ports.ID `json:\"intent_id,omitempty\"`\n\tExpected       ports.ID `json:\"expected_version,omitempty\"`\n\tAction         string   `json:\"action,omitempty\"`\n\tReason         string   `json:\"reason,omitempty\"`\n\tGeneral        bool     `json:\"general_safety_confirmed,omitempty\"`\n\tGroup          bool     `json:\"group_confirmed,omitempty\"`\n\tAfter          ports.ID `json:\"after,omitempty\"`\n}\ntype MediaHandler struct {\n\tservice  *MediaService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewMediaHandler(m *MediaService, identity ports.Identity, concurrency int) (*MediaHandler, error) {\n\tif m == nil || identity == nil || concurrency < 1 || concurrency > 16 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &MediaHandler{m, identity, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *MediaHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tfail := func(status int, code string) {\n\t\tw.WriteHeader(status)\n\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"code\": code, \"message\": \"图片操作未完成，请刷新状态后重试\", \"retryable\": status >= 500, \"server_time\": time.Now().UTC()})\n\t}\n\troute := strings.TrimPrefix(r.URL.Path, \"/chat/api/v1/media/\")\n\tfields := map[string]string{\n\t\t\"upload\": \"conversation_id upload_id size_bytes\", \"uploaded\": \"conversation_id attachment_id\",\n\t\t\"status\": \"conversation_id client_message_id\", \"cancel\": \"conversation_id client_message_id\", \"pending\": \"conversation_id\",\n\t\t\"report\": \"conversation_id message_id item_id reason\", \"url\": \"conversation_id message_id item_id thumbnail\", \"review/list\": \"after\",\n\t\t\"review/decide\": \"intent_id expected_version action reason general_safety_confirmed group_confirmed\", \"review/url\": \"intent_id expected_version item_id\",\n\t}\n\tallowed, ok := fields[route]\n\tif !ok || r.URL.Path != \"/chat/api/v1/media/\"+route {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tcontent, _, err := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif err != nil || content != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\")\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error())\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)\n\tdefer cancel()\n\tbody, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 16<<10))\n\tif err != nil {\n\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\")\n\t\treturn\n\t}\n\tvar q imageAction\n\tif !strictImageJSON(body, &q) {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tvar keys map[string]json.RawMessage\n\tjson.Unmarshal(body, &keys)\n\tfor key := range keys {\n\t\tif !strings.Contains(\" \"+allowed+\" \", \" \"+key+\" \") {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\t\treturn\n\t\t}\n\t}\n\tp, err := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif err != nil {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tvar result any\n\tswitch route {\n\tcase \"upload\":\n\t\tresult, err = h.service.Upload(ctx, p, q.ConversationID, q.UploadID, q.Size)\n\tcase \"uploaded\":\n\t\tresult, err = h.service.Uploaded(ctx, p, q.ConversationID, q.AttachmentID)\n\tcase \"status\", \"cancel\":\n\t\tresult, err = h.service.Status(ctx, p, q.ConversationID, q.ClientID, route == \"cancel\")\n\tcase \"pending\":\n\t\tresult, err = h.service.Pending(ctx, p, q.ConversationID)\n\tcase \"report\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Report(ctx, p, q.ConversationID, q.MessageID, q.ItemID, q.Reason)\n\t\tresult = map[string]any{\"report_id\": id, \"state\": \"pending\"}\n\tcase \"url\":\n\t\tvar url string\n\t\turl, err = h.service.URL(ctx, p, q.ConversationID, q.MessageID, q.ItemID, q.Thumbnail)\n\t\tresult = map[string]any{\"url\": url, \"expires_at\": time.Now().Add(60 * time.Second).Unix()}\n\tcase \"review/list\":\n\t\tresult, err = h.service.Reviews(ctx, p, q.After)\n\tcase \"review/decide\":\n\t\tresult, err = h.service.Review(ctx, p, q.IntentID, q.Expected, q.Action, q.Reason, q.General, q.Group)\n\tcase \"review/url\":\n\t\tvar url string\n\t\turl, err = h.service.ReviewURL(ctx, p, q.IntentID, q.Expected, q.ItemID)\n\t\tresult = map[string]any{\"url\": url, \"expires_at\": time.Now().Add(60 * time.Second).Unix()}\n\t}\n\tif err != nil {\n\t\tstatus := 409\n\t\tcode := err.Error()\n\t\tif err == ports.ErrInvalid {\n\t\t\tstatus = 400\n\t\t} else if err == auth.ErrUnauthorized {\n\t\t\tstatus = 403\n\t\t} else if err == ports.ErrUnavailable || err == ErrCheck {\n\t\t\tstatus = 503\n\t\t}\n\t\tfail(status, code)\n\t\treturn\n\t}\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"ok\": true, \"data\": result, \"server_time\": time.Now().UTC()})\n}\n","chat/helpers/images/requirements.lock":"# CPython 3.11 / Linux x86_64. Offline production installation from verified wheels.\nPillow==13.0.0 --hash=sha256:a625df9a2a5597fa5e5266e01aefc82604bb85d291e3547981e863560d75da6c\nzxing-cpp==3.1.1 --hash=sha256:8a5b32d719a5448f1b2f474e04d2db6ce41cc6973fb5c705d47dbe899361e5f9\n","chat/helpers/images/inspect.py":"\"\"\"Fixed local image helper. No network, OCR, shell, user URL or model download.\"\"\"\nimport json, os, pathlib, resource, struct, sys, warnings\nresource.setrlimit(resource.RLIMIT_AS, (512 * 1024**2, 512 * 1024**2))\nresource.setrlimit(resource.RLIMIT_CPU, (20, 20))\nfrom PIL import Image\nImage.MAX_IMAGE_PIXELS = 20_000_000\nwarnings.simplefilter(\"error\", Image.DecompressionBombWarning)\n\ndef inspect(path):\n    with Image.open(path) as im:\n        if im.format not in (\"JPEG\", \"PNG\", \"WEBP\") or getattr(im, \"n_frames\", 1) != 1:\n            raise ValueError(\"unsupported image\")\n        if im.width * im.height > 20_000_000 or min(im.size) < 1:\n            raise ValueError(\"pixels\")\n        im.load()\n        return im.format, im.size\n\ndef strip(data, kind):\n    # Strip metadata containers without re-encoding image pixels.\n    if kind == \"JPEG\":\n        out, p = bytearray(data[:2]), 2\n        while p < len(data):\n            if data[p] != 255: raise ValueError(\"jpeg\")\n            marker = data[p+1]\n            if marker == 218: out.extend(data[p:]); return bytes(out)\n            length = int.from_bytes(data[p+2:p+4], \"big\")\n            if length < 2 or p+2+length > len(data): raise ValueError(\"jpeg\")\n            if marker not in (225, 237, 254): out.extend(data[p:p+2+length])\n            p += 2 + length\n        raise ValueError(\"jpeg\")\n    if kind == \"PNG\":\n        out, p = bytearray(data[:8]), 8\n        while p < len(data):\n            length = int.from_bytes(data[p:p+4], \"big\")\n            if p+12+length > len(data): raise ValueError(\"png\")\n            tag = data[p+4:p+8]\n            if tag not in (b\"eXIf\", b\"tEXt\", b\"zTXt\", b\"iTXt\", b\"tIME\"):\n                out.extend(data[p:p+12+length])\n            p += 12+length\n            if tag == b\"IEND\": break\n        return bytes(out)\n    out, p = bytearray(b\"WEBP\"), 12\n    while p < len(data):\n        tag = data[p:p+4]; length = int.from_bytes(data[p+4:p+8], \"little\")\n        end = p + 8 + length + length % 2\n        if end > len(data): raise ValueError(\"webp\")\n        chunk = bytearray(data[p:end])\n        if tag == b\"VP8X\": chunk[8] &= ~12\n        if tag not in (b\"EXIF\", b\"XMP \"): out.extend(chunk)\n        p = end\n    return b\"RIFF\" + struct.pack(\"<I\", len(out)) + out\n\ndef qr(path):\n    try:\n        import zxingcpp\n        with Image.open(path) as im:\n            # Full delivered image, with ZXing's bounded rotation/downscale.\n            codes = zxingcpp.read_barcodes(im)\n        decision = \"clear\"\n        for code in codes[:64]:\n            text = code.text[:4096].strip().lower()\n            # Only known personal social/payment schemas are decisive;\n            # normal material barcodes and arbitrary numbers are NOT violations.\n            if text.startswith((\"weixin://\", \"wxp://\", \"alipayqr://\")) or text.startswith((\"https://weixin.qq.com/r/\", \"https://u.wechat.com/\")):\n                return \"completed\", \"blocked\"\n            if \"://\" in text: decision = \"review\"\n        return \"completed\", decision\n    except Exception:\n        return \"unavailable\", \"review\"\n\ndef main():\n    job = pathlib.Path(sys.argv[2]).resolve()\n    if not job.is_dir() or not job.name.startswith(\"bxchat-image-\"): raise ValueError(\"job\")\n    if sys.argv[1] == \"sanitize\":\n        source = job / \"source\"\n        if source.stat().st_size > 8*1024**2: raise ValueError(\"bytes\")\n        kind, _ = inspect(source)\n        clean = strip(source.read_bytes(), kind)\n        (job / \"clean.input\").write_bytes(clean)\n        inspect(job / \"clean.input\")\n        print(json.dumps({\"ok\": True}))\n    elif sys.argv[1] == \"inspect\":\n        kind, (width, height) = inspect(job / \"main\")\n        inspect(job / \"thumb\")\n        a, b = qr(job / \"main\"); c, d = qr(job / \"thumb\")\n        decision = \"blocked\" if \"blocked\" in (b,d) else \"review\" if \"review\" in (b,d) else \"clear\"\n        print(json.dumps({\"mime\": {\"JPEG\":\"image/jpeg\",\"PNG\":\"image/png\",\"WEBP\":\"image/webp\"}[kind],\n                          \"width\":width, \"height\":height,\n                          \"qr_status\":\"completed\" if a == c == \"completed\" else \"unavailable\",\n                          \"qr_decision\":decision, \"qr_version\":\"zxing-cpp-3.1.1\",\n                          \"ocr_status\":\"not_run\"}))\n    else: raise ValueError(\"mode\")\nif __name__ == \"__main__\":\n    try: main()\n    except Exception:\n        print('{\"code\":\"CHAT_IMAGE_CHECK_UNAVAILABLE\"}')\n        sys.exit(1)\n","server/bin/chat-images.php":"<?php\ndeclare(strict_types=1);\nif (PHP_SAPI !== 'cli') { http_response_code(404); exit; }\n// Only a Go-created private job directory is accepted; no application bootstrap,\n// FPM request, database write or arbitrary optimizer command is involved.\ntry {\n    $job = realpath($argv[1] ?? '');\n    if (!$job || !is_dir($job) || strpos(basename($job), 'bxchat-image-') !== 0 || is_link($argv[1])) throw new RuntimeException('job');\n    foreach (['source','clean.input'] as $name) if (!is_file($job.'/'.$name) || is_link($job.'/'.$name)) throw new RuntimeException('input');\n    $GLOBALS['chat_image_job'] = $job;\n    function base_path(string $path = ''): string { return $GLOBALS['chat_image_job'].'/'.$path; }\n    function setting(string $name, $default = null) {\n        $values = ['media.max_long_edge_px'=>(int)getenv('CHAT_IMAGE_EDGE'),'media.max_file_bytes'=>(int)getenv('CHAT_IMAGE_BYTES')];\n        return $values[$name] ?? $default;\n    }\n    require dirname(__DIR__).'/app/Services/ImageOptimizerService.php';\n    $result = (new \\WorkerAdmin\\Services\\ImageOptimizerService())->optimize($job.'/clean.input');\n    if (!copy($result['path'], $job.'/main')) throw new RuntimeException('copy');\n    $source = imagecreatefromstring((string)file_get_contents($job.'/main'));\n    if (!$source) throw new RuntimeException('decode');\n    $width = imagesx($source); $height = imagesy($source);\n    $scale = min(1.0, 400/max($width,$height));\n    $thumb = imagecreatetruecolor(max(1,(int)round($width*$scale)),max(1,(int)round($height*$scale)));\n    $white = imagecolorallocate($thumb,255,255,255); imagefill($thumb,0,0,$white);\n    imagecopyresampled($thumb,$source,0,0,0,0,imagesx($thumb),imagesy($thumb),$width,$height);\n    if (!imagejpeg($thumb,$job.'/thumb',90)) throw new RuntimeException('thumb');\n    imagedestroy($thumb);imagedestroy($source);\n    fwrite(STDOUT,json_encode(['method'=>$result['method']],JSON_THROW_ON_ERROR).\"\\n\");\n} catch (Throwable $error) {\n    fwrite(STDOUT,'{\"code\":\"CHAT_IMAGE_CHECK_UNAVAILABLE\"}'.\"\\n\");exit(1);\n}\n","chat/internal/imagepipeline/helper.go":"// Package imagepipeline is an offline, bounded adapter to existing optimization\n// and local ZXing. It has no chat-table write authority or network OCR fallback.\npackage imagepipeline\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n)\n\ntype Helper struct {\n\tPHP, Python, PHPScript, PythonScript, TempRoot string\n\tMaxBytes, MaxEdge                              int\n}\ntype boundedOutput struct{ bytes.Buffer }\n\nfunc (b *boundedOutput) Write(p []byte) (int, error) {\n\tif b.Len()+len(p) > 8192 {\n\t\treturn 0, errors.New(\"helper output budget\")\n\t}\n\treturn b.Buffer.Write(p)\n}\nfunc (h *Helper) command(ctx context.Context, name string, args ...string) ([]byte, error) {\n\tif !filepath.IsAbs(name) {\n\t\treturn nil, message.ErrMedia\n\t}\n\tcmd := exec.CommandContext(ctx, name, args...)\n\tcmd.WaitDelay = time.Second\n\tcmd.Env = []string{\"PATH=\" + os.Getenv(\"PATH\"), \"LANG=C.UTF-8\", \"PYTHONNOUSERSITE=1\", \"OMP_NUM_THREADS=1\", \"OPENBLAS_NUM_THREADS=1\", \"CHAT_IMAGE_EDGE=\" + itoa(h.MaxEdge), \"CHAT_IMAGE_BYTES=\" + itoa(h.MaxBytes)}\n\tvar out boundedOutput\n\tcmd.Stdout = &out\n\tcmd.Stderr = io.Discard\n\tif cmd.Run() != nil {\n\t\treturn nil, message.ErrCheck\n\t}\n\treturn out.Bytes(), nil\n}\nfunc itoa(n int) string { b, _ := json.Marshal(n); return string(b) }\nfunc (h *Helper) Process(ctx context.Context, raw []byte) (message.ProcessedImage, error) {\n\tvar result message.ProcessedImage\n\tif len(raw) < 1 || len(raw) > message.MaxImageBytes || h.MaxBytes < 10240 || h.MaxBytes > message.MaxImageBytes || h.MaxEdge < 800 || h.MaxEdge > 2400 || !filepath.IsAbs(h.PHPScript) || !filepath.IsAbs(h.PythonScript) {\n\t\treturn result, message.ErrMedia\n\t}\n\tctx, cancel := context.WithTimeout(ctx, 45*time.Second)\n\tdefer cancel()\n\tjob, e := os.MkdirTemp(h.TempRoot, \"bxchat-image-\")\n\tif e != nil {\n\t\treturn result, message.ErrCheck\n\t}\n\tdefer os.RemoveAll(job)\n\tif e = os.WriteFile(filepath.Join(job, \"source\"), raw, 0600); e != nil {\n\t\treturn result, message.ErrCheck\n\t}\n\tif _, e = h.command(ctx, h.Python, h.PythonScript, \"sanitize\", job); e != nil {\n\t\treturn result, e\n\t}\n\toptimized, e := h.command(ctx, h.PHP, \"-d\", \"memory_limit=256M\", \"-d\", \"max_execution_time=20\", h.PHPScript, job)\n\tif e != nil {\n\t\treturn result, e\n\t}\n\tvar optimization struct{ Method string }\n\tif json.Unmarshal(optimized, &optimization) != nil || optimization.Method == \"\" {\n\t\treturn result, message.ErrCheck\n\t}\n\tinspected, e := h.command(ctx, h.Python, h.PythonScript, \"inspect\", job)\n\tif e != nil {\n\t\treturn result, e\n\t}\n\tvar info struct {\n\t\tMIME       string `json:\"mime\"`\n\t\tWidth      int    `json:\"width\"`\n\t\tHeight     int    `json:\"height\"`\n\t\tQRStatus   string `json:\"qr_status\"`\n\t\tQRDecision string `json:\"qr_decision\"`\n\t\tQRVersion  string `json:\"qr_version\"`\n\t\tOCRStatus  string `json:\"ocr_status\"`\n\t}\n\tif json.Unmarshal(inspected, &info) != nil {\n\t\treturn result, message.ErrCheck\n\t}\n\tfor _, name := range []string{\"main\", \"thumb\"} {\n\t\tp := filepath.Join(job, name)\n\t\tstat, err := os.Lstat(p)\n\t\tif err != nil || !stat.Mode().IsRegular() || stat.Size() > message.MaxImageBytes {\n\t\t\treturn result, message.ErrMedia\n\t\t}\n\t\tb, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn result, message.ErrMedia\n\t\t}\n\t\tif name == \"main\" {\n\t\t\tresult.Main = b\n\t\t} else {\n\t\t\tresult.Thumb = b\n\t\t}\n\t}\n\tresult.MIME = info.MIME\n\tresult.Width = info.Width\n\tresult.Height = info.Height\n\tresult.Method = optimization.Method\n\tresult.QRStatus = info.QRStatus\n\tresult.QRDecision = info.QRDecision\n\tresult.QRVersion = info.QRVersion\n\tresult.OCRStatus = info.OCRStatus\n\treturn result, nil\n}\n","chat/internal/imagepipeline/qiniu.go":"package imagepipeline\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/hmac\"\n\t\"crypto/sha1\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"mime/multipart\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n)\n\ntype QiniuConfig struct {\n\tBucket, AccessKey, SecretKey, DownloadOrigin, UploadOrigin, Environment string\n\tPrivate                                                                 bool\n}\ntype Qiniu struct {\n\tconfig QiniuConfig\n\tclient *http.Client\n}\n\nvar objectKey = regexp.MustCompile(`^chat/(test|development|production)/[1-9][0-9]{0,19}/[0-9a-f]{64}/(source|[0-9a-f]{64}/(main|thumb))$`)\n\nfunc publicImageOrigin(raw string) bool {\n\tu, e := url.Parse(raw)\n\treturn e == nil && u.Scheme == \"https\" && u.Hostname() != \"\" && net.ParseIP(u.Hostname()) == nil && u.User == nil && u.RawQuery == \"\" && u.Fragment == \"\" && (u.Path == \"\" || u.Path == \"/\") && (u.Port() == \"\" || u.Port() == \"443\")\n}\nfunc NewQiniu(c QiniuConfig) (*Qiniu, error) {\n\tupload, e := url.Parse(c.UploadOrigin)\n\tif !c.Private || !publicImageOrigin(c.DownloadOrigin) || !publicImageOrigin(c.UploadOrigin) || e != nil ||\n\t\t!(strings.HasSuffix(upload.Hostname(), \".qiniup.com\") || strings.HasSuffix(upload.Hostname(), \".qiniu.com\")) ||\n\t\t!regexp.MustCompile(`^[A-Za-z0-9_-]{1,63}$`).MatchString(c.Bucket) || c.AccessKey == \"\" || c.SecretKey == \"\" ||\n\t\t(c.Environment != \"production\" && c.Environment != \"development\" && c.Environment != \"test\") {\n\t\treturn nil, message.ErrMedia\n\t}\n\tdialer := &net.Dialer{Timeout: 5 * time.Second}\n\ttransport := &http.Transport{Proxy: nil, MaxIdleConns: 2, MaxConnsPerHost: 2, IdleConnTimeout: 30 * time.Second, TLSHandshakeTimeout: 5 * time.Second, ResponseHeaderTimeout: 10 * time.Second}\n\ttransport.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {\n\t\thost, port, e := net.SplitHostPort(address)\n\t\tif e != nil {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t\taddresses, e := net.DefaultResolver.LookupIPAddr(ctx, host)\n\t\tif e != nil || len(addresses) == 0 {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t\tfor _, ip := range addresses {\n\t\t\tif !ip.IP.IsGlobalUnicast() || ip.IP.IsPrivate() || ip.IP.IsLoopback() || ip.IP.IsLinkLocalUnicast() {\n\t\t\t\treturn nil, message.ErrMedia\n\t\t\t}\n\t\t}\n\t\treturn dialer.DialContext(ctx, network, net.JoinHostPort(addresses[0].IP.String(), port))\n\t}\n\treturn &Qiniu{c, &http.Client{Timeout: 20 * time.Second, Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return message.ErrMedia }}}, nil\n}\nfunc b64(b []byte) string { return base64.URLEncoding.EncodeToString(b) }\nfunc (q *Qiniu) signature(s string) string {\n\th := hmac.New(sha1.New, []byte(q.config.SecretKey))\n\th.Write([]byte(s))\n\treturn b64(h.Sum(nil))\n}\nfunc (q *Qiniu) valid(key string) bool {\n\treturn objectKey.MatchString(key) && strings.HasPrefix(key, \"chat/\"+q.config.Environment+\"/\")\n}\nfunc (q *Qiniu) Grant(ctx context.Context, key string, size int64) (string, string, error) {\n\tif !q.valid(key) || size < 1 || size > message.MaxImageBytes {\n\t\treturn \"\", \"\", message.ErrMedia\n\t}\n\tpolicy, _ := json.Marshal(map[string]any{\"scope\": q.config.Bucket + \":\" + key, \"deadline\": time.Now().Add(5 * time.Minute).Unix(), \"insertOnly\": 1, \"fsizeMin\": size, \"fsizeLimit\": size, \"detectMime\": 1, \"mimeLimit\": \"image/jpeg;image/png;image/webp\"})\n\tencoded := b64(policy)\n\treturn q.config.AccessKey + \":\" + q.signature(encoded) + \":\" + encoded, q.config.UploadOrigin, nil\n}\nfunc (q *Qiniu) Sign(ctx context.Context, key string, ttl time.Duration) (string, error) {\n\tif !q.valid(key) || ttl <= 0 || ttl > 60*time.Second {\n\t\treturn \"\", message.ErrMedia\n\t}\n\tu := strings.TrimRight(q.config.DownloadOrigin, \"/\") + \"/\" + key + \"?e=\" + itoa(int(time.Now().Add(ttl).Unix()))\n\treturn u + \"&token=\" + q.config.AccessKey + \":\" + q.signature(u), nil\n}\nfunc (q *Qiniu) Read(ctx context.Context, key string, limit int64) ([]byte, error) {\n\tu, e := q.Sign(ctx, key, 60*time.Second)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\treq, _ := http.NewRequestWithContext(ctx, \"GET\", u, nil)\n\tres, e := q.client.Do(req)\n\tif e != nil {\n\t\treturn nil, message.ErrMedia\n\t}\n\tdefer res.Body.Close()\n\tif res.StatusCode != 200 || res.ContentLength > limit {\n\t\treturn nil, message.ErrMedia\n\t}\n\tb, e := io.ReadAll(io.LimitReader(res.Body, limit+1))\n\tif e != nil || int64(len(b)) > limit || len(b) == 0 {\n\t\treturn nil, message.ErrMedia\n\t}\n\treturn b, nil\n}\nfunc (q *Qiniu) Put(ctx context.Context, key string, b []byte, mime string) error {\n\ttoken, host, e := q.Grant(ctx, key, int64(len(b)))\n\tif e != nil {\n\t\treturn e\n\t}\n\tvar body bytes.Buffer\n\twriter := multipart.NewWriter(&body)\n\twriter.WriteField(\"token\", token)\n\twriter.WriteField(\"key\", key)\n\tpart, e := writer.CreateFormFile(\"file\", \"image\")\n\tif e != nil {\n\t\treturn message.ErrMedia\n\t}\n\tpart.Write(b)\n\twriter.Close()\n\treq, _ := http.NewRequestWithContext(ctx, \"POST\", host, &body)\n\treq.Header.Set(\"Content-Type\", writer.FormDataContentType())\n\tres, e := q.client.Do(req)\n\tif e != nil {\n\t\treturn message.ErrMedia\n\t}\n\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\tres.Body.Close()\n\tif res.StatusCode < 200 || res.StatusCode >= 300 {\n\t\t// insertOnly may report an existing object on retry. It is reusable only\n\t\t// after byte-for-byte verification, never by trusting provider etag.\n\t\texisting, err := q.Read(ctx, key, int64(len(b)))\n\t\tif err != nil || !bytes.Equal(existing, b) {\n\t\t\treturn message.ErrMedia\n\t\t}\n\t}\n\treturn nil\n}\nfunc (q *Qiniu) Delete(ctx context.Context, key string) error {\n\tif !q.valid(key) {\n\t\treturn message.ErrMedia\n\t}\n\tpath := \"/delete/\" + b64([]byte(q.config.Bucket+\":\"+key))\n\treq, _ := http.NewRequestWithContext(ctx, \"POST\", \"https://rs.qiniuapi.com\"+path, nil)\n\treq.Header.Set(\"Authorization\", \"QBox \"+q.config.AccessKey+\":\"+q.signature(path+\"\\n\"))\n\treq.Header.Set(\"Content-Type\", \"application/x-www-form-urlencoded\")\n\tres, e := q.client.Do(req)\n\tif e != nil {\n\t\treturn message.ErrMedia\n\t}\n\tio.Copy(io.Discard, io.LimitReader(res.Body, 4096))\n\tres.Body.Close()\n\tif res.StatusCode >= 200 && res.StatusCode < 300 || res.StatusCode == 612 {\n\t\treturn nil\n\t}\n\treturn message.ErrMedia\n}\n","chat/internal/message/media_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype imageMemory struct {\n\tmu      sync.Mutex\n\tobjects map[string][]byte\n}\n\nfunc (s *imageMemory) Grant(context.Context, string, int64) (string, string, error) {\n\treturn \"test-token\", \"https://upload.fixture.invalid\", nil\n}\nfunc (s *imageMemory) Read(ctx context.Context, key string, limit int64) ([]byte, error) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tb, ok := s.objects[key]\n\tif !ok || int64(len(b)) > limit {\n\t\treturn nil, ErrMedia\n\t}\n\treturn append([]byte(nil), b...), nil\n}\nfunc (s *imageMemory) Put(ctx context.Context, key string, b []byte, mime string) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tif old, ok := s.objects[key]; ok && string(old) != string(b) {\n\t\treturn ErrMedia\n\t}\n\ts.objects[key] = append([]byte(nil), b...)\n\treturn nil\n}\nfunc (s *imageMemory) Sign(ctx context.Context, key string, ttl time.Duration) (string, error) {\n\tif ttl > 60*time.Second {\n\t\treturn \"\", ErrMedia\n\t}\n\treturn \"https://private.fixture.invalid/\" + key + \"?e=short\", nil\n}\nfunc (s *imageMemory) Delete(ctx context.Context, key string) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tdelete(s.objects, key)\n\treturn nil\n}\n\ntype imageProcessorFunc func(context.Context, []byte) (ProcessedImage, error)\n\nfunc (fn imageProcessorFunc) Process(ctx context.Context, b []byte) (ProcessedImage, error) {\n\treturn fn(ctx, b)\n}\nfunc mediaFixture(t *testing.T) (*fixtureDB, *Service, *MediaService, *imageMemory, Request) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tstorage := &imageMemory{objects: map[string][]byte{}}\n\tm, e := NewMediaService(s, storage, imageProcessorFunc(func(ctx context.Context, b []byte) (ProcessedImage, error) {\n\t\tif string(b) == \"fail\" {\n\t\t\treturn ProcessedImage{}, ErrCheck\n\t\t}\n\t\tdecision := \"clear\"\n\t\tif string(b) == \"personal\" {\n\t\t\tdecision = \"blocked\"\n\t\t}\n\t\treturn ProcessedImage{Main: append([]byte(\"main:\"), b...), Thumb: append([]byte(\"thumb:\"), b...), MIME: \"image/jpeg\", Method: \"original\", Width: 100, Height: 100, QRStatus: \"completed\", QRDecision: decision, QRVersion: \"fixture-v1\", OCRStatus: \"not_run\"}, nil\n\t}), \"test\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts = s.WithMedia(m)\n\tf.exec(`INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(90001,'image-review-fixture','fixture','operations','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tf.exec(`INSERT INTO chat_admin_sessions(id,admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(90001,90001,REPEAT('a',64),REPEAT('b',64),REPEAT('c',64),'[\"chat:audit\",\"chat:moderate\",\"chat:images\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())`)\n\tq.Text = \"\"\n\tq.MessageType = \"image\"\n\tq.Revision = 1\n\tq.Items = nil\n\treturn f, s, m, storage, q\n}\nfunc mediaAdmin() ports.Principal {\n\treturn ports.Principal{ActorID: \"90001\", Kind: \"admin\", SourceID: \"90001\", SessionID: strings.Repeat(\"a\", 64), SessionVersion: strings.Repeat(\"b\", 64), Environment: \"test\", Scopes: []string{\"chat:audit\", \"chat:moderate\", \"chat:images\"}, ExpiresAt: time.Now().Add(time.Minute)}\n}\nfunc mediaAdd(t *testing.T, m *MediaService, storage *imageMemory, cid ports.ID, n int, body string) MediaItem {\n\tt.Helper()\n\tctx := context.Background()\n\tg, e := m.Upload(ctx, principal(\"10202\"), cid, client(500+n), int64(len(body)))\n\tif e != nil {\n\t\tt.Fatal(\"upload\", e)\n\t}\n\tstorage.Put(ctx, g.Key, []byte(body), \"image/jpeg\")\n\tif _, e = m.Uploaded(ctx, principal(\"10202\"), cid, g.AttachmentID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\treturn MediaItem{AttachmentID: g.AttachmentID, ObjectVersion: g.ObjectVersion}\n}\nfunc mediaProcess(t *testing.T, m *MediaService, n int) {\n\tt.Helper()\n\tfor i := 0; i < n; i++ {\n\t\tif e := m.ProcessOne(context.Background()); e != nil {\n\t\t\tt.Fatal(\"process\", e)\n\t\t}\n\t}\n\tif e := m.Advance(context.Background()); e != nil {\n\t\tt.Fatal(\"advance\", e)\n\t}\n}\nfunc mediaApprove(t *testing.T, m *MediaService) ports.ID {\n\tt.Helper()\n\tctx := context.Background()\n\tlist, e := m.Reviews(ctx, mediaAdmin(), \"0\")\n\tif e != nil || len(list) != 1 {\n\t\tt.Fatal(\"reviews\", list, e)\n\t}\n\tv, e := m.Review(ctx, mediaAdmin(), list[0].IntentID, list[0].Version, \"claim\", \"逐图检查\", false, false)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor _, item := range list[0].Items {\n\t\tif _, e = m.ReviewURL(ctx, mediaAdmin(), v.IntentID, v.Version, item.AttachmentID); e != nil {\n\t\t\tt.Fatal(\"review URL\", e)\n\t\t}\n\t}\n\tif _, e = m.Review(ctx, mediaAdmin(), v.IntentID, v.Version, \"approve\", \"全部图片一般安全及整组导流检查通过\", true, true); e != nil {\n\t\tt.Fatal(\"approve\", e)\n\t}\n\tif e := m.Advance(ctx); e != nil {\n\t\tt.Fatal(\"publish\", e)\n\t}\n\treturn v.IntentID\n}\nfunc TestMySQLS16ImageExplicitSubmitReviewAndRecall(t *testing.T) {\n\tf, s, m, storage, q := mediaFixture(t)\n\tctx := context.Background()\n\tq.Items = []MediaItem{mediaAdd(t, m, storage, q.ConversationID, 1, \"construction\")}\n\tmediaProcess(t, m, 1)\n\tvar count int\n\tf.root.QueryRow(\"SELECT COUNT(*) FROM chat_messages\").Scan(&count)\n\tif count != 0 {\n\t\tt.Fatal(\"upload published\")\n\t}\n\tlist, e := m.Reviews(ctx, mediaAdmin(), \"0\")\n\tif e != nil || len(list) != 0 {\n\t\tt.Fatal(\"unsubmitted review\", list, e)\n\t}\n\tif _, e := s.Send(ctx, principal(\"10202\"), q); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e := m.Advance(ctx); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tlist, _ = m.Reviews(ctx, mediaAdmin(), \"0\")\n\tv, e := m.Review(ctx, mediaAdmin(), list[0].IntentID, list[0].Version, \"claim\", \"检查图片\", false, false)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = m.Review(ctx, mediaAdmin(), v.IntentID, v.Version, \"approve\", \"尚未取完整图片\", true, true); e != ErrMedia {\n\t\tt.Fatal(\"unseen approval\", e)\n\t}\n\tif _, e = m.ReviewURL(ctx, mediaAdmin(), v.IntentID, v.Version, q.Items[0].AttachmentID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = m.Review(ctx, mediaAdmin(), v.IntentID, v.Version, \"approve\", \"一般安全和图片导流检查通过\", true, true); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e := m.Advance(ctx); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tr, e := s.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif e != nil || r.State != \"accepted\" || r.Seq != \"1\" {\n\t\tt.Fatal(r, e)\n\t}\n\th, _ := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"s\", 32)), 3*time.Second)\n\tpage, e := h.Read(ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif e != nil || len(page.Messages) != 1 || page.Messages[0].State != \"published\" || len(page.Messages[0].Images) != 1 {\n\t\tt.Fatal(\"history\", page, e)\n\t}\n\tencoded, _ := json.Marshal(page)\n\tif strings.Contains(string(encoded), \"chat/test/\") || strings.Contains(string(encoded), \"source_sha\") {\n\t\tt.Fatal(\"history leaked keys\")\n\t}\n\tif _, e = m.URL(ctx, principal(\"10203\"), q.ConversationID, r.MessageID, q.Items[0].AttachmentID, false); e != nil {\n\t\tt.Fatal(e)\n\t}\n\treport, e := m.Report(ctx, principal(\"10203\"), q.ConversationID, r.MessageID, q.Items[0].AttachmentID, \"疑似引流图片\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tagain, e := m.Report(ctx, principal(\"10203\"), q.ConversationID, r.MessageID, q.Items[0].AttachmentID, \"重复举报\")\n\tif e != nil || again != report {\n\t\tt.Fatal(\"report dedup\", e)\n\t}\n\tif _, e = m.Report(ctx, principal(\"10203\"), q.ConversationID, r.MessageID, \"99999\", \"错误条目\"); e == nil {\n\t\tt.Fatal(\"foreign report item\")\n\t}\n\treply := Request{ConversationID: q.ConversationID, ClientMessageID: client(700), MessageType: \"text\", Text: \"看这张图\", ReplyTo: r.MessageID, ReplyItem: q.Items[0].AttachmentID}\n\tif _, e := s.Send(ctx, principal(\"10203\"), reply); e != nil {\n\t\tt.Fatal(\"image reply\", e)\n\t}\n\tif _, e = s.Recall(ctx, principal(\"10202\"), q.ConversationID, r.MessageID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = m.URL(ctx, principal(\"10203\"), q.ConversationID, r.MessageID, q.Items[0].AttachmentID, false); e == nil {\n\t\tt.Fatal(\"recalled media signed\")\n\t}\n\tpage, e = h.Read(ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif e != nil || len(page.Messages[0].Images) != 0 || page.Messages[1].Reply.State != \"recalled\" {\n\t\tt.Fatal(\"recall projection\", page, e)\n\t}\n}\nfunc TestMySQLS17AlbumRetryOrderAndSingleUnread(t *testing.T) {\n\tf, s, m, storage, q := mediaFixture(t)\n\tctx := context.Background()\n\tq.MessageType = \"image_album\"\n\tfor i := 0; i < 9; i++ {\n\t\tbody := fmt.Sprint(\"construction-\", i)\n\t\tif i == 4 {\n\t\t\tbody = \"fail\"\n\t\t}\n\t\titem := mediaAdd(t, m, storage, q.ConversationID, i+1, body)\n\t\titem.Ordinal = i\n\t\tq.Items = append(q.Items, item)\n\t}\n\tif _, e := s.Send(ctx, principal(\"10202\"), q); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor i := 0; i < 9; i++ {\n\t\te := m.ProcessOne(ctx)\n\t\tif e != nil && e != ErrCheck {\n\t\t\tt.Fatal(e)\n\t\t}\n\t}\n\tm.Advance(ctx)\n\tstatus, e := m.Status(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID, false)\n\tif e != nil || status.State != \"retryable\" {\n\t\tt.Fatal(status, e)\n\t}\n\tvar count int\n\tf.root.QueryRow(\"SELECT COUNT(*) FROM chat_messages\").Scan(&count)\n\tif count != 0 {\n\t\tt.Fatal(\"partial album\")\n\t}\n\t// Retry only the failed immutable object. Same bytes may now process after\n\t// the unavailable infrastructure recovers; successful items keep attempts=1.\n\tm.processor = imageProcessorFunc(func(ctx context.Context, b []byte) (ProcessedImage, error) {\n\t\treturn ProcessedImage{Main: append([]byte(\"main:\"), b...), Thumb: []byte(\"thumb\"), MIME: \"image/jpeg\", Method: \"original\", Width: 100, Height: 100, QRStatus: \"unavailable\", QRDecision: \"review\", QRVersion: \"zxing-unavailable\", OCRStatus: \"not_run\"}, nil\n\t})\n\tif _, e = m.Uploaded(ctx, principal(\"10202\"), q.ConversationID, q.Items[4].AttachmentID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tmediaProcess(t, m, 1)\n\tmediaApprove(t, m)\n\tr, e := s.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif e != nil || r.State != \"accepted\" || r.Seq != \"1\" {\n\t\tt.Fatal(r, e)\n\t}\n\th, _ := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"s\", 32)), 3*time.Second)\n\tunread, e := h.Unread(ctx, principal(\"10203\"), q.ConversationID)\n\tif e != nil || unread.Count != 1 {\n\t\tt.Fatal(\"album unread\", unread, e)\n\t}\n\tpage, e := h.Read(ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif e != nil || len(page.Messages) != 1 || len(page.Messages[0].Images) != 9 {\n\t\tt.Fatal(\"album\", page, e)\n\t}\n\tfor i, v := range page.Messages[0].Images {\n\t\tif v.Ordinal != i || v.ItemID != q.Items[i].AttachmentID {\n\t\t\tt.Fatal(\"ordered manifest\")\n\t\t}\n\t}\n\tchanged := q\n\tchanged.Items = append([]MediaItem(nil), q.Items...)\n\tchanged.Items[0], changed.Items[1] = changed.Items[1], changed.Items[0]\n\tchanged.Items[0].Ordinal = 0\n\tchanged.Items[1].Ordinal = 1\n\tif _, e := s.Send(ctx, principal(\"10202\"), changed); e != ErrConflict {\n\t\tt.Fatal(\"changed order same ID\", e)\n\t}\n\tvar attempts int\n\tf.root.QueryRow(\"SELECT attempts FROM chat_image_uploads WHERE id=?\", string(q.Items[0].AttachmentID)).Scan(&attempts)\n\tif attempts != 1 {\n\t\tt.Fatal(\"rechecked success\")\n\t}\n}\nfunc TestMySQLS16CanceledUnknownAndFinalAuthority(t *testing.T) {\n\tfor _, change := range []string{\"cancel\", \"unknown\", \"expiry\", \"ban\", \"logout\", \"close\", \"rule\", \"corrupt\"} {\n\t\tt.Run(change, func(t *testing.T) {\n\t\t\tf, s, m, storage, q := mediaFixture(t)\n\t\t\tctx := context.Background()\n\t\t\tq.Items = []MediaItem{mediaAdd(t, m, storage, q.ConversationID, 1, \"construction\")}\n\t\t\tmediaProcess(t, m, 1)\n\t\t\tif change == \"unknown\" {\n\t\t\t\tif _, e := m.Status(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID, true); e != nil {\n\t\t\t\t\tt.Fatal(e)\n\t\t\t\t}\n\t\t\t\tr, e := s.Send(ctx, principal(\"10202\"), q)\n\t\t\t\tif e != nil || r.State != \"canceled\" {\n\t\t\t\t\tt.Fatal(\"tombstone\", r, e)\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif _, e := s.Send(ctx, principal(\"10202\"), q); e != nil {\n\t\t\t\tt.Fatal(e)\n\t\t\t}\n\t\t\tm.Advance(ctx)\n\t\t\tlist, _ := m.Reviews(ctx, mediaAdmin(), \"0\")\n\t\t\tv, e := m.Review(ctx, mediaAdmin(), list[0].IntentID, list[0].Version, \"claim\", \"检查图片\", false, false)\n\t\t\tif e != nil {\n\t\t\t\tt.Fatal(e)\n\t\t\t}\n\t\t\tm.ReviewURL(ctx, mediaAdmin(), v.IntentID, v.Version, q.Items[0].AttachmentID)\n\t\t\tif _, e = m.Review(ctx, mediaAdmin(), v.IntentID, v.Version, \"approve\", \"一般安全和整组检查通过\", true, true); e != nil {\n\t\t\t\tt.Fatal(e)\n\t\t\t}\n\t\t\tswitch change {\n\t\t\tcase \"cancel\":\n\t\t\t\tif _, e = m.Status(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID, true); e != nil {\n\t\t\t\t\tt.Fatal(e)\n\t\t\t\t}\n\t\t\tcase \"expiry\":\n\t\t\t\tf.exec(\"UPDATE chat_image_bundles SET expires_at=UTC_TIMESTAMP()-INTERVAL 1 SECOND\")\n\t\t\tcase \"ban\":\n\t\t\t\tf.exec(\"UPDATE chat_restrictions SET permanent=1 WHERE actor_id=10202\")\n\t\t\tcase \"logout\":\n\t\t\t\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\t\t\tcase \"close\":\n\t\t\t\tf.php(\"close\")\n\t\t\t\tif _, e = f.store.Poll(ctx, 100); e != nil {\n\t\t\t\t\tt.Fatal(e)\n\t\t\t\t}\n\t\t\tcase \"rule\":\n\t\t\t\tf.exec(\"UPDATE chat_image_bundles SET rule_version='old-rule'\")\n\t\t\tcase \"corrupt\":\n\t\t\t\tvar key string\n\t\t\t\tf.root.QueryRow(\"SELECT main_key FROM chat_image_uploads LIMIT 1\").Scan(&key)\n\t\t\t\tstorage.mu.Lock()\n\t\t\t\tstorage.objects[key] = []byte(\"changed\")\n\t\t\t\tstorage.mu.Unlock()\n\t\t\t}\n\t\t\t_, _ = m.Publish(ctx, v.IntentID)\n\t\t\tvar count int\n\t\t\tf.root.QueryRow(\"SELECT COUNT(*) FROM chat_messages\").Scan(&count)\n\t\t\tif count != 0 {\n\t\t\t\tt.Fatal(\"published after\", change)\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestMySQLS16ExpiredAccessAndConcurrentPublish(t *testing.T) {\n\tf, s, m, storage, q := mediaFixture(t)\n\tctx := context.Background()\n\tq.Items = []MediaItem{mediaAdd(t, m, storage, q.ConversationID, 1, \"construction\")}\n\tmediaProcess(t, m, 1)\n\tp := principal(\"10202\")\n\tp.ExpiresAt = time.Now().Add(time.Second)\n\tif _, e := s.Send(ctx, p, q); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tm.Advance(ctx)\n\tlist, _ := m.Reviews(ctx, mediaAdmin(), \"0\")\n\tv, _ := m.Review(ctx, mediaAdmin(), list[0].IntentID, list[0].Version, \"claim\", \"检查图片\", false, false)\n\tm.ReviewURL(ctx, mediaAdmin(), v.IntentID, v.Version, q.Items[0].AttachmentID)\n\tif _, e := m.Review(ctx, mediaAdmin(), v.IntentID, v.Version, \"approve\", \"一般安全和整组检查通过\", true, true); e != nil {\n\t\tt.Fatal(e)\n\t}\n\t// Expire only the original access deadline, not the underlying login.\n\tf.exec(`UPDATE chat_image_bundles SET principal_json=JSON_SET(principal_json,'$.ExpiresAt','2020-01-01T00:00:00Z')`)\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 4; i++ {\n\t\twg.Add(1)\n\t\tgo func() { defer wg.Done(); _, _ = m.Publish(ctx, v.IntentID) }()\n\t}\n\twg.Wait()\n\tr, e := s.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif e != nil || r.State != \"accepted\" {\n\t\tt.Fatal(\"access expiry canceled confirmation\", r, e)\n\t}\n\tvar count int\n\tf.root.QueryRow(\"SELECT COUNT(*) FROM chat_messages\").Scan(&count)\n\tif count != 1 {\n\t\tt.Fatal(\"duplicate publication\")\n\t}\n}\nfunc TestS17StrictManifest(t *testing.T) {\n\tq := Request{ConversationID: \"1\", ClientMessageID: client(1), MessageType: \"image_album\", Revision: 1, Items: []MediaItem{{AttachmentID: \"1\", ObjectVersion: strings.Repeat(\"a\", 64), Ordinal: 0}, {AttachmentID: \"2\", ObjectVersion: strings.Repeat(\"b\", 64), Ordinal: 1}}}\n\tb, _ := json.Marshal(q)\n\tif _, e := decodeMediaSend(b); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor _, raw := range []string{strings.Replace(string(b), `\"ordinal\":0`, `\"ordinal\":0,\"ordinal\":1`, 1), strings.Replace(string(b), `\"items\":[`, `\"unknown\":1,\"items\":[`, 1), strings.Replace(string(b), `\"ordinal\":0`, `\"ordinal\":null`, 1), strings.Replace(string(b), `,\"ordinal\":0`, \"\", 1)} {\n\t\tif _, e := decodeMediaSend([]byte(raw)); e == nil {\n\t\t\tt.Fatal(\"ambiguous manifest accepted\")\n\t\t}\n\t}\n\tq.Items[1].AttachmentID = \"1\"\n\tif _, e := mediaFingerprint(q); !errors.Is(e, ports.ErrInvalid) {\n\t\tt.Fatal(\"duplicate attachment\", e)\n\t}\n}\n\nfunc TestS17FingerprintBindsEveryItemAndSource(t *testing.T) {\n\tq := Request{ConversationID: \"1\", ClientMessageID: client(1), MessageType: \"image_album\", Revision: 1, Items: []MediaItem{{AttachmentID: \"1\", ObjectVersion: strings.Repeat(\"a\", 64), Ordinal: 0}, {AttachmentID: \"2\", ObjectVersion: strings.Repeat(\"b\", 64), Ordinal: 1}}}\n\tfirst, e := mediaFingerprint(q)\n\tif e != nil || first == mediaHash(nil) {\n\t\tt.Fatal(\"empty/invalid structural encoding\", e)\n\t}\n\tchanged := q\n\tchanged.Items = append([]MediaItem(nil), q.Items...)\n\tchanged.Items[0].ObjectVersion = strings.Repeat(\"c\", 64)\n\tsecond, e := mediaFingerprint(changed)\n\tif e != nil || first == second {\n\t\tt.Fatal(\"object version missing from fingerprint\")\n\t}\n\tchanged = q\n\tchanged.ReplyTo = \"7\"\n\tchanged.ReplyItem = \"2\"\n\tthird, e := mediaFingerprint(changed)\n\tif e != nil || first == third {\n\t\tt.Fatal(\"source missing from fingerprint\")\n\t}\n\tchanged = q\n\tchanged.Revision = 2\n\tfourth, e := mediaFingerprint(changed)\n\tif e != nil || first == fourth {\n\t\tt.Fatal(\"revision missing from fingerprint\")\n\t}\n}\n\nfunc TestMySQLS16ReviewLeaseAuthorityAndCancelledAccess(t *testing.T) {\n\tf, s, m, storage, q := mediaFixture(t)\n\tctx := context.Background()\n\tq.Items = []MediaItem{mediaAdd(t, m, storage, q.ConversationID, 1, \"construction\")}\n\tmediaProcess(t, m, 1)\n\tif _, e := s.Send(ctx, principal(\"10202\"), q); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tm.Advance(ctx)\n\tlist, e := m.Reviews(ctx, mediaAdmin(), \"0\")\n\tif e != nil || len(list) != 1 {\n\t\tt.Fatal(list, e)\n\t}\n\tadmin := mediaAdmin()\n\tadmin.Scopes = []string{\"chat:audit\", \"chat:moderate\"}\n\tif _, e = m.Reviews(ctx, admin, \"0\"); e == nil {\n\t\tt.Fatal(\"generic moderator lacks distinct prereview grant\")\n\t}\n\tv, e := m.Review(ctx, mediaAdmin(), list[0].IntentID, list[0].Version, \"claim\", \"逐图检查\", false, false)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = m.Review(ctx, mediaAdmin(), v.IntentID, list[0].Version, \"reject\", \"旧版本拒绝\", false, false); e != ErrMediaVersion {\n\t\tt.Fatal(\"stale decision\", e)\n\t}\n\tif _, e = m.Status(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID, true); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = m.ReviewURL(ctx, mediaAdmin(), v.IntentID, v.Version, q.Items[0].AttachmentID); e == nil {\n\t\tt.Fatal(\"canceled intent granted a fresh review URL\")\n\t}\n\tf.exec(\"UPDATE chat_admin_sessions SET revoked_at=UTC_TIMESTAMP() WHERE id=90001\")\n\tif _, e = m.Reviews(ctx, mediaAdmin(), \"0\"); e == nil {\n\t\tt.Fatal(\"revoked reviewer\")\n\t}\n}\n","chat/internal/imagepipeline/helper_test.go":"package imagepipeline\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"image\"\n\t\"image/color\"\n\t\"image/png\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc helperFixture(t *testing.T) *Helper {\n\tt.Helper()\n\tif os.Getenv(\"CHAT_IMAGE_HELPER_TEST\") != \"1\" {\n\t\tt.Skip(\"explicit offline helper fixture\")\n\t}\n\tphp, e := exec.LookPath(\"php\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpython, e := exec.LookPath(\"python3\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ta, _ := filepath.Abs(\"../../../server/bin/chat-images.php\")\n\tb, _ := filepath.Abs(\"../../helpers/images/inspect.py\")\n\treturn &Helper{PHP: php, Python: python, PHPScript: a, PythonScript: b, TempRoot: t.TempDir(), MaxBytes: 1048576, MaxEdge: 1600}\n}\nfunc TestOfflineImagePipelineAndBudgets(t *testing.T) {\n\th := helperFixture(t)\n\tim := image.NewRGBA(image.Rect(0, 0, 800, 600))\n\tfor y := 0; y < 600; y++ {\n\t\tfor x := 0; x < 800; x++ {\n\t\t\tim.Set(x, y, color.RGBA{byte(x % 200), byte(y % 200), 150, 255})\n\t\t}\n\t}\n\tvar b bytes.Buffer\n\tpng.Encode(&b, im)\n\tout, e := h.Process(context.Background(), b.Bytes())\n\tif e != nil || out.QRStatus != \"completed\" || out.QRDecision != \"clear\" || out.OCRStatus != \"not_run\" || out.Width != 800 {\n\t\tt.Fatalf(\"real pipeline %+v %v\", out, e)\n\t}\n\tif _, e = h.Process(context.Background(), []byte(\"not an image\")); e == nil {\n\t\tt.Fatal(\"invalid bytes\")\n\t}\n\tctx, cancel := context.WithCancel(context.Background())\n\tcancel()\n\tif _, e = h.Process(ctx, b.Bytes()); e == nil {\n\t\tt.Fatal(\"cancel ignored\")\n\t}\n\tentries, _ := os.ReadDir(h.TempRoot)\n\tif len(entries) != 0 {\n\t\tt.Fatal(\"temporary files retained\")\n\t}\n\tt.Logf(\"offline processed main=%d thumb=%d method=%s QR=%s\", len(out.Main), len(out.Thumb), out.Method, out.QRVersion)\n}\nfunc TestOfflineQRClassificationMetadataAndNoCloud(t *testing.T) {\n\th := helperFixture(t)\n\tscript := `import io,sys,zxingcpp\nfrom PIL import Image\nim=Image.fromarray(zxingcpp.create_barcode(sys.argv[1],zxingcpp.BarcodeFormat.QRCode).to_image(scale=8))\nim.save(sys.stdout.buffer,format=\"PNG\")`\n\t// ZXing image implements the buffer protocol; Pillow can wrap via frombytes\n\t// without numpy, which is deliberately absent from the pinned dependency set.\n\n\tfor _, v := range []struct{ text, want string }{{\"weixin://private-friend\", \"blocked\"}, {\"wxp://private-payment\", \"blocked\"}, {\"6901234567890\", \"clear\"}, {\"https://materials.example.invalid/batch/123\", \"review\"}} {\n\t\traw, e := exec.Command(h.Python, \"-c\", script, v.text).Output()\n\t\tif e != nil {\n\t\t\tt.Fatal(\"QR fixture\", e)\n\t\t}\n\t\tout, e := h.Process(context.Background(), raw)\n\t\tif e != nil || out.QRDecision != v.want {\n\t\t\tt.Fatalf(\"QR %s => %s %v\", v.text, out.QRDecision, e)\n\t\t}\n\t}\n\t// EXIF description/GPS-related container is stripped without re-encoding JPEG.\n\tscript = `import sys\nfrom PIL import Image\nim=Image.new(\"RGB\",(640,480),\"white\")\nexif=Image.Exif();exif[270]=\"private location\"\nim.save(sys.stdout.buffer,format=\"JPEG\",exif=exif)`\n\traw, e := exec.Command(h.Python, \"-c\", script).Output()\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tstart := time.Now()\n\tout, e := h.Process(context.Background(), raw)\n\tif e != nil || bytes.Contains(out.Main, []byte(\"private location\")) || bytes.Contains(out.Main, []byte(\"Exif\")) {\n\t\tt.Fatal(\"metadata retained\", e)\n\t}\n\tt.Logf(\"metadata/QR full pipeline duration=%s\", time.Since(start))\n}\nfunc TestQiniuPrivateKeyPolicy(t *testing.T) {\n\tconfig := QiniuConfig{Private: true, Bucket: \"fixture-bucket\", AccessKey: \"fixture-ak\", SecretKey: \"fixture-sk\", Environment: \"test\", DownloadOrigin: \"https://private.example.invalid\", UploadOrigin: \"https://up-z2.qiniup.com\"}\n\tq, e := NewQiniu(config)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tkey := \"chat/test/123/\" + strings.Repeat(\"a\", 64) + \"/source\"\n\ttoken, _, e := q.Grant(context.Background(), key, 123)\n\tif e != nil || token == \"\" {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = q.Sign(context.Background(), key, 61*time.Second); e == nil {\n\t\tt.Fatal(\"long URL\")\n\t}\n\tfor _, key := range []string{\"https://localhost/a\", \"chat/production/123/\" + strings.Repeat(\"a\", 64) + \"/source\", \"../../etc/passwd\"} {\n\t\tif _, _, e = q.Grant(context.Background(), key, 123); e == nil {\n\t\t\tt.Fatal(\"foreign key\")\n\t\t}\n\t}\n\tconfig.Private = false\n\tif _, e = NewQiniu(config); e == nil {\n\t\tt.Fatal(\"public bucket\")\n\t}\n\tconfig.Private = true\n\tconfig.DownloadOrigin = \"https://127.0.0.1\"\n\tif _, e = NewQiniu(config); e == nil {\n\t\tt.Fatal(\"private URL\")\n\t}\n}\n","server/app/Services/ImageOptimizerService.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Services;\n\nuse RuntimeException;\n\n/**\n * 服务器 API 图片统一处理器。\n *\n * 策略：先保留原格式并尝试无损优化；只有超过长边或最终容量限制时才缩放。\n * 缩放时不降低编码质量，避免原来“所有图片转 JPEG、质量逐级降到 72”的清晰度损失。\n * 旧云开发图片导入有独立历史兼容链路，故不由本服务接管。\n */\nfinal class ImageOptimizerService\n{\n    /**\n     * @return array{path:string,storage_key:string,mime_type:string,extension:string,size_bytes:int,width_px:int,height_px:int,sha256:string,compression_quality:?int,method:string}\n     */\n    public function optimize(string $sourcePath): array\n    {\n        if (!is_file($sourcePath) || !is_readable($sourcePath)) {\n            throw new RuntimeException('待处理的图片不存在或不可读。');\n        }\n        $info = @getimagesize($sourcePath);\n        if (!is_array($info) || empty($info[0]) || empty($info[1])) {\n            throw new RuntimeException('仅支持有效的 JPG、PNG、WEBP 图片。');\n        }\n        $mime = strtolower((string) ($info['mime'] ?? ''));\n        $extensions = ['image/jpeg' => 'jpg', 'image/png' => 'png', 'image/webp' => 'webp'];\n        if (!isset($extensions[$mime])) {\n            throw new RuntimeException('仅支持 JPG、PNG、WEBP 图片。');\n        }\n\n        $width = (int) $info[0];\n        $height = (int) $info[1];\n        $maxEdge = max(800, min(2400, (int) \\setting('media.max_long_edge_px', 1600)));\n        $maxBytes = max(10240, min(20 * 1024 * 1024, (int) \\setting('media.max_file_bytes', 1048576)));\n        $folder = 'uploads/' . gmdate('Y/m');\n        $directory = \\base_path('storage/private/' . $folder);\n        if (!is_dir($directory) && !@mkdir($directory, 0775, true) && !is_dir($directory)) {\n            throw new RuntimeException('服务器图片目录不可写。');\n        }\n\n        $name = bin2hex(random_bytes(16)) . '.' . $extensions[$mime];\n        $path = $directory . DIRECTORY_SEPARATOR . $name;\n        $method = 'original';\n        $quality = null;\n        try {\n            if (!@copy($sourcePath, $path)) {\n                throw new RuntimeException('图片暂存失败。');\n            }\n            $losslessTool = $this->runLosslessOptimizer($path, $mime);\n            if ($losslessTool !== '') {\n                $method = 'lossless-' . $losslessTool;\n            }\n\n            $currentSize = is_file($path) ? (int) filesize($path) : 0;\n            if (max($width, $height) > $maxEdge || $currentSize > $maxBytes) {\n                if (!function_exists('imagecreatetruecolor')) {\n                    throw new RuntimeException('图片需要缩放，但服务器未安装 GD 图片扩展。');\n                }\n                [$width, $height] = $this->resizeUntilWithinLimit($path, $mime, $width, $height, $maxEdge, $maxBytes);\n                $method = 'resize-quality-100' . ($losslessTool !== '' ? '-after-lossless' : '');\n                $quality = 100;\n            }\n\n            $size = is_file($path) ? (int) filesize($path) : 0;\n            if ($size < 1 || $size > $maxBytes) {\n                throw new RuntimeException('图片无损优化或必要缩放后仍超过服务器容量限制，请裁剪后重新上传。');\n            }\n            $sha = hash_file('sha256', $path);\n            if (!is_string($sha) || $sha === '') {\n                throw new RuntimeException('图片摘要生成失败。');\n            }\n            return [\n                'path' => $path,\n                'storage_key' => $folder . '/' . $name,\n                'mime_type' => $mime,\n                'extension' => $extensions[$mime],\n                'size_bytes' => $size,\n                'width_px' => $width,\n                'height_px' => $height,\n                'sha256' => $sha,\n                'compression_quality' => $quality,\n                'method' => $method,\n            ];\n        } catch (\\Throwable $exception) {\n            if (is_file($path)) @unlink($path);\n            throw $exception;\n        }\n    }\n\n    /**\n     * 使用固定命令调用服务器上已安装的无损工具。命令名不来自用户输入。\n     * 返回空字符串表示工具未安装，调用方继续保留原始文件格式和字节内容。\n     */\n    private function runLosslessOptimizer(string $path, string $mime): string\n    {\n        // 服务器可能出于安全策略禁用 proc_open；无损工具属于可选优化，禁用时安全回退到原格式。\n        if (!function_exists('proc_open')) return '';\n        $commands = [];\n        if ($mime === 'image/jpeg') {\n            $commands = [\n                ['name' => 'jpegoptim', 'command' => 'jpegoptim --strip-all --all-progressive --quiet ' . escapeshellarg($path)],\n            ];\n        } elseif ($mime === 'image/png') {\n            $commands = [\n                ['name' => 'oxipng', 'command' => 'oxipng -o 4 --strip safe --quiet ' . escapeshellarg($path)],\n                ['name' => 'optipng', 'command' => 'optipng -o7 -strip all -quiet ' . escapeshellarg($path)],\n            ];\n        } elseif ($mime === 'image/webp') {\n            // cwebp 必须输出到临时文件，成功后再原子替换，避免输入输出同路径导致原图损坏。\n            $temporary = $path . '.lossless.webp';\n            $commands = [\n                ['name' => 'cwebp-lossless', 'command' => 'cwebp -lossless -quiet ' . escapeshellarg($path) . ' -o ' . escapeshellarg($temporary), 'temporary_path' => $temporary],\n            ];\n        }\n        foreach ($commands as $item) {\n            $temporary = (string) ($item['temporary_path'] ?? '');\n            $pipes = [];\n            $process = @proc_open($item['command'], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);\n            if (!is_resource($process)) {\n                if ($temporary !== '' && is_file($temporary)) @unlink($temporary);\n                continue;\n            }\n            if (isset($pipes[1]) && is_resource($pipes[1])) @fclose($pipes[1]);\n            if (isset($pipes[2]) && is_resource($pipes[2])) @fclose($pipes[2]);\n            $status = proc_close($process);\n            if ($status === 0 && $temporary !== '' && is_file($temporary) && (int) filesize($temporary) > 0) {\n                // WebP 转无损后有可能比原文件更大；只在确实缩小或等大时替换，始终保留更优结果。\n                $originalSize = is_file($path) ? (int) filesize($path) : 0;\n                $optimizedSize = (int) filesize($temporary);\n                if ($originalSize > 0 && $optimizedSize <= $originalSize && @rename($temporary, $path) && is_file($path) && (int) filesize($path) > 0) return (string) $item['name'];\n            }\n            if ($temporary !== '' && is_file($temporary)) @unlink($temporary);\n            if ($status === 0 && $temporary === '' && is_file($path) && (int) filesize($path) > 0) return (string) $item['name'];\n        }\n        return '';\n    }\n\n    /** @return array{0:int,1:int} */\n    private function resizeUntilWithinLimit(string $path, string $mime, int $sourceWidth, int $sourceHeight, int $maxEdge, int $maxBytes): array\n    {\n        $scale = min(1.0, $maxEdge / max($sourceWidth, $sourceHeight));\n        $minimumEdge = 640;\n        $lastWidth = max(1, (int) round($sourceWidth * $scale));\n        $lastHeight = max(1, (int) round($sourceHeight * $scale));\n        for ($attempt = 0; $attempt < 10; $attempt++) {\n            $lastWidth = max(1, (int) round($sourceWidth * $scale));\n            $lastHeight = max(1, (int) round($sourceHeight * $scale));\n            $this->resizeOne($path, $mime, $lastWidth, $lastHeight);\n            $this->runLosslessOptimizer($path, $mime);\n            if (is_file($path) && (int) filesize($path) <= $maxBytes) return [$lastWidth, $lastHeight];\n            if (max($lastWidth, $lastHeight) <= $minimumEdge) break;\n            $scale *= 0.82;\n        }\n        throw new RuntimeException('图片必要缩放后仍超过服务器容量限制，请裁剪后重新上传。');\n    }\n\n    private function resizeOne(string $path, string $mime, int $width, int $height): void\n    {\n        $source = @imagecreatefromstring((string) @file_get_contents($path));\n        if (!$source) throw new RuntimeException('图片解码失败，无法完成必要缩放。');\n        $sourceWidth = imagesx($source);\n        $sourceHeight = imagesy($source);\n        $canvas = imagecreatetruecolor($width, $height);\n        if (!$canvas) {\n            imagedestroy($source);\n            throw new RuntimeException('图片缩放画布创建失败。');\n        }\n        if ($mime === 'image/jpeg') {\n            $background = imagecolorallocate($canvas, 255, 255, 255);\n            imagefill($canvas, 0, 0, $background);\n        } else {\n            imagealphablending($canvas, false);\n            imagesavealpha($canvas, true);\n            $transparent = imagecolorallocatealpha($canvas, 0, 0, 0, 127);\n            imagefill($canvas, 0, 0, $transparent);\n        }\n        imagecopyresampled($canvas, $source, 0, 0, 0, 0, $width, $height, $sourceWidth, $sourceHeight);\n        if ($mime === 'image/jpeg') {\n            $saved = imagejpeg($canvas, $path, 100);\n        } elseif ($mime === 'image/png') {\n            $saved = imagepng($canvas, $path, 9);\n        } else {\n            $saved = function_exists('imagewebp') && imagewebp($canvas, $path, 100);\n        }\n        imagedestroy($source);\n        imagedestroy($canvas);\n        if (!$saved || !is_file($path)) throw new RuntimeException('图片缩放保存失败。');\n    }\n}\n","server/app/Http/Admin/Modules/ChatImageReviewAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n\n/** PHP provides an authorized page only. All review state is owned by Go. */\nfinal class ChatImageReviewAdminModule implements AdminModule\n{\n    private Auth $auth;\n    public function __construct(Database $db, Auth $auth, Csrf $csrf) { $this->auth = $auth; }\n    public function supports(string $route): bool { return $route === 'chat.image-review'; }\n    public function dispatch(string $route): void\n    {\n        $this->auth->requirePermission('chat.images.review');\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'GET') {\n            http_response_code(405); throw new \\RuntimeException('该页面只接受 GET 请求。');\n        }\n        echo \\view('admin/chat-image-review', ['pageTitle'=>'聊天图片预审','activeMenu'=>'chat.image-review']);\n    }\n}\n","server/app/Http/Admin/AdminKernel.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AdminAccountAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ChatCredentialAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ChatImageReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AgreedRefundExecutionAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AgreementAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\AuditAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ContactRevealReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\DisputeReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ExceptionDashboardAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\FailedRefundRecoveryAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\FinanceAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\HelpCenterAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\MeasurementHoldReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\PlatformOrderAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\PlatformOrderFinanceAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RealNameAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderCancellationRiskAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RefundReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RepairInterventionAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ReviewAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\SchedulerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\MessageOutboxAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\RuntimeLogAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ConfigurationSettingsAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\ServiceCategoryAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\OrderFormDesignerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\TestCenterAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\UserMerchantAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\WorkerAdminModule;\nuse WorkerAdmin\\Http\\Admin\\Modules\\LegacyAdminModule;\n\n/** 后台模块组合根。 */\nfinal class AdminKernel\n{\n    /** @var AdminModule[] */\n    private array $modules;\n    private AdminRequestGuard $guard;\n\n    /** @param AdminModule[]|null $modules */\n    public function __construct(Database $db, Auth $auth, Csrf $csrf, ?array $modules = null)\n    {\n        $this->guard = new AdminRequestGuard($auth, $csrf);\n        $this->modules = $modules ?: [\n            new AdminAccountAdminModule($db, $auth, $csrf),\n            new ChatCredentialAdminModule($db, $auth, $csrf),\n            new ChatImageReviewAdminModule($db, $auth, $csrf),\n            new ExceptionDashboardAdminModule($db, $auth, $csrf),\n            new RefundReviewAdminModule($db, $auth, $csrf),\n            new DisputeReviewAdminModule($db, $auth, $csrf),\n            new AuditAdminModule($db, $auth, $csrf),\n            new ContactRevealReviewAdminModule($db, $auth, $csrf),\n            new MeasurementHoldReviewAdminModule($db, $auth, $csrf),\n            new RepairInterventionAdminModule($db, $auth, $csrf),\n            new AgreementAdminModule($db, $auth, $csrf),\n            new HelpCenterAdminModule($db, $auth, $csrf),\n            new RealNameAdminModule($db, $auth, $csrf),\n            new OrderCancellationRiskAdminModule($db, $auth, $csrf),\n            new SchedulerAdminModule($db, $auth, $csrf),\n            new AgreedRefundExecutionAdminModule($db, $auth, $csrf),\n            new FailedRefundRecoveryAdminModule($db, $auth, $csrf),\n            new PlatformOrderFinanceAdminModule($db, $auth, $csrf),\n            new PlatformOrderAdminModule($db, $auth, $csrf),\n            new MessageOutboxAdminModule($db, $auth, $csrf),\n            new RuntimeLogAdminModule($db, $auth, $csrf),\n            new TestCenterAdminModule($db, $auth, $csrf),\n            new ConfigurationSettingsAdminModule($db,$auth,$csrf),\n            new ServiceCategoryAdminModule($db,$auth,$csrf),\n            new OrderFormDesignerAdminModule($db,$auth,$csrf),\n            new UserMerchantAdminModule($db,$auth,$csrf),\n            new ReviewAdminModule($db,$auth,$csrf),\n            new WorkerAdminModule($db,$auth,$csrf),\n            // 最后一块旧网页订单路由由正式模块接管；Legacy 只保留 staged 旧 handler 的物理代码。\n            new OrderAdminModule($db,$auth,$csrf),\n            new FinanceAdminModule($db,$auth,$csrf),\n            new LegacyAdminModule($db, $auth, $csrf),\n        ];\n    }\n\n    public function dispatch(string $route): void\n    {\n        try {\n            $this->guard->inspect($route);\n        } catch (RuntimeException $exception) {\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) === 'POST') {\n                \\flash('danger', $exception->getMessage());\n                \\redirect(\\admin_url('dashboard'));\n            }\n            throw $exception;\n        }\n        foreach ($this->modules as $module) {\n            if (!$module instanceof AdminModule || !$module->supports($route)) continue;\n            $module->dispatch($route);\n            return;\n        }\n        throw new RuntimeException('后台路由不存在');\n    }\n}\n\n","server/app/Core/Auth.php":"<?php\n\nnamespace WorkerAdmin\\Core;\n\nuse RuntimeException;\n\nclass Auth\n{\n    private $db;\n    private $userLoaded = false;\n    private $user;\n\n    private $permissions = [\n        'operations' => ['chat.images.review', 'dashboard.view', 'orders.manage', 'workers.manage', 'users.view', 'users.manage', 'catalog.manage', 'help.manage', 'reviews.manage', 'disputes.manage', 'audit.view'],\n        'finance' => ['dashboard.view', 'orders.view', 'payments.manage', 'refunds.manage', 'commissions.manage', 'withdrawals.manage', 'audit.view'],\n        'viewer' => ['dashboard.view', 'orders.view', 'users.view'],\n    ];\n\n    public function __construct(Database $db)\n    {\n        $this->db = $db;\n    }\n\n    // 2026-08-14：登录包含失败锁定、会话轮换和密码哈希升级。\n    public function attempt($username, $password)\n    {\n        $username = trim((string) $username);\n        $user = $this->db->fetch('SELECT * FROM admin_users WHERE username = :username LIMIT 1', ['username' => $username]);\n        if (!$user || !in_array((string) $user['status'], ['active', '1'], true)) {\n            return false;\n        }\n\n        if (!empty($user['locked_until']) && strtotime($user['locked_until'] . ' UTC') > time()) {\n            throw new RuntimeException('登录失败次数过多，请稍后再试。');\n        }\n\n        if (!password_verify((string) $password, $user['password_hash'])) {\n            $attempts = (int) $user['failed_attempts'] + 1;\n            $max = (int) \\app_config('security.login_max_attempts', 5);\n            // 2026-08-14：锁定时间按 UTC 写库，与订单及审计时间约定保持一致。\n            $lockedUntil = $attempts >= $max ? gmdate('Y-m-d H:i:s', time() + ((int) \\app_config('security.login_lock_minutes', 15) * 60)) : null;\n            $this->db->execute('UPDATE admin_users SET failed_attempts=:attempts, locked_until=:locked_until, updated_at=NOW() WHERE id=:id', [\n                'attempts' => $attempts, 'locked_until' => $lockedUntil, 'id' => $user['id'],\n            ]);\n            return false;\n        }\n\n        if (password_needs_rehash($user['password_hash'], PASSWORD_BCRYPT, ['cost' => 12])) {\n            $this->db->execute('UPDATE admin_users SET password_hash=:hash WHERE id=:id', [\n                'hash' => password_hash((string) $password, PASSWORD_BCRYPT, ['cost' => 12]), 'id' => $user['id'],\n            ]);\n        }\n\n        $this->revokeChatIdentity();\n        session_regenerate_id(true);\n        $_SESSION['admin_id'] = (int) $user['id'];\n        $_SESSION['admin_login_at'] = time();\n        $this->db->execute('UPDATE admin_users SET failed_attempts=0, locked_until=NULL, last_login_at=NOW(), last_login_ip=:ip, updated_at=NOW() WHERE id=:id', [\n            'ip' => \\request_ip(), 'id' => $user['id'],\n        ]);\n        $this->userLoaded = false;\n        $this->user = null;\n        \\csrf()->rotate();\n        return true;\n    }\n\n    public function user()\n    {\n        if ($this->userLoaded) {\n            return $this->user;\n        }\n        $this->userLoaded = true;\n        if (empty($_SESSION['admin_id'])) {\n            return $this->user = null;\n        }\n        // 2026-08-14：管理员表不保存手机号，避免查询不存在字段导致登录后页面报错。\n        $this->user = $this->db->fetch('SELECT id, username, real_name, role, status, must_change_password, last_login_at, last_login_ip, created_at FROM admin_users WHERE id=:id LIMIT 1', ['id' => (int) $_SESSION['admin_id']]);\n        if (!$this->user || !in_array((string) $this->user['status'], ['active', '1'], true)) {\n            $this->logout();\n            return null;\n        }\n        return $this->user;\n    }\n\n    public function check()\n    {\n        return $this->user() !== null;\n    }\n\n    public function logout()\n    {\n        $this->revokeChatIdentity();\n        $this->user = null;\n        $this->userLoaded = true;\n        unset($_SESSION['admin_id'], $_SESSION['admin_login_at']);\n        if (session_status() === PHP_SESSION_ACTIVE) {\n            session_regenerate_id(true);\n        }\n    }\n\n    private function revokeChatIdentity(): void\n    {\n        if (empty($_SESSION['chat_admin_session_id'])) return;\n        try {\n            $this->db->execute('UPDATE chat_admin_sessions SET revoked_at=COALESCE(revoked_at,UTC_TIMESTAMP()) WHERE id=:id AND admin_id=:admin_id',\n                ['id'=>(string)$_SESSION['chat_admin_session_id'],'admin_id'=>(string)($_SESSION['admin_id'] ?? '0')]);\n        } catch (\\Throwable $error) {\n            // Don't report successful logout if persistent chat revocation failed.\n            throw new RuntimeException('聊天会话暂时无法撤销，请稍后再试。');\n        }\n        unset($_SESSION['chat_admin_session_id']);\n    }\n\n    public function can($permission)\n    {\n        $user = $this->user();\n        if (!$user) {\n            return false;\n        }\n        if ($user['role'] === 'super_admin') {\n            return true;\n        }\n        $grants = isset($this->permissions[$user['role']]) ? $this->permissions[$user['role']] : [];\n        if (in_array($permission, $grants, true)) {\n            return true;\n        }\n        if (substr($permission, -5) === '.view') {\n            return in_array(str_replace('.view', '.manage', $permission), $grants, true);\n        }\n        return false;\n    }\n\n    public function requireLogin()\n    {\n        if (!$this->check()) {\n            \\redirect(\\admin_url('login'));\n        }\n    }\n\n    public function requirePermission($permission)\n    {\n        $this->requireLogin();\n        if (!$this->can($permission)) {\n            http_response_code(403);\n            echo \\view('errors/403', ['pageTitle' => '无权访问']);\n            exit;\n        }\n    }\n}\n\n","server/app/Application/Chat/ChatCredentialIssuer.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Application\\Chat;\n\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\Auth;\n\n/** Only exchanges an existing PHP identity; never creates a login or touches last_seen. */\nfinal class ChatCredentialIssuer\n{\n    private Database $db;\n    private array $config;\n    private string $environment;\n\n    public function __construct(Database $db, array $config, string $phpEnvironment)\n    {\n        $this->db = $db;\n        $this->config = $config;\n        $this->environment = ['testing'=>'test','development'=>'development','production'=>'production'][$phpEnvironment] ?? '';\n    }\n\n    public function exchangeMini(string $token): array\n    {\n        $this->assertEnabled();\n        if (preg_match('/^[A-Fa-f0-9]{64}$/D', $token) !== 1) throw new RuntimeException('请重新登录', 401);\n        // Match the original persisted login authority. Proxy/test identities stay closed until S21.\n        $row = $this->db->fetch(\n            \"SELECT CAST(s.id AS CHAR) source_id,CAST(s.user_id AS CHAR) user_id,s.token_hash,\n                    UNIX_TIMESTAMP(s.expires_at) expires_unix\n             FROM login_sessions s JOIN users u ON u.id=s.user_id AND u.status='active'\n             WHERE s.token_hash=:token_hash AND s.status='active' AND s.expires_at>UTC_TIMESTAMP()\n               AND COALESCE(s.demo_actor_user_id,0)=0 AND COALESCE(s.test_actor_user_id,0)=0\n               AND COALESCE(s.test_instance_id,0)=0 AND s.test_actor_expires_at IS NULL LIMIT 1\",\n            ['token_hash'=>hash('sha256', $token)]\n        );\n        if (!$row) throw new RuntimeException('登录状态已失效，请重新进入', 401);\n        $source = $this->id($row['source_id']);\n        $actor = $this->id($row['user_id']);\n        $hash = (string)$row['token_hash'];\n        if (preg_match('/^[a-f0-9]{64}$/D', $hash) !== 1) throw new RuntimeException('聊天身份暂不可用', 503);\n        return $this->issue([\n            'sub'=>$actor,'kind'=>'mini','source_id'=>$source,\n            'session_id'=>hash('sha256', \"mini\\n\".$source.\"\\n\".$hash),\n            'session_version'=>hash('sha256', \"mini-v1\\n\".$source.\"\\n\".$hash.\"\\n\".$actor),\n            'scopes'=>['chat:use'],\n        ], (int)$row['expires_unix']);\n    }\n\n    private function assertEnabled(): void\n    {\n        if (($this->config['enabled'] ?? false) !== true || $this->environment === '') {\n            throw new RuntimeException('聊天凭证交换未启用', 503);\n        }\n    }\n\n    public function exchangeAdmin(Auth $auth): array\n    {\n        $this->assertEnabled();\n        if (session_status() !== PHP_SESSION_ACTIVE || session_id() === '') throw new RuntimeException('请重新登录', 401);\n        $admin = $auth->user();\n        if (!$admin) throw new RuntimeException('请重新登录', 401);\n        if (!empty($admin['must_change_password']) || !$auth->can('audit.view')) throw new RuntimeException('当前账号无聊天审计权限', 403);\n        $scopes = ['chat:audit'];\n        if ($auth->can('users.manage')) $scopes[] = 'chat:moderate';\n        if ($auth->can('chat.images.review')) $scopes[] = 'chat:images';\n        $scopeJSON = json_encode($scopes, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);\n        $adminID = $this->id($admin['id']);\n        $sessionHash = hash('sha256', \"admin\\n\".$this->environment.\"\\n\".session_id());\n        $deadline = (int)($_SESSION['_last_activity'] ?? time()) + max(1, (int)\\app_config('security.session_lifetime',7200));\n        $expiry = min(time()+300, $deadline);\n        if ($expiry <= time()) throw new RuntimeException('请重新登录',401);\n        $expectedRole = (string)$admin['role'];\n        $row = $this->db->transaction(function() use($adminID,$sessionHash,$scopeJSON,$expiry,$expectedRole): array {\n            $current = $this->db->fetch(\"SELECT CAST(id AS CHAR) id,role,password_hash FROM admin_users WHERE id=:id AND status IN ('active','1') AND must_change_password=0 FOR UPDATE\",['id'=>$adminID]);\n            if (!$current) throw new RuntimeException('请重新登录',401);\n            if ((string)$current['role'] !== $expectedRole) throw new RuntimeException('后台权限已变化，请刷新页面',403);\n            $authority = hash('sha256', \"admin-v1\\n\".$adminID.\"\\n\".(string)$current['role'].\"\\n\".(string)$current['password_hash'].\"\\n\".$scopeJSON);\n            $this->db->execute(\n                \"INSERT INTO chat_admin_sessions(admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at)\n                 VALUES(:admin_id,:session_hash,:version,:authority,:scopes,:expires,UTC_TIMESTAMP())\n                 ON DUPLICATE KEY UPDATE session_version=IF(revoked_at IS NOT NULL OR authority_hash<>VALUES(authority_hash),VALUES(session_version),session_version),\n                 authority_hash=VALUES(authority_hash),scopes_json=VALUES(scopes_json),expires_at=VALUES(expires_at),revoked_at=NULL\",\n                ['admin_id'=>$adminID,'session_hash'=>$sessionHash,'version'=>bin2hex(random_bytes(32)),\n                 'authority'=>$authority,'scopes'=>$scopeJSON,'expires'=>gmdate('Y-m-d H:i:s',$expiry)]\n            );\n            $row = $this->db->fetch('SELECT CAST(id AS CHAR) source_id,session_version,revoked_at FROM chat_admin_sessions WHERE session_hash=:hash AND admin_id=:admin_id LIMIT 1', ['hash'=>$sessionHash,'admin_id'=>$adminID]);\n            if (!$row || $row['revoked_at'] !== null) throw new RuntimeException('请重新登录',401);\n            return $row;\n        });\n        $_SESSION['chat_admin_session_id'] = $this->id($row['source_id']);\n        return $this->issue(['sub'=>$adminID,'kind'=>'admin','source_id'=>$this->id($row['source_id']),\n            'session_id'=>$sessionHash,'session_version'=>(string)$row['session_version'],'scopes'=>$scopes],$expiry);\n    }\n\n    private function id($value): string\n    {\n        $id = (string)$value;\n        if (preg_match('/^[1-9][0-9]{0,19}$/D', $id) !== 1 || strlen($id) === 20 && strcmp($id, '18446744073709551615') > 0) {\n            throw new RuntimeException('聊天身份暂不可用', 503);\n        }\n        return $id;\n    }\n\n    private function issue(array $identity, int $sessionExpiry): array\n    {\n        $kid = (string)($this->config['key_id'] ?? '');\n        $name = (string)($this->config['seed_env'] ?? '');\n        if (preg_match('/^[a-z0-9_-]{1,32}$/D', $kid) !== 1 || preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D', $name) !== 1 || !function_exists('sodium_crypto_sign_seed_keypair')) {\n            throw new RuntimeException('聊天凭证配置不可用', 503);\n        }\n        $encoded = getenv($name);\n        $seed = is_string($encoded) ? base64_decode($encoded, true) : false;\n        if (!is_string($seed) || strlen($seed) !== SODIUM_CRYPTO_SIGN_SEEDBYTES || base64_encode($seed) !== $encoded) {\n            throw new RuntimeException('聊天凭证配置不可用', 503);\n        }\n        $now = time();\n        $expires = min($now + 300, $sessionExpiry);\n        if ($expires <= $now) throw new RuntimeException('登录状态已失效，请重新进入', 401);\n        $claims = array_merge($identity, [\n            'iss'=>'bixuan-php:'.$this->environment,'aud'=>'bixuan-chat','env'=>$this->environment,\n            'iat'=>$now,'nbf'=>$now,'exp'=>$expires,'jti'=>bin2hex(random_bytes(32)),\n        ]);\n        $header = ['alg'=>'EdDSA','typ'=>'JWT','kid'=>$kid];\n        $input = $this->base64url(json_encode($header, JSON_THROW_ON_ERROR)).'.'.$this->base64url(json_encode($claims, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES));\n        $pair = sodium_crypto_sign_seed_keypair($seed);\n        sodium_memzero($seed);\n        $secret = sodium_crypto_sign_secretkey($pair);\n        $signature = sodium_crypto_sign_detached($input, $secret);\n        sodium_memzero($secret);\n        sodium_memzero($pair);\n        return ['access_token'=>$input.'.'.$this->base64url($signature),'token_type'=>'Bearer',\n            'expires_at'=>gmdate('Y-m-d\\TH:i:s\\Z', $expires),'expires_in'=>$expires-$now];\n    }\n\n    private function base64url(string $value): string { return rtrim(strtr(base64_encode($value), '+/', '-_'), '='); }\n}\n","chat/internal/message/media_reports.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n\t\"unicode/utf8\"\n)\n\n// Report binds either the whole image message (item=0) or a stable item.\n// It creates one pending governance case, never blocks content by report count.\nfunc (m *MediaService) Report(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, reason string) (ports.ID, error) {\n\tif !validID(cid) || !validID(mid) || item != \"\" && !validID(item) || !utf8.ValidString(reason) || utf8.RuneCountInString(reason) < 2 || utf8.RuneCountInString(reason) > 200 {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, e := m.base.begin(ctx)\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tdefer tx.Rollback()\n\tg, e := m.base.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif e != nil {\n\t\treturn \"\", e\n\t}\n\tvar found ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR) FROM chat_messages m WHERE m.id=? AND m.conversation_id=? AND m.message_type IN ('image','image_album') AND `+retainedTarget+` AND `+visibleColumn, string(mid), string(cid), string(g.Version), string(p.ActorID)).Scan(&found) != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tvar count int\n\tif item != \"\" {\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_image_items WHERE message_id=? AND item_id=?`, string(mid), string(item)).Scan(&count) != nil || count != 1 {\n\t\t\treturn \"\", ErrMedia\n\t\t}\n\t}\n\tif item == \"\" {\n\t\titem = \"0\"\n\t}\n\tvar existing ports.ID\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_image_reports WHERE reporter_id=? AND message_id=? AND item_id=?`, string(p.ActorID), string(mid), string(item)).Scan(&existing)\n\tif err == nil {\n\t\tif tx.Commit() != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t\treturn existing, nil\n\t}\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_image_reports WHERE reporter_id=? AND created_at>UTC_TIMESTAMP()-INTERVAL 1 DAY`, string(p.ActorID)).Scan(&count) != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif count >= 20 {\n\t\treturn \"\", ports.ErrBusy\n\t}\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_image_reports(reporter_id,conversation_id,message_id,item_id,reason,created_at) VALUES(?,?,?,?,?,UTC_TIMESTAMP(6))`, string(p.ActorID), string(cid), string(mid), string(item), reason)\n\tif e != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tid, e := res.LastInsertId()\n\tif e != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\t// A report protects all versions in this ordered message pending governance.\n\tif _, e = tx.ExecContext(ctx, `UPDATE chat_image_uploads u JOIN chat_image_items i ON i.item_id=u.id SET u.legal_hold=1 WHERE i.message_id=?`, string(mid)); e != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif !time.Now().Before(p.ExpiresAt) || tx.Commit() != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn decimal(uint64(id)), nil\n}\n","chat/internal/imagepipeline/config.go":"package imagepipeline\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n)\n\ntype Config struct {\n\tEnabled        bool   `json:\"enabled\"`\n\tMode           string `json:\"mode\"`\n\tBucket         string `json:\"bucket\"`\n\tPrivate        bool   `json:\"private_bucket\"`\n\tAccessKeyEnv   string `json:\"access_key_env\"`\n\tSecretKeyEnv   string `json:\"secret_key_env\"`\n\tDownloadOrigin string `json:\"download_origin\"`\n\tUploadOrigin   string `json:\"upload_origin\"`\n\tPHP            string `json:\"php_binary\"`\n\tPython         string `json:\"python_binary\"`\n\tPHPScript      string `json:\"php_script\"`\n\tPythonScript   string `json:\"python_script\"`\n\tTempRoot       string `json:\"temp_root\"`\n\tMaxBytes       int    `json:\"max_file_bytes\"`\n\tMaxEdge        int    `json:\"max_long_edge_px\"`\n}\n\n// Build is used by explicit isolated composition roots. The application's\n// release gate still rejects images.enabled until S21/S22 deployment review.\nfunc Build(c Config, env string, base *message.Service) (*message.MediaService, error) {\n\tif !c.Enabled {\n\t\treturn nil, nil\n\t}\n\tnames := regexp.MustCompile(`^CHAT_[A-Z0-9_]{1,60}$`)\n\tif c.Mode != \"manual_precheck\" || !names.MatchString(c.AccessKeyEnv) || !names.MatchString(c.SecretKeyEnv) || !filepath.IsAbs(c.TempRoot) || c.MaxBytes < 10240 || c.MaxBytes > message.MaxImageBytes || c.MaxEdge < 800 || c.MaxEdge > 2400 {\n\t\treturn nil, message.ErrMedia\n\t}\n\tfor _, path := range []string{c.PHP, c.Python, c.PHPScript, c.PythonScript} {\n\t\tinfo, e := os.Stat(path)\n\t\tif !filepath.IsAbs(path) || e != nil || !info.Mode().IsRegular() {\n\t\t\treturn nil, message.ErrMedia\n\t\t}\n\t}\n\tinfo, e := os.Stat(c.TempRoot)\n\tif e != nil || !info.IsDir() {\n\t\treturn nil, message.ErrMedia\n\t}\n\tstorage, e := NewQiniu(QiniuConfig{Bucket: c.Bucket, AccessKey: os.Getenv(c.AccessKeyEnv), SecretKey: os.Getenv(c.SecretKeyEnv), Private: c.Private, DownloadOrigin: c.DownloadOrigin, UploadOrigin: c.UploadOrigin, Environment: env})\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\thelper := &Helper{PHP: c.PHP, Python: c.Python, PHPScript: c.PHPScript, PythonScript: c.PythonScript, TempRoot: c.TempRoot, MaxBytes: c.MaxBytes, MaxEdge: c.MaxEdge}\n\treturn message.NewMediaService(base, storage, helper, env)\n}\n","chat/config.example.json":"{\n  \"env\": \"development\",\n  \"http\": {\n    \"listen\": \"127.0.0.1:19501\",\n    \"internal_listen\": \"127.0.0.1:19502\"\n  },\n  \"shutdown_timeout\": \"10s\",\n  \"log_level\": \"info\",\n  \"provider_mode\": \"disabled\",\n  \"dependencies\": {\n    \"operation_timeout\": \"500ms\",\n    \"probe_interval\": \"10s\",\n    \"external_concurrency\": 4,\n    \"mysql\": {\n      \"enabled\": false,\n      \"address\": \"127.0.0.1:3306\",\n      \"database\": \"\",\n      \"username\": \"\",\n      \"password_env\": \"CHAT_MYSQL_PASSWORD\",\n      \"max_open_serve\": 4,\n      \"max_open_worker\": 2,\n      \"max_idle\": 1\n    },\n    \"redis\": {\n      \"enabled\": false,\n      \"address\": \"127.0.0.1:6379\",\n      \"key_prefix\": \"bxchat:development:\",\n      \"password_env\": \"\",\n      \"pool_serve\": 2,\n      \"pool_worker\": 1\n    }\n  },\n  \"auth\": {\n    \"enabled\": false,\n    \"public_keys\": {}\n  },\n  \"conversations\": {\n    \"enabled\": false\n  },\n  \"messages\": {\n    \"enabled\": false\n  },\n  \"socket\": {\n    \"enabled\": false\n  },\n  \"history\": {\n    \"enabled\": false,\n    \"cursor_key_env\": \"\"\n  },\n  \"safety\": {\n    \"enabled\": false,\n    \"app_id\": \"\",\n    \"credential_file\": \"\"\n  },\n  \"images\": {\n    \"enabled\": false,\n    \"mode\": \"manual_precheck\",\n    \"private_bucket\": true,\n    \"bucket\": \"\",\n    \"access_key_env\": \"CHAT_QINIU_ACCESS_KEY\",\n    \"secret_key_env\": \"CHAT_QINIU_SECRET_KEY\",\n    \"download_origin\": \"\",\n    \"upload_origin\": \"https://up-z2.qiniup.com\",\n    \"php_binary\": \"\",\n    \"python_binary\": \"\",\n    \"php_script\": \"\",\n    \"python_script\": \"\",\n    \"temp_root\": \"\",\n    \"max_file_bytes\": 1048576,\n    \"max_long_edge_px\": 1600\n  }\n}\n","server/tests/chat_identity_contract.php":"<?php\n\ndeclare(strict_types=1);\n\n// Standalone PHP 7.4+ contract; optional real MySQL fixture is explicitly opted in.\nrequire_once dirname(__DIR__).'/app/Core/Database.php';\nrequire_once dirname(__DIR__).'/app/Core/Auth.php';\nrequire_once dirname(__DIR__).'/app/Core/Csrf.php';\nrequire_once dirname(__DIR__).'/app/Http/Admin/AdminRequestGuard.php';\nrequire_once dirname(__DIR__).'/app/Application/Chat/ChatCredentialIssuer.php';\n\nuse WorkerAdmin\\Application\\Chat\\ChatCredentialIssuer;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Http\\Admin\\AdminRequestGuard;\n\n$config = ['enabled'=>true,'key_id'=>'chat-v1','seed_env'=>'CHAT_ACCESS_SEED'];\n\nif (in_array(($argv[1] ?? ''), ['--issue-mini','--issue-admin','--logout-admin'],true)) {\n    if (getenv('CHAT_AUTH_TEST_INTEGRATION') !== '1') exit(2);\n    $host = (string)getenv('CHAT_AUTH_TEST_MYSQL_HOST');\n    $database = (string)getenv('CHAT_AUTH_TEST_MYSQL_DATABASE');\n    if ($host !== '127.0.0.1' || strpos($database, 'bixuan_test_auth_') !== 0) exit(2);\n    $db = new Database(['host'=>$host,'port'=>(int)getenv('CHAT_AUTH_TEST_MYSQL_PORT'),\n        'database'=>$database,'username'=>(string)getenv('CHAT_AUTH_TEST_MYSQL_USER'),\n        'password'=>(string)getenv('CHAT_AUTH_TEST_MYSQL_PASSWORD'),'charset'=>'utf8mb4']);\n    try {\n        $issuer = new ChatCredentialIssuer($db, $config, 'testing');\n        if ($argv[1] === '--issue-mini') {\n            $result = $issuer->exchangeMini((string)getenv('CHAT_AUTH_TEST_LOGIN_TOKEN'));\n        } else {\n            $folder = (string)getenv('CHAT_AUTH_TEST_SESSION_DIR');\n            if (!is_dir($folder)) exit(2);\n            session_save_path($folder);\n            session_id((string)getenv('CHAT_AUTH_TEST_SESSION_ID'));\n            session_start();\n            if ($argv[1] === '--issue-admin') {\n                $_SESSION['admin_id']='2'; $_SESSION['_last_activity']=time();\n                $result = $issuer->exchangeAdmin(new Auth($db));\n            } else {\n                (new Auth($db))->logout(); $result=['revoked'=>true];\n            }\n        }\n        echo json_encode($result, JSON_THROW_ON_ERROR);\n    } catch (Throwable $error) { fwrite(STDERR, \"fixture exchange failed\\n\"); exit(1); }\n    exit;\n}\n\nfunction app_config($key, $default=null) { return $default; }\n\nfinal class ChatIdentityFixtureDatabase extends Database\n{\n    public ?array $row;\n    public int $reads = 0;\n    public function __construct() { $this->row = ['source_id'=>'7','user_id'=>'18446744073709551615',\n        'token_hash'=>hash('sha256', str_repeat('a',64)),'expires_unix'=>time()+60]; }\n    public function fetch($sql, array $params = []) {\n        $this->reads++;\n        if (strpos($sql, 'SELECT ') !== 0 || array_keys($params) !== ['token_hash']) throw new RuntimeException('unexpected source access');\n        return $this->row;\n    }\n    public function execute($sql, array $params = []) { throw new RuntimeException('identity must never write'); }\n}\n\nfunction ensure(bool $ok, string $message): void { if (!$ok) throw new RuntimeException($message); }\nfunction rejected(callable $fn, int $status): void { try { $fn(); } catch (RuntimeException $e) { ensure($e->getCode() === $status, 'unexpected status'); return; } throw new RuntimeException('unexpected acceptance'); }\n\n$seed = random_bytes(32);\nputenv('CHAT_ACCESS_SEED='.base64_encode($seed));\n$db = new ChatIdentityFixtureDatabase();\n$issuer = new ChatCredentialIssuer($db, $config, 'testing');\n$result = $issuer->exchangeMini(str_repeat('a',64));\n$parts = explode('.', $result['access_token']);\n$decode = static function(string $s): string { return (string)base64_decode(strtr($s,'-_','+/')); };\n$claims = json_decode($decode($parts[1]), true, 32, JSON_THROW_ON_ERROR);\nensure($claims['sub'] === '18446744073709551615' && $claims['source_id'] === '7', 'IDs lost precision');\nensure($claims['env'] === 'test' && $claims['scopes'] === ['chat:use'], 'authority mismatch');\nensure($claims['exp'] <= time()+60 && $claims['exp'] > time(), 'source expiry not respected');\n$public = sodium_crypto_sign_publickey(sodium_crypto_sign_seed_keypair($seed));\nensure(sodium_crypto_sign_verify_detached($decode($parts[2]),$parts[0].'.'.$parts[1],$public), 'signature mismatch');\nrejected(static function() use($issuer): void { $issuer->exchangeMini('invalid'); },401);\n$db->row = null;\nrejected(static function() use($issuer): void { $issuer->exchangeMini(str_repeat('a',64)); },401);\n$db->row = ['source_id'=>'1','user_id'=>'1','token_hash'=>str_repeat('a',64),'expires_unix'=>time()+60];\nputenv('CHAT_ACCESS_SEED=bad-secret');\nrejected(static function() use($issuer): void { $issuer->exchangeMini(str_repeat('a',64)); },503);\nrejected(static function() use($db,$config): void { (new ChatCredentialIssuer($db,$config,'test'))->exchangeMini(str_repeat('a',64)); },503);\nrejected(static function() use($db): void { (new ChatCredentialIssuer($db,['enabled'=>false],'production'))->exchangeMini(str_repeat('a',64)); },503);\nputenv('CHAT_ACCESS_SEED');\n\nfinal class ChatResponse extends RuntimeException\n{\n    public array $payload;\n    public function __construct(array $payload,int $status) { parent::__construct('fixture response',$status);$this->payload=$payload; }\n}\nfunction json_response(array $payload,$status=200) { throw new ChatResponse($payload,(int)$status); }\nfunction request_id() { return 'fixture-request'; }\nfinal class ChatGuardAuth extends Auth\n{\n    public bool $loggedIn=true;\n    public bool $changePassword=false;\n    public function __construct() {}\n    public function check() { return $this->loggedIn; }\n    public function user() { return ['must_change_password'=>$this->changePassword]; }\n}\n$guardAuth=new ChatGuardAuth();$guard=new AdminRequestGuard($guardAuth,new Csrf());\n$_SESSION['_csrf_token']=str_repeat('a',64);$_SERVER['REQUEST_METHOD']='POST';$_POST=[];\nrejected(static function()use($guard):void{$guard->inspect('chat.credentials');},403);\n$_SERVER['HTTP_X_CSRF_TOKEN']=str_repeat('a',64);$guard->inspect('chat.credentials');\n$guardAuth->loggedIn=false;rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},401);\n$guardAuth->loggedIn=true;$guardAuth->changePassword=true;rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},403);\n$_SERVER['REQUEST_METHOD']='GET';rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},405);\n$_SESSION=['admin_id'=>'2','chat_admin_session_id'=>'1'];\ntry { (new Auth(new ChatIdentityFixtureDatabase()))->logout(); throw new RuntimeException('logout bypassed revocation failure'); }\ncatch(RuntimeException $error) { ensure(isset($_SESSION['admin_id'],$_SESSION['chat_admin_session_id']), 'failed logout discarded revocation evidence'); }\necho \"聊天身份PHP契约通过\\n\";\n","server/app/Core/Csrf.php":"<?php\n\nnamespace WorkerAdmin\\Core;\n\nuse RuntimeException;\n\nclass Csrf\n{\n    // 2026-08-14：所有后台写操作统一使用会话 CSRF 令牌。\n    public function token()\n    {\n        if (empty($_SESSION['_csrf_token'])) {\n            $_SESSION['_csrf_token'] = bin2hex(random_bytes(32));\n        }\n        return $_SESSION['_csrf_token'];\n    }\n\n    public function input()\n    {\n        return '<input type=\"hidden\" name=\"_token\" value=\"' . \\e($this->token()) . '\">';\n    }\n\n    public function validate($token)\n    {\n        return is_string($token) && hash_equals($this->token(), $token);\n    }\n\n    public function verifyRequest()\n    {\n        $token = isset($_POST['_token']) ? $_POST['_token'] : (isset($_SERVER['HTTP_X_CSRF_TOKEN']) ? $_SERVER['HTTP_X_CSRF_TOKEN'] : '');\n        if (!$this->validate($token)) {\n            throw new RuntimeException('页面已过期，请刷新后重试。');\n        }\n    }\n\n    public function rotate()\n    {\n        $_SESSION['_csrf_token'] = bin2hex(random_bytes(32));\n        return $_SESSION['_csrf_token'];\n    }\n}\n","server/app/Http/Admin/AdminRequestGuard.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\n\nfinal class AdminRequestGuard\n{\n    private Auth $auth;\n    private Csrf $csrf;\n\n    public function __construct(Auth $auth, Csrf $csrf)\n    {\n        $this->auth = $auth;\n        $this->csrf = $csrf;\n    }\n\n    public function inspect(string $route): void\n    {\n        if ($route === 'chat.credentials') {\n            $status = 0;\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {\n                header('Allow: POST'); $status = 405;\n            } elseif (!$this->auth->check()) { $status = 401;\n            } elseif (!empty($this->auth->user()['must_change_password'])) { $status = 403;\n            } else {\n                try { $this->csrf->verifyRequest(); } catch (\\RuntimeException $error) { $status = 403; }\n            }\n            if ($status) \\json_response(['ok'=>false,'code'=>$status===401?'CHAT_UNAUTHORIZED':($status===405?'CHAT_METHOD_NOT_ALLOWED':'CHAT_FORBIDDEN'),\n                'message'=>'请刷新页面后重试','retryable'=>false,'request_id'=>\\request_id(),'server_time'=>gmdate('Y-m-d\\TH:i:s\\Z')],$status);\n            return;\n        }\n        if ($route === 'login') return;\n        $this->auth->requireLogin();\n        $user = $this->auth->user();\n        if (!empty($user['must_change_password']) && !in_array($route, ['profile','profile.password','logout'], true)) {\n            \\flash('warning', '首次登录必须先修改演示密码。');\n            \\redirect(\\admin_url('profile'));\n        }\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) === 'POST') {\n            $this->csrf->verifyRequest();\n        }\n    }\n}\n\n"},"encodings":{"server/tests/fixtures/schema-2.6.0.sql.gz":"base64"},"blob_shas":{"chat/build.sh":"c9d2e8c654fac590d6533b2dfaa9d6e31e3d1aaa","chat/cmd/chatd/main.go":"ecd53d4d9b8d37dd714e8148a8e606a52801870f","chat/go.mod":"9e5d6b33a9a9fd732dcd518a1e8a8a3c7af2deba","chat/go.sum":"fb24675236722882b2484e1d8be224fa18a08a0e","chat/internal/auth/auth_test.go":"ee4c10778cc9abd6326ed781f4e924379c137eb3","chat/internal/auth/config.go":"0e0744e04da056a2450467411c08