',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','clicked_faq_id','点击问答ID','点击问答ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('help_search_logs','created_at','创建时间','创建时间',UTC_TIMESTAMP(),UTC_TIMESTAMP());\n\n-- V2.4.0 migration end.\n","server/database/upgrades/2.4.1.sql":"-- V2.4.1：微信 OCR 完整字段加密留存、后台 OCR 管理与本地额度计数。\n-- MySQL 5.7.44；可重复执行；不改动既有认证状态与已审核资料。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_241_ocr_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_241_ocr_schema`()\nBEGIN\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='worker_real_name_verifications' AND column_name='ocr_payload_ciphertext'\n  ) THEN\n    ALTER TABLE `worker_real_name_verifications`\n      ADD COLUMN `ocr_payload_ciphertext` LONGTEXT COLLATE utf8mb4_unicode_ci NULL COMMENT '微信OCR完整结果加密JSON' AFTER `id_number_hmac`;\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='worker_real_name_verifications' AND column_name='ocr_provider'\n  ) THEN\n    ALTER TABLE `worker_real_name_verifications`\n      ADD COLUMN `ocr_provider` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT 'OCR服务来源' AFTER `ocr_payload_ciphertext`;\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='worker_real_name_verifications' AND column_name='ocr_updated_at'\n  ) THEN\n    ALTER TABLE `worker_real_name_verifications`\n      ADD COLUMN `ocr_updated_at` DATETIME NULL COMMENT 'OCR资料最后更新时间' AFTER `ocr_provider`;\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='merchant_profiles' AND column_name='ocr_payload_ciphertext'\n  ) THEN\n    ALTER TABLE `merchant_profiles`\n      ADD COLUMN `ocr_payload_ciphertext` LONGTEXT COLLATE utf8mb4_unicode_ci NULL COMMENT '营业执照OCR完整结果加密JSON' AFTER `license_media_file_id`;\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='merchant_profiles' AND column_name='ocr_provider'\n  ) THEN\n    ALTER TABLE `merchant_profiles`\n      ADD COLUMN `ocr_provider` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT '' COMMENT 'OCR服务来源' AFTER `ocr_payload_ciphertext`;\n  END IF;\n\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='merchant_profiles' AND column_name='ocr_updated_at'\n  ) THEN\n    ALTER TABLE `merchant_profiles`\n      ADD COLUMN `ocr_updated_at` DATETIME NULL COMMENT 'OCR资料最后更新时间' AFTER `ocr_provider`;\n  END IF;\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns\n    WHERE table_schema=DATABASE() AND table_name='form_schema_versions' AND column_name='ui_config_json'\n  ) THEN\n    ALTER TABLE `form_schema_versions`\n      ADD COLUMN `ui_config_json` LONGTEXT COLLATE utf8mb4_unicode_ci NULL COMMENT '表单版本前端展示配置JSON' AFTER `snapshot_json`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_241_ocr_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_241_ocr_schema`;\n\nCREATE TABLE IF NOT EXISTS `ocr_usage_logs` (\n  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `client_msg_id` varchar(80) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '小程序调用服务市场时的唯一请求编号',\n  `user_id` BIGINT UNSIGNED NOT NULL COMMENT '调用用户ID',\n  `worker_id` BIGINT UNSIGNED NULL COMMENT '师傅ID，商家认证可为空',\n  `scene` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'realname_front/realname_back/merchant_license',\n  `ocr_type` tinyint unsigned NOT NULL COMMENT '服务市场OCR类型：1身份证、7营业执照',\n  `status` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'success' COMMENT '本地记录状态',\n  `quota_day` date NOT NULL COMMENT '微信服务市场额度归属日（Asia/Shanghai）',\n  `result_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '结果摘要SHA256，不保存明文识别内容',\n  `created_at` datetime NOT NULL COMMENT '创建时间UTC',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_ocr_usage_client_msg` (`client_msg_id`),\n  KEY `idx_ocr_usage_day_status` (`quota_day`,`status`),\n  KEY `idx_ocr_usage_user_time` (`user_id`,`created_at`),\n  KEY `idx_ocr_usage_worker_time` (`worker_id`,`created_at`),\n  KEY `idx_ocr_usage_scene_day` (`scene`,`quota_day`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='微信服务市场OCR本地调用计数';\n\n-- 默认沿用该服务公开资料中的 100 次/日免费额度；实际套餐变化时只调整此设置。\nINSERT INTO `system_settings`\n(`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n('wechat.ocr.daily_quota','100','integer','wechat',0,'微信服务市场OCR每日额度；后台剩余次数按本地成功调用记录估算，服务市场后台为最终准数',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `description`=VALUES(`description`),`updated_at`=`updated_at`;\n\n-- 门店手机号公开与师傅手机号会员权限分离：开启后普通登录用户即可查看已审核公开门店的手机号。\nINSERT INTO `system_settings`\n(`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n('store.phone_public_enabled','0','boolean','feature',0,'门店手机号公开：开启后已审核公开门店的手机号无需会员即可查看；关闭后接口不返回手机号',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=`updated_at`;\n\nINSERT INTO `database_field_dictionary`\n(`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('worker_real_name_verifications','ocr_payload_ciphertext','实名认证OCR完整数据','身份证正反面微信OCR的标准字段与原始完整回包，加密保存',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','ocr_provider','实名认证OCR来源','wechat_service_market=微信服务市场OCR',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','ocr_updated_at','实名认证OCR更新时间','最后一次完整OCR资料写入时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('merchant_profiles','ocr_payload_ciphertext','营业执照OCR完整数据','营业执照微信OCR的标准字段与原始完整回包，加密保存',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('merchant_profiles','ocr_provider','营业执照OCR来源','wechat_service_market=微信服务市场OCR',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('merchant_profiles','ocr_updated_at','营业执照OCR更新时间','最后一次完整OCR资料写入时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('ocr_usage_logs','client_msg_id','OCR请求编号','微信服务市场调用唯一请求编号，用于幂等计数',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('ocr_usage_logs','quota_day','OCR额度日期','按Asia/Shanghai归属的每日额度日期',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('ocr_usage_logs','result_digest','OCR结果摘要','完整结果SHA256摘要；调用台账不保存证件明文',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('form_schema_versions','ui_config_json','表单版本展示配置','下单表单版本级前端展示配置JSON，如默认收起非必填资料',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings`\nSET `setting_value`='2.4.1',`updated_at`=UTC_TIMESTAMP()\nWHERE `setting_key`='app.version';\n\nSELECT '2.4.1' AS version, '微信OCR、门店手机号公开设置与本地额度计数升级完成' AS message;","server/database/upgrades/2.5.0.sql":"-- V2.5.0：评价模块正式采用“服务态度 / 施工手艺”双维度评分。\n-- 当前环境尚未正式运营，因此运行时代码不保留旧 rating 兼容；升级时仅做一次性旧行搬迁后删除旧列。\n-- MySQL 5.7 幂等语句逐条执行；DDL 中断须人工核对后恢复，不允许自动整段重试。\nSET NAMES utf8mb4;\n\nSET @v250_attitude_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='reviews' AND COLUMN_NAME='attitude_rating'\n);\nSET @v250_attitude_ddl := IF(\n  @v250_attitude_exists > 0,\n  'SELECT 1',\n  'ALTER TABLE `reviews` ADD COLUMN `attitude_rating` tinyint unsigned NULL COMMENT ''服务态度评分：1-5星'''\n);\nPREPARE v250_attitude_stmt FROM @v250_attitude_ddl;\nEXECUTE v250_attitude_stmt;\nDEALLOCATE PREPARE v250_attitude_stmt;\n\nSET @v250_craft_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='reviews' AND COLUMN_NAME='craft_rating'\n);\nSET @v250_craft_ddl := IF(\n  @v250_craft_exists > 0,\n  'SELECT 1',\n  'ALTER TABLE `reviews` ADD COLUMN `craft_rating` tinyint unsigned NULL COMMENT ''施工手艺评分：1-5星'''\n);\nPREPARE v250_craft_stmt FROM @v250_craft_ddl;\nEXECUTE v250_craft_stmt;\nDEALLOCATE PREPARE v250_craft_stmt;\n\nSET @v250_rating_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='reviews' AND COLUMN_NAME='rating'\n);\n\n-- 只在升级阶段搬迁旧演示/测试评价；完成后代码和结构均不再依赖 rating。\nSET @v250_backfill_sql := IF(\n  @v250_rating_exists > 0,\n  'UPDATE `reviews` SET `attitude_rating`=COALESCE(`attitude_rating`,`rating`,5),`craft_rating`=COALESCE(`craft_rating`,`rating`,5)',\n  'UPDATE `reviews` SET `attitude_rating`=COALESCE(`attitude_rating`,5),`craft_rating`=COALESCE(`craft_rating`,5)'\n);\nPREPARE v250_backfill_stmt FROM @v250_backfill_sql;\nEXECUTE v250_backfill_stmt;\nDEALLOCATE PREPARE v250_backfill_stmt;\n\nALTER TABLE `reviews`\n  MODIFY COLUMN `attitude_rating` tinyint unsigned NOT NULL COMMENT '服务态度评分：1-5星',\n  MODIFY COLUMN `craft_rating` tinyint unsigned NOT NULL COMMENT '施工手艺评分：1-5星';\n\nSET @v250_rating_ddl := IF(@v250_rating_exists > 0, 'ALTER TABLE `reviews` DROP COLUMN `rating`', 'SELECT 1');\nPREPARE v250_rating_stmt FROM @v250_rating_ddl;\nEXECUTE v250_rating_stmt;\nDEALLOCATE PREPARE v250_rating_stmt;\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('review.quick_phrases','[\"服务态度好\",\"沟通耐心\",\"准时上门\",\"施工专业\",\"手艺细致\",\"现场整洁\",\"效果满意\",\"值得推荐\"]','json','review',0,'订单评价快捷短句；后台可增删调整，前端不再硬编码',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nDELETE FROM `database_field_dictionary`\nWHERE `table_name`='reviews' AND `field_name` IN ('rating','attitude_rating','craft_rating');\nINSERT INTO `database_field_dictionary`\n  (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nVALUES\n  ('reviews','attitude_rating','服务态度评分','订单评价服务态度星级，必填 1-5 星',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('reviews','craft_rating','施工手艺评分','订单评价施工手艺星级，必填 1-5 星；综合分由两个维度实时计算，不单独存储',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- V2.5.0：平台承接单继续复用统一 orders 主档，只增加来源专属条件与结构化开单明细。\nCREATE TABLE IF NOT EXISTS `order_platform_terms` (\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `customer_flow_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'platform_managed' COMMENT '客户参与方式：platform_managed平台托管、miniapp_booking小程序预约',\n  `customer_pricing_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'fixed_total' COMMENT '客户计价方式：fixed_total固定总价、itemized明细计价',\n  `customer_contract_total_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户当前最终成交金额（分）',\n  `worker_settlement_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'worker_collect' COMMENT '师傅工费结算：worker_collect师傅代收、platform_balance平台余额',\n  `worker_labor_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '当前最终师傅工费（分）',\n  `extra_income_rate_bp_snapshot` int(10) unsigned NOT NULL DEFAULT '2000' COMMENT '订单外加项平台收入比例快照（万分比）',\n  `booking_paid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '最终结算时平台已收预约费快照（分）',\n  `customer_tail_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '客户现场剩余应付（分）',\n  `platform_receivable_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '平台收入款待收金额（分）',\n  `worker_balance_credit_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '应进入师傅余额金额（分）',\n  `worker_balance_freeze_days_snapshot` smallint(5) unsigned NOT NULL DEFAULT '0' COMMENT '师傅余额冻结天数快照',\n  `settlement_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '平台承接单结算状态',\n  `settled_at` datetime DEFAULT NULL COMMENT '结算完成时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`order_id`),\n  KEY `idx_platform_terms_settlement` (`settlement_status`,`updated_at`),\n  CONSTRAINT `fk_platform_terms_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单专属计价与结算条件';\n\nSET @v250_customer_flow_mode_exists := (\n  SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS\n  WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='order_platform_terms' AND COLUMN_NAME='customer_flow_mode'\n);\nSET @v250_customer_flow_mode_ddl := IF(\n  @v250_customer_flow_mode_exists > 0,\n  'SELECT 1',\n  'ALTER TABLE `order_platform_terms` ADD COLUMN `customer_flow_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT ''platform_managed'' COMMENT ''客户参与方式：platform_managed平台托管、miniapp_booking小程序预约'' AFTER `order_id`'\n);\nPREPARE v250_customer_flow_mode_stmt FROM @v250_customer_flow_mode_ddl;\nEXECUTE v250_customer_flow_mode_stmt;\nDEALLOCATE PREPARE v250_customer_flow_mode_stmt;\n\nCREATE TABLE IF NOT EXISTS `order_pricing_items` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `item_source` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'base' COMMENT '明细来源：base基础开单、change订单外加项',\n  `change_request_id` bigint(20) unsigned DEFAULT NULL COMMENT '关联费用调整申请ID',\n  `description` varchar(160) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '施工项目/描述',\n  `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '项目说明',\n  `quantity` decimal(12,3) DEFAULT NULL COMMENT '数量/实际用量',\n  `unit` varchar(24) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '计价单位',\n  `unit_price_cents` bigint(20) unsigned DEFAULT NULL COMMENT '单价（分）',\n  `amount_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '项目金额（分）',\n  `sort_order` int(11) NOT NULL DEFAULT '0' COMMENT '排序值',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  KEY `idx_pricing_items_order_sort` (`order_id`,`status`,`sort_order`,`id`),\n  KEY `idx_pricing_items_change` (`change_request_id`),\n  CONSTRAINT `fk_pricing_items_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_pricing_items_change` FOREIGN KEY (`change_request_id`) REFERENCES `change_requests` (`id`) ON DELETE SET NULL ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='V2.5.0 平台承接单结构化开单明细';\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('platform_order.extra_income_rate_bp','2000','integer','platform_order',0,'平台承接单订单外加项平台收入比例（万分比），默认20%',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order.worker_balance_freeze_days','0','integer','platform_order',0,'平台余额结算工费冻结天数；0表示验收结算后直接进入可提现余额',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nDELETE FROM `database_field_dictionary`\nWHERE `table_name` IN ('order_platform_terms','order_pricing_items');\n\nINSERT INTO `database_field_dictionary`\n  (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nVALUES\n  ('order_platform_terms','order_id','订单ID','平台承接条件与统一 orders 主档一对一关联',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','customer_flow_mode','客户参与方式','platform_managed 平台托管；miniapp_booking 小程序预约。该字段为唯一事实来源，不根据预约费金额推断',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','customer_pricing_mode','客户计价方式','fixed_total 固定总价；itemized 按结构化项目/实际用量计价',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','customer_contract_total_cents','客户成交金额','客户当前最终成交金额，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','worker_settlement_mode','工费结算方式','worker_collect 师傅代收；platform_balance 平台余额结算',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','worker_labor_cents','师傅工费','当前最终师傅工费，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','extra_income_rate_bp_snapshot','加项平台收入比例','订单外加项平台收入比例快照，万分比',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','booking_paid_cents','已收预约费','最终结算快照中的平台已收预约费，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','customer_tail_cents','客户现场应收','客户现场剩余应付，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','platform_receivable_cents','平台收入款','师傅需支付平台的收入款/平台现场应收，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','worker_balance_credit_cents','师傅余额入账','平台余额结算时应进入师傅余额的金额，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','worker_balance_freeze_days_snapshot','余额冻结天数','平台承接单师傅余额冻结天数快照，0为不冻结',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','settlement_status','结算状态','pending待结算、ready待处理、settled已结算等',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_platform_terms','settled_at','结算完成时间','平台承接单财务结算完成时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','id','自增ID','平台承接单开单明细主键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','order_id','订单ID','所属统一订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','item_source','明细来源','base基础开单；change订单外加项',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','change_request_id','费用调整申请ID','订单外加项对应 change_requests 记录',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','description','施工项目','开单项目名称或描述',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','note','项目说明','项目范围、特殊条件等补充说明',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','quantity','数量','约定或最终实际用量',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','unit','单位','平方米、米、卷、项等',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','unit_price_cents','单价','结构化可计算单价，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','amount_cents','项目金额','服务端根据数量与单价计算或固定录入的金额，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','sort_order','排序值','开单明细显示顺序',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_pricing_items','status','状态','active有效、cancelled取消等',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `system_settings`\n  (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`)\nVALUES\n  ('app.version','2.5.0','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- V2.5.0：已验收平台单成功退款的人工财务复核单；不更改原验收/收款/钱包台账。\nCREATE TABLE IF NOT EXISTS `platform_order_refund_reviews` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '退款财务复核单ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '关联平台承接订单ID',\n  `refund_id` bigint(20) unsigned NOT NULL COMMENT '原真实退款单ID（一退款只处理一次）',\n  `refund_amount_cents` bigint(20) unsigned NOT NULL COMMENT '建档时退款成功金额快照（分）',\n  `worker_labor_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时师傅工费快照（分）',\n  `worker_balance_credit_cents_snapshot` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '验收时实际应入师傅余额快照（分）',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT 'open待判责、awaiting_recovery待实际追偿、resolved核账结束',\n  `responsibility` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'undetermined' COMMENT 'undetermined待定、platform平台、worker师傅、shared分担',\n  `worker_recovery_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '人工判定应由师傅补交金额（分）',\n  `recovered_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '已核对真实到账的线下追偿累计金额（分）',\n  `decision_note` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '责任判定的事实依据',\n  `recovery_reference` varchar(120) COLLATE utf8mb4_bin DEFAULT NULL COMMENT '最近一次已核实的追偿交易流水号（完整逐笔凭证见人工收款台账）',\n  `recovery_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '线下真实追偿核验说明',\n  `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '发起核账管理员ID',\n  `decided_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '判责管理员ID',\n  `resolved_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核实结清管理员ID',\n  `created_at` datetime NOT NULL COMMENT '建档时间',\n  `decided_at` datetime DEFAULT NULL COMMENT '判责时间',\n  `resolved_at` datetime DEFAULT NULL COMMENT '核账结束时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_platform_refund_review_refund` (`refund_id`),\n  UNIQUE KEY `uq_platform_refund_review_recovery` (`recovery_reference`),\n  KEY `idx_platform_refund_review_order_status` (`order_id`,`status`),\n  KEY `idx_platform_refund_review_status_created` (`status`,`created_at`),\n  CONSTRAINT `fk_platform_refund_review_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_platform_refund_review_refund` FOREIGN KEY (`refund_id`) REFERENCES `refunds` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台单已验收后退款资金判责与线下追偿人工核账';\n\nINSERT INTO `database_field_dictionary`\n  (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nVALUES\n  ('platform_order_refund_reviews','id','财务复核编号','每笔成功退款独立建档的自增编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','order_id','平台订单ID','对应统一订单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','refund_id','真实退款ID','一个退款最多建立一个财务复核单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','refund_amount_cents','退款金额快照','原退款成功金额（分）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','worker_labor_cents_snapshot','师傅工费快照','原结算师傅工费（分）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','worker_balance_credit_cents_snapshot','工费入账快照','原师傅余额应入账（分）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','status','复核进度','待判责、待追偿或已核账',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','responsibility','责任归属','平台、师傅或双方共同承担',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','worker_recovery_cents','应追偿师傅金额','人工确认应由师傅补交金额（分）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','recovered_cents','已追偿核实金额','管理员核对真实线下收款后的金额（分）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','decision_note','判责依据','必须记录业务和实际资金责任判定原因',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','recovery_reference','实际追偿流水号','线下已到账资金编号，不能重复登记',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','recovery_note','收款核验说明','线下真实到账核验备注',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','created_by_admin_id','发起管理员ID','退款核账发起人',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','decided_by_admin_id','判责管理员ID','责任分配审核人',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','resolved_by_admin_id','核账管理员ID','实际完成核验的管理员',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','created_at','发起时间','核账建档时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','decided_at','判责时间','责任确定时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','resolved_at','核账完成时间','责任完成核账时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_refund_reviews','updated_at','更新时间','最近操作时间',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nCREATE TABLE IF NOT EXISTS `platform_order_manual_receipts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '实际外部收款凭证ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '所属平台订单',\n  `refund_review_id` bigint(20) unsigned DEFAULT NULL COMMENT '追偿对应退款复核单；平台收入款时为空',\n  `income_order_id` bigint(20) unsigned DEFAULT NULL COMMENT '仅平台收入款填写的订单ID，唯一防重复核销',\n  `receipt_kind` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'platform_income平台收入款、refund_recovery退款追偿',\n  `amount_cents` bigint(20) unsigned NOT NULL COMMENT '本笔人工核验实际到账分数',\n  `payment_reference` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '银行或第三方支付实际收款编号；全类型唯一',\n  `verification_note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '人工核实凭据及渠道说明',\n  `verified_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '核验管理员ID',\n  `verified_at` datetime NOT NULL COMMENT '实际核验记录时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_manual_receipt_reference` (`payment_reference`),\n  UNIQUE KEY `uq_manual_income_order` (`income_order_id`),\n  KEY `idx_manual_receipt_review` (`refund_review_id`,`verified_at`),\n  KEY `idx_manual_receipt_order` (`order_id`,`verified_at`),\n  CONSTRAINT `fk_manual_receipt_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,\n  CONSTRAINT `fk_manual_receipt_review` FOREIGN KEY (`refund_review_id`) REFERENCES `platform_order_refund_reviews` (`id`) ON DELETE CASCADE ON UPDATE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='平台外部收款人工核验逐笔凭证，不代表微信支付或钱包入账';\n\nINSERT IGNORE INTO `platform_order_manual_receipts`\n  (`order_id`,`refund_review_id`,`income_order_id`,`receipt_kind`,`amount_cents`,\n   `payment_reference`,`verification_note`,`verified_by_admin_id`,`verified_at`)\nSELECT v.order_id,v.id,NULL,'refund_recovery',v.recovered_cents,\n       v.recovery_reference,v.recovery_note,v.resolved_by_admin_id,\n       COALESCE(v.resolved_at,UTC_TIMESTAMP())\nFROM `platform_order_refund_reviews` v\nWHERE v.recovered_cents>0 AND v.recovery_reference IS NOT NULL AND v.recovery_reference<>'';\n\nINSERT INTO `database_field_dictionary`\n  (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nVALUES\n  ('platform_order_manual_receipts','id','线下收款凭证ID','人工核验的每一笔外部转账编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','order_id','平台订单ID','实际收款关联统一订单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','refund_review_id','退款核账ID','若为退款线下追偿，关联具体退款核账单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','income_order_id','平台收入唯一订单ID','仅平台收入款写入，用于防止重复核销',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','receipt_kind','实际收款类型','platform_income平台收入款或refund_recovery退款追偿',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','amount_cents','本笔到账金额','管理员核实实际到账金额，单位分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','payment_reference','银行收款流水编号','所有平台人工收款唯一的外部真实交易编号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','verification_note','到账核验备注','实际收款渠道和核对依据',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','verified_by_admin_id','核验管理员ID','实际核对入账的操作人',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('platform_order_manual_receipts','verified_at','核验时间','管理员确认实际到账时间',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_accounts (\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  blocked_until datetime DEFAULT NULL COMMENT '新下单限制结束时间（UTC）',\n  last_restriction_id bigint unsigned DEFAULT NULL COMMENT '最近限制审计ID',\n  updated_at datetime NOT NULL COMMENT '更新时间（UTC）',\n  PRIMARY KEY (user_id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_signals (\n  id bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  order_id bigint unsigned NOT NULL COMMENT '取消订单ID',\n  worker_id bigint unsigned NOT NULL COMMENT '参与师傅ID',\n  signal_type varchar(20) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原操作信号：dialed拨号、contacted预约联系、complaint异常投诉',\n  note varchar(500) NOT NULL DEFAULT '' COMMENT '原提交说明',\n  created_at datetime NOT NULL COMMENT '创建时间（UTC）',\n  revoked_at datetime DEFAULT NULL COMMENT '信号撤销时间',\n  PRIMARY KEY (id),\n  UNIQUE KEY uq_cancel_risk_signal (order_id,worker_id,signal_type)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_scores (\n  order_id bigint unsigned NOT NULL COMMENT '取消订单ID',\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  base_score smallint unsigned NOT NULL DEFAULT 0 COMMENT '取消前报价成交跑空最高分',\n  score smallint unsigned NOT NULL DEFAULT 0 COMMENT '同单所有有效事实最高分',\n  cancelled_at datetime NOT NULL COMMENT '取消成立时间（UTC）',\n  snapshot_json longtext NOT NULL COMMENT '取消事实或处罚规则命中快照',\n  consumed_restriction_id bigint unsigned DEFAULT NULL COMMENT '消耗本单计分的限制ID；防止旧单重复封禁',\n  excluded_at datetime DEFAULT NULL COMMENT '客服或责任裁定排除时间',\n  exclusion_reason varchar(500) DEFAULT NULL COMMENT '计分排除原因',\n  created_at datetime NOT NULL COMMENT '创建时间（UTC）',\n  updated_at datetime NOT NULL COMMENT '更新时间（UTC）',\n  PRIMARY KEY (order_id),\n  KEY idx_cancel_risk_user_time (user_id,cancelled_at),\n  KEY idx_cancel_risk_user_unused (user_id,consumed_restriction_id,excluded_at)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\nCREATE TABLE IF NOT EXISTS order_cancellation_risk_restrictions (\n  id bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  user_id bigint unsigned NOT NULL COMMENT '下单用户ID',\n  starts_at datetime NOT NULL COMMENT '限制开始时间（UTC）',\n  expires_at datetime NOT NULL COMMENT '限制结束时间（UTC）',\n  snapshot_json longtext NOT NULL COMMENT '取消事实或处罚规则命中快照',\n  released_at datetime DEFAULT NULL COMMENT '客服解除时间（UTC）',\n  released_by_admin_id bigint unsigned DEFAULT NULL COMMENT '解除管理员ID',\n  release_reason varchar(500) DEFAULT NULL COMMENT '客服解除核实说明',\n  PRIMARY KEY (id),\n  KEY idx_cancel_risk_restriction_user (user_id,id)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n  ('order_cancellation_risk_accounts','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','blocked_until','新下单限制结束时间（UTC）','新下单限制结束时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','last_restriction_id','最近限制审计ID','最近限制审计ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_accounts','updated_at','更新时间（UTC）','更新时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','order_id','取消订单ID','取消订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','worker_id','参与师傅ID','参与师傅ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','signal_type','原操作信号：dialed拨号、contacted预约联系、complaint异常投诉','原操作信号：dialed拨号、contacted预约联系、complaint异常投诉',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','note','原提交说明','原提交说明',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','created_at','创建时间（UTC）','创建时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_signals','revoked_at','信号撤销时间','信号撤销时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','order_id','取消订单ID','取消订单ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','base_score','取消前报价成交跑空最高分','取消前报价成交跑空最高分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','score','同单所有有效事实最高分','同单所有有效事实最高分',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','cancelled_at','取消成立时间（UTC）','取消成立时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','snapshot_json','取消事实或处罚规则命中快照','取消事实或处罚规则命中快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','consumed_restriction_id','消耗本单计分的限制ID；防止旧单重复封禁','消耗本单计分的限制ID；防止旧单重复封禁',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','excluded_at','客服或责任裁定排除时间','客服或责任裁定排除时间',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','exclusion_reason','计分排除原因','计分排除原因',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','created_at','创建时间（UTC）','创建时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_scores','updated_at','更新时间（UTC）','更新时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','id','自增ID','自增ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','user_id','下单用户ID','下单用户ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','starts_at','限制开始时间（UTC）','限制开始时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','expires_at','限制结束时间（UTC）','限制结束时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','snapshot_json','取消事实或处罚规则命中快照','取消事实或处罚规则命中快照',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','released_at','客服解除时间（UTC）','客服解除时间（UTC）',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','released_by_admin_id','解除管理员ID','解除管理员ID',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('order_cancellation_risk_restrictions','release_reason','客服解除核实说明','客服解除核实说明',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE chinese_name=VALUES(chinese_name),description=VALUES(description),updated_at=UTC_TIMESTAMP();\n\n-- V2.5.0：微信审核/外部体验使用的六类接单大厅演示数据直接随 2.5.0 迁移写入。\n-- 记录保持 is_demo=1；大厅只对 BXDEMOHALL* 开放只读卡片，业务写入口仍由演示/真实数据域隔离。\nSET @demo_user_id := (\n  SELECT u.id FROM users u\n  WHERE u.status='active' AND BINARY u.public_id LIKE BINARY '01K2DEMOV%USER%'\n  ORDER BY u.id DESC LIMIT 1\n);\n\n-- 在线升级逐条自动提交；以下种子写入使用唯一键和重复键更新保持幂等。\n\nINSERT INTO orders\n(public_no,user_id,category_id,workflow_profile,dispatch_mode,expected_fee_type,expected_fee_cents,expected_fee_text,\n category_name_snapshot,category_names_snapshot,title,description,quantity_text,\n city,district,address_summary,lat,lng,order_source_type,audit_status,audited_at,publish_status,\n quote_status,assignment_status,fulfillment_status,payment_status,refund_status,dispute_status,\n lifecycle_status,published_at,quote_deadline_at,booking_fee_cents,is_demo,created_at,updated_at)\nSELECT d.no,@demo_user_id,\n       (SELECT sc.id FROM service_categories sc WHERE sc.status='active' AND sc.name=d.category ORDER BY sc.id ASC LIMIT 1),\n       d.workflow,d.dispatch,d.fee_type,d.fee_cents,d.fee_text,\n       d.category,d.category,d.title,d.description,d.quantity,\n       '杭州市',d.district,d.address,d.lat,d.lng,d.source,'approved',UTC_TIMESTAMP(),'published',\n       'waiting','unassigned','not_started','paid','none','none',\n       'active',UTC_TIMESTAMP(),DATE_ADD(UTC_TIMESTAMP(),INTERVAL 90 DAY),0,1,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM (\n SELECT 'BXDEMOHALL01' no,'construction' workflow,'multi_quote' dispatch,'unit' fee_type,\n        NULL fee_cents,'墙布施工约 25 元/㎡，以现场报价为准' fee_text,'墙布' category,\n        '客厅墙布铺贴' title,'审核演示：新房客厅墙布铺贴，材料已备齐，等待师傅报价' description,\n        '约 68㎡' quantity,'西湖区' district,'文三路附近' address,30.2810 lat,120.1250 lng,'consumer' source\n UNION ALL\n SELECT 'BXDEMOHALL02','construction','single_grab','total',88000,NULL,\n        '墙纸','卧室墙纸安装','审核演示：两间卧室墙纸施工，固定工费，师傅抢单展示','约 42㎡',\n        '拱墅区','湖墅南路附近',30.3150,120.1500,'consumer'\n UNION ALL\n SELECT 'BXDEMOHALL03','measurement','multi_quote','total',15000,NULL,\n        '墙布','墙布上门测量','审核演示：普通用户上门量尺，等待测量师傅报价','两室一厅',\n        '滨江区','江南大道附近',30.2080,120.2100,'consumer'\n UNION ALL\n SELECT 'BXDEMOHALL04','construction','multi_quote','unit',NULL,'墙纸铺贴按实际工程量报价',\n        '墙纸','商家墙纸安装','审核演示：商家客户已确认材料，需要施工师傅报价','约 55㎡',\n        '余杭区','五常大道附近',30.2720,120.0450,'merchant'\n UNION ALL\n SELECT 'BXDEMOHALL05','construction','multi_quote','total',128000,NULL,\n        '墙布','平台承接墙布施工','审核演示：平台承接施工单，客户已线下沟通，等待师傅报价','约 95㎡',\n        '萧山区','市心北路附近',30.2400,120.2600,'platform'\n UNION ALL\n SELECT 'BXDEMOHALL06','measurement','multi_quote','total',20000,NULL,\n        '墙布','平台墙布测量','审核演示：平台承接材料项目，先测量后进入后续施工核价','三室两厅',\n        '上城区','钱江路附近',30.2500,120.2000,'platform'\n) d\nWHERE @demo_user_id IS NOT NULL\nON DUPLICATE KEY UPDATE\n  user_id=VALUES(user_id),category_id=VALUES(category_id),workflow_profile=VALUES(workflow_profile),\n  dispatch_mode=VALUES(dispatch_mode),expected_fee_type=VALUES(expected_fee_type),\n  expected_fee_cents=VALUES(expected_fee_cents),expected_fee_text=VALUES(expected_fee_text),\n  category_name_snapshot=VALUES(category_name_snapshot),category_names_snapshot=VALUES(category_names_snapshot),\n  title=VALUES(title),description=VALUES(description),quantity_text=VALUES(quantity_text),\n  city=VALUES(city),district=VALUES(district),address_summary=VALUES(address_summary),lat=VALUES(lat),lng=VALUES(lng),\n  order_source_type=VALUES(order_source_type),audit_status='approved',audited_at=UTC_TIMESTAMP(),\n  publish_status='published',quote_status='waiting',assignment_status='unassigned',fulfillment_status='not_started',\n  payment_status='paid',refund_status='none',dispute_status='none',lifecycle_status='active',\n  published_at=UTC_TIMESTAMP(),quote_deadline_at=DATE_ADD(UTC_TIMESTAMP(),INTERVAL 90 DAY),\n  booking_fee_cents=0,is_demo=1,updated_at=UTC_TIMESTAMP();\n\nINSERT IGNORE INTO order_categories(order_id,category_id,category_name_snapshot,sort_order,created_at)\nSELECT o.id,sc.id,o.category_name_snapshot,0,UTC_TIMESTAMP()\nFROM orders o\nJOIN service_categories sc ON sc.status='active' AND sc.name=o.category_name_snapshot\nWHERE o.is_demo=1 AND BINARY o.public_no LIKE BINARY 'BXDEMOHALL%';\n\nINSERT INTO order_measurement_states(order_id,service_payment_status,result_status,settlement_status,created_at,updated_at)\nSELECT o.id,'unpaid','editing','pending',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM orders o\nWHERE o.is_demo=1 AND o.public_no='BXDEMOHALL03'\nON DUPLICATE KEY UPDATE result_status='editing',updated_at=UTC_TIMESTAMP();\n\nINSERT INTO order_platform_terms\n(order_id,customer_flow_mode,customer_pricing_mode,customer_contract_total_cents,worker_settlement_mode,\n worker_labor_cents,extra_income_rate_bp_snapshot,worker_balance_freeze_days_snapshot,settlement_status,created_at,updated_at)\nSELECT o.id,'platform_managed','fixed_total',\n       CASE WHEN o.public_no='BXDEMOHALL05' THEN 168000 ELSE 20000 END,\n       'worker_collect',\n       CASE WHEN o.public_no='BXDEMOHALL05' THEN 128000 ELSE 20000 END,\n       2000,0,'pending',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM orders o\nWHERE o.is_demo=1 AND o.public_no IN ('BXDEMOHALL05','BXDEMOHALL06')\nON DUPLICATE KEY UPDATE\n customer_flow_mode=VALUES(customer_flow_mode),customer_pricing_mode=VALUES(customer_pricing_mode),\n customer_contract_total_cents=VALUES(customer_contract_total_cents),worker_settlement_mode=VALUES(worker_settlement_mode),\n worker_labor_cents=VALUES(worker_labor_cents),extra_income_rate_bp_snapshot=VALUES(extra_income_rate_bp_snapshot),\n worker_balance_freeze_days_snapshot=VALUES(worker_balance_freeze_days_snapshot),settlement_status='pending',updated_at=UTC_TIMESTAMP();\n\nINSERT INTO order_measurement_states(order_id,service_payment_status,result_status,settlement_status,\n gross_amount_cents,refunded_amount_cents,service_rate_bp_snapshot,service_min_cents_snapshot,\n service_fee_cents,worker_net_cents,created_at,updated_at)\nSELECT o.id,'paid','editing','not_applicable',0,0,0,0,0,0,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM orders o\nWHERE o.is_demo=1 AND o.public_no='BXDEMOHALL06'\nON DUPLICATE KEY UPDATE\n service_payment_status='paid',result_status='editing',settlement_status='not_applicable',\n gross_amount_cents=0,refunded_amount_cents=0,service_rate_bp_snapshot=0,service_min_cents_snapshot=0,\n service_fee_cents=0,worker_net_cents=0,hold_until=NULL,max_hold_until=NULL,settled_at=NULL,updated_at=UTC_TIMESTAMP();\n","server/database/upgrades/2.6.0.sql":"-- V2.6.0：后台测试中心 M1 运行元数据。\n-- 业务事实继续写既有订单/报价/支付/媒体表；本迁移只增加测试归属、模拟来源和检查记录。\n-- 测试中心写入口由 app.env=testing 硬门禁保护，正式站不得通过设置开启。\nSET NAMES utf8mb4;\n\nCREATE TABLE IF NOT EXISTS `test_batches` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `create_request_key` varchar(80) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `code_sha` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `app_version` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `environment` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `archived_at` datetime DEFAULT NULL,\n  `cleanup_at` datetime DEFAULT NULL,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_batches_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_batches_request` (`created_by_admin_id`,`create_request_key`),\n  KEY `idx_test_batches_status_created` (`status`,`created_at`),\n  KEY `idx_test_batches_admin_created` (`created_by_admin_id`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心批次元数据';\n\nCREATE TABLE IF NOT EXISTS `test_instances` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `batch_id` bigint(20) unsigned NOT NULL,\n  `scenario_key` varchar(160) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `scenario_version` int(10) unsigned NOT NULL DEFAULT '1',\n  `order_id` bigint(20) unsigned DEFAULT NULL,\n  `order_no_snapshot` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `params_json` text COLLATE utf8mb4_unicode_ci,\n  `params_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `build_mode` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'preset',\n  `build_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'building',\n  `verification_status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending',\n  `source_instance_id` bigint(20) unsigned DEFAULT NULL,\n  `rebuilt_from_instance_id` bigint(20) unsigned DEFAULT NULL,\n  `version` int(10) unsigned NOT NULL DEFAULT '1',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  `archived_at` datetime DEFAULT NULL,\n  `deleted_at` datetime DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_instances_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_instances_order_id` (`order_id`),\n  KEY `idx_test_instances_batch` (`batch_id`,`id`),\n  KEY `idx_test_instances_scenario` (`scenario_key`,`build_status`,`created_at`),\n  KEY `idx_test_instances_verification` (`verification_status`,`created_at`),\n  KEY `idx_test_instances_source` (`source_instance_id`),\n  KEY `idx_test_instances_rebuilt` (`rebuilt_from_instance_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心场景实例';\n\nCREATE TABLE IF NOT EXISTS `test_runs` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `action_key` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_role` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'admin',\n  `operation_mode` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'preset',\n  `idempotency_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_id` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `before_summary_json` text COLLATE utf8mb4_unicode_ci,\n  `after_summary_json` text COLLATE utf8mb4_unicode_ci,\n  `result` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'running',\n  `error_code` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `error_message` varchar(1000) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `duration_ms` int(10) unsigned DEFAULT NULL,\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `started_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `finished_at` datetime DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_runs_public_id` (`public_id`),\n  UNIQUE KEY `uniq_test_runs_idempotency` (`instance_id`,`idempotency_key`),\n  KEY `idx_test_runs_instance_created` (`instance_id`,`created_at`),\n  KEY `idx_test_runs_result_created` (`result`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心动作执行记录';\n\nCREATE TABLE IF NOT EXISTS `test_assertion_results` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `run_id` bigint(20) unsigned DEFAULT NULL,\n  `assertion_group` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `assertion_key` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `expected_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `actual_text` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `details_json` text COLLATE utf8mb4_unicode_ci,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  KEY `idx_test_assertions_instance` (`instance_id`,`id`),\n  KEY `idx_test_assertions_run` (`run_id`,`id`),\n  KEY `idx_test_assertions_status` (`status`,`created_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心断言结果';\n\nCREATE TABLE IF NOT EXISTS `test_payment_facts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `payment_order_id` bigint(20) unsigned NOT NULL,\n  `simulation_request_key` varchar(96) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `business_type` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `amount_cents` bigint(20) unsigned NOT NULL,\n  `simulated_provider` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'internal_test',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'paid',\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_payment_order` (`payment_order_id`),\n  UNIQUE KEY `uniq_test_payment_request` (`simulation_request_key`),\n  KEY `idx_test_payment_instance` (`instance_id`,`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='testing 内部支付事实来源登记；绝非微信交易';\n\nCREATE TABLE IF NOT EXISTS `test_participants` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `slot_key` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `user_id` bigint(20) unsigned DEFAULT NULL,\n  `worker_id` bigint(20) unsigned DEFAULT NULL,\n  `expected_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_participant_slot` (`instance_id`,`slot_key`),\n  KEY `idx_test_participant_user` (`user_id`),\n  KEY `idx_test_participant_worker` (`worker_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试实例参与者 slot 映射；主档可由多个实例共享';\n\nCREATE TABLE IF NOT EXISTS `test_media_facts` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `media_file_id` bigint(20) unsigned NOT NULL,\n  `purpose` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `storage_key_snapshot` varchar(500) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_media_instance_file` (`instance_id`,`media_file_id`),\n  KEY `idx_test_media_file` (`media_file_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心创建媒体归属，用于精确清理';\n\nCREATE TABLE IF NOT EXISTS `test_message_outbox` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `order_id` bigint(20) unsigned NOT NULL,\n  `business_key` varchar(190) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `event_key` varchar(160) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `event_type` varchar(120) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `channel` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `recipient_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `recipient_id` bigint(20) unsigned DEFAULT NULL,\n  `scene_key` varchar(80) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `projection_status` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `reason_code` varchar(120) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `payload_json` text COLLATE utf8mb4_unicode_ci,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_message_business` (`instance_id`,`business_key`),\n  KEY `idx_test_message_instance_created` (`instance_id`,`created_at`),\n  KEY `idx_test_message_event_channel` (`event_type`,`channel`,`projection_status`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心消息模拟投影；绝不进入真实外部投递队列';\n\n\n-- V2.6.0：测试中心短期小程序会话。票据只能在 testing 中兑换，且每次 API actor 解析都重新校验实例归属。\nSET @v260_test_actor_user_col=(SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='login_sessions' AND column_name='test_actor_user_id');\nSET @v260_test_actor_user_sql=IF(@v260_test_actor_user_col=0,\n  'ALTER TABLE `login_sessions` ADD COLUMN `test_actor_user_id` BIGINT UNSIGNED NULL AFTER `demo_actor_user_id`',\n  'SELECT 1');\nPREPARE v260_test_actor_user_stmt FROM @v260_test_actor_user_sql;\nEXECUTE v260_test_actor_user_stmt;\nDEALLOCATE PREPARE v260_test_actor_user_stmt;\n\nSET @v260_test_instance_col=(SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='login_sessions' AND column_name='test_instance_id');\nSET @v260_test_instance_sql=IF(@v260_test_instance_col=0,\n  'ALTER TABLE `login_sessions` ADD COLUMN `test_instance_id` BIGINT UNSIGNED NULL AFTER `test_actor_user_id`',\n  'SELECT 1');\nPREPARE v260_test_instance_stmt FROM @v260_test_instance_sql;\nEXECUTE v260_test_instance_stmt;\nDEALLOCATE PREPARE v260_test_instance_stmt;\n\nSET @v260_test_actor_exp_col=(SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='login_sessions' AND column_name='test_actor_expires_at');\nSET @v260_test_actor_exp_sql=IF(@v260_test_actor_exp_col=0,\n  'ALTER TABLE `login_sessions` ADD COLUMN `test_actor_expires_at` DATETIME NULL AFTER `test_instance_id`',\n  'SELECT 1');\nPREPARE v260_test_actor_exp_stmt FROM @v260_test_actor_exp_sql;\nEXECUTE v260_test_actor_exp_stmt;\nDEALLOCATE PREPARE v260_test_actor_exp_stmt;\n\nCREATE TABLE IF NOT EXISTS `test_entry_tokens` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `token_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `instance_id` bigint(20) unsigned NOT NULL,\n  `actor_role` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `actor_user_id` bigint(20) unsigned NOT NULL,\n  `actor_worker_id` bigint(20) unsigned DEFAULT NULL,\n  `worker_slot` varchar(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `page_key` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active',\n  `expires_at` datetime NOT NULL,\n  `used_at` datetime DEFAULT NULL,\n  `used_by_session_id` bigint(20) unsigned DEFAULT NULL,\n  `created_by_admin_id` bigint(20) unsigned NOT NULL,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uniq_test_entry_public` (`public_id`),\n  UNIQUE KEY `uniq_test_entry_hash` (`token_hash`),\n  KEY `idx_test_entry_instance_status` (`instance_id`,`status`,`expires_at`),\n  KEY `idx_test_entry_session` (`used_by_session_id`,`used_at`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试中心一次性小程序短期入口；只保存 token 摘要';\n\nINSERT INTO `database_field_dictionary`\n  (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`)\nVALUES\n  ('test_batches','create_request_key','测试创建请求键','同一管理员的场景生成请求幂等键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_instances','scenario_key','测试场景键','代码版本化场景模板稳定标识，不包含应用版本号',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_instances','order_id','测试主订单ID','测试实例主要查看订单；M1 一实例一订单，删除后置空保留 tombstone',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_instances','verification_status','测试检查状态','pending/passed/failed/blocked',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_runs','idempotency_key','测试动作幂等键','同一实例同一动作请求的幂等保护键',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_assertion_results','status','断言结果','passed/failed/skipped/not_applicable/blocked',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_payment_facts','payment_order_id','内部模拟支付单ID','仅 testing 内部支付适配器登记；对应 payment_orders 不得具有微信 prepay/transaction_id',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_participants','slot_key','测试参与者槽位','例如 worker_1/worker_2/pending_worker；用于页面测试与清理归属',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_media_facts','media_file_id','测试媒体ID','测试中心创建并可安全删除的媒体主档，不得指向正式业务媒体',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_message_outbox','projection_status','消息模拟状态','delivered/config_disabled/demo_suppressed/not_applicable/environment_blocked/simulated/failed/not_run；模拟消息绝不进入真实 dispatcher',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_message_outbox','business_key','消息模拟幂等键','按测试实例、业务事件、渠道、收件人和场景去重，业务重试不得重复生成相同投影',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('login_sessions','test_actor_user_id','测试实例临时身份','仅 testing 的真实管理员小程序会话可通过一次性测试入口临时绑定；正式环境解析时忽略并清除',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('login_sessions','test_instance_id','测试实例临时绑定','短期测试会话只能访问此实例归属的客户或 test_participants 师傅身份',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('login_sessions','test_actor_expires_at','测试身份到期时间','到期后 API actor 解析自动清除临时身份',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_entry_tokens','token_hash','短期入口摘要','一次性入口只保存 SHA-256 摘要，不保存明文 token',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n  ('test_entry_tokens','status','入口票据状态','active/used/expired/revoked；used 后不可再次兑换',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE\n  `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n","server/VERSION":"2.7.0\n","server/database/upgrades/manifest.json":"{\n  \"manifest_version\": 1,\n  \"generated_at\": \"2026-10-23T20:00:00+08:00\",\n  \"install_file\": \"database.sql\",\n  \"install_checksum\": \"7cb2456fb64d9cfe1e3e1d0c2a8144782147f64f9ea71db8f90717d9fbacb828\",\n  \"upgrades\": [\n    {\n      \"version\": \"1.0.0\",\n      \"name\": \"首次安装基线\",\n      \"file\": \"1.0.0.sql\",\n      \"checksum\": \"321291ce4ce3e0add1752b2e78a7622d7b7088c091e783ee220c75e7abfd7273\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"首次安装由 database.sql 创建完整结构，本文件作为升级器可校验、可重复执行的 V1.0.0 空迁移。\"\n    },\n    {\n      \"version\": \"1.0.1\",\n      \"name\": \"订单待退款状态兼容\",\n      \"file\": \"1.0.1.sql\",\n      \"checksum\": \"d3ad9aead3708e0bdef6e688455305d804f743bf13187d3ee348d78080f7548d\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"将订单生命周期字段扩充为 40 个 ASCII 字符，兼容完整的待退款状态；全新安装已包含最终结构。\"\n    },\n    {\n      \"version\": \"1.0.2\",\n      \"name\": \"后台运营工作台与支付配置升级\",\n      \"file\": \"1.0.2.sql\",\n      \"checksum\": \"520744ff4de1028edf18ffed814ea5ac9e6e87f27c359d695909ab3def8a653d\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"增加类目化订单号、弹窗订单管理、微信支付与通知配置、单条云开发师傅同步及完整流程演示数据。\"\n    },\n    {\n      \"version\": \"1.0.3\",\n      \"name\": \"小程序订单支付退款与师傅结算闭环\",\n      \"file\": \"1.0.3.sql\",\n      \"checksum\": \"d370e6cba663ac1befa5ffa542e20900f9d55bf039d2a3dc48303ead80da780e\",\n      \"min_php\": \"7.4.0\",\n      \"min_mysql\": \"5.7.44\",\n      \"requires_extensions\": [],\n      \"idempotent\": true,\n      \"install_baseline\": true,\n      \"description\": \"增加报价结算确认快照、普通商户支付退款回调修正、三天服务费期限，并对齐无开始施工步骤的轻量履约流程。\"\n    },