LL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `share_contexts`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `context_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '上下文类型',\n  MODIFY COLUMN `token_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '令牌摘要',\n  MODIFY COLUMN `created_by_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '创建操作人类型',\n  MODIFY COLUMN `created_by_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建操作人ID',\n  MODIFY COLUMN `snapshot_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '快照JSON',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `expires_at` datetime NOT NULL COMMENT '到期时间',\n  MODIFY COLUMN `used_at` datetime DEFAULT NULL COMMENT '使用时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `sms_recipient_suppressions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `mobile_hmac` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '手机号HMAC摘要',\n  MODIFY COLUMN `mobile_masked` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '手机号脱敏值',\n  MODIFY COLUMN `reason` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原因',\n  MODIFY COLUMN `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备注',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建管理员ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `system_settings`\n  MODIFY COLUMN `setting_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '设置键',\n  MODIFY COLUMN `setting_value` longtext COLLATE utf8mb4_unicode_ci COMMENT '设置值',\n  MODIFY COLUMN `value_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'string' COMMENT '值类型',\n  MODIFY COLUMN `group_name` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'general' COMMENT '设置分组',\n  MODIFY COLUMN `is_public` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否公开',\n  MODIFY COLUMN `description` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '描述',\n  MODIFY COLUMN `updated_by` bigint(20) unsigned DEFAULT NULL COMMENT '更新人ID',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `upgrade_history`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `from_version` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '原版本',\n  MODIFY COLUMN `to_version` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '新版本',\n  MODIFY COLUMN `package_name` varchar(190) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '升级包名称',\n  MODIFY COLUMN `package_checksum` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '升级包校验值',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'running' COMMENT '状态',\n  MODIFY COLUMN `started_at` datetime NOT NULL COMMENT '开始时间',\n  MODIFY COLUMN `finished_at` datetime DEFAULT NULL COMMENT '结束时间',\n  MODIFY COLUMN `executed_by` bigint(20) unsigned DEFAULT NULL COMMENT '执行人ID',\n  MODIFY COLUMN `backup_reference` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备份引用',\n  MODIFY COLUMN `error_message` text COLLATE utf8mb4_unicode_ci COMMENT '错误信息',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `user_membership_grants`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT N