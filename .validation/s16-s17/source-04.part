ULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `actor_type` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作者类型',\n  MODIFY COLUMN `actor_id` bigint(20) unsigned NOT NULL COMMENT '操作者ID',\n  MODIFY COLUMN `action` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '操作',\n  MODIFY COLUMN `idempotency_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '幂等键',\n  MODIFY COLUMN `request_digest` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '请求摘要',\n  MODIFY COLUMN `response_status` int(10) unsigned DEFAULT NULL COMMENT '响应状态',\n  MODIFY COLUMN `response_body` longtext COLLATE utf8mb4_unicode_ci COMMENT '响应请求体',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'processing' COMMENT '状态',\n  MODIFY COLUMN `expires_at` datetime NOT NULL COMMENT '到期时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `completed_at` datetime DEFAULT NULL COMMENT '完成时间';\nALTER TABLE `invite_tokens`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `token_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '令牌摘要',\n  MODIFY COLUMN `purpose` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'worker_assignment' COMMENT '用途',\n  MODIFY COLUMN `created_by_admin_id` bigint(20) unsigned DEFAULT NULL COMMENT '创建管理员ID',\n  MODIFY COLUMN `claimed_by_user_id` bigint(20) unsigned DEFAULT NULL COMMENT '已领取操作人用户ID',\n  MODIFY COLUMN `claimed_worker_id` bigint(20) unsigned DEFAULT NULL COMMENT '已领取师傅ID',\n  MODIFY COLUMN `commission_rule_version_id` bigint(20) unsigned DEFAULT NULL COMMENT '服务费规则版本ID',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `max_claims` int(10) unsigned NOT NULL DEFAULT '1' COMMENT '最大领取',\n  MODIFY COLUMN `claim_count` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '领取数量',\n  MODIFY COLUMN `expires_at` datetime NOT NULL COMMENT '到期时间',\n  MODIFY COLUMN `claimed_at` datetime DEFAULT NULL COMMENT '领取时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `login_sessions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  MODIFY COLUMN `demo_actor_user_id` bigint(20) unsigned DEFAULT NULL COMMENT '演示操作者用户ID',\n  MODIFY COLUMN `token_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '令牌摘要',\n  MODIFY COLUMN `device_id_hash` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '设备ID摘要',\n  MODIFY COLUMN `client_ip` varchar(45) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '客户端IP',\n  MODIFY COLUMN `user_agent` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '客户端User-Agent',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  MODIFY COLUMN `expires_at` datetime NOT NULL COMMENT '到期时间',\n  MODIFY COLUMN `last_seen_at` datetime DEFAULT NULL COMMENT '最后查看时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间';\nALTER TABLE `media_files`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `public_id` char(26) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '公开ID',\n  MODIFY COLUMN `storage_disk` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'private_local' COMMENT '存储磁盘',\n  MODIFY COLUMN `storage_key` varchar(500) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '存储键',\n  MODIFY COLUMN `mime_type` varchar(100) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'MIME类型',\n  MODIFY COLUMN `extension` varchar(16) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '扩展名',\n  MODIFY COLUMN `size_bytes` bigint(