ts_snapshot` bigint(20) unsigned NOT NULL COMMENT '最终金额（分）快照',\n  MODIFY COLUMN `booking_fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '预约费（分）快照',\n  MODIFY COLUMN `rate_bp_snapshot` int(10) unsigned NOT NULL COMMENT '比例（万分比）快照',\n  MODIFY COLUMN `min_fee_cents_snapshot` bigint(20) unsigned NOT NULL COMMENT '最低费用（分）快照',\n  MODIFY COLUMN `gross_commission_cents` bigint(20) unsigned NOT NULL COMMENT '总额服务费（分）',\n  MODIFY COLUMN `booking_fee_offset_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '预约费用抵扣（分）',\n  MODIFY COLUMN `amount_due_cents` bigint(20) unsigned NOT NULL COMMENT '金额截止（分）',\n  MODIFY COLUMN `amount_paid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '金额已支付（分）',\n  MODIFY COLUMN `is_provisional` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否暂定',\n  MODIFY COLUMN `finalized_at` datetime DEFAULT NULL COMMENT '定稿时间',\n  MODIFY COLUMN `overpaid_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '多付（分）',\n  MODIFY COLUMN `worker_credit_cents` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '师傅入账（分）',\n  MODIFY COLUMN `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'pending' COMMENT '状态',\n  MODIFY COLUMN `due_at` datetime DEFAULT NULL COMMENT '截止时间',\n  MODIFY COLUMN `settled_at` datetime DEFAULT NULL COMMENT '结算时间',\n  MODIFY COLUMN `created_at` datetime NOT NULL COMMENT '创建时间',\n  MODIFY COLUMN `updated_at` datetime NOT NULL COMMENT '更新时间';\nALTER TABLE `commission_rule_versions`\n  MODIFY COLUMN `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  MODIFY COLUMN `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  MODIFY COLUMN `version_no` int(10) unsigned NOT NULL COMMENT '版本编号',\n  MODIFY COLUMN `rate_bp` int(10) unsigned NOT NULL DEFAULT '1000' COMMENT '比例（万分比）',\n  MODIFY COLUMN `min_fee_cents` bigint(20) unsigned NOT NULL DEFAULT '5000' COMMENT '最低费用（分）',\n  MODIFY COLUMN `adjustment_type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'defaul