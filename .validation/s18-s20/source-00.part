{"files":{"chat/build.sh":"#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")\"\nexport GOTOOLCHAIN=local\nexport CGO_ENABLED=0\nrequired=\"go$(awk '$1 == \"go\" {print $2}' go.mod)\"\nif [ \"$(go env GOVERSION)\" != \"$required\" ]; then\n    printf '%s\\n' \"请使用go.mod锁定的工具链: $required\" >&2\n    exit 2\nfi\nrevision=$(git rev-parse --verify HEAD)\ndirty=false\nif [ -n \"$(git status --porcelain)\" ]; then dirty=true; fi\nmkdir -p bin\ngo mod verify\ngo build -mod=readonly -trimpath -buildvcs=false \\\n    -ldflags=\"-buildid= -X github.com/franz-9527/workers/chat/internal/bootstrap.sourceRevision=$revision -X github.com/franz-9527/workers/chat/internal/bootstrap.sourceDirty=$dirty\" \\\n    -o bin/chatd ./cmd/chatd\n","chat/cmd/chatd/main.go":"package main\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"os/signal\"\n\t\"syscall\"\n\n\t\"github.com/franz-9527/workers/chat/internal/bootstrap\"\n)\n\nfunc main() { os.Exit(run()) }\n\nfunc run() int {\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\treturn bootstrap.Run(ctx, os.Args[1:], os.Stdout, os.Stderr)\n}\n","chat/go.mod":"module github.com/franz-9527/workers/chat\n\ngo 1.27.3\n\nrequire (\n\tgithub.com/go-sql-driver/mysql v1.10.1\n\tgithub.com/gorilla/websocket v1.5.3\n\tgithub.com/redis/go-redis/v9 v9.23.0\n)\n\nrequire (\n\tfilippo.io/edwards25519 v1.2.0 // indirect\n\tgithub.com/cespare/xxhash/v2 v2.3.0 // indirect\n\tgo.uber.org/atomic v1.12.0 // indirect\n\tgolang.org/x/sys v0.48.0 // indirect\n)\n","chat/go.sum":"filippo.io/edwards25519 v1.2.0 h1:crnVqOiS4jqYleHd9vaKZ+HKtHfllngJIiOpNpoJsjo=\nfilippo.io/edwards25519 v1.2.0/go.mod h1:xzAOLCNug/yB62zG1bQ8uziwrIqIuxhctzJT18Q77mc=\ngithub.com/bsm/ginkgo/v2 v2.12.0 h1:Ny8MWAHyOepLGlLKYmXG4IEkioBysk6GpaRTLC8zwWs=\ngithub.com/bsm/ginkgo/v2 v2.12.0/go.mod h1:SwYbGRRDovPVboqFv0tPTcG1sN61LM1Z4ARdbAV9g4c=\ngithub.com/bsm/gomega v1.27.10 h1:yeMWxP2pV2fG3FgAODIY8EiRE3dy0aeFYt4l7wh6yKA=\ngithub.com/bsm/gomega v1.27.10/go.mod h1:JyEr/xRbxbtgWNi8tIEVPUYZ5Dzef52k01W3YH0H+O0=\ngithub.com/cespare/xxhash/v2 v2.3.0 h1:UL815xU9SqsFlibzuggzjXhog7bL6oX9BbNZnL2UFvs=\ngithub.com/cespare/xxhash/v2 v2.3.0/go.mod h1:VGX0DQ3Q6kWi7AoAeZDth3/j3BFtOZR5XLFGgcrjCOs=\ngithub.com/go-sql-driver/mysql v1.10.1 h1:arlSnNLq6a5yxGxV7qg9lF4j0C+KwD6NbQyKr9QL6ME=\ngithub.com/go-sql-driver/mysql v1.10.1/go.mod h1:M+cqaI7+xxXGG9swrdeUIoPG3Y3KCkF0pZej+SK+nWk=\ngithub.com/gorilla/websocket v1.5.3 h1:saDtZ6Pbx/0u+bgYQ3q96pZgCzfhKXGPqt7kZ72aNNg=\ngithub.com/gorilla/websocket v1.5.3/go.mod h1:YR8l580nyteQvAITg2hZ9XVh4b55+EU/adAjf1fMHhE=\ngithub.com/klauspost/cpuid/v2 v2.4.0 h1:S6Hrbc7+ywsr0r+RLapfGBHfyefhCTwEh3A0tV913Dw=\ngithub.com/klauspost/cpuid/v2 v2.4.0/go.mod h1:19jmZ9mjzoF//ddRSUsv0zfBTJWh3QJh9FNxZTMrGxU=\ngithub.com/redis/go-redis/v9 v9.23.0 h1:/TTVdJa8BRNsybwwGGnmiYktHNlUXtbOQxlWpHBPL3s=\ngithub.com/redis/go-redis/v9 v9.23.0/go.mod h1:EWP2UUk+XDaI1s5nQB5mablZN6vccXlmBQTyfnF87D0=\ngithub.com/stretchr/testify v1.12.1 h1:EuwCh5fleGS7H32xRwO3wRGT7DxrDhLAT6FF8MpWDWE=\ngithub.com/stretchr/testify v1.12.1/go.mod h1:MDEgiDPPsNp5cuIrHPPCyornHKgEVbtFUmoNlxoYthg=\ngithub.com/zeebo/xxh3 v1.1.0 h1:s7DLGDK45Dyfg7++yxI0khrfwq9661w9EN78eP/UZVs=\ngithub.com/zeebo/xxh3 v1.1.0/go.mod h1:IisAie1LELR4xhVinxWS5+zf1lA4p0MW4T+w+W07F5s=\ngo.uber.org/atomic v1.12.0 h1:BvcXdFKuviU4fTL/f+SxdQ5qJX/Jix8pAkgdUcb3XOE=\ngo.uber.org/atomic v1.12.0/go.mod h1:I6c4cg+6HCxRjfjSsYtApoFILnpc0CGUdGkXVqbYVNk=\ngo.yaml.in/yaml/v3 v3.0.5 h1:N6y/pJk8buWs9NY5ERU2HSMfm+IuD/OtfdAnq6kESPw=\ngo.yaml.in/yaml/v3 v3.0.5/go.mod h1:HVTZu1O7/Vkt2N+BFy8Zza+lnLsABggaTM2ZpNIGuKg=\ngolang.org/x/sys v0.48.0 h1:bbX/i/6MgT9BVLM9RT1thmxL04yeTAhbEz4SyadbXoo=\ngolang.org/x/sys v0.48.0/go.mod h1:hNLxWAXmnKAxqDtdwIYC4bM9oQPEecfsnNMuSxOs3og=\n","chat/internal/auth/auth_test.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype memoryStore struct {\n\tmu     sync.Mutex\n\tvalues map[string]string\n\tfail   bool\n}\n\nfunc (m *memoryStore) Put(_ context.Context, k, v string, _ time.Duration) (bool, error) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif m.fail {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tif _, ok := m.values[k]; ok {\n\t\treturn false, nil\n\t}\n\tm.values[k] = v\n\treturn true, nil\n}\nfunc (m *memoryStore) Take(_ context.Context, k string) (string, error) {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\tif m.fail {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tv := m.values[k]\n\tdelete(m.values, k)\n\treturn v, nil\n}\n\ntype sourceFunc func(context.Context, Claims) error\n\nfunc (f sourceFunc) Validate(ctx context.Context, c Claims) error { return f(ctx, c) }\nfunc fixture(t *testing.T) (*Service, ed25519.PrivateKey, Claims, *memoryStore) {\n\tt.Helper()\n\tpub, priv, e := ed25519.GenerateKey(rand.Reader)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tv, e := NewVerifier(\"test\", map[string]ed25519.PublicKey{\"v1\": pub})\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tm := &memoryStore{values: map[string]string{}}\n\ts, e := NewService(v, sourceFunc(func(context.Context, Claims) error { return nil }), m, 2, 100*time.Millisecond)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tnow := time.Now().Unix()\n\tc := Claims{\"bixuan-php:test\", \"bixuan-chat\", \"18446744073709551615\", \"mini\", \"1\", strings.Repeat(\"a\", 64), strings.Repeat(\"b\", 64), \"test\", []string{\"chat:use\"}, now, now, now + 300, strings.Repeat(\"c\", 64)}\n\treturn s, priv, c, m\n}\nfunc sign(priv ed25519.PrivateKey, header, body string) string {\n\ta := base64.RawURLEncoding.EncodeToString([]byte(header)) + \".\" + base64.RawURLEncoding.EncodeToString([]byte(body))\n\treturn a + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(a)))\n}\nfunc token(priv ed25519.PrivateKey, c Claims) string {\n\tb, _ := json.Marshal(c)\n\treturn sign(priv, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, string(b))\n}\n\nfunc TestTokenBoundaries(t *testing.T) {\n\ts, priv, c, _ := fixture(t)\n\tnow := time.Now()\n\tgood := token(priv, c)\n\tif got, e := s.Check(context.Background(), good); e != nil || got.ActorID != c.ActorID {\n\t\tt.Fatal(got, e)\n\t}\n\tfor _, mutate := range []func(*Claims){func(c *Claims) { c.Environment = \"production\" }, func(c *Claims) { c.Audience = \"other\" }, func(c *Claims) { c.ActorID = \"0\" }, func(c *Claims) { c.ExpiresAt = c.IssuedAt + 301 }, func(c *Claims) { c.ExpiresAt = now.Unix() }, func(c *Claims) { c.IssuedAt = now.Unix() + 20; c.NotBefore = c.IssuedAt }, func(c *Claims) { c.Scopes = []string{\"chat:audit\"} }, func(c *Claims) { c.SessionID = \"old\" }, func(c *Claims) { c.Scopes = []string{\"chat:use\", \"chat:use\"} }} {\n\t\tbad := c\n\t\tmutate(&bad)\n\t\tif _, e := s.verifier.Verify(token(priv, bad), now); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"accepted invalid claims\", bad, e)\n\t\t}\n\t}\n\tb, _ := json.Marshal(c)\n\tfor _, h := range []string{`{\"alg\":\"none\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\",\"kid\":\"v1\"}`, `{\"ALG\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"missing\"}`, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\",\"jku\":\"https://invalid\"}`} {\n\t\tif _, e := s.verifier.Verify(sign(priv, h, string(b)), now); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"header accepted\", h)\n\t\t}\n\t}\n\tfor _, body := range []string{string(b[:len(b)-1]) + `,\"sub\":\"2\"}`, strings.Replace(string(b), `\"sub\":\"18446744073709551615\"`, `\"sub\":18446744073709551615`, 1), string(b) + ` {}`, strings.Replace(string(b), `\"env\"`, `\"ENV\"`, 1)} {\n\t\tif _, e := s.verifier.Verify(sign(priv, `{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`, body), now); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"body accepted\")\n\t\t}\n\t}\n}\n\nfunc TestTicketConcurrentReplayAndRevocation(t *testing.T) {\n\ts, priv, c, m := fixture(t)\n\tticket, exp, e := s.IssueTicket(context.Background(), token(priv, c))\n\tif e != nil || time.Until(exp) > 30*time.Second {\n\t\tt.Fatal(e)\n\t}\n\tvar successes atomic.Int32\n\tvar wg sync.WaitGroup\n\tfor range 24 {\n\t\twg.Go(func() {\n\t\t\tif _, e := s.ConsumeTicket(context.Background(), ticket); e == nil {\n\t\t\t\tsuccesses.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif successes.Load() != 1 {\n\t\tt.Fatal(successes.Load())\n\t}\n\tticket, _, e = s.IssueTicket(context.Background(), token(priv, c))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return ErrUnauthorized })\n\tif _, e = s.ConsumeTicket(context.Background(), ticket); e != ErrUnauthorized {\n\t\tt.Fatal(\"revoked ticket\", e)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return nil })\n\tm.fail = true\n\tif _, _, e = s.IssueTicket(context.Background(), token(priv, c)); e != ports.ErrUnavailable {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = s.Check(context.Background(), token(priv, c)); e != nil {\n\t\tt.Fatal(\"Redis must not block access-token HTTP\", e)\n\t}\n}\n\nfunc TestSessionDeadlineBudgetAndSocketRefresh(t *testing.T) {\n\ts, priv, c, _ := fixture(t)\n\tsocket := NewSocketIdentity(c)\n\tfresh := c\n\tfresh.ExpiresAt--\n\tif e := socket.Refresh(context.Background(), s, token(priv, fresh)); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\tfresh = c\n\tfresh.ActorID = \"3\"\n\tif e := socket.Refresh(context.Background(), s, token(priv, fresh)); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\tif e := socket.Refresh(context.Background(), s, token(priv, c)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return ErrUnauthorized })\n\tif _, e := socket.Current(context.Background(), s); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\tentered := make(chan struct{}, 2)\n\ts.source = sourceFunc(func(ctx context.Context, _ Claims) error { entered <- struct{}{}; <-ctx.Done(); return ctx.Err() })\n\tvar wg sync.WaitGroup\n\tfor range 2 {\n\t\twg.Go(func() { s.Check(context.Background(), token(priv, c)) })\n\t}\n\t<-entered\n\t<-entered\n\tif _, e := s.Check(context.Background(), token(priv, c)); e != ports.ErrBusy {\n\t\tt.Fatal(e)\n\t}\n\twg.Wait()\n}\n\nfunc TestInternalSignatureBindsRequestAndNonce(t *testing.T) {\n\t_, _, _, m := fixture(t)\n\ta, e := NewInternal(\"test\", map[string][]byte{\"v1\": []byte(strings.Repeat(\"k\", 32))}, m, 100*time.Millisecond)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tbody := []byte(`{\"actor_id\":\"1\"}`)\n\tnow := time.Now()\n\tr := httptest.NewRequest(\"POST\", \"http://127.0.0.1/internal?a=%2F&b=1\", nil)\n\tr.RequestURI = r.URL.RequestURI()\n\tif e = a.Sign(r, body, \"v1\", now); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = a.Verify(context.Background(), r, []byte(`{}`), now); e != ErrUnauthorized {\n\t\tt.Fatal(\"body tamper\", e)\n\t}\n\tother := r.Clone(context.Background())\n\tother.RequestURI = \"/internal?b=1&a=%2F\"\n\tif e = a.Verify(context.Background(), other, body, now); e != ErrUnauthorized {\n\t\tt.Fatal(\"query reorder\", e)\n\t}\n\tvar wg sync.WaitGroup\n\tvar successes atomic.Int32\n\tfor range 20 {\n\t\twg.Go(func() {\n\t\t\tif a.Verify(context.Background(), r, body, now) == nil {\n\t\t\t\tsuccesses.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif successes.Load() != 1 {\n\t\tt.Fatal(successes.Load())\n\t}\n\ta.Sign(r, body, \"v1\", now.Add(-31*time.Second))\n\tif e = a.Verify(context.Background(), r, body, now); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\ta.Sign(r, body, \"v1\", now)\n\tr.Header.Add(\"X-Chat-Environment\", \"test\")\n\tif e = a.Verify(context.Background(), r, body, now); e != ErrUnauthorized {\n\t\tt.Fatal(e)\n\t}\n\ta.Sign(r, body, \"v1\", now)\n\tm.fail = true\n\tif e = a.Verify(context.Background(), r, body, now); e != ports.ErrUnavailable {\n\t\tt.Fatal(e)\n\t}\n}\n","chat/internal/auth/config.go":"package auth\n\nimport (\n\t\"crypto/ed25519\"\n\t\"encoding/base64\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Config struct {\n\tEnabled    bool              `json:\"enabled\"`\n\tPublicKeys map[string]string `json:\"public_keys,omitempty\"`\n}\n\nfunc (c Config) Verifier(environment string) (*Verifier, error) {\n\tkeys := map[string]ed25519.PublicKey{}\n\tfor id, encoded := range c.PublicKeys {\n\t\tk, e := base64.StdEncoding.Strict().DecodeString(encoded)\n\t\tif e != nil || len(k) != 32 || base64.StdEncoding.EncodeToString(k) != encoded {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\tkeys[id] = ed25519.PublicKey(k)\n\t}\n\treturn NewVerifier(environment, keys)\n}\n","chat/internal/auth/http.go":"package auth\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Handler struct {\n\tservice *Service\n\tgate    chan struct{}\n}\n\nfunc NewHandler(service *Service, concurrency int) (*Handler, error) {\n\tif service == nil || concurrency < 1 || concurrency > 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Handler{service, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tid, e := randomID()\n\tif e != nil {\n\t\tid = \"unavailable\"\n\t}\n\tw.Header().Set(\"X-Request-ID\", id)\n\tfail := func(status int, code, message string, retryable bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"message\": message, \"retryable\": retryable, \"server_time\": time.Now().UTC().Format(time.RFC3339Nano)})\n\t\t}\n\t}\n\texpected := \"GET\"\n\tif r.URL.Path == \"/chat/api/v1/auth/socket-ticket\" {\n\t\texpected = \"POST\"\n\t} else if r.URL.Path != \"/chat/api/v1/auth/session\" {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", \"接口未开放\", false)\n\t\treturn\n\t}\n\tif r.Method != expected {\n\t\tw.Header().Set(\"Allow\", expected)\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", \"请求方法不支持\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"请求参数不正确\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, \"CHAT_RESOURCE_BUSY\", \"请求较多，请稍后重试\", true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效，请重新进入\", false)\n\t\treturn\n\t}\n\tcredential := strings.TrimPrefix(headers[0], \"Bearer \")\n\tcontroller := http.NewResponseController(w)\n\t_ = controller.SetReadDeadline(time.Now().Add(h.service.timeout))\n\tbody, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 256))\n\tif e != nil {\n\t\t// Leave an expired read deadline in place and close the connection;\n\t\t// net/http must not drain a stalled request body after the handler returns.\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar oversized *http.MaxBytesError\n\t\tif errors.As(e, &oversized) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", \"请求内容过大\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", \"请求未及时完成，请重试\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = controller.SetReadDeadline(time.Time{})\n\tif len(strings.TrimSpace(string(body))) > 0 && (expected == \"GET\" || strings.TrimSpace(string(body)) != \"{}\") {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"请求参数不正确\", false)\n\t\treturn\n\t}\n\tvar data any\n\tif expected == \"GET\" {\n\t\tvar c Claims\n\t\tc, e = h.service.Check(r.Context(), credential)\n\t\tif e == nil {\n\t\t\tdata = map[string]any{\"actor_id\": c.ActorID, \"kind\": c.Kind, \"env\": c.Environment, \"scopes\": c.Scopes, \"expires_at\": time.Unix(c.ExpiresAt, 0).UTC(), \"business_enabled\": false}\n\t\t}\n\t} else {\n\t\tvar ticket string\n\t\tvar expiry time.Time\n\t\tticket, expiry, e = h.service.IssueTicket(r.Context(), credential)\n\t\tif e == nil {\n\t\t\tdata = map[string]any{\"ticket\": ticket, \"expires_at\": expiry, \"business_enabled\": false}\n\t\t}\n\t}\n\tif e != nil {\n\t\tswitch e {\n\t\tcase ErrUnauthorized:\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效，请重新进入\", false)\n\t\tcase ports.ErrBusy:\n\t\t\tfail(429, \"CHAT_RESOURCE_BUSY\", \"请求较多，请稍后重试\", true)\n\t\tdefault:\n\t\t\tfail(503, \"CHAT_DEPENDENCY_UNAVAILABLE\", \"聊天身份暂不可用，请稍后重试\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"ok\": true, \"request_id\": id, \"data\": data, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/auth/http_test.go":"package auth\n\nimport (\n\t\"bufio\"\n\t\"context\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestAuthHTTPBoundary(t *testing.T) {\n\ts, priv, c, m := fixture(t)\n\th, e := NewHandler(s, 2)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcredential := token(priv, c)\n\tfor _, tc := range []struct {\n\t\tmethod, path, body, credential string\n\t\tstatus                         int\n\t}{\n\t\t{\"GET\", \"/chat/api/v1/auth/session\", \"\", credential, 200},\n\t\t{\"POST\", \"/chat/api/v1/auth/socket-ticket\", \"{}\", credential, 200},\n\t\t{\"GET\", \"/chat/api/v1/auth/socket-ticket\", \"\", credential, 405},\n\t\t{\"GET\", \"/chat/api/v1/auth/session?token=secret-input\", \"\", credential, 400},\n\t\t{\"GET\", \"/chat/api/v1/auth/session\", \"\", \"\", 401},\n\t\t{\"GET\", \"/chat/api/v1/auth/session\", \"\", \"bad\", 401},\n\t\t{\"POST\", \"/chat/api/v1/auth/socket-ticket\", `{\"actor_id\":\"3\"}`, credential, 400},\n\t\t{\"POST\", \"/chat/api/v1/auth/socket-ticket\", strings.Repeat(\"x\", 257), credential, 413},\n\t\t{\"GET\", \"/chat/api/v1/messages\", \"\", credential, 404},\n\t} {\n\t\tr := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))\n\t\tif tc.credential != \"\" {\n\t\t\tr.Header.Set(\"Authorization\", \"Bearer \"+tc.credential)\n\t\t}\n\t\tw := httptest.NewRecorder()\n\t\th.ServeHTTP(w, r)\n\t\tif w.Code != tc.status || w.Header().Get(\"Cache-Control\") != \"no-store\" || strings.Contains(w.Body.String(), credential) || strings.Contains(w.Body.String(), \"secret-input\") {\n\t\t\tt.Fatalf(\"%s expected %d got %d\", tc.path, tc.status, w.Code)\n\t\t}\n\t}\n\tm.fail = true\n\tr := httptest.NewRequest(\"POST\", \"/chat/api/v1/auth/socket-ticket\", nil)\n\tr.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\tw := httptest.NewRecorder()\n\th.ServeHTTP(w, r)\n\tif w.Code != 503 {\n\t\tt.Fatal(w.Code)\n\t}\n\ts.source = sourceFunc(func(context.Context, Claims) error { return ports.ErrUnavailable })\n\tr = httptest.NewRequest(\"GET\", \"/chat/api/v1/auth/session\", nil)\n\tr.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\tw = httptest.NewRecorder()\n\th.ServeHTTP(w, r)\n\tif w.Code != 503 {\n\t\tt.Fatal(w.Code)\n\t}\n}\n\nfunc TestAuthHTTPBodyDeadline(t *testing.T) {\n\ts, priv, c, _ := fixture(t)\n\th, _ := NewHandler(s, 2)\n\tserver := httptest.NewServer(h)\n\tdefer server.Close()\n\tconnection, e := net.DialTimeout(\"tcp\", strings.TrimPrefix(server.URL, \"http://\"), time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer connection.Close()\n\tconnection.SetDeadline(time.Now().Add(time.Second))\n\trequest := \"POST /chat/api/v1/auth/socket-ticket HTTP/1.1\\r\\nHost: fixture\\r\\nAuthorization: Bearer \" + token(priv, c) + \"\\r\\nContent-Length: 2\\r\\n\\r\\n{\"\n\tif _, e = connection.Write([]byte(request)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tresponse, e := http.ReadResponse(bufio.NewReader(connection), nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer response.Body.Close()\n\tif response.StatusCode != 408 {\n\t\tt.Fatal(response.StatusCode)\n\t}\n}\n","chat/internal/auth/internal.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"net/http\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// InternalAuth keys are independent from PHP's Ed25519 signing key. A verified\n// service request still needs an explicit route/purpose and actor authorization.\ntype InternalAuth struct {\n\tenvironment string\n\tkeys        map[string][]byte\n\tstore       OneTimeStore\n\ttimeout     time.Duration\n}\n\nfunc NewInternal(environment string, keys map[string][]byte, store OneTimeStore, timeout time.Duration) (*InternalAuth, error) {\n\tif !validEnvironment(environment) || len(keys) < 1 || len(keys) > 3 || store == nil || timeout < 50*time.Millisecond || timeout > 5*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ta := &InternalAuth{environment: environment, keys: map[string][]byte{}, store: store, timeout: timeout}\n\tfor id, k := range keys {\n\t\tif !keyID.MatchString(id) || len(k) != 32 {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\ta.keys[id] = append([]byte(nil), k...)\n\t}\n\treturn a, nil\n}\n\nfunc canonical(r *http.Request, body []byte, env, kid, stamp, nonce string) (string, error) {\n\turi := r.URL.RequestURI()\n\tif r.RequestURI != \"\" {\n\t\turi = r.RequestURI\n\t}\n\tif r.Method != \"POST\" || len(body) > 64<<10 || len(uri) > 2048 || !strings.HasPrefix(uri, \"/\") || strings.ContainsAny(uri, \"\\r\\n#\") {\n\t\treturn \"\", ErrUnauthorized\n\t}\n\th := sha256.Sum256(body)\n\treturn strings.Join([]string{\"chat-internal-v1\", r.Method, uri, hex.EncodeToString(h[:]), stamp, nonce, env, kid}, \"\\n\"), nil\n}\n\nfunc (a *InternalAuth) Sign(r *http.Request, body []byte, kid string, now time.Time) error {\n\tk := a.keys[kid]\n\tif len(k) != 32 {\n\t\treturn ports.ErrInvalid\n\t}\n\tnonce, e := randomID()\n\tif e != nil {\n\t\treturn e\n\t}\n\tstamp := strconv.FormatInt(now.Unix(), 10)\n\tc, e := canonical(r, body, a.environment, kid, stamp, nonce)\n\tif e != nil {\n\t\treturn e\n\t}\n\tmac := hmac.New(sha256.New, k)\n\t_, _ = mac.Write([]byte(c))\n\tfor key, value := range map[string]string{\"Environment\": a.environment, \"Key-ID\": kid, \"Timestamp\": stamp, \"Nonce\": nonce, \"Signature\": hex.EncodeToString(mac.Sum(nil))} {\n\t\tr.Header.Set(\"X-Chat-\"+key, value)\n\t}\n\treturn nil\n}\n\nfunc (a *InternalAuth) Verify(ctx context.Context, r *http.Request, body []byte, now time.Time) error {\n\tfields := map[string]string{}\n\tfor _, name := range []string{\"Environment\", \"Key-ID\", \"Timestamp\", \"Nonce\", \"Signature\"} {\n\t\tv := r.Header.Values(\"X-Chat-\" + name)\n\t\tif len(v) != 1 {\n\t\t\treturn ErrUnauthorized\n\t\t}\n\t\tfields[name] = v[0]\n\t}\n\tenv, kid, stamp, nonce := fields[\"Environment\"], fields[\"Key-ID\"], fields[\"Timestamp\"], fields[\"Nonce\"]\n\tts, e := strconv.ParseInt(stamp, 10, 64)\n\tif e != nil || strconv.FormatInt(ts, 10) != stamp || ts < now.Unix()-30 || ts > now.Unix()+30 || env != a.environment || !hex64.MatchString(nonce) || !hex64.MatchString(fields[\"Signature\"]) {\n\t\treturn ErrUnauthorized\n\t}\n\tk := a.keys[kid]\n\tif len(k) != 32 {\n\t\treturn ErrUnauthorized\n\t}\n\tc, e := canonical(r, body, env, kid, stamp, nonce)\n\tif e != nil {\n\t\treturn e\n\t}\n\tmac := hmac.New(sha256.New, k)\n\t_, _ = mac.Write([]byte(c))\n\tsig, _ := hex.DecodeString(fields[\"Signature\"])\n\tif !hmac.Equal(sig, mac.Sum(nil)) {\n\t\treturn ErrUnauthorized\n\t}\n\tctx, cancel := context.WithTimeout(ctx, a.timeout)\n\tdefer cancel()\n\tok, e := a.store.Put(ctx, \"nonce:\"+digest(kid+\":\"+nonce), \"1\", 61*time.Second)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !ok {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n","chat/internal/auth/mysql.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/subtle\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// MySQLSource is SELECT-only on PHP-owned identity tables. No last_seen writes.\ntype MySQLSource struct{ db *sql.DB }\n\nfunc NewMySQLSource(db *sql.DB) (*MySQLSource, error) {\n\tif db == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &MySQLSource{db}, nil\n}\nfunc (s *MySQLSource) Validate(ctx context.Context, c Claims) error {\n\tif c.Kind == \"mini_audit\" {\n\t\ttx, err := s.db.BeginTx(ctx, nil)\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tdefer tx.Rollback()\n\t\tp := ports.Principal{ActorID: c.ActorID, SourceID: c.SourceID, Kind: c.Kind, Scopes: c.Scopes, SessionID: c.SessionID, SessionVersion: c.Version, ExpiresAt: time.Unix(c.ExpiresAt, 0)}\n\t\tif err = s.ValidateAuditMiniLocked(ctx, tx, p); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tif c.Kind != \"mini\" {\n\t\tif c.Kind == \"admin\" {\n\t\t\treturn s.validateAdmin(ctx, c)\n\t\t}\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, hash string\n\tvar expires int64\n\terr := s.db.QueryRowContext(ctx, `SELECT CAST(s.user_id AS CHAR),s.token_hash,UNIX_TIMESTAMP(s.expires_at)\n FROM login_sessions s JOIN users u ON u.id=s.user_id AND u.status='active'\n WHERE s.id=? AND s.status='active' AND s.expires_at>UTC_TIMESTAMP()\n AND COALESCE(s.demo_actor_user_id,0)=0 AND COALESCE(s.test_actor_user_id,0)=0\n AND COALESCE(s.test_instance_id,0)=0 AND s.test_actor_expires_at IS NULL LIMIT 1`, string(c.SourceID)).Scan(&actor, &hash, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tsid := digest(\"mini\\n\" + string(c.SourceID) + \"\\n\" + hash)\n\tversion := digest(\"mini-v1\\n\" + string(c.SourceID) + \"\\n\" + hash + \"\\n\" + actor)\n\tif actor != string(c.ActorID) || !hex64.MatchString(hash) || subtle.ConstantTimeCompare([]byte(sid), []byte(c.SessionID)) != 1 || subtle.ConstantTimeCompare([]byte(version), []byte(c.Version)) != 1 || expires <= time.Now().Unix() || c.ExpiresAt > expires {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n\n// ValidatePrincipalLocked is the mini-session final check for a caller-owned\n// authorization/message transaction. PHP logout/disable cannot commit past it.\n// The Principal must already come from verification of a signed access token.\nfunc (s *MySQLSource) ValidatePrincipalLocked(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif tx == nil || p.Kind != \"mini\" || !p.ActorID.Valid() || p.ActorID == \"0\" || !p.SourceID.Valid() || p.SourceID == \"0\" ||\n\t\t!hex64.MatchString(p.SessionID) || !hex64.MatchString(p.SessionVersion) || !validScopes(p.Kind, p.Scopes) || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, hash string\n\tvar expires int64\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(s.user_id AS CHAR),s.token_hash,UNIX_TIMESTAMP(s.expires_at)\n\t\tFROM login_sessions s JOIN users u ON u.id=s.user_id AND u.status='active'\n\t\tWHERE s.id=? AND s.status='active' AND s.expires_at>UTC_TIMESTAMP()\n\t\tAND COALESCE(s.demo_actor_user_id,0)=0 AND COALESCE(s.test_actor_user_id,0)=0\n\t\tAND COALESCE(s.test_instance_id,0)=0 AND s.test_actor_expires_at IS NULL LIMIT 1 LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&actor, &hash, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif actor != string(p.ActorID) || !hex64.MatchString(hash) || p.SessionID != digest(\"mini\\n\"+string(p.SourceID)+\"\\n\"+hash) ||\n\t\tp.SessionVersion != digest(\"mini-v1\\n\"+string(p.SourceID)+\"\\n\"+hash+\"\\n\"+actor) || p.ExpiresAt.Unix() > expires || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n\nfunc (s *MySQLSource) validateAdmin(ctx context.Context, c Claims) error {\n\tvar actor, sid, version, scopesJSON string\n\tvar expires int64\n\terr := s.db.QueryRowContext(ctx, `SELECT CAST(s.admin_id AS CHAR),s.session_hash,s.session_version,s.scopes_json,UNIX_TIMESTAMP(s.expires_at)\n FROM chat_admin_sessions s\n WHERE s.id=? AND s.revoked_at IS NULL AND s.expires_at>UTC_TIMESTAMP()\n LIMIT 1`, string(c.SourceID)).Scan(&actor, &sid, &version, &scopesJSON, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif actor != string(c.ActorID) || sid != c.SessionID || version != c.Version || expires <= time.Now().Unix() || c.ExpiresAt > expires {\n\t\treturn ErrUnauthorized\n\t}\n\tvar scopes []string\n\tif json.Unmarshal([]byte(scopesJSON), &scopes) != nil || !validScopes(\"admin\", scopes) {\n\t\treturn ErrUnauthorized\n\t}\n\tfor _, wanted := range c.Scopes {\n\t\tfound := false\n\t\tfor _, allowed := range scopes {\n\t\t\tif wanted == allowed {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn ErrUnauthorized\n\t\t}\n\t}\n\treturn nil\n}\n\n// ValidateMediaAdminLocked is a distinct prereview permission. Session/role\n// changes revoke the persisted PHP-issued grant via the identity trigger.\nfunc (s *MySQLSource) ValidateMediaAdminLocked(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif p.Kind != \"admin\" || !p.ActorID.Valid() || !p.SourceID.Valid() || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\tallowed := false\n\tfor _, scope := range p.Scopes {\n\t\tif scope == \"chat:images\" {\n\t\t\tallowed = true\n\t\t}\n\t}\n\tif !allowed {\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, sid, version, scopes string\n\tvar expires int64\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(s.admin_id AS CHAR),s.session_hash,s.session_version,s.scopes_json,UNIX_TIMESTAMP(s.expires_at) FROM chat_admin_sessions s WHERE s.id=? AND s.revoked_at IS NULL AND s.expires_at>UTC_TIMESTAMP() LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&actor, &sid, &version, &scopes, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar list []string\n\tjson.Unmarshal([]byte(scopes), &list)\n\tmoderate := false\n\tfor _, v := range list {\n\t\tif v == \"chat:images\" {\n\t\t\tmoderate = true\n\t\t}\n\t}\n\tif !moderate || actor != string(p.ActorID) || sid != p.SessionID || version != p.SessionVersion || p.ExpiresAt.Unix() > expires {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n","chat/internal/auth/mysql_integration_test.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\nfunc TestMySQLAuthorityAndPHPIssuer(t *testing.T) {\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"isolated MySQL/PHP not provided\")\n\t}\n\taddress := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\thost, port, e := net.SplitHostPort(address)\n\tif e != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"explicit isolated endpoint required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)\n\tdefer cancel()\n\tconfig := mysql.NewConfig()\n\tconfig.Net = \"tcp\"\n\tconfig.Addr = address\n\tconfig.User = \"root\"\n\tconfig.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tconfig.Timeout = time.Second\n\tconfig.ReadTimeout = time.Second\n\tconfig.WriteTimeout = time.Second\n\tconfig.Params = map[string]string{\"time_zone\": \"'+00:00'\"}\n\tconnector, e := mysql.NewConnector(config)\n\tif e != nil {\n\t\tt.Fatal(\"fixture connector\")\n\t}\n\troot := sql.OpenDB(connector)\n\troot.SetMaxOpenConns(1)\n\tdefer root.Close()\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"invalid fixture host\")\n\t}\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tdatabase, user := \"bixuan_test_auth_\"+suffix, \"bxchat_test_\"+suffix\n\tpw, _ := randomID()\n\texecute := func(query string) {\n\t\tt.Helper()\n\t\tif _, e := root.ExecContext(ctx, query); e != nil {\n\t\t\tvar databaseError *mysql.MySQLError\n\t\t\tif errors.As(e, &databaseError) {\n\t\t\t\tt.Fatalf(\"isolated fixture MySQL code=%d\", databaseError.Number)\n\t\t\t}\n\t\t\tt.Fatal(\"isolated fixture query failed\")\n\t\t}\n\t}\n\texecute(\"CREATE DATABASE `\" + database + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tdefer root.Exec(\"DROP DATABASE IF EXISTS `\" + database + \"`\")\n\texecute(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY '\" + pw + \"'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"CREATE TABLE `\" + database + \"`.users(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB\")\n\texecute(\"CREATE TABLE `\" + database + \"`.login_sessions(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED,token_hash CHAR(64) CHARACTER SET ascii COLLATE ascii_bin UNIQUE,status VARCHAR(24),expires_at DATETIME,last_seen_at DATETIME NULL,demo_actor_user_id BIGINT UNSIGNED NULL,test_actor_user_id BIGINT UNSIGNED NULL,test_instance_id BIGINT UNSIGNED NULL,test_actor_expires_at DATETIME NULL) ENGINE=InnoDB\")\n\texecute(\"INSERT INTO `\" + database + \"`.users VALUES(18446744073709551615,'active')\")\n\tloginToken, _ := randomID()\n\thash := digest(loginToken)\n\texecute(\"INSERT INTO `\" + database + \"`.login_sessions(id,user_id,token_hash,status,expires_at) VALUES(7,18446744073709551615,'\" + hash + \"','active',UTC_TIMESTAMP()+INTERVAL 1 HOUR)\")\n\tfor _, table := range []string{\"users\", \"login_sessions\"} {\n\t\texecute(\"GRANT SELECT ON `\" + database + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\treadConfig := *config\n\treadConfig.User = user\n\treadConfig.Passwd = pw\n\treadConfig.DBName = database\n\tconnector, e = mysql.NewConnector(&readConfig)\n\tif e != nil {\n\t\tt.Fatal(\"source connector\")\n\t}\n\tdb := sql.OpenDB(connector)\n\tdb.SetMaxOpenConns(2)\n\tdefer db.Close()\n\tsource, _ := NewMySQLSource(db)\n\tvar seed [32]byte\n\tif _, e = rand.Read(seed[:]); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpriv := ed25519.NewKeyFromSeed(seed[:])\n\tv, _ := NewVerifier(\"test\", map[string]ed25519.PublicKey{\"chat-v1\": priv.Public().(ed25519.PublicKey)})\n\tservice, _ := NewService(v, source, nil, 2, 500*time.Millisecond)\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tt.Fatal(\"explicit PHP runtime required\")\n\t}\n\tpath, e := filepath.Abs(\"../../../server/tests/chat_identity_contract.php\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcmd := exec.CommandContext(ctx, php, path, \"--issue-mini\")\n\tcmd.Env = append(os.Environ(), \"CHAT_AUTH_TEST_MYSQL_HOST=127.0.0.1\", \"CHAT_AUTH_TEST_MYSQL_PORT=\"+port, \"CHAT_AUTH_TEST_MYSQL_DATABASE=\"+database, \"CHAT_AUTH_TEST_MYSQL_USER=\"+user, \"CHAT_AUTH_TEST_MYSQL_PASSWORD=\"+pw, \"CHAT_AUTH_TEST_LOGIN_TOKEN=\"+loginToken, \"CHAT_ACCESS_SEED=\"+base64.StdEncoding.EncodeToString(seed[:]))\n\toutput, e := cmd.Output()\n\tif e != nil {\n\t\tt.Fatal(\"PHP real exchange failed\")\n\t}\n\tvar result struct {\n\t\tToken string `json:\"access_token\"`\n\t}\n\tif json.Unmarshal(output, &result) != nil || result.Token == \"\" {\n\t\tt.Fatal(\"exchange envelope\")\n\t}\n\tc, e := service.Check(ctx, result.Token)\n\tif e != nil || c.ActorID != \"18446744073709551615\" || c.SourceID != \"7\" {\n\t\tt.Fatal(\"cross-language identity mismatch\", e)\n\t}\n\tvar lastSeen sql.NullString\n\tif db.QueryRowContext(ctx, \"SELECT last_seen_at FROM login_sessions WHERE id=7\").Scan(&lastSeen) != nil || lastSeen.Valid {\n\t\tt.Fatal(\"authentication wrote last_seen\")\n\t}\n\tfor _, tc := range []struct{ change, undo string }{\n\t\t{\"UPDATE login_sessions SET status='revoked' WHERE id=7\", \"UPDATE login_sessions SET status='active' WHERE id=7\"},\n\t\t{\"UPDATE users SET status='disabled'\", \"UPDATE users SET status='active'\"},\n\t\t{\"UPDATE login_sessions SET demo_actor_user_id=2\", \"UPDATE login_sessions SET demo_actor_user_id=NULL\"},\n\t\t{\"UPDATE login_sessions SET test_instance_id=2\", \"UPDATE login_sessions SET test_instance_id=NULL\"},\n\t\t{\"UPDATE login_sessions SET expires_at=UTC_TIMESTAMP()-INTERVAL 1 SECOND\", \"UPDATE login_sessions SET expires_at=UTC_TIMESTAMP()+INTERVAL 1 HOUR\"},\n\t\t{\"UPDATE login_sessions SET token_hash=REPEAT('f',64)\", \"UPDATE login_sessions SET token_hash='\" + hash + \"'\"},\n\t} {\n\t\tif _, e = root.ExecContext(ctx, \"USE `\"+database+\"`\"); e != nil {\n\t\t\tt.Fatal(\"select fixture\")\n\t\t}\n\t\texecute(tc.change)\n\t\tif e = service.Validate(ctx, c); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"revocation not observed\", e)\n\t\t}\n\t\texecute(tc.undo)\n\t\tif e = service.Validate(ctx, c); e != nil {\n\t\t\tt.Fatal(\"fixture recovery\", e)\n\t\t}\n\t}\n\tif _, e = db.ExecContext(ctx, \"UPDATE login_sessions SET last_seen_at=UTC_TIMESTAMP() WHERE id=7\"); e == nil {\n\t\tt.Fatal(\"Go identity unexpectedly has writes\")\n\t}\n\n\t// Admin exchange uses the existing PHP Session and a PHP-only write account.\n\tschemaPath, _ := filepath.Abs(\"../../../server/database/database.sql\")\n\tschema, e := os.ReadFile(schemaPath)\n\tif e != nil {\n\t\tt.Fatal(\"install schema fixture\")\n\t}\n\tstart := strings.Index(string(schema), \"CREATE TABLE `admin_users` (\")\n\tend := strings.Index(string(schema)[start:], \";\\n\")\n\tif start < 0 || end < 0 {\n\t\tt.Fatal(\"admin schema fixture\")\n\t}\n\texecute(string(schema)[start : start+end])\n\tmigrationPath, _ := filepath.Abs(\"../../../server/database/upgrades/2.7.0.sql\")\n\tmigration, e := os.ReadFile(migrationPath)\n\tif e != nil {\n\t\tt.Fatal(\"chat migration fixture\")\n\t}\n\tidentitySQL := strings.SplitN(string(migration), \"-- CHAT_SECTION identity\\n\", 2)\n\tif len(identitySQL) != 2 {\n\t\tt.Fatal(\"identity section missing\")\n\t}\n\tsection := strings.SplitN(identitySQL[1], \"-- CHAT_END identity\", 2)\n\tif len(section) != 2 {\n\t\tt.Fatal(\"identity section boundary missing\")\n\t}\n\tfor range 2 {\n\t\tfor _, statement := range strings.Split(section[0], \";\") {\n\t\t\tif strings.TrimSpace(statement) != \"\" {\n\t\t\t\texecute(statement)\n\t\t\t}\n\t\t}\n\t}\n\texecute(\"INSERT INTO admin_users(id,username,password_hash,real_name,role,status,must_change_password,created_at,updated_at) VALUES(2,'chat-fixture','fixture-password-hash','','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\")\n\tfor _, table := range []string{\"chat_admin_sessions\"} {\n\t\texecute(\"GRANT SELECT ON `\" + database + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tphpUser := \"bxphp_test_\" + suffix\n\tphpPassword, _ := randomID()\n\texecute(\"CREATE USER '\" + phpUser + \"'@'\" + fixtureHost + \"' IDENTIFIED BY '\" + phpPassword + \"'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + phpUser + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"GRANT SELECT ON `\" + database + \"`.admin_users TO '\" + phpUser + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"GRANT SELECT,INSERT,UPDATE ON `\" + database + \"`.chat_admin_sessions TO '\" + phpUser + \"'@'\" + fixtureHost + \"'\")\n\tsessionID, _ := randomID()\n\tsessionDir := t.TempDir()\n\tissueAdmin := func(mode string) string {\n\t\tt.Helper()\n\t\tcommand := exec.CommandContext(ctx, php, path, mode)\n\t\tcommand.Env = append(cmd.Env, \"CHAT_AUTH_TEST_MYSQL_USER=\"+phpUser, \"CHAT_AUTH_TEST_MYSQL_PASSWORD=\"+phpPassword, \"CHAT_AUTH_TEST_SESSION_DIR=\"+sessionDir, \"CHAT_AUTH_TEST_SESSION_ID=\"+sessionID)\n\t\tdata, err := command.Output()\n\t\tif err != nil {\n\t\t\tt.Fatal(\"PHP admin operation failed\")\n\t\t}\n\t\tvar r struct {\n\t\t\tToken string `json:\"access_token\"`\n\t\t}\n\t\tif json.Unmarshal(data, &r) != nil {\n\t\t\tt.Fatal(\"admin envelope\")\n\t\t}\n\t\treturn r.Token\n\t}\n\tadminToken := issueAdmin(\"--issue-admin\")\n\tadminClaims, e := service.Check(ctx, adminToken)\n\tif e != nil || adminClaims.Kind != \"admin\" || adminClaims.ActorID != \"2\" || len(adminClaims.Scopes) != 3 {\n\t\tt.Fatal(\"admin identity mismatch\", e)\n\t}\n\tfresh := issueAdmin(\"--issue-admin\")\n\tfreshClaims, e := service.Check(ctx, fresh)\n\tif e != nil || freshClaims.Version != adminClaims.Version || freshClaims.SourceID != adminClaims.SourceID {\n\t\tt.Fatal(\"renewal rotated a valid session\")\n\t}\n\tfor _, tc := range []struct{ change, undo string }{\n\t\t{\"UPDATE admin_users SET role='viewer' WHERE id=2\", \"UPDATE admin_users SET role='super_admin' WHERE id=2\"},\n\t\t{\"UPDATE admin_users SET password_hash='changed' WHERE id=2\", \"UPDATE admin_users SET password_hash='fixture-password-hash' WHERE id=2\"},\n\t\t{\"UPDATE admin_users SET status='disabled' WHERE id=2\", \"UPDATE admin_users SET status='active' WHERE id=2\"},\n\t\t{\"UPDATE admin_users SET must_change_password=1 WHERE id=2\", \"UPDATE admin_users SET must_change_password=0 WHERE id=2\"},\n\t} {\n\t\texecute(tc.change)\n\t\tif e = service.Validate(ctx, adminClaims); e != ErrUnauthorized {\n\t\t\tt.Fatal(\"admin revocation not observed\", e)\n\t\t}\n\t\texecute(tc.undo)\n\t\t// Re-authenticated PHP can issue a new version, never revive an old JWT.\n\t\tprevious := adminClaims.Version\n\t\tadminToken = issueAdmin(\"--issue-admin\")\n\t\tadminClaims, e = service.Check(ctx, adminToken)\n\t\tif e != nil || adminClaims.Version == previous {\n\t\t\tt.Fatal(\"revoked version was reused\", e)\n\t\t}\n\t}\n\tif _, err := db.QueryContext(ctx, \"SELECT password_hash FROM admin_users\"); err == nil {\n\t\tt.Fatal(\"Go can read admin passwords\")\n\t}\n\tif _, e = db.ExecContext(ctx, \"UPDATE chat_admin_sessions SET revoked_at=UTC_TIMESTAMP()\"); e == nil {\n\t\tt.Fatal(\"Go can write PHP admin sessions\")\n\t}\n\texecute(\"UPDATE admin_users SET role='finance' WHERE id=2\")\n\tfinanceToken := issueAdmin(\"--issue-admin\")\n\tfinanceClaims, e := service.Check(ctx, financeToken)\n\tif e != nil || len(financeClaims.Scopes) != 1 || financeClaims.Scopes[0] != \"chat:audit\" || financeClaims.Version == adminClaims.Version {\n\t\tt.Fatal(\"admin downscope mismatch\", e)\n\t}\n\tif e = service.Validate(ctx, adminClaims); e != ErrUnauthorized {\n\t\tt.Fatal(\"old admin version survived downgrade\", e)\n\t}\n\tissueAdmin(\"--logout-admin\")\n\tif e = service.Validate(ctx, financeClaims); e != ErrUnauthorized {\n\t\tt.Fatal(\"PHP logout did not revoke Go\", e)\n\t}\n\texecute(\"DROP TABLE `\" + database + \"`.login_sessions\")\n\tif _, e = service.Check(ctx, result.Token); e == nil || e == ErrUnauthorized {\n\t\tt.Fatal(\"database outage must be unavailable\")\n\t}\n}\n","chat/internal/auth/redis.go":"package auth\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\ntype RedisStore struct {\n\tclient *redis.Client\n\tprefix string\n}\n\nfunc NewRedisStore(client *redis.Client, environment, prefix string) (*RedisStore, error) {\n\tif client == nil || !validEnvironment(environment) || prefix != \"bxchat:\"+environment+\":\" {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &RedisStore{client, prefix + \"auth:\"}, nil\n}\nfunc (s *RedisStore) Put(ctx context.Context, key, value string, ttl time.Duration) (bool, error) {\n\tif ttl <= 0 || ttl > time.Minute+time.Second || len(value) > 4096 || !validStoreKey(key) {\n\t\treturn false, ports.ErrInvalid\n\t}\n\tok, e := s.client.SetNX(ctx, s.prefix+key, value, ttl).Result()\n\tif e != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn ok, nil\n}\nfunc (s *RedisStore) Take(ctx context.Context, key string) (string, error) {\n\tif !validStoreKey(key) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tv, e := s.client.GetDel(ctx, s.prefix+key).Result()\n\tif e == redis.Nil {\n\t\treturn \"\", nil\n\t}\n\tif e != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn v, nil\n}\nfunc validStoreKey(s string) bool {\n\tif len(s) == 71 && s[:7] == \"ticket:\" {\n\t\treturn hex64.MatchString(s[7:])\n\t}\n\treturn len(s) == 70 && s[:6] == \"nonce:\" && hex64.MatchString(s[6:])\n}\n","chat/internal/auth/redis_integration_test.go":"package auth\n\nimport (\n\t\"context\"\n\t\"net\"\n\t\"os\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/redis/go-redis/v9\"\n)\n\n// Explicit isolated endpoint only; never infer a production/default Redis.\nfunc TestRedisAtomicTicketAndNonce(t *testing.T) {\n\taddress := os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\")\n\tif address == \"\" {\n\t\tt.Skip(\"isolated Redis endpoint not provided\")\n\t}\n\th, _, e := net.SplitHostPort(address)\n\tif e != nil || net.ParseIP(h) == nil || !net.ParseIP(h).IsLoopback() {\n\t\tt.Fatal(\"isolated loopback required\")\n\t}\n\tclient := redis.NewClient(&redis.Options{Addr: address, PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, PipelinePoolSize: -1, DisableIdentity: true, Protocol: 2})\n\tdefer client.Close()\n\tstore, e := NewRedisStore(client, \"test\", \"bxchat:test:\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts, priv, c, _ := fixture(t)\n\ts.store = store\n\tctx := context.Background()\n\tticket, _, e := s.IssueTicket(ctx, token(priv, c))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tkey := \"bxchat:test:auth:ticket:\" + digest(ticket)\n\tttl := client.PTTL(ctx, key).Val()\n\tif ttl <= 0 || ttl > 30*time.Second {\n\t\tt.Fatal(ttl)\n\t}\n\tvar wg sync.WaitGroup\n\tvar count atomic.Int32\n\tfor range 32 {\n\t\twg.Go(func() {\n\t\t\tif _, e := s.ConsumeTicket(ctx, ticket); e == nil {\n\t\t\t\tcount.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif count.Load() != 1 {\n\t\tt.Fatal(count.Load())\n\t}\n\tif client.Exists(ctx, key).Val() != 0 {\n\t\tt.Fatal(\"consumed ticket survived\")\n\t}\n\tnonce, _ := randomID()\n\tnonceKey := \"nonce:\" + digest(nonce)\n\tdefer client.Del(ctx, \"bxchat:test:auth:\"+nonceKey)\n\tcount.Store(0)\n\tfor range 24 {\n\t\twg.Go(func() {\n\t\t\tif ok, e := store.Put(ctx, nonceKey, \"1\", 61*time.Second); e == nil && ok {\n\t\t\t\tcount.Add(1)\n\t\t\t}\n\t\t})\n\t}\n\twg.Wait()\n\tif count.Load() != 1 {\n\t\tt.Fatal(\"nonce reservation\", count.Load())\n\t}\n\tttl = client.PTTL(ctx, \"bxchat:test:auth:\"+nonceKey).Val()\n\tif ttl < 60*time.Second || ttl > 61*time.Second {\n\t\tt.Fatal(ttl)\n\t}\n\tif _, e := NewRedisStore(client, \"production\", \"bxchat:test:\"); e == nil {\n\t\tt.Fatal(\"cross environment prefix\")\n\t}\n}\n","chat/internal/auth/service.go":"package auth\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// OneTimeStore must implement linearizable put-if-absent and take-and-delete.\n// The key is already hashed/namespaced by its adapter; outages fail closed.\ntype OneTimeStore interface {\n\tPut(context.Context, string, string, time.Duration) (bool, error)\n\tTake(context.Context, string) (string, error)\n}\n\ntype Service struct {\n\tverifier *Verifier\n\tsource   SessionSource\n\tstore    OneTimeStore\n\tgate     chan struct{}\n\ttimeout  time.Duration\n}\n\nfunc NewService(v *Verifier, source SessionSource, store OneTimeStore, concurrency int, timeout time.Duration) (*Service, error) {\n\tif v == nil || source == nil || concurrency < 1 || concurrency > 32 || timeout < 50*time.Millisecond || timeout > 5*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Service{verifier: v, source: source, store: store, gate: make(chan struct{}, concurrency), timeout: timeout}, nil\n}\n\nfunc (s *Service) Authenticate(ctx context.Context, token string) (ports.Principal, error) {\n\tc, e := s.Check(ctx, token)\n\tif e != nil {\n\t\treturn ports.Principal{}, e\n\t}\n\treturn ports.Principal{ActorID: c.ActorID, SessionID: c.SessionID, Environment: c.Environment, Scopes: append([]string(nil), c.Scopes...), Kind: c.Kind, SourceID: c.SourceID, SessionVersion: c.Version, ExpiresAt: time.Unix(c.ExpiresAt, 0).UTC()}, nil\n}\n\nfunc (s *Service) Check(ctx context.Context, token string) (Claims, error) {\n\tc, e := s.verifier.Verify(token, time.Now())\n\tif e != nil {\n\t\treturn Claims{}, e\n\t}\n\tif e = s.Validate(ctx, c); e != nil {\n\t\treturn Claims{}, e\n\t}\n\treturn c, nil\n}\n\nfunc (s *Service) Validate(ctx context.Context, c Claims) error {\n\tif ctx.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif c.Environment != s.verifier.environment || c.ExpiresAt <= time.Now().Unix() {\n\t\treturn ErrUnauthorized\n\t}\n\tselect {\n\tcase s.gate <- struct{}{}:\n\t\tdefer func() { <-s.gate }()\n\tdefault:\n\t\treturn ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\terr := s.source.Validate(ctx, c)\n\tif err != nil {\n\t\tif err == ErrUnauthorized {\n\t\t\treturn err\n\t\t}\n\t\treturn ports.ErrUnavailable\n\t}\n\tif ctx.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif c.ExpiresAt <= time.Now().Unix() {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n\nfunc randomID() (string, error) {\n\tvar b [32]byte\n\tif _, e := rand.Read(b[:]); e != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn hex.EncodeToString(b[:]), nil\n}\nfunc digest(s string) string { h := sha256.Sum256([]byte(s)); return hex.EncodeToString(h[:]) }\n\nfunc (s *Service) IssueTicket(ctx context.Context, token string) (string, time.Time, error) {\n\tc, e := s.Check(ctx, token)\n\tif e != nil {\n\t\treturn \"\", time.Time{}, e\n\t}\n\tif s.store == nil {\n\t\treturn \"\", time.Time{}, ports.ErrUnavailable\n\t}\n\tticket, e := randomID()\n\tif e != nil {\n\t\treturn \"\", time.Time{}, e\n\t}\n\texp := time.Now().Add(30 * time.Second)\n\tif limit := time.Unix(c.ExpiresAt, 0); exp.After(limit) {\n\t\texp = limit\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tok, e := s.store.Put(ctx, \"ticket:\"+digest(ticket), token, time.Until(exp))\n\tif e != nil || !ok {\n\t\treturn \"\", time.Time{}, ports.ErrUnavailable\n\t}\n\treturn ticket, exp, nil\n}\n\nfunc (s *Service) ConsumeTicket(ctx context.Context, ticket string) (Claims, error) {\n\tif !hex64.MatchString(ticket) {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\tif s.store == nil {\n\t\treturn Claims{}, ports.ErrUnavailable\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttoken, e := s.store.Take(ctx, \"ticket:\"+digest(ticket))\n\tif e != nil {\n\t\treturn Claims{}, ports.ErrUnavailable\n\t}\n\tif token == \"\" {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\treturn s.Check(ctx, token)\n}\n\n// SocketIdentity is transport-independent; S10 must call Current before every\n// protected command/push and close on expiry. Refresh cannot switch principals.\ntype SocketIdentity struct {\n\tmu     sync.Mutex\n\tclaims Claims\n}\n\nfunc NewSocketIdentity(c Claims) *SocketIdentity {\n\tc.Scopes = append([]string(nil), c.Scopes...)\n\treturn &SocketIdentity{claims: c}\n}\nfunc (s *SocketIdentity) Current(ctx context.Context, auth *Service) (Claims, error) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tif e := auth.Validate(ctx, s.claims); e != nil {\n\t\treturn Claims{}, e\n\t}\n\tc := s.claims\n\tc.Scopes = append([]string(nil), c.Scopes...)\n\treturn c, nil\n}\nfunc (s *SocketIdentity) Refresh(ctx context.Context, auth *Service, token string) error {\n\tc, e := auth.Check(ctx, token)\n\tif e != nil {\n\t\treturn e\n\t}\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\told := s.claims\n\tif old.ExpiresAt <= time.Now().Unix() || c.ActorID != old.ActorID || c.Kind != old.Kind || c.SourceID != old.SourceID || c.SessionID != old.SessionID || c.Environment != old.Environment || c.Version != old.Version {\n\t\treturn ErrUnauthorized\n\t}\n\tfor _, scope := range c.Scopes {\n\t\tfound := false\n\t\tfor _, prior := range old.Scopes {\n\t\t\tif scope == prior {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn ErrUnauthorized\n\t\t}\n\t}\n\tif c.ExpiresAt < old.ExpiresAt {\n\t\treturn ErrUnauthorized\n\t}\n\ts.claims = c\n\treturn nil\n}\n","chat/internal/auth/token.go":"// Package auth verifies PHP-issued identities; it does not own accounts or roles.\npackage auth\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrUnauthorized = errors.New(\"CHAT_UNAUTHORIZED\")\nvar hex64 = regexp.MustCompile(`^[a-f0-9]{64}$`)\nvar keyID = regexp.MustCompile(`^[a-z0-9_-]{1,32}$`)\n\ntype Claims struct {\n\tIssuer      string   `json:\"iss\"`\n\tAudience    string   `json:\"aud\"`\n\tActorID     ports.ID `json:\"sub\"`\n\tKind        string   `json:\"kind\"`\n\tSourceID    ports.ID `json:\"source_id\"`\n\tSessionID   string   `json:\"session_id\"`\n\tVersion     string   `json:\"session_version\"`\n\tEnvironment string   `json:\"env\"`\n\tScopes      []string `json:\"scopes\"`\n\tIssuedAt    int64    `json:\"iat\"`\n\tNotBefore   int64    `json:\"nbf\"`\n\tExpiresAt   int64    `json:\"exp\"`\n\tJTI         string   `json:\"jti\"`\n}\n\n// SessionSource must read current persistent authority on every protected action.\n// A successful signature never replaces logout/disable/permission revocation.\ntype SessionSource interface {\n\tValidate(context.Context, Claims) error\n}\n\ntype Verifier struct {\n\tenvironment string\n\tkeys        map[string]ed25519.PublicKey\n}\n\nfunc NewVerifier(environment string, keys map[string]ed25519.PublicKey) (*Verifier, error) {\n\tif !validEnvironment(environment) || len(keys) < 1 || len(keys) > 3 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tv := &Verifier{environment: environment, keys: make(map[string]ed25519.PublicKey)}\n\tfor id, k := range keys {\n\t\tif !keyID.MatchString(id) || len(k) != ed25519.PublicKeySize {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\tv.keys[id] = append(ed25519.PublicKey(nil), k...)\n\t}\n\treturn v, nil\n}\n\nfunc validEnvironment(s string) bool { return s == \"development\" || s == \"test\" || s == \"production\" }\n\nfunc (v *Verifier) Verify(token string, now time.Time) (Claims, error) {\n\tvar c Claims\n\tif len(token) > 4096 {\n\t\treturn c, ErrUnauthorized\n\t}\n\tp := strings.Split(token, \".\")\n\tif len(p) != 3 {\n\t\treturn c, ErrUnauthorized\n\t}\n\th, err := base64.RawURLEncoding.Strict().DecodeString(p[0])\n\tif err != nil {\n\t\treturn c, ErrUnauthorized\n\t}\n\tvar header struct {\n\t\tAlgorithm string `json:\"alg\"`\n\t\tType      string `json:\"typ\"`\n\t\tKeyID     string `json:\"kid\"`\n\t}\n\tif !strictJSON(h, &header) || header.Algorithm != \"EdDSA\" || header.Type != \"JWT\" {\n\t\treturn c, ErrUnauthorized\n\t}\n\tk := v.keys[header.KeyID]\n\tif len(k) != ed25519.PublicKeySize {\n\t\treturn c, ErrUnauthorized\n\t}\n\tsig, err := base64.RawURLEncoding.Strict().DecodeString(p[2])\n\tif err != nil || !ed25519.Verify(k, []byte(p[0]+\".\"+p[1]), sig) {\n\t\treturn c, ErrUnauthorized\n\t}\n\tbody, err := base64.RawURLEncoding.Strict().DecodeString(p[1])\n\tif err != nil || !strictJSON(body, &c) {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\tt := now.Unix()\n\tif c.Issuer != \"bixuan-php:\"+v.environment || c.Audience != \"bixuan-chat\" || c.Environment != v.environment || !c.ActorID.Valid() || c.ActorID == \"0\" || !hex64.MatchString(c.SessionID) || !hex64.MatchString(c.Version) || !hex64.MatchString(c.JTI) ||\n\t\t(c.Kind != \"mini\" && c.Kind != \"admin\" && c.Kind != \"mini_audit\") || !c.SourceID.Valid() || c.SourceID == \"0\" || c.IssuedAt <= 0 || c.NotBefore != c.IssuedAt || c.IssuedAt > t+5 || c.ExpiresAt <= t || c.ExpiresAt <= c.IssuedAt || c.ExpiresAt-c.IssuedAt > 300 || !validScopes(c.Kind, c.Scopes) {\n\t\treturn Claims{}, ErrUnauthorized\n\t}\n\treturn c, nil\n}\n\nfunc validScopes(kind string, scopes []string) bool {\n\tif len(scopes) < 1 || len(scopes) > 4 {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor _, s := range scopes {\n\t\tif seen[s] || !(s == \"chat:use\" && kind == \"mini\" || s == \"chat:audit\" && kind == \"mini_audit\" || kind == \"admin\" && (s == \"chat:audit\" || s == \"chat:moderate\" || s == \"chat:images\" || s == \"chat:evidence\")) {\n\t\t\treturn false\n\t\t}\n\t\tseen[s] = true\n\t}\n\treturn true\n}\n\n// Reject duplicate/unknown/case-alias keys, trailing values and non-object roots.\nfunc strictJSON(data []byte, target any) bool {\n\tvar fields map[string]json.RawMessage\n\td := json.NewDecoder(bytes.NewReader(data))\n\tt, e := d.Token()\n\tif e != nil || t != json.Delim('{') {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tt, e = d.Token()\n\t\ts, ok := t.(string)\n\t\tif e != nil || !ok || seen[s] {\n\t\t\treturn false\n\t\t}\n\t\tseen[s] = true\n\t\tvar value json.RawMessage\n\t\tif d.Decode(&value) != nil {\n\t\t\treturn false\n\t\t}\n\t}\n\tif _, e = d.Token(); e != nil {\n\t\treturn false\n\t}\n\tif _, e = d.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\tif json.Unmarshal(data, &fields) != nil {\n\t\treturn false\n\t}\n\t// Re-encode after typed decoding to compare the exact accepted field names.\n\td = json.NewDecoder(bytes.NewReader(data))\n\td.DisallowUnknownFields()\n\tif d.Decode(target) != nil {\n\t\treturn false\n\t}\n\tencoded, e := json.Marshal(target)\n\tif e != nil {\n\t\treturn false\n\t}\n\tvar names map[string]json.RawMessage\n\tif json.Unmarshal(encoded, &names) != nil {\n\t\treturn false\n\t}\n\tfor name := range fields {\n\t\tif _, ok := names[name]; !ok {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n","chat/internal/bootstrap/app.go":"package bootstrap\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"flag\"\n\t\"io\"\n\t\"log/slog\"\n\t\"runtime\"\n\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n)\n\nvar (\n\tsourceRevision = \"unknown\"\n\tsourceDirty    = \"unknown\"\n)\n\nconst stage = \"S11\"\n\ntype versionInfo struct {\n\tStage           string `json:\"stage\"`\n\tGoVersion       string `json:\"go_version\"`\n\tSourceRevision  string `json:\"source_revision\"`\n\tSourceDirty     string `json:\"source_dirty\"`\n\tProtocolVersion int    `json:\"protocol_version\"`\n\tGOOS            string `json:\"goos\"`\n\tGOARCH          string `json:\"goarch\"`\n}\n\n// Run owns bounded dependencies, never order rules, migrations or chat delivery.\nfunc Run(ctx context.Context, args []string, stdout, stderr io.Writer) int {\n\tlogger := newLogger(stderr, slog.LevelInfo, \"cli\", \"unknown\")\n\tif len(args) == 0 {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"用法: chatd version | check-config/serve/worker --config 文件.json\", 2})\n\t}\n\tif args[0] == \"help\" || args[0] == \"--help\" || args[0] == \"-h\" {\n\t\t_, err := io.WriteString(stdout, \"chatd version\\nchatd check-config --config 文件.json [--probe]\\nchatd serve --config 文件.json\\nchatd worker --config 文件.json\\nS11实时恢复与历史/已读可独立配置，真实消息未开放。\\n\")\n\t\tif err != nil {\n\t\t\treturn fail(logger, &Fault{\"CHAT_OUTPUT_FAILED\", \"无法写入命令输出\", 1})\n\t\t}\n\t\treturn 0\n\t}\n\tif args[0] == \"version\" {\n\t\tif len(args) != 1 {\n\t\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"version不接受额外参数\", 2})\n\t\t}\n\t\treturn output(logger, stdout, versionInfo{Stage: stage, GoVersion: runtime.Version(), SourceRevision: sourceRevision, SourceDirty: sourceDirty, ProtocolVersion: 1, GOOS: runtime.GOOS, GOARCH: runtime.GOARCH})\n\t}\n\tcommand := args[0]\n\tif command != \"check-config\" && command != \"serve\" && command != \"worker\" {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"未知命令，请运行chatd help\", 2})\n\t}\n\tflags := flag.NewFlagSet(command, flag.ContinueOnError)\n\tflags.SetOutput(io.Discard) // flag errors otherwise echo paths and values.\n\tpath := flags.String(\"config\", \"\", \"配置文件\")\n\tprobe := flags.Bool(\"probe\", false, \"只读探测依赖\")\n\tif err := flags.Parse(args[1:]); err != nil || flags.NArg() != 0 || *path == \"\" {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"请仅使用--config指定JSON配置文件\", 2})\n\t}\n\tif *probe && command != \"check-config\" {\n\t\treturn fail(logger, &Fault{\"CHAT_USAGE\", \"--probe仅供check-config使用\", 2})\n\t}\n\tcfg, fault := LoadConfig(*path)\n\tif fault != nil {\n\t\treturn fail(logger, fault)\n\t}\n\tlevel, _ := logLevel(cfg.LogLevel)\n\tlogger = newLogger(stderr, level, command, cfg.Environment)\n\tif command == \"check-config\" && !*probe {\n\t\treturn output(logger, stdout, struct {\n\t\t\tStatus string `json:\"status\"`\n\t\t\tStage  string `json:\"stage\"`\n\t\t\tScope  string `json:\"scope\"`\n\t\t}{\"ok\", stage, \"config_only\"})\n\t}\n\tif ctx.Err() != nil {\n\t\treturn 0\n\t}\n\trole := command\n\tif role == \"check-config\" {\n\t\trole = \"serve\"\n\t}\n\tdeps, err := dependencies.Open(cfg.Dependencies, cfg.Environment, role, cfg.ProviderMode)\n\tif err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_DEPENDENCY_CONFIG_INVALID\", \"依赖凭证或初始化配置不可用\", 2})\n\t}\n\tdefer deps.Close()\n\tif err := deps.EnableIdentity(cfg.Auth); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_AUTH_INVALID\", \"身份适配配置不可用\", 2})\n\t}\n\tif err := deps.EnableConversations(cfg.Conversations); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_CONVERSATIONS_INVALID\", \"会话投影配置不可用\", 2})\n\t}\n\tif err := deps.EnableSafety(cfg.Safety); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_SAFETY_INVALID\", \"文本审核适配配置不可用\", 2})\n\t}\n\tif err := deps.EnableHistory(cfg.History); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_HISTORY_INVALID\", \"历史读取配置不可用\", 2})\n\t}\n\tif err := deps.EnableSocket(cfg.Socket); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_CONFIG_SOCKET_INVALID\", \"WSS连接配置不可用\", 2})\n\t}\n\tsnapshot := deps.Refresh(ctx)\n\tif command == \"check-config\" {\n\t\tif code := output(logger, stdout, snapshot); code != 0 {\n\t\t\treturn code\n\t\t}\n\t\tif !snapshot.InfrastructureReady {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\tmonitorCtx, stopMonitor := context.WithCancel(ctx)\n\tmonitorDone := make(chan struct{})\n\tgo func() { defer close(monitorDone); deps.Monitor(monitorCtx) }()\n\tdefer func() { stopMonitor(); <-monitorDone }()\n\tif command == \"worker\" {\n\t\tif deps.Moderation != nil {\n\t\t\tdone := make(chan struct{})\n\t\t\tgo func() { defer close(done); deps.Moderation.Maintain(ctx) }()\n\t\t\tdefer func() { <-done }()\n\t\t}\n\n\t\tif deps.Conversations != nil {\n\t\t\tlogger.Info(\"worker_started\", \"mode\", \"conversation_projection\", \"tasks_enabled\", true)\n\t\t\tdeps.Conversations.Run(ctx, logger)\n\t\t\tlogger.Info(\"worker_stopped\")\n\t\t\treturn 0\n\t\t}\n\t\tlogger.Info(\"worker_started\", \"mode\", \"idle\", \"tasks_enabled\", false)\n\t\t<-ctx.Done()\n\t\tlogger.Info(\"worker_stopped\")\n\t\treturn 0\n\t}\n\tif fault := serve(ctx, cfg, logger, deps); fault != nil {\n\t\treturn fail(logger, fault)\n\t}\n\treturn 0\n}\n\nfunc newLogger(w io.Writer, level slog.Level, process, environment string) *slog.Logger {\n\treturn slog.New(slog.NewJSONHandler(w, &slog.HandlerOptions{Level: level})).With(\n\t\t\"component\", \"chatd\", \"stage\", stage, \"process\", process, \"env\", environment)\n}\n\nfunc requestID() string {\n\tvar value [16]byte\n\tif _, err := rand.Read(value[:]); err != nil {\n\t\treturn \"unavailable\"\n\t}\n\treturn hex.EncodeToString(value[:])\n}\n\nfunc fail(logger *slog.Logger, fault *Fault) int {\n\tlogger.Error(fault.Message, \"code\", fault.Code, \"request_id\", requestID())\n\treturn fault.Exit\n}\n\nfunc output(logger *slog.Logger, w io.Writer, value any) int {\n\tif err := json.NewEncoder(w).Encode(value); err != nil {\n\t\treturn fail(logger, &Fault{\"CHAT_OUTPUT_FAILED\", \"无法写入命令输出\", 1})\n\t}\n\treturn 0\n}\n","chat/internal/bootstrap/app_test.go":"package bootstrap\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\ntype capturedLogs struct {\n\tmu     sync.Mutex\n\tdata   bytes.Buffer\n\tevents chan map[string]any\n}\n\nfunc (c *capturedLogs) Write(p []byte) (int, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tn, err := c.data.Write(p)\n\tvar event map[string]any\n\tif json.Unmarshal(p, &event) == nil {\n\t\tselect {\n\t\tcase c.events <- event:\n\t\tdefault:\n\t\t}\n\t}\n\treturn n, err\n}\n\nfunc waitEvent(t *testing.T, logs *capturedLogs, message string) map[string]any {\n\tt.Helper()\n\ttimer := time.NewTimer(3 * time.Second)\n\tdefer timer.Stop()\n\tfor {\n\t\tselect {\n\t\tcase event := <-logs.events:\n\t\t\tif event[\"msg\"] == message {\n\t\t\t\treturn event\n\t\t\t}\n\t\tcase <-timer.C:\n\t\t\tt.Fatalf(\"did not observe %s\", message)\n\t\t}\n\t}\n}\n\nfunc TestCLICommandsAndSafeErrors(t *testing.T) {\n\tpath := configFile(t, encodedConfig(t, testConfig()))\n\tfor _, command := range []string{\"version\", \"check-config\"} {\n\t\tvar out, logs bytes.Buffer\n\t\targs := []string{command}\n\t\tif command == \"check-config\" {\n\t\t\targs = append(args, \"--config\", path)\n\t\t}\n\t\tif code := Run(context.Background(), args, &out, &logs); code != 0 {\n\t\t\tt.Fatalf(\"%s: exit=%d: %s\", command, code, logs.String())\n\t\t}\n\t\tvar value map[string]any\n\t\tif err := json.Unmarshal(out.Bytes(), &value); err != nil || value[\"stage\"] != stage || logs.Len() != 0 {\n\t\t\tt.Fatalf(\"unexpected output: %s / %s\", out.String(), logs.String())\n\t\t}\n\t\tif strings.Contains(out.String(), path) {\n\t\t\tt.Fatal(\"config path leaked\")\n\t\t}\n\t}\n\tbadConfig := configFile(t, `{\"password\":\"secret-input\",\"env\":\"development\"}`)\n\tfor _, args := range [][]string{\n\t\tnil, {\"secret-input\"}, {\"version\", \"secret-input\"}, {\"serve\"},\n\t\t{\"worker\", \"--secret-input=secret-input\"}, {\"check-config\", \"--config\", \"secret-input\"},\n\t\t{\"serve\", \"--config\", badConfig}, {\"serve\", \"--config\", path, \"secret-input\"},\n\t} {\n\t\tvar out, logs bytes.Buffer\n\t\tif code := Run(context.Background(), args, &out, &logs); code != 2 {\n\t\t\tt.Fatalf(\"expected usage/config exit=2, got %d\", code)\n\t\t}\n\t\tvar value map[string]any\n\t\tif err := json.Unmarshal(logs.Bytes(), &value); err != nil || value[\"code\"] == nil || value[\"request_id\"] == nil {\n\t\t\tt.Fatalf(\"not a structured error: %s\", logs.String())\n\t\t}\n\t\tif out.Len() != 0 || strings.Contains(logs.String(), \"secret-input\") || strings.Contains(logs.String(), badConfig) {\n\t\t\tt.Fatalf(\"sensitive input echoed: %s / %s\", out.String(), logs.String())\n\t\t}\n\t}\n}\n\ntype brokenWriter struct{}\n\nfunc (brokenWriter) Write([]byte) (int, error) { return 0, errors.New(\"secret-input\") }\n\nfunc TestOutputFailureIsSafe(t *testing.T) {\n\tvar logs bytes.Buffer\n\tif code := Run(context.Background(), []string{\"version\"}, brokenWriter{}, &logs); code != 1 || strings.Contains(logs.String(), \"secret-input\") {\n\t\tt.Fatalf(\"unsafe output failure: exit=%d %s\", code, logs.String())\n\t}\n}\n\nfunc TestDependencyProbeIsExplicitAndSafe(t *testing.T) {\n\tcfg := testConfig()\n\tpath := configFile(t, encodedConfig(t, cfg))\n\tvar out, logs bytes.Buffer\n\tif code := Run(context.Background(), []string{\"check-config\", \"--config\", path, \"--probe\"}, &out, &logs); code != 1 {\n\t\tt.Fatalf(\"disabled dependencies exit=%d\", code)\n\t}\n\tvar health map[string]any\n\tif json.Unmarshal(out.Bytes(), &health) != nil || health[\"scope\"] != \"infrastructure_only\" || health[\"infrastructure_ready\"] != false || health[\"business_enabled\"] != false {\n\t\tt.Fatal(\"probe falsely reported business ready\")\n\t}\n\tcfg.Dependencies.MySQL.Enabled = true\n\tcfg.Dependencies.MySQL.Database = \"bixuan_dev_s02\"\n\tcfg.Dependencies.MySQL.Username = \"bxchat_development_test\"\n\tcfg.Dependencies.MySQL.PasswordEnv = \"CHAT_S02_MISSING_PASSWORD\"\n\tt.Setenv(\"CHAT_S02_MISSING_PASSWORD\", \"\")\n\tpath = configFile(t, encodedConfig(t, cfg))\n\tout.Reset()\n\tlogs.Reset()\n\tif code := Run(context.Background(), []string{\"check-config\", \"--config\", path}, &out, &logs); code != 0 {\n\t\tt.Fatalf(\"offline validation unexpectedly probed credentials: %d\", code)\n\t}\n\tout.Reset()\n\tlogs.Reset()\n\tif code := Run(context.Background(), []string{\"check-config\", \"--config\", path, \"--probe\"}, &out, &logs); code != 2 {\n\t\tt.Fatalf(\"missing secret exit=%d\", code)\n\t}\n\tif strings.Contains(logs.String(), \"bixuan_dev_s02\") || strings.Contains(logs.String(), \"CHAT_S02_MISSING_PASSWORD\") || out.Len() != 0 {\n\t\tt.Fatal(\"dependency error echoed configuration\")\n\t}\n}\n\nfunc TestWorkerWaitsForCancellation(t *testing.T) {\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\tlogs := &capturedLogs{events: make(chan map[string]any, 16)}\n\tpath := configFile(t, encodedConfig(t, testConfig()))\n\tfinished := make(chan int, 1)\n\tgo func() { finished <- Run(ctx, []string{\"worker\", \"--config\", path}, io.Discard, logs) }()\n\tevent := waitEvent(t, logs, \"worker_started\")\n\tif event[\"mode\"] != \"idle\" || event[\"tasks_enabled\"] != false {\n\t\tt.Fatalf(\"worker incorrectly claims task processing: %#v\", event)\n\t}\n\tselect {\n\tcase <-finished:\n\t\tt.Fatal(\"worker exited before cancellation\")\n\tdefault:\n\t}\n\tcancel()\n\tselect {\n\tcase code := <-finished:\n\t\tif code != 0 {\n\t\t\tt.Fatalf(\"exit=%d\", code)\n\t\t}\n\tcase <-time.After(3 * time.Second):\n\t\tt.Fatal(\"worker did not stop\")\n\t}\n\twaitEvent(t, logs, \"worker_stopped\")\n}\n","chat/internal/bootstrap/config.go":"package bootstrap\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n \"github.com/franz-9527/workers/chat/internal/imagepipeline\"\n\t\"github.com/franz-9527/workers/chat/internal/moderation\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n)\n\nconst maxConfigBytes = 64 << 10\n\n// Config contains implemented lifecycle and dependency settings only.\ntype Config struct {\n\tEnvironment string `json:\"env\"`\n\tHTTP        struct {\n\t\tListen         string `json:\"listen\"`\n\t\tInternalListen string `json:\"internal_listen\"`\n\t} `json:\"http\"`\n\tShutdownTimeout string                `json:\"shutdown_timeout\"`\n\tLogLevel        string                `json:\"log_level\"`\n\tProviderMode    string                `json:\"provider_mode\"`\n\tDependencies    dependencies.Settings `json:\"dependencies\"`\n\tAuth            auth.Config           `json:\"auth\"`\n\tConversations   conversation.Config   `json:\"conversations\"`\n\tImages imagepipeline.Config `json:\"images\"`\n Messages        message.Config        `json:\"messages\"`\n\tSafety          moderation.Config     `json:\"safety\"`\n\tHistory         message.HistoryConfig `json:\"history\"`\n\tSocket          socket.Config         `json:\"socket\"`\n}\n\n// Fault deliberately never wraps input, filenames, decoder or network errors.\n// CLI diagnostics must not echo malformed config values or credentials.\ntype Fault struct {\n\tCode    string\n\tMessage string\n\tExit    int\n}\n\nfunc (f *Fault) Error() string { return f.Message }\n\nfunc configFault(code, message string) *Fault {\n\treturn &Fault{Code: code, Message: message, Exit: 2}\n}\n\nfunc LoadConfig(path string) (Config, *Fault) {\n\tcfg := Config{ShutdownTimeout: \"10s\", LogLevel: \"info\", ProviderMode: \"disabled\", Dependencies: dependencies.Defaults()}\n\tinfo, err := os.Stat(path)\n\tif err != nil {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_READ_FAILED\", \"无法读取配置文件\")\n\t}\n\t// Reject devices/FIFOs before opening: opening a FIFO can otherwise block\n\t// check-config indefinitely. Deployment config paths are operator-controlled.\n\tif !info.Mode().IsRegular() || info.Size() > maxConfigBytes {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置必须是最多64KiB的普通JSON文件\")\n\t}\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_READ_FAILED\", \"无法读取配置文件\")\n\t}\n\tdefer f.Close()\n\tinfo, err = f.Stat()\n\tif err != nil || !info.Mode().IsRegular() || info.Size() > maxConfigBytes {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置必须是最多64KiB的普通JSON文件\")\n\t}\n\tdata, err := io.ReadAll(io.LimitReader(f, maxConfigBytes+1))\n\tif err != nil || len(data) > maxConfigBytes {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置读取失败或超过大小上限\")\n\t}\n\t// encoding/json accepts duplicate keys by default. Reject them before typed\n\t// decoding so a second security setting cannot silently override the first.\n\tpreflight := json.NewDecoder(strings.NewReader(string(data)))\n\tif !uniqueJSON(preflight, 0) {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"JSON格式错误、重复字段或嵌套过深\")\n\t}\n\tif _, err := preflight.Token(); err != io.EOF {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"配置只能包含一个JSON对象\")\n\t}\n\tdecoder := json.NewDecoder(strings.NewReader(string(data)))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&cfg); err != nil {\n\t\treturn cfg, configFault(\"CHAT_CONFIG_INVALID\", \"JSON字段、类型或结构不符合当前配置\")\n\t}\n\tif fault := cfg.validate(); fault != nil {\n\t\treturn cfg, fault\n\t}\n\treturn cfg, nil\n}\n\nfunc uniqueJSON(d *json.Decoder, depth int) bool {\n\tif depth > 16 {\n\t\treturn false\n\t}\n\ttoken, err := d.Token()\n\tif err != nil || token == nil {\n\t\treturn false\n\t}\n\tdelimiter, compound := token.(json.Delim)\n\tif !compound {\n\t\treturn true\n\t}\n\tif delimiter != '{' && delimiter != '[' {\n\t\treturn false\n\t}\n\tkeys := make(map[string]bool)\n\tfor d.More() {\n\t\tif delimiter == '{' {\n\t\t\tkey, err := d.Token()\n\t\t\tname, ok := key.(string)\n\t\t\tif err != nil || !ok || name != strings.ToLower(name) || keys[name] {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tkeys[name] = true\n\t\t}\n\t\tif !uniqueJSON(d, depth+1) {\n\t\t\treturn false\n\t\t}\n\t}\n\tend, err := d.Token()\n\treturn err == nil && ((delimiter == '{' && end == json.Delim('}')) ||\n\t\t(delimiter == '[' && end == json.Delim(']')))\n}\n\nfunc (c Config) validate() *Fault {\n\tif c.Environment != \"development\" && c.Environment != \"test\" && c.Environment != \"production\" {\n\t\treturn configFault(\"CHAT_CONFIG_ENV_INVALID\", \"env须为development、test或production\")\n\t}\n\tif !validLoopback(c.HTTP.Listen, c.Environment) || !validLoopback(c.HTTP.InternalListen, c.Environment) {\n\t\treturn configFault(\"CHAT_CONFIG_LISTEN_INVALID\", \"HTTP与内部端口必须使用回环IP及合法端口\")\n\t}\n\t_, port, _ := net.SplitHostPort(c.HTTP.Listen)\n\tif c.HTTP.Listen == c.HTTP.InternalListen && port != \"0\" {\n\t\treturn configFault(\"CHAT_CONFIG_LISTEN_CONFLICT\", \"HTTP与内部监听地址不能相同\")\n\t}\n\tduration, err := time.ParseDuration(c.ShutdownTimeout)\n\tif err != nil || duration < time.Second || duration > 30*time.Second {\n\t\treturn configFault(\"CHAT_CONFIG_TIMEOUT_INVALID\", \"shutdown_timeout须在1秒至30秒之间\")\n\t}\n\tif _, ok := logLevel(c.LogLevel); !ok {\n\t\treturn configFault(\"CHAT_CONFIG_LOG_INVALID\", \"log_level须为debug、info、warn或error\")\n\t}\n\tif c.ProviderMode != \"disabled\" && c.ProviderMode != \"fake\" {\n\t\treturn configFault(\"CHAT_PROVIDER_NOT_IMPLEMENTED\", \"真实业务提供者尚未实现\")\n\t}\n\tif c.ProviderMode == \"fake\" && c.Environment == \"production\" {\n\t\treturn configFault(\"CHAT_CONFIG_FAKE_FORBIDDEN\", \"生产环境禁止测试提供者\")\n\t}\n\tif c.Dependencies.Validate(c.Environment) != nil {\n\t\treturn configFault(\"CHAT_CONFIG_DEPENDENCY_INVALID\", \"依赖配置、环境隔离或资源预算不符合要求\")\n\t}\n\tif c.Auth.Enabled {\n\t\tif !c.Dependencies.MySQL.Enabled || c.ProviderMode != \"disabled\" {\n\t\t\treturn configFault(\"CHAT_CONFIG_AUTH_INVALID\", \"真实身份需要独立MySQL权限且不能混用测试身份\")\n\t\t}\n\t\tif _, err := c.Auth.Verifier(c.Environment); err != nil {\n\t\t\treturn configFault(\"CHAT_CONFIG_AUTH_INVALID\", \"身份公钥配置不可用\")\n\t\t}\n\t}\n\tif c.Conversations.Enabled && (!c.Auth.Enabled || !c.Dependencies.MySQL.Enabled || c.ProviderMode != \"disabled\") {\n\t\treturn configFault(\"CHAT_CONFIG_CONVERSATIONS_INVALID\", \"会话投影需要真实身份和独立MySQL权限\")\n\t}\n\tif c.Safety.Validate() != nil || c.Safety.Enabled && (!c.Conversations.Enabled || !c.Auth.Enabled || c.ProviderMode != \"disabled\" || c.Dependencies.Timeout() < 100*time.Millisecond) {\n\t\treturn configFault(\"CHAT_CONFIG_SAFETY_INVALID\", \"真实审核需要真实身份、会话、独立数据库和可信凭证文件\")\n\t}\n\tif _, e := c.History.Key(); e != nil || c.History.Enabled && (!c.Conversations.Enabled || !c.Auth.Enabled || c.ProviderMode != \"disabled\" || c.Dependencies.Timeout() < 100*time.Millisecond) {\n\t\treturn configFault(\"CHAT_CONFIG_HISTORY_INVALID\", \"历史读取需要真实身份、会话、独立数据库和游标签名密钥\")\n\t}\n\tif c.Images.Enabled{return configFault(\"CHAT_IMAGES_NOT_READY\",\"图片发布门禁完成前禁止开放上传与预审接口\")}\n if c.Messages.Enabled {\n\t\treturn configFault(\"CHAT_MESSAGES_NOT_READY\", \"聊天发布门禁完成前禁止开放发送\")\n\t}\n\tif c.Socket.Enabled && (!c.Auth.Enabled || !c.Dependencies.MySQL.Enabled || !c.Dependencies.Redis.Enabled || c.ProviderMode != \"disabled\") {\n\t\treturn configFault(\"CHAT_CONFIG_SOCKET_INVALID\", \"WSS需要真实身份、MySQL和一次性票据Redis\")\n\t}\n\treturn nil\n}\n\nfunc validLoopback(address, environment string) bool {\n\thost, port, err := net.SplitHostPort(address)\n\tif err != nil {\n\t\treturn false\n\t}\n\tip := net.ParseIP(host)\n\tn, err := strconv.Atoi(port)\n\treturn err == nil && ip != nil && ip.IsLoopback() && n >= 0 && n <= 65535 &&\n\t\t(n != 0 || environment == \"development\")\n}\n\nfunc logLevel(value string) (slog.Level, bool) {\n\tlevels := map[string]slog.Level{\"debug\": slog.LevelDebug, \"info\": slog.LevelInfo, \"warn\": slog.LevelWarn, \"error\": slog.LevelError}\n\tlevel, ok := levels[value]\n\treturn level, ok\n}\n","chat/internal/bootstrap/config_test.go":"package bootstrap\n\nimport (\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n)\n\nfunc testConfig() Config {\n\tc := Config{Environment: \"development\", ShutdownTimeout: \"1s\", LogLevel: \"info\", ProviderMode: \"disabled\", Dependencies: dependencies.Defaults()}\n\tc.HTTP.Listen = \"127.0.0.1:0\"\n\tc.HTTP.InternalListen = \"127.0.0.1:0\"\n\treturn c\n}\n\nfunc configFile(t *testing.T, contents string) string {\n\tt.Helper()\n\tp := filepath.Join(t.TempDir(), \"chat.json\")\n\tif err := os.WriteFile(p, []byte(contents), 0600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn p\n}\n\nfunc encodedConfig(t *testing.T, cfg Config) string {\n\tt.Helper()\n\tdata, err := json.Marshal(cfg)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn string(data)\n}\n\nfunc TestConfigValidation(t *testing.T) {\n\tvalid := encodedConfig(t, testConfig())\n\ttests := []struct{ name, data, code string }{\n\t\t{\"valid\", valid, \"\"},\n\t\t{\"malformed\", `{\"env\":\"secret-input`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"trailing_object\", valid + `{}`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"unknown_field\", strings.Replace(valid, `\"provider_mode\"`, `\"api_secret\"`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"duplicate_field\", strings.Replace(valid, `\"env\":`, `\"env\":\"test\",\"env\":`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"case_alias\", strings.Replace(valid, `\"env\":`, `\"ENV\":\"test\",\"env\":`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"null_mode\", strings.Replace(valid, `\"provider_mode\":\"disabled\"`, `\"provider_mode\":null`, 1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"null_root\", `null`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"array\", `[]`, \"CHAT_CONFIG_INVALID\"},\n\t\t{\"oversized\", strings.Repeat(\" \", maxConfigBytes+1), \"CHAT_CONFIG_INVALID\"},\n\t\t{\"empty\", `{}`, \"CHAT_CONFIG_ENV_INVALID\"},\n\t\t{\"unknown_env\", strings.Replace(valid, \"development\", \"secret-input\", 1), \"CHAT_CONFIG_ENV_INVALID\"},\n\t\t{\"public_bind\", strings.ReplaceAll(valid, \"127.0.0.1\", \"0.0.0.0\"), \"CHAT_CONFIG_LISTEN_INVALID\"},\n\t\t{\"hostname\", strings.ReplaceAll(valid, \"127.0.0.1\", \"localhost\"), \"CHAT_CONFIG_LISTEN_INVALID\"},\n\t\t{\"production_ephemeral\", strings.Replace(valid, \"development\", \"production\", 1), \"CHAT_CONFIG_LISTEN_INVALID\"},\n\t\t{\"conflicting_ports\", strings.ReplaceAll(valid, \":0\", \":19501\"), \"CHAT_CONFIG_LISTEN_CONFLICT\"},\n\t\t{\"negative_timeout\", strings.Replace(valid, `\"1s\"`, `\"-1s\"`, 1), \"CHAT_CONFIG_TIMEOUT_INVALID\"},\n\t\t{\"long_timeout\", strings.Replace(valid, `\"1s\"`, `\"31s\"`, 1), \"CHAT_CONFIG_TIMEOUT_INVALID\"},\n\t\t{\"invalid_log_level\", strings.Replace(valid, `\"info\"`, `\"secret-input\"`, 1), \"CHAT_CONFIG_LOG_INVALID\"},\n\t\t{\"fake_provider\", strings.Replace(valid, `\"disabled\"`, `\"fake\"`, 1), \"\"},\n\t\t{\"real_provider\", strings.Replace(valid, `\"disabled\"`, `\"real\"`, 1), \"CHAT_PROVIDER_NOT_IMPLEMENTED\"},\n\t}\n\tfor _, test := range tests {\n\t\tt.Run(test.name, func(t *testing.T) {\n\t\t\t_, fault := LoadConfig(configFile(t, test.data))\n\t\t\tif test.code == \"\" {\n\t\t\t\tif fault != nil {\n\t\t\t\t\tt.Fatal(fault)\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif fault == nil || fault.Code != test.code || strings.Contains(fault.Error(), \"secret-input\") {\n\t\t\t\tt.Fatalf(\"expected safe fault %s, got %#v\", test.code, fault)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestConfigDefaultsAndReadFailure(t *testing.T) {\n\tproduction := testConfig()\n\tproduction.Environment = \"production\"\n\tproduction.ProviderMode = \"fake\"\n\tproduction.HTTP.Listen = \"127.0.0.1:9501\"\n\tproduction.HTTP.InternalListen = \"127.0.0.1:9502\"\n\tif _, fault := LoadConfig(configFile(t, encodedConfig(t, production))); fault == nil || fault.Code != \"CHAT_CONFIG_FAKE_FORBIDDEN\" {\n\t\tt.Fatal(\"production fixture mode accepted\")\n\t}\n\tcfg, fault := LoadConfig(configFile(t, `{\"env\":\"test\",\"http\":{\"listen\":\"127.0.0.1:19501\",\"internal_listen\":\"127.0.0.1:19502\"}}`))\n\tif fault != nil || cfg.ShutdownTimeout != \"10s\" || cfg.ProviderMode != \"disabled\" || cfg.LogLevel != \"info\" {\n\t\tt.Fatalf(\"unsafe defaults: %#v, %v\", cfg, fault)\n\t}\n\tfor _, path := range []string{t.TempDir(), filepath.Join(t.TempDir(), \"secret-input.json\")} {\n\t\t_, fault := LoadConfig(path)\n\t\tif fault == nil || strings.Contains(fault.Error(), path) {\n\t\t\tt.Fatalf(\"expected safe read fault, got %#v\", fault)\n\t\t}\n\t}\n}\n\nfunc TestRealIdentityConfiguration(t *testing.T) {\n\tc := testConfig()\n\tc.Auth.Enabled = true\n\tc.Auth.PublicKeys = map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}\n\tif c.validate() == nil {\n\t\tt.Fatal(\"identity requires SQL\")\n\t}\n\tc.Dependencies.MySQL.Enabled = true\n\tc.Dependencies.MySQL.Database = \"bixuan_dev_identity\"\n\tc.Dependencies.MySQL.Username = \"bxchat_development_identity\"\n\tif f := c.validate(); f != nil {\n\t\tt.Fatal(f)\n\t}\n\tc.ProviderMode = \"fake\"\n\tif c.validate() == nil {\n\t\tt.Fatal(\"mixed real/fake authority\")\n\t}\n\tc.ProviderMode = \"disabled\"\n\tc.Auth.PublicKeys[\"chat-v1\"] = \"bad-key\"\n\tif c.validate() == nil {\n\t\tt.Fatal(\"bad public key\")\n\t}\n}\n\nfunc TestConversationProjectionConfiguration(t *testing.T) {\n\tc := testConfig()\n\tc.Conversations.Enabled = true\n\tif c.validate() == nil {\n\t\tt.Fatal(\"projection must not mix disabled identity or test providers\")\n\t}\n\tc.Auth.Enabled = true\n\tc.Auth.PublicKeys = map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}\n\tc.Dependencies.MySQL.Enabled = true\n\tc.Dependencies.MySQL.Database = \"bixuan_dev_projection\"\n\tc.Dependencies.MySQL.Username = \"bxchat_development_projection\"\n\tif err := c.validate(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.ProviderMode = \"fake\"\n\tif c.validate() == nil {\n\t\tt.Fatal(\"fake projection accepted\")\n\t}\n}\n\nfunc TestS06CannotEnableSending(t *testing.T) {\n\tc := testConfig()\n\tc.Messages.Enabled = true\n\t_, fault := LoadConfig(configFile(t, encodedConfig(t, c)))\n\tif fault == nil || fault.Code != \"CHAT_MESSAGES_NOT_READY\" {\n\t\tt.Fatal(\"S06 send gate was bypassed\", fault)\n\t}\n}\n\nfunc TestS07SafetyCannotUseFakeOrUnboundIdentity(t *testing.T) {\n\tc := testConfig()\n\tc.Safety.Enabled = true\n\tc.Safety.AppID = \"wx_s07_fixture\"\n\tc.Safety.CredentialFile = \"/tmp/fixture-token.json\"\n\t_, fault := LoadConfig(configFile(t, encodedConfig(t, c)))\n\tif fault == nil || fault.Code != \"CHAT_CONFIG_SAFETY_INVALID\" {\n\t\tt.Fatal(\"unbound safety enabled\", fault)\n\t}\n\tc.Safety.Enabled = false\n\t_, fault = LoadConfig(configFile(t, encodedConfig(t, c)))\n\tif fault == nil || fault.Code != \"CHAT_CONFIG_SAFETY_INVALID\" {\n\t\tt.Fatal(\"disabled safety retained credential settings\", fault)\n\t}\n}\n\nfunc TestS08HistoryRequiresBoundIdentityAndPrivateCursorKey(t *testing.T) {\n\tc := testConfig()\n\tc.History.Enabled = true\n\tc.History.CursorKeyEnv = \"CHAT_S08_FIXTURE_CURSOR\"\n\tt.Setenv(c.History.CursorKeyEnv, strings.Repeat(\"ab\", 32))\n\tif c.validate() == nil {\n\t\tt.Fatal(\"unbound history enabled\")\n\t}\n\tc.Auth.Enabled = true\n\tc.Auth.PublicKeys = map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}\n\tc.Conversations.Enabled = true\n\tc.Dependencies.MySQL.Enabled = true\n\tc.Dependencies.MySQL.Database = \"bixuan_dev_history\"\n\tc.Dependencies.MySQL.Username = \"bxchat_development_history\"\n\tif e := c.validate(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Setenv(c.History.CursorKeyEnv, \"malformed\")\n\tif c.validate() == nil {\n\t\tt.Fatal(\"weak cursor key accepted\")\n\t}\n\tc.History.Enabled = false\n\tif c.validate() == nil {\n\t\tt.Fatal(\"disabled config retained key\")\n\t}\n}\n\nfunc TestImageReleaseGateRemainsClosed(t *testing.T){\n c:=testConfig();c.Images.Enabled=true\n if fault:=c.validate();fault==nil||fault.Code!=\"CHAT_IMAGES_NOT_READY\"{t.Fatal(\"image deployment gate opened\",fault)}\n}\n","chat/internal/bootstrap/server.go":"package bootstrap\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"log\"\n\t\"log/slog\"\n\t\"net\"\n\t\"net/http\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n)\n\nfunc serve(ctx context.Context, cfg Config, logger *slog.Logger, runtimes ...*dependencies.Runtime) *Fault {\n\tvar deps *dependencies.Runtime\n\tif len(runtimes) > 0 {\n\t\tdeps = runtimes[0]\n\t}\n\tvar listeners []net.Listener\n\tdefer func() {\n\t\tfor _, listener := range listeners {\n\t\t\t_ = listener.Close()\n\t\t}\n\t}()\n\tfor _, address := range []string{cfg.HTTP.Listen, cfg.HTTP.InternalListen} {\n\t\tlistener, err := (&net.ListenConfig{}).Listen(ctx, \"tcp\", address)\n\t\tif err != nil {\n\t\t\tif ctx.Err() != nil {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn &Fault{\"CHAT_LISTEN_FAILED\", \"监听启动失败，请检查端口及权限\", 1}\n\t\t}\n\t\tlisteners = append(listeners, listener)\n\t}\n\tservers := []*http.Server{newHTTPServer(false, logger, deps), newHTTPServer(true, logger, deps)}\n\tfinished := make(chan error, len(servers))\n\tfor i, server := range servers {\n\t\tlistener := listeners[i]\n\t\tgo func() { finished <- server.Serve(listener) }()\n\t}\n\tlogger.Info(\"serve_started\", \"public_address\", listeners[0].Addr().String(),\n\t\t\"internal_address\", listeners[1].Addr().String(), \"business_enabled\", false)\n\tremaining := len(servers)\n\tvar fault *Fault\n\tselect {\n\tcase <-ctx.Done():\n\tcase err := <-finished:\n\t\tremaining--\n\t\tif !errors.Is(err, http.ErrServerClosed) {\n\t\t\tfault = &Fault{\"CHAT_HTTP_FAILED\", \"HTTP服务异常停止\", 1}\n\t\t}\n\t}\n\tlogger.Info(\"serve_stopping\")\n\tif deps != nil {\n\t\tdeps.Stop()\n\t}\n\ttimeout, _ := time.ParseDuration(cfg.ShutdownTimeout)\n\tshutdown, cancel := context.WithTimeout(context.Background(), timeout)\n\tdefer cancel()\n\tif deps != nil && deps.Socket != nil {\n\t\tif err := deps.Socket.Shutdown(shutdown); err != nil {\n\t\t\tlogger.Warn(\"socket_drain_timeout\", \"code\", \"CHAT_SHUTDOWN_FORCED\")\n\t\t\tfault = &Fault{\"CHAT_SHUTDOWN_FORCED\", \"WSS连接未在排空期限内关闭\", 1}\n\t\t}\n\t}\n\tfor _, server := range servers {\n\t\tif err := server.Shutdown(shutdown); err != nil {\n\t\t\t_ = server.Close()\n\t\t\tlogger.Warn(\"http_drain_timeout\", \"code\", \"CHAT_SHUTDOWN_FORCED\")\n\t\t\tif fault == nil {\n\t\t\t\tfault = &Fault{\"CHAT_SHUTDOWN_FORCED\", \"HTTP请求未在排空期限内完成\", 1}\n\t\t\t}\n\t\t}\n\t}\n\tfor range remaining {\n\t\t<-finished\n\t}\n\tlogger.Info(\"serve_stopped\")\n\treturn fault\n}\n\nfunc newHTTPServer(internal bool, logger *slog.Logger, deps *dependencies.Runtime) *http.Server {\n\treturn &http.Server{\n\t\tHandler:           healthHandler(internal, deps),\n\t\tReadHeaderTimeout: 5 * time.Second,\n\t\tReadTimeout:       10 * time.Second,\n\t\tWriteTimeout:      5 * time.Second,\n\t\tIdleTimeout:       60 * time.Second,\n\t\tMaxHeaderBytes:    16 << 10,\n\t\tErrorLog:          log.New(httpLogWriter{logger}, \"\", 0),\n\t}\n}\n\nfunc healthHandler(internal bool, runtimes ...*dependencies.Runtime) http.Handler {\n\tvar deps *dependencies.Runtime\n\tif len(runtimes) > 0 {\n\t\tdeps = runtimes[0]\n\t}\n\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\t\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\t\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\t\tif !internal && deps != nil && deps.Socket != nil && r.URL.Path == \"/chat/ws\" {\n\t\t\tdeps.Socket.ServeHTTP(w, r)\n\t\t\treturn\n\t\t}\n\t\tif !internal && deps != nil && deps.IdentityHTTP != nil && (r.URL.Path == \"/chat/api/v1/auth/session\" || r.URL.Path == \"/chat/api/v1/auth/socket-ticket\") {\n\t\t\tdeps.IdentityHTTP.ServeHTTP(w, r)\n\t\t\treturn\n\t\t}\n\t\tif !internal && deps != nil && deps.HistoryHTTP != nil && (r.URL.Path == \"/chat/api/v1/conversations/bootstrap\" || r.URL.Path == \"/chat/api/v1/messages/history\" || r.URL.Path == \"/chat/api/v1/messages/sync\" || r.URL.Path == \"/chat/api/v1/messages/changes\" || r.URL.Path == \"/chat/api/v1/messages/locate\" || r.URL.Path == \"/chat/api/v1/conversations/unread\" || r.URL.Path == \"/chat/api/v1/conversations/read\" || r.URL.Path == \"/chat/api/v1/conversations/digests\" || r.URL.Path == \"/chat/api/v1/conversations/preferences\" || r.URL.Path == \"/chat/api/v1/conversations/preference\") {\n\t\t\tdeps.HistoryHTTP.ServeHTTP(w, r)\n\t\t\treturn\n\t\t}\n\t\tif r.URL.Path != \"/livez\" && !(internal && r.URL.Path == \"/readyz\") {\n\t\t\twriteError(w, r, http.StatusNotFound, \"CHAT_ROUTE_NOT_FOUND\", \"接口未开放\", false)\n\t\t\treturn\n\t\t}\n\t\tif r.Method != http.MethodGet && r.Method != http.MethodHead {\n\t\t\tw.Header().Set(\"Allow\", \"GET, HEAD\")\n\t\t\twriteError(w, r, http.StatusMethodNotAllowed, \"CHAT_METHOD_NOT_ALLOWED\", \"请求方法不支持\", false)\n\t\t\treturn\n\t\t}\n\t\tif r.URL.Path == \"/readyz\" {\n\t\t\tif deps == nil {\n\t\t\t\twriteError(w, r, http.StatusServiceUnavailable, \"CHAT_NOT_READY\", \"基础依赖未接入\", false)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tsnapshot := deps.Snapshot()\n\t\t\tstatus := http.StatusOK\n\t\t\tif !snapshot.InfrastructureReady {\n\t\t\t\tstatus = http.StatusServiceUnavailable\n\t\t\t}\n\t\t\tw.WriteHeader(status)\n\t\t\tif r.Method != http.MethodHead {\n\t\t\t\t_ = json.NewEncoder(w).Encode(snapshot)\n\t\t\t}\n\t\t\treturn\n\t\t}\n\t\tif r.Method != http.MethodHead {\n\t\t\t_, _ = w.Write([]byte(\"{\\\"status\\\":\\\"alive\\\",\\\"stage\\\":\\\"\" + stage + \"\\\",\\\"business_enabled\\\":false}\\n\"))\n\t\t}\n\t})\n}\n\nfunc writeError(w http.ResponseWriter, r *http.Request, status int, code, message string, retryable bool) {\n\tid := requestID()\n\tw.Header().Set(\"X-Request-ID\", id)\n\tw.WriteHeader(status)\n\tif r.Method != http.MethodHead {\n\t\t_ = json.NewEncoder(w).Encode(struct {\n\t\t\tRequestID  string `json:\"request_id\"`\n\t\t\tCode       string `json:\"code\"`\n\t\t\tMessage    string `json:\"message\"`\n\t\t\tRetryable  bool   `json:\"retryable\"`\n\t\t\tServerTime string `json:\"server_time\"`\n\t\t}{id, code, message, retryable, time.Now().UTC().Format(time.RFC3339Nano)})\n\t}\n}\n\ntype httpLogWriter struct{ logger *slog.Logger }\n\nfunc (w httpLogWriter) Write(p []byte) (int, error) {\n\t// net/http's original diagnostics can contain attacker-controlled request\n\t// targets or panic values. Never forward that raw data into ordinary logs.\n\tw.logger.Error(\"http_runtime_error\", \"code\", \"CHAT_HTTP_RUNTIME_ERROR\")\n\treturn len(p), nil\n}\n","chat/internal/bootstrap/server_test.go":"package bootstrap\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestHealthAndClosedBusinessRoutes(t *testing.T) {\n\tfor _, internal := range []bool{false, true} {\n\t\tfor _, test := range []struct {\n\t\t\tmethod, path string\n\t\t\tstatus       int\n\t\t}{\n\t\t\t{\"GET\", \"/livez\", 200}, {\"HEAD\", \"/livez\", 200}, {\"POST\", \"/livez\", 405},\n\t\t\t{\"GET\", \"/chat/api/v1/messages?token=secret-input\", 404}, {\"GET\", \"/chat/ws\", 404},\n\t\t\t{\"GET\", \"/debug/pprof/\", 404}, {\"GET\", \"/metrics\", 404}, {\"GET\", \"/livez/\", 404},\n\t\t} {\n\t\t\tr := httptest.NewRequest(test.method, test.path, nil)\n\t\t\tw := httptest.NewRecorder()\n\t\t\thealthHandler(internal).ServeHTTP(w, r)\n\t\t\tif w.Code != test.status || w.Header().Get(\"Cache-Control\") != \"no-store\" || strings.Contains(w.Body.String(), \"secret-input\") {\n\t\t\t\tt.Fatalf(\"%s %s: %d %s\", test.method, test.path, w.Code, w.Body.String())\n\t\t\t}\n\t\t\tif test.method == \"HEAD\" && w.Body.Len() != 0 {\n\t\t\t\tt.Fatal(\"HEAD returned a body\")\n\t\t\t}\n\t\t\tif test.status >= 400 {\n\t\t\t\tvar body map[string]any\n\t\t\t\tif json.Unmarshal(w.Body.Bytes(), &body) != nil || body[\"request_id\"] != w.Header().Get(\"X-Request-ID\") {\n\t\t\t\t\tt.Fatalf(\"invalid error envelope: %s\", w.Body.String())\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tw := httptest.NewRecorder()\n\t\thealthHandler(internal).ServeHTTP(w, httptest.NewRequest(\"GET\", \"/readyz\", nil))\n\t\texpected := 404\n\t\tif internal {\n\t\t\texpected = 503\n\t\t}\n\t\tif w.Code != expected {\n\t\t\tt.Fatalf(\"skeleton must never report business-ready: %d\", w.Code)\n\t\t}\n\t}\n}\n\nfunc TestServeLifecycleAndListenerCleanup(t *testing.T) {\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\tlogs := &capturedLogs{events: make(chan map[string]any, 16)}\n\tpath := configFile(t, encodedConfig(t, testConfig()))\n\tfinished := make(chan int, 1)\n\tgo func() { finished <- Run(ctx, []string{\"serve\", \"--config\", path}, io.Discard, logs) }()\n\tevent := waitEvent(t, logs, \"serve_started\")\n\tclient := &http.Client{Timeout: 2 * time.Second, Transport: &http.Transport{Proxy: nil}}\n\tdefer client.CloseIdleConnections()\n\tfor _, key := range []string{\"public_address\", \"internal_address\"} {\n\t\taddress, ok := event[key].(string)\n\t\tif !ok || address == \"\" {\n\t\t\tt.Fatalf(\"missing bound address: %#v\", event)\n\t\t}\n\t\tresponse, err := client.Get(\"http://\" + address + \"/livez\")\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t_, _ = io.Copy(io.Discard, response.Body)\n\t\t_ = response.Body.Close()\n\t\tif response.StatusCode != 200 {\n\t\t\tt.Fatal(response.Status)\n\t\t}\n\t}\n\tcancel()\n\tselect {\n\tcase code := <-finished:\n\t\tif code != 0 {\n\t\t\tt.Fatalf(\"exit=%d\", code)\n\t\t}\n\tcase <-time.After(3 * time.Second):\n\t\tt.Fatal(\"serve did not stop both listeners\")\n\t}\n\tfor _, key := range []string{\"public_address\", \"internal_address\"} {\n\t\tlistener, err := net.Listen(\"tcp\", event[key].(string))\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"listener was not released: %v\", err)\n\t\t}\n\t\t_ = listener.Close()\n\t}\n}\n\nfunc TestSecondListenFailureReleasesFirst(t *testing.T) {\n\toccupied, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer occupied.Close()\n\tfirst, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\taddress := first.Addr().String()\n\t_ = first.Close()\n\tcfg := testConfig()\n\tcfg.HTTP.Listen = address\n\tcfg.HTTP.InternalListen = occupied.Addr().String()\n\tfault := serve(context.Background(), cfg, newLogger(io.Discard, slog.LevelInfo, \"test\", \"test\"))\n\tif fault == nil || fault.Code != \"CHAT_LISTEN_FAILED\" {\n\t\tt.Fatalf(\"expected bind failure, got %#v\", fault)\n\t}\n\trebound, err := net.Listen(\"tcp\", address)\n\tif err != nil {\n\t\tt.Fatalf(\"partial startup leaked first listener: %v\", err)\n\t}\n\t_ = rebound.Close()\n}\n\nfunc TestHTTPRuntimeLogDoesNotEchoRequestOrPanic(t *testing.T) {\n\tvar logs bytes.Buffer\n\tw := httpLogWriter{newLogger(&logs, slog.LevelInfo, \"serve\", \"test\")}\n\t_, _ = w.Write([]byte(\"panic: secret-input /path?token=secret-input\"))\n\tif strings.Contains(logs.String(), \"secret-input\") || !strings.Contains(logs.String(), \"CHAT_HTTP_RUNTIME_ERROR\") {\n\t\tt.Fatalf(\"unsafe runtime log: %s\", logs.String())\n\t}\n}\n","chat/internal/bootstrap/socket_test.go":"package bootstrap\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/dependencies\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"net/http/httptest\"\n\t\"testing\"\n)\n\nfunc TestS10SocketConfigRequiresRealDependencies(t *testing.T) {\n\tc := testConfig()\n\tc.Socket.Enabled = true\n\tif f := c.validate(); f == nil || f.Code != \"CHAT_CONFIG_SOCKET_INVALID\" {\n\t\tt.Fatal(\"WSS enabled without real identity/Redis\")\n\t}\n\tvar r dependencies.Runtime\n\tif e := r.EnableSocket(socket.Config{Enabled: true}); e == nil {\n\t\tt.Fatal(\"runtime accepted missing dependencies\")\n\t}\n\tif e := r.EnableSocket(socket.Config{}); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tc.Socket.Enabled = false\n\tc.Messages.Enabled = true\n\tif f := c.validate(); f == nil || f.Code != \"CHAT_MESSAGES_NOT_READY\" {\n\t\tt.Fatal(\"WSS bypassed send gate\")\n\t}\n}\nfunc TestS10InternalListenerNeverRegistersSocket(t *testing.T) {\n\t// A nonnil gateway must still never be invoked on the internal listener.\n\tdeps := &dependencies.Runtime{Socket: &socket.Gateway{}}\n\tfor _, path := range []string{\"/chat/ws\", \"/chat/ws?ticket=private\"} {\n\t\tw := httptest.NewRecorder()\n\t\thealthHandler(true, deps).ServeHTTP(w, httptest.NewRequest(\"GET\", path, nil))\n\t\tif w.Code != 404 {\n\t\t\tt.Fatal(w.Code)\n\t\t}\n\t}\n}\nfunc TestS10DefaultCommandsDoNotSend(t *testing.T) {\n\t_, _, err := (message.SocketCommands{}).Execute(context.Background(), ports.Principal{}, \"message.send\", json.RawMessage(`{}`))\n\tif err == nil || err.Error() != \"CHAT_MESSAGES_NOT_READY\" {\n\t\tt.Fatal(err)\n\t}\n}\n","chat/internal/conversation/consumer.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"log/slog\"\n\t\"regexp\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar eventIDPattern = regexp.MustCompile(`^[a-f0-9]{32}$`)\n\ntype Lease struct{ EventID, Owner, PayloadHash string }\ntype Batch struct{ Claimed, Applied, Deferred, Rejected int }\n\n// Claim writes only the Go receipt. The source is immutable PHP-owned data.\n// A durable lease survives a crash before the projection transaction begins.\nfunc (s *Store) Claim(ctx context.Context, eventID string) (Lease, error) {\n\tif !eventIDPattern.MatchString(eventID) {\n\t\treturn Lease{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tvar nonce [16]byte\n\tif _, err := rand.Read(nonce[:]); err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\towner := hex.EncodeToString(nonce[:])\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\t_, err = tx.ExecContext(ctx, `INSERT IGNORE INTO chat_event_receipts(event_id,aggregate_key,aggregate_version,payload_hash,status,attempts,next_attempt_at)\n\t\tSELECT event_id,aggregate_key,aggregate_version,SHA2(payload_json,256),'retry',0,UTC_TIMESTAMP(6) FROM chat_business_events WHERE event_id=?`, eventID)\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tvar hash string\n\terr = tx.QueryRowContext(ctx, `SELECT payload_hash FROM chat_event_receipts WHERE event_id=? FOR UPDATE`, eventID).Scan(&hash)\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tresult, err := tx.ExecContext(ctx, `UPDATE chat_event_receipts SET status='processing',lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,\n\t\tattempts=LEAST(attempts+1,1000000),error_code=NULL WHERE event_id=? AND\n\t\t((status='retry' AND next_attempt_at<=UTC_TIMESTAMP(6)) OR (status='processing' AND lease_until<=UTC_TIMESTAMP(6)))`, owner, eventID)\n\tif err != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\tn, _ := result.RowsAffected()\n\tif n != 1 {\n\t\treturn Lease{}, ports.ErrBusy\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Lease{}, ports.ErrUnavailable\n\t}\n\treturn Lease{eventID, owner, hash}, nil\n}\n\n// Consume fences ownership again in the SAME transaction as intervals and the\n// applied version. A late old owner cannot commit after a replacement claimant.\nfunc (s *Store) Consume(ctx context.Context, lease Lease) error {\n\tif !eventIDPattern.MatchString(lease.EventID) || !eventIDPattern.MatchString(lease.Owner) || len(lease.PayloadHash) != 64 {\n\t\treturn ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar scope, kind string\n\tvar version ports.ID\n\tvar schema int\n\tvar body sql.NullString\n\terr = tx.QueryRowContext(ctx, `SELECT aggregate_key,CAST(aggregate_version AS CHAR),schema_version,event_type,\n\t\tCASE WHEN OCTET_LENGTH(payload_json)<=32768 THEN payload_json ELSE NULL END FROM chat_business_events WHERE event_id=?`, lease.EventID).Scan(&scope, &version, &schema, &kind, &body)\n\tif err == sql.ErrNoRows {\n\t\treturn policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif schema != 1 || kind != \"chat.policy.changed\" || !body.Valid {\n\t\treturn policy.ErrDenied\n\t}\n\tsum := sha256.Sum256([]byte(body.String))\n\tif hex.EncodeToString(sum[:]) != lease.PayloadHash {\n\t\treturn policy.ErrDenied\n\t}\n\tp, err := policy.DecodeEvent([]byte(body.String), scope, version)\n\tif err != nil {\n\t\treturn err\n\t}\n\tcurrent, err := s.reader.CurrentLocked(ctx, tx, scope)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif current.OrderID != p.OrderID || current.AssignmentID != p.AssignmentID {\n\t\treturn policy.ErrDenied\n\t}\n\tif compare(p.Version, current.Version) > 0 {\n\t\treturn ErrGap\n\t}\n\tif p.Version == current.Version && p.Hash != current.Hash {\n\t\treturn policy.ErrDenied\n\t}\n\tif err = s.apply(ctx, tx, p); err != nil {\n\t\treturn err\n\t}\n\tresult, err := tx.ExecContext(ctx, `UPDATE chat_event_receipts SET status='done',lease_owner=NULL,lease_until=NULL,error_code=NULL,completed_at=UTC_TIMESTAMP(6)\n\t\tWHERE event_id=? AND status='processing' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) AND payload_hash=?`, lease.EventID, lease.Owner, lease.PayloadHash)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tn, _ := result.RowsAffected()\n\tif n != 1 {\n\t\treturn ErrLease\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\nfunc (s *Store) deferLease(ctx context.Context, lease Lease, cause error) error {\n\tstatus, code := \"retry\", \"CHAT_EVENT_RETRY\"\n\tif errors.Is(cause, policy.ErrDenied) {\n\t\tstatus, code = \"rejected\", \"CHAT_EVENT_INVALID\"\n\t}\n\tif errors.Is(cause, ErrGap) {\n\t\tcode = \"CHAT_EVENT_VERSION_GAP\"\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\t_, err := s.db.ExecContext(ctx, `UPDATE chat_event_receipts SET status=?,error_code=?,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 5 SECOND,lease_owner=NULL,lease_until=NULL\n\t\tWHERE event_id=? AND status='processing' AND lease_owner=?`, status, code, lease.EventID, lease.Owner)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\n// No MAX(id) or created_at watermark. The anti-join re-discovers a lower event\n// ID whose PHP transaction committed after a later event was already consumed.\n// Poll is authoritative; a lost Redis wake cannot lose any business event.\nfunc (s *Store) Poll(ctx context.Context, limit int) (Batch, error) {\n\tvar stats Batch\n\tif limit < 1 || limit > 100 {\n\t\treturn stats, ports.ErrInvalid\n\t}\n\tqueryCtx, cancel := context.WithTimeout(ctx, s.timeout)\n\trows, err := s.db.QueryContext(queryCtx, `SELECT e.event_id FROM chat_business_events e LEFT JOIN chat_event_receipts r ON r.event_id=e.event_id\n\t\tWHERE r.event_id IS NULL OR (r.status='retry' AND r.next_attempt_at<=UTC_TIMESTAMP(6))\n\t\tOR (r.status='processing' AND r.lease_until<=UTC_TIMESTAMP(6)) ORDER BY e.id LIMIT ?`, limit)\n\tif err != nil {\n\t\tcancel()\n\t\treturn stats, ports.ErrUnavailable\n\t}\n\tids := []string{}\n\tfor rows.Next() {\n\t\tvar id string\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\tcancel()\n\t\t\treturn stats, ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tcancel()\n\tif err != nil {\n\t\treturn stats, ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tif ctx.Err() != nil {\n\t\t\treturn stats, ctx.Err()\n\t\t}\n\t\tlease, e := s.Claim(ctx, id)\n\t\tif errors.Is(e, ports.ErrBusy) {\n\t\t\tcontinue\n\t\t}\n\t\tif e != nil {\n\t\t\treturn stats, e\n\t\t}\n\t\tstats.Claimed++\n\t\tif e = s.Consume(ctx, lease); e == nil {\n\t\t\tstats.Applied++\n\t\t\tcontinue\n\t\t}\n\t\tif err = s.deferLease(ctx, lease, e); err != nil {\n\t\t\treturn stats, err\n\t\t}\n\t\tif errors.Is(e, policy.ErrDenied) {\n\t\t\tstats.Rejected++\n\t\t} else {\n\t\t\tstats.Deferred++\n\t\t}\n\t}\n\treturn stats, nil\n}\n\nfunc (s *Store) Run(ctx context.Context, logger *slog.Logger) {\n\tticker := time.NewTicker(time.Second)\n\tdefer ticker.Stop()\n\tfor {\n\t\tstats, err := s.Poll(ctx, 100)\n\t\tif ctx.Err() != nil {\n\t\t\treturn\n\t\t}\n\t\tif err != nil {\n\t\t\tlogger.Warn(\"conversation_projection_retry\", \"code\", \"CHAT_EVENT_RETRY\")\n\t\t} else if stats.Claimed > 0 {\n\t\t\tlogger.Info(\"conversation_projection_batch\", \"claimed\", stats.Claimed, \"applied\", stats.Applied, \"deferred\", stats.Deferred, \"rejected\", stats.Rejected)\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n}\n","chat/internal/conversation/mysql_integration_test.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\ntype fixtureDB struct {\n\tt          *testing.T\n\tctx        context.Context\n\troot, goDB *sql.DB\n\tstore      *Store\n\tname       string\n\tuser       string\n}\n\nfunc digest(s string) string { v := sha256.Sum256([]byte(s)); return hex.EncodeToString(v[:]) }\nfunc newFixture(t *testing.T) *fixtureDB {\n\tt.Helper()\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated MySQL/PHP required\")\n\t}\n\thost, _, err := net.SplitHostPort(os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"))\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"loopback fixture required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 80*time.Second)\n\tt.Cleanup(cancel)\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ParseTime = true\n\tc.Params = map[string]string{\"time_zone\": \"'+00:00'\"}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tadmin := sql.OpenDB(connector)\n\tdefer admin.Close()\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname := \"bixuan_test_policy_platform_\" + suffix\n\tif _, err = admin.ExecContext(ctx, \"CREATE DATABASE `\"+name+\"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.DBName = name\n\tconnector, _ = mysql.NewConnector(c)\n\troot := sql.OpenDB(connector)\n\troot.SetMaxOpenConns(4)\n\tf := &fixtureDB{t: t, ctx: ctx, root: root, name: name}\n\tt.Cleanup(func() { root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\"); root.Close() })\n\tf.php(\"init\")\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\tuser := \"bxchat_test_s05_\" + suffix\n\tf.user = user\n\tf.exec(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY 's05-fixture-only'\")\n\tt.Cleanup(func() { root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\") })\n\tfor _, table := range []string{\"users\", \"login_sessions\", \"chat_policy_guards\", \"chat_business_events\", \"chat_staff_authority_versions\"} {\n\t\tf.exec(\"GRANT SELECT ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tfor _, table := range []string{\"chat_conversations\", \"chat_members\", \"chat_member_intervals\", \"chat_event_receipts\"} {\n\t\tf.exec(\"GRANT SELECT,INSERT,UPDATE,DELETE ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tc.User = user\n\tc.Passwd = \"s05-fixture-only\"\n\tconnector, _ = mysql.NewConnector(c)\n\tf.goDB = sql.OpenDB(connector)\n\tf.goDB.SetMaxOpenConns(4)\n\tt.Cleanup(func() { f.goDB.Close() })\n\tf.store, err = NewStore(f.goDB, \"test\", 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, actor := range []string{\"10201\", \"10202\", \"10203\"} {\n\t\tf.exec(`INSERT INTO login_sessions(id,user_id,token_hash,status,expires_at,created_at) VALUES(?,?,?,'active',UTC_TIMESTAMP()+INTERVAL 1 HOUR,UTC_TIMESTAMP())`, actor, actor, digest(\"login:\"+actor))\n\t}\n\treturn f\n}\nfunc (f *fixtureDB) exec(q string, args ...any) {\n\tf.t.Helper()\n\tif _, err := f.root.ExecContext(f.ctx, q, args...); err != nil {\n\t\tf.t.Fatal(\"fixture SQL\", err)\n\t}\n}\nfunc (f *fixtureDB) text(q string, args ...any) string {\n\tf.t.Helper()\n\tvar s string\n\tif err := f.root.QueryRowContext(f.ctx, q, args...).Scan(&s); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\treturn s\n}\nfunc (f *fixtureDB) php(action string, args ...string) {\n\tf.t.Helper()\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tf.t.Fatal(\"explicit PHP required\")\n\t}\n\tpath, _ := filepath.Abs(\"../../../server/tests/chat_platform_fixture.php\")\n\tcmd := exec.CommandContext(f.ctx, php, append([]string{path, action}, args...)...)\n\tcmd.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+f.name)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil || strings.TrimSpace(string(out)) != \"committed\" {\n\t\tf.t.Fatalf(\"real PHP %s: %s\", action, out)\n\t}\n}\nfunc principal(actor string) ports.Principal {\n\treturn ports.Principal{ActorID: ports.ID(actor), SourceID: ports.ID(actor), Kind: \"mini\", Environment: \"test\", Scopes: []string{\"chat:use\"}, SessionID: digest(\"mini\\n\" + actor + \"\\n\" + digest(\"login:\"+actor)), SessionVersion: digest(\"mini-v1\\n\" + actor + \"\\n\" + digest(\"login:\"+actor) + \"\\n\" + actor), ExpiresAt: time.Now().Add(time.Minute)}\n}\nfunc (f *fixtureDB) poll() Batch {\n\tf.t.Helper()\n\tb, err := f.store.Poll(f.ctx, 100)\n\tif err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\tif b.Rejected != 0 || b.Deferred != 0 {\n\t\tf.t.Fatalf(\"unexpected projection result %+v\", b)\n\t}\n\treturn b\n}\nfunc (f *fixtureDB) event(version string) string {\n\treturn f.text(\"SELECT event_id FROM chat_business_events WHERE aggregate_key='order:401:assignment:401' AND aggregate_version=?\", version)\n}\nfunc (f *fixtureDB) claim(v string) Lease {\n\tf.t.Helper()\n\tlease, err := f.store.Claim(f.ctx, f.event(v))\n\tif err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\treturn lease\n}\nfunc (f *fixtureDB) check(id ports.ID, actor, action string, allowed bool) {\n\tf.t.Helper()\n\tg, err := f.store.Authorize(f.ctx, ports.PolicyRequest{Actor: principal(actor), ConversationID: id, Action: action})\n\tif allowed && (err != nil || !g.CanRead) {\n\t\tf.t.Fatalf(\"authorized actor denied %s %s: %v\", actor, action, err)\n\t}\n\tif !allowed && err == nil {\n\t\tf.t.Fatal(\"stale/outsider authorization allowed\")\n\t}\n}\nfunc (f *fixtureDB) visible(id ports.ID, version string, want bool) {\n\tf.t.Helper()\n\ttx, err := f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\tdefer tx.Rollback()\n\tok, err := f.store.VisibleVersionLocked(f.ctx, tx, ports.PolicyRequest{Actor: principal(\"10203\"), ConversationID: id}, ports.ID(version))\n\tif err != nil || ok != want {\n\t\tf.t.Fatalf(\"history version %s: %v %v\", version, ok, err)\n\t}\n}\n\nfunc TestPHPProjectionLeaseIntervalsAndAuthorization(t *testing.T) {\n\tf := newFixture(t)\n\tif f.poll().Applied != 1 {\n\t\tt.Fatal(\"first PHP event not applied\")\n\t}\n\tid, err := f.store.FindOrder(f.ctx, principal(\"10203\"), \"401\", \"401\")\n\tif err != nil || id == \"401\" {\n\t\tt.Fatal(\"independent binding\", id, err)\n\t}\n\tf.check(id, \"10203\", \"send\", true)\n\tf.check(id, \"10202\", \"send\", true)\n\tf.check(id, \"10201\", \"read\", false)\n\tif f.poll().Claimed != 0 {\n\t\tt.Fatal(\"completed event replayed\")\n\t}\n\toldHistory, err := f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer oldHistory.Rollback()\n\tvar oldCount int\n\tif oldHistory.QueryRowContext(f.ctx, \"SELECT COUNT(*) FROM chat_member_intervals WHERE end_version IS NULL\").Scan(&oldCount) != nil {\n\t\tt.Fatal(\"history RR snapshot\")\n\t}\n\tif _, err = f.store.FindOrder(f.ctx, principal(\"10203\"), \"401\", \"402\"); err == nil {\n\t\tt.Fatal(\"wrong assignment binding accepted\")\n\t}\n\tf.exec(`UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'`)\n\tf.check(id, \"10203\", \"read\", false)\n\tf.check(id, \"10202\", \"send\", false) // Entire stale platform snapshot is fenced.\n\tf.check(id, \"10202\", \"read\", true)  // Another actor keeps legitimate history after staff revocation.\n\tf.php(\"sync\")\n\tf.check(id, \"10202\", \"read\", false) // Current PHP version has not been materialized yet.\n\tlease := f.claim(\"2\")\n\tf.exec(`CREATE TRIGGER fixture_projection_fail BEFORE UPDATE ON chat_conversations FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='fixture'`)\n\tif err = f.store.Consume(f.ctx, lease); err == nil {\n\t\tt.Fatal(\"injected failure ignored\")\n\t}\n\tif f.text(\"SELECT CAST(policy_version AS CHAR) FROM chat_conversations WHERE id=?\", string(id)) != \"1\" || f.text(\"SELECT COUNT(*) FROM chat_member_intervals WHERE end_version IS NOT NULL\") != \"0\" {\n\t\tt.Fatal(\"partial projection committed\")\n\t}\n\tf.exec(\"DROP TRIGGER fixture_projection_fail\")\n\tif err = f.store.Consume(f.ctx, lease); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.check(id, \"10202\", \"read\", true)\n\tf.check(id, \"10202\", \"send\", false)\n\tf.check(id, \"10203\", \"read\", false)\n\tf.exec(`UPDATE system_settings SET setting_value='[\"PlatformStaff\"]' WHERE setting_key='wechat.admin_openids'`)\n\tf.php(\"sync\")\n\told := f.claim(\"3\")\n\tf.exec(\"UPDATE chat_event_receipts SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND WHERE event_id=?\", old.EventID)\n\tnewOwner := f.claim(\"3\")\n\tif old.Owner == newOwner.Owner {\n\t\tt.Fatal(\"lease generation reused\")\n\t}\n\tif err = f.store.Consume(f.ctx, old); !errors.Is(err, ErrLease) {\n\t\tt.Fatal(\"old worker committed\", err)\n\t}\n\tif f.text(\"SELECT CAST(policy_version AS CHAR) FROM chat_conversations WHERE id=?\", string(id)) != \"2\" {\n\t\tt.Fatal(\"lost lease mutated projection\")\n\t}\n\tif err = f.store.Consume(f.ctx, newOwner); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.check(id, \"10203\", \"send\", true)\n\tf.visible(id, \"1\", true)\n\tf.visible(id, \"2\", false)\n\tf.visible(id, \"3\", true)\n\tvisible, err := f.store.VisibleVersionLocked(f.ctx, oldHistory, ports.PolicyRequest{Actor: principal(\"10203\"), ConversationID: id}, \"2\")\n\tif err != nil || visible {\n\t\tt.Fatal(\"old RR interval snapshot resurrected gap\", visible, err)\n\t}\n\toldHistory.Rollback()\n\tif f.text(\"SELECT COUNT(DISTINCT member_key) FROM chat_member_intervals WHERE actor_id=10203\") != \"2\" {\n\t\tt.Fatal(\"return reused revoked authority\")\n\t}\n\t// A higher version may be selected first, but never opens a gap in history.\n\tf.exec(\"UPDATE users SET status='disabled' WHERE id=10203\")\n\tf.php(\"sync\")\n\tf.exec(\"UPDATE users SET status='active' WHERE id=10203\")\n\tf.php(\"sync\")\n\thigh := f.claim(\"5\")\n\tif err = f.store.Consume(f.ctx, high); !errors.Is(err, ErrGap) {\n\t\tt.Fatal(\"out-of-order event skipped version\", err)\n\t}\n\tif err = f.store.deferLease(f.ctx, high, ErrGap); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlow := f.claim(\"4\")\n\tif err = f.store.Consume(f.ctx, low); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_event_receipts SET next_attempt_at=UTC_TIMESTAMP()-INTERVAL 1 SECOND WHERE event_id=?\", high.EventID)\n\tf.poll()\n\tf.visible(id, \"4\", false)\n\tf.visible(id, \"5\", true)\n\tf.visible(id, \"1\", true)\n\t// Session final check uses current locking reads even inside an old RR tx.\n\ttx, err := f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer tx.Rollback()\n\tvar status string\n\tif tx.QueryRowContext(f.ctx, \"SELECT status FROM login_sessions WHERE id=10202\").Scan(&status) != nil {\n\t\tt.Fatal(\"RR fixture\")\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, err = f.store.AuthorizeLocked(f.ctx, tx, ports.PolicyRequest{Actor: principal(\"10202\"), ConversationID: id, Action: \"read\"}); err == nil {\n\t\tt.Fatal(\"old identity snapshot granted\")\n\t}\n\ttx.Rollback()\n\tf.exec(\"UPDATE login_sessions SET status='active' WHERE id=10202\")\n\ttx, err = f.goDB.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer tx.Rollback()\n\tif _, err = f.store.AuthorizeLocked(f.ctx, tx, ports.PolicyRequest{Actor: principal(\"10202\"), ConversationID: id, Action: \"read\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tconn, err := f.root.Conn(f.ctx)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = conn.ExecContext(f.ctx, \"SET SESSION innodb_lock_wait_timeout=1\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, err = conn.ExecContext(f.ctx, \"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tvar dbErr *mysql.MySQLError\n\tif !errors.As(err, &dbErr) || dbErr.Number != 1205 {\n\t\tt.Fatal(\"session shared lock not retained\", err)\n\t}\n\tconn.Close()\n\ttx.Rollback()\n\t// Source tables are SELECT-only to this worker.\n\tfor _, q := range []string{\"DELETE FROM chat_business_events\", \"UPDATE chat_policy_guards SET policy_version=1\", \"UPDATE orders SET lifecycle_status='completed'\"} {\n\t\tif _, err = f.goDB.ExecContext(f.ctx, q); err == nil {\n\t\t\tt.Fatal(\"worker changed PHP source\")\n\t\t}\n\t}\n\tf.php(\"close\")\n\tf.poll()\n\tf.check(id, \"10203\", \"read\", true)\n\tf.check(id, \"10203\", \"send\", false)\n\tserviceKey := f.text(\"SELECT member_key FROM chat_members WHERE conversation_id=? AND actor_id=10203\", string(id))\n\tf.php(\"repair\")\n\tf.poll()\n\tf.check(id, \"10203\", \"send\", true)\n\trepairKey := f.text(\"SELECT member_key FROM chat_members WHERE conversation_id=? AND actor_id=10203\", string(id))\n\tif serviceKey == repairKey || !strings.Contains(repairKey, \":repair:\") {\n\t\tt.Fatal(\"repair reused original membership episode\")\n\t}\n\tf.php(\"repair-close\")\n\tf.poll()\n\tf.check(id, \"10203\", \"send\", false)\n\t// Same order, same worker, new assignment: a separate immutable conversation.\n\tf.exec(`INSERT INTO assignments(id,public_id,order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,\n\t\tbooking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,\n\t\testimated_offline_collect_cents,estimated_net_income_cents,status,offered_at,accepted_at,created_at,updated_at)\n\t\tSELECT 778,REPEAT('N',26),order_id,worker_id,assignment_type,commission_rule_version_id,final_amount_cents_snapshot,\n\t\tbooking_fee_cents_snapshot,commission_rate_bp_snapshot,commission_min_cents_snapshot,estimated_commission_cents,\n\t\testimated_offline_collect_cents,estimated_net_income_cents,'accepted',UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM assignments WHERE id=401`)\n\tf.exec(\"UPDATE orders SET current_assignment_id=778,lifecycle_status='active',assignment_status='accepted' WHERE id=401\")\n\tf.php(\"sync\")\n\tf.poll()\n\tnewID, err := f.store.FindOrder(f.ctx, principal(\"10203\"), \"401\", \"778\")\n\tif err != nil || newID == id {\n\t\tt.Fatal(\"reassignment merged old conversation\", err)\n\t}\n\tf.check(id, \"10203\", \"send\", false)\n\tf.check(newID, \"10203\", \"send\", true)\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_intervals WHERE conversation_id=? AND start_version=1\", string(newID)) != \"2\" {\n\t\tt.Fatal(\"new scope inherited old intervals\")\n\t}\n\tt.Log(\"real PHP snapshots, version history gaps, lease takeover, rollback, S03 session/current guard locks passed\")\n}\n\nfunc TestLateCommitWithoutWakeAndConcurrentClaims(t *testing.T) {\n\tf := newFixture(t)\n\tf.poll()\n\tbody := f.text(\"SELECT snapshot_json FROM chat_policy_guards WHERE order_id=401\")\n\tvar snapshot map[string]any\n\tif json.Unmarshal([]byte(body), &snapshot) != nil {\n\t\tt.Fatal(\"snapshot\")\n\t}\n\t// Model an uncommitted PHP authority change without inferring order enums.\n\tsnapshot[\"state\"] = \"open\"\n\tfor _, m := range snapshot[\"members\"].([]any) {\n\t\tm.(map[string]any)[\"can_send\"] = false\n\t}\n\traw, err := json.Marshal(snapshot)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpayload := `{\"schema_version\":1,\"policy_version\":\"2\",\"snapshot\":` + string(raw) + `}`\n\tlate, err := f.root.BeginTx(f.ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer late.Rollback()\n\t// Use the unique scope, not the order range index: the fixture must not gap\n\t// lock the independent scope that is meant to commit first.\n\tif _, err = late.ExecContext(f.ctx, `UPDATE chat_policy_guards SET policy_version=2,state='open',snapshot_json=?,snapshot_hash=? WHERE scope_key='order:401:assignment:401'`, string(raw), digest(string(raw))); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = late.ExecContext(f.ctx, `INSERT INTO chat_business_events(event_id,aggregate_key,aggregate_version,schema_version,event_type,payload_json,created_at)\n\t\tVALUES(?,'order:401:assignment:401',2,1,'chat.policy.changed',?,UTC_TIMESTAMP())`, strings.Repeat(\"a\", 32), payload); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.php(\"sync\", \"402\") // Higher ID, different scope, commits first.\n\tif f.poll().Applied != 1 {\n\t\tt.Fatal(\"independent higher committed event not applied\")\n\t}\n\tif err = late.Commit(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.poll().Applied != 1 || f.text(\"SELECT status FROM chat_event_receipts WHERE event_id=?\", strings.Repeat(\"a\", 32)) != \"done\" {\n\t\tt.Fatal(\"lower late commit was skipped\")\n\t}\n\tf.exec(`UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'`)\n\tf.php(\"sync\")\n\tevent := f.event(\"3\")\n\tvar wg sync.WaitGroup\n\tresults := make(chan error, 2)\n\tleases := make(chan Lease, 2)\n\tfor range 2 {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tl, e := f.store.Claim(f.ctx, event)\n\t\t\tresults <- e\n\t\t\tif e == nil {\n\t\t\t\tleases <- l\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\tclose(results)\n\tsuccess, busy := 0, 0\n\tfor e := range results {\n\t\tif e == nil {\n\t\t\tsuccess++\n\t\t} else if errors.Is(e, ports.ErrBusy) {\n\t\t\tbusy++\n\t\t} else {\n\t\t\tt.Fatal(e)\n\t\t}\n\t}\n\tif success != 1 || busy != 1 {\n\t\tt.Fatal(\"non-exclusive event lease\", success, busy)\n\t}\n\tlease := <-leases\n\t// The immutable source hash is checked before any projection mutation.\n\tf.exec(\"UPDATE chat_business_events SET payload_json=CONCAT(payload_json,' ') WHERE event_id=?\", event)\n\tif err = f.store.Consume(f.ctx, lease); !errors.Is(err, policy.ErrDenied) {\n\t\tt.Fatal(\"changed source accepted\", err)\n\t}\n\tif err = f.store.deferLease(f.ctx, lease, policy.ErrDenied); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT status FROM chat_event_receipts WHERE event_id=?\", event) != \"rejected\" {\n\t\tt.Fatal(\"poison event spins without quarantine\")\n\t}\n\tt.Log(\"lower-ID late commit discovered without Redis; concurrent lease exclusive; tampered source quarantined\")\n}\n\nfunc TestConfiguredProjectionWorkerLifecycle(t *testing.T) {\n\tf := newFixture(t)\n\tbinary, _ := filepath.Abs(\"../../bin/chatd\")\n\tif _, err := os.Stat(binary); err != nil {\n\t\tt.Fatal(\"build.sh must run before isolated worker lifecycle test\")\n\t}\n\tcfg := map[string]any{\"env\": \"test\", \"http\": map[string]string{\"listen\": \"127.0.0.1:19501\", \"internal_listen\": \"127.0.0.1:19502\"},\n\t\t\"dependencies\": map[string]any{\"operation_timeout\": \"3s\", \"mysql\": map[string]any{\"enabled\": true, \"address\": os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"), \"database\": f.name, \"username\": f.user, \"password_env\": \"CHAT_S05_MYSQL_PASSWORD\"}},\n\t\t\"auth\":         map[string]any{\"enabled\": true, \"public_keys\": map[string]string{\"chat-v1\": base64.StdEncoding.EncodeToString(make([]byte, 32))}}, \"conversations\": map[string]bool{\"enabled\": true}}\n\tbody, err := json.Marshal(cfg)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpath := filepath.Join(t.TempDir(), \"worker.json\")\n\tif os.WriteFile(path, body, 0600) != nil {\n\t\tt.Fatal(\"config fixture\")\n\t}\n\tlogFile, err := os.CreateTemp(t.TempDir(), \"worker-log\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer logFile.Close()\n\tcmd := exec.CommandContext(f.ctx, binary, \"worker\", \"--config\", path)\n\tcmd.Env = append(os.Environ(), \"CHAT_S05_MYSQL_PASSWORD=s05-fixture-only\")\n\tcmd.Stdout = logFile\n\tcmd.Stderr = logFile\n\tif err = cmd.Start(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdone := make(chan error, 1)\n\tgo func() { done <- cmd.Wait() }()\n\tt.Cleanup(func() { cmd.Process.Kill() })\n\tdeadline := time.NewTimer(10 * time.Second)\n\tdefer deadline.Stop()\n\tticker := time.NewTicker(50 * time.Millisecond)\n\tdefer ticker.Stop()\n\tfor f.text(\"SELECT COUNT(*) FROM chat_event_receipts WHERE status='done'\") != \"1\" {\n\t\tselect {\n\t\tcase err = <-done:\n\t\t\tt.Fatal(\"worker exited before projecting\", err)\n\t\tcase <-deadline.C:\n\t\t\tt.Fatal(\"worker failed to consume without Redis\")\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n\tif err = cmd.Process.Signal(os.Interrupt); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tselect {\n\tcase err = <-done:\n\t\tif err != nil {\n\t\t\tt.Fatal(\"worker shutdown\", err)\n\t\t}\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"worker did not stop\")\n\t}\n\tlogFile.Sync()\n\tlogs, err := os.ReadFile(logFile.Name())\n\tif err != nil || !strings.Contains(string(logs), `\"mode\":\"conversation_projection\"`) || !strings.Contains(string(logs), \"worker_stopped\") {\n\t\tt.Fatal(\"configured worker lifecycle not observed\")\n\t}\n\tt.Log(\"actual chatd worker: independent table grants, configured projection without Redis, clean shutdown\")\n}\n","chat/internal/conversation/realtime.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Projections only select candidates. Every socket output rechecks the current\n// PHP guard, login, epochs and membership; this list never grants permission.\nfunc (s *Store) MemberCandidates(ctx context.Context, id ports.ID) ([]ports.ID, error) {\n\tif !positive(id) {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\trows, e := s.db.QueryContext(ctx, `SELECT CAST(actor_id AS CHAR) FROM chat_members WHERE conversation_id=? AND can_read=1 ORDER BY actor_id LIMIT 11`, string(id))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tdefer rows.Close()\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar actor ports.ID\n\t\tif rows.Scan(&actor) != nil || !positive(actor) {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, actor)\n\t}\n\tif rows.Err() != nil || len(ids) > 10 {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn ids, nil\n}\n","chat/internal/conversation/store.go":"// Package conversation materializes PHP authority; it never interprets orders.\npackage conversation\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrGap = errors.New(\"CHAT_POLICY_VERSION_GAP\")\nvar ErrLease = errors.New(\"CHAT_EVENT_LEASE_LOST\")\n\ntype Config struct {\n\tEnabled bool `json:\"enabled\"`\n}\ntype Store struct {\n\tdb       *sql.DB\n\treader   *policy.Reader\n\tidentity *auth.MySQLSource\n\ttimeout  time.Duration\n}\n\nfunc NewStore(db *sql.DB, environment string, timeout time.Duration) (*Store, error) {\n\tif db == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tr, err := policy.NewReader(environment, timeout)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\ti, err := auth.NewMySQLSource(db)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Store{db: db, reader: r, identity: i, timeout: timeout}, nil\n}\n\n// Authorize is for bounded metadata checks. A later send must NOT reuse its\n// result: call AuthorizeLocked and commit the message using that same tx.\nfunc (s *Store) Authorize(ctx context.Context, req ports.PolicyRequest) (ports.Grant, error) {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.AuthorizeLocked(ctx, tx, req)\n\tif err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\treturn g, nil\n}\n\n// ValidatePrincipal performs the account/session check without assuming that\n// the actor has any conversations. Account-wide listings must call this even\n// when their candidate set is empty; otherwise a revoked session can receive\n// a successful (empty) response without consulting the authoritative login.\nfunc (s *Store) ValidatePrincipal(ctx context.Context, p ports.Principal) error {\n ctx, cancel := context.WithTimeout(ctx, s.timeout)\n defer cancel()\n tx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n if err != nil {\n  return ports.ErrUnavailable\n }\n defer tx.Rollback()\n if err := s.identity.ValidatePrincipalLocked(ctx, tx, p); err != nil {\n  return err\n }\n if err := tx.Commit(); err != nil {\n  return ports.ErrUnavailable\n }\n return nil\n}\n\n// Authority binds PHP guard/session locks to this exact transaction and request.\n// Callers may lock a stable account restriction between authority and projection.\n// Its fields are private so no caller can invent or reuse a grant on another tx.\ntype Authority struct {\n\ttx         *sql.Tx\n\trequest    ports.PolicyRequest\n\tprojection policy.Projection\n\tgrant      ports.Grant\n}\n\nfunc (s *Store) AuthorizeLocked(ctx context.Context, tx *sql.Tx, req ports.PolicyRequest) (ports.Grant, error) {\n\ta, err := s.LockAuthority(ctx, tx, req)\n\tif err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\treturn s.LockProjection(ctx, tx, a)\n}\n\n// LockAuthority locks PHP guard, staff epochs, login and active account first.\nfunc (s *Store) LockAuthority(ctx context.Context, tx *sql.Tx, req ports.PolicyRequest) (*Authority, error) {\n\tif tx == nil || !positive(req.ConversationID) || (req.Action != \"read\" && req.Action != \"send\") {\n\t\treturn nil, policy.ErrDenied\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tvar scope, kind string\n\terr := tx.QueryRowContext(ctx, `SELECT scope_key,conversation_type FROM chat_conversations WHERE id=?`, string(req.ConversationID)).Scan(&scope, &kind)\n\tif err == sql.ErrNoRows {\n\t\treturn nil, policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tif kind != \"order\" {\n\t\treturn nil, policy.ErrDenied\n\t}\n\tp, err := s.reader.CurrentLocked(ctx, tx, scope)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tg, err := s.reader.AuthorizeLocked(ctx, tx, scope, p.Version, req.Actor, req.Action)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err = s.identity.ValidatePrincipalLocked(ctx, tx, req.Actor); err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Authority{tx: tx, request: req, projection: p, grant: g}, nil\n}\n\n// LockProjection must follow any stable account restriction lock used by send.\nfunc (s *Store) LockProjection(ctx context.Context, tx *sql.Tx, a *Authority) (ports.Grant, error) {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tif a == nil || tx == nil || a.tx != tx {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tvar version, hash, order, assignment, state string\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(policy_version AS CHAR),snapshot_hash,CAST(order_id AS CHAR),CAST(assignment_id AS CHAR),state\n\t\tFROM chat_conversations WHERE id=? AND scope_key=? AND conversation_type='order' FOR UPDATE`, string(a.request.ConversationID), a.grant.ScopeKey).Scan(&version, &hash, &order, &assignment, &state)\n\tif err == sql.ErrNoRows {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif version != string(a.projection.Version) || hash != a.projection.Hash || order != string(a.projection.OrderID) || assignment != string(a.projection.AssignmentID) || state != a.projection.State {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tvar key string\n\tvar read, send bool\n\terr = tx.QueryRowContext(ctx, `SELECT member_key,can_read,can_send FROM chat_members WHERE conversation_id=? AND actor_id=? AND actor_kind='mini' LOCK IN SHARE MODE`, string(a.request.ConversationID), string(a.request.Actor.ActorID)).Scan(&key, &read, &send)\n\tif err == sql.ErrNoRows {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif key != a.grant.MemberKey || !read || (a.request.Action == \"send\" && !send) || !time.Now().Before(a.request.Actor.ExpiresAt) {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\treturn a.grant, nil\n}\n\n// FindOrder only finds an already-projected binding. It cannot create members.\nfunc (s *Store) FindOrder(ctx context.Context, actor ports.Principal, order, assignment ports.ID) (ports.ID, error) {\n\tif !positive(order) || !positive(assignment) {\n\t\treturn \"\", policy.ErrDenied\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar id ports.ID\n\terr = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE conversation_type='order' AND order_id=? AND assignment_id=?`, string(order), string(assignment)).Scan(&id)\n\tif err == sql.ErrNoRows {\n\t\treturn \"\", policy.ErrDenied\n\t}\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif _, err = s.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: actor, ConversationID: id, Action: \"read\"}); err != nil {\n\t\treturn \"\", err\n\t}\n\tif tx.Commit() != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn id, nil\n}\n\n// VisibleVersionLocked is the S08 predicate contract. A message's policy_version\n// is immutable, not reconstructed from processing time, current seq or episode.\nfunc (s *Store) VisibleVersionLocked(ctx context.Context, tx *sql.Tx, req ports.PolicyRequest, version ports.ID) (bool, error) {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tif !positive(version) {\n\t\treturn false, policy.ErrDenied\n\t}\n\treq.Action = \"read\"\n\tg, err := s.AuthorizeLocked(ctx, tx, req)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif compare(version, g.Version) > 0 {\n\t\treturn false, policy.ErrDenied\n\t}\n\tvar start string\n\t// A plain EXISTS could reuse an older RR snapshot with an interval that has\n\t// since closed, resurrecting the returning member's unauthorized gap.\n\terr = tx.QueryRowContext(ctx, `SELECT CAST(start_version AS CHAR) FROM chat_member_intervals WHERE conversation_id=? AND actor_id=?\n\t\tAND start_version<=? AND (end_version IS NULL OR end_version>?) LIMIT 1 LOCK IN SHARE MODE`, string(req.ConversationID), string(req.Actor.ActorID), string(version), string(version)).Scan(&start)\n\tif err == sql.ErrNoRows {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn true, nil\n}\n\nfunc positive(id ports.ID) bool { return id.Valid() && id != \"0\" }\nfunc compare(a, b ports.ID) int {\n\tav, _ := strconv.ParseUint(string(a), 10, 64)\n\tbv, _ := strconv.ParseUint(string(b), 10, 64)\n\tif av < bv {\n\t\treturn -1\n\t}\n\tif av > bv {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\n// apply runs only inside a leased event transaction under the PHP guard lock.\n// Intervals are [start_version,end_version); message seq is never a join bound.\nfunc (s *Store) apply(ctx context.Context, tx *sql.Tx, p policy.Projection) error {\n\t_, err := tx.ExecContext(ctx, `INSERT INTO chat_conversations(conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at)\n\t\tVALUES('order',?,?,?,0,'','','pending',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE id=id`, p.Scope, string(p.OrderID), string(p.AssignmentID))\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar id, version ports.ID\n\tvar hash, order, assignment string\n\terr = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),CAST(policy_version AS CHAR),snapshot_hash,CAST(order_id AS CHAR),CAST(assignment_id AS CHAR)\n\t\tFROM chat_conversations WHERE conversation_type='order' AND scope_key=? FOR UPDATE`, p.Scope).Scan(&id, &version, &hash, &order, &assignment)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif order != string(p.OrderID) || assignment != string(p.AssignmentID) {\n\t\treturn policy.ErrDenied\n\t}\n\tif compare(p.Version, version) <= 0 {\n\t\tif p.Version == version && p.Hash != hash {\n\t\t\treturn policy.ErrDenied\n\t\t}\n\t\treturn nil\n\t}\n\tcurrent, _ := strconv.ParseUint(string(version), 10, 64)\n\tincoming, _ := strconv.ParseUint(string(p.Version), 10, 64)\n\tif current == ^uint64(0) || incoming != current+1 {\n\t\treturn ErrGap\n\t}\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(actor_id AS CHAR),member_key FROM chat_members WHERE conversation_id=? AND can_read=1 FOR UPDATE`, string(id))\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\told := map[ports.ID]string{}\n\tfor rows.Next() {\n\t\tvar actor ports.ID\n\t\tvar key string\n\t\tif rows.Scan(&actor, &key) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\told[actor] = key\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tnext := map[ports.ID]string{}\n\tfor _, m := range p.Members {\n\t\tnext[m.ActorID] = m.Grant.MemberKey\n\t}\n\tfor actor, key := range old {\n\t\tif next[actor] != key {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_member_intervals SET end_version=? WHERE conversation_id=? AND actor_id=? AND end_version IS NULL`, string(p.Version), string(id), string(actor)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_members SET can_read=0,can_send=0 WHERE conversation_id=?`, string(id)); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, m := range p.Members {\n\t\tg := m.Grant\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_members(conversation_id,actor_id,actor_kind,role,member_key,can_read,can_send)\n\t\t\tVALUES(?,?,'mini',?,?,?,?) ON DUPLICATE KEY UPDATE role=VALUES(role),member_key=VALUES(member_key),can_read=VALUES(can_read),can_send=VALUES(can_send)`, string(id), string(m.ActorID), m.Role, g.MemberKey, g.CanRead, g.CanSend); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif old[m.ActorID] != g.MemberKey {\n\t\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version) VALUES(?,?,?,?)`, string(id), string(m.ActorID), g.MemberKey, string(p.Version)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\t_, err = tx.ExecContext(ctx, `UPDATE chat_conversations SET policy_version=?,snapshot_hash=?,episode_key=?,state=?,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, string(p.Version), p.Hash, p.Episode, p.State, string(id))\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/dependencies/dependencies_test.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestSettingsAndOwnership(t *testing.T) {\n\tif Defaults().Validate(\"test\") != nil {\n\t\tt.Fatal(\"defaults invalid\")\n\t}\n\tfor _, mutate := range []func(*Settings){\n\t\tfunc(s *Settings) { s.MySQL.MaxOpenServe = 32 }, func(s *Settings) { s.Redis.PoolWorker = 16 }, func(s *Settings) { s.OperationTimeout = \"0s\" },\n\t\tfunc(s *Settings) { s.ExternalConcurrency = 0 }, func(s *Settings) { s.ProbeInterval = \"1ms\" },\n\t\tfunc(s *Settings) { s.MySQL.Enabled = true; s.MySQL.Username = \"root\" },\n\t\tfunc(s *Settings) { s.Redis.Enabled = true; s.Redis.KeyPrefix = \"bxchat:production:\" },\n\t\tfunc(s *Settings) {\n\t\t\ts.Redis.Enabled = true\n\t\t\ts.Redis.Address = \"8.8.8.8:6379\"\n\t\t\ts.Redis.KeyPrefix = \"bxchat:test:\"\n\t\t},\n\t} {\n\t\ts := Defaults()\n\t\tmutate(&s)\n\t\tif s.Validate(\"test\") == nil {\n\t\t\tt.Fatal(\"unsafe budget or environment accepted\")\n\t\t}\n\t}\n\tfor _, line := range []string{\n\t\t\"GRANT USAGE ON *.* TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`orders` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`chat_admin_sessions` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`chat_staff_authority_versions` TO 'u'@'h'\",\n\t\t\"GRANT SELECT, INSERT, UPDATE, DELETE ON `bixuan_test_chat`.`chat_messages` TO 'u'@'h'\",\n\t\t\"GRANT SELECT, INSERT, UPDATE, DELETE ON `bixuan_test_chat`.`chat_member_reads` TO 'u'@'h'\",\n\t} {\n\t\tif !safeGrant(line, \"bixuan_test_chat\", \"test\") {\n\t\t\tt.Fatal(\"valid grant refused\")\n\t\t}\n\t}\n\tfor _, line := range []string{\n\t\t\"GRANT ALL PRIVILEGES ON *.* TO 'u'@'h'\", \"GRANT UPDATE ON `bixuan_test_chat`.`orders` TO 'u'@'h'\",\n\t\t\"GRANT INSERT ON `bixuan_test_chat`.`chat_policy_guards` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `bixuan_test_chat`.`chat_staff_authority_versions` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `bixuan_test_chat`.`chat_calls` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`user_wallets` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`admin_users` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `bixuan_test_chat`.`chat_admin_sessions` TO 'u'@'h'\",\n\t\t\"GRANT UPDATE ON `other_db`.`chat_messages` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.* TO 'u'@'h'\", \"GRANT CREATE ON `bixuan_test_chat`.`chat_messages` TO 'u'@'h'\",\n\t\t\"GRANT SELECT ON `bixuan_test_chat`.`orders` TO 'u'@'h' WITH GRANT OPTION\",\n\t} {\n\t\tif safeGrant(line, \"bixuan_test_chat\", \"test\") {\n\t\t\tt.Fatal(\"unsafe grant accepted\")\n\t\t}\n\t}\n}\nfunc fixture() Scenario {\n\treturn Scenario{Credential: \"test-token\", Principal: ports.Principal{ActorID: \"1\", SessionID: \"test-session\", Environment: \"test\", Scopes: []string{\"chat\"}},\n\t\tConversationID: \"2\", Grant: ports.Grant{CanRead: true, CanSend: true, ScopeKey: \"order:test:1\", Version: \"3\"},\n\t\tFingerprint: \"fixture-hash\", Text: \"施工尺寸12.5\", Safety: ports.SafetyResult{Decision: \"passed\", RuleVersion: \"test-rule\"},\n\t\tObjectKey: \"test/object\", Media: ports.MediaResult{Decision: \"passed\", ObjectVersion: \"v1\", ManifestHash: \"manifest\"},\n\t\tReminder: ports.Reminder{IntentID: \"1\", RecipientID: \"2\", TargetSeq: \"3\", ClusterVersion: \"4\", OperationID: \"operation-1\"},\n\t\tReceipt:  ports.Receipt{OperationID: \"operation-1\", State: \"accepted\"}}\n}\nfunc TestPortsAreExplicitAndFailClosed(t *testing.T) {\n\tctx := context.Background()\n\ts := fixture()\n\tp, err := NewProviders(\"test\", \"fake\", 2, time.Second, s)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ta, err := p.Identity.Authenticate(ctx, \"test-token\")\n\tif err != nil || a.ActorID != \"1\" {\n\t\tt.Fatal(\"fixture identity failed\")\n\t}\n\ta.Scopes[0] = \"tampered\"\n\tagain, _ := p.Identity.Authenticate(ctx, \"test-token\")\n\tif again.Scopes[0] != \"chat\" {\n\t\tt.Fatal(\"fixture alias\")\n\t}\n\tif _, err = p.Identity.Authenticate(ctx, \"forged\"); err == nil {\n\t\tt.Fatal(\"forged credential accepted\")\n\t}\n\tif _, err = p.Policy.Authorize(ctx, ports.PolicyRequest{Actor: again, ConversationID: \"2\", Action: \"send\"}); err != nil {\n\t\tt.Fatal(\"fixture grant failed\")\n\t}\n\tif _, err = p.Policy.Authorize(ctx, ports.PolicyRequest{Actor: again, ConversationID: \"99\", Action: \"send\"}); err == nil {\n\t\tt.Fatal(\"cross-conversation grant\")\n\t}\n\tif _, err = p.Safety.CheckText(ctx, ports.TextRequest{Actor: again, ConversationID: \"2\", Text: s.Text, Fingerprint: s.Fingerprint}); err != nil {\n\t\tt.Fatal(\"fixture safety failed\")\n\t}\n\tif _, err = p.Media.Inspect(ctx, ports.MediaRequest{Actor: again, ObjectKey: s.ObjectKey, ObjectVersion: \"v1\", ManifestHash: \"manifest\"}); err != nil {\n\t\tt.Fatal(\"fixture media failed\")\n\t}\n\tif _, err = p.Media.Inspect(ctx, ports.MediaRequest{Actor: again, ObjectKey: s.ObjectKey, ObjectVersion: \"v2\", ManifestHash: \"manifest\"}); err == nil {\n\t\tt.Fatal(\"wrong object version accepted\")\n\t}\n\tfor range 2 {\n\t\tif _, err = p.Notification.Submit(ctx, s.Reminder); err != nil {\n\t\t\tt.Fatal(\"same operation failed\")\n\t\t}\n\t}\n\tchanged := s.Reminder\n\tchanged.TargetSeq = \"99\"\n\tif _, err = p.Notification.Submit(ctx, changed); !errors.Is(err, ports.ErrInvalid) {\n\t\tt.Fatal(\"operation conflict accepted\")\n\t}\n\tif _, err = NewProviders(\"production\", \"fake\", 1, time.Second, s); err == nil {\n\t\tt.Fatal(\"production fake allowed\")\n\t}\n\tfor _, mode := range []string{\"disabled\", \"fake\"} {\n\t\tempty, _ := NewProviders(\"test\", mode, 1, time.Second, Scenario{})\n\t\tif _, err = empty.Identity.Authenticate(ctx, \"test-token\"); err == nil {\n\t\t\tt.Fatal(\"empty provider allowed identity\")\n\t\t}\n\t\tif _, err = empty.Safety.CheckText(ctx, ports.TextRequest{Fingerprint: \"x\"}); err == nil {\n\t\t\tt.Fatal(\"empty provider passed safety\")\n\t\t}\n\t}\n}\nfunc TestProviderDeadlineAndConcurrency(t *testing.T) {\n\ts := fixture()\n\ts.Delay = time.Second\n\tp, _ := NewProviders(\"test\", \"fake\", 1, 50*time.Millisecond, s)\n\tdone := make(chan error, 1)\n\tgo func() { _, err := p.Identity.Authenticate(context.Background(), s.Credential); done <- err }()\n\timpl := p.Identity.(*provider)\n\tdeadline := time.Now().Add(time.Second)\n\tfor len(impl.gate) == 0 && time.Now().Before(deadline) {\n\t\ttime.Sleep(time.Millisecond)\n\t}\n\tif _, err := p.Identity.Authenticate(context.Background(), s.Credential); !errors.Is(err, ports.ErrBusy) {\n\t\tt.Fatal(\"concurrency not bounded\")\n\t}\n\tif err := <-done; !errors.Is(err, context.DeadlineExceeded) {\n\t\tt.Fatal(\"deadline ignored\")\n\t}\n\tctx, cancel := context.WithCancel(context.Background())\n\tcancel()\n\tif _, err := p.Identity.Authenticate(ctx, s.Credential); !errors.Is(err, context.Canceled) {\n\t\tt.Fatal(\"cancel ignored\")\n\t}\n}\nfunc TestHTTPBudgetsAndNoRedirect(t *testing.T) {\n\tentered := make(chan struct{}, 1)\n\trelease := make(chan struct{})\n\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tswitch r.URL.Path {\n\t\tcase \"/slow\":\n\t\t\tentered <- struct{}{}\n\t\t\t<-release\n\t\tcase \"/large\":\n\t\t\t_, _ = io.WriteString(w, strings.Repeat(\"x\", 100))\n\t\tcase \"/redirect\":\n\t\t\thttp.Redirect(w, r, \"/forbidden\", 302)\n\t\tcase \"/forbidden\":\n\t\t\tt.Error(\"followed redirect\")\n\t\tdefault:\n\t\t\t_, _ = io.WriteString(w, \"ok\")\n\t\t}\n\t}))\n\tdefer server.Close()\n\tdefer func() {\n\t\tselect {\n\t\tcase <-release:\n\t\tdefault:\n\t\t\tclose(release)\n\t\t}\n\t}()\n\th, _ := NewHTTP(1, 80*time.Millisecond, 64)\n\tdefer h.Close()\n\trequest := func(path string) *http.Request { r, _ := http.NewRequest(\"GET\", server.URL+path, nil); return r }\n\tif _, status, err := h.Do(context.Background(), request(\"/redirect\")); err != nil || status != 302 {\n\t\tt.Fatal(\"redirect behavior\")\n\t}\n\tif _, _, err := h.Do(context.Background(), request(\"/large\")); !errors.Is(err, ports.ErrUnavailable) {\n\t\tt.Fatal(\"body limit ignored\")\n\t}\n\tdone := make(chan error, 1)\n\tgo func() { _, _, err := h.Do(context.Background(), request(\"/slow\")); done <- err }()\n\t<-entered\n\tif _, _, err := h.Do(context.Background(), request(\"/\")); !errors.Is(err, ports.ErrBusy) {\n\t\tt.Fatal(\"HTTP concurrency ignored\")\n\t}\n\terr := <-done\n\tclose(release)\n\tif !errors.Is(err, ports.ErrUnavailable) {\n\t\tt.Fatal(\"HTTP deadline ignored\")\n\t}\n}\nfunc TestDisabledReadinessAndStop(t *testing.T) {\n\tr, err := Open(Defaults(), \"test\", \"serve\", \"disabled\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer r.Close()\n\ts := r.Refresh(context.Background())\n\tif s.InfrastructureReady || s.BusinessEnabled || s.MySQL.State != \"disabled\" || s.MySQL.Required != true || s.Redis.Required {\n\t\tt.Fatal(\"false readiness\")\n\t}\n\tr.Stop()\n\tif r.Refresh(context.Background()).InfrastructureReady {\n\t\tt.Fatal(\"stopping became ready\")\n\t}\n}\n","chat/internal/dependencies/history.go":"package dependencies\n\nimport \"github.com/franz-9527/workers/chat/internal/message\"\nimport \"github.com/franz-9527/workers/chat/internal/ports\"\n\nfunc (r *Runtime) EnableHistory(c message.HistoryConfig) error {\n\tkey, e := c.Key()\n\tif e != nil {\n\t\treturn e\n\t}\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil || r.Conversations == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tr.History, e = message.NewHistoryService(r.sql, r.Conversations, r.environment, key, r.settings.Timeout())\n\tif e != nil {\n\t\treturn e\n\t}\n\tr.HistoryHTTP, e = message.NewHistoryHandler(r.History, r.Identity, 16)\n\treturn e\n}\n","chat/internal/dependencies/http.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// HTTP is reusable transport only. S03 supplies signed identity endpoints;\n// this stage never calls PHP or any supplier from a public request.\ntype HTTP struct {\n\tclient  *http.Client\n\tgate    chan struct{}\n\ttimeout time.Duration\n\tmaxBody int64\n}\n\nfunc NewHTTP(concurrency int, timeout time.Duration, maxBody int64) (*HTTP, error) {\n\tif concurrency < 1 || concurrency > 32 || timeout <= 0 || timeout > 5*time.Second || maxBody < 1 || maxBody > 1<<20 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttransport := &http.Transport{Proxy: nil, DialContext: (&net.Dialer{Timeout: timeout}).DialContext,\n\t\tMaxConnsPerHost: concurrency, MaxIdleConns: concurrency, MaxIdleConnsPerHost: concurrency,\n\t\tResponseHeaderTimeout: timeout, IdleConnTimeout: time.Minute, TLSHandshakeTimeout: timeout, MaxResponseHeaderBytes: 16 << 10}\n\treturn &HTTP{client: &http.Client{Transport: transport, Timeout: timeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}, gate: make(chan struct{}, concurrency), timeout: timeout, maxBody: maxBody}, nil\n}\nfunc (h *HTTP) Do(ctx context.Context, req *http.Request) ([]byte, int, error) {\n\tif req == nil || req.URL == nil || req.URL.User != nil || (req.URL.Scheme != \"http\" && req.URL.Scheme != \"https\") || req.ContentLength > 64<<10 {\n\t\treturn nil, 0, ports.ErrInvalid\n\t}\n\tif ctx.Err() != nil {\n\t\treturn nil, 0, ctx.Err()\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\treturn nil, 0, ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, h.timeout)\n\tdefer cancel()\n\tresponse, err := h.client.Do(req.Clone(ctx))\n\tif err != nil {\n\t\treturn nil, 0, ports.ErrUnavailable\n\t}\n\tdefer response.Body.Close()\n\tdata, err := io.ReadAll(io.LimitReader(response.Body, h.maxBody+1))\n\tif err != nil || int64(len(data)) > h.maxBody {\n\t\treturn nil, response.StatusCode, ports.ErrUnavailable\n\t}\n\treturn data, response.StatusCode, nil\n}\nfunc (h *HTTP) Close() { h.client.CloseIdleConnections() }\n","chat/internal/dependencies/identity.go":"package dependencies\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// EnableIdentity only enables identity exchange, never policy/message providers.\nfunc (r *Runtime) EnableIdentity(c auth.Config) error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tv, e := c.Verifier(r.environment)\n\tif e != nil {\n\t\treturn e\n\t}\n\tsource, e := auth.NewMySQLSource(r.sql)\n\tif e != nil {\n\t\treturn e\n\t}\n\tvar store auth.OneTimeStore\n\tif r.redis != nil {\n\t\tstore, e = auth.NewRedisStore(r.redis, r.environment, r.settings.Redis.KeyPrefix)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t}\n\tr.Identity, e = auth.NewService(v, source, store, r.settings.ExternalConcurrency, r.settings.Timeout())\n\tif e != nil {\n\t\treturn e\n\t}\n\tr.Ports.Identity = r.Identity\n\tr.IdentityHTTP, e = auth.NewHandler(r.Identity, r.settings.ExternalConcurrency)\n\treturn e\n}\n","chat/internal/dependencies/integration_test.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"syscall\"\n\t\"testing\"\n\t\"time\"\n\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\n// Explicit opt-in, loopback only, isolated fixture database/user. Never load a\n// production config or migrate the application schema from a test.\nfunc TestMySQL57RedisIntegration(t *testing.T) {\n\tif os.Getenv(\"CHAT_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"set CHAT_INTEGRATION=1 for isolated real services\")\n\t}\n\tma, ra := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"), os.Getenv(\"CHAT_INTEGRATION_REDIS_ADDR\")\n\tif !loopback(ma) || !loopback(ra) {\n\t\tt.Fatal(\"integration requires explicit loopback endpoints\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)\n\tdefer cancel()\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = ma\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ReadTimeout = time.Second\n\tc.WriteTimeout = time.Second\n\tc.Logger = silentMySQLLog{}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(\"admin connector failed\")\n\t}\n\tadmin := sql.OpenDB(connector)\n\tt.Cleanup(func() { _ = admin.Close() })\n\tif err := admin.PingContext(ctx); err != nil {\n\t\tvar dbError *mysql.MySQLError\n\t\tif errors.As(err, &dbError) {\n\t\t\tt.Fatalf(\"isolated MySQL admin error code=%d\", dbError.Number)\n\t\t}\n\t\tt.Fatalf(\"isolated MySQL unavailable: error type %T\", err)\n\t}\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tdatabase, user := \"bixuan_test_s02_\"+suffix, \"bxchat_test_\"+suffix\n\tvar b [16]byte\n\tif _, err = rand.Read(b[:]); err != nil {\n\t\tt.Fatal(\"fixture secret failed\")\n\t}\n\tpw := hex.EncodeToString(b[:])\n\texec := func(query string) {\n\t\tt.Helper()\n\t\tif _, err := admin.ExecContext(ctx, query); err != nil {\n\t\t\tt.Fatal(\"isolated fixture operation failed\")\n\t\t}\n\t}\n\texec(\"CREATE DATABASE `\" + database + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tt.Cleanup(func() { _, _ = admin.Exec(\"DROP DATABASE IF EXISTS `\" + database + \"`\") })\n\texec(\"CREATE USER '\" + user + \"'@'127.0.0.1' IDENTIFIED BY '\" + pw + \"'\")\n\tt.Cleanup(func() { _, _ = admin.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'127.0.0.1'\") })\n\texec(\"CREATE TABLE `\" + database + \"`.chat_contract_probe(id BIGINT UNSIGNED PRIMARY KEY, body TEXT, created_at DATETIME(6)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci\")\n\texec(\"CREATE TABLE `\" + database + \"`.orders(id BIGINT PRIMARY KEY)\")\n\texec(\"INSERT INTO `\" + database + \"`.orders(id) VALUES(1)\")\n\texec(\"CREATE TABLE `\" + database + \"`.user_wallets(id BIGINT PRIMARY KEY)\")\n\texec(\"GRANT SELECT,INSERT,UPDATE,DELETE ON `\" + database + \"`.chat_contract_probe TO '\" + user + \"'@'127.0.0.1'\")\n\texec(\"GRANT SELECT ON `\" + database + \"`.orders TO '\" + user + \"'@'127.0.0.1'\")\n\tt.Setenv(\"CHAT_MYSQL_PASSWORD\", pw)\n\ts := Defaults()\n\ts.MySQL.Enabled = true\n\ts.MySQL.Address = ma\n\ts.MySQL.Database = database\n\ts.MySQL.Username = user\n\ts.MySQL.MaxOpenServe = 2\n\ts.Redis.Enabled = true\n\ts.Redis.Address = ra\n\ts.Redis.KeyPrefix = \"bxchat:test:\"\n\tr, err := Open(s, \"test\", \"serve\", \"disabled\")\n\tif err != nil {\n\t\tt.Fatal(\"resource open failed\")\n\t}\n\tdefer r.Close()\n\tif got := r.Refresh(ctx); !got.InfrastructureReady || got.Redis.State != \"ready\" || got.BusinessEnabled {\n\t\tt.Fatalf(\"real dependency contract failed: %#v\", got)\n\t}\n\tvar version string\n\tif r.sql.QueryRowContext(ctx, \"SELECT VERSION()\").Scan(&version) != nil {\n\t\tt.Fatal(\"version query failed\")\n\t}\n\tt.Log(\"MySQL verified:\", version)\n\tstamp := time.Date(2026, 10, 21, 1, 2, 3, 123456000, time.UTC)\n\tbody := \"墙纸🧱 尺寸12.5 金额100\"\n\tif _, err = r.sql.ExecContext(ctx, \"INSERT INTO chat_contract_probe(id,body,created_at) VALUES (?,?,?)\", \"18446744073709551615\", body, stamp); err != nil {\n\t\tt.Fatal(\"utf8mb4/bigint/time insert failed\")\n\t}\n\tvar gotID, gotBody string\n\tvar gotTime time.Time\n\tif r.sql.QueryRowContext(ctx, \"SELECT id,body,created_at FROM chat_contract_probe\").Scan(&gotID, &gotBody, &gotTime) != nil || gotID != \"18446744073709551615\" || gotBody != body || !gotTime.Equal(stamp) || gotTime.Location() != time.UTC {\n\t\tt.Fatal(\"cross-language data contract failed\")\n\t}\n\tfor _, query := range []string{\"UPDATE orders SET id=2\", \"UPDATE user_wallets SET id=2\", \"CREATE TABLE forbidden_ddl(id INT)\"} {\n\t\t_, err = r.sql.ExecContext(ctx, query)\n\t\tvar denied *mysql.MySQLError\n\t\tif !errors.As(err, &denied) || denied.Number != 1142 {\n\t\t\tt.Fatal(\"business write/DDL not denied by MySQL\")\n\t\t}\n\t}\n\ttx, err := r.sql.BeginTx(ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(\"read-lock transaction failed\")\n\t}\n\tvar orderID int\n\terr = tx.QueryRowContext(ctx, \"SELECT id FROM orders WHERE id=1 FOR UPDATE\").Scan(&orderID)\n\t_ = tx.Rollback()\n\tif err != nil || orderID != 1 {\n\t\tt.Fatal(\"SELECT-only permission cannot lock authority row\")\n\t}\n\tt.Run(\"pool_and_cancellation\", func(t *testing.T) {\n\t\tone, e := r.sql.Conn(ctx)\n\t\tif e != nil {\n\t\t\tt.Fatal(\"lease failed\")\n\t\t}\n\t\ttwo, e := r.sql.Conn(ctx)\n\t\tif e != nil {\n\t\t\tone.Close()\n\t\t\tt.Fatal(\"lease failed\")\n\t\t}\n\t\tshort, stop := context.WithTimeout(ctx, 40*time.Millisecond)\n\t\t_, e = r.sql.Conn(short)\n\t\tstop()\n\t\tone.Close()\n\t\ttwo.Close()\n\t\tif e == nil {\n\t\t\tt.Fatal(\"pool admission deadline ignored\")\n\t\t}\n\t\tvar wg sync.WaitGroup\n\t\tfor range 8 {\n\t\t\twg.Add(1)\n\t\t\tgo func() { defer wg.Done(); var n int; _ = r.sql.QueryRowContext(ctx, \"SELECT SLEEP(0.02)\").Scan(&n) }()\n\t\t}\n\t\twg.Wait()\n\t\tif r.sql.Stats().OpenConnections > 2 {\n\t\t\tt.Fatal(\"MySQL pool exceeded budget\")\n\t\t}\n\t\tshort, stop = context.WithTimeout(ctx, 40*time.Millisecond)\n\t\tdefer stop()\n\t\tvar n int\n\t\tif r.sql.QueryRowContext(short, \"SELECT SLEEP(1)\").Scan(&n) == nil {\n\t\t\tt.Fatal(\"query deadline ignored\")\n\t\t}\n\t})\n\tkey := s.Redis.KeyPrefix + \"s02:\" + suffix\n\tif r.redis.Set(ctx, key, \"临时票据\", time.Minute).Err() != nil {\n\t\tt.Fatal(\"Redis set failed\")\n\t}\n\tdefer r.redis.Del(context.Background(), key)\n\tif value, e := r.redis.GetDel(ctx, key).Result(); e != nil || value != \"临时票据\" {\n\t\tt.Fatal(\"Redis atomic consume failed\")\n\t}\n\tif r.redis.PoolStats().TotalConns > uint32(s.Redis.PoolServe) {\n\t\tt.Fatal(\"Redis pool exceeded cap\")\n\t}\n\tinfo, e := r.redis.Info(ctx, \"server\").Result()\n\tif e != nil {\n\t\tt.Fatal(\"Redis version query failed\")\n\t}\n\tfor _, line := range strings.Split(info, \"\\r\\n\") {\n\t\tif strings.HasPrefix(line, \"redis_version:\") {\n\t\t\tt.Log(line)\n\t\t}\n\t}\n\tdegraded := s\n\tdegraded.Redis.Address = \"127.0.0.1:1\"\n\td, e := Open(degraded, \"test\", \"serve\", \"disabled\")\n\tif e != nil {\n\t\tt.Fatal(\"degraded resource open failed\")\n\t}\n\tdefer d.Close()\n\tif got := d.Refresh(ctx); !got.InfrastructureReady || got.Redis.State != \"unavailable\" {\n\t\tt.Fatal(\"Redis failure blocked required dependency\")\n\t}\n\tfailed := s\n\tfailed.MySQL.Address = \"127.0.0.1:1\"\n\tf, e := Open(failed, \"test\", \"serve\", \"disabled\")\n\tif e != nil {\n\t\tt.Fatal(\"failed resource open failed\")\n\t}\n\tdefer f.Close()\n\tif got := f.Refresh(ctx); got.InfrastructureReady || got.MySQL.State != \"unavailable\" {\n\t\tt.Fatal(\"MySQL outage reported ready\")\n\t}\n\tif binary := os.Getenv(\"CHAT_INTEGRATION_CHATD_BIN\"); binary != \"\" {\n\t\ttestProcessReadiness(t, binary, s)\n\t}\n\texec(\"GRANT UPDATE ON `\" + database + \"`.orders TO '\" + user + \"'@'127.0.0.1'\")\n\tif got := r.Refresh(ctx); got.InfrastructureReady || got.MySQL.Code != \"CHAT_DATABASE_CONTRACT_INVALID\" {\n\t\tt.Fatal(\"overprivileged account reported ready\")\n\t}\n}\n\nfunc testProcessReadiness(t *testing.T, binary string, s Settings) {\n\tt.Helper()\n\tif !filepath.IsAbs(binary) {\n\t\tt.Fatal(\"binary must have an absolute local path\")\n\t}\n\tfor _, test := range []struct {\n\t\tname         string\n\t\tmysql, redis bool\n\t\tstatus       int\n\t}{{\"healthy\", true, true, 200}, {\"redis_degraded\", true, false, 200}, {\"mysql_down\", false, true, 503}} {\n\t\tt.Run(\"process_\"+test.name, func(t *testing.T) {\n\t\t\tdeps := s\n\t\t\tif !test.mysql {\n\t\t\t\tdeps.MySQL.Address = \"127.0.0.1:1\"\n\t\t\t}\n\t\t\tif !test.redis {\n\t\t\t\tdeps.Redis.Address = \"127.0.0.1:1\"\n\t\t\t}\n\t\t\taddresses := []string{}\n\t\t\tfor range 2 {\n\t\t\t\tlistener, e := net.Listen(\"tcp\", \"127.0.0.1:0\")\n\t\t\t\tif e != nil {\n\t\t\t\t\tt.Fatal(\"test port allocation failed\")\n\t\t\t\t}\n\t\t\t\taddresses = append(addresses, listener.Addr().String())\n\t\t\t\t_ = listener.Close()\n\t\t\t}\n\t\t\tcfg := map[string]any{\"env\": \"test\", \"http\": map[string]string{\"listen\": addresses[0], \"internal_listen\": addresses[1]}, \"shutdown_timeout\": \"1s\", \"log_level\": \"error\", \"provider_mode\": \"disabled\", \"dependencies\": deps}\n\t\t\tdata, _ := json.Marshal(cfg)\n\t\t\tpath := filepath.Join(t.TempDir(), \"chat.json\")\n\t\t\tif os.WriteFile(path, data, 0600) != nil {\n\t\t\t\tt.Fatal(\"process config write failed\")\n\t\t\t}\n\t\t\tcmd := exec.Command(binary, \"serve\", \"--config\", path)\n\t\t\tcmd.Stdout = io.Discard\n\t\t\tcmd.Stderr = io.Discard\n\t\t\tif cmd.Start() != nil {\n\t\t\t\tt.Fatal(\"process start failed\")\n\t\t\t}\n\t\t\tdone := make(chan error, 1)\n\t\t\tgo func() { done <- cmd.Wait() }()\n\t\t\tdefer func() {\n\t\t\t\t_ = cmd.Process.Signal(syscall.SIGTERM)\n\t\t\t\tselect {\n\t\t\t\tcase err := <-done:\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Error(\"process exited unsuccessfully\")\n\t\t\t\t\t}\n\t\t\t\tcase <-time.After(3 * time.Second):\n\t\t\t\t\t_ = cmd.Process.Kill()\n\t\t\t\t\t<-done\n\t\t\t\t\tt.Error(\"process shutdown timed out\")\n\t\t\t\t}\n\t\t\t}()\n\t\t\tclient := &http.Client{Timeout: time.Second, Transport: &http.Transport{Proxy: nil}}\n\t\t\tdefer client.CloseIdleConnections()\n\t\t\turl := \"http://\" + addresses[1] + \"/readyz\"\n\t\t\tvar response *http.Response\n\t\t\tvar err error\n\t\t\tdeadline := time.Now().Add(5 * time.Second)\n\t\t\tfor time.Now().Before(deadline) {\n\t\t\t\tresponse, err = client.Get(url)\n\t\t\t\tif err == nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\ttime.Sleep(10 * time.Millisecond)\n\t\t\t}\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(\"health endpoint unavailable\")\n\t\t\t}\n\t\t\tvar snapshot Snapshot\n\t\t\terr = json.NewDecoder(response.Body).Decode(&snapshot)\n\t\t\t_ = response.Body.Close()\n\t\t\tif err != nil || response.StatusCode != test.status || snapshot.BusinessEnabled || snapshot.Scope != \"infrastructure_only\" || snapshot.InfrastructureReady != test.mysql {\n\t\t\t\tt.Fatal(\"process readiness contract failed\")\n\t\t\t}\n\t\t\tif test.redis != (snapshot.Redis.State == \"ready\") {\n\t\t\t\tt.Fatal(\"Redis degraded state missing\")\n\t\t\t}\n\t\t\tfor _, path := range []string{\"/readyz\", \"/chat/api/v1/messages\", \"/chat/ws\"} {\n\t\t\t\tresp, e := client.Get(\"http://\" + addresses[0] + path)\n\t\t\t\tif e != nil {\n\t\t\t\t\tt.Fatal(\"public endpoint failed\")\n\t\t\t\t}\n\t\t\t\t_ = resp.Body.Close()\n\t\t\t\tif resp.StatusCode != 404 {\n\t\t\t\t\tt.Fatal(\"private/business endpoint exposed\")\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n","chat/internal/dependencies/mysql.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\ntype silentMySQLLog struct{}\n\nfunc (silentMySQLLog) Print(...any) {}\n\nfunc openMySQL(s Settings, role string) (*sql.DB, error) {\n\tpw, err := password(s.MySQL.PasswordEnv, true)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = s.MySQL.Address\n\tc.DBName = s.MySQL.Database\n\tc.User = s.MySQL.Username\n\tc.Passwd = pw\n\tc.Collation = \"utf8mb4_unicode_ci\"\n\tc.ParseTime = true\n\tc.Loc = time.UTC\n\tc.Timeout = s.Timeout()\n\tc.ReadTimeout = s.Timeout()\n\tc.WriteTimeout = s.Timeout()\n\tc.Logger = silentMySQLLog{}\n\tif err := c.Apply(mysql.Charset(\"utf8mb4\", \"utf8mb4_unicode_ci\")); err != nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tc.Params = map[string]string{\"time_zone\": \"'+00:00'\", \"sql_mode\": \"'STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'\"}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tdb := sql.OpenDB(connector)\n\tmax := s.MySQL.MaxOpenServe\n\tif role == \"worker\" {\n\t\tmax = s.MySQL.MaxOpenWorker\n\t}\n\tdb.SetMaxOpenConns(max)\n\tdb.SetMaxIdleConns(s.MySQL.MaxIdle)\n\tdb.SetConnMaxLifetime(3 * time.Minute)\n\tdb.SetConnMaxIdleTime(time.Minute)\n\treturn db, nil\n}\n\nvar mysql57 = regexp.MustCompile(`^5\\.7\\.[0-9]+(?:[-.].*)?$`)\n\nfunc checkMySQL(ctx context.Context, db *sql.DB, database, environment string) error {\n\t// One lease keeps session invariants and SHOW GRANTS on the same connection.\n\tconn, err := db.Conn(ctx)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer conn.Close()\n\tvar version, zone, collation, charset, mode, schemaCollation string\n\terr = conn.QueryRowContext(ctx, `SELECT VERSION(), @@session.time_zone, @@session.collation_connection, @@session.character_set_connection, @@session.sql_mode`).Scan(&version, &zone, &collation, &charset, &mode)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !mysql57.MatchString(version) || zone != \"+00:00\" || collation != \"utf8mb4_unicode_ci\" || charset != \"utf8mb4\" || !strings.Contains(mode, \"STRICT_TRANS_TABLES\") {\n\t\treturn ports.ErrInvalid\n\t}\n\tif conn.QueryRowContext(ctx, `SELECT DEFAULT_COLLATION_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = DATABASE()`).Scan(&schemaCollation) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif schemaCollation != \"utf8mb4_unicode_ci\" {\n\t\treturn ports.ErrInvalid\n\t}\n\trows, err := conn.QueryContext(ctx, \"SHOW GRANTS\")\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tdefer rows.Close()\n\tcount := 0\n\tfor rows.Next() {\n\t\tvar grant string\n\t\tif rows.Scan(&grant) != nil || !safeGrant(grant, database, environment) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tcount++\n\t}\n\tif rows.Err() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif count == 0 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\n// Exact table ownership, never a chat_* wildcard: PHP owns several chat_* tables.\nvar goOwned = map[string]bool{\n\t\"chat_conversations\": true, \"chat_members\": true, \"chat_member_intervals\": true, \"chat_member_reads\": true,\n\t\"chat_messages\": true, \"chat_message_changes\": true, \"chat_send_intents\": true,\n\t\"chat_preference_accounts\": true, \"chat_attachments\": true, \"chat_media_tasks\": true, \"chat_user_preferences\": true,\n\t\"chat_restrictions\": true, \"chat_text_checks\": true, \"chat_risk_events\": true, \"chat_reviews\": true, \"chat_audit\": true,\n\t\"chat_event_receipts\": true, \"chat_notification_intents\": true, \"chat_call_sessions\": true,\n}\nvar phpReadable = map[string]bool{\"wechat_identities\": true, \"users\": true, \"login_sessions\": true, \"chat_admin_sessions\": true, \"orders\": true, \"assignments\": true, \"after_sales\": true, \"chat_policy_guards\": true, \"chat_business_events\": true, \"chat_staff_authority_versions\": true}\n\nfunc safeGrant(grant, database, environment string) bool {\n\tif !strings.HasPrefix(grant, \"GRANT \") || strings.Contains(grant, \" WITH GRANT OPTION\") {\n\t\treturn false\n\t}\n\tafter, subject, ok := strings.Cut(strings.TrimPrefix(grant, \"GRANT \"), \" ON \")\n\tif !ok {\n\t\treturn false\n\t}\n\ttarget, _, ok := strings.Cut(subject, \" TO \")\n\tif !ok {\n\t\treturn false\n\t}\n\tif after == \"USAGE\" && target == \"*.*\" {\n\t\treturn true\n\t}\n\tparts := strings.Split(strings.ReplaceAll(target, \"`\", \"\"), \".\")\n\tif len(parts) != 2 || parts[0] != database || !identifier.MatchString(parts[1]) {\n\t\treturn false\n\t}\n\towned := goOwned[parts[1]] || (environment != \"production\" && parts[1] == \"chat_contract_probe\")\n\tfor _, privilege := range strings.Split(after, \", \") {\n\t\tif privilege == \"SELECT\" && (owned || phpReadable[parts[1]]) {\n\t\t\tcontinue\n\t\t}\n\t\tif owned && (privilege == \"INSERT\" || privilege == \"UPDATE\" || privilege == \"DELETE\") {\n\t\t\tcontinue\n\t\t}\n\t\treturn false\n\t}\n\treturn true\n}\n","chat/internal/dependencies/providers.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Scenario is an explicit isolated fixture, not a permissive fallback. The\n// runtime uses an empty scenario: no identity/permission/safety is fabricated.\ntype Scenario struct {\n\tCredential                   string\n\tPrincipal                    ports.Principal\n\tGrant                        ports.Grant\n\tSafety                       ports.SafetyResult\n\tMedia                        ports.MediaResult\n\tReceipt                      ports.Receipt\n\tDelay                        time.Duration\n\tFailure                      error\n\tConversationID               ports.ID\n\tFingerprint, Text, ObjectKey string\n\tReminder                     ports.Reminder\n}\ntype provider struct {\n\tscenario    Scenario\n\tmode        string\n\tgate        chan struct{}\n\ttimeout     time.Duration\n\tenvironment string\n}\n\nfunc NewProviders(environment, mode string, concurrency int, timeout time.Duration, s Scenario) (ports.Set, error) {\n\tif concurrency < 1 || concurrency > 32 || timeout <= 0 || timeout > 5*time.Second || (environment != \"development\" && environment != \"test\" && environment != \"production\") || (mode != \"disabled\" && mode != \"fake\") || (mode == \"fake\" && environment != \"development\" && environment != \"test\") {\n\t\treturn ports.Set{}, ports.ErrInvalid\n\t}\n\tif s.Safety.Finding != nil {\n\t\tcopy := *s.Safety.Finding\n\t\ts.Safety.Finding = &copy\n\t}\n\ts.Principal.Scopes = append([]string(nil), s.Principal.Scopes...)\n\tp := &provider{scenario: s, mode: mode, gate: make(chan struct{}, concurrency), timeout: timeout, environment: environment}\n\treturn ports.Set{Identity: p, Policy: p, Safety: p, Media: p, Notification: p}, nil\n}\nfunc (p *provider) call(ctx context.Context, fn func() error) error {\n\tif ctx.Err() != nil {\n\t\treturn ctx.Err()\n\t}\n\tif p.mode != \"fake\" {\n\t\treturn ports.ErrUnavailable\n\t}\n\tselect {\n\tcase p.gate <- struct{}{}:\n\t\tdefer func() { <-p.gate }()\n\tdefault:\n\t\treturn ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, p.timeout)\n\tdefer cancel()\n\tif p.scenario.Delay > 0 {\n\t\tt := time.NewTimer(p.scenario.Delay)\n\t\tdefer t.Stop()\n\t\tselect {\n\t\tcase <-t.C:\n\t\tcase <-ctx.Done():\n\t\t\treturn ctx.Err()\n\t\t}\n\t}\n\tif ctx.Err() != nil {\n\t\treturn ctx.Err()\n\t}\n\tif p.scenario.Failure != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn fn()\n}\nfunc (p *provider) Authenticate(ctx context.Context, credential string) (ports.Principal, error) {\n\tvar result ports.Principal\n\terr := p.call(ctx, func() error {\n\t\tif p.scenario.Credential == \"\" || credential != p.scenario.Credential || !p.actor(p.scenario.Principal) {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Principal\n\t\tresult.Scopes = append([]string(nil), result.Scopes...)\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) Authorize(ctx context.Context, q ports.PolicyRequest) (ports.Grant, error) {\n\tvar result ports.Grant\n\terr := p.call(ctx, func() error {\n\t\tif !p.actor(q.Actor) || q.ConversationID != p.scenario.ConversationID || !q.ConversationID.Valid() || !p.scenario.Grant.Version.Valid() || p.scenario.Grant.ScopeKey == \"\" {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Grant\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) CheckText(ctx context.Context, q ports.TextRequest) (ports.SafetyResult, error) {\n\tvar result ports.SafetyResult\n\terr := p.call(ctx, func() error {\n\t\tif !p.actor(q.Actor) || q.Fingerprint == \"\" || q.Fingerprint != p.scenario.Fingerprint || q.Text != p.scenario.Text || q.ConversationID != p.scenario.ConversationID || (p.scenario.Safety.Decision != \"passed\" && p.scenario.Safety.Decision != \"blocked\" && p.scenario.Safety.Decision != \"review\") || p.scenario.Safety.RuleVersion == \"\" {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Safety\n\t\tif result.Finding != nil {\n\t\t\tcopy := *result.Finding\n\t\t\tresult.Finding = &copy\n\t\t}\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) Inspect(ctx context.Context, q ports.MediaRequest) (ports.MediaResult, error) {\n\tvar result ports.MediaResult\n\terr := p.call(ctx, func() error {\n\t\ts := p.scenario.Media\n\t\tif !p.actor(q.Actor) || q.ObjectKey == \"\" || q.ObjectKey != p.scenario.ObjectKey || q.ObjectVersion == \"\" || q.ObjectVersion != s.ObjectVersion || q.ManifestHash == \"\" || q.ManifestHash != s.ManifestHash || (s.Decision != \"passed\" && s.Decision != \"blocked\") {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = s\n\t\treturn nil\n\t})\n\treturn result, err\n}\nfunc (p *provider) Submit(ctx context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tvar result ports.Receipt\n\terr := p.call(ctx, func() error {\n\t\tif q != p.scenario.Reminder {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tif q.OperationID == \"\" || q.OperationID != p.scenario.Receipt.OperationID || (p.scenario.Receipt.State != \"accepted\" && p.scenario.Receipt.State != \"provider_unknown\") {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tresult = p.scenario.Receipt\n\t\treturn nil\n\t})\n\treturn result, err\n}\n\nfunc (p *provider) actor(a ports.Principal) bool {\n\tb := p.scenario.Principal\n\treturn a.ActorID.Valid() && a.ActorID != \"0\" && a.ActorID == b.ActorID && a.SessionID != \"\" && a.SessionID == b.SessionID && a.Environment == p.environment && a.Environment == b.Environment\n}\n","chat/internal/dependencies/redis.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\ntype silentRedisLog struct{}\n\nfunc (silentRedisLog) Printf(context.Context, string, ...interface{}) {}\nfunc init()                                                           { redis.SetLogger(silentRedisLog{}) }\n\nfunc openRedis(s Settings, role string) (*redis.Client, error) {\n\tpw, err := password(s.Redis.PasswordEnv, false)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tmax := s.Redis.PoolServe\n\tif role == \"worker\" {\n\t\tmax = s.Redis.PoolWorker\n\t}\n\treturn redis.NewClient(&redis.Options{Addr: s.Redis.Address, Password: pw, Protocol: 2,\n\t\tPoolSize: max, MaxActiveConns: max, MaxConcurrentDials: max, MaxIdleConns: max, MinIdleConns: 0,\n\t\tPipelinePoolSize: -1, MaxRetries: -1, DialerRetries: 1, DisableIdentity: true,\n\t\tDialTimeout: s.Timeout(), ReadTimeout: s.Timeout(), WriteTimeout: s.Timeout(), PoolTimeout: s.Timeout(),\n\t\tContextTimeoutEnabled: true}), nil\n}\n","chat/internal/dependencies/runtime.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"net/http\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/moderation\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\ntype Runtime struct {\n\tIdentity          *auth.Service\n\tIdentityHTTP      http.Handler\n\tConversations     *conversation.Store\n\tModeration        *moderation.Service\n\tHistory           *message.HistoryService\n\tHistoryHTTP       http.Handler\n\tSocket            *socket.Gateway\n\tsql               *sql.DB\n\tredis             *redis.Client\n\tPorts             ports.Set\n\tsettings          Settings\n\tenvironment, mode string\n\tmu                sync.RWMutex\n\tsnapshot          Snapshot\n\tstopping          bool\n}\ntype DependencyState struct {\n\tState    string `json:\"state\"`\n\tRequired bool   `json:\"required\"`\n\tCode     string `json:\"code,omitempty\"`\n}\ntype Snapshot struct {\n\tStage               string          `json:\"stage\"`\n\tScope               string          `json:\"scope\"`\n\tInfrastructureReady bool            `json:\"infrastructure_ready\"`\n\tBusinessEnabled     bool            `json:\"business_enabled\"`\n\tProviderMode        string          `json:\"provider_mode\"`\n\tSimulated           bool            `json:\"simulated\"`\n\tCheckedAt           time.Time       `json:\"checked_at\"`\n\tMySQL               DependencyState `json:\"mysql\"`\n\tRedis               DependencyState `json:\"redis\"`\n}\n\nfunc Open(s Settings, environment, role, mode string) (*Runtime, error) {\n\tif s.Validate(environment) != nil || (role != \"serve\" && role != \"worker\") {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tp, err := NewProviders(environment, mode, s.ExternalConcurrency, s.Timeout(), Scenario{})\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tr := &Runtime{settings: s, environment: environment, mode: mode, Ports: p}\n\tif s.MySQL.Enabled {\n\t\tr.sql, err = openMySQL(s, role)\n\t\tif err != nil {\n\t\t\tr.Close()\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tif s.Redis.Enabled {\n\t\tr.redis, err = openRedis(s, role)\n\t\tif err != nil {\n\t\t\tr.Close()\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tr.snapshot = r.newSnapshot()\n\treturn r, nil\n}\nfunc (r *Runtime) newSnapshot() Snapshot {\n\treturn Snapshot{Stage: \"S11\", Scope: \"infrastructure_only\", ProviderMode: r.mode, Simulated: r.mode == \"fake\", MySQL: DependencyState{State: \"disabled\", Required: true}, Redis: DependencyState{State: \"disabled\", Required: false}}\n}\n\n// Projection enables internal order membership only. No public messages/routes.\nfunc (r *Runtime) EnableConversations(c conversation.Config) error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar err error\n\tr.Conversations, err = conversation.NewStore(r.sql, r.environment, r.settings.Timeout())\n\tif err == nil {\n\t\tr.Ports.Policy = r.Conversations\n\t}\n\treturn err\n}\n\n// Safety is independent from the still-closed message release gate.\nfunc (r *Runtime) EnableSafety(c moderation.Config) error {\n\tif c.Validate() != nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil || r.Conversations == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tservice, err := moderation.New(r.sql, r.environment, c, min(r.settings.ExternalConcurrency, 16), min(r.settings.Timeout(), 2*time.Second), nil)\n\tif err == nil {\n\t\tr.Moderation = service\n\t\tr.Ports.Safety = service\n\t}\n\treturn err\n}\nfunc (r *Runtime) Refresh(ctx context.Context) Snapshot {\n\ts := r.newSnapshot()\n\ts.CheckedAt = time.Now().UTC()\n\tif r.sql != nil {\n\t\tprobe, cancel := context.WithTimeout(ctx, r.settings.Timeout())\n\t\terr := checkMySQL(probe, r.sql, r.settings.MySQL.Database, r.environment)\n\t\tcancel()\n\t\ts.MySQL = state(err, true)\n\t\ts.InfrastructureReady = err == nil\n\t}\n\tif r.redis != nil {\n\t\tprobe, cancel := context.WithTimeout(ctx, r.settings.Timeout())\n\t\terr := r.redis.Ping(probe).Err()\n\t\tcancel()\n\t\ts.Redis = state(err, false)\n\t}\n\tr.mu.Lock()\n\tif !r.stopping {\n\t\tr.snapshot = s\n\t}\n\tr.mu.Unlock()\n\treturn r.Snapshot()\n}\nfunc state(err error, required bool) DependencyState {\n\tif err == nil {\n\t\treturn DependencyState{State: \"ready\", Required: required}\n\t}\n\tcode := \"CHAT_DEPENDENCY_UNAVAILABLE\"\n\tif err == ports.ErrInvalid {\n\t\tcode = \"CHAT_DATABASE_CONTRACT_INVALID\"\n\t}\n\treturn DependencyState{State: \"unavailable\", Required: required, Code: code}\n}\nfunc (r *Runtime) Snapshot() Snapshot { r.mu.RLock(); defer r.mu.RUnlock(); return r.snapshot }\nfunc (r *Runtime) Monitor(ctx context.Context) {\n\tt := time.NewTicker(r.settings.Interval())\n\tdefer t.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-t.C:\n\t\t\tr.Refresh(ctx)\n\t\t}\n\t}\n}\nfunc (r *Runtime) Stop() {\n\tr.mu.Lock()\n\tdefer r.mu.Unlock()\n\tr.stopping = true\n\tr.snapshot.InfrastructureReady = false\n}\nfunc (r *Runtime) Close() {\n\tr.Stop()\n\tif r.Socket != nil {\n\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n\t\t_ = r.Socket.Shutdown(ctx)\n\t\tcancel()\n\t}\n\tif r.Moderation != nil {\n\t\tr.Moderation.Close()\n\t}\n\tif r.redis != nil {\n\t\t_ = r.redis.Close()\n\t}\n\tif r.sql != nil {\n\t\t_ = r.sql.Close()\n\t}\n}\n","chat/internal/dependencies/settings.go":"package dependencies\n\nimport (\n\t\"net\"\n\t\"os\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Settings struct {\n\tOperationTimeout    string        `json:\"operation_timeout\"`\n\tProbeInterval       string        `json:\"probe_interval\"`\n\tExternalConcurrency int           `json:\"external_concurrency\"`\n\tMySQL               MySQLSettings `json:\"mysql\"`\n\tRedis               RedisSettings `json:\"redis\"`\n}\ntype MySQLSettings struct {\n\tEnabled       bool   `json:\"enabled\"`\n\tAddress       string `json:\"address\"`\n\tDatabase      string `json:\"database\"`\n\tUsername      string `json:\"username\"`\n\tPasswordEnv   string `json:\"password_env\"`\n\tMaxOpenServe  int    `json:\"max_open_serve\"`\n\tMaxOpenWorker int    `json:\"max_open_worker\"`\n\tMaxIdle       int    `json:\"max_idle\"`\n}\ntype RedisSettings struct {\n\tEnabled     bool   `json:\"enabled\"`\n\tAddress     string `json:\"address\"`\n\tKeyPrefix   string `json:\"key_prefix\"`\n\tPasswordEnv string `json:\"password_env\"`\n\tPoolServe   int    `json:\"pool_serve\"`\n\tPoolWorker  int    `json:\"pool_worker\"`\n}\n\nfunc Defaults() Settings {\n\treturn Settings{OperationTimeout: \"500ms\", ProbeInterval: \"10s\", ExternalConcurrency: 4,\n\t\tMySQL: MySQLSettings{Address: \"127.0.0.1:3306\", PasswordEnv: \"CHAT_MYSQL_PASSWORD\", MaxOpenServe: 4, MaxOpenWorker: 2, MaxIdle: 1},\n\t\tRedis: RedisSettings{Address: \"127.0.0.1:6379\", PoolServe: 2, PoolWorker: 1}}\n}\n\nvar identifier = regexp.MustCompile(`^[a-zA-Z0-9_]{1,64}$`)\nvar secretName = regexp.MustCompile(`^CHAT_[A-Z0-9_]{1,60}$`)\n\nfunc (s Settings) Validate(environment string) error {\n\tif environment != \"development\" && environment != \"test\" && environment != \"production\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tt, e := time.ParseDuration(s.OperationTimeout)\n\ti, ie := time.ParseDuration(s.ProbeInterval)\n\tif e != nil || ie != nil || t < 50*time.Millisecond || t > 5*time.Second || i < time.Second || i > time.Minute || i < t || s.ExternalConcurrency < 1 || s.ExternalConcurrency > 32 {\n\t\treturn ports.ErrInvalid\n\t}\n\tm, r := s.MySQL, s.Redis\n\tif m.MaxOpenServe < 1 || m.MaxOpenWorker < 1 || m.MaxOpenServe+m.MaxOpenWorker > 32 || m.MaxIdle < 0 || m.MaxIdle > m.MaxOpenServe || m.MaxIdle > m.MaxOpenWorker {\n\t\treturn ports.ErrInvalid\n\t}\n\tif r.PoolServe < 1 || r.PoolWorker < 1 || r.PoolServe+r.PoolWorker > 16 {\n\t\treturn ports.ErrInvalid\n\t}\n\tif m.Enabled {\n\t\tprefix := map[string]string{\"development\": \"bixuan_dev_\", \"test\": \"bixuan_test_\"}[environment]\n\t\tif !loopback(m.Address) || !identifier.MatchString(m.Database) || !identifier.MatchString(m.Username) || len(m.Username) > 32 || !strings.HasPrefix(m.Username, \"bxchat_\"+environment+\"_\") || !secretName.MatchString(m.PasswordEnv) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tif prefix != \"\" && !strings.HasPrefix(m.Database, prefix) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tif environment == \"production\" && (strings.HasPrefix(m.Database, \"bixuan_dev_\") || strings.HasPrefix(m.Database, \"bixuan_test_\")) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t}\n\tif r.Enabled && (!loopback(r.Address) || r.KeyPrefix != \"bxchat:\"+environment+\":\" || (r.PasswordEnv != \"\" && !secretName.MatchString(r.PasswordEnv))) {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\nfunc loopback(address string) bool {\n\thost, p, e := net.SplitHostPort(address)\n\tn, ne := strconv.Atoi(p)\n\tip := net.ParseIP(host)\n\treturn e == nil && ne == nil && n > 0 && n <= 65535 && ip != nil && ip.IsLoopback()\n}\nfunc (s Settings) Timeout() time.Duration  { t, _ := time.ParseDuration(s.OperationTimeout); return t }\nfunc (s Settings) Interval() time.Duration { t, _ := time.ParseDuration(s.ProbeInterval); return t }\nfunc password(name string, required bool) (string, error) {\n\tif name == \"\" && !required {\n\t\treturn \"\", nil\n\t}\n\tvalue, ok := os.LookupEnv(name)\n\tif !ok || value == \"\" {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\treturn value, nil\n}\n","chat/internal/dependencies/socket.go":"package dependencies\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n)\n\nfunc (r *Runtime) EnableSocket(c socket.Config) error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.Identity == nil || r.redis == nil || r.sql == nil || r.mode != \"disabled\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar e error\n\tif r.Conversations != nil {\n\t\tr.Socket, e = socket.NewWithPolicy(r.Identity, message.SocketCommands{History: r.History}, r.Conversations)\n\t} else {\n\t\tr.Socket, e = socket.New(r.Identity, message.SocketCommands{History: r.History})\n\t}\n\treturn e\n}\n","chat/internal/message/digests.go":"package message\n\nimport (\n \"context\"\n \"errors\"\n \"crypto/aes\"\n \"crypto/cipher\"\n \"crypto/rand\"\n \"crypto/sha256\"\n \"encoding/base64\"\n \"encoding/json\"\n \"strconv\"\n  \"time\"\n\n \"github.com/franz-9527/workers/chat/internal/policy\"\n \"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype ConversationDigest struct {\n ConversationID ports.ID `json:\"conversation_id\"`\n Unread UnreadWindow `json:\"unread\"`\n}\ntype DigestPage struct {\n BadgeCount *uint64 `json:\"badge_count,omitempty\"` // C only, emitted after the complete server scan\n PreferenceRevision ports.ID `json:\"preference_revision\"`\n Items []ConversationDigest `json:\"items\"`\n NextAfter ports.ID `json:\"-\"` // internal resume key; no unauthorized candidate IDs on the wire\n NextCursor string `json:\"next_cursor,omitempty\"`\n HasMore bool `json:\"has_more\"`\n}\ntype digestCursor struct {\n Version int `json:\"v\"`\n Attention uint64 `json:\"attention\"`\n PreferenceRevision ports.ID `json:\"preference_revision\"`\n Binding string `json:\"binding\"`\n After ports.ID `json:\"after\"`\n Upper ports.ID `json:\"upper\"`\n Expires int64 `json:\"expires\"`\n}\n\n// Account cursors are authenticated AND encrypted: an otherwise valid member\n// projection is only a candidate, so even its upper conversation ID is private.\nfunc(s *HistoryService) digestAEAD() (cipher.AEAD,error){\n h:=sha256.New()\n h.Write([]byte(\"chat/digests/aes256gcm/v1\"))\n h.Write(s.key)\n key:=h.Sum(nil)\n block,e:=aes.NewCipher(key)\n if e!=nil{return nil,e}\n return cipher.NewGCM(block)\n}\nfunc (s *HistoryService) encodeDigestCursor(c digestCursor) (string,error) {\n raw,e:=json.Marshal(c);if e!=nil{return \"\",ports.ErrUnavailable}\n aead,e:=s.digestAEAD();if e!=nil{return \"\",ports.ErrUnavailable}\n nonce:=make([]byte,aead.NonceSize())\n if _,e=rand.Read(nonce);e!=nil{return \"\",ports.ErrUnavailable}\n sealed:=aead.Seal(nil,nonce,raw,[]byte(\"chat/digests/v1\"))\n return base64.RawURLEncoding.EncodeToString(append(nonce,sealed...)),nil\n}\nfunc (s *HistoryService) decodeDigestCursor(token string,p ports.Principal)(digestCursor,error){\n var c digestCursor\n if len(token)>1024{return c,ErrResync}\n payload,e:=base64.RawURLEncoding.Strict().DecodeString(token)\n if e!=nil{return c,ErrResync}\n aead,e:=s.digestAEAD();if e!=nil{return c,ports.ErrUnavailable}\n if len(payload)<aead.NonceSize()+aead.Overhead(){return c,ErrResync}\n raw,e:=aead.Open(nil,payload[:aead.NonceSize()],payload[aead.NonceSize():],[]byte(\"chat/digests/v1\"))\n if e!=nil{return c,ErrResync}\n if json.Unmarshal(raw,&c)!=nil||c.Version!=2||!c.PreferenceRevision.Valid()||c.Binding!=bindingFor(s.environment,p)||!c.After.Valid()||!c.Upper.Valid()||number(c.After)>number(c.Upper)||c.Expires<=time.Now().Unix()||c.Expires>time.Now().Add(cursorTTL).Unix()+5{return digestCursor{},ErrResync}\n return c,nil\n}\nfunc (s *HistoryService) Digests(ctx context.Context,p ports.Principal,after ports.ID,limit int)(DigestPage,error){\n if !after.Valid()||after!=\"0\"{return DigestPage{},ports.ErrInvalid}\n return s.DigestsCursor(ctx,p,\"\",limit)\n}\n// DigestsCursor fixes the account candidate upper ID across pages and signs\n// progression for the authenticated session. Reauthorization remains live.\nfunc (s *HistoryService) DigestsCursor(ctx context.Context,p ports.Principal,token string,limit int)(DigestPage,error){\n if !p.ActorID.Valid()||p.Environment!=s.environment||limit<1||limit>20{return DigestPage{},ports.ErrInvalid}\n if !time.Now().Before(p.ExpiresAt){return DigestPage{},policy.ErrDenied}\n ctx,cancel:=context.WithTimeout(ctx,3*s.timeout);defer cancel()\n if err:=s.conversations.ValidatePrincipal(ctx,p);err!=nil{return DigestPage{},err}\n revision,err:=accountRevision(ctx,s.db,p.ActorID);if err!=nil{return DigestPage{},err}\n var c digestCursor\n if token!=\"\"{\n  var e error;c,e=s.decodeDigestCursor(token,p);if e!=nil{return DigestPage{},e};if c.PreferenceRevision!=revision{return DigestPage{},ErrResync}\n }else{\n  var upper uint64\n  if e:=s.db.QueryRowContext(ctx,`SELECT COALESCE(MAX(conversation_id),0) FROM chat_members WHERE actor_id=? AND can_read=1`,string(p.ActorID)).Scan(&upper);e!=nil{return DigestPage{},ports.ErrUnavailable}\n  c=digestCursor{Version:2,PreferenceRevision:revision,Binding:bindingFor(s.environment,p),After:\"0\",Upper:ports.ID(strconv.FormatUint(upper,10)),Expires:time.Now().Add(cursorTTL).Unix()}\n }\n page:=DigestPage{PreferenceRevision:revision,Items:[]ConversationDigest{},NextAfter:c.After}\n const maxCandidates=100\n rows,e:=s.db.QueryContext(ctx,`SELECT CAST(conversation_id AS CHAR) FROM chat_members WHERE actor_id=? AND can_read=1 AND conversation_id>? AND conversation_id<=? ORDER BY conversation_id LIMIT ?`,string(p.ActorID),string(c.After),string(c.Upper),maxCandidates+1)\n if e!=nil{return DigestPage{},ports.ErrUnavailable}\n ids:=make([]ports.ID,0,maxCandidates+1)\n for rows.Next(){var id ports.ID;if rows.Scan(&id)!=nil||!validID(id){rows.Close();return DigestPage{},ports.ErrUnavailable};ids=append(ids,id)}\n e=rows.Err();rows.Close();if e!=nil{return DigestPage{},ports.ErrUnavailable}\n for i,id:=range ids{\n  if len(page.Items)==limit||i==maxCandidates{page.HasMore=true;break}\n  page.NextAfter=id\n  u,err:=s.Unread(ctx,p,id)\n  if err != nil {\n   // Only loss of this conversation's current membership may be skipped.\n   // Revoked login, identity mismatch, policy errors, SQL errors or timeout\n   // must fail the entire response rather than returning a partial snapshot.\n   if errors.Is(err, policy.ErrDenied) {\n    continue\n   }\n   return DigestPage{}, err\n  }\n  u.Preferences.AccountRevision=revision\n  if u.Count>0 || u.Preferences!=nil && u.Preferences.Later { c.Attention++ }\n  page.Items=append(page.Items,ConversationDigest{ConversationID:id,Unread:u})\n }\n if !page.HasMore { total:=c.Attention;page.BadgeCount=&total }\n if page.HasMore{\n  c.After=page.NextAfter\n  next,e:=s.encodeDigestCursor(c)\n  if e!=nil{return DigestPage{},e}\n  page.NextCursor=next\n }\n // Recheck at the response boundary, including empty/fully-filtered pages.\n // A logout that committed while scanning is not a successful empty list.\n if err:=s.conversations.ValidatePrincipal(ctx,p);err!=nil{return DigestPage{},err}\n latest,err:=accountRevision(ctx,s.db,p.ActorID);if err!=nil{return DigestPage{},err};if latest!=revision{return DigestPage{},ErrResync}\n if !time.Now().Before(p.ExpiresAt){return DigestPage{},policy.ErrDenied}\n return page,nil\n}","chat/internal/message/history.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// HistoryService is shared by HTTP and future WSS. All reads are bounded and\n// hold current authority and the same conversation commit lock as publication.\ntype HistoryService struct {\n\tdb            *sql.DB\n\tconversations *conversation.Store\n\tenvironment   string\n\tkey           []byte\n\ttimeout       time.Duration\n}\n\nfunc NewHistoryService(db *sql.DB, c *conversation.Store, env string, key []byte, timeout time.Duration) (*HistoryService, error) {\n\tif db == nil || c == nil || len(key) != 32 || (env != \"test\" && env != \"development\" && env != \"production\") || timeout < 100*time.Millisecond || timeout > 3*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &HistoryService{db, c, env, append([]byte(nil), key...), timeout}, nil\n}\n\ntype HistoryRequest struct {\n\tConversationID ports.ID `json:\"conversation_id\"`\n\tCursor         string   `json:\"cursor,omitempty\"`\n\tTargetID       ports.ID `json:\"message_id,omitempty\"`\n\tLimit          int      `json:\"limit,omitempty\"`\n}\ntype MessageView struct {\n ImageCount int `json:\"image_count,omitempty\"`\n Images []ImageView `json:\"images,omitempty\"`\n ReplyItem ports.ID `json:\"-\"`\n\tID            ports.ID  `json:\"message_id\"`\n\tSeq           ports.ID  `json:\"seq\"`\n\tSenderID      ports.ID  `json:\"sender_id\"`\n\tPolicyVersion ports.ID  `json:\"policy_version\"`\n\tType          string    `json:\"message_type\"`\n\tState         string    `json:\"state\"`\n\tStateVersion  ports.ID  `json:\"state_version\"`\n\tText          *string   `json:\"text,omitempty\"`\n\tCreatedAt     time.Time `json:\"created_at\"`\n    ReplyTo ports.ID `json:\"-\"`\n    EditedFrom ports.ID `json:\"-\"`\n    Reply *ReferenceView `json:\"reply,omitempty\"`\n    EditedSource *ReferenceView `json:\"edited_from,omitempty\"`\n}\ntype ChangeView struct {\n\tSeq     ports.ID    `json:\"change_seq\"`\n\tType    string      `json:\"change_type\"`\n\tMessage MessageView `json:\"message\"`\n}\ntype HistoryPage struct {\n OrderContext *ports.OrderContext `json:\"order_context,omitempty\"`\n MemberRole string `json:\"member_role\"`\n CanSend bool `json:\"can_send\"`\n ViewerID ports.ID `json:\"viewer_actor_id,omitempty\"`\n\tMessages          []MessageView `json:\"messages\"`\n\tChanges           []ChangeView  `json:\"changes\"`\n\tPolicyVersion     ports.ID      `json:\"policy_version\"`\n\tSnapshotMaxSeq    ports.ID      `json:\"snapshot_max_seq\"`\n\tSnapshotMaxChange ports.ID      `json:\"snapshot_max_change_seq\"`\n\tNextSync          ports.ID      `json:\"next_sync_cursor,omitempty\"`\n\tNextChange        ports.ID      `json:\"next_change_cursor,omitempty\"`\n\tSyncCursor        string        `json:\"sync_cursor,omitempty\"`\n\tChangeCursor      string        `json:\"change_cursor,omitempty\"`\n\tHistoryCursor     string        `json:\"history_cursor,omitempty\"`\n\tHasMore           bool          `json:\"has_more\"`\n\tExpiresAt         int64         `json:\"expires_at\"`\n}\ntype historyRead struct {\n\tactor ports.ID\n\ttx                                 *sql.Tx\n\tgrant                              ports.Grant\n\tcursor                             historyCursor\n\tseq, change, floorSeq, floorChange uint64\n}\n\nfunc (s *HistoryService) open(ctx context.Context, p ports.Principal, q HistoryRequest, mode string) (*historyRead, error) {\n\tif !validID(q.ConversationID) || p.Environment != s.environment || q.Limit < 0 || q.Limit > 50 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tvar c historyCursor\n\tvar e error\n\tif mode != \"bootstrap\" && mode != \"locate\" {\n\t\tc, e = s.parse(q.Cursor, mode)\n\t\tif e != nil {\n\t\t\treturn nil, e\n\t\t}\n\t\tif c.Binding != bindingFor(s.environment, p) || c.Conversation != q.ConversationID {\n\t\t\treturn nil, ErrResync\n\t\t}\n\t} else if q.Cursor != \"\" {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tfail := func(e error) (*historyRead, error) { tx.Rollback(); return nil, e }\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: q.ConversationID, Action: \"read\"})\n\tif e != nil {\n\t\treturn fail(e)\n\t}\n\tr := &historyRead{tx: tx, grant: g, actor:p.ActorID}\n\tif e = tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq,sync_floor_seq,change_floor_seq FROM chat_conversations WHERE id=?`, string(q.ConversationID)).Scan(&r.seq, &r.change, &r.floorSeq, &r.floorChange); e != nil {\n\t\treturn fail(ports.ErrUnavailable)\n\t}\n\tif r.floorSeq > r.seq || r.floorChange > r.change {\n\t\treturn fail(ports.ErrUnavailable)\n\t}\n\tif mode == \"bootstrap\" || mode == \"locate\" {\n\t\tnow := time.Now().Unix()\n\t\tc = historyCursor{Schema: 1, Binding: bindingFor(s.environment, p), Conversation: q.ConversationID, Policy: g.Version, Member: g.MemberKey, Seq: decimal(r.seq), Change: decimal(r.change), Issued: now, Expiry: now + int64(cursorTTL/time.Second)}\n\t} else {\n\t\tif c.Policy != g.Version || c.Member != g.MemberKey || number(c.Seq) > r.seq || number(c.Change) > r.change {\n\t\t\treturn fail(ErrResync)\n\t\t}\n\t\tupper := number(c.Seq)\n\t\tfloor := r.floorSeq\n\t\tif mode == \"changes\" {\n\t\t\tupper = number(c.Change)\n\t\t\tfloor = r.floorChange\n\t\t}\n\t\tif number(c.Position) > upper || number(c.Position) < floor {\n\t\t\treturn fail(ErrResync)\n\t\t}\n\t\tif mode != \"history\" && !c.Pending {\n\t\t\tc.Seq = decimal(r.seq)\n\t\t\tc.Change = decimal(r.change)\n\t\t\tc.Issued = time.Now().Unix()\n\t\t\tc.Expiry = c.Issued + int64(cursorTTL/time.Second)\n\t\t}\n\t}\n\tr.cursor = c\n\treturn r, nil\n}\nfunc emptyPage(r *historyRead) HistoryPage {\n\treturn HistoryPage{OrderContext:r.grant.OrderContext,MemberRole:r.grant.MemberRole,CanSend:r.grant.CanSend,ViewerID:r.actor,Messages: []MessageView{}, Changes: []ChangeView{}, PolicyVersion: r.grant.Version, SnapshotMaxSeq: r.cursor.Seq, SnapshotMaxChange: r.cursor.Change, ExpiresAt: r.cursor.Expiry}\n}\n\n// Projection is safe in SQL too: hidden bodies never cross the DB boundary.\nconst viewColumns = `CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),CAST(m.policy_version AS CHAR),m.message_type,m.state,CAST(m.state_version AS CHAR),CASE WHEN m.state='published' AND m.message_type='text' THEN m.text_body ELSE NULL END,m.created_at,CAST(m.reply_to_message_id AS CHAR),CAST(m.edited_from_recalled_message_id AS CHAR),CAST(m.reply_to_item_id AS CHAR)`\nconst visibleColumn = `(m.policy_version<=? AND EXISTS(SELECT 1 FROM chat_member_intervals i WHERE i.conversation_id=m.conversation_id AND i.actor_id=? AND i.start_version<=m.policy_version AND (i.end_version IS NULL OR i.end_version>m.policy_version)))`\n\ntype candidate struct {\n\tview    MessageView\n\tvisible bool\n\tchange  ports.ID\n\tkind    string\n}\n\nfunc scanCandidate(rows *sql.Rows, changes bool) (candidate, error) {\n\tvar c candidate\n\tvar text, reply, edited, replyItem sql.NullString\n\targs := []any{&c.view.ID, &c.view.Seq, &c.view.SenderID, &c.view.PolicyVersion, &c.view.Type, &c.view.State, &c.view.StateVersion, &text, &c.view.CreatedAt,&reply,&edited,&replyItem, &c.visible}\n\tif changes {\n\t\targs = append(args, &c.change, &c.kind)\n\t}\n\tif rows.Scan(args...) != nil || !validID(c.view.ID) || !validID(c.view.Seq) || !validID(c.view.StateVersion) {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\tif replyItem.Valid{c.view.ReplyItem=ports.ID(replyItem.String)}\n if reply.Valid {c.view.ReplyTo=ports.ID(reply.String)}\n    if edited.Valid {c.view.EditedFrom=ports.ID(edited.String)}\n\tif c.view.State == \"published\" && c.view.Type == \"text\" && text.Valid {\n\t\tv := text.String\n\t\tc.view.Text = &v\n\t} else if c.view.State==\"published\"&&(c.view.Type==\"image\"||c.view.Type==\"image_album\") {c.view.Text=nil\n } else {\n\t\tc.view.Text = nil\n\t\tif c.view.State != \"recalled\" && c.view.State != \"blocked\" {\n\t\t\tc.view.State = \"unavailable\"\n\t\t}\n\t}\n\treturn c, nil\n}\nfunc limitFor(q HistoryRequest) int {\n\tif q.Limit == 0 {\n\t\treturn 30\n\t}\n\treturn q.Limit\n}\nfunc (s *HistoryService) finish(ctx context.Context,p ports.Principal, r *historyRead, page HistoryPage) (HistoryPage, error) {\n\tviews:=make([]*MessageView,0,len(page.Messages)+len(page.Changes))\n    for i:=range page.Messages{views=append(views,&page.Messages[i])}\n    for i:=range page.Changes{views=append(views,&page.Changes[i].Message)}\n    if err:=hydrateImages(ctx,r.tx,views);err!=nil{return HistoryPage{},err}\n if err:=hydrateReferences(ctx,r.tx,p,r.grant,r.cursor.Conversation,views);err!=nil{return HistoryPage{},err}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn HistoryPage{}, policy.ErrDenied\n\t}\n\tif r.tx.Commit() != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\treturn page, nil\n}\nfunc (s *HistoryService) Read(ctx context.Context, p ports.Principal, q HistoryRequest, mode string) (HistoryPage, error) {\n\tif mode != \"bootstrap\" && mode != \"history\" && mode != \"sync\" && mode != \"changes\" && mode != \"locate\" {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tif mode == \"locate\" {\n\t\treturn s.locate(ctx, p, q)\n\t}\n\tif q.TargetID != \"\" {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tr, e := s.open(ctx, p, q, mode)\n\tif e != nil {\n\t\treturn HistoryPage{}, e\n\t}\n\tdefer r.tx.Rollback()\n\tpage := emptyPage(r)\n\tc := r.cursor\n\tlimit := limitFor(q)\n\tposition := number(c.Position)\n\tupper := number(c.Seq)\n\tfloor := r.floorSeq\n\tdescending := mode == \"bootstrap\" || mode == \"history\"\n\tchanges := mode == \"changes\"\n\tif mode == \"bootstrap\" {\n\t\tposition = upper\n\t}\n\tif changes {\n\t\tupper = number(c.Change)\n\t\tfloor = r.floorChange\n\t}\n\ttable := `chat_messages m`\n\tindex := `m.seq`\n\textra := ``\n\tif changes {\n\t\ttable = `chat_message_changes ch STRAIGHT_JOIN chat_messages m ON m.id=ch.message_id AND m.conversation_id=ch.conversation_id`\n\t\tindex = `ch.change_seq`\n\t\textra = `,CAST(ch.change_seq AS CHAR),ch.change_type`\n\t}\n\tpredicate := index + `>? AND ` + index + `<=?`\n\tstart, end := position, upper\n\torder := ` ASC`\n\tif descending {\n\t\tpredicate = index + `>? AND ` + index + `<=?`\n\t\tstart, end = floor, position\n\t\torder = ` DESC`\n\t}\n\tscopeColumn := \"m.conversation_id\"\n\tif changes {\n\t\tscopeColumn = \"ch.conversation_id\"\n\t}\n\tquery := `SELECT ` + viewColumns + `,` + visibleColumn + extra + ` FROM ` + table + ` WHERE ` + scopeColumn + `=? AND ` + predicate + ` ORDER BY ` + index + order + ` LIMIT ?`\n\trows, e := r.tx.QueryContext(ctx, query, string(r.grant.Version), string(p.ActorID), string(q.ConversationID), start, end, limit+1)\n\tif e != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tcandidates := make([]candidate, 0, limit+1)\n\tfor rows.Next() {\n\t\tv, err := scanCandidate(rows, changes)\n\t\tif err != nil {\n\t\t\trows.Close()\n\t\t\treturn HistoryPage{}, err\n\t\t}\n\t\tcandidates = append(candidates, v)\n\t}\n\te = rows.Err()\n\trows.Close()\n\tif e != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tpage.HasMore = len(candidates) > limit\n\tif page.HasMore {\n\t\tcandidates = candidates[:limit]\n\t}\n\tnext := upper\n\tif descending {\n\t\tnext = floor\n\t}\n\tif len(candidates) > 0 && (page.HasMore || descending) {\n\t\tlast := candidates[len(candidates)-1]\n\t\tnext = number(last.view.Seq)\n\t\tif changes {\n\t\t\tnext = number(last.change)\n\t\t}\n\t\tif descending {\n\t\t\tnext--\n\t\t}\n\t}\n\tfor _, v := range candidates {\n\t\tif !v.visible {\n\t\t\tcontinue\n\t\t}\n\t\tif changes {\n\t\t\tpage.Changes = append(page.Changes, ChangeView{v.change, v.kind, v.view})\n\t\t} else {\n\t\t\tpage.Messages = append(page.Messages, v.view)\n\t\t}\n\t}\n\tif descending {\n\t\tfor i, j := 0, len(page.Messages)-1; i < j; i, j = i+1, j-1 {\n\t\t\tpage.Messages[i], page.Messages[j] = page.Messages[j], page.Messages[i]\n\t\t}\n\t\th := c\n\t\th.Mode = \"history\"\n\t\th.Position = decimal(next)\n\t\th.Pending = true\n\t\tif page.HasMore {\n\t\t\tpage.HistoryCursor = s.sign(h)\n\t\t}\n\t\tif mode == \"bootstrap\" {\n\t\t\tpage.NextSync = c.Seq\n\t\t\tpage.NextChange = c.Change\n\t\t\tsc := c\n\t\t\tsc.Mode = \"sync\"\n\t\t\tsc.Position = c.Seq\n\t\t\tsc.Pending = false\n\t\t\tpage.SyncCursor = s.sign(sc)\n\t\t\tsc.Mode = \"changes\"\n\t\t\tsc.Position = c.Change\n\t\t\tpage.ChangeCursor = s.sign(sc)\n\t\t} else {\n\t\t\tpage.NextSync = \"\"\n\t\t\tpage.NextChange = \"\"\n\t\t}\n\t} else {\n\t\tc.Mode = mode\n\t\tc.Position = decimal(next)\n\t\tc.Pending = page.HasMore\n\t\tif changes {\n\t\t\tpage.NextChange = c.Position\n\t\t\tpage.ChangeCursor = s.sign(c)\n\t\t} else {\n\t\t\tpage.NextSync = c.Position\n\t\t\tpage.SyncCursor = s.sign(c)\n\t\t}\n\t}\n\treturn s.finish(ctx,p, r, page)\n}\n","chat/internal/message/history_cursor.go":"package message\n\nimport (\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"os\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrResync = errors.New(\"CHAT_RESYNC_REQUIRED\")\n\nconst cursorTTL = 10 * time.Minute\n\ntype HistoryConfig struct {\n\tEnabled      bool   `json:\"enabled\"`\n\tCursorKeyEnv string `json:\"cursor_key_env\"`\n}\n\nvar cursorEnv = regexp.MustCompile(`^CHAT_[A-Z0-9_]{1,58}$`)\n\nfunc (c HistoryConfig) Key() ([]byte, error) {\n\tif !c.Enabled {\n\t\tif c.CursorKeyEnv != \"\" {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\treturn nil, nil\n\t}\n\tif !cursorEnv.MatchString(c.CursorKeyEnv) {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tkey, e := hex.DecodeString(os.Getenv(c.CursorKeyEnv))\n\tif e != nil || len(key) != 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn key, nil\n}\n\ntype historyCursor struct {\n\tSchema       int      `json:\"v\"`\n\tMode         string   `json:\"mode\"`\n\tBinding      string   `json:\"binding\"`\n\tConversation ports.ID `json:\"conversation\"`\n\tPolicy       ports.ID `json:\"policy\"`\n\tMember       string   `json:\"member\"`\n\tSeq          ports.ID `json:\"seq\"`\n\tChange       ports.ID `json:\"change\"`\n\tPosition     ports.ID `json:\"position\"`\n\tPending      bool     `json:\"pending\"`\n\tIssued       int64    `json:\"issued\"`\n\tExpiry       int64    `json:\"expiry\"`\n}\n\nfunc bindingFor(env string, p ports.Principal) string {\n\tsum := sha256.Sum256([]byte(strings.Join([]string{env, string(p.ActorID), p.Kind, string(p.SourceID), p.SessionID, p.SessionVersion}, \"\\n\")))\n\treturn hex.EncodeToString(sum[:])\n}\nfunc number(id ports.ID) uint64 { n, _ := strconv.ParseUint(string(id), 10, 64); return n }\nfunc decimal(n uint64) ports.ID { return ports.ID(strconv.FormatUint(n, 10)) }\nfunc (s *HistoryService) sign(c historyCursor) string {\n\tbody, _ := json.Marshal(c)\n\tmac := hmac.New(sha256.New, s.key)\n\tmac.Write(body)\n\treturn base64.RawURLEncoding.EncodeToString(body) + \".\" + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))\n}\nfunc (s *HistoryService) parse(token, mode string) (historyCursor, error) {\n\tvar c historyCursor\n\tif len(token) > 2048 {\n\t\treturn c, ErrResync\n\t}\n\tparts := strings.Split(token, \".\")\n\tif len(parts) != 2 {\n\t\treturn c, ErrResync\n\t}\n\tbody, e := base64.RawURLEncoding.Strict().DecodeString(parts[0])\n\tif e != nil {\n\t\treturn c, ErrResync\n\t}\n\tsignature, e := base64.RawURLEncoding.Strict().DecodeString(parts[1])\n\tif e != nil {\n\t\treturn c, ErrResync\n\t}\n\tmac := hmac.New(sha256.New, s.key)\n\tmac.Write(body)\n\tif !hmac.Equal(signature, mac.Sum(nil)) {\n\t\treturn c, ErrResync\n\t}\n\tif json.Unmarshal(body, &c) != nil || c.Schema != 1 || c.Mode != mode || !validID(c.Conversation) || !validID(c.Policy) || !c.Seq.Valid() || !c.Change.Valid() || !c.Position.Valid() || c.Member == \"\" || c.Expiry-c.Issued != int64(cursorTTL/time.Second) || c.Issued > time.Now().Unix()+5 || c.Expiry <= time.Now().Unix() {\n\t\treturn c, ErrResync\n\t}\n\treturn c, nil\n}\n","chat/internal/message/history_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype HistoryHandler struct {\n\tservice  *HistoryService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewHistoryHandler(s *HistoryService, identity ports.Identity, concurrency int) (*HistoryHandler, error) {\n\tif s == nil || identity == nil || concurrency < 1 || concurrency > 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &HistoryHandler{s, identity, make(chan struct{}, concurrency)}, nil\n}\nfunc historyMode(path string) string {\n\tswitch path {\n\tcase \"/chat/api/v1/conversations/bootstrap\":\n\t\treturn \"bootstrap\"\n\tcase \"/chat/api/v1/messages/history\":\n\t\treturn \"history\"\n\tcase \"/chat/api/v1/messages/sync\":\n\t\treturn \"sync\"\n\tcase \"/chat/api/v1/messages/changes\":\n\t\treturn \"changes\"\n\tcase \"/chat/api/v1/messages/locate\":\n\t\treturn \"locate\"\n\t}\n\treturn \"\"\n}\nfunc decodeHistory(body []byte) (HistoryRequest, error) {\n\tvar q HistoryRequest\n\tif !utf8.Valid(body) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(body))\n\tt, e := d.Token()\n\tif e != nil || t != json.Delim('{') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tt, e = d.Token()\n\t\tk, ok := t.(string)\n\t\tif e != nil || !ok || seen[k] {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tseen[k] = true\n\t\tvar raw json.RawMessage\n\t\tif d.Decode(&raw) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tif k == \"limit\" {\n\t\t\tif len(raw) == 0 || raw[0] < '0' || raw[0] > '9' || json.Unmarshal(raw, &q.Limit) != nil || q.Limit < 1 || q.Limit > 50 {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tvar v string\n\t\tif len(raw) < 2 || raw[0] != '\"' || !validSurrogates(raw) || json.Unmarshal(raw, &v) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tswitch k {\n\t\tcase \"conversation_id\":\n\t\t\tq.ConversationID = ports.ID(v)\n\t\tcase \"cursor\":\n\t\t\tq.Cursor = v\n\t\tcase \"message_id\":\n\t\t\tq.TargetID = ports.ID(v)\n\t\tdefault:\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\tt, e = d.Token()\n\tif e != nil || t != json.Delim('}') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif _, e = d.Token(); e != io.EOF || !validID(q.ConversationID) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\nfunc (h *HistoryHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tvar nonce [16]byte\n\trand.Read(nonce[:])\n\tid := hex.EncodeToString(nonce[:])\n\tw.Header().Set(\"X-Request-ID\", id)\n\tfail := func(status int, code string, retry bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\tjson.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"retryable\": retry, \"server_time\": time.Now().UTC()})\n\t\t}\n\t}\n\tmode := historyMode(r.URL.Path)\n    if r.URL.Path==\"/chat/api/v1/conversations/unread\" || r.URL.Path==\"/chat/api/v1/conversations/read\" || r.URL.Path==\"/chat/api/v1/conversations/digests\" || r.URL.Path==\"/chat/api/v1/conversations/preferences\" || r.URL.Path==\"/chat/api/v1/conversations/preference\" { h.serveS09(w,r);return }\n\tif mode == \"\" {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", false)\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tcontent, _, e := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif e != nil || content != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error(), true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), h.service.timeout)\n\tdefer cancel()\n\tcontroller := http.NewResponseController(w)\n\tcontroller.SetReadDeadline(time.Now().Add(h.service.timeout))\n\tbody, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 4096))\n\tif e != nil {\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar large *http.MaxBytesError\n\t\tif errors.As(e, &large) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", true)\n\t\t}\n\t\treturn\n\t}\n\tcontroller.SetReadDeadline(time.Time{})\n\tq, e := decodeHistory(body)\n\tif e != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tp, e := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif e != nil {\n\t\tif errors.Is(e, auth.ErrUnauthorized) {\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\t} else {\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\tpage, e := h.service.Read(ctx, p, q, mode)\n\tif e != nil {\n\t\tswitch {\n\t\tcase errors.Is(e, ports.ErrInvalid):\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\tcase errors.Is(e, ErrResync):\n\t\t\tfail(409, ErrResync.Error(), false)\n\t\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\t\tfail(403, \"CHAT_PERMISSION_DENIED\", false)\n\t\tdefault:\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": \"OK\", \"data\": page, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/history_http_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype historyFixtureIdentity struct{}\n\nfunc (historyFixtureIdentity) Authenticate(ctx context.Context, token string) (ports.Principal, error) {\n\tif token != \"fixture-only\" {\n\t\treturn ports.Principal{}, auth.ErrUnauthorized\n\t}\n\treturn principal(\"10202\"), nil\n}\nfunc TestMySQLS08HTTPReadBoundary(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 31)\n\thandler, e := NewHistoryHandler(h, historyFixtureIdentity{}, 4)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tserver := httptest.NewServer(handler)\n\tdefer server.Close()\n\tcall := func(path, body, credential string, status int) []byte {\n\t\tt.Helper()\n\t\treq, _ := http.NewRequest(\"POST\", server.URL+path, strings.NewReader(body))\n\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n\t\tif credential != \"\" {\n\t\t\treq.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\t\t}\n\t\tres, e := server.Client().Do(req)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer res.Body.Close()\n\t\traw, _ := io.ReadAll(res.Body)\n\t\tif res.StatusCode != status {\n\t\t\tt.Fatalf(\"HTTP %d want %d: %s\", res.StatusCode, status, raw)\n\t\t}\n\t\tif res.Header.Get(\"Cache-Control\") != \"no-store\" || res.Header.Get(\"X-Request-ID\") == \"\" {\n\t\t\tt.Fatal(\"privacy headers\")\n\t\t}\n\t\treturn raw\n\t}\n\tbody := `{\"conversation_id\":\"` + string(r.ConversationID) + `\"}`\n\tcall(\"/chat/api/v1/conversations/bootstrap\", body, \"\", 401)\n\tcall(\"/chat/api/v1/conversations/bootstrap\", body, \"bad\", 401)\n\traw := call(\"/chat/api/v1/conversations/bootstrap\", body, \"fixture-only\", 200)\n\tvar out struct {\n\t\tData HistoryPage `json:\"data\"`\n\t}\n\tif json.Unmarshal(raw, &out) != nil || len(out.Data.Messages) != 30 {\n\t\tt.Fatal(\"bootstrap HTTP\")\n\t}\n\tcall(\"/chat/api/v1/messages/history\", `{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"`+out.Data.HistoryCursor+`\"}`, \"fixture-only\", 200)\n\tcall(\"/chat/api/v1/messages/sync\", `{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"invalid\"}`, \"fixture-only\", 409)\n\tcall(\"/chat/api/v1/messages/sync\", `{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"after_seq\":\"103\"}`, \"fixture-only\", 400)\n\tcall(\"/chat/api/v1/conversations/bootstrap?actor=10203\", body, \"fixture-only\", 400)\n\tcall(\"/chat/api/v1/conversations/bootstrap\", strings.Repeat(\"a\", 4097), \"fixture-only\", 413)\n\tf.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n\tcall(\"/chat/api/v1/conversations/bootstrap\", body, \"fixture-only\", 403)\n}\n","chat/internal/message/history_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc historyFixture(t *testing.T, n int) (*fixtureDB, *Service, *HistoryService, Request) {\n\tt.Helper()\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\th, e := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"s\", 32)), 3*time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif n > 0 {\n\t\tdigits := `(SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9)`\n\t\tfrom := []string{}\n\t\tterms := []string{}\n\t\tscale := 1\n\t\tfor i := 0; i < 5; i++ {\n\t\t\tfrom = append(from, fmt.Sprintf(\"%s d%d\", digits, i))\n\t\t\tterms = append(terms, fmt.Sprintf(\"d%d.n*%d\", i, scale))\n\t\t\tscale *= 10\n\t\t}\n\t\tgenerator := `(SELECT ` + strings.Join(terms, \"+\") + `+1 seq FROM ` + strings.Join(from, \" CROSS JOIN \") + `) nums`\n\t\tf.exec(`INSERT INTO chat_messages(conversation_id,seq,sender_id,client_message_id,policy_version,message_type,text_body,state,state_version,safety_rule_version,created_at) SELECT ?,seq,10202,CONCAT('1700000000.',LPAD(seq,32,'0')),1,'text',CONCAT('fixture-',seq),'published',1,'s08-fixture',UTC_TIMESTAMP(6) FROM `+generator+` WHERE seq<=? ORDER BY seq`, string(q.ConversationID), n)\n\t\tf.exec(`INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT conversation_id,seq,id,1,'message.accepted',UTC_TIMESTAMP(6) FROM chat_messages WHERE conversation_id=?`, string(q.ConversationID))\n\t\tf.exec(`UPDATE chat_conversations SET last_seq=?,last_change_seq=? WHERE id=?`, n, n, string(q.ConversationID))\n\t}\n\treturn f, s, h, q\n}\nfunc readPage(t *testing.T, h *HistoryService, q HistoryRequest, mode string) HistoryPage {\n\tt.Helper()\n\tp, e := h.Read(context.Background(), principal(\"10202\"), q, mode)\n\tif e != nil {\n\t\tt.Fatalf(\"read %s: %v\", mode, e)\n\t}\n\treturn p\n}\nfunc TestMySQLS08FixedSnapshotsGapsAndChanges(t *testing.T) {\n\tf, s, h, r := historyFixture(t, 100)\n\tq := HistoryRequest{ConversationID: r.ConversationID}\n\tboot := readPage(t, h, q, \"bootstrap\")\n\tif len(boot.Messages) != 30 || boot.Messages[0].Seq != \"71\" || boot.NextSync != \"100\" || boot.NextChange != \"100\" || boot.HistoryCursor == \"\" {\n\t\tt.Fatal(\"bootstrap\", boot)\n\t}\n\tfor i := 1; i <= 3; i++ {\n\t\tr.ClientMessageID = client(i)\n\t\taccepted(t, s, r)\n\t} // A real-time observer may see 103 first; the signed confirmed cursor remains 100.\n\tq.Cursor = boot.SyncCursor\n\tq.Limit = 1\n\tp := readPage(t, h, q, \"sync\")\n\tif p.NextChange != \"\" {\n\t\tt.Fatal(\"sync certified unconsumed changes\")\n\t}\n\tif p.NextSync != \"101\" || p.SnapshotMaxSeq != \"103\" || !p.HasMore {\n\t\tt.Fatal(\"skipped 101\", p)\n\t}\n\tr.ClientMessageID = client(4)\n\taccepted(t, s, r)\n\tfor _, seq := range []ports.ID{\"102\", \"103\"} {\n\t\tq.Cursor = p.SyncCursor\n\t\tp = readPage(t, h, q, \"sync\")\n\t\tif p.NextSync != seq || p.SnapshotMaxSeq != \"103\" {\n\t\t\tt.Fatal(\"snapshot moved\", p)\n\t\t}\n\t}\n\tif p.HasMore {\n\t\tt.Fatal(\"snapshot did not finish\")\n\t}\n\tq.Cursor = p.SyncCursor\n\tp = readPage(t, h, q, \"sync\")\n\tif p.NextSync != \"104\" || p.HasMore {\n\t\tt.Fatal(\"next round\", p)\n\t}\n\t// S15-style writer fixture: same commit lock and atomic state/change; no product recall API is enabled here.\n\ttx, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\tvar upper uint64\n\ttx.QueryRow(`SELECT last_change_seq FROM chat_conversations WHERE id=? FOR UPDATE`, string(r.ConversationID)).Scan(&upper)\n\tif _, e = tx.Exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=20`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = tx.Exec(`INSERT INTO chat_message_changes SELECT conversation_id,?,id,2,'message.recalled',UTC_TIMESTAMP(6) FROM chat_messages WHERE conversation_id=? AND seq=20`, upper+1, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\ttx.Exec(`UPDATE chat_conversations SET last_change_seq=? WHERE id=?`, upper+1, string(r.ConversationID))\n\tif tx.Commit() != nil {\n\t\tt.Fatal(\"recall commit\")\n\t}\n\tq.Cursor = boot.ChangeCursor\n\tq.Limit = 2\n\tvar changes []ChangeView\n\tfor i := 0; i < 4; i++ {\n\t\tp = readPage(t, h, q, \"changes\")\n\t\tchanges = append(changes, p.Changes...)\n\t\tq.Cursor = p.ChangeCursor\n\t\tif !p.HasMore {\n\t\t\tbreak\n\t\t}\n\t}\n\tif p.NextSync != \"\" {\n\t\tt.Fatal(\"change page certified messages\")\n\t}\n\tlast := changes[len(changes)-1]\n\tif len(changes) != 5 || last.Message.Seq != \"20\" || last.Message.Text != nil || last.Message.StateVersion != \"2\" || p.NextChange != \"105\" {\n\t\tt.Fatal(\"old-state recovery\", p)\n\t}\n\t// The old history snapshot re-reads safe current states, never original evidence.\n\tq.Cursor = boot.HistoryCursor\n\tq.Limit = 50\n\told := readPage(t, h, q, \"history\")\n\tif old.SyncCursor != \"\" || old.ChangeCursor != \"\" {\n\t\tt.Fatal(\"history replaced recovery cursors\")\n\t}\n\tfor _, m := range old.Messages {\n\t\tif m.Seq == \"20\" && (m.Text != nil || m.StateVersion != \"2\") {\n\t\t\tt.Fatal(\"old body resurrected\")\n\t\t}\n\t}\n\tq.Cursor = old.HistoryCursor\n\tolder := readPage(t, h, q, \"history\")\n\tseenRecall := false\n\tfor _, m := range older.Messages {\n\t\tif m.Seq == \"20\" {\n\t\t\tseenRecall = true\n\t\t\tif m.Text != nil || m.StateVersion != \"2\" {\n\t\t\t\tt.Fatal(\"historical body resurrected\")\n\t\t\t}\n\t\t}\n\t}\n\tif !seenRecall {\n\t\tt.Fatal(\"recall fixture not enumerated\")\n\t}\n\tq.Cursor = boot.SyncCursor\n\tif _, e := h.Read(f.ctx, principal(\"10203\"), q, \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"cross-actor cursor reused\", e)\n\t}\n\t// Closed ranges may contain a legal hole. Enumeration can certify the upper bound.\n\tf.exec(`UPDATE chat_conversations SET last_seq=106 WHERE id=?`, string(r.ConversationID))\n\tq.Cursor = p.ChangeCursor // deliberately a change cursor must be rejected by sync\n\tif _, e = h.Read(f.ctx, principal(\"10202\"), q, \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"stream reuse\", e)\n\t}\n\tq.Cursor = boot.SyncCursor\n\tq.Limit = 50\n\tp = readPage(t, h, q, \"sync\")\n\tif p.NextSync != \"106\" || p.HasMore || len(p.Messages) != 4 {\n\t\tt.Fatal(\"legal hole\", p)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM notifications\") != \"0\" {\n\t\tt.Fatal(\"read created notification\")\n\t}\n}\nfunc TestMySQLS08PermissionIntervalsLocateAndRetention(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 90)\n\tq := HistoryRequest{ConversationID: r.ConversationID}\n\tboot := readPage(t, h, q, \"bootstrap\")\n\tf.php(\"close\")\n\tf.store.Poll(f.ctx, 100)\n\tf.php(\"repair\")\n\tf.store.Poll(f.ctx, 100)\n\t// Returning identity has two legal ranges; version 2 is an explicit gap.\n\tf.exec(`DELETE FROM chat_member_intervals WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version,end_version) SELECT conversation_id,actor_id,member_key,1,2 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version) SELECT conversation_id,actor_id,member_key,3 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET policy_version=2 WHERE seq BETWEEN 40 AND 70 AND conversation_id=?`, string(r.ConversationID))\n\tq.Cursor = boot.SyncCursor\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"old policy cursor\", e)\n\t}\n\tq.Cursor = \"\"\n\tfresh := readPage(t, h, q, \"bootstrap\")\n\tfor _, m := range fresh.Messages {\n\t\tif m.PolicyVersion == \"2\" {\n\t\t\tt.Fatal(\"unauthorized gap\")\n\t\t}\n\t}\n\tq.Cursor = \"\"\n\tq.TargetID = ports.ID(f.text(`SELECT id FROM chat_messages WHERE conversation_id=? AND seq=55`, string(r.ConversationID)))\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"locate\"); e != policy.ErrDenied {\n\t\tt.Fatal(\"gap target\", e)\n\t}\n\tq.TargetID = ports.ID(f.text(`SELECT id FROM chat_messages WHERE conversation_id=? AND seq=30`, string(r.ConversationID)))\n\tlocated := readPage(t, h, q, \"locate\")\n\tif len(located.Messages) > 30 || located.SyncCursor != \"\" {\n\t\tt.Fatal(\"unbounded locate\")\n\t}\n\tq.TargetID = \"\"\n\tq.Cursor = fresh.HistoryCursor\n\tf.exec(`UPDATE chat_conversations SET sync_floor_seq=80 WHERE id=?`, string(r.ConversationID))\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"history\"); e != ErrResync {\n\t\tt.Fatal(\"retained floor\", e)\n\t}\n\tq.Cursor = fresh.ChangeCursor\n\tf.exec(`UPDATE chat_conversations SET change_floor_seq=90 WHERE id=?`, string(r.ConversationID))\n\tc, _ := h.parse(fresh.ChangeCursor, \"changes\")\n\tc.Position = \"89\"\n\tq.Cursor = h.sign(c)\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"changes\"); e != ErrResync {\n\t\tt.Fatal(\"change floor\", e)\n\t}\n\tq.Cursor = \"\"\n\tf.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n\tif _, e := h.Read(f.ctx, principal(\"10202\"), q, \"bootstrap\"); e == nil {\n\t\tt.Fatal(\"revoked login read\")\n\t}\n}\nfunc TestMySQLS08LargeHistoryAndCommitSerialization(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 100000)\n\tq := HistoryRequest{ConversationID: r.ConversationID, Limit: 50}\n\tp := readPage(t, h, q, \"bootstrap\")\n\tif len(p.Messages) != 50 || p.Messages[0].Seq != \"99951\" {\n\t\tt.Fatal(\"large bounded page\")\n\t}\n\tencoded, _ := json.Marshal(p)\n\tif len(encoded) > 100000 {\n\t\tt.Fatal(\"unbounded response\")\n\t}\n\t// A pending low-number change cannot fall behind a certified watermark.\n\ttx, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\ttx.Exec(`UPDATE chat_conversations SET last_change_seq=100001 WHERE id=?`, string(r.ConversationID))\n\tdone := make(chan error, 1)\n\tgo func() { _, e := h.Read(f.ctx, principal(\"10202\"), q, \"bootstrap\"); done <- e }()\n\tselect {\n\tcase e := <-done:\n\t\tt.Fatal(\"snapshot crossed pending commit\", e)\n\tcase <-time.After(100 * time.Millisecond):\n\t}\n\ttx.Rollback()\n\tif e = <-done; e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcommitting, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer committing.Rollback()\n\tif _, e = committing.Exec(`UPDATE chat_conversations SET last_change_seq=100001 WHERE id=?`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = committing.Exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=1`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = committing.Exec(`INSERT INTO chat_message_changes SELECT conversation_id,100001,id,2,'message.recalled',UTC_TIMESTAMP(6) FROM chat_messages WHERE conversation_id=? AND seq=1`, string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tresult := make(chan HistoryPage, 1)\n\tgo func() {\n\t\tpage, e := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: r.ConversationID, Cursor: p.ChangeCursor}, \"changes\")\n\t\tif e != nil {\n\t\t\tdone <- e\n\t\t\treturn\n\t\t}\n\t\tresult <- page\n\t}()\n\tselect {\n\tcase page := <-result:\n\t\tt.Fatal(\"change crossed uncommitted state\", page)\n\tcase e := <-done:\n\t\tt.Fatal(e)\n\tcase <-time.After(100 * time.Millisecond):\n\t}\n\tif e = committing.Commit(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tselect {\n\tcase page := <-result:\n\t\tif page.SnapshotMaxChange != \"100001\" || len(page.Changes) != 1 || page.Changes[0].Message.Text != nil || page.Changes[0].Message.StateVersion != \"2\" {\n\t\t\tt.Fatal(\"snapshot missed committed safety state\", page)\n\t\t}\n\tcase e := <-done:\n\t\tt.Fatal(e)\n\tcase <-time.After(4 * time.Second):\n\t\tt.Fatal(\"change reader did not resume\")\n\t}\n\t// Reads are allowed under a send-only ban, but never as a different actor.\n\tf.exec(`INSERT INTO chat_restrictions(actor_id,permanent,version,updated_at) VALUES(10202,1,1,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE permanent=1`)\n\treadPage(t, h, q, \"bootstrap\")\n\tif _, e = h.Read(f.ctx, principal(\"10201\"), q, \"bootstrap\"); e == nil {\n\t\tt.Fatal(\"outsider read\")\n\t}\n}\n\nfunc TestMySQLS15ReferencesRecallAndReedit(t *testing.T){\n f,s,h,q:=historyFixture(t,0)\n author:=principal(\"10202\");other:=principal(\"10203\")\n original:=accepted(t,s,q)\n q.ClientMessageID=client(1501);q.Text=\"回复内容\";q.ReplyTo=original.MessageID\n reply,e:=s.Send(f.ctx,other,q);if e!=nil||reply.State!=\"accepted\"{t.Fatal(reply,e)}\n page,e:=h.Read(f.ctx,other,HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\");if e!=nil{t.Fatal(e)}\n quoted:=page.Messages[1].Reply\n if quoted==nil||quoted.ID!=original.MessageID||quoted.Text==nil||quoted.State!=\"published\"{t.Fatal(\"missing safe quote\",quoted)}\n before,e:=h.Unread(f.ctx,other,q.ConversationID);if e!=nil||before.Count!=1{t.Fatal(before,e)}\n recalled,e:=s.Recall(f.ctx,author,q.ConversationID,original.MessageID);if e!=nil||recalled.State!=\"recalled\"||recalled.Text!=nil||recalled.StateVersion!=\"2\"{t.Fatal(recalled,e)}\n f.exec(\"UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 121 SECOND WHERE id=?\",string(original.MessageID))\n recalledAt:=f.text(\"SELECT CAST(recalled_at AS CHAR) FROM chat_messages WHERE id=?\",string(original.MessageID))\n // Original ID/seq and activity time survive, and duplicate requests add no change.\n if again,e:=s.Recall(f.ctx,author,q.ConversationID,original.MessageID);e!=nil||again.StateVersion!=\"2\"{t.Fatal(again,e)}\n if f.text(\"SELECT CAST(recalled_at AS CHAR) FROM chat_messages WHERE id=?\",string(original.MessageID))!=recalledAt{t.Fatal(\"duplicate recall changed its timestamp\")}\n if f.text(\"SELECT last_seq FROM chat_conversations WHERE id=?\",string(q.ConversationID))!=\"2\"||f.text(\"SELECT last_change_seq FROM chat_conversations WHERE id=?\",string(q.ConversationID))!=\"3\"{t.Fatal(\"recall allocated seq or duplicate change\")}\n after,e:=h.Unread(f.ctx,other,q.ConversationID);if e!=nil||after.Count!=0||before.ReadSeq!=after.ReadSeq{t.Fatal(\"recall count/read boundary\",after,e)}\n changes,e:=h.Read(f.ctx,other,HistoryRequest{ConversationID:q.ConversationID,Cursor:page.ChangeCursor},\"changes\");if e!=nil||len(changes.Changes)!=1||changes.Changes[0].Message.Text!=nil{t.Fatal(changes,e)}\n page,e=h.Read(f.ctx,other,HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\");if e!=nil{t.Fatal(e)}\n if page.Messages[0].Text!=nil||page.Messages[1].Reply==nil||page.Messages[1].Reply.Text!=nil||page.Messages[1].Reply.State!=\"recalled\"{t.Fatal(\"recall leaked into history/quote\",page)}\n if result,e:=s.Query(f.ctx,author,q.ConversationID,original.ClientMessageID);e!=nil||result.MessageState!=\"recalled\"{t.Fatal(result,e)}\n q.ClientMessageID=client(1502)\n if _,e:=s.Send(f.ctx,other,q);e!=ErrReference{t.Fatal(\"new reply to recalled target\",e)}\n q.ReplyTo=\"\";q.EditedFrom=original.MessageID;q.Text=\"修改后的正文\";q.ClientMessageID=client(1503)\n if _,e:=s.Send(f.ctx,other,q);e!=ErrReference{t.Fatal(\"forged author source\",e)}\n rewritten:=accepted(t,s,q)\n if rewritten.MessageID==original.MessageID||rewritten.Seq!=\"3\"{t.Fatal(\"rewrite replaced original\",rewritten)}\n if f.text(\"SELECT CAST(edited_from_recalled_message_id AS CHAR) FROM chat_messages WHERE id=?\",string(rewritten.MessageID))!=string(original.MessageID){t.Fatal(\"source omitted\")}\n page=readPage(t,h,HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\")\n if v:=page.Messages[2];v.EditedSource==nil||v.EditedSource.ID!=original.MessageID||v.EditedSource.Text!=nil{t.Fatal(\"safe source marker missing\",v)}\n // Changed source conflicts under the original client ID, even with identical text.\n q.EditedFrom=reply.MessageID\n if _,e:=s.Send(f.ctx,author,q);e!=ErrConflict{t.Fatal(\"source absent from fingerprint\",e)}\n}\nfunc TestMySQLS15RecallTimeWindowOwnershipBanClosureAndRevocation(t *testing.T){\n f,s,_,q:=historyFixture(t,0);a:=accepted(t,s,q)\n if _,e:=s.Recall(f.ctx,principal(\"10203\"),q.ConversationID,a.MessageID);e!=ErrRecall{t.Fatal(\"non-author recall\",e)}\n f.exec(\"UPDATE chat_messages SET message_type='order_card' WHERE id=?\",string(a.MessageID))\n if _,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,a.MessageID);e!=ErrRecall{t.Fatal(\"user recalled immutable business card\",e)}\n f.exec(\"UPDATE chat_messages SET message_type='text',state='blocked' WHERE id=?\",string(a.MessageID))\n if _,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,a.MessageID);e!=ErrRecall{t.Fatal(\"blocked content became a reedit source\",e)}\n f.exec(\"UPDATE chat_messages SET state='published',created_at=UTC_TIMESTAMP(6)-INTERVAL 121 SECOND WHERE id=?\",string(a.MessageID))\n if _,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,a.MessageID);e!=ErrRecallWindow{t.Fatal(\"late recall\",e)}\n f.exec(\"UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 119 SECOND WHERE id=?\",string(a.MessageID))\n f.exec(\"UPDATE chat_restrictions SET permanent=1 WHERE actor_id=10202\")\n f.php(\"close\");if _,e:=f.store.Poll(f.ctx,100);e!=nil{t.Fatal(e)}\n if _,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,a.MessageID);e!=nil{t.Fatal(\"ban/readonly blocked lawful recall\",e)}\n f.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n if _,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,a.MessageID);e==nil{t.Fatal(\"revoked identity recalls\")}\n}\nfunc TestMySQLS15FinalReferenceRecheckAndBoundedSourceChain(t *testing.T){\n f,s,_,q:=historyFixture(t,0);a:=accepted(t,s,q)\n // Inspection happens outside the commit lock; a recall committed during it\n // must invalidate a new reply, rather than publishing a stale quote.\n raceSafety:=safetyFunc(func(ctx context.Context,r ports.TextRequest)(ports.SafetyResult,error){_,e:=s.Recall(ctx,principal(\"10202\"),q.ConversationID,a.MessageID);if e!=nil{t.Fatal(e)};return pass(ctx,r)})\n raced,_:=NewService(f.goDB,f.store,raceSafety,3*time.Second)\n q.ClientMessageID=client(1510);q.ReplyTo=a.MessageID\n if _,e:=raced.Send(f.ctx,principal(\"10202\"),q);e!=ErrReference{t.Fatal(\"recall/send race published\",e)}\n if f.text(\"SELECT COUNT(*) FROM chat_messages\")!=\"1\"{t.Fatal(\"failed quote occupied a seq\")}\n q.ReplyTo=\"\";q.EditedFrom=a.MessageID\n for n:=1;n<=maxReeditDepth;n++{\n  q.ClientMessageID=client(1520+n);next:=accepted(t,s,q)\n  if _,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,next.MessageID);e!=nil{t.Fatal(e)}\n  q.EditedFrom=next.MessageID\n }\n q.ClientMessageID=client(1540)\n if _,e:=s.Send(f.ctx,principal(\"10202\"),q);e!=ErrReeditLimit{t.Fatal(\"unbounded reedit chain\",e)}\n}\nfunc TestMySQLS15ReferenceVisibilityAndCrossConversation(t *testing.T){\n f,s,h,q:=historyFixture(t,0);a:=accepted(t,s,q)\n f.php(\"sync\",\"402\");if _,e:=f.store.Poll(f.ctx,100);e!=nil{t.Fatal(e)}\n other,e:=f.store.FindOrder(f.ctx,principal(\"10202\"),\"402\",\"402\");if e!=nil{t.Fatal(e)}\n q.ConversationID=other;q.ClientMessageID=client(1550);q.ReplyTo=a.MessageID\n if _,e:=s.Send(f.ctx,principal(\"10202\"),q);e!=ErrReference{t.Fatal(\"cross conversation reference\",e)}\n q.ConversationID=aConversation(f,a.MessageID);q.ClientMessageID=client(1551)\n f.exec(\"UPDATE chat_messages SET seq=999 WHERE id=?\",string(a.MessageID))\n if _,e:=s.Send(f.ctx,principal(\"10202\"),q);e!=ErrReference{t.Fatal(\"source newer than committed high water\",e)}\n f.exec(\"UPDATE chat_messages SET seq=1 WHERE id=?\",string(a.MessageID))\n b:=accepted(t,s,q)\n // A newer member interval cannot be used to read an older quote target.\n f.exec(\"UPDATE chat_messages SET policy_version=2 WHERE id=?\",string(b.MessageID))\n f.exec(\"UPDATE chat_member_intervals SET start_version=2 WHERE conversation_id=? AND actor_id=10203\",string(q.ConversationID))\n g:=ports.Grant{Version:\"2\"}\n tx,e:=f.goDB.BeginTx(f.ctx,nil);if e!=nil{t.Fatal(e)};defer tx.Rollback()\n views:=[]*MessageView{{ID:b.MessageID,Seq:b.Seq,State:\"published\",ReplyTo:a.MessageID}}\n if e:=hydrateReferences(f.ctx,tx,principal(\"10203\"),g,q.ConversationID,views);e!=nil{t.Fatal(e)}\n if views[0].Reply==nil||views[0].Reply.ID!=\"\"||views[0].Reply.Text!=nil{t.Fatal(\"quote leaked absence interval\",views[0].Reply)}\n tx.Rollback()\n _=h\n}\nfunc aConversation(f *fixtureDB,id ports.ID)ports.ID{return ports.ID(f.text(\"SELECT CAST(conversation_id AS CHAR) FROM chat_messages WHERE id=?\",string(id)))}\nfunc TestMySQLS15ConcurrentRecallIsIdempotentAndTransactional(t *testing.T){\n f,s,_,q:=historyFixture(t,0);a:=accepted(t,s,q)\n results:=make(chan error,2)\n for range 2{go func(){_,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,a.MessageID);results<-e}()}\n for range 2{if e:=<-results;e!=nil{t.Fatal(e)}}\n if f.text(\"SELECT COUNT(*) FROM chat_message_changes WHERE change_type='message.recalled'\")!=\"1\"{t.Fatal(\"duplicate recall change\")}\n q.ClientMessageID=client(1560);b:=accepted(t,s,q)\n // Expiry while waiting for the shared conversation commit lock rolls back.\n holder,e:=f.root.BeginTx(f.ctx,nil);if e!=nil{t.Fatal(e)}\n if _,e=holder.ExecContext(f.ctx,\"SELECT id FROM chat_conversations WHERE id=? FOR UPDATE\",string(q.ConversationID));e!=nil{t.Fatal(e)}\n expiring:=principal(\"10202\");expiring.ExpiresAt=time.Now().Add(100*time.Millisecond)\n waiting:=make(chan error,1);go func(){_,e:=s.Recall(f.ctx,expiring,q.ConversationID,b.MessageID);waiting<-e}()\n time.Sleep(200*time.Millisecond);if e:=holder.Commit();e!=nil{t.Fatal(e)}\n if e:=<-waiting;e==nil{t.Fatal(\"recall with expired credential committed\")}\n if f.text(\"SELECT state FROM chat_messages WHERE id=?\",string(b.MessageID))!=\"published\"{t.Fatal(\"expiry committed recall\")}\n f.exec(\"CREATE TRIGGER s15_change_rollback BEFORE INSERT ON chat_message_changes FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='rollback-fixture'\")\n if _,e:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,b.MessageID);e==nil{t.Fatal(\"recall reported success after change failure\")}\n if f.text(\"SELECT state FROM chat_messages WHERE id=?\",string(b.MessageID))!=\"published\"{t.Fatal(\"partial recall committed\")}\n}\n","chat/internal/message/history_locate.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Locate is a bounded index seek, not repeated history-page traversal. It is\n// also the basis for S15 references/S09 unread anchors; it never marks read.\nfunc (s *HistoryService) locate(ctx context.Context, p ports.Principal, q HistoryRequest) (HistoryPage, error) {\n\tif !validID(q.TargetID) {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tr, e := s.open(ctx, p, q, \"locate\")\n\tif e != nil {\n\t\treturn HistoryPage{}, e\n\t}\n\tdefer r.tx.Rollback()\n\tselectSQL := `SELECT ` + viewColumns + `,` + visibleColumn + ` FROM chat_messages m WHERE m.conversation_id=? AND `\n\targs := []any{string(r.grant.Version), string(p.ActorID), string(q.ConversationID), string(q.TargetID), r.floorSeq, r.seq}\n\trows, e := r.tx.QueryContext(ctx, selectSQL+`m.id=? AND m.seq>? AND m.seq<=? LIMIT 1`, args...)\n\tif e != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tvar target candidate\n\tfound := rows.Next()\n\tif found {\n\t\ttarget, e = scanCandidate(rows, false)\n\t}\n\trowError := rows.Err()\n\trows.Close()\n\tif e != nil || rowError != nil {\n\t\treturn HistoryPage{}, ports.ErrUnavailable\n\t}\n\tif !found || !target.visible {\n\t\treturn HistoryPage{}, policy.ErrDenied\n\t}\n\tpage := emptyPage(r)\n\tlimit := limitFor(q)\n\tbefore := (limit - 1) / 2\n\tafter := limit - before - 1\n\tfetch := func(pre bool, n int) ([]candidate, error) {\n\t\tcmp := `m.seq>? AND m.seq<=? ORDER BY m.seq ASC`\n\t\tlo, hi := number(target.view.Seq), r.seq\n\t\tif pre {\n\t\t\tcmp = `m.seq>? AND m.seq<? ORDER BY m.seq DESC`\n\t\t\tlo, hi = r.floorSeq, number(target.view.Seq)\n\t\t}\n\t\trows, err := r.tx.QueryContext(ctx, selectSQL+cmp+` LIMIT ?`, string(r.grant.Version), string(p.ActorID), string(q.ConversationID), lo, hi, n)\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tout := make([]candidate, 0, n)\n\t\tfor rows.Next() {\n\t\t\tv, err := scanCandidate(rows, false)\n\t\t\tif err != nil {\n\t\t\t\trows.Close()\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tout = append(out, v)\n\t\t}\n\t\terr = rows.Err()\n\t\trows.Close()\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\treturn out, nil\n\t}\n\tprior, e := fetch(true, before+1)\n\tif e != nil {\n\t\treturn HistoryPage{}, e\n\t}\n\tpage.HasMore = len(prior) > before\n\tif page.HasMore {\n\t\tprior = prior[:before]\n\t}\n\tnext := number(target.view.Seq) - 1\n\tif len(prior) > 0 {\n\t\tnext = number(prior[len(prior)-1].view.Seq) - 1\n\t}\n\tfor i := len(prior) - 1; i >= 0; i-- {\n\t\tif prior[i].visible {\n\t\t\tpage.Messages = append(page.Messages, prior[i].view)\n\t\t}\n\t}\n\tpage.Messages = append(page.Messages, target.view)\n\tif after > 0 {\n\t\tfollowing, e := fetch(false, after)\n\t\tif e != nil {\n\t\t\treturn HistoryPage{}, e\n\t\t}\n\t\tfor _, v := range following {\n\t\t\tif v.visible {\n\t\t\t\tpage.Messages = append(page.Messages, v.view)\n\t\t\t}\n\t\t}\n\t}\n\tc := r.cursor\n\tif page.HasMore {\n\t\tc.Mode = \"history\"\n\t\tc.Position = decimal(next)\n\t\tc.Pending = true\n\t\tpage.HistoryCursor = s.sign(c)\n\t}\n\t// Locate is not bootstrap: it must not certify that newer messages were\n\t// consumed. The caller retains its existing independent sync/change cursors.\n\tpage.NextSync = \"\"\n\tpage.NextChange = \"\"\n\treturn s.finish(ctx,p, r, page)\n}\n","chat/internal/message/history_test.go":"package message\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestS08CursorBindingTamperingAndExpiry(t *testing.T) {\n\ts := &HistoryService{key: []byte(strings.Repeat(\"k\", 32)), environment: \"test\"}\n\tnow := time.Now().Unix()\n\tc := historyCursor{Schema: 1, Mode: \"sync\", Binding: bindingFor(\"test\", principal(\"10202\")), Conversation: \"1\", Policy: \"1\", Member: \"fixture\", Seq: \"18446744073709551615\", Change: \"0\", Position: \"100\", Issued: now, Expiry: now + 600}\n\ttoken := s.sign(c)\n\tif got, e := s.parse(token, \"sync\"); e != nil || got.Seq != c.Seq {\n\t\tt.Fatal(\"valid large cursor\", e)\n\t}\n\tfor _, v := range []string{\"\", token + \"a\", strings.Repeat(\"x\", 2049), strings.Replace(token, \".\", \"..\", 1)} {\n\t\tif _, e := s.parse(v, \"sync\"); e != ErrResync {\n\t\t\tt.Fatal(\"forged cursor\")\n\t\t}\n\t}\n\tif _, e := s.parse(token, \"changes\"); e != ErrResync {\n\t\tt.Fatal(\"cross-stream cursor\")\n\t}\n\tc.Issued -= 601\n\tc.Expiry -= 601\n\tif _, e := s.parse(s.sign(c), \"sync\"); e != ErrResync {\n\t\tt.Fatal(\"expired snapshot\")\n\t}\n\tif bindingFor(\"production\", principal(\"10202\")) == c.Binding || bindingFor(\"test\", principal(\"10203\")) == c.Binding {\n\t\tt.Fatal(\"identity collision\")\n\t}\n}\nfunc TestS08StrictReadRequest(t *testing.T) {\n\tfor _, body := range []string{`{\"conversation_id\":1}`, `{\"conversation_id\":\"1\",\"conversation_id\":\"1\"}`, `{\"Conversation_ID\":\"1\"}`, `{\"conversation_id\":\"1\",\"limit\":null}`, `{\"conversation_id\":\"1\",\"limit\":51}`, `{\"conversation_id\":\"1\",\"limit\":1.5}`, `{\"conversation_id\":\"1\",\"after_seq\":\"103\"}`, `{\"conversation_id\":\"1\",\"cursor\":\"\\ud800\"}`, `{\"conversation_id\":\"01\"}`, `{\"conversation_id\":\"1\"}{}`} {\n\t\tif _, e := decodeHistory([]byte(body)); e != ports.ErrInvalid {\n\t\t\tt.Fatal(\"accepted malformed request\", body)\n\t\t}\n\t}\n\tif q, e := decodeHistory([]byte(`{\"conversation_id\":\"1\",\"limit\":50}`)); e != nil || q.Limit != 50 {\n\t\tt.Fatal(e)\n\t}\n}\n","chat/internal/message/http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Handler is explicitly constructed by isolated fixtures in S06. Runtime\n// refuses messages.enabled=true until safety and release gates are complete.\ntype Handler struct {\n\tservice  *Service\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewHandler(s *Service, identity ports.Identity, concurrency int) (*Handler, error) {\n\tif s == nil || identity == nil || concurrency < 1 || concurrency > 32 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Handler{s, identity, make(chan struct{}, concurrency)}, nil\n}\nfunc validSurrogates(raw []byte) bool {\n\tfor i := 1; i < len(raw)-1; i++ {\n\t\tif raw[i] != '\\\\' {\n\t\t\tcontinue\n\t\t}\n\t\ti++\n\t\tif i >= len(raw)-1 {\n\t\t\treturn false\n\t\t}\n\t\tif raw[i] != 'u' {\n\t\t\tcontinue\n\t\t}\n\t\tif i+4 >= len(raw) {\n\t\t\treturn false\n\t\t}\n\t\tn, e := strconv.ParseUint(string(raw[i+1:i+5]), 16, 16)\n\t\tif e != nil {\n\t\t\treturn false\n\t\t}\n\t\ti += 4\n\t\tif n >= 0xdc00 && n <= 0xdfff {\n\t\t\treturn false\n\t\t}\n\t\tif n >= 0xd800 && n <= 0xdbff {\n\t\t\tif i+6 >= len(raw) || raw[i+1] != '\\\\' || raw[i+2] != 'u' {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tlow, e := strconv.ParseUint(string(raw[i+3:i+7]), 16, 16)\n\t\t\tif e != nil || low < 0xdc00 || low > 0xdfff {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\ti += 6\n\t\t}\n\t}\n\treturn true\n}\n\nfunc decode(body []byte, result bool) (Request, error) {\n\tvar r Request\n if !result {var peek map[string]json.RawMessage;if json.Unmarshal(body,&peek)==nil{var kind string;json.Unmarshal(peek[\"message_type\"],&kind);if kind==\"image\"||kind==\"image_album\"{return decodeMediaSend(body)}}}\n if !utf8.Valid(body) {\n\t\treturn r, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(body))\n\ttoken, e := d.Token()\n\tif e != nil || token != json.Delim('{') {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\ttoken, e = d.Token()\n\t\tkey, ok := token.(string)\n\t\tif e != nil || !ok || seen[key] {\n\t\t\treturn r, ports.ErrInvalid\n\t\t}\n\t\tseen[key] = true\n\t\tvar value string\n\t\tvar raw json.RawMessage\n\t\tif d.Decode(&raw) != nil || len(raw) < 2 || raw[0] != '\"' || json.Unmarshal(raw, &value) != nil || !validSurrogates(raw) {\n\t\t\treturn r, ports.ErrInvalid\n\t\t}\n\t\tswitch key {\n\t\tcase \"conversation_id\":\n\t\t\tr.ConversationID = ports.ID(value)\n\t\tcase \"client_message_id\":\n\t\t\tr.ClientMessageID = value\n\t\tcase \"message_type\":\n\t\t\tif result {\n\t\t\t\treturn r, ports.ErrInvalid\n\t\t\t}\n\t\t\tr.MessageType = value\n\t\tcase \"reply_to_message_id\",\"edited_from_recalled_message_id\",\"reply_to_item_id\":\n            if result || !validID(ports.ID(value)){return r,ports.ErrInvalid}\n            if key==\"reply_to_item_id\"{r.ReplyItem=ports.ID(value)}else if key==\"reply_to_message_id\"{r.ReplyTo=ports.ID(value)}else{r.EditedFrom=ports.ID(value)}\n\t\tcase \"text\":\n\t\t\tif result {\n\t\t\t\treturn r, ports.ErrInvalid\n\t\t\t}\n\t\t\tr.Text = value\n\t\tdefault:\n\t\t\treturn r, ports.ErrInvalid\n\t\t}\n\t}\n\tif token, e = d.Token(); e != nil || token != json.Delim('}') {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tif _, e = d.Token(); e != io.EOF {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tif !validID(r.ConversationID) || !validClient(r.ClientMessageID) {\n\t\treturn r, ports.ErrInvalid\n\t}\n\tif !result {\n\t\t_, e = fingerprint(r)\n\t\tif e != nil {\n\t\t\treturn r, e\n\t\t}\n\t}\n\treturn r, nil\n}\nfunc (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tvar nonce [16]byte\n\t_, _ = rand.Read(nonce[:])\n\tid := hex.EncodeToString(nonce[:])\n\tw.Header().Set(\"X-Request-ID\", id)\n\tfail := func(status int, code, message string, retry bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"message\": message, \"retryable\": retry, \"server_time\": time.Now().UTC()})\n\t\t}\n\t}\n\trecall := r.URL.Path==\"/chat/api/v1/messages/recall\"\n\tresult := r.URL.Path == \"/chat/api/v1/messages/result\"\n\tif !recall && !result && r.URL.Path != \"/chat/api/v1/messages/send\" {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", \"接口未开放\", false)\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", \"请求方法不支持\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"请求参数不正确\", false)\n\t\treturn\n\t}\n\tcontent, _, e := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif e != nil || content != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\", \"请使用JSON请求\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error(), \"请求较多，请稍后重试\", true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效\", false)\n\t\treturn\n\t}\n\tctx, cancel := context.WithTimeout(r.Context(), h.service.timeout)\n\tdefer cancel()\n\tcontroller := http.NewResponseController(w)\n\t_ = controller.SetReadDeadline(time.Now().Add(h.service.timeout))\n\tbody, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 32<<10))\n\tif e != nil {\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar large *http.MaxBytesError\n\t\tif errors.As(e, &large) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", \"请求内容过大\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", \"请求未及时完成\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = controller.SetReadDeadline(time.Time{})\n\tvar req Request\n    var target HistoryRequest\n    if recall {target,e=decodeRecall(body)}else{req,e=decode(body,result)}\n\tif e != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"消息格式不正确\", false)\n\t\treturn\n\t}\n\tp, e := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif e != nil {\n\t\tif errors.Is(e, auth.ErrUnauthorized) {\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", \"登录状态已失效\", false)\n\t\t} else {\n\t\t\tfail(503, ports.ErrUnavailable.Error(), \"身份服务暂不可用\", true)\n\t\t}\n\t\treturn\n\t}\n\tvar data any\n    if recall {\n        data,e=h.service.Recall(ctx,p,target.ConversationID,target.TargetID)\n    } else if result {\n\t\tdata, e = h.service.Query(ctx, p, req.ConversationID, req.ClientMessageID)\n\t} else {\n\t\tdata, e = h.service.Send(ctx, p, req)\n\t}\n\tif e != nil {\n\t\tswitch {\n\t\tcase errors.Is(e, ports.ErrInvalid):\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", \"消息格式不正确\", false)\n\t\tcase errors.Is(e,ErrReference),errors.Is(e,ErrReeditLimit),errors.Is(e,ErrRecall):\n            fail(409,e.Error(),\"消息来源或操作已不可用，请刷新后核对\",false)\n        case errors.Is(e,ErrRecallWindow):\n            fail(410,e.Error(),\"已超过两分钟撤回窗口\",false)\n\t\tcase errors.Is(e, ErrConflict):\n\t\t\tfail(409, e.Error(), \"同一消息ID的内容不能更改\", false)\n\t\tcase errors.Is(e, ErrExpired):\n\t\t\tfail(410, e.Error(), \"发送动作已过有效期，请先核对原结果\", false)\n\t\tcase errors.Is(e, ErrUnknown):\n\t\t\tfail(409, e.Error(), \"暂未确认发送结果，请沿用原ID核验\", true)\n\t\tcase errors.Is(e, ErrRestricted):\n\t\t\tfail(403, e.Error(), \"当前账号暂不能发送聊天消息\", false)\n\t\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\t\tfail(403, \"CHAT_PERMISSION_DENIED\", \"当前无法访问或发送此会话\", false)\n\t\tcase errors.Is(e, ports.ErrBusy):\n\t\t\tfail(429, e.Error(), \"消息正在处理，请用原ID查询\", true)\n\t\tcase errors.Is(e, ErrCheck):\n\t\t\tfail(503, e.Error(), \"内容检查暂不可用，请沿用原ID重试\", true)\n\t\tdefault:\n\t\t\tfail(503, ports.ErrUnavailable.Error(), \"结果暂未确认，请用原ID查询\", true)\n\t\t}\n\t\treturn\n\t}\n\tstatus := 200\n\tif outcome,ok:=data.(Result); ok && (outcome.State == \"checking\" || outcome.State == \"retryable\" || outcome.State == \"review_pending\") {\n\t\tstatus = 202\n\t}\n\tw.WriteHeader(status)\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"ok\": true, \"request_id\": id, \"data\": data, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/http_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n \"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n)\n\nfunc TestMySQLHTTPUsesVerifiedIdentityAndSharedSend(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tpublic, private, e := ed25519.GenerateKey(rand.Reader)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tverifier, e := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"fixture\": public})\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tsource, e := auth.NewMySQLSource(f.goDB)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tidentity, e := auth.NewService(verifier, source, nil, 4, time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\thandler, e := NewHandler(s, identity, 4)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tserver := httptest.NewServer(handler)\n\tdefer server.Close()\n\ttoken := func(actor string) string {\n\t\tp := principal(actor)\n\t\tnow := time.Now().Unix()\n\t\tclaims := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: \"test\", Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 60, JTI: digest(\"fixture-jti\")}\n\t\tpayload, _ := json.Marshal(claims)\n\t\theader := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"fixture\"}`))\n\t\tdata := header + \".\" + base64.RawURLEncoding.EncodeToString(payload)\n\t\treturn data + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(private, []byte(data)))\n\t}\n\tcredential := token(\"10202\")\n\tcall := func(method, path, body, credential string, status int) []byte {\n\t\tt.Helper()\n\t\treq, _ := http.NewRequest(method, server.URL+path, strings.NewReader(body))\n\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n\t\tif credential != \"\" {\n\t\t\treq.Header.Set(\"Authorization\", \"Bearer \"+credential)\n\t\t}\n\t\tres, e := server.Client().Do(req)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer res.Body.Close()\n\t\tout, _ := io.ReadAll(res.Body)\n\t\tif res.StatusCode != status {\n\t\t\tt.Fatalf(\"HTTP %d expected %d: %s\", res.StatusCode, status, out)\n\t\t}\n\t\tif res.Header.Get(\"Cache-Control\") != \"no-store\" || res.Header.Get(\"X-Request-ID\") == \"\" {\n\t\t\tt.Fatal(\"response privacy headers\")\n\t\t}\n\t\treturn out\n\t}\n\tbody, _ := json.Marshal(r)\n\tcall(\"GET\", \"/chat/api/v1/messages/send\", string(body), credential, 405)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", string(body), \"\", 401)\n\tcall(\"POST\", \"/chat/api/v1/messages/send?sender=10203\", string(body), credential, 400)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", strings.Repeat(\"a\", (32<<10)+1), credential, 413)\n\tbad := strings.Replace(string(body), `\"text\":`, `\"sender_id\":\"10203\",\"text\":`, 1)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", bad, credential, 400)\n\tout := call(\"POST\", \"/chat/api/v1/messages/send\", string(body), credential, 200)\n\tif strings.Contains(string(out), r.Text) || !strings.Contains(string(out), `\"state\":\"accepted\"`) {\n\t\tt.Fatal(\"unsafe result body\", string(out))\n\t}\n\tif again, e := s.Send(context.Background(), principal(\"10202\"), r); e != nil || again.Seq != \"1\" {\n\t\tt.Fatalf(\"transport idempotency %+v %v\", again, e)\n\t}\n\tr.Text += \" changed\"\n\tchanged, _ := json.Marshal(r)\n\tcall(\"POST\", \"/chat/api/v1/messages/send\", string(changed), credential, 409)\n\tquery, _ := json.Marshal(map[string]any{\"conversation_id\": r.ConversationID, \"client_message_id\": r.ClientMessageID})\n\tcall(\"POST\", \"/chat/api/v1/messages/result\", string(query), token(\"10203\"), 409)\n\tf.exec(\"UPDATE chat_restrictions SET permanent=1 WHERE actor_id=10202\")\n\tcall(\"POST\", \"/chat/api/v1/messages/result\", string(query), credential, 200)\n\trecallBody:=fmt.Sprintf(`{\"conversation_id\":%q,\"message_id\":%q}`,r.ConversationID,f.text(\"SELECT CAST(id AS CHAR) FROM chat_messages WHERE conversation_id=?\",string(r.ConversationID)))\n    recalled:=call(\"POST\",\"/chat/api/v1/messages/recall\",recallBody,credential,200)\n    if strings.Contains(string(recalled),\"施工\")||!strings.Contains(string(recalled),`\"state\":\"recalled\"`){t.Fatal(\"unsafe HTTP recall\",string(recalled))}\n    call(\"POST\",\"/chat/api/v1/messages/recall\",recallBody,credential,200)\n    call(\"POST\",\"/chat/api/v1/messages/recall\",strings.TrimSuffix(recallBody,\"}\")+`,\"text\":\"fake\"}`,credential,400)\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tcall(\"POST\", \"/chat/api/v1/messages/result\", string(query), credential, 401)\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"HTTP retries duplicated\")\n\t}\n}\n","chat/internal/message/moderation_integration_test.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"net/url\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/moderation\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype moderationHTTP func(*http.Request) (*http.Response, error)\n\nfunc (f moderationHTTP) Do(r *http.Request) (*http.Response, error) { return f(r) }\nfunc moderated(t *testing.T, respond func(*fixtureDB, http.ResponseWriter, *http.Request)) (*fixtureDB, *Service, *moderation.Service, Request, *atomic.Int32) {\n\tt.Helper()\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tf.exec(`INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10202,'chat-platform-app','oS07Worker_abcdefghijklmnopqrstuv','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tdirectory, e := os.MkdirTemp(\"\", \"bixuan-s07-\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Cleanup(func() { os.RemoveAll(directory) })\n\tpath, _ := filepath.Abs(\"../../../server/tests/chat_text_security_contract.php\")\n\tcmd := exec.CommandContext(f.ctx, os.Getenv(\"CHAT_AUTH_TEST_PHP\"), path, \"--export\", directory)\n\tcmd.Env = os.Environ()\n\tout, e := cmd.CombinedOutput()\n\tif e != nil || strings.TrimSpace(string(out)) != \"exported\" {\n\t\tt.Fatalf(\"real PHP credential exporter: %s\", out)\n\t}\n\tcount := &atomic.Int32{}\n\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) { count.Add(1); respond(f, w, req) }))\n\tt.Cleanup(server.Close)\n\taddress, _ := url.Parse(server.URL)\n\tclient := moderationHTTP(func(req *http.Request) (*http.Response, error) {\n\t\tif req.URL.Scheme != \"https\" || req.URL.Host != \"api.weixin.qq.com\" || req.URL.Path != \"/wxa/msg_sec_check\" || req.URL.Query().Get(\"access_token\") != \"s07_fixture_official_token\" {\n\t\t\treturn nil, ports.ErrInvalid\n\t\t}\n\t\tcopy := req.Clone(req.Context())\n\t\ttarget := *req.URL\n\t\tcopy.URL = &target\n\t\tcopy.URL.Host = address.Host\n\t\tcopy.URL.Scheme = address.Scheme\n\t\treturn server.Client().Do(copy)\n\t})\n\texport := filepath.Join(directory, \"export\", \"test-\"+digest(\"chat-platform-app\")+\".json\")\n\tf.credentialFile = export\n\tsafety, e := moderation.New(f.goDB, \"test\", moderation.Config{Enabled: true, AppID: \"chat-platform-app\", CredentialFile: export}, 4, 2*time.Second, client)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Cleanup(safety.Close)\n\ts.safety = safety\n\treturn f, s, safety, r, count\n}\nfunc officialPass(_ *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tvar body struct {\n\t\tContent string `json:\"content\"`\n\t\tOpenID  string `json:\"openid\"`\n\t\tScene   int    `json:\"scene\"`\n\t\tVersion int    `json:\"version\"`\n\t}\n\tif json.NewDecoder(req.Body).Decode(&body) != nil || body.OpenID != \"oS07Worker_abcdefghijklmnopqrstuv\" || body.Scene != 1 || body.Version != 2 || body.Content == \"\" {\n\t\tw.WriteHeader(400)\n\t\treturn\n\t}\n\tio.WriteString(w, `{\"errcode\":0,\"trace_id\":\"s07-fixture\",\"result\":{\"suggest\":\"pass\",\"label\":100},\"detail\":[]}`)\n}\nfunc TestMySQLS07OfficialPassUsesPHPTokenAndBoundedCache(t *testing.T) {\n\tf, s, safety, r, count := moderated(t, officialPass)\n\tfirst := accepted(t, s, r)\n\tr.ClientMessageID = client(2)\n\tsecond := accepted(t, s, r)\n\tif first.Seq != \"1\" || second.Seq != \"2\" || count.Load() != 1 {\n\t\tt.Fatalf(\"cache or send order %s %s calls=%d\", first.Seq, second.Seq, count.Load())\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_text_checks\") != \"2\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\tt.Fatal(\"normal sends created risk or lost context\")\n\t}\n\tf.exec(\"UPDATE chat_text_checks SET created_at=UTC_TIMESTAMP()-INTERVAL 11 MINUTE,pass_until=UTC_TIMESTAMP()-INTERVAL 1 MINUTE\")\n\tif e := safety.Clean(f.ctx); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_text_checks\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_send_intents\") != \"2\" {\n\t\tt.Fatal(\"context cleanup removed idempotency facts\")\n\t}\n\tif got, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID); e != nil || got.MessageID != second.MessageID {\n\t\tt.Fatalf(\"cleanup lost accepted result %+v %v\", got, e)\n\t}\n}\nfunc TestMySQLS07OfficialRejectionReviewAndFaults(t *testing.T) {\n\tfor _, mode := range []string{\"risky\", \"review\", \"quota\", \"malformed\", \"timeout\"} {\n\t\tt.Run(mode, func(t *testing.T) {\n\t\t\tvar response atomic.Value\n\t\t\tresponse.Store(mode)\n\t\t\tf, s, _, r, count := moderated(t, func(f *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\t\t\t\tswitch response.Load().(string) {\n\t\t\t\tcase \"pass\":\n\t\t\t\t\tofficialPass(f, w, req)\n\t\t\t\tcase \"risky\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":0,\"trace_id\":\"s07-risk\",\"result\":{\"suggest\":\"risky\",\"label\":200}}`)\n\t\t\t\tcase \"review\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":0,\"trace_id\":\"s07-review\",\"result\":{\"suggest\":\"review\"}}`)\n\t\t\t\tcase \"quota\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":45009,\"errmsg\":\"fixture diagnostic never forwarded\"}`)\n\t\t\t\tcase \"malformed\":\n\t\t\t\t\tio.WriteString(w, `{\"errcode\":0}`)\n\t\t\t\tcase \"timeout\":\n\t\t\t\t\t// Drain the POST body so net/http can observe a closed peer.\n\t\t\t\t\t// Bound the fixture too: server cleanup must not wait forever.\n\t\t\t\t\tio.Copy(io.Discard, req.Body)\n\t\t\t\t\tselect {\n\t\t\t\t\tcase <-req.Context().Done():\n\t\t\t\t\tcase <-time.After(3 * time.Second):\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t})\n\t\t\tout, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\t\tnoMessages(t, f)\n\t\t\tif mode == \"risky\" || mode == \"review\" {\n\t\t\t\twant := \"rejected\"\n\t\t\t\tconfirmed := \"1\"\n\t\t\t\tif mode == \"review\" {\n\t\t\t\t\twant = \"review_pending\"\n\t\t\t\t\tconfirmed = \"0\"\n\t\t\t\t}\n\t\t\t\tif e != nil || out.State != want || out.RiskEventID == \"\" {\n\t\t\t\t\tt.Fatalf(\"risk outcome %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t\tif f.text(\"SELECT CAST(confirmed AS CHAR) FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) != confirmed {\n\t\t\t\t\tt.Fatal(\"review incorrectly counted as violation\")\n\t\t\t\t}\n\t\t\t\tif f.text(\"SELECT text_evidence FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) != r.Text {\n\t\t\t\t\tt.Fatal(\"risk evidence is not original text\")\n\t\t\t\t}\n\t\t\t\tagain, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\t\t\tif e != nil || again.RiskEventID != out.RiskEventID || count.Load() != 1 || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"1\" {\n\t\t\t\t\tt.Fatalf(\"risk retry duplicated %+v %v\", again, e)\n\t\t\t\t}\n\t\t\t\tgot, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID)\n\t\t\t\tif e != nil || got.RiskEventID != out.RiskEventID {\n\t\t\t\t\tt.Fatalf(\"risk status query %+v %v\", got, e)\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif e != ErrCheck || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\t\t\t\tt.Fatalf(\"fault recorded a violation %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t\tresponse.Store(\"pass\")\n\t\t\t\t// A timeout may leave the checking lease until takeover; the same ID still\n\t\t\t\t// owns the fingerprint, never creates a second logical action.\n\t\t\t\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND WHERE state='checking'\")\n\t\t\t\taccepted(t, s, r)\n\t\t\t\tif f.text(\"SELECT COUNT(*) FROM chat_text_checks\") != \"1\" {\n\t\t\t\t\tt.Fatal(\"retry added another fragment\")\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestMySQLS07LocalAndSplitRules(t *testing.T) {\n\tf, s, _, r, count := moderated(t, officialPass)\n\tr.Text = \"电话138001\"\n\taccepted(t, s, r)\n\tnext := r\n\tnext.ClientMessageID = client(2)\n\tnext.Text = \"38000\"\n\tout, e := s.Send(f.ctx, principal(\"10202\"), next)\n\tif e != nil || out.State != \"rejected\" || out.RiskEventID == \"\" || count.Load() != 1 {\n\t\tt.Fatalf(\"split contact bypass %+v %v calls=%d\", out, e, count.Load())\n\t}\n\tif f.text(\"SELECT reason_code FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) != \"split_private_phone\" || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"wrong split disposition\")\n\t}\n\tif f.text(\"SELECT context_evidence FROM chat_risk_events WHERE id=?\", string(out.RiskEventID)) == \"\" {\n\t\tt.Fatal(\"split evidence lost contributing action snapshots\")\n\t}\n\tif again, e := s.Send(f.ctx, principal(\"10202\"), next); e != nil || again.RiskEventID != out.RiskEventID {\n\t\tt.Fatal(\"blocked action was re-counted\")\n\t}\n\t// Same person's other order has independent context; a naked numeric fragment\n\t// is not itself confirmed diversion evidence.\n\tf.php(\"sync\", \"402\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tid, e := f.store.FindOrder(f.ctx, principal(\"10202\"), \"402\", \"402\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tother := next\n\tother.ConversationID = id\n\tother.ClientMessageID = client(3)\n\taccepted(t, s, other)\n\t// Old context is ineligible, while minimum intent/risk facts remain.\n\tf.exec(\"UPDATE chat_text_checks SET created_at=UTC_TIMESTAMP()-INTERVAL 3 MINUTE WHERE conversation_id=?\", string(r.ConversationID))\n\tnext.ClientMessageID = client(4)\n\taccepted(t, s, next)\n\tdirect := r\n\tdirect.ClientMessageID = client(5)\n\tdirect.Text = \"加我 ＶＸ：abc_123456\"\n\tif out, e = s.Send(f.ctx, principal(\"10202\"), direct); e != nil || out.State != \"rejected\" {\n\t\tt.Fatalf(\"direct diversion %+v %v\", out, e)\n\t}\n}\nfunc TestMySQLS07RevalidatesAuthorityBeforeEveryFinalResult(t *testing.T) {\n\tfor _, mode := range []string{\"identity-version\", \"ban\", \"close\"} {\n\t\tfor _, decision := range []string{\"pass\", \"risky\", \"review\"} {\n\t\t\tt.Run(mode+\"/\"+decision, func(t *testing.T) {\n\t\t\t\tf, s, _, r, _ := moderated(t, func(f *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\t\t\t\t\t// These real writes complete during official inspection, proving no SQL\n\t\t\t\t\t// identity/authority lease spans network I/O.\n\t\t\t\t\tswitch mode {\n\t\t\t\t\tcase \"identity-version\":\n\t\t\t\t\t\tf.exec(\"UPDATE wechat_identities SET session_version=session_version+1 WHERE user_id=10202\")\n\t\t\t\t\tcase \"ban\":\n\t\t\t\t\t\tf.exec(\"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\t\t\t\t\tcase \"close\":\n\t\t\t\t\t\tf.php(\"close\")\n\t\t\t\t\t}\n\t\t\t\t\tif decision == \"pass\" {\n\t\t\t\t\t\tofficialPass(f, w, req)\n\t\t\t\t\t} else {\n\t\t\t\t\t\tio.WriteString(w, `{\"errcode\":0,\"result\":{\"suggest\":\"`+decision+`\"}}`)\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t\tif out, e := s.Send(f.ctx, principal(\"10202\"), r); e == nil {\n\t\t\t\t\tt.Fatalf(\"stale authority finalized: %+v\", out)\n\t\t\t\t}\n\t\t\t\tnoMessages(t, f)\n\t\t\t\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\t\t\t\tt.Fatal(\"authorization change counted as violation\")\n\t\t\t\t}\n\t\t\t})\n\t\t}\n\t}\n}\nfunc TestMySQLS07MissingOrAmbiguousOpenIDFailsClosed(t *testing.T) {\n\tf, s, _, r, count := moderated(t, officialPass)\n\tf.exec(\"UPDATE wechat_identities SET status='disabled' WHERE user_id=10202\")\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ErrCheck {\n\t\tt.Fatalf(\"missing real identity %v\", e)\n\t}\n\tnoMessages(t, f)\n\tf.exec(\"UPDATE wechat_identities SET status='active' WHERE user_id=10202\")\n\tf.exec(`INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10202,'chat-platform-app','oS07Other_abcdefghijklmnopqrstuv','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tr.ClientMessageID = client(2)\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ErrCheck {\n\t\tt.Fatalf(\"ambiguous identity %v\", e)\n\t}\n\tif count.Load() != 0 || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\tt.Fatal(\"untrusted identity used externally or recorded as violation\")\n\t}\n}\n\nfunc TestMySQLS07RiskCASAndEvidenceRollback(t *testing.T) {\n\tt.Run(\"stale-owner\", func(t *testing.T) {\n\t\tf, s, _, r, _ := moderated(t, func(f *fixtureDB, w http.ResponseWriter, req *http.Request) {\n\t\t\tf.exec(\"UPDATE chat_send_intents SET lease_owner=REPEAT('f',32) WHERE sender_id=10202 AND state='checking'\")\n\t\t\tio.WriteString(w, `{\"errcode\":0,\"result\":{\"suggest\":\"risky\"}}`)\n\t\t})\n\t\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrBusy {\n\t\t\tt.Fatalf(\"old owner recorded risk %v\", e)\n\t\t}\n\t\tnoMessages(t, f)\n\t\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\t\tt.Fatal(\"old inspection created evidence/count\")\n\t\t}\n\t})\n\tt.Run(\"rollback\", func(t *testing.T) {\n\t\tf, s, _, r, _ := moderated(t, func(_ *fixtureDB, w http.ResponseWriter, _ *http.Request) {\n\t\t\tio.WriteString(w, `{\"errcode\":0,\"result\":{\"suggest\":\"risky\"}}`)\n\t\t})\n\t\tf.exec(\"CREATE TRIGGER s07_risk_failure BEFORE INSERT ON chat_risk_events FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='isolated risk rollback'\")\n\t\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrUnavailable {\n\t\t\tt.Fatalf(\"risk insert failure %v\", e)\n\t\t}\n\t\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_send_intents WHERE state='rejected'\") != \"0\" {\n\t\t\tt.Fatal(\"risk/evidence terminal transaction partially committed\")\n\t\t}\n\t\tf.exec(\"DROP TRIGGER s07_risk_failure\")\n\t\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND\")\n\t\tout, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\tif e != nil || out.RiskEventID == \"\" {\n\t\t\tt.Fatalf(\"same-ID recovery %+v %v\", out, e)\n\t\t}\n\t\tnoMessages(t, f)\n\t})\n}\nfunc TestMySQLS07ExpiredCredentialCannotUseCachedPass(t *testing.T) {\n\tf, s, _, r, count := moderated(t, officialPass)\n\taccepted(t, s, r)\n\tdata, e := os.ReadFile(f.credentialFile)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tvar envelope map[string]any\n\tjson.Unmarshal(data, &envelope)\n\tenvelope[\"expires_at\"] = time.Now().Unix() - 1\n\tbad, _ := json.Marshal(envelope)\n\tos.WriteFile(f.credentialFile, bad, 0640)\n\tr.ClientMessageID = client(2)\n\tif _, e = s.Send(f.ctx, principal(\"10202\"), r); e != ErrCheck {\n\t\tt.Fatalf(\"expired credential bypassed via pass cache %v\", e)\n\t}\n\tif count.Load() != 1 || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events\") != \"0\" {\n\t\tt.Fatal(\"expired credential published or recorded risk\")\n\t}\n\tos.WriteFile(f.credentialFile, data, 0640)\n\taccepted(t, s, r)\n}\n","chat/internal/message/mysql_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"fmt\"\n\n\t\"encoding/hex\"\n\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\ntype fixtureDB struct {\n\tt              *testing.T\n\tctx            context.Context\n\troot, goDB     *sql.DB\n\tstore          *conversation.Store\n\tname           string\n\tuser           string\n\tcredentialFile string\n}\n\nfunc digest(s string) string { v := sha256.Sum256([]byte(s)); return hex.EncodeToString(v[:]) }\nfunc newFixture(t *testing.T) *fixtureDB {\n\tt.Helper()\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated MySQL/PHP required\")\n\t}\n\thost, _, err := net.SplitHostPort(os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\"))\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"loopback fixture required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 80*time.Second)\n\tt.Cleanup(cancel)\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ParseTime = true\n\tc.Apply(mysql.Charset(\"utf8mb4\", \"utf8mb4_unicode_ci\"))\n\tc.Params = map[string]string{\"time_zone\": \"'+00:00'\"}\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tadmin := sql.OpenDB(connector)\n\tdefer admin.Close()\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname := \"bixuan_test_policy_platform_\" + suffix\n\tif _, err = admin.ExecContext(ctx, \"CREATE DATABASE `\"+name+\"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.DBName = name\n\tconnector, _ = mysql.NewConnector(c)\n\troot := sql.OpenDB(connector)\n\troot.SetMaxOpenConns(4)\n\tf := &fixtureDB{t: t, ctx: ctx, root: root, name: name}\n\tt.Cleanup(func() { root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\"); root.Close() })\n\tf.php(\"init\")\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\tuser := \"bxchat_test_s06_\" + suffix\n\tf.user = user\n\tf.exec(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY 's05-fixture-only'\")\n\tt.Cleanup(func() { root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\") })\n\tfor _, table := range []string{\"users\", \"login_sessions\", \"chat_policy_guards\", \"chat_business_events\", \"chat_staff_authority_versions\", \"wechat_identities\", \"chat_admin_sessions\", \"chat_mini_auditors\"} {\n\t\tf.exec(\"GRANT SELECT ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tfor _, table := range []string{\"chat_conversations\", \"chat_members\", \"chat_member_intervals\", \"chat_event_receipts\", \"chat_restrictions\", \"chat_send_intents\", \"chat_messages\", \"chat_message_changes\", \"chat_text_checks\", \"chat_risk_events\", \"chat_member_reads\", \"chat_user_preferences\", \"chat_preference_accounts\", \"chat_image_uploads\", \"chat_image_bundles\", \"chat_image_items\", \"chat_image_audit\", \"chat_image_objects\", \"chat_image_reports\", \"chat_audit_accounts\", \"chat_audit_snapshots\", \"chat_audit_snapshot_items\", \"chat_cases\", \"chat_reminder_events\", \"chat_reminder_clusters\", \"chat_reminder_budgets\", \"chat_reminder_intents\"} {\n\t\tf.exec(\"GRANT SELECT,INSERT,UPDATE,DELETE ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\tf.exec(\"GRANT SELECT,INSERT ON `\" + name + \"`.chat_governance_audit TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\tc.User = user\n\tc.Passwd = \"s05-fixture-only\"\n\tconnector, _ = mysql.NewConnector(c)\n\tf.goDB = sql.OpenDB(connector)\n\tf.goDB.SetMaxOpenConns(4)\n\tt.Cleanup(func() { f.goDB.Close() })\n\tf.store, err = conversation.NewStore(f.goDB, \"test\", 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, actor := range []string{\"10201\", \"10202\", \"10203\"} {\n\t\tf.exec(`INSERT INTO login_sessions(id,user_id,token_hash,status,expires_at,created_at) VALUES(?,?,?,'active',UTC_TIMESTAMP()+INTERVAL 1 HOUR,UTC_TIMESTAMP())`, actor, actor, digest(\"login:\"+actor))\n\t}\n\treturn f\n}\nfunc (f *fixtureDB) exec(q string, args ...any) {\n\tf.t.Helper()\n\tif _, err := f.root.ExecContext(f.ctx, q, args...); err != nil {\n\t\tf.t.Fatal(\"fixture SQL\", err)\n\t}\n}\nfunc (f *fixtureDB) text(q string, args ...any) string {\n\tf.t.Helper()\n\tvar s string\n\tif err := f.root.QueryRowContext(f.ctx, q, args...).Scan(&s); err != nil {\n\t\tf.t.Fatal(err)\n\t}\n\treturn s\n}\nfunc (f *fixtureDB) php(action string, args ...string) {\n\tf.t.Helper()\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tf.t.Fatal(\"explicit PHP required\")\n\t}\n\tpath, _ := filepath.Abs(\"../../../server/tests/chat_platform_fixture.php\")\n\tcmd := exec.CommandContext(f.ctx, php, append([]string{path, action}, args...)...)\n\tcmd.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+f.name)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil || strings.TrimSpace(string(out)) != \"committed\" {\n\t\tf.t.Fatalf(\"real PHP %s: %s\", action, out)\n\t}\n}\nfunc principal(actor string) ports.Principal {\n\treturn ports.Principal{ActorID: ports.ID(actor), SourceID: ports.ID(actor), Kind: \"mini\", Environment: \"test\", Scopes: []string{\"chat:use\"}, SessionID: digest(\"mini\\n\" + actor + \"\\n\" + digest(\"login:\"+actor)), SessionVersion: digest(\"mini-v1\\n\" + actor + \"\\n\" + digest(\"login:\"+actor) + \"\\n\" + actor), ExpiresAt: time.Now().Add(time.Minute)}\n}\n\ntype safetyFunc func(context.Context, ports.TextRequest) (ports.SafetyResult, error)\n\nfunc (f safetyFunc) CheckText(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\treturn f(ctx, r)\n}\nfunc pass(_ context.Context, _ ports.TextRequest) (ports.SafetyResult, error) {\n\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: \"s06-fixture-v1\"}, nil\n}\nfunc setupMessage(t *testing.T, safety ports.Safety) (*fixtureDB, *Service, Request) {\n\tt.Helper()\n\tf := newFixture(t)\n\tb, e := f.store.Poll(f.ctx, 100)\n\tif e != nil || b.Applied < 1 {\n\t\tt.Fatalf(\"projection %+v %v\", b, e)\n\t}\n\tid, e := f.store.FindOrder(f.ctx, principal(\"10202\"), \"401\", \"401\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ts, e := NewService(f.goDB, f.store, safety, 3*time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tr := request(1)\n\tr.ConversationID = id\n\treturn f, s, r\n}\nfunc accepted(t *testing.T, s *Service, r Request) Result {\n\tt.Helper()\n\tout, e := s.Send(context.Background(), principal(\"10202\"), r)\n\tif e != nil || out.State != \"accepted\" {\n\t\tt.Fatalf(\"send %+v %v\", out, e)\n\t}\n\treturn out\n}\nfunc noMessages(t *testing.T, f *fixtureDB) {\n\tt.Helper()\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"0\" || f.text(\"SELECT SUM(last_seq+last_change_seq) FROM chat_conversations\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_message_changes\") != \"0\" {\n\t\tt.Fatal(\"rejected/checking action published state\")\n\t}\n}\nfunc TestMySQLSendIdempotencyAndSafeResult(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tout := accepted(t, s, r)\n\tif out.Seq != \"1\" || out.PolicyVersion != \"1\" {\n\t\tt.Fatalf(\"wrong seq/version %+v\", out)\n\t}\n\tagain := accepted(t, s, r)\n\tif again.MessageID != out.MessageID {\n\t\tt.Fatal(\"duplicate message\")\n\t}\n\taltered := r\n\taltered.Text += \" changed\"\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), altered); e != ErrConflict {\n\t\tt.Fatalf(\"conflict %v\", e)\n\t}\n\tif f.text(\"SELECT text_body FROM chat_messages WHERE id=?\", string(out.MessageID)) != r.Text {\n\t\tt.Fatal(\"body changed\")\n\t}\n\tf.exec(\"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\tif got, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID); e != nil || got.MessageID != out.MessageID {\n\t\tt.Fatalf(\"ban prevented original result %+v %v\", got, e)\n\t}\n\tif got := accepted(t, s, r); got.MessageID != out.MessageID {\n\t\tt.Fatal(\"ban retry re-sent\")\n\t}\n\tnewer := r\n\tnewer.ClientMessageID = client(2)\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), newer); e != ErrRestricted {\n\t\tt.Fatalf(\"ban bypass %v\", e)\n\t}\n\tf.exec(\"UPDATE chat_messages SET state='recalled',state_version=2 WHERE id=?\", string(out.MessageID))\n\tgot, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID)\n\tif e != nil || got.MessageState != \"recalled\" || got.StateVersion != \"2\" {\n\t\tt.Fatalf(\"unsafe state %+v %v\", got, e)\n\t}\n\tf.php(\"close\")\n\tif _, e = f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif got, e = s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID); e != nil || got.MessageID != out.MessageID {\n\t\tt.Fatalf(\"closure lost result %+v %v\", got, e)\n\t}\n\tif _, e = s.Query(f.ctx, principal(\"10203\"), r.ConversationID, r.ClientMessageID); e != ErrUnknown {\n\t\tt.Fatalf(\"other author result leaked %v\", e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"retries published again\")\n\t}\n}\nfunc TestMySQLUnavailableAndBlockedDoNotPublish(t *testing.T) {\n\tfor _, mode := range []string{\"unavailable\", \"blocked\", \"malformed\"} {\n\t\tt.Run(mode, func(t *testing.T) {\n\t\t\tf, s, r := setupMessage(t, safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\t\t\tif mode == \"unavailable\" {\n\t\t\t\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif mode == \"malformed\" {\n\t\t\t\t\treturn ports.SafetyResult{Decision: \"passed\"}, nil\n\t\t\t\t}\n\t\t\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: \"fixture\", Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: \"fixture_blocked\", Level: 2, Confirmed: true}}, nil\n\t\t\t}))\n\t\t\tout, e := s.Send(f.ctx, principal(\"10202\"), r)\n\t\t\tif mode == \"blocked\" {\n\t\t\t\tif e != nil || out.State != \"rejected\" || out.Code != ErrBlocked.Error() {\n\t\t\t\t\tt.Fatalf(\"blocked %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t} else if e != ErrCheck {\n\t\t\t\tt.Fatalf(\"fail-open %+v %v\", out, e)\n\t\t\t}\n\t\t\tnoMessages(t, f)\n\t\t\tgot, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, r.ClientMessageID)\n\t\t\tif e != nil || got.State == \"accepted\" {\n\t\t\t\tt.Fatalf(\"result %+v %v\", got, e)\n\t\t\t}\n\t\t\tif f.text(\"SELECT COUNT(*) FROM chat_send_intents WHERE retain_until>=action_expires_at+INTERVAL 30 DAY\") != \"1\" {\n\t\t\t\tt.Fatal(\"retention\")\n\t\t\t}\n\t\t\tif mode != \"blocked\" {\n\t\t\t\ts.safety = safetyFunc(pass)\n\t\t\t\taccepted(t, s, r)\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestMySQLFinalRevalidationAndSequenceOrder(t *testing.T) {\n\tfor _, change := range []string{\"ban\", \"close\", \"logout\", \"user-inactive\", \"staff-revoke\"} {\n\t\tt.Run(change, func(t *testing.T) {\n\t\t\tvar f *fixtureDB\n\t\t\tsafety := safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\t\t\t// Every operation commits while the inspector is running, proving no\n\t\t\t\t// long authority/conversation transaction is held over external calls.\n\t\t\t\tswitch change {\n\t\t\t\tcase \"ban\":\n\t\t\t\t\tf.exec(\"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\t\t\t\tcase \"close\":\n\t\t\t\t\tf.php(\"close\")\n\t\t\t\tcase \"logout\":\n\t\t\t\t\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\t\t\t\tcase \"user-inactive\":\n\t\t\t\t\tf.exec(\"UPDATE users SET status='disabled' WHERE id=10202\")\n\t\t\t\tcase \"staff-revoke\":\n\t\t\t\t\tf.exec(\"UPDATE users SET status='disabled' WHERE id=10203\")\n\t\t\t\t}\n\t\t\t\treturn pass(context.Background(), ports.TextRequest{})\n\t\t\t})\n\t\t\tvar s *Service\n\t\t\tvar r Request\n\t\t\tf, s, r = setupMessage(t, safety)\n\t\t\tif out, e := s.Send(f.ctx, principal(\"10202\"), r); e == nil && out.State == \"accepted\" {\n\t\t\t\tt.Fatal(\"changed authority published\")\n\t\t\t}\n\t\t\tnoMessages(t, f)\n\t\t})\n\t}\n\t// A slow checked message does not reserve seq. A later fast message commits\n\t// first; a retry of the slow action observes its single accepted identity.\n\tentered := make(chan struct{})\n\trelease := make(chan struct{})\n\tf, s, r := setupMessage(t, safetyFunc(func(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\t\tif r.Text == \"slow\" {\n\t\t\tclose(entered)\n\t\t\tselect {\n\t\t\tcase <-release:\n\t\t\tcase <-ctx.Done():\n\t\t\t\treturn ports.SafetyResult{}, ctx.Err()\n\t\t\t}\n\t\t}\n\t\treturn pass(ctx, r)\n\t}))\n\tslow := r\n\tslow.Text = \"slow\"\n\tdone := make(chan Result, 1)\n\terrs := make(chan error, 1)\n\tgo func() { out, e := s.Send(f.ctx, principal(\"10202\"), slow); done <- out; errs <- e }()\n\t<-entered\n\tconcurrent, e := s.Send(f.ctx, principal(\"10202\"), slow)\n\tif e != nil || concurrent.State != \"checking\" {\n\t\tt.Fatalf(\"concurrent retry %+v %v\", concurrent, e)\n\t}\n\tfast := r\n\tfast.ClientMessageID = client(2)\n\tfast.Text = \"fast\"\n\tfirst := accepted(t, s, fast)\n\tif first.Seq != \"1\" {\n\t\tt.Fatal(\"slow reserved seq\")\n\t}\n\tclose(release)\n\tsecond := <-done\n\tif e := <-errs; e != nil || second.Seq != \"2\" {\n\t\tt.Fatalf(\"commit order %+v %v\", second, e)\n\t}\n\tif got := accepted(t, s, slow); got.MessageID != second.MessageID {\n\t\tt.Fatal(\"double-send\")\n\t}\n\tif f.text(\"SELECT CONCAT(last_seq,':',last_change_seq,':',last_message_id) FROM chat_conversations WHERE id=?\", string(r.ConversationID)) != \"2:2:\"+string(second.MessageID) {\n\t\tt.Fatal(\"summary not atomic\")\n\t}\n}\nfunc TestMySQLExpiredIDsAndLeaseOwner(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\texpired := r\n\texpired.ClientMessageID = fmt.Sprintf(\"%d.%032x\", time.Now().Add(-25*time.Hour).Unix(), 1)\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), expired); e != ErrExpired {\n\t\tt.Fatalf(\"expired ID accepted %v\", e)\n\t}\n\tif _, e := s.Query(f.ctx, principal(\"10202\"), expired.ConversationID, expired.ClientMessageID); e != ErrExpired {\n\t\tt.Fatalf(\"missing expired result %v\", e)\n\t}\n\tnoMessages(t, f)\n\t// Simulate takeover while old inspector is outstanding. Old token cannot\n\t// accept even though it obtained a positive safety result.\n\ts.safety = safetyFunc(func(ctx context.Context, r ports.TextRequest) (ports.SafetyResult, error) {\n\t\tf.exec(\"UPDATE chat_send_intents SET lease_owner=REPEAT('f',32) WHERE id=?\", string(r.IntentID))\n\t\treturn pass(ctx, r)\n\t})\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrBusy {\n\t\tt.Fatalf(\"old lease published %v\", e)\n\t}\n\tnoMessages(t, f)\n\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND\")\n\ts.safety = safetyFunc(pass)\n\taccepted(t, s, r)\n}\n\nfunc TestMySQLPublicationRollbackAndStableRestrictionLock(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\tf.exec(\"CREATE TRIGGER s06_reject_change BEFORE INSERT ON chat_message_changes FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='isolated rollback test'\")\n\tif _, e := s.Send(f.ctx, principal(\"10202\"), r); e != ports.ErrUnavailable {\n\t\tt.Fatalf(\"forced rollback %v\", e)\n\t}\n\tnoMessages(t, f)\n\tf.exec(\"DROP TRIGGER s06_reject_change\")\n\tf.exec(\"UPDATE chat_send_intents SET lease_until=UTC_TIMESTAMP()-INTERVAL 1 SECOND\")\n\tif out := accepted(t, s, r); out.Seq != \"1\" {\n\t\tt.Fatal(\"rollback consumed seq\")\n\t}\n\t// Even an unrestricted actor has a stable row locked through commit. A\n\t// concurrent ban cannot commit until this final-authorization tx releases it.\n\ttx, e := s.begin(f.ctx)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\tif _, e = s.authorize(f.ctx, tx, principal(\"10202\"), r.ConversationID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tblocked := make(chan error, 1)\n\tgo func() {\n\t\t_, e := f.root.ExecContext(f.ctx, \"UPDATE chat_restrictions SET permanent=1,version=version+1 WHERE actor_id=10202\")\n\t\tblocked <- e\n\t}()\n\tselect {\n\tcase e := <-blocked:\n\t\tt.Fatalf(\"ban escaped stable row lock: %v\", e)\n\tcase <-time.After(100 * time.Millisecond):\n\t}\n\tif e = tx.Commit(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = <-blocked; e != nil {\n\t\tt.Fatal(e)\n\t}\n\tr.ClientMessageID = client(3)\n\tif _, e = s.Send(f.ctx, principal(\"10202\"), r); e != ErrRestricted {\n\t\tt.Fatalf(\"new ban not authoritative %v\", e)\n\t}\n}\n\nfunc TestMySQLResultDoesNotOutliveCredential(t *testing.T) {\n\tf, s, r := setupMessage(t, safetyFunc(pass))\n\taccepted(t, s, r)\n\ttx, e := f.root.BeginTx(f.ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer tx.Rollback()\n\tif _, e = tx.ExecContext(f.ctx, \"UPDATE chat_send_intents SET updated_at=updated_at WHERE conversation_id=?\", string(r.ConversationID)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tp := principal(\"10202\")\n\tp.ExpiresAt = time.Now().Add(300 * time.Millisecond)\n\tdone := make(chan error, 1)\n\tgo func() { _, e := s.Query(f.ctx, p, r.ConversationID, r.ClientMessageID); done <- e }()\n\ttimer := time.NewTimer(400 * time.Millisecond)\n\tdefer timer.Stop()\n\t<-timer.C\n\tif e = tx.Commit(); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = <-done; e == nil {\n\t\tt.Fatal(\"result released after credential expired\")\n\t}\n\t// An old nonterminal intent can never remain actionable, even before cleanup.\n\told := fmt.Sprintf(\"%d.%032x\", time.Now().Add(-25*time.Hour).Unix(), 9)\n\tf.exec(\"INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,attempts,action_expires_at,retain_until,created_at,updated_at) VALUES(10202,?,?,REPEAT('a',64),'retryable',1,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()+INTERVAL 30 DAY,UTC_TIMESTAMP(),UTC_TIMESTAMP())\", string(r.ConversationID), old)\n\tout, e := s.Query(f.ctx, principal(\"10202\"), r.ConversationID, old)\n\tif e != nil || out.State != \"rejected\" || out.Code != ErrExpired.Error() {\n\t\tt.Fatalf(\"expired nonterminal result %+v %v\", out, e)\n\t}\n}\n","chat/internal/message/read_progress.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"crypto/subtle\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc memberHash(key string) string {\n\tsum := sha256.Sum256([]byte(key))\n\treturn hex.EncodeToString(sum[:])\n}\n\n// Acknowledge is the only read-watermark writer. A locate/history cursor, an\n// unfinished sync page, an expired token or a different login cannot mark read.\n// The token is a proof of an S08 server-committed contiguous sync position;\n// the UI must still call this only after explicitly reading to that position.\nfunc (s *HistoryService) Acknowledge(ctx context.Context, p ports.Principal, id ports.ID, cursor string) (ports.ID, error) {\n\tif !validID(id) || !p.ActorID.Valid() || p.Environment != s.environment {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tc, err := s.parse(cursor, \"sync\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif c.Binding != bindingFor(s.environment, p) || c.Conversation != id || c.Pending || c.Position != c.Seq {\n\t\treturn \"\", ErrResync\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, err := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, err := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\t// This must happen inside the same locked transaction as the actual write.\n\tif g.Version != c.Policy || g.MemberKey != c.Member {\n\t\treturn \"\", ErrResync\n\t}\n\tvar upper, floor uint64\n\tif err = tx.QueryRowContext(ctx, `SELECT last_seq,sync_floor_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&upper, &floor); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\ttarget := number(c.Seq)\n\tif target > upper || target < floor {\n\t\treturn \"\", ErrResync\n\t}\n\thash := memberHash(g.MemberKey)\n\t// A row is created only for an explicit acknowledgement, never for an\n\t// unread query or a conversation summary.\n\t_, err = tx.ExecContext(ctx, `INSERT INTO chat_member_reads\n\t\t(conversation_id,actor_id,member_key_hash,read_seq,updated_at)\n\t\tVALUES(?,?,?,0,UTC_TIMESTAMP(6))\n\t\tON DUPLICATE KEY UPDATE actor_id=actor_id`, string(id), string(p.ActorID), hash)\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tvar storedHash string\n\tvar current uint64\n\terr = tx.QueryRowContext(ctx, `SELECT member_key_hash,read_seq FROM chat_member_reads\n\t\tWHERE conversation_id=? AND actor_id=? FOR UPDATE`, string(id), string(p.ActorID)).Scan(&storedHash, &current)\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif subtle.ConstantTimeCompare([]byte(storedHash), []byte(hash)) != 1 {\n\t\tcurrent = 0\n\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_member_reads SET member_key_hash=?,read_seq=0,updated_at=UTC_TIMESTAMP(6)\n\t\t\tWHERE conversation_id=? AND actor_id=?`, hash, string(id), string(p.ActorID))\n\t\tif err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t}\n\tif target > current {\n\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_member_reads SET read_seq=?,updated_at=UTC_TIMESTAMP(6)\n\t\t\tWHERE conversation_id=? AND actor_id=?`, target, string(id), string(p.ActorID))\n\t\tif err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t\tcurrent = target\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn \"\", policy.ErrDenied\n\t}\n\tif err = tx.Commit(); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn decimal(current), nil\n}\n","chat/internal/message/realtime_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\"fmt\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/gorilla/websocket\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\nfunc TestMySQLRedisS11PostCommitPushAndMissedHintRecovery(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 0)\n\trdb := redis.NewClient(&redis.Options{Addr: os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\"), PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, DisableIdentity: true, Protocol: 2})\n\tdefer rdb.Close()\n\tstore, e := auth.NewRedisStore(rdb, \"test\", \"bxchat:test:\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\tv, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"s11\": pub})\n\tsrc, _ := auth.NewMySQLSource(f.goDB)\n\tidentity, _ := auth.NewService(v, src, store, 4, time.Second)\n\tcommands := &SocketCommands{History: h}\n\tg, e := socket.NewWithPolicy(identity, commands, f.store)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcommands.Sender = s.WithPublisher(g)\n\tserver := httptest.NewServer(g)\n\tdefer server.Close()\n\tdefer func() {\n\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)\n\t\tdefer cancel()\n\t\tif e := g.Shutdown(ctx); e != nil {\n\t\t\tt.Error(e)\n\t\t}\n\t}()\n\tlogin := func(actor string) *websocket.Conn {\n\t\tt.Helper()\n\t\tp := principal(actor)\n\t\tnow := time.Now().Unix()\n\t\tc := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: p.Environment, Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\t\traw, _ := json.Marshal(c)\n\t\tunsigned := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"s11\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(raw)\n\t\ttoken := unsigned + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(unsigned)))\n\t\tticket, _, e := identity.IssueTicket(f.ctx, token)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tws, _, e := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tt.Cleanup(func() { ws.Close() })\n\t\tws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"auth\", \"type\": \"auth\", \"payload\": map[string]string{\"ticket\": ticket}})\n\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\tvar out map[string]any\n\t\tif e := ws.ReadJSON(&out); e != nil || out[\"type\"] != \"auth.ok\" {\n\t\t\tt.Fatalf(\"auth %v %v\", out, e)\n\t\t}\n\t\treturn ws\n\t}\n\trecipient := login(\"10203\")\n\tboot, e := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tresult, e := commands.Sender.Send(f.ctx, principal(\"10202\"), q)\n\tif e != nil || result.State != \"accepted\" {\n\t\tt.Fatal(result, e)\n\t}\n\tvar hint struct {\n\t\tType    string `json:\"type\"`\n\t\tPayload struct {\n\t\t\tConversationID ports.ID `json:\"conversation_id\"`\n\t\t\tSeq            ports.ID `json:\"highest_seq\"`\n\t\t} `json:\"payload\"`\n\t}\n\trecipient.SetReadDeadline(time.Now().Add(5 * time.Second))\n\tif e := recipient.ReadJSON(&hint); e != nil || hint.Type != \"message.new\" || hint.Payload.Seq != \"1\" {\n\t\tt.Fatalf(\"postcommit %v %+v\", e, hint)\n\t}\n\t// The row is already visible when the hint arrives; hints never invent seq.\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages WHERE id=?\", string(result.MessageID)) != \"1\" {\n\t\tt.Fatal(\"hint before commit\")\n\t}\n\trecipient.Close()\n\tq.ClientMessageID = client(2)\n\tsecond := accepted(t, commands.Sender, q)\n\t// No live connection observed the second hint. The original signed cursor\n\t// still recovers both messages and the independent changes stream.\n\tpage, e := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: boot.SyncCursor}, \"sync\")\n\tif e != nil || len(page.Messages) != 2 || page.Messages[1].ID != second.MessageID {\n\t\tt.Fatal(\"lost hint lost data\", e)\n\t}\n\tchanges, e := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: boot.ChangeCursor}, \"changes\")\n\tif e != nil || len(changes.Changes) != 2 {\n\t\tt.Fatal(\"change recovery\", e)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != \"0\" {\n\t\tt.Fatal(\"delivery/sync automatically marked read\")\n\t}\n\t// Retries query/return the committed result and do not publish another row.\n\taccepted(t, commands.Sender, q)\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"2\" {\n\t\tt.Fatal(\"retry duplicated publication\")\n\t}\n\trecipient = login(\"10203\")\n\trecipient.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"focus\", \"type\": \"conversation.focus\", \"payload\": map[string]any{\"conversation_id\": q.ConversationID}})\n\tvar frame map[string]any\n\tfor {\n\t\tif e := recipient.ReadJSON(&frame); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif frame[\"request_id\"] == \"focus\" {\n\t\t\tbreak\n\t\t}\n\t}\n\t// A recall emits a body-free state wakeup and recovers through the same\n    // original change cursor even if this device misses that wakeup.\n    if _,e:=commands.Sender.Recall(f.ctx,principal(\"10202\"),q.ConversationID,result.MessageID);e!=nil{t.Fatal(e)}\n    for{\n        if e:=recipient.ReadJSON(&frame);e!=nil{t.Fatal(e)}\n        if frame[\"type\"]==\"message.changed\"{if strings.Contains(fmt.Sprint(frame),\"text-\"){t.Fatal(\"recall hint body\")};break}\n    }\n    recovered,e:=h.Read(f.ctx,principal(\"10203\"),HistoryRequest{ConversationID:q.ConversationID,Cursor:changes.ChangeCursor},\"changes\")\n    if e!=nil||len(recovered.Changes)!=1||recovered.Changes[0].Message.State!=\"recalled\"||recovered.Changes[0].Message.Text!=nil{t.Fatal(\"recall reconnect recovery\",recovered,e)}\n    // Drain the paired account wakeup before the stale-authorization barrier.\n    for{if e:=recipient.ReadJSON(&frame);e!=nil{t.Fatal(e)};if frame[\"type\"]==\"account.summary.changed\"{break}}\n\t// A stale projected membership is only a candidate, never permission.\n\tf.exec(\"UPDATE chat_policy_guards SET policy_version=policy_version+1 WHERE order_id=401\")\n\tg.Committed(ports.CommittedMessage{ConversationID: q.ConversationID, Seq: \"2\", PolicyVersion: \"1\"})\n\trecipient.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"barrier\", \"type\": \"ping\", \"payload\": map[string]string{\"nonce\": \"done\"}})\n\trecipient.SetReadDeadline(time.Now().Add(5 * time.Second))\n\tfor {\n\t\tif e := recipient.ReadJSON(&frame); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif frame[\"request_id\"] == \"server\" && frame[\"type\"] == \"presence.changed\" {\n\t\t\tcontinue\n\t\t}\n\t\tif frame[\"type\"] != \"pong\" {\n\t\t\tt.Fatal(\"stale membership leaked\", frame)\n\t\t}\n\t\tbreak\n\t}\n}\n","chat/internal/message/risk.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Optional real-safety finalizer: after PHP authority/current login, before\n// stable account restriction/conversation locks. It must never do network I/O.\ntype finalSafety interface {\n\tValidateTextLocked(context.Context, *sql.Tx, ports.Principal, ports.SafetyResult) error\n}\n\nvar riskCodePattern = regexp.MustCompile(`^[a-z][a-z0-9_]{1,47}$`)\nvar riskTracePattern = regexp.MustCompile(`^[A-Za-z0-9_-]{0,128}$`)\n\nfunc terminal(state string) bool {\n\treturn state == \"accepted\" || state == \"rejected\" || state == \"review_pending\"\n}\nfunc validFinding(r ports.SafetyResult) bool {\n\tf := r.Finding\n\treturn f != nil && (f.Provider == \"local.anti_diversion\" || f.Provider == \"wechat.msg_sec_check.v2\") && riskCodePattern.MatchString(f.Code) && riskTracePattern.MatchString(f.TraceID) && len(f.ContextEvidence) <= 40<<10 && (f.ContextEvidence == \"\" || json.Valid([]byte(f.ContextEvidence))) &&\n\t\t((r.Decision == \"blocked\" && f.Level == 2 && f.Confirmed) || (r.Decision == \"review\" && f.Level == 1 && !f.Confirmed))\n}\n\n// Risk evidence and the author's terminal result commit atomically. A late\n// inspector/expired owner cannot create risk, increment counts or publish.\nfunc (s *Service) reject(ctx context.Context, p ports.Principal, r Request, fp string, id ports.ID, owner string, checked ports.SafetyResult) (Result, error) {\n\tif !validFinding(checked) || !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, ErrCheck\n\t}\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\t// Rejections also use the canonical authority -> identity -> restriction ->\n\t// conversation -> intent order. An inspection completed after revocation\n\t// must not create a confirmed violation under the old authority.\n\tif _, e = s.authorize(ctx, tx, p, r.ConversationID, checked); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar intent string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_send_intents WHERE id=? AND sender_id=? AND conversation_id=? AND fingerprint=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(id), string(p.ActorID), string(r.ConversationID), fp, owner).Scan(&intent)\n\tif e == sql.ErrNoRows {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tf := checked.Finding\n\tstate, code := \"rejected\", ErrBlocked.Error()\n\tif checked.Decision == \"review\" {\n\t\tstate, code = \"review_pending\", \"CHAT_REVIEW_PENDING\"\n\t}\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_risk_events(intent_id,sender_id,conversation_id,content_fingerprint,rule_version,provider,reason_code,provider_trace,risk_level,confirmed,disposition,review_state,text_evidence,context_evidence,retain_until,created_at)\n SELECT id,sender_id,conversation_id,fingerprint,?,?,?,?,?,?,?,'open',?,?,retain_until,UTC_TIMESTAMP(6) FROM chat_send_intents WHERE id=?`, checked.RuleVersion, f.Provider, f.Code, f.TraceID, f.Level, f.Confirmed, state, r.Text, f.ContextEvidence, intent)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tn, e := res.LastInsertId()\n\tif e != nil || n <= 0 {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\trisk := ports.ID(strconv.FormatInt(n, 10))\n\tif _, e = createCase(ctx, tx, \"review\", \"risk\", risk, \"0\", r.ConversationID, p.ActorID, p.ActorID, \"1\", fp, \"内容安全待复核\"); e != nil {\n\t\treturn Result{}, e\n\t}\n\tres, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=?,risk_event_id=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, state, code, string(risk), intent, owner)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tchanged, e := res.RowsAffected()\n\tif e != nil || changed != 1 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, ErrCheck\n\t}\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\treturn Result{ClientMessageID: r.ClientMessageID, State: state, Code: code, RiskEventID: risk}, nil\n}\n","chat/internal/message/s09_completion_integration_test.go":"package message\n\nimport (\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestMySQLS09LargeUnreadCapAndRealFirstAnchor(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 100000)\n\tf.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=?`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET sender_id=10202 WHERE conversation_id=? AND seq<=10`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=20`, string(r.ConversationID))\n\tu, e := h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 1000 || !u.CountCapped || u.FirstSeq != \"11\" {\n\t\tt.Fatalf(\"bounded unread %+v %v\", u, e)\n\t}\n\tlocated := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID, TargetID: u.FirstMessage}, \"locate\")\n\tif len(located.Messages) > 30 {\n\t\tt.Fatal(\"anchor expanded history\")\n\t}\n\tif f.text(`SELECT COUNT(*) FROM chat_member_reads`) != \"0\" {\n\t\tt.Fatal(\"unread/anchor wrote read receipt\")\n\t}\n\tboot := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID}, \"bootstrap\")\n\tproof, e := h.parse(boot.SyncCursor, \"sync\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tproof.Seq = \"99000\"\n\tproof.Position = \"99000\"\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, h.sign(proof)); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tu, e = h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 1000 || u.CountCapped || u.FirstSeq != \"99001\" {\n\t\tt.Fatalf(\"exact count at cap %+v %v\", u, e)\n\t}\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, boot.SyncCursor); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tu, e = h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 0 || u.CountCapped || u.ReadSeq != \"100000\" {\n\t\tt.Fatal(u, e)\n\t}\n}\n\nfunc TestMySQLS09UnreadHistoryGapAndRetainedAcknowledgement(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 6)\n\tf.php(\"close\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tf.php(\"repair\")\n\tif _, e := f.store.Poll(f.ctx, 100); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tf.exec(`DELETE FROM chat_member_intervals WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version,end_version) SELECT conversation_id,actor_id,member_key,1,2 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`INSERT INTO chat_member_intervals(conversation_id,actor_id,member_key,start_version) SELECT conversation_id,actor_id,member_key,3 FROM chat_members WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tf.exec(`UPDATE chat_messages SET sender_id=10203,policy_version=CASE WHEN seq IN(2,5) THEN 2 WHEN seq IN(4,6) THEN 3 ELSE 1 END WHERE conversation_id=?`, string(r.ConversationID))\n\tu, e := h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.Count != 4 || u.FirstSeq != \"1\" {\n\t\tt.Fatal(\"gap counted\", u, e)\n\t}\n\tboot := readPage(t, h, HistoryRequest{ConversationID: r.ConversationID}, \"bootstrap\")\n\tproof, _ := h.parse(boot.SyncCursor, \"sync\")\n\tproof.Pending = true\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, h.sign(proof)); e != ErrResync {\n\t\tt.Fatal(\"unfinished sync acknowledged\", e)\n\t}\n\tproof.Pending = false\n\tproof.Seq = \"1\"\n\tproof.Position = \"1\"\n\tf.exec(`UPDATE chat_conversations SET sync_floor_seq=2 WHERE id=?`, string(r.ConversationID))\n\tif _, e = h.Acknowledge(f.ctx, principal(\"10202\"), r.ConversationID, h.sign(proof)); e != ErrResync {\n\t\tt.Fatal(\"obsolete retained proof acknowledged\", e)\n\t}\n\tif f.text(`SELECT COUNT(*) FROM chat_member_reads`) != \"0\" {\n\t\tt.Fatal(\"invalid proof wrote read state\")\n\t}\n}\n\nfunc TestMySQLS09SlowBodyStopsWithinReadBudget(t *testing.T) {\n\t_, _, h, _ := historyFixture(t, 0)\n\th.timeout = 100 * time.Millisecond\n\thandler, e := NewHistoryHandler(h, historyFixtureIdentity{}, 2)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tserver := httptest.NewServer(handler)\n\tdefer server.Close()\n\treader, writer := io.Pipe()\n\tdefer reader.Close()\n\tdefer writer.Close()\n\trequest, _ := http.NewRequest(\"POST\", server.URL+\"/chat/api/v1/conversations/unread\", reader)\n\trequest.Header.Set(\"Authorization\", \"Bearer fixture-only\")\n\trequest.Header.Set(\"Content-Type\", \"application/json\")\n\tclient := server.Client()\n\tclient.Timeout = 2 * time.Second\n\tstart := time.Now()\n\tresponse, e := client.Do(request)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer response.Body.Close()\n\tif response.StatusCode != 408 || time.Since(start) > time.Second {\n\t\tt.Fatal(\"slow body exceeded budget\", response.StatusCode, time.Since(start))\n\t}\n}\n\nfunc TestMySQLS12DigestActivityUsesVisibleMessageTime(t *testing.T) {\n\tf, _, h, r := historyFixture(t, 3)\n\tf.exec(`UPDATE chat_messages SET created_at=CASE seq WHEN 1 THEN '2026-10-01 10:00:00' WHEN 2 THEN '2026-10-01 11:00:00' ELSE '2026-10-01 12:00:00' END WHERE conversation_id=?`, string(r.ConversationID))\n\tu, e := h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.LastMessageAt == nil || u.LastMessageAt.Format(time.RFC3339) != \"2026-10-01T12:00:00Z\" || u.Count != 0 {\n\t\tt.Fatal(\"own/read messages still determine activity\", u, e)\n\t}\n\tif u.LastMessage==nil||u.LastMessage.Text==nil||*u.LastMessage.Text!=\"fixture-3\"||u.OrderContext==nil||u.OrderContext.PublicNo!=\"CHAT-PLATFORM-401\"||u.MemberRole!=\"worker\" {t.Fatal(\"untrusted or missing preview/context\",u)}\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n if boot.OrderContext==nil||boot.ViewerID!=\"10202\"||boot.MemberRole!=\"worker\"{t.Fatal(\"missing native page context\",boot)}\n f.exec(`UPDATE chat_messages SET state='recalled',text_body='must-not-leak' WHERE conversation_id=? AND seq=3`, string(r.ConversationID))\n\tpage, e := h.Digests(f.ctx, principal(\"10202\"), \"0\", 20)\n\tif e != nil || len(page.Items) != 1 || page.Items[0].Unread.LastMessageAt == nil || !page.Items[0].Unread.LastMessageAt.Equal(*u.LastMessageAt) {\n\t\tt.Fatal(\"digest exposes recall activity without a body\", page, e)\n\t}\n\tif page.Items[0].Unread.LastMessage==nil||page.Items[0].Unread.LastMessage.Text!=nil||page.Items[0].Unread.LastMessage.State!=\"recalled\"{t.Fatal(\"recall original leaked in preview\",page)}\n // A message outside every authorized membership interval cannot affect sorting.\n\tf.exec(`UPDATE chat_member_intervals SET end_version=1 WHERE conversation_id=? AND actor_id=10202`, string(r.ConversationID))\n\tu, e = h.Unread(f.ctx, principal(\"10202\"), r.ConversationID)\n\tif e != nil || u.LastMessageAt != nil || u.LastMessage != nil {\n\t\tt.Fatal(\"hidden activity leaked\", u, e)\n\t}\n\tif f.text(`SELECT COUNT(*) FROM chat_member_reads`) != \"0\" {\n\t\tt.Fatal(\"inbox ordering wrote a read receipt\")\n\t}\n}\n","chat/internal/message/s09_http.go":"package message\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype s09Request struct {\n\tConversationID ports.ID `json:\"conversation_id,omitempty\"`\n\tCursor         string   `json:\"cursor,omitempty\"`\n\tLimit          int      `json:\"limit,omitempty\"`\n}\n\nfunc decodeS09(raw []byte) (s09Request, error) {\n\tvar q s09Request\n\tif !utf8.Valid(raw) {\n\t\treturn q, ports.ErrInvalid\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\tt, e := d.Token()\n\tif e != nil || t != json.Delim('{') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tv, e := d.Token()\n\t\tkey, ok := v.(string)\n\t\tif e != nil || !ok || seen[key] {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tseen[key] = true\n\t\tvar field json.RawMessage\n\t\tif d.Decode(&field) != nil {\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t\tswitch key {\n\t\tcase \"conversation_id\":\n\t\t\tif json.Unmarshal(field, &q.ConversationID) != nil {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\tcase \"cursor\":\n\t\t\tif len(field) < 2 || field[0] != '\"' || !validSurrogates(field) || json.Unmarshal(field, &q.Cursor) != nil || len(q.Cursor) > 2048 {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\tcase \"limit\":\n\t\t\tif len(field) == 0 || field[0] < '0' || field[0] > '9' || json.Unmarshal(field, &q.Limit) != nil {\n\t\t\t\treturn q, ports.ErrInvalid\n\t\t\t}\n\t\tdefault:\n\t\t\treturn q, ports.ErrInvalid\n\t\t}\n\t}\n\tt, e = d.Token()\n\tif e != nil || t != json.Delim('}') {\n\t\treturn q, ports.ErrInvalid\n\t}\n\tif _, e = d.Token(); e != io.EOF {\n\t\treturn q, ports.ErrInvalid\n\t}\n\treturn q, nil\n}\n\nfunc (h *HistoryHandler) serveS09(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tvar nonce [16]byte\n\t_, _ = rand.Read(nonce[:])\n\trequestID := hex.EncodeToString(nonce[:])\n\tw.Header().Set(\"X-Request-ID\", requestID)\n\tfail := func(status int, code string, retry bool) {\n\t\tw.WriteHeader(status)\n\t\tif r.Method != \"HEAD\" {\n\t\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": requestID, \"code\": code, \"retryable\": retry, \"server_time\": time.Now().UTC()})\n\t\t}\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\", false)\n\t\treturn\n\t}\n\tif r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tmedia, _, e := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif e != nil || media != \"application/json\" {\n\t\tfail(415, \"CHAT_CONTENT_TYPE_INVALID\", false)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error(), true)\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\treturn\n\t}\n\t// Public HTTP WriteTimeout is 5s; terminate bounded digest scans first.\n\tctx, cancel := context.WithTimeout(r.Context(), min(3*h.service.timeout, 4*time.Second))\n\tdefer cancel()\n\tcontroller := http.NewResponseController(w)\n\t_ = controller.SetReadDeadline(time.Now().Add(min(3*h.service.timeout, 4*time.Second)))\n\tb, e := io.ReadAll(http.MaxBytesReader(w, r.Body, 4096))\n\tif e != nil {\n\t\tw.Header().Set(\"Connection\", \"close\")\n\t\tvar large *http.MaxBytesError\n\t\tif errors.As(e, &large) {\n\t\t\tfail(413, \"CHAT_REQUEST_TOO_LARGE\", false)\n\t\t} else {\n\t\t\tfail(408, \"CHAT_REQUEST_TIMEOUT\", true)\n\t\t}\n\t\treturn\n\t}\n\t_ = controller.SetReadDeadline(time.Time{})\n\tvar q s09Request\n var preference PreferenceRequest\n var decodeErr error\n isPreference:=r.URL.Path==\"/chat/api/v1/conversations/preferences\"||r.URL.Path==\"/chat/api/v1/conversations/preference\"\n if isPreference { preference,decodeErr=decodePreference(b,r.URL.Path==\"/chat/api/v1/conversations/preference\") } else {q,decodeErr=decodeS09(b)}\n\tif decodeErr != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\treturn\n\t}\n\tp, e := h.identity.Authenticate(ctx, strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif e != nil {\n\t\tif errors.Is(e, auth.ErrUnauthorized) {\n\t\t\tfail(401, \"CHAT_UNAUTHORIZED\", false)\n\t\t} else {\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\tvar out any\n\tswitch r.URL.Path {\n case \"/chat/api/v1/conversations/preferences\":\n  out,e=h.service.Preferences(ctx,p,preference.ConversationID)\n case \"/chat/api/v1/conversations/preference\":\n  out,e=h.service.SetPreference(ctx,p,preference)\n\tcase \"/chat/api/v1/conversations/unread\":\n\t\tif !validID(q.ConversationID) || q.Cursor != \"\" || q.Limit != 0 {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\t\treturn\n\t\t}\n\t\tout, e = h.service.Unread(ctx, p, q.ConversationID)\n\tcase \"/chat/api/v1/conversations/read\":\n\t\tif !validID(q.ConversationID) || q.Cursor == \"\" || q.Limit != 0 {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\t\treturn\n\t\t}\n\t\tout, e = h.service.Acknowledge(ctx, p, q.ConversationID, q.Cursor)\n\tcase \"/chat/api/v1/conversations/digests\":\n\t\tif q.ConversationID != \"\" || q.Limit < 1 || q.Limit > 20 {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\t\treturn\n\t\t}\n\t\tout, e = h.service.DigestsCursor(ctx, p, q.Cursor, q.Limit)\n\tdefault:\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\", false)\n\t\treturn\n\t}\n\tif e != nil {\n\t\tswitch {\n\t\tcase errors.Is(e, ports.ErrInvalid):\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\", false)\n\t\tcase errors.Is(e, ErrPreferenceConflict),errors.Is(e,ErrPinLimit):\n   w.WriteHeader(409)\n   _=json.NewEncoder(w).Encode(map[string]any{\"request_id\":requestID,\"code\":e.Error(),\"retryable\":false,\"current\":out,\"server_time\":time.Now().UTC()})\n  case errors.Is(e, ErrResync):\n\t\t\tfail(409, ErrResync.Error(), false)\n\t\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\t\tfail(403, \"CHAT_PERMISSION_DENIED\", false)\n\t\tdefault:\n\t\t\tfail(503, ports.ErrUnavailable.Error(), true)\n\t\t}\n\t\treturn\n\t}\n\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": requestID, \"code\": \"OK\", \"data\": out, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/message/s09_http_integration_test.go":"package message\n\nimport (\n \"encoding/json\"\n \"io\"\n \"net/http\"\n \"net/http/httptest\"\n \"strings\"\n \"testing\"\n)\n\nfunc TestMySQLS09HTTPAuthorizationAndRead(t *testing.T){\n f,_,h,r:=historyFixture(t,8)\n f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq IN(2,6)`,string(r.ConversationID))\n handler,e:=NewHistoryHandler(h,historyFixtureIdentity{},4);if e!=nil{t.Fatal(e)}\n server:=httptest.NewServer(handler);defer server.Close()\n call:=func(path,body,credential string,status int) []byte {\n  t.Helper()\n  req,e:=http.NewRequest(\"POST\",server.URL+path,strings.NewReader(body));if e!=nil{t.Fatal(e)}\n  req.Header.Set(\"Content-Type\",\"application/json\")\n  if credential!=\"\"{req.Header.Set(\"Authorization\",\"Bearer \"+credential)}\n  response,e:=server.Client().Do(req);if e!=nil{t.Fatal(e)};defer response.Body.Close()\n  raw,_:=io.ReadAll(response.Body)\n  if response.StatusCode!=status{t.Fatalf(\"%s: got %d want %d: %s\",path,response.StatusCode,status,raw)}\n  if response.Header.Get(\"Cache-Control\")!=\"no-store\"||response.Header.Get(\"X-Request-ID\")==\"\"{t.Fatal(\"missing safe headers\")}\n  return raw\n }\n base:=`{\"conversation_id\":\"`+string(r.ConversationID)+`\"}`\n call(\"/chat/api/v1/conversations/unread\",base,\"\",401)\n call(\"/chat/api/v1/conversations/unread\",base,\"bad\",401)\n call(\"/chat/api/v1/conversations/unread\",`{\"conversation_id\":\"1\",\"conversation_id\":\"2\"}`,\"fixture-only\",400)\n data:=call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",200)\n var unread struct{Data UnreadWindow `json:\"data\"`}\n if json.Unmarshal(data,&unread)!=nil||unread.Data.Count!=2||unread.Data.FirstSeq!=\"2\"{t.Fatal(\"unread\",string(data))}\n call(\"/chat/api/v1/conversations/read\",`{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"forged\"}`,\"fixture-only\",409)\n signed:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\").SyncCursor\n call(\"/chat/api/v1/conversations/read\",`{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"cursor\":\"`+signed+`\"}`,\"fixture-only\",200)\n data=call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",200)\n if json.Unmarshal(data,&unread)!=nil||unread.Data.Count!=0||unread.Data.ReadSeq!=\"8\"{t.Fatal(\"not acknowledged\",string(data))}\n data=call(\"/chat/api/v1/conversations/digests\",`{\"limit\":20}`,\"fixture-only\",200)\n var dig struct{Data DigestPage `json:\"data\"`}\n if json.Unmarshal(data,&dig)!=nil||len(dig.Data.Items)==0{t.Fatal(\"digest\",string(data))}\n call(\"/chat/api/v1/conversations/digests\",`{\"limit\":20,\"cursor\":\"bad\"}`,\"fixture-only\",409)\n data=call(\"/chat/api/v1/conversations/preferences\",base,\"fixture-only\",200)\n var pref struct{Data Preferences `json:\"data\"`};if json.Unmarshal(data,&pref)!=nil||pref.Data.Later{t.Fatal(\"default preference\",string(data))}\n update:=`{\"conversation_id\":\"`+string(r.ConversationID)+`\",\"member_version\":\"`+pref.Data.MemberVersion+`\",\"field\":\"later\",\"value\":true,\"expected_version\":\"0\"}`\n call(\"/chat/api/v1/conversations/preference\",update,\"fixture-only\",200)\n call(\"/chat/api/v1/conversations/preference\",update,\"fixture-only\",200)\n call(\"/chat/api/v1/conversations/preference\",strings.Replace(update,`\"value\":true`,`\"value\":false`,1),\"fixture-only\",409)\n call(\"/chat/api/v1/conversations/preferences\",`{\"conversation_id\":\"1\",\"hidden\":true}`,\"fixture-only\",400)\n data=call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",200)\n if json.Unmarshal(data,&unread)!=nil||unread.Data.Count!=0||!unread.Data.Preferences.Later{t.Fatal(\"preference/read isolation\",string(data))}\n f.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n call(\"/chat/api/v1/conversations/unread\",base,\"fixture-only\",403)\n}\n","chat/internal/message/s09_integration_test.go":"package message\n\nimport (\n \"context\"\n \"testing\"\n\n \"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestMySQLS09ReadProgressAndUnread(t *testing.T){\n f,_,h,r:=historyFixture(t,6)\n // Fixture actor authored all rows; incoming sender is a different actor.\n f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq IN(2,3,5)`,string(r.ConversationID))\n p:=principal(\"10202\")\n initial,e:=h.Unread(f.ctx,p,r.ConversationID)\n if e!=nil||initial.Count!=3||initial.FirstSeq!=\"2\"||initial.ReadSeq!=\"0\"{t.Fatalf(\"initial %+v %v\",initial,e)}\n if f.text(`SELECT COUNT(*) FROM chat_member_reads WHERE conversation_id=?`,string(r.ConversationID))!=\"0\"{t.Fatal(\"read-only unread query mutated state\")}\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n future,err:=h.parse(boot.SyncCursor,\"sync\")\n if err!=nil{t.Fatal(err)}\n future.Seq=\"7\";future.Position=\"7\"\n if _,e=h.Acknowledge(f.ctx,p,r.ConversationID,h.sign(future));e!=ErrResync{t.Fatal(\"future advanced\",e)}\n if _,e=h.Acknowledge(f.ctx,principal(\"10201\"),r.ConversationID,boot.SyncCursor);e==nil{t.Fatal(\"outsider acknowledged\")}\n if _,e=h.Acknowledge(f.ctx,p,r.ConversationID,\"invalid\");e!=ErrResync{t.Fatal(\"unsigned acknowledgement\",e)}\n if got,e:=h.Acknowledge(f.ctx,p,r.ConversationID,boot.SyncCursor);e!=nil||got!=\"6\"{t.Fatal(\"ack\",got,e)}\n if got,e:=h.Acknowledge(f.ctx,p,r.ConversationID,boot.SyncCursor);e!=nil||got!=\"6\"{t.Fatal(\"ack duplicate\",got,e)}\n if f.text(`SELECT COUNT(*) FROM chat_member_reads WHERE conversation_id=?`,string(r.ConversationID))!=\"1\"{t.Fatal(\"ack idempotence created extra read rows\")}\n older,err:=h.parse(boot.SyncCursor,\"sync\")\n if err!=nil{t.Fatal(err)}\n older.Seq=\"2\";older.Position=\"2\"\n if got,e:=h.Acknowledge(f.ctx,p,r.ConversationID,h.sign(older));e!=nil||got!=\"6\"{t.Fatal(\"watermark decreased\",got,e)}\n now,e:=h.Unread(f.ctx,p,r.ConversationID)\n if e!=nil||now.Count!=0||now.ReadSeq!=\"6\"{t.Fatal(\"post-ack\",now,e)}\n if _,e=h.Acknowledge(context.Background(),principal(\"10203\"),r.ConversationID,boot.SyncCursor);e==nil{t.Fatal(\"cross identity cursor accepted\")}\n // Changing the membership generation resets persisted progress.\n f.exec(`UPDATE chat_members SET member_key=CONCAT(member_key,'-new') WHERE conversation_id=? AND actor_id=10202`,string(r.ConversationID))\n if _,e=h.Unread(f.ctx,p,r.ConversationID);e==nil{t.Fatal(\"stale authority member accepted\")}\n}\n\nfunc TestMySQLS09DigestPageAndIsolation(t *testing.T){\n f,_,h,r:=historyFixture(t,3)\n p:=principal(\"10202\")\n out,e:=h.Digests(f.ctx,p,\"0\",10)\n if e!=nil||len(out.Items)!=1||out.Items[0].ConversationID!=r.ConversationID||out.HasMore{t.Fatal(out,e)}\n if _,e=h.Digests(f.ctx,p,\"0\",21);e!=ports.ErrInvalid{t.Fatal(\"limit\",e)}\n if _,e=h.Digests(f.ctx,principal(\"10201\"),\"0\",10);e!=nil{t.Fatal(\"outsider index unavailable\",e)}\n}\n\nfunc TestMySQLS09MembershipGenerationInvalidatesRead(t *testing.T){\n f,_,h,r:=historyFixture(t,6)\n actor:=principal(\"10202\")\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n if n,e:=h.Acknowledge(f.ctx,actor,r.ConversationID,boot.SyncCursor);e!=nil||n!=\"6\"{t.Fatal(n,e)}\n f.php(\"close\")\n if _,e:=f.store.Poll(f.ctx,100);e!=nil{t.Fatal(e)}\n f.php(\"repair\")\n if _,e:=f.store.Poll(f.ctx,100);e!=nil{t.Fatal(e)}\n if _,e:=h.Acknowledge(f.ctx,actor,r.ConversationID,boot.SyncCursor);e!=ErrResync{t.Fatal(\"prior authority generation accepted\",e)}\n u,e:=h.Unread(f.ctx,actor,r.ConversationID)\n if e!=nil||u.ReadSeq!=\"0\"{t.Fatal(\"stale membership watermark reused\",u,e)}\n}\n\nfunc TestMySQLS09ConcurrentReadHighWatermarkAndLaterMessage(t *testing.T) {\n f,s,h,r:=historyFixture(t,6)\n actor:=principal(\"10202\")\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n old,err:=h.parse(boot.SyncCursor,\"sync\")\n if err!=nil{t.Fatal(err)}\n old.Seq=\"2\";old.Position=\"2\"\n tokens:=[]string{h.sign(old),boot.SyncCursor}\n results:=make(chan error,len(tokens))\n for _,token:=range tokens{\n  tok:=token\n  go func(){_,e:=h.Acknowledge(f.ctx,actor,r.ConversationID,tok);results<-e}()\n }\n for range tokens{\n  if e:=<-results;e!=nil{t.Fatal(\"concurrent ack\",e)}\n }\n u,e:=h.Unread(f.ctx,actor,r.ConversationID)\n if e!=nil||u.ReadSeq!=\"6\"{t.Fatal(\"regressed waterline\",u,e)}\n // A message committed after the signed cursor must not be marked read.\n r.ClientMessageID=client(991)\n msg:=accepted(t,s,r)\n if msg.Seq!=\"7\"{t.Fatal(\"expected next committed sequence\",msg)}\n f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq=7`,string(r.ConversationID))\n u,e=h.Unread(f.ctx,actor,r.ConversationID)\n if e!=nil||u.ReadSeq!=\"6\"||u.Count!=1||u.FirstSeq!=\"7\"{\n  t.Fatal(\"post-ack message lost\",u,e)\n }\n}\n\nfunc TestMySQLS09AccountPaginationExcludesLaterConversations(t *testing.T) {\n f,_,h,_:=historyFixture(t,0)\n f.php(\"sync\",\"402\")\n if outcome,e:=f.store.Poll(f.ctx,100);e!=nil||outcome.Applied!=1{t.Fatal(\"second projection\",outcome,e)}\n actor:=principal(\"10202\")\n first,e:=h.DigestsCursor(f.ctx,actor,\"\",1)\n if e!=nil||len(first.Items)!=1||!first.HasMore||first.NextCursor==\"\"{t.Fatal(\"first\",first,e)}\n // A new conversation after the snapshot is not inserted into its later pages.\n f.php(\"sync\",\"403\")\n if outcome,e:=f.store.Poll(f.ctx,100);e!=nil||outcome.Applied!=1{t.Fatal(\"third projection\",outcome,e)}\n second,e:=h.DigestsCursor(f.ctx,actor,first.NextCursor,1)\n if e!=nil||len(second.Items)!=1||second.HasMore||second.NextCursor!=\"\"{t.Fatal(\"later candidate drift\",second,e)}\n if first.Items[0].ConversationID==second.Items[0].ConversationID{t.Fatal(\"duplicate candidate\")}\n fresh,e:=h.DigestsCursor(f.ctx,actor,\"\",20)\n if e!=nil||len(fresh.Items)!=3{t.Fatal(\"new snapshot lost new conversation\",fresh,e)}\n}\n\nfunc TestMySQLS09RevokedAccountDigestFailsClosed(t *testing.T) {\n f,_,h,_:=historyFixture(t,1)\n p:=principal(\"10202\")\n if out,e:=h.DigestsCursor(f.ctx,p,\"\",10);e!=nil||len(out.Items)!=1 {\n  t.Fatalf(\"pre-revocation digest: %+v %v\",out,e)\n }\n f.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10202`)\n if out,e:=h.DigestsCursor(f.ctx,p,\"\",10);e==nil||len(out.Items)!=0 {\n  t.Fatalf(\"revoked login returned partial or empty success: %+v %v\",out,e)\n }\n}\n\nfunc TestMySQLS09EmptyDigestStillRechecksLogin(t *testing.T) {\n f,_,h,_:=historyFixture(t,0)\n p:=principal(\"10201\") // No projected membership in the initial unbound order.\n before,e:=h.DigestsCursor(f.ctx,p,\"\",10)\n if e!=nil||len(before.Items)!=0{t.Fatalf(\"valid empty account: %+v %v\",before,e)}\n f.exec(`UPDATE login_sessions SET status='revoked' WHERE id=10201`)\n after,e:=h.DigestsCursor(f.ctx,p,\"\",10)\n if e==nil||len(after.Items)!=0{t.Fatalf(\"revoked empty account falsely succeeded: %+v %v\",after,e)}\n}\n\nfunc TestMySQLS14FullAccountAttentionBeyondClientWindow(t *testing.T){\n f,_,h,r:=historyFixture(t,3)\n f.php(\"attention-seed\")\n for {batch,e:=f.store.Poll(f.ctx,100);if e!=nil{t.Fatal(e)};if batch.Applied<100{break}}\n f.exec(`INSERT INTO chat_user_preferences(conversation_id,actor_id,member_key_hash,pinned,pinned_version,later,later_version,updated_at) SELECT conversation_id,actor_id,SHA2(member_key,256),0,0,1,1,UTC_TIMESTAMP(6) FROM chat_members WHERE actor_id=10202`)\n f.exec(\"UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=?\",string(r.ConversationID))\n cursor:=\"\";pages:=0\n for{\n  page,e:=h.DigestsCursor(f.ctx,principal(\"10202\"),cursor,20);if e!=nil{t.Fatal(e)};pages++\n  if page.HasMore {if page.BadgeCount!=nil{t.Fatal(\"partial page claims a global count\")};cursor=page.NextCursor;continue}\n  if page.BadgeCount==nil||*page.BadgeCount!=126||pages<7{t.Fatal(\"client-window truncated or unread/later double counted\",page.BadgeCount,pages)}\n  break\n }\n f.exec(\"UPDATE chat_user_preferences SET later=0 WHERE conversation_id=?\",string(r.ConversationID))\n page,e:=h.DigestsCursor(f.ctx,principal(\"10202\"),\"\",20);if e!=nil||!page.HasMore{t.Fatal(page,e)}\n // The caller cannot alter an authenticated partial attention accumulator.\n parsed,e:=h.decodeDigestCursor(page.NextCursor,principal(\"10202\"));if e!=nil||parsed.Attention!=20{t.Fatal(parsed,e)}\n if _,e=h.DigestsCursor(f.ctx,principal(\"10202\"),page.NextCursor+\"x\",20);e!=ErrResync{t.Fatal(\"tampered total accepted\",e)}\n boot:=readPage(t,h,HistoryRequest{ConversationID:r.ConversationID},\"bootstrap\")\n if _,e=h.Acknowledge(f.ctx,principal(\"10202\"),r.ConversationID,boot.SyncCursor);e!=nil{t.Fatal(e)}\n cursor=\"\"\n for{page,e=h.DigestsCursor(f.ctx,principal(\"10202\"),cursor,20);if e!=nil{t.Fatal(e)};if !page.HasMore{if page.BadgeCount==nil||*page.BadgeCount!=125{t.Fatal(\"read did not preserve other later items\",page.BadgeCount)};break};cursor=page.NextCursor}\n}\n","chat/internal/message/s09_test.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"testing\"\n \"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestS09StrictRequestDecoder(t *testing.T) {\n\tfor _, bad := range []string{\n\t\t`{\"cursor\":null}`,\n\t\t`{\"cursor\":\"\\ud800\"}`,\n\t\t\"{\\\"cursor\\\":\\\"\\xff\\\"}\",\n\t\t`{\"conversation_id\":\"1\",\"conversation_id\":\"2\"}`,\n\t\t`{\"limit\":5,\"limit\":6}`,\n\t\t`{\"conversation_id\":1}`,\n\t\t`{\"conversation_id\":\"01\"}`,\n\t\t`{\"limit\":2.5}`,\n\t\t`{\"limit\":-1}`,\n\t\t`{\"actor_id\":\"10203\"}`,\n\t\t`[]`,\n\t\t`{\"limit\":1} {}`,\n\t} {\n\t\tif _, err := decodeS09([]byte(bad)); err == nil {\n\t\t\tt.Fatalf(\"accepted %s\", bad)\n\t\t}\n\t}\n\tfor _, good := range []string{`{\"conversation_id\":\"1\"}`, `{\"conversation_id\":\"1\",\"cursor\":\"abc\"}`, `{\"limit\":20}`} {\n\t\tif _, err := decodeS09([]byte(good)); err != nil {\n\t\t\tt.Fatalf(\"rejected %s: %v\", good, err)\n\t\t}\n\t}\n}\n\nfunc TestS09DigestCursorBindingAndExpiry(t *testing.T) {\n\ts := &HistoryService{environment: \"test\", key: []byte(\"12345678901234567890123456789012\")}\n\tp := principal(\"10202\")\n\tc := digestCursor{Version: 2, PreferenceRevision: \"0\", Binding: bindingFor(\"test\", p), After: \"2\", Upper: \"99\", Expires: time.Now().Add(time.Minute).Unix()}\n\ttoken, e := s.encodeDigestCursor(c)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tgot, e := s.decodeDigestCursor(token, p)\n\tif e != nil || got.After != \"2\" {\n\t\tt.Fatal(\"round trip\", got, e)\n\t}\n\tif _, e = s.decodeDigestCursor(token, principal(\"10203\")); e != ErrResync {\n\t\tt.Fatal(\"cross account\", e)\n\t}\n\tif _, e = s.decodeDigestCursor(token+\"x\", p); e != ErrResync {\n\t\tt.Fatal(\"tampered token\", e)\n\t}\n\tc.Expires = time.Now().Add(-time.Second).Unix()\n\texpired, e := s.encodeDigestCursor(c)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = s.decodeDigestCursor(expired, p); e != ErrResync {\n\t\tt.Fatal(\"expired\", e)\n\t}\n}\n\nfunc TestS09ReadIDJSON(t *testing.T) {\n\tv := UnreadWindow{ReadSeq: \"0\", SnapshotSeq: \"12\", SnapshotChange: \"12\", PolicyVersion: \"1\", Count: 2}\n\traw, e := json.Marshal(v)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tvar decoded struct {\n\t\tReadSeq ports.ID `json:\"read_seq\"`\n\t}\n\tif e = json.Unmarshal(raw, &decoded); e != nil || decoded.ReadSeq != \"0\" {\n\t\tt.Fatal(decoded, e)\n\t}\n}\n\nfunc TestS14PreferenceClosedSchema(t *testing.T){\n hash:=\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"\n good:=`{\"conversation_id\":\"9\",\"member_version\":\"`+hash+`\",\"field\":\"pinned\",\"value\":true,\"expected_version\":\"0\"`+`}`\n q,e:=decodePreference([]byte(good),true);if e!=nil||q.Field!=\"pinned\"||!q.Value||q.Expected!=\"0\"{t.Fatal(q,e)}\n for _,raw:=range []string{\n  `{\"conversation_id\":\"9\",\"muted\":true}`, `{\"conversation_id\":\"9\",\"hidden\":true}`, `{\"conversation_id\":\"9\",\"actor_id\":\"1\"}`,\n  `{\"conversation_id\":\"9\",\"conversation_id\":\"10\"}`, `{\"conversation_id\":9}`, `{\"conversation_id\":\"09\"}`,\n  `{\"conversation_id\":\"9\",\"read_seq\":\"999\"}`, `{\"conversation_id\":\"9\",\"field\":\"pinned\",\"value\":null}`, `{\"conversation_id\":\"9\"} {}`,\n }{if _,e:=decodePreference([]byte(raw),true);e==nil{t.Fatal(\"accepted write\",raw)};if _,e:=decodePreference([]byte(raw),false);e==nil{t.Fatal(\"accepted read\",raw)}}\n if _,e:=decodePreference([]byte(`{\"conversation_id\":\"9\"}`),false);e!=nil{t.Fatal(e)}\n for _,change:=range []struct{old,new string}{{\"true\",\"null\"},{\"true\",`\"true\"`},{`\"pinned\"`,`\"muted\"`},{`\"0\"`,`\"00\"`},{hash,\"BAD\"},{`\"expected_version\":\"0\"`,`\"expected_version\":0`}}{\n  raw:=strings.Replace(good,change.old,change.new,1);if _,e:=decodePreference([]byte(raw),true);e==nil{t.Fatal(\"accepted\",raw)}\n }\n}","chat/internal/message/service.go":"// Package message owns the transport-independent, fail-closed text send use case.\n// HTTP and future WSS must call Send; neither transport may write messages.\npackage message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/conversation\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar (\n\tErrConflict   = errors.New(\"CHAT_CLIENT_MESSAGE_CONFLICT\")\n\tErrExpired    = errors.New(\"CHAT_ACTION_EXPIRED\")\n\tErrUnknown    = errors.New(\"CHAT_SEND_RESULT_UNKNOWN\")\n\tErrRestricted = errors.New(\"CHAT_SEND_RESTRICTED\")\n\tErrBlocked    = errors.New(\"CHAT_CONTENT_BLOCKED\")\n\tErrCheck      = errors.New(\"CHAT_CHECK_UNAVAILABLE\")\n)\n\nconst ActionWindow = 24 * time.Hour\nconst MinimumRetention = 30 * 24 * time.Hour\nconst leaseDuration = 10 * time.Second\n\nvar clientPattern = regexp.MustCompile(`^([1-9][0-9]{9})\\.([0-9a-f]{32})$`)\nvar rulePattern = regexp.MustCompile(`^[A-Za-z0-9_.:-]{1,64}$`)\n\ntype Config struct {\n\tEnabled bool `json:\"enabled\"`\n}\ntype Request struct {\n\tItems           []MediaItem `json:\"items,omitempty\"`\n\tRevision        int         `json:\"revision,omitempty\"`\n\tReplyItem       ports.ID    `json:\"reply_to_item_id,omitempty\"`\n\tConversationID  ports.ID    `json:\"conversation_id\"`\n\tClientMessageID string      `json:\"client_message_id\"`\n\tMessageType     string      `json:\"message_type\"`\n\tText            string      `json:\"text\"`\n\tReplyTo         ports.ID    `json:\"reply_to_message_id,omitempty\"`\n\tEditedFrom      ports.ID    `json:\"edited_from_recalled_message_id,omitempty\"`\n}\n\n// Result deliberately never returns stored text, including after recall/block.\n// State is checking/retryable/rejected/accepted; absence is never proof of failure.\ntype Result struct {\n\tRiskEventID     ports.ID `json:\"risk_event_id,omitempty\"`\n\tClientMessageID string   `json:\"client_message_id\"`\n\tState           string   `json:\"state\"`\n\tCode            string   `json:\"code,omitempty\"`\n\tMessageID       ports.ID `json:\"message_id,omitempty\"`\n\tSeq             ports.ID `json:\"seq,omitempty\"`\n\tPolicyVersion   ports.ID `json:\"policy_version,omitempty\"`\n\tStateVersion    ports.ID `json:\"state_version,omitempty\"`\n\tMessageState    string   `json:\"message_state,omitempty\"`\n}\ntype Service struct {\n\tmedia         *MediaService\n\tdb            *sql.DB\n\tconversations *conversation.Store\n\tsafety        ports.Safety\n\ttimeout       time.Duration\n\tpublisher     ports.MessagePublisher\n}\n\n// WithPublisher returns an immutable configured copy, before serving requests.\nfunc (s *Service) WithPublisher(p ports.MessagePublisher) *Service {\n\tcopy := *s\n\tcopy.publisher = p\n\treturn &copy\n}\n\nfunc NewService(db *sql.DB, c *conversation.Store, safety ports.Safety, timeout time.Duration) (*Service, error) {\n\tif db == nil || c == nil || safety == nil || timeout < 100*time.Millisecond || timeout > 3*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Service{db: db, conversations: c, safety: safety, timeout: timeout}, nil\n}\nfunc validID(id ports.ID) bool   { return id.Valid() && id != \"0\" }\nfunc validClient(id string) bool { return clientPattern.MatchString(id) }\nfunc expires(id string) time.Time {\n\tseconds, _ := strconv.ParseInt(strings.SplitN(id, \".\", 2)[0], 10, 64)\n\treturn time.Unix(seconds, 0).UTC().Add(ActionWindow)\n}\nfunc active(id string, now time.Time) bool {\n\tend := expires(id)\n\treturn now.Before(end) && !now.Add(30*time.Second).Before(end.Add(-ActionWindow))\n}\nfunc fingerprint(r Request) (string, error) {\n\tif len(r.Items) > 0 || r.Revision != 0 || r.ReplyItem != \"\" && (!validID(r.ReplyItem) || r.ReplyTo == \"\") || (r.ReplyTo != \"\" && !validID(r.ReplyTo)) || (r.EditedFrom != \"\" && !validID(r.EditedFrom)) || !validID(r.ConversationID) || !validClient(r.ClientMessageID) || r.MessageType != \"text\" || !utf8.ValidString(r.Text) || len(r.Text) > 4000 || utf8.RuneCountInString(r.Text) > 2000 || strings.TrimSpace(r.Text) == \"\" || strings.ContainsRune(r.Text, 0) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\t// Versioned structural encoding: preserves every UTF-8 byte, whitespace and\n\t// line break. Future attachments/replies require a new explicit schema.\n\tdata, _ := json.Marshal(struct {\n\t\tSchema int    `json:\"schema\"`\n\t\tType   string `json:\"type\"`\n\t\tText   string `json:\"text\"`\n\t}{1, r.MessageType, r.Text})\n\tif r.ReplyTo != \"\" || r.EditedFrom != \"\" || r.ReplyItem != \"\" {\n\t\tdata, _ = json.Marshal(struct {\n\t\t\tSchema     int      `json:\"schema\"`\n\t\t\tType       string   `json:\"type\"`\n\t\t\tText       string   `json:\"text\"`\n\t\t\tReplyTo    ports.ID `json:\"reply_to_message_id,omitempty\"`\n\t\t\tEditedFrom ports.ID `json:\"edited_from_recalled_message_id,omitempty\"`\n\t\t\tReplyItem  ports.ID `json:\"reply_to_item_id,omitempty\"`\n\t\t}{2, r.MessageType, r.Text, r.ReplyTo, r.EditedFrom, r.ReplyItem})\n\t}\n\tsum := sha256.Sum256(data)\n\treturn hex.EncodeToString(sum[:]), nil\n}\nfunc (s *Service) begin(ctx context.Context) (*sql.Tx, error) {\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn tx, nil\n}\nfunc (s *Service) authorize(ctx context.Context, tx *sql.Tx, p ports.Principal, id ports.ID, final ...ports.SafetyResult) (ports.Grant, error) {\n\ta, e := s.conversations.LockAuthority(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"send\"})\n\tif e != nil {\n\t\treturn ports.Grant{}, e\n\t}\n\tif len(final) == 1 {\n\t\tif validator, ok := s.safety.(finalSafety); ok {\n\t\t\tif err := validator.ValidateTextLocked(ctx, tx, p, final[0]); err != nil {\n\t\t\t\treturn ports.Grant{}, err\n\t\t\t}\n\t\t}\n\t}\n\t// Never lock a possibly absent restriction via SELECT alone. Even an\n\t// unrestricted actor owns a permanent row; all future bans use this same row.\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_restrictions(actor_id,permanent,version,updated_at) VALUES(?,0,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(p.ActorID))\n\tif e != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tvar restricted bool\n\te = tx.QueryRowContext(ctx, `SELECT permanent=1 OR (blocked_until IS NOT NULL AND blocked_until>UTC_TIMESTAMP(6)) FROM chat_restrictions WHERE actor_id=? FOR UPDATE`, string(p.ActorID)).Scan(&restricted)\n\tif e != nil {\n\t\treturn ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif restricted {\n\t\treturn ports.Grant{}, ErrRestricted\n\t}\n\treturn s.conversations.LockProjection(ctx, tx, a)\n}\n\ntype intent struct {\n\tid                 ports.ID\n\tfingerprint, owner string\n\tresult             Result\n\tleased             bool\n\tattempts           int\n}\n\nfunc (s *Service) lookup(ctx context.Context, tx *sql.Tx, p ports.Principal, conversation ports.ID, client string) (*intent, error) {\n\tvar i intent\n\ti.result.ClientMessageID = client\n\tvar message, risk sql.NullString\n\te := tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR),fingerprint,state,COALESCE(error_code,''),CAST(message_id AS CHAR),CAST(risk_event_id AS CHAR),COALESCE(lease_owner,''),COALESCE(lease_until>UTC_TIMESTAMP(6),0),attempts\n FROM chat_send_intents WHERE sender_id=? AND conversation_id=? AND client_message_id=? FOR UPDATE`, string(p.ActorID), string(conversation), client).Scan(&i.id, &i.fingerprint, &i.result.State, &i.result.Code, &message, &risk, &i.owner, &i.leased, &i.attempts)\n\tif e == sql.ErrNoRows {\n\t\treturn nil, nil\n\t}\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tif risk.Valid {\n\t\ti.result.RiskEventID = ports.ID(risk.String)\n\t}\n\tif i.result.State == \"accepted\" {\n\t\tif !message.Valid {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\ti.result.MessageID = ports.ID(message.String)\n\t\te = tx.QueryRowContext(ctx, `SELECT CAST(seq AS CHAR),CAST(policy_version AS CHAR),CAST(state_version AS CHAR),state FROM chat_messages WHERE id=? AND conversation_id=? AND sender_id=? LOCK IN SHARE MODE`, message.String, string(conversation), string(p.ActorID)).Scan(&i.result.Seq, &i.result.PolicyVersion, &i.result.StateVersion, &i.result.MessageState)\n\t\tif e != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\t// Current readable membership alone must not expose an absence-period send.\n\t\tvar start string\n\t\te = tx.QueryRowContext(ctx, `SELECT CAST(start_version AS CHAR) FROM chat_member_intervals WHERE conversation_id=? AND actor_id=? AND start_version<=? AND (end_version IS NULL OR end_version>?) LIMIT 1 LOCK IN SHARE MODE`, string(conversation), string(p.ActorID), string(i.result.PolicyVersion), string(i.result.PolicyVersion)).Scan(&start)\n\t\tif e == sql.ErrNoRows {\n\t\t\treturn nil, policy.ErrDenied\n\t\t}\n\t\tif e != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn nil, policy.ErrDenied\n\t}\n\treturn &i, nil\n}\n\n// Query uses read authority, never send authority or the ban gate. An accepted\n// action remains confirmable by its legitimate author after a send ban/closure.\nfunc (s *Service) Query(ctx context.Context, p ports.Principal, id ports.ID, client string) (Result, error) {\n\tif !validID(id) || !validClient(client) {\n\t\treturn Result{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tif _, e = s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"}); e != nil {\n\t\treturn Result{}, e\n\t}\n\ti, e := s.lookup(ctx, tx, p, id, client)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif i == nil {\n\t\tif !active(client, time.Now()) {\n\t\t\treturn Result{}, ErrExpired\n\t\t}\n\t\treturn Result{}, ErrUnknown\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif i.result.State != \"accepted\" && i.result.State != \"rejected\" && !active(client, time.Now()) {\n\t\ti.result.State = \"rejected\"\n\t\ti.result.Code = ErrExpired.Error()\n\t}\n\treturn i.result, nil\n}\n\nfunc (s *Service) Send(ctx context.Context, p ports.Principal, r Request) (Result, error) {\n\tif r.MessageType == \"image\" || r.MessageType == \"image_album\" {\n\t\tif s.media == nil {\n\t\t\treturn Result{}, ErrMedia\n\t\t}\n\t\treturn s.media.Send(ctx, p, r)\n\t}\n\tfp, e := fingerprint(r)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\t// Read-only result lookup precedes send restrictions, expiry and safety. It\n\t// never commits a new message, even if the original acknowledgement was lost.\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif _, e = s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: r.ConversationID, Action: \"read\"}); e != nil {\n\t\ttx.Rollback()\n\t\treturn Result{}, e\n\t}\n\tprevious, e := s.lookup(ctx, tx, p, r.ConversationID, r.ClientMessageID)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\treturn Result{}, e\n\t}\n\tif previous != nil && previous.fingerprint != fp {\n\t\ttx.Rollback()\n\t\treturn Result{}, ErrConflict\n\t}\n\tif previous != nil && terminal(previous.result.State) {\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn previous.result, nil\n\t}\n\ttx.Rollback()\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\ttx, e = s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tgrant, e := s.authorize(ctx, tx, p, r.ConversationID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Re-read under canonical guard -> restriction -> conversation -> intent order.\n\tcurrent, e := s.lookup(ctx, tx, p, r.ConversationID, r.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif current != nil && current.fingerprint != fp {\n\t\treturn Result{}, ErrConflict\n\t}\n\tif current != nil && terminal(current.result.State) {\n\t\tif tx.Commit() != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\treturn current.result, nil\n\t}\n\tif current != nil && (current.leased || current.attempts >= 8) {\n\t\treturn current.result, nil\n\t}\n\tif _, e = validateReferences(ctx, tx, p, r, grant); e != nil {\n\t\treturn Result{}, e\n\t}\n\tvar pending int\n\tif e = tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_send_intents WHERE sender_id=? AND state='checking' AND lease_until>UTC_TIMESTAMP(6)`, string(p.ActorID)).Scan(&pending); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tif pending >= 4 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tvar token [16]byte\n\tif _, e = rand.Read(token[:]); e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\towner := hex.EncodeToString(token[:])\n\tif current == nil {\n\t\tres, err := tx.ExecContext(ctx, `INSERT INTO chat_send_intents(sender_id,conversation_id,client_message_id,fingerprint,state,lease_owner,lease_until,attempts,action_expires_at,retain_until,created_at,updated_at) VALUES(?,?,?,?,'checking',?,UTC_TIMESTAMP(6)+INTERVAL 10 SECOND,1,?,?,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))`, string(p.ActorID), string(r.ConversationID), r.ClientMessageID, fp, owner, expires(r.ClientMessageID), expires(r.ClientMessageID).Add(MinimumRetention))\n\t\tif err != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\tn, err := res.LastInsertId()\n\t\tif err != nil || n <= 0 {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t\tcurrent = &intent{id: ports.ID(strconv.FormatInt(n, 10))}\n\t} else {\n\t\t_, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='checking',error_code=NULL,lease_owner=?,lease_until=UTC_TIMESTAMP(6)+INTERVAL 10 SECOND,attempts=attempts+1,updated_at=UTC_TIMESTAMP(6) WHERE id=?`, owner, string(current.id))\n\t\tif e != nil {\n\t\t\treturn Result{}, ports.ErrUnavailable\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\t// No DB lease/transaction is held over network inspection. Exact text and\n\t// fingerprint are immutable on this stack and supplied together to safety.\n\tchecked, checkErr := s.safety.CheckText(ctx, ports.TextRequest{Actor: p, ConversationID: r.ConversationID, IntentID: current.id, Text: r.Text, Fingerprint: fp})\n\tif checkErr != nil || !rulePattern.MatchString(checked.RuleVersion) || (checked.Decision != \"passed\" && !validFinding(checked)) {\n\t\ts.settle(ctx, current.id, owner, \"retryable\", ErrCheck.Error())\n\t\treturn Result{}, ErrCheck\n\t}\n\tif checked.Decision != \"passed\" {\n\t\treturn s.reject(ctx, p, r, fp, current.id, owner, checked)\n\t}\n\treturn s.publish(ctx, p, r, fp, current.id, owner, checked)\n\n}\n\nfunc (s *Service) settle(ctx context.Context, id ports.ID, owner, state, code string) bool {\n\t// Intent-only CAS never acquires an earlier lock and cannot publish anything.\n\tres, e := s.db.ExecContext(ctx, `UPDATE chat_send_intents SET state=?,error_code=?,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, state, code, string(id), owner)\n\tif e != nil {\n\t\treturn false\n\t}\n\tn, e := res.RowsAffected()\n\treturn e == nil && n == 1\n}\nfunc (s *Service) publish(ctx context.Context, p ports.Principal, r Request, fp string, id ports.ID, owner string, checked ports.SafetyResult) (Result, error) {\n\ttx, e := s.begin(ctx)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tdefer tx.Rollback()\n\tgrant, e := s.authorize(ctx, tx, p, r.ConversationID, checked)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\tif e == ErrRestricted || errors.Is(e, policy.ErrDenied) {\n\t\t\ts.settle(ctx, id, owner, \"rejected\", e.Error())\n\t\t}\n\t\treturn Result{}, e\n\t}\n\ti, e := s.lookup(ctx, tx, p, r.ConversationID, r.ClientMessageID)\n\tif e != nil {\n\t\treturn Result{}, e\n\t}\n\tif i == nil || i.id != id || i.owner != owner || !i.leased || i.result.State != \"checking\" || i.fingerprint != fp {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\ttx.Rollback()\n\t\ts.settle(ctx, id, owner, \"rejected\", ErrExpired.Error())\n\t\treturn Result{}, ErrExpired\n\t}\n\tdepth, e := validateReferences(ctx, tx, p, r, grant)\n\tif e != nil {\n\t\ttx.Rollback()\n\t\ts.settle(ctx, id, owner, \"rejected\", e.Error())\n\t\treturn Result{}, e\n\t}\n\tvar seq, change uint64\n\te = tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=? FOR UPDATE`, string(r.ConversationID)).Scan(&seq, &change)\n\tif e != nil || seq == ^uint64(0) || change == ^uint64(0) {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tseq++\n\tchange++\n\tres, e := tx.ExecContext(ctx, `INSERT INTO chat_messages(conversation_id,seq,sender_id,client_message_id,policy_version,message_type,text_body,state,state_version,safety_rule_version,created_at,reply_to_message_id,edited_from_recalled_message_id,reedit_depth,reply_to_item_id) VALUES(?,?,?,?,?,'text',?,'published',1,?,UTC_TIMESTAMP(6),?,?,?,?)`, string(r.ConversationID), seq, string(p.ActorID), r.ClientMessageID, string(grant.Version), r.Text, checked.RuleVersion, nullableID(r.ReplyTo), nullableID(r.EditedFrom), depth, nullableID(r.ReplyItem))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tmessageID, e := res.LastInsertId()\n\tif e != nil || messageID <= 0 {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(?,?,?,1,'message.accepted',UTC_TIMESTAMP(6))`, string(r.ConversationID), change, messageID)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\t_, e = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_seq=?,last_change_seq=?,last_message_id=?,last_message_at=UTC_TIMESTAMP(6) WHERE id=?`, seq, change, messageID, string(r.ConversationID))\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tres, e = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='accepted',message_id=?,error_code=NULL,lease_owner=NULL,lease_until=NULL,updated_at=UTC_TIMESTAMP(6) WHERE id=? AND state='checking' AND lease_owner=? AND lease_until>UTC_TIMESTAMP(6)`, messageID, string(id), owner)\n\tif e != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t}\n\tn, e := res.RowsAffected()\n\tif e != nil || n != 1 {\n\t\treturn Result{}, ports.ErrBusy\n\t}\n\tif e = reminderEvent(ctx, tx, r.ConversationID, seq); e != nil {\n\t\treturn Result{}, e\n\t}\n\t// Credential validity is rechecked after any lock wait immediately at commit.\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn Result{}, policy.ErrDenied\n\t}\n\tif !active(r.ClientMessageID, time.Now()) {\n\t\treturn Result{}, ErrExpired\n\t}\n\tif tx.Commit() != nil {\n\t\treturn Result{}, ports.ErrUnavailable\n\t} // UNKNOWN: query same ID.\n\tif s.publisher != nil {\n\t\ts.publisher.Committed(ports.CommittedMessage{ConversationID: r.ConversationID, Seq: ports.ID(fmt.Sprint(seq)), PolicyVersion: grant.Version})\n\t}\n\treturn Result{ClientMessageID: r.ClientMessageID, State: \"accepted\", MessageID: ports.ID(fmt.Sprint(messageID)), Seq: ports.ID(fmt.Sprint(seq)), PolicyVersion: grant.Version, StateVersion: \"1\", MessageState: \"published\"}, nil\n}\n","chat/internal/message/service_test.go":"package message\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc client(n int) string { return fmt.Sprintf(\"%d.%032x\", time.Now().Unix(), n) }\nfunc request(n int) Request {\n\treturn Request{ConversationID: \"1\", ClientMessageID: client(n), MessageType: \"text\", Text: \"施工尺寸 3.5m × 2m\\n明天见 🛠️\"}\n}\nfunc TestActionBoundaryAndFingerprint(t *testing.T) {\n\tnow := time.Now().Truncate(time.Second)\n\tid := fmt.Sprintf(\"%d.%032x\", now.Unix(), 1)\n\tif !active(id, now.Add(ActionWindow-time.Nanosecond)) || active(id, now.Add(ActionWindow)) || active(id, now.Add(-31*time.Second)) {\n\t\tt.Fatal(\"action window boundary\")\n\t}\n\tr := request(1)\n\tfp, e := fingerprint(r)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tr.Text += \" \"\n\tother, _ := fingerprint(r)\n\tif fp == other {\n\t\tt.Fatal(\"whitespace was normalized\")\n\t}\n\tr.Text = strings.Repeat(\"a\", 2001)\n\tif _, e = fingerprint(r); e == nil {\n\t\tt.Fatal(\"character limit\")\n\t}\n\tr.Text = strings.Repeat(\"中\", 1334)\n\tif _, e = fingerprint(r); e == nil {\n\t\tt.Fatal(\"UTF8 byte limit\")\n\t}\n\tfor _, id := range []string{\"1\", client(1) + \"0\", \"0000000000.\" + strings.Repeat(\"a\", 32), strings.ToUpper(client(255))} {\n\t\tr = request(1)\n\t\tr.ClientMessageID = id\n\t\tif _, e = fingerprint(r); e == nil {\n\t\t\tt.Fatalf(\"invalid client ID %s\", id)\n\t\t}\n\t}\n}\nfunc TestStrictJSON(t *testing.T) {\n\tfor _, v := range []string{`\"\\ud83d\\udee0\"`, `\"�\"`, `\"\\\\uD800\"`} {\n\t\tif !validSurrogates([]byte(v)) {\n\t\t\tt.Fatal(\"valid Unicode rejected\", v)\n\t\t}\n\t}\n\tfor _, v := range []string{`\"\\ud800\"`, `\"\\udc00\"`, `\"\\ud800\\u0041\"`} {\n\t\tif validSurrogates([]byte(v)) {\n\t\t\tt.Fatal(\"lossy Unicode accepted\", v)\n\t\t}\n\t}\n\n\tgood := fmt.Sprintf(`{\"conversation_id\":\"18446744073709551615\",\"client_message_id\":%q,\"message_type\":\"text\",\"text\":\"换行\\n🛠\"}`, client(1))\n\tif _, e := decode([]byte(good), false); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tfor _, body := range []string{strings.Replace(good, `\"text\":`, `\"text\":\"x\",\"text\":`, 1), strings.Replace(good, `\"text\":`, `\"Text\":`, 1), strings.Replace(good, `\"message_type\":\"text\"`, `\"message_type\":null`, 1), strings.Replace(good, `\"18446744073709551615\"`, `18446744073709551615`, 1), good + `{}`, strings.Replace(good, `换行\\n🛠`, `\\ud800`, 1), `[]`, strings.Replace(good, `\"text\":`, `\"sender_id\":\"42\",\"text\":`, 1)} {\n\t\tif _, e := decode([]byte(body), false); e == nil {\n\t\t\tt.Fatalf(\"accepted invalid body %s\", body)\n\t\t}\n\t}\n\tif _, e := decode([]byte(good), true); e == nil {\n\t\tt.Fatal(\"query accepted text\")\n\t}\n}\n\nfunc TestS15ReferenceFingerprintAndClosedPayloads(t *testing.T){\n q:=request(1501);base,_:=fingerprint(q);q.ReplyTo=\"1\";reply,_:=fingerprint(q)\n q.ReplyTo=\"\";q.EditedFrom=\"1\";edited,_:=fingerprint(q)\n if base==reply||reply==edited||base==edited{t.Fatal(\"source fingerprint collision\")}\n good:=fmt.Sprintf(`{\"conversation_id\":\"1\",\"client_message_id\":%q,\"message_type\":\"text\",\"text\":\"回复\",\"reply_to_message_id\":\"2\"}`,client(1502))\n if _,e:=decode([]byte(good),false);e!=nil{t.Fatal(e)}\n for _,bad:=range []string{strings.Replace(good,`\"2\"`,`2`,1),strings.Replace(good,`\"2\"`,`\"0\"`,1),strings.Replace(good,`\"2\"`,`null`,1),strings.Replace(good,`\"text\":`,`\"quote_text\":\"fake\",\"text\":`,1),strings.Replace(good,`\"reply_to_message_id\":\"2\"`,`\"reply_to_message_id\":\"2\",\"reply_to_message_id\":\"2\"`,1)}{if _,e:=decode([]byte(bad),false);e==nil{t.Fatal(\"malformed source\",bad)}}\n for _,bad:=range []string{`{\"conversation_id\":\"1\",\"message_id\":\"2\",\"cursor\":\"\"}`,`{\"conversation_id\":\"1\",\"message_id\":2}`,`{\"conversation_id\":\"1\",\"message_id\":\"2\",\"message_id\":\"2\"}`,`{\"conversation_id\":\"1\",\"message_id\":\"2\",\"sender_id\":\"1\"}`}{if _,e:=decodeRecall([]byte(bad));e==nil{t.Fatal(\"malformed recall\",bad)}}\n if _,e:=decodeRecall([]byte(`{\"conversation_id\":\"1\",\"message_id\":\"2\"}`));e!=nil{t.Fatal(e)}\n}\n","chat/internal/message/socket.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// SocketCommands adapts the exact HTTP payload decoders and application use\n// cases. Runtime supplies no sender until the independent release gate opens.\ntype SocketCommands struct {\n\tSender  *Service\n\tHistory *HistoryService\n}\ntype commandError struct {\n\tcode  string\n\tretry bool\n}\n\nfunc (e commandError) Error() string              { return e.code }\nfunc (e commandError) PublicCode() (string, bool) { return e.code, e.retry }\nfunc socketError(e error) error {\n\tif e == nil {\n\t\treturn nil\n\t}\n\tswitch {\n\tcase errors.Is(e, ports.ErrInvalid):\n\t\treturn commandError{\"CHAT_INVALID_REQUEST\", false}\n\tcase errors.Is(e, policy.ErrDenied), errors.Is(e, auth.ErrUnauthorized):\n\t\treturn commandError{\"CHAT_PERMISSION_DENIED\", false}\n\tcase errors.Is(e,ErrReference),errors.Is(e,ErrReeditLimit),errors.Is(e,ErrRecall),errors.Is(e,ErrRecallWindow),errors.Is(e, ErrPreferenceConflict), errors.Is(e,ErrPinLimit), errors.Is(e, ErrConflict), errors.Is(e, ErrExpired), errors.Is(e, ErrRestricted), errors.Is(e, ErrResync):\n\t\treturn commandError{e.Error(), false}\n\tcase errors.Is(e, ErrUnknown), errors.Is(e, ErrCheck), errors.Is(e, ports.ErrBusy):\n\t\treturn commandError{e.Error(), true}\n\tdefault:\n\t\treturn commandError{ports.ErrUnavailable.Error(), true}\n\t}\n}\nfunc (s SocketCommands) Execute(ctx context.Context, p ports.Principal, typ string, raw json.RawMessage) (string, any, error) {\n\tif len(raw) > 4096 && typ != \"message.send\" && typ != \"message.status\" {\n\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t}\n\tvar out any\n\tvar e error\n\tresponse := typ + \".result\"\n\tswitch typ {\n\tcase \"message.recall\":\n        if s.Sender==nil{return \"\",nil,commandError{\"CHAT_MESSAGES_NOT_READY\",false}}\n        q,err:=decodeRecall(raw);if err!=nil{return \"\",nil,socketError(err)}\n        out,e=s.Sender.Recall(ctx,p,q.ConversationID,q.TargetID)\n\tcase \"message.send\", \"message.status\":\n\t\tif s.Sender == nil {\n\t\t\treturn \"\", nil, commandError{\"CHAT_MESSAGES_NOT_READY\", false}\n\t\t}\n\t\tq, err := decode(raw, typ == \"message.status\")\n\t\tif err != nil {\n\t\t\treturn \"\", nil, socketError(err)\n\t\t}\n\t\tif typ == \"message.send\" {\n\t\t\tout, e = s.Sender.Send(ctx, p, q)\n\t\t\tresponse = \"message.result\"\n\t\t\tif r, ok := out.(Result); ok && r.State == \"accepted\" {\n\t\t\t\tresponse = \"message.accepted\"\n\t\t\t}\n\t\t} else {\n\t\t\tout, e = s.Sender.Query(ctx, p, q.ConversationID, q.ClientMessageID)\n\t\t}\n\tcase \"conversation.bootstrap\", \"history.request\", \"sync.request\", \"changes.sync\", \"message.locate\":\n\t\tif s.History == nil {\n\t\t\treturn \"\", nil, commandError{\"CHAT_HISTORY_NOT_READY\", false}\n\t\t}\n\t\tmode := map[string]string{\"conversation.bootstrap\": \"bootstrap\", \"history.request\": \"history\", \"sync.request\": \"sync\", \"changes.sync\": \"changes\", \"message.locate\": \"locate\"}[typ]\n\t\tq, err := decodeHistory(raw)\n\t\tif err != nil {\n\t\t\treturn \"\", nil, socketError(err)\n\t\t}\n\t\tout, e = s.History.Read(ctx, p, q, mode)\n\t\tif typ == \"sync.request\" {\n\t\t\tresponse = \"sync.result\"\n\t\t}\n\tcase \"conversation.preferences\",\"conversation.preference\":\n  if s.History==nil{return \"\",nil,commandError{\"CHAT_HISTORY_NOT_READY\",false}}\n  q,err:=decodePreference(raw,typ==\"conversation.preference\");if err!=nil{return \"\",nil,socketError(err)}\n  if typ==\"conversation.preference\"{out,e=s.History.SetPreference(ctx,p,q)}else{out,e=s.History.Preferences(ctx,p,q.ConversationID)}\n case \"receipt.read\", \"conversation.unread\", \"account.digests\":\n\t\tif s.History == nil {\n\t\t\treturn \"\", nil, commandError{\"CHAT_HISTORY_NOT_READY\", false}\n\t\t}\n\t\tq, err := decodeS09(raw)\n\t\tif err != nil {\n\t\t\treturn \"\", nil, socketError(err)\n\t\t}\n\t\tswitch typ {\n\t\tcase \"receipt.read\":\n\t\t\tif !validID(q.ConversationID) || q.Cursor == \"\" || q.Limit != 0 {\n\t\t\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t\t\t}\n\t\t\tout, e = s.History.Acknowledge(ctx, p, q.ConversationID, q.Cursor)\n\t\tcase \"conversation.unread\":\n\t\t\tif !validID(q.ConversationID) || q.Cursor != \"\" || q.Limit != 0 {\n\t\t\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t\t\t}\n\t\t\tout, e = s.History.Unread(ctx, p, q.ConversationID)\n\t\tcase \"account.digests\":\n\t\t\tif q.ConversationID != \"\" || q.Limit < 1 || q.Limit > 20 {\n\t\t\t\treturn \"\", nil, socketError(ports.ErrInvalid)\n\t\t\t}\n\t\t\tout, e = s.History.DigestsCursor(ctx, p, q.Cursor, q.Limit)\n\t\t}\n\tdefault:\n\t\treturn \"\", nil, commandError{\"CHAT_COMMAND_UNKNOWN\", false}\n\t}\n\treturn response, out, socketError(e)\n}\n","chat/internal/message/socket_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/gorilla/websocket\"\n\t\"github.com/redis/go-redis/v9\"\n)\n\nfunc TestMySQLRedisS10HTTPAndWSSUseTheSameCommands(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 0)\n\taddress := os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\")\n\tif address == \"\" {\n\t\tt.Fatal(\"explicit isolated Redis required\")\n\t}\n\tredisClient := redis.NewClient(&redis.Options{Addr: address, PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, DisableIdentity: true, Protocol: 2})\n\tdefer redisClient.Close()\n\tticketStore, e := auth.NewRedisStore(redisClient, \"test\", \"bxchat:test:\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\tverifier, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"s10\": pub})\n\tsource, _ := auth.NewMySQLSource(f.goDB)\n\tidentity, e := auth.NewService(verifier, source, ticketStore, 4, time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tp := principal(\"10202\")\n\tnow := time.Now().Unix()\n\tclaims := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: p.Environment, Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\traw, _ := json.Marshal(claims)\n\tunsigned := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"s10\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(raw)\n\ttoken := unsigned + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(unsigned)))\n\tgateway, e := socket.New(identity, SocketCommands{Sender: s, History: h})\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tsendHTTP, _ := NewHandler(s, identity, 4)\n\treadHTTP, _ := NewHistoryHandler(h, identity, 4)\n\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tif r.URL.Path == \"/chat/ws\" {\n\t\t\tgateway.ServeHTTP(w, r)\n\t\t} else if strings.HasSuffix(r.URL.Path, \"/send\") {\n\t\t\tsendHTTP.ServeHTTP(w, r)\n\t\t} else {\n\t\t\treadHTTP.ServeHTTP(w, r)\n\t\t}\n\t}))\n\tdefer server.Close()\n\tdefer func() {\n\t\tctx, cancel := context.WithTimeout(context.Background(), time.Second)\n\t\tdefer cancel()\n\t\tif e := gateway.Shutdown(ctx); e != nil {\n\t\t\tt.Error(e)\n\t\t}\n\t}()\n\tws, _, e := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdefer ws.Close()\n\tcall := func(typ string, payload any) (string, json.RawMessage) {\n\t\tt.Helper()\n\t\tif e := ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"s10\", \"type\": typ, \"payload\": payload}); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\tvar out struct {\n\t\t\tType    string          `json:\"type\"`\n\t\t\tPayload json.RawMessage `json:\"payload\"`\n\t\t}\n\t\tif e := ws.ReadJSON(&out); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\treturn out.Type, out.Payload\n\t}\n\tticket, _, e := identity.IssueTicket(f.ctx, token)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\ttyp, _ := call(\"auth\", map[string]string{\"ticket\": ticket})\n\tif typ != \"auth.ok\" {\n\t\tt.Fatal(typ)\n\t}\n\ttyp, body := call(\"message.send\", q)\n\tvar first Result\n\tif typ != \"message.accepted\" || json.Unmarshal(body, &first) != nil || first.Seq != \"1\" {\n\t\tt.Fatalf(\"send %s %s\", typ, body)\n\t}\n\thttpCall := func(path string, payload any) json.RawMessage {\n\t\tt.Helper()\n\t\tb, _ := json.Marshal(payload)\n\t\tr, _ := http.NewRequest(\"POST\", server.URL+path, strings.NewReader(string(b)))\n\t\tr.Header.Set(\"Authorization\", \"Bearer \"+token)\n\t\tr.Header.Set(\"Content-Type\", \"application/json\")\n\t\tres, e := server.Client().Do(r)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer res.Body.Close()\n\t\tb, _ = io.ReadAll(res.Body)\n\t\tif res.StatusCode != 200 {\n\t\t\tt.Fatalf(\"HTTP %d %s\", res.StatusCode, b)\n\t\t}\n\t\tvar out struct {\n\t\t\tData json.RawMessage `json:\"data\"`\n\t\t}\n\t\tif json.Unmarshal(b, &out) != nil {\n\t\t\tt.Fatal(\"HTTP data\")\n\t\t}\n\t\treturn out.Data\n\t}\n\tvar repeated Result\n\tjson.Unmarshal(httpCall(\"/chat/api/v1/messages/send\", q), &repeated)\n\tif repeated.MessageID != first.MessageID || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"HTTP retry duplicated WSS send\")\n\t}\n\ttyp, body = call(\"message.status\", map[string]string{\"conversation_id\": string(q.ConversationID), \"client_message_id\": q.ClientMessageID})\n\tjson.Unmarshal(body, &repeated)\n\tif typ != \"message.status.result\" || repeated.MessageID != first.MessageID {\n\t\tt.Fatal(\"WSS result lookup\")\n\t}\n\ttyp, body = call(\"conversation.bootstrap\", HistoryRequest{ConversationID: q.ConversationID})\n\tvar boot HistoryPage\n\tif typ != \"conversation.bootstrap.result\" || json.Unmarshal(body, &boot) != nil || len(boot.Messages) != 1 {\n\t\tt.Fatalf(\"bootstrap %s %s\", typ, body)\n\t}\n\t// Cross-transport opaque cursors are identical contracts, not numeric seqs.\n\tvar syncPage HistoryPage\n\tjson.Unmarshal(httpCall(\"/chat/api/v1/messages/sync\", HistoryRequest{ConversationID: q.ConversationID, Cursor: boot.SyncCursor}), &syncPage)\n\ttyp, body = call(\"receipt.read\", map[string]string{\"conversation_id\": string(q.ConversationID), \"cursor\": syncPage.SyncCursor})\n\tif typ != \"receipt.read.result\" {\n\t\tt.Fatalf(\"read %s %s\", typ, body)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != \"1\" {\n\t\tt.Fatal(\"explicit read did not commit\")\n\t}\n\t// Scope/policy checks are shared too. Revoking the PHP guard cannot be\n\t// bypassed through an already authenticated socket.\n\tf.exec(\"UPDATE chat_policy_guards SET policy_version=policy_version+1 WHERE order_id=401\")\n\ttyp, body = call(\"conversation.bootstrap\", HistoryRequest{ConversationID: q.ConversationID})\n\tif typ != \"error\" || !strings.Contains(string(body), \"CHAT_PERMISSION_DENIED\") {\n\t\tt.Fatalf(\"revoked policy %s %s\", typ, body)\n\t}\n\t// PHP logout invalidates an existing WSS identity before the next command;\n\t// there is no wait for an advisory Redis event or periodic idle check.\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif e = ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"logout\", \"type\": \"conversation.bootstrap\", \"payload\": HistoryRequest{ConversationID: q.ConversationID}}); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\tif _, _, e = ws.ReadMessage(); !websocket.IsCloseError(e, websocket.ClosePolicyViolation) {\n\t\tt.Fatalf(\"revoked PHP login kept socket usable: %v\", e)\n\t}\n}\n\nfunc TestMySQLS15SocketRecallUsesSameDecoderAndUseCase(t *testing.T){\n f,s,h,q:=historyFixture(t,0);m:=accepted(t,s,q)\n commands:=SocketCommands{Sender:s,History:h}\n raw,_:=json.Marshal(map[string]any{\"conversation_id\":q.ConversationID,\"message_id\":m.MessageID})\n typ,out,e:=commands.Execute(f.ctx,principal(\"10202\"),\"message.recall\",raw)\n if e!=nil||typ!=\"message.recall.result\"||out.(MessageView).Text!=nil||out.(MessageView).State!=\"recalled\"{t.Fatal(typ,out,e)}\n if _,_,e:=commands.Execute(f.ctx,principal(\"10202\"),\"message.recall\",append(raw[:len(raw)-1],[]byte(`,\"read_seq\":\"1\"}`)...));e==nil{t.Fatal(\"recall extra field\")}\n}\n","chat/internal/message/socket_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"testing\"\n)\n\nfunc TestS10RuntimeSocketReleaseGates(t *testing.T) {\n\tc := SocketCommands{}\n\tfor typ, want := range map[string]string{\"message.send\": \"CHAT_MESSAGES_NOT_READY\", \"message.status\": \"CHAT_MESSAGES_NOT_READY\", \"sync.request\": \"CHAT_HISTORY_NOT_READY\", \"receipt.read\": \"CHAT_HISTORY_NOT_READY\", \"typing.start\": \"CHAT_COMMAND_UNKNOWN\", \"method.inject\": \"CHAT_COMMAND_UNKNOWN\"} {\n\t\t_, _, err := c.Execute(context.Background(), ports.Principal{}, typ, json.RawMessage(`{}`))\n\t\tif err == nil || err.Error() != want {\n\t\t\tt.Fatalf(\"%s %v\", typ, err)\n\t\t}\n\t}\n}\n","chat/internal/message/unread.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"strconv\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nconst unreadCountLimit = 1000\n\ntype UnreadWindow struct {\n\tCountCapped    bool       `json:\"unread_count_capped\"`\n\tReadSeq        ports.ID   `json:\"read_seq\"`\n\tSnapshotSeq    ports.ID   `json:\"snapshot_max_seq\"`\n\tSnapshotChange ports.ID   `json:\"snapshot_max_change_seq\"`\n\tPolicyVersion  ports.ID   `json:\"policy_version\"`\n\tCount          uint64     `json:\"unread_count\"`\n\tFirstMessage   ports.ID   `json:\"first_unread_message_id,omitempty\"`\n\tFirstSeq       ports.ID   `json:\"first_unread_seq,omitempty\"`\n\tLastMessageAt  *time.Time `json:\"last_message_at,omitempty\"`\n LastMessage *MessageView `json:\"last_message,omitempty\"`\n OrderContext *ports.OrderContext `json:\"order_context,omitempty\"`\n MemberRole string `json:\"member_role\"`\n CanSend bool `json:\"can_send\"`\n ConversationState string `json:\"conversation_state\"`\n Preferences *Preferences `json:\"preferences,omitempty\"`\n}\n\n// unreadLocked counts actual currently eligible incoming published messages,\n// never the gap between sequence numbers. Call only under AuthorizeLocked.\nfunc unreadLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, id ports.ID, grant ports.Grant, read, upper, change uint64) (UnreadWindow, error) {\n\tif read > upper {\n\t\treturn UnreadWindow{}, ports.ErrInvalid\n\t}\n\tresult := UnreadWindow{ReadSeq: decimal(read), SnapshotSeq: decimal(upper), SnapshotChange: decimal(change), PolicyVersion: grant.Version, OrderContext: grant.OrderContext, MemberRole: grant.MemberRole, CanSend: grant.CanSend}\n\t// Activity belongs to the last message this member may see, including their\n\t// own messages and recall placeholders. Read acknowledgements never move it.\n\tvar preview MessageView\n var text sql.NullString\n err := tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR),CAST(m.sender_id AS CHAR),CAST(m.policy_version AS CHAR),m.message_type,m.state,CAST(m.state_version AS CHAR),CASE WHEN m.state='published' AND m.message_type='text' THEN LEFT(m.text_body,160) ELSE NULL END,m.created_at,(SELECT COUNT(*) FROM chat_image_items ci WHERE ci.message_id=m.id) FROM chat_messages m WHERE m.conversation_id=? AND m.seq<=? AND m.policy_version<=? AND EXISTS (\n SELECT 1 FROM chat_member_intervals i WHERE i.conversation_id=m.conversation_id AND i.actor_id=?\n AND i.start_version<=m.policy_version AND (i.end_version IS NULL OR i.end_version>m.policy_version)) ORDER BY m.seq DESC LIMIT 1`, string(id), upper, string(grant.Version), string(p.ActorID)).Scan(&preview.ID,&preview.Seq,&preview.SenderID,&preview.PolicyVersion,&preview.Type,&preview.State,&preview.StateVersion,&text,&preview.CreatedAt,&preview.ImageCount)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif err == nil {\n\t\tpreview.CreatedAt = preview.CreatedAt.UTC()\n  result.LastMessageAt = &preview.CreatedAt\n  if preview.State == \"published\" && preview.Type == \"text\" && text.Valid { value:=text.String; preview.Text=&value }\n  if preview.State != \"published\" && preview.State != \"recalled\" && preview.State != \"blocked\" { preview.State=\"unavailable\"; preview.Text=nil }\n  result.LastMessage = &preview\n\t}\n\tprefs, err := preferenceLocked(ctx,tx,p,id,grant)\n if err != nil { return UnreadWindow{},err }\n prefs.AccountRevision,err=accountRevision(ctx,tx,p.ActorID);if err!=nil{return UnreadWindow{},err};result.Preferences=&prefs\n if tx.QueryRowContext(ctx, `SELECT state FROM chat_conversations WHERE id=?`,string(id)).Scan(&result.ConversationState)!=nil{return UnreadWindow{},ports.ErrUnavailable}\n predicate := `m.conversation_id=? AND m.seq>? AND m.seq<=? AND m.state='published' AND m.sender_id<>? AND m.policy_version<=? AND EXISTS (\n SELECT 1 FROM chat_member_intervals i WHERE i.conversation_id=m.conversation_id AND i.actor_id=?\n AND i.start_version<=m.policy_version AND (i.end_version IS NULL OR i.end_version>m.policy_version))`\n\targs := []any{string(id), read, upper, string(p.ActorID), string(grant.Version), string(p.ActorID)}\n\tif err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM (SELECT m.id FROM chat_messages m FORCE INDEX (idx_chat_unread) WHERE `+predicate+` LIMIT 1001) unread_candidates`, args...).Scan(&result.Count); err != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif result.Count > unreadCountLimit {\n\t\tresult.Count = unreadCountLimit\n\t\tresult.CountCapped = true\n\t}\n\tvar first, seq string\n\te := tx.QueryRowContext(ctx, `SELECT CAST(m.id AS CHAR),CAST(m.seq AS CHAR) FROM chat_messages m FORCE INDEX (idx_chat_unread) WHERE `+predicate+` ORDER BY m.seq ASC LIMIT 1`, args...).Scan(&first, &seq)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif e == nil {\n\t\tresult.FirstMessage = ports.ID(first)\n\t\tresult.FirstSeq = ports.ID(seq)\n\t}\n\treturn result, nil\n}\n\n// unreadSince is for trusted server-side preloaded watermarks and tests; HTTP\n// consumers must use Unread, which reads the watermark inside its own lock.\nfunc (s *HistoryService) unreadSince(ctx context.Context, p ports.Principal, id ports.ID, readSeq ports.ID) (UnreadWindow, error) {\n\tif !validID(id) || !readSeq.Valid() || p.Environment != s.environment {\n\t\treturn UnreadWindow{}, ports.ErrInvalid\n\t}\n\tread, _ := strconv.ParseUint(string(readSeq), 10, 64)\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tvar upper, change uint64\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&upper, &change) != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tout, e := unreadLocked(ctx, tx, p, id, g, read, upper, change)\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn UnreadWindow{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// Unread obtains authorization, committed max sequence, persisted watermark,\n// publication states and membership ranges in one transaction. No read\n// acknowledgement is created by opening an unread/digest endpoint.\nfunc (s *HistoryService) Unread(ctx context.Context, p ports.Principal, id ports.ID) (UnreadWindow, error) {\n\tif !validID(id) || !p.ActorID.Valid() || p.Environment != s.environment {\n\t\treturn UnreadWindow{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tg, e := s.conversations.AuthorizeLocked(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: id, Action: \"read\"})\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tvar upper, change, read uint64\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq FROM chat_conversations WHERE id=?`, string(id)).Scan(&upper, &change) != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tvar hash string\n\te = tx.QueryRowContext(ctx, `SELECT member_key_hash,read_seq FROM chat_member_reads WHERE conversation_id=? AND actor_id=?`, string(id), string(p.ActorID)).Scan(&hash, &read)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\tif e == sql.ErrNoRows || hash != memberHash(g.MemberKey) {\n\t\tread = 0\n\t}\n\tout, e := unreadLocked(ctx, tx, p, id, g, read, upper, change)\n\tif e != nil {\n\t\treturn UnreadWindow{}, e\n\t}\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn UnreadWindow{}, policy.ErrDenied\n\t}\n\tif tx.Commit() != nil {\n\t\treturn UnreadWindow{}, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}","chat/internal/message/unread_integration_test.go":"package message\n\nimport (\n    \"context\"\n    \"testing\"\n    \"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc TestMySQLS09UnreadEligibilityAndAnchor(t *testing.T) {\n    f, _, h, r := historyFixture(t, 6)\n    // S08 fixture sends as 10202. A sender's own published messages are never unread.\n    p, err := h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"0\")\n    if err != nil || p.Count != 0 || p.FirstMessage != \"\" || p.SnapshotSeq != \"6\" {\n        t.Fatalf(\"self messages counted: %+v, %v\", p, err)\n    }\n    f.exec(`UPDATE chat_messages SET sender_id=10203 WHERE conversation_id=? AND seq IN (2,3,5)`, string(r.ConversationID))\n    f.exec(`UPDATE chat_messages SET state='recalled',state_version=2 WHERE conversation_id=? AND seq=3`, string(r.ConversationID))\n    p, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"1\")\n    if err != nil || p.Count != 2 || p.FirstSeq != \"2\" || p.FirstMessage == \"\" {\n        t.Fatalf(\"incorrect unread window: %+v, %v\", p, err)\n    }\n    p, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"2\")\n    if err != nil || p.Count != 1 || p.FirstSeq != \"5\" {\n        t.Fatalf(\"read through anchor: %+v, %v\", p, err)\n    }\n    if _, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"7\"); err != ports.ErrInvalid {\n        t.Fatalf(\"future watermark accepted: %v\", err)\n    }\n    if _, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"not-a-number\"); err != ports.ErrInvalid {\n        t.Fatalf(\"invalid watermark accepted: %v\", err)\n    }\n    f.exec(`UPDATE chat_messages SET policy_version=999 WHERE conversation_id=? AND seq=5`, string(r.ConversationID))\n    p, err = h.unreadSince(context.Background(), principal(\"10202\"), r.ConversationID, \"2\")\n    if err != nil || p.Count != 0 {\n        t.Fatalf(\"future policy visible: %+v, %v\", p, err)\n    }\n}\n","chat/internal/moderation/rules.go":"package moderation\n\nimport (\n\t\"regexp\"\n\t\"strings\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n)\n\nconst RuleVersion = \"wechat-v2.diversion-20261022.1\"\n\nvar appPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{1,64}$`)\nvar tokenPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{10,}$`)\nvar hexPattern = regexp.MustCompile(`^[a-f0-9]{64}$`)\nvar openIDPattern = regexp.MustCompile(`^[A-Za-z0-9_-]{20,64}$`)\nvar clauses = regexp.MustCompile(`[，,。！？!?;；\\n]+`)\nvar negated = regexp.MustCompile(`(?:请勿|不要|禁止|不准|不能|别再|拒绝|不允许|不得)(?:私下|私自|绕过平台|发|发送|添加|加|提供|泄露|透露|联系|转账|走私单)`)\nvar mobile = regexp.MustCompile(`(?:^|[^0-9])(?:\\+?86)?(1[3-9][0-9]{9})(?:[^0-9]|$)`)\nvar contact = regexp.MustCompile(`(?:联系我|联系你|联系电话|手机号|手机号码|电话|打给我|致电|加我|拨打|给我打)`)\nvar wechatID = regexp.MustCompile(`(?:微信|weixin|vx|wx|v信|薇信)(?:号|是|为|号码|[:：])*([a-z][a-z0-9_-]{5,19})`)\nvar privateDeal = regexp.MustCompile(`(?:绕过平台|不要走平台|不走平台|别走平台|避开平台|私下接单|私下成交|私下交易|私下转账|私下做|私下付款|省掉服务费|绕过服务费|取消订单.{0,24}私下|私下.{0,24}取消订单)`)\nvar englishDigit = regexp.MustCompile(`\\b(zero|one|two|three|four|five|six|seven|eight|nine|ling|yao|yi|er|san|si|wu|liu|qi|ba|jiu)\\b`)\nvar digitWords = map[string]string{\"zero\": \"0\", \"one\": \"1\", \"two\": \"2\", \"three\": \"3\", \"four\": \"4\", \"five\": \"5\", \"six\": \"6\", \"seven\": \"7\", \"eight\": \"8\", \"nine\": \"9\", \"ling\": \"0\", \"yao\": \"1\", \"yi\": \"1\", \"er\": \"2\", \"san\": \"3\", \"si\": \"4\", \"wu\": \"5\", \"liu\": \"6\", \"qi\": \"7\", \"ba\": \"8\", \"jiu\": \"9\"}\n\nfunc validEnvironment(e string) bool { return e == \"production\" || e == \"development\" || e == \"test\" }\nfunc normalize(text string) string {\n\tvar b strings.Builder\n\tfor _, r := range strings.ToLower(text) {\n\t\tif r >= 0xff01 && r <= 0xff5e {\n\t\t\tr -= 0xfee0\n\t\t\tr = unicode.ToLower(r)\n\t\t}\n\t\tif unicode.Is(unicode.Cf, r) {\n\t\t\tcontinue\n\t\t}\n\t\tswitch r {\n\t\tcase '零', '〇', '洞':\n\t\t\tr = '0'\n\t\tcase '一', '壹', '幺':\n\t\t\tr = '1'\n\t\tcase '二', '贰', '两':\n\t\t\tr = '2'\n\t\tcase '三', '叁':\n\t\t\tr = '3'\n\t\tcase '四', '肆':\n\t\t\tr = '4'\n\t\tcase '五', '伍':\n\t\t\tr = '5'\n\t\tcase '六', '陆':\n\t\t\tr = '6'\n\t\tcase '七', '柒', '拐':\n\t\t\tr = '7'\n\t\tcase '八', '捌':\n\t\t\tr = '8'\n\t\tcase '九', '玖', '勾':\n\t\t\tr = '9'\n\t\t}\n\t\tb.WriteRune(r)\n\t}\n\treturn englishDigit.ReplaceAllStringFunc(b.String(), func(v string) string { return digitWords[v] })\n}\nfunc compact(text string) string {\n\treturn strings.Map(func(r rune) rune {\n\t\tif unicode.IsSpace(r) || r == '-' || r == '_' || r == '·' || r == '/' || r == '\\\\' || r == '(' || r == ')' || r == '（' || r == '）' {\n\t\t\treturn -1\n\t\t}\n\t\treturn r\n\t}, text)\n}\n\n// analyze requires contextual evidence. A bare 11-digit number, quote/size,\n// order number, approved order contact entry or a warning is not a violation.\n// Context contains at most five same-author/same-conversation logical actions.\nfunc analyze(text string, previous []string) string {\n\tclean := func(s string) string {\n\t\tparts := clauses.Split(normalize(s), -1)\n\t\tout := make([]string, 0, len(parts))\n\t\tfor _, p := range parts {\n\t\t\tif !negated.MatchString(p) {\n\t\t\t\tout = append(out, p)\n\t\t\t}\n\t\t}\n\t\treturn strings.Join(out, \"\")\n\t}\n\tcurrent := clean(text)\n\tif privateDeal.MatchString(compact(current)) {\n\t\treturn \"off_platform_deal\"\n\t}\n\tif strings.Contains(current, \"weixin://\") {\n\t\treturn \"private_contact_link\"\n\t}\n\tif wechatEvidence(compact(current)) {\n\t\treturn \"private_wechat\"\n\t}\n\tif contact.MatchString(current) && mobile.MatchString(compact(current)) {\n\t\treturn \"private_phone\"\n\t}\n\t// Never turn a currently negated instruction into evidence by concatenating\n\t// a previous fragment. Old lawful/blocked fragments are context, not new risk.\n\tif current == \"\" {\n\t\treturn \"\"\n\t}\n\tprior := \"\"\n\tfor _, p := range previous {\n\t\tprior += clean(p)\n\t}\n\tjoined := prior + current\n\tif contact.MatchString(joined) && mobile.MatchString(compact(joined)) && !(contact.MatchString(prior) && mobile.MatchString(compact(prior))) {\n\t\t// Require the current action to contribute at least one digit/contact cue;\n\t\t// an unrelated later greeting must not become a fresh violation.\n\t\tif strings.ContainsAny(compact(current), \"0123456789\") || contact.MatchString(current) {\n\t\t\treturn \"split_private_phone\"\n\t\t}\n\t}\n\tif !wechatEvidence(compact(prior)) && wechatEvidence(compact(joined)) && (strings.ContainsAny(current, \"abcdefghijklmnopqrstuvwxyz0123456789\") || strings.Contains(current, \"微信\")) {\n\t\treturn \"split_private_wechat\"\n\t}\n\treturn \"\"\n}\nfunc validText(s string) bool {\n\treturn utf8.ValidString(s) && len(s) > 0 && len(s) <= 4000 && utf8.RuneCountInString(s) <= 2000 && strings.TrimSpace(s) != \"\" && !strings.ContainsRune(s, 0)\n}\n\nvar wechatCue = regexp.MustCompile(`(?:加我|加你|添加|加好友|加微信|加vx|加wx|微信号|vx号|我的微信|我的vx|联系|私聊|好友|微信[:：]|vx[:：])`)\n\nfunc wechatEvidence(text string) bool {\n\tif !wechatID.MatchString(text) {\n\t\treturn false\n\t}\n\treturn wechatCue.MatchString(text) || strings.HasPrefix(text, \"微信\") || strings.HasPrefix(text, \"weixin\") || strings.HasPrefix(text, \"vx\") || strings.HasPrefix(text, \"wx\")\n}\n","chat/internal/moderation/rules_test.go":"package moderation\n\nimport \"testing\"\n\nfunc TestDiversionRulesAndConstructionNegatives(t *testing.T) {\n\tcases := []struct {\n\t\ttext     string\n\t\tprevious []string\n\t\tblocked  bool\n\t}{\n\t\t{\"电话 １３８ ００１３ ８０００\", nil, true},\n\t\t{\"联系我 一三八 零零一三 八零零零\", nil, true},\n\t\t{\"电话 one three eight zero zero one three eight zero zero zero\", nil, true},\n\t\t{\"电话 yao san ba ling ling yi san ba ling ling ling\", nil, true},\n\t\t{\"加我 ＶＸ：abc_123456\", nil, true},\n\t\t{\"加微信a\\u200bb\\u200cc123456\", nil, true},\n\t\t{\"weixin://contacts/profile/fixture\", nil, true},\n\t\t{\"取消订单后私下做，省掉服务费\", nil, true},\n\t\t{\"不走平台，这单私下做\", nil, true},\n\t\t{\"13800138000\", nil, false},\n\t\t{\"工单号13800138000，墙长12.5米，面积25平方米，报价1380元\", nil, false},\n\t\t{\"施工20261022138001，预约10:30，五楼二单元三零一\", nil, false},\n\t\t{\"不要私下加微信\", nil, false},\n\t\t{\"禁止绕过平台交易\", nil, false},\n\t\t{\"请勿发送电话13800138000\", nil, false},\n\t\t{\"售后电话请在订单页面查看\", nil, false},\n\t\t{\"请使用订单的联系师傅入口，尾款在原入口确认\", nil, false},\n\t\t{\"加微信\", nil, false},\n\t\t{\"型号VXabc123456，按图施工\", nil, false},\n\t\t{\"材料说明 https://brand.example.test/spec/13800138000\", nil, false},\n\t\t{\"不要私下加微信abc123，但加微信xyz789\", nil, true},\n\t\t{\"38000\", []string{\"电话138001\"}, true},\n\t\t{\"def456\", []string{\"微信abc\"}, true},\n\t\t{\"ok\", []string{\"请勿私下加微信abc123\"}, false},\n\t\t{\"ok\", []string{\"微信abc123456\"}, false},\n\t\t{\"你好\", []string{\"电话13800138000\"}, false},\n\t}\n\tfor _, c := range cases {\n\t\tt.Run(c.text, func(t *testing.T) {\n\t\t\tcode := analyze(c.text, c.previous)\n\t\t\tif (code != \"\") != c.blocked {\n\t\t\t\tt.Fatalf(\"decision %q expected blocked=%v\", code, c.blocked)\n\t\t\t}\n\t\t})\n\t}\n}\n","chat/internal/moderation/service.go":"package moderation\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Config struct {\n\tEnabled        bool   `json:\"enabled\"`\n\tAppID          string `json:\"app_id\"`\n\tCredentialFile string `json:\"credential_file\"`\n}\n\nfunc (c Config) Validate() error {\n\tif !c.Enabled {\n\t\tif c.AppID != \"\" || c.CredentialFile != \"\" {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\treturn nil\n\t}\n\tif !appPattern.MatchString(c.AppID) || !filepath.IsAbs(c.CredentialFile) {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\ntype HTTPClient interface {\n\tDo(*http.Request) (*http.Response, error)\n}\ntype Service struct {\n\tdb                 *sql.DB\n\tsource             *auth.MySQLSource\n\tcredentials        *Credentials\n\tenvironment, appID string\n\tclient             HTTPClient\n\tgate               chan struct{}\n\ttimeout            time.Duration\n}\n\nfunc New(db *sql.DB, environment string, c Config, concurrency int, timeout time.Duration, client HTTPClient) (*Service, error) {\n\tif db == nil || !c.Enabled || c.Validate() != nil || !validEnvironment(environment) || concurrency < 1 || concurrency > 16 || timeout < 100*time.Millisecond || timeout > 2*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tcredentials, e := NewCredentials(c.CredentialFile, environment, c.AppID)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tsource, e := auth.NewMySQLSource(db)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tif client == nil {\n\t\tclient = &http.Client{Timeout: timeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }, Transport: &http.Transport{Proxy: nil, DialContext: (&net.Dialer{Timeout: timeout / 2, KeepAlive: 30 * time.Second}).DialContext, MaxConnsPerHost: concurrency, MaxIdleConns: concurrency, MaxIdleConnsPerHost: concurrency, IdleConnTimeout: 30 * time.Second, ResponseHeaderTimeout: timeout}}\n\t}\n\treturn &Service{db, source, credentials, environment, c.AppID, client, make(chan struct{}, concurrency), timeout}, nil\n}\nfunc (s *Service) CheckText(ctx context.Context, q ports.TextRequest) (ports.SafetyResult, error) {\n\tif q.Actor.Environment != s.environment || q.Actor.Kind != \"mini\" || !validID(q.IntentID) || !validID(q.ConversationID) || !validText(q.Text) || !hexPattern.MatchString(q.Fingerprint) {\n\t\treturn ports.SafetyResult{}, ports.ErrInvalid\n\t}\n\tselect {\n\tcase s.gate <- struct{}{}:\n\t\tdefer func() { <-s.gate }()\n\tdefault:\n\t\treturn ports.SafetyResult{}, ports.ErrBusy\n\t}\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\tidentity, e := s.identity(ctx, q.Actor, nil)\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tcontextItems, e := s.prepare(ctx, q)\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tprevious := make([]string, 0, len(contextItems))\n\tfor _, item := range contextItems {\n\t\tprevious = append(previous, item.NormalizedText)\n\t}\n\tif code := analyze(q.Text, previous); code != \"\" {\n\t\tevidence := \"\"\n\t\tif strings.HasPrefix(code, \"split_\") {\n\t\t\tsnapshot := append(contextItems, contextItem{IntentID: q.IntentID, Fingerprint: q.Fingerprint, NormalizedText: normalize(q.Text)})\n\t\t\traw, _ := json.Marshal(struct {\n\t\t\t\tSchema  int           `json:\"schema\"`\n\t\t\t\tActions []contextItem `json:\"actions\"`\n\t\t\t}{1, snapshot})\n\t\t\tevidence = string(raw)\n\t\t}\n\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: RuleVersion, AuthorityProof: identity.proof, Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: code, Level: 2, Confirmed: true, ContextEvidence: evidence}}, nil\n\t}\n\tcredential, e := s.credentials.Get()\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tkey := hash(strings.Join([]string{s.environment, s.appID, identity.proof, q.Actor.SessionVersion, \"scene:1\", RuleVersion, q.Fingerprint}, \"\\n\"))\n\tvar cached int\n\te = s.db.QueryRowContext(ctx, `SELECT 1 FROM chat_text_checks WHERE cache_key=? AND pass_until>UTC_TIMESTAMP(6) LIMIT 1`, key).Scan(&cached)\n\tif e != nil && e != sql.ErrNoRows {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tif cached > 0 {\n\t\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: RuleVersion, AuthorityProof: identity.proof}, nil\n\t}\n\tresult, e := s.inspect(ctx, credential, identity.openid, q.Text)\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tresult.RuleVersion = RuleVersion\n\tresult.AuthorityProof = identity.proof\n\tif result.Decision == \"passed\" {\n\t\t// Only an explicit official pass is cached. Local contextual rules always\n\t\t// ran first and cannot be bypassed by a prior hash-only cache hit.\n\t\tif _, e = s.db.ExecContext(ctx, `UPDATE chat_text_checks SET cache_key=?,pass_until=UTC_TIMESTAMP(6)+INTERVAL 5 MINUTE WHERE intent_id=? AND fingerprint=?`, key, string(q.IntentID), q.Fingerprint); e != nil {\n\t\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t\t}\n\t}\n\treturn result, nil\n}\nfunc validID(id ports.ID) bool { return id.Valid() && id != \"0\" }\n\nvar tracePattern = regexp.MustCompile(`^[A-Za-z0-9_-]{0,128}$`)\n\nfunc (s *Service) inspect(ctx context.Context, c Credential, openid, text string) (ports.SafetyResult, error) {\n\tbody, e := json.Marshal(map[string]any{\"version\": 2, \"scene\": 1, \"openid\": openid, \"content\": text})\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tendpoint := \"https://api.weixin.qq.com/wxa/msg_sec_check?\" + url.Values{\"access_token\": []string{c.Token}}.Encode()\n\treq, e := http.NewRequestWithContext(ctx, \"POST\", endpoint, strings.NewReader(string(body)))\n\tif e != nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\treq.Header.Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\treq.Header.Set(\"Accept\", \"application/json\")\n\tres, e := s.client.Do(req)\n\tif e != nil || res == nil || res.Body == nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tdefer res.Body.Close()\n\traw, e := io.ReadAll(io.LimitReader(res.Body, (32<<10)+1))\n\tif e != nil || len(raw) > 32<<10 || res.StatusCode != 200 {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tvar response struct {\n\t\tCode    *int   `json:\"errcode\"`\n\t\tMessage string `json:\"errmsg\"`\n\t\tTrace   string `json:\"trace_id\"`\n\t\tResult  *struct {\n\t\t\tSuggest string `json:\"suggest\"`\n\t\t\tLabel   *int   `json:\"label\"`\n\t\t} `json:\"result\"`\n\t\tDetail json.RawMessage `json:\"detail\"`\n\t}\n\tif !strictObject(raw, &response) || response.Code == nil || !tracePattern.MatchString(response.Trace) {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tif *response.Code == 40001 || *response.Code == 40014 || *response.Code == 42001 {\n\t\ts.credentials.Reject(c.Generation)\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tif *response.Code == 87014 {\n\t\treturn ports.SafetyResult{Decision: \"blocked\", Finding: &ports.SafetyFinding{Provider: \"wechat.msg_sec_check.v2\", Code: \"official_risky\", TraceID: response.Trace, Level: 2, Confirmed: true}}, nil\n\t}\n\tif *response.Code != 0 || response.Result == nil {\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n\tswitch response.Result.Suggest {\n\tcase \"pass\":\n\t\treturn ports.SafetyResult{Decision: \"passed\"}, nil\n\tcase \"risky\":\n\t\treturn ports.SafetyResult{Decision: \"blocked\", Finding: &ports.SafetyFinding{Provider: \"wechat.msg_sec_check.v2\", Code: \"official_risky\", TraceID: response.Trace, Level: 2, Confirmed: true}}, nil\n\tcase \"review\":\n\t\treturn ports.SafetyResult{Decision: \"review\", Finding: &ports.SafetyFinding{Provider: \"wechat.msg_sec_check.v2\", Code: \"official_review\", TraceID: response.Trace, Level: 1, Confirmed: false}}, nil\n\tdefault:\n\t\treturn ports.SafetyResult{}, ports.ErrUnavailable\n\t}\n}\n\ntype binding struct{ openid, proof string }\n\nfunc (s *Service) identity(ctx context.Context, p ports.Principal, tx *sql.Tx) (binding, error) {\n\towned := tx == nil\n\tif owned {\n\t\tvar e error\n\t\ttx, e = s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\t\tif e != nil {\n\t\t\treturn binding{}, ports.ErrUnavailable\n\t\t}\n\t\tdefer tx.Rollback()\n\t}\n\tif p.Environment != s.environment || p.Kind != \"mini\" {\n\t\treturn binding{}, ports.ErrInvalid\n\t}\n\tif e := s.source.ValidatePrincipalLocked(ctx, tx, p); e != nil {\n\t\treturn binding{}, e\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(id AS CHAR),openid,CAST(session_version AS CHAR) FROM wechat_identities WHERE user_id=? AND app_id=? AND status='active' ORDER BY id LIMIT 2 LOCK IN SHARE MODE`, string(p.ActorID), s.appID)\n\tif e != nil {\n\t\treturn binding{}, ports.ErrUnavailable\n\t}\n\tcount := 0\n\tvar id, openid, version string\n\tfor rows.Next() {\n\t\tif e = rows.Scan(&id, &openid, &version); e != nil {\n\t\t\tbreak\n\t\t}\n\t\tcount++\n\t}\n\tfailure := rows.Err()\n\trows.Close()\n\tif e != nil || failure != nil || count != 1 || !openIDPattern.MatchString(openid) || !ports.ID(version).Valid() || version == \"0\" {\n\t\treturn binding{}, ports.ErrUnavailable\n\t}\n\tproof := hash(strings.Join([]string{s.environment, s.appID, string(p.ActorID), id, version, openid}, \"\\n\"))\n\tif owned && tx.Commit() != nil {\n\t\treturn binding{}, ports.ErrUnavailable\n\t}\n\treturn binding{openid, proof}, nil\n}\n\n// ValidateTextLocked runs after PHP authority/current login and before the\n// stable restriction/conversation lock. No network call occurs in this tx.\nfunc (s *Service) ValidateTextLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, checked ports.SafetyResult) error {\n\tif checked.RuleVersion != RuleVersion || !hexPattern.MatchString(checked.AuthorityProof) {\n\t\treturn ports.ErrUnavailable\n\t}\n\tidentity, e := s.identity(ctx, p, tx)\n\tif e != nil || identity.proof != checked.AuthorityProof {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\ntype contextItem struct {\n\tIntentID       ports.ID `json:\"intent_id\"`\n\tFingerprint    string   `json:\"fingerprint\"`\n\tNormalizedText string   `json:\"normalized_text\"`\n}\n\nfunc (s *Service) prepare(ctx context.Context, q ports.TextRequest) ([]contextItem, error) {\n\ttx, e := s.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar actor string\n\tif e = tx.QueryRowContext(ctx, `SELECT CAST(actor_id AS CHAR) FROM chat_restrictions WHERE actor_id=? FOR UPDATE`, string(q.Actor.ActorID)).Scan(&actor); e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tvar intent string\n\te = tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_send_intents WHERE id=? AND sender_id=? AND conversation_id=? AND fingerprint=? AND state='checking' LOCK IN SHARE MODE`, string(q.IntentID), string(q.Actor.ActorID), string(q.ConversationID), q.Fingerprint).Scan(&intent)\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_text_checks(intent_id,sender_id,conversation_id,fingerprint,normalized_text,created_at) VALUES(?,?,?,?,?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE intent_id=intent_id`, intent, string(q.Actor.ActorID), string(q.ConversationID), q.Fingerprint, normalize(q.Text))\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tvar fp string\n\tif e = tx.QueryRowContext(ctx, `SELECT fingerprint FROM chat_text_checks WHERE intent_id=? FOR UPDATE`, intent).Scan(&fp); e != nil || fp != q.Fingerprint {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\trows, e := tx.QueryContext(ctx, `SELECT CAST(intent_id AS CHAR),fingerprint,normalized_text FROM chat_text_checks WHERE sender_id=? AND conversation_id=? AND intent_id<>? AND created_at>=UTC_TIMESTAMP(6)-INTERVAL 2 MINUTE ORDER BY created_at DESC,id DESC LIMIT 4 FOR UPDATE`, string(q.Actor.ActorID), string(q.ConversationID), intent)\n\tif e != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tprevious := []contextItem{}\n\tfor rows.Next() {\n\t\tvar item contextItem\n\t\tif e = rows.Scan(&item.IntentID, &item.Fingerprint, &item.NormalizedText); e != nil {\n\t\t\tbreak\n\t\t}\n\t\tprevious = append(previous, item)\n\t}\n\tfailure := rows.Err()\n\trows.Close()\n\tif e != nil || failure != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tfor i, j := 0, len(previous)-1; i < j; i, j = i+1, j-1 {\n\t\tprevious[i], previous[j] = previous[j], previous[i]\n\t}\n\tif tx.Commit() != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\treturn previous, nil\n}\n\n// Context/cache data is ephemeral; minimal intents and risk evidence are not\n// deleted here. The worker sweeps at most 100 expired context rows per tick.\nfunc (s *Service) Clean(ctx context.Context) error {\n\tctx, cancel := context.WithTimeout(ctx, s.timeout)\n\tdefer cancel()\n\t_, e := s.db.ExecContext(ctx, `DELETE FROM chat_text_checks WHERE created_at<UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE ORDER BY created_at LIMIT 100`)\n\tif e != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (s *Service) Maintain(ctx context.Context) {\n\ttimer := time.NewTicker(30 * time.Second)\n\tdefer timer.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-timer.C:\n\t\t\t_ = s.Clean(ctx)\n\t\t}\n\t}\n}\n\nvar _ ports.Safety = (*Service)(nil)\n\nfunc (s *Service) Close() {\n\tif c, ok := s.client.(interface{ CloseIdleConnections() }); ok {\n\t\tc.CloseIdleConnections()\n\t}\n}\n","chat/internal/moderation/service_test.go":"package moderation\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc credential(token string) Credential {\n\tnow := time.Now().Unix()\n\tv := Credential{Schema: 1, Environment: \"test\", AppID: \"wx_s07_fixture\", Token: token, IssuedAt: now, ExpiresAt: now + 3600}\n\tv.Generation = hash(v.Environment + \"\\n\" + v.AppID + \"\\n\" + v.Token)\n\treturn v\n}\nfunc putCredential(t *testing.T, path string, v Credential) {\n\tt.Helper()\n\tbody, _ := json.Marshal(v)\n\tif e := os.WriteFile(path, body, 0640); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\nfunc TestCredentialBoundariesAndFallback(t *testing.T) {\n\troot := t.TempDir()\n\tpath := filepath.Join(root, \"credential.json\")\n\tv := credential(\"s07_fixture_token_one\")\n\tputCredential(t, path, v)\n\tc, e := NewCredentials(path, \"test\", v.AppID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif got, e := c.Get(); e != nil || got.Token != v.Token {\n\t\tt.Fatal(\"valid export refused\", e)\n\t}\n\tos.Remove(path)\n\tif _, e = c.Get(); e != nil {\n\t\tt.Fatal(\"still-valid cached credential could not bridge outage\")\n\t}\n\tputCredential(t, path, v)\n\tos.Chmod(path, 0644)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"insecure export bypassed via cache\")\n\t}\n\tos.Chmod(path, 0640)\n\twrong := v\n\twrong.Environment = \"production\"\n\tputCredential(t, path, wrong)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"cross-environment export\")\n\t}\n\tputCredential(t, path, v)\n\tc.Reject(v.Generation)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"rejected generation reused\")\n\t}\n\tnext := credential(\"s07_fixture_token_two\")\n\tputCredential(t, path, next)\n\tif _, e = c.Get(); e != nil {\n\t\tt.Fatal(\"rotation failed\", e)\n\t}\n\tc.Reject(next.Generation)\n\tputCredential(t, path, v)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"earlier rejected generation resurrected\")\n\t}\n\tc.cached = credential(\"s07_fixture_old_cache\")\n\tc.cached.ExpiresAt = time.Now().Unix() - 1\n\tos.Remove(path)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"expired fallback\")\n\t}\n\tputCredential(t, path, v)\n\tbody, _ := json.Marshal(v)\n\tos.WriteFile(path, []byte(strings.Replace(string(body), `\"env\":`, `\"env\":\"test\",\"env\":`, 1)), 0640)\n\tif _, e = c.Get(); e == nil {\n\t\tt.Fatal(\"duplicate envelope key\")\n\t}\n}\n\ntype httpFunc func(*http.Request) (*http.Response, error)\n\nfunc (f httpFunc) Do(r *http.Request) (*http.Response, error) { return f(r) }\nfunc TestOfficialResponseContract(t *testing.T) {\n\tcases := []struct {\n\t\tname, body, decision string\n\t\tstatus               int\n\t\tunavailable          bool\n\t}{\n\t\t{\"pass\", `{\"errcode\":0,\"trace_id\":\"fixture-trace\",\"result\":{\"suggest\":\"pass\",\"label\":100},\"detail\":[]}`, \"passed\", 200, false},\n\t\t{\"risky\", `{\"errcode\":0,\"result\":{\"suggest\":\"risky\",\"label\":200}}`, \"blocked\", 200, false},\n\t\t{\"review\", `{\"errcode\":0,\"result\":{\"suggest\":\"review\"}}`, \"review\", 200, false},\n\t\t{\"blocked_code\", `{\"errcode\":87014}`, \"blocked\", 200, false},\n\t\t{\"empty\", `{}`, \"\", 200, true},\n\t\t{\"missing_result\", `{\"errcode\":0}`, \"\", 200, true},\n\t\t{\"missing_code\", `{\"result\":{\"suggest\":\"pass\"}}`, \"\", 200, true},\n\t\t{\"null\", `{\"errcode\":0,\"result\":null}`, \"\", 200, true},\n\t\t{\"unknown\", `{\"errcode\":0,\"result\":{\"suggest\":\"unknown\"}}`, \"\", 200, true},\n\t\t{\"duplicate\", `{\"errcode\":0,\"errcode\":0,\"result\":{\"suggest\":\"pass\"}}`, \"\", 200, true},\n\t\t{\"case_alias\", `{\"ERRCODE\":0,\"result\":{\"suggest\":\"pass\"}}`, \"\", 200, true},\n\t\t{\"quota\", `{\"errcode\":45009,\"errmsg\":\"sensitive-fixture\"}`, \"\", 200, true},\n\t\t{\"http_error\", `{\"errcode\":0,\"result\":{\"suggest\":\"pass\"}}`, \"\", 503, true},\n\t\t{\"oversized\", strings.Repeat(\"x\", (32<<10)+1), \"\", 200, true},\n\t}\n\tfor _, c := range cases {\n\t\tt.Run(c.name, func(t *testing.T) {\n\t\t\ts := &Service{client: httpFunc(func(r *http.Request) (*http.Response, error) {\n\t\t\t\tif r.URL.Host != \"api.weixin.qq.com\" || r.URL.Path != \"/wxa/msg_sec_check\" || r.URL.Scheme != \"https\" || r.Method != \"POST\" || r.URL.Query().Get(\"access_token\") != \"s07_fixture_token_one\" {\n\t\t\t\t\tt.Fatal(\"incorrect official request\")\n\t\t\t\t}\n\t\t\t\traw, _ := io.ReadAll(r.Body)\n\t\t\t\tvar body struct {\n\t\t\t\t\tContent, OpenID string\n\t\t\t\t\tVersion, Scene  int\n\t\t\t\t}\n\t\t\t\tif json.Unmarshal(raw, &body) != nil || body.Content != \"尺寸12.5米\\n🛠\" || body.OpenID != \"oS07_abcdefghijklmnopqrstuv\" || body.Version != 2 || body.Scene != 1 {\n\t\t\t\t\tt.Fatal(\"text identity or bytes changed\", string(raw))\n\t\t\t\t}\n\t\t\t\treturn &http.Response{StatusCode: c.status, Body: io.NopCloser(strings.NewReader(c.body))}, nil\n\t\t\t})}\n\t\t\tout, e := s.inspect(context.Background(), credential(\"s07_fixture_token_one\"), \"oS07_abcdefghijklmnopqrstuv\", \"尺寸12.5米\\n🛠\")\n\t\t\tif c.unavailable {\n\t\t\t\tif e != ports.ErrUnavailable {\n\t\t\t\t\tt.Fatalf(\"fail-open %+v %v\", out, e)\n\t\t\t\t}\n\t\t\t} else if e != nil || out.Decision != c.decision {\n\t\t\t\tt.Fatalf(\"decision %+v %v\", out, e)\n\t\t\t}\n\t\t\tif c.decision == \"review\" && (out.Finding == nil || out.Finding.Confirmed) {\n\t\t\t\tt.Fatal(\"review counted as violation\")\n\t\t\t}\n\t\t})\n\t}\n}\nfunc TestExpiredOfficialCredentialIsQuarantined(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"credential.json\")\n\tv := credential(\"s07_fixture_token_one\")\n\tputCredential(t, path, v)\n\tc, _ := NewCredentials(path, \"test\", v.AppID)\n\ts := &Service{credentials: c, client: httpFunc(func(*http.Request) (*http.Response, error) {\n\t\treturn &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(`{\"errcode\":40001}`))}, nil\n\t})}\n\tif _, e := s.inspect(context.Background(), v, \"oS07_abcdefghijklmnopqrstuv\", \"fixture\"); e == nil {\n\t\tt.Fatal(\"invalid access token allowed\")\n\t}\n\tif _, e := c.Get(); e == nil {\n\t\tt.Fatal(\"bad generation remained usable\")\n\t}\n}\n","chat/internal/moderation/token.go":"// Package moderation implements official text checks and local diversion rules.\n// It never grants order authority or writes PHP-owned identity tables.\npackage moderation\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype Credential struct {\n\tSchema      int    `json:\"schema_version\"`\n\tEnvironment string `json:\"env\"`\n\tAppID       string `json:\"app_id\"`\n\tToken       string `json:\"token\"`\n\tIssuedAt    int64  `json:\"issued_at\"`\n\tExpiresAt   int64  `json:\"expires_at\"`\n\tGeneration  string `json:\"generation\"`\n}\ntype Credentials struct {\n\tmu                       sync.Mutex\n\tpath, environment, appID string\n\tcached                   Credential\n\trejected                 map[string]int64\n}\n\nfunc NewCredentials(path, environment, appID string) (*Credentials, error) {\n\tif !filepath.IsAbs(path) || !validEnvironment(environment) || !appPattern.MatchString(appID) {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Credentials{path: path, environment: environment, appID: appID, rejected: map[string]int64{}}, nil\n}\nfunc hash(s string) string { v := sha256.Sum256([]byte(s)); return hex.EncodeToString(v[:]) }\nfunc (c *Credentials) valid(v Credential, now time.Time) bool {\n\treturn v.Schema == 1 && v.Environment == c.environment && v.AppID == c.appID && len(v.Token) <= 2048 && tokenPattern.MatchString(v.Token) && v.IssuedAt > 0 && v.IssuedAt <= now.Unix()+5 && v.ExpiresAt > now.Unix()+5 && v.ExpiresAt > v.IssuedAt && v.ExpiresAt-v.IssuedAt <= 7200 && v.Generation == hash(v.Environment+\"\\n\"+v.AppID+\"\\n\"+v.Token) && c.rejected[v.Generation] <= now.Unix() && len(c.rejected) < 32\n}\nfunc (c *Credentials) Get() (Credential, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tnow := time.Now()\n\tfor key, until := range c.rejected {\n\t\tif until <= now.Unix() {\n\t\t\tdelete(c.rejected, key)\n\t\t}\n\t}\n\t// Refresh the protected file on every check to observe revocations/rotation;\n\t// cache only bridges file/proxy outages while a known credential is valid.\n\tinfo, e := os.Lstat(c.path)\n\tif e == nil && info.Mode().IsRegular() && info.Mode().Perm()&0027 == 0 && info.Size() <= 4096 {\n\t\tparent, err := os.Stat(filepath.Dir(c.path))\n\t\tif err == nil && parent.IsDir() && parent.Mode().Perm()&0022 == 0 {\n\t\t\tf, err := os.Open(c.path)\n\t\t\tif err == nil {\n\t\t\t\tactual, err := f.Stat()\n\t\t\t\tvar body []byte\n\t\t\t\tif err == nil && os.SameFile(info, actual) {\n\t\t\t\t\tbody, err = io.ReadAll(io.LimitReader(f, 4097))\n\t\t\t\t}\n\t\t\t\tf.Close()\n\t\t\t\tvar v Credential\n\t\t\t\tif err == nil && len(body) <= 4096 && strictObject(body, &v) && c.valid(v, now) {\n\t\t\t\t\tc.cached = v\n\t\t\t\t\treturn v, nil\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif e != nil && (os.IsNotExist(e) || os.IsPermission(e)) && c.valid(c.cached, now) {\n\t\treturn c.cached, nil\n\t}\n\treturn Credential{}, ports.ErrUnavailable\n}\nfunc (c *Credentials) Reject(generation string) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tif hexPattern.MatchString(generation) {\n\t\tuntil := time.Now().Add(2 * time.Hour).Unix()\n\t\tif c.cached.Generation == generation {\n\t\t\tuntil = c.cached.ExpiresAt\n\t\t}\n\t\tc.rejected[generation] = until\n\t\tif c.cached.Generation == generation {\n\t\t\tc.cached = Credential{}\n\t\t}\n\t}\n}\n\n// Duplicate/case/unknown keys are forbidden even on trusted on-disk envelopes.\nfunc strictObject(body []byte, value any) bool {\n\tvar raw map[string]json.RawMessage\n\tif json.Unmarshal(body, &raw) != nil || raw == nil {\n\t\treturn false\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(body))\n\ttoken, e := decoder.Token()\n\tif e != nil || token != json.Delim('{') {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor decoder.More() {\n\t\tk, e := decoder.Token()\n\t\tkey, ok := k.(string)\n\t\tif e != nil || !ok || seen[key] || key != strings.ToLower(key) {\n\t\t\treturn false\n\t\t}\n\t\tseen[key] = true\n\t\tvar v json.RawMessage\n\t\tif decoder.Decode(&v) != nil || string(v) == \"null\" {\n\t\t\treturn false\n\t\t}\n\t}\n\tif _, e = decoder.Token(); e != nil {\n\t\treturn false\n\t}\n\tif _, e = decoder.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\tdecoder = json.NewDecoder(bytes.NewReader(body))\n\tdecoder.DisallowUnknownFields()\n\treturn decoder.Decode(value) == nil\n}\n","chat/internal/policy/guard.go":"// Package policy reads PHP-owned authorization facts. It never interprets order states.\npackage policy\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"io\"\n\t\"regexp\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nvar ErrDenied = errors.New(\"CHAT_POLICY_DENIED\")\nvar hexVersion = regexp.MustCompile(`^[a-f0-9]{64}$`)\n\ntype member struct {\n\tActorID          ports.ID `json:\"actor_id\"`\n\tKind             string   `json:\"kind\"`\n\tRole             string   `json:\"role\"`\n\tCanRead          bool     `json:\"can_read\"`\n\tCanSend          bool     `json:\"can_send\"`\n\tAuthorityVersion ports.ID `json:\"authority_version,omitempty\"`\n}\n\nfunc (m *member) UnmarshalJSON(data []byte) error {\n\ttype plain member\n\tif object(data, (*plain)(m), \"actor_id\", \"kind\", \"role\", \"can_read\", \"can_send\") {\n\t\treturn nil\n\t}\n\tif object(data, (*plain)(m), \"actor_id\", \"kind\", \"role\", \"can_read\", \"can_send\", \"authority_version\") && m.Role == \"platform_staff\" {\n\t\treturn nil\n\t}\n\treturn ErrDenied\n}\n\ntype snapshot struct {\n\tOrderContext *ports.OrderContext `json:\"order_context,omitempty\"`\n\tSchema             int      `json:\"schema_version\"`\n\tScope              string   `json:\"scope_key\"`\n\tOrderID            ports.ID `json:\"order_id\"`\n\tAssignmentID       ports.ID `json:\"assignment_id\"`\n\tEpisode            string   `json:\"episode_key\"`\n\tState              string   `json:\"state\"`\n\tCanInvite          bool     `json:\"can_invite\"`\n\tMembers            []member `json:\"members\"`\n\tStaffConfigVersion ports.ID `json:\"staff_config_version,omitempty\"`\n}\n\ntype row struct{ scope, orderID, assignmentID, version, state, body, hash string }\n\n// Reader is deliberately not ports.Policy: S05 must resolve the conversation's\n// trusted binding first. A client-provided scope must never replace that binding.\ntype Reader struct {\n\tenvironment string\n\ttimeout     time.Duration\n}\n\nfunc NewReader(environment string, timeout time.Duration) (*Reader, error) {\n\tif (environment != \"development\" && environment != \"test\" && environment != \"production\") || timeout <= 0 || timeout > 5*time.Second {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Reader{environment: environment, timeout: timeout}, nil\n}\n\n// AuthorizeLocked holds the PHP guard's shared lock in the caller's transaction.\n// S06 must commit the message using this SAME tx, never authorize then start a\n// second transaction. expectedVersion is the applied S05 membership version.\n// The caller must also revalidate the S03 session and account restrictions.\nfunc (r *Reader) AuthorizeLocked(ctx context.Context, tx *sql.Tx, scope string, expectedVersion ports.ID, actor ports.Principal, action string) (ports.Grant, error) {\n\tif tx == nil || len(scope) < 1 || len(scope) > 96 || !positive(expectedVersion) || (action != \"read\" && action != \"send\") {\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\tif !r.actor(actor, time.Now()) {\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\tctx, cancel := context.WithTimeout(ctx, r.timeout)\n\tdefer cancel()\n\tp, err := r.CurrentLocked(ctx, tx, scope)\n\tif err != nil || p.Version != expectedVersion {\n\t\tif err != nil {\n\t\t\treturn ports.Grant{}, err\n\t\t}\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\tif err = r.CheckEpochsLocked(ctx, tx, p, actor.ActorID, action); err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\tvar grant ports.Grant\n\tfor _, m := range p.Members {\n\t\tif m.ActorID == actor.ActorID {\n\t\t\tgrant = m.Grant\n\t\t}\n\t}\n\tif !grant.CanRead || (action == \"send\" && !grant.CanSend) || !r.actor(actor, time.Now()) {\n\t\treturn ports.Grant{}, ErrDenied\n\t}\n\treturn grant, nil\n}\n\nfunc (r *Reader) actor(a ports.Principal, now time.Time) bool {\n\treturn positive(a.ActorID) && positive(a.SourceID) && a.Kind == \"mini\" && a.Environment == r.environment &&\n\t\thexVersion.MatchString(a.SessionID) && hexVersion.MatchString(a.SessionVersion) && now.Before(a.ExpiresAt) &&\n\t\tlen(a.Scopes) == 1 && a.Scopes[0] == \"chat:use\"\n}\n\nfunc evaluate(value row, scope string, expectedVersion ports.ID, actor ports.ID, action string) (ports.Grant, error) {\n\tdeny := func() (ports.Grant, error) { return ports.Grant{}, ErrDenied }\n\tif !positive(actor) || !positive(expectedVersion) || value.version != string(expectedVersion) || value.scope != scope || len(value.body) > 16384 || !hexVersion.MatchString(value.hash) {\n\t\treturn deny()\n\t}\n\tdigest := sha256.Sum256([]byte(value.body))\n\tif hex.EncodeToString(digest[:]) != value.hash {\n\t\treturn deny()\n\t}\n\tvar s snapshot\n\tkeys := []string{\"schema_version\", \"scope_key\", \"order_id\", \"assignment_id\", \"episode_key\", \"state\", \"can_invite\", \"members\"}\n\tvar header struct {\n\t\tSchema int `json:\"schema_version\"`\n\t\tOrder json.RawMessage `json:\"order_context\"`\n\t}\n\tif json.Unmarshal([]byte(value.body), &header) != nil {\n\t\treturn deny()\n\t}\n\tif len(header.Order) > 0 {\n\t\tvar display ports.OrderContext\n\t\tif !object(header.Order, &display, \"public_no\", \"title\", \"workflow\") || !validOrderContext(display) { return deny() }\n\t\tkeys = append(keys, \"order_context\")\n\t}\n\tif header.Schema == 2 {\n\t\tkeys = append(keys, \"staff_config_version\")\n\t}\n\tif !object([]byte(value.body), &s, keys...) ||\n\t\t(s.Schema != 1 && s.Schema != 2) || (s.Schema == 2 && !positive(s.StaffConfigVersion)) || !positive(s.OrderID) || !positive(s.AssignmentID) || s.Scope != scope || s.Scope != \"order:\"+string(s.OrderID)+\":assignment:\"+string(s.AssignmentID) ||\n\t\tvalue.orderID != string(s.OrderID) || value.assignmentID != string(s.AssignmentID) || value.state != s.State || (s.State != \"open\" && s.State != \"readonly\") ||\n\t\t!validEpisode(s.Episode, s.AssignmentID) || s.CanInvite || len(s.Members) < 1 || len(s.Members) > 10 || (s.Schema == 1 && len(s.Members) != 2) {\n\t\treturn deny()\n\t}\n\tseen := map[ports.ID]bool{}\n\troles := map[string]bool{}\n\tvar found *member\n\tfor i := range s.Members {\n\t\tm := &s.Members[i]\n\t\tstaff := m.Role == \"platform_staff\"\n\t\tif !positive(m.ActorID) || seen[m.ActorID] || (roles[m.Role] && !staff) || m.Kind != \"mini\" || (m.Role != \"customer\" && m.Role != \"worker\" && !staff) || !m.CanRead || (s.State == \"readonly\" && m.CanSend) ||\n\t\t\t(staff && (s.Schema != 2 || !positive(m.AuthorityVersion))) || (!staff && m.AuthorityVersion != \"\") || (len(s.Members) == 1 && m.CanSend) {\n\t\t\treturn deny()\n\t\t}\n\t\tseen[m.ActorID] = true\n\t\troles[m.Role] = true\n\t\tif m.ActorID == actor {\n\t\t\tfound = m\n\t\t}\n\t}\n\tif !roles[\"worker\"] || (s.Schema == 1 && !roles[\"customer\"]) {\n\t\treturn deny()\n\t}\n\tif found == nil || (action != \"read\" && action != \"send\") || (action == \"send\" && (!found.CanSend || s.State != \"open\")) {\n\t\treturn deny()\n\t}\n\tgrant := ports.Grant{OrderContext: s.OrderContext, MemberRole: found.Role, CanRead: found.CanRead, CanSend: found.CanSend && s.State == \"open\", ScopeKey: s.Scope, Version: expectedVersion,\n\t\tMemberKey: s.Episode + \":mini:\" + string(actor) + \":\" + found.Role}\n\tif found.Role == \"platform_staff\" {\n\t\tgrant.StaffConfigVersion = s.StaffConfigVersion\n\t\tgrant.StaffUserVersion = found.AuthorityVersion\n\t\tgrant.MemberKey += \":config:\" + string(s.StaffConfigVersion) + \":user:\" + string(found.AuthorityVersion)\n\t}\n\treturn grant, nil\n}\n\nfunc positive(id ports.ID) bool { return id.Valid() && id != \"0\" }\n\n// The episode identity is supplied by PHP. Go does not infer repair eligibility.\nfunc validEpisode(episode string, assignment ports.ID) bool {\n\tprefix := \"assignment:\" + string(assignment)\n\tif episode == prefix+\":service\" {\n\t\treturn true\n\t}\n\tid, ok := strings.CutPrefix(episode, prefix+\":repair:\")\n\treturn ok && positive(ports.ID(id))\n}\n\n// Exact required keys, including nested members: reject duplicates, case aliases,\n// null fields, missing/unknown fields, non-object roots and trailing values.\nfunc object(data []byte, target any, keys ...string) bool {\n\tdecoder := json.NewDecoder(bytes.NewReader(data))\n\ttoken, err := decoder.Token()\n\tif err != nil || token != json.Delim('{') {\n\t\treturn false\n\t}\n\tallowed := map[string]bool{}\n\tfor _, key := range keys {\n\t\tallowed[key] = true\n\t}\n\tseen := map[string]bool{}\n\tfor decoder.More() {\n\t\ttoken, err = decoder.Token()\n\t\tkey, ok := token.(string)\n\t\tif err != nil || !ok || !allowed[key] || seen[key] {\n\t\t\treturn false\n\t\t}\n\t\tseen[key] = true\n\t\tvar raw json.RawMessage\n\t\tif decoder.Decode(&raw) != nil || bytes.Equal(bytes.TrimSpace(raw), []byte(\"null\")) {\n\t\t\treturn false\n\t\t}\n\t}\n\tif token, err = decoder.Token(); err != nil || token != json.Delim('}') || len(seen) != len(allowed) {\n\t\treturn false\n\t}\n\tif _, err = decoder.Token(); err != io.EOF {\n\t\treturn false\n\t}\n\treturn json.Unmarshal(data, target) == nil\n}\n\n// Display metadata is optional for pre-S12 guards and cannot change authority.\nfunc validOrderContext(c ports.OrderContext) bool {\n if len(c.PublicNo) < 1 || len(c.PublicNo) > 80 || (c.Workflow != \"construction\" && c.Workflow != \"measurement\") || !utf8.ValidString(c.Title) || utf8.RuneCountInString(c.Title)>120 { return false }\n for _, r := range c.PublicNo { if !(r>='0'&&r<='9'||r>='A'&&r<='Z'||r>='a'&&r<='z'||r=='-'||r=='_') { return false } }\n for _, r := range c.Title { if unicode.IsControl(r) { return false } }\n return true\n}\n","chat/internal/policy/guard_test.go":"package policy\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nconst validSnapshot = `{\"schema_version\":1,\"scope_key\":\"order:77:assignment:100\",\"order_id\":\"77\",\"assignment_id\":\"100\",\"episode_key\":\"assignment:100:service\",\"state\":\"open\",\"can_invite\":false,\"members\":[{\"actor_id\":\"1\",\"kind\":\"mini\",\"role\":\"customer\",\"can_read\":true,\"can_send\":true},{\"actor_id\":\"18446744073709551615\",\"kind\":\"mini\",\"role\":\"worker\",\"can_read\":true,\"can_send\":true}]}`\n\nfunc fixture(body string) row {\n\tsum := sha256.Sum256([]byte(body))\n\treturn row{scope: \"order:77:assignment:100\", orderID: \"77\", assignmentID: \"100\", version: \"7\", state: \"open\", body: body, hash: hex.EncodeToString(sum[:])}\n}\n\nfunc TestGuardProtocolAndMembership(t *testing.T) {\n\tr := fixture(validSnapshot)\n\tfor _, id := range []ports.ID{\"1\", \"18446744073709551615\"} {\n\t\tg, e := evaluate(r, r.scope, \"7\", id, \"send\")\n\t\tif e != nil || !g.CanRead || !g.CanSend || g.Version != \"7\" {\n\t\t\tt.Fatal(\"PHP member lost\", g, e)\n\t\t}\n\t}\n\tfor _, id := range []ports.ID{\"0\", \"2\", \"01\", \"18446744073709551616\"} {\n\t\tif _, e := evaluate(r, r.scope, \"7\", id, \"read\"); e != ErrDenied {\n\t\t\tt.Fatal(\"outsider granted\", id, e)\n\t\t}\n\t}\n\tfor _, version := range []ports.ID{\"6\", \"8\", \"0\", \"07\"} {\n\t\tif _, e := evaluate(r, r.scope, version, \"1\", \"send\"); e != ErrDenied {\n\t\t\tt.Fatal(\"unapplied/stale version granted\", version, e)\n\t\t}\n\t}\n\tr.body = strings.ReplaceAll(strings.Replace(validSnapshot, `\"state\":\"open\"`, `\"state\":\"readonly\"`, 1), `\"can_send\":true`, `\"can_send\":false`)\n\tr = fixture(r.body)\n\tr.state = \"readonly\"\n\tgrant, e := evaluate(r, r.scope, \"7\", \"1\", \"read\")\n\tif e != nil || !grant.CanRead || grant.CanSend {\n\t\tt.Fatal(\"closed history\", grant, e)\n\t}\n\tif _, e = evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\tt.Fatal(\"closed send allowed\")\n\t}\n}\n\nfunc TestRepairEpisodeIdentity(t *testing.T) {\n\tfor _, id := range []string{\"1\", \"18446744073709551615\"} {\n\t\tr := fixture(strings.Replace(validSnapshot, \":service\", \":repair:\"+id, 1))\n\t\tif g, e := evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != nil || !g.CanSend {\n\t\t\tt.Fatal(\"explicit PHP repair episode\", e)\n\t\t}\n\t}\n\tfor _, id := range []string{\"0\", \"01\", \"\", \"18446744073709551616\", \"1:extra\"} {\n\t\tr := fixture(strings.Replace(validSnapshot, \":service\", \":repair:\"+id, 1))\n\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\t\tt.Fatal(\"invalid repair generation granted\", id, e)\n\t\t}\n\t}\n}\n\nfunc TestMalformedAuthorityNeverGrants(t *testing.T) {\n\tfor name, body := range map[string]string{\n\t\t\"duplicate root\":   strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":1,\"schema_version\":1`, 1),\n\t\t\"duplicate member\": strings.Replace(validSnapshot, `\"actor_id\":\"1\"`, `\"actor_id\":\"1\",\"actor_id\":\"2\"`, 1),\n\t\t\"case alias\":       strings.Replace(validSnapshot, `\"can_send\"`, `\"Can_Send\"`, 1),\n\t\t\"extra\":            strings.Replace(validSnapshot, `\"can_invite\":false`, `\"can_invite\":false,\"extra\":1`, 1),\n\t\t\"missing\":          strings.Replace(validSnapshot, `\"can_invite\":false,`, \"\", 1),\n\t\t\"null\":             strings.Replace(validSnapshot, `\"can_invite\":false`, `\"can_invite\":null`, 1),\n\t\t\"numeric ID\":       strings.Replace(validSnapshot, `\"order_id\":\"77\"`, `\"order_id\":77`, 1),\n\t\t\"scope mismatch\":   strings.Replace(validSnapshot, `\"order_id\":\"77\"`, `\"order_id\":\"78\"`, 1),\n\t\t\"unknown schema\":   strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2`, 1),\n\t\t\"unknown episode\":  strings.Replace(validSnapshot, `:service`, `:unapproved`, 1),\n\t\t\"unknown state\":    strings.Replace(validSnapshot, `\"state\":\"open\"`, `\"state\":\"unknown\"`, 1),\n\t\t\"invitation\":       strings.Replace(validSnapshot, `\"can_invite\":false`, `\"can_invite\":true`, 1),\n\t\t\"duplicate actor\":  strings.Replace(validSnapshot, `\"18446744073709551615\"`, `\"1\"`, 1),\n\t\t\"duplicate role\":   strings.Replace(validSnapshot, `\"role\":\"worker\"`, `\"role\":\"customer\"`, 1),\n\t\t\"admin peer\":       strings.Replace(validSnapshot, `\"kind\":\"mini\"`, `\"kind\":\"admin\"`, 1),\n\t\t\"trailing\":         validSnapshot + `{}`,\n\t\t\"array\":            \"[\" + validSnapshot + \"]\",\n\t\t\"oversized\":        strings.Repeat(\" \", 16385) + validSnapshot,\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tr := fixture(body)\n\t\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\t\t\tt.Fatal(\"bad fact granted\", e)\n\t\t\t}\n\t\t})\n\t}\n\tfor _, change := range []func(*row){\n\t\tfunc(r *row) { r.hash = strings.Repeat(\"a\", 64) }, func(r *row) { r.orderID = \"78\" }, func(r *row) { r.assignmentID = \"101\" }, func(r *row) { r.state = \"readonly\" },\n\t} {\n\t\tr := fixture(validSnapshot)\n\t\tchange(&r)\n\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", \"read\"); e != ErrDenied {\n\t\t\tt.Fatal(\"row/snapshot mismatch granted\", e)\n\t\t}\n\t}\n}\n\nfunc principal() ports.Principal {\n\treturn ports.Principal{ActorID: \"1\", Kind: \"mini\", SourceID: \"1\", Environment: \"test\", SessionID: strings.Repeat(\"a\", 64), SessionVersion: strings.Repeat(\"b\", 64), ExpiresAt: time.Now().Add(time.Minute), Scopes: []string{\"chat:use\"}}\n}\n\nfunc TestReaderIdentityBoundary(t *testing.T) {\n\tr, e := NewReader(\"test\", time.Second)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif !r.actor(principal(), time.Now()) {\n\t\tt.Fatal(\"valid principal\")\n\t}\n\tfor _, change := range []func(*ports.Principal){\n\t\tfunc(p *ports.Principal) { p.Kind = \"admin\" }, func(p *ports.Principal) { p.Environment = \"production\" }, func(p *ports.Principal) { p.SourceID = \"0\" },\n\t\tfunc(p *ports.Principal) { p.ExpiresAt = time.Now().Add(-time.Second) }, func(p *ports.Principal) { p.Scopes = []string{\"chat:audit\"} },\n\t\tfunc(p *ports.Principal) { p.SessionVersion = \"\" }, func(p *ports.Principal) { p.Scopes = append(p.Scopes, \"chat:moderate\") },\n\t} {\n\t\tp := principal()\n\t\tchange(&p)\n\t\tif r.actor(p, time.Now()) {\n\t\t\tt.Fatal(\"invalid identity accepted\")\n\t\t}\n\t}\n\tif _, e = r.AuthorizeLocked(context.Background(), nil, \"order:77:assignment:100\", \"1\", principal(), \"send\"); e != ErrDenied {\n\t\tt.Fatal(\"must own caller transaction\")\n\t}\n\tif _, e = NewReader(\"test\", 6*time.Second); e != ports.ErrInvalid {\n\t\tt.Fatal(\"unbounded timeout\")\n\t}\n}\n\n// Missing authority generations never become valid platform permissions.\nfunc TestPlatformMissingAuthorityRejected(t *testing.T) {\n\tfor _, body := range []string{\n\t\tstrings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2`, 1),\n\t\tstrings.Replace(strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2`, 1), `\"role\":\"customer\"`, `\"role\":\"platform_staff\"`, 1),\n\t\tstrings.Replace(validSnapshot, `\"role\":\"customer\"`, `\"role\":\"platform_staff\"`, 1),\n\t} {\n\t\tr := fixture(body)\n\t\tfor _, action := range []string{\"read\", \"send\"} {\n\t\t\tif _, e := evaluate(r, r.scope, \"7\", \"1\", action); e != ErrDenied {\n\t\t\t\tt.Fatal(\"unintegrated platform authority granted\", e)\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc TestEventEnvelopeAndProjection(t *testing.T) {\n\tbody := `{\"schema_version\":1,\"policy_version\":\"7\",\"snapshot\":` + validSnapshot + `}`\n\tp, err := DecodeEvent([]byte(body), \"order:77:assignment:100\", \"7\")\n\tif err != nil || len(p.Members) != 2 || p.Version != \"7\" || p.Members[0].Grant.MemberKey != \"assignment:100:service:mini:1:customer\" {\n\t\tt.Fatal(\"projection contract\", p, err)\n\t}\n\tfor _, bad := range []string{\n\t\tstrings.Replace(body, `\"policy_version\":\"7\"`, `\"policy_version\":\"8\"`, 1),\n\t\tstrings.Replace(body, `\"schema_version\":1`, `\"schema_version\":2`, 1),\n\t\tstrings.Replace(body, `\"policy_version\":\"7\"`, `\"policy_version\":\"7\",\"policy_version\":\"7\"`, 1),\n\t\tstrings.Replace(body, `\"snapshot\":`, `\"Snapshot\":`, 1), body + `{}`, `null`, strings.Repeat(\" \", 32769),\n\t} {\n\t\tif _, err = DecodeEvent([]byte(bad), \"order:77:assignment:100\", \"7\"); err != ErrDenied {\n\t\t\tt.Fatal(\"malformed event accepted\", err)\n\t\t}\n\t}\n}\n\nfunc TestPlatformStaffProtocolAndGenerations(t *testing.T) {\n\tbase := strings.Replace(validSnapshot, `\"schema_version\":1`, `\"schema_version\":2,\"staff_config_version\":\"3\"`, 1)\n\tbase = strings.Replace(base, `\"role\":\"customer\"`, `\"role\":\"platform_staff\",\"authority_version\":\"5\"`, 1)\n\tr := fixture(base)\n\tfirst, e := evaluate(r, r.scope, \"7\", \"1\", \"send\")\n\tif e != nil || first.StaffConfigVersion != \"3\" || first.StaffUserVersion != \"5\" || first.MemberKey == \"\" {\n\t\tt.Fatal(\"staff generation missing\", e)\n\t}\n\tfor _, replacement := range []string{\n\t\tstrings.Replace(base, `\"staff_config_version\":\"3\"`, `\"staff_config_version\":\"4\"`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\"`, `\"authority_version\":\"6\"`, 1),\n\t} {\n\t\tnext := fixture(replacement)\n\t\tg, e := evaluate(next, next.scope, \"7\", \"1\", \"send\")\n\t\tif e != nil || g.MemberKey == first.MemberKey {\n\t\t\tt.Fatal(\"returning staff reused its old interval\", e)\n\t\t}\n\t}\n\tfor _, body := range []string{\n\t\tstrings.Replace(base, `\"staff_config_version\":\"3\"`, `\"staff_config_version\":\"0\"`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\"`, `\"authority_version\":\"0\"`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\"`, `\"authority_version\":5`, 1),\n\t\tstrings.Replace(base, `\"authority_version\":\"5\",`, \"\", 1),\n\t\tstrings.Replace(validSnapshot, `\"role\":\"customer\"`, `\"role\":\"customer\",\"authority_version\":\"\"`, 1),\n\t} {\n\t\tbad := fixture(body)\n\t\tif _, e := evaluate(bad, bad.scope, \"7\", \"1\", \"send\"); e != ErrDenied {\n\t\t\tt.Fatal(\"malformed staff authority accepted\", e)\n\t\t}\n\t}\n}\n\nfunc FuzzGuardSnapshot(f *testing.F) {\n\tf.Add(validSnapshot)\n\tf.Add(`null`)\n\tf.Add(`{\"members\":[{}]}`)\n\tf.Fuzz(func(t *testing.T, body string) {\n\t\tr := fixture(body)\n\t\tg, e := evaluate(r, r.scope, \"7\", \"1\", \"send\")\n\t\tif e == nil && (!g.CanRead || !g.CanSend || g.ScopeKey != r.scope || g.Version != \"7\") {\n\t\t\tt.Fatal(\"inconsistent grant\")\n\t\t}\n\t})\n}\n\nfunc TestS12OrderContextIsOptionalBoundedAndNotAuthority(t *testing.T) {\n display:=`\"order_context\":{\"public_no\":\"ORDER-77\",\"title\":\"墙布施工\",\"workflow\":\"construction\"},`\n body:=strings.Replace(validSnapshot,`\"members\":`,display+`\"members\":`,1)\n r:=fixture(body);g,e:=evaluate(r,r.scope,\"7\",\"1\",\"read\")\n if e!=nil||g.OrderContext==nil||g.OrderContext.PublicNo!=\"ORDER-77\"||g.MemberRole!=\"customer\" {t.Fatal(g,e)}\n if _,e=evaluate(r,r.scope,\"7\",\"2\",\"read\");e!=ErrDenied {t.Fatal(\"display metadata authorized outsider\",e)}\n for _,bad:=range []string{\n  strings.Replace(body,`\"ORDER-77\"`,`\"../77\"`,1),\n  strings.Replace(body,`\"construction\"`,`\"other\"`,1),\n  strings.Replace(body,`\"title\":\"墙布施工\"`,`\"title\":null`,1),\n  strings.Replace(body,`\"title\":\"墙布施工\"`,`\"title\":\"x\",\"title\":\"y\"`,1),\n  strings.Replace(body,`\"title\":\"墙布施工\"`,`\"title\":\"`+strings.Repeat(\"字\",121)+`\"`,1),\n } {v:=fixture(bad);if _,e=evaluate(v,v.scope,\"7\",\"1\",\"read\");e!=ErrDenied{t.Fatal(\"bad display accepted\",bad,e)}}\n legacy:=fixture(validSnapshot);g,e=evaluate(legacy,legacy.scope,\"7\",\"1\",\"read\")\n if e!=nil||g.OrderContext!=nil{t.Fatal(\"legacy authorization changed\",g,e)}\n}\n","chat/internal/policy/mysql_integration_test.go":"package policy\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\tmysql \"github.com/go-sql-driver/mysql\"\n)\n\nfunc TestPHPGuardSharedLockAndVersions(t *testing.T) {\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated MySQL/PHP fixture not provided\")\n\t}\n\taddress := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\thost, _, err := net.SplitHostPort(address)\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"explicit loopback required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)\n\tdefer cancel()\n\tc := mysql.NewConfig()\n\tc.Net = \"tcp\"\n\tc.Addr = address\n\tc.User = \"root\"\n\tc.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tc.Timeout = time.Second\n\tc.ReadTimeout = 3 * time.Second\n\tc.WriteTimeout = time.Second\n\tconnector, err := mysql.NewConnector(c)\n\tif err != nil {\n\t\tt.Fatal(\"fixture connector\")\n\t}\n\troot := sql.OpenDB(connector)\n\tdefer root.Close()\n\troot.SetMaxOpenConns(1)\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname, user := \"bixuan_test_policy_go_\"+suffix, \"bxchat_test_\"+suffix\n\tpw := strings.Repeat(\"a\", 32) + suffix\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\texecute := func(query string) {\n\t\tt.Helper()\n\t\tif _, e := root.ExecContext(ctx, query); e != nil {\n\t\t\tvar code *mysql.MySQLError\n\t\t\tif errors.As(e, &code) {\n\t\t\t\tt.Fatalf(\"fixture MySQL code=%d\", code.Number)\n\t\t\t}\n\t\t\tt.Fatal(\"fixture SQL failed\")\n\t\t}\n\t}\n\texecute(\"CREATE DATABASE `\" + name + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tdefer root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\")\n\texecute(\"USE `\" + name + \"`\")\n\tfor _, query := range []string{\n\t\t\"CREATE TABLE users(id BIGINT UNSIGNED PRIMARY KEY,status VARCHAR(24)) ENGINE=InnoDB\",\n\t\t\"CREATE TABLE worker_profiles(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED) ENGINE=InnoDB\",\n\t\t\"CREATE TABLE assignments(id BIGINT UNSIGNED PRIMARY KEY,order_id BIGINT UNSIGNED,worker_id BIGINT UNSIGNED,status VARCHAR(24),accepted_at DATETIME) ENGINE=InnoDB\",\n\t\t\"CREATE TABLE orders(id BIGINT UNSIGNED PRIMARY KEY,user_id BIGINT UNSIGNED,is_demo TINYINT,workflow_profile VARCHAR(24),order_source_type VARCHAR(24),lifecycle_status VARCHAR(40),payment_status VARCHAR(24),assignment_status VARCHAR(24),current_assignment_id BIGINT UNSIGNED,assigned_worker_id BIGINT UNSIGNED,public_no VARCHAR(80),title VARCHAR(180)) ENGINE=InnoDB\",\n\t\t\"INSERT INTO users VALUES(1,'active'),(2,'active')\", \"INSERT INTO worker_profiles VALUES(10,2)\",\n\t\t\"INSERT INTO assignments VALUES(100,77,10,'accepted',UTC_TIMESTAMP())\",\n\t\t\"INSERT INTO orders VALUES(77,1,0,'construction','consumer','active','paid','accepted',100,10,'POLICY-77','Policy fixture order')\",\n\t} {\n\t\texecute(query)\n\t}\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tt.Fatal(\"explicit PHP required\")\n\t}\n\tscript, err := filepath.Abs(\"../../../server/tests/chat_policy_fixture.php\")\n\tif err != nil {\n\t\tt.Fatal(\"fixture path\")\n\t}\n\tcallPHP := func(action, expected string) {\n\t\tt.Helper()\n\t\tcommand := exec.CommandContext(ctx, php, script, action)\n\t\tcommand.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+name)\n\t\toutput, e := command.Output()\n\t\tif e != nil || strings.TrimSpace(string(output)) != expected {\n\t\t\tt.Fatal(\"real PHP guard transaction failed\", action)\n\t\t}\n\t}\n\tcallPHP(\"init\", \"committed\")\n\texecute(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY '\" + pw + \"'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\")\n\texecute(\"GRANT SELECT ON `\" + name + \"`.chat_policy_guards TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\trc := *c\n\trc.DBName = name\n\trc.User = user\n\trc.Passwd = pw\n\tconnector, err = mysql.NewConnector(&rc)\n\tif err != nil {\n\t\tt.Fatal(\"read connector\")\n\t}\n\tdb := sql.OpenDB(connector)\n\tdefer db.Close()\n\tdb.SetMaxOpenConns(2)\n\tr, _ := NewReader(\"test\", 2*time.Second)\n\ttx, err := db.BeginTx(ctx, nil)\n\tif err != nil {\n\t\tt.Fatal(\"guard transaction\")\n\t}\n\tdefer tx.Rollback()\n\tgrant, err := r.AuthorizeLocked(ctx, tx, \"order:77:assignment:100\", \"1\", principal(), \"send\")\n\tif err != nil || !grant.CanSend {\n\t\tt.Fatal(\"actual PHP snapshot not understood\", err)\n\t}\n\tif grant.OrderContext==nil||grant.OrderContext.PublicNo!=\"POLICY-77\" { t.Fatal(\"PHP display facts not preserved\",grant) }\n // PHP really attempts closure and times out on the Go reader's shared lock.\n\tcallPHP(\"close-blocked\", \"blocked\")\n\tvar lifecycle string\n\tif root.QueryRowContext(ctx, \"SELECT lifecycle_status FROM orders WHERE id=77\").Scan(&lifecycle) != nil || lifecycle != \"active\" {\n\t\tt.Fatal(\"blocked PHP close partially committed\")\n\t}\n\tif tx.Commit() != nil {\n\t\tt.Fatal(\"release guard lease\")\n\t}\n\tcallPHP(\"close\", \"committed\")\n\tcheck := func(version, action string, wantDenied bool, wantSend bool) {\n\t\tt.Helper()\n\t\ttransaction, e := db.BeginTx(ctx, nil)\n\t\tif e != nil {\n\t\t\tt.Fatal(\"check transaction\")\n\t\t}\n\t\tdefer transaction.Rollback()\n\t\tg, e := r.AuthorizeLocked(ctx, transaction, \"order:77:assignment:100\", ports.ID(version), principal(), action)\n\t\tif wantDenied {\n\t\t\tif e != ErrDenied {\n\t\t\t\tt.Fatal(\"revoked/stale policy granted\", e)\n\t\t\t}\n\t\t} else if e != nil || !g.CanRead || g.CanSend != wantSend {\n\t\t\tt.Fatal(\"closed history not bounded\", g, e)\n\t\t}\n\t}\n\tcheck(\"1\", \"read\", true, false)\n\tcheck(\"2\", \"send\", true, false)\n\tcheck(\"2\", \"read\", false, false)\n\tcallPHP(\"repair\", \"committed\")\n\tcheck(\"2\", \"read\", true, false)\n\tcheck(\"3\", \"send\", false, true)\n\tcallPHP(\"repair-close\", \"committed\")\n\tcheck(\"3\", \"send\", true, false)\n\tcheck(\"4\", \"send\", true, false)\n\tcheck(\"4\", \"read\", false, false)\n\tif _, err = db.ExecContext(ctx, \"UPDATE chat_policy_guards SET state='open'\"); err == nil {\n\t\tt.Fatal(\"Go read account can mutate PHP authority\")\n\t}\n\texecute(\"UPDATE chat_policy_guards SET snapshot_hash=REPEAT('f',64)\")\n\tcheck(\"4\", \"read\", true, false)\n\texecute(\"DELETE FROM chat_policy_guards\")\n\tcheck(\"4\", \"read\", true, false)\n}\n\n// Full PHP install/real source triggers: revocation is immediate even when no\n// new order event has reached Go. No order enum is interpreted in this adapter.\nfunc TestPlatformAuthorityGenerationsAndLocks(t *testing.T) {\n\tif os.Getenv(\"CHAT_AUTH_TEST_INTEGRATION\") != \"1\" {\n\t\tt.Skip(\"explicit isolated services required\")\n\t}\n\taddress := os.Getenv(\"CHAT_INTEGRATION_MYSQL_ADDR\")\n\thost, _, err := net.SplitHostPort(address)\n\tif err != nil || host != \"127.0.0.1\" {\n\t\tt.Fatal(\"loopback fixture required\")\n\t}\n\tctx, cancel := context.WithTimeout(context.Background(), 50*time.Second)\n\tdefer cancel()\n\tconfig := mysql.NewConfig()\n\tconfig.Net = \"tcp\"\n\tconfig.Addr = address\n\tconfig.User = \"root\"\n\tconfig.Passwd = os.Getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\")\n\tconfig.Timeout = time.Second\n\tconnector, err := mysql.NewConnector(config)\n\tif err != nil {\n\t\tt.Fatal(\"fixture connector\")\n\t}\n\troot := sql.OpenDB(connector)\n\tdefer root.Close()\n\troot.SetMaxOpenConns(1)\n\tsuffix := strconv.FormatInt(time.Now().UnixNano(), 36)\n\tname := \"bixuan_test_policy_platform_\" + suffix\n\tuser := \"bxchat_platform_\" + suffix\n\texecute := func(query string) {\n\t\tt.Helper()\n\t\tif _, e := root.ExecContext(ctx, query); e != nil {\n\t\t\tt.Fatal(\"platform fixture SQL\", e)\n\t\t}\n\t}\n\texecute(\"CREATE DATABASE `\" + name + \"` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci\")\n\tdefer root.Exec(\"DROP DATABASE IF EXISTS `\" + name + \"`\")\n\tphp := os.Getenv(\"CHAT_AUTH_TEST_PHP\")\n\tif php == \"\" {\n\t\tt.Fatal(\"explicit PHP required\")\n\t}\n\tscript, _ := filepath.Abs(\"../../../server/tests/chat_platform_fixture.php\")\n\tcallPHP := func(action, expected string) {\n\t\tt.Helper()\n\t\tcommand := exec.CommandContext(ctx, php, script, action)\n\t\tcommand.Env = append(os.Environ(), \"CHAT_POLICY_FIXTURE_DATABASE=\"+name)\n\t\tout, e := command.CombinedOutput()\n\t\tif e != nil || strings.TrimSpace(string(out)) != expected {\n\t\t\tt.Fatalf(\"platform PHP %s: %s\", action, out)\n\t\t}\n\t}\n\tcallPHP(\"init\", \"committed\")\n\texecute(\"USE `\" + name + \"`\")\n\tfixtureHost := os.Getenv(\"CHAT_AUTH_TEST_MYSQL_USER_HOST\")\n\tif fixtureHost == \"\" {\n\t\tfixtureHost = \"127.0.0.1\"\n\t}\n\tif fixtureHost != \"127.0.0.1\" && fixtureHost != \"%\" {\n\t\tt.Fatal(\"fixture user host\")\n\t}\n\texecute(\"CREATE USER '\" + user + \"'@'\" + fixtureHost + \"' IDENTIFIED BY 'platform-fixture-only'\")\n\tdefer root.Exec(\"DROP USER IF EXISTS '\" + user + \"'@'\" + fixtureHost + \"'\")\n\tfor _, table := range []string{\"chat_policy_guards\", \"chat_staff_authority_versions\"} {\n\t\texecute(\"GRANT SELECT ON `\" + name + \"`.\" + table + \" TO '\" + user + \"'@'\" + fixtureHost + \"'\")\n\t}\n\treadConfig := *config\n\treadConfig.DBName = name\n\treadConfig.User = user\n\treadConfig.Passwd = \"platform-fixture-only\"\n\trc, e := mysql.NewConnector(&readConfig)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tdb := sql.OpenDB(rc)\n\tdefer db.Close()\n\treader, _ := NewReader(\"test\", 2*time.Second)\n\tversion := func() ports.ID {\n\t\tt.Helper()\n\t\tvar v string\n\t\tif root.QueryRowContext(ctx, \"SELECT CAST(policy_version AS CHAR) FROM chat_policy_guards WHERE order_id=401\").Scan(&v) != nil {\n\t\t\tt.Fatal(\"guard version\")\n\t\t}\n\t\treturn ports.ID(v)\n\t}\n\tstaff := principal()\n\tstaff.ActorID = \"10203\"\n\tcheck := func(v ports.ID, actor ports.Principal, action string, denied bool) ports.Grant {\n\t\tt.Helper()\n\t\ttx, e := db.BeginTx(ctx, nil)\n\t\tif e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tdefer tx.Rollback()\n\t\tg, e := reader.AuthorizeLocked(ctx, tx, \"order:401:assignment:401\", v, actor, action)\n\t\tif denied {\n\t\t\tif e != ErrDenied {\n\t\t\t\tt.Fatal(\"stale authority accepted\", e)\n\t\t\t}\n\t\t} else if e != nil {\n\t\t\tt.Fatal(\"valid platform authority denied\", e)\n\t\t}\n\t\treturn g\n\t}\n\tfirstVersion := version()\n\tfirst := check(firstVersion, staff, \"send\", false)\n\tif first.MemberKey == \"\" || first.StaffConfigVersion == \"\" || first.StaffUserVersion == \"\" {\n\t\tt.Fatal(\"missing authority generation binding\")\n\t}\n\texecute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n\tcheck(firstVersion, staff, \"read\", true)\n\tcheck(firstVersion, staff, \"send\", true)\n\tworker := staff\n\tworker.ActorID = \"10202\"\n\tcheck(firstVersion, worker, \"send\", true) // Prevent messages stamped with a stale roster during a staff gap.\n\texecute(\"UPDATE system_settings SET setting_value='[\\\"PlatformStaff\\\"]' WHERE setting_key='wechat.admin_openids'\")\n\tcheck(firstVersion, staff, \"send\", true) // A -> B -> A must not resurrect cached authority.\n\tcallPHP(\"sync\", \"committed\")\n\tnextVersion := version()\n\tnext := check(nextVersion, staff, \"send\", false)\n\tif next.MemberKey == first.MemberKey {\n\t\tt.Fatal(\"configuration gap silently reopened\")\n\t}\n\tcheck(firstVersion, staff, \"send\", true)\n\texecute(\"UPDATE users SET status='disabled' WHERE id=10203\")\n\texecute(\"UPDATE users SET status='active' WHERE id=10203\")\n\tcheck(nextVersion, staff, \"read\", true)\n\tcallPHP(\"sync\", \"committed\")\n\tuserVersion := version()\n\tcurrent := check(userVersion, staff, \"send\", false)\n\tif current.MemberKey == next.MemberKey {\n\t\tt.Fatal(\"account gap silently reopened\")\n\t}\n\texecute(\"UPDATE wechat_identities SET status='revoked' WHERE user_id=10203\")\n\texecute(\"UPDATE wechat_identities SET status='active' WHERE user_id=10203\")\n\tcheck(userVersion, staff, \"send\", true)\n\tcallPHP(\"sync\", \"committed\")\n\tv := version()\n\tcurrent = check(v, staff, \"send\", false)\n\ttx, e := db.BeginTx(ctx, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = reader.AuthorizeLocked(ctx, tx, \"order:401:assignment:401\", v, staff, \"send\"); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcallPHP(\"config-blocked\", \"blocked\")\n\tcallPHP(\"user-blocked\", \"blocked\")\n\tif tx.Commit() != nil {\n\t\tt.Fatal(\"release authority lock\")\n\t}\n\tcheck(v, staff, \"send\", false)\n\tadmin := staff\n\tadmin.Kind = \"admin\"\n\tadmin.Scopes = []string{\"chat:audit\"}\n\tcheck(v, admin, \"send\", true)\n\tif _, e = db.ExecContext(ctx, \"UPDATE chat_staff_authority_versions SET authority_version=1\"); e == nil {\n\t\tt.Fatal(\"Go may not write PHP authority\")\n\t}\n\tcallPHP(\"close\", \"committed\")\n\tv = version()\n\tg := check(v, staff, \"read\", false)\n\tif g.CanSend {\n\t\tt.Fatal(\"closed platform permits send\")\n\t}\n\tcheck(v, staff, \"send\", true)\n\texecute(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n\tcheck(v, staff, \"read\", true)\n}\n","chat/internal/policy/projection.go":"package policy\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"sort\"\n\t\"strconv\"\n\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Projection is a validated PHP fact, not an interpretation of order status.\ntype Projection struct {\n\tScope, Episode, State, Hash    string\n\tOrderID, AssignmentID, Version ports.ID\n\tStaffConfigVersion             ports.ID\n\tMembers                        []ProjectedMember\n}\ntype ProjectedMember struct {\n\tActorID ports.ID\n\tRole    string\n\tGrant   ports.Grant\n}\n\nfunc DecodeEvent(body []byte, scope string, version ports.ID) (Projection, error) {\n\tvar event struct {\n\t\tSchema   int             `json:\"schema_version\"`\n\t\tVersion  ports.ID        `json:\"policy_version\"`\n\t\tSnapshot json.RawMessage `json:\"snapshot\"`\n\t}\n\tif len(body) > 32768 || !object(body, &event, \"schema_version\", \"policy_version\", \"snapshot\") || event.Schema != 1 || event.Version != version {\n\t\treturn Projection{}, ErrDenied\n\t}\n\treturn DecodeProjection(event.Snapshot, scope, version)\n}\n\nfunc DecodeProjection(body []byte, scope string, version ports.ID) (Projection, error) {\n\tvar s snapshot\n\tif len(body) > 16384 || json.Unmarshal(body, &s) != nil || len(s.Members) == 0 {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tsum := sha256.Sum256(body)\n\tv := row{scope: scope, orderID: string(s.OrderID), assignmentID: string(s.AssignmentID), version: string(version), state: s.State, body: string(body), hash: hex.EncodeToString(sum[:])}\n\tp := Projection{Scope: scope, Episode: s.Episode, State: s.State, Hash: v.hash, OrderID: s.OrderID, AssignmentID: s.AssignmentID, Version: version, StaffConfigVersion: s.StaffConfigVersion}\n\tfor _, m := range s.Members {\n\t\tg, err := evaluate(v, scope, version, m.ActorID, \"read\")\n\t\tif err != nil {\n\t\t\treturn Projection{}, err\n\t\t}\n\t\tp.Members = append(p.Members, ProjectedMember{m.ActorID, m.Role, g})\n\t}\n\treturn p, nil\n}\n\n// CurrentLocked always uses a current locking read, including in an older RR tx.\nfunc (r *Reader) CurrentLocked(ctx context.Context, tx *sql.Tx, scope string) (Projection, error) {\n\tif tx == nil || len(scope) < 1 || len(scope) > 96 {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tvar v row\n\tvar body sql.NullString\n\terr := tx.QueryRowContext(ctx, `SELECT scope_key,CAST(order_id AS CHAR),CAST(assignment_id AS CHAR),CAST(policy_version AS CHAR),state,\n\t\tCASE WHEN OCTET_LENGTH(snapshot_json)<=16384 THEN snapshot_json ELSE NULL END,snapshot_hash\n\t\tFROM chat_policy_guards WHERE scope_key=? LOCK IN SHARE MODE`, scope).Scan(&v.scope, &v.orderID, &v.assignmentID, &v.version, &v.state, &body, &v.hash)\n\tif err == sql.ErrNoRows {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tif err != nil {\n\t\treturn Projection{}, ports.ErrUnavailable\n\t}\n\tif !body.Valid {\n\t\treturn Projection{}, ErrDenied\n\t}\n\tp, err := DecodeProjection([]byte(body.String), scope, ports.ID(v.version))\n\tif err != nil || p.Hash != v.hash || string(p.OrderID) != v.orderID || string(p.AssignmentID) != v.assignmentID || p.State != v.state {\n\t\treturn Projection{}, ErrDenied\n\t}\n\treturn p, nil\n}\n\n// Every platform participant must fence ALL staff epochs. Otherwise other peers\n// could send under an obsolete policy version during a staff member's absence,\n// making that gap indistinguishable from the member's old authorized history.\nfunc (r *Reader) CheckEpochsLocked(ctx context.Context, tx *sql.Tx, p Projection, actor ports.ID, action string) error {\n\t// A schema-2 snapshot may have no staff; its config epoch still fences joins.\n\tif p.StaffConfigVersion == \"\" {\n\t\treturn nil\n\t}\n\tversions := map[ports.ID]ports.ID{\"0\": p.StaffConfigVersion}\n\tisStaff := false\n\tfor _, m := range p.Members {\n\t\tif m.Role == \"platform_staff\" && (action == \"send\" || m.ActorID == actor) {\n\t\t\tversions[m.ActorID] = m.Grant.StaffUserVersion\n\t\t\tif m.ActorID == actor {\n\t\t\t\tisStaff = true\n\t\t\t}\n\t\t}\n\t}\n\t// Unaffected peers keep their authorized history, including closed scopes\n\t// whose historical staff roster intentionally never refreshes.\n\tif action == \"read\" && !isStaff {\n\t\treturn nil\n\t}\n\tids := make([]ports.ID, 0, len(versions))\n\tfor id := range versions {\n\t\tids = append(ids, id)\n\t}\n\tsort.Slice(ids, func(i, j int) bool {\n\t\ta, _ := strconv.ParseUint(string(ids[i]), 10, 64)\n\t\tb, _ := strconv.ParseUint(string(ids[j]), 10, 64)\n\t\treturn a < b\n\t})\n\tfor _, id := range ids {\n\t\tvar current string\n\t\terr := tx.QueryRowContext(ctx, `SELECT CAST(authority_version AS CHAR) FROM chat_staff_authority_versions WHERE user_id=? LOCK IN SHARE MODE`, string(id)).Scan(&current)\n\t\tif err == sql.ErrNoRows {\n\t\t\treturn ErrDenied\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif current != string(versions[id]) {\n\t\t\treturn ErrDenied\n\t\t}\n\t}\n\treturn nil\n}\n","chat/internal/ports/contracts.go":"// Package ports defines service boundaries, not PHP order rules or SQL owners.\npackage ports\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"strconv\"\n\t\"time\"\n)\n\nvar (\n\tErrUnavailable = errors.New(\"CHAT_DEPENDENCY_UNAVAILABLE\")\n\tErrBusy        = errors.New(\"CHAT_RESOURCE_BUSY\")\n\tErrInvalid     = errors.New(\"CHAT_CONTRACT_INVALID\")\n)\n\n// ID is a canonical unsigned BIGINT carried as a decimal JSON string.\n// Cursor zero is allowed; an absent optional ID must use a pointer/omitempty.\ntype ID string\n\nfunc (id ID) Valid() bool {\n\tn, err := strconv.ParseUint(string(id), 10, 64)\n\treturn err == nil && strconv.FormatUint(n, 10) == string(id)\n}\n\nfunc (id ID) MarshalJSON() ([]byte, error) {\n\tif !id.Valid() {\n\t\treturn nil, ErrInvalid\n\t}\n\treturn json.Marshal(string(id))\n}\n\nfunc (id *ID) UnmarshalJSON(data []byte) error {\n\tvar value string\n\tif json.Unmarshal(data, &value) != nil || !ID(value).Valid() {\n\t\treturn ErrInvalid\n\t}\n\t*id = ID(value)\n\treturn nil\n}\n\ntype Principal struct {\n\tActorID                ID\n\tSessionID, Environment string\n\tScopes                 []string\n\tKind                   string\n\tSourceID               ID\n\tSessionVersion         string\n\tExpiresAt              time.Time\n}\ntype PolicyRequest struct {\n\tActor          Principal\n\tConversationID ID\n\tAction         string\n}\n\n// OrderContext is PHP-supplied display data, never an authorization input.\ntype OrderContext struct {\n\tPublicNo string `json:\"public_no\"`\n\tTitle    string `json:\"title\"`\n\tWorkflow string `json:\"workflow\"`\n}\n\ntype Grant struct {\n\tOrderContext     *OrderContext\n\tMemberRole       string\n\tCanRead, CanSend bool\n\tScopeKey         string\n\tVersion          ID\n\t// S05 must bind intervals to this immutable authority generation, not a\n\t// processing-time seq. Staff returning after revocation get a different key.\n\tMemberKey                            string\n\tStaffConfigVersion, StaffUserVersion ID\n}\ntype TextRequest struct {\n\tActor                    Principal\n\tConversationID, IntentID ID\n\tText, Fingerprint        string\n}\ntype SafetyResult struct {\n\tDecision, RuleVersion string\n\t// AuthorityProof binds the real AppID/OPENID generation; never client input.\n\tAuthorityProof string\n\tFinding        *SafetyFinding\n}\ntype SafetyFinding struct {\n\tProvider, Code, TraceID string\n\tContextEvidence         string\n\tLevel                   int\n\tConfirmed               bool\n}\ntype MediaRequest struct {\n\tActor                                  Principal\n\tIntentID                               ID\n\tObjectKey, ObjectVersion, ManifestHash string\n}\ntype MediaResult struct{ Decision, ObjectVersion, ManifestHash string }\ntype Reminder struct {\n\tIntentID, RecipientID, TargetSeq, ClusterVersion ID\n\tConversationID                                   ID\n\tOperationID                                      string\n}\ntype Receipt struct {\n\tOperationID, State string\n\tDiagnostic         string\n}\n\ntype Identity interface {\n\tAuthenticate(context.Context, string) (Principal, error)\n}\n\n// CommittedMessage is a best-effort wakeup, never a second message store.\ntype CommittedMessage struct{ ConversationID, Seq, PolicyVersion ID }\ntype MessagePublisher interface{ Committed(CommittedMessage) }\ntype RealtimePolicy interface {\n\tPolicy\n\tMemberCandidates(context.Context, ID) ([]ID, error)\n}\ntype Policy interface {\n\tAuthorize(context.Context, PolicyRequest) (Grant, error)\n}\ntype Safety interface {\n\tCheckText(context.Context, TextRequest) (SafetyResult, error)\n}\ntype Media interface {\n\tInspect(context.Context, MediaRequest) (MediaResult, error)\n}\ntype Notification interface {\n\tSubmit(context.Context, Reminder) (Receipt, error)\n}\ntype Set struct {\n\tIdentity     Identity\n\tPolicy       Policy\n\tSafety       Safety\n\tMedia        Media\n\tNotification Notification\n}\n","chat/internal/ports/contracts_test.go":"package ports\n\nimport (\n\t\"encoding/json\"\n\t\"testing\"\n)\n\nfunc TestBIGINTStringContract(t *testing.T) {\n\tfor _, v := range []ID{\"0\", \"9\", \"10\", \"9007199254740993\", \"18446744073709551615\"} {\n\t\tb, e := json.Marshal(v)\n\t\tif e != nil || string(b) != \"\\\"\"+string(v)+\"\\\"\" {\n\t\t\tt.Fatal(\"lost bigint precision\")\n\t\t}\n\t\tvar got ID\n\t\tif json.Unmarshal(b, &got) != nil || got != v {\n\t\t\tt.Fatal(\"roundtrip failed\")\n\t\t}\n\t}\n\tfor _, v := range []string{`1`, `null`, `\"\"`, `\"01\"`, `\"-1\"`, `\"1e3\"`, `\"18446744073709551616\"`} {\n\t\tvar got ID\n\t\tif json.Unmarshal([]byte(v), &got) == nil {\n\t\t\tt.Fatalf(\"invalid id accepted: %s\", v)\n\t\t}\n\t}\n}\n","chat/internal/socket/gateway.go":"package socket\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/gorilla/websocket\"\n)\n\ntype Config struct {\n\tEnabled bool `json:\"enabled\"`\n}\ntype Commands interface {\n\tExecute(context.Context, ports.Principal, string, json.RawMessage) (string, any, error)\n}\ntype Gateway struct {\n\tidentity    *auth.Service\n\tcommands    Commands\n\tgate        chan struct{}\n\tmu          sync.Mutex\n\tclients     map[*client]struct{}\n\tstopping    bool\n\tqueuedBytes atomic.Int64\n\twg          sync.WaitGroup\n\ttiming      timings\n\trealtime    *realtime\n}\ntype timings struct{ auth, write, ping, pong, idle, check, operation time.Duration }\n\nfunc New(identity *auth.Service, commands Commands) (*Gateway, error) {\n\tif identity == nil || commands == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Gateway{identity: identity, commands: commands, gate: make(chan struct{}, 16), clients: map[*client]struct{}{}, timing: timings{5 * time.Second, 2 * time.Second, 30 * time.Second, 10 * time.Second, 90 * time.Second, 5 * time.Second, 4 * time.Second}}, nil\n}\n\ntype outbound struct {\n\tframe        frame\n\tcontrol      int\n\tbytes        []byte\n\tprotected    bool\n\tepoch        uint64\n\tconversation ports.ID\n\ttypingSource *client\n\ttypingUntil  time.Time\n}\ntype client struct {\n\tg            *Gateway\n\tws           *websocket.Conn\n\ttransportMu  sync.Mutex\n\texpires      atomic.Int64\n\tauthUntil    time.Time\n\tctx          context.Context\n\tcancel       context.CancelFunc\n\tidentity     *auth.SocketIdentity\n\tactor        ports.ID\n\tkind         string\n\tout          chan outbound\n\tqueueMu      sync.Mutex\n\tstop         chan struct{}\n\tonce         sync.Once\n\tcode         atomic.Int32\n\tepoch        atomic.Uint64\n\tforeground   atomic.Bool\n\theartbeatMu  sync.Mutex\n\tchallenge    string\n\tpongUntil    time.Time\n\tlastActivity time.Time\n\tbudgetMu     sync.Mutex\n\tbudget       int\n\tbudgetAt     time.Time\n\tstateMu      sync.Mutex\n\tactive       ports.ID\n\tpresenceAt   time.Time\n\ttypingAt     time.Time\n\ttypingUntil  time.Time\n}\n\nfunc (g *Gateway) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tif r.URL.Path != \"/chat/ws\" {\n\t\tfailHTTP(w, r, 404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"GET\" {\n\t\tw.Header().Set(\"Allow\", \"GET\")\n\t\tfailHTTP(w, r, 405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\t// Credentials are accepted only in the first frame. No query or protocol\n\t// token can leak through access logs, referers or proxy diagnostics.\n\tif r.URL.RawQuery != \"\" || r.URL.ForceQuery || r.URL.RawPath != \"\" || len(r.Header.Values(\"Authorization\")) != 0 || len(r.Header.Values(\"Sec-WebSocket-Protocol\")) != 0 || r.ContentLength > 0 {\n\t\tfailHTTP(w, r, 400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tctx, cancel := context.WithCancel(context.Background())\n\tc := &client{g: g, ctx: ctx, cancel: cancel, out: make(chan outbound, 8), stop: make(chan struct{}), lastActivity: time.Now(), budgetAt: time.Now(), authUntil: time.Now().Add(g.timing.auth)}\n\tg.mu.Lock()\n\tif g.stopping || len(g.clients) >= 300 {\n\t\tg.mu.Unlock()\n\t\tcancel()\n\t\tfailHTTP(w, r, 503, \"CHAT_RESOURCE_BUSY\")\n\t\treturn\n\t}\n\tg.clients[c] = struct{}{}\n\tg.wg.Add(1)\n\tg.mu.Unlock()\n\tdefer func() {\n\t\tcancel()\n\t\tc.clearTransient()\n\t\tg.mu.Lock()\n\t\tdelete(g.clients, c)\n\t\tg.mu.Unlock()\n\t\tg.wg.Done()\n\t}()\n\tup := websocket.Upgrader{HandshakeTimeout: g.timing.write, ReadBufferSize: 4096, WriteBufferSize: 4096, EnableCompression: false, Error: func(w http.ResponseWriter, r *http.Request, status int, _ error) {\n\t\tfailHTTP(w, r, status, \"CHAT_SOCKET_UPGRADE_INVALID\")\n\t}, CheckOrigin: func(r *http.Request) bool {\n\t\torigins := r.Header.Values(\"Origin\")\n\t\tif len(origins) == 0 {\n\t\t\treturn true\n\t\t}\n\t\tif len(origins) != 1 {\n\t\t\treturn false\n\t\t}\n\t\tu, e := url.Parse(origins[0])\n\t\treturn e == nil && u.Scheme == \"https\" && u.Host == r.Host && u.User == nil && u.RawQuery == \"\" && u.Fragment == \"\" && u.Path == \"\"\n\t}}\n\tws, e := up.Upgrade(w, r, nil)\n\tif e != nil {\n\t\treturn\n\t}\n\tc.transportMu.Lock()\n\tc.ws = ws\n\tc.transportMu.Unlock()\n\tdefer ws.Close()\n\tselect {\n\tcase <-c.stop:\n\t\treturn\n\tdefault:\n\t}\n\tws.SetReadLimit(32 << 10)\n\t_ = ws.SetReadDeadline(time.Now().Add(g.timing.auth))\n\t// Control replies also go through the one writer. Control floods consume\n\t// the same in-memory budget as application commands.\n\tws.SetPingHandler(func(s string) error {\n\t\tif !c.allow() {\n\t\t\treturn ports.ErrBusy\n\t\t}\n\t\tif !c.enqueue(outbound{control: websocket.PongMessage, bytes: []byte(s)}) {\n\t\t\treturn ports.ErrBusy\n\t\t}\n\t\treturn nil\n\t})\n\tws.SetPongHandler(func(s string) error { c.pong(s); return nil })\n\tws.SetCloseHandler(func(int, string) error { return nil })\n\twriterDone := make(chan struct{})\n\tgo func() { defer close(writerDone); c.writeLoop() }()\n\texpiryDone := make(chan struct{})\n\tgo func() { defer close(expiryDone); c.expiryLoop() }()\n\tdefer func() { c.close(websocket.CloseNormalClosure); <-writerDone; <-expiryDone }()\n\tkind, raw, e := ws.ReadMessage()\n\tf, ok := decode(raw)\n\tvar q struct {\n\t\tTicket string `json:\"ticket\"`\n\t}\n\tif e != nil || kind != websocket.TextMessage || !ok || f.Type != \"auth\" || !strict(f.Payload, &q) {\n\t\tc.close(websocket.ClosePolicyViolation)\n\t\treturn\n\t}\n\tselect {\n\tcase g.gate <- struct{}{}:\n\tdefault:\n\t\tc.close(websocket.CloseTryAgainLater)\n\t\treturn\n\t}\n\top, stop := context.WithDeadline(c.ctx, minTime(c.authUntil, time.Now().Add(g.timing.operation)))\n\tclaims, e := g.identity.ConsumeTicket(op, q.Ticket)\n\tstop()\n\t<-g.gate\n\tif e != nil {\n\t\tc.close(websocket.ClosePolicyViolation)\n\t\treturn\n\t}\n\tc.identity = auth.NewSocketIdentity(claims)\n\tc.actor = claims.ActorID\n\tc.kind = claims.Kind\n\tc.expires.Store(claims.ExpiresAt)\n\tc.epoch.Store(1)\n\tc.foreground.Store(true)\n\tc.send(f, \"auth.ok\", map[string]any{\"actor_id\": claims.ActorID, \"expires_at\": claims.ExpiresAt, \"heartbeat_seconds\": 30}, true)\n\t_ = ws.SetReadDeadline(time.Now().Add(g.timing.idle))\n\tfor {\n\t\tkind, raw, e = ws.ReadMessage()\n\t\tif e != nil {\n\t\t\treturn\n\t\t}\n\t\tif kind != websocket.TextMessage {\n\t\t\tc.close(websocket.CloseUnsupportedData)\n\t\t\treturn\n\t\t}\n\t\tif !c.allow() {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn\n\t\t}\n\t\tf, ok = decode(raw)\n\t\tif !ok {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn\n\t\t}\n\t\tc.heartbeatMu.Lock()\n\t\tc.lastActivity = time.Now()\n\t\tc.heartbeatMu.Unlock()\n\t\tif f.Type == \"pong\" {\n\t\t\tvar q struct {\n\t\t\t\tNonce string `json:\"nonce\"`\n\t\t\t}\n\t\t\tif !strict(f.Payload, &q) {\n\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tc.pong(q.Nonce)\n\t\t\tcontinue\n\t\t}\n\t\tif !c.handle(f) {\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc failHTTP(w http.ResponseWriter, r *http.Request, status int, code string) {\n\tvar b [16]byte\n\t_, _ = rand.Read(b[:])\n\tid := hex.EncodeToString(b[:])\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"X-Request-ID\", id)\n\tw.WriteHeader(status)\n\tif r.Method != \"HEAD\" {\n\t\t_ = json.NewEncoder(w).Encode(map[string]any{\"request_id\": id, \"code\": code, \"retryable\": status == 503, \"server_time\": time.Now().UTC()})\n\t}\n}\nfunc (c *client) allow() bool {\n\tc.budgetMu.Lock()\n\tdefer c.budgetMu.Unlock()\n\tif time.Since(c.budgetAt) >= time.Second {\n\t\tc.budget = 0\n\t\tc.budgetAt = time.Now()\n\t}\n\tc.budget++\n\treturn c.budget <= 20\n}\nfunc (c *client) pong(nonce string) {\n\tc.heartbeatMu.Lock()\n\tdefer c.heartbeatMu.Unlock()\n\tif c.challenge != \"\" && nonce == c.challenge {\n\t\tc.challenge = \"\"\n\t\tc.pongUntil = time.Time{}\n\t\tc.lastActivity = time.Now()\n\t\t_ = c.ws.SetReadDeadline(time.Now().Add(c.g.timing.idle))\n\t}\n}\nfunc (c *client) close(code int) {\n\tc.once.Do(func() {\n\t\tc.foreground.Store(false)\n\t\tc.code.Store(int32(code))\n\t\tclose(c.stop)\n\t\tc.cancel()\n\t})\n}\nfunc (c *client) enqueue(o outbound) bool {\n\tc.queueMu.Lock()\n\tdefer c.queueMu.Unlock()\n\tselect {\n\tcase <-c.stop:\n\t\treturn false\n\tdefault:\n\t}\n\tsize := int64(len(o.frame.Payload) + len(o.bytes) + 128)\n\tif c.g.queuedBytes.Add(size) > 16<<20 {\n\t\tc.g.queuedBytes.Add(-size)\n\t\tc.close(websocket.CloseTryAgainLater)\n\t\treturn false\n\t}\n\tselect {\n\tcase c.out <- o:\n\t\treturn true\n\tdefault:\n\t\tc.g.queuedBytes.Add(-size)\n\t\tc.close(websocket.CloseTryAgainLater)\n\t\treturn false\n\t}\n}\nfunc (c *client) send(f frame, typ string, payload any, protected bool) bool {\n\traw, e := json.Marshal(payload)\n\tif e != nil || len(raw) > 256<<10 {\n\t\tc.close(websocket.CloseInternalServerErr)\n\t\treturn false\n\t}\n\treturn c.enqueue(outbound{frame: frame{1, f.RequestID, typ, raw}, protected: protected, epoch: c.epoch.Load()})\n}\nfunc (c *client) current() (auth.Claims, error) {\n\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\tdefer cancel()\n\treturn c.identity.Current(ctx, c.g.identity)\n}\nfunc minTime(a, b time.Time) time.Time {\n\tif a.Before(b) {\n\t\treturn a\n\t}\n\treturn b\n}\nfunc principal(c auth.Claims) ports.Principal {\n\treturn ports.Principal{ActorID: c.ActorID, Kind: c.Kind, SourceID: c.SourceID, SessionID: c.SessionID, Environment: c.Environment, SessionVersion: c.Version, Scopes: c.Scopes, ExpiresAt: time.Unix(c.ExpiresAt, 0).UTC()}\n}\nfunc (c *client) handle(f frame) bool {\n\tselect {\n\tcase c.g.gate <- struct{}{}:\n\t\tdefer func() { <-c.g.gate }()\n\tdefault:\n\t\treturn c.send(f, \"error\", map[string]any{\"code\": \"CHAT_RESOURCE_BUSY\", \"retryable\": true}, false)\n\t}\n\tclaims, e := c.current()\n\tif e != nil {\n\t\tc.close(websocket.ClosePolicyViolation)\n\t\treturn false\n\t}\n\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\tdefer cancel()\n\tswitch f.Type {\n\tcase \"auth.refresh\":\n\t\tvar q struct {\n\t\t\tAccessToken string `json:\"access_token\"`\n\t\t}\n\t\tif !strict(f.Payload, &q) || len(q.AccessToken) > 4096 {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn false\n\t\t}\n\t\tif c.identity.Refresh(ctx, c.g.identity, q.AccessToken) != nil {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn false\n\t\t}\n\t\tc.epoch.Add(1)\n\t\tclaims, e = c.current()\n\t\tif e != nil {\n\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\treturn false\n\t\t}\n\t\tc.expires.Store(claims.ExpiresAt)\n\t\treturn c.send(f, \"auth.ok\", map[string]any{\"actor_id\": claims.ActorID, \"expires_at\": claims.ExpiresAt}, true)\n\tcase \"session.state\":\n\t\tvar q struct {\n\t\t\tState string `json:\"state\"`\n\t\t}\n\t\tif !strict(f.Payload, &q) || (q.State != \"foreground\" && q.State != \"background\") {\n\t\t\treturn c.send(f, \"error\", map[string]any{\"code\": \"CHAT_INVALID_REQUEST\", \"retryable\": false}, false)\n\t\t}\n\t\tc.foreground.Store(q.State == \"foreground\")\n\t\tif q.State == \"background\" {\n\t\t\tc.clearTransient()\n\t\t}\n\t\treturn c.send(f, \"session.state\", q, true)\n\tcase \"ping\":\n\t\tvar q struct {\n\t\t\tNonce string `json:\"nonce\"`\n\t\t}\n\t\tif !strict(f.Payload, &q) || len(q.Nonce) > 64 {\n\t\t\treturn c.send(f, \"error\", map[string]any{\"code\": \"CHAT_INVALID_REQUEST\", \"retryable\": false}, false)\n\t\t}\n\t\treturn c.send(f, \"pong\", q, false)\n\tcase \"auth\":\n\t\tc.close(websocket.ClosePolicyViolation)\n\t\treturn false\n\t}\n\tif handled, ok := c.transient(ctx, claims, f); handled {\n\t\treturn ok\n\t}\n\ttyp, data, e := c.g.commands.Execute(ctx, principal(claims), f.Type, f.Payload)\n\tif e != nil {\n\t\tcode, retry := \"CHAT_DEPENDENCY_UNAVAILABLE\", true\n\t\tvar safe interface{ PublicCode() (string, bool) }\n\t\tif errors.As(e, &safe) {\n\t\t\tcode, retry = safe.PublicCode()\n\t\t}\n\t\treturn c.send(f, \"error\", map[string]any{\"code\": code, \"retryable\": retry}, false)\n\t}\n\treturn c.send(f, typ, data, true)\n}\n\n// Expiry must not wait behind a slow write or a persistent-session lookup.\n// The writer remains the sole frame writer; cancellation interrupts use cases.\nfunc (c *client) expiryLoop() {\n\ttick := time.NewTicker(min(c.g.timing.check, 100*time.Millisecond))\n\tdefer tick.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-c.stop:\n\t\t\treturn\n\t\tcase now := <-tick.C:\n\t\t\tif c.epoch.Load() == 0 {\n\t\t\t\tif !now.Before(c.authUntil) {\n\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t} else if now.Unix() >= c.expires.Load() {\n\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\nfunc (c *client) writeLoop() {\n\tdefer c.ws.Close()\n\tdefer func() {\n\t\tc.queueMu.Lock()\n\t\tdefer c.queueMu.Unlock()\n\t\tfor {\n\t\t\tselect {\n\t\t\tcase o := <-c.out:\n\t\t\t\tc.g.queuedBytes.Add(-int64(len(o.frame.Payload) + len(o.bytes) + 128))\n\t\t\tdefault:\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}()\n\ttick := time.NewTicker(min(c.g.timing.check, 100*time.Millisecond))\n\tdefer tick.Stop()\n\tnextPing := time.Now().Add(c.g.timing.ping)\n\tnextCheck := time.Now().Add(c.g.timing.check)\n\tvar warned uint64\n\tfor {\n\t\tselect {\n\t\tcase <-c.stop:\n\t\t\t_ = c.ws.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(int(c.code.Load()), \"\"), time.Now().Add(c.g.timing.write))\n\t\t\treturn\n\t\tcase o := <-c.out:\n\t\t\tc.g.queuedBytes.Add(-int64(len(o.frame.Payload) + len(o.bytes) + 128))\n\t\t\tif o.protected {\n\t\t\t\tif o.epoch != c.epoch.Load() {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif o.conversation != \"\" {\n\t\t\t\t\tclaims, e := c.current()\n\t\t\t\t\tif e != nil {\n\t\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tif !c.foreground.Load() || c.g.realtime == nil {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\t\t\t\t\t_, e = c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(claims), ConversationID: o.conversation, Action: \"read\"})\n\t\t\t\t\tcancel()\n\t\t\t\t\tif e != nil {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tif o.typingSource != nil {\n\t\t\t\t\t\tc.stateMu.Lock()\n\t\t\t\t\t\tfocused := c.active == o.conversation\n\t\t\t\t\t\tc.stateMu.Unlock()\n\t\t\t\t\t\tif !focused || !o.typingSource.canType(o.conversation, o.typingUntil) {\n\t\t\t\t\t\t\tcontinue\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif _, e := c.current(); e != nil {\n\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif o.epoch != c.epoch.Load() {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t}\n\t\t\tselect {\n\t\t\tcase <-c.stop:\n\t\t\t\tcontinue\n\t\t\tdefault:\n\t\t\t}\n\t\t\tdeadline := time.Now().Add(c.g.timing.write)\n\t\t\tif o.protected {\n\t\t\t\tdeadline = minTime(deadline, time.Unix(c.expires.Load(), 0))\n\t\t\t}\n\t\t\t_ = c.ws.SetWriteDeadline(deadline)\n\t\t\tvar e error\n\t\t\tif o.control != 0 {\n\t\t\t\te = c.ws.WriteControl(o.control, o.bytes, time.Now().Add(c.g.timing.write))\n\t\t\t} else {\n\t\t\t\te = c.ws.WriteJSON(o.frame)\n\t\t\t}\n\t\t\tif e != nil {\n\t\t\t\tc.close(websocket.CloseTryAgainLater)\n\t\t\t}\n\t\tcase now := <-tick.C:\n\t\t\t// epoch publishes identity after first-frame auth. Heartbeats never write\n\t\t\t// last_seen, Redis presence, read progress or successful-event logs.\n\t\t\tif c.epoch.Load() == 0 {\n\t\t\t\tif !now.Before(c.authUntil) {\n\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif now.Unix() >= c.expires.Load() {\n\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif c.expires.Load()-now.Unix() <= 30 && warned != c.epoch.Load() {\n\t\t\t\twarned = c.epoch.Load()\n\t\t\t\tc.send(frame{RequestID: \"server\"}, \"auth.required\", map[string]any{\"expires_at\": c.expires.Load()}, true)\n\t\t\t}\n\t\t\tc.heartbeatMu.Lock()\n\t\t\texpired := !c.pongUntil.IsZero() && !now.Before(c.pongUntil) || now.Sub(c.lastActivity) >= c.g.timing.idle\n\t\t\tc.heartbeatMu.Unlock()\n\t\t\tif expired {\n\t\t\t\tc.close(websocket.CloseGoingAway)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif !now.Before(nextCheck) {\n\t\t\t\tif _, e := c.current(); e != nil {\n\t\t\t\t\tc.close(websocket.ClosePolicyViolation)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tnextCheck = now.Add(c.g.timing.check)\n\t\t\t}\n\t\t\tif !now.Before(nextPing) {\n\t\t\t\tvar b [16]byte\n\t\t\t\tif _, e := rand.Read(b[:]); e != nil {\n\t\t\t\t\tc.close(websocket.CloseInternalServerErr)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tnonce := hex.EncodeToString(b[:])\n\t\t\t\tc.heartbeatMu.Lock()\n\t\t\t\tc.challenge = nonce\n\t\t\t\tc.pongUntil = now.Add(c.g.timing.pong)\n\t\t\t\tc.heartbeatMu.Unlock()\n\t\t\t\tif e := c.ws.WriteControl(websocket.PingMessage, []byte(nonce), now.Add(c.g.timing.write)); e != nil {\n\t\t\t\t\tc.close(websocket.CloseGoingAway)\n\t\t\t\t}\n\t\t\t\tnextPing = now.Add(c.g.timing.ping)\n\t\t\t}\n\t\t}\n\t}\n}\n\n// Shutdown explicitly owns hijacked connections, which http.Server.Shutdown\n// does not wait for. Cancellation blocks admission and interrupts use cases.\nfunc (g *Gateway) Shutdown(ctx context.Context) error {\n\tg.mu.Lock()\n\tg.stopping = true\n\tif g.realtime != nil {\n\t\tg.realtime.once.Do(func() {\n\t\t\tif g.realtime.cancel != nil {\n\t\t\t\tg.realtime.cancel()\n\t\t\t}\n\t\t\tclose(g.realtime.stop)\n\t\t})\n\t}\n\tfor c := range g.clients {\n\t\tc.close(websocket.CloseGoingAway)\n\t}\n\tg.mu.Unlock()\n\tdone := make(chan struct{})\n\tgo func() {\n\t\tg.wg.Wait()\n\t\tif g.realtime != nil {\n\t\t\tg.realtime.workers.Wait()\n\t\t}\n\t\tclose(done)\n\t}()\n\tselect {\n\tcase <-done:\n\t\treturn nil\n\tcase <-ctx.Done():\n\t\tg.mu.Lock()\n\t\tfor c := range g.clients {\n\t\t\tc.transportMu.Lock()\n\t\t\tif c.ws != nil {\n\t\t\t\t_ = c.ws.Close()\n\t\t\t}\n\t\t\tc.transportMu.Unlock()\n\t\t}\n\t\tg.mu.Unlock()\n\t\treturn ctx.Err()\n\t}\n}\n","chat/internal/socket/gateway_test.go":"package socket\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/gorilla/websocket\"\n)\n\ntype tickets struct {\n\tsync.Mutex\n\tvalues map[string]string\n\tfail   atomic.Bool\n}\n\nfunc (m *tickets) Put(_ context.Context, k, v string, _ time.Duration) (bool, error) {\n\tm.Lock()\n\tdefer m.Unlock()\n\tif m.fail.Load() {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tm.values[k] = v\n\treturn true, nil\n}\nfunc (m *tickets) Take(_ context.Context, k string) (string, error) {\n\tm.Lock()\n\tdefer m.Unlock()\n\tif m.fail.Load() {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tv := m.values[k]\n\tdelete(m.values, k)\n\treturn v, nil\n}\n\ntype source struct {\n\trevoked atomic.Bool\n\tcalls   atomic.Int64\n}\n\nfunc (s *source) Validate(context.Context, auth.Claims) error {\n\ts.calls.Add(1)\n\tif s.revoked.Load() {\n\t\treturn auth.ErrUnauthorized\n\t}\n\treturn nil\n}\n\ntype echo struct {\n\tcalls atomic.Int64\n\tblock atomic.Bool\n}\n\nfunc (e *echo) Execute(ctx context.Context, p ports.Principal, typ string, raw json.RawMessage) (string, any, error) {\n\te.calls.Add(1)\n\tif typ == \"large\" {\n\t\treturn \"large.result\", strings.Repeat(\"x\", 200<<10), nil\n\t}\n\tif e.block.Load() {\n\t\t<-ctx.Done()\n\t\treturn \"\", nil, ctx.Err()\n\t}\n\treturn typ + \".result\", map[string]any{\"actor_id\": p.ActorID}, nil\n}\n\ntype fixture struct {\n\tg        *Gateway\n\ts        *auth.Service\n\tsrc      *source\n\tstore    *tickets\n\tcommands *echo\n\tpriv     ed25519.PrivateKey\n\tclaims   auth.Claims\n\tserver   *httptest.Server\n\turl      string\n}\n\nfunc setup(t *testing.T) *fixture {\n\tt.Helper()\n\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\tv, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"v1\": pub})\n\tsrc := &source{}\n\tstore := &tickets{values: map[string]string{}}\n\ts, _ := auth.NewService(v, src, store, 16, 100*time.Millisecond)\n\tcommands := &echo{}\n\tg, _ := New(s, commands)\n\tg.timing = timings{300 * time.Millisecond, 100 * time.Millisecond, 100 * time.Millisecond, 70 * time.Millisecond, 600 * time.Millisecond, 30 * time.Millisecond, 100 * time.Millisecond}\n\tserver := httptest.NewServer(g)\n\tnow := time.Now().Unix()\n\tc := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: \"18446744073709551615\", Kind: \"mini\", SourceID: \"1\", SessionID: strings.Repeat(\"a\", 64), Version: strings.Repeat(\"b\", 64), Environment: \"test\", Scopes: []string{\"chat:use\"}, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\tf := &fixture{g, s, src, store, commands, priv, c, server, \"ws\" + strings.TrimPrefix(server.URL, \"http\") + \"/chat/ws\"}\n\tt.Cleanup(func() {\n\t\tctx, cancel := context.WithTimeout(context.Background(), time.Second)\n\t\tdefer cancel()\n\t\tif err := g.Shutdown(ctx); err != nil {\n\t\t\tt.Error(err)\n\t\t}\n\t\tserver.Close()\n\t\tif g.queuedBytes.Load() != 0 {\n\t\t\tt.Error(\"outbound byte budget leaked\")\n\t\t}\n\t})\n\treturn f\n}\nfunc (f *fixture) token(c auth.Claims) string {\n\tb, _ := json.Marshal(c)\n\ta := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"v1\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(b)\n\treturn a + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(f.priv, []byte(a)))\n}\nfunc (f *fixture) ticket(t *testing.T) string {\n\tt.Helper()\n\tv, _, e := f.s.IssueTicket(context.Background(), f.token(f.claims))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\treturn v\n}\nfunc (f *fixture) dial(t *testing.T) *websocket.Conn {\n\tt.Helper()\n\tc, _, e := websocket.DefaultDialer.Dial(f.url, nil)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tt.Cleanup(func() { c.Close() })\n\treturn c\n}\nfunc send(t *testing.T, c *websocket.Conn, typ string, payload any) {\n\tt.Helper()\n\tb, e := json.Marshal(payload)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e = c.WriteJSON(frame{1, \"r1\", typ, b}); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\nfunc read(t *testing.T, c *websocket.Conn, typ string) frame {\n\tt.Helper()\n\tc.SetReadDeadline(time.Now().Add(time.Second))\n\tvar f frame\n\tif e := c.ReadJSON(&f); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif f.Type != typ || f.Version != 1 || f.RequestID != \"r1\" {\n\t\tt.Fatalf(\"wrong frame %s\", f.Type)\n\t}\n\treturn f\n}\nfunc (f *fixture) login(t *testing.T) *websocket.Conn {\n\tt.Helper()\n\tc := f.dial(t)\n\tsend(t, c, \"auth\", map[string]string{\"ticket\": f.ticket(t)})\n\tread(t, c, \"auth.ok\")\n\treturn c\n}\nfunc closed(t *testing.T, c *websocket.Conn) {\n\tt.Helper()\n\tc.SetReadDeadline(time.Now().Add(2 * time.Second))\n\tfor {\n\t\t_, _, e := c.ReadMessage()\n\t\tif e != nil {\n\t\t\tvar ce *websocket.CloseError\n\t\t\tif !errors.As(e, &ce) {\n\t\t\t\tt.Fatalf(\"connection timed out instead of closing: %v\", e)\n\t\t\t}\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc TestFirstFrameReplayAndTimeout(t *testing.T) {\n\tf := setup(t)\n\tc := f.dial(t)\n\tclosed(t, c)\n\tc = f.dial(t)\n\tsend(t, c, \"sync.request\", map[string]string{})\n\tclosed(t, c)\n\tticket := f.ticket(t)\n\tc = f.dial(t)\n\tsend(t, c, \"auth\", map[string]string{\"ticket\": ticket})\n\tread(t, c, \"auth.ok\")\n\tother := f.dial(t)\n\tsend(t, other, \"auth\", map[string]string{\"ticket\": ticket})\n\tclosed(t, other)\n\tif f.commands.calls.Load() != 0 {\n\t\tt.Fatal(\"unauthenticated command executed\")\n\t}\n}\nfunc TestConcurrentTicketReplayOnlyOneConnection(t *testing.T) {\n\tf := setup(t)\n\tticket := f.ticket(t)\n\tclients := make([]*websocket.Conn, 12)\n\tfor i := range clients {\n\t\tclients[i] = f.dial(t)\n\t}\n\tvar successes atomic.Int64\n\tvar wg sync.WaitGroup\n\tfor _, c := range clients {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tb, _ := json.Marshal(map[string]string{\"ticket\": ticket})\n\t\t\tc.WriteJSON(frame{1, \"r1\", \"auth\", b})\n\t\t\tc.SetReadDeadline(time.Now().Add(time.Second))\n\t\t\tvar out frame\n\t\t\tif c.ReadJSON(&out) == nil && out.Type == \"auth.ok\" {\n\t\t\t\tsuccesses.Add(1)\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\tif successes.Load() != 1 {\n\t\tt.Fatalf(\"ticket accepted %d times\", successes.Load())\n\t}\n}\nfunc TestRefreshIdentityRevocationAndTwoDevices(t *testing.T) {\n\tf := setup(t)\n\ta, b := f.login(t), f.login(t)\n\tsend(t, a, \"session.state\", map[string]string{\"state\": \"background\"})\n\tread(t, a, \"session.state\")\n\tsend(t, b, \"sync.request\", map[string]string{})\n\tread(t, b, \"sync.request.result\")\n\tnext := f.claims\n\tnext.IssuedAt++\n\tnext.NotBefore++\n\tnext.ExpiresAt++\n\tsend(t, a, \"auth.refresh\", map[string]string{\"access_token\": f.token(next)})\n\tread(t, a, \"auth.ok\")\n\tnext.ActorID = \"2\"\n\tsend(t, a, \"auth.refresh\", map[string]string{\"access_token\": f.token(next)})\n\tclosed(t, a)\n\t// Closing one device does not log out another; persistent PHP revocation does.\n\tsend(t, b, \"ping\", map[string]string{\"nonce\": \"alive\"})\n\tread(t, b, \"pong\")\n\tf.src.revoked.Store(true)\n\tclosed(t, b)\n}\nfunc TestExpiryCannotReviveAndIdleRevocation(t *testing.T) {\n\tf := setup(t)\n\tf.claims.ExpiresAt = time.Now().Unix() + 1\n\tc := f.login(t)\n\tclosed(t, c)\n\tif f.commands.calls.Load() != 0 {\n\t\tt.Fatal(\"expiry executed a command\")\n\t}\n}\nfunc TestHeartbeatRequiresMatchingPong(t *testing.T) {\n\tf := setup(t)\n\tc := f.login(t)\n\tc.SetPingHandler(func(string) error { return nil })\n\tclosed(t, c)\n\thealthy := f.login(t)\n\tfor i := 0; i < 5; i++ {\n\t\ttime.Sleep(45 * time.Millisecond)\n\t\tsend(t, healthy, \"ping\", map[string]string{\"nonce\": \"app\"})\n\t\tread(t, healthy, \"pong\")\n\t}\n}\nfunc TestRedisOutageDoesNotBypassTicketOrKillAuthenticatedHTTPIdentity(t *testing.T) {\n\tf := setup(t)\n\tc := f.login(t)\n\tticket := f.ticket(t)\n\tf.store.fail.Store(true)\n\tnewConnection := f.dial(t)\n\tsend(t, newConnection, \"auth\", map[string]string{\"ticket\": ticket})\n\tclosed(t, newConnection)\n\tsend(t, c, \"sync.request\", map[string]string{})\n\tread(t, c, \"sync.request.result\")\n\tif _, e := f.s.Authenticate(context.Background(), f.token(f.claims)); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\nfunc TestAdmissionAndProtocolBoundaries(t *testing.T) {\n\tf := setup(t)\n\tfor _, tc := range []struct {\n\t\tsuffix  string\n\t\theaders http.Header\n\t}{{\"?ticket=private\", nil}, {\"?\", nil}, {\"\", http.Header{\"Authorization\": {\"Bearer private\"}}}, {\"\", http.Header{\"Sec-WebSocket-Protocol\": {\"private\"}}}, {\"\", http.Header{\"Origin\": {\"https://evil.invalid\"}}}} {\n\t\tc, res, e := websocket.DefaultDialer.Dial(f.url+tc.suffix, tc.headers)\n\t\tif e == nil {\n\t\t\tc.Close()\n\t\t\tt.Fatal(\"unsafe upgrade accepted\")\n\t\t}\n\t\tif res != nil {\n\t\t\tres.Body.Close()\n\t\t}\n\t}\n\tfor _, raw := range []string{`{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"auth\",\"payload\":{\"ticket\":\"x\",\"ticket\":\"x\"}}`, `{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"auth\",\"payload\":{},\"TYPE\":\"auth\"}`, `{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"auth\",\"payload\":{\"ticket\":\"\\ud800\"}}`} {\n\t\tc := f.dial(t)\n\t\tc.WriteMessage(websocket.TextMessage, []byte(raw))\n\t\tclosed(t, c)\n\t}\n\tc := f.login(t)\n\tc.WriteMessage(websocket.BinaryMessage, []byte(\"binary\"))\n\tclosed(t, c)\n\tc = f.login(t)\n\tc.WriteMessage(websocket.TextMessage, []byte(strings.Repeat(\"x\", (32<<10)+1)))\n\tclosed(t, c)\n}\nfunc TestBoundedQueueAndShutdownIsolation(t *testing.T) {\n\tf := setup(t)\n\thealthy := f.login(t)\n\tctx, cancel := context.WithCancel(context.Background())\n\tslow := &client{g: f.g, ctx: ctx, cancel: cancel, out: make(chan outbound, 8), stop: make(chan struct{})}\n\tfor range 8 {\n\t\tif !slow.enqueue(outbound{}) {\n\t\t\tt.Fatal(\"early overflow\")\n\t\t}\n\t}\n\tif slow.enqueue(outbound{}) {\n\t\tt.Fatal(\"unbounded queue\")\n\t}\n\tif slow.code.Load() != websocket.CloseTryAgainLater {\n\t\tt.Fatal(\"slow client not disconnected\")\n\t}\n\tfor len(slow.out) > 0 {\n\t\to := <-slow.out\n\t\tf.g.queuedBytes.Add(-int64(len(o.frame.Payload) + len(o.bytes) + 128))\n\t}\n\tsend(t, healthy, \"sync.request\", map[string]string{})\n\tread(t, healthy, \"sync.request.result\")\n\t// Shutdown interrupts a blocked use case and owns the hijacked connection.\n\tf.commands.block.Store(true)\n\tsend(t, healthy, \"sync.request\", map[string]string{})\n\tshutdown, stop := context.WithTimeout(context.Background(), time.Second)\n\tdefer stop()\n\tif e := f.g.Shutdown(shutdown); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tclosed(t, healthy)\n\t_, res, e := websocket.DefaultDialer.Dial(f.url, nil)\n\tif e == nil || res == nil || res.StatusCode != 503 {\n\t\tt.Fatal(\"shutdown admitted a connection\")\n\t}\n\tres.Body.Close()\n}\nfunc TestStrictEnvelope(t *testing.T) {\n\tfor _, raw := range []string{`null`, `[]`, `{\"protocol_version\":2,\"request_id\":\"r1\",\"type\":\"ping\",\"payload\":{}}`, `{\"protocol_version\":1,\"request_id\":\"bad\\n\",\"type\":\"ping\",\"payload\":{}}`, `{\"protocol_version\":1,\"request_id\":\"r1\",\"type\":\"ping\",\"payload\":null}`} {\n\t\tif _, ok := decode([]byte(raw)); ok {\n\t\t\tt.Fatal(\"invalid envelope accepted\")\n\t\t}\n\t}\n}\n\nfunc TestNetworkSlowReaderDoesNotBlockAnotherConnection(t *testing.T) {\n\tf := setup(t)\n\tslow := f.login(t)\n\thealthy := f.login(t)\n\t// Make backpressure deterministic rather than relying on the OS default\n\t// several-megabyte TCP buffers or flooding the process with test data.\n\tslow.UnderlyingConn().(*net.TCPConn).SetReadBuffer(1024)\n\tf.g.mu.Lock()\n\tvar serverSide *client\n\tfor c := range f.g.clients {\n\t\tif c.ws.RemoteAddr().String() == slow.LocalAddr().String() {\n\t\t\tserverSide = c\n\t\t\tc.ws.UnderlyingConn().(*net.TCPConn).SetWriteBuffer(1024)\n\t\t}\n\t}\n\tf.g.mu.Unlock()\n\tif serverSide == nil {\n\t\tt.Fatal(\"connection registry\")\n\t}\n\tfor range 12 {\n\t\tsend(t, slow, \"large\", map[string]string{})\n\t}\n\tsend(t, healthy, \"sync.request\", map[string]string{})\n\tread(t, healthy, \"sync.request.result\")\n\tselect {\n\tcase <-serverSide.stop:\n\tcase <-time.After(time.Second):\n\t\tt.Fatal(\"slow reader not bounded\")\n\t}\n}\n\nfunc TestBoundedGlobalOutputBudget(t *testing.T) {\n\tf := setup(t)\n\tf.g.queuedBytes.Store(16 << 20)\n\tctx, cancel := context.WithCancel(context.Background())\n\tc := &client{g: f.g, ctx: ctx, cancel: cancel, out: make(chan outbound, 8), stop: make(chan struct{})}\n\tif c.enqueue(outbound{}) || c.code.Load() != websocket.CloseTryAgainLater {\n\t\tt.Fatal(\"global byte budget bypassed\")\n\t}\n\tif f.g.queuedBytes.Load() != 16<<20 {\n\t\tt.Fatal(\"failed enqueue retained bytes\")\n\t}\n\tf.g.queuedBytes.Store(0)\n}\n","chat/internal/socket/protocol.go":"// Package socket owns the single-instance WSS transport, never business SQL.\npackage socket\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\t\"unicode/utf8\"\n)\n\ntype frame struct {\n\tVersion   int             `json:\"protocol_version\"`\n\tRequestID string          `json:\"request_id\"`\n\tType      string          `json:\"type\"`\n\tPayload   json.RawMessage `json:\"payload\"`\n}\n\nvar requestID = regexp.MustCompile(`^[A-Za-z0-9_.:-]{1,64}$`)\n\n// JSON's duplicate keys, case aliases and replacement of unpaired surrogates\n// must not give different transports different interpretations of a command.\nfunc strict(raw []byte, target any) bool {\n\tif !utf8.Valid(raw) || !surrogates(raw) {\n\t\treturn false\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\tif !unique(d, 0) {\n\t\treturn false\n\t}\n\tif _, e := d.Token(); e != io.EOF {\n\t\treturn false\n\t}\n\td = json.NewDecoder(bytes.NewReader(raw))\n\td.DisallowUnknownFields()\n\treturn d.Decode(target) == nil\n}\nfunc unique(d *json.Decoder, depth int) bool {\n\tif depth > 12 {\n\t\treturn false\n\t}\n\tt, e := d.Token()\n\tif e != nil || t == nil {\n\t\treturn false\n\t}\n\tdelim, ok := t.(json.Delim)\n\tif !ok {\n\t\treturn true\n\t}\n\tif delim != '{' && delim != '[' {\n\t\treturn false\n\t}\n\tseen := map[string]bool{}\n\tfor d.More() {\n\t\tif delim == '{' {\n\t\t\tt, e = d.Token()\n\t\t\tk, ok := t.(string)\n\t\t\tif e != nil || !ok || seen[k] || k != strings.ToLower(k) {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tseen[k] = true\n\t\t}\n\t\tif !unique(d, depth+1) {\n\t\t\treturn false\n\t\t}\n\t}\n\tend, e := d.Token()\n\treturn e == nil && (delim == '{' && end == json.Delim('}') || delim == '[' && end == json.Delim(']'))\n}\nfunc surrogates(raw []byte) bool {\n\tfor i := 0; i < len(raw); i++ {\n\t\tif raw[i] != '\\\\' {\n\t\t\tcontinue\n\t\t}\n\t\ti++\n\t\tif i >= len(raw) {\n\t\t\treturn false\n\t\t}\n\t\tif raw[i] != 'u' {\n\t\t\tcontinue\n\t\t}\n\t\tif i+4 >= len(raw) {\n\t\t\treturn false\n\t\t}\n\t\tn, e := strconv.ParseUint(string(raw[i+1:i+5]), 16, 16)\n\t\tif e != nil {\n\t\t\treturn false\n\t\t}\n\t\ti += 4\n\t\tif n >= 0xdc00 && n <= 0xdfff {\n\t\t\treturn false\n\t\t}\n\t\tif n >= 0xd800 && n <= 0xdbff {\n\t\t\tif i+6 >= len(raw) || raw[i+1] != '\\\\' || raw[i+2] != 'u' {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\tn, e = strconv.ParseUint(string(raw[i+3:i+7]), 16, 16)\n\t\t\tif e != nil || n < 0xdc00 || n > 0xdfff {\n\t\t\t\treturn false\n\t\t\t}\n\t\t\ti += 6\n\t\t}\n\t}\n\treturn true\n}\nfunc decode(raw []byte) (frame, bool) {\n\tvar f frame\n\tok := strict(raw, &f) && len(bytes.TrimSpace(raw)) > 0 && bytes.TrimSpace(raw)[0] == '{' && f.Version == 1 && requestID.MatchString(f.RequestID) && len(f.Type) <= 64 && len(f.Payload) > 0 && f.Payload[0] == '{'\n\treturn f, ok\n}\n","chat/internal/socket/realtime.go":"package socket\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\ntype liveEvent struct {\n\tmessage ports.CommittedMessage\n\tkind    string\n\tsource  *client\n\tuntil   time.Time\n}\ntype realtime struct {\n\tpolicy  ports.RealtimePolicy\n\tevents  chan liveEvent\n\tstop    chan struct{}\n\tonce    sync.Once\n\tworkers sync.WaitGroup\n\tctx     context.Context\n\tcancel  context.CancelFunc\n}\n\nfunc NewWithPolicy(identity *auth.Service, commands Commands, policy ports.RealtimePolicy) (*Gateway, error) {\n\tif policy == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tg, e := New(identity, commands)\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tg.realtime = &realtime{policy: policy, events: make(chan liveEvent, 64), stop: make(chan struct{})}\n\tg.realtime.ctx, g.realtime.cancel = context.WithCancel(context.Background())\n\tfor range 2 {\n\t\tg.realtime.workers.Add(1)\n\t\tgo func() { defer g.realtime.workers.Done(); g.deliver() }()\n\t}\n\treturn g, nil\n}\n\n// Called only AFTER MySQL COMMIT. Admission is bounded and performs no I/O.\n// A lost wakeup is recovered by account reconciliation and both opaque cursors.\nfunc (g *Gateway) Changed(m ports.CommittedMessage) {\n    g.offer(liveEvent{message:m,kind:\"message.changed\"})\n}\nfunc (g *Gateway) Committed(m ports.CommittedMessage) {\n\tg.offer(liveEvent{message: m, kind: \"message.new\"})\n}\nfunc (g *Gateway) offer(e liveEvent) {\n\tif g.realtime == nil {\n\t\treturn\n\t}\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tif g.stopping {\n\t\treturn\n\t}\n\tselect {\n\tcase g.realtime.events <- e:\n\tdefault:\n\t}\n}\nfunc (g *Gateway) connections() []*client {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tlist := make([]*client, 0, len(g.clients))\n\tfor c := range g.clients {\n\t\tif c.epoch.Load() > 0 {\n\t\t\tlist = append(list, c)\n\t\t}\n\t}\n\treturn list\n}\nfunc (g *Gateway) deliver() {\n\tfor {\n\t\tselect {\n\t\tcase <-g.realtime.stop:\n\t\t\treturn\n\t\tcase event := <-g.realtime.events:\n\t\t\troot := g.realtime.ctx\n\t\t\tif root == nil {\n\t\t\t\troot = context.Background()\n\t\t\t}\n\t\t\tctx, cancel := context.WithTimeout(root, 2*time.Second)\n\t\t\tids, e := g.realtime.policy.MemberCandidates(ctx, event.message.ConversationID)\n\t\t\tcancel()\n\t\t\tif e != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tcandidates := map[ports.ID]bool{}\n\t\t\tfor _, id := range ids {\n\t\t\t\tcandidates[id] = true\n\t\t\t}\n\t\t\tfor _, c := range g.connections() {\n\t\t\t\tif c.kind != \"mini\" || !candidates[c.actor] || !c.foreground.Load() {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif event.kind == \"presence.changed\" {\n\t\t\t\t\tc.stateMu.Lock()\n\t\t\t\t\tfocused := c.active == event.message.ConversationID\n\t\t\t\t\tc.stateMu.Unlock()\n\t\t\t\t\tif !focused {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif event.source != nil {\n\t\t\t\t\tc.stateMu.Lock()\n\t\t\t\t\tfocused := c.active == event.message.ConversationID\n\t\t\t\t\tc.stateMu.Unlock()\n\t\t\t\t\tif !focused || c.actor == event.source.actor {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tpayload := map[string]any{\"conversation_id\": event.message.ConversationID}\n\t\t\t\tif event.kind == \"message.new\" {\n\t\t\t\t\tpayload[\"highest_seq\"] = event.message.Seq\n\t\t\t\t\tpayload[\"policy_version\"] = event.message.PolicyVersion\n\t\t\t\t}\n\t\t\t\tif event.source != nil {\n\t\t\t\t\tpayload[\"actor_id\"] = event.source.actor\n\t\t\t\t\tpayload[\"expires_at\"] = event.until.UnixMilli()\n\t\t\t\t}\n\t\t\t\tc.live(frame{RequestID: \"server\"}, event.kind, payload, event.message.ConversationID, event.source, event.until)\n\t\t\t\tif event.kind == \"message.new\" || event.kind==\"message.changed\" {\n\t\t\t\t\tc.live(frame{RequestID: \"server\"}, \"account.summary.changed\", map[string]bool{\"reconcile\": true}, event.message.ConversationID, nil, time.Time{})\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\nfunc (c *client) live(f frame, typ string, payload any, id ports.ID, source *client, until time.Time) bool {\n\traw, e := json.Marshal(payload)\n\tif e != nil {\n\t\treturn false\n\t}\n\treturn c.enqueue(outbound{frame: frame{1, f.RequestID, typ, raw}, protected: true, epoch: c.epoch.Load(), conversation: id, typingSource: source, typingUntil: until})\n}\nfunc (c *client) clearTransient() {\n\tc.stateMu.Lock()\n\tprevious := c.active\n\tc.active = \"\"\n\tc.typingUntil = time.Time{}\n\tc.stateMu.Unlock()\n\tif previous != \"\" {\n\t\tc.g.offer(liveEvent{message: ports.CommittedMessage{ConversationID: previous}, kind: \"presence.changed\"})\n\t}\n}\nfunc (c *client) canType(id ports.ID, until time.Time) bool {\n\tselect {\n\tcase <-c.stop:\n\t\treturn false\n\tdefault:\n\t}\n\tif !c.foreground.Load() || time.Now().Unix() >= c.expires.Load() {\n\t\treturn false\n\t}\n\tc.stateMu.Lock()\n\tvalid := c.active == id && c.typingUntil.Equal(until) && (until.IsZero() || time.Now().Before(until))\n\tc.stateMu.Unlock()\n\tif !valid {\n\t\treturn false\n\t}\n\tclaims, e := c.current()\n\tif e != nil {\n\t\treturn false\n\t}\n\tctx, cancel := context.WithTimeout(c.ctx, c.g.timing.operation)\n\tdefer cancel()\n\taction := \"send\"\n\tif until.IsZero() {\n\t\taction = \"read\"\n\t}\n\t_, e = c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(claims), ConversationID: id, Action: action})\n\treturn e == nil\n}\nfunc (c *client) transient(ctx context.Context, claims auth.Claims, f frame) (bool, bool) {\n\tswitch f.Type {\n\tcase \"conversation.focus\", \"presence.query\", \"typing.start\", \"typing.stop\":\n\tdefault:\n\t\treturn false, false\n\t}\n\tfail := func(code string) (bool, bool) {\n\t\treturn true, c.send(f, \"error\", map[string]any{\"code\": code, \"retryable\": false}, false)\n\t}\n\tif c.g.realtime == nil {\n\t\treturn fail(\"CHAT_REALTIME_NOT_READY\")\n\t}\n\tvar q struct {\n\t\tConversationID ports.ID `json:\"conversation_id\"`\n\t}\n\tif !strict(f.Payload, &q) || !q.ConversationID.Valid() {\n\t\treturn fail(\"CHAT_INVALID_REQUEST\")\n\t}\n\tif f.Type == \"conversation.focus\" && q.ConversationID == \"0\" {\n\t\tc.clearTransient()\n\t\treturn true, c.send(f, \"conversation.focus.result\", q, true)\n\t}\n\taction := \"read\"\n\tif f.Type == \"typing.start\" {\n\t\taction = \"send\"\n\t}\n\tif _, e := c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(claims), ConversationID: q.ConversationID, Action: action}); e != nil {\n\t\treturn fail(\"CHAT_PERMISSION_DENIED\")\n\t}\n\tswitch f.Type {\n\tcase \"conversation.focus\":\n\t\tc.clearTransient()\n\t\tc.stateMu.Lock()\n\t\tc.active = q.ConversationID\n\t\tc.stateMu.Unlock()\n\t\tc.g.offer(liveEvent{message: ports.CommittedMessage{ConversationID: q.ConversationID}, kind: \"presence.changed\"})\n\t\treturn true, c.live(f, \"conversation.focus.result\", q, q.ConversationID, nil, time.Time{})\n\tcase \"presence.query\":\n\t\tc.stateMu.Lock()\n\t\tif time.Since(c.presenceAt) < time.Second {\n\t\t\tc.stateMu.Unlock()\n\t\t\treturn fail(\"CHAT_RESOURCE_BUSY\")\n\t\t}\n\t\tc.presenceAt = time.Now()\n\t\tc.stateMu.Unlock()\n\t\tids, e := c.g.realtime.policy.MemberCandidates(ctx, q.ConversationID)\n\t\tif e != nil {\n\t\t\treturn fail(\"CHAT_DEPENDENCY_UNAVAILABLE\")\n\t\t}\n\t\tcandidates := map[ports.ID]bool{}\n\t\tfor _, id := range ids {\n\t\t\tcandidates[id] = true\n\t\t}\n\t\tonline := []ports.ID{}\n\t\ttyping := []ports.ID{}\n\t\tseen := map[ports.ID]bool{}\n\t\ttypingSeen := map[ports.ID]bool{}\n\t\tfor _, other := range c.g.connections() {\n\t\t\tif ctx.Err() != nil {\n\t\t\t\treturn fail(\"CHAT_DEPENDENCY_UNAVAILABLE\")\n\t\t\t}\n\t\t\tif other.kind != \"mini\" || !candidates[other.actor] || !other.foreground.Load() {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tp, e := other.identity.Current(ctx, c.g.identity)\n\t\t\tif e != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tgrant, e := c.g.realtime.policy.Authorize(ctx, ports.PolicyRequest{Actor: principal(p), ConversationID: q.ConversationID, Action: \"read\"})\n\t\t\tif e != nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tother.heartbeatMu.Lock()\n\t\t\thealthy := time.Since(other.lastActivity) < c.g.timing.idle && (other.pongUntil.IsZero() || time.Now().Before(other.pongUntil))\n\t\t\tother.heartbeatMu.Unlock()\n\t\t\tif !healthy {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif !seen[other.actor] {\n\t\t\t\tseen[other.actor] = true\n\t\t\t\tonline = append(online, other.actor)\n\t\t\t}\n\t\t\tother.stateMu.Lock()\n\t\t\tactive, until := other.active, other.typingUntil\n\t\t\tother.stateMu.Unlock()\n\t\t\tif active == q.ConversationID && time.Now().Before(until) && grant.CanSend && !typingSeen[other.actor] {\n\t\t\t\ttypingSeen[other.actor] = true\n\t\t\t\ttyping = append(typing, other.actor)\n\t\t\t}\n\t\t}\n\t\treturn true, c.live(f, \"presence.snapshot\", map[string]any{\"conversation_id\": q.ConversationID, \"online_actor_ids\": online, \"typing_actor_ids\": typing, \"ttl_seconds\": 6}, q.ConversationID, nil, time.Time{})\n\tcase \"typing.start\", \"typing.stop\":\n\t\tif !c.foreground.Load() {\n\t\t\treturn fail(\"CHAT_PERMISSION_DENIED\")\n\t\t}\n\t\tc.stateMu.Lock()\n\t\tif c.active != q.ConversationID {\n\t\t\tc.stateMu.Unlock()\n\t\t\treturn fail(\"CHAT_PERMISSION_DENIED\")\n\t\t}\n\t\tnow := time.Now()\n\t\tif f.Type == \"typing.start\" {\n\t\t\tif now.Sub(c.typingAt) < 2*time.Second {\n\t\t\t\tc.stateMu.Unlock()\n\t\t\t\treturn true, c.send(f, \"typing.result\", map[string]bool{\"throttled\": true}, true)\n\t\t\t}\n\t\t\tc.typingAt = now\n\t\t\tc.typingUntil = now.Add(6 * time.Second)\n\t\t} else {\n\t\t\tc.typingUntil = time.Time{}\n\t\t}\n\t\tuntil := c.typingUntil\n\t\tc.stateMu.Unlock()\n\t\t// Stop is best-effort; no stale start may pass the writer's source check.\n\t\tif f.Type == \"typing.start\" || f.Type == \"typing.stop\" {\n\t\t\tc.g.offer(liveEvent{message: ports.CommittedMessage{ConversationID: q.ConversationID}, kind: f.Type, source: c, until: until})\n\t\t}\n\t\treturn true, c.live(f, \"typing.result\", map[string]bool{\"active\": f.Type == \"typing.start\"}, q.ConversationID, nil, time.Time{})\n\t}\n\treturn false, false\n}\n","chat/internal/socket/realtime_test.go":"package socket\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc readLive(t *testing.T, c interface {\n\tSetReadDeadline(time.Time) error\n\tReadJSON(any) error\n}, typ string) frame {\n\tt.Helper()\n\t_ = c.SetReadDeadline(time.Now().Add(time.Second))\n\tfor {\n\t\tvar f frame\n\t\tif e := c.ReadJSON(&f); e != nil {\n\t\t\tt.Fatal(e)\n\t\t}\n\t\tif f.RequestID == \"server\" && f.Type == \"presence.changed\" {\n\t\t\tcontinue\n\t\t}\n\t\tif f.Type != typ {\n\t\t\tt.Fatalf(\"got %s want %s\", f.Type, typ)\n\t\t}\n\t\treturn f\n\t}\n}\n\ntype livePolicy struct {\n\tdeny  atomic.Bool\n\tcalls atomic.Int64\n}\n\nfunc (p *livePolicy) Authorize(context.Context, ports.PolicyRequest) (ports.Grant, error) {\n\tp.calls.Add(1)\n\tif p.deny.Load() {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\treturn ports.Grant{CanRead: true, CanSend: true, Version: \"1\"}, nil\n}\nfunc (p *livePolicy) MemberCandidates(context.Context, ports.ID) ([]ports.ID, error) {\n\treturn []ports.ID{\"18446744073709551615\"}, nil\n}\nfunc liveSetup(t *testing.T) (*fixture, *livePolicy) {\n\tf := setup(t)\n\tp := &livePolicy{}\n\tf.g.realtime = &realtime{policy: p, events: make(chan liveEvent, 64), stop: make(chan struct{})}\n\tf.g.realtime.workers.Add(1)\n\tgo func() { defer f.g.realtime.workers.Done(); f.g.deliver() }()\n\treturn f, p\n}\nfunc TestS11CommittedHintContainsNoMessageBody(t *testing.T) {\n\tf, p := liveSetup(t)\n\tc := f.login(t)\n\tf.g.Committed(ports.CommittedMessage{ConversationID: \"77\", Seq: \"103\", PolicyVersion: \"1\"})\n\tc.SetReadDeadline(time.Now().Add(time.Second))\n\tvar event frame\n\tif e := c.ReadJSON(&event); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif event.Type != \"message.new\" || event.RequestID != \"server\" {\n\t\tt.Fatal(event.Type)\n\t}\n\tvar payload map[string]any\n\tjson.Unmarshal(event.Payload, &payload)\n\tif len(payload) != 3 || payload[\"highest_seq\"] != \"103\" || payload[\"text\"] != nil {\n\t\tt.Fatal(payload)\n\t}\n\tif e := c.ReadJSON(&event); e != nil || event.Type != \"account.summary.changed\" {\n\t\tt.Fatal(\"account wakeup\", e)\n\t}\n\tif p.calls.Load() < 2 {\n\t\tt.Fatal(\"output did not reauthorize\")\n\t}\n}\nfunc TestS11WriterDropsQueuedHintAfterMembershipLoss(t *testing.T) {\n\tf, p := liveSetup(t)\n\tc := f.login(t)\n\tp.deny.Store(true)\n\tf.g.Committed(ports.CommittedMessage{ConversationID: \"77\", Seq: \"1\", PolicyVersion: \"1\"})\n\t// Ordered application response can pass, but no unauthorized hint may pass.\n\tsend(t, c, \"ping\", map[string]string{\"nonce\": \"barrier\"})\n\tread(t, c, \"pong\")\n\ttime.Sleep(45 * time.Millisecond)\n\tsend(t, c, \"ping\", map[string]string{\"nonce\": \"barrier2\"})\n\tread(t, c, \"pong\")\n}\nfunc TestS11PresenceBackgroundAndTypingThrottle(t *testing.T) {\n\tf, _ := liveSetup(t)\n\tc := f.login(t)\n\tsend(t, c, \"conversation.focus\", map[string]string{\"conversation_id\": \"77\"})\n\treadLive(t, c, \"conversation.focus.result\")\n\tsend(t, c, \"typing.start\", map[string]string{\"conversation_id\": \"77\"})\n\treadLive(t, c, \"typing.result\")\n\tsend(t, c, \"typing.start\", map[string]string{\"conversation_id\": \"77\"})\n\tr := readLive(t, c, \"typing.result\")\n\tvar throttled map[string]bool\n\tjson.Unmarshal(r.Payload, &throttled)\n\tif !throttled[\"throttled\"] {\n\t\tt.Fatal(\"typing not throttled\")\n\t}\n\tsend(t, c, \"presence.query\", map[string]string{\"conversation_id\": \"77\"})\n\tr = readLive(t, c, \"presence.snapshot\")\n\tvar snapshot struct {\n\t\tOnline []ports.ID `json:\"online_actor_ids\"`\n\t\tTyping []ports.ID `json:\"typing_actor_ids\"`\n\t}\n\tjson.Unmarshal(r.Payload, &snapshot)\n\tif len(snapshot.Online) != 1 || len(snapshot.Typing) != 1 {\n\t\tt.Fatal(\"live snapshot\")\n\t}\n\tsend(t, c, \"session.state\", map[string]string{\"state\": \"background\"})\n\treadLive(t, c, \"session.state\")\n\t// Background sockets cannot publish ephemeral activity. The ordinary state\n\t// acknowledgement remains allowed so the client can complete its transition.\n\tsend(t, c, \"typing.start\", map[string]string{\"conversation_id\": \"77\"})\n\treadLive(t, c, \"error\")\n}\nfunc TestS11CommitQueueNeverBlocksAndDoesNotGrow(t *testing.T) {\n\tf := setup(t)\n\tf.g.realtime = &realtime{policy: &livePolicy{}, events: make(chan liveEvent, 64), stop: make(chan struct{})}\n\tfor range 10000 {\n\t\tf.g.Committed(ports.CommittedMessage{ConversationID: \"1\", Seq: \"1\", PolicyVersion: \"1\"})\n\t}\n\tif len(f.g.realtime.events) != 64 {\n\t\tt.Fatal(\"unbounded event queue\")\n\t}\n}\n","chat/scripts/verify-s09.sh":"#!/usr/bin/env bash\n# S09 acceptance only. No production database, no deployment, no schema\n# writes outside explicitly isolated random test databases.\nset -euo pipefail\n\nfail() { printf 'CHAT_S09_VERIFY_BLOCKED: %s\\n' \"$1\" >&2; exit 1; }\nroot=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\ncd \"$root\"\n\n[[ \"${CHAT_AUTH_TEST_INTEGRATION:-}\" == \"1\" ]] || fail \"isolated integration switch must be exactly 1\"\n[[ \"${CHAT_INTEGRATION_MYSQL_ADDR:-}\" =~ ^127\\.0\\.0\\.1:[0-9]+$ ]] || fail \"MySQL must be explicitly loopback only\"\n[[ \"${CHAT_INTEGRATION_REDIS_ADDR:-}\" =~ ^127\\.0\\.0\\.1:[0-9]+$ ]] || fail \"Redis must be explicitly loopback only\"\n[[ \"${CHAT_AUTH_TEST_REDIS_ADDRESS:-}\" =~ ^127\\.0\\.0\\.1:[0-9]+$ ]] || fail \"Redis identity integration address must be loopback only\"\n[[ -n \"${CHAT_INTEGRATION_ADMIN_PASSWORD:-}\" ]] || fail \"explicit isolated MySQL fixture administrator credential missing\"\n[[ -n \"${CHAT_AUTH_TEST_PHP:-}\" && -x \"${CHAT_AUTH_TEST_PHP:-/nonexistent}\" ]] || fail \"explicit PHP binary path required\"\n[[ \"${CHAT_AUTH_TEST_MYSQL_USER_HOST:-}\" == \"127.0.0.1\" || \"${CHAT_AUTH_TEST_MYSQL_USER_HOST:-}\" == \"%\" ]] || fail \"isolated SQL fixture user host not allowed\"\n\n[[ \"$(go version)\" =~ ^go[[:space:]]version[[:space:]]go1\\.27\\.3[[:space:]] ]] || fail \"requires exact Go 1.27.3\"\n[[ \"$(\"$CHAT_AUTH_TEST_PHP\" -r 'echo PHP_VERSION;')\" == \"8.3.36\" ]] || fail \"requires exact PHP 8.3.36\"\n\n# Root privileges are restricted to ephemeral, randomly named test databases.\n# Never interpolate the database address into SQL; parse its numeric port.\nmysql_port=\"${CHAT_INTEGRATION_MYSQL_ADDR##*:}\"\nCHAT_S09_FIXTURE_PORT=\"$mysql_port\" \"$CHAT_AUTH_TEST_PHP\" -r '\n  $port = (int) getenv(\"CHAT_S09_FIXTURE_PORT\");\n  $db = new PDO(\"mysql:host=127.0.0.1;port=\".$port.\";charset=utf8mb4\",\n                \"root\", (string)getenv(\"CHAT_INTEGRATION_ADMIN_PASSWORD\"),\n                [PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);\n  $version = (string)$db->query(\"SELECT VERSION()\")->fetchColumn();\n  if (!preg_match(\"/^5\\\\.7\\\\.44(?:[-.].*)?$/D\", $version)) {\n    fwrite(STDERR, \"CHAT_S09_VERIFY_BLOCKED: exact MySQL 5.7.44 required\\n\");\n    exit(1);\n  }\n  echo \"Isolated MySQL 5.7.44 verified\\n\";\n'\n\necho 'S09: PHP contracts, upgrade checks and ephemeral MySQL fixtures'\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_schema_contract.php\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_identity_contract.php\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_policy_contract.php\n\"$CHAT_AUTH_TEST_PHP\" server/tests/chat_text_security_contract.php\n\necho 'S09: Go module integrity, vet, compile and race-tested integration'\n(\n  cd chat\n  export GOTOOLCHAIN=local\n  go mod verify\n  go vet ./...\n  bash build.sh\n  go test -race -count=1 ./...\n)\necho 'CHAT_S09_ACCEPTANCE_PASSED (only for the exact checked-out revision)'\n","chat/scripts/verify-s10.sh":"#!/usr/bin/env bash\n# Same isolated PHP/MySQL/Redis/version gates and full S01-S09 regression suite;\n# go test ./... additionally runs real S10 WSS/HTTP equivalence and lifecycle.\nset -euo pipefail\nroot=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nbash \"$root/chat/scripts/verify-s09.sh\"\necho 'CHAT_S10_ACCEPTANCE_PASSED (only for the exact checked-out revision)'\n","chat/scripts/verify-s11.sh":"#!/usr/bin/env bash\n# The existing strict isolated PHP/MySQL/Redis gates remain authoritative.\nset -euo pipefail\nroot=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nbash \"$root/chat/scripts/verify-s10.sh\"\ncd \"$root\"\nnode --test tools/test_chat_s11.js\necho 'CHAT_S11_ACCEPTANCE_PASSED (only for the exact checked-out revision)'\n","server/database/database.sql":"-- V2.2.9 complete install baseline.\n-- Generated by importing the prior complete baseline and idempotently converging through current 2.2.9.sql on MySQL 5.7.44.\n-- Source of truth for evolution remains database/upgrades/*.sql; this file is the consolidated fresh-install result.\n\n/*!40101 SET @OLD_CHARACTER_SET_CLIENT=@@CHARACTER_SET_CLIENT */;\n/*!40101 SET @OLD_CHARACTER_SET_RESULTS=@@CHARACTER_SET_RESULTS */;\n/*!40101 SET @OLD_COLLATION_CONNECTION=@@COLLATION_CONNECTION */;\n/*!40101 SET NAMES utf8mb4 */;\n/*!40103 SET @OLD_TIME_ZONE=@@TIME_ZONE */;\n/*!40103 SET TIME_ZONE='+00:00' */;\n/*!40014 SET @OLD_UNIQUE_CHECKS=@@UNIQUE_CHECKS, UNIQUE_CHECKS=0 */;\n/*!40014 SET @OLD_FOREIGN_KEY_CHECKS=@@FOREIGN_KEY_CHECKS, FOREIGN_KEY_CHECKS=0 */;\n/*!40101 SET @OLD_SQL_MODE=@@SQL_MODE, SQL_MODE='NO_AUTO_VALUE_ON_ZERO' */;\n/*!40111 SET @OLD_SQL_NOTES=@@SQL_NOTES, SQL_NOTES=0 */;\nDROP TABLE IF EXISTS `admin_users`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `admin_users` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `username` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '登录账号',\n  `password_hash` varchar(255) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '密码哈希',\n  `real_name` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '真实姓名',\n  `role` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'operator' COMMENT '角色',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'active' COMMENT '状态',\n  `must_change_password` tinyint(3) unsigned NOT NULL DEFAULT '1' COMMENT '是否必须修改密码',\n  `failed_attempts` int(10) unsigned NOT NULL DEFAULT '0' COMMENT '登录失败次数',\n  `locked_until` datetime DEFAULT NULL COMMENT '锁定截止时间',\n  `last_login_at` datetime DEFAULT NULL COMMENT '最后登录时间',\n  `last_login_ip` varchar(45) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL COMMENT '最后登录IP',\n  `password_changed_at` datetime DEFAULT NULL COMMENT '密码修改时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_admin_users_username` (`username`),\n  KEY `idx_admin_users_status_role` (`status`,`role`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：后台管理员账号';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `admin_users` WRITE;\n/*!40000 ALTER TABLE `admin_users` DISABLE KEYS */;\n/*!40000 ALTER TABLE `admin_users` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `after_sales`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `after_sales` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `public_no` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '业务编号',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `user_id` bigint(20) unsigned NOT NULL COMMENT '用户ID',\n  `type` varchar(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT '类型',\n  `description` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '描述',\n  `warranty_months_snapshot` smallint(5) unsigned DEFAULT NULL COMMENT '保修月数快照',\n  `warranty_expires_at_snapshot` datetime DEFAULT NULL COMMENT '保修到期时间快照',\n  `non_human_confirmed` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT '是否确认非人为原因',\n  `evidence_media_ids_json` longtext COLLATE utf8mb4_unicode_ci COMMENT '证据媒体ID列表JSON',\n  `status` varchar(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'open' COMMENT '状态',\n  `handled_by` bigint(20) unsigned DEFAULT NULL COMMENT '处理管理员ID',\n  `resolution` text COLLATE utf8mb4_unicode_ci COMMENT '处理结果',\n  `opened_at` datetime NOT NULL COMMENT '开启时间',\n  `closed_at` datetime DEFAULT NULL COMMENT '关闭时间',\n  `created_at` datetime NOT NULL COMMENT '创建时间',\n  `updated_at` datetime NOT NULL COMMENT '更新时间',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_after_sales_public_no` (`public_no`),\n  KEY `idx_after_sales_order_status` (`order_id`,`status`),\n  KEY `fk_after_sales_user` (`user_id`),\n  KEY `fk_after_sales_admin` (`handled_by`),\n  CONSTRAINT `fk_after_sales_admin` FOREIGN KEY (`handled_by`) REFERENCES `admin_users` (`id`) ON DELETE SET NULL ON UPDATE CASCADE,\n  CONSTRAINT `fk_after_sales_order` FOREIGN KEY (`order_id`) REFERENCES `orders` (`id`) ON UPDATE CASCADE,\n  CONSTRAINT `fk_after_sales_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON UPDATE CASCADE\n) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='2026-08-14：订单售后';\n/*!40101 SET character_set_client = @saved_cs_client */;\n\nLOCK TABLES `after_sales` WRITE;\n/*!40000 ALTER TABLE `after_sales` DISABLE KEYS */;\n/*!40000 ALTER TABLE `after_sales` ENABLE KEYS */;\nUNLOCK TABLES;\nDROP TABLE IF EXISTS `appointment_records`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n/*!40101 SET character_set_client = utf8 */;\nCREATE TABLE `appointment_records` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '自增ID',\n  `order_id` bigint(20) unsigned NOT NULL COMMENT '订单ID',\n  `worker_id` bigint(20) unsigned NOT NULL COMMENT '师傅ID',\n  `appointment_at` datetime DEFAULT NULL COMMENT '预约时间',\n  `note` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '备注',\n  `