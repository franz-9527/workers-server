`assignments` WHERE `order_id`=@demo_order_done LIMIT 1);\nSET @demo_assignment_invite=(SELECT `id` FROM `assignments` WHERE `order_id`=@demo_order_invite LIMIT 1);\nUPDATE `orders` SET `selected_quote_id`=@demo_quote_pay WHERE `id`=@demo_order_pay;\nUPDATE `orders` SET `selected_quote_id`=@demo_quote_build,`current_assignment_id`=@demo_assignment_build,`commission_rule_version_id`=@demo_rule_build WHERE `id`=@demo_order_build_id;\nUPDATE `orders` SET `selected_quote_id`=@demo_quote_complete,`current_assignment_id`=@demo_assignment_complete,`commission_rule_version_id`=@demo_rule_complete WHERE `id`=@demo_order_complete;\nUPDATE `orders` SET `selected_quote_id`=@demo_quote_done,`current_assignment_id`=@demo_assignment_done,`commission_rule_version_id`=@demo_rule_done WHERE `id`=@demo_order_done;\nUPDATE `orders` SET `selected_quote_id`=@demo_quote_invite,`current_assignment_id`=@demo_assignment_invite,`commission_rule_version_id`=@demo_rule_invite WHERE `id`=@demo_order_invite;\n\nINSERT INTO `appointment_records` (`order_id`,`worker_id`,`appointment_at`,`note`,`status`,`created_at`,`updated_at`) VALUES (@demo_order_build_id,@demo_worker_id,UTC_TIMESTAMP()+INTERVAL 1 DAY,'师傅电话预约，无需用户确认。','recorded',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\nINSERT INTO `offline_payment_delay_requests` (`order_id`,`worker_id`,`amount_cents_snapshot`,`reason`,`expected_collect_at`,`status`,`submitted_at`,`created_at`,`updated_at`) VALUES (@demo_order_build_id,@demo_worker_id,115000,'业主约定三天后支付线下尾款（演示）',UTC_TIMESTAMP()+INTERVAL 3 DAY,'pending',UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP());\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES\n(@demo_order_complete,@demo_worker_id,'已完工，等待用户或系统验收。','submitted',UTC_TIMESTAMP()-INTERVAL 20 HOUR,NULL,NULL,1,UTC_TIMESTAMP()-INTERVAL 20 HOUR,UTC_TIMESTAMP()),\n(@demo_order_done,@demo_worker_id,'已完工并自动验收。','accepted',UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,'auto',1,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP());\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`created_at`,`updated_at`) VALUES ('COM-DEMO-DONE-105',@demo_order_done,@demo_worker_id,@demo_assignment_done,@demo_rule_done,100000,5000,1000,5000,10000,5000,5000,0,'overdue',UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`succeeded_at`,`created_at`,`updated_at`) VALUES\n('REF-DEMO-PENDING-102',@demo_pay_refund_pending,@demo_order_refund_pending_id,2500,'预约费部分退款 25.00 元，演示自定义退款金额','pending_review',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 1 HOUR,NULL,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()),\n('REF-DEMO-DONE-105',@demo_pay_refund_done,@demo_order_refund_done,5000,'未上门取消全额退款演示','succeeded',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP());\nINSERT INTO `disputes` (`public_no`,`order_id`,`raised_by_type`,`raised_by_id`,`dispute_type`,`title`,`description`,`status`,`responsibility`,`refund_amount_cents`,`run_empty_fee_cents`,`opened_at`,`created_at`,`updated_at`) VALUES ('DSP-DEMO-OPEN-105',@demo_order_build_id,'worker',@demo_worker_id,'change_rejected','加价协商未达成（待处理演示）','用户拒绝加价，双方协商未果，等待管理员裁定。','open','undetermined',0,0,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP());\n\nINSERT INTO `media_files` (`public_id`,`storage_disk`,`storage_key`,`mime_type`,`extension`,`size_bytes`,`width_px`,`height_px`,`sha256`,`compression_quality`,`status`,`reference_count`,`created_at`) VALUES\n(LEFT(SHA2('demo-material-102',256),26),'private_local','uploads/demo/order-material.png','image/png','png',181195,750,270,'52c6f8f13731acad90f77da0310c7b32a320580094f28817ac9d2842fb7f1874',80,'active',2,UTC_TIMESTAMP()),\n(LEFT(SHA2('demo-wall-102',256),26),'private_local','uploads/demo/order-wall.png','image/png','png',62655,500,400,'8190a8bb9b71229f241af3fef50ce702bc05f613a1bb7fb78d2e77fcaa586fb3',80,'active',1,UTC_TIMESTAMP()),\n(LEFT(SHA2('demo-completion-102',256),26),'private_local','uploads/demo/order-completion.png','image/png','png',18844,200,200,'30e0a1e015bcf26f8d0efff252679ad62449f099f649ce0662e5094f0be37137',80,'active',3,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `status`='active',`reference_count`=VALUES(`reference_count`);\nSET @demo_media_material=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-material.png' LIMIT 1);\nSET @demo_media_wall=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-wall.png' LIMIT 1);\nSET @demo_media_completion=(SELECT `id` FROM `media_files` WHERE `storage_key`='uploads/demo/order-completion.png' LIMIT 1);\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`) VALUES\n(@demo_media_material,'order',@demo_order_hall_id,'product',10,'system',NULL,UTC_TIMESTAMP()),\n(@demo_media_wall,'order',@demo_order_hall_id,'wall',20,'system',NULL,UTC_TIMESTAMP()),\n(@demo_media_completion,'order',@demo_order_complete,'completion',10,'system',NULL,UTC_TIMESTAMP()),\n(@demo_media_completion,'order',@demo_order_done,'completion',10,'system',NULL,UTC_TIMESTAMP());\nINSERT INTO `reviews` (`public_id`,`order_id`,`user_id`,`worker_id`,`rating`,`content`,`is_auto`,`status`,`reviewed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('demo-review-done-105',256),26),@demo_order_done,@demo_customer_id,@demo_worker_id,5,'施工认真，沟通顺畅，附完工图片（演示评价）。',0,'visible',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @demo_review_id=(SELECT `id` FROM `reviews` WHERE `order_id`=@demo_order_done LIMIT 1);\nINSERT INTO `review_media` (`review_id`,`media_file_id`,`sort_order`,`created_at`) VALUES (@demo_review_id,@demo_media_completion,10,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO `rating_summaries` (`worker_id`,`review_count`,`rating_sum`,`rating_average`,`five_star_count`,`updated_at`) VALUES (@demo_worker_id,1,5,5.00,1,UTC_TIMESTAMP());\n\nINSERT INTO `invite_tokens` (`order_id`,`token_hash`,`purpose`,`created_by_admin_id`,`claimed_by_user_id`,`claimed_worker_id`,`commission_rule_version_id`,`status`,`max_claims`,`claim_count`,`expires_at`,`claimed_at`,`created_at`) VALUES\n(@demo_order_hall_id,SHA2('DEMO-ACTIVE-INVITE-105',256),'worker_assignment',@demo_admin_id,NULL,NULL,@demo_rule_hall,'active',1,0,UTC_TIMESTAMP()+INTERVAL 7 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n(@demo_order_invite,SHA2('DEMO-CLAIMED-INVITE-105',256),'worker_assignment',@demo_admin_id,@demo_pending_user_id,@demo_pending_worker_id,@demo_rule_invite,'claimed',1,1,UTC_TIMESTAMP()+INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY);\nINSERT INTO `share_contexts` (`order_id`,`context_type`,`token_hash`,`created_by_type`,`created_by_id`,`snapshot_json`,`status`,`expires_at`,`created_at`) VALUES (@demo_order_hall_id,'ordinary_order',SHA2('DEMO-ORDINARY-SHARE-105-NOT-USABLE',256),'system',NULL,'{\"share_type\":\"ordinary\",\"demo\":true}','active',UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 1 HOUR);\n\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`) VALUES\n(@demo_order_audit,'order_submitted','demo:105:audit','user',@demo_customer_id,'{\"message\":\"用户提交订单，等待管理员审核\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n(@demo_order_hall_id,'worker_quoted','demo:105:hall:worker','worker',@demo_worker_id,'{\"message\":\"师傅提交报价\"}',UTC_TIMESTAMP()-INTERVAL 20 HOUR),\n(@demo_order_hall_id,'platform_quoted','demo:105:hall:platform','admin',@demo_admin_id,'{\"message\":\"平台提交报价\"}',UTC_TIMESTAMP()-INTERVAL 18 HOUR),\n(@demo_order_pay,'quote_selected_pending_payment','demo:105:pay','user',@demo_customer_id,'{\"message\":\"用户选择报价，等待支付预约费\"}',UTC_TIMESTAMP()-INTERVAL 20 HOUR),\n(@demo_order_build_id,'appointment_recorded','demo:105:build:appointment','worker',@demo_worker_id,'{\"message\":\"师傅电话预约上门时间\"}',UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@demo_order_build_id,'offline_collection_delayed','demo:105:build:delay','worker',@demo_worker_id,'{\"message\":\"师傅登记尾款延期\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n(@demo_order_build_id,'change_rejected','demo:105:build:dispute','user',@demo_customer_id,'{\"message\":\"用户拒绝加价并申请客服介入\"}',UTC_TIMESTAMP()-INTERVAL 2 HOUR),\n(@demo_order_complete,'completion_submitted','demo:105:complete','worker',@demo_worker_id,'{\"message\":\"师傅提交完工照，等待验收\"}',UTC_TIMESTAMP()-INTERVAL 20 HOUR),\n(@demo_order_done,'auto_accepted_72h','demo:105:done:accept','system',NULL,'{\"message\":\"系统自动验收\"}',UTC_TIMESTAMP()-INTERVAL 6 DAY),\n(@demo_order_done,'review_submitted','demo:105:done:review','user',@demo_customer_id,'{\"message\":\"用户提交带图评价\"}',UTC_TIMESTAMP()-INTERVAL 5 DAY),\n(@demo_order_refund_pending_id,'cancel_requested','demo:105:refund:pending','user',@demo_customer_id,'{\"message\":\"用户申请取消，等待部分退款审核\"}',UTC_TIMESTAMP()-INTERVAL 1 HOUR),\n(@demo_order_refund_done,'refund_succeeded','demo:105:refund:done','system',NULL,'{\"message\":\"预约费退款成功\"}',UTC_TIMESTAMP()-INTERVAL 3 DAY),\n(@demo_order_expired,'auto_cancelled_7d','demo:105:expired','system',NULL,'{\"message\":\"订单七天未成交自动取消\"}',UTC_TIMESTAMP()-INTERVAL 1 DAY),\n(@demo_order_invite,'invite_claimed','demo:105:invite','worker',@demo_pending_worker_id,'{\"message\":\"受邀师傅领取订单，等待确认接单\"}',UTC_TIMESTAMP()-INTERVAL 1 HOUR);\n\nINSERT INTO `worker_payout_accounts` (`worker_id`,`account_type`,`holder_name_masked`,`holder_name_ciphertext`,`account_masked`,`account_ciphertext`,`account_hmac`,`status`,`is_default`,`verified_at`,`created_at`,`updated_at`) VALUES (@demo_worker_id,'alipay','王*','DEMO_ONLY_NOT_DECRYPTABLE','139******02','DEMO_ONLY_NOT_DECRYPTABLE',SHA2('DEMO-ALIPAY-105',256),'active',1,UTC_TIMESTAMP()-INTERVAL 10 DAY,UTC_TIMESTAMP()-INTERVAL 10 DAY,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`status`='active',`updated_at`=UTC_TIMESTAMP();\nSET @demo_payout_account_id=LAST_INSERT_ID();\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@demo_worker_id,'demo_credit','credit',10000,10000,0,'demo_adjustment',1,'demo:105:credit','演示余额入账','effective',UTC_TIMESTAMP()-INTERVAL 10 DAY);\nSET @demo_credit_ledger_id=LAST_INSERT_ID();\nINSERT INTO `withdrawal_requests` (`public_no`,`worker_id`,`payout_account_id`,`amount_cents`,`account_type_snapshot`,`holder_name_masked_snapshot`,`holder_name_ciphertext_snapshot`,`account_masked_snapshot`,`account_ciphertext_snapshot`,`status`,`review_note`,`submitted_at`,`reviewed_at`,`paid_at`,`created_at`,`updated_at`) VALUES ('WD-DEMO-PAID-105',@demo_worker_id,@demo_payout_account_id,5000,'alipay','王*','DEMO_ONLY_NOT_DECRYPTABLE','139******02','DEMO_ONLY_NOT_DECRYPTABLE','paid','管理员已手动打款（演示）',UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP());\nSET @demo_withdrawal_paid=LAST_INSERT_ID();\nINSERT INTO `worker_payouts` (`public_no`,`withdrawal_request_id`,`worker_id`,`amount_cents`,`channel`,`external_transaction_no`,`status`,`paid_by`,`paid_at`,`created_at`) VALUES ('PO-DEMO-PAID-105',@demo_withdrawal_paid,@demo_worker_id,5000,'alipay_manual','DEMO_ALIPAY_TX_105','paid',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 7 DAY);\nSET @demo_payout_paid=LAST_INSERT_ID();\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES\n(@demo_worker_id,'withdrawal_freeze','transfer',5000,-5000,5000,'withdrawal_request',@demo_withdrawal_paid,'demo:105:paid:freeze','演示已付款提现冻结','effective',UTC_TIMESTAMP()-INTERVAL 8 DAY),\n(@demo_worker_id,'withdrawal_paid','debit',5000,0,-5000,'worker_payout',@demo_payout_paid,'demo:105:paid:debit','演示人工支付宝付款完成','effective',UTC_TIMESTAMP()-INTERVAL 7 DAY);\nINSERT INTO `withdrawal_allocations` (`withdrawal_request_id`,`ledger_entry_id`,`amount_cents`,`created_at`) VALUES (@demo_withdrawal_paid,@demo_credit_ledger_id,5000,UTC_TIMESTAMP()-INTERVAL 8 DAY);\nINSERT INTO `withdrawal_events` (`withdrawal_request_id`,`event_type`,`from_status`,`to_status`,`note`,`operator_type`,`operator_id`,`created_at`) VALUES\n(@demo_withdrawal_paid,'submitted',NULL,'pending','师傅申请提现（演示）','worker',@demo_worker_id,UTC_TIMESTAMP()-INTERVAL 8 DAY),\n(@demo_withdrawal_paid,'paid','approved','paid','管理员已手动支付宝打款（演示）','admin',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 7 DAY);\n\n-- 2026-08-25：重建完成后继续执行下方幂等补齐，保证旧库缺少个别基础配置时仍能升级。\nSET @demo_customer_id=(SELECT id FROM users WHERE public_id='01K2DEMOUSER00000000000001' LIMIT 1);\nSET @demo_worker_id=(SELECT id FROM worker_profiles WHERE public_id='01K2DEMOWORKERPROFILE00001' LIMIT 1);\nSET @demo_pending_worker_id=(SELECT id FROM worker_profiles WHERE public_id='01K2DEMOPENDINGPROFILE001' LIMIT 1);\nSET @demo_order_hall_id=(SELECT id FROM orders WHERE public_no='WO-DEMO-HALL-8K3M2Q7X' LIMIT 1);\nSET @demo_order_build_id=(SELECT id FROM orders WHERE public_no='WO-DEMO-BUILD-102' LIMIT 1);\nSET @demo_order_refund_pending_id=(SELECT id FROM orders WHERE public_no='WO-DEMO-REFUND-PENDING-102' LIMIT 1);\nSET @demo_wallpaper_id=(SELECT id FROM service_categories WHERE category_key='wallpaper' LIMIT 1);\nSET @demo_wallcloth_id=(SELECT id FROM service_categories WHERE category_key='wall_cloth' LIMIT 1);\nSET @demo_payout_account_id=(SELECT id FROM worker_payout_accounts WHERE worker_id=@demo_worker_id ORDER BY id LIMIT 1);\n\nUPDATE orders SET is_demo=1,category_names_snapshot=category_name_snapshot WHERE public_no LIKE '%DEMO%';\n-- 2026-08-25：V1.0.5 起所有师傅/平台报价均不设置有效期，支付选择的占位时限仍由 quote_selections 单独控制。\nUPDATE quotes SET expires_at=NULL,updated_at=UTC_TIMESTAMP() WHERE expires_at IS NOT NULL;\nUPDATE orders SET category_names_snapshot='墙纸、墙布',title='墙纸与墙布组合施工（多类目演示）',updated_at=UTC_TIMESTAMP() WHERE id=@demo_order_hall_id;\nINSERT IGNORE INTO order_categories(order_id,category_id,category_name_snapshot,sort_order,created_at)\nSELECT @demo_order_hall_id,@demo_wallpaper_id,'墙纸',0,UTC_TIMESTAMP() FROM DUAL WHERE @demo_order_hall_id IS NOT NULL AND @demo_wallpaper_id IS NOT NULL;\nINSERT IGNORE INTO order_categories(order_id,category_id,category_name_snapshot,sort_order,created_at)\nSELECT @demo_order_hall_id,@demo_wallcloth_id,'墙布',1,UTC_TIMESTAMP() FROM DUAL WHERE @demo_order_hall_id IS NOT NULL AND @demo_wallcloth_id IS NOT NULL;\n\nUPDATE refunds SET amount_cents=2500,reason='预约费部分退款 25.00 元，演示自定义退款金额',status='pending_review',updated_at=UTC_TIMESTAMP() WHERE public_no='REF-DEMO-PENDING-102';\nUPDATE orders SET refund_status='pending_review',lifecycle_status='cancel_approved_pending_refund',updated_at=UTC_TIMESTAMP() WHERE id=@demo_order_refund_pending_id;\n\nINSERT INTO disputes(public_no,order_id,raised_by_type,raised_by_id,dispute_type,title,description,status,responsibility,resolution,refund_amount_cents,run_empty_fee_cents,opened_at,created_at,updated_at)\nSELECT 'DSP-DEMO-OPEN-105',@demo_order_build_id,'worker',@demo_worker_id,'change_rejected','加价协商未达成（待处理演示）','用户拒绝加价，双方协商未果，等待管理员依据沟通记录判定是否结束订单及跑空费。','open','undetermined',NULL,0,0,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_order_build_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM disputes WHERE public_no='DSP-DEMO-OPEN-105');\nUPDATE orders SET dispute_status='open',updated_at=UTC_TIMESTAMP() WHERE id=@demo_order_build_id;\n\nINSERT INTO worker_real_name_verifications(worker_id,real_name_masked,real_name_ciphertext,id_number_masked,id_number_ciphertext,id_number_hmac,status,review_reason,submitted_at,reviewed_at,created_at,updated_at)\nSELECT @demo_worker_id,'王**','DEMO_ONLY_NOT_DECRYPTABLE','330***********1234','DEMO_ONLY_NOT_DECRYPTABLE',SHA2('DEMO-ID-APPROVED-105',256),'approved','V1.0.5 已通过实名认证演示',UTC_TIMESTAMP()-INTERVAL 10 DAY,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 10 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_worker_id IS NOT NULL\nON DUPLICATE KEY UPDATE status='approved',review_reason=VALUES(review_reason),updated_at=UTC_TIMESTAMP();\nINSERT INTO worker_real_name_verifications(worker_id,real_name_masked,real_name_ciphertext,id_number_masked,id_number_ciphertext,id_number_hmac,status,review_reason,submitted_at,created_at,updated_at)\nSELECT @demo_pending_worker_id,'李**','DEMO_ONLY_NOT_DECRYPTABLE','330***********5678','DEMO_ONLY_NOT_DECRYPTABLE',SHA2('DEMO-ID-PENDING-105',256),'pending',NULL,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_pending_worker_id IS NOT NULL\nON DUPLICATE KEY UPDATE status='pending',review_reason=NULL,submitted_at=VALUES(submitted_at),updated_at=UTC_TIMESTAMP();\n\nINSERT INTO withdrawal_requests(public_no,worker_id,payout_account_id,amount_cents,account_type_snapshot,holder_name_masked_snapshot,holder_name_ciphertext_snapshot,account_masked_snapshot,account_ciphertext_snapshot,status,review_note,submitted_at,reviewed_at,created_at,updated_at)\nSELECT 'WD-DEMO-PENDING-105',@demo_worker_id,@demo_payout_account_id,100,'alipay','王*','DEMO_ONLY_NOT_DECRYPTABLE','139******02','DEMO_ONLY_NOT_DECRYPTABLE','pending','等待管理员审核的 1.00 元提现演示',UTC_TIMESTAMP()-INTERVAL 30 MINUTE,NULL,UTC_TIMESTAMP()-INTERVAL 30 MINUTE,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_worker_id IS NOT NULL AND @demo_payout_account_id IS NOT NULL\nON DUPLICATE KEY UPDATE status='pending',review_note=VALUES(review_note),reviewed_at=NULL,paid_at=NULL,updated_at=UTC_TIMESTAMP();\nINSERT INTO withdrawal_requests(public_no,worker_id,payout_account_id,amount_cents,account_type_snapshot,holder_name_masked_snapshot,holder_name_ciphertext_snapshot,account_masked_snapshot,account_ciphertext_snapshot,status,review_note,submitted_at,reviewed_at,created_at,updated_at)\nSELECT 'WD-DEMO-APPROVED-105',@demo_worker_id,@demo_payout_account_id,200,'alipay','王*','DEMO_ONLY_NOT_DECRYPTABLE','139******02','DEMO_ONLY_NOT_DECRYPTABLE','approved','已审核，等待管理员支付宝打款',UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()\nFROM DUAL WHERE @demo_worker_id IS NOT NULL AND @demo_payout_account_id IS NOT NULL\nON DUPLICATE KEY UPDATE status='approved',review_note=VALUES(review_note),reviewed_at=VALUES(reviewed_at),paid_at=NULL,updated_at=UTC_TIMESTAMP();\nSET @demo_withdrawal_pending=(SELECT `id` FROM `withdrawal_requests` WHERE `public_no`='WD-DEMO-PENDING-105');\nSET @demo_withdrawal_approved=(SELECT `id` FROM `withdrawal_requests` WHERE `public_no`='WD-DEMO-APPROVED-105');\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES\n(@demo_worker_id,'withdrawal_freeze','transfer',100,-100,100,'withdrawal_request',@demo_withdrawal_pending,'demo:105:pending:freeze','待审核提现冻结（演示）','effective',UTC_TIMESTAMP()-INTERVAL 30 MINUTE),\n(@demo_worker_id,'withdrawal_freeze','transfer',200,-200,200,'withdrawal_request',@demo_withdrawal_approved,'demo:105:approved:freeze','已审核待付款提现冻结（演示）','effective',UTC_TIMESTAMP()-INTERVAL 2 HOUR);\nINSERT INTO `withdrawal_events` (`withdrawal_request_id`,`event_type`,`from_status`,`to_status`,`note`,`operator_type`,`operator_id`,`created_at`) VALUES\n(@demo_withdrawal_pending,'submitted',NULL,'pending','等待管理员审核（演示）','worker',@demo_worker_id,UTC_TIMESTAMP()-INTERVAL 30 MINUTE),\n(@demo_withdrawal_approved,'approved','pending','approved','管理员审核通过，等待付款（演示）','admin',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 1 HOUR);\n\nINSERT INTO share_contexts(order_id,context_type,token_hash,created_by_type,created_by_id,snapshot_json,status,expires_at,created_at)\nSELECT @demo_order_hall_id,'ordinary_order',SHA2('DEMO-ORDINARY-SHARE-105-NOT-USABLE',256),'system',NULL,'{\"share_type\":\"ordinary\",\"demo\":true}','active',UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP()-INTERVAL 1 HOUR\nFROM DUAL WHERE @demo_order_hall_id IS NOT NULL\nON DUPLICATE KEY UPDATE status='active',expires_at=VALUES(expires_at),snapshot_json=VALUES(snapshot_json);\n\nINSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,updated_by,created_at,updated_at)\nVALUES('demo.seed_version','1.0.5','string','system',0,'当前全状态演示数据版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE setting_value='1.0.5',description=VALUES(description),updated_at=UTC_TIMESTAMP();\n\nSELECT 'V1.0.5 multi-category orders, real-name verification and operations workbench upgraded' AS `migration_message`;\n","server/database/upgrades/2.0.1.sql":"-- 2026-08-25：V2.0.1 下单预付、订单分享码和运营弹窗升级。\n-- 兼容 PHP 7.4 / MySQL 5.7.44；不使用 MySQL 8 语法或重复读取临时表。\nSET NAMES utf8mb4;\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.1','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('wechat.miniapp_env_version','release','string','wechat',0,'后台生成小程序码使用的版本：release/trial/develop',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=IF(`setting_key`='app.version','2.0.1',`setting_value`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nUPDATE `system_settings` SET `description`='下单提交时在线支付的预约费金额（分）',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='order.booking_fee_cents';\nUPDATE `system_settings` SET `description`='订单公开后无报价、未接受报价或仍未匹配师傅时自动取消退款天数',`updated_at`=UTC_TIMESTAMP() WHERE `setting_key`='order.auto_cancel_days';\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('payment_orders','business_type','支付业务类型','order_booking 下单预约费、booking_fee 旧版选价预约费、commission 平台服务费',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','payment_status','预约费支付状态','下单预付预约费状态；支付成功后订单进入管理员审核',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.0.1 upfront booking payment, mini-program sharing code and modal operations upgraded' AS `migration_message`;\n","server/database/upgrades/2.0.2.sql":"-- 2026-08-26：V2.0.2 师傅服务器唯一主档、实名审核与订单权限升级。\n-- 兼容 PHP 7.4 / MySQL 5.7.44；脚本可重复执行，不修改旧云开发记录。\nSET NAMES utf8mb4;\n\nDROP PROCEDURE IF EXISTS `worker_upgrade_202_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_202_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='profile_json') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `profile_json` LONGTEXT NULL AFTER `completed_orders`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='worker_profiles' AND column_name='profile_source') THEN\n    ALTER TABLE `worker_profiles` ADD COLUMN `profile_source` VARCHAR(24) CHARACTER SET ascii COLLATE ascii_bin NOT NULL DEFAULT 'cloud' AFTER `profile_json`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_202_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_202_schema`;\n\nUPDATE `worker_profiles` SET `profile_source`=IF(`cloud_worker_id` IS NULL,'server','cloud') WHERE `profile_source`='' OR `profile_source` IS NULL;\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('worker_profiles','profile_json','师傅入驻完整资料','MySQL 唯一主档保存的安装类型、技能、报价说明和地图地址等资料',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_profiles','profile_source','师傅资料来源','server 为新版服务器唯一主档，cloud 为旧云开发兼容资料',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','real_name_ciphertext','实名姓名原文','应用层密文保存，后台审核时回显完整姓名',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('worker_real_name_verifications','id_number_ciphertext','身份证号原文','应用层密文保存，仅后台实名审核使用',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('withdrawal_requests','account_ciphertext_snapshot','支付宝账号原文快照','人工转账时后台回显完整账号',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.2','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`='2.0.2',`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.0.2 worker server profile, identity review and order permission upgraded' AS `migration_message`;\n","server/database/upgrades/2.0.3.sql":"-- 2026-08-27：V2.0.3 订单管理、履约结算、维护开关与全状态演示数据升级。\n-- 兼容 PHP 7.4 / MySQL 5.7.44；只删除 is_demo=1 或旧 WO-DEMO 标记数据，不触碰真实订单。\nSET NAMES utf8mb4;\n\n-- 2026-08-28：补齐早期管理员审核接口已经使用、但旧表结构遗漏的审核说明与审核时间字段。\nDROP PROCEDURE IF EXISTS `worker_upgrade_203_schema`;\nDELIMITER $$\nCREATE PROCEDURE `worker_upgrade_203_schema`()\nBEGIN\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='audit_note') THEN\n    ALTER TABLE `orders` ADD COLUMN `audit_note` VARCHAR(500) NULL AFTER `audit_status`;\n  END IF;\n  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='orders' AND column_name='audited_at') THEN\n    ALTER TABLE `orders` ADD COLUMN `audited_at` DATETIME NULL AFTER `audit_note`;\n  END IF;\nEND$$\nDELIMITER ;\nCALL `worker_upgrade_203_schema`();\nDROP PROCEDURE IF EXISTS `worker_upgrade_203_schema`;\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.3','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('development.pause_hall','0','boolean','development',1,'维护开关：暂停普通师傅浏览和领取新订单，管理员与进行中订单不受影响',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('development.pause_quotes','0','boolean','development',1,'维护开关：暂停师傅及平台新增或修改报价，已成交施工订单不受影响',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.seed_version','2.0.3','string','system',0,'当前全状态演示数据版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=IF(`setting_key`='app.version' OR `setting_key`='demo.seed_version',VALUES(`setting_value`),`setting_value`),`value_type`=VALUES(`value_type`),`group_name`=VALUES(`group_name`),`is_public`=VALUES(`is_public`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('orders','audit_note','订单审核说明','驳回或要求补充资料时的中文说明',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','audited_at','订单审核时间','管理员最后一次完成审核的时间',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-27：每条 DELETE 只 JOIN 临时表一次，规避 MySQL 5.7 “Can't reopen table”错误。\nDROP TEMPORARY TABLE IF EXISTS `worker_v203_demo_orders`;\nCREATE TEMPORARY TABLE `worker_v203_demo_orders` (`id` BIGINT UNSIGNED NOT NULL PRIMARY KEY) ENGINE=MEMORY;\nINSERT INTO `worker_v203_demo_orders` (`id`) SELECT `id` FROM `orders` WHERE `is_demo`=1 OR `public_no` LIKE 'WO-DEMO-%';\n\nSET @worker_v203_old_fk_checks=@@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\nDELETE rm FROM `review_media` rm JOIN `reviews` r ON r.id=rm.review_id JOIN `worker_v203_demo_orders` d ON d.id=r.order_id;\nDELETE rr FROM `review_replies` rr JOIN `reviews` r ON r.id=rr.review_id JOIN `worker_v203_demo_orders` d ON d.id=r.order_id;\nDELETE de FROM `dispute_evidence` de JOIN `disputes` ds ON ds.id=de.dispute_id JOIN `worker_v203_demo_orders` d ON d.id=ds.order_id;\nDELETE qi FROM `quote_items` qi JOIN `quote_versions` qv ON qv.id=qi.quote_version_id JOIN `quotes` q ON q.id=qv.quote_id JOIN `worker_v203_demo_orders` d ON d.id=q.order_id;\nDELETE cp FROM `commission_payments` cp JOIN `commission_receivables` cr ON cr.id=cp.receivable_id JOIN `worker_v203_demo_orders` d ON d.id=cr.order_id;\nDELETE ca FROM `commission_adjustments` ca JOIN `commission_receivables` cr ON cr.id=ca.receivable_id JOIN `worker_v203_demo_orders` d ON d.id=cr.order_id;\nDELETE pn FROM `payment_notifications` pn JOIN `payment_orders` po ON po.id=pn.payment_order_id JOIN `worker_v203_demo_orders` d ON d.id=po.order_id;\nDELETE ci FROM `change_items` ci JOIN `change_requests` cr ON cr.id=ci.change_request_id JOIN `worker_v203_demo_orders` d ON d.id=cr.order_id;\nDELETE cc FROM `change_confirmations` cc JOIN `change_requests` cr ON cr.id=cc.change_request_id JOIN `worker_v203_demo_orders` d ON d.id=cr.order_id;\nDELETE ah FROM `assignment_history` ah JOIN `worker_v203_demo_orders` d ON d.id=ah.order_id;\nDELETE ocd FROM `order_cancel_decisions` ocd JOIN `worker_v203_demo_orders` d ON d.id=ocd.order_id;\nDELETE r FROM `refunds` r JOIN `worker_v203_demo_orders` d ON d.id=r.order_id;\nDELETE cr FROM `commission_receivables` cr JOIN `worker_v203_demo_orders` d ON d.id=cr.order_id;\nDELETE rv FROM `reviews` rv JOIN `worker_v203_demo_orders` d ON d.id=rv.order_id;\nDELETE ds FROM `disputes` ds JOIN `worker_v203_demo_orders` d ON d.id=ds.order_id;\nDELETE af FROM `after_sales` af JOIN `worker_v203_demo_orders` d ON d.id=af.order_id;\nDELETE ocr FROM `order_cancel_requests` ocr JOIN `worker_v203_demo_orders` d ON d.id=ocr.order_id;\nDELETE cs FROM `completion_submissions` cs JOIN `worker_v203_demo_orders` d ON d.id=cs.order_id;\nDELETE odr FROM `offline_payment_delay_requests` odr JOIN `worker_v203_demo_orders` d ON d.id=odr.order_id;\nDELETE cr FROM `change_requests` cr JOIN `worker_v203_demo_orders` d ON d.id=cr.order_id;\nDELETE ar FROM `appointment_records` ar JOIN `worker_v203_demo_orders` d ON d.id=ar.order_id;\nDELETE ea FROM `exceptional_arrivals` ea JOIN `worker_v203_demo_orders` d ON d.id=ea.order_id;\nDELETE org FROM `order_role_grants` org JOIN `worker_v203_demo_orders` d ON d.id=org.order_id;\nDELETE a FROM `assignments` a JOIN `worker_v203_demo_orders` d ON d.id=a.order_id;\nDELETE it FROM `invite_tokens` it JOIN `worker_v203_demo_orders` d ON d.id=it.order_id;\nDELETE sc FROM `share_contexts` sc JOIN `worker_v203_demo_orders` d ON d.id=sc.order_id;\nDELETE qs FROM `quote_selections` qs JOIN `worker_v203_demo_orders` d ON d.id=qs.order_id;\nDELETE qv FROM `quote_versions` qv JOIN `quotes` q ON q.id=qv.quote_id JOIN `worker_v203_demo_orders` d ON d.id=q.order_id;\nDELETE q FROM `quotes` q JOIN `worker_v203_demo_orders` d ON d.id=q.order_id;\nDELETE crv FROM `commission_rule_versions` crv JOIN `worker_v203_demo_orders` d ON d.id=crv.order_id;\nDELETE po FROM `payment_orders` po JOIN `worker_v203_demo_orders` d ON d.id=po.order_id;\nDELETE od FROM `order_deadlines` od JOIN `worker_v203_demo_orders` d ON d.id=od.order_id;\nDELETE oe FROM `order_events` oe JOIN `worker_v203_demo_orders` d ON d.id=oe.order_id;\nDELETE orev FROM `order_revisions` orev JOIN `worker_v203_demo_orders` d ON d.id=orev.order_id;\nDELETE oa FROM `order_answers` oa JOIN `worker_v203_demo_orders` d ON d.id=oa.order_id;\nDELETE oad FROM `order_addresses` oad JOIN `worker_v203_demo_orders` d ON d.id=oad.order_id;\nDELETE oc FROM `order_categories` oc JOIN `worker_v203_demo_orders` d ON d.id=oc.order_id;\nDELETE ml FROM `media_links` ml JOIN `worker_v203_demo_orders` d ON d.id=ml.entity_id WHERE ml.entity_type='order';\nDELETE o FROM `orders` o JOIN `worker_v203_demo_orders` d ON d.id=o.id;\nDELETE mf FROM `media_files` mf LEFT JOIN `media_links` ml ON ml.media_file_id=mf.id WHERE mf.storage_key IN ('uploads/demo/order-material.jpg','uploads/demo/order-wall.jpg','uploads/demo/order-completion.jpg') AND ml.id IS NULL;\n\n-- 清理旧演示财务记录后重新生成；真实师傅资金流水不受影响。\nDELETE pa FROM `payout_adjustments` pa JOIN `worker_payouts` wp ON wp.id=pa.worker_payout_id WHERE wp.public_no LIKE '%DEMO%';\nDELETE wa FROM `withdrawal_allocations` wa JOIN `withdrawal_requests` wr ON wr.id=wa.withdrawal_request_id WHERE wr.public_no LIKE '%DEMO%';\nDELETE we FROM `withdrawal_events` we JOIN `withdrawal_requests` wr ON wr.id=we.withdrawal_request_id WHERE wr.public_no LIKE '%DEMO%';\nDELETE FROM `worker_payouts` WHERE `public_no` LIKE '%DEMO%';\nDELETE FROM `withdrawal_requests` WHERE `public_no` LIKE '%DEMO%';\nDELETE FROM `worker_balance_ledger` WHERE `idempotency_key` LIKE 'demo:%';\nSET FOREIGN_KEY_CHECKS=@worker_v203_old_fk_checks;\nDROP TEMPORARY TABLE IF EXISTS `worker_v203_demo_orders`;\n\nSET @demo_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\nSET @demo_schema_version_id=(SELECT `id` FROM `form_schema_versions` WHERE `status`='published' ORDER BY `version_no` DESC,`id` DESC LIMIT 1);\nSET @demo_wallpaper_id=(SELECT `id` FROM `service_categories` WHERE `category_key`='wallpaper' LIMIT 1);\nSET @demo_wallcloth_id=(SELECT `id` FROM `service_categories` WHERE `category_key`='wall_cloth' LIMIT 1);\nSET @demo_glass_id=(SELECT `id` FROM `service_categories` WHERE `category_key`='glass_film' LIMIT 1);\nSET @demo_furniture_id=(SELECT `id` FROM `service_categories` WHERE `category_key`='furniture_film' LIMIT 1);\nSET @demo_curtain_id=(SELECT `id` FROM `service_categories` WHERE `category_key`='curtain' LIMIT 1);\nSET @demo_seam_id=(SELECT `id` FROM `service_categories` WHERE `category_key`='beauty_seam' LIMIT 1);\n\n-- 用户与师傅是同一登录身份，worker_profiles 只保存师傅业务档案；不再复制一套用户账号。\nINSERT INTO `users` (`public_id`,`nickname`,`mobile_masked`,`status`,`created_at`,`updated_at`)\nSELECT '4P6VCTD79R5B9QHYRWGNB7VBRG','V2.0.3 测试用户','13088880000','active',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM DUAL WHERE NOT EXISTS(SELECT 1 FROM `users` WHERE `public_id`='4P6VCTD79R5B9QHYRWGNB7VBRG');\nSET @demo_customer_id=(SELECT `id` FROM `users` WHERE `public_id`='4P6VCTD79R5B9QHYRWGNB7VBRG' LIMIT 1);\n\nINSERT INTO `users` (`public_id`,`nickname`,`mobile_masked`,`status`,`created_at`,`updated_at`)\nSELECT 'V203DEMOWORKERUSER000001','周师傅（V2.0.3演示）','12011112222','active',UTC_TIMESTAMP(),UTC_TIMESTAMP()\nFROM DUAL WHERE NOT EXISTS(SELECT 1 FROM `users` WHERE `public_id`='V203DEMOWORKERUSER000001');\nSET @demo_worker_user_id=(SELECT `id` FROM `users` WHERE `public_id`='V203DEMOWORKERUSER000001' LIMIT 1);\nINSERT INTO `worker_profiles` (`user_id`,`public_id`,`display_name`,`mobile_masked`,`verification_status`,`invited_only`,`city`,`district`,`address_masked`,`lat`,`lng`,`coordinate_system`,`rating`,`completed_orders`,`profile_json`,`profile_source`,`verified_at`,`verified_by`,`created_at`,`updated_at`)\nSELECT @demo_worker_user_id,'V203DEMOWORKERPROFILE001','周师傅','12011112222','approved',0,'杭州市','西湖区','杭州市西湖区文三路 88 号',30.2741000,120.1551000,'GCJ-02',4.90,28,'{\"skills\":[\"墙纸\",\"墙布\",\"玻璃膜\"],\"source\":\"v2.0.3_demo\"}','server',UTC_TIMESTAMP()-INTERVAL 30 DAY,@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 30 DAY,UTC_TIMESTAMP()\nFROM DUAL WHERE NOT EXISTS(SELECT 1 FROM `worker_profiles` WHERE `user_id`=@demo_worker_user_id);\nSET @demo_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `user_id`=@demo_worker_user_id LIMIT 1);\nUPDATE `worker_profiles` SET `display_name`='周师傅',`mobile_masked`='12011112222',`verification_status`='approved',`profile_source`='server',`updated_at`=UTC_TIMESTAMP() WHERE `id`=@demo_worker_id;\n\n-- 九笔订单覆盖待审核、报价中、平台报价待派、施工中、待验收、已完工、待退款、争议/尾款延期和到期退款。\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,`wall_height_text`,`is_renovation`,`expected_visit_at`,`city`,`district`,`address_summary`,`lat`,`lng`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`contact_revealed_at`,`completion_submitted_at`,`auto_accept_at`,`accepted_at`,`auto_review_at`,`cancelled_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`) VALUES\n('BXQZ202608270001',@demo_customer_id,@demo_schema_version_id,@demo_wallpaper_id,'墙纸','墙纸','待审核墙纸施工（演示）','用户刚支付预约费并提交，等待管理员审核。','45.00㎡','2.80m',1,UTC_TIMESTAMP()+INTERVAL 3 DAY,'杭州市','西湖区','杭州市西湖区文二路 120 号 3 幢 502 室',30.2819000,120.1280000,'陈女士','13088880000','pending','hidden','waiting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()),\n('BXQB202608270002',@demo_customer_id,@demo_schema_version_id,@demo_wallcloth_id,'墙布','墙布','多师傅与平台报价（演示）','可在订单详情同时查看师傅报价和平台报价。','68.00㎡','2.85m',0,NULL,'杭州市','拱墅区','杭州市拱墅区湖墅南路 66 号 2 幢 701 室',30.3023000,120.1568000,'李先生','13088880000','approved','published','quoting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 6 DAY,NULL,NULL,NULL,NULL,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('BXBLM202608270003',@demo_customer_id,@demo_schema_version_id,@demo_glass_id,'玻璃膜','玻璃膜','已选平台报价待派单（演示）','用户已接受平台报价并支付预约费，可邀请或指派师傅。','32.00㎡',NULL,0,NULL,'杭州市','滨江区','杭州市滨江区江南大道 1888 号 1 幢 1102 室',30.2084000,120.2121000,'王女士','13088880000','approved','hidden','selected','unassigned','not_started','paid','none','none','active',78000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,NULL,NULL,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()),\n('BXCL202608270004',@demo_customer_id,@demo_schema_version_id,@demo_curtain_id,'窗帘','窗帘','已预约施工订单（演示）','师傅已电话预约上门时间，进行中的订单保持可操作。','4 套',NULL,0,UTC_TIMESTAMP()+INTERVAL 1 DAY,'杭州市','上城区','杭州市上城区庆春路 58 号 6 幢 301 室',30.2581000,120.1833000,'赵女士','13088880000','approved','hidden','selected','assigned','scheduled','paid','none','none','active',86000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 3 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,NULL,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()),\n('BXJJM202608270005',@demo_customer_id,@demo_schema_version_id,@demo_furniture_id,'家具膜','家具膜','已提交完工待结算（演示）','已上传完工照和线下收款凭证，可立即支付服务费。','12 件',NULL,0,NULL,'杭州市','余杭区','杭州市余杭区五常大道 99 号 8 幢 202 室',30.2656000,120.0218000,'孙先生','13088880000','approved','hidden','selected','assigned','submitted','paid','none','none','active',120000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 6 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP()+INTERVAL 60 HOUR,NULL,NULL,NULL,NULL,8,1,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()),\n('BXQZ202608270006',@demo_customer_id,@demo_schema_version_id,@demo_wallpaper_id,'墙纸','墙纸','已完工评价与服务费结清（演示）','完整展示完工图片、评价和服务费结清状态。','55.00㎡','2.75m',1,NULL,'杭州市','萧山区','杭州市萧山区市心中路 168 号 5 幢 402 室',30.1831000,120.2643000,'周女士','13088880000','approved','hidden','selected','completed','accepted','paid','none','resolved','completed',95000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 12 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 11 DAY,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 6 DAY,12,1,UTC_TIMESTAMP()-INTERVAL 12 DAY,UTC_TIMESTAMP()),\n('BXMF202608270007',@demo_customer_id,@demo_schema_version_id,@demo_seam_id,'美缝','美缝','用户取消待部分退款（演示）','管理员可在退款管理弹窗自定义部分退款金额。','约 80m',NULL,0,NULL,'杭州市','临平区','杭州市临平区南苑街道 20 号 3 幢 101 室',30.4188000,120.2994000,'郑先生','13088880000','approved','hidden','closed','unassigned','not_started','paid','pending_review','none','cancel_approved_pending_refund',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 DAY,NULL,NULL,NULL,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 HOUR,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()),\n('BXQB202608270008',@demo_customer_id,@demo_schema_version_id,@demo_wallcloth_id,'墙布','墙布','施工争议与尾款延期（演示）','用户拒绝加价，师傅登记尾款延期，等待管理员裁定。','72.00㎡','3.10m',1,NULL,'杭州市','西湖区','杭州市西湖区留下街道 77 号 2 幢 602 室',30.2356000,120.0812000,'吴女士','13088880000','approved','hidden','selected','assigned','in_progress','paid','none','open','active',135000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 5 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 4 DAY,NULL,NULL,NULL,NULL,NULL,NULL,8,1,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()),\n('BXQZ202608270009',@demo_customer_id,@demo_schema_version_id,@demo_wallpaper_id,'墙纸','墙纸','七天未成交自动取消退款（演示）','用于检查宝塔计划任务自动取消和自动退款结果。','36.00㎡','2.70m',0,NULL,'杭州市','富阳区','杭州市富阳区富春街道 9 号 1 幢 201 室',30.0547000,119.9511000,'钱先生','13088880000','approved','hidden','closed','unassigned','not_started','refunded','succeeded','none','expired',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,4,1,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP());\n\n-- 给每笔演示订单补齐多类目关系、完整对接人地址和两张订单图片。\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`)\nSELECT o.id,o.category_id,o.category_name_snapshot,0,UTC_TIMESTAMP() FROM `orders` o WHERE o.is_demo=1 AND o.category_id IS NOT NULL;\nINSERT INTO `order_addresses` (`order_id`,`province`,`city`,`district`,`address_summary`,`contact_name_masked`,`contact_mobile_masked`,`lat`,`lng`,`coordinate_system`,`created_at`,`updated_at`)\nSELECT o.id,'浙江省',o.city,o.district,o.address_summary,o.contact_name_masked,o.contact_mobile_masked,o.lat,o.lng,'GCJ-02',UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM `orders` o WHERE o.is_demo=1;\nINSERT INTO `media_files` (`public_id`,`storage_disk`,`storage_key`,`mime_type`,`extension`,`size_bytes`,`width_px`,`height_px`,`sha256`,`compression_quality`,`status`,`reference_count`,`created_at`) VALUES\n(LEFT(SHA2('demo-material-203',256),26),'private_local','uploads/demo/order-material.jpg','image/jpeg','jpg',80804,900,675,'ab8fda1afebff029b6249570a4f7466150598cb4f20d6f092a585f74382fce51',82,'active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('demo-wall-203',256),26),'private_local','uploads/demo/order-wall.jpg','image/jpeg','jpg',41075,900,675,'baa9fbd644cf266126cd79c894ef44731010311b736ac072b47412b479f3543b',82,'active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('demo-completion-203',256),26),'private_local','uploads/demo/order-completion.jpg','image/jpeg','jpg',48207,900,675,'967ee65e75ca2d0c6d8f591ca856f476a5d2d88e57c41172431c885381d5675f',82,'active',0,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `status`='active',`pending_delete_at`=NULL,`deleted_at`=NULL;\nSET @demo_media_material=(SELECT id FROM media_files WHERE storage_key='uploads/demo/order-material.jpg' LIMIT 1);\nSET @demo_media_wall=(SELECT id FROM media_files WHERE storage_key='uploads/demo/order-wall.jpg' LIMIT 1);\nSET @demo_media_completion=(SELECT id FROM media_files WHERE storage_key='uploads/demo/order-completion.jpg' LIMIT 1);\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`)\nSELECT @demo_media_material,'order',o.id,'product',10,'system',NULL,UTC_TIMESTAMP() FROM orders o WHERE o.is_demo=1;\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_by_id`,`created_at`)\nSELECT @demo_media_wall,'order',o.id,'wall',20,'system',NULL,UTC_TIMESTAMP() FROM orders o WHERE o.is_demo=1;\n\n-- 报价中订单同时具备师傅报价和平台报价。\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`expires_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v203-worker-',o.public_no),256),26),o.id,'worker',@demo_worker_id,NULL,88000,5000,'周师傅报价：含基础墙面检查和铺贴施工。','active',1,NULL,UTC_TIMESTAMP()-INTERVAL 18 HOUR,UTC_TIMESTAMP() FROM orders o WHERE o.public_no='BXQB202608270002';\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`expires_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v203-platform-',o.public_no),256),26),o.id,'platform',NULL,@demo_admin_id,92000,5000,'平台参考报价：接受后由管理员安排师傅。','active',1,NULL,UTC_TIMESTAMP()-INTERVAL 16 HOUR,UTC_TIMESTAMP() FROM orders o WHERE o.public_no='BXQB202608270002';\n\n-- 已选择订单的报价、规则、支付与指派使用集合插入，避免重复手写状态造成错链。\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`selected_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v203-selected-',o.public_no),256),26),o.id,IF(o.public_no='BXBLM202608270003','platform','worker'),IF(o.public_no='BXBLM202608270003',NULL,@demo_worker_id),IF(o.public_no='BXBLM202608270003',@demo_admin_id,NULL),o.final_amount_cents,o.booking_fee_cents,'V2.0.3 已选择报价演示','selected',1,o.contact_revealed_at,o.created_at+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM orders o WHERE o.public_no IN ('BXBLM202608270003','BXCL202608270004','BXJJM202608270005','BXQZ202608270006','BXQB202608270008');\nINSERT INTO `quote_versions` (`quote_id`,`version_no`,`amount_cents`,`booking_fee_cents`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`rule_acknowledged_at`,`description`,`operator_type`,`operator_id`,`created_at`)\nSELECT q.id,1,q.amount_cents,q.booking_fee_cents,1000,5000,q.created_at,q.description,IF(q.quote_type='platform','admin','worker'),IF(q.quote_type='platform',@demo_admin_id,@demo_worker_id),q.created_at FROM quotes q JOIN orders o ON o.id=q.order_id WHERE o.is_demo=1;\nINSERT INTO `quote_selections` (`order_id`,`quote_id`,`quote_version_id`,`user_id`,`amount_cents_snapshot`,`booking_fee_cents_snapshot`,`status`,`selected_at`,`confirmed_at`)\nSELECT o.id,q.id,qv.id,@demo_customer_id,q.amount_cents,q.booking_fee_cents,'confirmed',q.selected_at,q.selected_at FROM orders o JOIN quotes q ON q.order_id=o.id AND q.status='selected' JOIN quote_versions qv ON qv.quote_id=q.id AND qv.version_no=1 WHERE o.is_demo=1;\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`locked_at`,`created_at`)\nSELECT o.id,1,1000,5000,'default','V2.0.3 演示订单规则',@demo_admin_id,'locked',o.contact_revealed_at,o.created_at FROM orders o WHERE o.selected_quote_id IS NULL AND o.public_no IN ('BXBLM202608270003','BXCL202608270004','BXJJM202608270005','BXQZ202608270006','BXQB202608270008');\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT CONCAT('PAY-DEMO-203-',RIGHT(o.public_no,4)),'order_booking',o.id,o.id,@demo_customer_id,'DEMO_OPENID_203','DEMO_APPID','DEMO_MCHID','v3','CNY',5000,IF(o.public_no='BXQZ202608270009','refunded','paid'),CONCAT('DEMO_TX_203_',RIGHT(o.public_no,4)),'演示预约费，不是真实微信交易',o.created_at+INTERVAL 10 MINUTE,o.created_at,UTC_TIMESTAMP()\nFROM orders o WHERE o.public_no IN ('BXQZ202608270001','BXQB202608270002','BXBLM202608270003','BXCL202608270004','BXJJM202608270005','BXQZ202608270006','BXQB202608270008','BXMF202608270007','BXQZ202608270009');\n\nINSERT INTO `assignments` (`public_id`,`order_id`,`worker_id`,`quote_id`,`assignment_type`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`estimated_commission_cents`,`estimated_offline_collect_cents`,`estimated_net_income_cents`,`status`,`offered_at`,`accepted_at`,`created_by_admin_id`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v203-assignment-',o.public_no),256),26),o.id,@demo_worker_id,q.id,'worker_quote',crv.id,o.final_amount_cents,o.booking_fee_cents,1000,5000,GREATEST(ROUND(o.final_amount_cents*0.10),5000),o.final_amount_cents-o.booking_fee_cents,o.final_amount_cents-GREATEST(ROUND(o.final_amount_cents*0.10),5000),IF(o.fulfillment_status='accepted','completed','accepted'),o.created_at+INTERVAL 1 DAY,o.created_at+INTERVAL 1 DAY,@demo_admin_id,o.created_at+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM orders o JOIN quotes q ON q.order_id=o.id AND q.status='selected' JOIN commission_rule_versions crv ON crv.order_id=o.id AND crv.version_no=1 WHERE o.public_no IN ('BXCL202608270004','BXJJM202608270005','BXQZ202608270006','BXQB202608270008');\nUPDATE orders o JOIN quotes q ON q.order_id=o.id AND q.status='selected' LEFT JOIN commission_rule_versions crv ON crv.order_id=o.id AND crv.version_no=1 LEFT JOIN assignments a ON a.order_id=o.id SET o.selected_quote_id=q.id,o.commission_rule_version_id=crv.id,o.current_assignment_id=a.id,o.assigned_worker_id=a.worker_id WHERE o.is_demo=1;\n\nSET @demo_order_platform=(SELECT id FROM orders WHERE public_no='BXBLM202608270003');\nSET @demo_rule_platform=(SELECT id FROM commission_rule_versions WHERE order_id=@demo_order_platform LIMIT 1);\nINSERT INTO `invite_tokens` (`order_id`,`token_hash`,`purpose`,`created_by_admin_id`,`commission_rule_version_id`,`status`,`max_claims`,`claim_count`,`expires_at`,`created_at`) VALUES (@demo_order_platform,SHA2('DEMO-V203-INVITE-NOT-USABLE',256),'worker_assignment',@demo_admin_id,@demo_rule_platform,'active',1,0,UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\nINSERT INTO `share_contexts` (`order_id`,`context_type`,`token_hash`,`created_by_type`,`created_by_id`,`snapshot_json`,`status`,`expires_at`,`created_at`) VALUES (@demo_order_platform,'worker_invite',SHA2('DEMO-V203-SHARE-NOT-USABLE',256),'admin',@demo_admin_id,'{\"share_type\":\"worker_invite\",\"demo\":true}','active',UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\n\nSET @demo_order_scheduled=(SELECT id FROM orders WHERE public_no='BXCL202608270004');\nINSERT INTO `appointment_records` (`order_id`,`worker_id`,`appointment_at`,`note`,`status`,`created_at`,`updated_at`) VALUES (@demo_order_scheduled,@demo_worker_id,UTC_TIMESTAMP()+INTERVAL 1 DAY,'师傅电话预约：明日上午九点上门。','recorded',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nSET @demo_order_submitted=(SELECT id FROM orders WHERE public_no='BXJJM202608270005');\nSET @demo_assignment_submitted=(SELECT id FROM assignments WHERE order_id=@demo_order_submitted LIMIT 1);\nSET @demo_rule_submitted=(SELECT commission_rule_version_id FROM assignments WHERE id=@demo_assignment_submitted);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`version`,`created_at`,`updated_at`) VALUES (@demo_order_submitted,@demo_worker_id,'家具膜施工已完成，已清理现场。','submitted',UTC_TIMESTAMP()-INTERVAL 12 HOUR,1,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP());\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`created_at`,`updated_at`) VALUES ('COM-DEMO-203-PENDING',@demo_order_submitted,@demo_worker_id,@demo_assignment_submitted,@demo_rule_submitted,120000,5000,1000,5000,12000,5000,7000,0,'pending',UTC_TIMESTAMP()+INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP());\nINSERT INTO media_links(media_file_id,entity_type,entity_id,purpose,sort_order,created_by_type,created_by_id,created_at) VALUES (@demo_media_completion,'order',@demo_order_submitted,'completion',10,'worker',@demo_worker_id,UTC_TIMESTAMP()-INTERVAL 12 HOUR),(@demo_media_material,'order',@demo_order_submitted,'collection_receipt',10,'worker',@demo_worker_id,UTC_TIMESTAMP()-INTERVAL 11 HOUR);\n\nSET @demo_order_done=(SELECT id FROM orders WHERE public_no='BXQZ202608270006');\nSET @demo_assignment_done=(SELECT id FROM assignments WHERE order_id=@demo_order_done LIMIT 1);\nSET @demo_rule_done=(SELECT commission_rule_version_id FROM assignments WHERE id=@demo_assignment_done);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES (@demo_order_done,@demo_worker_id,'墙纸施工完成，用户已验收。','accepted',UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,'auto_72h',1,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP());\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`settled_at`,`created_at`,`updated_at`) VALUES ('COM-DEMO-203-SETTLED',@demo_order_done,@demo_worker_id,@demo_assignment_done,@demo_rule_done,95000,5000,1000,5000,9500,5000,4500,4500,'settled',UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nSET @demo_receivable_done=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`) VALUES ('PAY-DEMO-203-COMMISSION','commission',@demo_receivable_done,@demo_order_done,@demo_worker_user_id,'DEMO_WORKER_OPENID_203','DEMO_APPID','DEMO_MCHID','v3','CNY',4500,'paid','DEMO_TX_203_COMMISSION','演示平台服务费，不是真实微信交易',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @demo_commission_payment_order=LAST_INSERT_ID();\nINSERT INTO `commission_payments` (`receivable_id`,`payment_order_id`,`amount_cents`,`status`,`paid_at`,`created_at`) VALUES (@demo_receivable_done,@demo_commission_payment_order,4500,'paid',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO media_links(media_file_id,entity_type,entity_id,purpose,sort_order,created_by_type,created_by_id,created_at) VALUES (@demo_media_completion,'order',@demo_order_done,'completion',10,'worker',@demo_worker_id,UTC_TIMESTAMP()-INTERVAL 8 DAY),(@demo_media_material,'order',@demo_order_done,'collection_receipt',10,'worker',@demo_worker_id,UTC_TIMESTAMP()-INTERVAL 7 DAY);\nINSERT INTO `reviews` (`public_id`,`order_id`,`user_id`,`worker_id`,`rating`,`content`,`is_auto`,`status`,`reviewed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('demo-v203-review',256),26),@demo_order_done,@demo_customer_id,@demo_worker_id,5,'师傅沟通及时，施工细致，完工效果满意。',0,'visible',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @demo_review_id=LAST_INSERT_ID();\nINSERT INTO `review_media` (`review_id`,`media_file_id`,`sort_order`,`created_at`) VALUES (@demo_review_id,@demo_media_completion,10,UTC_TIMESTAMP()-INTERVAL 5 DAY);\n\nSET @demo_order_refund=(SELECT id FROM orders WHERE public_no='BXMF202608270007');\nSET @demo_pay_refund=(SELECT id FROM payment_orders WHERE order_id=@demo_order_refund LIMIT 1);\nINSERT INTO `order_cancel_requests` (`public_id`,`order_id`,`applicant_type`,`applicant_id`,`request_type`,`order_state_snapshot_json`,`reason_code`,`reason`,`status`,`requested_refund_cents`,`requested_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('demo-v203-cancel-pending',256),26),@demo_order_refund,'user',@demo_customer_id,'cancel_refund','{\"fulfillment_status\":\"not_started\",\"payment_status\":\"paid\"}','schedule_changed','行程变化，申请退回部分预约费。','approved',2500,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP());\nSET @demo_cancel_request=LAST_INSERT_ID();\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`cancel_request_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`created_at`,`updated_at`) VALUES ('REF-DEMO-203-PENDING',@demo_pay_refund,@demo_order_refund,@demo_cancel_request,2500,'演示自定义部分退款 25.00 元','pending_review',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP()-INTERVAL 40 MINUTE,UTC_TIMESTAMP());\n\nSET @demo_order_expired=(SELECT id FROM orders WHERE public_no='BXQZ202608270009');\nSET @demo_pay_expired=(SELECT id FROM payment_orders WHERE order_id=@demo_order_expired LIMIT 1);\nINSERT INTO `refunds` (`public_no`,`payment_order_id`,`order_id`,`amount_cents`,`reason`,`status`,`requested_by_admin_id`,`requested_at`,`succeeded_at`,`created_at`,`updated_at`) VALUES ('REF-DEMO-203-DONE',@demo_pay_expired,@demo_order_expired,5000,'七天未成交自动取消，全额退回预约费','succeeded',NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 23 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nSET @demo_order_dispute=(SELECT id FROM orders WHERE public_no='BXQB202608270008');\nINSERT INTO `disputes` (`public_no`,`order_id`,`raised_by_type`,`raised_by_id`,`dispute_type`,`title`,`description`,`status`,`responsibility`,`refund_amount_cents`,`run_empty_fee_cents`,`opened_at`,`created_at`,`updated_at`) VALUES ('DSP-DEMO-203-OPEN',@demo_order_dispute,'worker',@demo_worker_id,'change_rejected','施工加价协商未达成','用户拒绝加价，双方协商未果，等待管理员依据图片与沟通记录裁定。','open','undetermined',0,0,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP()-INTERVAL 3 HOUR,UTC_TIMESTAMP());\nINSERT INTO `offline_payment_delay_requests` (`order_id`,`worker_id`,`amount_cents_snapshot`,`reason`,`expected_collect_at`,`status`,`submitted_at`,`created_at`,`updated_at`) VALUES (@demo_order_dispute,@demo_worker_id,130000,'业主约定三天后补齐线下尾款。',UTC_TIMESTAMP()+INTERVAL 3 DAY,'pending',UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP());\n\n-- 每笔订单都有中文时间线，便于检查详情页状态转换。\nINSERT INTO `order_events` (`order_id`,`event_type`,`event_key`,`actor_type`,`actor_id`,`payload_json`,`created_at`)\nSELECT o.id,'order_demo_seeded',CONCAT('demo:203:',o.id),'system',NULL,JSON_OBJECT('message',CONCAT('V2.0.3 演示状态：',o.title)),o.created_at FROM orders o WHERE o.is_demo=1;\n\n-- 支付宝账号与提现演示使用完整姓名、账号和电话，避免后台人工转账无法排查。\nINSERT INTO `worker_payout_accounts` (`worker_id`,`account_type`,`holder_name_masked`,`holder_name_ciphertext`,`account_masked`,`account_ciphertext`,`account_hmac`,`status`,`is_default`,`verified_at`,`created_at`,`updated_at`) VALUES (@demo_worker_id,'alipay','周师傅','周师傅','12011112222','12011112222',SHA2('V203-DEMO-ALIPAY-12011112222',256),'active',1,UTC_TIMESTAMP()-INTERVAL 20 DAY,UTC_TIMESTAMP()-INTERVAL 20 DAY,UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE `id`=LAST_INSERT_ID(`id`),`holder_name_masked`='周师傅',`holder_name_ciphertext`='周师傅',`account_masked`='12011112222',`account_ciphertext`='12011112222',`status`='active',`updated_at`=UTC_TIMESTAMP();\nSET @demo_payout_account_id=LAST_INSERT_ID();\nINSERT INTO `worker_real_name_verifications` (`worker_id`,`real_name_masked`,`real_name_ciphertext`,`id_number_masked`,`id_number_ciphertext`,`id_number_hmac`,`status`,`review_reason`,`reviewed_by`,`submitted_at`,`reviewed_at`,`created_at`,`updated_at`) VALUES (@demo_worker_id,'周师傅','周师傅','330106199001011234','330106199001011234',SHA2('330106199001011234',256),'approved','V2.0.3 实名审核通过演示',@demo_admin_id,UTC_TIMESTAMP()-INTERVAL 25 DAY,UTC_TIMESTAMP()-INTERVAL 24 DAY,UTC_TIMESTAMP()-INTERVAL 25 DAY,UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE `real_name_masked`='周师傅',`real_name_ciphertext`='周师傅',`id_number_masked`='330106199001011234',`id_number_ciphertext`='330106199001011234',`status`='approved',`review_reason`=VALUES(`review_reason`),`reviewed_by`=VALUES(`reviewed_by`),`reviewed_at`=VALUES(`reviewed_at`),`updated_at`=UTC_TIMESTAMP();\nINSERT INTO `worker_balance_ledger` (`worker_id`,`entry_type`,`direction`,`amount_cents`,`available_delta_cents`,`frozen_delta_cents`,`business_type`,`business_id`,`idempotency_key`,`description`,`status`,`created_at`) VALUES (@demo_worker_id,'run_empty_fee','credit',10000,10000,0,'demo_adjustment',203,'demo:203:balance','跑空费进入余额演示','effective',UTC_TIMESTAMP()-INTERVAL 2 DAY);\nINSERT INTO `withdrawal_requests` (`public_no`,`worker_id`,`payout_account_id`,`amount_cents`,`account_type_snapshot`,`holder_name_masked_snapshot`,`holder_name_ciphertext_snapshot`,`account_masked_snapshot`,`account_ciphertext_snapshot`,`status`,`review_note`,`submitted_at`,`reviewed_at`,`created_at`,`updated_at`) VALUES\n('WD-DEMO-203-PENDING',@demo_worker_id,@demo_payout_account_id,3000,'alipay','周师傅','周师傅','12011112222','12011112222','pending','待管理员审核并人工支付宝转账',UTC_TIMESTAMP()-INTERVAL 1 HOUR,NULL,UTC_TIMESTAMP()-INTERVAL 1 HOUR,UTC_TIMESTAMP()),\n('WD-DEMO-203-APPROVED',@demo_worker_id,@demo_payout_account_id,2000,'alipay','周师傅','周师傅','12011112222','12011112222','approved','审核通过，等待管理员登记付款结果',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 20 HOUR,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nUPDATE `media_files` m SET m.reference_count=(SELECT COUNT(*) FROM media_links l WHERE l.media_file_id=m.id) WHERE m.id IN (@demo_media_material,@demo_media_wall,@demo_media_completion);\nINSERT INTO `rating_summaries` (`worker_id`,`review_count`,`rating_sum`,`rating_average`,`five_star_count`,`updated_at`) VALUES (@demo_worker_id,1,5,5.00,1,UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE `review_count`=1,`rating_sum`=5,`rating_average`=5.00,`five_star_count`=1,`updated_at`=UTC_TIMESTAMP();\n\nSELECT 'V2.0.3 order admin, completion settlement, maintenance switches and demo dataset upgraded' AS `migration_message`;\n","server/database/upgrades/2.0.4.sql":"-- 2026-08-28：V2.0.4 管理操作、订单时间线与双测试身份全流程数据重建。\n-- 重要：按本次上线前测试要求清空全部订单、报价、履约、退款、争议、评价与师傅财务业务数据。\n-- 兼容 PHP 7.4 / MySQL 5.7.44；保留系统设置、管理员、类目和表单配置。\nSET NAMES utf8mb4;\n\nINSERT INTO `system_settings` (`setting_key`,`setting_value`,`value_type`,`group_name`,`is_public`,`description`,`updated_by`,`created_at`,`updated_at`) VALUES\n('app.version','2.0.4','string','system',1,'当前后台和数据库基线版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('demo.seed_version','2.0.4','string','system',0,'当前全流程测试数据版本',NULL,UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `setting_value`=VALUES(`setting_value`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-28：补充运营后台常用字段中文名，普通管理页面不再直接展示难懂的英文字段。\nINSERT INTO `database_field_dictionary` (`table_name`,`field_name`,`chinese_name`,`description`,`created_at`,`updated_at`) VALUES\n('orders','audit_status','审核状态','待审核、已通过、待补资料或未通过',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','publish_status','大厅展示状态','订单是否显示在接单大厅',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','quote_status','报价状态','等待报价、报价中、已选报价或已关闭',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','assignment_status','派单状态','待安排、已安排或师傅已接单',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','fulfillment_status','施工状态','待施工、已预约、施工中、待验收或已验收',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','payment_status','预约费支付状态','预约费当前支付状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','refund_status','退款状态','预约费退款审核与到账状态',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','dispute_status','争议状态','订单是否处于争议处理中',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('orders','lifecycle_status','订单总状态','订单进行中、已完成、已取消或已到期',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('quotes','quote_type','报价来源','师傅报价或平台报价',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('quotes','status','报价状态','报价是否可选择或已被选择',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('assignments','assignment_type','安排方式','师傅报价、管理员指派或邀请领取',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('assignments','status','施工单状态','待接单、已接单、已完工或已取消',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('refunds','status','退款处理状态','待审核、处理中、成功或失败',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('disputes','responsibility','责任判定','用户、师傅、平台、双方协商或待判定',UTC_TIMESTAMP(),UTC_TIMESTAMP()),\n('withdrawal_requests','status','提现状态','待审核、已通过、已支付或已驳回',UTC_TIMESTAMP(),UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `chinese_name`=VALUES(`chinese_name`),`description`=VALUES(`description`),`updated_at`=UTC_TIMESTAMP();\n\n-- 2026-08-28：两个测试身份均为服务器已有真实用户，仅按 public_id 取主键，绝不新增或覆盖昵称、头像、手机号、微信身份和云同步资料。\nSET @v204_customer_id=(SELECT `id` FROM `users` WHERE `public_id`='BE20FMBCSMG6924JK21TE0RJTP' LIMIT 1);\nSET @v204_worker_user_id=(SELECT `id` FROM `users` WHERE `public_id`='4P6VCTD79R5B9QHYRWGNB7VBRG' LIMIT 1);\nSET @v204_identity_ready=IF(@v204_customer_id IS NOT NULL AND @v204_worker_user_id IS NOT NULL,1,0);\nSET @v204_worker_id=(SELECT `id` FROM `worker_profiles` WHERE `user_id`=@v204_worker_user_id ORDER BY `id` LIMIT 1);\nSET @v204_admin_id=(SELECT `id` FROM `admin_users` ORDER BY `id` LIMIT 1);\n\nSET @v204_old_fk_checks=@@FOREIGN_KEY_CHECKS;\nSET FOREIGN_KEY_CHECKS=0;\n\n-- 清空全部订单业务链。每张表只执行一次 DELETE，避免 MySQL 5.7 临时表重复打开问题。\nDELETE FROM `review_media`;\nDELETE FROM `review_replies`;\nDELETE FROM `dispute_evidence`;\nDELETE FROM `quote_items`;\nDELETE FROM `commission_payments`;\nDELETE FROM `commission_adjustments`;\nDELETE FROM `payment_notifications`;\nDELETE FROM `reconciliation_records`;\nDELETE FROM `change_items`;\nDELETE FROM `change_confirmations`;\nDELETE FROM `assignment_history`;\nDELETE FROM `order_cancel_decisions`;\nDELETE FROM `refunds`;\nDELETE FROM `commission_receivables`;\nDELETE FROM `reviews`;\nDELETE FROM `disputes`;\nDELETE FROM `after_sales`;\nDELETE FROM `order_cancel_requests`;\nDELETE FROM `completion_submissions`;\nDELETE FROM `offline_payment_delay_requests`;\nDELETE FROM `change_requests`;\nDELETE FROM `appointment_records`;\nDELETE FROM `exceptional_arrivals`;\nDELETE FROM `order_role_grants`;\nDELETE FROM `assignments`;\nDELETE FROM `invite_tokens`;\nDELETE FROM `share_contexts`;\nDELETE FROM `quote_selections`;\nDELETE FROM `quote_versions`;\nDELETE FROM `quotes`;\nDELETE FROM `commission_rule_versions`;\nDELETE FROM `payment_orders`;\nDELETE FROM `order_deadlines`;\nDELETE FROM `order_events`;\nDELETE FROM `order_revisions`;\nDELETE FROM `order_answers`;\nDELETE FROM `order_addresses`;\nDELETE FROM `order_categories`;\nDELETE FROM `media_links` WHERE `entity_type` IN ('order','review');\nDELETE FROM `media_files` WHERE `storage_key` LIKE 'uploads/demo/%';\nDELETE FROM `orders`;\n\n-- 2026-08-28：清空旧订单财务测试数据，但保留 4P6... 已有师傅主档、实名、位置、技能、图片及支付宝资料。\nDELETE FROM `payout_adjustments`;\nDELETE FROM `withdrawal_allocations`;\nDELETE FROM `withdrawal_events`;\nDELETE FROM `worker_payouts`;\nDELETE FROM `withdrawal_requests`;\nDELETE FROM `worker_balance_ledger`;\nDELETE FROM `worker_payout_accounts` WHERE @v204_worker_id IS NOT NULL AND `worker_id`<>@v204_worker_id;\nDELETE FROM `worker_real_name_verifications` WHERE @v204_worker_id IS NOT NULL AND `worker_id`<>@v204_worker_id;\nDELETE FROM `worker_verifications` WHERE @v204_worker_id IS NOT NULL AND `worker_id`<>@v204_worker_id;\nDELETE FROM `worker_locations` WHERE @v204_worker_id IS NOT NULL AND `worker_id`<>@v204_worker_id;\nDELETE FROM `worker_skills` WHERE @v204_worker_id IS NOT NULL AND `worker_id`<>@v204_worker_id;\nDELETE FROM `rating_summaries`;\nDELETE FROM `worker_profiles` WHERE @v204_worker_id IS NOT NULL AND `id`<>@v204_worker_id;\n\n-- 清理其他小程序用户的身份、会话和云同步记录；管理员账号不在 users 表，不受影响。\nDELETE a FROM `cloud_sync_attempts` a LEFT JOIN `cloud_identity_mappings` m ON m.`id`=a.`mapping_id` WHERE @v204_identity_ready=1 AND (m.`user_id` IS NULL OR m.`user_id` NOT IN (@v204_customer_id,@v204_worker_user_id));\nDELETE FROM `cloud_identity_mappings` WHERE `user_id` NOT IN (@v204_customer_id,@v204_worker_user_id);\nDELETE FROM `subscription_preferences` WHERE `user_id` NOT IN (@v204_customer_id,@v204_worker_user_id);\nDELETE FROM `user_roles` WHERE `user_id` NOT IN (@v204_customer_id,@v204_worker_user_id);\nDELETE FROM `login_sessions` WHERE `user_id` NOT IN (@v204_customer_id,@v204_worker_user_id);\nDELETE FROM `wechat_identities` WHERE `user_id` NOT IN (@v204_customer_id,@v204_worker_user_id);\nUPDATE `media_files` SET `upload_session_id`=NULL WHERE `upload_session_id` IN (SELECT `id` FROM `upload_sessions` WHERE @v204_identity_ready=1 AND ((`owner_type`='user' AND `owner_id` NOT IN (@v204_customer_id,@v204_worker_user_id)) OR (`owner_type`='worker' AND @v204_worker_id IS NOT NULL AND `owner_id`<>@v204_worker_id)));\nDELETE FROM `upload_sessions` WHERE @v204_identity_ready=1 AND ((`owner_type`='user' AND `owner_id` NOT IN (@v204_customer_id,@v204_worker_user_id)) OR (`owner_type`='worker' AND @v204_worker_id IS NOT NULL AND `owner_id`<>@v204_worker_id));\nDELETE FROM `notifications`;\nDELETE FROM `message_outbox`;\nDELETE FROM `idempotency_keys`;\nDELETE FROM `users` WHERE @v204_identity_ready=1 AND `id` NOT IN (@v204_customer_id,@v204_worker_user_id);\n\nSET FOREIGN_KEY_CHECKS=@v204_old_fk_checks;\n\n-- 2026-08-28：复用 4P6... 原有师傅编号和云档案；仅按本次测试身份要求恢复为可接单状态，不修改真实个人资料。\nUPDATE `worker_profiles` SET `verification_status`='approved',`rejection_reason`=NULL,`verified_at`=COALESCE(`verified_at`,UTC_TIMESTAMP()),`verified_by`=COALESCE(`verified_by`,@v204_admin_id) WHERE `id`=@v204_worker_id;\nSET @v204_worker_name=(SELECT COALESCE(NULLIF(`display_name`,''),'师傅') FROM `worker_profiles` WHERE `id`=@v204_worker_id LIMIT 1);\nSET @v204_customer_role_id=(SELECT `id` FROM `roles` WHERE `role_key`='customer' LIMIT 1);\nSET @v204_worker_role_id=(SELECT `id` FROM `roles` WHERE `role_key`='worker' LIMIT 1);\nSET @v204_worker_pending_role_id=(SELECT `id` FROM `roles` WHERE `role_key`='worker_pending' LIMIT 1);\nINSERT IGNORE INTO `user_roles` (`user_id`,`role_id`,`source`,`granted_by_admin_id`,`created_at`) SELECT @v204_customer_id,@v204_customer_role_id,'v2.0.4_existing_user',@v204_admin_id,UTC_TIMESTAMP() WHERE @v204_customer_id IS NOT NULL AND @v204_customer_role_id IS NOT NULL;\nINSERT IGNORE INTO `user_roles` (`user_id`,`role_id`,`source`,`granted_by_admin_id`,`created_at`) SELECT @v204_worker_user_id,@v204_customer_role_id,'v2.0.4_existing_user',@v204_admin_id,UTC_TIMESTAMP() WHERE @v204_worker_user_id IS NOT NULL AND @v204_customer_role_id IS NOT NULL;\nINSERT IGNORE INTO `user_roles` (`user_id`,`role_id`,`source`,`granted_by_admin_id`,`created_at`) SELECT @v204_worker_user_id,@v204_worker_role_id,'v2.0.4_existing_worker',@v204_admin_id,UTC_TIMESTAMP() WHERE @v204_worker_user_id IS NOT NULL AND @v204_worker_role_id IS NOT NULL;\nDELETE FROM `user_roles` WHERE `user_id`=@v204_worker_user_id AND `role_id`=@v204_worker_pending_role_id AND @v204_worker_role_id IS NOT NULL;\n\nSET @v204_schema_id=(SELECT `id` FROM `form_schema_versions` WHERE `status`='published' ORDER BY `version_no` DESC,`id` DESC LIMIT 1);\nSET @v204_qz=(SELECT `id` FROM `service_categories` WHERE `category_key`='wallpaper' LIMIT 1);\nSET @v204_qb=(SELECT `id` FROM `service_categories` WHERE `category_key`='wall_cloth' LIMIT 1);\nSET @v204_blm=(SELECT `id` FROM `service_categories` WHERE `category_key`='glass_film' LIMIT 1);\nSET @v204_jjm=(SELECT `id` FROM `service_categories` WHERE `category_key`='furniture_film' LIMIT 1);\nSET @v204_cl=(SELECT `id` FROM `service_categories` WHERE `category_key`='curtain' LIMIT 1);\nSET @v204_mf=(SELECT `id` FROM `service_categories` WHERE `category_key`='beauty_seam' LIMIT 1);\n\n-- 2026-08-28：订单测试覆盖全部类目，但不伪造师傅位置、身份证或手机号。\nINSERT IGNORE INTO `worker_skills` (`worker_id`,`category_id`,`status`,`created_at`) SELECT @v204_worker_id,id,'active',UTC_TIMESTAMP() FROM service_categories WHERE @v204_worker_id IS NOT NULL AND id IN (@v204_qz,@v204_qb,@v204_blm,@v204_jjm,@v204_cl,@v204_mf);\nINSERT INTO `worker_verifications` (`worker_id`,`submitted_snapshot_json`,`decision`,`decision_reason`,`reviewed_by`,`submitted_at`,`reviewed_at`)\nSELECT @v204_worker_id,JSON_OBJECT('display_name',@v204_worker_name,'source','v2.0.4_existing_worker'),'approved','2.0.4 使用既有师傅档案作为测试接单身份',@v204_admin_id,UTC_TIMESTAMP(),UTC_TIMESTAMP()\nWHERE @v204_worker_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM `worker_verifications` WHERE `worker_id`=@v204_worker_id AND `decision_reason`='2.0.4 使用既有师傅档案作为测试接单身份');\n\n-- 十笔订单覆盖待审核、待补资料、报价中、平台待派、已预约、待验收、已完成、待退款、争议与自动退款。\nINSERT INTO `orders` (`public_no`,`user_id`,`form_schema_version_id`,`category_id`,`category_name_snapshot`,`category_names_snapshot`,`title`,`description`,`quantity_text`,`wall_height_text`,`is_renovation`,`expected_visit_at`,`city`,`district`,`address_summary`,`lat`,`lng`,`contact_name_masked`,`contact_mobile_masked`,`audit_status`,`audit_note`,`audited_at`,`publish_status`,`quote_status`,`assignment_status`,`fulfillment_status`,`payment_status`,`refund_status`,`dispute_status`,`lifecycle_status`,`final_amount_cents`,`booking_fee_cents`,`commission_rate_bp`,`commission_min_cents`,`published_at`,`quote_deadline_at`,`contact_revealed_at`,`completion_submitted_at`,`auto_accept_at`,`accepted_at`,`auto_review_at`,`cancelled_at`,`closed_at`,`version`,`is_demo`,`created_at`,`updated_at`) VALUES\n('BXQZ202608280731',@v204_customer_id,@v204_schema_id,@v204_qz,'墙纸','墙纸','待审核墙纸施工','预约费已付，等待管理员统一审核处理。','45.00㎡','2.80m',1,NULL,'杭州市','西湖区','杭州市西湖区文二路 120 号 3 幢 502 室',30.2819000,120.1280000,'陈女士','13088880000','pending',NULL,NULL,'hidden','waiting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,UTC_TIMESTAMP()-INTERVAL 2 HOUR,UTC_TIMESTAMP()),\n('BXQB202608284826',@v204_customer_id,@v204_schema_id,@v204_qb,'墙布','墙布','待用户补充现场资料','管理员已要求补充更清晰的墙面图片。','60.00㎡','2.85m',1,NULL,'杭州市','拱墅区','杭州市拱墅区湖墅南路 66 号 2 幢 701 室',30.3023000,120.1568000,'李先生','13088880000','supplement_required','请补充发霉墙面的近照和全景照片。',UTC_TIMESTAMP()-INTERVAL 30 MINUTE,'hidden','waiting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,2,1,UTC_TIMESTAMP()-INTERVAL 4 HOUR,UTC_TIMESTAMP()),\n('BXQB202608289154',@v204_customer_id,@v204_schema_id,@v204_qb,'墙布','墙布','师傅与平台同时报价','可检查师傅报价、平台报价和管理员详情操作。','68.00㎡','2.85m',0,NULL,'杭州市','拱墅区','杭州市拱墅区莫干山路 188 号 1 幢 601 室',30.3115000,120.1532000,'郭女士','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,'published','quoting','unassigned','not_started','paid','none','none','active',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 6 DAY,NULL,NULL,NULL,NULL,NULL,NULL,NULL,3,1,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()),\n('BXBLM202608283608',@v204_customer_id,@v204_schema_id,@v204_blm,'玻璃膜','玻璃膜','平台报价已接受待邀请师傅','管理员订单详情应显示邀请师傅分享，工作台不显示分享按钮。','32.00㎡',NULL,0,NULL,'杭州市','滨江区','杭州市滨江区江南大道 1888 号 1 幢 1102 室',30.2084000,120.2121000,'王女士','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 2 DAY,'hidden','selected','unassigned','not_started','paid','none','none','active',78000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,NULL,NULL,NULL,NULL,NULL,4,1,UTC_TIMESTAMP()-INTERVAL 2 DAY,UTC_TIMESTAMP()),\n('BXCL202608287245',@v204_customer_id,@v204_schema_id,@v204_cl,'窗帘','窗帘','已安排师傅并完成电话预约','师傅已接单并记录明日上午上门。','4 套',NULL,0,UTC_TIMESTAMP()+INTERVAL 1 DAY,'杭州市','上城区','杭州市上城区庆春路 58 号 6 幢 301 室',30.2581000,120.1833000,'赵女士','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 3 DAY,'hidden','selected','accepted','scheduled','paid','none','none','active',86000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 3 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,NULL,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()),\n('BXJJM202608281937',@v204_customer_id,@v204_schema_id,@v204_jjm,'家具膜','家具膜','已提交完工待验收和结算','已上传完工照、收款凭证并登记线下尾款延期。','12 件',NULL,0,NULL,'杭州市','余杭区','杭州市余杭区五常大道 99 号 8 幢 202 室',30.2656000,120.0218000,'孙先生','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 6 DAY,'hidden','selected','accepted','submitted','paid','none','none','active',120000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 6 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP()+INTERVAL 60 HOUR,NULL,NULL,NULL,NULL,8,1,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()),\n('BXQZ202608286403',@v204_customer_id,@v204_schema_id,@v204_qz,'墙纸','墙纸','已验收评价并结清服务费','可检查完整评价、完工图片和服务费结清。','55.00㎡','2.75m',1,NULL,'杭州市','萧山区','杭州市萧山区市心中路 168 号 5 幢 402 室',30.1831000,120.2643000,'周女士','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 12 DAY,'hidden','selected','completed','accepted','paid','none','resolved','completed',95000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 12 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 11 DAY,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 6 DAY,12,1,UTC_TIMESTAMP()-INTERVAL 12 DAY,UTC_TIMESTAMP()),\n('BXMF202608285871',@v204_customer_id,@v204_schema_id,@v204_mf,'美缝','美缝','取消订单待部分退款','管理员可在退款弹窗自定义本次退款金额。','约 80m',NULL,0,NULL,'杭州市','临平区','杭州市临平区南苑街道 20 号 3 幢 101 室',30.4188000,120.2994000,'郑先生','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 4 DAY,'hidden','closed','unassigned','not_started','paid','pending_review','none','cancel_approved_pending_refund',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 4 DAY,NULL,NULL,NULL,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 HOUR,NULL,5,1,UTC_TIMESTAMP()-INTERVAL 4 DAY,UTC_TIMESTAMP()),\n('BXQB202608282469',@v204_customer_id,@v204_schema_id,@v204_qb,'墙布','墙布','用户拒绝加价后的施工争议','加价已拒绝并明确记录，双方协商未果后申请平台介入。','72.00㎡','3.10m',1,NULL,'杭州市','西湖区','杭州市西湖区留下街道 77 号 2 幢 602 室',30.2356000,120.0812000,'吴女士','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 5 DAY,'hidden','selected','accepted','in_progress','paid','none','open','active',135000,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 5 DAY,NULL,UTC_TIMESTAMP()-INTERVAL 4 DAY,NULL,NULL,NULL,NULL,NULL,NULL,8,1,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()),\n('BXQZ202608288315',@v204_customer_id,@v204_schema_id,@v204_qz,'墙纸','墙纸','七天未接受报价自动退款','用于检查宝塔计划任务自动取消和全额退款结果。','36.00㎡','2.70m',0,NULL,'杭州市','富阳区','杭州市富阳区富春街道 9 号 1 幢 201 室',30.0547000,119.9511000,'钱先生','13088880000','approved',NULL,UTC_TIMESTAMP()-INTERVAL 9 DAY,'hidden','closed','unassigned','not_started','refunded','succeeded','none','expired',0,5000,1000,5000,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP()-INTERVAL 2 DAY,NULL,NULL,NULL,NULL,NULL,UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP()-INTERVAL 1 DAY,4,1,UTC_TIMESTAMP()-INTERVAL 9 DAY,UTC_TIMESTAMP());\n\nINSERT INTO `order_categories` (`order_id`,`category_id`,`category_name_snapshot`,`sort_order`,`created_at`) SELECT id,category_id,category_name_snapshot,0,UTC_TIMESTAMP() FROM orders WHERE category_id IS NOT NULL;\nINSERT INTO `order_addresses` (`order_id`,`province`,`city`,`district`,`address_summary`,`address_ciphertext`,`contact_name_masked`,`contact_name_ciphertext`,`contact_mobile_masked`,`contact_mobile_ciphertext`,`lat`,`lng`,`coordinate_system`,`created_at`,`updated_at`) SELECT id,'浙江省',city,district,address_summary,address_summary,contact_name_masked,contact_name_masked,contact_mobile_masked,contact_mobile_masked,lat,lng,'GCJ-02',UTC_TIMESTAMP(),UTC_TIMESTAMP() FROM orders;\n\n-- 使用随升级包提供的三张压缩演示图，所有订单均有材料图和现场图，完工订单另有完工图。\nINSERT INTO `media_files` (`public_id`,`storage_disk`,`storage_key`,`mime_type`,`extension`,`size_bytes`,`width_px`,`height_px`,`sha256`,`compression_quality`,`status`,`reference_count`,`created_at`) VALUES\n(LEFT(SHA2('v204-material',256),26),'private_local','uploads/demo/order-material.jpg','image/jpeg','jpg',80804,900,675,'ab8fda1afebff029b6249570a4f7466150598cb4f20d6f092a585f74382fce51',82,'active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('v204-wall',256),26),'private_local','uploads/demo/order-wall.jpg','image/jpeg','jpg',41075,900,675,'baa9fbd644cf266126cd79c894ef44731010311b736ac072b47412b479f3543b',82,'active',0,UTC_TIMESTAMP()),\n(LEFT(SHA2('v204-completion',256),26),'private_local','uploads/demo/order-completion.jpg','image/jpeg','jpg',48207,900,675,'967ee65e75ca2d0c6d8f591ca856f476a5d2d88e57c41172431c885381d5675f',82,'active',0,UTC_TIMESTAMP())\nON DUPLICATE KEY UPDATE `status`='active',`pending_delete_at`=NULL,`deleted_at`=NULL;\nSET @v204_material=(SELECT id FROM media_files WHERE storage_key='uploads/demo/order-material.jpg' LIMIT 1);\nSET @v204_wall=(SELECT id FROM media_files WHERE storage_key='uploads/demo/order-wall.jpg' LIMIT 1);\nSET @v204_completion=(SELECT id FROM media_files WHERE storage_key='uploads/demo/order-completion.jpg' LIMIT 1);\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_at`) SELECT @v204_material,'order',id,'product',10,'system',UTC_TIMESTAMP() FROM orders;\nINSERT INTO `media_links` (`media_file_id`,`entity_type`,`entity_id`,`purpose`,`sort_order`,`created_by_type`,`created_at`) SELECT @v204_wall,'order',id,'wall',20,'system',UTC_TIMESTAMP() FROM orders;\n\n-- 报价中订单同时提供师傅报价和平台报价。\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v204-worker-',o.public_no),256),26),o.id,'worker',@v204_worker_id,NULL,88000,5000,CONCAT(@v204_worker_name,'报价：包含基础墙面检查和铺贴施工。'),'active',1,UTC_TIMESTAMP()-INTERVAL 18 HOUR,UTC_TIMESTAMP() FROM orders o WHERE o.public_no='BXQB202608289154';\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v204-platform-',o.public_no),256),26),o.id,'platform',@v204_admin_id,92000,5000,'平台报价：接受后由管理员邀请或安排师傅。','active',1,UTC_TIMESTAMP()-INTERVAL 16 HOUR,UTC_TIMESTAMP() FROM orders o WHERE o.public_no='BXQB202608289154';\n\nINSERT INTO `quotes` (`public_id`,`order_id`,`quote_type`,`worker_id`,`created_by_admin_id`,`amount_cents`,`booking_fee_cents`,`description`,`status`,`current_version`,`selected_at`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v204-selected-',o.public_no),256),26),o.id,IF(o.public_no='BXBLM202608283608','platform','worker'),IF(o.public_no='BXBLM202608283608',NULL,@v204_worker_id),IF(o.public_no='BXBLM202608283608',@v204_admin_id,NULL),o.final_amount_cents,o.booking_fee_cents,'2.0.4 已选择报价测试','selected',1,o.contact_revealed_at,o.created_at+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM orders o WHERE o.public_no IN ('BXBLM202608283608','BXCL202608287245','BXJJM202608281937','BXQZ202608286403','BXQB202608282469');\nINSERT INTO `quote_versions` (`quote_id`,`version_no`,`amount_cents`,`booking_fee_cents`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`rule_acknowledged_at`,`description`,`operator_type`,`operator_id`,`created_at`)\nSELECT q.id,1,q.amount_cents,q.booking_fee_cents,1000,5000,q.created_at,q.description,IF(q.quote_type='platform','admin','worker'),IF(q.quote_type='platform',@v204_admin_id,@v204_worker_id),q.created_at FROM quotes q;\nINSERT INTO `quote_selections` (`order_id`,`quote_id`,`quote_version_id`,`user_id`,`amount_cents_snapshot`,`booking_fee_cents_snapshot`,`status`,`selected_at`,`confirmed_at`)\nSELECT o.id,q.id,qv.id,@v204_customer_id,q.amount_cents,q.booking_fee_cents,'confirmed',q.selected_at,q.selected_at FROM orders o JOIN quotes q ON q.order_id=o.id AND q.status='selected' JOIN quote_versions qv ON qv.quote_id=q.id AND qv.version_no=1;\nINSERT INTO `commission_rule_versions` (`order_id`,`version_no`,`rate_bp`,`min_fee_cents`,`adjustment_type`,`adjustment_reason`,`created_by_admin_id`,`status`,`locked_at`,`created_at`)\nSELECT o.id,1,1000,5000,'default','2.0.4 测试订单服务费规则',@v204_admin_id,IF(o.public_no='BXBLM202608283608','active','locked'),IF(o.public_no='BXBLM202608283608',NULL,o.contact_revealed_at),o.created_at FROM orders o WHERE o.public_no IN ('BXBLM202608283608','BXCL202608287245','BXJJM202608281937','BXQZ202608286403','BXQB202608282469');\n\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`)\nSELECT CONCAT('PAY-V204-',RIGHT(o.public_no,4)),'order_booking',o.id,o.id,@v204_customer_id,'V204_CUSTOMER_OPENID','V204_APPID','V204_MCHID','v3','CNY',5000,IF(o.lifecycle_status='expired','refunded','paid'),CONCAT('V204_TX_',RIGHT(o.public_no,4)),'2.0.4 测试预约费，不是真实微信交易',o.created_at+INTERVAL 10 MINUTE,o.created_at,UTC_TIMESTAMP() FROM orders o;\n\nINSERT INTO `assignments` (`public_id`,`order_id`,`worker_id`,`quote_id`,`assignment_type`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`commission_rate_bp_snapshot`,`commission_min_cents_snapshot`,`estimated_commission_cents`,`estimated_offline_collect_cents`,`estimated_net_income_cents`,`status`,`offered_at`,`accepted_at`,`created_by_admin_id`,`created_at`,`updated_at`)\nSELECT LEFT(SHA2(CONCAT('v204-assignment-',o.public_no),256),26),o.id,@v204_worker_id,q.id,'worker_quote',crv.id,o.final_amount_cents,o.booking_fee_cents,1000,5000,GREATEST(ROUND(o.final_amount_cents*0.10),5000),o.final_amount_cents-o.booking_fee_cents,o.final_amount_cents-GREATEST(ROUND(o.final_amount_cents*0.10),5000),IF(o.fulfillment_status='accepted','completed','accepted'),o.created_at+INTERVAL 1 DAY,o.created_at+INTERVAL 1 DAY,@v204_admin_id,o.created_at+INTERVAL 1 DAY,UTC_TIMESTAMP()\nFROM orders o JOIN quotes q ON q.order_id=o.id AND q.status='selected' JOIN commission_rule_versions crv ON crv.order_id=o.id WHERE o.public_no IN ('BXCL202608287245','BXJJM202608281937','BXQZ202608286403','BXQB202608282469');\nUPDATE orders o JOIN quotes q ON q.order_id=o.id AND q.status='selected' LEFT JOIN commission_rule_versions crv ON crv.order_id=o.id LEFT JOIN assignments a ON a.order_id=o.id SET o.selected_quote_id=q.id,o.commission_rule_version_id=crv.id,o.current_assignment_id=a.id,o.assigned_worker_id=a.worker_id;\n\nSET @v204_platform_order=(SELECT id FROM orders WHERE public_no='BXBLM202608283608');\nSET @v204_platform_rule=(SELECT id FROM commission_rule_versions WHERE order_id=@v204_platform_order LIMIT 1);\nINSERT INTO `invite_tokens` (`order_id`,`token_hash`,`purpose`,`created_by_admin_id`,`commission_rule_version_id`,`status`,`max_claims`,`claim_count`,`expires_at`,`created_at`) VALUES (@v204_platform_order,SHA2('V204-TEST-INVITE-NOT-USABLE',256),'worker_assignment',@v204_admin_id,@v204_platform_rule,'active',1,0,UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\nINSERT INTO `share_contexts` (`order_id`,`context_type`,`token_hash`,`created_by_type`,`created_by_id`,`snapshot_json`,`status`,`expires_at`,`created_at`) VALUES (@v204_platform_order,'worker_invite',SHA2('V204-TEST-SHARE-NOT-USABLE',256),'admin',@v204_admin_id,'{\"share_type\":\"worker_invite\",\"test\":true}','active',UTC_TIMESTAMP()+INTERVAL 7 DAY,UTC_TIMESTAMP());\n\nSET @v204_scheduled=(SELECT id FROM orders WHERE public_no='BXCL202608287245');\nINSERT INTO `appointment_records` (`order_id`,`worker_id`,`appointment_at`,`note`,`status`,`created_at`,`updated_at`) VALUES (@v204_scheduled,@v204_worker_id,UTC_TIMESTAMP()+INTERVAL 1 DAY,'师傅电话联系后约定明日上午上门。','recorded',UTC_TIMESTAMP()-INTERVAL 1 DAY,UTC_TIMESTAMP());\n\nSET @v204_submitted=(SELECT id FROM orders WHERE public_no='BXJJM202608281937');\nSET @v204_submitted_assignment=(SELECT id FROM assignments WHERE order_id=@v204_submitted LIMIT 1);\nSET @v204_submitted_rule=(SELECT commission_rule_version_id FROM assignments WHERE id=@v204_submitted_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`version`,`created_at`,`updated_at`) VALUES (@v204_submitted,@v204_worker_id,'家具膜施工完成，现场已清理。','submitted',UTC_TIMESTAMP()-INTERVAL 12 HOUR,1,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP());\nINSERT INTO `offline_payment_delay_requests` (`order_id`,`worker_id`,`amount_cents_snapshot`,`reason`,`expected_collect_at`,`status`,`submitted_at`,`created_at`,`updated_at`) VALUES (@v204_submitted,@v204_worker_id,115000,'用户确认完工，但约定三天后支付线下尾款。',UTC_TIMESTAMP()+INTERVAL 3 DAY,'pending',UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP()-INTERVAL 10 HOUR,UTC_TIMESTAMP());\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`created_at`,`updated_at`) VALUES ('COM-V204-PENDING',@v204_submitted,@v204_worker_id,@v204_submitted_assignment,@v204_submitted_rule,120000,5000,1000,5000,12000,5000,7000,0,'pending',UTC_TIMESTAMP()+INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 12 HOUR,UTC_TIMESTAMP());\nINSERT INTO media_links(media_file_id,entity_type,entity_id,purpose,sort_order,created_by_type,created_by_id,created_at) VALUES (@v204_completion,'order',@v204_submitted,'completion',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 12 HOUR),(@v204_material,'order',@v204_submitted,'collection_receipt',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 11 HOUR);\n\nSET @v204_done=(SELECT id FROM orders WHERE public_no='BXQZ202608286403');\nSET @v204_done_assignment=(SELECT id FROM assignments WHERE order_id=@v204_done LIMIT 1);\nSET @v204_done_rule=(SELECT commission_rule_version_id FROM assignments WHERE id=@v204_done_assignment);\nINSERT INTO `completion_submissions` (`order_id`,`worker_id`,`description`,`status`,`submitted_at`,`accepted_at`,`accepted_type`,`version`,`created_at`,`updated_at`) VALUES (@v204_done,@v204_worker_id,'墙纸施工完成，用户已验收。','accepted',UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,'auto_72h',1,UTC_TIMESTAMP()-INTERVAL 8 DAY,UTC_TIMESTAMP());\nINSERT INTO `commission_receivables` (`public_no`,`order_id`,`worker_id`,`assignment_id`,`commission_rule_version_id`,`final_amount_cents_snapshot`,`booking_fee_cents_snapshot`,`rate_bp_snapshot`,`min_fee_cents_snapshot`,`gross_commission_cents`,`booking_fee_offset_cents`,`amount_due_cents`,`amount_paid_cents`,`status`,`due_at`,`settled_at`,`created_at`,`updated_at`) VALUES ('COM-V204-SETTLED',@v204_done,@v204_worker_id,@v204_done_assignment,@v204_done_rule,95000,5000,1000,5000,9500,5000,4500,4500,'settled',UTC_TIMESTAMP()-INTERVAL 3 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 6 DAY,UTC_TIMESTAMP());\nSET @v204_receivable_done=LAST_INSERT_ID();\nINSERT INTO `payment_orders` (`public_no`,`business_type`,`business_id`,`order_id`,`payer_user_id`,`payer_openid`,`app_id`,`mch_id`,`api_version`,`currency`,`amount_cents`,`status`,`wechat_transaction_id`,`description`,`paid_at`,`created_at`,`updated_at`) VALUES ('PAY-V204-COMMISSION','commission',@v204_receivable_done,@v204_done,@v204_worker_user_id,'V204_WORKER_OPENID','V204_APPID','V204_MCHID','v3','CNY',4500,'paid','V204_TX_COMMISSION','2.0.4 测试平台服务费',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP());\nSET @v204_commission_payment=LAST_INSERT_ID();\nINSERT INTO `commission_payments` (`receivable_id`,`payment_order_id`,`amount_cents`,`status`,`paid_at`,`created_at`) VALUES (@v204_receivable_done,@v204_commission_payment,4500,'paid',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_TIMESTAMP()-INTERVAL 5 DAY);\nINSERT INTO media_links(media_file_id,entity_type,entity_id,purpose,sort_order,created_by_type,created_by_id,created_at) VALUES (@v204_completion,'order',@v204_done,'completion',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 8 DAY),(@v204_material,'order',@v204_done,'collection_receipt',10,'worker',@v204_worker_id,UTC_TIMESTAMP()-INTERVAL 7 DAY);\nINSERT INTO `reviews` (`public_id`,`order_id`,`user_id`,`worker_id`,`rating`,`content`,`is_auto`,`status`,`reviewed_at`,`created_at`,`updated_at`) VALUES (LEFT(SHA2('v204-review',256),26),@v204_done,@v204_customer_id,@v204_worker_id,5,'师傅沟通及时，施工细致，完工效果满意。',0,'visible',UTC_TIMESTAMP()-INTERVAL 5 DAY,UTC_