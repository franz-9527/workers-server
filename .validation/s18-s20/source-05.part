storyCursor=g.history.sign(c)}\n for i,j:=0,len(out.Messages)-1;i<j;i,j=i+1,j-1{out.Messages[i],out.Messages[j]=out.Messages[j],out.Messages[i]}\n views:=make([]*MessageView,0,len(out.Messages));for i:=range out.Messages{views=append(views,&out.Messages[i])}\n if err=hydrateImages(ctx,tx,views);err!=nil{return out,err}\n if err=hydrateReferenceScope(ctx,tx,p,ports.Grant{},q.ConversationID,views,true);err!=nil{return out,err}\n if err=governanceLog(ctx,tx,p,\"audit.history\",q.ConversationID,q.TargetID,\"\",version,\"\");err!=nil{return out,err}\n if err=g.commit(tx,p);err!=nil{return out,err};return out,nil\n}\nfunc(g *GovernanceService) AuditImage(ctx context.Context,p ports.Principal,cid,mid,item ports.ID,thumb bool)(string,error){\n if g.media==nil||!validID(cid)||!validID(mid)||!validID(item){return \"\",ports.ErrInvalid}\n tx,err:=g.base.begin(ctx);if err!=nil{return \"\",err};defer tx.Rollback()\n if err=g.admin(ctx,tx,p,\"chat:audit\");err!=nil{return \"\",err}\n var id ports.ID\n if tx.QueryRowContext(ctx,`SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`,string(cid)).Scan(&id)!=nil{return \"\",ErrResync}\n col:=\"u.main_key\";if thumb{col=\"u.thumb_key\"};var key string;var version ports.ID\n if tx.QueryRowContext(ctx,`SELECT `+col+`,CAST(m.state_version AS CHAR) FROM chat_messages m JOIN chat_image_items i ON i.message_id=m.id JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE m.conversation_id=? AND m.id=? AND i.item_id=? AND m.state='published' AND `+retainedTarget,string(cid),string(mid),string(item)).Scan(&key,&version)!=nil||key==\"\"{return \"\",ErrMedia}\n url,err:=g.media.storage.Sign(ctx,key,60*time.Second);if err!=nil{return \"\",ErrMedia}\n if err=governanceLog(ctx,tx,p,\"audit.image\",cid,mid,item,version,\"\");err!=nil{return \"\",err};if err=g.commit(tx,p);err!=nil{return \"\",err};return url,nil\n}\n","chat/internal/message/restrictions.go":"package message\n\nimport(\"context\";\"database/sql\";\"time\";\"github.com/franz-9527/workers/chat/internal/auth\";\"github.com/franz-9527/workers/chat/internal/ports\")\n\ntype Restriction struct{Actor ports.ID `json:\"actor_id\"`;Version ports.ID `json:\"version\"`;Permanent bool `json:\"permanent\"`;Until *time.Time `json:\"blocked_until,omitempty\"`;Blocked bool `json:\"blocked\"`;ConfirmedRisks uint64 `json:\"confirmed_risks\"`}\ntype RestrictionRequest struct{Actor ports.ID `json:\"actor_id\"`;Expected ports.ID `json:\"expected_version\"`;Action string `json:\"action\"`;Seconds int `json:\"seconds,omitempty\"`;Reason string `json:\"reason\"`}\nfunc restrictionLocked(ctx context.Context,tx *sql.Tx,id ports.ID)(Restriction,error){\n if _,err:=tx.ExecContext(ctx,`INSERT INTO chat_restrictions(actor_id,version,updated_at) VALUES(?,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`,string(id));err!=nil{return Restriction{},ports.ErrUnavailable}\n out:=Restriction{Actor:id};var until sql.NullTime\n if tx.QueryRowContext(ctx,`SELECT CAST(version AS CHAR),permanent,blocked_until,(permanent=1 OR blocked_until>UTC_TIMESTAMP(6)) IS TRUE FROM chat_restrictions WHERE actor_id=? FOR UPDATE`,string(id)).Scan(&out.Version,&out.Permanent,&until,&out.Blocked)!=nil{return out,ports.ErrUnavailable}\n if until.Valid{v:=until.Time;out.Until=&v}\n if tx.QueryRowContext(ctx,`SELECT COUNT(*) FROM chat_risk_events WHERE sender_id=? AND confirmed=1 AND review_state<>'corrected'`,string(id)).Scan(&out.ConfirmedRisks)!=nil{return out,ports.ErrUnavailable};return out,nil\n}\nfunc(g *GovernanceService) Restriction(ctx context.Context,p ports.Principal,actor ports.ID)(Restriction,error){\n if !validID(actor){return Restriction{},ports.ErrInvalid}\n tx,err:=g.base.begin(ctx);if err!=nil{return Restriction{},err};defer tx.Rollback()\n if p.Kind==\"mini\"&&p.ActorID==actor&&p.Environment==g.environment{err=g.source.ValidatePrincipalLocked(ctx,tx,p)}else{err=g.admin(ctx,tx,p,\"chat:moderate\")};if err!=nil{return Restriction{},err}\n out,err:=restrictionLocked(ctx,tx,actor);if err!=nil{return out,err};if err=g.commit(tx,p);err!=nil{return out,err};return out,nil\n}\nfunc(g *GovernanceService) Restrict(ctx context.Context,p ports.Principal,q RestrictionRequest)(Restriction,error){\n if !validID(q.Actor)||!q.Expected.Valid()||!reasonValid(q.Reason)||q.Action!=\"unban\"&&q.Action!=\"permanent\"&&q.Action!=\"timed\"||q.Action==\"timed\"&&(q.Seconds<60||q.Seconds>30*86400)||q.Action!=\"timed\"&&q.Seconds!=0{return Restriction{},ports.ErrInvalid}\n tx,err:=g.base.begin(ctx);if err!=nil{return Restriction{},err};defer tx.Rollback()\n if err=g.admin(ctx,tx,p,\"chat:moderate\");err!=nil{return Restriction{},err}\n var actor ports.ID;if tx.QueryRowContext(ctx,`SELECT CAST(id AS CHAR) FROM users WHERE id=? LOCK IN SHARE MODE`,string(q.Actor)).Scan(&actor)!=nil{return Restriction{},auth.ErrUnauthorized}\n out,err:=restrictionLocked(ctx,tx,q.Actor);if err!=nil{return out,err};if out.Version!=q.Expected{return out,ErrPreferenceConflict}\n if _,err=tx.ExecContext(ctx,`UPDATE chat_restrictions SET permanent=?,blocked_until=IF(?='timed',TIMESTAMPADD(SECOND,?,UTC_TIMESTAMP(6)),NULL),version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`,q.Action==\"permanent\",q.Action,q.Seconds,string(q.Actor));err!=nil{return out,ports.ErrUnavailable}\n if err=governanceLog(ctx,tx,p,\"restriction.\"+q.Action,\"\",q.Actor,\"\",decimal(number(out.Version)+1),q.Reason);err!=nil{return out,err}\n out,err=restrictionLocked(ctx,tx,q.Actor);if err!=nil{return out,err};if err=g.commit(tx,p);err!=nil{return out,err};return out,nil\n}\n// Ban expiry uses the permanent stable row, exactly as send and manual unban.\nfunc(g *GovernanceService) ExpireRestrictions(ctx context.Context)error{\n tx,err:=g.base.begin(ctx);if err!=nil{return err};defer tx.Rollback()\n rows,err:=tx.QueryContext(ctx,`SELECT CAST(actor_id AS CHAR) FROM chat_restrictions WHERE permanent=0 AND blocked_until<=UTC_TIMESTAMP(6) ORDER BY actor_id LIMIT 50 FOR UPDATE`);if err!=nil{return ports.ErrUnavailable}\n ids:=[]ports.ID{};for rows.Next(){var id ports.ID;if rows.Scan(&id)!=nil{rows.Close();return ports.ErrUnavailable};ids=append(ids,id)};err=rows.Err();rows.Close();if err!=nil{return ports.ErrUnavailable}\n for _,id:=range ids{\n  if _,err=tx.ExecContext(ctx,`INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,target_id,target_version,reason,created_at) SELECT 'system',0,REPEAT('0',64),'restriction.expire',actor_id,version+1,'限时禁聊到期',UTC_TIMESTAMP(6) FROM chat_restrictions WHERE actor_id=?`,string(id));err!=nil{return ports.ErrUnavailable}\n  if _,err=tx.ExecContext(ctx,`UPDATE chat_restrictions SET blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`,string(id));err!=nil{return ports.ErrUnavailable}\n }\n if tx.Commit()!=nil{return ports.ErrUnavailable};return nil\n}\n","chat/internal/message/cases.go":"package message\n\nimport(\"context\";\"database/sql\";\"time\";\"github.com/franz-9527/workers/chat/internal/ports\")\ntype Case struct{ID ports.ID `json:\"case_id\"`;Kind string `json:\"kind\"`;TargetType string `json:\"target_type\"`;Target ports.ID `json:\"target_id\"`;Item ports.ID `json:\"item_id\"`;Conversation ports.ID `json:\"conversation_id\"`;Reporter ports.ID `json:\"reporter_id\"`;Subject ports.ID `json:\"subject_id\"`;Version ports.ID `json:\"version\"`;State string `json:\"state\"`;Reason string `json:\"reason\"`;Resolution string `json:\"resolution\"`;Created time.Time `json:\"created_at\"`;Fingerprint string `json:\"fingerprint\"`;TargetVersion ports.ID `json:\"target_version\"`}\nconst caseColumns=`CAST(id AS CHAR),kind,target_type,CAST(target_id AS CHAR),CAST(item_id AS CHAR),CAST(conversation_id AS CHAR),CAST(reporter_id AS CHAR),CAST(subject_id AS CHAR),CAST(version AS CHAR),state,reason,COALESCE(resolution,''),created_at,fingerprint,CAST(target_version AS CHAR)`\ntype CasePage struct{Items []Case `json:\"items\"`;After ports.ID `json:\"next_after\"`;More bool `json:\"has_more\"`}\nfunc scanCase(row interface{Scan(...any)error})(Case,error){var c Case;err:=row.Scan(&c.ID,&c.Kind,&c.TargetType,&c.Target,&c.Item,&c.Conversation,&c.Reporter,&c.Subject,&c.Version,&c.State,&c.Reason,&c.Resolution,&c.Created,&c.Fingerprint,&c.TargetVersion);if err!=nil{return c,ports.ErrUnavailable};return c,nil}\nfunc createCase(ctx context.Context,tx *sql.Tx,kind,targetType string,target,item,cid,reporter,subject,version ports.ID,fp,reason string)(ports.ID,error){\n var id ports.ID\n err:=tx.QueryRowContext(ctx,`SELECT CAST(id AS CHAR) FROM chat_cases WHERE kind=? AND target_type=? AND target_id=? AND item_id=? AND reporter_id=?`,kind,targetType,string(target),string(item),string(reporter)).Scan(&id)\n if err==nil{return id,nil};if err!=sql.ErrNoRows{return \"\",ports.ErrUnavailable}\n var n int;if tx.QueryRowContext(ctx,`SELECT COUNT(*) FROM chat_cases WHERE reporter_id=? AND created_at>UTC_TIMESTAMP()-INTERVAL 1 DAY`,string(reporter)).Scan(&n)!=nil{return \"\",ports.ErrUnavailable};if n>=20&&kind!=\"review\"{return \"\",ports.ErrBusy}\n r,err:=tx.ExecContext(ctx,`INSERT INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,'pending',1,UTC_TIMESTAMP(6)+INTERVAL 30 DAY,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE id=LAST_INSERT_ID(id)`,kind,targetType,string(target),string(item),string(cid),string(reporter),string(subject),string(version),fp,reason)\n if err!=nil{return \"\",ports.ErrUnavailable};n64,err:=r.LastInsertId();if err!=nil{return \"\",ports.ErrUnavailable};return decimal(uint64(n64)),nil\n}\nfunc(g *GovernanceService) Report(ctx context.Context,p ports.Principal,cid,mid,item ports.ID,reason string)(ports.ID,error){\n if !validID(cid)||!validID(mid)||item!=\"\"&&!validID(item)||!reasonValid(reason){return \"\",ports.ErrInvalid};if item==\"\"{item=\"0\"}\n tx,err:=g.base.begin(ctx);if err!=nil{return \"\",err};defer tx.Rollback()\n authority,err:=g.base.conversations.LockAuthority(ctx,tx,ports.PolicyRequest{Actor:p,ConversationID:cid,Action:\"read\"});if err!=nil{return \"\",err}\n if _,err=restrictionLocked(ctx,tx,p.ActorID);err!=nil{return \"\",err}\n grant,err:=g.base.conversations.LockProjection(ctx,tx,authority);if err!=nil{return \"\",err}\n var subject,version ports.ID;var fp string\n if tx.QueryRowContext(ctx,`SELECT CAST(m.sender_id AS CHAR),CAST(m.state_version AS CHAR),SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn,string(cid),string(mid),string(grant.Version),string(p.ActorID)).Scan(&subject,&version,&fp)!=nil{return \"\",ErrResync}\n if item!=\"0\"{var n int;if tx.QueryRowContext(ctx,`SELECT COUNT(*) FROM chat_image_items WHERE message_id=? AND item_id=?`,string(mid),string(item)).Scan(&n)!=nil||n!=1{return \"\",ErrMedia}}\n id,err:=createCase(ctx,tx,\"report\",\"message\",mid,item,cid,p.ActorID,subject,version,fp,reason);if err!=nil{return \"\",err}\n if _,err=tx.ExecContext(ctx,`UPDATE chat_image_uploads u JOIN chat_image_items i ON i.item_id=u.id SET u.legal_hold=1 WHERE i.message_id=?`,string(mid));err!=nil{return \"\",ports.ErrUnavailable}\n if err=governanceLog(ctx,tx,p,\"case.report\",cid,id,item,version,reason);err!=nil{return \"\",err};if err=g.commit(tx,p);err!=nil{return \"\",err};return id,nil\n}\nfunc(g *GovernanceService) Appeal(ctx context.Context,p ports.Principal,targetType string,target,expected ports.ID,reason string)(ports.ID,error){\n if !validID(target)||!expected.Valid()||!reasonValid(reason)||targetType!=\"risk\"&&targetType!=\"image_intent\"&&targetType!=\"restriction\"||p.Environment!=g.environment{return \"\",ports.ErrInvalid}\n tx,err:=g.base.begin(ctx);if err!=nil{return \"\",err};defer tx.Rollback()\n if err=g.source.ValidatePrincipalLocked(ctx,tx,p);err!=nil{return \"\",err}\n status,err:=restrictionLocked(ctx,tx,p.ActorID);if err!=nil{return \"\",err}\n cid,subject,version,fp:=ports.ID(\"0\"),p.ActorID,ports.ID(\"1\"),\"\"\n switch targetType{\n case \"risk\":\n  if tx.QueryRowContext(ctx,`SELECT CAST(conversation_id AS CHAR),content_fingerprint FROM chat_risk_events WHERE id=? AND sender_id=? AND retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`,string(target),string(p.ActorID)).Scan(&cid,&fp)!=nil{return \"\",ErrResync}\n case \"image_intent\":\n  if tx.QueryRowContext(ctx,`SELECT CAST(i.conversation_id AS CHAR),b.manifest_hash,CAST(b.review_version AS CHAR) FROM chat_send_intents i JOIN chat_image_bundles b ON b.intent_id=i.id WHERE i.id=? AND i.sender_id=? AND i.state='rejected' AND i.retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`,string(target),string(p.ActorID)).Scan(&cid,&fp,&version)!=nil{return \"\",ErrResync}\n case \"restriction\":\n  if target!=p.ActorID||status.Version!=expected||!status.Blocked{return \"\",ErrResync};version=status.Version;fp=memberHash(string(p.ActorID)+\":\"+string(version))\n }\n if targetType!=\"restriction\"&&version!=expected{return \"\",ErrResync}\n id,err:=createCase(ctx,tx,\"appeal\",targetType,target,\"0\",cid,p.ActorID,subject,version,fp,reason);if err!=nil{return \"\",err}\n if targetType==\"image_intent\"{\n  items,e:=caseImageItems(ctx,tx,Case{TargetType:targetType,Target:target,Fingerprint:fp});if e!=nil{return \"\",e}\n  for _,v:=range items{if _,err=tx.ExecContext(ctx,`UPDATE chat_image_uploads SET legal_hold=1 WHERE id=? AND actor_id=? AND conversation_id=?`,string(v.ItemID),string(p.ActorID),string(cid));err!=nil{return \"\",ports.ErrUnavailable}}\n }\n if err=governanceLog(ctx,tx,p,\"case.appeal\",cid,id,\"\",version,reason);err!=nil{return \"\",err};if err=g.commit(tx,p);err!=nil{return \"\",err};return id,nil\n}\nfunc(g *GovernanceService) Cases(ctx context.Context,p ports.Principal,after ports.ID,admin bool)(CasePage,error){\n if after==\"\"{after=\"0\"};if !after.Valid(){return CasePage{},ports.ErrInvalid}\n tx,err:=g.base.begin(ctx);if err!=nil{return CasePage{},err};defer tx.Rollback()\n if admin{err=g.admin(ctx,tx,p,\"chat:moderate\")}else if p.Environment==g.environment{err=g.source.ValidatePrincipalLocked(ctx,tx,p)}else{err=ports.ErrInvalid};if err!=nil{return CasePage{},err}\n query:=`SELECT `+caseColumns+` FROM chat_cases WHERE id>?`;args:=[]any{string(after)}\n if !admin{query+=` AND reporter_id=?`;args=append(args,string(p.ActorID))}\n query+=` ORDER BY id LIMIT 21`\n rows,err:=tx.QueryContext(ctx,query,args...);if err!=nil{return CasePage{},ports.ErrUnavailable}\n out:=CasePage{Items:[]Case{},After:after}\n for rows.Next(){c,e:=scanCase(rows);if e!=nil{rows.Close();return out,e};if !admin{c.Fingerprint=\"\";c.Subject=\"0\"};out.Items=append(out.Items,c)}\n err=rows.Err();rows.Close();if err!=nil{return out,ports.ErrUnavailable};if len(out.Items)>20{out.More=true;out.Items=out.Items[:20]};if len(out.Items)>0{out.After=out.Items[len(out.Items)-1].ID}\n if admin{if err=governanceLog(ctx,tx,p,\"case.list\",\"\",\"\",\"\",\"\",\"\");err!=nil{return out,err}}\n if err=g.commit(tx,p);err!=nil{return out,err};return out,nil\n}\n","chat/internal/message/case_review.go":"package message\n\nimport(\"context\";\"database/sql\";\"encoding/json\";\"time\";\"github.com/franz-9527/workers/chat/internal/ports\")\n\ntype Evidence struct{Case Case `json:\"case\"`;Text *string `json:\"text,omitempty\"`;Context *string `json:\"context,omitempty\"`;Items []ImageView `json:\"items\"`;Unavailable bool `json:\"unavailable\"`;URL string `json:\"url,omitempty\"`}\nfunc(g *GovernanceService) caseLock(ctx context.Context,tx *sql.Tx,id ports.ID)(Case,error){\n var cid,subject ports.ID\n if tx.QueryRowContext(ctx,`SELECT CAST(conversation_id AS CHAR),CAST(subject_id AS CHAR) FROM chat_cases WHERE id=?`,string(id)).Scan(&cid,&subject)!=nil{return Case{},ErrResync}\n // Same actor -> conversation order used by send, ban and publication.\n if _,err:=restrictionLocked(ctx,tx,subject);err!=nil{return Case{},err}\n if cid!=\"0\"{var found ports.ID;if tx.QueryRowContext(ctx,`SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? FOR UPDATE`,string(cid)).Scan(&found)!=nil{return Case{},ErrResync}}\n return scanCase(tx.QueryRowContext(ctx,`SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`,string(id)))\n}\nfunc caseImageItems(ctx context.Context,tx *sql.Tx,c Case)([]ImageView,error){\n items:=[]ImageView{}\n if c.TargetType==\"message\"{\n  query:=`SELECT CAST(i.item_id AS CHAR),i.ordinal,u.width_px,u.height_px FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=?`;args:=[]any{string(c.Target)}\n  if c.Item!=\"0\"{query+=` AND i.item_id=?`;args=append(args,string(c.Item))};query+=` ORDER BY i.ordinal LIMIT 9`\n  rows,err:=tx.QueryContext(ctx,query,args...);if err!=nil{return nil,ports.ErrUnavailable};for rows.Next(){var v ImageView;if rows.Scan(&v.ItemID,&v.Ordinal,&v.Width,&v.Height)!=nil{rows.Close();return nil,ports.ErrUnavailable};items=append(items,v)};err=rows.Err();rows.Close();if err!=nil{return nil,ports.ErrUnavailable}\n }else if c.TargetType==\"image_intent\"{\n  var raw,fp string\n  if tx.QueryRowContext(ctx,`SELECT manifest_json,manifest_hash FROM chat_image_bundles WHERE intent_id=?`,string(c.Target)).Scan(&raw,&fp)!=nil||fp!=c.Fingerprint{return nil,ErrMediaVersion}\n  var q Request;if json.Unmarshal([]byte(raw),&q)!=nil||len(q.Items)<1||len(q.Items)>9{return nil,ports.ErrUnavailable}\n  for _,v:=range q.Items{items=append(items,ImageView{ItemID:v.AttachmentID,Ordinal:v.Ordinal})}\n }\n return items,nil\n}\nfunc(g *GovernanceService) Evidence(ctx context.Context,p ports.Principal,id,expected,item ports.ID,reason string)(Evidence,error){\n if !validID(id)||!validID(expected)||item!=\"\"&&!validID(item)||!reasonValid(reason){return Evidence{},ports.ErrInvalid}\n tx,err:=g.base.begin(ctx);if err!=nil{return Evidence{},err};defer tx.Rollback()\n if err=g.admin(ctx,tx,p,\"chat:evidence\");err!=nil{return Evidence{},err}\n c,err:=g.caseLock(ctx,tx,id);if err!=nil{return Evidence{},err};if c.Version!=expected{return Evidence{},ErrMediaVersion}\n out:=Evidence{Case:c,Items:[]ImageView{}}\n switch c.TargetType{\n case \"risk\":\n  var text,context,fp string\n  if tx.QueryRowContext(ctx,`SELECT text_evidence,context_evidence,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6)`,string(c.Target)).Scan(&text,&context,&fp)!=nil||fp!=c.Fingerprint{out.Unavailable=true}else{out.Text=&text;out.Context=&context}\n case \"message\":\n  var text sql.NullString;var fp string\n  if tx.QueryRowContext(ctx,`SELECT m.text_body,SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.id=? AND m.conversation_id=? AND `+retainedTarget,string(c.Target),string(c.Conversation)).Scan(&text,&fp)!=nil||fp!=c.Fingerprint{out.Unavailable=true}else if text.Valid{out.Text=&text.String}\n case \"restriction\":\n  out.Unavailable=false\n case \"image_intent\":\n default:return out,ports.ErrInvalid\n }\n out.Items,err=caseImageItems(ctx,tx,c);if err!=nil{return out,err}\n if item!=\"\"{\n  found:=false;for _,v:=range out.Items{if v.ItemID==item{found=true}};if !found||g.media==nil{return out,ErrMedia}\n  var key string\n  if c.TargetType==\"message\"{\n   err=tx.QueryRowContext(ctx,`SELECT u.main_key FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=? AND i.item_id=?`,string(c.Target),string(item)).Scan(&key)\n  }else{\n   var raw string;if tx.QueryRowContext(ctx,`SELECT manifest_json FROM chat_image_bundles WHERE intent_id=?`,string(c.Target)).Scan(&raw)!=nil{return out,ErrMedia};var q Request;json.Unmarshal([]byte(raw),&q);version:=\"\";for _,v:=range q.Items{if v.AttachmentID==item{version=v.ObjectVersion}}\n   err=tx.QueryRowContext(ctx,`SELECT main_key FROM chat_image_uploads WHERE id=? AND object_version=? AND legal_hold=1`,string(item),version).Scan(&key)\n  }\n  if err!=nil||key==\"\"{out.Unavailable=true}else{out.URL,err=g.media.storage.Sign(ctx,key,60*time.Second);if err!=nil{return out,ErrMedia}}\n }\n action:=\"case.evidence\";if out.Unavailable{action=\"evidence.unavailable\"};if item!=\"\"&&out.URL==\"\"{action=\"evidence.unavailable\"}\n if err=governanceLog(ctx,tx,p,action,c.Conversation,c.ID,item,c.Version,reason);err!=nil{return out,err}\n if err=g.commit(tx,p);err!=nil{return out,err};return out,nil\n}\ntype CaseDecision struct{ID ports.ID `json:\"case_id\"`;Expected ports.ID `json:\"expected_version\"`;Action string `json:\"action\"`;Reason string `json:\"reason\"`}\nfunc(g *GovernanceService) Decide(ctx context.Context,p ports.Principal,q CaseDecision)(Case,error){\n if !validID(q.ID)||!validID(q.Expected)||!reasonValid(q.Reason)||q.Action!=\"confirm\"&&q.Action!=\"correct\"&&q.Action!=\"dismiss\"&&q.Action!=\"block\"{return Case{},ports.ErrInvalid}\n tx,err:=g.base.begin(ctx);if err!=nil{return Case{},err};defer tx.Rollback()\n if err=g.admin(ctx,tx,p,\"chat:moderate\");err!=nil{return Case{},err}\n c,err:=g.caseLock(ctx,tx,q.ID);if err!=nil{return c,err}\n if c.Version!=q.Expected||c.State!=\"pending\"{return c,ErrMediaVersion}\n var n int\n if tx.QueryRowContext(ctx,`SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id IS NULL AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`,p.Kind,string(p.ActorID),bindingFor(g.environment,p),string(c.ID),string(c.Version)).Scan(&n)!=nil||n==0{return c,ErrMedia}\n // A visible metadata list or thumbnail cannot satisfy full image evidence.\n items,err:=caseImageItems(ctx,tx,c);if err!=nil{return c,err}\n for _,v:=range items{if tx.QueryRowContext(ctx,`SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id=? AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`,p.Kind,string(p.ActorID),bindingFor(g.environment,p),string(c.ID),string(c.Version),string(v.ItemID)).Scan(&n)!=nil||n==0{return c,ErrMedia}}\n switch c.TargetType{\n case \"risk\":\n  var riskState,fp string\n  if tx.QueryRowContext(ctx,`SELECT review_state,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`,string(c.Target)).Scan(&riskState,&fp)!=nil||fp!=c.Fingerprint{return c,ErrResync}\n  if riskState==\"corrected\"&&q.Action==\"confirm\"{return c,ErrMediaVersion}\n  if q.Action==\"block\"{return c,ports.ErrInvalid}\n  if q.Action==\"correct\"{\n   if _,err=tx.ExecContext(ctx,`UPDATE chat_risk_events SET confirmed=0,review_state='corrected' WHERE id=? AND content_fingerprint=?`,string(c.Target),c.Fingerprint);err!=nil{return c,ports.ErrUnavailable}\n  }else if q.Action==\"confirm\"{\n   if _,err=tx.ExecContext(ctx,`UPDATE chat_risk_events SET confirmed=1,review_state='confirmed' WHERE id=? AND content_fingerprint=? AND review_state<>'corrected'`,string(c.Target),c.Fingerprint);err!=nil{return c,ports.ErrUnavailable}\n  }\n  if q.Action==\"correct\"||q.Action==\"confirm\"{\n   code:=\"CHAT_CONTENT_BLOCKED\";if q.Action==\"correct\"{code=\"CHAT_REVIEW_CORRECTED\"}\n   if _,err=tx.ExecContext(ctx,`UPDATE chat_send_intents SET state='rejected',error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE risk_event_id=? AND state IN ('review_pending','rejected')`,code,string(c.Target));err!=nil{return c,ports.ErrUnavailable}\n  }\n  // No send-intent or message is resurrected by a successful appeal.\n case \"restriction\":\n  if q.Action==\"block\"{return c,ports.ErrInvalid}\n  if q.Action==\"correct\"{\n   r,err:=restrictionLocked(ctx,tx,c.Subject);if err!=nil{return c,err};if r.Version!=c.TargetVersion{return c,ErrMediaVersion}\n   if _,err=tx.ExecContext(ctx,`UPDATE chat_restrictions SET permanent=0,blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`,string(c.Subject));err!=nil{return c,ports.ErrUnavailable}\n  }\n case \"message\":\n  if q.Action==\"block\"{\n   var state string;var version,seq uint64\n   if tx.QueryRowContext(ctx,`SELECT state,state_version,seq FROM chat_messages WHERE id=? AND conversation_id=? FOR UPDATE`,string(c.Target),string(c.Conversation)).Scan(&state,&version,&seq)!=nil{return c,ErrResync}\n   if state==\"published\"{\n    if _,err=tx.ExecContext(ctx,`UPDATE chat_conversations SET last_change_seq=last_change_seq+1 WHERE id=?`,string(c.Conversation));err!=nil{return c,ports.ErrUnavailable}\n    if _,err=tx.ExecContext(ctx,`UPDATE chat_messages SET state='blocked',state_version=state_version+1 WHERE id=?`,string(c.Target));err!=nil{return c,ports.ErrUnavailable}\n    if _,err=tx.ExecContext(ctx,`INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT id,last_change_seq,?,?, 'message.blocked',UTC_TIMESTAMP(6) FROM chat_conversations WHERE id=?`,string(c.Target),version+1,string(c.Conversation));err!=nil{return c,ports.ErrUnavailable}\n   }\n  }\n case \"image_intent\":\n  if q.Action==\"block\"{return c,ports.ErrInvalid}\n  // Only the governance result changes. Old rejected manifests stay rejected.\n default:return c,ports.ErrInvalid\n }\n if _,err=tx.ExecContext(ctx,`UPDATE chat_cases SET state=?,version=version+1,resolution=?,reviewer_id=?,decided_at=UTC_TIMESTAMP(6) WHERE id=?`,q.Action,q.Reason,string(p.ActorID),string(c.ID));err!=nil{return c,ports.ErrUnavailable}\n if err=governanceLog(ctx,tx,p,\"case.\"+q.Action,c.Conversation,c.ID,c.Item,decimal(number(c.Version)+1),q.Reason);err!=nil{return c,err}\n c.State=q.Action;c.Resolution=q.Reason;c.Version=decimal(number(c.Version)+1)\n if err=g.commit(tx,p);err!=nil{return c,err}\n if q.Action==\"block\"&&g.base.publisher!=nil{g.base.publisher.Committed(ports.CommittedMessage{ConversationID:c.Conversation})}\n return c,nil\n}\n","chat/internal/policy/recipient.go":"package policy\nimport(\"context\";\"database/sql\";\"github.com/franz-9527/workers/chat/internal/ports\")\n// Internal notification eligibility uses current PHP business authority and\n// account status. It does not fabricate a logged-in user or online presence.\nfunc(r *Reader) RecipientLocked(ctx context.Context,tx *sql.Tx,scope string,actor ports.ID)(Projection,ports.Grant,error){\n p,err:=r.CurrentLocked(ctx,tx,scope);if err!=nil{return p,ports.Grant{},err}\n if err=r.CheckEpochsLocked(ctx,tx,p,actor,\"read\");err!=nil{return p,ports.Grant{},err}\n var active bool\n err=tx.QueryRowContext(ctx,`SELECT status='active' FROM users WHERE id=? LOCK IN SHARE MODE`,string(actor)).Scan(&active)\n if err==sql.ErrNoRows{return p,ports.Grant{},ErrDenied};if err!=nil{return p,ports.Grant{},ports.ErrUnavailable};if !active{return p,ports.Grant{},ErrDenied}\n for _,m:=range p.Members{if m.ActorID==actor&&m.Grant.CanRead{return p,m.Grant,nil}}\n return p,ports.Grant{},ErrDenied\n}\n","chat/internal/conversation/reminders.go":"package conversation\nimport(\"context\";\"database/sql\";\"time\";\"github.com/franz-9527/workers/chat/internal/ports\";\"github.com/franz-9527/workers/chat/internal/policy\")\n// Server-side only: not an impersonation API and never grants send permission.\nfunc(s *Store) RecipientLocked(ctx context.Context,tx *sql.Tx,cid,actor ports.ID)(ports.Grant,error){\n if !positive(cid)||!positive(actor){return ports.Grant{},policy.ErrDenied}\n var scope,kind string;if tx.QueryRowContext(ctx,`SELECT scope_key,conversation_type FROM chat_conversations WHERE id=?`,string(cid)).Scan(&scope,&kind)!=nil||kind!=\"order\"{return ports.Grant{},policy.ErrDenied}\n projection,grant,err:=s.reader.RecipientLocked(ctx,tx,scope,actor);if err!=nil{return ports.Grant{},err}\n authority:=&Authority{tx:tx,request:ports.PolicyRequest{Actor:ports.Principal{ActorID:actor,ExpiresAt:time.Now().Add(s.timeout)},ConversationID:cid,Action:\"read\"},projection:projection,grant:grant}\n return s.LockProjection(ctx,tx,authority)\n}\n","chat/internal/message/reminders.go":"package message\n\nimport(\"context\";\"database/sql\";\"errors\";\"time\";\"github.com/franz-9527/workers/chat/internal/ports\";\"github.com/franz-9527/workers/chat/internal/policy\")\n\n// Publication persists only this wakeup; the worker may restart at any time.\nfunc reminderEvent(ctx context.Context,tx *sql.Tx,cid ports.ID,seq uint64)error{\n _,err:=tx.ExecContext(ctx,`INSERT INTO chat_reminder_events(conversation_id,seq,created_at) VALUES(?,?,UTC_TIMESTAMP(6))`,string(cid),seq)\n if err!=nil{return ports.ErrUnavailable};return nil\n}\ntype ReminderConfig struct{FirstDelaySeconds int;RecipientHourly,RecipientDaily,PlatformHourly,PlatformDaily int}\nfunc DefaultReminderConfig()ReminderConfig{return ReminderConfig{10,3,10,1000,10000}}\nfunc(c ReminderConfig) Validate()error{if c.FirstDelaySeconds<1||c.FirstDelaySeconds>30||c.RecipientHourly<1||c.RecipientHourly>100||c.RecipientDaily<c.RecipientHourly||c.RecipientDaily>1000||c.PlatformHourly<c.RecipientHourly||c.PlatformHourly>100000||c.PlatformDaily<c.PlatformHourly||c.PlatformDaily>1000000{return ports.ErrInvalid};return nil}\ntype ReminderService struct{base *Service;notification ports.Notification;config ReminderConfig}\ntype reminderReceipts interface{Status(context.Context,string)(ports.Receipt,error)}\nfunc NewReminderService(base *Service,n ports.Notification)(*ReminderService,error){if base==nil||n==nil{return nil,ports.ErrInvalid};return &ReminderService{base,n,DefaultReminderConfig()},nil}\nfunc(r *ReminderService) WithConfig(c ReminderConfig)(*ReminderService,error){if c.Validate()!=nil{return nil,ports.ErrInvalid};copy:=*r;copy.config=c;return &copy,nil}\ntype reminderWindow struct{Grant ports.Grant;Hash string;First,Target uint64;Read uint64;At time.Time}\nfunc(r *ReminderService) window(ctx context.Context,tx *sql.Tx,cid,actor ports.ID,target uint64)(reminderWindow,error){\n grant,err:=r.base.conversations.RecipientLocked(ctx,tx,cid,actor);if err!=nil{return reminderWindow{},err}\n out:=reminderWindow{Grant:grant,Hash:memberHash(grant.MemberKey)}\n if target==^uint64(0){if tx.QueryRowContext(ctx,`SELECT last_seq FROM chat_conversations WHERE id=?`,string(cid)).Scan(&target)!=nil{return out,ports.ErrUnavailable}}\n var hash string\n err=tx.QueryRowContext(ctx,`SELECT member_key_hash,read_seq FROM chat_member_reads WHERE conversation_id=? AND actor_id=? LOCK IN SHARE MODE`,string(cid),string(actor)).Scan(&hash,&out.Read)\n if err!=nil&&err!=sql.ErrNoRows{return out,ports.ErrUnavailable};if hash!=out.Hash{out.Read=0}\n predicate:=`m.conversation_id=? AND m.sender_id<>? AND m.state='published' AND m.seq>? AND m.seq<=? AND `+retainedTarget+` AND `+visibleColumn\n args:=[]any{string(cid),string(actor),out.Read,target,string(grant.Version),string(actor)}\n err=tx.QueryRowContext(ctx,`SELECT m.seq,m.created_at FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq LIMIT 1`,args...).Scan(&out.First,&out.At)\n if err==sql.ErrNoRows{return out,nil};if err!=nil{return out,ports.ErrUnavailable}\n if tx.QueryRowContext(ctx,`SELECT m.seq FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq DESC LIMIT 1`,args...).Scan(&out.Target)!=nil{return out,ports.ErrUnavailable};return out,nil\n}\n// DrainEvents is bounded and replay-safe. First due comes from the first\n// still-unread message, never from the time this process happens to wake up.\nfunc(r *ReminderService) DrainEvents(ctx context.Context)error{\n rows,err:=r.base.db.QueryContext(ctx,`SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),seq FROM chat_reminder_events WHERE processed_at IS NULL ORDER BY id LIMIT 50`);if err!=nil{return ports.ErrUnavailable}\n type event struct{id,cid ports.ID;seq uint64};events:=[]event{}\n for rows.Next(){var v event;if rows.Scan(&v.id,&v.cid,&v.seq)!=nil{rows.Close();return ports.ErrUnavailable};events=append(events,v)};err=rows.Err();rows.Close();if err!=nil{return ports.ErrUnavailable}\n for _,event:=range events{\n  actors,e:=r.base.conversations.MemberCandidates(ctx,event.cid);if e!=nil{return e}\n  for _,actor:=range actors{\n   tx,e:=r.base.begin(ctx);if e!=nil{return e}\n   w,e:=r.window(ctx,tx,event.cid,actor,event.seq)\n   if e!=nil{tx.Rollback();if errors.Is(e,policy.ErrDenied){continue};return e}\n   if w.First>0{\n    _,e=tx.ExecContext(ctx,`INSERT INTO chat_reminder_clusters(conversation_id,recipient_id,member_hash,round_version,first_seq,target_seq,first_due_at,next_due,rounds,state,created_at) VALUES(?,?,?,1,?,?,TIMESTAMPADD(SECOND,?,?),TIMESTAMPADD(SECOND,?,?),0,'open',UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE round_version=IF(state='closed' OR ? >= target_seq,round_version+1,round_version),first_seq=IF(state='closed' OR ? >= target_seq,VALUES(first_seq),LEAST(first_seq,VALUES(first_seq))),first_due_at=IF(state='closed' OR ? >= target_seq,VALUES(first_due_at),first_due_at),first_notified_at=IF(state='closed' OR ? >= target_seq,NULL,first_notified_at),next_due=IF(state='closed' OR ? >= target_seq,VALUES(next_due),next_due),rounds=IF(state='closed' OR ? >= target_seq,0,rounds),target_seq=GREATEST(target_seq,VALUES(target_seq)),state=IF(state='exhausted' AND rounds>=3,'exhausted','open')`,string(event.cid),string(actor),w.Hash,w.First,w.Target,r.config.FirstDelaySeconds,w.At,r.config.FirstDelaySeconds,w.At,w.Read,w.Read,w.Read,w.Read,w.Read,w.Read)\n   }\n   if e!=nil{tx.Rollback();return ports.ErrUnavailable};if tx.Commit()!=nil{return ports.ErrUnavailable}\n  }\n  if _,err=r.base.db.ExecContext(ctx,`UPDATE chat_reminder_events SET processed_at=UTC_TIMESTAMP(6) WHERE id=?`,string(event.id));err!=nil{return ports.ErrUnavailable}\n }\n return nil\n}\n","chat/internal/message/reminder_rounds.go":"package message\nimport(\"context\";\"database/sql\";\"crypto/rand\";\"encoding/hex\";\"errors\";\"time\";\"github.com/franz-9527/workers/chat/internal/ports\";\"github.com/franz-9527/workers/chat/internal/policy\")\ntype reminderCluster struct{ID,CID,Actor ports.ID;Hash string;Version uint64;Round int;Target uint64}\nfunc(r *ReminderService) Prepare(ctx context.Context)error{\n rows,err:=r.base.db.QueryContext(ctx,`SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_clusters WHERE state='open' AND next_due<=UTC_TIMESTAMP(6) ORDER BY next_due,id LIMIT 50`);if err!=nil{return ports.ErrUnavailable}\n candidates:=[]reminderCluster{};for rows.Next(){var c reminderCluster;if rows.Scan(&c.ID,&c.CID,&c.Actor,&c.Hash)!=nil{rows.Close();return ports.ErrUnavailable};candidates=append(candidates,c)};err=rows.Err();rows.Close();if err!=nil{return ports.ErrUnavailable}\n for _,c:=range candidates{if err=r.prepareOne(ctx,c);err!=nil{return err}};return nil\n}\nfunc(r *ReminderService) reserveBudget(ctx context.Context,tx *sql.Tx,actor ports.ID)(bool,error){\n now:=time.Now().UTC()\n for _,id:=range []ports.ID{\"0\",actor}{\n  if _,err:=tx.ExecContext(ctx,`INSERT INTO chat_reminder_budgets(recipient_id,hour_start,hour_count,day_start,day_count) VALUES(?,UTC_TIMESTAMP(),0,UTC_DATE(),0) ON DUPLICATE KEY UPDATE recipient_id=recipient_id`,string(id));err!=nil{return false,ports.ErrUnavailable}\n  var hourly,daily int;var hour,day time.Time\n  if tx.QueryRowContext(ctx,`SELECT hour_start,hour_count,day_start,day_count FROM chat_reminder_budgets WHERE recipient_id=? FOR UPDATE`,string(id)).Scan(&hour,&hourly,&day,&daily)!=nil{return false,ports.ErrUnavailable}\n  if now.Sub(hour)>=time.Hour{hour=now;hourly=0};if day.Format(\"2006-01-02\")!=now.Format(\"2006-01-02\"){day=now;daily=0}\n  h,d:=r.config.RecipientHourly,r.config.RecipientDaily;if id==\"0\"{h=r.config.PlatformHourly;d=r.config.PlatformDaily}\n  if hourly>=h||daily>=d{return false,nil}\n  if _,err:=tx.ExecContext(ctx,`UPDATE chat_reminder_budgets SET hour_start=?,hour_count=?,day_start=?,day_count=? WHERE recipient_id=?`,hour,hourly+1,day.Format(\"2006-01-02\"),daily+1,string(id));err!=nil{return false,ports.ErrUnavailable}\n }\n return true,nil\n}\nfunc(r *ReminderService) prepareOne(ctx context.Context,c reminderCluster)error{\n tx,err:=r.base.begin(ctx);if err!=nil{return err};defer tx.Rollback()\n w,err:=r.window(ctx,tx,c.CID,c.Actor,^uint64(0));if err!=nil&&!errors.Is(err,policy.ErrDenied){return err};denied:=errors.Is(err,policy.ErrDenied)\n var state string;var due bool\n if tx.QueryRowContext(ctx,`SELECT round_version,rounds,target_seq,state,next_due<=UTC_TIMESTAMP(6) FROM chat_reminder_clusters WHERE id=? FOR UPDATE`,string(c.ID)).Scan(&c.Version,&c.Round,&c.Target,&state,&due)!=nil{return ports.ErrUnavailable}\n if state!=\"open\"||!due{return nil}\n if denied||w.First==0||w.Hash!=c.Hash{if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET state='closed' WHERE id=?`,string(c.ID));err!=nil{return ports.ErrUnavailable};return tx.Commit()}\n if c.Round>=3{if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET state='exhausted' WHERE id=?`,string(c.ID));err!=nil{return ports.ErrUnavailable};return tx.Commit()}\n var exists int\n if tx.QueryRowContext(ctx,`SELECT COUNT(*) FROM chat_reminder_intents WHERE cluster_id=? AND round_version=? AND round_no=?`,string(c.ID),c.Version,c.Round+1).Scan(&exists)!=nil{return ports.ErrUnavailable}\n if exists>0{return nil} // One persisted attempt/outbox until a real outcome.\n // All reservations roll back together if either account/platform budget fails.\n if _,err=tx.ExecContext(ctx,\"SAVEPOINT reminder_budget\");err!=nil{return ports.ErrUnavailable}\n allowed,err:=r.reserveBudget(ctx,tx,c.Actor);if err!=nil{return err}\n if !allowed{\n  if _,err=tx.ExecContext(ctx,\"ROLLBACK TO SAVEPOINT reminder_budget\");err!=nil{return ports.ErrUnavailable}\n  if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,blocked_reason='channel_budget' WHERE id=?`,string(c.ID));err!=nil{return ports.ErrUnavailable};return tx.Commit()\n }\n var b [32]byte;if _,err=rand.Read(b[:]);err!=nil{return ports.ErrUnavailable}\n if _,err=tx.ExecContext(ctx,`INSERT INTO chat_reminder_intents(operation_id,cluster_id,round_version,round_no,conversation_id,recipient_id,member_hash,target_seq,state,attempts,next_attempt_at,created_at,expires_at) VALUES(?,?,?,?,?,?,?,?,'pending',0,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6),UTC_TIMESTAMP(6)+INTERVAL 1 DAY)`,hex.EncodeToString(b[:]),string(c.ID),c.Version,c.Round+1,string(c.CID),string(c.Actor),c.Hash,w.Target);err!=nil{return ports.ErrUnavailable}\n if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET blocked_reason=NULL WHERE id=?`,string(c.ID));err!=nil{return ports.ErrUnavailable}\n if tx.Commit()!=nil{return ports.ErrUnavailable};return nil\n}\nfunc(r *ReminderService) SubmitPending(ctx context.Context)error{\n rows,err:=r.base.db.QueryContext(ctx,`SELECT CAST(id AS CHAR),operation_id,CAST(recipient_id AS CHAR),CAST(target_seq AS CHAR),CAST(round_version AS CHAR),CAST(conversation_id AS CHAR) FROM chat_reminder_intents WHERE state IN ('pending','retryable') AND attempts<8 AND next_attempt_at<=UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6) ORDER BY id LIMIT 20`);if err!=nil{return ports.ErrUnavailable}\n work:=[]ports.Reminder{};for rows.Next(){var q ports.Reminder;if rows.Scan(&q.IntentID,&q.OperationID,&q.RecipientID,&q.TargetSeq,&q.ClusterVersion,&q.ConversationID)!=nil{rows.Close();return ports.ErrUnavailable};work=append(work,q)};err=rows.Err();rows.Close();if err!=nil{return ports.ErrUnavailable}\n for _,q:=range work{\n  result,err:=r.base.db.ExecContext(ctx,`UPDATE chat_reminder_intents SET state='retryable',attempts=attempts+1,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND WHERE id=? AND state IN ('pending','retryable') AND next_attempt_at<=UTC_TIMESTAMP(6) AND attempts<8`,string(q.IntentID));if err!=nil{return ports.ErrUnavailable};n,_:=result.RowsAffected();if n!=1{continue}\n  allowed,err:=r.Eligible(ctx,q.OperationID);if err!=nil{return err}\n  if !allowed{if err=r.reconcileOne(ctx,q.OperationID,ports.Receipt{OperationID:q.OperationID,State:\"suppressed\",Diagnostic:\"read_or_permission_changed\"});err!=nil{return err};continue}\n  receipt,err:=r.notification.Submit(ctx,q);if err!=nil{continue}\n  if receipt.OperationID!=q.OperationID{return ports.ErrUnavailable}\n  switch receipt.State{\n  case \"accepted\":_,err=r.base.db.ExecContext(ctx,`UPDATE chat_reminder_intents SET state='submitted' WHERE id=? AND state='retryable'`,string(q.IntentID))\n  case \"sent\",\"suppressed\",\"channel_limited\",\"provider_unknown\":err=r.reconcileOne(ctx,q.OperationID,receipt)\n  default:return ports.ErrUnavailable\n  };if err!=nil{return ports.ErrUnavailable}\n }\n return nil\n}\nfunc(r *ReminderService) Eligible(ctx context.Context,op string)(bool,error){\n if len(op)!=64{return false,ports.ErrInvalid}\n var cid,actor,cluster ports.ID;var hash,state string;var target,version uint64;var live bool\n err:=r.base.db.QueryRowContext(ctx,`SELECT CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),CAST(cluster_id AS CHAR),member_hash,target_seq,round_version,state,expires_at>UTC_TIMESTAMP(6) FROM chat_reminder_intents WHERE operation_id=?`,op).Scan(&cid,&actor,&cluster,&hash,&target,&version,&state,&live)\n if err==sql.ErrNoRows{return false,nil};if err!=nil{return false,ports.ErrUnavailable}\n if !live||state==\"suppressed\"||state==\"provider_unknown\"||state==\"channel_limited\"{return false,nil}\n tx,err:=r.base.begin(ctx);if err!=nil{return false,err};defer tx.Rollback()\n w,err:=r.window(ctx,tx,cid,actor,target);if errors.Is(err,policy.ErrDenied){return false,nil};if err!=nil{return false,err}\n var current uint64\n if tx.QueryRowContext(ctx,`SELECT round_version FROM chat_reminder_clusters WHERE id=? LOCK IN SHARE MODE`,string(cluster)).Scan(&current)!=nil{return false,ports.ErrUnavailable}\n valid:=w.First>0&&w.Hash==hash&&current==version;if tx.Commit()!=nil{return false,ports.ErrUnavailable};return valid,nil\n}\n","chat/internal/message/governance_http.go":"package message\n\nimport(\"encoding/json\";\"io\";\"mime\";\"net/http\";\"strings\";\"time\";\"errors\";\"github.com/franz-9527/workers/chat/internal/auth\";\"github.com/franz-9527/workers/chat/internal/ports\";\"github.com/franz-9527/workers/chat/internal/policy\")\n\ntype governanceAction struct{\n Conversation ports.ID `json:\"conversation_id,omitempty\"`;Message ports.ID `json:\"message_id,omitempty\"`;Item ports.ID `json:\"item_id,omitempty\"`\n Case ports.ID `json:\"case_id,omitempty\"`;Target ports.ID `json:\"target_id,omitempty\"`;Actor ports.ID `json:\"actor_id,omitempty\"`;Expected ports.ID `json:\"expected_version,omitempty\"`\n Cursor string `json:\"cursor,omitempty\"`;After ports.ID `json:\"after,omitempty\"`;Limit int `json:\"limit,omitempty\"`;Seconds int `json:\"seconds,omitempty\"`\n Reason string `json:\"reason,omitempty\"`;Action string `json:\"action,omitempty\"`;TargetType string `json:\"target_type,omitempty\"`;Thumbnail bool `json:\"thumbnail,omitempty\"`\n}\ntype GovernanceHandler struct{service *GovernanceService;identity ports.Identity;gate chan struct{}}\nfunc NewGovernanceHandler(g *GovernanceService,id ports.Identity,concurrency int)(*GovernanceHandler,error){\n if g==nil||id==nil||concurrency<1||concurrency>16{return nil,ports.ErrInvalid};return &GovernanceHandler{g,id,make(chan struct{},concurrency)},nil\n}\nfunc(h *GovernanceHandler) ServeHTTP(w http.ResponseWriter,r *http.Request){\n w.Header().Set(\"Content-Type\",\"application/json; charset=utf-8\");w.Header().Set(\"Cache-Control\",\"no-store\");w.Header().Set(\"X-Content-Type-Options\",\"nosniff\")\n fail:=func(status int,code string){w.WriteHeader(status);json.NewEncoder(w).Encode(map[string]any{\"code\":code,\"message\":\"操作未完成，请刷新状态后重试\",\"retryable\":status>=500})}\n routes:=map[string]string{\n \"audit/list\":\"cursor limit\",\"audit/history\":\"conversation_id cursor message_id limit\",\"audit/url\":\"conversation_id message_id item_id thumbnail\",\n \"governance/status\":\"actor_id\",\"governance/restrict\":\"actor_id expected_version action seconds reason\",\"governance/report\":\"conversation_id message_id item_id reason\",\n \"governance/appeal\":\"target_type target_id expected_version reason\",\"governance/cases\":\"after\",\"governance/queue\":\"after\",\n \"governance/evidence\":\"case_id expected_version item_id reason\",\"governance/decide\":\"case_id expected_version action reason\",\n }\n route:=strings.TrimPrefix(r.URL.Path,\"/chat/api/v1/\");fields,ok:=routes[route]\n if !ok||r.URL.Path!=\"/chat/api/v1/\"+route{fail(404,\"CHAT_ROUTE_NOT_FOUND\");return}\n if r.Method!=\"POST\"{w.Header().Set(\"Allow\",\"POST\");fail(405,\"CHAT_METHOD_NOT_ALLOWED\");return}\n content,_,err:=mime.ParseMediaType(r.Header.Get(\"Content-Type\"));if err!=nil||content!=\"application/json\"||r.URL.RawQuery!=\"\"||r.URL.RawPath!=\"\"{fail(400,\"CHAT_INVALID_REQUEST\");return}\n select{case h.gate<-struct{}{}:defer func(){<-h.gate}();default:fail(429,ports.ErrBusy.Error());return}\n headers:=r.Header.Values(\"Authorization\");if len(headers)!=1||!strings.HasPrefix(headers[0],\"Bearer \")||strings.ContainsAny(headers[0],\"\\r\\n\\t\"){fail(401,\"CHAT_UNAUTHORIZED\");return}\n p,err:=h.identity.Authenticate(r.Context(),strings.TrimPrefix(headers[0],\"Bearer \"));if err!=nil{fail(401,\"CHAT_UNAUTHORIZED\");return}\n raw,err:=io.ReadAll(io.LimitReader(r.Body,8193));if err!=nil||len(raw)>8192{fail(400,\"CHAT_INVALID_REQUEST\");return}\n var q governanceAction;var keys map[string]json.RawMessage\n if !strictImageJSON(raw,&q)||json.Unmarshal(raw,&keys)!=nil{fail(400,\"CHAT_INVALID_REQUEST\");return}\n allowed:=map[string]bool{};for _,v:=range strings.Fields(fields){allowed[v]=true};for k,v:=range keys{if !allowed[k]||string(v)==\"null\"{fail(400,\"CHAT_INVALID_REQUEST\");return}}\n var data any\n switch route{\n case \"audit/list\":data,err=h.service.AuditList(r.Context(),p,q.Cursor,q.Limit)\n case \"audit/history\":data,err=h.service.AuditHistory(r.Context(),p,HistoryRequest{ConversationID:q.Conversation,Cursor:q.Cursor,TargetID:q.Message,Limit:q.Limit})\n case \"audit/url\":var url string;url,err=h.service.AuditImage(r.Context(),p,q.Conversation,q.Message,q.Item,q.Thumbnail);data=map[string]any{\"url\":url,\"expires_in\":60}\n case \"governance/status\":if q.Actor==\"\"{q.Actor=p.ActorID};data,err=h.service.Restriction(r.Context(),p,q.Actor)\n case \"governance/restrict\":data,err=h.service.Restrict(r.Context(),p,RestrictionRequest{Actor:q.Actor,Expected:q.Expected,Action:q.Action,Seconds:q.Seconds,Reason:q.Reason})\n case \"governance/report\":var id ports.ID;id,err=h.service.Report(r.Context(),p,q.Conversation,q.Message,q.Item,q.Reason);data=map[string]any{\"case_id\":id}\n case \"governance/appeal\":var id ports.ID;id,err=h.service.Appeal(r.Context(),p,q.TargetType,q.Target,q.Expected,q.Reason);data=map[string]any{\"case_id\":id}\n case \"governance/cases\",\"governance/queue\":data,err=h.service.Cases(r.Context(),p,q.After,route==\"governance/queue\")\n case \"governance/evidence\":data,err=h.service.Evidence(r.Context(),p,q.Case,q.Expected,q.Item,q.Reason)\n case \"governance/decide\":data,err=h.service.Decide(r.Context(),p,CaseDecision{ID:q.Case,Expected:q.Expected,Action:q.Action,Reason:q.Reason})\n }\n if err!=nil{status:=503;switch{case errors.Is(err,auth.ErrUnauthorized):status=401;case errors.Is(err,policy.ErrDenied):status=403;case errors.Is(err,ports.ErrInvalid):status=400;case errors.Is(err,ports.ErrBusy):status=429;case errors.Is(err,ErrResync),errors.Is(err,ErrMediaVersion),errors.Is(err,ErrPreferenceConflict),errors.Is(err,ErrMedia):status=409};fail(status,err.Error());return}\n json.NewEncoder(w).Encode(map[string]any{\"data\":data,\"server_time\":time.Now().UTC()})\n}\n","chat/internal/dependencies/reminders.go":"package dependencies\nimport(\"context\";\"bytes\";\"encoding/json\";\"net/http\";\"net/url\";\"time\";\"github.com/franz-9527/workers/chat/internal/auth\";\"github.com/franz-9527/workers/chat/internal/ports\")\ntype ReminderHTTP struct{transport *HTTP;signer *auth.InternalAuth;endpoint,kid string}\nfunc NewReminderHTTP(h *HTTP,signer *auth.InternalAuth,endpoint,kid string)(*ReminderHTTP,error){\n u,err:=url.Parse(endpoint);if err!=nil||h==nil||signer==nil||u.Scheme!=\"https\"||u.Host==\"\"||u.User!=nil||u.RawQuery!=\"\"||u.Fragment!=\"\"||u.Path!=\"/chat-internal.php\"{return nil,ports.ErrInvalid};return &ReminderHTTP{h,signer,endpoint,kid},nil\n}\nfunc(h *ReminderHTTP) call(ctx context.Context,q map[string]string)(ports.Receipt,error){\n raw,_:=json.Marshal(q);req,err:=http.NewRequestWithContext(ctx,\"POST\",h.endpoint,bytes.NewReader(raw));if err!=nil{return ports.Receipt{},ports.ErrInvalid};req.Header.Set(\"Content-Type\",\"application/json\")\n if err=h.signer.Sign(req,raw,h.kid,time.Now());err!=nil{return ports.Receipt{},err}\n body,status,err:=h.transport.Do(ctx,req);if err!=nil||status!=200{return ports.Receipt{},ports.ErrUnavailable}\n var result struct{Operation string `json:\"operation_id\"`;State string `json:\"state\"`;Diagnostic string `json:\"diagnostic\"`}\n if json.Unmarshal(body,&result)!=nil||result.Operation!=q[\"operation_id\"]{return ports.Receipt{},ports.ErrUnavailable}\n switch result.State{case \"accepted\",\"sent\",\"suppressed\",\"channel_limited\",\"provider_unknown\":default:return ports.Receipt{},ports.ErrUnavailable}\n if len(result.Diagnostic)>64{return ports.Receipt{},ports.ErrUnavailable}\n return ports.Receipt{OperationID:result.Operation,State:result.State,Diagnostic:result.Diagnostic},nil\n}\nfunc(h *ReminderHTTP) Submit(ctx context.Context,q ports.Reminder)(ports.Receipt,error){\n if !q.IntentID.Valid()||!q.RecipientID.Valid()||!q.ConversationID.Valid()||!q.TargetSeq.Valid()||!q.ClusterVersion.Valid()||len(q.OperationID)!=64{return ports.Receipt{},ports.ErrInvalid}\n return h.call(ctx,map[string]string{\"intent_id\":string(q.IntentID),\"recipient_id\":string(q.RecipientID),\"conversation_id\":string(q.ConversationID),\"target_seq\":string(q.TargetSeq),\"cluster_version\":string(q.ClusterVersion),\"operation_id\":q.OperationID})\n}\nfunc(h *ReminderHTTP) Status(ctx context.Context,op string)(ports.Receipt,error){if len(op)!=64{return ports.Receipt{},ports.ErrInvalid};return h.call(ctx,map[string]string{\"operation_id\":op})}\n","chat/internal/message/reminder_http.go":"package message\nimport(\"encoding/json\";\"io\";\"net/http\";\"time\";\"github.com/franz-9527/workers/chat/internal/auth\";\"github.com/franz-9527/workers/chat/internal/ports\")\ntype ReminderInternalHandler struct{service *ReminderService;auth *auth.InternalAuth;gate chan struct{}}\nfunc NewReminderInternalHandler(s *ReminderService,a *auth.InternalAuth)(*ReminderInternalHandler,error){if s==nil||a==nil{return nil,ports.ErrInvalid};return &ReminderInternalHandler{s,a,make(chan struct{},8)},nil}\nfunc(h *ReminderInternalHandler) ServeHTTP(w http.ResponseWriter,r *http.Request){\n w.Header().Set(\"Content-Type\",\"application/json\");w.Header().Set(\"Cache-Control\",\"no-store\")\n fail:=func(status int){w.WriteHeader(status);w.Write([]byte(\"{\\\"code\\\":\\\"CHAT_REMINDER_UNAVAILABLE\\\"}\"))}\n if r.Method!=\"POST\"||r.URL.Path!=\"/chat/internal/v1/reminders/eligible\"||r.URL.RawQuery!=\"\"||r.URL.RawPath!=\"\"{fail(404);return}\n select{case h.gate<-struct{}{}:defer func(){<-h.gate}();default:fail(429);return}\n raw,err:=io.ReadAll(io.LimitReader(r.Body,1025));if err!=nil||len(raw)>1024{fail(400);return}\n if err=h.auth.Verify(r.Context(),r,raw,time.Now());err!=nil{fail(401);return}\n var q struct{Operation string `json:\"operation_id\"`}\n if !strictImageJSON(raw,&q)||len(q.Operation)!=64{fail(400);return}\n allowed,err:=h.service.Eligible(r.Context(),q.Operation);if err!=nil{fail(503);return}\n json.NewEncoder(w).Encode(map[string]bool{\"eligible\":allowed})\n}\n","server/config/defaults.php":"<?php\n\n// 2026-08-14：提供无需 Composer 的默认配置，生产密钥由网页安装器写入 installed.php。\nreturn [\n    'installed' => false,\n    // V2.4.0：默认版本跟随当前代码包；全新安装基线已包含帮助中心结构和草稿问答。\n    'version' => '2.4.0',\n    'app' => [\n        'name' => '壁选师傅订单管理系统',\n        'url' => '',\n        'env' => 'production',\n        'debug' => false,\n        'timezone' => 'Asia/Shanghai',\n        'key' => '',\n    ],\n    'database' => [\n        'host' => '127.0.0.1',\n        'port' => 3306,\n        'database' => '',\n        'username' => '',\n        'password' => '',\n        'charset' => 'utf8mb4',\n    ],\n    // Independent PHP Ed25519 seed; Go receives public keys only. Disabled until chat acceptance.\n    'chat' => ['enabled'=>false,'key_id'=>'chat-v1','seed_env'=>'CHAT_ACCESS_SEED','order_policy_enabled'=>false,'safety_credential_export_enabled'=>false,'reminders_enabled'=>false,'internal_key_id'=>'chat-internal-v1','internal_key_env'=>'CHAT_INTERNAL_KEY','internal_go_origin'=>''],\n    'security' => [\n        'session_name' => 'worker_admin_session',\n        'session_lifetime' => 7200,\n        'login_max_attempts' => 5,\n        'login_lock_minutes' => 15,\n        'force_https' => true,\n    ],\n    'media' => [\n        'max_width' => 1600,\n        'jpeg_quality' => 90,\n        'max_file_bytes' => 1048576,\n        'storage_path' => 'storage/private/uploads',\n    ],\n];\n\n","server/app/Infrastructure/Messaging/ChatInternalAuth.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n/** Internal shared key is independent of access-token signing and channel keys. */\nfinal class ChatInternalAuth\n{\n    private Database $db; private string $env; private string $kid; private string $key;\n    public function __construct(Database $db,string $env,string $kid,string $key)\n    {\n        if (!in_array($env,['production','development','test'],true) || preg_match('/^[a-z0-9_-]{1,32}$/D',$kid)!==1 || strlen($key)!==32) throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $this->db=$db;$this->env=$env;$this->kid=$kid;$this->key=$key;\n    }\n    public static function configured(Database $db):self\n    {\n        $env=['testing'=>'test','development'=>'development','production'=>'production'][(string)\\app_config('app.env','')]??'';\n        $name=(string)\\app_config('chat.internal_key_env','');\n        if(preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D',$name)!==1)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $encoded=getenv($name);$key=is_string($encoded)?base64_decode($encoded,true):false;\n        if(!is_string($key)||base64_encode($key)!==$encoded)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        return new self($db,$env,(string)\\app_config('chat.internal_key_id',''),$key);\n    }\n    private function canonical(string $uri,string $body,string $stamp,string $nonce):string\n    {return implode(\"\\n\",['chat-internal-v1','POST',$uri,hash('sha256',$body),$stamp,$nonce,$this->env,$this->kid]);}\n    public function sign(string $uri,string $body):array\n    {\n        $stamp=(string)time();$nonce=bin2hex(random_bytes(32));\n        return ['X-Chat-Environment: '.$this->env,'X-Chat-Key-ID: '.$this->kid,'X-Chat-Timestamp: '.$stamp,'X-Chat-Nonce: '.$nonce,\n            'X-Chat-Signature: '.hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key)];\n    }\n    public function verify(string $uri,string $body,array $headers):void\n    {\n        if($uri!=='/chat-internal.php'||strlen($body)>8192)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $get=static fn(string $key):string=>(string)($headers[$key]??'');\n        $stamp=$get('timestamp');$nonce=$get('nonce');$signature=$get('signature');\n        if($get('environment')!==$this->env||$get('key-id')!==$this->kid||preg_match('/^[1-9][0-9]{9}$/D',$stamp)!==1||abs(time()-(int)$stamp)>30\n            ||preg_match('/^[a-f0-9]{64}$/D',$nonce)!==1||preg_match('/^[a-f0-9]{64}$/D',$signature)!==1\n            ||!hash_equals(hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key),$signature))throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $insert=$this->db->execute('INSERT IGNORE INTO chat_internal_nonces(nonce_hash,expires_at) VALUES(:hash,UTC_TIMESTAMP()+INTERVAL 61 SECOND)',['hash'=>hash('sha256',$this->kid.':'.$nonce)]);\n        if($insert!==1)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n    }\n    public function eligible(string $operation):bool\n    {\n        $origin=rtrim((string)\\app_config('chat.internal_go_origin',''),'/');$url=parse_url($origin);\n        if(!$url||($url['scheme']??'')!=='https'||empty($url['host'])||isset($url['user'])||isset($url['pass'])||isset($url['query'])||isset($url['fragment'])||!empty($url['path']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $uri='/chat/internal/v1/reminders/eligible';$body=json_encode(['operation_id'=>$operation],JSON_THROW_ON_ERROR);\n        $response='';$ch=curl_init($origin.$uri);curl_setopt_array($ch,[CURLOPT_POST=>true,CURLOPT_POSTFIELDS=>$body,CURLOPT_HTTPHEADER=>array_merge(['Content-Type: application/json'],$this->sign($uri,$body)),CURLOPT_RETURNTRANSFER=>false,CURLOPT_WRITEFUNCTION=>static function($handle,string $chunk)use(&$response):int{if(strlen($response)+strlen($chunk)>1024)return 0;$response.=$chunk;return strlen($chunk);},CURLOPT_CONNECTTIMEOUT_MS=>1000,CURLOPT_TIMEOUT_MS=>3000,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_PROTOCOLS=>CURLPROTO_HTTPS]);\n        $ok=curl_exec($ch);$raw=$ok===false?false:$response;$status=(int)curl_getinfo($ch,CURLINFO_RESPONSE_CODE);curl_close($ch);\n        if($status!==200||!is_string($raw)||strlen($raw)>1024)throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $result=json_decode($raw,true);if(!is_array($result)||!isset($result['eligible'])||!is_bool($result['eligible']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');return $result['eligible'];\n    }\n}\n","server/app/Application/Chat/ChatReminderReceipts.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nfinal class ChatReminderReceipts\n{\n    private Database $db;\n    public function __construct(Database $db){$this->db=$db;}\n    public function receive(string $raw):array\n    {\n        $q=json_decode($raw,true,8,JSON_THROW_ON_ERROR);\n        if(is_array($q)&&array_keys($q)===['operation_id']&&json_encode($q,JSON_THROW_ON_ERROR)===$raw)return $this->status((string)$q['operation_id']);\n        $fields=['cluster_version','conversation_id','intent_id','operation_id','recipient_id','target_seq'];\n        if(!is_array($q)||array_keys($q)!==$fields||json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES)!==$raw)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        foreach($q as $key=>$value){\n            if(!is_string($value)||preg_match($key==='operation_id'?'/^[a-f0-9]{64}$/D':'/^[1-9][0-9]{0,19}$/D',$value)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n            if($key!=='operation_id'&&strlen($value)===20&&strcmp($value,'18446744073709551615')>0)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        }\n        return $this->db->transaction(function()use($q,$raw):array{\n            $hash=hash('sha256',$raw);\n            $this->db->execute(\"INSERT IGNORE INTO chat_reminder_receipts(operation_id,payload_hash,payload_json,state,diagnostic,created_at,updated_at) VALUES(:op,:hash,:body,'accepted','queued',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\",['op'=>$q['operation_id'],'hash'=>$hash,'body'=>$raw]);\n            $row=$this->db->fetch('SELECT payload_hash,state,diagnostic,outbox_id FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$q['operation_id']]);\n            if(!$row||!hash_equals((string)$row['payload_hash'],$hash))throw new RuntimeException('CHAT_REMINDER_CONFLICT');\n            if($row['outbox_id']===null){\n                $id=$this->db->insert(\"INSERT INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('chat_reminder',:key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['key'=>'chat:'.$q['operation_id'],'payload'=>$raw]);\n                $this->db->execute('UPDATE chat_reminder_receipts SET outbox_id=:id WHERE operation_id=:op',['id'=>$id,'op'=>$q['operation_id']]);\n            }\n            return $this->result($q['operation_id'],$row);\n        });\n    }\n    public function status(string $operation):array\n    {\n        if(preg_match('/^[a-f0-9]{64}$/D',$operation)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        $row=$this->db->fetch('SELECT state,diagnostic FROM chat_reminder_receipts WHERE operation_id=:op',['op'=>$operation]);\n        if(!$row)throw new RuntimeException('CHAT_REMINDER_NOT_FOUND');\n        return $this->result($operation,$row);\n    }\n    private function result(string $operation,array $row):array\n    {\n        $state=in_array($row['state'],['sending','provider_unknown'],true)?'provider_unknown':(string)$row['state'];\n        return ['operation_id'=>$operation,'state'=>$state,'diagnostic'=>(string)$row['diagnostic']];\n    }\n}\n","server/chat-internal.php":"<?php\ndeclare(strict_types=1);\nrequire __DIR__.'/bootstrap.php';\nheader('Content-Type: application/json');header('Cache-Control: no-store');header('X-Content-Type-Options: nosniff');\ntry{\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    if(($_SERVER['REQUEST_METHOD']??'')!=='POST'||($_SERVER['REQUEST_URI']??'')!=='/chat-internal.php'||strtolower(trim(explode(';',(string)($_SERVER['CONTENT_TYPE']??''))[0]))!=='application/json')throw new RuntimeException('request');\n    $raw=file_get_contents('php://input',false,null,0,8193);if(!is_string($raw)||strlen($raw)>8192)throw new RuntimeException('body');\n    $headers=[];foreach(['environment','key-id','timestamp','nonce','signature'] as $key)$headers[$key]=(string)($_SERVER['HTTP_X_CHAT_'.strtoupper(str_replace('-','_',$key))]??'');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());$auth->verify('/chat-internal.php',$raw,$headers);\n    $result=(new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts(db()))->receive($raw);\n    echo json_encode($result,JSON_THROW_ON_ERROR);\n}catch(Throwable $error){http_response_code(503);echo '{\"code\":\"CHAT_REMINDER_UNAVAILABLE\"}';}\n","server/app/Infrastructure/Messaging/ChatReminderTemplate.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\nfinal class ChatReminderTemplate\n{\n    public static function build(Database $db,array $q):array\n    {\n        $scene=SubscriptionCatalog::subscriptionSceneDefinitions()['chat_unread']??[];\n        if(empty($scene['available']))return ['diagnostic'=>'template_unavailable'];\n        $uid=(int)$q['recipient_id'];$pref=SubscriptionQuotaStore::subscriptionPreferences($db,$uid)['chat_unread']??[];\n        $type=(string)($scene['subscription_type']??'one_time');\n        if(in_array((string)($pref['authorization_status']??''),['ban','disabled'],true)\n            ||($type==='one_time'&&max(0,(int)($pref['remaining_count']??0))<1)\n            ||($type!=='one_time'&&(empty($pref['enabled'])||!in_array($pref['authorization_status']??'',['accept','acceptWithAudio','acceptWithAlert'],true))))return ['diagnostic'=>'subscription_unavailable'];\n        $openid=(string)$db->fetchValue(\"SELECT openid FROM wechat_identities WHERE user_id=:id AND status='active' ORDER BY id DESC LIMIT 1\",['id'=>$uid]);\n        if($openid==='')return ['diagnostic'=>'openid_missing'];\n        $values=['status'=>'您有未读的订单聊天消息','time'=>date('Y-m-d H:i')];$data=[];\n        foreach((array)$scene['field_map'] as $semantic=>$key){\n            if(!isset($values[$semantic]))return ['diagnostic'=>'template_data_invalid'];\n            $value=WechatTemplateValue::format((string)$key,$values[$semantic]);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $key=>$fixed){\n            if(isset($data[$key]))continue;$value=WechatTemplateValue::format((string)$key,(string)$fixed);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['template_fields']??[]) as $key)if(!isset($data[$key]))return ['diagnostic'=>'template_data_missing'];\n        if(!$data)return ['diagnostic'=>'template_data_missing'];\n        return ['payload'=>['user_id'=>$uid,'scene_key'=>'chat_unread','openid'=>$openid,'template_id'=>(string)$scene['template_id'],\n            'page'=>'subpackages/chat/conversation/index?conversation_id='.rawurlencode($q['conversation_id']),'data'=>$data]];\n    }\n}\n","server/app/Application/Chat/ChatReminderDispatch.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse Throwable;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatReminderTemplate;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionQuotaStore;\n/** Reuses the existing gateway/quota; no copied channel, SMS or billing stack. */\nfinal class ChatReminderDispatch\n{\n    private Database $db;private SubscribeMessageGateway $gateway;private $eligible;\n    public function __construct(Database $db,SubscribeMessageGateway $gateway,callable $eligible){$this->db=$db;$this->gateway=$gateway;$this->eligible=$eligible;}\n    public function dispatch(int $limit=20):array\n    {\n        if($this->db->pdo()->inTransaction())throw new RuntimeException('CHAT_SEND_TRANSACTION');\n        $limit=max(1,min(50,$limit));\n        // A dead process after entering the channel has an unknown result. It\n        // cannot re-enter generic failed retries or trigger an SMS fallback.\n        $this->db->execute(\"UPDATE chat_reminder_receipts SET state='provider_unknown',diagnostic='provider_unknown',updated_at=UTC_TIMESTAMP(6) WHERE state='sending' AND updated_at<UTC_TIMESTAMP(6)-INTERVAL 5 MINUTE\");\n        $rows=$this->db->fetchAll(\"SELECT o.id,o.payload_json FROM message_outbox o JOIN chat_reminder_receipts r ON r.outbox_id=o.id WHERE o.topic='chat_reminder' AND o.status IN ('pending','failed','processing') AND r.state='accepted' AND o.attempt_count<8 AND (o.next_attempt_at IS NULL OR o.next_attempt_at<=UTC_TIMESTAMP()) ORDER BY o.id LIMIT \".$limit);\n        $stats=['scanned'=>count($rows),'sent'=>0,'suppressed'=>0,'unknown'=>0,'retry'=>0];\n        foreach($rows as $row){\n            $id=(int)$row['id'];$q=json_decode((string)$row['payload_json'],true);$op=(string)($q['operation_id']??'');\n            if(preg_match('/^[a-f0-9]{64}$/D',$op)!==1)continue;\n            $claimed=$this->db->execute(\"UPDATE message_outbox SET status='processing',attempt_count=attempt_count+1,next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE WHERE id=:id AND topic='chat_reminder' AND (status IN ('pending','failed') OR (status='processing' AND next_attempt_at<=UTC_TIMESTAMP()))\",['id'=>$id]);\n            if($claimed!==1)continue;\n            $entered=false;\n            try{\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $built=ChatReminderTemplate::build($this->db,$q);\n                if(!isset($built['payload'])){$this->finish($op,$id,'channel_limited',(string)$built['diagnostic']);$stats['suppressed']++;continue;}\n                // Final check is after metadata/permissions and immediately\n                // before recording the irreversible provider boundary.\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $entered=$this->db->transaction(function()use($op,$q):bool{\n                    $receipt=$this->db->fetch('SELECT state FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$op]);\n                    if(!$receipt||$receipt['state']!=='accepted')return false;\n                    $this->db->fetch(\"SELECT setting_key FROM system_settings WHERE setting_key=:key FOR UPDATE\",['key'=>'wechat.subscription.user.'.(int)$q['recipient_id']]);\n                    $current=ChatReminderTemplate::build($this->db,$q);if(!isset($current['payload']))return false;\n                    // Reserve once, including provider-unknown outcomes.\n                    SubscriptionQuotaStore::markSubscriptionConsumed($this->db,(int)$q['recipient_id'],'chat_unread');\n                    $this->db->execute(\"UPDATE chat_reminder_receipts SET state='sending',diagnostic='channel_entered',updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op\",['op'=>$op]);return true;\n                });\n                if(!$entered){$this->finish($op,$id,'suppressed','subscription_changed');$stats['suppressed']++;continue;}\n                $this->gateway->send($built['payload']);\n                $this->finish($op,$id,'sent','sent');$stats['sent']++;\n            }catch(Throwable $error){\n                if($entered){$this->finish($op,$id,'provider_unknown','provider_unknown');$stats['unknown']++;}\n                else{$this->db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE,last_error='chat_eligibility_unavailable' WHERE id=:id\",['id'=>$id]);$stats['retry']++;}\n            }\n        }\n        return $stats;\n    }\n    private function finish(string $op,int $id,string $state,string $diagnostic):void\n    {\n        $this->db->transaction(function()use($op,$id,$state,$diagnostic):void{\n            $this->db->execute(\"UPDATE chat_reminder_receipts SET state=:state,diagnostic=:diagnostic,updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op AND state IN ('accepted','sending')\",['state'=>$state,'diagnostic'=>$diagnostic,'op'=>$op]);\n            $this->db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP(),next_attempt_at=NULL,last_error=:diagnostic WHERE id=:id AND topic='chat_reminder'\",['diagnostic'=>$diagnostic,'id'=>$id]);\n        });\n    }\n}\n","server/bin/chat-reminders.php":"<?php\ndeclare(strict_types=1);\nif(PHP_SAPI!=='cli'){http_response_code(404);exit;}\nrequire dirname(__DIR__).'/bootstrap.php';\ntry{\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());\n    $shared=new \\WorkerAdmin\\Foundation\\ApplicationContainer(db());\n    $dispatcher=new \\WorkerAdmin\\Application\\Chat\\ChatReminderDispatch(db(),$shared->subscribeMessages(),[$auth,'eligible']);\n    $stats=$dispatcher->dispatch(20);\n    db()->execute('DELETE FROM chat_internal_nonces WHERE expires_at<=UTC_TIMESTAMP() ORDER BY expires_at LIMIT 1000');\n    fwrite(STDOUT,json_encode($stats,JSON_THROW_ON_ERROR).\"\\n\");\n}catch(Throwable $error){fwrite(STDERR,\"聊天提醒处理暂不可用\\n\");exit(1);}\n","server/app/Http/Admin/Modules/ChatGovernanceAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n/** PHP owns page/identity grants only; every chat-governance mutation uses Go. */\nfinal class ChatGovernanceAdminModule implements AdminModule\n{\n    private Database $db;private Auth $auth;\n    public function __construct(Database $db,Auth $auth,Csrf $csrf){$this->db=$db;$this->auth=$auth;}\n    public function supports(string $route):bool{return in_array($route,['chat.governance','chat.auditors'],true);}\n    public function dispatch(string $route):void\n    {\n        $this->auth->requirePermission($route==='chat.auditors'?'chat.audit.grants':'audit.view');\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));\n        if($route==='chat.auditors'&&$method==='POST'){\n            $id=trim((string)($_POST['user_id']??''));$reason=trim((string)($_POST['reason']??''));$enabled=(string)($_POST['enabled']??'')==='1';\n            if(preg_match('/^[1-9][0-9]{0,19}$/D',$id)!==1||mb_strlen($reason)<2||mb_strlen($reason)>200||!$this->db->fetchValue(\"SELECT id FROM users WHERE id=:id AND status='active'\",['id'=>$id]))throw new RuntimeException('请填写真实用户编号和授权理由');\n            $admin=(string)$this->auth->user()['id'];$version=bin2hex(random_bytes(32));\n            $this->db->transaction(function()use($id,$reason,$enabled,$admin,$version):void{\n                $this->db->execute('INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE enabled=VALUES(enabled),authority_version=VALUES(authority_version),granted_by=VALUES(granted_by),reason=VALUES(reason),updated_at=VALUES(updated_at)',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n                $this->db->execute('INSERT INTO chat_auditor_grant_audit(user_id,enabled,authority_version,admin_id,reason,created_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6))',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n            });\n            \\flash('success','会话抽检授权已更新');\\redirect(\\admin_url('chat.auditors'));return;\n        }\n        if($method!=='GET'){http_response_code(405);throw new RuntimeException('请求方式不正确');}\n        $grants=$route==='chat.auditors'?$this->db->fetchAll('SELECT user_id,enabled,granted_by,reason,updated_at FROM chat_mini_auditors ORDER BY updated_at DESC,user_id DESC LIMIT 50'):[];\n        echo \\view('admin/chat-governance',['pageTitle'=>$route==='chat.auditors'?'小程序抽检授权':'聊天抽检与治理','activeMenu'=>$route,'grants'=>$grants,'grantPage'=>$route==='chat.auditors',\n            'canModerate'=>$this->auth->can('users.manage'),'canEvidence'=>$this->auth->can('chat.evidence.view')]);\n    }\n}\n","chat/internal/message/governance_integration_test.go":"package message\n\nimport(\"context\";\"strings\";\"sync\";\"testing\";\"time\";\"github.com/franz-9527/workers/chat/internal/ports\")\n\nfunc governanceFixture(t *testing.T,f *fixtureDB,s *Service,m *MediaService)(*GovernanceService,ports.Principal){\n t.Helper();h,err:=NewHistoryService(f.goDB,f.store,\"test\",[]byte(strings.Repeat(\"k\",32)),3*time.Second);if err!=nil{t.Fatal(err)}\n g,err:=NewGovernanceService(s,h,m,\"test\");if err!=nil{t.Fatal(err)}\n f.exec(`INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(91001,'governance-fixture','fixture','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n f.exec(`INSERT INTO chat_admin_sessions(id,admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(91001,91001,REPEAT('d',64),REPEAT('e',64),REPEAT('f',64),'[\"chat:audit\",\"chat:moderate\",\"chat:images\",\"chat:evidence\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())`)\n p:=ports.Principal{ActorID:\"91001\",Kind:\"admin\",SourceID:\"91001\",SessionID:strings.Repeat(\"d\",64),SessionVersion:strings.Repeat(\"e\",64),Environment:\"test\",Scopes:[]string{\"chat:audit\",\"chat:moderate\",\"chat:images\",\"chat:evidence\"},ExpiresAt:time.Now().Add(time.Minute)}\n return g,p\n}\nfunc TestMySQLS18AuditSnapshotIsolationAndRevocation(t *testing.T){\n f,s,q:=setupMessage(t,safetyFunc(pass));g,admin:=governanceFixture(t,f,s,nil);ctx:=f.ctx\n first:=accepted(t,s,q)\n for i:=0;i<5;i++{f.exec(`INSERT INTO chat_conversations(conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at) VALUES('order',CONCAT('fixture-audit:',?),?, ?,1,REPEAT('a',64),'fixture','readonly',UTC_TIMESTAMP(6)-INTERVAL 1 DAY,UTC_TIMESTAMP(6))`,i,600+i,600+i)}\n page,err:=g.AuditList(ctx,admin,\"\",2);if err!=nil||len(page.Items)!=2||!page.More{t.Fatal(page,err)}\n total:=f.text(\"SELECT COUNT(*) FROM chat_conversations\");seen:=map[ports.ID]bool{};for _,item:=range page.Items{seen[item.ID]=true}\n // Move an unseen row to the top after the snapshot was created.\n f.exec(`UPDATE chat_conversations SET last_message_at=UTC_TIMESTAMP(6)+INTERVAL 1 DAY WHERE scope_key='fixture-audit:4'`)\n for page.More{page,err=g.AuditList(ctx,admin,page.Cursor,2);if err!=nil{t.Fatal(err)};for _,item:=range page.Items{if seen[item.ID]{t.Fatal(\"activity change duplicated snapshot row\")};seen[item.ID]=true}}\n if decimal(uint64(len(seen)))!=ports.ID(total){t.Fatal(\"snapshot lost conversations\",len(seen),total)}\n if _,err=g.AuditList(ctx,principal(\"10203\"),\"\",20);err==nil{t.Fatal(\"platform staff inherited audit\")}\n mini:=principal(\"10203\");mini.Kind=\"mini_audit\";mini.Scopes=[]string{\"chat:audit\"}\n if _,err=g.AuditList(ctx,mini,\"\",20);err==nil{t.Fatal(\"ungranted mini audit\")}\n f.exec(`INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(10203,1,REPEAT('f',64),91001,'独立抽检测试',UTC_TIMESTAMP(6))`)\n mini.SessionVersion=digest(\"mini-audit-v1\\n10203\\n\"+digest(\"login:10203\")+\"\\n10203\\n\"+strings.Repeat(\"f\",64))\n if _,err=g.AuditList(ctx,mini,\"\",20);err!=nil{t.Fatal(\"independent grant\",err)}\n if _,err=f.store.Authorize(ctx,ports.PolicyRequest{Actor:mini,ConversationID:q.ConversationID,Action:\"send\"});err==nil{t.Fatal(\"audit identity used ordinary member path\")}\n before:=f.text(\"SELECT COUNT(*) FROM chat_member_reads\")\n detail,err:=g.AuditHistory(ctx,admin,HistoryRequest{ConversationID:q.ConversationID});if err!=nil||len(detail.Messages)!=1||detail.Messages[0].Text==nil{t.Fatal(detail,err)}\n if _,err=s.Recall(ctx,principal(\"10202\"),q.ConversationID,first.MessageID);err!=nil{t.Fatal(err)}\n detail,err=g.AuditHistory(ctx,admin,HistoryRequest{ConversationID:q.ConversationID,TargetID:first.MessageID});if err!=nil||detail.Messages[0].Text!=nil||detail.Messages[0].State!=\"recalled\"{t.Fatal(\"audit leaked recall\",detail,err)}\n if f.text(\"SELECT COUNT(*) FROM chat_member_reads\")!=before{t.Fatal(\"audit marked read\")}\n f.exec(\"UPDATE chat_mini_auditors SET enabled=0 WHERE user_id=10203\")\n if _,err=g.AuditHistory(ctx,mini,HistoryRequest{ConversationID:q.ConversationID});err==nil{t.Fatal(\"revoked mini audit\")}\n f.exec(\"UPDATE chat_mini_auditors SET enabled=1,authority_version=REPEAT('a',64) WHERE user_id=10203\")\n if _,err=g.AuditHistory(ctx,mini,HistoryRequest{ConversationID:q.ConversationID});err==nil{t.Fatal(\"old revoked grant revived after regrant\")}\n f.exec(\"UPDATE admin_users SET role='viewer' WHERE id=91001\")\n if _,err=g.AuditList(ctx,admin,\"\",20);err==nil{t.Fatal(\"revoked admin\")}\n if _,err=f.goDB.ExecContext(ctx,\"UPDATE chat_governance_audit SET reason='tamper'\");err==nil{t.Fatal(\"audit table mutable by Go\")}\n}\nfunc TestMySQLS19BanSerializesPendingSendAndKeepsReadRecallAppeal(t *testing.T){\n started,resume:=make(chan struct{}),make(chan struct{});var once sync.Once\n f,s,q:=setupMessage(t,safetyFunc(pass));g,admin:=governanceFixture(t,f,s,nil);ctx:=f.ctx\n first:=accepted(t,s,q)\n s.safety=safetyFunc(func(context.Context,ports.TextRequest)(ports.SafetyResult,error){once.Do(func(){close(started)});<-resume;return ports.SafetyResult{Decision:\"passed\",RuleVersion:\"s19-fixture\"},nil})\n q.ClientMessageID=client(22);done:=make(chan error,1);go func(){_,err:=s.Send(ctx,principal(\"10202\"),q);done<-err}();<-started\n blocked,err:=g.Restrict(ctx,admin,RestrictionRequest{Actor:\"10202\",Expected:\"0\",Action:\"permanent\",Reason:\"并发禁聊测试\"});if err!=nil||!blocked.Blocked{t.Fatal(blocked,err)}\n close(resume);if err=<-done;err!=ErrRestricted{t.Fatal(\"in-flight send bypassed restriction\",err)}\n if f.text(\"SELECT COUNT(*) FROM chat_messages\")!=\"1\"{t.Fatal(\"late publish\")}\n if _,err=g.history.Read(ctx,principal(\"10202\"),HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\");err!=nil{t.Fatal(\"ban blocked legal read\",err)}\n if _,err=s.Recall(ctx,principal(\"10202\"),q.ConversationID,first.MessageID);err!=nil{t.Fatal(\"ban blocked recall\",err)}\n id,err:=g.Appeal(ctx,principal(\"10202\"),\"restriction\",\"10202\",blocked.Version,\"对此次禁聊提出申诉\");if err!=nil{t.Fatal(err)}\n if _,err=g.Evidence(ctx,admin,id,\"1\",\"\",\"核对禁聊依据\");err!=nil{t.Fatal(err)}\n if _,err=g.Decide(ctx,admin,CaseDecision{ID:id,Expected:\"1\",Action:\"correct\",Reason:\"核查后解除限制\"});err!=nil{t.Fatal(err)}\n status,err:=g.Restriction(ctx,principal(\"10202\"),\"10202\");if err!=nil||status.Blocked||status.Version!=\"2\"{t.Fatal(status,err)}\n if f.text(\"SELECT COUNT(*) FROM chat_messages\")!=\"1\"{t.Fatal(\"appeal resent old action\")}\n timed,err:=g.Restrict(ctx,admin,RestrictionRequest{Actor:\"10202\",Expected:\"2\",Action:\"timed\",Seconds:60,Reason:\"限时到期测试\"});if err!=nil||!timed.Blocked{t.Fatal(timed,err)}\n f.exec(\"UPDATE chat_restrictions SET blocked_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND WHERE actor_id=10202\")\n if err=g.ExpireRestrictions(ctx);err!=nil{t.Fatal(err)}\n status,err=g.Restriction(ctx,principal(\"10202\"),\"10202\");if err!=nil||status.Blocked||status.Version!=\"4\"{t.Fatal(status,err)}\n}\nfunc TestMySQLS19ReportsScopeEvidenceAndFalsePositiveCorrection(t *testing.T){\n safety:=safetyFunc(func(context.Context,ports.TextRequest)(ports.SafetyResult,error){return ports.SafetyResult{Decision:\"blocked\",RuleVersion:\"s19-fixture\",Finding:&ports.SafetyFinding{Provider:\"local.anti_diversion\",Code:\"fixture_risk\",Level:2,Confirmed:true}},nil})\n f,s,q:=setupMessage(t,safety);g,admin:=governanceFixture(t,f,s,nil);ctx:=f.ctx\n result,err:=s.Send(ctx,principal(\"10202\"),q);if err!=nil||result.RiskEventID==\"\"{t.Fatal(result,err)}\n id,err:=g.Appeal(ctx,principal(\"10202\"),\"risk\",result.RiskEventID,\"1\",\"认为此内容存在误判\");if err!=nil{t.Fatal(err)}\n if _,err=g.Appeal(ctx,principal(\"10203\"),\"risk\",result.RiskEventID,\"1\",\"不能申诉他人内容\");err==nil{t.Fatal(\"foreign evidence appeal\")}\n weak:=admin;weak.Scopes=[]string{\"chat:audit\",\"chat:moderate\"}\n if _,err=g.Evidence(ctx,weak,id,\"1\",\"\",\"普通权限不能读原文\");err==nil{t.Fatal(\"missing distinct evidence scope\")}\n evidence,err:=g.Evidence(ctx,admin,id,\"1\",\"\",\"核对原文及上下文\");if err!=nil||evidence.Text==nil||*evidence.Text!=q.Text{t.Fatal(evidence,err)}\n if _,err=g.Decide(ctx,admin,CaseDecision{ID:id,Expected:\"1\",Action:\"correct\",Reason:\"原内容确认为误判\"});err!=nil{t.Fatal(err)}\n if f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE confirmed=1\")!=\"0\"{t.Fatal(\"false positive still counted\")}\n again,err:=s.Query(ctx,principal(\"10202\"),q.ConversationID,q.ClientMessageID);if err!=nil||again.State!=\"rejected\"{t.Fatal(\"corrected old intent resurrected\",again,err)}\n noMessages(t,f)\n s.safety=safetyFunc(pass);q.ClientMessageID=client(29);message:=accepted(t,s,q)\n report,err:=g.Report(ctx,principal(\"10203\"),q.ConversationID,message.MessageID,\"\",\"此消息需要平台核查\");if err!=nil{t.Fatal(err)}\n duplicate,err:=g.Report(ctx,principal(\"10203\"),q.ConversationID,message.MessageID,\"\",\"重复举报合并\");if err!=nil||duplicate!=report{t.Fatal(\"duplicate case\",duplicate,err)}\n if _,err=g.Decide(ctx,admin,CaseDecision{ID:report,Expected:\"1\",Action:\"block\",Reason:\"尚未查看证据\"});err==nil{t.Fatal(\"decision without evidence\")}\n if _,err=g.Evidence(ctx,admin,report,\"1\",\"\",\"查看被举报原消息\");err!=nil{t.Fatal(err)}\n if _,err=g.Decide(ctx,admin,CaseDecision{ID:report,Expected:\"1\",Action:\"block\",Reason:\"确认需要屏蔽\"});err!=nil{t.Fatal(err)}\n page,err:=g.history.Read(ctx,principal(\"10203\"),HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\");if err!=nil||len(page.Messages)!=1||page.Messages[0].Text!=nil||page.Messages[0].State!=\"blocked\"{t.Fatal(\"block projection\",page,err)}\n if _,err=g.Decide(ctx,admin,CaseDecision{ID:report,Expected:\"1\",Action:\"dismiss\",Reason:\"旧版本不能覆盖\"});err==nil{t.Fatal(\"stale decision\")}\n}\n","chat/internal/message/reminders_integration_test.go":"package message\n\nimport(\"context\";\"sync\";\"testing\";\"github.com/franz-9527/workers/chat/internal/ports\")\n\ntype reminderCapture struct{mu sync.Mutex;calls []ports.Reminder;lose bool}\nfunc(c *reminderCapture) Submit(_ context.Context,q ports.Reminder)(ports.Receipt,error){c.mu.Lock();defer c.mu.Unlock();c.calls=append(c.calls,q);if c.lose{c.lose=false;return ports.Receipt{},ports.ErrUnavailable};return ports.Receipt{OperationID:q.OperationID,State:\"accepted\"},nil}\nfunc(c *reminderCapture) Status(_ context.Context,op string)(ports.Receipt,error){return ports.Receipt{OperationID:op,State:\"sent\",Diagnostic:\"sent\"},nil}\nfunc TestMySQLS20DurableEventsFixedDueRetryAndReadSuppression(t *testing.T){\n f,s,q:=setupMessage(t,safetyFunc(pass));capture:=&reminderCapture{lose:true};r,err:=NewReminderService(s,capture);if err!=nil{t.Fatal(err)}\n first:=accepted(t,s,q)\n if f.text(\"SELECT COUNT(*) FROM chat_reminder_events WHERE processed_at IS NULL\")!=\"1\"{t.Fatal(\"publication lost durable event\")}\n // A new instance represents process death after message commit.\n r,_=NewReminderService(s,capture);if err=r.DrainEvents(f.ctx);err!=nil{t.Fatal(err)}\n due:=f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\")\n q.ClientMessageID=client(42);accepted(t,s,q)\n if err=r.DrainEvents(f.ctx);err!=nil{t.Fatal(err)}\n if f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\")!=due{t.Fatal(\"new message postponed first reminder\")}\n f.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n if err=r.Prepare(f.ctx);err!=nil{t.Fatal(err)}\n if f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\")!=\"1\"{t.Fatal(\"not one aggregate round\")}\n if err=r.SubmitPending(f.ctx);err!=nil{t.Fatal(err)}\n f.exec(\"UPDATE chat_reminder_intents SET next_attempt_at=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n if err=r.SubmitPending(f.ctx);err!=nil{t.Fatal(err)}\n if len(capture.calls)!=2||capture.calls[0].OperationID!=capture.calls[1].OperationID{t.Fatal(\"ambiguous PHP result changed operation\")}\n op:=capture.calls[1].OperationID\n if allowed,err:=r.Eligible(f.ctx,op);err!=nil||!allowed{t.Fatal(\"online is not read\",allowed,err)}\n h,err:=NewHistoryService(f.goDB,f.store,\"test\",[]byte(\"12345678901234567890123456789012\"),s.timeout);if err!=nil{t.Fatal(err)}\n page,err:=h.Read(f.ctx,principal(\"10203\"),HistoryRequest{ConversationID:q.ConversationID},\"bootstrap\");if err!=nil{t.Fatal(err)}\n if _,err=h.Acknowledge(f.ctx,principal(\"10203\"),q.ConversationID,page.SyncCursor);err!=nil{t.Fatal(err)}\n if allowed,err:=r.Eligible(f.ctx,op);err!=nil||allowed{t.Fatal(\"read did not suppress queued reminder\",allowed,err)}\n if first.MessageID==\"\"||f.text(\"SELECT COUNT(*) FROM notifications\")!=\"0\"{t.Fatal(\"per-message business notices created\")}\n}\nfunc TestMySQLS20RoundsBudgetRecallAndPermissionRevocation(t *testing.T){\n f,s,q:=setupMessage(t,safetyFunc(pass));capture:=&reminderCapture{};r,_:=NewReminderService(s,capture)\n msg:=accepted(t,s,q);if err:=r.DrainEvents(f.ctx);err!=nil{t.Fatal(err)}\n for i:=0;i<5;i++{f.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\");if err:=r.Prepare(f.ctx);err!=nil{t.Fatal(err)};if err:=r.SubmitPending(f.ctx);err!=nil{t.Fatal(err)};if err:=r.Reconcile(f.ctx);err!=nil{t.Fatal(err)}}\n if f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\")!=\"3\"{t.Fatal(\"continued unread exceeded three rounds\")}\n if f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=10203\")!=\"3\"{t.Fatal(\"chat-only budget mismatch\")}\n if err:=r.SubmitPending(f.ctx);err!=nil{t.Fatal(err)}\n if len(capture.calls)!=3{t.Fatal(capture.calls)}\n if _,err:=s.Recall(f.ctx,principal(\"10202\"),q.ConversationID,msg.MessageID);err!=nil{t.Fatal(err)}\n if ok,err:=r.Eligible(f.ctx,capture.calls[0].OperationID);err!=nil||ok{t.Fatal(\"recall still reminded\",ok,err)}\n q.ClientMessageID=client(49);accepted(t,s,q);if err:=r.DrainEvents(f.ctx);err!=nil{t.Fatal(err)}\n // The original member epoch is revoked in PHP before the worker projects it.\n f.exec(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n if ok,err:=r.Eligible(f.ctx,capture.calls[1].OperationID);err!=nil||ok{t.Fatal(\"revoked recipient reminded\",ok,err)}\n}\n","server/tests/chat_reminder_contract.php":"<?php\ndeclare(strict_types=1);\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'){echo \"提醒数据库验证未启用\\n\";exit;}\nrequire_once dirname(__DIR__).'/app/Support/functions.php';\nspl_autoload_register(static function(string $class):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)===0){$file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require_once $file;}});\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderReceipts;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderDispatch;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nfunction reminderEnsure(bool $ok,string $message):void{if(!$ok)throw new RuntimeException($message);}\nfinal class ReminderGatewayFixture implements SubscribeMessageGateway{\n public int $calls=0;public bool $fail=false;\n public function categoryList():array{return [];}public function publicTemplateTitles(array $ids,int $start=0,int $limit=30):array{return [];}\n public function publicTemplateKeywords(string $tid):array{return [];}public function addTemplate(string $tid,array $kids,string $desc=''):string{return '';}\n public function templateList():array{return [];}\n public function send(array $payload):array{$this->calls++;reminderEnsure(!isset($payload['sms_fallback'])&&$payload['scene_key']==='chat_unread','chat SMS fallback or wrong scene');if($this->fail)throw new RuntimeException('accepted but transport result lost');return ['ok'=>true];}\n}\n$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');if(preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$m)!==1)throw new RuntimeException('loopback required');\n$config=['host'=>'127.0.0.1','port'=>(int)$m[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$root=new Database($config);$name='bixuan_test_chat_reminder_'.bin2hex(random_bytes(6));$root->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$GLOBALS['worker_admin_config']=['database'=>$config];$db=db();\ntry{\n (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n $db->execute(\"INSERT INTO users(id,public_id,nickname,status,created_at,updated_at) VALUES(10001,:public,'提醒隔离用户','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>str_repeat('U',26)]);\n $db->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10001,'fixture-app','fixture-openid','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n $settings=['wechat.subscribe_enabled'=>['1','bool'],'wechat.subscribe_template_ids'=>[json_encode(['chat_unread'=>['template_id'=>'fixture-template','field_map'=>['status'=>'thing1','time'=>'time2']]]),'json'],\n 'wechat.subscription.user.10001'=>[json_encode(['chat_unread'=>['enabled'=>true,'authorization_status'=>'accept','remaining_count'=>5,'subscription_type'=>'one_time']]),'json']];\n foreach($settings as $key=>$value)$db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,created_at,updated_at) VALUES(:key,:value,:type,'notification',0,'隔离测试',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['key'=>$key,'value'=>$value[0],'type'=>$value[1]]);\n $receipts=new ChatReminderReceipts($db);\n $body=static function(string $op):string{$q=['cluster_version'=>'1','conversation_id'=>'401','intent_id'=>'1','operation_id'=>$op,'recipient_id'=>'10001','target_seq'=>'2'];return json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);};\n $a=str_repeat('a',64);$raw=$body($a);\n $auth=new ChatInternalAuth($db,'test','internal-fixture',str_repeat('k',32));$headers=[];\n foreach($auth->sign('/chat-internal.php',$raw) as $line){[$key,$value]=explode(': ',$line,2);$headers[strtolower(substr($key,7))]=$value;}\n $auth->verify('/chat-internal.php',$raw,$headers);\n $replayed=false;try{$auth->verify('/chat-internal.php',$raw,$headers);}catch(RuntimeException $error){$replayed=true;}reminderEnsure($replayed,'internal replay accepted');\n $tamper=false;try{$auth->verify('/chat-internal.php',$raw.' ',$headers);}catch(RuntimeException $error){$tamper=true;}reminderEnsure($tamper,'tampered body accepted');\n for($i=0;$i<3;$i++)reminderEnsure($receipts->receive($raw)['state']==='accepted','receipt changed');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\")===1,'duplicate PHP receipt duplicated outbox');\n $conflict=false;try{$receipts->receive(str_replace('\"target_seq\":\"2\"','\"target_seq\":\"3\"',$raw));}catch(RuntimeException $error){$conflict=true;}reminderEnsure($conflict,'immutable operation payload changed');\n $gateway=new ReminderGatewayFixture();\n $dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>false);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===0&&$stats['suppressed']===1,'read message sent');\n $b=str_repeat('b',64);$receipts->receive($body($b));$dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>true);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===1&&$stats['sent']===1,'unread not sent once');\n $c=str_repeat('c',64);$receipts->receive($body($c));$gateway->fail=true;$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['unknown']===1,'provider unknown not recorded');\n $db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP() WHERE business_key=:key\",['key'=>'chat:'.$c]);$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$receipts->receive($body($c))['state']==='provider_unknown','unknown provider blindly retried');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='aliyun_sms'\")===0,'unknown fell back to paid SMS');\n $d=str_repeat('d',64);$receipts->receive($body($d));$checks=0;$final=new ChatReminderDispatch($db,$gateway,static function(string $op)use(&$checks):bool{return ++$checks===1;});$stats=$final->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['suppressed']===1,'final read check missed');\n $e=str_repeat('e',64);$receipts->receive($body($e));$db->execute(\"UPDATE chat_reminder_receipts SET state='sending',updated_at=UTC_TIMESTAMP()-INTERVAL 6 MINUTE WHERE operation_id=:op\",['op'=>$e]);\n $dispatcher->dispatch();reminderEnsure($receipts->receive($body($e))['state']==='provider_unknown'&&$gateway->calls===2,'crashed sender retried');\n echo \"S20 PHP 内部签名/重放、幂等回执、最终未读复验、供应商未知与短信隔离验证通过\\n\";\n}finally{$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n","chat/internal/dependencies/governance.go":"package dependencies\nimport(\"net/http\";\"github.com/franz-9527/workers/chat/internal/auth\";\"github.com/franz-9527/workers/chat/internal/message\";\"github.com/franz-9527/workers/chat/internal/ports\")\n// Explicit composition for the S21-S23 isolated/release composition root. No\n// call is made by the still-closed production bootstrap.\ntype Governance struct{Service *message.GovernanceService;HTTP http.Handler;Reminders *message.ReminderService;InternalHTTP http.Handler}\nfunc(r *Runtime) ComposeGovernance(base *message.Service,media *message.MediaService,n ports.Notification,internal *auth.InternalAuth)(*Governance,error){\n if r.History==nil||r.Identity==nil||base==nil||n==nil||internal==nil{return nil,ports.ErrInvalid}\n g,err:=message.NewGovernanceService(base,r.History,media,r.environment);if err!=nil{return nil,err}\n h,err:=message.NewGovernanceHandler(g,r.Identity,8);if err!=nil{return nil,err}\n reminders,err:=message.NewReminderService(base,n);if err!=nil{return nil,err}\n ih,err:=message.NewReminderInternalHandler(reminders,internal);if err!=nil{return nil,err}\n return &Governance{g,h,reminders,ih},nil\n}\n","chat/internal/message/governance_maintenance.go":"package message\nimport(\"context\";\"time\";\"github.com/franz-9527/workers/chat/internal/ports\";\"github.com/franz-9527/workers/chat/internal/policy\")\n// One bounded pass. S22 owns wider archive/backup policy; this pass expires\n// governance evidence holds only after every linked case's retention ends.\nfunc(g *GovernanceService) ExpireEvidence(ctx context.Context)error{\n rows,err:=g.base.db.QueryContext(ctx,`SELECT CAST(id AS CHAR) FROM chat_cases WHERE retain_until<=UTC_TIMESTAMP(6) AND state<>'expired' ORDER BY retain_until,id LIMIT 30`);if err!=nil{return ports.ErrUnavailable}\n ids:=[]ports.ID{};for rows.Next(){var id ports.ID;if rows.Scan(&id)!=nil{rows.Close();return ports.ErrUnavailable};ids=append(ids,id)};err=rows.Err();rows.Close();if err!=nil{return ports.ErrUnavailable}\n for _,id:=range ids{\n  tx,err:=g.base.begin(ctx);if err!=nil{return err}\n  // Expired cases cannot be opened through caseLock; lock in the same order.\n  var subject,cid ports.ID\n  if tx.QueryRowContext(ctx,`SELECT CAST(subject_id AS CHAR),CAST(conversation_id AS CHAR) FROM chat_cases WHERE id=?`,string(id)).Scan(&subject,&cid)!=nil{tx.Rollback();return ports.ErrUnavailable}\n  if _,err=restrictionLocked(ctx,tx,subject);err!=nil{tx.Rollback();return err}\n  if cid!=\"0\"{var n int;if tx.QueryRowContext(ctx,`SELECT 1 FROM chat_conversations WHERE id=? FOR UPDATE`,string(cid)).Scan(&n)!=nil{tx.Rollback();return ports.ErrUnavailable}}\n  c,err:=scanCase(tx.QueryRowContext(ctx,`SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) FOR UPDATE`,string(id)))\n  if err!=nil{tx.Rollback();return err};if c.State==\"expired\"{tx.Rollback();continue}\n  if _,err=tx.ExecContext(ctx,`UPDATE chat_cases SET state='expired',version=version+1 WHERE id=?`,string(id));err!=nil{tx.Rollback();return ports.ErrUnavailable}\n  if c.TargetType==\"risk\"{\n   _,err=tx.ExecContext(ctx,`UPDATE chat_risk_events SET text_evidence='',context_evidence='' WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='risk' AND c.target_id=chat_risk_events.id AND c.retain_until>UTC_TIMESTAMP(6))`,string(c.Target))\n  }\n  if err==nil&&(c.TargetType==\"message\"||c.TargetType==\"image_intent\"){\n   items,e:=caseImageItems(ctx,tx,c);if e!=nil{tx.Rollback();return e}\n   for _,item:=range items{\n    _,err=tx.ExecContext(ctx,`UPDATE chat_image_uploads u SET legal_hold=0 WHERE u.id=? AND NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_image_items i ON c.target_type='message' AND c.target_id=i.message_id WHERE i.item_id=u.id AND c.retain_until>UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='image_intent' AND c.subject_id=u.actor_id AND c.conversation_id=u.conversation_id AND c.retain_until>UTC_TIMESTAMP(6))`,string(item.ItemID));if err!=nil{break}\n   }\n  }\n  if err!=nil{tx.Rollback();return ports.ErrUnavailable}\n  sys:=ports.Principal{Kind:\"system\",ActorID:\"0\",Environment:g.environment}\n  if err=governanceLog(ctx,tx,sys,\"evidence.expire\",c.Conversation,c.ID,c.Item,decimal(number(c.Version)+1),\"治理证据保留期结束\");err!=nil{tx.Rollback();return err}\n  if tx.Commit()!=nil{return ports.ErrUnavailable}\n }\n return nil\n}\nfunc(g *GovernanceService) Maintain(ctx context.Context,reminders *ReminderService)error{\n if err:=g.ExpireRestrictions(ctx);err!=nil{return err};if err:=g.CleanupSnapshots(ctx);err!=nil{return err};if err:=g.ExpireEvidence(ctx);err!=nil{return err}\n if reminders!=nil{if err:=reminders.Reconcile(ctx);err!=nil{return err};if err:=reminders.DrainEvents(ctx);err!=nil{return err};if err:=reminders.Prepare(ctx);err!=nil{return err};return reminders.SubmitPending(ctx)};return nil\n}\nfunc(g *GovernanceService) Run(ctx context.Context,reminders *ReminderService){\n ticker:=time.NewTicker(15*time.Second);defer ticker.Stop()\n for{pass,cancel:=context.WithTimeout(ctx,10*time.Second);_ =g.Maintain(pass,reminders);cancel();select{case <-ctx.Done():return;case <-ticker.C:}}\n}\n\nfunc(r *ReminderService) Reconcile(ctx context.Context)error{\n reader,ok:=r.notification.(reminderReceipts);if !ok{return nil}\n rows,err:=r.base.db.QueryContext(ctx,`SELECT operation_id FROM chat_reminder_intents WHERE state IN ('submitted','provider_unknown') ORDER BY id LIMIT 20`);if err!=nil{return ports.ErrUnavailable}\n ops:=[]string{};for rows.Next(){var op string;if rows.Scan(&op)!=nil{rows.Close();return ports.ErrUnavailable};ops=append(ops,op)};err=rows.Err();rows.Close();if err!=nil{return ports.ErrUnavailable}\n for _,op:=range ops{receipt,e:=reader.Status(ctx,op);if e!=nil{continue};if receipt.OperationID!=op{return ports.ErrUnavailable};if receipt.State!=\"accepted\"{if e=r.reconcileOne(ctx,op,receipt);e!=nil{return e}}};return nil\n}\nfunc(r *ReminderService) reconcileOne(ctx context.Context,op string,receipt ports.Receipt)error{\n if receipt.State!=\"sent\"&&receipt.State!=\"suppressed\"&&receipt.State!=\"channel_limited\"&&receipt.State!=\"provider_unknown\"{return ports.ErrInvalid}\n var c reminderCluster\n if r.base.db.QueryRowContext(ctx,`SELECT CAST(cluster_id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_intents WHERE operation_id=?`,op).Scan(&c.ID,&c.CID,&c.Actor,&c.Hash)!=nil{return ports.ErrUnavailable}\n tx,err:=r.base.begin(ctx);if err!=nil{return err};defer tx.Rollback()\n // Current PHP guard/account -> conversation -> cluster -> intent -> budget.\n w,windowErr:=r.window(ctx,tx,c.CID,c.Actor,^uint64(0));err=windowErr;if err!=nil&&err!=policy.ErrDenied{return err}\n var currentVersion uint64\n if tx.QueryRowContext(ctx,`SELECT round_version,rounds FROM chat_reminder_clusters WHERE id=? FOR UPDATE`,string(c.ID)).Scan(&currentVersion,&c.Round)!=nil{return ports.ErrUnavailable}\n var version,target uint64;var round int;var state string;var created time.Time;var released bool\n if tx.QueryRowContext(ctx,`SELECT round_version,round_no,target_seq,state,created_at,budget_released FROM chat_reminder_intents WHERE operation_id=? FOR UPDATE`,op).Scan(&version,&round,&target,&state,&created,&released)!=nil{return ports.ErrUnavailable}\n if state==\"sent\"||state==\"suppressed\"||state==\"channel_limited\"{return nil}\n if receipt.State==\"suppressed\"||receipt.State==\"channel_limited\"{\n  if !released{\n   if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_budgets SET hour_count=GREATEST(0,CAST(hour_count AS SIGNED)-IF(hour_start<=?,1,0)),day_count=GREATEST(0,CAST(day_count AS SIGNED)-IF(day_start=DATE(?),1,0)) WHERE recipient_id IN (0,?)`,created,created,string(c.Actor));err!=nil{return ports.ErrUnavailable};released=true\n  }\n }\n if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_intents SET state=?,diagnostic=?,budget_released=? WHERE operation_id=?`,receipt.State,receipt.Diagnostic,released,op);err!=nil{return ports.ErrUnavailable}\n if version==currentVersion{\n  if receipt.State==\"sent\"&&round==c.Round+1{\n   if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET rounds=?,last_notified_seq=GREATEST(last_notified_seq,?),first_notified_at=COALESCE(first_notified_at,UTC_TIMESTAMP(6)),next_due=TIMESTAMPADD(MINUTE,?,COALESCE(first_notified_at,UTC_TIMESTAMP(6))),state=IF(? >= 3,'exhausted','open'),blocked_reason=NULL WHERE id=?`,round,target,5+(round-1)*10,round,string(c.ID));err!=nil{return ports.ErrUnavailable}\n  }else if receipt.State==\"channel_limited\"||receipt.State==\"provider_unknown\"{\n   if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET state=?,blocked_reason=? WHERE id=?`,receipt.State,receipt.Diagnostic,string(c.ID));err!=nil{return ports.ErrUnavailable}\n  }else if receipt.State==\"suppressed\"{\n   if windowErr==nil&&w.First>0&&w.Read>=target{\n    if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET round_version=round_version+1,first_seq=?,target_seq=?,first_due_at=TIMESTAMPADD(SECOND,?,?),next_due=TIMESTAMPADD(SECOND,?,?),first_notified_at=NULL,rounds=0,state='open',blocked_reason=NULL WHERE id=?`,w.First,w.Target,r.config.FirstDelaySeconds,w.At,r.config.FirstDelaySeconds,w.At,string(c.ID));err!=nil{return ports.ErrUnavailable}\n   }else{\n    if _,err=tx.ExecContext(ctx,`UPDATE chat_reminder_clusters SET state=IF(target_seq<=?,'closed',state),blocked_reason=? WHERE id=?`,target,receipt.Diagnostic,string(c.ID));err!=nil{return ports.ErrUnavailable}\n   }\n  }\n }\n if tx.Commit()!=nil{return ports.ErrUnavailable};return nil\n}\n","server/app/Support/functions.php":"<?php\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\View;\n\n// 2026-08-14：集中提供后台通用帮助函数，避免页面重复处理配置、转义与安全逻辑。\nfunction base_path($path = '')\n{\n    $base = defined('WORKER_BASE_PATH') ? WORKER_BASE_PATH : dirname(__DIR__, 2);\n    return $path === '' ? $base : $base . DIRECTORY_SEPARATOR . ltrim(str_replace(['/', '\\\\'], DIRECTORY_SEPARATOR, $path), DIRECTORY_SEPARATOR);\n}\n\nfunction app_config($key = null, $default = null)\n{\n    $config = isset($GLOBALS['worker_admin_config']) ? $GLOBALS['worker_admin_config'] : [];\n    if ($key === null || $key === '') {\n        return $config;\n    }\n\n    $value = $config;\n    foreach (explode('.', (string) $key) as $segment) {\n        if (!is_array($value) || !array_key_exists($segment, $value)) {\n            return $default;\n        }\n        $value = $value[$segment];\n    }\n    return $value;\n}\n\nfunction is_installed()\n{\n    return (bool) app_config('installed', false)\n        && is_file(base_path('config/installed.php'))\n        && is_file(base_path('storage/install.lock'));\n}\n\n// 2026-08-14：发布新代码后若配置版本尚未同步，后台仅允许登录并进入升级页，API 与计划任务保持暂停。\nfunction upgrade_required()\n{\n    return !empty($GLOBALS['worker_admin_upgrade_required']);\n}\n\nfunction db()\n{\n    static $database;\n    if (!$database) {\n        $config = (array) app_config('database', []);\n        if (empty($config['database']) && !empty($config['name'])) {\n            $config['database'] = $config['name'];\n        }\n        $database = new Database($config);\n    }\n    return $database;\n}\n\nfunction auth()\n{\n    static $auth;\n    if (!$auth) {\n        $auth = new Auth(db());\n    }\n    return $auth;\n}\n\nfunction csrf()\n{\n    static $csrf;\n    if (!$csrf) {\n        $csrf = new Csrf();\n    }\n    return $csrf;\n}\n\nfunction view($template, array $data = [], $layout = 'layouts/admin')\n{\n    return (new View(base_path('views')))->render($template, $data, $layout);\n}\n\nfunction e($value)\n{\n    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n}\n\nfunction app_url($path = '')\n{\n    $base = rtrim((string) app_config('app.url', ''), '/');\n    if ($base === '' && PHP_SAPI !== 'cli') {\n        $https = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')\n            || (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https');\n        $host = isset($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost';\n        $base = ($https ? 'https://' : 'http://') . $host;\n    }\n    return $base . ($path === '' ? '' : '/' . ltrim($path, '/'));\n}\n\nfunction admin_url($route = 'dashboard', array $params = [])\n{\n    $params = array_merge(['route' => $route], $params);\n    return app_url('admin/?' . http_build_query($params));\n}\n\nfunction asset_url($path)\n{\n    // 后台热修不提升数据库版本时，追加文件指纹刷新 CSS/JS，避免浏览器或 CDN 继续命中旧 2.4.0 静态资源。\n    $version = (string) app_config('app.version', app_config('version', '2.4.0'));\n    $relative = ltrim((string) $path, '/');\n    $assetPath = dirname(__DIR__, 2) . '/assets/' . $relative;\n    $fingerprint = '';\n    if (is_file($assetPath)) {\n        $mtime = @filemtime($assetPath);\n        $size = @filesize($assetPath);\n        if ($mtime !== false && $size !== false) $fingerprint = '-' . (string) $mtime . '-' . (string) $size;\n    }\n    return app_url('assets/' . $relative) . '?v=' . rawurlencode($version . $fingerprint);\n}\n\nfunction redirect($url, $status = 302)\n{\n    header('Location: ' . $url, true, $status);\n    exit;\n}\n\nfunction json_response(array $data, $status = 200)\n{\n    http_response_code((int) $status);\n    header('Content-Type: application/json; charset=utf-8');\n    // 2026-09-22：鉴权 API 可能位于 ESA/CDN 后方；显式禁止浏览器、代理和共享缓存保存或串用敏感响应。\n    header('Cache-Control: no-store, private, max-age=0');\n    header('Surrogate-Control: no-store');\n    header('Pragma: no-cache');\n    header('Expires: 0');\n    header('Vary: Authorization', false);\n    echo json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n    exit;\n}\n\nfunction request_id()\n{\n    static $id;\n    if (!$id) {\n        try {\n            $id = bin2hex(random_bytes(8));\n        } catch (Exception $exception) {\n            $id = str_replace('.', '', uniqid('', true));\n        }\n    }\n    return $id;\n}\n\nfunction request_ip()\n{\n    $ip = isset($_SERVER['REMOTE_ADDR']) ? (string) $_SERVER['REMOTE_ADDR'] : '127.0.0.1';\n    return substr($ip, 0, 45);\n}\n\nfunction write_log($channel, $message)\n{\n    $directory = base_path('storage/logs');\n    if (!is_dir($directory)) {\n        @mkdir($directory, 0775, true);\n    }\n    @file_put_contents($directory . DIRECTORY_SEPARATOR . preg_replace('/[^a-z0-9_-]/i', '', $channel) . '.log', $message, FILE_APPEND | LOCK_EX);\n}\n\nfunction flash($type = null, $message = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return null;\n    }\n    if ($type !== null && $message !== null) {\n        $_SESSION['_flash'][$type][] = (string) $message;\n        return null;\n    }\n    $messages = isset($_SESSION['_flash']) ? $_SESSION['_flash'] : [];\n    unset($_SESSION['_flash']);\n    return $messages;\n}\n\nfunction old_input(array $values = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return [];\n    }\n    if ($values !== null) {\n        $_SESSION['_old_input'] = $values;\n        return [];\n    }\n    $old = isset($_SESSION['_old_input']) ? $_SESSION['_old_input'] : [];\n    unset($_SESSION['_old_input']);\n    return $old;\n}\n\nfunction money($cents)\n{\n    return '¥' . number_format(((int) $cents) / 100, 2);\n}\n\n// 2026-08-14：数据库统一保存 UTC，后台所有可见时间通过此函数转换为站点时区，避免中国管理员看到时间少八小时。\nfunction local_datetime($value, $format = 'Y-m-d H:i')\n{\n    $value = trim((string) $value);\n    if ($value === '' || $value === '0000-00-00 00:00:00') {\n        return '—';\n    }\n    try {\n        $date = new DateTimeImmutable($value, new DateTimeZone('UTC'));\n        return $date->setTimezone(new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai')))->format((string) $format);\n    } catch (Throwable $exception) {\n        return $value;\n    }\n}\n\n// 2026-08-14：生成不含易混淆字符的 26 位公开标识，数据库只暴露该标识而不暴露自增主键。\nfunction public_id()\n{\n    $alphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\n    $bytes = random_bytes(26);\n    $id = '';\n    for ($index = 0; $index < 26; $index++) {\n        $id .= $alphabet[ord($bytes[$index]) & 31];\n    }\n    return $id;\n}\n\n// 2026-08-14：业务单号包含类型、UTC 时间与随机尾号，便于人工检索且避免并发冲突。\nfunction business_no($prefix)\n{\n    return strtoupper(preg_replace('/[^A-Z0-9]/i', '', (string) $prefix))\n        . gmdate('YmdHis')\n        . substr(public_id(), -6);\n}\n\n// 新订单号：BX + 两位类目码 + YYMMDD + '-' + 六位安全随机码。历史订单号保持不变。\n// 生成函数不访问数据库；订单表 public_no 唯一索引与写入端重试负责处理极少数碰撞。\nfunction order_business_no($categoryCode)\n{\n    $code = strtoupper(preg_replace('/[^A-Z]/i', '', (string) $categoryCode));\n    $code = strlen($code) === 2 ? $code : 'QT';\n    $alphabet = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';\n    $suffix = '';\n    for ($i = 0; $i < 6; $i++) {\n        $suffix .= $alphabet[random_int(0, strlen($alphabet) - 1)];\n    }\n    $date = (new DateTimeImmutable('now', new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai'))))->format('ymd');\n    return 'BX' . $code . $date . '-' . $suffix;\n}\n\n// 2026-08-23：后台新增订单和云数据同步统一生成姓名、手机号的最小必要脱敏展示值。\nfunction mask_private_name($value)\n{\n    $value = trim((string) $value);\n    if ($value === '') {\n        return '';\n    }\n    $length = function_exists('mb_strlen') ? mb_strlen($value, 'UTF-8') : strlen($value);\n    $first = function_exists('mb_substr') ? mb_substr($value, 0, 1, 'UTF-8') : substr($value, 0, 1);\n    return $first . str_repeat('*', max(1, min(3, $length - 1)));\n}\n\nfunction mask_private_mobile($value)\n{\n    $digits = preg_replace('/\\D+/', '', (string) $value);\n    if (strlen($digits) < 7) {\n        return $digits === '' ? '' : substr($digits, 0, 2) . '***';\n    }\n    return substr($digits, 0, 3) . str_repeat('*', max(4, strlen($digits) - 7)) . substr($digits, -4);\n}\n\n// 2026-08-23：使用安装时生成的站点密钥加密微信支付、短信、云开发和订单隐私字段。\nfunction encrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if ($value === '') {\n        return null;\n    }\n    $appKey = (string) app_config('app.key', '');\n    if ($appKey === '' || !function_exists('openssl_encrypt')) {\n        throw new RuntimeException('站点加密密钥或 OpenSSL 不可用，无法保存敏感内容。');\n    }\n    $key = hash('sha256', $appKey, true);\n    $nonce = random_bytes(12);\n    $tag = '';\n    $ciphertext = openssl_encrypt($value, 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $nonce, $tag, (string) $context, 16);\n    if (!is_string($ciphertext)) {\n        throw new RuntimeException('敏感内容加密失败。');\n    }\n    return 'enc:v1:' . base64_encode($nonce . $tag . $ciphertext);\n}\n\nfunction decrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if (strpos($value, 'enc:v1:') !== 0) {\n        return $value;\n    }\n    $payload = base64_decode(substr($value, 7), true);\n    $appKey = (string) app_config('app.key', '');\n    if (!is_string($payload) || strlen($payload) < 29 || $appKey === '' || !function_exists('openssl_decrypt')) {\n        return '';\n    }\n    $plaintext = openssl_decrypt(substr($payload, 28), 'aes-256-gcm', hash('sha256', $appKey, true), OPENSSL_RAW_DATA, substr($payload, 0, 12), substr($payload, 12, 16), (string) $context);\n    return is_string($plaintext) ? $plaintext : '';\n}\n\nfunction private_value_hmac($value, $context = 'private')\n{\n    return hash_hmac('sha256', (string) $value, hash('sha256', (string) app_config('app.key', ''), true) . (string) $context);\n}\n\nfunction status_meta($status)\n{\n    $map = [\n        'pending' => ['待处理', 'warning'], 'pending_review' => ['待审核', 'warning'],\n        'approved' => ['已通过', 'success'], 'active' => ['正常', 'success'],\n        'published' => ['已公开', 'info'], 'paid' => ['已支付', 'success'],\n        'completed' => ['已完成', 'success'], 'success' => ['成功', 'success'],\n        'rejected' => ['已驳回', 'danger'], 'cancelled' => ['已取消', 'muted'],\n        'canceled' => ['已取消', 'muted'], 'disabled' => ['已停用', 'muted'],\n        'failed' => ['失败', 'danger'], 'refunding' => ['退款中', 'warning'],\n        'unpaid' => ['未支付', 'muted'], 'processing' => ['处理中', 'info'],\n        'open' => ['处理中', 'warning'], 'resolved' => ['已解决', 'success'],\n        'hidden' => ['已隐藏', 'muted'], 'visible' => ['显示', 'success'],\n        'waiting' => ['等待报价', 'warning'], 'collecting' => ['报价中', 'info'],\n        'offered' => ['待师傅接单', 'warning'], 'accepted' => ['已接受', 'success'],\n        'supplement_required' => ['待补资料', 'warning'], 'suspended' => ['已暂停', 'danger'],\n        'none' => ['无', 'muted'], 'created' => ['已创建', 'warning'],\n        'cancel_approved_pending_refund' => ['已取消待退款', 'warning'],\n        'succeeded' => ['退款成功', 'success'], 'archived' => ['已归档', 'muted'],\n        'draft' => ['草稿', 'warning'], 'payment_failed' => ['付款失败', 'danger'],\n        'claimed' => ['已领取', 'success'], 'revoked' => ['已撤销', 'muted'],\n        'expired' => ['已过期', 'muted'], 'overdue' => ['已逾期', 'danger'],\n        'acknowledged' => ['已知悉', 'info'],\n        'quoting' => ['报价中', 'info'], 'selected' => ['已选报价', 'success'],\n        'unassigned' => ['待安排', 'warning'], 'assigned' => ['已安排', 'info'],\n        'info_released' => ['已开放信息', 'success'], 'not_started' => ['未开始', 'muted'],\n        'scheduled' => ['已预约', 'info'], 'refunded' => ['已退款', 'success'],\n        'awaiting_payment' => ['待付预约费', 'warning'], 'in_progress' => ['施工中', 'info'],\n        'submitted' => ['待验收', 'warning'], 'confirmed' => ['已确认', 'success'],\n        'settled' => ['已抵扣结清', 'success'], 'released' => ['已释放', 'muted'],\n        'deleted' => ['已删除', 'muted'], 'user' => ['用户责任', 'danger'],\n        'worker' => ['师傅责任', 'danger'], 'platform' => ['平台责任', 'warning'],\n        'shared' => ['双方协商', 'info'], 'unclear' => ['责任不清', 'warning'],\n        'undetermined' => ['待判定', 'warning'], 'user_schedule_change' => ['用户行程原因', 'info'],\n        'draft_pending_upload' => ['待上传图片', 'warning'], 'pending_payment' => ['待付款', 'warning'],\n        'selected_pending_payment' => ['已选报价待付款', 'warning'], 'reviewed' => ['已审核', 'success'],\n        'pending_contact_release' => ['待开放联系信息', 'warning'], 'completed_with_delay' => ['完成但尾款延期', 'warning'],\n        'booking_fee' => ['预约费', 'info'], 'commission' => ['平台服务费', 'info'],\n        'cancel_refund' => ['申请退款并取消订单', 'warning'], 'change_rejected' => ['拒绝加价', 'warning'],\n        // 2026-08-28：补齐后台资源列表、支付、派单和通知中可能出现的枚举中文名。\n        'closed' => ['已关闭', 'muted'], 'requested' => ['待提交', 'warning'],\n        'received' => ['已接收', 'info'], 'sent' => ['已发送', 'success'], 'read' => ['已读', 'success'],\n        'unknown' => ['未确定', 'muted'], 'recorded' => ['已记录', 'info'], 'effective' => ['已生效', 'success'],\n        'locked' => ['已锁定', 'success'], 'superseded' => ['已被新版本替代', 'muted'],\n        'order_booking' => ['订单预约费', 'info'], 'measurement_balance' => ['测量选师傅补款', 'info'], 'measurement_change' => ['测量现场加费', 'info'], 'booking_fee_paid' => ['预约费已支付', 'success'],\n        'worker_quote' => ['师傅报价成交', 'info'], 'admin_assignment' => ['管理员指派', 'info'],\n        'admin' => ['管理员指派', 'info'], 'invite' => ['邀请师傅接单', 'info'],\n        'ordinary_order' => ['普通订单分享', 'info'], 'worker_invite' => ['邀请师傅分享', 'info'],\n        'run_empty_fee' => ['跑空费', 'warning'], 'auto_72h' => ['72小时自动验收', 'info'],\n        'schedule_changed' => ['行程变化', 'info'], 'forced_cancel_refund' => ['强制取消并退款', 'danger'],\n        'change_accepted' => ['同意加价', 'success'], 'construction_issue' => ['施工问题', 'warning'],\n        // 2026-08-29：尾款延期提交即为已登记，只有放弃收款才标记坏账。\n        'reported' => ['已登记', 'info'], 'bad_debt' => ['已标记坏账', 'danger'],\n        // 2026-09-09：实际尾款先自动生效，再由管理员抽查。\n        'auto_approved' => ['自动预审已生效', 'success'],\n        // 2026-09-15：补齐 V2.2.1 预计服务费在验收前的中文状态。\n        'estimate' => ['预计服务费待缴', 'warning'], 'estimate_paid' => ['预计服务费部分已缴', 'info'],\n        'estimate_settled' => ['预计服务费已结清', 'success'],\n    ];\n    return isset($map[$status]) ? $map[$status] : [$status ?: '—', 'muted'];\n}\n\n// 2026-08-25：模板只需要中文状态文字时统一走同一份映射，避免列表与详情翻译不一致。\nfunction status_text($status)\n{\n    $meta = status_meta($status);\n    return $meta[0];\n}\n\n// 2026-08-30：订单专用状态按小程序列表的业务优先级计算，避免 active 被笼统翻译成“正常”。\nfunction order_business_status_meta(array $order)\n{\n    $refundStatus = (string) ($order['refund_status'] ?? '');\n    $lifecycleStatus = (string) ($order['lifecycle_status'] ?? 'active');\n    $auditStatus = (string) ($order['audit_status'] ?? '');\n    $paymentStatus = (string) ($order['payment_status'] ?? '');\n    $fulfillmentStatus = (string) ($order['fulfillment_status'] ?? '');\n    $assignmentStatus = (string) ($order['assignment_status'] ?? '');\n    $quoteStatus = (string) ($order['quote_status'] ?? '');\n    $dispatchMode = (string) ($order['dispatch_mode'] ?? 'multi_quote');\n    $expectedFeeType = (string) ($order['expected_fee_type'] ?? '');\n    $expectedFeeCents = max(0, (int) ($order['expected_fee_cents'] ?? 0));\n\n    if (in_array($refundStatus, ['created', 'pending_review', 'approved', 'processing', 'refunding'], true) || $lifecycleStatus === 'cancel_approved_pending_refund') return ['退款处理中', 'warning'];\n    if ($refundStatus === 'succeeded') return ['已退款', 'success'];\n    if ($lifecycleStatus === 'expired') return ['已到期取消', 'warning'];\n    if ($lifecycleStatus === 'cancelled') return ['已取消', 'danger'];\n    if ($lifecycleStatus === 'completed') return ['已完成', 'success'];\n    if ($auditStatus === 'draft' && $paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($auditStatus === 'draft') return ['草稿', 'muted'];\n    if ($auditStatus === 'pending') return ['待审核', 'warning'];\n    if ($auditStatus === 'supplement_required') return ['待补充资料', 'warning'];\n    if ($auditStatus === 'rejected') return ['审核未通过', 'danger'];\n    if ($fulfillmentStatus === 'accepted') return ['已验收', 'success'];\n    if ($fulfillmentStatus === 'submitted') return ['待验收', 'warning'];\n    if ($fulfillmentStatus === 'in_progress') return ['施工中', 'info'];\n    if ($fulfillmentStatus === 'scheduled') return ['已预约', 'info'];\n    if ($paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($assignmentStatus === 'accepted') {\n        if ($dispatchMode === 'single_grab') return [$expectedFeeType === 'total' && $expectedFeeCents > 0 ? '已按期望总价抢单，待施工' : '抢单报价已成交，待施工', 'info'];\n        return ['已安排师傅，待施工', 'info'];\n    }\n    if (in_array($assignmentStatus, ['offered', 'assigned'], true)) {\n        if ($dispatchMode === 'single_grab' && $assignmentStatus === 'offered') return ['师傅已抢单，待沟通报价', 'warning'];\n        return ['已安排师傅，待接单', 'warning'];\n    }\n    if (!empty($order['selected_quote_id']) || $quoteStatus === 'selected') return ['已选报价，待安排师傅', 'warning'];\n    if (in_array($quoteStatus, ['quoting', 'collecting'], true)) return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '报价中', 'info'];\n    return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '等待报价', 'info'];\n}\n\n// 2026-08-28：后台订单时间线统一显示中文事件标题；事件正文继续展示具体金额、原因和处理结果。\nfunction order_event_text($eventType)\n{\n    $map = [\n        'draft_created'=>'订单草稿已保存','admin_created'=>'管理员新增订单','admin_updated'=>'管理员修改订单资料',\n        'order_ready_for_prepayment'=>'等待支付预约费','order_submitted'=>'订单已提交审核','order_approved'=>'审核通过并公开',\n        'order_supplement_required'=>'要求补充资料','order_supplemented'=>'用户补充资料并重新提交','order_rejected'=>'订单审核未通过','order_published'=>'订单公开到大厅','order_hidden'=>'订单从大厅隐藏','order_edited'=>'订单资料已修改',\n        'worker_quoted'=>'师傅提交报价','worker_quote_updated'=>'师傅修改报价','platform_quoted'=>'平台提交报价','platform_quote_created'=>'平台新增报价','quote_selected_pending_payment'=>'用户选择报价',\n        'booking_fee_paid'=>'预约费支付成功','booking_fee_paid_upfront'=>'下单预约费支付成功','payment_reservation_released'=>'支付占位已释放',\n        'worker_invite_created'=>'生成邀请师傅分享','invite_claimed'=>'受邀师傅领取订单','worker_assigned'=>'管理员安排师傅','order_grabbed'=>'师傅抢单成功','single_grab_quote_confirmed'=>'抢单报价直接成交','single_grab_fixed_price_accepted'=>'按期望总价抢单成交','assignment_accepted'=>'师傅确认接单','contact_revealed'=>'完整联系信息已开放',\n        'appointment_recorded'=>'电话预约已记录','exceptional_arrival_reported'=>'到场异常已提交','change_requested'=>'师傅申请加价','change_accepted'=>'用户同意加价','change_rejected'=>'用户拒绝加价',\n        'measurement_service_paid'=>'测量服务款已补齐','measurement_change_accepted_pending_payment'=>'测量加费待支付','measurement_change_paid'=>'测量现场加费已支付','measurement_change_refund_created'=>'测量加费已登记退款','measurement_change_refunded'=>'测量加费已退款','measurement_late_balance_refund_created'=>'测量补款已登记退款','measurement_late_balance_refunded'=>'测量补款已退款',\n        'measurement_result_submitted'=>'测量成果已提交','measurement_result_accepted'=>'测量成果已确认','measurement_auto_accepted'=>'测量成果自动确认','measurement_rework_requested'=>'用户要求补测',\n        'measurement_hold_extension_requested'=>'申请延长测量冻结期','measurement_hold_extension_approved'=>'测量冻结延期已批准','measurement_hold_extension_rejected'=>'测量冻结延期未批准',\n        'measurement_income_released'=>'测量收入已释放','measurement_construction_linked'=>'测量单已关联施工',\n        'offline_collection_delayed'=>'线下尾款延期已登记','offline_collection_bad_debt'=>'线下尾款已标记坏账','completion_submitted'=>'师傅提交完工','completion_accepted_by_user'=>'用户确认验收','auto_completion_accepted'=>'系统自动验收','auto_accepted_72h'=>'72小时自动验收',\n        'auto_reviewed_5d'=>'5天自动评价','review_submitted'=>'用户提交评价','commission_receivable_created'=>'生成平台服务费账单','commission_paid'=>'平台服务费已结清',\n        'cancel_requested'=>'用户申请退款取消','cancel_approved'=>'管理员同意取消退款','admin_cancelled'=>'管理员强制取消','forced_cancel_refund'=>'管理员强制取消退款','auto_cancelled_7d'=>'7天未成交自动取消',\n        'cancel_rejected'=>'取消退款申请未通过','cancel_approved'=>'取消退款审核通过','refund_succeeded'=>'预约费退款成功','dispute_opened'=>'订单进入争议处理','dispute_resolved'=>'订单争议已结案','order_demo_seeded'=>'测试流程数据建立',\n        'test_center_scenario_built'=>'测试场景已生成（预置数据）',\n        'test_center_preset_preapproved'=>'已预置审核通过状态（未执行人工审核）',\n        'test_center_preset_target_built'=>'测试订单目标状态已生成（预置数据）',\n        'test_center_preset_worker_quote'=>'已预置师傅报价（未执行真实报价）',\n        'test_center_linked_construction_ready'=>'关联施工测试单已就绪（预置数据）',\n        'test_center_proxy_ready'=>'普通代录测试草稿已就绪'\n    ];\n    return isset($map[$eventType]) ? $map[$eventType] : '订单流程记录';\n}\n\nfunction audit($action, $resourceType, $resourceId = null, $description = '', $before = null, $after = null)\n{\n    if (!is_installed()) {\n        return;\n    }\n    try {\n        $admin = auth()->user();\n        // 2026-08-14：审计字段与不可变审计表保持一致，记录操作者快照及业务对象。\n        db()->execute(\n            \"INSERT INTO audit_logs (request_id, actor_type, actor_id, actor_name_snapshot, action, entity_type, entity_id, before_json, after_json, reason, ip_address, user_agent, result, created_at) VALUES (:request_id,'admin',:actor_id,:actor_name,:action,:entity_type,:entity_id,:before_json,:after_json,:reason,:ip,:ua,'success',NOW())\",\n            [\n                'actor_id' => $admin ? $admin['id'] : null,\n                'actor_name' => $admin ? ($admin['real_name'] ?: $admin['username']) : 'system',\n                'action' => $action,\n                'entity_type' => $resourceType,\n                'entity_id' => $resourceId === null ? null : (string) $resourceId,\n                'reason' => $description,\n                'before_json' => $before === null ? null : json_encode($before, JSON_UNESCAPED_UNICODE),\n                'after_json' => $after === null ? null : json_encode($after, JSON_UNESCAPED_UNICODE),\n                'ip' => request_ip(),\n                'ua' => substr(isset($_SERVER['HTTP_USER_AGENT']) ? $_SERVER['HTTP_USER_AGENT'] : 'cli', 0, 500),\n                'request_id' => request_id(),\n            ]\n        );\n    } catch (Throwable $exception) {\n        write_log('audit', '[' . date('c') . '] ' . $exception->getMessage() . \"\\n\");\n    }\n}\n\nfunction setting($key, $default = null)\n{\n    static $cache = [];\n    if (array_key_exists($key, $cache)) {\n        return $cache[$key];\n    }\n    try {\n        $row = db()->fetch('SELECT setting_value, value_type FROM system_settings WHERE setting_key = :key LIMIT 1', ['key' => $key]);\n        if (!$row) {\n            return $cache[$key] = $default;\n        }\n        $value = $row['setting_value'];\n        // 2026-08-25：新设置按运营要求明文保存；这里继续兼容读取升级前已有的 enc:v1 密文。\n        if (is_string($value) && strpos($value, 'enc:v1:') === 0) {\n            $value = decrypt_private_value($value, 'system-setting:' . (string) $key);\n        }\n        if (in_array($row['value_type'], ['int', 'integer'], true)) {\n            $value = (int) $value;\n        } elseif (in_array($row['value_type'], ['bool', 'boolean'], true)) {\n            $value = in_array(strtolower((string) $value), ['1', 'true', 'yes', 'on'], true);\n        } elseif ($row['value_type'] === 'json') {\n            $decoded = json_decode((string) $value, true);\n            $value = json_last_error() === JSON_ERROR_NONE ? $decoded : $default;\n        }\n        return $cache[$key] = $value;\n    } catch (Throwable $exception) {\n        return $default;\n    }\n}\n","server/app/Contracts/SubscribeMessageGateway.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface SubscribeMessageGateway\n{\n    public function categoryList(): array;\n    public function publicTemplateTitles(array $categoryIds, int $start = 0, int $limit = 30): array;\n    public function publicTemplateKeywords(string $tid): array;\n    public function addTemplate(string $tid, array $kidList, string $sceneDesc = ''): string;\n    public function templateList(): array;\n    public function send(array $payload): array;\n}\n"},"encodings":{"server/tests/fixtures/schema-2.6.0.sql.gz":"base64"},"blob_shas":{"chat/build.sh":"c9d2e8c654fac590d6533b2dfaa9d6e31e3d1aaa","chat/cmd/chatd/main.go":"ecd53d4d9b8d37dd714e8148a8e606a52801870f","chat/go.mod":"9e5d6b33a9a9fd732dcd518a1e8a8a3c7af2deba","chat/go.sum":"fb24675236722882b2484e1d8be224fa18a08a0e","chat/internal/auth/auth_test.go":"ee4c10778cc9abd6326ed781f4e924379c137eb3","chat/internal/auth/config.go":"0e0744e04da056a2450467411c085136ab5e76f7","chat/internal/auth/http.go":"09e194a71335c5c52cb408c5bbcf0d437b48fafd","chat/internal/auth/http_test.go":"b9706f2cc2085772a30f4cb3fcf3fafbf19c6e36","ch