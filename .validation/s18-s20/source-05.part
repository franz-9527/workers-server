n\t\t\treturn AuditList{}, err\n\t\t}\n\t}\n\t_ = c\n\treturn g.auditListPage(ctx, tx, p, token, limit, c)\n}\n\ntype ReminderSummary struct {\n\tID           ports.ID  `json:\"cluster_id\"`\n\tConversation ports.ID  `json:\"conversation_id\"`\n\tRecipient    ports.ID  `json:\"recipient_id\"`\n\tFirstDue     time.Time `json:\"first_due_at\"`\n\tTarget       ports.ID  `json:\"target_seq\"`\n\tLastNotified ports.ID  `json:\"last_notified_seq\"`\n\tRounds       int       `json:\"successful_rounds\"`\n\tState        string    `json:\"state\"`\n\tDiagnostic   string    `json:\"diagnostic\"`\n}\n\nfunc (g *GovernanceService) ReminderSummaries(ctx context.Context, p ports.Principal, after ports.ID) ([]ReminderSummary, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn nil, err\n\t}\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(c.id AS CHAR),CAST(c.conversation_id AS CHAR),CAST(c.recipient_id AS CHAR),c.first_due_at,CAST(c.target_seq AS CHAR),CAST(c.last_notified_seq AS CHAR),c.rounds,c.state,COALESCE(c.blocked_reason,(SELECT i.diagnostic FROM chat_reminder_intents i WHERE i.cluster_id=c.id AND i.round_version=c.round_version ORDER BY i.id DESC LIMIT 1),'') FROM chat_reminder_clusters c WHERE c.id>? AND c.first_due_at<=UTC_TIMESTAMP(6) ORDER BY c.id LIMIT 20`, string(after))\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tout := []ReminderSummary{}\n\tfor rows.Next() {\n\t\tvar v ReminderSummary\n\t\tif rows.Scan(&v.ID, &v.Conversation, &v.Recipient, &v.FirstDue, &v.Target, &v.LastNotified, &v.Rounds, &v.State, &v.Diagnostic) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tout = append(out, v)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"reminders.summary\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\treturn nil, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn nil, err\n\t}\n\treturn out, nil\n}\n","chat/internal/message/audit_list.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc (g *GovernanceService) encodeAuditCursor(p ports.Principal, c auditCursor) (string, error) {\n\ta, err := g.history.digestAEAD()\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\traw, _ := json.Marshal(c)\n\tnonce := make([]byte, a.NonceSize())\n\tif _, err = rand.Read(nonce); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn base64.RawURLEncoding.EncodeToString(append(nonce, a.Seal(nil, nonce, raw, []byte(\"audit:\"+bindingFor(g.environment, p)))...)), nil\n}\nfunc (g *GovernanceService) decodeAuditCursor(token string, p ports.Principal, c *auditCursor) error {\n\tif len(token) > 1024 {\n\t\treturn ErrResync\n\t}\n\tb, err := base64.RawURLEncoding.Strict().DecodeString(token)\n\tif err != nil {\n\t\treturn ErrResync\n\t}\n\ta, err := g.history.digestAEAD()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif len(b) < a.NonceSize()+a.Overhead() {\n\t\treturn ErrResync\n\t}\n\traw, err := a.Open(nil, b[:a.NonceSize()], b[a.NonceSize():], []byte(\"audit:\"+bindingFor(g.environment, p)))\n\tif err != nil || json.Unmarshal(raw, c) != nil || len(c.Snapshot) != 64 || !validID(c.After) || c.At.IsZero() {\n\t\treturn ErrResync\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) auditListPage(ctx context.Context, tx *sql.Tx, p ports.Principal, token string, limit int, c auditCursor) (AuditList, error) {\n\tvar live bool\n\tif tx.QueryRowContext(ctx, `SELECT expires_at>UTC_TIMESTAMP(6) FROM chat_audit_snapshots WHERE id=? AND binding=? LOCK IN SHARE MODE`, c.Snapshot, bindingFor(g.environment, p)).Scan(&live) != nil || !live {\n\t\treturn AuditList{}, ErrResync\n\t}\n\tquery := `SELECT CAST(conversation_id AS CHAR),CAST(order_id AS CHAR),activity_at FROM chat_audit_snapshot_items WHERE snapshot_id=?`\n\targs := []any{c.Snapshot}\n\tif token != \"\" {\n\t\tquery += ` AND (activity_at<? OR (activity_at=? AND conversation_id<?))`\n\t\targs = append(args, c.At, c.At, string(c.After))\n\t}\n\tquery += ` ORDER BY activity_at DESC,conversation_id DESC LIMIT ?`\n\targs = append(args, limit+1)\n\trows, err := tx.QueryContext(ctx, query, args...)\n\tif err != nil {\n\t\treturn AuditList{}, ports.ErrUnavailable\n\t}\n\tout := AuditList{Items: []AuditConversation{}}\n\tfor rows.Next() {\n\t\tvar item AuditConversation\n\t\tif rows.Scan(&item.ID, &item.OrderID, &item.Activity) != nil {\n\t\t\trows.Close()\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tout.Items = append(out.Items, item)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn AuditList{}, ports.ErrUnavailable\n\t}\n\tif len(out.Items) > limit {\n\t\tout.More = true\n\t\tout.Items = out.Items[:limit]\n\t\tlast := out.Items[len(out.Items)-1]\n\t\tc.At = last.Activity\n\t\tc.After = last.ID\n\t\tout.Cursor, err = g.encodeAuditCursor(p, c)\n\t\tif err != nil {\n\t\t\treturn AuditList{}, err\n\t\t}\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.list\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\treturn out, nil\n}\n\n// Explicit bounded maintenance; snapshot expiration never reorders a live page.\nfunc (g *GovernanceService) CleanupSnapshots(ctx context.Context) error {\n\t_, err := g.base.db.ExecContext(ctx, `DELETE FROM chat_audit_snapshots WHERE expires_at<=UTC_TIMESTAMP(6) ORDER BY expires_at LIMIT 10`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/audit_history.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Audit history has its own scope and cursor namespace. It never invokes\n// member bootstrap, read acknowledgements, presence or personal preferences.\nfunc (g *GovernanceService) AuditHistory(ctx context.Context, p ports.Principal, q HistoryRequest) (HistoryPage, error) {\n\tif !validID(q.ConversationID) || q.Limit < 0 || q.Limit > 50 || q.TargetID != \"\" && !validID(q.TargetID) || q.TargetID != \"\" && q.Cursor != \"\" {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, g.base.timeout)\n\tdefer cancel()\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tvar seq, change, floor uint64\n\tvar version ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq,sync_floor_seq,CAST(policy_version AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`, string(q.ConversationID)).Scan(&seq, &change, &floor, &version) != nil {\n\t\treturn HistoryPage{}, ErrResync\n\t}\n\tc := historyCursor{Schema: 1, Mode: \"audit.history\", Binding: bindingFor(g.environment, p), Conversation: q.ConversationID, Policy: version, Member: \"audit\", Seq: decimal(seq), Change: decimal(change), Position: decimal(seq), Issued: time.Now().Unix(), Expiry: time.Now().Add(cursorTTL).Unix()}\n\tif q.Cursor != \"\" {\n\t\tc, err = g.history.parse(q.Cursor, \"audit.history\")\n\t\tif err != nil || c.Binding != bindingFor(g.environment, p) || c.Conversation != q.ConversationID || number(c.Seq) > seq || number(c.Position) < floor {\n\t\t\treturn HistoryPage{}, ErrResync\n\t\t}\n\t}\n\tlimit := q.Limit\n\tif limit == 0 {\n\t\tlimit = 30\n\t}\n\tout := HistoryPage{MemberRole: \"audit\", CanSend: false, ViewerID: p.ActorID, Messages: []MessageView{}, Changes: []ChangeView{}, PolicyVersion: version, SnapshotMaxSeq: c.Seq, SnapshotMaxChange: c.Change, ExpiresAt: c.Expiry}\n\tquery := `SELECT ` + viewColumns + `,1 FROM chat_messages m WHERE m.conversation_id=? AND m.seq>? AND m.seq<=? AND m.seq<=? ORDER BY m.seq DESC LIMIT ?`\n\tpos := number(c.Position)\n\tif q.TargetID != \"\" {\n\t\tvar target uint64\n\t\tif tx.QueryRowContext(ctx, `SELECT seq FROM chat_messages WHERE conversation_id=? AND id=? AND seq>? AND seq<=?`, string(q.ConversationID), string(q.TargetID), floor, seq).Scan(&target) != nil {\n\t\t\treturn HistoryPage{}, ErrResync\n\t\t}\n\t\tpos = target + uint64(limit/2)\n\t\tif pos > seq {\n\t\t\tpos = seq\n\t\t}\n\t}\n\trows, err := tx.QueryContext(ctx, query, string(q.ConversationID), floor, string(c.Seq), pos, limit+1)\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tfor rows.Next() {\n\t\tv, e := scanCandidate(rows, false)\n\t\tif e != nil {\n\t\t\trows.Close()\n\t\t\treturn out, e\n\t\t}\n\t\tout.Messages = append(out.Messages, v.view)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif len(out.Messages) > limit {\n\t\tout.HasMore = true\n\t\tout.Messages = out.Messages[:limit]\n\t\tc.Position = decimal(number(out.Messages[len(out.Messages)-1].Seq) - 1)\n\t\tout.HistoryCursor = g.history.sign(c)\n\t}\n\tfor i, j := 0, len(out.Messages)-1; i < j; i, j = i+1, j-1 {\n\t\tout.Messages[i], out.Messages[j] = out.Messages[j], out.Messages[i]\n\t}\n\tviews := make([]*MessageView, 0, len(out.Messages))\n\tfor i := range out.Messages {\n\t\tviews = append(views, &out.Messages[i])\n\t}\n\tif err = hydrateImages(ctx, tx, views); err != nil {\n\t\treturn out, err\n\t}\n\tif err = hydrateReferenceScope(ctx, tx, p, ports.Grant{}, q.ConversationID, views, true); err != nil {\n\t\treturn out, err\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.history\", q.ConversationID, q.TargetID, \"\", version, \"\"); err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) AuditImage(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, thumb bool) (string, error) {\n\tif g.media == nil || !validID(cid) || !validID(mid) || !validID(item) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn \"\", err\n\t}\n\tvar id ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`, string(cid)).Scan(&id) != nil {\n\t\treturn \"\", ErrResync\n\t}\n\tcol := \"u.main_key\"\n\tif thumb {\n\t\tcol = \"u.thumb_key\"\n\t}\n\tvar key string\n\tvar version ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT `+col+`,CAST(m.state_version AS CHAR) FROM chat_messages m JOIN chat_image_items i ON i.message_id=m.id JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE m.conversation_id=? AND m.id=? AND i.item_id=? AND m.state='published' AND `+retainedTarget, string(cid), string(mid), string(item)).Scan(&key, &version) != nil || key == \"\" {\n\t\treturn \"\", ErrMedia\n\t}\n\turl, err := g.media.storage.Sign(ctx, key, 60*time.Second)\n\tif err != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.image\", cid, mid, item, version, \"\"); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn url, nil\n}\n","chat/internal/message/restrictions.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Restriction struct {\n\tActor          ports.ID   `json:\"actor_id\"`\n\tVersion        ports.ID   `json:\"version\"`\n\tPermanent      bool       `json:\"permanent\"`\n\tUntil          *time.Time `json:\"blocked_until,omitempty\"`\n\tBlocked        bool       `json:\"blocked\"`\n\tConfirmedRisks uint64     `json:\"confirmed_risks\"`\n}\ntype RestrictionRequest struct {\n\tActor    ports.ID `json:\"actor_id\"`\n\tExpected ports.ID `json:\"expected_version\"`\n\tAction   string   `json:\"action\"`\n\tSeconds  int      `json:\"seconds,omitempty\"`\n\tReason   string   `json:\"reason\"`\n}\n\nfunc restrictionLocked(ctx context.Context, tx *sql.Tx, id ports.ID) (Restriction, error) {\n\tif _, err := tx.ExecContext(ctx, `INSERT INTO chat_restrictions(actor_id,version,updated_at) VALUES(?,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(id)); err != nil {\n\t\treturn Restriction{}, ports.ErrUnavailable\n\t}\n\tout := Restriction{Actor: id}\n\tvar until sql.NullTime\n\tif tx.QueryRowContext(ctx, `SELECT CAST(version AS CHAR),permanent,blocked_until,(permanent=1 OR blocked_until>UTC_TIMESTAMP(6)) IS TRUE FROM chat_restrictions WHERE actor_id=? FOR UPDATE`, string(id)).Scan(&out.Version, &out.Permanent, &until, &out.Blocked) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif until.Valid {\n\t\tv := until.Time\n\t\tout.Until = &v\n\t}\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_risk_events WHERE sender_id=? AND confirmed=1 AND review_state<>'corrected'`, string(id)).Scan(&out.ConfirmedRisks) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) Restriction(ctx context.Context, p ports.Principal, actor ports.ID) (Restriction, error) {\n\tif !validID(actor) {\n\t\treturn Restriction{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tdefer tx.Rollback()\n\tif p.Kind == \"mini\" && p.ActorID == actor && p.Environment == g.environment {\n\t\terr = g.source.ValidatePrincipalLocked(ctx, tx, p)\n\t} else {\n\t\terr = g.admin(ctx, tx, p, \"chat:moderate\")\n\t}\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tout, err := restrictionLocked(ctx, tx, actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) Restrict(ctx context.Context, p ports.Principal, q RestrictionRequest) (Restriction, error) {\n\tif !validID(q.Actor) || !q.Expected.Valid() || !reasonValid(q.Reason) || q.Action != \"unban\" && q.Action != \"permanent\" && q.Action != \"timed\" || q.Action == \"timed\" && (q.Seconds < 60 || q.Seconds > 30*86400) || q.Action != \"timed\" && q.Seconds != 0 {\n\t\treturn Restriction{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:moderate\"); err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tvar actor ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM users WHERE id=? LOCK IN SHARE MODE`, string(q.Actor)).Scan(&actor) != nil {\n\t\treturn Restriction{}, auth.ErrUnauthorized\n\t}\n\tout, err := restrictionLocked(ctx, tx, q.Actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif out.Version != q.Expected {\n\t\treturn out, ErrPreferenceConflict\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET permanent=?,blocked_until=IF(?='timed',TIMESTAMPADD(SECOND,?,UTC_TIMESTAMP(6)),NULL),version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, q.Action == \"permanent\", q.Action, q.Seconds, string(q.Actor)); err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"restriction.\"+q.Action, \"\", q.Actor, \"\", decimal(number(out.Version)+1), q.Reason); err != nil {\n\t\treturn out, err\n\t}\n\tout, err = restrictionLocked(ctx, tx, q.Actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n\n// Ban expiry uses the permanent stable row, exactly as send and manual unban.\nfunc (g *GovernanceService) ExpireRestrictions(ctx context.Context) error {\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(actor_id AS CHAR) FROM chat_restrictions WHERE permanent=0 AND blocked_until<=UTC_TIMESTAMP(6) ORDER BY actor_id LIMIT 50 FOR UPDATE`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,target_id,target_version,reason,created_at) SELECT 'system',0,REPEAT('0',64),'restriction.expire',actor_id,version+1,'限时禁聊到期',UTC_TIMESTAMP(6) FROM chat_restrictions WHERE actor_id=?`, string(id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/cases.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Case struct {\n\tID            ports.ID  `json:\"case_id\"`\n\tKind          string    `json:\"kind\"`\n\tTargetType    string    `json:\"target_type\"`\n\tTarget        ports.ID  `json:\"target_id\"`\n\tItem          ports.ID  `json:\"item_id\"`\n\tConversation  ports.ID  `json:\"conversation_id\"`\n\tReporter      ports.ID  `json:\"reporter_id\"`\n\tSubject       ports.ID  `json:\"subject_id\"`\n\tVersion       ports.ID  `json:\"version\"`\n\tState         string    `json:\"state\"`\n\tReason        string    `json:\"reason\"`\n\tResolution    string    `json:\"resolution\"`\n\tCreated       time.Time `json:\"created_at\"`\n\tFingerprint   string    `json:\"fingerprint\"`\n\tTargetVersion ports.ID  `json:\"target_version\"`\n}\n\nconst caseColumns = `CAST(id AS CHAR),kind,target_type,CAST(target_id AS CHAR),CAST(item_id AS CHAR),CAST(conversation_id AS CHAR),CAST(reporter_id AS CHAR),CAST(subject_id AS CHAR),CAST(version AS CHAR),state,reason,COALESCE(resolution,''),created_at,fingerprint,CAST(target_version AS CHAR)`\n\ntype CasePage struct {\n\tItems []Case   `json:\"items\"`\n\tAfter ports.ID `json:\"next_after\"`\n\tMore  bool     `json:\"has_more\"`\n}\n\nfunc scanCase(row interface{ Scan(...any) error }) (Case, error) {\n\tvar c Case\n\terr := row.Scan(&c.ID, &c.Kind, &c.TargetType, &c.Target, &c.Item, &c.Conversation, &c.Reporter, &c.Subject, &c.Version, &c.State, &c.Reason, &c.Resolution, &c.Created, &c.Fingerprint, &c.TargetVersion)\n\tif err != nil {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\treturn c, nil\n}\nfunc createCase(ctx context.Context, tx *sql.Tx, kind, targetType string, target, item, cid, reporter, subject, version ports.ID, fp, reason string) (ports.ID, error) {\n\tvar id ports.ID\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_cases WHERE kind=? AND target_type=? AND target_id=? AND item_id=? AND reporter_id=? AND (kind<>'appeal' OR target_version=?)`, kind, targetType, string(target), string(item), string(reporter), string(version)).Scan(&id)\n\tif err == nil {\n\t\treturn id, nil\n\t}\n\tif err != sql.ErrNoRows {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tvar n int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_cases WHERE reporter_id=? AND kind<>'review' AND created_at>UTC_TIMESTAMP()-INTERVAL 1 DAY`, string(reporter)).Scan(&n) != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif n >= 20 && kind != \"review\" {\n\t\treturn \"\", ports.ErrBusy\n\t}\n\tr, err := tx.ExecContext(ctx, `INSERT INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,'pending',1,UTC_TIMESTAMP(6)+INTERVAL 30 DAY,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE id=LAST_INSERT_ID(id)`, kind, targetType, string(target), string(item), string(cid), string(reporter), string(subject), string(version), fp, reason)\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tn64, err := r.LastInsertId()\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn decimal(uint64(n64)), nil\n}\nfunc (g *GovernanceService) Report(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, reason string) (ports.ID, error) {\n\tif !validID(cid) || !validID(mid) || item != \"\" && !validID(item) || !reasonValid(reason) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tif item == \"\" {\n\t\titem = \"0\"\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tauthority, err := g.base.conversations.LockAuthority(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif _, err = restrictionLocked(ctx, tx, p.ActorID); err != nil {\n\t\treturn \"\", err\n\t}\n\tgrant, err := g.base.conversations.LockProjection(ctx, tx, authority)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tvar subject, version ports.ID\n\tvar fp string\n\tif tx.QueryRowContext(ctx, `SELECT CAST(m.sender_id AS CHAR),CAST(m.state_version AS CHAR),SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn, string(cid), string(mid), string(grant.Version), string(p.ActorID)).Scan(&subject, &version, &fp) != nil {\n\t\treturn \"\", ErrResync\n\t}\n\tif item != \"0\" {\n\t\tvar n int\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_image_items WHERE message_id=? AND item_id=?`, string(mid), string(item)).Scan(&n) != nil || n != 1 {\n\t\t\treturn \"\", ErrMedia\n\t\t}\n\t}\n\tid, err := createCase(ctx, tx, \"report\", \"message\", mid, item, cid, p.ActorID, subject, version, fp, reason)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads u JOIN chat_image_items i ON i.item_id=u.id SET u.legal_hold=1 WHERE i.message_id=?`, string(mid)); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.report\", cid, id, item, version, reason); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn id, nil\n}\nfunc (g *GovernanceService) Appeal(ctx context.Context, p ports.Principal, targetType string, target, expected ports.ID, reason string) (ports.ID, error) {\n\tif !validID(target) || !expected.Valid() || !reasonValid(reason) || targetType != \"risk\" && targetType != \"image_intent\" && targetType != \"restriction\" || p.Environment != g.environment {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.source.ValidatePrincipalLocked(ctx, tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\tstatus, err := restrictionLocked(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tcid, subject, version, fp := ports.ID(\"0\"), p.ActorID, ports.ID(\"1\"), \"\"\n\tswitch targetType {\n\tcase \"risk\":\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),content_fingerprint FROM chat_risk_events WHERE id=? AND sender_id=? AND retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`, string(target), string(p.ActorID)).Scan(&cid, &fp) != nil {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\tcase \"image_intent\":\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(i.conversation_id AS CHAR),b.manifest_hash,CAST(b.review_version AS CHAR) FROM chat_send_intents i JOIN chat_image_bundles b ON b.intent_id=i.id WHERE i.id=? AND i.sender_id=? AND i.state='rejected' AND i.retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`, string(target), string(p.ActorID)).Scan(&cid, &fp, &version) != nil {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\tcase \"restriction\":\n\t\tif target != p.ActorID || status.Version != expected || !status.Blocked {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\t\tversion = status.Version\n\t\tfp = memberHash(string(p.ActorID) + \":\" + string(version))\n\t}\n\tif targetType != \"restriction\" && version != expected {\n\t\treturn \"\", ErrResync\n\t}\n\tid, err := createCase(ctx, tx, \"appeal\", targetType, target, \"0\", cid, p.ActorID, subject, version, fp, reason)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif targetType == \"risk\" {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET retain_until=GREATEST(retain_until,UTC_TIMESTAMP(6)+INTERVAL 30 DAY) WHERE id=?`, string(target)); err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t}\n\tif targetType == \"image_intent\" {\n\t\titems, e := caseImageItems(ctx, tx, Case{TargetType: targetType, Target: target, Fingerprint: fp})\n\t\tif e != nil {\n\t\t\treturn \"\", e\n\t\t}\n\t\tfor _, v := range items {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET legal_hold=1 WHERE id=? AND actor_id=? AND conversation_id=?`, string(v.ItemID), string(p.ActorID), string(cid)); err != nil {\n\t\t\t\treturn \"\", ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.appeal\", cid, id, \"\", version, reason); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn id, nil\n}\nfunc (g *GovernanceService) Cases(ctx context.Context, p ports.Principal, after ports.ID, admin bool) (CasePage, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn CasePage{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn CasePage{}, err\n\t}\n\tdefer tx.Rollback()\n\tif admin {\n\t\terr = g.admin(ctx, tx, p, \"chat:moderate\")\n\t} else if p.Environment == g.environment {\n\t\terr = g.source.ValidatePrincipalLocked(ctx, tx, p)\n\t} else {\n\t\terr = ports.ErrInvalid\n\t}\n\tif err != nil {\n\t\treturn CasePage{}, err\n\t}\n\tquery := `SELECT ` + caseColumns + ` FROM chat_cases WHERE id>?`\n\targs := []any{string(after)}\n\tif !admin {\n\t\tquery += ` AND reporter_id=?`\n\t\targs = append(args, string(p.ActorID))\n\t}\n\tquery += ` ORDER BY id LIMIT 21`\n\trows, err := tx.QueryContext(ctx, query, args...)\n\tif err != nil {\n\t\treturn CasePage{}, ports.ErrUnavailable\n\t}\n\tout := CasePage{Items: []Case{}, After: after}\n\tfor rows.Next() {\n\t\tc, e := scanCase(rows)\n\t\tif e != nil {\n\t\t\trows.Close()\n\t\t\treturn out, e\n\t\t}\n\t\tif !admin {\n\t\t\tc.Fingerprint = \"\"\n\t\t\tc.Subject = \"0\"\n\t\t}\n\t\tout.Items = append(out.Items, c)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif len(out.Items) > 20 {\n\t\tout.More = true\n\t\tout.Items = out.Items[:20]\n\t}\n\tif len(out.Items) > 0 {\n\t\tout.After = out.Items[len(out.Items)-1].ID\n\t}\n\tif admin {\n\t\tif err = governanceLog(ctx, tx, p, \"case.list\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\t\treturn out, err\n\t\t}\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n","chat/internal/message/case_review.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Evidence struct {\n\tCase        Case        `json:\"case\"`\n\tText        *string     `json:\"text,omitempty\"`\n\tContext     *string     `json:\"context,omitempty\"`\n\tItems       []ImageView `json:\"items\"`\n\tUnavailable bool        `json:\"unavailable\"`\n\tURL         string      `json:\"url,omitempty\"`\n}\n\nfunc (g *GovernanceService) caseLock(ctx context.Context, tx *sql.Tx, id ports.ID) (Case, error) {\n\tvar cid, subject ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),CAST(subject_id AS CHAR) FROM chat_cases WHERE id=?`, string(id)).Scan(&cid, &subject) != nil {\n\t\treturn Case{}, ErrResync\n\t}\n\t// Same actor -> conversation order used by send, ban and publication.\n\tif _, err := restrictionLocked(ctx, tx, subject); err != nil {\n\t\treturn Case{}, err\n\t}\n\tif cid != \"0\" {\n\t\tvar found ports.ID\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? FOR UPDATE`, string(cid)).Scan(&found) != nil {\n\t\t\treturn Case{}, ErrResync\n\t\t}\n\t}\n\treturn scanCase(tx.QueryRowContext(ctx, `SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(id)))\n}\nfunc caseImageItems(ctx context.Context, tx *sql.Tx, c Case) ([]ImageView, error) {\n\titems := []ImageView{}\n\tif c.TargetType == \"message\" {\n\t\tquery := `SELECT CAST(i.item_id AS CHAR),i.ordinal,u.width_px,u.height_px FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=?`\n\t\targs := []any{string(c.Target)}\n\t\tif c.Item != \"0\" {\n\t\t\tquery += ` AND i.item_id=?`\n\t\t\targs = append(args, string(c.Item))\n\t\t}\n\t\tquery += ` ORDER BY i.ordinal LIMIT 9`\n\t\trows, err := tx.QueryContext(ctx, query, args...)\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tfor rows.Next() {\n\t\t\tvar v ImageView\n\t\t\tif rows.Scan(&v.ItemID, &v.Ordinal, &v.Width, &v.Height) != nil {\n\t\t\t\trows.Close()\n\t\t\t\treturn nil, ports.ErrUnavailable\n\t\t\t}\n\t\t\titems = append(items, v)\n\t\t}\n\t\terr = rows.Err()\n\t\trows.Close()\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t} else if c.TargetType == \"image_intent\" {\n\t\tvar raw, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT manifest_json,manifest_hash FROM chat_image_bundles WHERE intent_id=?`, string(c.Target)).Scan(&raw, &fp) != nil || fp != c.Fingerprint {\n\t\t\treturn nil, ErrMediaVersion\n\t\t}\n\t\tvar q Request\n\t\tif json.Unmarshal([]byte(raw), &q) != nil || len(q.Items) < 1 || len(q.Items) > 9 {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tfor _, v := range q.Items {\n\t\t\titems = append(items, ImageView{ItemID: v.AttachmentID, Ordinal: v.Ordinal})\n\t\t}\n\t}\n\treturn items, nil\n}\nfunc (g *GovernanceService) Evidence(ctx context.Context, p ports.Principal, id, expected, item ports.ID, reason string) (Evidence, error) {\n\tif !validID(id) || !validID(expected) || item != \"\" && !validID(item) || !reasonValid(reason) {\n\t\treturn Evidence{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:evidence\"); err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tc, err := g.caseLock(ctx, tx, id)\n\tif err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tif c.Version != expected {\n\t\treturn Evidence{}, ErrMediaVersion\n\t}\n\tout := Evidence{Case: c, Items: []ImageView{}}\n\tswitch c.TargetType {\n\tcase \"risk\":\n\t\tvar text, context, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT text_evidence,context_evidence,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6)`, string(c.Target)).Scan(&text, &context, &fp) != nil || fp != c.Fingerprint {\n\t\t\tout.Unavailable = true\n\t\t} else {\n\t\t\tout.Text = &text\n\t\t\tout.Context = &context\n\t\t}\n\tcase \"message\":\n\t\tvar text sql.NullString\n\t\tvar fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT m.text_body,SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.id=? AND m.conversation_id=? AND `+retainedTarget, string(c.Target), string(c.Conversation)).Scan(&text, &fp) != nil || fp != c.Fingerprint {\n\t\t\tout.Unavailable = true\n\t\t} else if text.Valid {\n\t\t\tout.Text = &text.String\n\t\t}\n\tcase \"restriction\":\n\t\tout.Unavailable = false\n\tcase \"image_intent\":\n\tdefault:\n\t\treturn out, ports.ErrInvalid\n\t}\n\tout.Items, err = caseImageItems(ctx, tx, c)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif item != \"\" {\n\t\tfound := false\n\t\tfor _, v := range out.Items {\n\t\t\tif v.ItemID == item {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found || g.media == nil {\n\t\t\treturn out, ErrMedia\n\t\t}\n\t\tvar key string\n\t\tif c.TargetType == \"message\" {\n\t\t\terr = tx.QueryRowContext(ctx, `SELECT u.main_key FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=? AND i.item_id=?`, string(c.Target), string(item)).Scan(&key)\n\t\t} else {\n\t\t\tvar raw string\n\t\t\tif tx.QueryRowContext(ctx, `SELECT manifest_json FROM chat_image_bundles WHERE intent_id=?`, string(c.Target)).Scan(&raw) != nil {\n\t\t\t\treturn out, ErrMedia\n\t\t\t}\n\t\t\tvar q Request\n\t\t\tjson.Unmarshal([]byte(raw), &q)\n\t\t\tversion := \"\"\n\t\t\tfor _, v := range q.Items {\n\t\t\t\tif v.AttachmentID == item {\n\t\t\t\t\tversion = v.ObjectVersion\n\t\t\t\t}\n\t\t\t}\n\t\t\terr = tx.QueryRowContext(ctx, `SELECT main_key FROM chat_image_uploads WHERE id=? AND object_version=? AND legal_hold=1`, string(item), version).Scan(&key)\n\t\t}\n\t\tif err != nil || key == \"\" {\n\t\t\tout.Unavailable = true\n\t\t} else {\n\t\t\tout.URL, err = g.media.storage.Sign(ctx, key, 60*time.Second)\n\t\t\tif err != nil {\n\t\t\t\treturn out, ErrMedia\n\t\t\t}\n\t\t}\n\t}\n\taction := \"case.evidence\"\n\tif out.Unavailable {\n\t\taction = \"evidence.unavailable\"\n\t}\n\tif item != \"\" && out.URL == \"\" {\n\t\taction = \"evidence.unavailable\"\n\t}\n\tif err = governanceLog(ctx, tx, p, action, c.Conversation, c.ID, item, c.Version, reason); err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n\ntype CaseDecision struct {\n\tID       ports.ID `json:\"case_id\"`\n\tExpected ports.ID `json:\"expected_version\"`\n\tAction   string   `json:\"action\"`\n\tReason   string   `json:\"reason\"`\n}\n\nfunc (g *GovernanceService) Decide(ctx context.Context, p ports.Principal, q CaseDecision) (Case, error) {\n\tif !validID(q.ID) || !validID(q.Expected) || !reasonValid(q.Reason) || q.Action != \"confirm\" && q.Action != \"correct\" && q.Action != \"dismiss\" && q.Action != \"block\" {\n\t\treturn Case{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Case{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:moderate\"); err != nil {\n\t\treturn Case{}, err\n\t}\n\tc, err := g.caseLock(ctx, tx, q.ID)\n\tif err != nil {\n\t\treturn c, err\n\t}\n\tif c.Version != q.Expected || c.State != \"pending\" {\n\t\treturn c, ErrMediaVersion\n\t}\n\tvar n int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id IS NULL AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`, p.Kind, string(p.ActorID), bindingFor(g.environment, p), string(c.ID), string(c.Version)).Scan(&n) != nil || n == 0 {\n\t\treturn c, ErrMedia\n\t}\n\t// A visible metadata list or thumbnail cannot satisfy full image evidence.\n\titems, err := caseImageItems(ctx, tx, c)\n\tif err != nil {\n\t\treturn c, err\n\t}\n\tfor _, v := range items {\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id=? AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`, p.Kind, string(p.ActorID), bindingFor(g.environment, p), string(c.ID), string(c.Version), string(v.ItemID)).Scan(&n) != nil || n == 0 {\n\t\t\treturn c, ErrMedia\n\t\t}\n\t}\n\tswitch c.TargetType {\n\tcase \"risk\":\n\t\tvar riskState, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT review_state,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(c.Target)).Scan(&riskState, &fp) != nil || fp != c.Fingerprint {\n\t\t\treturn c, ErrResync\n\t\t}\n\t\tif riskState == \"corrected\" && q.Action == \"confirm\" {\n\t\t\treturn c, ErrMediaVersion\n\t\t}\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\tif q.Action == \"correct\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET confirmed=0,review_state='corrected' WHERE id=? AND content_fingerprint=?`, string(c.Target), c.Fingerprint); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t} else if q.Action == \"confirm\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET confirmed=1,review_state='confirmed' WHERE id=? AND content_fingerprint=? AND review_state<>'corrected'`, string(c.Target), c.Fingerprint); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tif q.Action == \"correct\" || q.Action == \"confirm\" {\n\t\t\tcode := \"CHAT_CONTENT_BLOCKED\"\n\t\t\tif q.Action == \"correct\" {\n\t\t\t\tcode = \"CHAT_REVIEW_CORRECTED\"\n\t\t\t}\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE risk_event_id=? AND state IN ('review_pending','rejected')`, code, string(c.Target)); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\t// No send-intent or message is resurrected by a successful appeal.\n\tcase \"restriction\":\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\tif q.Action == \"correct\" {\n\t\t\tr, err := restrictionLocked(ctx, tx, c.Subject)\n\t\t\tif err != nil {\n\t\t\t\treturn c, err\n\t\t\t}\n\t\t\tif r.Version != c.TargetVersion {\n\t\t\t\treturn c, ErrMediaVersion\n\t\t\t}\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET permanent=0,blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(c.Subject)); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\tcase \"message\":\n\t\tif q.Action == \"block\" {\n\t\t\tvar state string\n\t\t\tvar version, seq uint64\n\t\t\tif tx.QueryRowContext(ctx, `SELECT state,state_version,seq FROM chat_messages WHERE id=? AND conversation_id=? FOR UPDATE`, string(c.Target), string(c.Conversation)).Scan(&state, &version, &seq) != nil {\n\t\t\t\treturn c, ErrResync\n\t\t\t}\n\t\t\tif state == \"published\" {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_change_seq=last_change_seq+1 WHERE id=?`, string(c.Conversation)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_messages SET state='blocked',state_version=state_version+1 WHERE id=?`, string(c.Target)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT id,last_change_seq,?,?, 'message.blocked',UTC_TIMESTAMP(6) FROM chat_conversations WHERE id=?`, string(c.Target), version+1, string(c.Conversation)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\tcase \"image_intent\":\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\t// Only the governance result changes. Old rejected manifests stay rejected.\n\tdefault:\n\t\treturn c, ports.ErrInvalid\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_cases SET state=?,version=version+1,resolution=?,reviewer_id=?,decided_at=UTC_TIMESTAMP(6) WHERE id=?`, q.Action, q.Reason, string(p.ActorID), string(c.ID)); err != nil {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.\"+q.Action, c.Conversation, c.ID, c.Item, decimal(number(c.Version)+1), q.Reason); err != nil {\n\t\treturn c, err\n\t}\n\tc.State = q.Action\n\tc.Resolution = q.Reason\n\tc.Version = decimal(number(c.Version) + 1)\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn c, err\n\t}\n\tif q.Action == \"block\" && g.base.publisher != nil {\n\t\tg.base.publisher.Committed(ports.CommittedMessage{ConversationID: c.Conversation})\n\t}\n\treturn c, nil\n}\n","chat/internal/policy/recipient.go":"package policy\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Internal notification eligibility uses current PHP business authority and\n// account status. It does not fabricate a logged-in user or online presence.\nfunc (r *Reader) RecipientLocked(ctx context.Context, tx *sql.Tx, scope string, actor ports.ID) (Projection, ports.Grant, error) {\n\tp, err := r.CurrentLocked(ctx, tx, scope)\n\tif err != nil {\n\t\treturn p, ports.Grant{}, err\n\t}\n\tif err = r.CheckEpochsLocked(ctx, tx, p, actor, \"read\"); err != nil {\n\t\treturn p, ports.Grant{}, err\n\t}\n\tvar active bool\n\terr = tx.QueryRowContext(ctx, `SELECT status='active' FROM users WHERE id=? LOCK IN SHARE MODE`, string(actor)).Scan(&active)\n\tif err == sql.ErrNoRows {\n\t\treturn p, ports.Grant{}, ErrDenied\n\t}\n\tif err != nil {\n\t\treturn p, ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif !active {\n\t\treturn p, ports.Grant{}, ErrDenied\n\t}\n\tfor _, m := range p.Members {\n\t\tif m.ActorID == actor && m.Grant.CanRead {\n\t\t\treturn p, m.Grant, nil\n\t\t}\n\t}\n\treturn p, ports.Grant{}, ErrDenied\n}\n","chat/internal/conversation/reminders.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Server-side only: not an impersonation API and never grants send permission.\nfunc (s *Store) RecipientLocked(ctx context.Context, tx *sql.Tx, cid, actor ports.ID) (ports.Grant, error) {\n\tif !positive(cid) || !positive(actor) {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tvar scope, kind string\n\tif tx.QueryRowContext(ctx, `SELECT scope_key,conversation_type FROM chat_conversations WHERE id=?`, string(cid)).Scan(&scope, &kind) != nil || kind != \"order\" {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tprojection, grant, err := s.reader.RecipientLocked(ctx, tx, scope, actor)\n\tif err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\tauthority := &Authority{tx: tx, request: ports.PolicyRequest{Actor: ports.Principal{ActorID: actor, ExpiresAt: time.Now().Add(s.timeout)}, ConversationID: cid, Action: \"read\"}, projection: projection, grant: grant}\n\treturn s.LockProjection(ctx, tx, authority)\n}\n","chat/internal/message/reminders.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Publication persists only this wakeup; the worker may restart at any time.\nfunc reminderEvent(ctx context.Context, tx *sql.Tx, cid ports.ID, seq uint64) error {\n\t_, err := tx.ExecContext(ctx, `INSERT INTO chat_reminder_events(conversation_id,seq,created_at) VALUES(?,?,UTC_TIMESTAMP(6))`, string(cid), seq)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\ntype ReminderConfig struct {\n\tFirstDelaySeconds                                              int\n\tRecipientHourly, RecipientDaily, PlatformHourly, PlatformDaily int\n}\n\nfunc DefaultReminderConfig() ReminderConfig { return ReminderConfig{10, 3, 10, 1000, 10000} }\nfunc (c ReminderConfig) Validate() error {\n\tif c.FirstDelaySeconds < 1 || c.FirstDelaySeconds > 30 || c.RecipientHourly < 1 || c.RecipientHourly > 100 || c.RecipientDaily < c.RecipientHourly || c.RecipientDaily > 1000 || c.PlatformHourly < c.RecipientHourly || c.PlatformHourly > 100000 || c.PlatformDaily < c.PlatformHourly || c.PlatformDaily > 1000000 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\ntype ReminderService struct {\n\tbase         *Service\n\tnotification ports.Notification\n\tconfig       ReminderConfig\n}\ntype reminderReceipts interface {\n\tStatus(context.Context, string) (ports.Receipt, error)\n}\n\nfunc NewReminderService(base *Service, n ports.Notification) (*ReminderService, error) {\n\tif base == nil || n == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderService{base, n, DefaultReminderConfig()}, nil\n}\nfunc (r *ReminderService) WithConfig(c ReminderConfig) (*ReminderService, error) {\n\tif c.Validate() != nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tcopy := *r\n\tcopy.config = c\n\treturn &copy, nil\n}\n\ntype reminderWindow struct {\n\tGrant         ports.Grant\n\tHash          string\n\tFirst, Target uint64\n\tRead          uint64\n\tAt            time.Time\n}\n\nfunc (r *ReminderService) window(ctx context.Context, tx *sql.Tx, cid, actor ports.ID, target uint64) (reminderWindow, error) {\n\tgrant, err := r.base.conversations.RecipientLocked(ctx, tx, cid, actor)\n\tif err != nil {\n\t\treturn reminderWindow{}, err\n\t}\n\tout := reminderWindow{Grant: grant, Hash: memberHash(grant.MemberKey)}\n\tif target == ^uint64(0) {\n\t\tif tx.QueryRowContext(ctx, `SELECT last_seq FROM chat_conversations WHERE id=?`, string(cid)).Scan(&target) != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t}\n\tvar hash string\n\terr = tx.QueryRowContext(ctx, `SELECT member_key_hash,read_seq FROM chat_member_reads WHERE conversation_id=? AND actor_id=? LOCK IN SHARE MODE`, string(cid), string(actor)).Scan(&hash, &out.Read)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif hash != out.Hash {\n\t\tout.Read = 0\n\t}\n\tpredicate := `m.conversation_id=? AND m.sender_id<>? AND m.state='published' AND m.seq>? AND m.seq<=? AND ` + retainedTarget + ` AND ` + visibleColumn\n\targs := []any{string(cid), string(actor), out.Read, target, string(grant.Version), string(actor)}\n\terr = tx.QueryRowContext(ctx, `SELECT m.seq,m.created_at FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq LIMIT 1`, args...).Scan(&out.First, &out.At)\n\tif err == sql.ErrNoRows {\n\t\treturn out, nil\n\t}\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif tx.QueryRowContext(ctx, `SELECT m.seq FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq DESC LIMIT 1`, args...).Scan(&out.Target) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// DrainEvents is bounded and replay-safe. First due comes from the first\n// still-unread message, never from the time this process happens to wake up.\nfunc (r *ReminderService) DrainEvents(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),seq FROM chat_reminder_events WHERE processed_at IS NULL ORDER BY id LIMIT 50`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttype event struct {\n\t\tid, cid ports.ID\n\t\tseq     uint64\n\t}\n\tevents := []event{}\n\tfor rows.Next() {\n\t\tvar v event\n\t\tif rows.Scan(&v.id, &v.cid, &v.seq) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tevents = append(events, v)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, event := range events {\n\t\tactors, e := r.base.conversations.MemberCandidates(ctx, event.cid)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tfor _, actor := range actors {\n\t\t\ttx, e := r.base.begin(ctx)\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tw, e := r.window(ctx, tx, event.cid, actor, event.seq)\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\tif errors.Is(e, policy.ErrDenied) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tif w.First > 0 {\n\t\t\t\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_reminder_clusters(conversation_id,recipient_id,member_hash,round_version,first_seq,target_seq,first_due_at,next_due,rounds,state,created_at) VALUES(?,?,?,1,?,?,TIMESTAMPADD(SECOND,?,?),TIMESTAMPADD(SECOND,?,?),0,'open',UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE round_version=IF(state='closed' OR ? >= target_seq,round_version+1,round_version),first_seq=IF(state='closed' OR ? >= target_seq,VALUES(first_seq),LEAST(first_seq,VALUES(first_seq))),first_due_at=IF(state='closed' OR ? >= target_seq,VALUES(first_due_at),first_due_at),first_notified_at=IF(state='closed' OR ? >= target_seq,NULL,first_notified_at),next_due=IF(state='closed' OR ? >= target_seq,VALUES(next_due),next_due),rounds=IF(state='closed' OR ? >= target_seq,0,rounds),target_seq=GREATEST(target_seq,VALUES(target_seq)),state=IF(state='exhausted' AND rounds>=3,'exhausted','open')`, string(event.cid), string(actor), w.Hash, w.First, w.Target, r.config.FirstDelaySeconds, w.At, r.config.FirstDelaySeconds, w.At, w.Read, w.Read, w.Read, w.Read, w.Read, w.Read)\n\t\t\t}\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\tif tx.Commit() != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tif _, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_events SET processed_at=UTC_TIMESTAMP(6) WHERE id=?`, string(event.id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\n","chat/internal/message/reminder_rounds.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype reminderCluster struct {\n\tID, CID, Actor ports.ID\n\tHash           string\n\tVersion        uint64\n\tRound          int\n\tTarget         uint64\n}\n\nfunc (r *ReminderService) Prepare(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_clusters WHERE state='open' AND next_due<=UTC_TIMESTAMP(6) ORDER BY next_due,id LIMIT 50`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tcandidates := []reminderCluster{}\n\tfor rows.Next() {\n\t\tvar c reminderCluster\n\t\tif rows.Scan(&c.ID, &c.CID, &c.Actor, &c.Hash) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tcandidates = append(candidates, c)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, c := range candidates {\n\t\tif err = r.prepareOne(ctx, c); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) reserveBudget(ctx context.Context, tx *sql.Tx, actor ports.ID) (bool, error) {\n\tnow := time.Now().UTC()\n\tfor _, id := range []ports.ID{\"0\", actor} {\n\t\tif _, err := tx.ExecContext(ctx, `INSERT INTO chat_reminder_budgets(recipient_id,hour_start,hour_count,day_start,day_count) VALUES(?,UTC_TIMESTAMP(),0,UTC_DATE(),0) ON DUPLICATE KEY UPDATE recipient_id=recipient_id`, string(id)); err != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t\tvar hourly, daily int\n\t\tvar hour, day time.Time\n\t\tif tx.QueryRowContext(ctx, `SELECT hour_start,hour_count,day_start,day_count FROM chat_reminder_budgets WHERE recipient_id=? FOR UPDATE`, string(id)).Scan(&hour, &hourly, &day, &daily) != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t\tif now.Sub(hour) >= time.Hour {\n\t\t\thour = now\n\t\t\thourly = 0\n\t\t}\n\t\tif day.Format(\"2006-01-02\") != now.Format(\"2006-01-02\") {\n\t\t\tday = now\n\t\t\tdaily = 0\n\t\t}\n\t\th, d := r.config.RecipientHourly, r.config.RecipientDaily\n\t\tif id == \"0\" {\n\t\t\th = r.config.PlatformHourly\n\t\t\td = r.config.PlatformDaily\n\t\t}\n\t\tif hourly >= h || daily >= d {\n\t\t\treturn false, nil\n\t\t}\n\t\tif _, err := tx.ExecContext(ctx, `UPDATE chat_reminder_budgets SET hour_start=?,hour_count=?,day_start=?,day_count=? WHERE recipient_id=?`, hour, hourly+1, day.Format(\"2006-01-02\"), daily+1, string(id)); err != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t}\n\treturn true, nil\n}\nfunc (r *ReminderService) prepareOne(ctx context.Context, c reminderCluster) error {\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\tw, err := r.window(ctx, tx, c.CID, c.Actor, ^uint64(0))\n\tif err != nil && !errors.Is(err, policy.ErrDenied) {\n\t\treturn err\n\t}\n\tdenied := errors.Is(err, policy.ErrDenied)\n\tvar state string\n\tvar due bool\n\tif tx.QueryRowContext(ctx, `SELECT round_version,rounds,target_seq,state,next_due<=UTC_TIMESTAMP(6) FROM chat_reminder_clusters WHERE id=? FOR UPDATE`, string(c.ID)).Scan(&c.Version, &c.Round, &c.Target, &state, &due) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif state != \"open\" || !due {\n\t\treturn nil\n\t}\n\tif denied || w.First == 0 || w.Hash != c.Hash {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state='closed' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tif c.Round >= 3 {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state='exhausted' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tvar exists int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_reminder_intents WHERE cluster_id=? AND round_version=? AND round_no=?`, string(c.ID), c.Version, c.Round+1).Scan(&exists) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif exists > 0 {\n\t\treturn nil\n\t} // One persisted attempt/outbox until a real outcome.\n\t// All reservations roll back together if either account/platform budget fails.\n\tif _, err = tx.ExecContext(ctx, \"SAVEPOINT reminder_budget\"); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tallowed, err := r.reserveBudget(ctx, tx, c.Actor)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !allowed {\n\t\tif _, err = tx.ExecContext(ctx, \"ROLLBACK TO SAVEPOINT reminder_budget\"); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,blocked_reason='channel_budget' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tvar b [32]byte\n\tif _, err = rand.Read(b[:]); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_reminder_intents(operation_id,cluster_id,round_version,round_no,conversation_id,recipient_id,member_hash,target_seq,state,attempts,next_attempt_at,created_at,expires_at) VALUES(?,?,?,?,?,?,?,?,'pending',0,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6),UTC_TIMESTAMP(6)+INTERVAL 1 DAY)`, hex.EncodeToString(b[:]), string(c.ID), c.Version, c.Round+1, string(c.CID), string(c.Actor), c.Hash, w.Target); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET blocked_reason=NULL WHERE id=?`, string(c.ID)); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) SubmitPending(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),operation_id,CAST(recipient_id AS CHAR),CAST(target_seq AS CHAR),CAST(round_version AS CHAR),CAST(conversation_id AS CHAR) FROM chat_reminder_intents WHERE state IN ('pending','retryable') AND attempts<8 AND next_attempt_at<=UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6) ORDER BY id LIMIT 20`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\twork := []ports.Reminder{}\n\tfor rows.Next() {\n\t\tvar q ports.Reminder\n\t\tif rows.Scan(&q.IntentID, &q.OperationID, &q.RecipientID, &q.TargetSeq, &q.ClusterVersion, &q.ConversationID) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\twork = append(work, q)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, q := range work {\n\t\tresult, err := r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='retryable',diagnostic='php_receipt_unconfirmed',attempts=attempts+1,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND WHERE id=? AND state IN ('pending','retryable') AND next_attempt_at<=UTC_TIMESTAMP(6) AND attempts<8`, string(q.IntentID))\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tn, _ := result.RowsAffected()\n\t\tif n != 1 {\n\t\t\tcontinue\n\t\t}\n\t\tallowed, err := r.Eligible(ctx, q.OperationID)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !allowed {\n\t\t\tif err = r.reconcileOne(ctx, q.OperationID, ports.Receipt{OperationID: q.OperationID, State: \"suppressed\", Diagnostic: \"read_or_permission_changed\"}); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\treceipt, err := r.notification.Submit(ctx, q)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif receipt.OperationID != q.OperationID {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tswitch receipt.State {\n\t\tcase \"accepted\":\n\t\t\t_, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='submitted' WHERE id=? AND state='retryable'`, string(q.IntentID))\n\t\tcase \"sent\", \"suppressed\", \"channel_limited\", \"provider_unknown\":\n\t\t\terr = r.reconcileOne(ctx, q.OperationID, receipt)\n\t\tdefault:\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) Eligible(ctx context.Context, op string) (bool, error) {\n\tif len(op) != 64 {\n\t\treturn false, ports.ErrInvalid\n\t}\n\tvar cid, actor, cluster ports.ID\n\tvar hash, state string\n\tvar target, version uint64\n\tvar live bool\n\terr := r.base.db.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),CAST(cluster_id AS CHAR),member_hash,target_seq,round_version,state,expires_at>UTC_TIMESTAMP(6) FROM chat_reminder_intents WHERE operation_id=?`, op).Scan(&cid, &actor, &cluster, &hash, &target, &version, &state, &live)\n\tif err == sql.ErrNoRows {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tif !live || state == \"suppressed\" || state == \"provider_unknown\" || state == \"channel_limited\" {\n\t\treturn false, nil\n\t}\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tdefer tx.Rollback()\n\tw, err := r.window(ctx, tx, cid, actor, target)\n\tif errors.Is(err, policy.ErrDenied) {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tvar current uint64\n\tif tx.QueryRowContext(ctx, `SELECT round_version FROM chat_reminder_clusters WHERE id=? LOCK IN SHARE MODE`, string(cluster)).Scan(&current) != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tvalid := w.First > 0 && w.Hash == hash && current == version\n\tif tx.Commit() != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn valid, nil\n}\n","chat/internal/message/governance_http.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n)\n\ntype governanceAction struct {\n\tConversation ports.ID `json:\"conversation_id,omitempty\"`\n\tMessage      ports.ID `json:\"message_id,omitempty\"`\n\tItem         ports.ID `json:\"item_id,omitempty\"`\n\tCase         ports.ID `json:\"case_id,omitempty\"`\n\tTarget       ports.ID `json:\"target_id,omitempty\"`\n\tActor        ports.ID `json:\"actor_id,omitempty\"`\n\tExpected     ports.ID `json:\"expected_version,omitempty\"`\n\tCursor       string   `json:\"cursor,omitempty\"`\n\tAfter        ports.ID `json:\"after,omitempty\"`\n\tLimit        int      `json:\"limit,omitempty\"`\n\tSeconds      int      `json:\"seconds,omitempty\"`\n\tReason       string   `json:\"reason,omitempty\"`\n\tAction       string   `json:\"action,omitempty\"`\n\tTargetType   string   `json:\"target_type,omitempty\"`\n\tThumbnail    bool     `json:\"thumbnail,omitempty\"`\n}\ntype GovernanceHandler struct {\n\tservice  *GovernanceService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewGovernanceHandler(g *GovernanceService, id ports.Identity, concurrency int) (*GovernanceHandler, error) {\n\tif g == nil || id == nil || concurrency < 1 || concurrency > 16 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &GovernanceHandler{g, id, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *GovernanceHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tfail := func(status int, code string) {\n\t\tw.WriteHeader(status)\n\t\tjson.NewEncoder(w).Encode(map[string]any{\"code\": code, \"message\": \"操作未完成，请刷新状态后重试\", \"retryable\": status >= 500})\n\t}\n\troutes := map[string]string{\n\t\t\"audit/list\": \"cursor limit\", \"audit/history\": \"conversation_id cursor message_id limit\", \"audit/url\": \"conversation_id message_id item_id thumbnail\",\n\t\t\"governance/reminders\": \"after\", \"governance/status\": \"actor_id\", \"governance/restrict\": \"actor_id expected_version action seconds reason\", \"governance/report\": \"conversation_id message_id item_id reason\",\n\t\t\"governance/appeal\": \"target_type target_id expected_version reason\", \"governance/cases\": \"after\", \"governance/queue\": \"after\",\n\t\t\"governance/evidence\": \"case_id expected_version item_id reason\", \"governance/decide\": \"case_id expected_version action reason\",\n\t}\n\troute := strings.TrimPrefix(r.URL.Path, \"/chat/api/v1/\")\n\tfields, ok := routes[route]\n\tif !ok || r.URL.Path != \"/chat/api/v1/\"+route {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\tcontent, _, err := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif err != nil || content != \"application/json\" || r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error())\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tp, err := h.identity.Authenticate(r.Context(), strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif err != nil {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\traw, err := io.ReadAll(io.LimitReader(r.Body, 8193))\n\tif err != nil || len(raw) > 8192 {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tvar q governanceAction\n\tvar keys map[string]json.RawMessage\n\tif !strictImageJSON(raw, &q) || json.Unmarshal(raw, &keys) != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tallowed := map[string]bool{}\n\tfor _, v := range strings.Fields(fields) {\n\t\tallowed[v] = true\n\t}\n\tfor k, v := range keys {\n\t\tif !allowed[k] || string(v) == \"null\" {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\t\treturn\n\t\t}\n\t}\n\tvar data any\n\tswitch route {\n\tcase \"audit/list\":\n\t\tdata, err = h.service.AuditList(r.Context(), p, q.Cursor, q.Limit)\n\tcase \"audit/history\":\n\t\tdata, err = h.service.AuditHistory(r.Context(), p, HistoryRequest{ConversationID: q.Conversation, Cursor: q.Cursor, TargetID: q.Message, Limit: q.Limit})\n\tcase \"audit/url\":\n\t\tvar url string\n\t\turl, err = h.service.AuditImage(r.Context(), p, q.Conversation, q.Message, q.Item, q.Thumbnail)\n\t\tdata = map[string]any{\"url\": url, \"expires_in\": 60}\n\tcase \"governance/reminders\":\n\t\tdata, err = h.service.ReminderSummaries(r.Context(), p, q.After)\n\tcase \"governance/status\":\n\t\tif q.Actor == \"\" {\n\t\t\tq.Actor = p.ActorID\n\t\t}\n\t\tdata, err = h.service.Restriction(r.Context(), p, q.Actor)\n\tcase \"governance/restrict\":\n\t\tdata, err = h.service.Restrict(r.Context(), p, RestrictionRequest{Actor: q.Actor, Expected: q.Expected, Action: q.Action, Seconds: q.Seconds, Reason: q.Reason})\n\tcase \"governance/report\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Report(r.Context(), p, q.Conversation, q.Message, q.Item, q.Reason)\n\t\tdata = map[string]any{\"case_id\": id}\n\tcase \"governance/appeal\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Appeal(r.Context(), p, q.TargetType, q.Target, q.Expected, q.Reason)\n\t\tdata = map[string]any{\"case_id\": id}\n\tcase \"governance/cases\", \"governance/queue\":\n\t\tdata, err = h.service.Cases(r.Context(), p, q.After, route == \"governance/queue\")\n\tcase \"governance/evidence\":\n\t\tdata, err = h.service.Evidence(r.Context(), p, q.Case, q.Expected, q.Item, q.Reason)\n\tcase \"governance/decide\":\n\t\tdata, err = h.service.Decide(r.Context(), p, CaseDecision{ID: q.Case, Expected: q.Expected, Action: q.Action, Reason: q.Reason})\n\t}\n\tif err != nil {\n\t\tstatus := 503\n\t\tswitch {\n\t\tcase errors.Is(err, auth.ErrUnauthorized):\n\t\t\tstatus = 401\n\t\tcase errors.Is(err, policy.ErrDenied):\n\t\t\tstatus = 403\n\t\tcase errors.Is(err, ports.ErrInvalid):\n\t\t\tstatus = 400\n\t\tcase errors.Is(err, ports.ErrBusy):\n\t\t\tstatus = 429\n\t\tcase errors.Is(err, ErrResync), errors.Is(err, ErrMediaVersion), errors.Is(err, ErrPreferenceConflict), errors.Is(err, ErrMedia):\n\t\t\tstatus = 409\n\t\t}\n\t\tfail(status, err.Error())\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]any{\"data\": data, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/dependencies/reminders.go":"package dependencies\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"time\"\n)\n\ntype ReminderHTTP struct {\n\ttransport     *HTTP\n\tsigner        *auth.InternalAuth\n\tendpoint, kid string\n}\n\nfunc NewReminderHTTP(h *HTTP, signer *auth.InternalAuth, endpoint, kid string) (*ReminderHTTP, error) {\n\tu, err := url.Parse(endpoint)\n\tif err != nil || h == nil || signer == nil || u.Scheme != \"https\" || u.Host == \"\" || u.User != nil || u.RawQuery != \"\" || u.Fragment != \"\" || u.Path != \"/chat-internal.php\" {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderHTTP{h, signer, endpoint, kid}, nil\n}\nfunc (h *ReminderHTTP) call(ctx context.Context, q map[string]string) (ports.Receipt, error) {\n\traw, _ := json.Marshal(q)\n\treq, err := http.NewRequestWithContext(ctx, \"POST\", h.endpoint, bytes.NewReader(raw))\n\tif err != nil {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\tif err = h.signer.Sign(req, raw, h.kid, time.Now()); err != nil {\n\t\treturn ports.Receipt{}, err\n\t}\n\tbody, status, err := h.transport.Do(ctx, req)\n\tif err != nil || status != 200 {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tvar result struct {\n\t\tOperation  string `json:\"operation_id\"`\n\t\tState      string `json:\"state\"`\n\t\tDiagnostic string `json:\"diagnostic\"`\n\t}\n\tif json.Unmarshal(body, &result) != nil || result.Operation != q[\"operation_id\"] {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tswitch result.State {\n\tcase \"accepted\", \"sent\", \"suppressed\", \"channel_limited\", \"provider_unknown\":\n\tdefault:\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tif len(result.Diagnostic) > 64 {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\treturn ports.Receipt{OperationID: result.Operation, State: result.State, Diagnostic: result.Diagnostic}, nil\n}\nfunc (h *ReminderHTTP) Submit(ctx context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tif !q.IntentID.Valid() || !q.RecipientID.Valid() || !q.ConversationID.Valid() || !q.TargetSeq.Valid() || !q.ClusterVersion.Valid() || len(q.OperationID) != 64 {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treturn h.call(ctx, map[string]string{\"intent_id\": string(q.IntentID), \"recipient_id\": string(q.RecipientID), \"conversation_id\": string(q.ConversationID), \"target_seq\": string(q.TargetSeq), \"cluster_version\": string(q.ClusterVersion), \"operation_id\": q.OperationID})\n}\nfunc (h *ReminderHTTP) Status(ctx context.Context, op string) (ports.Receipt, error) {\n\tif len(op) != 64 {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treturn h.call(ctx, map[string]string{\"operation_id\": op})\n}\n","chat/internal/message/reminder_http.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"io\"\n\t\"net/http\"\n\t\"time\"\n)\n\ntype ReminderInternalHandler struct {\n\tservice *ReminderService\n\tauth    *auth.InternalAuth\n\tgate    chan struct{}\n}\n\nfunc NewReminderInternalHandler(s *ReminderService, a *auth.InternalAuth) (*ReminderInternalHandler, error) {\n\tif s == nil || a == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderInternalHandler{s, a, make(chan struct{}, 8)}, nil\n}\nfunc (h *ReminderInternalHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tfail := func(status int) { w.WriteHeader(status); w.Write([]byte(\"{\\\"code\\\":\\\"CHAT_REMINDER_UNAVAILABLE\\\"}\")) }\n\tif r.Method != \"POST\" || r.URL.Path != \"/chat/internal/v1/reminders/eligible\" || r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(404)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429)\n\t\treturn\n\t}\n\traw, err := io.ReadAll(io.LimitReader(r.Body, 1025))\n\tif err != nil || len(raw) > 1024 {\n\t\tfail(400)\n\t\treturn\n\t}\n\tif err = h.auth.Verify(r.Context(), r, raw, time.Now()); err != nil {\n\t\tfail(401)\n\t\treturn\n\t}\n\tvar q struct {\n\t\tOperation string `json:\"operation_id\"`\n\t}\n\tif !strictImageJSON(raw, &q) || len(q.Operation) != 64 {\n\t\tfail(400)\n\t\treturn\n\t}\n\tallowed, err := h.service.Eligible(r.Context(), q.Operation)\n\tif err != nil {\n\t\tfail(503)\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]bool{\"eligible\": allowed})\n}\n","server/config/defaults.php":"<?php\n\n// 2026-08-14：提供无需 Composer 的默认配置，生产密钥由网页安装器写入 installed.php。\nreturn [\n    'installed' => false,\n    // V2.4.0：默认版本跟随当前代码包；全新安装基线已包含帮助中心结构和草稿问答。\n    'version' => '2.4.0',\n    'app' => [\n        'name' => '壁选师傅订单管理系统',\n        'url' => '',\n        'env' => 'production',\n        'debug' => false,\n        'timezone' => 'Asia/Shanghai',\n        'key' => '',\n    ],\n    'database' => [\n        'host' => '127.0.0.1',\n        'port' => 3306,\n        'database' => '',\n        'username' => '',\n        'password' => '',\n        'charset' => 'utf8mb4',\n    ],\n    // Independent PHP Ed25519 seed; Go receives public keys only. Disabled until chat acceptance.\n    'chat' => ['enabled'=>false,'key_id'=>'chat-v1','seed_env'=>'CHAT_ACCESS_SEED','order_policy_enabled'=>false,'safety_credential_export_enabled'=>false,'reminders_enabled'=>false,'internal_key_id'=>'chat-internal-v1','internal_key_env'=>'CHAT_INTERNAL_KEY','internal_go_origin'=>''],\n    'security' => [\n        'session_name' => 'worker_admin_session',\n        'session_lifetime' => 7200,\n        'login_max_attempts' => 5,\n        'login_lock_minutes' => 15,\n        'force_https' => true,\n    ],\n    'media' => [\n        'max_width' => 1600,\n        'jpeg_quality' => 90,\n        'max_file_bytes' => 1048576,\n        'storage_path' => 'storage/private/uploads',\n    ],\n];\n\n","server/app/Infrastructure/Messaging/ChatInternalAuth.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n/** Internal shared key is independent of access-token signing and channel keys. */\nfinal class ChatInternalAuth\n{\n    private Database $db; private string $env; private string $kid; private string $key;\n    public function __construct(Database $db,string $env,string $kid,string $key)\n    {\n        if (!in_array($env,['production','development','test'],true) || preg_match('/^[a-z0-9_-]{1,32}$/D',$kid)!==1 || strlen($key)!==32) throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $this->db=$db;$this->env=$env;$this->kid=$kid;$this->key=$key;\n    }\n    public static function configured(Database $db):self\n    {\n        $env=['testing'=>'test','development'=>'development','production'=>'production'][(string)\\app_config('app.env','')]??'';\n        $name=(string)\\app_config('chat.internal_key_env','');\n        if(preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D',$name)!==1)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $encoded=getenv($name);$key=is_string($encoded)?base64_decode($encoded,true):false;\n        if(!is_string($key)||base64_encode($key)!==$encoded)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        return new self($db,$env,(string)\\app_config('chat.internal_key_id',''),$key);\n    }\n    private function canonical(string $uri,string $body,string $stamp,string $nonce):string\n    {return implode(\"\\n\",['chat-internal-v1','POST',$uri,hash('sha256',$body),$stamp,$nonce,$this->env,$this->kid]);}\n    public function sign(string $uri,string $body):array\n    {\n        $stamp=(string)time();$nonce=bin2hex(random_bytes(32));\n        return ['X-Chat-Environment: '.$this->env,'X-Chat-Key-ID: '.$this->kid,'X-Chat-Timestamp: '.$stamp,'X-Chat-Nonce: '.$nonce,\n            'X-Chat-Signature: '.hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key)];\n    }\n    public function verify(string $uri,string $body,array $headers):void\n    {\n        if($uri!=='/chat-internal.php'||strlen($body)>8192)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $get=static fn(string $key):string=>(string)($headers[$key]??'');\n        $stamp=$get('timestamp');$nonce=$get('nonce');$signature=$get('signature');\n        if($get('environment')!==$this->env||$get('key-id')!==$this->kid||preg_match('/^[1-9][0-9]{9}$/D',$stamp)!==1||abs(time()-(int)$stamp)>30\n            ||preg_match('/^[a-f0-9]{64}$/D',$nonce)!==1||preg_match('/^[a-f0-9]{64}$/D',$signature)!==1\n            ||!hash_equals(hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key),$signature))throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $insert=$this->db->execute('INSERT IGNORE INTO chat_internal_nonces(nonce_hash,expires_at) VALUES(:hash,UTC_TIMESTAMP()+INTERVAL 61 SECOND)',['hash'=>hash('sha256',$this->kid.':'.$nonce)]);\n        if($insert!==1)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n    }\n    public function eligible(string $operation):bool\n    {\n        $origin=rtrim((string)\\app_config('chat.internal_go_origin',''),'/');$url=parse_url($origin);\n        if(!$url||($url['scheme']??'')!=='https'||empty($url['host'])||isset($url['user'])||isset($url['pass'])||isset($url['query'])||isset($url['fragment'])||!empty($url['path']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $uri='/chat/internal/v1/reminders/eligible';$body=json_encode(['operation_id'=>$operation],JSON_THROW_ON_ERROR);\n        $response='';$ch=curl_init($origin.$uri);curl_setopt_array($ch,[CURLOPT_POST=>true,CURLOPT_POSTFIELDS=>$body,CURLOPT_HTTPHEADER=>array_merge(['Content-Type: application/json'],$this->sign($uri,$body)),CURLOPT_RETURNTRANSFER=>false,CURLOPT_WRITEFUNCTION=>static function($handle,string $chunk)use(&$response):int{if(strlen($response)+strlen($chunk)>1024)return 0;$response.=$chunk;return strlen($chunk);},CURLOPT_CONNECTTIMEOUT_MS=>1000,CURLOPT_TIMEOUT_MS=>3000,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_PROTOCOLS=>CURLPROTO_HTTPS]);\n        $ok=curl_exec($ch);$raw=$ok===false?false:$response;$status=(int)curl_getinfo($ch,CURLINFO_RESPONSE_CODE);curl_close($ch);\n        if($status!==200||!is_string($raw)||strlen($raw)>1024)throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $result=json_decode($raw,true);if(!is_array($result)||!isset($result['eligible'])||!is_bool($result['eligible']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');return $result['eligible'];\n    }\n}\n","server/app/Application/Chat/ChatReminderReceipts.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nfinal class ChatReminderReceipts\n{\n    private Database $db;\n    public function __construct(Database $db){$this->db=$db;}\n    public function receive(string $raw):array\n    {\n        $q=json_decode($raw,true,8,JSON_THROW_ON_ERROR);\n        if(is_array($q)&&array_keys($q)===['operation_id']&&json_encode($q,JSON_THROW_ON_ERROR)===$raw)return $this->status((string)$q['operation_id']);\n        $fields=['cluster_version','conversation_id','intent_id','operation_id','recipient_id','target_seq'];\n        if(!is_array($q)||array_keys($q)!==$fields||json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES)!==$raw)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        foreach($q as $key=>$value){\n            if(!is_string($value)||preg_match($key==='operation_id'?'/^[a-f0-9]{64}$/D':'/^[1-9][0-9]{0,19}$/D',$value)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n            if($key!=='operation_id'&&strlen($value)===20&&strcmp($value,'18446744073709551615')>0)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        }\n        return $this->db->transaction(function()use($q,$raw):array{\n            $hash=hash('sha256',$raw);\n            $this->db->execute(\"INSERT IGNORE INTO chat_reminder_receipts(operation_id,payload_hash,payload_json,state,diagnostic,created_at,updated_at) VALUES(:op,:hash,:body,'accepted','queued',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\",['op'=>$q['operation_id'],'hash'=>$hash,'body'=>$raw]);\n            $row=$this->db->fetch('SELECT payload_hash,state,diagnostic,outbox_id FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$q['operation_id']]);\n            if(!$row||!hash_equals((string)$row['payload_hash'],$hash))throw new RuntimeException('CHAT_REMINDER_CONFLICT');\n            if($row['outbox_id']===null){\n                $id=$this->db->insert(\"INSERT INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('chat_reminder',:key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['key'=>'chat:'.$q['operation_id'],'payload'=>$raw]);\n                $this->db->execute('UPDATE chat_reminder_receipts SET outbox_id=:id WHERE operation_id=:op',['id'=>$id,'op'=>$q['operation_id']]);\n            }\n            return $this->result($q['operation_id'],$row);\n        });\n    }\n    public function status(string $operation):array\n    {\n        if(preg_match('/^[a-f0-9]{64}$/D',$operation)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        $row=$this->db->fetch('SELECT state,diagnostic FROM chat_reminder_receipts WHERE operation_id=:op',['op'=>$operation]);\n        if(!$row)throw new RuntimeException('CHAT_REMINDER_NOT_FOUND');\n        return $this->result($operation,$row);\n    }\n    private function result(string $operation,array $row):array\n    {\n        $state=in_array($row['state'],['sending','provider_unknown'],true)?'provider_unknown':(string)$row['state'];\n        return ['operation_id'=>$operation,'state'=>$state,'diagnostic'=>(string)$row['diagnostic']];\n    }\n}\n","server/chat-internal.php":"<?php\ndeclare(strict_types=1);\nrequire __DIR__.'/bootstrap.php';\nheader('Content-Type: application/json');header('Cache-Control: no-store');header('X-Content-Type-Options: nosniff');\ntry{\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    if(($_SERVER['REQUEST_METHOD']??'')!=='POST'||($_SERVER['REQUEST_URI']??'')!=='/chat-internal.php'||strtolower(trim(explode(';',(string)($_SERVER['CONTENT_TYPE']??''))[0]))!=='application/json')throw new RuntimeException('request');\n    $raw=file_get_contents('php://input',false,null,0,8193);if(!is_string($raw)||strlen($raw)>8192)throw new RuntimeException('body');\n    $headers=[];foreach(['environment','key-id','timestamp','nonce','signature'] as $key)$headers[$key]=(string)($_SERVER['HTTP_X_CHAT_'.strtoupper(str_replace('-','_',$key))]??'');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());$auth->verify('/chat-internal.php',$raw,$headers);\n    $result=(new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts(db()))->receive($raw);\n    echo json_encode($result,JSON_THROW_ON_ERROR);\n}catch(Throwable $error){http_response_code(503);echo '{\"code\":\"CHAT_REMINDER_UNAVAILABLE\"}';}\n","server/app/Infrastructure/Messaging/ChatReminderTemplate.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\nfinal class ChatReminderTemplate\n{\n    public static function build(Database $db,array $q):array\n    {\n        $scene=SubscriptionCatalog::subscriptionSceneDefinitions()['chat_unread']??[];\n        if(empty($scene['available']))return ['diagnostic'=>'template_unavailable'];\n        $uid=(int)$q['recipient_id'];$pref=SubscriptionQuotaStore::subscriptionPreferences($db,$uid)['chat_unread']??[];\n        $type=(string)($scene['subscription_type']??'one_time');\n        if(in_array((string)($pref['authorization_status']??''),['ban','disabled'],true)\n            ||($type==='one_time'&&max(0,(int)($pref['remaining_count']??0))<1)\n            ||($type!=='one_time'&&(empty($pref['enabled'])||!in_array($pref['authorization_status']??'',['accept','acceptWithAudio','acceptWithAlert'],true))))return ['diagnostic'=>'subscription_unavailable'];\n        $openid=(string)$db->fetchValue(\"SELECT openid FROM wechat_identities WHERE user_id=:id AND status='active' ORDER BY id DESC LIMIT 1\",['id'=>$uid]);\n        if($openid==='')return ['diagnostic'=>'openid_missing'];\n        $values=['status'=>'您有未读的订单聊天消息','time'=>date('Y-m-d H:i')];$data=[];\n        foreach((array)$scene['field_map'] as $semantic=>$key){\n            if(!isset($values[$semantic]))return ['diagnostic'=>'template_data_invalid'];\n            $value=WechatTemplateValue::format((string)$key,$values[$semantic]);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $key=>$fixed){\n            if(isset($data[$key]))continue;$value=WechatTemplateValue::format((string)$key,(string)$fixed);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['template_fields']??[]) as $key)if(!isset($data[$key]))return ['diagnostic'=>'template_data_missing'];\n        if(!$data)return ['diagnostic'=>'template_data_missing'];\n        return ['payload'=>['user_id'=>$uid,'scene_key'=>'chat_unread','openid'=>$openid,'template_id'=>(string)$scene['template_id'],\n            'page'=>'subpackages/chat/conversation/index?conversation_id='.rawurlencode($q['conversation_id']),'data'=>$data]];\n    }\n}\n","server/app/Application/Chat/ChatReminderDispatch.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse Throwable;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatReminderTemplate;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionQuotaStore;\n/** Reuses the existing gateway/quota; no copied channel, SMS or billing stack. */\nfinal class ChatReminderDispatch\n{\n    private Database $db;private SubscribeMessageGateway $gateway;private $eligible;\n    public function __construct(Database $db,SubscribeMessageGateway $gateway,callable $eligible){$this->db=$db;$this->gateway=$gateway;$this->eligible=$eligible;}\n    public function dispatch(int $limit=20):array\n    {\n        if($this->db->pdo()->inTransaction())throw new RuntimeException('CHAT_SEND_TRANSACTION');\n        $limit=max(1,min(50,$limit));\n        // A dead process after entering the channel has an unknown result. It\n        // cannot re-enter generic failed retries or trigger an SMS fallback.\n        $this->db->execute(\"UPDATE chat_reminder_receipts SET state='provider_unknown',diagnostic='provider_unknown',updated_at=UTC_TIMESTAMP(6) WHERE state='sending' AND updated_at<UTC_TIMESTAMP(6)-INTERVAL 5 MINUTE\");\n        $rows=$this->db->fetchAll(\"SELECT o.id,o.payload_json FROM message_outbox o JOIN chat_reminder_receipts r ON r.outbox_id=o.id WHERE o.topic='chat_reminder' AND o.status IN ('pending','failed','processing') AND r.state='accepted' AND o.attempt_count<8 AND (o.next_attempt_at IS NULL OR o.next_attempt_at<=UTC_TIMESTAMP()) ORDER BY o.id LIMIT \".$limit);\n        $stats=['scanned'=>count($rows),'sent'=>0,'suppressed'=>0,'unknown'=>0,'retry'=>0];\n        foreach($rows as $row){\n            $id=(int)$row['id'];$q=json_decode((string)$row['payload_json'],true);$op=(string)($q['operation_id']??'');\n            if(preg_match('/^[a-f0-9]{64}$/D',$op)!==1)continue;\n            $claimed=$this->db->execute(\"UPDATE message_outbox SET status='processing',attempt_count=attempt_count+1,next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE WHERE id=:id AND topic='chat_reminder' AND (status IN ('pending','failed') OR (status='processing' AND next_attempt_at<=UTC_TIMESTAMP()))\",['id'=>$id]);\n            if($claimed!==1)continue;\n            $entered=false;\n            try{\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $built=ChatReminderTemplate::build($this->db,$q);\n                if(!isset($built['payload'])){$this->finish($op,$id,'channel_limited',(string)$built['diagnostic']);$stats['suppressed']++;continue;}\n                // Final check is after metadata/permissions and immediately\n                // before recording the irreversible provider boundary.\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $entered=$this->db->transaction(function()use($op,$q):bool{\n                    $receipt=$this->db->fetch('SELECT state FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$op]);\n                    if(!$receipt||$receipt['state']!=='accepted')return false;\n                    $this->db->fetch(\"SELECT setting_key FROM system_settings WHERE setting_key=:key FOR UPDATE\",['key'=>'wechat.subscription.user.'.(int)$q['recipient_id']]);\n                    $current=ChatReminderTemplate::build($this->db,$q);if(!isset($current['payload']))return false;\n                    // Reserve once, including provider-unknown outcomes.\n                    SubscriptionQuotaStore::markSubscriptionConsumed($this->db,(int)$q['recipient_id'],'chat_unread');\n                    $this->db->execute(\"UPDATE chat_reminder_receipts SET state='sending',diagnostic='channel_entered',updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op\",['op'=>$op]);return true;\n                });\n                if(!$entered){$this->finish($op,$id,'suppressed','subscription_changed');$stats['suppressed']++;continue;}\n                $this->gateway->send($built['payload']);\n                $this->finish($op,$id,'sent','sent');$stats['sent']++;\n            }catch(Throwable $error){\n                if($entered){$this->finish($op,$id,'provider_unknown','provider_unknown');$stats['unknown']++;}\n                else{$this->db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE,last_error='chat_eligibility_unavailable' WHERE id=:id\",['id'=>$id]);$stats['retry']++;}\n            }\n        }\n        return $stats;\n    }\n    private function finish(string $op,int $id,string $state,string $diagnostic):void\n    {\n        $this->db->transaction(function()use($op,$id,$state,$diagnostic):void{\n            $this->db->execute(\"UPDATE chat_reminder_receipts SET state=:state,diagnostic=:diagnostic,updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op AND state IN ('accepted','sending')\",['state'=>$state,'diagnostic'=>$diagnostic,'op'=>$op]);\n            $this->db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP(),next_attempt_at=NULL,last_error=:diagnostic WHERE id=:id AND topic='chat_reminder'\",['diagnostic'=>$diagnostic,'id'=>$id]);\n        });\n    }\n}\n","server/bin/chat-reminders.php":"<?php\ndeclare(strict_types=1);\nif(PHP_SAPI!=='cli'){http_response_code(404);exit;}\nrequire dirname(__DIR__).'/bootstrap.php';\ntry{\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());\n    $shared=new \\WorkerAdmin\\Foundation\\ApplicationContainer(db());\n    $dispatcher=new \\WorkerAdmin\\Application\\Chat\\ChatReminderDispatch(db(),$shared->subscribeMessages(),[$auth,'eligible']);\n    $stats=$dispatcher->dispatch(20);\n    db()->execute('DELETE FROM chat_internal_nonces WHERE expires_at<=UTC_TIMESTAMP() ORDER BY expires_at LIMIT 1000');\n    fwrite(STDOUT,json_encode($stats,JSON_THROW_ON_ERROR).\"\\n\");\n}catch(Throwable $error){fwrite(STDERR,\"聊天提醒处理暂不可用\\n\");exit(1);}\n","server/app/Http/Admin/Modules/ChatGovernanceAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n/** PHP owns page/identity grants only; every chat-governance mutation uses Go. */\nfinal class ChatGovernanceAdminModule implements AdminModule\n{\n    private Database $db;private Auth $auth;\n    public function __construct(Database $db,Auth $auth,Csrf $csrf){$this->db=$db;$this->auth=$auth;}\n    public function supports(string $route):bool{return in_array($route,['chat.governance','chat.auditors'],true);}\n    public function dispatch(string $route):void\n    {\n        $this->auth->requirePermission($route==='chat.auditors'?'chat.audit.grants':'audit.view');\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));\n        if($route==='chat.auditors'&&$method==='POST'){\n            $id=trim((string)($_POST['user_id']??''));$reason=trim((string)($_POST['reason']??''));$enabled=(string)($_POST['enabled']??'')==='1';\n            if(preg_match('/^[1-9][0-9]{0,19}$/D',$id)!==1||mb_strlen($reason)<2||mb_strlen($reason)>200||!$this->db->fetchValue(\"SELECT id FROM users WHERE id=:id AND status='active'\",['id'=>$id]))throw new RuntimeException('请填写真实用户编号和授权理由');\n            $admin=(string)$this->auth->user()['id'];$version=bin2hex(random_bytes(32));\n            $this->db->transaction(function()use($id,$reason,$enabled,$admin,$version):void{\n                $this->db->execute('INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE enabled=VALUES(enabled),authority_version=VALUES(authority_version),granted_by=VALUES(granted_by),reason=VALUES(reason),updated_at=VALUES(updated_at)',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n                $this->db->execute('INSERT INTO chat_auditor_grant_audit(user_id,enabled,authority_version,admin_id,reason,created_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6))',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n            });\n            \\flash('success','会话抽检授权已更新');\\redirect(\\admin_url('chat.auditors'));return;\n        }\n        if($method!=='GET'){http_response_code(405);throw new RuntimeException('请求方式不正确');}\n        $grants=$route==='chat.auditors'?$this->db->fetchAll('SELECT user_id,enabled,granted_by,reason,updated_at FROM chat_mini_auditors ORDER BY updated_at DESC,user_id DESC LIMIT 50'):[];\n        echo \\view('admin/chat-governance',['pageTitle'=>$route==='chat.auditors'?'小程序抽检授权':'聊天抽检与治理','activeMenu'=>$route,'grants'=>$grants,'grantPage'=>$route==='chat.auditors',\n            'canModerate'=>$this->auth->can('users.manage'),'canEvidence'=>$this->auth->can('chat.evidence.view')]);\n    }\n}\n","chat/internal/message/governance_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc governanceFixture(t *testing.T, f *fixtureDB, s *Service, m *MediaService) (*GovernanceService, ports.Principal) {\n\tt.Helper()\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"k\", 32)), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tg, err := NewGovernanceService(s, h, m, \"test\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(`INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(91001,'governance-fixture','fixture','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tf.exec(`INSERT INTO chat_admin_sessions(id,admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(91001,91001,REPEAT('d',64),REPEAT('e',64),REPEAT('f',64),'[\"chat:audit\",\"chat:moderate\",\"chat:images\",\"chat:evidence\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())`)\n\tp := ports.Principal{ActorID: \"91001\", Kind: \"admin\", SourceID: \"91001\", SessionID: strings.Repeat(\"d\", 64), SessionVersion: strings.Repeat(\"e\", 64), Environment: \"test\", Scopes: []string{\"chat:audit\", \"chat:moderate\", \"chat:images\", \"chat:evidence\"}, ExpiresAt: time.Now().Add(time.Minute)}\n\treturn g, p\n}\nfunc TestMySQLS18AuditSnapshotIsolationAndRevocation(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tfirst := accepted(t, s, q)\n\tfor i := 0; i < 5; i++ {\n\t\tf.exec(`INSERT INTO chat_conversations(conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at) VALUES('order',CONCAT('fixture-audit:',?),?, ?,1,REPEAT('a',64),'fixture','readonly',UTC_TIMESTAMP(6)-INTERVAL 1 DAY,UTC_TIMESTAMP(6))`, i, 600+i, 600+i)\n\t}\n\tpage, err := g.AuditList(ctx, admin, \"\", 2)\n\tif err != nil || len(page.Items) != 2 || !page.More {\n\t\tt.Fatal(page, err)\n\t}\n\ttotal := f.text(\"SELECT COUNT(*) FROM chat_conversations\")\n\tseen := map[ports.ID]bool{}\n\tfor _, item := range page.Items {\n\t\tseen[item.ID] = true\n\t}\n\t// Move an unseen row to the top after the snapshot was created.\n\tf.exec(`UPDATE chat_conversations SET last_message_at=UTC_TIMESTAMP(6)+INTERVAL 1 DAY WHERE scope_key='fixture-audit:4'`)\n\tfor page.More {\n\t\tpage, err = g.AuditList(ctx, admin, page.Cursor, 2)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tfor _, item := range page.Items {\n\t\t\tif seen[item.ID] {\n\t\t\t\tt.Fatal(\"activity change duplicated snapshot row\")\n\t\t\t}\n\t\t\tseen[item.ID] = true\n\t\t}\n\t}\n\tif decimal(uint64(len(seen))) != ports.ID(total) {\n\t\tt.Fatal(\"snapshot lost conversations\", len(seen), total)\n\t}\n\tif _, err = g.AuditList(ctx, principal(\"10203\"), \"\", 20); err == nil {\n\t\tt.Fatal(\"platform staff inherited audit\")\n\t}\n\tmini := principal(\"10203\")\n\tmini.Kind = \"mini_audit\"\n\tmini.Scopes = []string{\"chat:audit\"}\n\tif _, err = g.AuditList(ctx, mini, \"\", 20); err == nil {\n\t\tt.Fatal(\"ungranted mini audit\")\n\t}\n\tf.exec(`INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(10203,1,REPEAT('f',64),91001,'独立抽检测试',UTC_TIMESTAMP(6))`)\n\tmini.SessionVersion = digest(\"mini-audit-v1\\n10203\\n\" + digest(\"login:10203\") + \"\\n10203\\n\" + strings.Repeat(\"f\", 64))\n\tif _, err = g.AuditList(ctx, mini, \"\", 20); err != nil {\n\t\tt.Fatal(\"independent grant\", err)\n\t}\n\tif _, err = f.store.Authorize(ctx, ports.PolicyRequest{Actor: mini, ConversationID: q.ConversationID, Action: \"send\"}); err == nil {\n\t\tt.Fatal(\"audit identity used ordinary member path\")\n\t}\n\tbefore := f.text(\"SELECT COUNT(*) FROM chat_member_reads\")\n\tdetail, err := g.AuditHistory(ctx, admin, HistoryRequest{ConversationID: q.ConversationID})\n\tif err != nil || len(detail.Messages) != 1 || detail.Messages[0].Text == nil {\n\t\tt.Fatal(detail, err)\n\t}\n\tif _, err = s.Recall(ctx, principal(\"10202\"), q.ConversationID, first.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdetail, err = g.AuditHistory(ctx, admin, HistoryRequest{ConversationID: q.ConversationID, TargetID: first.MessageID})\n\tif err != nil || detail.Messages[0].Text != nil || detail.Messages[0].State != \"recalled\" {\n\t\tt.Fatal(\"audit leaked recall\", detail, err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != before {\n\t\tt.Fatal(\"audit marked read\")\n\t}\n\tf.exec(\"UPDATE chat_mini_auditors SET enabled=0 WHERE user_id=10203\")\n\tif _, err = g.AuditHistory(ctx, mini, HistoryRequest{ConversationID: q.ConversationID}); err == nil {\n\t\tt.Fatal(\"revoked mini audit\")\n\t}\n\tf.exec(\"UPDATE chat_mini_auditors SET enabled=1,authority_version=REPEAT('a',64) WHERE user_id=10203\")\n\tif _, err = g.AuditHistory(ctx, mini, HistoryRequest{ConversationID: q.ConversationID}); err == nil {\n\t\tt.Fatal(\"old revoked grant revived after regrant\")\n\t}\n\tf.exec(\"UPDATE admin_users SET role='viewer' WHERE id=91001\")\n\tif _, err = g.AuditList(ctx, admin, \"\", 20); err == nil {\n\t\tt.Fatal(\"revoked admin\")\n\t}\n\tif _, err = f.goDB.ExecContext(ctx, \"UPDATE chat_governance_audit SET reason='tamper'\"); err == nil {\n\t\tt.Fatal(\"audit table mutable by Go\")\n\t}\n}\nfunc TestMySQLS19BanSerializesPendingSendAndKeepsReadRecallAppeal(t *testing.T) {\n\tstarted, resume := make(chan struct{}), make(chan struct{})\n\tvar once sync.Once\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tfirst := accepted(t, s, q)\n\ts.safety = safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\tonce.Do(func() { close(started) })\n\t\t<-resume\n\t\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: \"s19-fixture\"}, nil\n\t})\n\tq.ClientMessageID = client(22)\n\tdone := make(chan error, 1)\n\tgo func() { _, err := s.Send(ctx, principal(\"10202\"), q); done <- err }()\n\t<-started\n\tblocked, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"0\", Action: \"permanent\", Reason: \"并发禁聊测试\"})\n\tif err != nil || !blocked.Blocked {\n\t\tt.Fatal(blocked, err)\n\t}\n\tclose(resume)\n\tif err = <-done; err != ErrRestricted {\n\t\tt.Fatal(\"in-flight send bypassed restriction\", err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"late publish\")\n\t}\n\tif _, err = g.history.Read(ctx, principal(\"10202\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\"); err != nil {\n\t\tt.Fatal(\"ban blocked legal read\", err)\n\t}\n\tif _, err = s.Recall(ctx, principal(\"10202\"), q.ConversationID, first.MessageID); err != nil {\n\t\tt.Fatal(\"ban blocked recall\", err)\n\t}\n\tid, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", blocked.Version, \"对此次禁聊提出申诉\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Evidence(ctx, admin, id, \"1\", \"\", \"核对禁聊依据\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: id, Expected: \"1\", Action: \"correct\", Reason: \"核查后解除限制\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstatus, err := g.Restriction(ctx, principal(\"10202\"), \"10202\")\n\tif err != nil || status.Blocked || status.Version != \"2\" {\n\t\tt.Fatal(status, err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"appeal resent old action\")\n\t}\n\ttimed, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"2\", Action: \"timed\", Seconds: 60, Reason: \"限时到期测试\"})\n\tif err != nil || !timed.Blocked {\n\t\tt.Fatal(timed, err)\n\t}\n\tf.exec(\"UPDATE chat_restrictions SET blocked_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND WHERE actor_id=10202\")\n\tif err = g.ExpireRestrictions(ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstatus, err = g.Restriction(ctx, principal(\"10202\"), \"10202\")\n\tif err != nil || status.Blocked || status.Version != \"4\" {\n\t\tt.Fatal(status, err)\n\t}\n\tbannedAgain, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"4\", Action: \"permanent\", Reason: \"独立第二次禁聊\"})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsecond, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", bannedAgain.Version, \"第二次禁聊独立申诉\")\n\tif err != nil || second == id {\n\t\tt.Fatal(\"new restriction generation reused old case\", second, err)\n\t}\n\tagain, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", bannedAgain.Version, \"重复提交同一申诉\")\n\tif err != nil || again != second {\n\t\tt.Fatal(\"same generation duplicated appeal\", again, err)\n\t}\n}\nfunc TestMySQLS19ReportsScopeEvidenceAndFalsePositiveCorrection(t *testing.T) {\n\tsafety := safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: \"s19-fixture\", Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: \"fixture_risk\", Level: 2, Confirmed: true}}, nil\n\t})\n\tf, s, q := setupMessage(t, safety)\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tresult, err := s.Send(ctx, principal(\"10202\"), q)\n\tif err != nil || result.RiskEventID == \"\" {\n\t\tt.Fatal(result, err)\n\t}\n\tid, err := g.Appeal(ctx, principal(\"10202\"), \"risk\", result.RiskEventID, \"1\", \"认为此内容存在误判\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Appeal(ctx, principal(\"10203\"), \"risk\", result.RiskEventID, \"1\", \"不能申诉他人内容\"); err == nil {\n\t\tt.Fatal(\"foreign evidence appeal\")\n\t}\n\tweak := admin\n\tweak.Scopes = []string{\"chat:audit\", \"chat:moderate\"}\n\tif _, err = g.Evidence(ctx, weak, id, \"1\", \"\", \"普通权限不能读原文\"); err == nil {\n\t\tt.Fatal(\"missing distinct evidence scope\")\n\t}\n\tevidence, err := g.Evidence(ctx, admin, id, \"1\", \"\", \"核对原文及上下文\")\n\tif err != nil || evidence.Text == nil || *evidence.Text != q.Text {\n\t\tt.Fatal(evidence, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: id, Expected: \"1\", Action: \"correct\", Reason: \"原内容确认为误判\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE confirmed=1\") != \"0\" {\n\t\tt.Fatal(\"false positive still counted\")\n\t}\n\tagain, err := s.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif err != nil || again.State != \"rejected\" {\n\t\tt.Fatal(\"corrected old intent resurrected\", again, err)\n\t}\n\tnoMessages(t, f)\n\ts.safety = safetyFunc(pass)\n\tq.ClientMessageID = client(29)\n\tmessage := accepted(t, s, q)\n\treport, err := g.Report(ctx, principal(\"10203\"), q.ConversationID, message.MessageID, \"\", \"此消息需要平台核查\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tduplicate, err := g.Report(ctx, principal(\"10203\"), q.ConversationID, message.MessageID, \"\", \"重复举报合并\")\n\tif err != nil || duplicate != report {\n\t\tt.Fatal(\"duplicate case\", duplicate, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"block\", Reason: \"尚未查看证据\"}); err == nil {\n\t\tt.Fatal(\"decision without evidence\")\n\t}\n\tif _, err = g.Evidence(ctx, admin, report, \"1\", \"\", \"查看被举报原消息\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"block\", Reason: \"确认需要屏蔽\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpage, err := g.history.Read(ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif err != nil || len(page.Messages) != 1 || page.Messages[0].Text != nil || page.Messages[0].State != \"blocked\" {\n\t\tt.Fatal(\"block projection\", page, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"dismiss\", Reason: \"旧版本不能覆盖\"}); err == nil {\n\t\tt.Fatal(\"stale decision\")\n\t}\n}\n","chat/internal/message/reminders_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync\"\n\t\"testing\"\n)\n\ntype reminderCapture struct {\n\tmu    sync.Mutex\n\tcalls []ports.Reminder\n\tlose  bool\n}\n\nfunc (c *reminderCapture) Submit(_ context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tc.calls = append(c.calls, q)\n\tif c.lose {\n\t\tc.lose = false\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\treturn ports.Receipt{OperationID: q.OperationID, State: \"accepted\"}, nil\n}\nfunc (c *reminderCapture) Status(_ context.Context, op string) (ports.Receipt, error) {\n\treturn ports.Receipt{OperationID: op, State: \"sent\", Diagnostic: \"sent\"}, nil\n}\nfunc TestMySQLS20DurableEventsFixedDueRetryAndReadSuppression(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{lose: true}\n\tr, err := NewReminderService(s, capture)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfirst := accepted(t, s, q)\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_events WHERE processed_at IS NULL\") != \"1\" {\n\t\tt.Fatal(\"publication lost durable event\")\n\t}\n\t// A new instance represents process death after message commit.\n\tr, _ = NewReminderService(s, capture)\n\tif err = r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdue := f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\")\n\tq.ClientMessageID = client(42)\n\taccepted(t, s, q)\n\tif err = r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\") != due {\n\t\tt.Fatal(\"new message postponed first reminder\")\n\t}\n\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err = r.Prepare(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"1\" {\n\t\tt.Fatal(\"not one aggregate round\")\n\t}\n\tif err = r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_reminder_intents SET next_attempt_at=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err = r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(capture.calls) != 2 || capture.calls[0].OperationID != capture.calls[1].OperationID {\n\t\tt.Fatal(\"ambiguous PHP result changed operation\")\n\t}\n\top := capture.calls[1].OperationID\n\tif allowed, err := r.Eligible(f.ctx, op); err != nil || !allowed {\n\t\tt.Fatal(\"online is not read\", allowed, err)\n\t}\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(\"12345678901234567890123456789012\"), s.timeout)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpage, err := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = h.Acknowledge(f.ctx, principal(\"10203\"), q.ConversationID, page.SyncCursor); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif allowed, err := r.Eligible(f.ctx, op); err != nil || allowed {\n\t\tt.Fatal(\"read did not suppress queued reminder\", allowed, err)\n\t}\n\tif first.MessageID == \"\" || f.text(\"SELECT COUNT(*) FROM notifications\") != \"0\" {\n\t\tt.Fatal(\"per-message business notices created\")\n\t}\n}\nfunc TestMySQLS20RoundsBudgetRecallAndPermissionRevocation(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{}\n\tr, _ := NewReminderService(s, capture)\n\tmsg := accepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor i := 0; i < 5; i++ {\n\t\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\t\tif err := r.Prepare(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := r.SubmitPending(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := r.Reconcile(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"3\" {\n\t\tt.Fatal(\"continued unread exceeded three rounds\")\n\t}\n\tif f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=10203\") != \"3\" {\n\t\tt.Fatal(\"chat-only budget mismatch\")\n\t}\n\tif err := r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(capture.calls) != 3 {\n\t\tt.Fatal(capture.calls)\n\t}\n\tif _, err := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, msg.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif ok, err := r.Eligible(f.ctx, capture.calls[0].OperationID); err != nil || ok {\n\t\tt.Fatal(\"recall still reminded\", ok, err)\n\t}\n\tq.ClientMessageID = client(49)\n\taccepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// The original member epoch is revoked in PHP before the worker projects it.\n\tf.exec(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n\tif ok, err := r.Eligible(f.ctx, capture.calls[1].OperationID); err != nil || ok {\n\t\tt.Fatal(\"revoked recipient reminded\", ok, err)\n\t}\n}\n\nfunc TestS20ReminderConfigBounds(t *testing.T) {\n\tc := DefaultReminderConfig()\n\tif c.FirstDelaySeconds != 10 || c.Validate() != nil {\n\t\tt.Fatal(\"default reminder policy\")\n\t}\n\tc.FirstDelaySeconds = 31\n\tif c.Validate() == nil {\n\t\tt.Fatal(\"first due exceeded 30-second policy\")\n\t}\n\tc = DefaultReminderConfig()\n\tc.PlatformHourly = 0\n\tif c.Validate() == nil {\n\t\tt.Fatal(\"unbounded platform budget\")\n\t}\n}\nfunc TestMySQLS20ChannelLimitsReleaseReservationsWithoutCountingSuccess(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{}\n\tr, _ := NewReminderService(s, capture)\n\taccepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err := r.Prepare(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\top := f.text(\"SELECT operation_id FROM chat_reminder_intents LIMIT 1\")\n\tif err := r.reconcileOne(f.ctx, op, ports.Receipt{OperationID: op, State: \"channel_limited\", Diagnostic: \"template_unavailable\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT rounds FROM chat_reminder_clusters\") != \"0\" || f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=10203\") != \"0\" || f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=0\") != \"0\" {\n\t\tt.Fatal(\"channel failure counted as successful reminder\")\n\t}\n\tif f.text(\"SELECT state FROM chat_reminder_clusters\") != \"channel_limited\" {\n\t\tt.Fatal(\"channel diagnostic lost\")\n\t}\n\tfor i := 0; i < 3; i++ {\n\t\tif err := r.Prepare(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"1\" {\n\t\tt.Fatal(\"channel limit created endless new rounds\")\n\t}\n}\n","server/tests/chat_reminder_contract.php":"<?php\ndeclare(strict_types=1);\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'){echo \"提醒数据库验证未启用\\n\";exit;}\nrequire_once dirname(__DIR__).'/app/Support/functions.php';\nspl_autoload_register(static function(string $class):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)===0){$file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require_once $file;}});\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderReceipts;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderDispatch;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nfunction reminderEnsure(bool $ok,string $message):void{if(!$ok)throw new RuntimeException($message);}\nfinal class ReminderGatewayFixture implements SubscribeMessageGateway{\n public int $calls=0;public bool $fail=false;\n public function categoryList():array{return [];}public function publicTemplateTitles(array $ids,int $start=0,int $limit=30):array{return [];}\n public function publicTemplateKeywords(string $tid):array{return [];}public function addTemplate(string $tid,array $kids,string $desc=''):string{return '';}\n public function templateList():array{return [];}\n public function send(array $payload):array{$this->calls++;reminderEnsure(!isset($payload['sms_fallback'])&&$payload['scene_key']==='chat_unread','chat SMS fallback or wrong scene');if($this->fail)throw new RuntimeException('accepted but transport result lost');return ['ok'=>true];}\n}\n$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');if(preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$m)!==1)throw new RuntimeException('loopback required');\n$config=['host'=>'127.0.0.1','port'=>(int)$m[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$root=new Database($config);$name='bixuan_test_chat_reminder_'.bin2hex(random_bytes(6));$root->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$GLOBALS['worker_admin_config']=['database'=>$config];$db=db();\ntry{\n (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n $db->execute(\"INSERT INTO users(id,public_id,nickname,status,created_at,updated_at) VALUES(10001,:public,'提醒隔离用户','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>str_repeat('U',26)]);\n $db->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10001,'fixture-app','fixture-openid','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n $settings=['wechat.subscribe_enabled'=>['1','bool'],'wechat.subscribe_template_ids'=>[json_encode(['chat_unread'=>['template_id'=>'fixture-template','field_map'=>['status'=>'thing1','time'=>'time2']]]),'json'],\n 'wechat.subscription.user.10001'=>[json_encode(['chat_unread'=>['enabled'=>true,'authorization_status'=>'accept','remaining_count'=>5,'subscription_type'=>'one_time']]),'json']];\n foreach($settings as $key=>$value)$db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,created_at,updated_at) VALUES(:key,:value,:type,'notification',0,'隔离测试',UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type=VALUES(value_type)\",['key'=>$key,'value'=>$value[0],'type'=>$value[1]]);\n $receipts=new ChatReminderReceipts($db);\n $body=static function(string $op):string{$q=['cluster_version'=>'1','conversation_id'=>'401','intent_id'=>'1','operation_id'=>$op,'recipient_id'=>'10001','target_seq'=>'2'];return json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);};\n $a=str_repeat('a',64);$raw=$body($a);\n $auth=new ChatInternalAuth($db,'test','internal-fixture',str_repeat('k',32));$headers=[];\n foreach($auth->sign('/chat-internal.php',$raw) as $line){[$key,$value]=explode(': ',$line,2);$headers[strtolower(substr($key,7))]=$value;}\n $auth->verify('/chat-internal.php',$raw,$headers);\n $replayed=false;try{$auth->verify('/chat-internal.php',$raw,$headers);}catch(RuntimeException $error){$replayed=true;}reminderEnsure($replayed,'internal replay accepted');\n $tamper=false;try{$auth->verify('/chat-internal.php',$raw.' ',$headers);}catch(RuntimeException $error){$tamper=true;}reminderEnsure($tamper,'tampered body accepted');\n for($i=0;$i<3;$i++)reminderEnsure($receipts->receive($raw)['state']==='accepted','receipt changed');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\")===1,'duplicate PHP receipt duplicated outbox');\n $conflict=false;try{$receipts->receive(str_replace('\"target_seq\":\"2\"','\"target_seq\":\"3\"',$raw));}catch(RuntimeException $error){$conflict=true;}reminderEnsure($conflict,'immutable operation payload changed');\n $gateway=new ReminderGatewayFixture();\n $dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>false);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===0&&$stats['suppressed']===1,'read message sent');\n $b=str_repeat('b',64);$receipts->receive($body($b));$dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>true);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===1&&$stats['sent']===1,'unread not sent once');\n $c=str_repeat('c',64);$receipts->receive($body($c));$gateway->fail=true;$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['unknown']===1,'provider unknown not recorded');\n $db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP() WHERE business_key=:key\",['key'=>'chat:'.$c]);$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$receipts->receive($body($c))['state']==='provider_unknown','unknown provider blindly retried');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='aliyun_sms'\")===0,'unknown fell back to paid SMS');\n $d=str_repeat('d',64);$receipts->receive($body($d));$checks=0;$final=new ChatReminderDispatch($db,$gateway,static function(string $op)use(&$checks):bool{return ++$checks===1;});$stats=$final->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['suppressed']===1,'final read check missed');\n $e=str_repeat('e',64);$receipts->receive($body($e));$db->execute(\"UPDATE chat_reminder_receipts SET state='sending',updated_at=UTC_TIMESTAMP()-INTERVAL 6 MINUTE WHERE operation_id=:op\",['op'=>$e]);\n $dispatcher->dispatch();reminderEnsure($receipts->receive($body($e))['state']==='provider_unknown'&&$gateway->calls===2,'crashed sender retried');\n echo \"S20 PHP 内部签名/重放、幂等回执、最终未读复验、供应商未知与短信隔离验证通过\\n\";\n}finally{$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n","chat/internal/dependencies/governance.go":"package dependencies\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http\"\n)\n\n// Explicit composition for the S21-S23 isolated/release composition root. No\n// call is made by the still-closed production bootstrap.\ntype Governance struct {\n\tService      *message.GovernanceService\n\tHTTP         http.Handler\n\tReminders    *message.ReminderService\n\tInternalHTTP http.Handler\n}\n\nfunc (r *Runtime) ComposeGovernance(base *message.Service, media *message.MediaService, n ports.Notification, internal *auth.InternalAuth) (*Governance, error) {\n\tif r.History == nil || r.Identity == nil || base == nil || n == nil || internal == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tg, err := message.NewGovernanceService(base, r.History, media, r.environment)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\th, err := message.NewGovernanceHandler(g, r.Identity, 8)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treminders, err := message.NewReminderService(base, n)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tih, err := message.NewReminderInternalHandler(reminders, internal)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Governance{g, h, reminders, ih}, nil\n}\n","chat/internal/message/governance_maintenance.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// One bounded pass. S22 owns wider archive/backup policy; this pass expires\n// governance evidence holds only after every linked case's retention ends.\nfunc (g *GovernanceService) ExpireEvidence(ctx context.Context) error {\n\trows, err := g.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_cases WHERE retain_until<=UTC_TIMESTAMP(6) AND state<>'expired' ORDER BY retain_until,id LIMIT 30`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\ttx, err := g.base.begin(ctx)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// Expired cases cannot be opened through caseLock; lock in the same order.\n\t\tvar subject, cid ports.ID\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(subject_id AS CHAR),CAST(conversation_id AS CHAR) FROM chat_cases WHERE id=?`, string(id)).Scan(&subject, &cid) != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = restrictionLocked(ctx, tx, subject); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif cid != \"0\" {\n\t\t\tvar n int\n\t\t\tif tx.QueryRowContext(ctx, `SELECT 1 FROM chat_conversations WHERE id=? FOR UPDATE`, string(cid)).Scan(&n) != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tc, err := scanCase(tx.QueryRowContext(ctx, `SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) FOR UPDATE`, string(id)))\n\t\tif err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif c.State == \"expired\" {\n\t\t\ttx.Rollback()\n\t\t\tcontinue\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_cases SET state='expired',version=version+1 WHERE id=?`, string(id)); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif c.TargetType == \"risk\" {\n\t\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET text_evidence='',context_evidence='' WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='risk' AND c.target_id=chat_risk_events.id AND c.retain_until>UTC_TIMESTAMP(6))`, string(c.Target))\n\t\t}\n\t\tif err == nil && (c.TargetType == \"message\" || c.TargetType == \"image_intent\") {\n\t\t\titems, e := caseImageItems(ctx, tx, c)\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tfor _, item := range items {\n\t\t\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads u SET legal_hold=0 WHERE u.id=? AND NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_image_items i ON c.target_type='message' AND c.target_id=i.message_id WHERE i.item_id=u.id AND c.retain_until>UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='image_intent' AND c.subject_id=u.actor_id AND c.conversation_id=u.conversation_id AND c.retain_until>UTC_TIMESTAMP(6))`, string(item.ItemID))\n\t\t\t\tif err != nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tsys := ports.Principal{Kind: \"system\", ActorID: \"0\", Environment: g.environment}\n\t\tif err = governanceLog(ctx, tx, sys, \"evidence.expire\", c.Conversation, c.ID, c.Item, decimal(number(c.Version)+1), \"治理证据保留期结束\"); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) Maintain(ctx context.Context, reminders *ReminderService) error {\n\tif err := g.ExpireRestrictions(ctx); err != nil {\n\t\treturn err\n\t}\n\tif err := g.CleanupSnapshots(ctx); err != nil {\n\t\treturn err\n\t}\n\tif err := g.ExpireEvidence(ctx); err != nil {\n\t\treturn err\n\t}\n\tif reminders != nil {\n\t\tif err := reminders.Reconcile(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := reminders.DrainEvents(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := reminders.Prepare(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn reminders.SubmitPending(ctx)\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) Run(ctx context.Context, reminders *ReminderService) {\n\tticker := time.NewTicker(time.Second)\n\tdefer ticker.Stop()\n\tfor {\n\t\tpass, cancel := context.WithTimeout(ctx, 10*time.Second)\n\t\t_ = g.Maintain(pass, reminders)\n\t\tcancel()\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n}\n\nfunc (r *ReminderService) Reconcile(ctx context.Context) error {\n\treader, ok := r.notification.(reminderReceipts)\n\tif !ok {\n\t\treturn nil\n\t}\n\trows, err := r.base.db.QueryContext(ctx, `SELECT operation_id FROM chat_reminder_intents WHERE (state IN ('submitted','provider_unknown') OR (state='retryable' AND attempts>=8)) AND (next_receipt_at IS NULL OR next_receipt_at<=UTC_TIMESTAMP(6)) ORDER BY next_receipt_at,id LIMIT 20`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tops := []string{}\n\tfor rows.Next() {\n\t\tvar op string\n\t\tif rows.Scan(&op) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tops = append(ops, op)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, op := range ops {\n\t\tif _, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET next_receipt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND WHERE operation_id=?`, op); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treceipt, e := reader.Status(ctx, op)\n\t\tif e != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif receipt.OperationID != op {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif receipt.State != \"accepted\" {\n\t\t\tif e = r.reconcileOne(ctx, op, receipt); e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t} else {\n\t\t\tif _, e = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='submitted' WHERE operation_id=? AND state='retryable'`, op); e != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) reconcileOne(ctx context.Context, op string, receipt ports.Receipt) error {\n\tif receipt.State != \"sent\" && receipt.State != \"suppressed\" && receipt.State != \"channel_limited\" && receipt.State != \"provider_unknown\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar c reminderCluster\n\tif r.base.db.QueryRowContext(ctx, `SELECT CAST(cluster_id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_intents WHERE operation_id=?`, op).Scan(&c.ID, &c.CID, &c.Actor, &c.Hash) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\t// Current PHP guard/account -> conversation -> cluster -> intent -> budget.\n\tw, windowErr := r.window(ctx, tx, c.CID, c.Actor, ^uint64(0))\n\terr = windowErr\n\tif err != nil && err != policy.ErrDenied {\n\t\treturn err\n\t}\n\tvar currentVersion uint64\n\tif tx.QueryRowContext(ctx, `SELECT round_version,rounds FROM chat_reminder_clusters WHERE id=? FOR UPDATE`, string(c.ID)).Scan(&currentVersion, &c.Round) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar version, target uint64\n\tvar round int\n\tvar state string\n\tvar created time.Time\n\tvar released bool\n\tif tx.QueryRowContext(ctx, `SELECT round_version,round_no,target_seq,state,created_at,budget_released FROM chat_reminder_intents WHERE operation_id=? FOR UPDATE`, op).Scan(&version, &round, &target, &state, &created, &released) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif state == \"sent\" || state == \"suppressed\" || state == \"channel_limited\" {\n\t\treturn nil\n\t}\n\tif receipt.State == \"suppressed\" || receipt.State == \"channel_limited\" {\n\t\tif !released {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_budgets SET hour_count=GREATEST(0,CAST(hour_count AS SIGNED)-IF(hour_start<=?,1,0)),day_count=GREATEST(0,CAST(day_count AS SIGNED)-IF(day_start=DATE(?),1,0)) WHERE recipient_id IN (0,?)`, created, created, string(c.Actor)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\treleased = true\n\t\t}\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_intents SET state=?,diagnostic=?,budget_released=? WHERE operation_id=?`, receipt.State, receipt.Diagnostic, released, op); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif version == currentVersion {\n\t\tif receipt.State == \"sent\" && round == c.Round+1 {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET rounds=?,last_notified_seq=GREATEST(last_notified_seq,?),first_notified_at=COALESCE(first_notified_at,UTC_TIMESTAMP(6)),next_due=TIMESTAMPADD(MINUTE,?,COALESCE(first_notified_at,UTC_TIMESTAMP(6))),state=IF(? >= 3,'exhausted','open'),blocked_reason=NULL WHERE id=?`, round, target, 5+(round-1)*10, round, string(c.ID)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t} else if receipt.State == \"channel_limited\" || receipt.State == \"provider_unknown\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state=?,blocked_reason=? WHERE id=?`, receipt.State, receipt.Diagnostic, string(c.ID)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t} else if receipt.State == \"suppressed\" {\n\t\t\tif windowErr == nil && w.First > 0 && w.Read >= target {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET round_version=round_version+1,first_seq=?,target_seq=?,first_due_at=TIMESTAMPADD(SECOND,?,?),next_due=TIMESTAMPADD(SECOND,?,?),first_notified_at=NULL,rounds=0,state='open',blocked_reason=NULL WHERE id=?`, w.First, w.Target, r.config.FirstDelaySeconds, w.At, r.config.FirstDelaySeconds, w.At, string(c.ID)); err != nil {\n\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state=IF(target_seq<=?,'closed',state),blocked_reason=? WHERE id=?`, target, receipt.Diagnostic, string(c.ID)); err != nil {\n\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","server/app/Support/functions.php":"<?php\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\View;\n\n// 2026-08-14：集中提供后台通用帮助函数，避免页面重复处理配置、转义与安全逻辑。\nfunction base_path($path = '')\n{\n    $base = defined('WORKER_BASE_PATH') ? WORKER_BASE_PATH : dirname(__DIR__, 2);\n    return $path === '' ? $base : $base . DIRECTORY_SEPARATOR . ltrim(str_replace(['/', '\\\\'], DIRECTORY_SEPARATOR, $path), DIRECTORY_SEPARATOR);\n}\n\nfunction app_config($key = null, $default = null)\n{\n    $config = isset($GLOBALS['worker_admin_config']) ? $GLOBALS['worker_admin_config'] : [];\n    if ($key === null || $key === '') {\n        return $config;\n    }\n\n    $value = $config;\n    foreach (explode('.', (string) $key) as $segment) {\n        if (!is_array($value) || !array_key_exists($segment, $value)) {\n            return $default;\n        }\n        $value = $value[$segment];\n    }\n    return $value;\n}\n\nfunction is_installed()\n{\n    return (bool) app_config('installed', false)\n        && is_file(base_path('config/installed.php'))\n        && is_file(base_path('storage/install.lock'));\n}\n\n// 2026-08-14：发布新代码后若配置版本尚未同步，后台仅允许登录并进入升级页，API 与计划任务保持暂停。\nfunction upgrade_required()\n{\n    return !empty($GLOBALS['worker_admin_upgrade_required']);\n}\n\nfunction db()\n{\n    static $database;\n    if (!$database) {\n        $config = (array) app_config('database', []);\n        if (empty($config['database']) && !empty($config['name'])) {\n            $config['database'] = $config['name'];\n        }\n        $database = new Database($config);\n    }\n    return $database;\n}\n\nfunction auth()\n{\n    static $auth;\n    if (!$auth) {\n        $auth = new Auth(db());\n    }\n    return $auth;\n}\n\nfunction csrf()\n{\n    static $csrf;\n    if (!$csrf) {\n        $csrf = new Csrf();\n    }\n    return $csrf;\n}\n\nfunction view($template, array $data = [], $layout = 'layouts/admin')\n{\n    return (new View(base_path('views')))->render($template, $data, $layout);\n}\n\nfunction e($value)\n{\n    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n}\n\nfunction app_url($path = '')\n{\n    $base = rtrim((string) app_config('app.url', ''), '/');\n    if ($base === '' && PHP_SAPI !== 'cli') {\n        $https = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')\n            || (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https');\n        $host = isset($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost';\n        $base = ($https ? 'https://' : 'http://') . $host;\n    }\n    return $base . ($path === '' ? '' : '/' . ltrim($path, '/'));\n}\n\nfunction admin_url($route = 'dashboard', array $params = [])\n{\n    $params = array_merge(['route' => $route], $params);\n    return app_url('admin/?' . http_build_query($params));\n}\n\nfunction asset_url($path)\n{\n    // 后台热修不提升数据库版本时，追加文件指纹刷新 CSS/JS，避免浏览器或 CDN 继续命中旧 2.4.0 静态资源。\n    $version = (string) app_config('app.version', app_config('version', '2.4.0'));\n    $relative = ltrim((string) $path, '/');\n    $assetPath = dirname(__DIR__, 2) . '/assets/' . $relative;\n    $fingerprint = '';\n    if (is_file($assetPath)) {\n        $mtime = @filemtime($assetPath);\n        $size = @filesize($assetPath);\n        if ($mtime !== false && $size !== false) $fingerprint = '-' . (string) $mtime . '-' . (string) $size;\n    }\n    return app_url('assets/' . $relative) . '?v=' . rawurlencode($version . $fingerprint);\n}\n\nfunction redirect($url, $status = 302)\n{\n    header('Location: ' . $url, true, $status);\n    exit;\n}\n\nfunction json_response(array $data, $status = 200)\n{\n    http_response_code((int) $status);\n    header('Content-Type: application/json; charset=utf-8');\n    // 2026-09-22：鉴权 API 可能位于 ESA/CDN 后方；显式禁止浏览器、代理和共享缓存保存或串用敏感响应。\n    header('Cache-Control: no-store, private, max-age=0');\n    header('Surrogate-Control: no-store');\n    header('Pragma: no-cache');\n    header('Expires: 0');\n    header('Vary: Authorization', false);\n    echo json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n    exit;\n}\n\nfunction request_id()\n{\n    static $id;\n    if (!$id) {\n        try {\n            $id = bin2hex(random_bytes(8));\n        } catch (Exception $exception) {\n            $id = str_replace('.', '', uniqid('', true));\n        }\n    }\n    return $id;\n}\n\nfunction request_ip()\n{\n    $ip = isset($_SERVER['REMOTE_ADDR']) ? (string) $_SERVER['REMOTE_ADDR'] : '127.0.0.1';\n    return substr($ip, 0, 45);\n}\n\nfunction write_log($channel, $message)\n{\n    $directory = base_path('storage/logs');\n    if (!is_dir($directory)) {\n        @mkdir($directory, 0775, true);\n    }\n    @file_put_contents($directory . DIRECTORY_SEPARATOR . preg_replace('/[^a-z0-9_-]/i', '', $channel) . '.log', $message, FILE_APPEND | LOCK_EX);\n}\n\nfunction flash($type = null, $message = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return null;\n    }\n    if ($type !== null && $message !== null) {\n        $_SESSION['_flash'][$type][] = (string) $message;\n        return null;\n    }\n    $messages = isset($_SESSION['_flash']) ? $_SESSION['_flash'] : [];\n    unset($_SESSION['_flash']);\n    return $messages;\n}\n\nfunction old_input(array $values = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return [];\n    }\n    if ($values !== null) {\n        $_SESSION['_old_input'] = $values;\n        return [];\n    }\n    $old = isset($_SESSION['_old_input']) ? $_SESSION['_old_input'] : [];\n    unset($_SESSION['_old_input']);\n    return $old;\n}\n\nfunction money($cents)\n{\n    return '¥' . number_format(((int) $cents) / 100, 2);\n}\n\n// 2026-08-14：数据库统一保存 UTC，后台所有可见时间通过此函数转换为站点时区，避免中国管理员看到时间少八小时。\nfunction local_datetime($value, $format = 'Y-m-d H:i')\n{\n    $value = trim((string) $value);\n    if ($value === '' || $value === '0000-00-00 00:00:00') {\n        return '—';\n    }\n    try {\n        $date = new DateTimeImmutable($value, new DateTimeZone('UTC'));\n        return $date->setTimezone(new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai')))->format((string) $format);\n    } catch (Throwable $exception) {\n        return $value;\n    }\n}\n\n// 2026-08-14：生成不含易混淆字符的 26 位公开标识，数据库只暴露该标识而不暴露自增主键。\nfunction public_id()\n{\n    $alphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\n    $bytes = random_bytes(26);\n    $id = '';\n    for ($index = 0; $index < 26; $index++) {\n        $id .= $alphabet[ord($bytes[$index]) & 31];\n    }\n    return $id;\n}\n\n// 2026-08-14：业务单号包含类型、UTC 时间与随机尾号，便于人工检索且避免并发冲突。\nfunction business_no($prefix)\n{\n    return strtoupper(preg_replace('/[^A-Z0-9]/i', '', (string) $prefix))\n        . gmdate('YmdHis')\n        . substr(public_id(), -6);\n}\n\n// 新订单号：BX + 两位类目码 + YYMMDD + '-' + 六位安全随机码。历史订单号保持不变。\n// 生成函数不访问数据库；订单表 public_no 唯一索引与写入端重试负责处理极少数碰撞。\nfunction order_business_no($categoryCode)\n{\n    $code = strtoupper(preg_replace('/[^A-Z]/i', '', (string) $categoryCode));\n    $code = strlen($code) === 2 ? $code : 'QT';\n    $alphabet = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';\n    $suffix = '';\n    for ($i = 0; $i < 6; $i++) {\n        $suffix .= $alphabet[random_int(0, strlen($alphabet) - 1)];\n    }\n    $date = (new DateTimeImmutable('now', new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai'))))->format('ymd');\n    return 'BX' . $code . $date . '-' . $suffix;\n}\n\n// 2026-08-23：后台新增订单和云数据同步统一生成姓名、手机号的最小必要脱敏展示值。\nfunction mask_private_name($value)\n{\n    $value = trim((string) $value);\n    if ($value === '') {\n        return '';\n    }\n    $length = function_exists('mb_strlen') ? mb_strlen($value, 'UTF-8') : strlen($value);\n    $first = function_exists('mb_substr') ? mb_substr($value, 0, 1, 'UTF-8') : substr($value, 0, 1);\n    return $first . str_repeat('*', max(1, min(3, $length - 1)));\n}\n\nfunction mask_private_mobile($value)\n{\n    $digits = preg_replace('/\\D+/', '', (string) $value);\n    if (strlen($digits) < 7) {\n        return $digits === '' ? '' : substr($digits, 0, 2) . '***';\n    }\n    return substr($digits, 0, 3) . str_repeat('*', max(4, strlen($digits) - 7)) . substr($digits, -4);\n}\n\n// 2026-08-23：使用安装时生成的站点密钥加密微信支付、短信、云开发和订单隐私字段。\nfunction encrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if ($value === '') {\n        return null;\n    }\n    $appKey = (string) app_config('app.key', '');\n    if ($appKey === '' || !function_exists('openssl_encrypt')) {\n        throw new RuntimeException('站点加密密钥或 OpenSSL 不可用，无法保存敏感内容。');\n    }\n    $key = hash('sha256', $appKey, true);\n    $nonce = random_bytes(12);\n    $tag = '';\n    $ciphertext = openssl_encrypt($value, 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $nonce, $tag, (string) $context, 16);\n    if (!is_string($ciphertext)) {\n        throw new RuntimeException('敏感内容加密失败。');\n    }\n    return 'enc:v1:' . base64_encode($nonce . $tag . $ciphertext);\n}\n\nfunction decrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if (strpos($value, 'enc:v1:') !== 0) {\n        return $value;\n    }\n    $payload = base64_decode(substr($value, 7), true);\n    $appKey = (string) app_config('app.key', '');\n    if (!is_string($payload) || strlen($payload) < 29 || $appKey === '' || !function_exists('openssl_decrypt')) {\n        return '';\n    }\n    $plaintext = openssl_decrypt(substr($payload, 28), 'aes-256-gcm', hash('sha256', $appKey, true), OPENSSL_RAW_DATA, substr($payload, 0, 12), substr($payload, 12, 16), (string) $context);\n    return is_string($plaintext) ? $plaintext : '';\n}\n\nfunction private_value_hmac($value, $context = 'private')\n{\n    return hash_hmac('sha256', (string) $value, hash('sha256', (string) app_config('app.key', ''), true) . (string) $context);\n}\n\nfunction status_meta($status)\n{\n    $map = [\n        'pending' => ['待处理', 'warning'], 'pending_review' => ['待审核', 'warning'],\n        'approved' => ['已通过', 'success'], 'active' => ['正常', 'success'],\n        'published' => ['已公开', 'info'], 'paid' => ['已支付', 'success'],\n        'completed' => ['已完成', 'success'], 'success' => ['成功', 'success'],\n        'rejected' => ['已驳回', 'danger'], 'cancelled' => ['已取消', 'muted'],\n        'canceled' => ['已取消', 'muted'], 'disabled' => ['已停用', 'muted'],\n        'failed' => ['失败', 'danger'], 'refunding' => ['退款中', 'warning'],\n        'unpaid' => ['未支付', 'muted'], 'processing' => ['处理中', 'info'],\n        'open' => ['处理中', 'warning'], 'resolved' => ['已解决', 'success'],\n        'hidden' => ['已隐藏', 'muted'], 'visible' => ['显示', 'success'],\n        'waiting' => ['等待报价', 'warning'], 'collecting' => ['报价中', 'info'],\n        'offered' => ['待师傅接单', 'warning'], 'accepted' => ['已接受', 'success'],\n        'supplement_required' => ['待补资料', 'warning'], 'suspended' => ['已暂停', 'danger'],\n        'none' => ['无', 'muted'], 'created' => ['已创建', 'warning'],\n        'cancel_approved_pending_refund' => ['已取消待退款', 'warning'],\n        'succeeded' => ['退款成功', 'success'], 'archived' => ['已归档', 'muted'],\n        'draft' => ['草稿', 'warning'], 'payment_failed' => ['付款失败', 'danger'],\n        'claimed' => ['已领取', 'success'], 'revoked' => ['已撤销', 'muted'],\n        'expired' => ['已过期', 'muted'], 'overdue' => ['已逾期', 'danger'],\n        'acknowledged' => ['已知悉', 'info'],\n        'quoting' => ['报价中', 'info'], 'selected' => ['已选报价', 'success'],\n        'unassigned' => ['待安排', 'warning'], 'assigned' => ['已安排', 'info'],\n        'info_released' => ['已开放信息', 'success'], 'not_started' => ['未开始', 'muted'],\n        'scheduled' => ['已预约', 'info'], 'refunded' => ['已退款', 'success'],\n        'awaiting_payment' => ['待付预约费', 'warning'], 'in_progress' => ['施工中', 'info'],\n        'submitted' => ['待验收', 'warning'], 'confirmed' => ['已确认', 'success'],\n        'settled' => ['已抵扣结清', 'success'], 'released' => ['已释放', 'muted'],\n        'deleted' => ['已删除', 'muted'], 'user' => ['用户责任', 'danger'],\n        'worker' => ['师傅责任', 'danger'], 'platform' => ['平台责任', 'warning'],\n        'shared' => ['双方协商', 'info'], 'unclear' => ['责任不清', 'warning'],\n        'undetermined' => ['待判定', 'warning'], 'user_schedule_change' => ['用户行程原因', 'info'],\n        'draft_pending_upload' => ['待上传图片', 'warning'], 'pending_payment' => ['待付款', 'warning'],\n        'selected_pending_payment' => ['已选报价待付款', 'warning'], 'reviewed' => ['已审核', 'success'],\n        'pending_contact_release' => ['待开放联系信息', 'warning'], 'completed_with_delay' => ['完成但尾款延期', 'warning'],\n        'booking_fee' => ['预约费', 'info'], 'commission' => ['平台服务费', 'info'],\n        'cancel_refund' => ['申请退款并取消订单', 'warning'], 'change_rejected' => ['拒绝加价', 'warning'],\n        // 2026-08-28：补齐后台资源列表、支付、派单和通知中可能出现的枚举中文名。\n        'closed' => ['已关闭', 'muted'], 'requested' => ['待提交', 'warning'],\n        'received' => ['已接收', 'info'], 'sent' => ['已发送', 'success'], 'read' => ['已读', 'success'],\n        'unknown' => ['未确定', 'muted'], 'recorded' => ['已记录', 'info'], 'effective' => ['已生效', 'success'],\n        'locked' => ['已锁定', 'success'], 'superseded' => ['已被新版本替代', 'muted'],\n        'order_booking' => ['订单预约费', 'info'], 'measurement_balance' => ['测量选师傅补款', 'info'], 'measurement_change' => ['测量现场加费', 'info'], 'booking_fee_paid' => ['预约费已支付', 'success'],\n        'worker_quote' => ['师傅报价成交', 'info'], 'admin_assignment' => ['管理员指派', 'info'],\n        'admin' => ['管理员指派', 'info'], 'invite' => ['邀请师傅接单', 'info'],\n        'ordinary_order' => ['普通订单分享', 'info'], 'worker_invite' => ['邀请师傅分享', 'info'],\n        'run_empty_fee' => ['跑空费', 'warning'], 'auto_72h' => ['72小时自动验收', 'info'],\n        'schedule_changed' => ['行程变化', 'info'], 'forced_cancel_refund' => ['强制取消并退款', 'danger'],\n        'change_accepted' => ['同意加价', 'success'], 'construction_issue' => ['施工问题', 'warning'],\n        // 2026-08-29：尾款延期提交即为已登记，只有放弃收款才标记坏账。\n        'reported' => ['已登记', 'info'], 'bad_debt' => ['已标记坏账', 'danger'],\n        // 2026-09-09：实际尾款先自动生效，再由管理员抽查。\n        'auto_approved' => ['自动预审已生效', 'success'],\n        // 2026-09-15：补齐 V2.2.1 预计服务费在验收前的中文状态。\n        'estimate' => ['预计服务费待缴', 'warning'], 'estimate_paid' => ['预计服务费部分已缴', 'info'],\n        'estimate_settled' => ['预计服务费已结清', 'success'],\n    ];\n    return isset($map[$status]) ? $map[$status] : [$status ?: '—', 'muted'];\n}\n\n// 2026-08-25：模板只需要中文状态文字时统一走同一份映射，避免列表与详情翻译不一致。\nfunction status_text($status)\n{\n    $meta = status_meta($status);\n    return $meta[0];\n}\n\n// 2026-08-30：订单专用状态按小程序列表的业务优先级计算，避免 active 被笼统翻译成“正常”。\nfunction order_business_status_meta(array $order)\n{\n    $refundStatus = (string) ($order['refund_status'] ?? '');\n    $lifecycleStatus = (string) ($order['lifecycle_status'] ?? 'active');\n    $auditStatus = (string) ($order['audit_status'] ?? '');\n    $paymentStatus = (string) ($order['payment_status'] ?? '');\n    $fulfillmentStatus = (string) ($order['fulfillment_status'] ?? '');\n    $assignmentStatus = (string) ($order['assignment_status'] ?? '');\n    $quoteStatus = (string) ($order['quote_status'] ?? '');\n    $dispatchMode = (string) ($order['dispatch_mode'] ?? 'multi_quote');\n    $expectedFeeType = (string) ($order['expected_fee_type'] ?? '');\n    $expectedFeeCents = max(0, (int) ($order['expected_fee_cents'] ?? 0));\n\n    if (in_array($refundStatus, ['created', 'pending_review', 'approved', 'processing', 'refunding'], true) || $lifecycleStatus === 'cancel_approved_pending_refund') return ['退款处理中', 'warning'];\n    if ($refundStatus === 'succeeded') return ['已退款', 'success'];\n    if ($lifecycleStatus === 'expired') return ['已到期取消', 'warning'];\n    if ($lifecycleStatus === 'cancelled') return ['已取消', 'danger'];\n    if ($lifecycleStatus === 'completed') return ['已完成', 'success'];\n    if ($auditStatus === 'draft' && $paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($auditStatus === 'draft') return ['草稿', 'muted'];\n    if ($auditStatus === 'pending') return ['待审核', 'warning'];\n    if ($auditStatus === 'supplement_required') return ['待补充资料', 'warning'];\n    if ($auditStatus === 'rejected') return ['审核未通过', 'danger'];\n    if ($fulfillmentStatus === 'accepted') return ['已验收', 'success'];\n    if ($fulfillmentStatus === 'submitted') return ['待验收', 'warning'];\n    if ($fulfillmentStatus === 'in_progress') return ['施工中', 'info'];\n    if ($fulfillmentStatus === 'scheduled') return ['已预约', 'info'];\n    if ($paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($assignmentStatus === 'accepted') {\n        if ($dispatchMode === 'single_grab') return [$expectedFeeType === 'total' && $expectedFeeCents > 0 ? '已按期望总价抢单，待施工' : '抢单报价已成交，待施工', 'info'];\n        return ['已安排师傅，待施工', 'info'];\n    }\n    if (in_array($assignmentStatus, ['offered', 'assigned'], true)) {\n        if ($dispatchMode === 'single_grab' && $assignmentStatus === 'offered') return ['师傅已抢单，待沟通报价', 'warning'];\n        return ['已安排师傅，待接单', 'warning'];\n    }\n    if (!empty($order['selected_quote_id']) || $quoteStatus === 'selected') return ['已选报价，待安排师傅', 'warning'];\n    if (in_array($quoteStatus, ['quoting', 'collecting'], true)) return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '报价中', 'info'];\n    return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '等待报价', 'info'];\n}\n\n// 2026-08-28：后台订单时间线统一显示中文事件标题；事件正文继续展示具体金额、原因和处理结果。\nfunction order_event_text($eventType)\n{\n    $map = [\n        'draft_created'=>'订单草稿已保存','admin_created'=>'管理员新增订单','admin_updated'=>'管理员修改订单资料',\n        'order_ready_for_prepayment'=>'等待支付预约费','order_submitted'=>'订单已提交审核','order_approved'=>'审核通过并公开',\n        'order_supplement_required'=>'要求补充资料','order_supplemented'=>'用户补充资料并重新提交','order_rejected'=>'订单审核未通过','order_published'=>'订单公开到大厅','order_hidden'=>'订单从大厅隐藏','order_edited'=>'订单资料已修改',\n        'worker_quoted'=>'师傅提交报价','worker_quote_updated'=>'师傅修改报价','platform_quoted'=>'平台提交报价','platform_quote_created'=>'平台新增报价','quote_selected_pending_payment'=>'用户选择报价',\n        'booking_fee_paid'=>'预约费支付成功','booking_fee_paid_upfront'=>'下单预约费支付成功','payment_reservation_released'=>'支付占位已释放',\n        'worker_invite_created'=>'生成邀请师傅分享','invite_claimed'=>'受邀师傅领取订单','worker_assigned'=>'管理员安排师傅','order_grabbed'=>'师傅抢单成功','single_grab_quote_confirmed'=>'抢单报价直接成交','single_grab_fixed_price_accepted'=>'按期望总价抢单成交','assignment_accepted'=>'师傅确认接单','contact_revealed'=>'完整联系信息已开放',\n        'appointment_recorded'=>'电话预约已记录','exceptional_arrival_reported'=>'到场异常已提交','change_requested'=>'师傅申请加价','change_accepted'=>'用户同意加价','change_rejected'=>'用户拒绝加价',\n        'measurement_service_paid'=>'测量服务款已补齐','measurement_change_accepted_pending_payment'=>'测量加费待支付','measurement_change_paid'=>'测量现场加费已支付','measurement_change_refund_created'=>'测量加费已登记退款','measurement_change_refunded'=>'测量加费已退款','measurement_late_balance_refund_created'=>'测量补款已登记退款','measurement_late_balance_refunded'=>'测量补款已退款',\n        'measurement_result_submitted'=>'测量成果已提交','measurement_result_accepted'=>'测量成果已确认','measurement_auto_accepted'=>'测量成果自动确认','measurement_rework_requested'=>'用户要求补测',\n        'measurement_hold_extension_requested'=>'申请延长测量冻结期','measurement_hold_extension_approved'=>'测量冻结延期已批准','measurement_hold_extension_rejected'=>'测量冻结延期未批准',\n        'measurement_income_released'=>'测量收入已释放','measurement_construction_linked'=>'测量单已关联施工',\n        'offline_collection_delayed'=>'线下尾款延期已登记','offline_collection_bad_debt'=>'线下尾款已标记坏账','completion_submitted'=>'师傅提交完工','completion_accepted_by_user'=>'用户确认验收','auto_completion_accepted'=>'系统自动验收','auto_accepted_72h'=>'72小时自动验收',\n        'auto_reviewed_5d'=>'5天自动评价','review_submitted'=>'用户提交评价','commission_receivable_created'=>'生成平台服务费账单','commission_paid'=>'平台服务费已结清',\n        'cancel_requested'=>'用户申请退款取消','cancel_approved'=>'管理员同意取消退款','admin_cancelled'=>'管理员强制取消','forced_cancel_refund'=>'管理员强制取消退款','auto_cancelled_7d'=>'7天未成交自动取消',\n        'cancel_rejected'=>'取消退款申请未通过','cancel_approved'=>'取消退款审核通过','refund_succeeded'=>'预约费退款成功','dispute_opened'=>'订单进入争议处理','dispute_resolved'=>'订单争议已结案','order_demo_seeded'=>'测试流程数据建立',\n        'test_center_scenario_built'=>'测试场景已生成（预置数据）',\n        'test_center_preset_preapproved'=>'已预置审核通过状态（未执行人工审核）',\n        'test_center_preset_target_built'=>'测试订单目标状态已生成（预置数据）',\n        'test_center_preset_worker_quote'=>'已预置师傅报价（未执行真实报价）',\n        'test_center_linked_construction_ready'=>'关联施工测试单已就绪（预置数据）',\n        'test_center_proxy_ready'=>'普通代录测试草稿已就绪'\n    ];\n    return isset($map[$eventType]) ? $map[$eventType] : '订单流程记录';\n}\n\nfunction audit($action, $resourceType, $resourceId = null, $description = '', $before = null, $after = null)\n{\n    if (!is_installed()) {\n        return;\n    }\n    try {\n        $admin = auth()->user();\n        // 2026-08-14：审计字段与不可变审计表保持一致，记录操作者快照及业务对象。\n        db()->execute(\n            \"INSERT INTO audit_logs (request_id, actor_type, actor_id, actor_name_snapshot, action, entity_type, entity_id, before_json, after_json, reason, ip_address, user_agent, result, created_at) VALUES (:request_id,'admin',:actor_id,:actor_name,:action,:entity_type,:entity_id,:before_json,:after_json,:reason,:ip,:ua,'success',NOW())\",\n            [\n                'actor_id' => $admin ? $admin['id'] : null,\n                'actor_name' => $admin ? ($admin['real_name'] ?: $admin['username']) : 'system',\n                'action' => $action,\n                'entity_type' => $resourceType,\n                'entity_id' => $resourceId === null ? null : (string) $resourceId,\n                'reason' => $description,\n                'before_json' => $before === null ? null : json_encode($before, JSON_UNESCAPED_UNICODE),\n                'after_json' => $after === null ? null : json_encode($after, JSON_UNESCAPED_UNICODE),\n                'ip' => request_ip(),\n                'ua' => substr(isset($_SERVER['HTTP_USER_AGENT']) ? $_SERVER['HTTP_USER_AGENT'] : 'cli', 0, 500),\n                'request_id' => request_id(),\n            ]\n        );\n    } catch (Throwable $exception) {\n        write_log('audit', '[' . date('c') . '] ' . $exception->getMessage() . \"\\n\");\n    }\n}\n\nfunction setting($key, $default = null)\n{\n    static $cache = [];\n    if (array_key_exists($key, $cache)) {\n        return $cache[$key];\n    }\n    try {\n        $row = db()->fetch('SELECT setting_value, value_type FROM system_settings WHERE setting_key = :key LIMIT 1', ['key' => $key]);\n        if (!$row) {\n            return $cache[$key] = $default;\n        }\n        $value = $row['setting_value'];\n        // 2026-08-25：新设置按运营要求明文保存；这里继续兼容读取升级前已有的 enc:v1 密文。\n        if (is_string($value) && strpos($value, 'enc:v1:') === 0) {\n            $value = decrypt_private_value($value, 'system-setting:' . (string) $key);\n        }\n        if (in_array($row['value_type'], ['int', 'integer'], true)) {\n            $value = (int) $value;\n        } elseif (in_array($row['value_type'], ['bool', 'boolean'], true)) {\n            $value = in_array(strtolower((string) $value), ['1', 'true', 'yes', 'on'], true);\n        } elseif ($row['value_type'] === 'json') {\n            $decoded = json_decode((string) $value, true);\n            $value = json_last_error() === JSON_ERROR_NONE ? $decoded : $default;\n        }\n        return $cache[$key] = $value;\n    } catch (Throwable $exception) {\n        return $default;\n    }\n}\n","server/app/Contracts/SubscribeMessageGateway.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface SubscribeMessageGateway\n{\n    public function categoryList(): array;\n    public function publicTemplateTitles(array $categoryIds, int $start = 0, int $limit = 30): array;\n    public function publicTemplateKeywords(string $tid): array;\n    public function addTemplate(string $tid, array $kidList, string $sceneDesc = ''): string;\n    public function templateList(): array;\n    public function send(array $payload): array;\n}\n"},"encodings":{"server/tests/fixtures/schema-2.6.0.sql.gz":"base64"},"blob_shas":{"chat/build.sh":"c9d2e8c654fac590d6533b2dfaa9d6e31e3d1aaa","chat/cmd/chatd/main.go":"ecd53d4d9b8d37dd714e8148a8e606a52801870f","chat/go.mod":"9e5d6b33a9a9fd732dcd518a1e8a8a3c7af2deba","chat/go.sum":"fb24675236722882b2484e1d8be224fa18a08a0e","chat/internal/auth/auth_test.go":"ee4c10778cc9abd6326ed781f4e924379c137eb3","chat/internal/auth/config.go":"0e0744e04da056a2450467411c085136ab5e76f7","chat/internal/auth/http.go":"09e194a71335c5c52cb408c5bbcf0d437b48f