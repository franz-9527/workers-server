nds RuntimeException\n{\n    public array $payload;\n    public function __construct(array $payload,int $status) { parent::__construct('fixture response',$status);$this->payload=$payload; }\n}\nfunction json_response(array $payload,$status=200) { throw new ChatResponse($payload,(int)$status); }\nfunction request_id() { return 'fixture-request'; }\nfinal class ChatGuardAuth extends Auth\n{\n    public bool $loggedIn=true;\n    public bool $changePassword=false;\n    public function __construct() {}\n    public function check() { return $this->loggedIn; }\n    public function user() { return ['must_change_password'=>$this->changePassword]; }\n}\n$guardAuth=new ChatGuardAuth();$guard=new AdminRequestGuard($guardAuth,new Csrf());\n$_SESSION['_csrf_token']=str_repeat('a',64);$_SERVER['REQUEST_METHOD']='POST';$_POST=[];\nrejected(static function()use($guard):void{$guard->inspect('chat.credentials');},403);\n$_SERVER['HTTP_X_CSRF_TOKEN']=str_repeat('a',64);$guard->inspect('chat.credentials');\n$guardAuth->loggedIn=false;rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},401);\n$guardAuth->loggedIn=true;$guardAuth->changePassword=true;rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},403);\n$_SERVER['REQUEST_METHOD']='GET';rejected(static function()use($guard):void{$guard->inspect('chat.credentials');},405);\n$_SESSION=['admin_id'=>'2','chat_admin_session_id'=>'1'];\ntry { (new Auth(new ChatIdentityFixtureDatabase()))->logout(); throw new RuntimeException('logout bypassed revocation failure'); }\ncatch(RuntimeException $error) { ensure(isset($_SESSION['admin_id'],$_SESSION['chat_admin_session_id']), 'failed logout discarded revocation evidence'); }\necho \"聊天身份PHP契约通过\\n\";\n","server/app/Core/Csrf.php":"<?php\n\nnamespace WorkerAdmin\\Core;\n\nuse RuntimeException;\n\nclass Csrf\n{\n    // 2026-08-14：所有后台写操作统一使用会话 CSRF 令牌。\n    public function token()\n    {\n        if (empty($_SESSION['_csrf_token'])) {\n            $_SESSION['_csrf_token'] = bin2hex(random_bytes(32));\n        }\n        return $_SESSION['_csrf_token'];\n    }\n\n    public function input()\n    {\n        return '<input type=\"hidden\" name=\"_token\" value=\"' . \\e($this->token()) . '\">';\n    }\n\n    public function validate($token)\n    {\n        return is_string($token) && hash_equals($this->token(), $token);\n    }\n\n    public function verifyRequest()\n    {\n        $token = isset($_POST['_token']) ? $_POST['_token'] : (isset($_SERVER['HTTP_X_CSRF_TOKEN']) ? $_SERVER['HTTP_X_CSRF_TOKEN'] : '');\n        if (!$this->validate($token)) {\n            throw new RuntimeException('页面已过期，请刷新后重试。');\n        }\n    }\n\n    public function rotate()\n    {\n        $_SESSION['_csrf_token'] = bin2hex(random_bytes(32));\n        return $_SESSION['_csrf_token'];\n    }\n}\n","server/app/Http/Admin/AdminRequestGuard.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin;\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\n\nfinal class AdminRequestGuard\n{\n    private Auth $auth;\n    private Csrf $csrf;\n\n    public function __construct(Auth $auth, Csrf $csrf)\n    {\n        $this->auth = $auth;\n        $this->csrf = $csrf;\n    }\n\n    public function inspect(string $route): void\n    {\n        if ($route === 'chat.credentials') {\n            $status = 0;\n            if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {\n                header('Allow: POST'); $status = 405;\n            } elseif (!$this->auth->check()) { $status = 401;\n            } elseif (!empty($this->auth->user()['must_change_password'])) { $status = 403;\n            } else {\n                try { $this->csrf->verifyRequest(); } catch (\\RuntimeException $error) { $status = 403; }\n            }\n            if ($status) \\json_response(['ok'=>false,'code'=>$status===401?'CHAT_UNAUTHORIZED':($status===405?'CHAT_METHOD_NOT_ALLOWED':'CHAT_FORBIDDEN'),\n                'message'=>'请刷新页面后重试','retryable'=>false,'request_id'=>\\request_id(),'server_time'=>gmdate('Y-m-d\\TH:i:s\\Z')],$status);\n            return;\n        }\n        if ($route === 'login') return;\n        $this->auth->requireLogin();\n        $user = $this->auth->user();\n        if (!empty($user['must_change_password']) && !in_array($route, ['profile','profile.password','logout'], true)) {\n            \\flash('warning', '首次登录必须先修改演示密码。');\n            \\redirect(\\admin_url('profile'));\n        }\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) === 'POST') {\n            $this->csrf->verifyRequest();\n        }\n    }\n}\n\n","chat/internal/auth/governance.go":"package auth\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Scope-specific authority stays live under the caller's transaction. Audit\n// mini identities deliberately cannot enter the ordinary member authorizer.\nfunc (s *MySQLSource) ValidateAuditMiniLocked(ctx context.Context, tx *sql.Tx, p ports.Principal) error {\n\tif p.Kind != \"mini_audit\" || len(p.Scopes) != 1 || p.Scopes[0] != \"chat:audit\" {\n\t\treturn ErrUnauthorized\n\t}\n\tvar hash string\n\terr := tx.QueryRowContext(ctx, `SELECT token_hash FROM login_sessions WHERE id=? LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&hash)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tmini := p\n\tmini.Kind = \"mini\"\n\tmini.Scopes = []string{\"chat:use\"}\n\tmini.SessionVersion = digest(\"mini-v1\\n\" + string(p.SourceID) + \"\\n\" + hash + \"\\n\" + string(p.ActorID))\n\tif err = s.ValidatePrincipalLocked(ctx, tx, mini); err != nil {\n\t\treturn err\n\t}\n\tvar version string\n\terr = tx.QueryRowContext(ctx, `SELECT authority_version FROM chat_mini_auditors WHERE user_id=? AND enabled=1 LOCK IN SHARE MODE`, string(p.ActorID)).Scan(&version)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif !hex64.MatchString(version) || p.SessionVersion != digest(\"mini-audit-v1\\n\"+string(p.SourceID)+\"\\n\"+hash+\"\\n\"+string(p.ActorID)+\"\\n\"+version) {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\nfunc (s *MySQLSource) ValidateAdminLocked(ctx context.Context, tx *sql.Tx, p ports.Principal, scope string) error {\n\tif scope == \"chat:audit\" && p.Kind == \"mini_audit\" {\n\t\treturn s.ValidateAuditMiniLocked(ctx, tx, p)\n\t}\n\tif tx == nil || p.Kind != \"admin\" || !p.ActorID.Valid() || p.ActorID == \"0\" || !p.SourceID.Valid() || p.SourceID == \"0\" || !validScopes(p.Kind, p.Scopes) || !time.Now().Before(p.ExpiresAt) {\n\t\treturn ErrUnauthorized\n\t}\n\tfound := false\n\tfor _, v := range p.Scopes {\n\t\tif v == scope {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\treturn ErrUnauthorized\n\t}\n\tvar actor, sid, version, raw string\n\tvar expires int64\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(admin_id AS CHAR),session_hash,session_version,scopes_json,UNIX_TIMESTAMP(expires_at) FROM chat_admin_sessions WHERE id=? AND revoked_at IS NULL AND expires_at>UTC_TIMESTAMP() LOCK IN SHARE MODE`, string(p.SourceID)).Scan(&actor, &sid, &version, &raw, &expires)\n\tif err == sql.ErrNoRows {\n\t\treturn ErrUnauthorized\n\t}\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar scopes []string\n\tif json.Unmarshal([]byte(raw), &scopes) != nil || !validScopes(\"admin\", scopes) {\n\t\treturn ErrUnauthorized\n\t}\n\tfound = false\n\tfor _, v := range scopes {\n\t\tif v == scope {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found || actor != string(p.ActorID) || sid != p.SessionID || version != p.SessionVersion || p.ExpiresAt.Unix() > expires {\n\t\treturn ErrUnauthorized\n\t}\n\treturn nil\n}\n","server/app/Http/Api/Modules/ChatCredentialApiModule.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Api\\Modules;\n\nuse RuntimeException;\nuse Throwable;\nuse WorkerAdmin\\Application\\Chat\\ChatCredentialIssuer;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Api\\ApiModule;\n\nfinal class ChatCredentialApiModule implements ApiModule\n{\n    private Database $db;\n    public function __construct(Database $db) { $this->db = $db; }\n    public function supports(string $route): bool { return in_array($route,['chat.credentials','chat.audit.credentials'],true); }\n    public function requiresContentSecurity(string $route): bool { return false; }\n    public function dispatch(string $route): void\n    {\n        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {\n            header('Allow: POST');\n            $this->fail('请求方式不正确', 'CHAT_METHOD_NOT_ALLOWED', 405);\n        }\n        $authorization = (string)($_SERVER['HTTP_AUTHORIZATION'] ?? '');\n        if (preg_match('/^Bearer ([A-Fa-f0-9]{64})$/D', $authorization, $match) !== 1) $this->fail('请重新登录', 'CHAT_UNAUTHORIZED', 401);\n        try {\n            $issuer = new ChatCredentialIssuer($this->db, (array)\\app_config('chat', []), (string)\\app_config('app.env', 'production'));\n            \\json_response(['ok'=>true,'data'=>$issuer->exchangeMini($match[1],$route==='chat.audit.credentials')]);\n        } catch (Throwable $exception) {\n            // Deliberately don't pass the exception/SQL/token to the global API logger.\n            $status = $exception instanceof RuntimeException && in_array($exception->getCode(),[401,403],true) ? $exception->getCode() : 503;\n            $this->fail($status === 401 ? '登录状态已失效，请重新进入' : '聊天身份暂不可用，请稍后重试',\n                $status === 401 ? 'CHAT_UNAUTHORIZED' : ($status===403?'CHAT_FORBIDDEN':'CHAT_DEPENDENCY_UNAVAILABLE'), $status);\n        }\n    }\n    private function fail(string $message, string $code, int $status): void\n    {\n        \\json_response(['ok'=>false,'code'=>$code,'message'=>$message,'request_id'=>\\request_id(),\n            'retryable'=>$status === 503,'server_time'=>gmdate('Y-m-d\\TH:i:s\\Z')], $status);\n    }\n}\n","chat/internal/message/governance.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n\t\"unicode/utf8\"\n)\n\ntype GovernanceService struct {\n\tbase        *Service\n\thistory     *HistoryService\n\tmedia       *MediaService\n\tsource      *auth.MySQLSource\n\tenvironment string\n}\n\nfunc NewGovernanceService(base *Service, h *HistoryService, m *MediaService, env string) (*GovernanceService, error) {\n\tif base == nil || h == nil || base.db != h.db || env != h.environment {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tsource, err := auth.NewMySQLSource(base.db)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &GovernanceService{base, h, m, source, env}, nil\n}\nfunc (g *GovernanceService) admin(ctx context.Context, tx *sql.Tx, p ports.Principal, scope string) error {\n\tif p.Environment != g.environment {\n\t\treturn auth.ErrUnauthorized\n\t}\n\treturn g.source.ValidateAdminLocked(ctx, tx, p, scope)\n}\nfunc reasonValid(s string) bool {\n\treturn utf8.ValidString(s) && utf8.RuneCountInString(s) >= 2 && utf8.RuneCountInString(s) <= 200\n}\nfunc governanceLog(ctx context.Context, tx *sql.Tx, p ports.Principal, action string, cid, target, item ports.ID, version ports.ID, reason string) error {\n\t_, err := tx.ExecContext(ctx, `INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,conversation_id,target_id,item_id,target_version,reason,created_at) VALUES(?,?,?,?,?,?,?,?,?,UTC_TIMESTAMP(6))`, p.Kind, string(p.ActorID), bindingFor(p.Environment, p), action, nullableID(cid), nullableID(target), nullableID(item), nullableID(version), reason)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) commit(tx *sql.Tx, p ports.Principal) error {\n\tif !time.Now().Before(p.ExpiresAt) {\n\t\treturn auth.ErrUnauthorized\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\ntype AuditConversation struct {\n\tID       ports.ID  `json:\"conversation_id\"`\n\tOrderID  ports.ID  `json:\"order_id\"`\n\tActivity time.Time `json:\"activity_at\"`\n}\ntype AuditList struct {\n\tItems  []AuditConversation `json:\"items\"`\n\tCursor string              `json:\"next_cursor,omitempty\"`\n\tMore   bool                `json:\"has_more\"`\n}\ntype auditCursor struct {\n\tSnapshot string    `json:\"snapshot\"`\n\tAt       time.Time `json:\"at\"`\n\tAfter    ports.ID  `json:\"after\"`\n}\n\n// Materialize only IDs/activity in one DB statement, never message history.\n// Subsequent message activity cannot move a row across snapshot pages.\nfunc (g *GovernanceService) AuditList(ctx context.Context, p ports.Principal, token string, limit int) (AuditList, error) {\n\tif limit == 0 {\n\t\tlimit = 20\n\t}\n\tif limit < 1 || limit > 50 {\n\t\treturn AuditList{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, 3*g.base.timeout)\n\tdefer cancel()\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn AuditList{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\tvar c auditCursor\n\tbinding := bindingFor(g.environment, p)\n\tif token == \"\" {\n\t\t// Serialize snapshot quota by live source authority, without member state.\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_audit_accounts(binding,updated_at) VALUES(?,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE updated_at=VALUES(updated_at)`, binding); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tvar n int\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_audit_snapshots WHERE binding=? AND expires_at>UTC_TIMESTAMP(6)`, binding).Scan(&n) != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tif n >= 3 {\n\t\t\treturn AuditList{}, ports.ErrBusy\n\t\t}\n\t\tvar b [32]byte\n\t\tif _, err = rand.Read(b[:]); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tc.Snapshot = hex.EncodeToString(b[:])\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_audit_snapshots(id,binding,expires_at) VALUES(?,?,UTC_TIMESTAMP(6)+INTERVAL 10 MINUTE)`, c.Snapshot, binding); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_audit_snapshot_items(snapshot_id,conversation_id,order_id,activity_at) SELECT ?,id,order_id,COALESCE(last_message_at,created_at) FROM chat_conversations WHERE conversation_type='order'`, c.Snapshot); err != nil {\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t} else {\n\t\tif err = g.decodeAuditCursor(token, p, &c); err != nil {\n\t\t\treturn AuditList{}, err\n\t\t}\n\t}\n\t_ = c\n\treturn g.auditListPage(ctx, tx, p, token, limit, c)\n}\n\ntype ReminderSummary struct {\n\tID           ports.ID  `json:\"cluster_id\"`\n\tConversation ports.ID  `json:\"conversation_id\"`\n\tRecipient    ports.ID  `json:\"recipient_id\"`\n\tFirstDue     time.Time `json:\"first_due_at\"`\n\tTarget       ports.ID  `json:\"target_seq\"`\n\tLastNotified ports.ID  `json:\"last_notified_seq\"`\n\tRounds       int       `json:\"successful_rounds\"`\n\tState        string    `json:\"state\"`\n\tDiagnostic   string    `json:\"diagnostic\"`\n}\n\nfunc (g *GovernanceService) ReminderSummaries(ctx context.Context, p ports.Principal, after ports.ID) ([]ReminderSummary, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn nil, err\n\t}\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(c.id AS CHAR),CAST(c.conversation_id AS CHAR),CAST(c.recipient_id AS CHAR),c.first_due_at,CAST(c.target_seq AS CHAR),CAST(c.last_notified_seq AS CHAR),c.rounds,c.state,COALESCE(c.blocked_reason,(SELECT i.diagnostic FROM chat_reminder_intents i WHERE i.cluster_id=c.id AND i.round_version=c.round_version ORDER BY i.id DESC LIMIT 1),'') FROM chat_reminder_clusters c WHERE c.id>? AND c.first_due_at<=UTC_TIMESTAMP(6) ORDER BY c.id LIMIT 20`, string(after))\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tout := []ReminderSummary{}\n\tfor rows.Next() {\n\t\tvar v ReminderSummary\n\t\tif rows.Scan(&v.ID, &v.Conversation, &v.Recipient, &v.FirstDue, &v.Target, &v.LastNotified, &v.Rounds, &v.State, &v.Diagnostic) != nil {\n\t\t\trows.Close()\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tout = append(out, v)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn nil, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"reminders.summary\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\treturn nil, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn nil, err\n\t}\n\treturn out, nil\n}\n","chat/internal/message/audit_list.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\nfunc (g *GovernanceService) encodeAuditCursor(p ports.Principal, c auditCursor) (string, error) {\n\ta, err := g.history.digestAEAD()\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\traw, _ := json.Marshal(c)\n\tnonce := make([]byte, a.NonceSize())\n\tif _, err = rand.Read(nonce); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn base64.RawURLEncoding.EncodeToString(append(nonce, a.Seal(nil, nonce, raw, []byte(\"audit:\"+bindingFor(g.environment, p)))...)), nil\n}\nfunc (g *GovernanceService) decodeAuditCursor(token string, p ports.Principal, c *auditCursor) error {\n\tif len(token) > 1024 {\n\t\treturn ErrResync\n\t}\n\tb, err := base64.RawURLEncoding.Strict().DecodeString(token)\n\tif err != nil {\n\t\treturn ErrResync\n\t}\n\ta, err := g.history.digestAEAD()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif len(b) < a.NonceSize()+a.Overhead() {\n\t\treturn ErrResync\n\t}\n\traw, err := a.Open(nil, b[:a.NonceSize()], b[a.NonceSize():], []byte(\"audit:\"+bindingFor(g.environment, p)))\n\tif err != nil || json.Unmarshal(raw, c) != nil || len(c.Snapshot) != 64 || !validID(c.After) || c.At.IsZero() {\n\t\treturn ErrResync\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) auditListPage(ctx context.Context, tx *sql.Tx, p ports.Principal, token string, limit int, c auditCursor) (AuditList, error) {\n\tvar live bool\n\tif tx.QueryRowContext(ctx, `SELECT expires_at>UTC_TIMESTAMP(6) FROM chat_audit_snapshots WHERE id=? AND binding=? LOCK IN SHARE MODE`, c.Snapshot, bindingFor(g.environment, p)).Scan(&live) != nil || !live {\n\t\treturn AuditList{}, ErrResync\n\t}\n\tquery := `SELECT CAST(conversation_id AS CHAR),CAST(order_id AS CHAR),activity_at FROM chat_audit_snapshot_items WHERE snapshot_id=?`\n\targs := []any{c.Snapshot}\n\tif token != \"\" {\n\t\tquery += ` AND (activity_at<? OR (activity_at=? AND conversation_id<?))`\n\t\targs = append(args, c.At, c.At, string(c.After))\n\t}\n\tquery += ` ORDER BY activity_at DESC,conversation_id DESC LIMIT ?`\n\targs = append(args, limit+1)\n\trows, err := tx.QueryContext(ctx, query, args...)\n\tif err != nil {\n\t\treturn AuditList{}, ports.ErrUnavailable\n\t}\n\tout := AuditList{Items: []AuditConversation{}}\n\tfor rows.Next() {\n\t\tvar item AuditConversation\n\t\tif rows.Scan(&item.ID, &item.OrderID, &item.Activity) != nil {\n\t\t\trows.Close()\n\t\t\treturn AuditList{}, ports.ErrUnavailable\n\t\t}\n\t\tout.Items = append(out.Items, item)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn AuditList{}, ports.ErrUnavailable\n\t}\n\tif len(out.Items) > limit {\n\t\tout.More = true\n\t\tout.Items = out.Items[:limit]\n\t\tlast := out.Items[len(out.Items)-1]\n\t\tc.At = last.Activity\n\t\tc.After = last.ID\n\t\tout.Cursor, err = g.encodeAuditCursor(p, c)\n\t\tif err != nil {\n\t\t\treturn AuditList{}, err\n\t\t}\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.list\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn AuditList{}, err\n\t}\n\treturn out, nil\n}\n\n// Explicit bounded maintenance; snapshot expiration never reorders a live page.\nfunc (g *GovernanceService) CleanupSnapshots(ctx context.Context) error {\n\t_, err := g.base.db.ExecContext(ctx, `DELETE FROM chat_audit_snapshots WHERE expires_at<=UTC_TIMESTAMP(6) ORDER BY expires_at LIMIT 10`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/audit_history.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Audit history has its own scope and cursor namespace. It never invokes\n// member bootstrap, read acknowledgements, presence or personal preferences.\nfunc (g *GovernanceService) AuditHistory(ctx context.Context, p ports.Principal, q HistoryRequest) (HistoryPage, error) {\n\tif !validID(q.ConversationID) || q.Limit < 0 || q.Limit > 50 || q.TargetID != \"\" && !validID(q.TargetID) || q.TargetID != \"\" && q.Cursor != \"\" {\n\t\treturn HistoryPage{}, ports.ErrInvalid\n\t}\n\tctx, cancel := context.WithTimeout(ctx, g.base.timeout)\n\tdefer cancel()\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn HistoryPage{}, err\n\t}\n\tvar seq, change, floor uint64\n\tvar version ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT last_seq,last_change_seq,sync_floor_seq,CAST(policy_version AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`, string(q.ConversationID)).Scan(&seq, &change, &floor, &version) != nil {\n\t\treturn HistoryPage{}, ErrResync\n\t}\n\tc := historyCursor{Schema: 1, Mode: \"audit.history\", Binding: bindingFor(g.environment, p), Conversation: q.ConversationID, Policy: version, Member: \"audit\", Seq: decimal(seq), Change: decimal(change), Position: decimal(seq), Issued: time.Now().Unix(), Expiry: time.Now().Add(cursorTTL).Unix()}\n\tif q.Cursor != \"\" {\n\t\tc, err = g.history.parse(q.Cursor, \"audit.history\")\n\t\tif err != nil || c.Binding != bindingFor(g.environment, p) || c.Conversation != q.ConversationID || number(c.Seq) > seq || number(c.Position) < floor {\n\t\t\treturn HistoryPage{}, ErrResync\n\t\t}\n\t}\n\tlimit := q.Limit\n\tif limit == 0 {\n\t\tlimit = 30\n\t}\n\tout := HistoryPage{MemberRole: \"audit\", CanSend: false, ViewerID: p.ActorID, Messages: []MessageView{}, Changes: []ChangeView{}, PolicyVersion: version, SnapshotMaxSeq: c.Seq, SnapshotMaxChange: c.Change, ExpiresAt: c.Expiry}\n\tquery := `SELECT ` + viewColumns + `,1 FROM chat_messages m WHERE m.conversation_id=? AND m.seq>? AND m.seq<=? AND m.seq<=? ORDER BY m.seq DESC LIMIT ?`\n\tpos := number(c.Position)\n\tif q.TargetID != \"\" {\n\t\tvar target uint64\n\t\tif tx.QueryRowContext(ctx, `SELECT seq FROM chat_messages WHERE conversation_id=? AND id=? AND seq>? AND seq<=?`, string(q.ConversationID), string(q.TargetID), floor, seq).Scan(&target) != nil {\n\t\t\treturn HistoryPage{}, ErrResync\n\t\t}\n\t\tpos = target + uint64(limit/2)\n\t\tif pos > seq {\n\t\t\tpos = seq\n\t\t}\n\t}\n\trows, err := tx.QueryContext(ctx, query, string(q.ConversationID), floor, string(c.Seq), pos, limit+1)\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tfor rows.Next() {\n\t\tv, e := scanCandidate(rows, false)\n\t\tif e != nil {\n\t\t\trows.Close()\n\t\t\treturn out, e\n\t\t}\n\t\tout.Messages = append(out.Messages, v.view)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif len(out.Messages) > limit {\n\t\tout.HasMore = true\n\t\tout.Messages = out.Messages[:limit]\n\t\tc.Position = decimal(number(out.Messages[len(out.Messages)-1].Seq) - 1)\n\t\tout.HistoryCursor = g.history.sign(c)\n\t}\n\tfor i, j := 0, len(out.Messages)-1; i < j; i, j = i+1, j-1 {\n\t\tout.Messages[i], out.Messages[j] = out.Messages[j], out.Messages[i]\n\t}\n\tviews := make([]*MessageView, 0, len(out.Messages))\n\tfor i := range out.Messages {\n\t\tviews = append(views, &out.Messages[i])\n\t}\n\tif err = hydrateImages(ctx, tx, views); err != nil {\n\t\treturn out, err\n\t}\n\tif err = hydrateReferenceScope(ctx, tx, p, ports.Grant{}, q.ConversationID, views, true); err != nil {\n\t\treturn out, err\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.history\", q.ConversationID, q.TargetID, \"\", version, \"\"); err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) AuditImage(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, thumb bool) (string, error) {\n\tif g.media == nil || !validID(cid) || !validID(mid) || !validID(item) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:audit\"); err != nil {\n\t\treturn \"\", err\n\t}\n\tvar id ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? AND conversation_type='order' LOCK IN SHARE MODE`, string(cid)).Scan(&id) != nil {\n\t\treturn \"\", ErrResync\n\t}\n\tcol := \"u.main_key\"\n\tif thumb {\n\t\tcol = \"u.thumb_key\"\n\t}\n\tvar key string\n\tvar version ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT `+col+`,CAST(m.state_version AS CHAR) FROM chat_messages m JOIN chat_image_items i ON i.message_id=m.id JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE m.conversation_id=? AND m.id=? AND i.item_id=? AND m.state='published' AND `+retainedTarget, string(cid), string(mid), string(item)).Scan(&key, &version) != nil || key == \"\" {\n\t\treturn \"\", ErrMedia\n\t}\n\turl, err := g.media.storage.Sign(ctx, key, 60*time.Second)\n\tif err != nil {\n\t\treturn \"\", ErrMedia\n\t}\n\tif err = governanceLog(ctx, tx, p, \"audit.image\", cid, mid, item, version, \"\"); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn url, nil\n}\n","chat/internal/message/restrictions.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Restriction struct {\n\tActor          ports.ID   `json:\"actor_id\"`\n\tVersion        ports.ID   `json:\"version\"`\n\tPermanent      bool       `json:\"permanent\"`\n\tUntil          *time.Time `json:\"blocked_until,omitempty\"`\n\tBlocked        bool       `json:\"blocked\"`\n\tConfirmedRisks uint64     `json:\"confirmed_risks\"`\n}\ntype RestrictionRequest struct {\n\tActor    ports.ID `json:\"actor_id\"`\n\tExpected ports.ID `json:\"expected_version\"`\n\tAction   string   `json:\"action\"`\n\tSeconds  int      `json:\"seconds,omitempty\"`\n\tReason   string   `json:\"reason\"`\n}\n\nfunc restrictionLocked(ctx context.Context, tx *sql.Tx, id ports.ID) (Restriction, error) {\n\tif _, err := tx.ExecContext(ctx, `INSERT INTO chat_restrictions(actor_id,version,updated_at) VALUES(?,0,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE actor_id=actor_id`, string(id)); err != nil {\n\t\treturn Restriction{}, ports.ErrUnavailable\n\t}\n\tout := Restriction{Actor: id}\n\tvar until sql.NullTime\n\tif tx.QueryRowContext(ctx, `SELECT CAST(version AS CHAR),permanent,blocked_until,(permanent=1 OR blocked_until>UTC_TIMESTAMP(6)) IS TRUE FROM chat_restrictions WHERE actor_id=? FOR UPDATE`, string(id)).Scan(&out.Version, &out.Permanent, &until, &out.Blocked) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif until.Valid {\n\t\tv := until.Time\n\t\tout.Until = &v\n\t}\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_risk_events WHERE sender_id=? AND confirmed=1 AND review_state<>'corrected'`, string(id)).Scan(&out.ConfirmedRisks) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) Restriction(ctx context.Context, p ports.Principal, actor ports.ID) (Restriction, error) {\n\tif !validID(actor) {\n\t\treturn Restriction{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tdefer tx.Rollback()\n\tif p.Kind == \"mini\" && p.ActorID == actor && p.Environment == g.environment {\n\t\terr = g.source.ValidatePrincipalLocked(ctx, tx, p)\n\t} else {\n\t\terr = g.admin(ctx, tx, p, \"chat:moderate\")\n\t}\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tout, err := restrictionLocked(ctx, tx, actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\nfunc (g *GovernanceService) Restrict(ctx context.Context, p ports.Principal, q RestrictionRequest) (Restriction, error) {\n\tif !validID(q.Actor) || !q.Expected.Valid() || !reasonValid(q.Reason) || q.Action != \"unban\" && q.Action != \"permanent\" && q.Action != \"timed\" || q.Action == \"timed\" && (q.Seconds < 60 || q.Seconds > 30*86400) || q.Action != \"timed\" && q.Seconds != 0 {\n\t\treturn Restriction{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:moderate\"); err != nil {\n\t\treturn Restriction{}, err\n\t}\n\tvar actor ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM users WHERE id=? LOCK IN SHARE MODE`, string(q.Actor)).Scan(&actor) != nil {\n\t\treturn Restriction{}, auth.ErrUnauthorized\n\t}\n\tout, err := restrictionLocked(ctx, tx, q.Actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif out.Version != q.Expected {\n\t\treturn out, ErrPreferenceConflict\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET permanent=?,blocked_until=IF(?='timed',TIMESTAMPADD(SECOND,?,UTC_TIMESTAMP(6)),NULL),version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, q.Action == \"permanent\", q.Action, q.Seconds, string(q.Actor)); err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"restriction.\"+q.Action, \"\", q.Actor, \"\", decimal(number(out.Version)+1), q.Reason); err != nil {\n\t\treturn out, err\n\t}\n\tout, err = restrictionLocked(ctx, tx, q.Actor)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n\n// Ban expiry uses the permanent stable row, exactly as send and manual unban.\nfunc (g *GovernanceService) ExpireRestrictions(ctx context.Context) error {\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\trows, err := tx.QueryContext(ctx, `SELECT CAST(actor_id AS CHAR) FROM chat_restrictions WHERE permanent=0 AND blocked_until<=UTC_TIMESTAMP(6) ORDER BY actor_id LIMIT 50 FOR UPDATE`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,target_id,target_version,reason,created_at) SELECT 'system',0,REPEAT('0',64),'restriction.expire',actor_id,version+1,'限时禁聊到期',UTC_TIMESTAMP(6) FROM chat_restrictions WHERE actor_id=?`, string(id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","chat/internal/message/cases.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Case struct {\n\tID            ports.ID  `json:\"case_id\"`\n\tKind          string    `json:\"kind\"`\n\tTargetType    string    `json:\"target_type\"`\n\tTarget        ports.ID  `json:\"target_id\"`\n\tItem          ports.ID  `json:\"item_id\"`\n\tConversation  ports.ID  `json:\"conversation_id\"`\n\tReporter      ports.ID  `json:\"reporter_id\"`\n\tSubject       ports.ID  `json:\"subject_id\"`\n\tVersion       ports.ID  `json:\"version\"`\n\tState         string    `json:\"state\"`\n\tReason        string    `json:\"reason\"`\n\tResolution    string    `json:\"resolution\"`\n\tCreated       time.Time `json:\"created_at\"`\n\tFingerprint   string    `json:\"fingerprint\"`\n\tTargetVersion ports.ID  `json:\"target_version\"`\n}\n\nconst caseColumns = `CAST(id AS CHAR),kind,target_type,CAST(target_id AS CHAR),CAST(item_id AS CHAR),CAST(conversation_id AS CHAR),CAST(reporter_id AS CHAR),CAST(subject_id AS CHAR),CAST(version AS CHAR),state,reason,COALESCE(resolution,''),created_at,fingerprint,CAST(target_version AS CHAR)`\n\ntype CasePage struct {\n\tItems []Case   `json:\"items\"`\n\tAfter ports.ID `json:\"next_after\"`\n\tMore  bool     `json:\"has_more\"`\n}\n\nfunc scanCase(row interface{ Scan(...any) error }) (Case, error) {\n\tvar c Case\n\terr := row.Scan(&c.ID, &c.Kind, &c.TargetType, &c.Target, &c.Item, &c.Conversation, &c.Reporter, &c.Subject, &c.Version, &c.State, &c.Reason, &c.Resolution, &c.Created, &c.Fingerprint, &c.TargetVersion)\n\tif err != nil {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\treturn c, nil\n}\nfunc createCase(ctx context.Context, tx *sql.Tx, kind, targetType string, target, item, cid, reporter, subject, version ports.ID, fp, reason string) (ports.ID, error) {\n\tvar id ports.ID\n\terr := tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_cases WHERE kind=? AND target_type=? AND target_id=? AND item_id=? AND reporter_id=? AND (kind<>'appeal' OR target_version=?)`, kind, targetType, string(target), string(item), string(reporter), string(version)).Scan(&id)\n\tif err == nil {\n\t\treturn id, nil\n\t}\n\tif err != sql.ErrNoRows {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tvar n int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_cases WHERE reporter_id=? AND kind<>'review' AND created_at>UTC_TIMESTAMP()-INTERVAL 1 DAY`, string(reporter)).Scan(&n) != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif n >= 20 && kind != \"review\" {\n\t\treturn \"\", ports.ErrBusy\n\t}\n\tr, err := tx.ExecContext(ctx, `INSERT INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,'pending',1,UTC_TIMESTAMP(6)+INTERVAL 30 DAY,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE id=LAST_INSERT_ID(id)`, kind, targetType, string(target), string(item), string(cid), string(reporter), string(subject), string(version), fp, reason)\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tn64, err := r.LastInsertId()\n\tif err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\treturn decimal(uint64(n64)), nil\n}\nfunc (g *GovernanceService) Report(ctx context.Context, p ports.Principal, cid, mid, item ports.ID, reason string) (ports.ID, error) {\n\tif !validID(cid) || !validID(mid) || item != \"\" && !validID(item) || !reasonValid(reason) {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\tif item == \"\" {\n\t\titem = \"0\"\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tauthority, err := g.base.conversations.LockAuthority(ctx, tx, ports.PolicyRequest{Actor: p, ConversationID: cid, Action: \"read\"})\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif _, err = restrictionLocked(ctx, tx, p.ActorID); err != nil {\n\t\treturn \"\", err\n\t}\n\tgrant, err := g.base.conversations.LockProjection(ctx, tx, authority)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tvar subject, version ports.ID\n\tvar fp string\n\tif tx.QueryRowContext(ctx, `SELECT CAST(m.sender_id AS CHAR),CAST(m.state_version AS CHAR),SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.conversation_id=? AND m.id=? AND `+retainedTarget+` AND `+visibleColumn, string(cid), string(mid), string(grant.Version), string(p.ActorID)).Scan(&subject, &version, &fp) != nil {\n\t\treturn \"\", ErrResync\n\t}\n\tif item != \"0\" {\n\t\tvar n int\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_image_items WHERE message_id=? AND item_id=?`, string(mid), string(item)).Scan(&n) != nil || n != 1 {\n\t\t\treturn \"\", ErrMedia\n\t\t}\n\t}\n\tid, err := createCase(ctx, tx, \"report\", \"message\", mid, item, cid, p.ActorID, subject, version, fp, reason)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads u JOIN chat_image_items i ON i.item_id=u.id SET u.legal_hold=1 WHERE i.message_id=?`, string(mid)); err != nil {\n\t\treturn \"\", ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.report\", cid, id, item, version, reason); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn id, nil\n}\nfunc (g *GovernanceService) Appeal(ctx context.Context, p ports.Principal, targetType string, target, expected ports.ID, reason string) (ports.ID, error) {\n\tif !validID(target) || !expected.Valid() || !reasonValid(reason) || targetType != \"risk\" && targetType != \"image_intent\" && targetType != \"restriction\" || p.Environment != g.environment {\n\t\treturn \"\", ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.source.ValidatePrincipalLocked(ctx, tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\tstatus, err := restrictionLocked(ctx, tx, p.ActorID)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tcid, subject, version, fp := ports.ID(\"0\"), p.ActorID, ports.ID(\"1\"), \"\"\n\tswitch targetType {\n\tcase \"risk\":\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),content_fingerprint FROM chat_risk_events WHERE id=? AND sender_id=? AND retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`, string(target), string(p.ActorID)).Scan(&cid, &fp) != nil {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\tcase \"image_intent\":\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(i.conversation_id AS CHAR),b.manifest_hash,CAST(b.review_version AS CHAR) FROM chat_send_intents i JOIN chat_image_bundles b ON b.intent_id=i.id WHERE i.id=? AND i.sender_id=? AND i.state='rejected' AND i.retain_until>UTC_TIMESTAMP(6) LOCK IN SHARE MODE`, string(target), string(p.ActorID)).Scan(&cid, &fp, &version) != nil {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\tcase \"restriction\":\n\t\tif target != p.ActorID || status.Version != expected || !status.Blocked {\n\t\t\treturn \"\", ErrResync\n\t\t}\n\t\tversion = status.Version\n\t\tfp = memberHash(string(p.ActorID) + \":\" + string(version))\n\t}\n\tif targetType != \"restriction\" && version != expected {\n\t\treturn \"\", ErrResync\n\t}\n\tid, err := createCase(ctx, tx, \"appeal\", targetType, target, \"0\", cid, p.ActorID, subject, version, fp, reason)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif targetType == \"risk\" {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET retain_until=GREATEST(retain_until,UTC_TIMESTAMP(6)+INTERVAL 30 DAY) WHERE id=?`, string(target)); err != nil {\n\t\t\treturn \"\", ports.ErrUnavailable\n\t\t}\n\t}\n\tif targetType == \"image_intent\" {\n\t\titems, e := caseImageItems(ctx, tx, Case{TargetType: targetType, Target: target, Fingerprint: fp})\n\t\tif e != nil {\n\t\t\treturn \"\", e\n\t\t}\n\t\tfor _, v := range items {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads SET legal_hold=1 WHERE id=? AND actor_id=? AND conversation_id=?`, string(v.ItemID), string(p.ActorID), string(cid)); err != nil {\n\t\t\t\treturn \"\", ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.appeal\", cid, id, \"\", version, reason); err != nil {\n\t\treturn \"\", err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn id, nil\n}\nfunc (g *GovernanceService) Cases(ctx context.Context, p ports.Principal, after ports.ID, admin bool) (CasePage, error) {\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\tif !after.Valid() {\n\t\treturn CasePage{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn CasePage{}, err\n\t}\n\tdefer tx.Rollback()\n\tif admin {\n\t\terr = g.admin(ctx, tx, p, \"chat:moderate\")\n\t} else if p.Environment == g.environment {\n\t\terr = g.source.ValidatePrincipalLocked(ctx, tx, p)\n\t} else {\n\t\terr = ports.ErrInvalid\n\t}\n\tif err != nil {\n\t\treturn CasePage{}, err\n\t}\n\tquery := `SELECT ` + caseColumns + ` FROM chat_cases WHERE id>?`\n\targs := []any{string(after)}\n\tif !admin {\n\t\tquery += ` AND reporter_id=?`\n\t\targs = append(args, string(p.ActorID))\n\t}\n\tquery += ` ORDER BY id LIMIT 21`\n\trows, err := tx.QueryContext(ctx, query, args...)\n\tif err != nil {\n\t\treturn CasePage{}, ports.ErrUnavailable\n\t}\n\tout := CasePage{Items: []Case{}, After: after}\n\tfor rows.Next() {\n\t\tc, e := scanCase(rows)\n\t\tif e != nil {\n\t\t\trows.Close()\n\t\t\treturn out, e\n\t\t}\n\t\tif !admin {\n\t\t\tc.Fingerprint = \"\"\n\t\t\tc.Subject = \"0\"\n\t\t}\n\t\tout.Items = append(out.Items, c)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif len(out.Items) > 20 {\n\t\tout.More = true\n\t\tout.Items = out.Items[:20]\n\t}\n\tif len(out.Items) > 0 {\n\t\tout.After = out.Items[len(out.Items)-1].ID\n\t}\n\tif admin {\n\t\tif err = governanceLog(ctx, tx, p, \"case.list\", \"\", \"\", \"\", \"\", \"\"); err != nil {\n\t\t\treturn out, err\n\t\t}\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n","chat/internal/message/case_review.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype Evidence struct {\n\tCase        Case        `json:\"case\"`\n\tText        *string     `json:\"text,omitempty\"`\n\tContext     *string     `json:\"context,omitempty\"`\n\tItems       []ImageView `json:\"items\"`\n\tUnavailable bool        `json:\"unavailable\"`\n\tURL         string      `json:\"url,omitempty\"`\n}\n\nfunc (g *GovernanceService) caseLock(ctx context.Context, tx *sql.Tx, id ports.ID) (Case, error) {\n\tvar cid, subject ports.ID\n\tif tx.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),CAST(subject_id AS CHAR) FROM chat_cases WHERE id=?`, string(id)).Scan(&cid, &subject) != nil {\n\t\treturn Case{}, ErrResync\n\t}\n\t// Same actor -> conversation order used by send, ban and publication.\n\tif _, err := restrictionLocked(ctx, tx, subject); err != nil {\n\t\treturn Case{}, err\n\t}\n\tif cid != \"0\" {\n\t\tvar found ports.ID\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id=? FOR UPDATE`, string(cid)).Scan(&found) != nil {\n\t\t\treturn Case{}, ErrResync\n\t\t}\n\t}\n\treturn scanCase(tx.QueryRowContext(ctx, `SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(id)))\n}\nfunc caseImageItems(ctx context.Context, tx *sql.Tx, c Case) ([]ImageView, error) {\n\titems := []ImageView{}\n\tif c.TargetType == \"message\" {\n\t\tquery := `SELECT CAST(i.item_id AS CHAR),i.ordinal,u.width_px,u.height_px FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=?`\n\t\targs := []any{string(c.Target)}\n\t\tif c.Item != \"0\" {\n\t\t\tquery += ` AND i.item_id=?`\n\t\t\targs = append(args, string(c.Item))\n\t\t}\n\t\tquery += ` ORDER BY i.ordinal LIMIT 9`\n\t\trows, err := tx.QueryContext(ctx, query, args...)\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tfor rows.Next() {\n\t\t\tvar v ImageView\n\t\t\tif rows.Scan(&v.ItemID, &v.Ordinal, &v.Width, &v.Height) != nil {\n\t\t\t\trows.Close()\n\t\t\t\treturn nil, ports.ErrUnavailable\n\t\t\t}\n\t\t\titems = append(items, v)\n\t\t}\n\t\terr = rows.Err()\n\t\trows.Close()\n\t\tif err != nil {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t} else if c.TargetType == \"image_intent\" {\n\t\tvar raw, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT manifest_json,manifest_hash FROM chat_image_bundles WHERE intent_id=?`, string(c.Target)).Scan(&raw, &fp) != nil || fp != c.Fingerprint {\n\t\t\treturn nil, ErrMediaVersion\n\t\t}\n\t\tvar q Request\n\t\tif json.Unmarshal([]byte(raw), &q) != nil || len(q.Items) < 1 || len(q.Items) > 9 {\n\t\t\treturn nil, ports.ErrUnavailable\n\t\t}\n\t\tfor _, v := range q.Items {\n\t\t\titems = append(items, ImageView{ItemID: v.AttachmentID, Ordinal: v.Ordinal})\n\t\t}\n\t}\n\treturn items, nil\n}\nfunc (g *GovernanceService) Evidence(ctx context.Context, p ports.Principal, id, expected, item ports.ID, reason string) (Evidence, error) {\n\tif !validID(id) || !validID(expected) || item != \"\" && !validID(item) || !reasonValid(reason) {\n\t\treturn Evidence{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:evidence\"); err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tc, err := g.caseLock(ctx, tx, id)\n\tif err != nil {\n\t\treturn Evidence{}, err\n\t}\n\tif c.Version != expected {\n\t\treturn Evidence{}, ErrMediaVersion\n\t}\n\tout := Evidence{Case: c, Items: []ImageView{}}\n\tswitch c.TargetType {\n\tcase \"risk\":\n\t\tvar text, context, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT text_evidence,context_evidence,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6)`, string(c.Target)).Scan(&text, &context, &fp) != nil || fp != c.Fingerprint {\n\t\t\tout.Unavailable = true\n\t\t} else {\n\t\t\tout.Text = &text\n\t\t\tout.Context = &context\n\t\t}\n\tcase \"message\":\n\t\tvar text sql.NullString\n\t\tvar fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT m.text_body,SHA2(CONCAT(m.id,':',m.client_message_id,':',m.safety_rule_version),256) FROM chat_messages m WHERE m.id=? AND m.conversation_id=? AND `+retainedTarget, string(c.Target), string(c.Conversation)).Scan(&text, &fp) != nil || fp != c.Fingerprint {\n\t\t\tout.Unavailable = true\n\t\t} else if text.Valid {\n\t\t\tout.Text = &text.String\n\t\t}\n\tcase \"restriction\":\n\t\tout.Unavailable = false\n\tcase \"image_intent\":\n\tdefault:\n\t\treturn out, ports.ErrInvalid\n\t}\n\tout.Items, err = caseImageItems(ctx, tx, c)\n\tif err != nil {\n\t\treturn out, err\n\t}\n\tif item != \"\" {\n\t\tfound := false\n\t\tfor _, v := range out.Items {\n\t\t\tif v.ItemID == item {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found || g.media == nil {\n\t\t\treturn out, ErrMedia\n\t\t}\n\t\tvar key string\n\t\tif c.TargetType == \"message\" {\n\t\t\terr = tx.QueryRowContext(ctx, `SELECT u.main_key FROM chat_image_items i JOIN chat_image_uploads u ON u.id=i.item_id AND u.object_version=i.object_version WHERE i.message_id=? AND i.item_id=?`, string(c.Target), string(item)).Scan(&key)\n\t\t} else {\n\t\t\tvar raw string\n\t\t\tif tx.QueryRowContext(ctx, `SELECT manifest_json FROM chat_image_bundles WHERE intent_id=?`, string(c.Target)).Scan(&raw) != nil {\n\t\t\t\treturn out, ErrMedia\n\t\t\t}\n\t\t\tvar q Request\n\t\t\tjson.Unmarshal([]byte(raw), &q)\n\t\t\tversion := \"\"\n\t\t\tfor _, v := range q.Items {\n\t\t\t\tif v.AttachmentID == item {\n\t\t\t\t\tversion = v.ObjectVersion\n\t\t\t\t}\n\t\t\t}\n\t\t\terr = tx.QueryRowContext(ctx, `SELECT main_key FROM chat_image_uploads WHERE id=? AND object_version=? AND legal_hold=1`, string(item), version).Scan(&key)\n\t\t}\n\t\tif err != nil || key == \"\" {\n\t\t\tout.Unavailable = true\n\t\t} else {\n\t\t\tout.URL, err = g.media.storage.Sign(ctx, key, 60*time.Second)\n\t\t\tif err != nil {\n\t\t\t\treturn out, ErrMedia\n\t\t\t}\n\t\t}\n\t}\n\taction := \"case.evidence\"\n\tif out.Unavailable {\n\t\taction = \"evidence.unavailable\"\n\t}\n\tif item != \"\" && out.URL == \"\" {\n\t\taction = \"evidence.unavailable\"\n\t}\n\tif err = governanceLog(ctx, tx, p, action, c.Conversation, c.ID, item, c.Version, reason); err != nil {\n\t\treturn out, err\n\t}\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn out, err\n\t}\n\treturn out, nil\n}\n\ntype CaseDecision struct {\n\tID       ports.ID `json:\"case_id\"`\n\tExpected ports.ID `json:\"expected_version\"`\n\tAction   string   `json:\"action\"`\n\tReason   string   `json:\"reason\"`\n}\n\nfunc (g *GovernanceService) Decide(ctx context.Context, p ports.Principal, q CaseDecision) (Case, error) {\n\tif !validID(q.ID) || !validID(q.Expected) || !reasonValid(q.Reason) || q.Action != \"confirm\" && q.Action != \"correct\" && q.Action != \"dismiss\" && q.Action != \"block\" {\n\t\treturn Case{}, ports.ErrInvalid\n\t}\n\ttx, err := g.base.begin(ctx)\n\tif err != nil {\n\t\treturn Case{}, err\n\t}\n\tdefer tx.Rollback()\n\tif err = g.admin(ctx, tx, p, \"chat:moderate\"); err != nil {\n\t\treturn Case{}, err\n\t}\n\tc, err := g.caseLock(ctx, tx, q.ID)\n\tif err != nil {\n\t\treturn c, err\n\t}\n\tif c.Version != q.Expected || c.State != \"pending\" {\n\t\treturn c, ErrMediaVersion\n\t}\n\tvar n int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id IS NULL AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`, p.Kind, string(p.ActorID), bindingFor(g.environment, p), string(c.ID), string(c.Version)).Scan(&n) != nil || n == 0 {\n\t\treturn c, ErrMedia\n\t}\n\t// A visible metadata list or thumbnail cannot satisfy full image evidence.\n\titems, err := caseImageItems(ctx, tx, c)\n\tif err != nil {\n\t\treturn c, err\n\t}\n\tfor _, v := range items {\n\t\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_governance_audit WHERE actor_kind=? AND actor_id=? AND session_binding=? AND action='case.evidence' AND target_id=? AND target_version=? AND item_id=? AND created_at>UTC_TIMESTAMP(6)-INTERVAL 10 MINUTE`, p.Kind, string(p.ActorID), bindingFor(g.environment, p), string(c.ID), string(c.Version), string(v.ItemID)).Scan(&n) != nil || n == 0 {\n\t\t\treturn c, ErrMedia\n\t\t}\n\t}\n\tswitch c.TargetType {\n\tcase \"risk\":\n\t\tvar riskState, fp string\n\t\tif tx.QueryRowContext(ctx, `SELECT review_state,content_fingerprint FROM chat_risk_events WHERE id=? AND retain_until>UTC_TIMESTAMP(6) FOR UPDATE`, string(c.Target)).Scan(&riskState, &fp) != nil || fp != c.Fingerprint {\n\t\t\treturn c, ErrResync\n\t\t}\n\t\tif riskState == \"corrected\" && q.Action == \"confirm\" {\n\t\t\treturn c, ErrMediaVersion\n\t\t}\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\tif q.Action == \"correct\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET confirmed=0,review_state='corrected' WHERE id=? AND content_fingerprint=?`, string(c.Target), c.Fingerprint); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t} else if q.Action == \"confirm\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET confirmed=1,review_state='confirmed' WHERE id=? AND content_fingerprint=? AND review_state<>'corrected'`, string(c.Target), c.Fingerprint); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tif q.Action == \"correct\" || q.Action == \"confirm\" {\n\t\t\tcode := \"CHAT_CONTENT_BLOCKED\"\n\t\t\tif q.Action == \"correct\" {\n\t\t\t\tcode = \"CHAT_REVIEW_CORRECTED\"\n\t\t\t}\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_send_intents SET state='rejected',error_code=?,updated_at=UTC_TIMESTAMP(6) WHERE risk_event_id=? AND state IN ('review_pending','rejected')`, code, string(c.Target)); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\t// No send-intent or message is resurrected by a successful appeal.\n\tcase \"restriction\":\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\tif q.Action == \"correct\" {\n\t\t\tr, err := restrictionLocked(ctx, tx, c.Subject)\n\t\t\tif err != nil {\n\t\t\t\treturn c, err\n\t\t\t}\n\t\t\tif r.Version != c.TargetVersion {\n\t\t\t\treturn c, ErrMediaVersion\n\t\t\t}\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_restrictions SET permanent=0,blocked_until=NULL,version=version+1,updated_at=UTC_TIMESTAMP(6) WHERE actor_id=?`, string(c.Subject)); err != nil {\n\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\tcase \"message\":\n\t\tif q.Action == \"block\" {\n\t\t\tvar state string\n\t\t\tvar version, seq uint64\n\t\t\tif tx.QueryRowContext(ctx, `SELECT state,state_version,seq FROM chat_messages WHERE id=? AND conversation_id=? FOR UPDATE`, string(c.Target), string(c.Conversation)).Scan(&state, &version, &seq) != nil {\n\t\t\t\treturn c, ErrResync\n\t\t\t}\n\t\t\tif state == \"published\" {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_conversations SET last_change_seq=last_change_seq+1 WHERE id=?`, string(c.Conversation)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_messages SET state='blocked',state_version=state_version+1 WHERE id=?`, string(c.Target)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT id,last_change_seq,?,?, 'message.blocked',UTC_TIMESTAMP(6) FROM chat_conversations WHERE id=?`, string(c.Target), version+1, string(c.Conversation)); err != nil {\n\t\t\t\t\treturn c, ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\tcase \"image_intent\":\n\t\tif q.Action == \"block\" {\n\t\t\treturn c, ports.ErrInvalid\n\t\t}\n\t\t// Only the governance result changes. Old rejected manifests stay rejected.\n\tdefault:\n\t\treturn c, ports.ErrInvalid\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_cases SET state=?,version=version+1,resolution=?,reviewer_id=?,decided_at=UTC_TIMESTAMP(6) WHERE id=?`, q.Action, q.Reason, string(p.ActorID), string(c.ID)); err != nil {\n\t\treturn c, ports.ErrUnavailable\n\t}\n\tif err = governanceLog(ctx, tx, p, \"case.\"+q.Action, c.Conversation, c.ID, c.Item, decimal(number(c.Version)+1), q.Reason); err != nil {\n\t\treturn c, err\n\t}\n\tc.State = q.Action\n\tc.Resolution = q.Reason\n\tc.Version = decimal(number(c.Version) + 1)\n\tif err = g.commit(tx, p); err != nil {\n\t\treturn c, err\n\t}\n\tif q.Action == \"block\" && g.base.publisher != nil {\n\t\tg.base.publisher.Committed(ports.CommittedMessage{ConversationID: c.Conversation})\n\t}\n\treturn c, nil\n}\n","chat/internal/policy/recipient.go":"package policy\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n)\n\n// Internal notification eligibility uses current PHP business authority and\n// account status. It does not fabricate a logged-in user or online presence.\nfunc (r *Reader) RecipientLocked(ctx context.Context, tx *sql.Tx, scope string, actor ports.ID) (Projection, ports.Grant, error) {\n\tp, err := r.CurrentLocked(ctx, tx, scope)\n\tif err != nil {\n\t\treturn p, ports.Grant{}, err\n\t}\n\tif err = r.CheckEpochsLocked(ctx, tx, p, actor, \"read\"); err != nil {\n\t\treturn p, ports.Grant{}, err\n\t}\n\tvar active bool\n\terr = tx.QueryRowContext(ctx, `SELECT status='active' FROM users WHERE id=? LOCK IN SHARE MODE`, string(actor)).Scan(&active)\n\tif err == sql.ErrNoRows {\n\t\treturn p, ports.Grant{}, ErrDenied\n\t}\n\tif err != nil {\n\t\treturn p, ports.Grant{}, ports.ErrUnavailable\n\t}\n\tif !active {\n\t\treturn p, ports.Grant{}, ErrDenied\n\t}\n\tfor _, m := range p.Members {\n\t\tif m.ActorID == actor && m.Grant.CanRead {\n\t\t\treturn p, m.Grant, nil\n\t\t}\n\t}\n\treturn p, ports.Grant{}, ErrDenied\n}\n","chat/internal/conversation/reminders.go":"package conversation\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Server-side only: not an impersonation API and never grants send permission.\nfunc (s *Store) RecipientLocked(ctx context.Context, tx *sql.Tx, cid, actor ports.ID) (ports.Grant, error) {\n\tif !positive(cid) || !positive(actor) {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tvar scope, kind string\n\tif tx.QueryRowContext(ctx, `SELECT scope_key,conversation_type FROM chat_conversations WHERE id=?`, string(cid)).Scan(&scope, &kind) != nil || kind != \"order\" {\n\t\treturn ports.Grant{}, policy.ErrDenied\n\t}\n\tprojection, grant, err := s.reader.RecipientLocked(ctx, tx, scope, actor)\n\tif err != nil {\n\t\treturn ports.Grant{}, err\n\t}\n\tauthority := &Authority{tx: tx, request: ports.PolicyRequest{Actor: ports.Principal{ActorID: actor, ExpiresAt: time.Now().Add(s.timeout)}, ConversationID: cid, Action: \"read\"}, projection: projection, grant: grant}\n\treturn s.LockProjection(ctx, tx, authority)\n}\n","chat/internal/message/reminders.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Publication persists only this wakeup; the worker may restart at any time.\nfunc reminderEvent(ctx context.Context, tx *sql.Tx, cid ports.ID, seq uint64) error {\n\t_, err := tx.ExecContext(ctx, `INSERT INTO chat_reminder_events(conversation_id,seq,created_at) VALUES(?,?,UTC_TIMESTAMP(6))`, string(cid), seq)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n\ntype ReminderConfig struct {\n\tFirstDelaySeconds                                              int\n\tRecipientHourly, RecipientDaily, PlatformHourly, PlatformDaily int\n}\n\nfunc DefaultReminderConfig() ReminderConfig { return ReminderConfig{10, 3, 10, 1000, 10000} }\nfunc (c ReminderConfig) Validate() error {\n\tif c.FirstDelaySeconds < 1 || c.FirstDelaySeconds > 30 || c.RecipientHourly < 1 || c.RecipientHourly > 100 || c.RecipientDaily < c.RecipientHourly || c.RecipientDaily > 1000 || c.PlatformHourly < c.RecipientHourly || c.PlatformHourly > 100000 || c.PlatformDaily < c.PlatformHourly || c.PlatformDaily > 1000000 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\ntype ReminderService struct {\n\tbase         *Service\n\tnotification ports.Notification\n\tconfig       ReminderConfig\n}\ntype reminderReceipts interface {\n\tStatus(context.Context, string) (ports.Receipt, error)\n}\n\nfunc NewReminderService(base *Service, n ports.Notification) (*ReminderService, error) {\n\tif base == nil || n == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderService{base, n, DefaultReminderConfig()}, nil\n}\nfunc (r *ReminderService) WithConfig(c ReminderConfig) (*ReminderService, error) {\n\tif c.Validate() != nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tcopy := *r\n\tcopy.config = c\n\treturn &copy, nil\n}\n\ntype reminderWindow struct {\n\tGrant         ports.Grant\n\tHash          string\n\tFirst, Target uint64\n\tRead          uint64\n\tAt            time.Time\n}\n\nfunc (r *ReminderService) window(ctx context.Context, tx *sql.Tx, cid, actor ports.ID, target uint64) (reminderWindow, error) {\n\tgrant, err := r.base.conversations.RecipientLocked(ctx, tx, cid, actor)\n\tif err != nil {\n\t\treturn reminderWindow{}, err\n\t}\n\tout := reminderWindow{Grant: grant, Hash: memberHash(grant.MemberKey)}\n\tif target == ^uint64(0) {\n\t\tif tx.QueryRowContext(ctx, `SELECT last_seq FROM chat_conversations WHERE id=?`, string(cid)).Scan(&target) != nil {\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t}\n\tvar hash string\n\terr = tx.QueryRowContext(ctx, `SELECT member_key_hash,read_seq FROM chat_member_reads WHERE conversation_id=? AND actor_id=? LOCK IN SHARE MODE`, string(cid), string(actor)).Scan(&hash, &out.Read)\n\tif err != nil && err != sql.ErrNoRows {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif hash != out.Hash {\n\t\tout.Read = 0\n\t}\n\tpredicate := `m.conversation_id=? AND m.sender_id<>? AND m.state='published' AND m.seq>? AND m.seq<=? AND ` + retainedTarget + ` AND ` + visibleColumn\n\targs := []any{string(cid), string(actor), out.Read, target, string(grant.Version), string(actor)}\n\terr = tx.QueryRowContext(ctx, `SELECT m.seq,m.created_at FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq LIMIT 1`, args...).Scan(&out.First, &out.At)\n\tif err == sql.ErrNoRows {\n\t\treturn out, nil\n\t}\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tif tx.QueryRowContext(ctx, `SELECT m.seq FROM chat_messages m WHERE `+predicate+` ORDER BY m.seq DESC LIMIT 1`, args...).Scan(&out.Target) != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\treturn out, nil\n}\n\n// DrainEvents is bounded and replay-safe. First due comes from the first\n// still-unread message, never from the time this process happens to wake up.\nfunc (r *ReminderService) DrainEvents(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),seq FROM chat_reminder_events WHERE processed_at IS NULL ORDER BY id LIMIT 50`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttype event struct {\n\t\tid, cid ports.ID\n\t\tseq     uint64\n\t}\n\tevents := []event{}\n\tfor rows.Next() {\n\t\tvar v event\n\t\tif rows.Scan(&v.id, &v.cid, &v.seq) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tevents = append(events, v)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, event := range events {\n\t\tactors, e := r.base.conversations.MemberCandidates(ctx, event.cid)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tfor _, actor := range actors {\n\t\t\ttx, e := r.base.begin(ctx)\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tw, e := r.window(ctx, tx, event.cid, actor, event.seq)\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\tif errors.Is(e, policy.ErrDenied) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tif w.First > 0 {\n\t\t\t\t_, e = tx.ExecContext(ctx, `INSERT INTO chat_reminder_clusters(conversation_id,recipient_id,member_hash,round_version,first_seq,target_seq,first_due_at,next_due,rounds,state,created_at) VALUES(?,?,?,1,?,?,TIMESTAMPADD(SECOND,?,?),TIMESTAMPADD(SECOND,?,?),0,'open',UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE round_version=IF(state='closed' OR ? >= target_seq,round_version+1,round_version),first_seq=IF(state='closed' OR ? >= target_seq,VALUES(first_seq),LEAST(first_seq,VALUES(first_seq))),first_due_at=IF(state='closed' OR ? >= target_seq,VALUES(first_due_at),first_due_at),first_notified_at=IF(state='closed' OR ? >= target_seq,NULL,first_notified_at),next_due=IF(state='closed' OR ? >= target_seq,VALUES(next_due),next_due),rounds=IF(state='closed' OR ? >= target_seq,0,rounds),target_seq=GREATEST(target_seq,VALUES(target_seq)),state=IF(state='exhausted' AND rounds>=3,'exhausted','open')`, string(event.cid), string(actor), w.Hash, w.First, w.Target, r.config.FirstDelaySeconds, w.At, r.config.FirstDelaySeconds, w.At, w.Read, w.Read, w.Read, w.Read, w.Read, w.Read)\n\t\t\t}\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\tif tx.Commit() != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tif _, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_events SET processed_at=UTC_TIMESTAMP(6) WHERE id=?`, string(event.id)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\n","chat/internal/message/reminder_rounds.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"database/sql\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\ntype reminderCluster struct {\n\tID, CID, Actor ports.ID\n\tHash           string\n\tVersion        uint64\n\tRound          int\n\tTarget         uint64\n}\n\nfunc (r *ReminderService) Prepare(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_clusters WHERE state='open' AND next_due<=UTC_TIMESTAMP(6) ORDER BY next_due,id LIMIT 50`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tcandidates := []reminderCluster{}\n\tfor rows.Next() {\n\t\tvar c reminderCluster\n\t\tif rows.Scan(&c.ID, &c.CID, &c.Actor, &c.Hash) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tcandidates = append(candidates, c)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, c := range candidates {\n\t\tif err = r.prepareOne(ctx, c); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) reserveBudget(ctx context.Context, tx *sql.Tx, actor ports.ID) (bool, error) {\n\tnow := time.Now().UTC()\n\tfor _, id := range []ports.ID{\"0\", actor} {\n\t\tif _, err := tx.ExecContext(ctx, `INSERT INTO chat_reminder_budgets(recipient_id,hour_start,hour_count,day_start,day_count) VALUES(?,UTC_TIMESTAMP(),0,UTC_DATE(),0) ON DUPLICATE KEY UPDATE recipient_id=recipient_id`, string(id)); err != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t\tvar hourly, daily int\n\t\tvar hour, day time.Time\n\t\tif tx.QueryRowContext(ctx, `SELECT hour_start,hour_count,day_start,day_count FROM chat_reminder_budgets WHERE recipient_id=? FOR UPDATE`, string(id)).Scan(&hour, &hourly, &day, &daily) != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t\tif now.Sub(hour) >= time.Hour {\n\t\t\thour = now\n\t\t\thourly = 0\n\t\t}\n\t\tif day.Format(\"2006-01-02\") != now.Format(\"2006-01-02\") {\n\t\t\tday = now\n\t\t\tdaily = 0\n\t\t}\n\t\th, d := r.config.RecipientHourly, r.config.RecipientDaily\n\t\tif id == \"0\" {\n\t\t\th = r.config.PlatformHourly\n\t\t\td = r.config.PlatformDaily\n\t\t}\n\t\tif hourly >= h || daily >= d {\n\t\t\treturn false, nil\n\t\t}\n\t\tif _, err := tx.ExecContext(ctx, `UPDATE chat_reminder_budgets SET hour_start=?,hour_count=?,day_start=?,day_count=? WHERE recipient_id=?`, hour, hourly+1, day.Format(\"2006-01-02\"), daily+1, string(id)); err != nil {\n\t\t\treturn false, ports.ErrUnavailable\n\t\t}\n\t}\n\treturn true, nil\n}\nfunc (r *ReminderService) prepareOne(ctx context.Context, c reminderCluster) error {\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\tw, err := r.window(ctx, tx, c.CID, c.Actor, ^uint64(0))\n\tif err != nil && !errors.Is(err, policy.ErrDenied) {\n\t\treturn err\n\t}\n\tdenied := errors.Is(err, policy.ErrDenied)\n\tvar state string\n\tvar due bool\n\tif tx.QueryRowContext(ctx, `SELECT round_version,rounds,target_seq,state,next_due<=UTC_TIMESTAMP(6) FROM chat_reminder_clusters WHERE id=? FOR UPDATE`, string(c.ID)).Scan(&c.Version, &c.Round, &c.Target, &state, &due) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif state != \"open\" || !due {\n\t\treturn nil\n\t}\n\tif denied || w.First == 0 || w.Hash != c.Hash {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state='closed' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tif c.Round >= 3 {\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state='exhausted' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tvar exists int\n\tif tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM chat_reminder_intents WHERE cluster_id=? AND round_version=? AND round_no=?`, string(c.ID), c.Version, c.Round+1).Scan(&exists) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif exists > 0 {\n\t\treturn nil\n\t} // One persisted attempt/outbox until a real outcome.\n\t// All reservations roll back together if either account/platform budget fails.\n\tif _, err = tx.ExecContext(ctx, \"SAVEPOINT reminder_budget\"); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tallowed, err := r.reserveBudget(ctx, tx, c.Actor)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !allowed {\n\t\tif _, err = tx.ExecContext(ctx, \"ROLLBACK TO SAVEPOINT reminder_budget\"); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND,blocked_reason='channel_budget' WHERE id=?`, string(c.ID)); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treturn tx.Commit()\n\t}\n\tvar b [32]byte\n\tif _, err = rand.Read(b[:]); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, err = tx.ExecContext(ctx, `INSERT INTO chat_reminder_intents(operation_id,cluster_id,round_version,round_no,conversation_id,recipient_id,member_hash,target_seq,state,attempts,next_attempt_at,created_at,expires_at) VALUES(?,?,?,?,?,?,?,?,'pending',0,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6),UTC_TIMESTAMP(6)+INTERVAL 1 DAY)`, hex.EncodeToString(b[:]), string(c.ID), c.Version, c.Round+1, string(c.CID), string(c.Actor), c.Hash, w.Target); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET blocked_reason=NULL WHERE id=?`, string(c.ID)); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) SubmitPending(ctx context.Context) error {\n\trows, err := r.base.db.QueryContext(ctx, `SELECT CAST(id AS CHAR),operation_id,CAST(recipient_id AS CHAR),CAST(target_seq AS CHAR),CAST(round_version AS CHAR),CAST(conversation_id AS CHAR) FROM chat_reminder_intents WHERE state IN ('pending','retryable') AND attempts<8 AND next_attempt_at<=UTC_TIMESTAMP(6) AND expires_at>UTC_TIMESTAMP(6) ORDER BY id LIMIT 20`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\twork := []ports.Reminder{}\n\tfor rows.Next() {\n\t\tvar q ports.Reminder\n\t\tif rows.Scan(&q.IntentID, &q.OperationID, &q.RecipientID, &q.TargetSeq, &q.ClusterVersion, &q.ConversationID) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\twork = append(work, q)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, q := range work {\n\t\tresult, err := r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='retryable',diagnostic='php_receipt_unconfirmed',attempts=attempts+1,next_attempt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND WHERE id=? AND state IN ('pending','retryable') AND next_attempt_at<=UTC_TIMESTAMP(6) AND attempts<8`, string(q.IntentID))\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tn, _ := result.RowsAffected()\n\t\tif n != 1 {\n\t\t\tcontinue\n\t\t}\n\t\tallowed, err := r.Eligible(ctx, q.OperationID)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !allowed {\n\t\t\tif err = r.reconcileOne(ctx, q.OperationID, ports.Receipt{OperationID: q.OperationID, State: \"suppressed\", Diagnostic: \"read_or_permission_changed\"}); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\treceipt, err := r.notification.Submit(ctx, q)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif receipt.OperationID != q.OperationID {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tswitch receipt.State {\n\t\tcase \"accepted\":\n\t\t\t_, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='submitted' WHERE id=? AND state='retryable'`, string(q.IntentID))\n\t\tcase \"sent\", \"suppressed\", \"channel_limited\", \"provider_unknown\":\n\t\t\terr = r.reconcileOne(ctx, q.OperationID, receipt)\n\t\tdefault:\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) Eligible(ctx context.Context, op string) (bool, error) {\n\tif len(op) != 64 {\n\t\treturn false, ports.ErrInvalid\n\t}\n\tvar cid, actor, cluster ports.ID\n\tvar hash, state string\n\tvar target, version uint64\n\tvar live bool\n\terr := r.base.db.QueryRowContext(ctx, `SELECT CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),CAST(cluster_id AS CHAR),member_hash,target_seq,round_version,state,expires_at>UTC_TIMESTAMP(6) FROM chat_reminder_intents WHERE operation_id=?`, op).Scan(&cid, &actor, &cluster, &hash, &target, &version, &state, &live)\n\tif err == sql.ErrNoRows {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tif !live || state == \"suppressed\" || state == \"provider_unknown\" || state == \"channel_limited\" {\n\t\treturn false, nil\n\t}\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tdefer tx.Rollback()\n\tw, err := r.window(ctx, tx, cid, actor, target)\n\tif errors.Is(err, policy.ErrDenied) {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tvar current uint64\n\tif tx.QueryRowContext(ctx, `SELECT round_version FROM chat_reminder_clusters WHERE id=? LOCK IN SHARE MODE`, string(cluster)).Scan(&current) != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\tvalid := w.First > 0 && w.Hash == hash && current == version\n\tif tx.Commit() != nil {\n\t\treturn false, ports.ErrUnavailable\n\t}\n\treturn valid, nil\n}\n","chat/internal/message/governance_http.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"io\"\n\t\"mime\"\n\t\"net/http\"\n\t\"strings\"\n\t\"time\"\n)\n\ntype governanceAction struct {\n\tConversation ports.ID `json:\"conversation_id,omitempty\"`\n\tMessage      ports.ID `json:\"message_id,omitempty\"`\n\tItem         ports.ID `json:\"item_id,omitempty\"`\n\tCase         ports.ID `json:\"case_id,omitempty\"`\n\tTarget       ports.ID `json:\"target_id,omitempty\"`\n\tActor        ports.ID `json:\"actor_id,omitempty\"`\n\tExpected     ports.ID `json:\"expected_version,omitempty\"`\n\tCursor       string   `json:\"cursor,omitempty\"`\n\tAfter        ports.ID `json:\"after,omitempty\"`\n\tLimit        int      `json:\"limit,omitempty\"`\n\tSeconds      int      `json:\"seconds,omitempty\"`\n\tReason       string   `json:\"reason,omitempty\"`\n\tAction       string   `json:\"action,omitempty\"`\n\tTargetType   string   `json:\"target_type,omitempty\"`\n\tThumbnail    bool     `json:\"thumbnail,omitempty\"`\n}\ntype GovernanceHandler struct {\n\tservice  *GovernanceService\n\tidentity ports.Identity\n\tgate     chan struct{}\n}\n\nfunc NewGovernanceHandler(g *GovernanceService, id ports.Identity, concurrency int) (*GovernanceHandler, error) {\n\tif g == nil || id == nil || concurrency < 1 || concurrency > 16 {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &GovernanceHandler{g, id, make(chan struct{}, concurrency)}, nil\n}\nfunc (h *GovernanceHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json; charset=utf-8\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tw.Header().Set(\"X-Content-Type-Options\", \"nosniff\")\n\tfail := func(status int, code string) {\n\t\tw.WriteHeader(status)\n\t\tjson.NewEncoder(w).Encode(map[string]any{\"code\": code, \"message\": \"操作未完成，请刷新状态后重试\", \"retryable\": status >= 500})\n\t}\n\troutes := map[string]string{\n\t\t\"audit/list\": \"cursor limit\", \"audit/history\": \"conversation_id cursor message_id limit\", \"audit/url\": \"conversation_id message_id item_id thumbnail\",\n\t\t\"governance/reminders\": \"after\", \"governance/status\": \"actor_id\", \"governance/restrict\": \"actor_id expected_version action seconds reason\", \"governance/report\": \"conversation_id message_id item_id reason\",\n\t\t\"governance/appeal\": \"target_type target_id expected_version reason\", \"governance/cases\": \"after\", \"governance/queue\": \"after\",\n\t\t\"governance/evidence\": \"case_id expected_version item_id reason\", \"governance/decide\": \"case_id expected_version action reason\",\n\t}\n\troute := strings.TrimPrefix(r.URL.Path, \"/chat/api/v1/\")\n\tfields, ok := routes[route]\n\tif !ok || r.URL.Path != \"/chat/api/v1/\"+route {\n\t\tfail(404, \"CHAT_ROUTE_NOT_FOUND\")\n\t\treturn\n\t}\n\tif r.Method != \"POST\" {\n\t\tw.Header().Set(\"Allow\", \"POST\")\n\t\tfail(405, \"CHAT_METHOD_NOT_ALLOWED\")\n\t\treturn\n\t}\n\tcontent, _, err := mime.ParseMediaType(r.Header.Get(\"Content-Type\"))\n\tif err != nil || content != \"application/json\" || r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429, ports.ErrBusy.Error())\n\t\treturn\n\t}\n\theaders := r.Header.Values(\"Authorization\")\n\tif len(headers) != 1 || !strings.HasPrefix(headers[0], \"Bearer \") || strings.ContainsAny(headers[0], \"\\r\\n\\t\") {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\tp, err := h.identity.Authenticate(r.Context(), strings.TrimPrefix(headers[0], \"Bearer \"))\n\tif err != nil {\n\t\tfail(401, \"CHAT_UNAUTHORIZED\")\n\t\treturn\n\t}\n\traw, err := io.ReadAll(io.LimitReader(r.Body, 8193))\n\tif err != nil || len(raw) > 8192 {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tvar q governanceAction\n\tvar keys map[string]json.RawMessage\n\tif !strictImageJSON(raw, &q) || json.Unmarshal(raw, &keys) != nil {\n\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\treturn\n\t}\n\tallowed := map[string]bool{}\n\tfor _, v := range strings.Fields(fields) {\n\t\tallowed[v] = true\n\t}\n\tfor k, v := range keys {\n\t\tif !allowed[k] || string(v) == \"null\" {\n\t\t\tfail(400, \"CHAT_INVALID_REQUEST\")\n\t\t\treturn\n\t\t}\n\t}\n\tvar data any\n\tswitch route {\n\tcase \"audit/list\":\n\t\tdata, err = h.service.AuditList(r.Context(), p, q.Cursor, q.Limit)\n\tcase \"audit/history\":\n\t\tdata, err = h.service.AuditHistory(r.Context(), p, HistoryRequest{ConversationID: q.Conversation, Cursor: q.Cursor, TargetID: q.Message, Limit: q.Limit})\n\tcase \"audit/url\":\n\t\tvar url string\n\t\turl, err = h.service.AuditImage(r.Context(), p, q.Conversation, q.Message, q.Item, q.Thumbnail)\n\t\tdata = map[string]any{\"url\": url, \"expires_in\": 60}\n\tcase \"governance/reminders\":\n\t\tdata, err = h.service.ReminderSummaries(r.Context(), p, q.After)\n\tcase \"governance/status\":\n\t\tif q.Actor == \"\" {\n\t\t\tq.Actor = p.ActorID\n\t\t}\n\t\tdata, err = h.service.Restriction(r.Context(), p, q.Actor)\n\tcase \"governance/restrict\":\n\t\tdata, err = h.service.Restrict(r.Context(), p, RestrictionRequest{Actor: q.Actor, Expected: q.Expected, Action: q.Action, Seconds: q.Seconds, Reason: q.Reason})\n\tcase \"governance/report\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Report(r.Context(), p, q.Conversation, q.Message, q.Item, q.Reason)\n\t\tdata = map[string]any{\"case_id\": id}\n\tcase \"governance/appeal\":\n\t\tvar id ports.ID\n\t\tid, err = h.service.Appeal(r.Context(), p, q.TargetType, q.Target, q.Expected, q.Reason)\n\t\tdata = map[string]any{\"case_id\": id}\n\tcase \"governance/cases\", \"governance/queue\":\n\t\tdata, err = h.service.Cases(r.Context(), p, q.After, route == \"governance/queue\")\n\tcase \"governance/evidence\":\n\t\tdata, err = h.service.Evidence(r.Context(), p, q.Case, q.Expected, q.Item, q.Reason)\n\tcase \"governance/decide\":\n\t\tdata, err = h.service.Decide(r.Context(), p, CaseDecision{ID: q.Case, Expected: q.Expected, Action: q.Action, Reason: q.Reason})\n\t}\n\tif err != nil {\n\t\tstatus := 503\n\t\tswitch {\n\t\tcase errors.Is(err, auth.ErrUnauthorized):\n\t\t\tstatus = 401\n\t\tcase errors.Is(err, policy.ErrDenied):\n\t\t\tstatus = 403\n\t\tcase errors.Is(err, ports.ErrInvalid):\n\t\t\tstatus = 400\n\t\tcase errors.Is(err, ports.ErrBusy):\n\t\t\tstatus = 429\n\t\tcase errors.Is(err, ErrResync), errors.Is(err, ErrMediaVersion), errors.Is(err, ErrPreferenceConflict), errors.Is(err, ErrMedia):\n\t\t\tstatus = 409\n\t\t}\n\t\tfail(status, err.Error())\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]any{\"data\": data, \"server_time\": time.Now().UTC()})\n}\n","chat/internal/dependencies/reminders.go":"package dependencies\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"time\"\n)\n\ntype ReminderHTTP struct {\n\ttransport     *HTTP\n\tsigner        *auth.InternalAuth\n\tendpoint, kid string\n}\n\nfunc NewReminderHTTP(h *HTTP, signer *auth.InternalAuth, endpoint, kid string) (*ReminderHTTP, error) {\n\tu, err := url.Parse(endpoint)\n\tif err != nil || h == nil || signer == nil || u.Scheme != \"https\" || u.Host == \"\" || u.User != nil || u.RawQuery != \"\" || u.Fragment != \"\" || u.Path != \"/chat-internal.php\" {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderHTTP{h, signer, endpoint, kid}, nil\n}\nfunc (h *ReminderHTTP) call(ctx context.Context, q map[string]string) (ports.Receipt, error) {\n\traw, _ := json.Marshal(q)\n\treq, err := http.NewRequestWithContext(ctx, \"POST\", h.endpoint, bytes.NewReader(raw))\n\tif err != nil {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\tif err = h.signer.Sign(req, raw, h.kid, time.Now()); err != nil {\n\t\treturn ports.Receipt{}, err\n\t}\n\tbody, status, err := h.transport.Do(ctx, req)\n\tif err != nil || status != 200 {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tvar result struct {\n\t\tOperation  string `json:\"operation_id\"`\n\t\tState      string `json:\"state\"`\n\t\tDiagnostic string `json:\"diagnostic\"`\n\t}\n\tif json.Unmarshal(body, &result) != nil || result.Operation != q[\"operation_id\"] {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tswitch result.State {\n\tcase \"accepted\", \"sent\", \"suppressed\", \"channel_limited\", \"provider_unknown\":\n\tdefault:\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\tif len(result.Diagnostic) > 64 {\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\treturn ports.Receipt{OperationID: result.Operation, State: result.State, Diagnostic: result.Diagnostic}, nil\n}\nfunc (h *ReminderHTTP) Submit(ctx context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tif !q.IntentID.Valid() || !q.RecipientID.Valid() || !q.ConversationID.Valid() || !q.TargetSeq.Valid() || !q.ClusterVersion.Valid() || len(q.OperationID) != 64 {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treturn h.call(ctx, map[string]string{\"intent_id\": string(q.IntentID), \"recipient_id\": string(q.RecipientID), \"conversation_id\": string(q.ConversationID), \"target_seq\": string(q.TargetSeq), \"cluster_version\": string(q.ClusterVersion), \"operation_id\": q.OperationID})\n}\nfunc (h *ReminderHTTP) Status(ctx context.Context, op string) (ports.Receipt, error) {\n\tif len(op) != 64 {\n\t\treturn ports.Receipt{}, ports.ErrInvalid\n\t}\n\treturn h.call(ctx, map[string]string{\"operation_id\": op})\n}\n","chat/internal/message/reminder_http.go":"package message\n\nimport (\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"io\"\n\t\"net/http\"\n\t\"time\"\n)\n\ntype ReminderInternalHandler struct {\n\tservice *ReminderService\n\tauth    *auth.InternalAuth\n\tgate    chan struct{}\n}\n\nfunc NewReminderInternalHandler(s *ReminderService, a *auth.InternalAuth) (*ReminderInternalHandler, error) {\n\tif s == nil || a == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &ReminderInternalHandler{s, a, make(chan struct{}, 8)}, nil\n}\nfunc (h *ReminderInternalHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tfail := func(status int) { w.WriteHeader(status); w.Write([]byte(\"{\\\"code\\\":\\\"CHAT_REMINDER_UNAVAILABLE\\\"}\")) }\n\tif r.Method != \"POST\" || r.URL.Path != \"/chat/internal/v1/reminders/eligible\" || r.URL.RawQuery != \"\" || r.URL.RawPath != \"\" {\n\t\tfail(404)\n\t\treturn\n\t}\n\tselect {\n\tcase h.gate <- struct{}{}:\n\t\tdefer func() { <-h.gate }()\n\tdefault:\n\t\tfail(429)\n\t\treturn\n\t}\n\traw, err := io.ReadAll(io.LimitReader(r.Body, 1025))\n\tif err != nil || len(raw) > 1024 {\n\t\tfail(400)\n\t\treturn\n\t}\n\tif err = h.auth.Verify(r.Context(), r, raw, time.Now()); err != nil {\n\t\tfail(401)\n\t\treturn\n\t}\n\tvar q struct {\n\t\tOperation string `json:\"operation_id\"`\n\t}\n\tif !strictImageJSON(raw, &q) || len(q.Operation) != 64 {\n\t\tfail(400)\n\t\treturn\n\t}\n\tallowed, err := h.service.Eligible(r.Context(), q.Operation)\n\tif err != nil {\n\t\tfail(503)\n\t\treturn\n\t}\n\tjson.NewEncoder(w).Encode(map[string]bool{\"eligible\": allowed})\n}\n","server/config/defaults.php":"<?php\n\n// 2026-08-14：提供无需 Composer 的默认配置，生产密钥由网页安装器写入 installed.php。\nreturn [\n    'installed' => false,\n    // V2.4.0：默认版本跟随当前代码包；全新安装基线已包含帮助中心结构和草稿问答。\n    'version' => '2.4.0',\n    'app' => [\n        'name' => '壁选师傅订单管理系统',\n        'url' => '',\n        'env' => 'production',\n        'debug' => false,\n        'timezone' => 'Asia/Shanghai',\n        'key' => '',\n    ],\n    'database' => [\n        'host' => '127.0.0.1',\n        'port' => 3306,\n        'database' => '',\n        'username' => '',\n        'password' => '',\n        'charset' => 'utf8mb4',\n    ],\n    // Independent PHP Ed25519 seed; Go receives public keys only. Disabled until chat acceptance.\n    'chat' => ['enabled'=>false,'key_id'=>'chat-v1','seed_env'=>'CHAT_ACCESS_SEED','order_policy_enabled'=>false,'safety_credential_export_enabled'=>false,'reminders_enabled'=>false,'internal_key_id'=>'chat-internal-v1','internal_key_env'=>'CHAT_INTERNAL_KEY','internal_go_origin'=>'','recovery_directory'=>'','recovery_gate_file'=>'','recovery_epoch'=>'','recovery_key_env'=>'CHAT_RECOVERY_KEY','test_report_key_env'=>'CHAT_TEST_REPORT_KEY','test_report_revision'=>''],\n    'security' => [\n        'session_name' => 'worker_admin_session',\n        'session_lifetime' => 7200,\n        'login_max_attempts' => 5,\n        'login_lock_minutes' => 15,\n        'force_https' => true,\n    ],\n    'media' => [\n        'max_width' => 1600,\n        'jpeg_quality' => 90,\n        'max_file_bytes' => 1048576,\n        'storage_path' => 'storage/private/uploads',\n    ],\n];\n\n","server/app/Infrastructure/Messaging/ChatInternalAuth.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\n/** Internal shared key is independent of access-token signing and channel keys. */\nfinal class ChatInternalAuth\n{\n    private Database $db; private string $env; private string $kid; private string $key;\n    public function __construct(Database $db,string $env,string $kid,string $key)\n    {\n        if (!in_array($env,['production','development','test'],true) || preg_match('/^[a-z0-9_-]{1,32}$/D',$kid)!==1 || strlen($key)!==32) throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $this->db=$db;$this->env=$env;$this->kid=$kid;$this->key=$key;\n    }\n    public static function configured(Database $db):self\n    {\n        $env=['testing'=>'test','development'=>'development','production'=>'production'][(string)\\app_config('app.env','')]??'';\n        $name=(string)\\app_config('chat.internal_key_env','');\n        if(preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D',$name)!==1)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        $encoded=getenv($name);$key=is_string($encoded)?base64_decode($encoded,true):false;\n        if(!is_string($key)||base64_encode($key)!==$encoded)throw new RuntimeException('CHAT_INTERNAL_CONFIG');\n        return new self($db,$env,(string)\\app_config('chat.internal_key_id',''),$key);\n    }\n    private function canonical(string $uri,string $body,string $stamp,string $nonce):string\n    {return implode(\"\\n\",['chat-internal-v1','POST',$uri,hash('sha256',$body),$stamp,$nonce,$this->env,$this->kid]);}\n    public function sign(string $uri,string $body):array\n    {\n        $stamp=(string)time();$nonce=bin2hex(random_bytes(32));\n        return ['X-Chat-Environment: '.$this->env,'X-Chat-Key-ID: '.$this->kid,'X-Chat-Timestamp: '.$stamp,'X-Chat-Nonce: '.$nonce,\n            'X-Chat-Signature: '.hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key)];\n    }\n    public function verify(string $uri,string $body,array $headers):void\n    {\n        if($uri!=='/chat-internal.php'||strlen($body)>8192)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $get=static fn(string $key):string=>(string)($headers[$key]??'');\n        $stamp=$get('timestamp');$nonce=$get('nonce');$signature=$get('signature');\n        if($get('environment')!==$this->env||$get('key-id')!==$this->kid||preg_match('/^[1-9][0-9]{9}$/D',$stamp)!==1||abs(time()-(int)$stamp)>30\n            ||preg_match('/^[a-f0-9]{64}$/D',$nonce)!==1||preg_match('/^[a-f0-9]{64}$/D',$signature)!==1\n            ||!hash_equals(hash_hmac('sha256',$this->canonical($uri,$body,$stamp,$nonce),$this->key),$signature))throw new RuntimeException('CHAT_INTERNAL_AUTH');\n        $insert=$this->db->execute('INSERT IGNORE INTO chat_internal_nonces(nonce_hash,expires_at) VALUES(:hash,UTC_TIMESTAMP()+INTERVAL 61 SECOND)',['hash'=>hash('sha256',$this->kid.':'.$nonce)]);\n        if($insert!==1)throw new RuntimeException('CHAT_INTERNAL_AUTH');\n    }\n    public function eligible(string $operation):bool\n    {\n        $origin=rtrim((string)\\app_config('chat.internal_go_origin',''),'/');$url=parse_url($origin);\n        if(!$url||($url['scheme']??'')!=='https'||empty($url['host'])||isset($url['user'])||isset($url['pass'])||isset($url['query'])||isset($url['fragment'])||!empty($url['path']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $uri='/chat/internal/v1/reminders/eligible';$body=json_encode(['operation_id'=>$operation],JSON_THROW_ON_ERROR);\n        $response='';$ch=curl_init($origin.$uri);curl_setopt_array($ch,[CURLOPT_POST=>true,CURLOPT_POSTFIELDS=>$body,CURLOPT_HTTPHEADER=>array_merge(['Content-Type: application/json'],$this->sign($uri,$body)),CURLOPT_RETURNTRANSFER=>false,CURLOPT_WRITEFUNCTION=>static function($handle,string $chunk)use(&$response):int{if(strlen($response)+strlen($chunk)>1024)return 0;$response.=$chunk;return strlen($chunk);},CURLOPT_CONNECTTIMEOUT_MS=>1000,CURLOPT_TIMEOUT_MS=>3000,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_PROTOCOLS=>CURLPROTO_HTTPS]);\n        $ok=curl_exec($ch);$raw=$ok===false?false:$response;$status=(int)curl_getinfo($ch,CURLINFO_RESPONSE_CODE);curl_close($ch);\n        if($status!==200||!is_string($raw)||strlen($raw)>1024)throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');\n        $result=json_decode($raw,true);if(!is_array($result)||!isset($result['eligible'])||!is_bool($result['eligible']))throw new RuntimeException('CHAT_ELIGIBILITY_UNAVAILABLE');return $result['eligible'];\n    }\n}\n","server/app/Application/Chat/ChatReminderReceipts.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nfinal class ChatReminderReceipts\n{\n    private Database $db;\n    public function __construct(Database $db){$this->db=$db;}\n    public function receive(string $raw):array\n    {\n        $q=json_decode($raw,true,8,JSON_THROW_ON_ERROR);\n        if(is_array($q)&&array_keys($q)===['operation_id']&&json_encode($q,JSON_THROW_ON_ERROR)===$raw)return $this->status((string)$q['operation_id']);\n        $fields=['cluster_version','conversation_id','intent_id','operation_id','recipient_id','target_seq'];\n        if(!is_array($q)||array_keys($q)!==$fields||json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES)!==$raw)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        foreach($q as $key=>$value){\n            if(!is_string($value)||preg_match($key==='operation_id'?'/^[a-f0-9]{64}$/D':'/^[1-9][0-9]{0,19}$/D',$value)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n            if($key!=='operation_id'&&strlen($value)===20&&strcmp($value,'18446744073709551615')>0)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        }\n        return $this->db->transaction(function()use($q,$raw):array{\n            $hash=hash('sha256',$raw);\n            $this->db->execute(\"INSERT IGNORE INTO chat_reminder_receipts(operation_id,payload_hash,payload_json,state,diagnostic,created_at,updated_at) VALUES(:op,:hash,:body,'accepted','queued',UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\",['op'=>$q['operation_id'],'hash'=>$hash,'body'=>$raw]);\n            $row=$this->db->fetch('SELECT payload_hash,state,diagnostic,outbox_id FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$q['operation_id']]);\n            if(!$row||!hash_equals((string)$row['payload_hash'],$hash))throw new RuntimeException('CHAT_REMINDER_CONFLICT');\n            if($row['outbox_id']===null){\n                $id=$this->db->insert(\"INSERT INTO message_outbox(topic,business_key,payload_json,status,attempt_count,next_attempt_at,created_at) VALUES('chat_reminder',:key,:payload,'pending',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['key'=>'chat:'.$q['operation_id'],'payload'=>$raw]);\n                $this->db->execute('UPDATE chat_reminder_receipts SET outbox_id=:id WHERE operation_id=:op',['id'=>$id,'op'=>$q['operation_id']]);\n            }\n            return $this->result($q['operation_id'],$row);\n        });\n    }\n    public function status(string $operation):array\n    {\n        if(preg_match('/^[a-f0-9]{64}$/D',$operation)!==1)throw new RuntimeException('CHAT_REMINDER_INVALID');\n        $row=$this->db->fetch('SELECT state,diagnostic FROM chat_reminder_receipts WHERE operation_id=:op',['op'=>$operation]);\n        if(!$row)throw new RuntimeException('CHAT_REMINDER_NOT_FOUND');\n        return $this->result($operation,$row);\n    }\n    private function result(string $operation,array $row):array\n    {\n        $state=in_array($row['state'],['sending','provider_unknown'],true)?'provider_unknown':(string)$row['state'];\n        return ['operation_id'=>$operation,'state'=>$state,'diagnostic'=>(string)$row['diagnostic']];\n    }\n}\n","server/chat-internal.php":"<?php\ndeclare(strict_types=1);\nrequire __DIR__.'/bootstrap.php';\nheader('Content-Type: application/json');header('Cache-Control: no-store');header('X-Content-Type-Options: nosniff');\ntry{\n    $recoveryEnvironment=['testing'=>'test','development'=>'development','production'=>'production'][(string)app_config('app.env','production')]??'';\n    \\WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryGate::assertReady((array)app_config('chat',[]),$recoveryEnvironment);\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    if(($_SERVER['REQUEST_METHOD']??'')!=='POST'||($_SERVER['REQUEST_URI']??'')!=='/chat-internal.php'||strtolower(trim(explode(';',(string)($_SERVER['CONTENT_TYPE']??''))[0]))!=='application/json')throw new RuntimeException('request');\n    $raw=file_get_contents('php://input',false,null,0,8193);if(!is_string($raw)||strlen($raw)>8192)throw new RuntimeException('body');\n    $headers=[];foreach(['environment','key-id','timestamp','nonce','signature'] as $key)$headers[$key]=(string)($_SERVER['HTTP_X_CHAT_'.strtoupper(str_replace('-','_',$key))]??'');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());$auth->verify('/chat-internal.php',$raw,$headers);\n    $result=(new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts(db()))->receive($raw);\n    echo json_encode($result,JSON_THROW_ON_ERROR);\n}catch(Throwable $error){http_response_code(503);echo '{\"code\":\"CHAT_REMINDER_UNAVAILABLE\"}';}\n","server/app/Infrastructure/Messaging/ChatReminderTemplate.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Messaging;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Messaging\\WechatTemplateValue;\nfinal class ChatReminderTemplate\n{\n    public static function build(Database $db,array $q):array\n    {\n        $scene=SubscriptionCatalog::subscriptionSceneDefinitions()['chat_unread']??[];\n        if(empty($scene['available']))return ['diagnostic'=>'template_unavailable'];\n        $recipient=(string)$q['recipient_id'];\n        // Existing PHP channel/quota ports take signed integers. Reject an\n        // unrepresentable unsigned ID instead of sending to a saturated ID.\n        $maximum=(string)PHP_INT_MAX;\n        if(strlen($recipient)>strlen($maximum)||(strlen($recipient)===strlen($maximum)&&strcmp($recipient,$maximum)>0))return ['diagnostic'=>'recipient_id_unsupported'];\n        $uid=(int)$recipient;$pref=SubscriptionQuotaStore::subscriptionPreferences($db,$uid)['chat_unread']??[];\n        $type=(string)($scene['subscription_type']??'one_time');\n        if(in_array((string)($pref['authorization_status']??''),['ban','disabled'],true)\n            ||($type==='one_time'&&max(0,(int)($pref['remaining_count']??0))<1)\n            ||($type!=='one_time'&&(empty($pref['enabled'])||!in_array($pref['authorization_status']??'',['accept','acceptWithAudio','acceptWithAlert'],true))))return ['diagnostic'=>'subscription_unavailable'];\n        $openid=(string)$db->fetchValue(\"SELECT openid FROM wechat_identities WHERE user_id=:id AND status='active' ORDER BY id DESC LIMIT 1\",['id'=>$uid]);\n        if($openid==='')return ['diagnostic'=>'openid_missing'];\n        $values=['status'=>'您有未读的订单聊天消息','time'=>date('Y-m-d H:i')];$data=[];\n        foreach((array)$scene['field_map'] as $semantic=>$key){\n            if(!isset($values[$semantic]))return ['diagnostic'=>'template_data_invalid'];\n            $value=WechatTemplateValue::format((string)$key,$values[$semantic]);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['field_defaults']??[]) as $key=>$fixed){\n            if(isset($data[$key]))continue;$value=WechatTemplateValue::format((string)$key,(string)$fixed);if($value===null||$value==='')return ['diagnostic'=>'template_data_invalid'];$data[$key]=['value'=>$value];\n        }\n        foreach((array)($scene['template_fields']??[]) as $key)if(!isset($data[$key]))return ['diagnostic'=>'template_data_missing'];\n        if(!$data)return ['diagnostic'=>'template_data_missing'];\n        return ['payload'=>['user_id'=>$uid,'scene_key'=>'chat_unread','openid'=>$openid,'template_id'=>(string)$scene['template_id'],\n            'page'=>'subpackages/chat/conversation/index?conversation_id='.rawurlencode($q['conversation_id']),'data'=>$data]];\n    }\n}\n","server/app/Application/Chat/ChatReminderDispatch.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Application\\Chat;\nuse Throwable;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatReminderTemplate;\nuse WorkerAdmin\\Infrastructure\\Messaging\\SubscriptionQuotaStore;\n/** Reuses the existing gateway/quota; no copied channel, SMS or billing stack. */\nfinal class ChatReminderDispatch\n{\n    private Database $db;private SubscribeMessageGateway $gateway;private $eligible;\n    public function __construct(Database $db,SubscribeMessageGateway $gateway,callable $eligible){$this->db=$db;$this->gateway=$gateway;$this->eligible=$eligible;}\n    public function dispatch(int $limit=20):array\n    {\n        if($this->db->pdo()->inTransaction())throw new RuntimeException('CHAT_SEND_TRANSACTION');\n        $limit=max(1,min(50,$limit));\n        // A dead process after entering the channel has an unknown result. It\n        // cannot re-enter generic failed retries or trigger an SMS fallback.\n        $this->db->execute(\"UPDATE chat_reminder_receipts SET state='provider_unknown',diagnostic='provider_unknown',updated_at=UTC_TIMESTAMP(6) WHERE state='sending' AND updated_at<UTC_TIMESTAMP(6)-INTERVAL 5 MINUTE\");\n        $rows=$this->db->fetchAll(\"SELECT o.id,o.payload_json FROM message_outbox o JOIN chat_reminder_receipts r ON r.outbox_id=o.id WHERE o.topic='chat_reminder' AND o.status IN ('pending','failed','processing') AND r.state='accepted' AND o.attempt_count<8 AND (o.next_attempt_at IS NULL OR o.next_attempt_at<=UTC_TIMESTAMP()) ORDER BY o.id LIMIT \".$limit);\n        $stats=['scanned'=>count($rows),'sent'=>0,'suppressed'=>0,'unknown'=>0,'retry'=>0];\n        foreach($rows as $row){\n            $id=(int)$row['id'];$q=json_decode((string)$row['payload_json'],true);$op=(string)($q['operation_id']??'');\n            if(preg_match('/^[a-f0-9]{64}$/D',$op)!==1)continue;\n            $claimed=$this->db->execute(\"UPDATE message_outbox SET status='processing',attempt_count=attempt_count+1,next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE WHERE id=:id AND topic='chat_reminder' AND (status IN ('pending','failed') OR (status='processing' AND next_attempt_at<=UTC_TIMESTAMP()))\",['id'=>$id]);\n            if($claimed!==1)continue;\n            $entered=false;\n            try{\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $built=ChatReminderTemplate::build($this->db,$q);\n                if(!isset($built['payload'])){$this->finish($op,$id,'channel_limited',(string)$built['diagnostic']);$stats['suppressed']++;continue;}\n                // Final check is after metadata/permissions and immediately\n                // before recording the irreversible provider boundary.\n                if(!(($this->eligible)($op))){$this->finish($op,$id,'suppressed','read_or_permission_changed');$stats['suppressed']++;continue;}\n                $entered=$this->db->transaction(function()use($op,$q):bool{\n                    $receipt=$this->db->fetch('SELECT state FROM chat_reminder_receipts WHERE operation_id=:op FOR UPDATE',['op'=>$op]);\n                    if(!$receipt||$receipt['state']!=='accepted')return false;\n                    $this->db->fetch(\"SELECT setting_key FROM system_settings WHERE setting_key=:key FOR UPDATE\",['key'=>'wechat.subscription.user.'.(int)$q['recipient_id']]);\n                    $current=ChatReminderTemplate::build($this->db,$q);if(!isset($current['payload']))return false;\n                    // Reserve once, including provider-unknown outcomes.\n                    SubscriptionQuotaStore::markSubscriptionConsumed($this->db,(int)$q['recipient_id'],'chat_unread');\n                    $this->db->execute(\"UPDATE chat_reminder_receipts SET state='sending',diagnostic='channel_entered',updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op\",['op'=>$op]);return true;\n                });\n                if(!$entered){$this->finish($op,$id,'suppressed','subscription_changed');$stats['suppressed']++;continue;}\n                $this->gateway->send($built['payload']);\n                $this->finish($op,$id,'sent','sent');$stats['sent']++;\n            }catch(Throwable $error){\n                if($entered){$this->finish($op,$id,'provider_unknown','provider_unknown');$stats['unknown']++;}\n                else{$this->db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP()+INTERVAL 1 MINUTE,last_error='chat_eligibility_unavailable' WHERE id=:id\",['id'=>$id]);$stats['retry']++;}\n            }\n        }\n        return $stats;\n    }\n    private function finish(string $op,int $id,string $state,string $diagnostic):void\n    {\n        $this->db->transaction(function()use($op,$id,$state,$diagnostic):void{\n            $this->db->execute(\"UPDATE chat_reminder_receipts SET state=:state,diagnostic=:diagnostic,updated_at=UTC_TIMESTAMP(6) WHERE operation_id=:op AND state IN ('accepted','sending')\",['state'=>$state,'diagnostic'=>$diagnostic,'op'=>$op]);\n            $this->db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP(),next_attempt_at=NULL,last_error=:diagnostic WHERE id=:id AND topic='chat_reminder'\",['diagnostic'=>$diagnostic,'id'=>$id]);\n        });\n    }\n}\n","server/bin/chat-reminders.php":"<?php\ndeclare(strict_types=1);\nif(PHP_SAPI!=='cli'){http_response_code(404);exit;}\nrequire dirname(__DIR__).'/bootstrap.php';\ntry{\n    $recoveryEnvironment=['testing'=>'test','development'=>'development','production'=>'production'][(string)app_config('app.env','production')]??'';\n    \\WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryGate::assertReady((array)app_config('chat',[]),$recoveryEnvironment);\n    if(!is_installed()||upgrade_required()||app_config('chat.reminders_enabled',false)!==true)throw new RuntimeException('closed');\n    $auth=\\WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth::configured(db());\n    $shared=new \\WorkerAdmin\\Foundation\\ApplicationContainer(db());\n    $dispatcher=new \\WorkerAdmin\\Application\\Chat\\ChatReminderDispatch(db(),$shared->subscribeMessages(),[$auth,'eligible']);\n    $stats=$dispatcher->dispatch(20);\n    db()->execute('DELETE FROM chat_internal_nonces WHERE expires_at<=UTC_TIMESTAMP() ORDER BY expires_at LIMIT 1000');\n    fwrite(STDOUT,json_encode($stats,JSON_THROW_ON_ERROR).\"\\n\");\n}catch(Throwable $error){fwrite(STDERR,\"聊天提醒处理暂不可用\\n\");exit(1);}\n","server/app/Http/Admin/Modules/ChatGovernanceAdminModule.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\nuse RuntimeException;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\n/** PHP owns page/identity grants only; every chat-governance mutation uses Go. */\nfinal class ChatGovernanceAdminModule implements AdminModule\n{\n    private Database $db;private Auth $auth;\n    public function __construct(Database $db,Auth $auth,Csrf $csrf){$this->db=$db;$this->auth=$auth;}\n    public function supports(string $route):bool{return in_array($route,['chat.governance','chat.auditors'],true);}\n    public function dispatch(string $route):void\n    {\n        $this->auth->requirePermission($route==='chat.auditors'?'chat.audit.grants':'audit.view');\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));\n        if($route==='chat.auditors'&&$method==='POST'){\n            $id=trim((string)($_POST['user_id']??''));$reason=trim((string)($_POST['reason']??''));$enabled=(string)($_POST['enabled']??'')==='1';\n            if(preg_match('/^[1-9][0-9]{0,19}$/D',$id)!==1||mb_strlen($reason)<2||mb_strlen($reason)>200||!$this->db->fetchValue(\"SELECT id FROM users WHERE id=:id AND status='active'\",['id'=>$id]))throw new RuntimeException('请填写真实用户编号和授权理由');\n            $admin=(string)$this->auth->user()['id'];$version=bin2hex(random_bytes(32));\n            $this->db->transaction(function()use($id,$reason,$enabled,$admin,$version):void{\n                $this->db->execute('INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6)) ON DUPLICATE KEY UPDATE enabled=VALUES(enabled),authority_version=VALUES(authority_version),granted_by=VALUES(granted_by),reason=VALUES(reason),updated_at=VALUES(updated_at)',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n                $this->db->execute('INSERT INTO chat_auditor_grant_audit(user_id,enabled,authority_version,admin_id,reason,created_at) VALUES(:id,:enabled,:version,:admin,:reason,UTC_TIMESTAMP(6))',['id'=>$id,'enabled'=>(int)$enabled,'version'=>$version,'admin'=>$admin,'reason'=>$reason]);\n            });\n            \\flash('success','会话抽检授权已更新');\\redirect(\\admin_url('chat.auditors'));return;\n        }\n        if($method!=='GET'){http_response_code(405);throw new RuntimeException('请求方式不正确');}\n        $grants=$route==='chat.auditors'?$this->db->fetchAll('SELECT user_id,enabled,granted_by,reason,updated_at FROM chat_mini_auditors ORDER BY updated_at DESC,user_id DESC LIMIT 50'):[];\n        echo \\view('admin/chat-governance',['pageTitle'=>$route==='chat.auditors'?'小程序抽检授权':'聊天抽检与治理','activeMenu'=>$route,'grants'=>$grants,'grantPage'=>$route==='chat.auditors',\n            'canModerate'=>$this->auth->can('users.manage'),'canEvidence'=>$this->auth->can('chat.evidence.view')]);\n    }\n}\n","chat/internal/message/governance_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc governanceFixture(t *testing.T, f *fixtureDB, s *Service, m *MediaService) (*GovernanceService, ports.Principal) {\n\tt.Helper()\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"k\", 32)), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tg, err := NewGovernanceService(s, h, m, \"test\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(`INSERT INTO admin_users(id,username,password_hash,role,status,must_change_password,created_at,updated_at) VALUES(91001,'governance-fixture','fixture','super_admin','active',0,UTC_TIMESTAMP(),UTC_TIMESTAMP())`)\n\tf.exec(`INSERT INTO chat_admin_sessions(id,admin_id,session_hash,session_version,authority_hash,scopes_json,expires_at,created_at) VALUES(91001,91001,REPEAT('d',64),REPEAT('e',64),REPEAT('f',64),'[\"chat:audit\",\"chat:moderate\",\"chat:images\",\"chat:evidence\"]',UTC_TIMESTAMP()+INTERVAL 5 MINUTE,UTC_TIMESTAMP())`)\n\tp := ports.Principal{ActorID: \"91001\", Kind: \"admin\", SourceID: \"91001\", SessionID: strings.Repeat(\"d\", 64), SessionVersion: strings.Repeat(\"e\", 64), Environment: \"test\", Scopes: []string{\"chat:audit\", \"chat:moderate\", \"chat:images\", \"chat:evidence\"}, ExpiresAt: time.Now().Add(time.Minute)}\n\treturn g, p\n}\nfunc TestMySQLS18AuditSnapshotIsolationAndRevocation(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tfirst := accepted(t, s, q)\n\tfor i := 0; i < 5; i++ {\n\t\tf.exec(`INSERT INTO chat_conversations(conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,created_at,updated_at) VALUES('order',CONCAT('fixture-audit:',?),?, ?,1,REPEAT('a',64),'fixture','readonly',UTC_TIMESTAMP(6)-INTERVAL 1 DAY,UTC_TIMESTAMP(6))`, i, 600+i, 600+i)\n\t}\n\tpage, err := g.AuditList(ctx, admin, \"\", 2)\n\tif err != nil || len(page.Items) != 2 || !page.More {\n\t\tt.Fatal(page, err)\n\t}\n\ttotal := f.text(\"SELECT COUNT(*) FROM chat_conversations\")\n\tseen := map[ports.ID]bool{}\n\tfor _, item := range page.Items {\n\t\tseen[item.ID] = true\n\t}\n\t// Move an unseen row to the top after the snapshot was created.\n\tf.exec(`UPDATE chat_conversations SET last_message_at=UTC_TIMESTAMP(6)+INTERVAL 1 DAY WHERE scope_key='fixture-audit:4'`)\n\tfor page.More {\n\t\tpage, err = g.AuditList(ctx, admin, page.Cursor, 2)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tfor _, item := range page.Items {\n\t\t\tif seen[item.ID] {\n\t\t\t\tt.Fatal(\"activity change duplicated snapshot row\")\n\t\t\t}\n\t\t\tseen[item.ID] = true\n\t\t}\n\t}\n\tif decimal(uint64(len(seen))) != ports.ID(total) {\n\t\tt.Fatal(\"snapshot lost conversations\", len(seen), total)\n\t}\n\tif _, err = g.AuditList(ctx, principal(\"10203\"), \"\", 20); err == nil {\n\t\tt.Fatal(\"platform staff inherited audit\")\n\t}\n\tmini := principal(\"10203\")\n\tmini.Kind = \"mini_audit\"\n\tmini.Scopes = []string{\"chat:audit\"}\n\tif _, err = g.AuditList(ctx, mini, \"\", 20); err == nil {\n\t\tt.Fatal(\"ungranted mini audit\")\n\t}\n\tf.exec(`INSERT INTO chat_mini_auditors(user_id,enabled,authority_version,granted_by,reason,updated_at) VALUES(10203,1,REPEAT('f',64),91001,'独立抽检测试',UTC_TIMESTAMP(6))`)\n\tmini.SessionVersion = digest(\"mini-audit-v1\\n10203\\n\" + digest(\"login:10203\") + \"\\n10203\\n\" + strings.Repeat(\"f\", 64))\n\tif _, err = g.AuditList(ctx, mini, \"\", 20); err != nil {\n\t\tt.Fatal(\"independent grant\", err)\n\t}\n\tif _, err = f.store.Authorize(ctx, ports.PolicyRequest{Actor: mini, ConversationID: q.ConversationID, Action: \"send\"}); err == nil {\n\t\tt.Fatal(\"audit identity used ordinary member path\")\n\t}\n\tbefore := f.text(\"SELECT COUNT(*) FROM chat_member_reads\")\n\tdetail, err := g.AuditHistory(ctx, admin, HistoryRequest{ConversationID: q.ConversationID})\n\tif err != nil || len(detail.Messages) != 1 || detail.Messages[0].Text == nil {\n\t\tt.Fatal(detail, err)\n\t}\n\tif _, err = s.Recall(ctx, principal(\"10202\"), q.ConversationID, first.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdetail, err = g.AuditHistory(ctx, admin, HistoryRequest{ConversationID: q.ConversationID, TargetID: first.MessageID})\n\tif err != nil || detail.Messages[0].Text != nil || detail.Messages[0].State != \"recalled\" {\n\t\tt.Fatal(\"audit leaked recall\", detail, err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_member_reads\") != before {\n\t\tt.Fatal(\"audit marked read\")\n\t}\n\tf.exec(\"UPDATE chat_mini_auditors SET enabled=0 WHERE user_id=10203\")\n\tif _, err = g.AuditHistory(ctx, mini, HistoryRequest{ConversationID: q.ConversationID}); err == nil {\n\t\tt.Fatal(\"revoked mini audit\")\n\t}\n\tf.exec(\"UPDATE chat_mini_auditors SET enabled=1,authority_version=REPEAT('a',64) WHERE user_id=10203\")\n\tif _, err = g.AuditHistory(ctx, mini, HistoryRequest{ConversationID: q.ConversationID}); err == nil {\n\t\tt.Fatal(\"old revoked grant revived after regrant\")\n\t}\n\tf.exec(\"UPDATE admin_users SET role='viewer' WHERE id=91001\")\n\tif _, err = g.AuditList(ctx, admin, \"\", 20); err == nil {\n\t\tt.Fatal(\"revoked admin\")\n\t}\n\tif _, err = f.goDB.ExecContext(ctx, \"UPDATE chat_governance_audit SET reason='tamper'\"); err == nil {\n\t\tt.Fatal(\"audit table mutable by Go\")\n\t}\n}\nfunc TestMySQLS19BanSerializesPendingSendAndKeepsReadRecallAppeal(t *testing.T) {\n\tstarted, resume := make(chan struct{}), make(chan struct{})\n\tvar once sync.Once\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tfirst := accepted(t, s, q)\n\ts.safety = safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\tonce.Do(func() { close(started) })\n\t\t<-resume\n\t\treturn ports.SafetyResult{Decision: \"passed\", RuleVersion: \"s19-fixture\"}, nil\n\t})\n\tq.ClientMessageID = client(22)\n\tdone := make(chan error, 1)\n\tgo func() { _, err := s.Send(ctx, principal(\"10202\"), q); done <- err }()\n\t<-started\n\tblocked, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"0\", Action: \"permanent\", Reason: \"并发禁聊测试\"})\n\tif err != nil || !blocked.Blocked {\n\t\tt.Fatal(blocked, err)\n\t}\n\tclose(resume)\n\tif err = <-done; err != ErrRestricted {\n\t\tt.Fatal(\"in-flight send bypassed restriction\", err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"late publish\")\n\t}\n\tif _, err = g.history.Read(ctx, principal(\"10202\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\"); err != nil {\n\t\tt.Fatal(\"ban blocked legal read\", err)\n\t}\n\tif _, err = s.Recall(ctx, principal(\"10202\"), q.ConversationID, first.MessageID); err != nil {\n\t\tt.Fatal(\"ban blocked recall\", err)\n\t}\n\tid, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", blocked.Version, \"对此次禁聊提出申诉\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Evidence(ctx, admin, id, \"1\", \"\", \"核对禁聊依据\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: id, Expected: \"1\", Action: \"correct\", Reason: \"核查后解除限制\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstatus, err := g.Restriction(ctx, principal(\"10202\"), \"10202\")\n\tif err != nil || status.Blocked || status.Version != \"2\" {\n\t\tt.Fatal(status, err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"appeal resent old action\")\n\t}\n\ttimed, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"2\", Action: \"timed\", Seconds: 60, Reason: \"限时到期测试\"})\n\tif err != nil || !timed.Blocked {\n\t\tt.Fatal(timed, err)\n\t}\n\tf.exec(\"UPDATE chat_restrictions SET blocked_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND WHERE actor_id=10202\")\n\tif err = g.ExpireRestrictions(ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstatus, err = g.Restriction(ctx, principal(\"10202\"), \"10202\")\n\tif err != nil || status.Blocked || status.Version != \"4\" {\n\t\tt.Fatal(status, err)\n\t}\n\tbannedAgain, err := g.Restrict(ctx, admin, RestrictionRequest{Actor: \"10202\", Expected: \"4\", Action: \"permanent\", Reason: \"独立第二次禁聊\"})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsecond, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", bannedAgain.Version, \"第二次禁聊独立申诉\")\n\tif err != nil || second == id {\n\t\tt.Fatal(\"new restriction generation reused old case\", second, err)\n\t}\n\tagain, err := g.Appeal(ctx, principal(\"10202\"), \"restriction\", \"10202\", bannedAgain.Version, \"重复提交同一申诉\")\n\tif err != nil || again != second {\n\t\tt.Fatal(\"same generation duplicated appeal\", again, err)\n\t}\n}\nfunc TestMySQLS19ReportsScopeEvidenceAndFalsePositiveCorrection(t *testing.T) {\n\tsafety := safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: \"s19-fixture\", Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: \"fixture_risk\", Level: 2, Confirmed: true}}, nil\n\t})\n\tf, s, q := setupMessage(t, safety)\n\tg, admin := governanceFixture(t, f, s, nil)\n\tctx := f.ctx\n\tresult, err := s.Send(ctx, principal(\"10202\"), q)\n\tif err != nil || result.RiskEventID == \"\" {\n\t\tt.Fatal(result, err)\n\t}\n\tid, err := g.Appeal(ctx, principal(\"10202\"), \"risk\", result.RiskEventID, \"1\", \"认为此内容存在误判\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Appeal(ctx, principal(\"10203\"), \"risk\", result.RiskEventID, \"1\", \"不能申诉他人内容\"); err == nil {\n\t\tt.Fatal(\"foreign evidence appeal\")\n\t}\n\tweak := admin\n\tweak.Scopes = []string{\"chat:audit\", \"chat:moderate\"}\n\tif _, err = g.Evidence(ctx, weak, id, \"1\", \"\", \"普通权限不能读原文\"); err == nil {\n\t\tt.Fatal(\"missing distinct evidence scope\")\n\t}\n\tevidence, err := g.Evidence(ctx, admin, id, \"1\", \"\", \"核对原文及上下文\")\n\tif err != nil || evidence.Text == nil || *evidence.Text != q.Text {\n\t\tt.Fatal(evidence, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: id, Expected: \"1\", Action: \"correct\", Reason: \"原内容确认为误判\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE confirmed=1\") != \"0\" {\n\t\tt.Fatal(\"false positive still counted\")\n\t}\n\tagain, err := s.Query(ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif err != nil || again.State != \"rejected\" {\n\t\tt.Fatal(\"corrected old intent resurrected\", again, err)\n\t}\n\tnoMessages(t, f)\n\ts.safety = safetyFunc(pass)\n\tq.ClientMessageID = client(29)\n\tmessage := accepted(t, s, q)\n\treport, err := g.Report(ctx, principal(\"10203\"), q.ConversationID, message.MessageID, \"\", \"此消息需要平台核查\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tduplicate, err := g.Report(ctx, principal(\"10203\"), q.ConversationID, message.MessageID, \"\", \"重复举报合并\")\n\tif err != nil || duplicate != report {\n\t\tt.Fatal(\"duplicate case\", duplicate, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"block\", Reason: \"尚未查看证据\"}); err == nil {\n\t\tt.Fatal(\"decision without evidence\")\n\t}\n\tif _, err = g.Evidence(ctx, admin, report, \"1\", \"\", \"查看被举报原消息\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"block\", Reason: \"确认需要屏蔽\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpage, err := g.history.Read(ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif err != nil || len(page.Messages) != 1 || page.Messages[0].Text != nil || page.Messages[0].State != \"blocked\" {\n\t\tt.Fatal(\"block projection\", page, err)\n\t}\n\tif _, err = g.Decide(ctx, admin, CaseDecision{ID: report, Expected: \"1\", Action: \"dismiss\", Reason: \"旧版本不能覆盖\"}); err == nil {\n\t\tt.Fatal(\"stale decision\")\n\t}\n}\n","chat/internal/message/reminders_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"sync\"\n\t\"testing\"\n)\n\ntype reminderCapture struct {\n\tmu    sync.Mutex\n\tcalls []ports.Reminder\n\tlose  bool\n}\n\nfunc (c *reminderCapture) Submit(_ context.Context, q ports.Reminder) (ports.Receipt, error) {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tc.calls = append(c.calls, q)\n\tif c.lose {\n\t\tc.lose = false\n\t\treturn ports.Receipt{}, ports.ErrUnavailable\n\t}\n\treturn ports.Receipt{OperationID: q.OperationID, State: \"accepted\"}, nil\n}\nfunc (c *reminderCapture) Status(_ context.Context, op string) (ports.Receipt, error) {\n\treturn ports.Receipt{OperationID: op, State: \"sent\", Diagnostic: \"sent\"}, nil\n}\nfunc TestMySQLS20DurableEventsFixedDueRetryAndReadSuppression(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{lose: true}\n\tr, err := NewReminderService(s, capture)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfirst := accepted(t, s, q)\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_events WHERE processed_at IS NULL\") != \"1\" {\n\t\tt.Fatal(\"publication lost durable event\")\n\t}\n\t// A new instance represents process death after message commit.\n\tr, _ = NewReminderService(s, capture)\n\tif err = r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdue := f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\")\n\tq.ClientMessageID = client(42)\n\taccepted(t, s, q)\n\tif err = r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT next_due FROM chat_reminder_clusters WHERE recipient_id=10203\") != due {\n\t\tt.Fatal(\"new message postponed first reminder\")\n\t}\n\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err = r.Prepare(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"1\" {\n\t\tt.Fatal(\"not one aggregate round\")\n\t}\n\tif err = r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_reminder_intents SET next_attempt_at=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err = r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(capture.calls) != 2 || capture.calls[0].OperationID != capture.calls[1].OperationID {\n\t\tt.Fatal(\"ambiguous PHP result changed operation\")\n\t}\n\top := capture.calls[1].OperationID\n\tif allowed, err := r.Eligible(f.ctx, op); err != nil || !allowed {\n\t\tt.Fatal(\"online is not read\", allowed, err)\n\t}\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(\"12345678901234567890123456789012\"), s.timeout)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tpage, err := h.Read(f.ctx, principal(\"10203\"), HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = h.Acknowledge(f.ctx, principal(\"10203\"), q.ConversationID, page.SyncCursor); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif allowed, err := r.Eligible(f.ctx, op); err != nil || allowed {\n\t\tt.Fatal(\"read did not suppress queued reminder\", allowed, err)\n\t}\n\tif first.MessageID == \"\" || f.text(\"SELECT COUNT(*) FROM notifications\") != \"0\" {\n\t\tt.Fatal(\"per-message business notices created\")\n\t}\n}\nfunc TestMySQLS20RoundsBudgetRecallAndPermissionRevocation(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{}\n\tr, _ := NewReminderService(s, capture)\n\tmsg := accepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor i := 0; i < 5; i++ {\n\t\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\t\tif err := r.Prepare(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := r.SubmitPending(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := r.Reconcile(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"3\" {\n\t\tt.Fatal(\"continued unread exceeded three rounds\")\n\t}\n\tif f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=10203\") != \"3\" {\n\t\tt.Fatal(\"chat-only budget mismatch\")\n\t}\n\tif err := r.SubmitPending(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(capture.calls) != 3 {\n\t\tt.Fatal(capture.calls)\n\t}\n\tif _, err := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, msg.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif ok, err := r.Eligible(f.ctx, capture.calls[0].OperationID); err != nil || ok {\n\t\tt.Fatal(\"recall still reminded\", ok, err)\n\t}\n\tq.ClientMessageID = client(49)\n\taccepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// The original member epoch is revoked in PHP before the worker projects it.\n\tf.exec(\"UPDATE system_settings SET setting_value='[]' WHERE setting_key='wechat.admin_openids'\")\n\tif ok, err := r.Eligible(f.ctx, capture.calls[1].OperationID); err != nil || ok {\n\t\tt.Fatal(\"revoked recipient reminded\", ok, err)\n\t}\n}\n\nfunc TestS20ReminderConfigBounds(t *testing.T) {\n\tc := DefaultReminderConfig()\n\tif c.FirstDelaySeconds != 10 || c.Validate() != nil {\n\t\tt.Fatal(\"default reminder policy\")\n\t}\n\tc.FirstDelaySeconds = 31\n\tif c.Validate() == nil {\n\t\tt.Fatal(\"first due exceeded 30-second policy\")\n\t}\n\tc = DefaultReminderConfig()\n\tc.PlatformHourly = 0\n\tif c.Validate() == nil {\n\t\tt.Fatal(\"unbounded platform budget\")\n\t}\n}\nfunc TestMySQLS20ChannelLimitsReleaseReservationsWithoutCountingSuccess(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tcapture := &reminderCapture{}\n\tr, _ := NewReminderService(s, capture)\n\taccepted(t, s, q)\n\tif err := r.DrainEvents(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\tif err := r.Prepare(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\top := f.text(\"SELECT operation_id FROM chat_reminder_intents LIMIT 1\")\n\tif err := r.reconcileOne(f.ctx, op, ports.Receipt{OperationID: op, State: \"channel_limited\", Diagnostic: \"template_unavailable\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT rounds FROM chat_reminder_clusters\") != \"0\" || f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=10203\") != \"0\" || f.text(\"SELECT hour_count FROM chat_reminder_budgets WHERE recipient_id=0\") != \"0\" {\n\t\tt.Fatal(\"channel failure counted as successful reminder\")\n\t}\n\tif f.text(\"SELECT state FROM chat_reminder_clusters\") != \"channel_limited\" {\n\t\tt.Fatal(\"channel diagnostic lost\")\n\t}\n\tfor i := 0; i < 3; i++ {\n\t\tif err := r.Prepare(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_intents\") != \"1\" {\n\t\tt.Fatal(\"channel limit created endless new rounds\")\n\t}\n}\n","server/tests/chat_reminder_contract.php":"<?php\ndeclare(strict_types=1);\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'){echo \"提醒数据库验证未启用\\n\";exit;}\nrequire_once dirname(__DIR__).'/app/Support/functions.php';\nspl_autoload_register(static function(string $class):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)===0){$file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require_once $file;}});\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderReceipts;\nuse WorkerAdmin\\Application\\Chat\\ChatReminderDispatch;\nuse WorkerAdmin\\Infrastructure\\Messaging\\ChatInternalAuth;\nuse WorkerAdmin\\Contracts\\SubscribeMessageGateway;\nfunction reminderEnsure(bool $ok,string $message):void{if(!$ok)throw new RuntimeException($message);}\nfinal class ReminderGatewayFixture implements SubscribeMessageGateway{\n public int $calls=0;public bool $fail=false;\n public function categoryList():array{return [];}public function publicTemplateTitles(array $ids,int $start=0,int $limit=30):array{return [];}\n public function publicTemplateKeywords(string $tid):array{return [];}public function addTemplate(string $tid,array $kids,string $desc=''):string{return '';}\n public function templateList():array{return [];}\n public function send(array $payload):array{$this->calls++;reminderEnsure(!isset($payload['sms_fallback'])&&$payload['scene_key']==='chat_unread','chat SMS fallback or wrong scene');if($this->fail)throw new RuntimeException('accepted but transport result lost');return ['ok'=>true];}\n}\n$address=(string)getenv('CHAT_INTEGRATION_MYSQL_ADDR');if(preg_match('/^127\\.0\\.0\\.1:([0-9]+)$/D',$address,$m)!==1)throw new RuntimeException('loopback required');\n$config=['host'=>'127.0.0.1','port'=>(int)$m[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$root=new Database($config);$name='bixuan_test_chat_reminder_'.bin2hex(random_bytes(6));$root->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$GLOBALS['worker_admin_config']=['database'=>$config];$db=db();\ntry{\n (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n $db->execute(\"INSERT INTO users(id,public_id,nickname,status,created_at,updated_at) VALUES(10001,:public,'提醒隔离用户','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>str_repeat('U',26)]);\n $db->execute(\"INSERT INTO wechat_identities(user_id,app_id,openid,status,created_at,updated_at) VALUES(10001,'fixture-app','fixture-openid','active',UTC_TIMESTAMP(),UTC_TIMESTAMP())\");\n $settings=['wechat.subscribe_enabled'=>['1','bool'],'wechat.subscribe_template_ids'=>[json_encode(['chat_unread'=>['template_id'=>'fixture-template','field_map'=>['status'=>'thing1','time'=>'time2']]]),'json'],\n 'wechat.subscription.user.10001'=>[json_encode(['chat_unread'=>['enabled'=>true,'authorization_status'=>'accept','remaining_count'=>5,'subscription_type'=>'one_time']]),'json']];\n foreach($settings as $key=>$value)$db->execute(\"INSERT INTO system_settings(setting_key,setting_value,value_type,group_name,is_public,description,created_at,updated_at) VALUES(:key,:value,:type,'notification',0,'隔离测试',UTC_TIMESTAMP(),UTC_TIMESTAMP()) ON DUPLICATE KEY UPDATE setting_value=VALUES(setting_value),value_type=VALUES(value_type)\",['key'=>$key,'value'=>$value[0],'type'=>$value[1]]);\n $receipts=new ChatReminderReceipts($db);\n $body=static function(string $op):string{$q=['cluster_version'=>'1','conversation_id'=>'401','intent_id'=>'1','operation_id'=>$op,'recipient_id'=>'10001','target_seq'=>'2'];return json_encode($q,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);};\n $a=str_repeat('a',64);$raw=$body($a);\n $auth=new ChatInternalAuth($db,'test','internal-fixture',str_repeat('k',32));$headers=[];\n foreach($auth->sign('/chat-internal.php',$raw) as $line){[$key,$value]=explode(': ',$line,2);$headers[strtolower(substr($key,7))]=$value;}\n $auth->verify('/chat-internal.php',$raw,$headers);\n $replayed=false;try{$auth->verify('/chat-internal.php',$raw,$headers);}catch(RuntimeException $error){$replayed=true;}reminderEnsure($replayed,'internal replay accepted');\n $tamper=false;try{$auth->verify('/chat-internal.php',$raw.' ',$headers);}catch(RuntimeException $error){$tamper=true;}reminderEnsure($tamper,'tampered body accepted');\n for($i=0;$i<3;$i++)reminderEnsure($receipts->receive($raw)['state']==='accepted','receipt changed');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\")===1,'duplicate PHP receipt duplicated outbox');\n $conflict=false;try{$receipts->receive(str_replace('\"target_seq\":\"2\"','\"target_seq\":\"3\"',$raw));}catch(RuntimeException $error){$conflict=true;}reminderEnsure($conflict,'immutable operation payload changed');\n $gateway=new ReminderGatewayFixture();\n $dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>false);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===0&&$stats['suppressed']===1,'read message sent');\n $b=str_repeat('b',64);$receipts->receive($body($b));$dispatcher=new ChatReminderDispatch($db,$gateway,static fn(string $op):bool=>true);$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===1&&$stats['sent']===1,'unread not sent once');\n $c=str_repeat('c',64);$receipts->receive($body($c));$gateway->fail=true;$stats=$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['unknown']===1,'provider unknown not recorded');\n $db->execute(\"UPDATE message_outbox SET status='failed',next_attempt_at=UTC_TIMESTAMP() WHERE business_key=:key\",['key'=>'chat:'.$c]);$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$receipts->receive($body($c))['state']==='provider_unknown','unknown provider blindly retried');\n reminderEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='aliyun_sms'\")===0,'unknown fell back to paid SMS');\n $d=str_repeat('d',64);$receipts->receive($body($d));$checks=0;$final=new ChatReminderDispatch($db,$gateway,static function(string $op)use(&$checks):bool{return ++$checks===1;});$stats=$final->dispatch();\n reminderEnsure($gateway->calls===2&&$stats['suppressed']===1,'final read check missed');\n $e=str_repeat('e',64);$receipts->receive($body($e));$db->execute(\"UPDATE chat_reminder_receipts SET state='sending',updated_at=UTC_TIMESTAMP()-INTERVAL 6 MINUTE WHERE operation_id=:op\",['op'=>$e]);\n $dispatcher->dispatch();reminderEnsure($receipts->receive($body($e))['state']==='provider_unknown'&&$gateway->calls===2,'crashed sender retried');\n $large=str_repeat('f',64);$largeBody=str_replace('\"recipient_id\":\"10001\"','\"recipient_id\":\"18446744073709551615\"',$body($large));$receipts->receive($largeBody);$dispatcher->dispatch();\n reminderEnsure($gateway->calls===2&&$receipts->status($large)['diagnostic']==='recipient_id_unsupported','unsigned recipient ID saturated into another channel account');\n echo \"S20 PHP 内部签名/重放、幂等回执、最终未读复验、供应商未知、ID精度与短信隔离验证通过\\n\";\n}finally{$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n","chat/internal/dependencies/governance.go":"package dependencies\n\nimport (\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http\"\n)\n\n// Explicit composition for the S21-S23 isolated/release composition root. No\n// call is made by the still-closed production bootstrap.\ntype Governance struct {\n\tService      *message.GovernanceService\n\tHTTP         http.Handler\n\tReminders    *message.ReminderService\n\tInternalHTTP http.Handler\n}\n\nfunc (r *Runtime) ComposeGovernance(base *message.Service, media *message.MediaService, n ports.Notification, internal *auth.InternalAuth) (*Governance, error) {\n\tif r.History == nil || r.Identity == nil || base == nil || n == nil || internal == nil {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\tg, err := message.NewGovernanceService(base, r.History, media, r.environment)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\th, err := message.NewGovernanceHandler(g, r.Identity, 8)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treminders, err := message.NewReminderService(base, n)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tih, err := message.NewReminderInternalHandler(reminders, internal)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn &Governance{g, h, reminders, ih}, nil\n}\n","chat/internal/message/governance_maintenance.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/policy\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// One bounded pass. S22 owns wider archive/backup policy; this pass expires\n// governance evidence holds only after every linked case's retention ends.\nfunc (g *GovernanceService) ExpireEvidence(ctx context.Context) error {\n\treturn expireGovernanceEvidence(ctx, g.base.db, g.environment)\n}\nfunc expireGovernanceEvidence(ctx context.Context, db *sql.DB, environment string) error {\n\t// Risk TTL may be later than its original review case (action cutoff +30d).\n\t// Revisit due risk evidence independently, even after that case was expired.\n\tif _, err := db.ExecContext(ctx, `UPDATE chat_risk_events SET text_evidence='',context_evidence='' WHERE retain_until<=UTC_TIMESTAMP(6) AND (text_evidence<>'' OR context_evidence<>'') AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='risk' AND c.target_id=chat_risk_events.id AND c.retain_until>UTC_TIMESTAMP(6)) ORDER BY retain_until,id LIMIT 30`); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\trows, err := db.QueryContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_cases WHERE retain_until<=UTC_TIMESTAMP(6) AND state<>'expired' ORDER BY retain_until,id LIMIT 30`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\ttx, err := db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// Expired cases cannot be opened through caseLock; lock in the same order.\n\t\tvar subject, cid ports.ID\n\t\tif tx.QueryRowContext(ctx, `SELECT CAST(subject_id AS CHAR),CAST(conversation_id AS CHAR) FROM chat_cases WHERE id=?`, string(id)).Scan(&subject, &cid) != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif _, err = restrictionLocked(ctx, tx, subject); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif cid != \"0\" {\n\t\t\tvar n int\n\t\t\tif tx.QueryRowContext(ctx, `SELECT 1 FROM chat_conversations WHERE id=? FOR UPDATE`, string(cid)).Scan(&n) != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t\tc, err := scanCase(tx.QueryRowContext(ctx, `SELECT `+caseColumns+` FROM chat_cases WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) FOR UPDATE`, string(id)))\n\t\tif err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif c.State == \"expired\" {\n\t\t\ttx.Rollback()\n\t\t\tcontinue\n\t\t}\n\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_cases SET resolution=CONCAT('expired:',state),reason='',state='expired',version=version+1 WHERE id=?`, string(id)); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif c.TargetType == \"risk\" {\n\t\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_risk_events SET text_evidence='',context_evidence='' WHERE id=? AND retain_until<=UTC_TIMESTAMP(6) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='risk' AND c.target_id=chat_risk_events.id AND c.retain_until>UTC_TIMESTAMP(6))`, string(c.Target))\n\t\t}\n\t\tif err == nil && (c.TargetType == \"message\" || c.TargetType == \"image_intent\") {\n\t\t\titems, e := caseImageItems(ctx, tx, c)\n\t\t\tif e != nil {\n\t\t\t\ttx.Rollback()\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tfor _, item := range items {\n\t\t\t\t_, err = tx.ExecContext(ctx, `UPDATE chat_image_uploads u SET legal_hold=0 WHERE u.id=? AND NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_image_items i ON c.target_type='message' AND c.target_id=i.message_id WHERE i.item_id=u.id AND c.retain_until>UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.target_type='image_intent' AND c.subject_id=u.actor_id AND c.conversation_id=u.conversation_id AND c.retain_until>UTC_TIMESTAMP(6))`, string(item.ItemID))\n\t\t\t\tif err != nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tsys := ports.Principal{Kind: \"system\", ActorID: \"0\", Environment: environment}\n\t\tif err = governanceLog(ctx, tx, sys, \"evidence.expire\", c.Conversation, c.ID, c.Item, decimal(number(c.Version)+1), \"治理证据保留期结束\"); err != nil {\n\t\t\ttx.Rollback()\n\t\t\treturn err\n\t\t}\n\t\tif tx.Commit() != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) Maintain(ctx context.Context, reminders *ReminderService) error {\n\tif err := g.ExpireRestrictions(ctx); err != nil {\n\t\treturn err\n\t}\n\tif err := g.CleanupSnapshots(ctx); err != nil {\n\t\treturn err\n\t}\n\tif err := g.ExpireEvidence(ctx); err != nil {\n\t\treturn err\n\t}\n\tif reminders != nil {\n\t\tif err := reminders.Reconcile(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := reminders.DrainEvents(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := reminders.Prepare(ctx); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn reminders.SubmitPending(ctx)\n\t}\n\treturn nil\n}\nfunc (g *GovernanceService) Run(ctx context.Context, reminders *ReminderService) {\n\tticker := time.NewTicker(time.Second)\n\tdefer ticker.Stop()\n\tfor {\n\t\tpass, cancel := context.WithTimeout(ctx, 10*time.Second)\n\t\t_ = g.Maintain(pass, reminders)\n\t\tcancel()\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n}\n\nfunc (r *ReminderService) Reconcile(ctx context.Context) error {\n\treader, ok := r.notification.(reminderReceipts)\n\tif !ok {\n\t\treturn nil\n\t}\n\trows, err := r.base.db.QueryContext(ctx, `SELECT operation_id FROM chat_reminder_intents WHERE (state IN ('submitted','provider_unknown') OR (state='retryable' AND attempts>=8)) AND (next_receipt_at IS NULL OR next_receipt_at<=UTC_TIMESTAMP(6)) ORDER BY next_receipt_at,id LIMIT 20`)\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tops := []string{}\n\tfor rows.Next() {\n\t\tvar op string\n\t\tif rows.Scan(&op) != nil {\n\t\t\trows.Close()\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tops = append(ops, op)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tfor _, op := range ops {\n\t\tif _, err = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET next_receipt_at=UTC_TIMESTAMP(6)+INTERVAL 30 SECOND WHERE operation_id=?`, op); err != nil {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\treceipt, e := reader.Status(ctx, op)\n\t\tif e != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif receipt.OperationID != op {\n\t\t\treturn ports.ErrUnavailable\n\t\t}\n\t\tif receipt.State != \"accepted\" {\n\t\t\tif e = r.reconcileOne(ctx, op, receipt); e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t} else {\n\t\t\tif _, e = r.base.db.ExecContext(ctx, `UPDATE chat_reminder_intents SET state='submitted' WHERE operation_id=? AND state='retryable'`, op); e != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *ReminderService) reconcileOne(ctx context.Context, op string, receipt ports.Receipt) error {\n\tif receipt.State != \"sent\" && receipt.State != \"suppressed\" && receipt.State != \"channel_limited\" && receipt.State != \"provider_unknown\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar c reminderCluster\n\tif r.base.db.QueryRowContext(ctx, `SELECT CAST(cluster_id AS CHAR),CAST(conversation_id AS CHAR),CAST(recipient_id AS CHAR),member_hash FROM chat_reminder_intents WHERE operation_id=?`, op).Scan(&c.ID, &c.CID, &c.Actor, &c.Hash) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\ttx, err := r.base.begin(ctx)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer tx.Rollback()\n\t// Current PHP guard/account -> conversation -> cluster -> intent -> budget.\n\tw, windowErr := r.window(ctx, tx, c.CID, c.Actor, ^uint64(0))\n\terr = windowErr\n\tif err != nil && err != policy.ErrDenied {\n\t\treturn err\n\t}\n\tvar currentVersion uint64\n\tif tx.QueryRowContext(ctx, `SELECT round_version,rounds FROM chat_reminder_clusters WHERE id=? FOR UPDATE`, string(c.ID)).Scan(&currentVersion, &c.Round) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tvar version, target uint64\n\tvar round int\n\tvar state string\n\tvar created time.Time\n\tvar released bool\n\tif tx.QueryRowContext(ctx, `SELECT round_version,round_no,target_seq,state,created_at,budget_released FROM chat_reminder_intents WHERE operation_id=? FOR UPDATE`, op).Scan(&version, &round, &target, &state, &created, &released) != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif state == \"sent\" || state == \"suppressed\" || state == \"channel_limited\" {\n\t\treturn nil\n\t}\n\tif receipt.State == \"suppressed\" || receipt.State == \"channel_limited\" {\n\t\tif !released {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_budgets SET hour_count=GREATEST(0,CAST(hour_count AS SIGNED)-IF(hour_start<=?,1,0)),day_count=GREATEST(0,CAST(day_count AS SIGNED)-IF(day_start=DATE(?),1,0)) WHERE recipient_id IN (0,?)`, created, created, string(c.Actor)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t\treleased = true\n\t\t}\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_intents SET state=?,diagnostic=?,budget_released=? WHERE operation_id=?`, receipt.State, receipt.Diagnostic, released, op); err != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\tif version == currentVersion {\n\t\tif receipt.State == \"sent\" && round == c.Round+1 {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET rounds=?,last_notified_seq=GREATEST(last_notified_seq,?),first_notified_at=COALESCE(first_notified_at,UTC_TIMESTAMP(6)),next_due=TIMESTAMPADD(MINUTE,?,COALESCE(first_notified_at,UTC_TIMESTAMP(6))),state=IF(? >= 3,'exhausted','open'),blocked_reason=NULL WHERE id=?`, round, target, 5+(round-1)*10, round, string(c.ID)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t} else if receipt.State == \"channel_limited\" || receipt.State == \"provider_unknown\" {\n\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state=?,blocked_reason=? WHERE id=?`, receipt.State, receipt.Diagnostic, string(c.ID)); err != nil {\n\t\t\t\treturn ports.ErrUnavailable\n\t\t\t}\n\t\t} else if receipt.State == \"suppressed\" {\n\t\t\tif windowErr == nil && w.First > 0 && w.Read >= target {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET round_version=round_version+1,first_seq=?,target_seq=?,first_due_at=TIMESTAMPADD(SECOND,?,?),next_due=TIMESTAMPADD(SECOND,?,?),first_notified_at=NULL,rounds=0,state='open',blocked_reason=NULL WHERE id=?`, w.First, w.Target, r.config.FirstDelaySeconds, w.At, r.config.FirstDelaySeconds, w.At, string(c.ID)); err != nil {\n\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif _, err = tx.ExecContext(ctx, `UPDATE chat_reminder_clusters SET state=IF(target_seq<=?,'closed',state),blocked_reason=? WHERE id=?`, target, receipt.Diagnostic, string(c.ID)); err != nil {\n\t\t\t\t\treturn ports.ErrUnavailable\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif tx.Commit() != nil {\n\t\treturn ports.ErrUnavailable\n\t}\n\treturn nil\n}\n","server/app/Support/functions.php":"<?php\n\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Core\\View;\n\n// 2026-08-14：集中提供后台通用帮助函数，避免页面重复处理配置、转义与安全逻辑。\nfunction base_path($path = '')\n{\n    $base = defined('WORKER_BASE_PATH') ? WORKER_BASE_PATH : dirname(__DIR__, 2);\n    return $path === '' ? $base : $base . DIRECTORY_SEPARATOR . ltrim(str_replace(['/', '\\\\'], DIRECTORY_SEPARATOR, $path), DIRECTORY_SEPARATOR);\n}\n\nfunction app_config($key = null, $default = null)\n{\n    $config = isset($GLOBALS['worker_admin_config']) ? $GLOBALS['worker_admin_config'] : [];\n    if ($key === null || $key === '') {\n        return $config;\n    }\n\n    $value = $config;\n    foreach (explode('.', (string) $key) as $segment) {\n        if (!is_array($value) || !array_key_exists($segment, $value)) {\n            return $default;\n        }\n        $value = $value[$segment];\n    }\n    return $value;\n}\n\nfunction is_installed()\n{\n    return (bool) app_config('installed', false)\n        && is_file(base_path('config/installed.php'))\n        && is_file(base_path('storage/install.lock'));\n}\n\n// 2026-08-14：发布新代码后若配置版本尚未同步，后台仅允许登录并进入升级页，API 与计划任务保持暂停。\nfunction upgrade_required()\n{\n    return !empty($GLOBALS['worker_admin_upgrade_required']);\n}\n\nfunction db()\n{\n    static $database;\n    if (!$database) {\n        $config = (array) app_config('database', []);\n        if (empty($config['database']) && !empty($config['name'])) {\n            $config['database'] = $config['name'];\n        }\n        $database = new Database($config);\n    }\n    return $database;\n}\n\nfunction auth()\n{\n    static $auth;\n    if (!$auth) {\n        $auth = new Auth(db());\n    }\n    return $auth;\n}\n\nfunction csrf()\n{\n    static $csrf;\n    if (!$csrf) {\n        $csrf = new Csrf();\n    }\n    return $csrf;\n}\n\nfunction view($template, array $data = [], $layout = 'layouts/admin')\n{\n    return (new View(base_path('views')))->render($template, $data, $layout);\n}\n\nfunction e($value)\n{\n    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n}\n\nfunction app_url($path = '')\n{\n    $base = rtrim((string) app_config('app.url', ''), '/');\n    if ($base === '' && PHP_SAPI !== 'cli') {\n        $https = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')\n            || (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https');\n        $host = isset($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost';\n        $base = ($https ? 'https://' : 'http://') . $host;\n    }\n    return $base . ($path === '' ? '' : '/' . ltrim($path, '/'));\n}\n\nfunction admin_url($route = 'dashboard', array $params = [])\n{\n    $params = array_merge(['route' => $route], $params);\n    return app_url('admin/?' . http_build_query($params));\n}\n\nfunction asset_url($path)\n{\n    // 后台热修不提升数据库版本时，追加文件指纹刷新 CSS/JS，避免浏览器或 CDN 继续命中旧 2.4.0 静态资源。\n    $version = (string) app_config('app.version', app_config('version', '2.4.0'));\n    $relative = ltrim((string) $path, '/');\n    $assetPath = dirname(__DIR__, 2) . '/assets/' . $relative;\n    $fingerprint = '';\n    if (is_file($assetPath)) {\n        $mtime = @filemtime($assetPath);\n        $size = @filesize($assetPath);\n        if ($mtime !== false && $size !== false) $fingerprint = '-' . (string) $mtime . '-' . (string) $size;\n    }\n    return app_url('assets/' . $relative) . '?v=' . rawurlencode($version . $fingerprint);\n}\n\nfunction redirect($url, $status = 302)\n{\n    header('Location: ' . $url, true, $status);\n    exit;\n}\n\nfunction json_response(array $data, $status = 200)\n{\n    http_response_code((int) $status);\n    header('Content-Type: application/json; charset=utf-8');\n    // 2026-09-22：鉴权 API 可能位于 ESA/CDN 后方；显式禁止浏览器、代理和共享缓存保存或串用敏感响应。\n    header('Cache-Control: no-store, private, max-age=0');\n    header('Surrogate-Control: no-store');\n    header('Pragma: no-cache');\n    header('Expires: 0');\n    header('Vary: Authorization', false);\n    echo json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n    exit;\n}\n\nfunction request_id()\n{\n    static $id;\n    if (!$id) {\n        try {\n            $id = bin2hex(random_bytes(8));\n        } catch (Exception $exception) {\n            $id = str_replace('.', '', uniqid('', true));\n        }\n    }\n    return $id;\n}\n\nfunction request_ip()\n{\n    $ip = isset($_SERVER['REMOTE_ADDR']) ? (string) $_SERVER['REMOTE_ADDR'] : '127.0.0.1';\n    return substr($ip, 0, 45);\n}\n\nfunction write_log($channel, $message)\n{\n    $directory = base_path('storage/logs');\n    if (!is_dir($directory)) {\n        @mkdir($directory, 0775, true);\n    }\n    @file_put_contents($directory . DIRECTORY_SEPARATOR . preg_replace('/[^a-z0-9_-]/i', '', $channel) . '.log', $message, FILE_APPEND | LOCK_EX);\n}\n\nfunction flash($type = null, $message = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return null;\n    }\n    if ($type !== null && $message !== null) {\n        $_SESSION['_flash'][$type][] = (string) $message;\n        return null;\n    }\n    $messages = isset($_SESSION['_flash']) ? $_SESSION['_flash'] : [];\n    unset($_SESSION['_flash']);\n    return $messages;\n}\n\nfunction old_input(array $values = null)\n{\n    if (session_status() !== PHP_SESSION_ACTIVE) {\n        return [];\n    }\n    if ($values !== null) {\n        $_SESSION['_old_input'] = $values;\n        return [];\n    }\n    $old = isset($_SESSION['_old_input']) ? $_SESSION['_old_input'] : [];\n    unset($_SESSION['_old_input']);\n    return $old;\n}\n\nfunction money($cents)\n{\n    return '¥' . number_format(((int) $cents) / 100, 2);\n}\n\n// 2026-08-14：数据库统一保存 UTC，后台所有可见时间通过此函数转换为站点时区，避免中国管理员看到时间少八小时。\nfunction local_datetime($value, $format = 'Y-m-d H:i')\n{\n    $value = trim((string) $value);\n    if ($value === '' || $value === '0000-00-00 00:00:00') {\n        return '—';\n    }\n    try {\n        $date = new DateTimeImmutable($value, new DateTimeZone('UTC'));\n        return $date->setTimezone(new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai')))->format((string) $format);\n    } catch (Throwable $exception) {\n        return $value;\n    }\n}\n\n// 2026-08-14：生成不含易混淆字符的 26 位公开标识，数据库只暴露该标识而不暴露自增主键。\nfunction public_id()\n{\n    $alphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\n    $bytes = random_bytes(26);\n    $id = '';\n    for ($index = 0; $index < 26; $index++) {\n        $id .= $alphabet[ord($bytes[$index]) & 31];\n    }\n    return $id;\n}\n\n// 2026-08-14：业务单号包含类型、UTC 时间与随机尾号，便于人工检索且避免并发冲突。\nfunction business_no($prefix)\n{\n    return strtoupper(preg_replace('/[^A-Z0-9]/i', '', (string) $prefix))\n        . gmdate('YmdHis')\n        . substr(public_id(), -6);\n}\n\n// 新订单号：BX + 两位类目码 + YYMMDD + '-' + 六位安全随机码。历史订单号保持不变。\n// 生成函数不访问数据库；订单表 public_no 唯一索引与写入端重试负责处理极少数碰撞。\nfunction order_business_no($categoryCode)\n{\n    $code = strtoupper(preg_replace('/[^A-Z]/i', '', (string) $categoryCode));\n    $code = strlen($code) === 2 ? $code : 'QT';\n    $alphabet = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';\n    $suffix = '';\n    for ($i = 0; $i < 6; $i++) {\n        $suffix .= $alphabet[random_int(0, strlen($alphabet) - 1)];\n    }\n    $date = (new DateTimeImmutable('now', new DateTimeZone((string) app_config('app.timezone', 'Asia/Shanghai'))))->format('ymd');\n    return 'BX' . $code . $date . '-' . $suffix;\n}\n\n// 2026-08-23：后台新增订单和云数据同步统一生成姓名、手机号的最小必要脱敏展示值。\nfunction mask_private_name($value)\n{\n    $value = trim((string) $value);\n    if ($value === '') {\n        return '';\n    }\n    $length = function_exists('mb_strlen') ? mb_strlen($value, 'UTF-8') : strlen($value);\n    $first = function_exists('mb_substr') ? mb_substr($value, 0, 1, 'UTF-8') : substr($value, 0, 1);\n    return $first . str_repeat('*', max(1, min(3, $length - 1)));\n}\n\nfunction mask_private_mobile($value)\n{\n    $digits = preg_replace('/\\D+/', '', (string) $value);\n    if (strlen($digits) < 7) {\n        return $digits === '' ? '' : substr($digits, 0, 2) . '***';\n    }\n    return substr($digits, 0, 3) . str_repeat('*', max(4, strlen($digits) - 7)) . substr($digits, -4);\n}\n\n// 2026-08-23：使用安装时生成的站点密钥加密微信支付、短信、云开发和订单隐私字段。\nfunction encrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if ($value === '') {\n        return null;\n    }\n    $appKey = (string) app_config('app.key', '');\n    if ($appKey === '' || !function_exists('openssl_encrypt')) {\n        throw new RuntimeException('站点加密密钥或 OpenSSL 不可用，无法保存敏感内容。');\n    }\n    $key = hash('sha256', $appKey, true);\n    $nonce = random_bytes(12);\n    $tag = '';\n    $ciphertext = openssl_encrypt($value, 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $nonce, $tag, (string) $context, 16);\n    if (!is_string($ciphertext)) {\n        throw new RuntimeException('敏感内容加密失败。');\n    }\n    return 'enc:v1:' . base64_encode($nonce . $tag . $ciphertext);\n}\n\nfunction decrypt_private_value($value, $context = 'private')\n{\n    $value = (string) $value;\n    if (strpos($value, 'enc:v1:') !== 0) {\n        return $value;\n    }\n    $payload = base64_decode(substr($value, 7), true);\n    $appKey = (string) app_config('app.key', '');\n    if (!is_string($payload) || strlen($payload) < 29 || $appKey === '' || !function_exists('openssl_decrypt')) {\n        return '';\n    }\n    $plaintext = openssl_decrypt(substr($payload, 28), 'aes-256-gcm', hash('sha256', $appKey, true), OPENSSL_RAW_DATA, substr($payload, 0, 12), substr($payload, 12, 16), (string) $context);\n    return is_string($plaintext) ? $plaintext : '';\n}\n\nfunction private_value_hmac($value, $context = 'private')\n{\n    return hash_hmac('sha256', (string) $value, hash('sha256', (string) app_config('app.key', ''), true) . (string) $context);\n}\n\nfunction status_meta($status)\n{\n    $map = [\n        'pending' => ['待处理', 'warning'], 'pending_review' => ['待审核', 'warning'],\n        'approved' => ['已通过', 'success'], 'active' => ['正常', 'success'],\n        'published' => ['已公开', 'info'], 'paid' => ['已支付', 'success'],\n        'completed' => ['已完成', 'success'], 'success' => ['成功', 'success'],\n        'rejected' => ['已驳回', 'danger'], 'cancelled' => ['已取消', 'muted'],\n        'canceled' => ['已取消', 'muted'], 'disabled' => ['已停用', 'muted'],\n        'failed' => ['失败', 'danger'], 'refunding' => ['退款中', 'warning'],\n        'unpaid' => ['未支付', 'muted'], 'processing' => ['处理中', 'info'],\n        'open' => ['处理中', 'warning'], 'resolved' => ['已解决', 'success'],\n        'hidden' => ['已隐藏', 'muted'], 'visible' => ['显示', 'success'],\n        'waiting' => ['等待报价', 'warning'], 'collecting' => ['报价中', 'info'],\n        'offered' => ['待师傅接单', 'warning'], 'accepted' => ['已接受', 'success'],\n        'supplement_required' => ['待补资料', 'warning'], 'suspended' => ['已暂停', 'danger'],\n        'none' => ['无', 'muted'], 'created' => ['已创建', 'warning'],\n        'cancel_approved_pending_refund' => ['已取消待退款', 'warning'],\n        'succeeded' => ['退款成功', 'success'], 'archived' => ['已归档', 'muted'],\n        'draft' => ['草稿', 'warning'], 'payment_failed' => ['付款失败', 'danger'],\n        'claimed' => ['已领取', 'success'], 'revoked' => ['已撤销', 'muted'],\n        'expired' => ['已过期', 'muted'], 'overdue' => ['已逾期', 'danger'],\n        'acknowledged' => ['已知悉', 'info'],\n        'quoting' => ['报价中', 'info'], 'selected' => ['已选报价', 'success'],\n        'unassigned' => ['待安排', 'warning'], 'assigned' => ['已安排', 'info'],\n        'info_released' => ['已开放信息', 'success'], 'not_started' => ['未开始', 'muted'],\n        'scheduled' => ['已预约', 'info'], 'refunded' => ['已退款', 'success'],\n        'awaiting_payment' => ['待付预约费', 'warning'], 'in_progress' => ['施工中', 'info'],\n        'submitted' => ['待验收', 'warning'], 'confirmed' => ['已确认', 'success'],\n        'settled' => ['已抵扣结清', 'success'], 'released' => ['已释放', 'muted'],\n        'deleted' => ['已删除', 'muted'], 'user' => ['用户责任', 'danger'],\n        'worker' => ['师傅责任', 'danger'], 'platform' => ['平台责任', 'warning'],\n        'shared' => ['双方协商', 'info'], 'unclear' => ['责任不清', 'warning'],\n        'undetermined' => ['待判定', 'warning'], 'user_schedule_change' => ['用户行程原因', 'info'],\n        'draft_pending_upload' => ['待上传图片', 'warning'], 'pending_payment' => ['待付款', 'warning'],\n        'selected_pending_payment' => ['已选报价待付款', 'warning'], 'reviewed' => ['已审核', 'success'],\n        'pending_contact_release' => ['待开放联系信息', 'warning'], 'completed_with_delay' => ['完成但尾款延期', 'warning'],\n        'booking_fee' => ['预约费', 'info'], 'commission' => ['平台服务费', 'info'],\n        'cancel_refund' => ['申请退款并取消订单', 'warning'], 'change_rejected' => ['拒绝加价', 'warning'],\n        // 2026-08-28：补齐后台资源列表、支付、派单和通知中可能出现的枚举中文名。\n        'closed' => ['已关闭', 'muted'], 'requested' => ['待提交', 'warning'],\n        'received' => ['已接收', 'info'], 'sent' => ['已发送', 'success'], 'read' => ['已读', 'success'],\n        'unknown' => ['未确定', 'muted'], 'recorded' => ['已记录', 'info'], 'effective' => ['已生效', 'success'],\n        'locked' => ['已锁定', 'success'], 'superseded' => ['已被新版本替代', 'muted'],\n        'order_booking' => ['订单预约费', 'info'], 'measurement_balance' => ['测量选师傅补款', 'info'], 'measurement_change' => ['测量现场加费', 'info'], 'booking_fee_paid' => ['预约费已支付', 'success'],\n        'worker_quote' => ['师傅报价成交', 'info'], 'admin_assignment' => ['管理员指派', 'info'],\n        'admin' => ['管理员指派', 'info'], 'invite' => ['邀请师傅接单', 'info'],\n        'ordinary_order' => ['普通订单分享', 'info'], 'worker_invite' => ['邀请师傅分享', 'info'],\n        'run_empty_fee' => ['跑空费', 'warning'], 'auto_72h' => ['72小时自动验收', 'info'],\n        'schedule_changed' => ['行程变化', 'info'], 'forced_cancel_refund' => ['强制取消并退款', 'danger'],\n        'change_accepted' => ['同意加价', 'success'], 'construction_issue' => ['施工问题', 'warning'],\n        // 2026-08-29：尾款延期提交即为已登记，只有放弃收款才标记坏账。\n        'reported' => ['已登记', 'info'], 'bad_debt' => ['已标记坏账', 'danger'],\n        // 2026-09-09：实际尾款先自动生效，再由管理员抽查。\n        'auto_approved' => ['自动预审已生效', 'success'],\n        // 2026-09-15：补齐 V2.2.1 预计服务费在验收前的中文状态。\n        'estimate' => ['预计服务费待缴', 'warning'], 'estimate_paid' => ['预计服务费部分已缴', 'info'],\n        'estimate_settled' => ['预计服务费已结清', 'success'],\n    ];\n    return isset($map[$status]) ? $map[$status] : [$status ?: '—', 'muted'];\n}\n\n// 2026-08-25：模板只需要中文状态文字时统一走同一份映射，避免列表与详情翻译不一致。\nfunction status_text($status)\n{\n    $meta = status_meta($status);\n    return $meta[0];\n}\n\n// 2026-08-30：订单专用状态按小程序列表的业务优先级计算，避免 active 被笼统翻译成“正常”。\nfunction order_business_status_meta(array $order)\n{\n    $refundStatus = (string) ($order['refund_status'] ?? '');\n    $lifecycleStatus = (string) ($order['lifecycle_status'] ?? 'active');\n    $auditStatus = (string) ($order['audit_status'] ?? '');\n    $paymentStatus = (string) ($order['payment_status'] ?? '');\n    $fulfillmentStatus = (string) ($order['fulfillment_status'] ?? '');\n    $assignmentStatus = (string) ($order['assignment_status'] ?? '');\n    $quoteStatus = (string) ($order['quote_status'] ?? '');\n    $dispatchMode = (string) ($order['dispatch_mode'] ?? 'multi_quote');\n    $expectedFeeType = (string) ($order['expected_fee_type'] ?? '');\n    $expectedFeeCents = max(0, (int) ($order['expected_fee_cents'] ?? 0));\n\n    if (in_array($refundStatus, ['created', 'pending_review', 'approved', 'processing', 'refunding'], true) || $lifecycleStatus === 'cancel_approved_pending_refund') return ['退款处理中', 'warning'];\n    if ($refundStatus === 'succeeded') return ['已退款', 'success'];\n    if ($lifecycleStatus === 'expired') return ['已到期取消', 'warning'];\n    if ($lifecycleStatus === 'cancelled') return ['已取消', 'danger'];\n    if ($lifecycleStatus === 'completed') return ['已完成', 'success'];\n    if ($auditStatus === 'draft' && $paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($auditStatus === 'draft') return ['草稿', 'muted'];\n    if ($auditStatus === 'pending') return ['待审核', 'warning'];\n    if ($auditStatus === 'supplement_required') return ['待补充资料', 'warning'];\n    if ($auditStatus === 'rejected') return ['审核未通过', 'danger'];\n    if ($fulfillmentStatus === 'accepted') return ['已验收', 'success'];\n    if ($fulfillmentStatus === 'submitted') return ['待验收', 'warning'];\n    if ($fulfillmentStatus === 'in_progress') return ['施工中', 'info'];\n    if ($fulfillmentStatus === 'scheduled') return ['已预约', 'info'];\n    if ($paymentStatus === 'awaiting_payment') return ['待付预约费', 'warning'];\n    if ($assignmentStatus === 'accepted') {\n        if ($dispatchMode === 'single_grab') return [$expectedFeeType === 'total' && $expectedFeeCents > 0 ? '已按期望总价抢单，待施工' : '抢单报价已成交，待施工', 'info'];\n        return ['已安排师傅，待施工', 'info'];\n    }\n    if (in_array($assignmentStatus, ['offered', 'assigned'], true)) {\n        if ($dispatchMode === 'single_grab' && $assignmentStatus === 'offered') return ['师傅已抢单，待沟通报价', 'warning'];\n        return ['已安排师傅，待接单', 'warning'];\n    }\n    if (!empty($order['selected_quote_id']) || $quoteStatus === 'selected') return ['已选报价，待安排师傅', 'warning'];\n    if (in_array($quoteStatus, ['quoting', 'collecting'], true)) return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '报价中', 'info'];\n    return [$dispatchMode === 'single_grab' ? '等待师傅抢单' : '等待报价', 'info'];\n}\n\n// 2026-08-28：后台订单时间线统一显示中文事件标题；事件正文继续展示具体金额、原因和处理结果。\nfunction order_event_text($eventType)\n{\n    $map = [\n        'draft_created'=>'订单草稿已保存','admin_created'=>'管理员新增订单','admin_updated'=>'管理员修改订单资料',\n        'order_ready_for_prepayment'=>'等待支付预约费','order_submitted'=>'订单已提交审核','order_approved'=>'审核通过并公开',\n        'order_supplement_required'=>'要求补充资料','order_supplemented'=>'用户补充资料并重新提交','order_rejected'=>'订单审核未通过','order_published'=>'订单公开到大厅','order_hidden'=>'订单从大厅隐藏','order_edited'=>'订单资料已修改',\n        'worker_quoted'=>'师傅提交报价','worker_quote_updated'=>'师傅修改报价','platform_quoted'=>'平台提交报价','platform_quote_created'=>'平台新增报价','quote_selected_pending_payment'=>'用户选择报价',\n        'booking_fee_paid'=>'预约费支付成功','booking_fee_paid_upfront'=>'下单预约费支付成功','payment_reservation_released'=>'支付占位已释放',\n        'worker_invite_created'=>'生成邀请师傅分享','invite_claimed'=>'受邀师傅领取订单','worker_assigned'=>'管理员安排师傅','order_grabbed'=>'师傅抢单成功','single_grab_quote_confirmed'=>'抢单报价直接成交','single_grab_fixed_price_accepted'=>'按期望总价抢单成交','assignment_accepted'=>'师傅确认接单','contact_revealed'=>'完整联系信息已开放',\n        'appointment_recorded'=>'电话预约已记录','exceptional_arrival_reported'=>'到场异常已提交','change_requested'=>'师傅申请加价','change_accepted'=>'用户同意加价','change_rejected'=>'用户拒绝加价',\n        'measurement_service_paid'=>'测量服务款已补齐','measurement_change_accepted_pending_payment'=>'测量加费待支付','measurement_change_paid'=>'测量现场加费已支付','measurement_change_refund_created'=>'测量加费已登记退款','measurement_change_refunded'=>'测量加费已退款','measurement_late_balance_refund_created'=>'测量补款已登记退款','measurement_late_balance_refunded'=>'测量补款已退款',\n        'measurement_result_submitted'=>'测量成果已提交','measurement_result_accepted'=>'测量成果已确认','measurement_auto_accepted'=>'测量成果自动确认','measurement_rework_requested'=>'用户要求补测',\n        'measurement_hold_extension_requested'=>'申请延长测量冻结期','measurement_hold_extension_approved'=>'测量冻结延期已批准','measurement_hold_extension_rejected'=>'测量冻结延期未批准',\n        'measurement_income_released'=>'测量收入已释放','measurement_construction_linked'=>'测量单已关联施工',\n        'offline_collection_delayed'=>'线下尾款延期已登记','offline_collection_bad_debt'=>'线下尾款已标记坏账','completion_submitted'=>'师傅提交完工','completion_accepted_by_user'=>'用户确认验收','auto_completion_accepted'=>'系统自动验收','auto_accepted_72h'=>'72小时自动验收',\n        'auto_reviewed_5d'=>'5天自动评价','review_submitted'=>'用户提交评价','commission_receivable_created'=>'生成平台服务费账单','commission_paid'=>'平台服务费已结清',\n        'cancel_requested'=>'用户申请退款取消','cancel_approved'=>'管理员同意取消退款','admin_cancelled'=>'管理员强制取消','forced_cancel_refund'=>'管理员强制取消退款','auto_cancelled_7d'=>'7天未成交自动取消',\n        'cancel_rejected'=>'取消退款申请未通过','cancel_approved'=>'取消退款审核通过','refund_succeeded'=>'预约费退款成功','dispute_opened'=>'订单进入争议处理','dispute_resolved'=>'订单争议已结案','order_demo_seeded'=>'测试流程数据建立',\n        'test_center_scenario_built'=>'测试场景已生成（预置数据）',\n        'test_center_preset_preapproved'=>'已预置审核通过状态（未执行人工审核）',\n        'test_center_preset_target_built'=>'测试订单目标状态已生成（预置数据）',\n        'test_center_preset_worker_quote'=>'已预置师傅报价（未执行真实报价）',\n        'test_center_linked_construction_ready'=>'关联施工测试单已就绪（预置数据）',\n        'test_center_proxy_ready'=>'普通代录测试草稿已就绪'\n    ];\n    return isset($map[$eventType]) ? $map[$eventType] : '订单流程记录';\n}\n\nfunction audit($action, $resourceType, $resourceId = null, $description = '', $before = null, $after = null)\n{\n    if (!is_installed()) {\n        return;\n    }\n    try {\n        $admin = auth()->user();\n        // 2026-08-14：审计字段与不可变审计表保持一致，记录操作者快照及业务对象。\n        db()->execute(\n            \"INSERT INTO audit_logs (request_id, actor_type, actor_id, actor_name_snapshot, action, entity_type, entity_id, before_json, after_json, reason, ip_address, user_agent, result, created_at) VALUES (:request_id,'admin',:actor_id,:actor_name,:action,:entity_type,:entity_id,:before_json,:after_json,:reason,:ip,:ua,'success',NOW())\",\n            [\n                'actor_id' => $admin ? $admin['id'] : null,\n                'actor_name' => $admin ? ($admin['real_name'] ?: $admin['username']) : 'system',\n                'action' => $action,\n                'entity_type' => $resourceType,\n                'entity_id' => $resourceId === null ? null : (string) $resourceId,\n                'reason' => $description,\n                'before_json' => $before === null ? null : json_encode($before, JSON_UNESCAPED_UNICODE),\n                'after_json' => $after === null ? null : json_encode($after, JSON_UNESCAPED_UNICODE),\n                'ip' => request_ip(),\n                'ua' => substr(isset($_SERVER['HTTP_USER_AGENT']) ? $_SERVER['HTTP_USER_AGENT'] : 'cli', 0, 500),\n                'request_id' => request_id(),\n            ]\n        );\n    } catch (Throwable $exception) {\n        write_log('audit', '[' . date('c') . '] ' . $exception->getMessage() . \"\\n\");\n    }\n}\n\nfunction setting($key, $default = null)\n{\n    static $cache = [];\n    if (array_key_exists($key, $cache)) {\n        return $cache[$key];\n    }\n    try {\n        $row = db()->fetch('SELECT setting_value, value_type FROM system_settings WHERE setting_key = :key LIMIT 1', ['key' => $key]);\n        if (!$row) {\n            return $cache[$key] = $default;\n        }\n        $value = $row['setting_value'];\n        // 2026-08-25：新设置按运营要求明文保存；这里继续兼容读取升级前已有的 enc:v1 密文。\n        if (is_string($value) && strpos($value, 'enc:v1:') === 0) {\n            $value = decrypt_private_value($value, 'system-setting:' . (string) $key);\n        }\n        if (in_array($row['value_type'], ['int', 'integer'], true)) {\n            $value = (int) $value;\n        } elseif (in_array($row['value_type'], ['bool', 'boolean'], true)) {\n            $value = in_array(strtolower((string) $value), ['1', 'true', 'yes', 'on'], true);\n        } elseif ($row['value_type'] === 'json') {\n            $decoded = json_decode((string) $value, true);\n            $value = json_last_error() === JSON_ERROR_NONE ? $decoded : $default;\n        }\n        return $cache[$key] = $value;\n    } catch (Throwable $exception) {\n        return $default;\n    }\n}\n","server/app/Contracts/SubscribeMessageGateway.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface SubscribeMessageGateway\n{\n    public function categoryList(): array;\n    public function publicTemplateTitles(array $categoryIds, int $start = 0, int $limit = 30): array;\n    public function publicTemplateKeywords(string $tid): array;\n    public function addTemplate(string $tid, array $kidList, string $sceneDesc = ''): string;\n    public function templateList(): array;\n    public function send(array $payload): array;\n}\n","server/app/Infrastructure/Testing/DatabaseTestCenterChatActionRunner.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Testing;\n\nuse WorkerAdmin\\Contracts\\TestCenterActionRunner;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Testing\\TestCenterException;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\n\n/** Export an allowlisted fixture from the EXISTING instance, never a real identity or provider credential. */\nfinal class DatabaseTestCenterChatActionRunner implements TestCenterActionRunner\n{\n    public const ACTION='chat_fixture_export';\n    public const IMPORT='chat_result_import';\n    public const SUITES=[\n        'recovery'=>'双游标、进程重启与撤权恢复',\n        'media'=>'1/2/4/9 图、部分失败与共享对象',\n        'governance'=>'抽检、禁聊、举报与申诉',\n        'reminders'=>'任务重放、已读/撤权与渠道故障',\n        'retention'=>'留存、清理与安全恢复',\n    ];\n    private Database $db;\n    private TestCenterActionRunner $inner;\n    private TestingActionExecution $execution;\n    public function __construct(Database $db,TestCenterActionRunner $inner)\n    {$this->db=$db;$this->inner=$inner;$this->execution=new TestingActionExecution($db);}\n\n    public function available(string $id): array\n    {\n        $result=$this->inner->available($id);\n        if(!TestingEnvironmentPolicy::active())return$result;\n        [$instance,$order]=$this->execution->context($id);\n        if(!$order||$instance['build_status']!=='built'||!empty($instance['archived_at'])||!empty($instance['deleted_at']))return$result;\n        $result['items'][self::ACTION]=['key'=>self::ACTION,'label'=>'准备隔离聊天回归',\n            'description'=>'从本实例导出无身份凭证的夹具，复用独立 MySQL/Redis 回归；准备成功不代表回归通过，不调用真实消息渠道。',\n            'suites'=>self::SUITES];\n        if(preg_match('/^[a-f0-9]{40}$/D',(string)\\app_config('chat.test_report_revision',''))===1){\n            $result['items'][self::IMPORT]=['key'=>self::IMPORT,'label'=>'登记隔离聊天回归结果',\n                'description'=>'校验回归工具的签名、当前实例夹具及指定源码版本，分别记录回归通过或失败；不代表真机、主机或真实渠道验收。'];\n        }\n        return$result;\n    }\n    public function run(string $id,string $action,array $input,int $adminId,string $request): array\n    {\n        if($action===self::IMPORT)return$this->importReport($id,(string)($input['chat_report']??''),$adminId,$request);\n        if($action!==self::ACTION)return$this->inner->run($id,$action,$input,$adminId,$request);\n        $suite=(string)($input['chat_suite']??'');\n        if(!isset(self::SUITES[$suite]))throw new TestCenterException('请选择聊天回归场景。','TEST_CHAT_SUITE_INVALID',422);\n        $result=$this->execution->run($id,$action,['suite'=>$suite],$adminId,$request,'system','isolated_fixture',\n            function(array $instance,array $order,array $command):array {\n                // Re-read under the existing instance execution boundary. Production orders never qualify.\n                $fixture=self::fixture($instance,$order,(string)$command['suite']);\n                return ['status'=>'fixture_ready','tests_executed'=>false,'external_delivery_executed'=>false,\n                    'fixture_sha256'=>hash('sha256',self::encode($fixture)),'fixture'=>$fixture];\n            });\n        $result['operation_mode']='isolated_fixture';return$result;\n    }\n\n    private function importReport(string $id,string $raw,int $adminId,string $request): array\n    {\n        if(!TestingEnvironmentPolicy::active())throw new TestCenterException('回归登记仅允许测试环境。','TEST_ACTION_PRODUCTION_BLOCKED',403);\n        if(strlen($raw)>65536)throw new TestCenterException('回归结果过大。','TEST_CHAT_REPORT_INVALID',422);\n        $envelope=json_decode($raw,true);\n        if(!is_array($envelope)||count($envelope)!==2||!is_string($envelope['payload']??null)||!is_string($envelope['mac']??null))throw new TestCenterException('回归结果格式无效。','TEST_CHAT_REPORT_INVALID',422);\n        $encoded=(string)\\getenv((string)\\app_config('chat.test_report_key_env','CHAT_TEST_REPORT_KEY'));\n        $key=base64_decode($encoded,true);$payload=base64_decode($envelope['payload'],true);\n        if(!is_string($key)||strlen($key)!==32||base64_encode($key)!==$encoded||!is_string($payload)||base64_encode($payload)!==$envelope['payload']\n            ||!hash_equals(hash_hmac('sha256',$payload,$key),$envelope['mac']))throw new TestCenterException('回归结果签名不匹配。','TEST_CHAT_REPORT_SIGNATURE',422);\n        $report=json_decode($payload,true);$expected=(string)\\app_config('chat.test_report_revision','');\n        $fields=['schema','instance','suite','fixture_sha256','status','tests','failed','skipped','simulated_provider','real_channel','go_version','source_sha256','source_revision'];\n        if(!is_array($report)||array_diff(array_keys($report),$fields)||array_diff($fields,array_keys($report))\n            ||$report['schema']!==1||$report['instance']!==$id||!isset(self::SUITES[$report['suite']??''])\n            ||$report['simulated_provider']!==true||$report['real_channel']!==false||$report['go_version']!=='go1.27.3'\n            ||preg_match('/^[a-f0-9]{40}$/D',$expected)!==1||$report['source_revision']!==$expected\n            ||preg_match('/^[a-f0-9]{64}$/D',(string)$report['source_sha256'])!==1\n            ||!in_array($report['status'],['passed','failed'],true))throw new TestCenterException('实例、源码或回归范围不匹配。','TEST_CHAT_REPORT_BINDING',409);\n        foreach(['tests','failed','skipped'] as $list){\n            if(!is_array($report[$list])||count($report[$list])>500)throw new TestCenterException('回归条目无效。','TEST_CHAT_REPORT_INVALID',422);\n            foreach($report[$list] as $test)if(!is_string($test)||preg_match('#^Test[A-Za-z0-9_./:-]{1,199}$#D',$test)!==1)throw new TestCenterException('回归条目无效。','TEST_CHAT_REPORT_INVALID',422);\n        }\n        if($report['status']==='passed'&&(!$report['tests']||$report['failed']||$report['skipped']))throw new TestCenterException('通过结果存在缺项。','TEST_CHAT_REPORT_INCOMPLETE',409);\n        [$instance,$order]=$this->execution->context($id);\n        $fixture=self::fixture($instance,(array)$order,$report['suite']);$digest=hash('sha256',self::encode($fixture));\n        if(!hash_equals($digest,(string)$report['fixture_sha256']))throw new TestCenterException('实例夹具已经变化。','TEST_CHAT_REPORT_BINDING',409);\n        $prepared=false;\n        foreach($this->db->fetchAll(\"SELECT after_summary_json FROM test_runs WHERE instance_id=:instance AND action_key='chat_fixture_export' AND result='passed' ORDER BY id DESC LIMIT 20\",['instance'=>(int)$instance['id']]) as $row){\n            $summary=json_decode((string)$row['after_summary_json'],true);\n            if(hash_equals($digest,(string)($summary['business']['fixture_sha256']??'')))$prepared=true;\n        }\n        if(!$prepared)throw new TestCenterException('请先为当前实例准备同一回归夹具。','TEST_CHAT_FIXTURE_REQUIRED',409);\n        $result=$this->execution->run($id,self::IMPORT,['report_sha256'=>hash('sha256',$payload)],$adminId,$request,'system','isolated_regression',\n            static fn(array $i,array $o,array $command):array=>['status'=>$report['status']==='passed'?'regression_passed':'regression_failed','tests_executed'=>true,'real_channel'=>false,'report'=>$report]);\n        $result['operation_mode']='isolated_regression';$result['regression_passed']=$report['status']==='passed';\n        if(!$result['regression_passed']){\n            $this->db->execute(\"UPDATE test_runs SET result='failed',error_code='TEST_CHAT_REGRESSION_FAILED',error_message='隔离聊天回归未通过，请查看签名结果。' WHERE BINARY public_id=BINARY :id\",['id'=>$result['run_public_id']]);\n            $result['result']='failed';\n        }\n        return$result;\n    }\n\n    /** A schema shared with chat/scripts/test-center.py. No source IDs, names, addresses, tokens or content. */\n    public static function fixture(array $instance,array $order,string $suite): array\n    {\n        $id=(string)($instance['public_id']??'');\n        $profile=(string)($order['workflow_profile']??'construction');\n        $source=(string)($order['order_source_type']??'consumer');\n        $dispatch=(string)($order['dispatch_mode']??'multi_quote');\n        if(!isset(self::SUITES[$suite])||preg_match('/^[A-Za-z0-9_-]{1,96}$/D',$id)!==1\n            ||(int)($order['is_demo']??0)!==1\n            ||(string)($instance['order_no_snapshot']??'')!==(string)($order['public_no']??'')\n            ||strpos((string)($order['public_no']??''),'BXDEMOHALL')===0\n            ||!in_array($profile,['construction','measurement'],true)||!in_array($source,['consumer','platform'],true)\n            ||!in_array($dispatch,['multi_quote','single_grab'],true)){\n            throw new TestCenterException('夹具必须来自当前测试实例。','TEST_CHAT_INSTANCE_BOUNDARY',403);\n        }\n        return ['schema'=>1,'instance'=>$id,'suite'=>$suite,'environment'=>'test','provider'=>'simulated',\n            'order'=>['workflow'=>$profile,'source'=>$source,'dispatch'=>$dispatch],\n            'actors'=>['worker','customer','platform_staff'],'image_counts'=>[1,2,4,9]];\n    }\n    private static function encode(array $value): string\n    {return(string)json_encode($value,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);}\n}\n","server/app/Foundation/TestCenterComposition.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Foundation;\n\nuse WorkerAdmin\\Application\\Testing\\TestCenter;\nuse WorkerAdmin\\Application\\Testing\\TestScenarioCatalog;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Persistence\\DatabaseTestCenterRepository;\nuse WorkerAdmin\\Infrastructure\\Security\\GlobalPrivateValueCipher;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterActionSafetyRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFailureReplay;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterReplayCaptureRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSchedulerInspector;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSchedulerActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMessageSimulationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMessageProviderFailureActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterPaidSmsReceiptActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAdminAdjudicationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAdminAdjudicationVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoReviewVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoReviewCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoCancelVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundRetryVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSupplementTimeoutVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSupplementTimeoutCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAutoCancelCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterAdminRefundReplayRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterCleanupGuardRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterCleanupSafetyRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterDisputeFinanceActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterDisputeFinanceCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterDisputeFinanceVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFulfillmentActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFulfillmentCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterFulfillmentVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterM1Repository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegativeQuoteRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegotiationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegotiationCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterNegotiationVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterProgressVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRefundVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRepairActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRepairCleanupRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterRepairVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSingleGrabActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterSingleGrabVerificationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterPlatformMeasurementRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterPlatformMeasurementActionRunner;\n\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterProxyOrderActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterProxyOrderRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterInvitationActionRunner;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterInvitationRepository;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterMeasurementTailActionRunner;\n\nfinal class TestCenterComposition\n{\n    public static function entrySessions(Database $db): \\WorkerAdmin\\Contracts\\TestCenterEntryGateway\n    {\n        return new \\WorkerAdmin\\Infrastructure\\Testing\\TestCenterEntrySession($db);\n    }\n\n    public static function build(Database $db): TestCenter\n    {\n        $cipher=new GlobalPrivateValueCipher();\n        $base=new DatabaseTestCenterRepository($db,$cipher);\n        $m1=new DatabaseTestCenterM1Repository($db,$cipher,$base);\n        $measurementBase=new DatabaseTestCenterMeasurementRepository($db,$cipher,$m1);\n        $negative=new DatabaseTestCenterNegativeQuoteRepository($db,$measurementBase);\n        $dealProgress=new DatabaseTestCenterProgressVerificationRepository($db,$negative);\n        $singleGrabProgress=new DatabaseTestCenterSingleGrabVerificationRepository($db,$dealProgress);\n        $measurementProgress=new DatabaseTestCenterMeasurementVerificationRepository($db,$singleGrabProgress);\n        $fulfillmentProgress=new DatabaseTestCenterFulfillmentVerificationRepository($db,$measurementProgress);\n        $negotiationProgress=new DatabaseTestCenterNegotiationVerificationRepository($db,$fulfillmentProgress);\n        $refundProgress=new DatabaseTestCenterRefundVerificationRepository($db,$negotiationProgress);\n        $repairProgress=new DatabaseTestCenterRepairVerificationRepository($db,$refundProgress);\n        $adminProgress=new DatabaseTestCenterAdminAdjudicationVerificationRepository($db,$repairProgress);\n        $financeProgress=new DatabaseTestCenterDisputeFinanceVerificationRepository($db,$adminProgress);\n        $autoReviewProgress=new DatabaseTestCenterAutoReviewVerificationRepository($db,$financeProgress);\n        $autoCancelProgress=new DatabaseTestCenterAutoCancelVerificationRepository($db,$autoReviewProgress);\n        $refundRetryProgress=new DatabaseTestCenterRefundRetryVerificationRepository($db,$autoCancelProgress);\n        $supplementTimeoutProgress=new DatabaseTestCenterSupplementTimeoutVerificationRepository($db,$refundRetryProgress);\n        $financeCleanup=new DatabaseTestCenterDisputeFinanceCleanupRepository($db,$supplementTimeoutProgress);\n        $fulfillmentCleanup=new DatabaseTestCenterFulfillmentCleanupRepository($db,$financeCleanup);\n        $negotiationCleanup=new DatabaseTestCenterNegotiationCleanupRepository($db,$fulfillmentCleanup);\n        $refundCleanup=new DatabaseTestCenterRefundCleanupRepository($db,$negotiationCleanup);\n        $repairCleanup=new DatabaseTestCenterRepairCleanupRepository($db,$refundCleanup);\n        $measurementCleanup=new DatabaseTestCenterMeasurementCleanupRepository($db,$repairCleanup);\n        $platformMeasurement=new DatabaseTestCenterPlatformMeasurementRepository($db,$measurementCleanup);\n        $proxyFactory=new DatabaseTestCenterProxyOrderActionRunner($db,new DatabaseTestCenterActionRunner($db));\n        $proxyRepository=new DatabaseTestCenterProxyOrderRepository($db,$platformMeasurement,$proxyFactory);\n        $invitationRepository=new DatabaseTestCenterInvitationRepository($db,$proxyRepository);\n        $autoReviewCleanup=new DatabaseTestCenterAutoReviewCleanupRepository($db,$invitationRepository);\n        $autoCancelCleanup=new DatabaseTestCenterAutoCancelCleanupRepository($db,$autoReviewCleanup);\n        $supplementTimeoutCleanup=new DatabaseTestCenterSupplementTimeoutCleanupRepository($db,$autoCancelCleanup);\n        $cleanupGuard=new DatabaseTestCenterCleanupGuardRepository($db,$supplementTimeoutCleanup);\n        $repository=new DatabaseTestCenterCleanupSafetyRepository($db,$cleanupGuard);\n\n        $dealActions=new DatabaseTestCenterActionRunner($db);\n        $singleGrabActions=new DatabaseTestCenterSingleGrabActionRunner($db,$dealActions);\n        $measurementActions=new DatabaseTestCenterMeasurementActionRunner($db,$singleGrabActions);\n        $fulfillmentActions=new DatabaseTestCenterFulfillmentActionRunner($db,$measurementActions);\n        $negotiationActions=new DatabaseTestCenterNegotiationActionRunner($db,$fulfillmentActions);\n        $refundActions=new DatabaseTestCenterRefundActionRunner($db,$negotiationActions);\n        $repairActions=new DatabaseTestCenterRepairActionRunner($db,$refundActions);\n        $adminActions=new DatabaseTestCenterAdminAdjudicationActionRunner($db,$repairActions);\n        $financeActions=new DatabaseTestCenterDisputeFinanceActionRunner($db,$adminActions);\n        $adminReplayActions=new DatabaseTestCenterAdminRefundReplayRunner($db,$financeActions);\n        $platformActions=new DatabaseTestCenterPlatformMeasurementActionRunner($db,$adminReplayActions);\n        $proxyActions=new DatabaseTestCenterProxyOrderActionRunner($db,$platformActions);\n        $invitationActions=new DatabaseTestCenterInvitationActionRunner($db,$proxyActions,$repository);\n        $tailActions=new DatabaseTestCenterMeasurementTailActionRunner($db,$invitationActions,$repository);\n        $schedulerActions=new DatabaseTestCenterSchedulerActionRunner($db,$tailActions);\n        $messageSimulationActions=new DatabaseTestCenterMessageSimulationActionRunner($db,$schedulerActions);\n        $messageProviderActions=new DatabaseTestCenterMessageProviderFailureActionRunner($db,$messageSimulationActions);\n        $paidSmsReceiptActions=new DatabaseTestCenterPaidSmsReceiptActionRunner($db,$messageProviderActions);\n        $captureActions=new DatabaseTestCenterReplayCaptureRunner($db,new \\WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterChatActionRunner($db,$paidSmsReceiptActions));\n        $actions=new DatabaseTestCenterActionSafetyRunner($db,$captureActions);\n        $failureReplay=new DatabaseTestCenterFailureReplay($db,$actions);\n        $schedulerInspector=new DatabaseTestCenterSchedulerInspector($db);\n        return new TestCenter($repository,new TestScenarioCatalog(),$actions,$failureReplay,$schedulerInspector);\n    }\n}\n\n","chat/scripts/test-center.py":"#!/usr/bin/env python3\n\"\"\"Run existing Go/MySQL contracts from a sanitized Test Center fixture.\"\"\"\nimport argparse, base64, hashlib, hmac, json, os, pathlib, re, subprocess, sys, tempfile\n\nSUITES = {\n    \"recovery\": r\"S21|S08|S10|S15|S09\",\n    \"media\": r\"S21|S16|S17\",\n    \"governance\": r\"S21|S18|S19\",\n    \"reminders\": r\"S21|S20\",\n    \"retention\": r\"S21|S22\",\n}\ndef validate(f):\n    if set(f) != {\"schema\",\"instance\",\"suite\",\"environment\",\"provider\",\"order\",\"actors\",\"image_counts\"}:\n        raise ValueError(\"fixture fields\")\n    if type(f[\"schema\"]) is not int or f[\"schema\"] != 1 or not re.fullmatch(r\"[A-Za-z0-9_-]{1,96}\", f[\"instance\"]):\n        raise ValueError(\"fixture identity\")\n    if f[\"suite\"] not in SUITES or f[\"environment\"] != \"test\" or f[\"provider\"] != \"simulated\":\n        raise ValueError(\"isolated fixture required\")\n    o=f[\"order\"]\n    if set(o) != {\"workflow\",\"source\",\"dispatch\"} or o[\"workflow\"] not in (\"construction\",\"measurement\") or o[\"source\"] not in (\"consumer\",\"platform\") or o[\"dispatch\"] not in (\"multi_quote\",\"single_grab\"):\n        raise ValueError(\"order fixture\")\n    if f[\"actors\"] != [\"worker\",\"customer\",\"platform_staff\"] or f[\"image_counts\"] != [1,2,4,9] or any(type(n) is not int for n in f[\"image_counts\"]):\n        raise ValueError(\"no injected identity or image input\")\n    return f\n\ndef run(args):\n    if bool(args.sign_env)!=bool(args.report_file): raise ValueError(\"report output and signing key must be paired\")\n    path=pathlib.Path(args.fixture).resolve()\n    if path.stat().st_size > 4096:\n        raise ValueError(\"fixture too large\")\n    raw=path.read_bytes()\n    def pairs(items):\n        d={}\n        for k,v in items:\n            if k in d: raise ValueError(\"duplicate fixture field\")\n            d[k]=v\n        return d\n    f=validate(json.loads(raw,object_pairs_hook=pairs))\n    canonical={\"schema\":1,\"instance\":f[\"instance\"],\"suite\":f[\"suite\"],\"environment\":\"test\",\"provider\":\"simulated\",\n        \"order\":{name:f[\"order\"][name] for name in (\"workflow\",\"source\",\"dispatch\")},\n        \"actors\":f[\"actors\"],\"image_counts\":f[\"image_counts\"]}\n    fixture_hash=hashlib.sha256(json.dumps(canonical,ensure_ascii=False,separators=(\",\",\":\")).encode()).hexdigest()\n    for key in (\"CHAT_AUTH_TEST_INTEGRATION\",\"CHAT_INTEGRATION\"):\n        if os.environ.get(key) != \"1\": raise ValueError(\"explicit isolated integration required\")\n    for key in (\"CHAT_INTEGRATION_MYSQL_ADDR\",\"CHAT_INTEGRATION_REDIS_ADDR\"):\n        if not re.fullmatch(r\"127\\.0\\.0\\.1:[1-9][0-9]{0,4}\",os.environ.get(key,\"\")):\n            raise ValueError(\"loopback dependencies required\")\n    env=dict(os.environ, CHAT_TEST_CENTER_FIXTURE=str(path), GOTOOLCHAIN=\"local\")\n    root=pathlib.Path(__file__).resolve().parents[1]\n    # Fixed executable and argument list; fixture cannot introduce paths, URLs or shell.\n    required=\"go\"+next(line.split()[1] for line in (root/\"go.mod\").read_text().splitlines() if line.startswith(\"go \"))\n    actual=subprocess.check_output([\"go\",\"env\",\"GOVERSION\"],cwd=root,env=env,text=True,timeout=10).strip()\n    if actual!=required: raise ValueError(\"locked Go toolchain required\")\n    source_hash=hashlib.sha256()\n    for source in sorted(list((root/\"internal\").rglob(\"*.go\"))+list((root/\"cmd\").rglob(\"*.go\"))+[root/\"go.mod\",root/\"go.sum\"]):\n        source_hash.update(str(source.relative_to(root)).encode()+b\"\\\\0\"+hashlib.sha256(source.read_bytes()).digest())\n    cmd=[\"go\",\"test\",\"-race\",\"-count=1\",\"-json\",\"-run\",SUITES[f[\"suite\"]],\"./internal/message\"]\n    p=subprocess.run(cmd,cwd=root,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=900)\n    tests=[]; failed=[]; skipped=[]\n    for line in p.stdout.decode(\"utf-8\",errors=\"replace\").splitlines():\n        try: row=json.loads(line)\n        except ValueError: continue\n        if row.get(\"Test\") and row.get(\"Action\")==\"pass\": tests.append(row[\"Test\"])\n        if row.get(\"Test\") and row.get(\"Action\")==\"fail\": failed.append(row[\"Test\"])\n        if row.get(\"Test\") and row.get(\"Action\")==\"skip\": skipped.append(row[\"Test\"])\n    report={\"schema\":1,\"instance\":f[\"instance\"],\"suite\":f[\"suite\"],\"fixture_sha256\":fixture_hash,\n        \"go_version\":actual,\"source_sha256\":source_hash.hexdigest(),\"source_revision\":os.environ.get(\"CHAT_VERIFIED_SOURCE_REVISION\",\"unrecorded\"),\n        \"status\":\"passed\" if p.returncode==0 and tests and not failed and not skipped else \"failed\",\n        \"tests\":tests,\"failed\":failed,\"skipped\":skipped,\"simulated_provider\":True,\"real_channel\":False}\n    # Do not echo raw test logs (they may contain fixture SQL). Operators can retain private CI logs.\n    if args.report_file:\n        if not args.sign_env or not re.fullmatch(r\"CHAT_[A-Z0-9_]{1,60}\",args.sign_env): raise ValueError(\"report signing key name\")\n        key_text=os.environ.get(args.sign_env,\"\");key=base64.b64decode(key_text,validate=True)\n        if len(key)!=32 or base64.b64encode(key).decode()!=key_text or not re.fullmatch(r\"[0-9a-f]{40}\",report[\"source_revision\"]):\n            raise ValueError(\"report key/source binding\")\n        payload=json.dumps(report,ensure_ascii=False,separators=(\",\",\":\")).encode()\n        envelope={\"payload\":base64.b64encode(payload).decode(),\"mac\":hmac.new(key,payload,\"sha256\").hexdigest()}\n        target=pathlib.Path(args.report_file)\n        if not target.is_absolute() or target.is_symlink(): raise ValueError(\"private absolute report path\")\n        fd,name=tempfile.mkstemp(prefix=\".chat-report-\",dir=target.parent)\n        try:\n            os.fchmod(fd,0o640)\n            with os.fdopen(fd,\"w\") as output:\n                json.dump(envelope,output,separators=(\",\",\":\"));output.flush();os.fsync(output.fileno())\n            os.replace(name,target)\n        finally:\n            if os.path.exists(name): os.unlink(name)\n    print(json.dumps(report,ensure_ascii=False))\n    return 0 if report[\"status\"]==\"passed\" else 1\n\nif __name__==\"__main__\":\n    parser=argparse.ArgumentParser()\n    parser.add_argument(\"--fixture\",required=True)\n    parser.add_argument(\"--report-file\");parser.add_argument(\"--sign-env\")\n    try: sys.exit(run(parser.parse_args()))\n    except (ValueError,OSError,subprocess.SubprocessError,TypeError,KeyError):\n        print('{\"status\":\"failed\",\"code\":\"CHAT_TEST_CENTER_INVALID_OR_UNAVAILABLE\"}')\n        sys.exit(2)\n","chat/internal/message/recovery_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestMySQLS21TestCenterInstance(t *testing.T) {\n\tpath := os.Getenv(\"CHAT_TEST_CENTER_FIXTURE\")\n\tif path == \"\" {\n\t\tt.Skip(\"test center fixture not requested\")\n\t}\n\traw, err := os.ReadFile(path)\n\tif err != nil || len(raw) > 4096 {\n\t\tt.Fatal(\"fixture input\")\n\t}\n\tvar fixture struct {\n\t\tSchema      int    `json:\"schema\"`\n\t\tInstance    string `json:\"instance\"`\n\t\tSuite       string `json:\"suite\"`\n\t\tEnvironment string `json:\"environment\"`\n\t\tProvider    string `json:\"provider\"`\n\t\tOrder       struct {\n\t\t\tWorkflow string `json:\"workflow\"`\n\t\t\tSource   string `json:\"source\"`\n\t\t\tDispatch string `json:\"dispatch\"`\n\t\t} `json:\"order\"`\n\t\tActors []string `json:\"actors\"`\n\t\tCounts []int    `json:\"image_counts\"`\n\t}\n\td := json.NewDecoder(strings.NewReader(string(raw)))\n\td.DisallowUnknownFields()\n\tif d.Decode(&fixture) != nil || fixture.Schema != 1 || fixture.Instance == \"\" || fixture.Environment != \"test\" || fixture.Provider != \"simulated\" {\n\t\tt.Fatal(\"isolated fixture\")\n\t}\n\tf := newFixture(t)\n\tf.php(\"test-center\", fixture.Order.Source, fixture.Order.Workflow, fixture.Order.Dispatch)\n\tif _, err = f.store.Poll(f.ctx, 100); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcid, err := f.store.FindOrder(f.ctx, principal(\"10202\"), \"401\", \"401\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ts, err := NewService(f.goDB, f.store, safetyFunc(pass), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tq := request(210)\n\tq.ConversationID = cid\n\tout := accepted(t, s, q)\n\t// Recompose actual services on the same durable DB, without presence or a Redis cache.\n\trestarted, err := NewService(f.goDB, f.store, safetyFunc(pass), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tagain, err := restarted.Send(f.ctx, principal(\"10202\"), q)\n\tif err != nil || again.MessageID != out.MessageID || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"1\" {\n\t\tt.Fatal(\"restart replay\", again, err)\n\t}\n\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"k\", 32)), 3*time.Second)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tinitial, err := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: cid}, \"bootstrap\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = restarted.Recall(f.ctx, principal(\"10202\"), cid, out.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tchanges, err := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: cid, Cursor: initial.ChangeCursor}, \"changes\")\n\tif err != nil || len(changes.Changes) != 1 || changes.Changes[0].Message.Text != nil {\n\t\tt.Fatal(\"durable change cursor\", changes, err)\n\t}\n\t// Replaying PHP events never resets a committed seq or revives a recalled body.\n\tif _, err = f.store.Poll(f.ctx, 100); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(out.MessageID)) != \"recalled\" {\n\t\tt.Fatal(\"projection revived message\")\n\t}\n\tf.exec(\"UPDATE login_sessions SET status='revoked' WHERE id=10202\")\n\tif _, err = h.Read(context.Background(), principal(\"10202\"), HistoryRequest{ConversationID: cid}, \"bootstrap\"); err == nil {\n\t\tt.Fatal(\"old login restored read\")\n\t}\n}\n","chat/internal/message/retention.go":"package message\n\nimport (\n\t\"context\"\n\t\"database/sql\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"time\"\n)\n\n// Minimal idempotency, authority versions, restriction rows and message tombstones\n// are not deleted by this worker. Their disaster-recovery window is independent.\ntype RetentionConfig struct {\n\tEnabled      bool `json:\"enabled\"`\n\tBodyDays     int  `json:\"body_days\"`\n\tEvidenceDays int  `json:\"evidence_days\"`\n\tChangeDays   int  `json:\"change_days\"`\n\tBatch        int  `json:\"batch\"`\n}\n\nfunc DefaultRetentionConfig() RetentionConfig { return RetentionConfig{false, 365, 30, 90, 20} }\nfunc (c RetentionConfig) Validate() error {\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif c.BodyDays < 90 || c.BodyDays > 3650 || c.EvidenceDays < 30 || c.EvidenceDays > c.BodyDays || c.ChangeDays < 1 || c.ChangeDays > 365 || c.Batch < 1 || c.Batch > 50 {\n\t\treturn ports.ErrInvalid\n\t}\n\treturn nil\n}\n\ntype Retention struct {\n\tdb          *sql.DB\n\tconfig      RetentionConfig\n\tenvironment string\n}\ntype RetentionResult struct {\n\tNext          ports.ID `json:\"next_after\"`\n\tConversations int      `json:\"conversations\"`\n\tMessages      int      `json:\"messages\"`\n\tChanges       int      `json:\"changes\"`\n}\n\nfunc NewRetention(db *sql.DB, environment string, c RetentionConfig) (*Retention, error) {\n\tif db == nil || c.Validate() != nil || !c.Enabled || (environment != \"test\" && environment != \"development\" && environment != \"production\") {\n\t\treturn nil, ports.ErrInvalid\n\t}\n\treturn &Retention{db, c, environment}, nil\n}\nfunc (r *Retention) Pass(ctx context.Context, after ports.ID) (RetentionResult, error) {\n\tctx, cancel := context.WithTimeout(ctx, 10*time.Second)\n\tdefer cancel()\n\tout := RetentionResult{Next: \"0\"}\n\tif err := expireGovernanceEvidence(ctx, r.db, r.environment); err != nil {\n\t\treturn out, err\n\t}\n\tif after != \"\" && after != \"0\" && !validID(after) {\n\t\treturn out, ports.ErrInvalid\n\t}\n\tif after == \"\" {\n\t\tafter = \"0\"\n\t}\n\trows, err := r.db.QueryContext(ctx, `SELECT CAST(id AS CHAR) FROM chat_conversations WHERE id>? ORDER BY id LIMIT ?`, string(after), r.config.Batch)\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tids := []ports.ID{}\n\tfor rows.Next() {\n\t\tvar id ports.ID\n\t\tif rows.Scan(&id) != nil {\n\t\t\trows.Close()\n\t\t\treturn out, ports.ErrUnavailable\n\t\t}\n\t\tids = append(ids, id)\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn out, ports.ErrUnavailable\n\t}\n\tfor _, id := range ids {\n\t\tn, c, err := r.one(ctx, id)\n\t\tif err != nil {\n\t\t\treturn out, err\n\t\t}\n\t\tout.Conversations++\n\t\tout.Messages += n\n\t\tout.Changes += c\n\t\tout.Next = id\n\t}\n\tif len(ids) < r.config.Batch {\n\t\tout.Next = \"0\"\n\t}\n\treturn out, nil\n}\nfunc (r *Retention) one(ctx context.Context, id ports.ID) (int, int, error) {\n\tctx, cancel := context.WithTimeout(ctx, 3*time.Second)\n\tdefer cancel()\n\ttx, err := r.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})\n\tif err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tdefer tx.Rollback()\n\tvar floor, change uint64\n\tif tx.QueryRowContext(ctx, `SELECT sync_floor_seq,last_change_seq FROM chat_conversations WHERE id=? FOR UPDATE`, string(id)).Scan(&floor, &change) != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\t// Any unexpired dispute protects the conversation, including a risk/intent case.\n\t// This conservative hold avoids severing shared evidence referenced through another table.\n\tvar holds int\n\tif tx.QueryRowContext(ctx, `SELECT (SELECT COUNT(*) FROM chat_cases WHERE conversation_id=? AND retain_until>UTC_TIMESTAMP(6))+(SELECT COUNT(*) FROM chat_image_uploads WHERE conversation_id=? AND legal_hold=1)`, string(id), string(id)).Scan(&holds) != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tn := 0\n\tif holds == 0 {\n\t\trows, e := tx.QueryContext(ctx, `SELECT CAST(id AS CHAR),seq,created_at<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) FROM chat_messages WHERE conversation_id=? AND seq>? ORDER BY seq LIMIT 50`, r.config.BodyDays, string(id), floor)\n\t\tif e != nil {\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t\ttype target struct {\n\t\t\tid  ports.ID\n\t\t\tseq uint64\n\t\t}\n\t\ttargets := []target{}\n\t\tfor rows.Next() {\n\t\t\tvar v target\n\t\t\tvar old bool\n\t\t\tif rows.Scan(&v.id, &v.seq, &old) != nil {\n\t\t\t\trows.Close()\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t\tif !old {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ttargets = append(targets, v)\n\t\t}\n\t\te = rows.Err()\n\t\trows.Close()\n\t\tif e != nil {\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t\tfor _, v := range targets {\n\t\t\tif change == ^uint64(0) {\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t\tchange++\n\t\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_messages SET text_body=NULL,state='expired',state_version=state_version+1 WHERE id=?`, string(v.id)); e != nil {\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t\tif _, e = tx.ExecContext(ctx, `INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) SELECT conversation_id,?,id,state_version,'message.expired',UTC_TIMESTAMP(6) FROM chat_messages WHERE id=?`, change, string(v.id)); e != nil {\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t\tif _, e = tx.ExecContext(ctx, `DELETE FROM chat_image_items WHERE message_id=?`, string(v.id)); e != nil {\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t\tfloor = v.seq\n\t\t\tn++\n\t\t}\n\t\t// Recalled/blocked bodies and their media are evidence for at least 30 days\n\t\t// from the latest safety change. Keep the minimal message and original seq.\n\t\trows, e = tx.QueryContext(ctx, `SELECT CAST(m.id AS CHAR) FROM chat_messages m WHERE m.conversation_id=? AND m.state IN ('recalled','blocked') AND m.created_at<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) AND NOT EXISTS(SELECT 1 FROM chat_message_changes c WHERE c.message_id=m.id AND c.created_at>=TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6))) AND (m.text_body IS NOT NULL OR EXISTS(SELECT 1 FROM chat_image_items i WHERE i.message_id=m.id)) ORDER BY m.seq LIMIT 50`, string(id), r.config.EvidenceDays, r.config.EvidenceDays)\n\t\tif e != nil {\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t\tevidence := []ports.ID{}\n\t\tfor rows.Next() {\n\t\t\tvar mid ports.ID\n\t\t\tif rows.Scan(&mid) != nil {\n\t\t\t\trows.Close()\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t\tevidence = append(evidence, mid)\n\t\t}\n\t\te = rows.Err()\n\t\trows.Close()\n\t\tif e != nil {\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t\tfor _, mid := range evidence {\n\t\t\tif _, e = tx.ExecContext(ctx, `UPDATE chat_messages SET text_body=NULL WHERE id=?`, string(mid)); e != nil {\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t\tif _, e = tx.ExecContext(ctx, `DELETE FROM chat_image_items WHERE message_id=?`, string(mid)); e != nil {\n\t\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t\t}\n\t\t}\n\t}\n\t// Change retention always advances a contiguous prefix while holding the same\n\t// conversation lock as publish/recall. A cursor below the new floor must resync.\n\trows, err := tx.QueryContext(ctx, `SELECT change_seq,created_at<TIMESTAMPADD(DAY,-?,UTC_TIMESTAMP(6)) FROM chat_message_changes WHERE conversation_id=? ORDER BY change_seq LIMIT 100`, r.config.ChangeDays, string(id))\n\tif err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tchangeFloor := uint64(0)\n\tcount := 0\n\tfor rows.Next() {\n\t\tvar v uint64\n\t\tvar old bool\n\t\tif rows.Scan(&v, &old) != nil {\n\t\t\trows.Close()\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t\tif !old {\n\t\t\tbreak\n\t\t}\n\t\tchangeFloor = v\n\t\tcount++\n\t}\n\terr = rows.Err()\n\trows.Close()\n\tif err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tif count > 0 {\n\t\tif _, err = tx.ExecContext(ctx, `DELETE FROM chat_message_changes WHERE conversation_id=? AND change_seq<=?`, string(id), changeFloor); err != nil {\n\t\t\treturn 0, 0, ports.ErrUnavailable\n\t\t}\n\t}\n\tif _, err = tx.ExecContext(ctx, `UPDATE chat_conversations SET sync_floor_seq=GREATEST(sync_floor_seq,?),change_floor_seq=GREATEST(change_floor_seq,?),last_change_seq=? WHERE id=?`, floor, changeFloor, change, string(id)); err != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\tif tx.Commit() != nil {\n\t\treturn 0, 0, ports.ErrUnavailable\n\t}\n\treturn n, count, nil\n}\n","chat/internal/dependencies/retention.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"log/slog\"\n\t\"time\"\n)\n\nfunc (r *Runtime) EnableRetention(c message.RetentionConfig) error {\n\tif c.Validate() != nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tif !c.Enabled {\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" {\n\t\treturn ports.ErrInvalid\n\t}\n\tvar err error\n\tr.Retention, err = message.NewRetention(r.sql, r.environment, c)\n\treturn err\n}\nfunc (r *Runtime) MaintainRetention(ctx context.Context, logger *slog.Logger) {\n\tafter := ports.ID(\"0\")\n\tticker := time.NewTicker(time.Minute)\n\tdefer ticker.Stop()\n\tfor {\n\t\tif r.OperationsReady() {\n\t\t\tpass, cancel := context.WithTimeout(ctx, 10*time.Second)\n\t\t\tout, err := r.Retention.Pass(pass, after)\n\t\t\tcancel()\n\t\t\tif err != nil {\n\t\t\t\tlogger.Warn(\"retention_unavailable\", \"code\", \"CHAT_RETENTION_UNAVAILABLE\")\n\t\t\t} else {\n\t\t\t\tafter = out.Next\n\t\t\t\tlogger.Info(\"retention_pass\", \"conversations\", out.Conversations, \"messages\", out.Messages, \"changes\", out.Changes)\n\t\t\t}\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-ticker.C:\n\t\t}\n\t}\n}\n","chat/internal/dependencies/operations.go":"package dependencies\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"io\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"runtime\"\n\t\"time\"\n)\n\ntype OperationsConfig struct {\n\tGateFile string `json:\"gate_file\"`\n\tEpoch    string `json:\"epoch\"`\n}\n\nvar recoveryEpoch = regexp.MustCompile(\"^[0-9a-f]{64}$\")\n\nfunc (c OperationsConfig) Validate(required bool) bool {\n\tif c.GateFile == \"\" && c.Epoch == \"\" {\n\t\treturn !required\n\t}\n\treturn filepath.IsAbs(c.GateFile) && recoveryEpoch.MatchString(c.Epoch)\n}\n\n// Gate belongs to independent recovery control, never a DB backup or release directory.\nfunc (c OperationsConfig) Ready(env string) bool {\n\tif c.GateFile == \"\" {\n\t\treturn c.Epoch == \"\"\n\t}\n\tinfo, err := os.Lstat(c.GateFile)\n\tif err != nil || !info.Mode().IsRegular() || info.Size() > 1024 || info.Mode().Perm()&0022 != 0 {\n\t\treturn false\n\t}\n\tfile, err := os.Open(c.GateFile)\n\tif err != nil {\n\t\treturn false\n\t}\n\tdefer file.Close()\n\traw, err := io.ReadAll(io.LimitReader(file, 1025))\n\tif err != nil || len(raw) > 1024 {\n\t\treturn false\n\t}\n\tvar mark struct {\n\t\tSchema      int    `json:\"schema\"`\n\t\tEnvironment string `json:\"environment\"`\n\t\tEpoch       string `json:\"epoch\"`\n\t\tState       string `json:\"state\"`\n\t}\n\td := json.NewDecoder(bytes.NewReader(raw))\n\td.DisallowUnknownFields()\n\tif d.Decode(&mark) != nil {\n\t\treturn false\n\t}\n\tvar rest any\n\tif d.Decode(&rest) != io.EOF {\n\t\treturn false\n\t}\n\tcanonical, _ := json.Marshal(mark)\n\tvar compact bytes.Buffer\n\tif json.Compact(&compact, raw) != nil || !bytes.Equal(canonical, compact.Bytes()) {\n\t\treturn false\n\t}\n\treturn mark.Schema == 1 && mark.Environment == env && mark.Epoch == c.Epoch && mark.State == \"ready\"\n}\nfunc (r *Runtime) ConfigureOperations(c OperationsConfig) { r.operations = c }\nfunc (r *Runtime) OperationsReady() bool                  { return r.operations.Ready(r.environment) }\nfunc (r *Runtime) RunProjection(ctx context.Context, logger *slog.Logger) {\n\ttimer := time.NewTicker(time.Second)\n\tdefer timer.Stop()\n\tfor {\n\t\tif r.OperationsReady() {\n\t\t\tpass, cancel := context.WithTimeout(ctx, 5*time.Second)\n\t\t\tout, err := r.Conversations.Poll(pass, 100)\n\t\t\tcancel()\n\t\t\tif err != nil {\n\t\t\t\tlogger.Warn(\"projection_unavailable\", \"code\", \"CHAT_PROJECTION_UNAVAILABLE\")\n\t\t\t} else if out.Applied > 0 {\n\t\t\t\tlogger.Info(\"projection_pass\", \"applied\", out.Applied)\n\t\t\t}\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-timer.C:\n\t\t}\n\t}\n}\nfunc (r *Runtime) Metrics(w http.ResponseWriter, q *http.Request) {\n\tw.Header().Set(\"Content-Type\", \"text/plain; version=0.0.4\")\n\tw.Header().Set(\"Cache-Control\", \"no-store\")\n\tif q.Method != http.MethodGet && q.Method != http.MethodHead {\n\t\tw.Header().Set(\"Allow\", \"GET, HEAD\")\n\t\tw.WriteHeader(405)\n\t\treturn\n\t}\n\tif q.Method == http.MethodHead {\n\t\treturn\n\t}\n\tready := 0\n\tif r.OperationsReady() {\n\t\tready = 1\n\t}\n\ts := r.Snapshot()\n\tmysqlReady, redisReady := 0, 0\n\tif s.MySQL.State == \"ready\" {\n\t\tmysqlReady = 1\n\t}\n\tif s.Redis.State == \"ready\" {\n\t\tredisReady = 1\n\t}\n\tvar m runtime.MemStats\n\truntime.ReadMemStats(&m)\n\t_, _ = fmt.Fprintf(w, \"chat_recovery_ready %d\\nchat_mysql_ready %d\\nchat_redis_ready %d\\nchat_goroutines %d\\nchat_heap_bytes %d\\n\", ready, mysqlReady, redisReady, runtime.NumGoroutine(), m.HeapAlloc)\n\tif r.sql != nil {\n\t\td := r.sql.Stats()\n\t\t_, _ = fmt.Fprintf(w, \"chat_db_open %d\\nchat_db_in_use %d\\nchat_db_wait_total %d\\n\", d.OpenConnections, d.InUse, d.WaitCount)\n\t}\n}\n\ntype recoveryError struct{}\n\nfunc (recoveryError) Error() string              { return \"CHAT_RECOVERY_BLOCKED\" }\nfunc (recoveryError) PublicCode() (string, bool) { return \"CHAT_RECOVERY_BLOCKED\", true }\n\ntype guardedCommands struct {\n\truntime *Runtime\n\tinner   socket.Commands\n}\n\nfunc (g guardedCommands) Execute(ctx context.Context, p ports.Principal, kind string, raw json.RawMessage) (string, any, error) {\n\tif !g.runtime.OperationsReady() {\n\t\treturn \"\", nil, recoveryError{}\n\t}\n\treturn g.inner.Execute(ctx, p, kind, raw)\n}\n\ntype guardedPolicy struct {\n\truntime *Runtime\n\tinner   ports.RealtimePolicy\n}\n\nfunc (g guardedPolicy) Authorize(ctx context.Context, q ports.PolicyRequest) (ports.Grant, error) {\n\tif !g.runtime.OperationsReady() {\n\t\treturn ports.Grant{}, recoveryError{}\n\t}\n\treturn g.inner.Authorize(ctx, q)\n}\nfunc (g guardedPolicy) MemberCandidates(ctx context.Context, id ports.ID) ([]ports.ID, error) {\n\tif !g.runtime.OperationsReady() {\n\t\treturn nil, recoveryError{}\n\t}\n\treturn g.inner.MemberCandidates(ctx, id)\n}\n","server/app/Infrastructure/Chat/ChatRecoveryGate.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Chat;\n\nuse RuntimeException;\n\n/** Independent control marker; never stored inside a DB backup or release tree. */\nfinal class ChatRecoveryGate\n{\n    public static function ready(array $config,string $environment): bool\n    {\n        $path=(string)($config['recovery_gate_file']??'');$epoch=(string)($config['recovery_epoch']??'');\n        if($path===''&&$epoch==='')return in_array($environment,['test','development'],true);\n        if(!self::path($path)||preg_match('/^[a-f0-9]{64}$/D',$epoch)!==1||!is_file($path)||is_link($path)||filesize($path)>1024||(fileperms($path)&0022)!==0)return false;\n        $raw=file_get_contents($path);if(!is_string($raw))return false;\n        $m=json_decode($raw,true);\n        if(!is_array($m)||array_keys($m)!==['schema','environment','epoch','state'])return false;\n        if(json_encode($m,JSON_UNESCAPED_SLASHES)!==preg_replace('/\\s+(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/','',$raw))return false;\n        return$m===['schema'=>1,'environment'=>$environment,'epoch'=>$epoch,'state'=>'ready'];\n    }\n    public static function assertReady(array $config,string $environment): void\n    {if(!self::ready($config,$environment))throw new RuntimeException('聊天安全恢复尚未核验',503);}\n    public static function path(string $path): bool\n    {return$path!==''&&($path[0]==='/'||preg_match('/^[A-Za-z]:[\\\\\\\\\\/]/D',$path)===1)&&strpos($path,\"\\0\")===false;}\n}\n","server/app/Infrastructure/Chat/ChatRecoveryCheckpoint.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Chat;\n\nuse PDO;\nuse RuntimeException;\n\n/**\n * Compare safety facts after operator-controlled, continuous binlog replay.\n * Never replay messages, enqueue notification, charge wallets or invent missing increments.\n * Capture/verify require stopped chat processes and a separately protected control directory.\n */\nfinal class ChatRecoveryCheckpoint\n{\n    private PDO $db;private string $environment;private string $key;private string $directory;private string $epoch;\n    public function __construct(PDO $db,string $environment,string $key,string $directory,string $epoch)\n    {\n        if(!in_array($environment,['test','development','production'],true)||strlen($key)!==32\n            ||!ChatRecoveryGate::path($directory)||!is_dir($directory)||is_link($directory)||(fileperms($directory)&0027)!==0\n            ||preg_match('/^[a-f0-9]{64}$/D',$epoch)!==1)throw new RuntimeException('CHAT_RECOVERY_CONFIG');\n        $this->db=$db;$this->environment=$environment;$this->key=$key;$this->directory=rtrim($directory,'/\\\\');$this->epoch=$epoch;\n    }\n    public function block(): void\n    {$this->write('gate.json',['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'blocked']);}\n    private function blocked(): void\n    {\n        $m=$this->read('gate.json',1024);\n        if($m!==['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'blocked'])throw new RuntimeException('CHAT_RECOVERY_MAINTENANCE_REQUIRED');\n    }\n    /** Fingerprints only; no message bodies, source identities, media keys or channel payloads leave the DB. */\n    public static function queries(): array\n    {\n        return [\n            'chat_policy_guards'=>'SELECT id,order_id,assignment_id,policy_version,SHA2(snapshot_json,256) snapshot_hash FROM chat_policy_guards ORDER BY id',\n            'chat_repair_episodes'=>'SELECT * FROM chat_repair_episodes ORDER BY id',\n            'chat_policy_refresh'=>'SELECT * FROM chat_policy_refresh ORDER BY order_id',\n            'chat_auditor_grant_audit'=>'SELECT * FROM chat_auditor_grant_audit ORDER BY id',\n            'chat_audit_accounts'=>'SELECT * FROM chat_audit_accounts ORDER BY 1',\n            'chat_audit_snapshots'=>'SELECT * FROM chat_audit_snapshots ORDER BY 1',\n            'chat_audit_snapshot_items'=>'SELECT * FROM chat_audit_snapshot_items ORDER BY 1,2',\n            'admin_authority'=>'SELECT id,role,status,must_change_password,SHA2(password_hash,256) password_version FROM admin_users ORDER BY id',\n            'chat_staff_authority_versions'=>'SELECT user_id,authority_version FROM chat_staff_authority_versions ORDER BY user_id',\n            'chat_admin_sessions'=>'SELECT id,session_version,authority_hash,scopes_json,expires_at,revoked_at FROM chat_admin_sessions ORDER BY id',\n            'chat_mini_auditors'=>'SELECT user_id,enabled,authority_version FROM chat_mini_auditors ORDER BY user_id',\n            'login_sessions'=>'SELECT id,user_id,status,expires_at,SHA2(token_hash,256) credential_hash,demo_actor_user_id,test_actor_user_id,test_instance_id,test_actor_expires_at FROM login_sessions ORDER BY id',\n            'users'=>'SELECT id,status FROM users ORDER BY id',\n            'wechat_identities'=>'SELECT id,user_id,SHA2(CONCAT(app_id,CHAR(10),openid),256) identity_hash,status FROM wechat_identities ORDER BY id',\n            'staff_settings'=>\"SELECT setting_key,SHA2(setting_value,256) value_hash FROM system_settings WHERE setting_key IN ('wechat.miniapp_appid','wechat.admin_openids') ORDER BY setting_key\",\n            'chat_business_events'=>'SELECT id,event_id,aggregate_key,aggregate_version,SHA2(payload_json,256) payload_hash FROM chat_business_events ORDER BY id',\n            'chat_event_receipts'=>'SELECT * FROM chat_event_receipts ORDER BY event_id',\n            'chat_conversations'=>'SELECT * FROM chat_conversations ORDER BY id',\n            'chat_members'=>'SELECT * FROM chat_members ORDER BY conversation_id,actor_id',\n            'chat_member_intervals'=>'SELECT * FROM chat_member_intervals ORDER BY conversation_id,actor_id,start_version',\n            'chat_restrictions'=>'SELECT * FROM chat_restrictions ORDER BY actor_id',\n            'chat_messages'=>'SELECT id,conversation_id,seq,sender_id,client_message_id,policy_version,message_type,state,state_version,SHA2(COALESCE(text_body,\"\"),256) body_hash,reply_to_message_id,edited_from_recalled_message_id,reply_to_item_id,recalled_at FROM chat_messages ORDER BY id',\n            'chat_message_changes'=>'SELECT * FROM chat_message_changes ORDER BY conversation_id,change_seq',\n            'chat_send_intents'=>'SELECT * FROM chat_send_intents ORDER BY id',\n            'chat_member_reads'=>'SELECT * FROM chat_member_reads ORDER BY conversation_id,actor_id',\n            'chat_user_preferences'=>'SELECT * FROM chat_user_preferences ORDER BY actor_id,conversation_id',\n            'chat_preference_accounts'=>'SELECT * FROM chat_preference_accounts ORDER BY actor_id',\n            'chat_risk_events'=>'SELECT id,intent_id,confirmed,review_state,retain_until,SHA2(text_evidence,256) text_hash,SHA2(context_evidence,256) context_hash FROM chat_risk_events ORDER BY id',\n            'chat_cases'=>'SELECT * FROM chat_cases ORDER BY id',\n            'chat_image_uploads'=>'SELECT * FROM chat_image_uploads ORDER BY id',\n            'chat_image_bundles'=>'SELECT * FROM chat_image_bundles ORDER BY intent_id',\n            'chat_image_items'=>'SELECT * FROM chat_image_items ORDER BY message_id,item_id',\n            'chat_image_objects'=>'SELECT * FROM chat_image_objects ORDER BY object_key',\n            'chat_image_reports'=>'SELECT * FROM chat_image_reports ORDER BY id',\n            'chat_image_audit'=>'SELECT * FROM chat_image_audit ORDER BY id',\n            'chat_governance_audit'=>'SELECT * FROM chat_governance_audit ORDER BY id',\n            'chat_reminder_events'=>'SELECT * FROM chat_reminder_events ORDER BY id',\n            'chat_reminder_clusters'=>'SELECT * FROM chat_reminder_clusters ORDER BY id',\n            'chat_reminder_budgets'=>'SELECT * FROM chat_reminder_budgets ORDER BY recipient_id',\n            'chat_reminder_intents'=>'SELECT * FROM chat_reminder_intents ORDER BY id',\n            'chat_reminder_receipts'=>'SELECT * FROM chat_reminder_receipts ORDER BY operation_id',\n            'chat_reminder_outbox'=>\"SELECT id,status,attempt_count,next_attempt_at,processed_at,SHA2(payload_json,256) payload_hash FROM message_outbox WHERE topic='chat_reminder' ORDER BY id\",\n        ];\n    }\n    public function facts(): array\n    {\n        if($this->db->inTransaction())throw new RuntimeException('CHAT_RECOVERY_TRANSACTION');\n        $this->db->exec('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ');\n        $this->db->beginTransaction();\n        try{\n            $result=[];\n            foreach(self::queries() as $name=>$query){\n                // PDO unbuffered scan, one row in memory. JSON numeric values are\n                // normalized to strings for driver/PHP patch-version stability.\n                $this->db->setAttribute(PDO::MYSQL_ATTR_USE_BUFFERED_QUERY,false);\n                $rows=$this->db->query($query);$hash=hash_init('sha256');$count=0;\n                while($row=$rows->fetch(PDO::FETCH_ASSOC)){\n                    foreach($row as &$value)if($value!==null)$value=(string)$value;unset($value);\n                    hash_update($hash,json_encode($row,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR).\"\\n\");$count++;\n                }\n                $rows->closeCursor();\n                $result[$name]=['count'=>$count,'sha256'=>hash_final($hash)];\n            }\n            $this->db->commit();return$result;\n        }catch(\\Throwable $e){if($this->db->inTransaction())$this->db->rollBack();throw new RuntimeException('CHAT_RECOVERY_FACTS_UNAVAILABLE');}\n        finally{$this->db->setAttribute(PDO::MYSQL_ATTR_USE_BUFFERED_QUERY,true);}\n    }\n    private function coordinate(): array\n    {\n        $row=$this->db->query('SHOW MASTER STATUS')->fetch(PDO::FETCH_ASSOC);\n        $uuid=(string)$this->db->query('SELECT @@server_uuid')->fetchColumn();\n        if(!$row||!isset($row['File'],$row['Position'])||$uuid==='')throw new RuntimeException('CHAT_RECOVERY_BINLOG_REQUIRED');\n        return ['server_uuid'=>$uuid,'file'=>(string)$row['File'],'position'=>(string)$row['Position']];\n    }\n    public function capture(): array\n    {\n        $this->blocked();$before=$this->coordinate();$facts=$this->facts();$after=$this->coordinate();\n        if($before!==$after)throw new RuntimeException('CHAT_RECOVERY_SOURCE_NOT_QUIESCENT');\n        $payload=['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,\n            'captured_at'=>gmdate('Y-m-d\\\\TH:i:s\\\\Z'),'watermark'=>$after,'facts'=>$facts];\n        $json=self::encode($payload);$sealed=['payload'=>$payload,'mac'=>hash_hmac('sha256',$json,$this->key)];\n        $this->write('checkpoint.json',$sealed);\n        // Latest anchor is independent of backup/restore. Never accept any older signed file.\n        $this->write('latest.json',['sha256'=>hash('sha256',self::encode($sealed)),'watermark'=>$after,'epoch'=>$this->epoch]);\n        return ['status'=>'captured','tables'=>count($facts),'watermark'=>$after];\n    }\n    public function verify(bool $release=false): array\n    {\n        $this->blocked();$sealed=$this->read('checkpoint.json',65536);$latest=$this->read('latest.json',4096);\n        $p=$sealed['payload']??null;$mac=$sealed['mac']??'';\n        if(!is_array($p)||!is_string($mac)||!hash_equals(hash_hmac('sha256',self::encode($p),$this->key),$mac)\n            ||($p['schema']??0)!==1||($p['environment']??'')!==$this->environment||($p['epoch']??'')!==$this->epoch\n            ||($latest['epoch']??'')!==$this->epoch||($latest['watermark']??null)!==($p['watermark']??null)\n            ||!hash_equals((string)($latest['sha256']??''),hash('sha256',self::encode($sealed))))throw new RuntimeException('CHAT_RECOVERY_CHECKPOINT_INVALID');\n        $current=$this->facts();$missing=[];\n        if(array_keys((array)($p['facts']??[]))!==array_keys($current))throw new RuntimeException('CHAT_RECOVERY_CONTRACT_CHANGED');\n        foreach($current as $table=>$fact)if($fact!==$p['facts'][$table])$missing[]=$table;\n        if($missing)return['status'=>'blocked','mismatched_tables'=>$missing,'notification_replayed'=>false];\n        if($release){\n            $continuity=$this->read('continuity.json',8192);$proof=$continuity['payload']??null;\n            if(!is_array($proof)||($proof['schema']??0)!==1||($proof['environment']??'')!==$this->environment\n                ||($proof['epoch']??'')!==$this->epoch||($proof['watermark']??null)!==$p['watermark']\n                ||($proof['complete']??false)!==true\n                ||!hash_equals(hash_hmac('sha256',self::encode($proof),$this->key),(string)($continuity['mac']??'')))throw new RuntimeException('CHAT_RECOVERY_INCREMENT_GAP');\n        }\n        if($release)$this->write('gate.json',['schema'=>1,'environment'=>$this->environment,'epoch'=>$this->epoch,'state'=>'ready']);\n        return['status'=>$release?'ready':'verified','tables'=>count($current),'notification_replayed'=>false];\n    }\n    /** Explicit maintenance-account purge; normal Go audit grants remain INSERT/SELECT only. */\n    public function pruneAudit(): array\n    {\n        $this->blocked();\n        $progress=is_file($this->directory.'/audit-progress.json')?$this->read('audit-progress.json',4096):[];\n        $rules=[\n            'chat_governance_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.retain_until>UTC_TIMESTAMP(6) AND (c.conversation_id=chat_governance_audit.conversation_id OR c.subject_id=chat_governance_audit.actor_id OR c.reporter_id=chat_governance_audit.actor_id))\",\n            'chat_image_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c JOIN chat_send_intents i ON i.id=chat_image_audit.intent_id WHERE c.retain_until>UTC_TIMESTAMP(6) AND ((c.target_type='image_intent' AND c.target_id=i.id) OR (c.target_type='message' AND c.target_id=i.message_id)))\",\n            'chat_auditor_grant_audit'=>\"NOT EXISTS(SELECT 1 FROM chat_cases c WHERE c.retain_until>UTC_TIMESTAMP(6) AND (c.subject_id=chat_auditor_grant_audit.user_id OR c.reporter_id=chat_auditor_grant_audit.user_id))\",\n        ];\n        $counts=[];\n        $this->journal(['action'=>'audit.prune.begin','epoch'=>$this->epoch,'days'=>365,'at'=>gmdate('c')]);\n        foreach($rules as $table=>$hold){\n            $after=(string)($progress[$table]??'0');\n            if(preg_match('/^[0-9]{1,20}$/D',$after)!==1)throw new RuntimeException('CHAT_AUDIT_CURSOR');\n            $stmt=$this->db->prepare('SELECT id FROM '.$table.' WHERE id>? ORDER BY id LIMIT 100');$stmt->execute([$after]);\n            $ids=$stmt->fetchAll(PDO::FETCH_COLUMN);$removed=0;\n            foreach($ids as $id){\n                $delete=$this->db->prepare('DELETE FROM '.$table.' WHERE id=? AND created_at<UTC_TIMESTAMP(6)-INTERVAL 365 DAY AND '.$hold);\n                $delete->execute([(string)$id]);$removed+=$delete->rowCount();\n            }\n            $progress[$table]=count($ids)<100?'0':(string)end($ids);\n            $counts[$table]=['scanned'=>count($ids),'deleted'=>$removed,'next_after'=>$progress[$table]];\n        }\n        $this->write('audit-progress.json',$progress);\n        $this->journal(['action'=>'audit.prune.complete','epoch'=>$this->epoch,'counts'=>$counts,'at'=>gmdate('c')]);\n        return ['status'=>'maintenance_blocked','audit'=>$counts,'recapture_required'=>true];\n    }\n    private function journal(array $v): void\n    {\n        $file=$this->directory.'/maintenance.jsonl';\n        if(is_link($file))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        $h=fopen($file,'ab');if(!$h)throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        try{\n            if(!chmod($file,0640)||!flock($h,LOCK_EX))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n            $raw=self::encode($v).\"\\n\";\n            if(fwrite($h,$raw)!==strlen($raw)||!fflush($h)||!fsync($h))throw new RuntimeException('CHAT_MAINTENANCE_LOG');\n        }finally{flock($h,LOCK_UN);fclose($h);}\n        $this->syncDirectory();\n    }\n    private function read(string $file,int $limit): array\n    {\n        $path=$this->directory.'/'.$file;\n        if(!is_file($path)||is_link($path)||filesize($path)>$limit||(fileperms($path)&0022)!==0)throw new RuntimeException('CHAT_RECOVERY_FILE_INVALID');\n        $raw=file_get_contents($path);$v=is_string($raw)?json_decode($raw,true):null;\n        if(!is_array($v))throw new RuntimeException('CHAT_RECOVERY_FILE_INVALID');return$v;\n    }\n    private function write(string $name,array $value): void\n    {\n        $path=$this->directory.'/'.$name;$temporary=$path.'.'.bin2hex(random_bytes(8));\n        $handle=fopen($temporary,'x');if(!$handle)throw new RuntimeException('CHAT_RECOVERY_WRITE');\n        try{$raw=self::encode($value);if(!chmod($temporary,0640)||fwrite($handle,$raw)!==strlen($raw)||!fflush($handle)||!fsync($handle))throw new RuntimeException('CHAT_RECOVERY_WRITE');}\n        finally{fclose($handle);}\n        if(!rename($temporary,$path)){unlink($temporary);throw new RuntimeException('CHAT_RECOVERY_WRITE');}\n        $this->syncDirectory();\n    }\n    private function syncDirectory(): void\n    {\n        $handle=fopen($this->directory,'r');\n        if(!$handle)throw new RuntimeException('CHAT_RECOVERY_DURABILITY');\n        try{if(!fsync($handle))throw new RuntimeException('CHAT_RECOVERY_DURABILITY');}finally{fclose($handle);}\n    }\n    private static function encode(array $v): string{return(string)json_encode($v,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR);}\n}\n","server/bin/chat-recovery.php":"<?php\ndeclare(strict_types=1);\nif(PHP_SAPI!=='cli'){http_response_code(404);exit;}\nrequire dirname(__DIR__).'/bootstrap.php';\ntry {\n    if(!is_installed()||upgrade_required()||count($argv)!==2||!in_array($argv[1],['block','capture','verify','release','prune-audit'],true))throw new RuntimeException('CHAT_RECOVERY_USAGE');\n    $config=(array)app_config('chat',[]);\n    $env=['testing'=>'test','development'=>'development','production'=>'production'][(string)app_config('app.env','production')]??'';\n    $directory=(string)($config['recovery_directory']??'');\n    if((string)($config['recovery_gate_file']??'')!==rtrim($directory,'/\\\\').'/gate.json')throw new RuntimeException('CHAT_RECOVERY_GATE_PATH');\n    $name=(string)($config['recovery_key_env']??'');\n    if(preg_match('/^CHAT_[A-Z0-9_]{1,60}$/D',$name)!==1)throw new RuntimeException('CHAT_RECOVERY_KEY');\n    $encoded=getenv($name);$key=is_string($encoded)?base64_decode($encoded,true):false;\n    if(!is_string($key)||strlen($key)!==32||base64_encode($key)!==$encoded)throw new RuntimeException('CHAT_RECOVERY_KEY');\n    $ops=new \\WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryCheckpoint(db()->pdo(),$env,$key,$directory,(string)($config['recovery_epoch']??''));\n    if($argv[1]==='block'){$ops->block();$result=['status'=>'blocked'];}\n    elseif($argv[1]==='prune-audit')$result=$ops->pruneAudit();\n    elseif($argv[1]==='capture')$result=$ops->capture();\n    else $result=$ops->verify($argv[1]==='release');\n    fwrite(STDOUT,json_encode($result,JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES).\"\\n\");\n    exit(($result['status']??'')==='blocked'&&$argv[1]!=='block'?1:0);\n}catch(Throwable $e){fwrite(STDERR,\"聊天恢复核验未通过，保持维护状态\\n\");exit(1);}\n","chat/internal/message/retention_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"testing\"\n)\n\nfunc TestS22RetentionBounds(t *testing.T) {\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tif c.Validate() != nil {\n\t\tt.Fatal(\"default retention\")\n\t}\n\tfor _, bad := range []RetentionConfig{{true, 89, 30, 90, 20}, {true, 365, 29, 90, 20}, {true, 365, 30, 0, 20}, {true, 365, 30, 90, 51}} {\n\t\tif bad.Validate() == nil {\n\t\t\tt.Fatal(\"unsafe retention\", bad)\n\t\t}\n\t}\n}\nfunc TestMySQLS22RetentionFloorsEvidenceAndMinimalFacts(t *testing.T) {\n\tf, s, h, q := historyFixture(t, 4)\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY WHERE conversation_id=? AND seq<=2`, string(q.ConversationID))\n\tf.exec(`UPDATE chat_message_changes SET created_at=UTC_TIMESTAMP(6)-INTERVAL 100 DAY WHERE conversation_id=? AND change_seq<=2`, string(q.ConversationID))\n\tbefore := readPage(t, h, HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, err := NewRetention(f.goDB, \"test\", c)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, err := r.Pass(f.ctx, \"0\")\n\tif err != nil || result.Messages != 2 || result.Changes != 2 {\n\t\tt.Fatal(result, err)\n\t}\n\tif f.text(\"SELECT sync_floor_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"2\" || f.text(\"SELECT change_floor_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"2\" {\n\t\tt.Fatal(\"noncontiguous floors\")\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_messages WHERE seq<=2 AND text_body IS NOT NULL\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_messages\") != \"4\" {\n\t\tt.Fatal(\"body or minimal fact loss\")\n\t}\n\tafter := readPage(t, h, HistoryRequest{ConversationID: q.ConversationID}, \"bootstrap\")\n\tif len(after.Messages) != 2 || after.Messages[0].Seq != \"3\" {\n\t\tt.Fatal(\"expired body visible\", after)\n\t}\n\tchanged, err := h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: before.ChangeCursor}, \"changes\")\n\tif err != nil || len(changed.Changes) != 2 {\n\t\tt.Fatal(\"cache invalidation\", changed, err)\n\t}\n\tfor _, v := range changed.Changes {\n\t\tif v.Message.Text != nil || v.Type != \"message.expired\" {\n\t\t\tt.Fatal(\"expiration leaked\", v)\n\t\t}\n\t}\n\t// Current signed sync snapshot still resumes, but a signed old floor must resync.\n\told, err := h.parse(before.SyncCursor, \"sync\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\told.Position = \"0\"\n\tif _, err = h.Read(f.ctx, principal(\"10202\"), HistoryRequest{ConversationID: q.ConversationID, Cursor: h.sign(old)}, \"sync\"); err != ErrResync {\n\t\tt.Fatal(\"old cursor did not resync\", err)\n\t}\n\t_ = s\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT last_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"4\" {\n\t\tt.Fatal(\"cleanup reset seq\")\n\t}\n}\nfunc TestMySQLS22LegalCaseProtectsBodyAndReleasedEvidenceExpires(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tout := accepted(t, s, q)\n\tg, _ := governanceFixture(t, f, s, nil)\n\t_, err := g.Report(f.ctx, principal(\"10203\"), q.ConversationID, out.MessageID, \"\", \"证据保留验证\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY WHERE id=?`, string(out.MessageID))\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT sync_floor_seq FROM chat_conversations WHERE id=?\", string(q.ConversationID)) != \"0\" {\n\t\tt.Fatal(\"active case purged\")\n\t}\n\tf.exec(`UPDATE chat_cases SET retain_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND`)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(out.MessageID)) != \"expired\" {\n\t\tt.Fatal(\"expired hold retained body\")\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_send_intents WHERE message_id=?\", string(out.MessageID)) != \"1\" {\n\t\tt.Fatal(\"minimum idempotency fact deleted\")\n\t}\n}\nfunc TestMySQLS22RecalledEvidenceExpiresWithoutRevivingOrSending(t *testing.T) {\n\tf, s, q := setupMessage(t, safetyFunc(pass))\n\tout := accepted(t, s, q)\n\tif _, err := s.Recall(f.ctx, principal(\"10202\"), q.ConversationID, out.MessageID); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 40 DAY,recalled_at=UTC_TIMESTAMP(6)-INTERVAL 35 DAY WHERE id=?`, string(out.MessageID))\n\tf.exec(`UPDATE chat_message_changes SET created_at=UTC_TIMESTAMP(6)-INTERVAL 35 DAY WHERE message_id=?`, string(out.MessageID))\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err := r.Pass(context.Background(), \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT state FROM chat_messages WHERE id=?\", string(out.MessageID)) != \"recalled\" || f.text(\"SELECT COUNT(*) FROM chat_messages WHERE text_body IS NOT NULL\") != \"0\" {\n\t\tt.Fatal(\"evidence body retained\")\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_reminder_events\") != \"1\" {\n\t\tt.Fatal(\"cleanup re-enqueued reminder\")\n\t}\n}\n\ntype retryDeleteStorage struct {\n\t*imageMemory\n\tfail bool\n}\n\nfunc (s *retryDeleteStorage) Delete(ctx context.Context, key string) error {\n\tif s.fail {\n\t\treturn ErrMedia\n\t}\n\treturn s.imageMemory.Delete(ctx, key)\n}\nfunc TestMySQLS22SharedMediaSurvivesFirstExpiryAndDeletionRetries(t *testing.T) {\n\tf, s, m, storage, q := mediaFixture(t)\n\tq.Items = []MediaItem{mediaAdd(t, m, storage, q.ConversationID, 301, \"shared-construction\")}\n\tmediaProcess(t, m, 1)\n\tif _, err := s.Send(f.ctx, principal(\"10202\"), q); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tm.Advance(f.ctx)\n\tmediaApprove(t, m)\n\tfirst, err := s.Query(f.ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tq.ClientMessageID = client(223)\n\tif _, err = s.Send(f.ctx, principal(\"10202\"), q); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tm.Advance(f.ctx)\n\tmediaApprove(t, m)\n\tsecond, err := s.Query(f.ctx, principal(\"10202\"), q.ConversationID, q.ClientMessageID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tmain := f.text(\"SELECT main_key FROM chat_image_uploads WHERE id=?\", string(q.Items[0].AttachmentID))\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY WHERE id=?`, string(first.MessageID))\n\tf.exec(`UPDATE chat_image_uploads SET expires_at=UTC_TIMESTAMP(6)-INTERVAL 1 DAY`)\n\tf.exec(`UPDATE chat_image_objects SET created_at=UTC_TIMESTAMP(6)-INTERVAL 2 DAY`)\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err = m.CleanOne(f.ctx); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstorage.mu.Lock()\n\t_, kept := storage.objects[main]\n\tstorage.mu.Unlock()\n\tif !kept || f.text(\"SELECT COUNT(*) FROM chat_image_items\") != \"1\" {\n\t\tt.Fatal(\"shared delivery object deleted\")\n\t}\n\tif _, err = m.URL(f.ctx, principal(\"10202\"), q.ConversationID, second.MessageID, q.Items[0].AttachmentID, false); err != nil {\n\t\tt.Fatal(\"remaining reference denied\", err)\n\t}\n\tf.exec(`UPDATE chat_messages SET created_at=UTC_TIMESTAMP(6)-INTERVAL 400 DAY WHERE id=?`, string(second.MessageID))\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err = m.URL(f.ctx, principal(\"10202\"), q.ConversationID, second.MessageID, q.Items[0].AttachmentID, false); err == nil {\n\t\tt.Fatal(\"expired media still signed\")\n\t}\n\tfailed := &retryDeleteStorage{storage, true}\n\tm.storage = failed\n\tif err = m.CleanOne(f.ctx); err != ErrMedia || f.text(\"SELECT COUNT(*) FROM chat_image_objects\") != \"2\" {\n\t\tt.Fatal(\"failed deletion discarded ledger\", err)\n\t}\n\tfailed.fail = false\n\tfor i := 0; i < 3; i++ {\n\t\tif err = m.CleanOne(f.ctx); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_image_objects\") != \"0\" {\n\t\tt.Fatal(\"orphan objects not retried\")\n\t}\n}\nfunc TestMySQLS22DueRiskRevisitedAfterReviewAlreadyExpired(t *testing.T) {\n\tsafety := safetyFunc(func(context.Context, ports.TextRequest) (ports.SafetyResult, error) {\n\t\treturn ports.SafetyResult{Decision: \"blocked\", RuleVersion: \"s22-fixture\", Finding: &ports.SafetyFinding{Provider: \"local.anti_diversion\", Code: \"fixture_risk\", Level: 2, Confirmed: true}}, nil\n\t})\n\tf, s, q := setupMessage(t, safety)\n\tout, err := s.Send(f.ctx, principal(\"10202\"), q)\n\tif err != nil || out.RiskEventID == \"\" {\n\t\tt.Fatal(out, err)\n\t}\n\tf.exec(`UPDATE chat_cases SET retain_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND`)\n\tc := DefaultRetentionConfig()\n\tc.Enabled = true\n\tr, _ := NewRetention(f.goDB, \"test\", c)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_cases WHERE state='expired' AND reason=''\") != \"1\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE text_evidence<>''\") != \"1\" {\n\t\tt.Fatal(\"separate case/risk TTL\")\n\t}\n\tf.exec(`UPDATE chat_risk_events SET retain_until=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND`)\n\tif _, err = r.Pass(f.ctx, \"0\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE text_evidence<>'' OR context_evidence<>''\") != \"0\" || f.text(\"SELECT COUNT(*) FROM chat_risk_events WHERE confirmed=1\") != \"1\" {\n\t\tt.Fatal(\"expired review stranded evidence or lost minimal count\")\n\t}\n}\n","chat/internal/dependencies/operations_test.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestS22IndependentGateNeverAcceptsRestoredOrMalformedReady(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"gate.json\")\n\tepoch := strings.Repeat(\"a\", 64)\n\tc := OperationsConfig{path, epoch}\n\tif c.Ready(\"test\") || !c.Validate(true) || (OperationsConfig{}).Validate(true) {\n\t\tt.Fatal(\"missing recovery evidence\")\n\t}\n\twrite := func(raw string) {\n\t\tt.Helper()\n\t\tif os.WriteFile(path, []byte(raw), 0640) != nil {\n\t\t\tt.Fatal(\"gate write\")\n\t\t}\n\t}\n\tgood := `{\"schema\":1,\"environment\":\"test\",\"epoch\":\"` + epoch + `\",\"state\":\"ready\"}`\n\twrite(good)\n\tif !c.Ready(\"test\") || c.Ready(\"production\") {\n\t\tt.Fatal(\"environment isolation\")\n\t}\n\tfor _, raw := range []string{strings.Replace(good, \"ready\", \"blocked\", 1), strings.Replace(good, epoch, strings.Repeat(\"b\", 64), 1), good + \"{}\", strings.Replace(good, `\"state\":\"ready\"`, `\"state\":\"blocked\",\"state\":\"ready\"`, 1)} {\n\t\twrite(raw)\n\t\tif c.Ready(\"test\") {\n\t\t\tt.Fatal(\"invalid gate accepted\")\n\t\t}\n\t}\n\twrite(good)\n\tif os.Chmod(path, 0666) != nil {\n\t\tt.Fatal(\"chmod\")\n\t}\n\tif c.Ready(\"test\") {\n\t\tt.Fatal(\"world-writable ready accepted\")\n\t}\n}\n\ntype gateCommandFixture struct{ called bool }\n\nfunc (g *gateCommandFixture) Execute(context.Context, ports.Principal, string, json.RawMessage) (string, any, error) {\n\tg.called = true\n\treturn \"\", nil, nil\n}\nfunc TestS22GateProtectsAlreadyAuthenticatedWSSAndPrivateMetrics(t *testing.T) {\n\tr := &Runtime{environment: \"test\", operations: OperationsConfig{filepath.Join(t.TempDir(), \"missing.json\"), strings.Repeat(\"a\", 64)}}\n\tinner := &gateCommandFixture{}\n\tg := guardedCommands{r, inner}\n\tif _, _, err := g.Execute(context.Background(), ports.Principal{}, \"history.request\", nil); err == nil || inner.called {\n\t\tt.Fatal(\"old socket bypassed recovery\")\n\t}\n\tw := httptest.NewRecorder()\n\tr.Metrics(w, httptest.NewRequest(\"GET\", \"/metrics\", nil))\n\tif !strings.Contains(w.Body.String(), \"chat_recovery_ready 0\") || strings.Contains(w.Body.String(), \"missing.json\") {\n\t\tt.Fatal(\"metric privacy\")\n\t}\n}\n","server/tests/chat_operations_contract.php":"<?php\ndeclare(strict_types=1);\nif(getenv('CHAT_AUTH_TEST_INTEGRATION')!=='1'){echo \"隔离运行未启用\\n\";exit;}\nrequire_once dirname(__DIR__).'/app/Support/functions.php';\nspl_autoload_register(static function(string $class):void{$prefix='WorkerAdmin\\\\';if(strpos($class,$prefix)===0){$file=dirname(__DIR__).'/app/'.str_replace('\\\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require_once$file;}});\nrequire_once __DIR__.'/chat_platform_contract.php';\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryCheckpoint;\nuse WorkerAdmin\\Infrastructure\\Chat\\ChatRecoveryGate;\nuse WorkerAdmin\\Infrastructure\\Testing\\DatabaseTestCenterChatActionRunner;\nuse WorkerAdmin\\Contracts\\TestCenterActionRunner;\nfunction operationsEnsure(bool $ok,string $why):void{if(!$ok)throw new RuntimeException($why);}\nfunction operationsReject(callable $call,string $why):void{$failed=false;try{$call();}catch(Throwable $e){$failed=true;}operationsEnsure($failed,$why);}\n$address=(string)(getenv('CHAT_RECOVERY_TEST_MYSQL_ADDR')?:getenv('CHAT_INTEGRATION_MYSQL_ADDR'));\nif(preg_match('/^127\\\\.0\\\\.0\\\\.1:([0-9]+)$/D',$address,$match)!==1)throw new RuntimeException('loopback required');\n$config=['host'=>'127.0.0.1','port'=>(int)$match[1],'database'=>'mysql','username'=>'root','password'=>(string)getenv('CHAT_INTEGRATION_ADMIN_PASSWORD'),'charset'=>'utf8mb4'];\n$root=new Database($config);\n$mode=(string)($argv[1]??'');$verification=in_array($mode,['--verify-restored-old','--verify-replayed'],true);$importing=$mode==='--import-report';\n$control=(string)getenv('CHAT_RECOVERY_TEST_CONTROL_DIR');\n$meta=($verification||$importing)?json_decode((string)file_get_contents($control.'/fixture-meta.json'),true):[];\n$name=($verification||$importing)?(string)($meta['database']??''):'bixuan_test_chat_ops_'.bin2hex(random_bytes(6));\nif(preg_match('/^bixuan_test_chat_ops_[a-f0-9]{12}$/D',$name)!==1)throw new RuntimeException('isolated recovery database required');\nif(!$verification&&!$importing)$root->execute('CREATE DATABASE `'.$name.'` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');\n$config['database']=$name;$GLOBALS['worker_admin_config']=['app'=>['env'=>'testing'],'database'=>$config];$db=db();\n$export=(string)getenv('CHAT_RECOVERY_TEST_CONTROL_DIR');\n$dir=$export!==''?$export:sys_get_temp_dir().'/chat-recovery-'.bin2hex(random_bytes(8));if(!is_dir($dir))mkdir($dir,0700,true);chmod($dir,0700);\n$receiptBody=static function(string $op):string{return json_encode(['cluster_version'=>'1','conversation_id'=>'401','intent_id'=>'1','operation_id'=>$op,'recipient_id'=>'10203','target_seq'=>'2'],JSON_THROW_ON_ERROR|JSON_UNESCAPED_SLASHES);};\nif($importing){\n $GLOBALS['worker_admin_config']['chat']=['test_report_revision'=>(string)getenv('CHAT_VERIFIED_SOURCE_REVISION'),'test_report_key_env'=>'CHAT_TEST_REPORT_KEY'];\n $inner=new class implements TestCenterActionRunner{public function available(string $id):array{return['items'=>[]];}public function run(string $id,string $a,array $i,int $u,string $k):array{throw new RuntimeException('inner');}};\n $actions=new DatabaseTestCenterChatActionRunner($db,$inner);$id=str_repeat('T',26);\n $raw=(string)file_get_contents((string)getenv('CHAT_TEST_CENTER_SIGNED_REPORT'));\n $report=['chat_report'=>$raw];\n $first=$actions->run($id,'chat_result_import',$report,1,'chat:report:actual');\n $again=$actions->run($id,'chat_result_import',$report,1,'chat:report:actual');\n operationsEnsure($first['regression_passed']===true&&!empty($again['replayed']),'actual signed Go result did not reach original center');\n $bad=json_decode($raw,true);$bad['mac']=str_repeat('0',64);\n operationsReject(static fn()=>$actions->run($id,'chat_result_import',['chat_report'=>json_encode($bad)],1,'chat:report:tampered'),'tampered Go result accepted');\n $GLOBALS['worker_admin_config']['chat']['test_report_revision']=str_repeat('0',40);\n operationsReject(static fn()=>$actions->run($id,'chat_result_import',$report,1,'chat:report:old-source'),'wrong source imported');\n echo \"原测试中心签名Go回归结果登记、同键重试、篡改和旧源码拒绝验证通过\\n\";exit;\n}\nif($verification){\n $ops=new ChatRecoveryCheckpoint($db->pdo(),'test',str_repeat('k',32),$dir,str_repeat('e',64));\n if($mode==='--verify-restored-old'){\n  operationsEnsure($ops->verify()['status']==='blocked','old backup unexpectedly opened');\n  echo \"旧备份缺少最新撤权及提醒回执，已保持隔离\\n\";exit;\n }\n try{\n  operationsEnsure($ops->verify(true)['status']==='ready','continuous binlog replay differs from final source');\n  operationsEnsure($db->fetchValue('SELECT state FROM chat_messages WHERE id=1')==='recalled'&&$db->fetchValue('SELECT status FROM users WHERE id=10203')==='disabled','replay resurrected recall or removed authority');\n  $before=(int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\");\n  $receipts=new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts($db);\n  operationsEnsure($receipts->receive($receiptBody(str_repeat('a',64)))['state']==='provider_unknown','unknown receipt resurrected');\n  operationsEnsure($receipts->receive($receiptBody(str_repeat('b',64)))['state']==='sent','sent receipt replayed');\n  operationsEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox WHERE topic='chat_reminder'\")===$before,'restore duplicated notification');\n  operationsEnsure((int)$db->fetchValue('SELECT COUNT(*) FROM user_wallet_ledger')===0&&(int)$db->fetchValue('SELECT COUNT(*) FROM worker_balance_ledger')===0,'restore charged wallet');\n  echo \"真实旧备份 + 连续 binlog 恢复、撤权与提醒未知/已发送幂等及无资金副作用验证通过\\n\";\n }finally{$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');}\n exit;\n}\ntry{\n (new \\WorkerAdmin\\Support\\SqlScriptRunner())->runFile($db->pdo(),dirname(__DIR__).'/database/database.sql');\n chatPlatformSeed($db);\n $db->execute(\"UPDATE orders SET is_demo=1 WHERE id=401\");\n $id=str_repeat('T',26);\n $db->execute(\"INSERT INTO test_batches(id,public_id,create_request_key,request_digest,app_version,environment,created_by_admin_id) VALUES(1,:public,'chat',REPEAT('a',64),'2.7.0','testing',1)\",['public'=>str_repeat('B',26)]);\n $db->execute(\"INSERT INTO test_instances(id,public_id,batch_id,scenario_key,order_id,order_no_snapshot,params_digest,build_status,created_by_admin_id) VALUES(1,:public,1,'platform.construction',401,'CHAT-PLATFORM-401',REPEAT('a',64),'built',1)\",['public'=>$id]);\n $inner=new class implements TestCenterActionRunner{public function available(string $id):array{return['items'=>[]];}public function run(string $id,string $action,array $input,int $admin,string $key):array{throw new RuntimeException('inner untouched');}};\n $actions=new DatabaseTestCenterChatActionRunner($db,$inner);\n operationsEnsure(isset($actions->available($id)['items']['chat_fixture_export']),'chat not in existing center');\n $first=$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:test:1');\n $again=$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:test:1');\n operationsEnsure(!empty($again['replayed'])&&$again['operation_mode']==='isolated_fixture','fixture retry not durable');\n operationsEnsure($first['business']['tests_executed']===false&&$first['business']['status']==='fixture_ready','fixture claimed real test success');\n operationsEnsure((int)$db->fetchValue('SELECT COUNT(*) FROM test_runs')===1,'fixture duplicate run');\n operationsEnsure((int)$db->fetchValue(\"SELECT COUNT(*) FROM message_outbox\")===0,'fixture touched real outbox');\n $json=json_encode($first['business']['fixture'],JSON_THROW_ON_ERROR);\n operationsEnsure(strpos($json,'10202')===false&&strpos($json,'401')===false&&strpos($json,'token')===false,'export contains source identity');\n operationsReject(static fn()=>$actions->run($id,'chat_fixture_export',['chat_suite'=>'http://outside/'],1,'chat:bad'),'unbounded suite');\n $GLOBALS['worker_admin_config']['app']['env']='production';\n operationsEnsure(!isset($actions->available($id)['items']['chat_fixture_export']),'production action visible');\n operationsReject(static fn()=>$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:prod'),'production export ran');\n $GLOBALS['worker_admin_config']['app']['env']='testing';\n $db->execute(\"UPDATE orders SET is_demo=0 WHERE id=401\");\n operationsReject(static fn()=>$actions->run($id,'chat_fixture_export',['chat_suite'=>'recovery'],1,'chat:real'),'real order exported');\n $db->execute(\"UPDATE orders SET is_demo=1 WHERE id=401\");\n $instance=$db->fetch('SELECT * FROM test_instances WHERE id=1');$order=$db->fetch('SELECT * FROM orders WHERE id=401');\n $fixtureDir=(string)getenv('CHAT_TEST_CENTER_FIXTURE_DIR');\n if($fixtureDir!==''){\n  if(!is_dir($fixtureDir))mkdir($fixtureDir,0700,true);\n  foreach(['ordinary'=>['consumer','construction','multi_quote'],'measurement'=>['consumer','measurement','multi_quote'],'single_grab'=>['consumer','construction','single_grab'],'platform'=>['platform','construction','multi_quote']] as $label=>$profile){\n   [$order['order_source_type'],$order['workflow_profile'],$order['dispatch_mode']]=$profile;\n   file_put_contents($fixtureDir.'/'.$label.'.json',json_encode(DatabaseTestCenterChatActionRunner::fixture($instance,$order,'recovery'),JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR));\n  }\n }\n $epoch=str_repeat('e',64);$key=str_repeat('k',32);$ops=new ChatRecoveryCheckpoint($db->pdo(),'test',$key,$dir,$epoch);\n $gate=['recovery_gate_file'=>$dir.'/gate.json','recovery_epoch'=>$epoch];\n operationsEnsure(!ChatRecoveryGate::ready($gate,'test'),'missing gate ready');\n $ops->block();\n $db->execute(\"INSERT INTO chat_cases(kind,target_type,target_id,item_id,conversation_id,reporter_id,subject_id,target_version,fingerprint,reason,state,version,retain_until,created_at) VALUES('appeal','restriction',10203,0,0,10203,10203,1,REPEAT('c',64),'审计保留','pending',1,UTC_TIMESTAMP()+INTERVAL 30 DAY,UTC_TIMESTAMP())\");\n for($i=0;$i<102;$i++)$db->execute(\"INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,reason,created_at) VALUES('system',10202,REPEAT('a',64),'fixture.expired','过期审计',UTC_TIMESTAMP()-INTERVAL 400 DAY)\");\n $db->execute(\"INSERT INTO chat_governance_audit(actor_kind,actor_id,session_binding,action,reason,created_at) VALUES('system',10203,REPEAT('a',64),'fixture.hold','争议保留',UTC_TIMESTAMP()-INTERVAL 400 DAY)\");\n $prune=$ops->pruneAudit();operationsEnsure($prune['audit']['chat_governance_audit']['scanned']===100,'unbounded audit cleanup');\n $ops->pruneAudit();\n operationsEnsure((int)$db->fetchValue('SELECT COUNT(*) FROM chat_governance_audit')===1,'held audit removed or old audit uncollected');\n $db->execute(\"INSERT INTO chat_conversations(id,conversation_type,scope_key,order_id,assignment_id,policy_version,snapshot_hash,episode_key,state,last_seq,last_change_seq,created_at,updated_at) VALUES(1,'order','restore-fixture',401,401,1,REPEAT('a',64),'restore-fixture','open',1,1,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\");\n $db->execute(\"INSERT INTO chat_messages(id,conversation_id,seq,sender_id,client_message_id,policy_version,message_type,text_body,state,state_version,safety_rule_version,created_at) VALUES(1,1,1,10202,CONCAT('1700000000.',REPEAT('a',32)),1,'text','隔离恢复证据','published',1,'restore-fixture',UTC_TIMESTAMP(6))\");\n $db->execute(\"INSERT INTO chat_send_intents(id,sender_id,conversation_id,client_message_id,fingerprint,state,message_id,action_expires_at,retain_until,created_at,updated_at) VALUES(1,10202,1,CONCAT('1700000000.',REPEAT('a',32)),REPEAT('a',64),'accepted',1,UTC_TIMESTAMP()+INTERVAL 1 DAY,UTC_TIMESTAMP()+INTERVAL 31 DAY,UTC_TIMESTAMP(6),UTC_TIMESTAMP(6))\");\n $db->execute(\"INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(1,1,1,1,'message.accepted',UTC_TIMESTAMP(6))\");\n $receipts=new \\WorkerAdmin\\Application\\Chat\\ChatReminderReceipts($db);\n $receipts->receive($receiptBody(str_repeat('a',64)));\n $db->execute(\"UPDATE chat_reminder_receipts SET state='provider_unknown',diagnostic='provider_unknown' WHERE operation_id=REPEAT('a',64)\");\n $db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP() WHERE topic='chat_reminder'\");\n $capture=$ops->capture();\n operationsEnsure($capture['status']==='captured'&&count($ops->facts())===count(ChatRecoveryCheckpoint::queries()),'real MySQL snapshot');\n operationsEnsure($ops->verify()['status']==='verified','matching checkpoint rejected');\n operationsReject(static fn()=>$ops->verify(true),'missing independent increment evidence released');\n $old=file_get_contents($dir.'/checkpoint.json');if($export!==''){file_put_contents($dir.'/backup-checkpoint.json',$old);chmod($dir.'/backup-checkpoint.json',0640);}\n if($export!==''){\n  file_put_contents($dir.'/fixture-meta.json',json_encode(['database'=>$name],JSON_THROW_ON_ERROR));chmod($dir.'/fixture-meta.json',0640);\n  $backup=(string)getenv('CHAT_RECOVERY_TEST_BACKUP_PATH');\n  if($backup==='')throw new RuntimeException('explicit private backup path required');\n  $process=proc_open(['docker','exec','-e','MYSQL_PWD=s14-fixture-only','bxchat-recovery','mysqldump','-uroot','--single-transaction','--hex-blob','--routines','--triggers','--set-gtid-purged=OFF','--databases',$name],[0=>['pipe','r'],1=>['file',$backup,'w'],2=>['pipe','w']],$pipes);\n  if(!is_resource($process))throw new RuntimeException('isolated backup unavailable');\n  fclose($pipes[0]);stream_get_contents($pipes[2]);fclose($pipes[2]);\n  if(proc_close($process)!==0||!chmod($backup,0600))throw new RuntimeException('isolated backup failed');\n }\n $db->transaction(static function(Database $db):void{\n  $db->fetch('SELECT id FROM chat_conversations WHERE id=1 FOR UPDATE');\n  $db->execute(\"UPDATE chat_messages SET state='recalled',state_version=2,recalled_at=UTC_TIMESTAMP(6) WHERE id=1\");\n  $db->execute(\"INSERT INTO chat_message_changes(conversation_id,change_seq,message_id,state_version,change_type,created_at) VALUES(1,2,1,2,'message.recalled',UTC_TIMESTAMP(6))\");\n  $db->execute('UPDATE chat_conversations SET last_change_seq=2 WHERE id=1');\n });\n $receipts->receive($receiptBody(str_repeat('b',64)));\n $db->execute(\"UPDATE chat_reminder_receipts SET state='sent',diagnostic='sent' WHERE operation_id=REPEAT('b',64)\");\n $db->execute(\"UPDATE message_outbox SET status='processed',processed_at=UTC_TIMESTAMP() WHERE topic='chat_reminder'\");\n\n operationsEnsure($ops->verify()['status']==='blocked','post-backup recall and receipt changes not detected');\n $db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");$ops->capture();\n $new=file_get_contents($dir.'/checkpoint.json');\n $authority=$db->fetchAll('SELECT user_id,authority_version FROM chat_staff_authority_versions ORDER BY user_id');\n file_put_contents($dir.'/checkpoint.json',$old);\n operationsReject(static fn()=>$ops->verify(),'old signed checkpoint accepted');\n file_put_contents($dir.'/checkpoint.json',$new);\n $db->execute(\"UPDATE users SET status='active' WHERE id=10203\");\n $mismatch=$ops->verify();\n operationsEnsure($mismatch['status']==='blocked'&&in_array('users',$mismatch['mismatched_tables'],true)&&!ChatRecoveryGate::ready($gate,'test'),'restored old authority reopened');\n $db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");\n foreach($authority as $row)$db->execute('UPDATE chat_staff_authority_versions SET authority_version=:version WHERE user_id=:user',['version'=>$row['authority_version'],'user'=>$row['user_id']]);\n // A separate archive validator supplies this HMAC proof; this fixture models a\n // complete verified archive, never a live channel or an automatic success fallback.\n $sealed=json_decode($new,true);$proof=['schema'=>1,'environment'=>'test','epoch'=>$epoch,'watermark'=>$sealed['payload']['watermark'],'complete'=>true];\n $encode=static fn(array $v):string=>(string)json_encode($v,JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR);\n $continuity=['payload'=>$proof,'mac'=>hash_hmac('sha256',$encode($proof),$key)];\n file_put_contents($dir.'/continuity.json',$encode($continuity));chmod($dir.'/continuity.json',0640);\n operationsEnsure($ops->verify(true)['status']==='ready'&&ChatRecoveryGate::ready($gate,'test')&&!ChatRecoveryGate::ready($gate,'production'),'verified gate/environment');\n $ops->block();$db->execute(\"UPDATE users SET status='active' WHERE id=10203\");\n operationsEnsure($ops->verify()['status']==='blocked','post-checkpoint permission loss not detected');\n operationsEnsure(!ChatRecoveryGate::ready($gate,'test'),'failed verification reopened gate');\n if($export!==''){$db->execute(\"UPDATE users SET status='disabled' WHERE id=10203\");$ops->capture();}\n echo \"S21 测试中心实例/请求键/生产隔离、S22 MySQL 安全指纹/旧检查点/增量缺口/恢复门禁验证通过\\n\";\n}finally{\n if($export==='')$root->execute('DROP DATABASE IF EXISTS `'.$name.'`');\n if($export===''){foreach(['gate.json','checkpoint.json','latest.json','continuity.json','maintenance.jsonl','audit-progress.json'] as $file)if(is_file($dir.'/'.$file))unlink($dir.'/'.$file);rmdir($dir);}\n}\n","chat/scripts/seal-binlogs.py":"#!/usr/bin/env python3\n\"\"\"Validate a continuous archived binlog range; never execute its SQL.\"\"\"\nimport argparse, base64, hashlib, hmac, json, os, pathlib, re, subprocess, sys, tempfile\n\ndef encode(v):\n    return json.dumps(v,ensure_ascii=False,separators=(\",\",\":\")).encode()\ndef read(path,limit=65536):\n    path=pathlib.Path(path)\n    if path.is_symlink() or not path.is_file() or path.stat().st_size>limit or path.stat().st_mode&0o022:\n        raise ValueError(\"protected file required\")\n    def pairs(items):\n        out={}\n        for k,v in items:\n            if k in out: raise ValueError(\"duplicate field\")\n            out[k]=v\n        return out\n    return json.loads(path.read_bytes(),object_pairs_hook=pairs)\ndef sealed(path,key):\n    v=read(path);p=v[\"payload\"]\n    if not hmac.compare_digest(v[\"mac\"],hmac.new(key,encode(p),\"sha256\").hexdigest()):\n        raise ValueError(\"checkpoint signature\")\n    return p\ndef coordinate(v):\n    name=v[\"file\"];m=re.fullmatch(r\"([A-Za-z0-9_-]+\\.)([0-9]{6})\",name)\n    pos=v[\"position\"]\n    if not m or not re.fullmatch(r\"[0-9]{1,20}\",pos) or int(pos)<4 or not re.fullmatch(r\"[0-9a-f-]{36}\",v[\"server_uuid\"]):\n        raise ValueError(\"binlog coordinate\")\n    return m[1],int(m[2]),int(pos)\ndef verify_range(start,end,directory,binary):\n    a,first,position=coordinate(start);b,last,stop=coordinate(end)\n    if a!=b or start[\"server_uuid\"]!=end[\"server_uuid\"] or first>last or last-first>10000 or first==last and position>stop:\n        raise ValueError(\"noncontinuous range\")\n    root=pathlib.Path(directory).resolve(strict=True)\n    if not root.is_dir(): raise ValueError(\"archive directory\")\n    hashes={}\n    for n in range(first,last+1):\n        name=a+str(n).zfill(6);path=root/name\n        if path.is_symlink() or not path.is_file() or path.resolve().parent!=root:\n            raise ValueError(\"binlog gap\")\n        size=path.stat().st_size\n        lo=position if n==first else 4\n        hi=stop if n==last else size\n        if lo>hi or hi>size: raise ValueError(\"incomplete archive tail\")\n        with path.open(\"rb\") as f:\n            if f.read(4)!=b\"\\xfebin\": raise ValueError(\"binlog header\")\n            digest=hashlib.sha256()\n            f.seek(0)\n            while chunk:=f.read(1024*1024): digest.update(chunk)\n        cmd=[binary,\"--no-defaults\",\"--verify-binlog-checksum\",\"--start-position=\"+str(lo),\"--stop-position=\"+str(hi),str(path)]\n        p=subprocess.run(cmd,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=120)\n        if p.returncode: raise ValueError(\"binlog verification\")\n        hashes[name]={\"bytes\":size,\"sha256\":digest.hexdigest(),\"start\":lo,\"stop\":hi}\n    return hashes\n\ndef main(args):\n    encoded=os.environ.get(args.key_env,\"\")\n    if not re.fullmatch(r\"CHAT_[A-Z0-9_]{1,60}\",args.key_env): raise ValueError(\"key name\")\n    key=base64.b64decode(encoded,validate=True)\n    if len(key)!=32 or base64.b64encode(key).decode()!=encoded: raise ValueError(\"key\")\n    directory=pathlib.Path(args.control).resolve(strict=True)\n    gate=read(directory/\"gate.json\",1024)\n    if gate[\"state\"]!=\"blocked\": raise ValueError(\"maintenance required\")\n    before=sealed(args.backup_checkpoint,key)\n    after=sealed(directory/\"checkpoint.json\",key)\n    latest=read(directory/\"latest.json\",4096)\n    latest_hash=hashlib.sha256(encode(read(directory/\"checkpoint.json\"))).hexdigest()\n    if latest_hash!=latest[\"sha256\"] or latest[\"watermark\"]!=after[\"watermark\"]:\n        raise ValueError(\"stale checkpoint\")\n    for field in (\"schema\",\"environment\",\"epoch\"):\n        if before[field]!=after[field] or after[field]!=gate[field] or (field==\"schema\" and after[field]!=1):\n            raise ValueError(\"environment or epoch\")\n    binary=pathlib.Path(args.mysqlbinlog).resolve(strict=True)\n    if not binary.is_file() or not os.access(binary,os.X_OK): raise ValueError(\"explicit mysqlbinlog executable\")\n    hashes=verify_range(before[\"watermark\"],after[\"watermark\"],args.archive,str(binary))\n    p={\"schema\":1,\"environment\":after[\"environment\"],\"epoch\":after[\"epoch\"],\"watermark\":after[\"watermark\"],\n        \"complete\":True,\"from\":before[\"watermark\"],\"archive_sha256\":hashlib.sha256(encode(hashes)).hexdigest()}\n    proof={\"payload\":p,\"mac\":hmac.new(key,encode(p),\"sha256\").hexdigest()}\n    fd,name=tempfile.mkstemp(prefix=\".continuity-\",dir=directory)\n    try:\n        os.fchmod(fd,0o640)\n        with os.fdopen(fd,\"wb\") as out:\n            out.write(encode(proof));out.flush();os.fsync(out.fileno())\n        os.replace(name,directory/\"continuity.json\")\n    finally:\n        if os.path.exists(name): os.unlink(name)\n    print(json.dumps({\"status\":\"verified\",\"files\":len(hashes),\"sql_executed\":False}))\nif __name__==\"__main__\":\n    p=argparse.ArgumentParser()\n    p.add_argument(\"--control\",required=True);p.add_argument(\"--backup-checkpoint\",required=True)\n    p.add_argument(\"--archive\",required=True);p.add_argument(\"--mysqlbinlog\",required=True)\n    p.add_argument(\"--key-env\",default=\"CHAT_RECOVERY_KEY\")\n    try: main(p.parse_args())\n    except ValueError as error:\n        allowed={\"protected file required\",\"duplicate field\",\"checkpoint signature\",\"binlog coordinate\",\"noncontinuous range\",\n            \"archive directory\",\"binlog gap\",\"incomplete archive tail\",\"binlog header\",\"binlog verification\",\"key name\",\n            \"key\",\"maintenance required\",\"stale checkpoint\",\"environment or epoch\",\"explicit mysqlbinlog executable\"}\n        reason=str(error) if str(error) in allowed else \"invalid structure\"\n        print(json.dumps({\"status\":\"blocked\",\"code\":\"CHAT_RECOVERY_INCREMENT_GAP\",\"reason\":reason}));sys.exit(1)\n    except (OSError,KeyError,TypeError,subprocess.SubprocessError):\n        print('{\"status\":\"blocked\",\"code\":\"CHAT_RECOVERY_INCREMENT_GAP\",\"reason\":\"dependency or structure unavailable\"}');sys.exit(1)\n","tools/check-chat-release.py":"#!/usr/bin/env python3\n\"\"\"Fail-closed joint acceptance; fixture/source evidence cannot satisfy host/device gates.\"\"\"\nimport argparse, base64, hashlib, hmac, json, math, os, pathlib, re, sys, tempfile, time\nCASES=([f\"C{i:02}\" for i in range(1,48) if i!=20]+[f\"G{i:02}\" for i in range(1,17)]\n       +[f\"U{i:02}\" for i in list(range(1,10))+list(range(12,18))]+[f\"I{i:02}\" for i in range(1,9)]+[f\"AUD{i:02}\" for i in range(1,11)])\nAREAS=(\"automation\",\"devices\",\"capacity\",\"deployment\",\"channels\",\"recovery\")\ndef validate(e,revision):\n    failures=[]\n    def require(ok,code):\n        if not ok: failures.append(code)\n    require(e.get(\"schema\")==1,\"schema\")\n    require(e.get(\"environment\") in (\"test\",\"development\",\"production\") and bool(re.fullmatch(r\"[0-9a-f]{64}\",e.get(\"recovery_epoch\",\"\"))),\"environment_and_recovery_epoch\")\n    require(bool(re.fullmatch(r\"[0-9a-f]{40}\",revision)) and e.get(\"revision\")==revision,\"exact_revision\")\n    require(e.get(\"go_version\")==\"go1.27.3\" and e.get(\"database_version\")==\"2.7.0\",\"runtime_versions\")\n    require(e.get(\"release_authorized\") is True and isinstance(e.get(\"authorization_reference\"),str) and 5<=len(e.get(\"authorization_reference\",\"\"))<=512,\"human_release_authorization\")\n    cases=e.get(\"cases\",{})\n    for case in CASES:\n        row=cases.get(case,{})\n        require(row.get(\"status\")==\"passed\" and row.get(\"revision\")==revision and bool(row.get(\"evidence\")),case)\n    for area in AREAS:\n        row=e.get(area,{})\n        require(row.get(\"status\")==\"passed\" and row.get(\"revision\")==revision and bool(row.get(\"evidence\")),area)\n    a=e.get(\"automation\",{})\n    require(a.get(\"race\") is True and a.get(\"mysql57\") is True and a.get(\"php_version\")==\"8.3.36\"\n            and a.get(\"redis\") is True and a.get(\"source_verified\") is True,\"automation_contract\")\n    d=e.get(\"devices\",{})\n    devices=d.get(\"physical_devices\",[])\n    require(len(devices)>=2 and len({x.get(\"id\") for x in devices})>=2\n            and {\"ios\",\"android\"}<={x.get(\"platform\") for x in devices}\n            and all(x.get(\"physical\") is True and x.get(\"passed\") is True for x in devices),\"two_real_devices\")\n    require(d.get(\"weak_network\") is True and d.get(\"large_text\") is True and d.get(\"dark_mode\") is True\n            and d.get(\"album_permissions\") is True and d.get(\"safe_area\") is True,\"device_ui\")\n    c=e.get(\"capacity\",{})\n    require(c.get(\"environment\")==\"target_host\" and c.get(\"connections\")==[30,100,300]\n            and c.get(\"history_sizes\")==[1000,10000,100000]\n            and c.get(\"mixed_order_media_notifications\") is True,\"target_mixed_capacity\")\n    base=c.get(\"baseline_order_p95_ms\",0);mixed=c.get(\"mixed_order_p95_ms\",0);headroom=c.get(\"headroom_percent\",0)\n    numeric=all(type(v) in (int,float) and math.isfinite(v) for v in (base,mixed,headroom))\n    require(numeric and base>0 and 0<mixed<=base*1.10 and 30<=headroom<=100,\"order_budget_and_headroom\")\n    deploy=e.get(\"deployment\",{})\n    require(deploy.get(\"actual_sha\")==revision and deploy.get(\"source_dirty\") is False\n            and deploy.get(\"nonroot_processes\")==[\"serve\",\"worker\"] and deploy.get(\"private_internal_port\") is True\n            and deploy.get(\"php_routes_preserved\") is True and deploy.get(\"rollback_passed\") is True\n            and deploy.get(\"authenticated_wss\") is True,\"actual_deployment_and_rollback\")\n    channels=e.get(\"channels\",{})\n    require(channels.get(\"simulated\") is False and channels.get(\"private_media_expiry\") is True\n            and channels.get(\"platform_safety\") is True and channels.get(\"subscription_receipts\") is True\n            and channels.get(\"field_images_reviewed\") is True and channels.get(\"manual_wait_reviewed\") is True,\"actual_channels\")\n    recovery=e.get(\"recovery\",{})\n    require(recovery.get(\"independent_increment_complete\") is True and recovery.get(\"old_permissions_denied\") is True\n            and recovery.get(\"recall_not_revived\") is True and recovery.get(\"notification_not_resent\") is True\n            and recovery.get(\"wallet_not_recharged\") is True and recovery.get(\"gap_blocks_access\") is True,\"safe_incremental_restore\")\n    return failures\ndef template():\n    e={\"schema\":1,\"revision\":\"\",\"environment\":\"test\",\"recovery_epoch\":\"\",\"go_version\":\"go1.27.3\",\"database_version\":\"2.7.0\",\n       \"release_authorized\":False,\"authorization_reference\":\"\",\n       \"cases\":{case:{\"status\":\"pending\",\"revision\":\"\",\"evidence\":\"\"} for case in CASES}}\n    for area in AREAS: e[area]={\"status\":\"pending\",\"revision\":\"\",\"evidence\":\"\"}\n    return e\ndef main():\n    p=argparse.ArgumentParser()\n    p.add_argument(\"--evidence\");p.add_argument(\"--revision\");p.add_argument(\"--template\",action=\"store_true\")\n    p.add_argument(\"--seal\");p.add_argument(\"--key-env\",default=\"CHAT_RELEASE_KEY\")\n    a=p.parse_args()\n    if a.template: print(json.dumps(template(),ensure_ascii=False,indent=2));return 0\n    if not a.evidence or not a.revision: p.error(\"--evidence and --revision are required\")\n    path=pathlib.Path(a.evidence)\n    if path.stat().st_size>1048576: raise ValueError(\"evidence too large\")\n    e=json.loads(path.read_bytes())\n    failures=validate(e,a.revision)\n    if a.seal and not failures:\n        if e.get(\"environment\") not in (\"test\",\"production\",\"development\") or not re.fullmatch(r\"[0-9a-f]{64}\",e.get(\"recovery_epoch\",\"\")):\n            raise ValueError(\"release environment/epoch\")\n        if not re.fullmatch(r\"CHAT_[A-Z0-9_]{1,60}\",a.key_env): raise ValueError(\"release key name\")\n        encoded=os.environ.get(a.key_env,\"\");key=base64.b64decode(encoded,validate=True)\n        if len(key)!=32 or base64.b64encode(key).decode()!=encoded: raise ValueError(\"release key\")\n        destination=pathlib.Path(a.seal)\n        if not destination.is_absolute() or destination.is_symlink(): raise ValueError(\"private absolute seal path\")\n        body=json.dumps({\"schema\":1,\"environment\":e[\"environment\"],\"epoch\":e[\"recovery_epoch\"],\"revision\":a.revision,\n            \"expires_at\":int(time.time())+86390,\"capabilities\":[\"text\",\"images\",\"governance\",\"reminders\"]},separators=(\",\",\":\")).encode()\n        envelope={\"payload\":base64.b64encode(body).decode(),\"mac\":hmac.new(key,body,\"sha256\").hexdigest()}\n        fd,name=tempfile.mkstemp(prefix=\".release-\",dir=destination.parent)\n        try:\n            os.fchmod(fd,0o640)\n            with os.fdopen(fd,\"w\") as out:\n                json.dump(envelope,out,separators=(\",\",\":\"));out.flush();os.fsync(out.fileno())\n            os.replace(name,destination)\n        finally:\n            if os.path.exists(name): os.unlink(name)\n    print(json.dumps({\"status\":\"blocked\" if failures else \"ready_for_authorized_release\",\"missing\":failures,\"deployment_executed\":False}))\n    return 1 if failures else 0\nif __name__==\"__main__\":\n    try: sys.exit(main())\n    except (OSError,ValueError,TypeError,KeyError,AttributeError):\n        print('{\"status\":\"blocked\",\"code\":\"CHAT_RELEASE_EVIDENCE_INVALID\"}');sys.exit(2)\n","chat/scripts/package.sh":"#!/bin/sh\n# Build a reviewable artifact; this script never uploads, switches current or restarts a process.\nset -eu\ncd \"$(dirname \"$0\")/..\"\nif [ \"$#\" -ne 1 ] || [ ! -d \"$1\" ]; then\n    printf '%s\\n' '用法: package.sh 已存在的绝对产物目录' >&2\n    exit 2\nfi\ncase \"$1\" in /*) ;; *) exit 2 ;; esac\nif [ -n \"$(git status --porcelain)\" ]; then\n    printf '%s\\n' '正式构建需要干净的完整源码提交' >&2\n    exit 2\nfi\nsh ./build.sh\nout=\"$1\"\ncp bin/chatd \"$out/chatd\"\n./bin/chatd version > \"$out/version.json\"\npython3 - \"$out\" <<'PY'\nimport hashlib,json,pathlib,sys\nout=pathlib.Path(sys.argv[1])\nversion=json.loads((out/\"version.json\").read_bytes())\nif version[\"source_dirty\"]!=\"false\" or version[\"source_revision\"]==\"unknown\" or version[\"go_version\"]!=\"go1.27.3\":\n    raise SystemExit(\"invalid release provenance\")\nmanifest={\"schema\":1,\"version\":version,\"php\":\"8.3.36\",\"database\":\"2.7.0\",\"files\":{}}\nfor p in [pathlib.Path(\"bin/chatd\"),pathlib.Path(\"helpers/images/inspect.py\"),pathlib.Path(\"helpers/images/requirements.lock\")]:\n    manifest[\"files\"][str(p)]={\"bytes\":p.stat().st_size,\"sha256\":hashlib.sha256(p.read_bytes()).hexdigest()}\n(out/\"manifest.json\").write_text(json.dumps(manifest,indent=2)+\"\\n\")\nPY\n","chat/deploy/nginx.conf.example":"# Include these locations inside the EXISTING HTTPS PHP server.\n# Keep existing TLS, PHP handler and order routes; run nginx -t before reload.\nlocation = /chat/ws {\n    proxy_pass http://127.0.0.1:9501;\n    proxy_http_version 1.1;\n    proxy_set_header Upgrade $http_upgrade;\n    proxy_set_header Connection \"upgrade\";\n    proxy_set_header Host $host;\n    proxy_set_header X-Forwarded-Proto $scheme;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $remote_addr;\n    proxy_read_timeout 120s;\n    proxy_send_timeout 120s;\n    proxy_buffering off;\n}\nlocation ^~ /chat/api/v1/ {\n    proxy_pass http://127.0.0.1:9501;\n    proxy_http_version 1.1;\n    proxy_set_header Connection \"\";\n    proxy_set_header Host $host;\n    proxy_set_header X-Forwarded-Proto $scheme;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $remote_addr;\n    client_max_body_size 64k;\n    proxy_connect_timeout 3s;\n    proxy_read_timeout 30s;\n    proxy_send_timeout 30s;\n    proxy_buffering off;\n    proxy_cache off;\n}\n# Internal bridge is never exposed by this public PHP virtual host. Give it a\n# separate loopback TLS virtual host using the existing FPM pool and a certificate\n# matching the configured private HTTPS endpoint; do not expose 9502 or metrics.\nlocation = /chat-internal.php { return 404; }\nlocation ^~ /chat/ { return 404; }\nlocation ^~ /internal/ { return 404; }\n","chat/deploy/supervisor.conf.example":"[program:bixuan-chat]\ncommand=/www/server/bixuan-chat/current/chatd serve --config /www/server/bixuan-chat/shared/chat.json\ndirectory=/www/server/bixuan-chat/current\nuser=bxchat\nnumprocs=1\nautostart=true\nautorestart=true\nstartsecs=5\nstartretries=3\nstopsignal=TERM\nstopwaitsecs=45\nstopasgroup=true\nkillasgroup=true\numask=027\nredirect_stderr=true\nstdout_logfile=/www/wwwlogs/bixuan-chat/serve.log\nstdout_logfile_maxbytes=20MB\nstdout_logfile_backups=5\n\n[program:bixuan-chat-worker]\ncommand=/www/server/bixuan-chat/current/chatd worker --config /www/server/bixuan-chat/shared/chat.json\ndirectory=/www/server/bixuan-chat/current\nuser=bxchat\nnumprocs=1\nautostart=true\nautorestart=true\nstartsecs=5\nstartretries=3\nstopsignal=TERM\nstopwaitsecs=45\nstopasgroup=true\nkillasgroup=true\numask=027\nredirect_stderr=true\nstdout_logfile=/www/wwwlogs/bixuan-chat/worker.log\nstdout_logfile_maxbytes=20MB\nstdout_logfile_backups=5\n","chat/internal/bootstrap/release.go":"package bootstrap\n\nimport (\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"time\"\n)\n\ntype ReleaseConfig struct {\n\tStaging bool   `json:\"staging\"`\n\tFile    string `json:\"file\"`\n\tKeyEnv  string `json:\"key_env\"`\n}\n\nfunc (c ReleaseConfig) Verify(env, epoch, revision, dirty string, capabilities ...string) bool {\n\tif !regexp.MustCompile(\"^[0-9a-f]{40}$\").MatchString(revision) || dirty != \"false\" || !filepath.IsAbs(c.File) || !regexp.MustCompile(\"^CHAT_[A-Z0-9_]{1,60}$\").MatchString(c.KeyEnv) {\n\t\treturn false\n\t}\n\tinfo, err := os.Lstat(c.File)\n\tif err != nil || !info.Mode().IsRegular() || info.Size() > 8192 || info.Mode().Perm()&0022 != 0 {\n\t\treturn false\n\t}\n\tfile, err := os.Open(c.File)\n\tif err != nil {\n\t\treturn false\n\t}\n\tdefer file.Close()\n\traw, err := io.ReadAll(io.LimitReader(file, 8193))\n\tif err != nil || len(raw) > 8192 {\n\t\treturn false\n\t}\n\tvar envelope struct {\n\t\tPayload string `json:\"payload\"`\n\t\tMAC     string `json:\"mac\"`\n\t}\n\tif json.Unmarshal(raw, &envelope) != nil {\n\t\treturn false\n\t}\n\tbody, err := base64.StdEncoding.Strict().DecodeString(envelope.Payload)\n\tif err != nil || base64.StdEncoding.EncodeToString(body) != envelope.Payload {\n\t\treturn false\n\t}\n\tkeyText := os.Getenv(c.KeyEnv)\n\tkey, err := base64.StdEncoding.Strict().DecodeString(keyText)\n\tif err != nil || len(key) != 32 || base64.StdEncoding.EncodeToString(key) != keyText {\n\t\treturn false\n\t}\n\tgot, err := hex.DecodeString(envelope.MAC)\n\tif err != nil {\n\t\treturn false\n\t}\n\tmac := hmac.New(sha256.New, key)\n\t_, _ = mac.Write(body)\n\tif !hmac.Equal(got, mac.Sum(nil)) {\n\t\treturn false\n\t}\n\tvar p struct {\n\t\tSchema       int      `json:\"schema\"`\n\t\tEnvironment  string   `json:\"environment\"`\n\t\tEpoch        string   `json:\"epoch\"`\n\t\tRevision     string   `json:\"revision\"`\n\t\tExpires      int64    `json:\"expires_at\"`\n\t\tCapabilities []string `json:\"capabilities\"`\n\t}\n\tif json.Unmarshal(body, &p) != nil || p.Schema != 1 || p.Environment != env || p.Epoch != epoch || p.Revision != revision || p.Expires <= time.Now().Unix() || p.Expires > time.Now().Add(24*time.Hour).Unix() {\n\t\treturn false\n\t}\n\tfor _, required := range capabilities {\n\t\tfound := false\n\t\tfor _, cap := range p.Capabilities {\n\t\t\tif cap == required {\n\t\t\t\tfound = true\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n","chat/internal/dependencies/messaging.go":"package dependencies\n\nimport (\n\t\"context\"\n\t\"encoding/base64\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/imagepipeline\"\n\t\"github.com/franz-9527/workers/chat/internal/message\"\n\t\"github.com/franz-9527/workers/chat/internal/ports\"\n\t\"log/slog\"\n\t\"net/http\"\n\t\"os\"\n\t\"regexp\"\n\t\"time\"\n)\n\ntype RemindersConfig struct {\n\tEnabled     bool   `json:\"enabled\"`\n\tPHPEndpoint string `json:\"php_endpoint\"`\n\tKeyID       string `json:\"key_id\"`\n\tKeyEnv      string `json:\"key_env\"`\n}\ntype publicationRelay struct{ runtime *Runtime }\n\nfunc (p publicationRelay) Committed(m ports.CommittedMessage) {\n\tif p.runtime.Socket != nil {\n\t\tp.runtime.Socket.Committed(m)\n\t}\n}\nfunc (p publicationRelay) Changed(m ports.CommittedMessage) {\n\tif p.runtime.Socket != nil {\n\t\tp.runtime.Socket.Changed(m)\n\t}\n}\n\n// The only process composition: HTTP/WSS share the exact same sender; media,\n// governance and reminders share its durable DB and current authority locks.\nfunc (r *Runtime) EnableMessaging(c message.Config, images imagepipeline.Config, reminders RemindersConfig) error {\n\tif !c.Enabled {\n\t\tif images.Enabled || reminders.Enabled {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\treturn nil\n\t}\n\tif r.sql == nil || r.mode != \"disabled\" || r.Identity == nil || r.Conversations == nil || r.Moderation == nil || r.History == nil {\n\t\treturn ports.ErrInvalid\n\t}\n\tbase, err := message.NewService(r.sql, r.Conversations, r.Moderation, min(r.settings.Timeout(), 3*time.Second))\n\tif err != nil {\n\t\treturn err\n\t}\n\tbase = base.WithPublisher(publicationRelay{r})\n\tmedia, err := imagepipeline.Build(images, r.environment, base)\n\tif err != nil {\n\t\treturn err\n\t}\n\tbase = base.WithMedia(media)\n\tr.Messages = base\n\tr.Media = media\n\tr.MessageHTTP, err = message.NewHandler(base, r.Identity, 16)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif media != nil {\n\t\tr.MediaHTTP, err = message.NewMediaHandler(media, r.Identity, 8)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tg, err := message.NewGovernanceService(base, r.History, media, r.environment)\n\tif err != nil {\n\t\treturn err\n\t}\n\tr.Governance = g\n\tr.GovernanceHTTP, err = message.NewGovernanceHandler(g, r.Identity, 8)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif reminders.Enabled {\n\t\tif r.redis == nil || !regexp.MustCompile(\"^CHAT_[A-Z0-9_]{1,60}$\").MatchString(reminders.KeyEnv) {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tkeyText := os.Getenv(reminders.KeyEnv)\n\t\tkey, e := base64.StdEncoding.Strict().DecodeString(keyText)\n\t\tif e != nil || len(key) != 32 || base64.StdEncoding.EncodeToString(key) != keyText {\n\t\t\treturn ports.ErrInvalid\n\t\t}\n\t\tstore, e := auth.NewRedisStore(r.redis, r.environment, r.settings.Redis.KeyPrefix)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tinternal, e := auth.NewInternal(r.environment, map[string][]byte{reminders.KeyID: key}, store, time.Second)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\th, e := NewHTTP(4, 3*time.Second, 8192)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tr.reminderTransport = h\n\t\tn, e := NewReminderHTTP(h, internal, reminders.PHPEndpoint, reminders.KeyID)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tr.Reminders, e = message.NewReminderService(base, n)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t\tr.ReminderHTTP, e = message.NewReminderInternalHandler(r.Reminders, internal)\n\t\tif e != nil {\n\t\t\treturn e\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *Runtime) RunMessaging(ctx context.Context, logger *slog.Logger) {\n\ttick := time.NewTicker(time.Second)\n\tdefer tick.Stop()\n\tfor {\n\t\tif r.OperationsReady() {\n\t\t\tpass, cancel := context.WithTimeout(ctx, 15*time.Second)\n\t\t\tif r.Media != nil {\n\t\t\t\tfor _, work := range []func(context.Context) error{r.Media.ProcessOne, r.Media.Advance, r.Media.CleanOne} {\n\t\t\t\t\tif err := work(pass); err != nil {\n\t\t\t\t\t\tlogger.Warn(\"media_pass_unavailable\", \"code\", \"CHAT_MEDIA_UNAVAILABLE\")\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif err := r.Governance.Maintain(pass, r.Reminders); err != nil {\n\t\t\t\tlogger.Warn(\"governance_pass_unavailable\", \"code\", \"CHAT_GOVERNANCE_UNAVAILABLE\")\n\t\t\t}\n\t\t\tcancel()\n\t\t}\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t}\n\t}\n}\n\nvar _ http.Handler = (*message.GovernanceHandler)(nil)\n","chat/internal/bootstrap/release_test.go":"package bootstrap\n\nimport (\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/base64\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestS23ReleaseProofBindsExactSourceEnvironmentAndCapabilities(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"release.json\")\n\tkey := []byte(strings.Repeat(\"k\", 32))\n\tt.Setenv(\"CHAT_RELEASE_FIXTURE_KEY\", base64.StdEncoding.EncodeToString(key))\n\tc := ReleaseConfig{File: path, KeyEnv: \"CHAT_RELEASE_FIXTURE_KEY\"}\n\trevision := strings.Repeat(\"a\", 40)\n\tepoch := strings.Repeat(\"b\", 64)\n\tbody, _ := json.Marshal(map[string]any{\"schema\": 1, \"environment\": \"production\", \"epoch\": epoch, \"revision\": revision, \"expires_at\": time.Now().Add(time.Hour).Unix(), \"capabilities\": []string{\"text\", \"images\", \"governance\", \"reminders\"}})\n\tmac := hmac.New(sha256.New, key)\n\tmac.Write(body)\n\tenvelope, _ := json.Marshal(map[string]string{\"payload\": base64.StdEncoding.EncodeToString(body), \"mac\": hex.EncodeToString(mac.Sum(nil))})\n\tif os.WriteFile(path, envelope, 0640) != nil {\n\t\tt.Fatal(\"private file\")\n\t}\n\tif !c.Verify(\"production\", epoch, revision, \"false\", \"text\", \"images\") {\n\t\tt.Fatal(\"valid seal rejected\")\n\t}\n\tfor _, bad := range []struct{ env, epoch, revision, dirty string }{{\"test\", epoch, revision, \"false\"}, {\"production\", strings.Repeat(\"c\", 64), revision, \"false\"}, {\"production\", epoch, strings.Repeat(\"d\", 40), \"false\"}, {\"production\", epoch, revision, \"true\"}} {\n\t\tif c.Verify(bad.env, bad.epoch, bad.revision, bad.dirty, \"text\") {\n\t\t\tt.Fatal(\"seal crossed boundary\", bad)\n\t\t}\n\t}\n\tif c.Verify(\"production\", epoch, revision, \"false\", \"voice\") {\n\t\tt.Fatal(\"unaccepted capability\")\n\t}\n\tenvelope[len(envelope)-5] ^= 1\n\tos.WriteFile(path, envelope, 0640)\n\tif c.Verify(\"production\", epoch, revision, \"false\", \"text\") {\n\t\tt.Fatal(\"tampered seal\")\n\t}\n}\n","chat/internal/message/load_integration_test.go":"package message\n\nimport (\n\t\"context\"\n\t\"crypto/ed25519\"\n\t\"crypto/rand\"\n\t\"encoding/base64\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/franz-9527/workers/chat/internal/auth\"\n\t\"github.com/franz-9527/workers/chat/internal/socket\"\n\t\"github.com/gorilla/websocket\"\n\t\"github.com/redis/go-redis/v9\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestMySQLRedisS23MixedLoad(t *testing.T) {\n\tfor _, profile := range []struct{ connections, history int }{{30, 1000}, {100, 10000}, {300, 100000}} {\n\t\tt.Run(fmt.Sprintf(\"%d_connections_%d_history\", profile.connections, profile.history), func(t *testing.T) {\n\t\t\tf, s, m, storage, q := mediaFixture(t)\n\t\t\tctx, cancel := context.WithTimeout(context.Background(), 150*time.Second)\n\t\t\tdefer cancel()\n\t\t\tf.ctx = ctx\n\t\t\tseedHistory(t, f, q, profile.history)\n\t\t\th, err := NewHistoryService(f.goDB, f.store, \"test\", []byte(strings.Repeat(\"h\", 32)), 3*time.Second)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\taddress := os.Getenv(\"CHAT_AUTH_TEST_REDIS_ADDRESS\")\n\t\t\tif address == \"\" {\n\t\t\t\tt.Fatal(\"isolated Redis required\")\n\t\t\t}\n\t\t\trc := redis.NewClient(&redis.Options{Addr: address, PoolSize: 2, MaxActiveConns: 2, MaxRetries: -1, DisableIdentity: true, Protocol: 2})\n\t\t\tdefer rc.Close()\n\t\t\ttickets, err := auth.NewRedisStore(rc, \"test\", \"bxchat:test:\")\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tpub, priv, _ := ed25519.GenerateKey(rand.Reader)\n\t\t\tverifier, _ := auth.NewVerifier(\"test\", map[string]ed25519.PublicKey{\"load\": pub})\n\t\t\tsource, _ := auth.NewMySQLSource(f.goDB)\n\t\t\tidentity, err := auth.NewService(verifier, source, tickets, 8, time.Second)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tp := principal(\"10202\")\n\t\t\tnow := time.Now().Unix()\n\t\t\tclaims := auth.Claims{Issuer: \"bixuan-php:test\", Audience: \"bixuan-chat\", ActorID: p.ActorID, Kind: p.Kind, SourceID: p.SourceID, SessionID: p.SessionID, Version: p.SessionVersion, Environment: \"test\", Scopes: p.Scopes, IssuedAt: now, NotBefore: now, ExpiresAt: now + 300, JTI: strings.Repeat(\"c\", 64)}\n\t\t\tbody, _ := json.Marshal(claims)\n\t\t\tunsigned := base64.RawURLEncoding.EncodeToString([]byte(`{\"alg\":\"EdDSA\",\"typ\":\"JWT\",\"kid\":\"load\"}`)) + \".\" + base64.RawURLEncoding.EncodeToString(body)\n\t\t\ttoken := unsigned + \".\" + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(unsigned)))\n\t\t\tgateway, err := socket.NewWithPolicy(identity, SocketCommands{Sender: s, History: h}, f.store)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tdefer func() {\n\t\t\t\tshutdown, stop := context.WithTimeout(context.Background(), 3*time.Second)\n\t\t\t\tdefer stop()\n\t\t\t\tif gateway.Shutdown(shutdown) != nil {\n\t\t\t\t\tt.Error(\"drain\")\n\t\t\t\t}\n\t\t\t}()\n\t\t\treadHTTP, _ := NewHistoryHandler(h, identity, 16)\n\t\t\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\t\t\tif r.URL.Path == \"/chat/ws\" {\n\t\t\t\t\tgateway.ServeHTTP(w, r)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tif r.URL.Path == \"/fixture/order\" {\n\t\t\t\t\tvar state string\n\t\t\t\t\terr := f.root.QueryRowContext(r.Context(), \"SELECT lifecycle_status FROM orders WHERE id=401\").Scan(&state)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tw.WriteHeader(503)\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\t_, _ = io.WriteString(w, state)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\treadHTTP.ServeHTTP(w, r)\n\t\t\t}))\n\t\t\tdefer server.Close()\n\t\t\tclients := []*websocket.Conn{}\n\t\t\tdefer func() {\n\t\t\t\tfor _, ws := range clients {\n\t\t\t\t\tws.Close()\n\t\t\t\t}\n\t\t\t}()\n\t\t\tfor i := 0; i < profile.connections; i++ {\n\t\t\t\tticket, _, err := identity.IssueTicket(ctx, token)\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(\"ticket\", err)\n\t\t\t\t}\n\t\t\t\tws, _, err := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\tclients = append(clients, ws)\n\t\t\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\t\t\tif ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"load-auth\", \"type\": \"auth\", \"payload\": map[string]string{\"ticket\": ticket}}) != nil {\n\t\t\t\t\tt.Fatal(\"auth write\")\n\t\t\t\t}\n\t\t\t\tvar response struct {\n\t\t\t\t\tType string `json:\"type\"`\n\t\t\t\t}\n\t\t\t\tif ws.ReadJSON(&response) != nil || response.Type != \"auth.ok\" {\n\t\t\t\t\tt.Fatal(\"authenticated connection\", response)\n\t\t\t\t}\n\t\t\t}\n\t\t\t// Verify the hard connection cap rather than relying on unbounded goroutines.\n\t\t\tif profile.connections == 300 {\n\t\t\t\textra, _, e := websocket.DefaultDialer.Dial(\"ws\"+strings.TrimPrefix(server.URL, \"http\")+\"/chat/ws\", nil)\n\t\t\t\tif e == nil {\n\t\t\t\t\textra.Close()\n\t\t\t\t\tt.Fatal(\"connection 301 admitted\")\n\t\t\t\t}\n\t\t\t}\n\t\t\tvar mu sync.Mutex\n\t\t\torderTimes, chatTimes := []int64{}, []int64{}\n\t\t\tfailures := []string{}\n\t\t\trecord := func(kind string, start time.Time, err error) {\n\t\t\t\tmu.Lock()\n\t\t\t\tdefer mu.Unlock()\n\t\t\t\tif err != nil {\n\t\t\t\t\tif len(failures) < 20 {\n\t\t\t\t\t\tfailures = append(failures, kind+\":\"+err.Error())\n\t\t\t\t\t}\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t\tms := time.Since(start).Microseconds()\n\t\t\t\tif kind == \"order\" {\n\t\t\t\t\torderTimes = append(orderTimes, ms)\n\t\t\t\t} else {\n\t\t\t\t\tchatTimes = append(chatTimes, ms)\n\t\t\t\t}\n\t\t\t}\n\t\t\torderProbe := func() {\n\t\t\t\tstart := time.Now()\n\t\t\t\tresponse, err := server.Client().Get(server.URL + \"/fixture/order\")\n\t\t\t\tif err == nil {\n\t\t\t\t\tio.Copy(io.Discard, response.Body)\n\t\t\t\t\tresponse.Body.Close()\n\t\t\t\t\tif response.StatusCode != 200 {\n\t\t\t\t\t\terr = fmt.Errorf(\"order status\")\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\trecord(\"order\", start, err)\n\t\t\t}\n\t\t\tfor i := 0; i < 20; i++ {\n\t\t\t\torderProbe()\n\t\t\t}\n\t\t\tbaseline := append([]int64(nil), orderTimes...)\n\t\t\torderTimes = nil\n\t\t\tvar wg sync.WaitGroup\n\t\t\tjobs := make(chan *websocket.Conn, profile.connections)\n\t\t\tfor _, ws := range clients {\n\t\t\t\tjobs <- ws\n\t\t\t}\n\t\t\tclose(jobs)\n\t\t\tfor i := 0; i < 8; i++ {\n\t\t\t\twg.Add(1)\n\t\t\t\tgo func() {\n\t\t\t\t\tdefer wg.Done()\n\t\t\t\t\tfor ws := range jobs {\n\t\t\t\t\t\tstart := time.Now()\n\t\t\t\t\t\tws.SetReadDeadline(time.Now().Add(5 * time.Second))\n\t\t\t\t\t\terr := ws.WriteJSON(map[string]any{\"protocol_version\": 1, \"request_id\": \"load-history\", \"type\": \"conversation.bootstrap\", \"payload\": map[string]string{\"conversation_id\": string(q.ConversationID)}})\n\t\t\t\t\t\tvar response struct {\n\t\t\t\t\t\t\tType    string      `json:\"type\"`\n\t\t\t\t\t\t\tPayload HistoryPage `json:\"payload\"`\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif err == nil {\n\t\t\t\t\t\t\terr = ws.ReadJSON(&response)\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif err == nil && (response.Type != \"conversation.bootstrap.result\" || len(response.Payload.Messages) > 30) {\n\t\t\t\t\t\t\terr = fmt.Errorf(\"bounded page\")\n\t\t\t\t\t\t}\n\t\t\t\t\t\trecord(\"chat\", start, err)\n\t\t\t\t\t\torderProbe()\n\t\t\t\t\t}\n\t\t\t\t}()\n\t\t\t}\n\t\t\twg.Add(1)\n\t\t\tgo func() {\n\t\t\t\tdefer wg.Done()\n\t\t\t\tfor i := 0; i < 10; i++ {\n\t\t\t\t\ttext := request(2300 + i)\n\t\t\t\t\ttext.ConversationID = q.ConversationID\n\t\t\t\t\t_, err := s.Send(ctx, principal(\"10202\"), text)\n\t\t\t\t\trecord(\"send\", time.Now(), err)\n\t\t\t\t}\n\t\t\t}()\n\t\t\t// Real media state machine with simulated private storage / local processor.\n\t\t\tq.MessageType = \"image_album\"\n\t\t\tq.Items = nil\n\t\t\tfor i := 0; i < 9; i++ {\n\t\t\t\tv := mediaAdd(t, m, storage, q.ConversationID, 100+i, \"load-construction\")\n\t\t\t\tv.Ordinal = i\n\t\t\t\tq.Items = append(q.Items, v)\n\t\t\t}\n\t\t\tmediaProcess(t, m, 9)\n\t\t\tif _, err := s.Send(ctx, principal(\"10202\"), q); err != nil {\n\t\t\t\tt.Fatal(\"mixed album\", err)\n\t\t\t}\n\t\t\tif err := m.Advance(ctx); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tmediaApprove(t, m)\n\t\t\treminders, _ := NewReminderService(s, &reminderCapture{})\n\t\t\tif err := reminders.DrainEvents(ctx); err != nil {\n\t\t\t\tt.Fatal(\"mixed reminder\", err)\n\t\t\t}\n\t\t\tf.exec(\"UPDATE chat_reminder_clusters SET next_due=UTC_TIMESTAMP(6)-INTERVAL 1 SECOND\")\n\t\t\tif err := reminders.Prepare(ctx); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif err := reminders.SubmitPending(ctx); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\twg.Wait()\n\t\t\tif len(failures) > 0 {\n\t\t\t\tt.Fatal(\"mixed isolated failures\", failures)\n\t\t\t}\n\t\t\tp95 := func(v []int64) int64 {\n\t\t\t\tsort.Slice(v, func(i, j int) bool { return v[i] < v[j] })\n\t\t\t\tif len(v) == 0 {\n\t\t\t\t\treturn 0\n\t\t\t\t}\n\t\t\t\treturn v[(len(v)-1)*95/100]\n\t\t\t}\n\t\t\tt.Logf(\"S23_CAPACITY {\\\"environment\\\":\\\"isolated_runner\\\",\\\"connections\\\":%d,\\\"history\\\":%d,\\\"order_probe_baseline_p95_us\\\":%d,\\\"order_probe_mixed_p95_us\\\":%d,\\\"chat_p95_us\\\":%d,\\\"real_order_api\\\":false,\\\"real_media_channel\\\":false}\", profile.connections, profile.history, p95(baseline), p95(orderTimes), p95(chatTimes))\n\t\t})\n\t}\n}\n","tools/test_chat_operations.py":"#!/usr/bin/env python3\nimport importlib.util,json,pathlib,tempfile,unittest,sys\nROOT=pathlib.Path(__file__).resolve().parents[1]\ndef module(name,path):\n    spec=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);return m\nrelease=module(\"chat_release\",ROOT/\"tools/check-chat-release.py\")\ncenter=module(\"chat_center\",ROOT/\"chat/scripts/test-center.py\")\narchive=module(\"chat_archive\",ROOT/\"chat/scripts/seal-binlogs.py\")\nclass ChatOperationsContract(unittest.TestCase):\n    def complete(self):\n        sha=\"a\"*40;e=release.template();e.update(revision=sha,environment=\"production\",recovery_epoch=\"b\"*64,release_authorized=True,authorization_reference=\"explicit human release task\")\n        for case in e[\"cases\"].values():case.update(status=\"passed\",revision=sha,evidence=\"private-reviewed-evidence\")\n        for area in release.AREAS:e[area].update(status=\"passed\",revision=sha,evidence=\"private-reviewed-evidence\")\n        e[\"automation\"].update(race=True,mysql57=True,php_version=\"8.3.36\",redis=True,source_verified=True)\n        e[\"devices\"].update(physical_devices=[{\"id\":\"device-a\",\"platform\":\"ios\",\"physical\":True,\"passed\":True},{\"id\":\"device-b\",\"platform\":\"android\",\"physical\":True,\"passed\":True}],weak_network=True,large_text=True,dark_mode=True,album_permissions=True,safe_area=True)\n        e[\"capacity\"].update(environment=\"target_host\",connections=[30,100,300],history_sizes=[1000,10000,100000],mixed_order_media_notifications=True,baseline_order_p95_ms=100,mixed_order_p95_ms=105,headroom_percent=35)\n        e[\"deployment\"].update(actual_sha=sha,source_dirty=False,nonroot_processes=[\"serve\",\"worker\"],private_internal_port=True,php_routes_preserved=True,rollback_passed=True,authenticated_wss=True)\n        e[\"channels\"].update(simulated=False,private_media_expiry=True,platform_safety=True,subscription_receipts=True,field_images_reviewed=True,manual_wait_reviewed=True)\n        e[\"recovery\"].update(independent_increment_complete=True,old_permissions_denied=True,recall_not_revived=True,notification_not_resent=True,wallet_not_recharged=True,gap_blocks_access=True)\n        return e,sha\n    def test_pending_template_cannot_release(self):\n        self.assertIn(\"human_release_authorization\",release.validate(release.template(),\"a\"*40))\n    def test_complete_schema_and_source_binding(self):\n        e,sha=self.complete();self.assertEqual([],release.validate(e,sha))\n        self.assertIn(\"exact_revision\",release.validate(e,\"b\"*40))\n        e[\"cases\"][\"C04\"][\"revision\"]=\"b\"*40\n        self.assertIn(\"C04\",release.validate(e,sha))\n    def test_simulations_cannot_satisfy_devices_channels_or_host(self):\n        e,sha=self.complete()\n        e[\"devices\"][\"physical_devices\"][0][\"physical\"]=False\n        e[\"capacity\"][\"environment\"]=\"isolated_runner\";e[\"channels\"][\"simulated\"]=True\n        failed=release.validate(e,sha)\n        for key in (\"two_real_devices\",\"target_mixed_capacity\",\"actual_channels\"):self.assertIn(key,failed)\n    def test_load_budget_and_recovery_gaps_block(self):\n        e,sha=self.complete();e[\"capacity\"][\"mixed_order_p95_ms\"]=120;e[\"recovery\"][\"independent_increment_complete\"]=False\n        failed=release.validate(e,sha)\n        self.assertIn(\"order_budget_and_headroom\",failed);self.assertIn(\"safe_incremental_restore\",failed)\n        e,sha=self.complete();e[\"capacity\"][\"baseline_order_p95_ms\"]=float(\"inf\")\n        self.assertIn(\"order_budget_and_headroom\",release.validate(e,sha))\n    def test_fixture_never_accepts_credentials_or_urls(self):\n        f={\"schema\":1,\"instance\":\"instance-a\",\"suite\":\"media\",\"environment\":\"test\",\"provider\":\"simulated\",\"order\":{\"workflow\":\"measurement\",\"source\":\"consumer\",\"dispatch\":\"single_grab\"},\"actors\":[\"worker\",\"customer\",\"platform_staff\"],\"image_counts\":[1,2,4,9]}\n        self.assertEqual(f,center.validate(f))\n        for key,value in ((\"provider\",\"real\"),(\"environment\",\"production\"),(\"suite\",\"../outside\")):\n            bad=dict(f);bad[key]=value\n            with self.assertRaises(ValueError):center.validate(bad)\n        f[\"access_token\"]=\"injected\"\n        with self.assertRaises(ValueError):center.validate(f)\n    def test_archive_gap_and_incomplete_tail_rejected_before_execution(self):\n        with tempfile.TemporaryDirectory() as d:\n            start={\"server_uuid\":\"a\"*8+\"-\"+\"b\"*4+\"-\"+\"c\"*4+\"-\"+\"d\"*4+\"-\"+\"e\"*12,\"file\":\"mysql-bin.000001\",\"position\":\"4\"}\n            end=dict(start,file=\"mysql-bin.000002\",position=\"200\")\n            with self.assertRaises(ValueError):archive.verify_range(start,end,d,sys.executable)\n            (pathlib.Path(d)/\"mysql-bin.000001\").write_bytes(b\"\\\\xfebin\")\n            with self.assertRaises(ValueError):archive.verify_range(start,start,d,sys.executable)\nif __name__==\"__main__\":unittest.main()\n","server/app/Http/Admin/Modules/TestCenterAdminModule.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Http\\Admin\\Modules;\n\nuse Throwable;\nuse WorkerAdmin\\Application\\Testing\\TestCenter;\nuse WorkerAdmin\\Core\\Auth;\nuse WorkerAdmin\\Core\\Csrf;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Testing\\TestCenterException;\nuse WorkerAdmin\\Foundation\\TestCenterComposition;\nuse WorkerAdmin\\Http\\Admin\\AdminModule;\nuse WorkerAdmin\\Contracts\\TestCenterEntryGateway;\n\nfinal class TestCenterAdminModule implements AdminModule\n{\n    private Auth $auth;\n    private Csrf $csrf;\n    private TestCenter $testCenter;\n    private TestCenterEntryGateway $testEntry;\n\n    public function __construct(Database $db, Auth $auth, Csrf $csrf)\n    {\n        $this->auth=$auth;$this->csrf=$csrf;$this->testCenter=TestCenterComposition::build($db);$this->testEntry=TestCenterComposition::entrySessions($db);\n    }\n\n    public function supports(string $route): bool{return$route==='test-center'||strpos($route,'test-center.')===0;}\n\n    public function dispatch(string $route): void\n    {\n        $this->auth->requireLogin();$admin=$this->auth->user();\n        if(!empty($admin['must_change_password'])){\\flash('warning','首次登录必须先修改演示密码。');\\redirect(\\admin_url('profile'));}\n        $this->auth->requirePermission('settings.manage');\n        if(($admin['role']??'')!=='super_admin'){http_response_code(403);echo \\view('errors/403',['pageTitle'=>'无权访问测试中心']);return;}\n        $allowed=['test-center','test-center.detail','test-center.create','test-center.verify','test-center.action','test-center.replay-failure','test-center.copy','test-center.rebuild','test-center.cleanup','test-center.batch-cleanup','test-center.batch-cleanup.execute','test-center.entry-token'];\n        if(!in_array($route,$allowed,true)){http_response_code(404);echo \\view('errors/404',['pageTitle'=>'页面不存在']);return;}\n        $method=strtoupper((string)($_SERVER['REQUEST_METHOD']??'GET'));if($method==='POST')$this->csrf->verifyRequest();$adminId=(int)($admin['id']??0);\n        try{\n            if($route==='test-center'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $filters=['q'=>trim((string)($_GET['q']??'')),'status'=>trim((string)($_GET['status']??'')),'scenario'=>trim((string)($_GET['scenario']??''))];\n                $data=$this->testCenter->dashboard($filters);$requestKeys=[];\n                foreach((array)($data['scenarios']??[])as$scenario){$key=(string)($scenario['key']??'');if($key!=='')$requestKeys[$key]='create:'.bin2hex(random_bytes(12));}\n                echo \\view('admin/test-center',array_merge($data,['pageTitle'=>'测试中心','activeMenu'=>'test-center','filters'=>$filters,'requestKeys'=>$requestKeys]));return;\n            }\n            if($route==='test-center.detail'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $id=trim((string)($_GET['id']??''));$detail=$this->testCenter->detail($id);$detail['entry_tokens']=$this->testEntry->options($id);$actionRequestKeys=[];$failureReplayRequestKeys=[];\n                foreach((array)($detail['actions']['items']??[])as$key=>$action){$actionKey=(string)($action['key']??$key);if($actionKey!=='')$actionRequestKeys[$actionKey]='action:'.bin2hex(random_bytes(12));}\n                foreach((array)($detail['failure_replays']['items']??[])as$item){$runId=(string)($item['run_public_id']??'');if($runId!==''&&!empty($item['replayable']))$failureReplayRequestKeys[$runId]='failure-replay:'.bin2hex(random_bytes(12));}\n                echo \\view('admin/test-center-detail-v260',['pageTitle'=>'测试订单详情','activeMenu'=>'test-center','detail'=>$detail,'copyRequestKey'=>'copy:'.bin2hex(random_bytes(12)),'rebuildRequestKey'=>'rebuild:'.bin2hex(random_bytes(12)),'actionRequestKeys'=>$actionRequestKeys,'failureReplayRequestKeys'=>$failureReplayRequestKeys]);return;\n            }\n            if($route==='test-center.batch-cleanup'){\n                if($method!=='GET')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n                $batch=trim((string)($_GET['batch']??''));$preview=$this->testCenter->batchCleanupPreview($batch);\n                echo \\view('admin/test-center-batch-cleanup',['pageTitle'=>'测试批次清理','activeMenu'=>'test-center','preview'=>$preview]);return;\n            }\n            if($method!=='POST')throw new TestCenterException('请求方式不正确。','METHOD_NOT_ALLOWED',405);\n            if($route==='test-center.create'){\n                $result=$this->testCenter->create($_POST,$adminId);$id=(string)($result['instance']['public_id']??'');\n                \\audit('test_center.create','test_instance',(int)($result['instance']['id']??0),'创建测试场景 '.(string)($result['instance']['scenario_key']??''));\\flash('success','测试场景已生成并完成结构检查。');\\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.entry-token'){\n                $id=trim((string)($_POST['id']??''));\n                $entry=$this->testEntry->issue(\n                    $id,\n                    (string)($_POST['role']??''),\n                    (string)($_POST['worker_slot']??''),\n                    (int)($_POST['ttl_minutes']??10),\n                    $adminId\n                );\n                \\audit('test_center.entry_issue','test_instance',0,'生成测试中心短期小程序入口，实例 '.$id.'，角色 '.(string)$entry['actor_role'],[\n                    'entry_public_id'=>(string)$entry['public_id'],'worker_slot'=>$entry['worker_slot'],'expires_at'=>(string)$entry['expires_at'],\n                ]);\n                echo \\view('admin/test-center-entry-token',['pageTitle'=>'短期小程序测试入口','activeMenu'=>'test-center','entry'=>$entry]);\n                return;\n            }\n            if($route==='test-center.batch-cleanup.execute'){\n                $batch=trim((string)($_POST['batch']??''));$result=$this->testCenter->cleanupBatch($batch,$adminId,trim((string)($_POST['plan_digest']??'')));\n                \\audit('test_center.batch_cleanup','test_batch',0,'清理测试批次 '.$batch.'；成功 '.(int)$result['succeeded'].'，失败 '.(int)$result['failed']);\n                \\flash(!empty($result['complete'])?'success':'warning','批次清理完成：成功 '.(int)$result['succeeded'].'，失败 '.(int)$result['failed'].'。');\n                \\redirect(\\admin_url('test-center'));\n            }\n            $id=trim((string)($_POST['id']??''));\n            if($route==='test-center.action'){\n                $action=trim((string)($_POST['action_key']??''));$result=$this->testCenter->runAction($id,$_POST,$adminId);$mode=(string)($result['operation_mode']??'real_service');\n                \\audit('test_center.action','test_instance',0,'执行测试动作 '.$action.'，mode='.$mode.'，实例 '.$id.'，run '.(string)($result['run_public_id']??''));\n                if(!empty($result['replayed']))$message='该测试动作此前已成功执行，本次返回幂等结果。';\n                elseif($mode==='isolated_regression')$message=!empty($result['regression_passed'])?'隔离聊天回归通过，已登记指定源码与实例的签名结果；真机和真实渠道需分别验收。':'隔离聊天回归未通过，已记录失败结果，请查看执行记录。';\n                elseif($mode==='isolated_fixture')$message='隔离聊天夹具已准备，尚未执行聊天回归；请查看本次执行记录。';\n                elseif($mode==='real_service')$message='真实业务动作执行成功，订单/售后状态已按正式流程推进。';\n                elseif($mode==='time_fixture')$message='测试时间条件已推进；该步骤不计作真实业务动作。';\n                else $message='测试前置条件已补齐；该步骤不计作真实业务动作。';\n                \\flash(($result['result']??'')==='failed'?'warning':'success',$message);\\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.replay-failure'){\n                $sourceRun=trim((string)($_POST['run_id']??''));$requestKey=trim((string)($_POST['request_key']??''));\n                $result=$this->testCenter->replayFailure($id,$sourceRun,$adminId,$requestKey);\n                \\audit('test_center.failure_replay','test_instance',0,'重放失败测试动作，实例 '.$id.'，来源 run '.$sourceRun.'，新 run '.(string)($result['run_public_id']??''));\n                \\flash('success',!empty($result['replayed'])?'该失败动作已经按同一复现请求执行过，本次返回幂等结果。':'失败动作已使用原安全参数重新执行。');\n                \\redirect(\\admin_url('test-center.detail',['id'=>$id]));\n            }\n            if($route==='test-center.verify'){$result=$this->testCenter->verify($id,$adminId);\\flash($result['failed']>0?'danger':'success',$result['failed']>0?'检查发现失败断言，请查看详情。':'测试实例检查通过。');\\redirect(\\admin_url('test-center.detail',['id'=>$id]));}\n            if($route==='test-center.copy'){$result=$this->testCenter->copy($id,$adminId,(string)($_POST['request_key']??''));$newId=(string)($result['instance']['public_id']??'');\\audit('test_center.copy','test_instance',(int)($result['instance']['id']??0),'复制测试场景，来源 '.$id);\\flash('success','已复制为新的测试实例。');\\redirect(\\admin_url('test-center.detail',['id'=>$newId]));}\n            if($route==='test-center.rebuild'){$result=$this->testCenter->rebuild($id,$adminId,(string)($_POST['request_key']??''));$newId=(string)($result['instance']['public_id']??'');\\audit('test_center.rebuild','test_instance',(int)($result['instance']['id']??0),'重建测试场景，来源 '.$id);\\flash('success','已按原场景参数重建新实例，旧实例和报告保留。');\\redirect(\\admin_url('test-center.detail',['id'=>$newId]));}\n            if($route==='test-center.cleanup'){$result=$this->testCenter->cleanup($id,$adminId,trim((string)($_POST['plan_digest']??'')));\\flash('success','测试业务数据已清理，实例留档与检查记录继续保留。');\\redirect(\\admin_url('test-center.detail',['id'=>(string)($result['public_id']??$id)]));}\n        }catch(TestCenterException $exception){\n            \\flash('danger',$exception->getMessage().'（'.$exception->businessCode().'）');\n            if($method==='GET')\\redirect(\\admin_url('test-center'));\n            $batch=trim((string)($_POST['batch']??''));if($batch!=='')\\redirect(\\admin_url('test-center.batch-cleanup',['batch'=>$batch]));\n            $id=trim((string)($_POST['id']??''));\\redirect($id!==''?\\admin_url('test-center.detail',['id'=>$id]):\\admin_url('test-center'));\n        }catch(Throwable $exception){\n            $requestId=\\request_id();\\write_log('test-center','['.date('c').'] request_id='.$requestId.' '.$exception.\"\\n\");\\flash('danger','测试中心处理失败，请查看运行日志。请求编号：'.$requestId);\n            if($method==='GET')\\redirect(\\admin_url('test-center'));\n            $batch=trim((string)($_POST['batch']??''));if($batch!=='')\\redirect(\\admin_url('test-center.batch-cleanup',['batch'=>$batch]));\n            $id=trim((string)($_POST['id']??''));\\redirect($id!==''?\\admin_url('test-center.detail',['id'=>$id]):\\admin_url('test-center'));\n        }\n    }\n}\n","server/app/Contracts/TestCenterActionRunner.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Contracts;\n\ninterface TestCenterActionRunner\n{\n    /** @return array<string,mixed> */\n    public function available(string $instancePublicId): array;\n\n    /**\n     * @param array<string,mixed> $input\n     * @return array<string,mixed>\n     */\n    public function run(string $instancePublicId, string $actionKey, array $input, int $adminId, string $requestKey): array;\n}\n","server/app/Infrastructure/Testing/TestingActionExecution.php":"<?php\ndeclare(strict_types=1);\nnamespace WorkerAdmin\\Infrastructure\\Testing;\n\nuse Throwable;\nuse WorkerAdmin\\Core\\Database;\nuse WorkerAdmin\\Domain\\Order\\OrderOperationException;\nuse WorkerAdmin\\Domain\\Testing\\TestCenterException;\nuse WorkerAdmin\\Infrastructure\\Safety\\TestingEnvironmentPolicy;\n\n/** 受控测试命令的持久化请求键、审计与实例边界。回调只能由服务端白名单适配器装配。 */\nfinal class TestingActionExecution\n{\n    private Database $db;\n    public function __construct(Database $db){$this->db=$db;}\n    public function context(string $publicId): array\n    {\n        $i=$this->db->fetch('SELECT * FROM test_instances WHERE BINARY public_id=BINARY :public LIMIT 1',['public'=>trim($publicId)]);\n        if(!$i)throw new TestCenterException('测试实例不存在。','TEST_INSTANCE_NOT_FOUND',404);\n        $o=!empty($i['order_id'])?$this->db->fetch('SELECT * FROM orders WHERE id=:id',['id'=>(int)$i['order_id']]):null;\n        if($o&&((int)$o['is_demo']!==1||(string)$o['public_no']!==(string)$i['order_no_snapshot']||strpos((string)$o['public_no'],'BXDEMOHALL')===0))throw new TestCenterException('订单不属于当前测试实例。','TEST_ACTION_ORDER_BOUNDARY',403);\n        return[$i,$o];\n    }\n    public function run(string $publicId,string $action,array $command,int $adminId,string $request,string $role,string $mode,callable $execute): array\n    {\n        if(!TestingEnvironmentPolicy::active())throw new TestCenterException('测试动作仅允许 testing 环境。','TEST_ACTION_PRODUCTION_BLOCKED',403);\n        if($adminId<1)throw new TestCenterException('管理员身份无效。','TEST_ADMIN_REQUIRED',403);\n        if(preg_match('/^[A-Za-z0-9._:-]{1,96}$/D',$request)!==1)throw new TestCenterException('动作请求键无效。','TEST_ACTION_REQUEST_KEY_INVALID',422);\n        [$i,$o]=$this->context($publicId);\n        $digest=hash('sha256',$this->json(['action'=>$action,'order'=>(int)($o['id']??0),'command'=>$command]));\n        $prior=$this->db->fetch('SELECT * FROM test_runs WHERE instance_id=:instance AND BINARY idempotency_key=BINARY :key LIMIT 1',['instance'=>(int)$i['id'],'key'=>$request]);\n        if($prior){\n            if(!hash_equals((string)$prior['request_digest'],$digest))throw new TestCenterException('相同请求键对应的动作或参数已经变化。','TEST_ACTION_IDEMPOTENCY_CONFLICT',409);\n            if($prior['result']==='passed')return['replayed'=>true,'result'=>'passed','run_public_id'=>$prior['public_id'],'after'=>json_decode((string)$prior['after_summary_json'],true)];\n            throw new TestCenterException((string)($prior['error_message']?:'动作正在执行或已失败，请查看原运行记录。'),(string)($prior['error_code']?:'TEST_ACTION_RUNNING'),409);\n        }\n        if(!$o||$i['build_status']!=='built'||!empty($i['archived_at'])||!empty($i['deleted_at']))throw new TestCenterException('测试实例当前不可写。','TEST_ACTION_INSTANCE_NOT_WRITABLE',409);\n        $public=\\public_id();$started=microtime(true);\n        $run=$this->db->insert(\"INSERT INTO test_runs(public_id,instance_id,action_key,actor_role,operation_mode,idempotency_key,request_digest,request_id,before_summary_json,result,created_by_admin_id,started_at,created_at) VALUES(:public,:instance,:action,:role,:mode,:key,:digest,:request,:before,'running',:admin,UTC_TIMESTAMP(),UTC_TIMESTAMP())\",['public'=>$public,'instance'=>(int)$i['id'],'action'=>$action,'role'=>$role,'mode'=>$mode,'key'=>$request,'digest'=>$digest,'request'=>\\request_id(),'before'=>$this->json(['order'=>$o]),'admin'=>$adminId]);\n        try{\n            $business=$execute($i,$o,$command);\n            $after=['business'=>$business,'order'=>$this->db->fetch('SELECT * FROM orders WHERE id=:id',['id'=>(int)$o['id']])];\n            $this->finish($run,$started,'passed',$after,null,null);\n            $this->db->execute(\"UPDATE test_instances SET verification_status='pending',version=version+1,updated_at=UTC_TIMESTAMP() WHERE id=:id\",['id'=>(int)$i['id']]);\n            return['replayed'=>false,'result'=>'passed','run_public_id'=>$public,'business'=>$business,'after'=>$after];\n        }catch(Throwable $e){\n            $code=$e instanceof OrderOperationException?$e->apiCode():($e instanceof TestCenterException?$e->businessCode():'TEST_ACTION_FAILED');\n            $this->finish($run,$started,'failed',['order'=>$this->db->fetch('SELECT * FROM orders WHERE id=:id',['id'=>(int)$o['id']])],$code,$e->getMessage());\n            if($e instanceof TestCenterException)throw$e;\n            $status=$e instanceof OrderOperationException?(int)$e->getCode():500;\n            throw new TestCenterException($e instanceof OrderOperationException?$e->getMessage():'测试动作失败，请查看运行记录。',$code,$status>=400&&$status<=599?$status:409,['run_public_id'=>$public]);\n        }\n    }\n    private function finish(int $id,float $started,string $status,array $after,?string $code,?string $message): void\n    {\n        $this->db->execute('UPDATE test_runs SET result=:status,after_summary_json=:after,error_code=:code,error_message=:message,duration_ms=:duration,finished_at=UTC_TIMESTAMP() WHERE id=:id',['status'=>$status,'after'=>$this->json($after),'code'=>$code,'message'=>$message===null?null:mb_substr($message,0,1000),'duration'=>(int)round((microtime(true)-$started)*1000),'id'=>$id]);\n    }\n    private function json(array $value): string{return(string)json_encode($value,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);}\n}\n","server/app/Domain/Testing/TestCenterException.php":"<?php\n\ndeclare(strict_types=1);\n\nnamespace WorkerAdmin\\Domain\\Testing;\n\nuse RuntimeException;\n\nfinal class TestCenterException extends RuntimeException\n{\n    private string $businessCode;\n    private int $httpStatus;\n    /** @var array<string,mixed> */\n    private array $details;\n\n    /** @param array<string,mixed> $details */\n    public function __construct(string $message, string $businessCode = 'TEST_CENTER_ERROR', int $httpStatus = 409, array $details = [])\n    {\n        parent::__construct($message);\n        $this->businessCode = $businessCode;\n        $this->httpStatus = $httpStatus;\n        $this->details = $details;\n    }\n\n    public function businessCode(): string { return $this->businessCode; }\n    public function httpStatus(): int { return $this->httpStatus; }\n    /** @return array<string,mixed> */\n    public function details(): array { return $this->details; }\n}\n"},"encodings":{"server/tests/fixtures/schema-2.6.0.sql.gz":"base64"},"source_commit":"7734d942fd6c660c67ff8801778a5e40bc5581bc","source_tree":"cd48461622ff188b1e5f55746552e416e0d61eee","blob_shas":{"chat/build.sh":"c9d2e8c654fac590d6533b2dfaa9d6e31e3d1aaa","chat/cmd/chatd/main.go":"ecd53d4d9b8d37dd714e8148a8e606a52801870f","chat/go.mod":"9e5d6b33a9a9fd732dcd518a1e8a8a3c7af2deba","chat/go.sum":"fb24675236722882b2484e1d8be224fa18a08a0e","chat/internal/auth/auth_test.go":"ee4c10778cc9abd6326ed781f4e924379c137eb3","chat/internal/a