.call-page{min-height:100vh;background:#18212c;color:#fff;padding:64rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));box-sizing:border-box;text-align:center}.call-title{font-size:40rpx;font-weight:600}.call-status{margin:30rpx 0;font-size:30rpx}.call-notice,.call-hint{margin:24rpx;color:#e6d1a8}.call-stage{position:relative;height:55vh}.call-stage live-player{width:100%;height:100%}.local-video{position:absolute;right:10rpx;top:10rpx;width:180rpx;height:240rpx}.audio-pusher{position:absolute;left:-10px;top:-10px;width:1px;height:1px;opacity:0}.call-controls{display:flex;flex-wrap:wrap;justify-content:center;gap:20rpx;margin-top:32rpx}.call-controls button{font-size:28rpx;margin:0}.call-controls .hangup{background:#dc4545;color:white}
.history-row{text-align:left;padding:24rpx 0;border-bottom:1px solid #405060}.history-row text{font-size:24rpx;color:#ccd5df}
