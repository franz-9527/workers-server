<view class="conversation-page {{keyboardOpen ? 'keyboard-open' : ''}}" style="padding-bottom:{{keyboardHeight}}px">
  <view class="conversation-context chat-page-toolbar conversation-utility-bar">
    <view class="conversation-context-copy chat-toolbar-copy"><view class="conversation-context-sub conversation-context-only">{{orderContext ? orderContext.publicNo : '订单沟通'}}{{!canSend ? ' · 只读' : ''}}</view></view>
    <button wx:if="{{enabled}}" class="chat-icon-button chat-details chat-menu-trigger" bindtap="chatInfo" aria-label="{{showChatMenu ? '收起会话菜单' : '会话设置与操作'}}" aria-expanded="{{showChatMenu}}"><text class="chat-icon chat-icon-tune" aria-hidden="true"></text></button>
  </view>
  <view wx:if="{{showChatMenu}}" class="chat-operation-mask" catchtap="closeChatMenu" catchtouchmove="stopMenuTouch">
    <view class="chat-operation-panel conversation-operation-panel" catchtap="stopMenuTouch" aria-label="会话菜单">
      <view class="chat-operation-group">
        <view class="chat-operation-label">会话</view>
        <view class="chat-operation-list">
          <button wx:if="{{isGroup || testSandbox}}" class="chat-operation-item" data-action="group" bindtap="runChatMenuAction"><text>群成员与邀请</text><text>›</text></button>
          <button wx:if="{{canOpenOrder}}" class="chat-operation-item" data-action="order" bindtap="runChatMenuAction"><text>{{simulation ? '查看测试订单' : '查看订单'}}</text><text>›</text></button>
          <button wx:if="{{!simulation && directCalls}}" class="chat-operation-item" data-action="calls" bindtap="runChatMenuAction"><text>通话记录</text><text>›</text></button>
          <button wx:if="{{simulation}}" class="chat-operation-item" data-action="simulation" bindtap="runChatMenuAction"><text>测试会话说明</text><text>›</text></button>
        </view>
      </view>
      <view wx:if="{{!simulation}}" class="chat-operation-group">
        <view class="chat-operation-label">工具与支持</view>
        <view class="chat-operation-list">
          <button class="chat-operation-item" data-action="storage" bindtap="runChatMenuAction"><text>聊天缓存</text><text>›</text></button>
          <button class="chat-operation-item" data-action="governance" bindtap="runChatMenuAction"><text>举报与申诉</text><text>›</text></button>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{invalid}}" class="conversation-empty"><text class="cuIcon-warn"></text><view>会话编号无效</view></view>
  <view wx:elif="{{!enabled}}" class="conversation-empty"><text class="cuIcon-comment"></text><view>订单聊天已暂停或状态暂未同步</view><view class="muted">可先通过订单详情或通知与待办联系相关人员</view></view>
  <block wx:else>
    <view wx:if="{{status === 'denied'}}" class="conversation-warning">当前无权继续查看此会话，原有内容已清理</view>
    <view wx:elif="{{status === 'unavailable'}}" class="conversation-warning">连接暂不可用，已加载内容可能不是最新<button class="retry-button" bindtap="retryConnection">重新同步</button></view>
    <view wx:if="{{restrictionText}}" class="conversation-warning" role="alert">{{restrictionText}}<button bindtap="openGovernance">查看状态与申诉</button></view>
    <view wx:if="{{notice}}" class="conversation-warning" role="alert">{{notice}}</view>
    <view wx:if="{{status !== 'denied' && (firstUnread || hasReturn || newCount || showJump)}}" class="reading-actions">
      <button wx:if="{{firstUnread}}" bindtap="firstUnread" disabled="{{windowBusy}}">首条未读 · {{unreadLabel}}</button>
      <button wx:if="{{newCount || showJump}}" bindtap="latestMessages" disabled="{{windowBusy}}">{{newCount ? newCount + '条新消息 · ' : ''}}回到底部</button>
      <button wx:if="{{hasReturn}}" bindtap="returnToPosition" disabled="{{windowBusy}}">返回刚才位置</button>
      <button wx:if="{{unreadCount > 0}}" bindtap="readLatest" disabled="{{!readReady || readBusy}}" loading="{{readBusy}}" aria-label="将本次已完成同步的范围标为已读">读至当前最新</button>
    </view>
    <scroll-view class="message-scroll" scroll-y scroll-top="{{scrollTop}}" scroll-into-view="{{scrollInto}}" scroll-with-animation="{{false}}" bindtap="dismissTools" bindscroll="onScroll" bindscrolltoupper="loadEarlier" bindscrolltolower="onBottom" upper-threshold="60" lower-threshold="30">
      <view class="message-content">
        <view wx:if="{{!simulation}}" class="conversation-safety-tip" role="note"><text class="cuIcon-warnfill safety-tip-icon"></text><text>平台内沟通更安全，请勿私下交易或发送手机号、微信号、二维码。</text></view>
        <button wx:if="{{hasHistory}}" class="history-button" bindtap="loadEarlier" disabled="{{windowBusy}}" loading="{{windowBusy}}">加载更早消息</button>
        <block wx:for="{{messages}}" wx:key="messageId"><view wx:if="{{item.timeDivider}}" class="message-divider">{{item.timeDivider}}</view><view id="message-{{item.messageId}}" class="message-item {{item.isPlaceholder ? 'is-placeholder' : ''}} {{item.isMine ? 'is-mine' : ''}}" data-id="{{item.messageId}}" bindlongpress="messageActions" role="text" aria-label="{{item.displayName}}：{{item.body}}">
          <image class="message-avatar" src="{{item.avatarPath}}" mode="aspectFill" aria-label="{{item.displayName}}的固定头像"/>
          <view class="message-body"><view wx:if="{{isGroup}}" class="message-sender">{{item.displayName}}</view><view class="message-bubble {{item.isAV ? 'av-message-bubble' : ''}} {{item.isAudio ? 'voice-message-bubble' : ''}}" style="{{item.isAudio ? 'width:' + item.bubbleWidth + 'rpx' : ''}}">
          <button wx:if="{{item.reply}}" class="reference-preview" data-id="{{item.messageId}}" catchtap="locateReference" aria-label="查看被回复的原消息">{{item.replyText}}</button>
          <button wx:if="{{item.editedFrom}}" class="reedit-source" data-id="{{item.messageId}}" data-source="edited" catchtap="locateReference" aria-label="定位重新编辑来源">由已撤回消息重新编辑</button>
          <button wx:if="{{item.orderCard}}" class="shared-order-card" data-id="{{item.messageId}}" catchtap="openSharedOrder"><text>订单 · {{item.orderCard.title}}</text><text>{{item.orderCard.publicNo}}</text><text>查看订单 ›</text></button><view wx:elif="{{!item.isAV && !item.isImage}}" class="message-text">{{item.body}}</view>
          <view wx:if="{{item.isAV}}" class="av-card">
            <button data-id="{{item.messageId}}" catchtap="playAV" aria-label="播放{{item.isAudio ? '语音' : '视频'}}">
              <text class="chat-icon {{item.isAudio ? 'chat-icon-voice' : 'chat-icon-video'}}" aria-hidden="true"></text><text>{{item.duration}}″{{playingAudio === item.messageId ? ' · 播放中' : ''}}</text>
              <text wx:if="{{item.isAudio && !item.heard && !item.isMine}}" class="av-unheard">●</text>
            </button>
            <button wx:if="{{!item.isAudio}}" data-id="{{item.messageId}}" catchtap="showFrames">查看保留的封面与抽帧</button>
            <text wx:if="{{item.isAudio && item.transcript}}" class="av-transcript">{{item.transcript}}</text>
          </view>
          <view wx:if="{{item.isImage}}" class="image-card">
            <view>{{item.imageCount > 1 ? '共' + item.imageCount + '张' : '图片'}}</view>
            <view class="image-grid">
              <view wx:for="{{item.images}}" wx:for-item="photo" wx:key="item_id" class="chat-image" id="image-{{item.messageId}}-{{photo.item_id}}" data-message="{{item.messageId}}" data-item="{{photo.item_id}}" catchtap="previewImage" catchlongpress="imageActions" aria-label="查看第{{photo.ordinal + 1}}张图片，长按回复此图">
                <image wx:if="{{photo.url}}" src="{{photo.url}}" mode="aspectFill" lazy-load/><text wx:else>第{{photo.ordinal + 1}}张</text>
              </view>
            </view>
            <button wx:if="{{item.imageCount > 4}}" data-id="{{item.messageId}}" catchtap="toggleImages">{{item.imageExpanded ? '收起' : '展开全部图片'}}</button>
          </view>
          <view wx:if="{{smsAnchor === item.messageId}}" class="sms-nudge-row">
            <text wx:if="{{smsFirstHint}}" class="sms-nudge-hint">暂未读，可用余额发短信提醒</text>
            <button class="sms-nudge-button" catchtap="openSMS" aria-label="短信提醒，点击查看费用与余额"><text class="chat-icon chat-icon-notice" aria-hidden="true"></text></button>
          </view>
          </view><view wx:if="{{item.isMine && item.state === 'published'}}" class="message-receipt" role="button" data-id="{{item.messageId}}" catchtap="showReaders">{{receiptLabels[item.messageId] || (directCalls ? '未读' : '查看阅读状态')}}</view></view>
        </view></block>
        <view wx:if="{{loading}}" class="conversation-empty compact"><text class="cuIcon-loading2 cuIconfont-spin"></text> 正在同步会话</view>
        <view wx:elif="{{!messages.length && status !== 'denied'}}" class="conversation-empty compact"><text class="cuIcon-comment"></text> 暂无可查看的消息</view>
        <view wx:for="{{attempts}}" wx:key="clientId" class="attempt-item">
          <view wx:if="{{item.body}}" class="message-text">{{item.body}}</view>
          <view class="attempt-state">{{item.label}}</view>
          <view wx:if="{{item.reason}}" class="attempt-reason">{{item.reason}}</view>
          <button wx:if="{{item.canRetry}}" data-id="{{item.clientId}}" bindtap="retryMessage">核验并重试原消息</button>
          <button wx:if="{{item.canEdit}}" data-id="{{item.clientId}}" bindtap="editAttempt">放回输入框修改</button>
        </view>
        <view wx:for="{{albums}}" wx:for-item="album" wx:key="clientId" class="album-attempt">
          <view>图片{{album.items.length > 1 ? '合集' : ''}} · {{album.label}}</view><view wx:if="{{!album.submitted}}" class="draft-hint">选图和上传不会发送；本机选择短时保留，需点击下方发送。</view>
          <view wx:for="{{album.items}}" wx:for-item="photo" wx:key="index" class="album-item">
            <image wx:if="{{photo.path}}" src="{{photo.path}}" mode="aspectFill"/><text>第{{photo.index + 1}}张 · {{photo.label}}{{photo.state === 'uploading' ? ' ' + photo.progress + '%' : ''}}</text>
            <button wx:if="{{photo.canRetry}}" data-client="{{album.clientId}}" data-index="{{photo.index}}" bindtap="retryImage">重试此图</button>
            <view wx:if="{{album.canChange}}" class="album-tools">
              <button data-client="{{album.clientId}}" data-index="{{photo.index}}" data-action="up" bindtap="changeImage" disabled="{{photo.index === 0}}">上移</button>
              <button data-client="{{album.clientId}}" data-index="{{photo.index}}" data-action="down" bindtap="changeImage" disabled="{{photo.index === album.items.length - 1}}">下移</button>
              <button data-client="{{album.clientId}}" data-index="{{photo.index}}" data-action="replace" bindtap="changeImage">替换</button>
              <button data-client="{{album.clientId}}" data-index="{{photo.index}}" data-action="remove" bindtap="changeImage">移除</button>
            </view>
          </view>
          <button wx:if="{{album.state === 'rejected'}}" data-client="{{album.clientId}}" bindtap="appealImages">核验并申诉此次图片检查</button><view wx:if="{{album.reason}}" class="attempt-reason">{{album.reason}}</view>
          <button wx:if="{{!album.submitted}}" data-client="{{album.clientId}}" bindtap="sendImages" disabled="{{!album.canSend || !canSend}}">发送{{album.items.length}}张图片</button>
          <button wx:if="{{album.submitted && album.state !== 'accepted' && album.state !== 'canceled'}}" data-client="{{album.clientId}}" bindtap="imageStatus">核验原发送状态</button>
          <button wx:if="{{album.canCancel}}" data-client="{{album.clientId}}" bindtap="cancelImages">取消本次发送</button>
        </view>
        <view wx:for="{{avAttempts}}" wx:for-item="av" wx:key="client" class="message-item is-mine pending-media">
          <image class="message-avatar" src="{{av.avatarPath}}" mode="aspectFill"/>
          <view class="message-body">
            <view wx:if="{{isGroup}}" class="message-sender">{{av.displayName}}</view>
            <view class="pending-media-line">
              <view wx:if="{{av.failed}}" class="media-retry" role="button" aria-label="重新发送{{av.kind === 'audio' ? '语音' : '视频'}}" data-client="{{av.client}}" catchtap="retryAV">!</view>
              <view class="message-bubble av-message-bubble pending-av-bubble {{av.kind === 'audio' ? 'voice-message-bubble' : ''}}" style="width:{{av.bubbleWidth}}rpx">
                <view class="av-card">
                  <button data-client="{{av.client}}" catchtap="previewAV" catchlongpress="pendingAVActions" aria-label="预览{{av.kind === 'audio' ? '语音' : '视频'}}"><text class="chat-icon {{av.kind === 'audio' ? 'chat-icon-voice' : 'chat-icon-video'}}" aria-hidden="true"></text><text>{{av.duration}}″</text></button>
                  <text wx:if="{{av.kind === 'audio' && av.transcript}}" class="av-transcript">{{av.transcript}}</text>
                </view>
              </view>
            </view>
            <view class="pending-media-state {{av.failed ? 'has-error' : ''}}" data-client="{{av.client}}" catchtap="pendingAVActions">{{av.uploading ? '上传中 ' + av.progress + '%' : av.label}}</view>
            <view wx:if="{{av.code}}" class="pending-media-reason" data-client="{{av.client}}" catchtap="pendingAVActions">{{av.code}}</view>
            <view wx:if="{{!av.submitted}}" class="pending-media-state" data-client="{{av.client}}" catchtap="sendAV">发送</view>
          </view>
        </view>
        <view id="message-bottom" class="message-bottom"></view>
      </view>
    </scroll-view>
    <view wx:if="{{status !== 'denied'}}" class="composer">
      <block wx:if="{{canSend}}">
        <view wx:if="{{replyTarget}}" class="composer-reference"><text>回复：{{replyPreview}}</text><button bindtap="cancelReply" aria-label="取消回复引用">取消引用</button></view>
        <view wx:if="{{editedSource}}" class="composer-reedit"><text>由已撤回消息重新编辑 · 将作为新消息发送</text><button bindtap="cancelReedit">取消重新编辑</button></view>
        <view class="composer-row">
          <button wx:if="{{audioEnabled}}" class="chat-icon-button composer-mode" bindtap="toggleVoiceMode" aria-label="{{voiceMode ? '切换键盘输入' : '切换语音输入'}}"><text class="chat-icon {{voiceMode ? 'chat-icon-keyboard' : 'chat-icon-voice'}}" aria-hidden="true"></text></button>
          <button wx:if="{{voiceMode && audioEnabled}}" class="voice-hold {{recording ? 'is-recording' : ''}}" bindtouchstart="beginVoice" catchtouchmove="moveVoice" bindtouchend="endVoice" bindtouchcancel="cancelVoice" aria-label="按住录音，松开发送，上滑取消">{{recordCanceled ? '松开 取消' : recording ? '松开 发送' : voiceStarting ? '准备中…' : '按住 说话'}}</button>
          <input wx:else class="composer-input" type="text" value="{{draft}}" maxlength="2000" adjust-position="{{false}}" confirm-type="send" confirm-hold="{{true}}" hold-keyboard="{{true}}" bindconfirm="sendText" bindinput="inputText" bindfocus="focusComposer" bindblur="inputBlur" bindkeyboardheightchange="keyboardChange" placeholder="输入消息" placeholder-class="composer-placeholder" aria-label="消息内容，键盘发送键可发送"/>
          <view wx:if="{{draft && (!voiceMode || !audioEnabled)}}" class="composer-send {{inputError ? 'is-disabled' : ''}}" role="button" bindtap="sendText" aria-disabled="{{!!inputError}}" aria-label="发送文字消息">发送</view>
          <button wx:elif="{{!simulation}}" class="chat-icon-button composer-more" bindtap="toggleTools" aria-label="{{showTools ? '收起更多功能' : '更多功能'}}" aria-expanded="{{showTools}}"><text class="chat-icon {{showTools ? 'chat-icon-close' : 'chat-icon-plus'}}" aria-hidden="true"></text></button>
        </view>
        
        <view wx:if="{{showTools}}" class="chat-tools">
          <view class="chat-tool" bindtap="shareOrder" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-order" aria-hidden="true"></text></view><text>订单</text></view>
          <view class="chat-tool" bindtap="chooseImages" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-photo" aria-hidden="true"></text></view><text>照片</text></view>
          <view class="chat-tool" bindtap="takePhoto" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-camera" aria-hidden="true"></text></view><text>拍摄</text></view>
          <view wx:if="{{videoEnabled}}" class="chat-tool" bindtap="chooseVideo" disabled="{{avSelecting}}" role="button"><view class="chat-tool-icon"><text class="chat-icon chat-icon-video" aria-hidden="true"></text></view><text>视频</text></view>
          <view wx:if="{{!simulation && canSend && directCalls}}" class="chat-tool {{callAudio ? '' : 'is-unavailable'}}" data-media="audio" bindtap="openCall" role="button" aria-disabled="{{!callAudio}}"><view class="chat-tool-icon"><text class="chat-icon chat-icon-phone" aria-hidden="true"></text></view><text>语音通话</text></view>
          <view wx:if="{{!simulation && canSend && directCalls}}" class="chat-tool {{callVideo ? '' : 'is-unavailable'}}" data-media="video" bindtap="openCall" role="button" aria-disabled="{{!callVideo}}"><view class="chat-tool-icon"><text class="chat-icon chat-icon-video" aria-hidden="true"></text></view><text>视频通话</text></view>
        </view>
        <view wx:if="{{showTools && !simulation && canSend && directCalls && !callAudio && !callVideo && callReason}}" class="call-tool-hint">{{callReason}}</view>
        <view wx:if="{{inputError}}" class="input-error" role="alert">{{inputError}}</view>
        <view wx:if="{{sendReason}}" class="input-error" role="alert">上次发送：{{sendReason}}</view>
      </block>
      <view wx:else class="composer-closed">当前会话只读，可通过上方入口查看订单</view>
    </view>
  </block>

  <view wx:if="{{messageMenu}}" class="message-menu-mask" catchtap="closeMessageMenu" catchtouchmove="stopImageTouch"><view class="message-menu" style="top:{{messageMenu.top}}px;left:{{messageMenu.left}}px" catchtap="stopImageTouch"><button wx:for="{{messageMenu.actions}}" wx:key="key" data-key="{{item.key}}" catchtap="runMessageAction">{{item.label}}</button></view></view>
  <view wx:if="{{recording}}" class="voice-record-mask" aria-live="polite"><view class="voice-record-panel {{recordCanceled ? 'is-cancel' : ''}}">
    <view wx:if="{{recordCanceled}}" class="voice-cancel-symbol">↶</view>
    <view wx:else class="voice-waveform"><text class="chat-icon chat-icon-mic"></text><view class="voice-level-bars"><view></view><view></view><view></view><view></view><view></view></view></view>
    <text wx:if="{{voiceCountdown <= 10 && !recordCanceled}}" class="voice-countdown">还可说 {{voiceCountdown}} 秒</text>
    <text class="voice-record-instruction">{{recordCanceled ? '松开手指，取消发送' : '手指上滑，取消发送'}}</text>
  </view></view>
  <view wx:if="{{smsDialog}}" class="sms-mask" catchtouchmove="stopImageTouch" bindtap="closeSMS">
    <view class="sms-dialog" role="dialog" aria-label="短信提醒确认" catchtap="stopImageTouch">
      <view class="sms-dialog-title">短信提醒</view>
      <scroll-view wx:if="{{smsDialog.state === 'confirm'}}" scroll-y class="sms-recipient-list {{smsDialog.items.length === 1 ? 'sms-one' : (smsDialog.items.length === 2 ? 'sms-two' : '')}}">
        <button wx:for="{{smsDialog.items}}" wx:key="id" class="sms-recipient {{smsDialog.selected === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectSMSRecipient" disabled="{{smsBusy}}"><text>{{item.name}}</text><text>{{smsDialog.selected === item.id ? '✓' : ''}}</text></button>
      </scroll-view>
      <view wx:if="{{smsDialog.state === 'confirm'}}" class="sms-fee">本次 {{smsDialog.fee}} · 可用余额 {{smsDialog.balance}}</view>
      <view wx:if="{{smsDialog.insufficient}}" class="sms-insufficient">余额不足，充值后可提醒。充值不会自动发送短信。</view>
      <view class="sms-dialog-note">{{smsDialog.notice}}</view>
      <view class="sms-dialog-actions"><button bindtap="closeSMS" disabled="{{smsBusy}}">{{smsDialog.state === 'confirm' ? '取消' : '关闭'}}</button><button class="sms-confirm" bindtap="confirmSMS" loading="{{smsBusy}}" disabled="{{smsBusy}}">{{smsDialog.state === 'confirm' ? (smsDialog.insufficient ? '去充值' : '确认提醒') : (smsDialog.state === 'pending' ? '核对结果' : '知道了')}}</button></view>
    </view>
  </view>
  <view wx:if="{{activeFrames}}" class="av-viewer" catchtouchmove="stopImageTouch"><button bindtap="closeAV">关闭图片</button><view>{{activeFrames.label}}</view><image wx:if="{{activeFrames.src}}" src="{{activeFrames.src}}" mode="aspectFit" style="width:100%;height:65vh"/><view class="av-composer"><button bindtap="previousFrame" disabled="{{activeFrames.index < 0}}">上一张</button><button bindtap="nextFrame" disabled="{{activeFrames.index + 1 >= activeFrames.count}}">下一张</button></view></view>
  <view wx:if="{{activeVideo}}" class="av-viewer" catchtouchmove="stopImageTouch">
    <button bindtap="closeAV">关闭视频</button>
    <video id="chat-video" src="{{activeVideo.src}}" controls autoplay="{{false}}" show-center-play-btn object-fit="contain" binderror="closeAV" />
    <view wx:if="{{activeVideo.preview}}">预览不会发送，请关闭后点击确认发送</view>
  </view>
  <view wx:if="{{largeImage}}" class="image-viewer" catchtouchmove="stopImageTouch">
    <view class="image-viewer-bar"><button bindtap="closeImage">关闭</button><text>{{largeImage.index + 1}} / {{largeImage.count}}</text><button bindtap="saveImage" disabled="{{!largeImage.url}}">保存此图</button></view>
    <view class="image-viewer-body" bindtouchstart="imageTouchStart" bindtouchend="imageTouchEnd">
      <image wx:if="{{largeImage.url}}" src="{{largeImage.url}}" mode="aspectFit"/><text wx:else>{{largeImage.loading ? '图片加载中' : largeImage.error}}</text>
    </view>
    <view class="image-viewer-bar"><button bindtap="previousImage" disabled="{{largeImage.index === 0}}">上一张</button><button bindtap="nextImage" disabled="{{largeImage.index + 1 >= largeImage.count}}">下一张</button></view>
  </view>
</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>
