  }

  page .admin-page .admin-action--warning,
  page .admin-page .admin-action--outline {
    color: #f2d58b !important;
    background: #3a301d !important;
    box-shadow: inset 0 0 0 1rpx #6a5528 !important;
  }

  page .admin-page .admin-action--danger {
    color: #ffc0b8 !important;
    background: #3a211f !important;
    box-shadow: inset 0 0 0 1rpx #70403a !important;
  }

  page .business-stats.business-stats {
    color: #dce7e9 !important;
    background: #192629 !important;
  }

  page .business-stats .stats-switch {
    background: #121c1f !important;
  }

  page .business-stats .stats-switch > view {
    color: #a9b8bb !important;
  }

  page .business-stats .stats-switch > view.active {
    background: #29373a !important;
    box-shadow: none !important;
  }

  page .business-stats .stats-single-title,
  page .business-stats .stat-label {
    color: #c2d0d2 !important;
  }

  page .business-stats .stats-grid > view {
    border-color: #2d4145 !important;
  }

  page .business-stats .stats-dots text {
    background: #45575b !important;
  }

  page .business-stats .stats-dots text.active.user-dot {
    background: #ed7b32 !important;
  }

  page .business-stats .stats-dots text.active.worker-dot {
    background: #159b63 !important;
  }

  page .legacy-counts {
    color: #91a2a5 !important;
  }

  page .UCenter-bg.UCenter-bg {
    background-image: linear-gradient(rgba(10, 22, 27, .28), rgba(10, 22, 27, .42)), url(https://776f-worker-real-1301382302.tcb.qcloud.la/public/mineBg.jpeg) !important;
  }

  page .userinfo-nickname {
    color: #eef7ff !important;
  }

  page .worker-review-state {
    color: #c3d0d2 !important;
    background: #263236 !important;
  }

  page .worker-review-state.approved {
    color: #80e0b4 !important;
    background: #17382b !important;
  }

  page .worker-review-state.pending {
    color: #f2d27e !important;
    background: #3b3019 !important;
  }

  page .worker-review-state.blocked {
    color: #ffb8ae !important;
    background: #3a211f !important;
  }
