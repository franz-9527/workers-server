  page .center-page.center-page,
  page .construction-page.construction-page,
  page .detail-page.detail-page {
    color: #e7f0f1 !important;
    background: #101718 !important;
  }

  page .hall-page.hall-page {
    background: linear-gradient(180deg, #007985 0, #007985 150rpx, #101718 300rpx) !important;
  }

  page .hall-page .order-card,
  page .center-page .card,
  page .construction-page .legacy-entry,
  page .construction-page .order-card,
  page .detail-page .panel,
  page .detail-page .card,
  page .detail-page .actions-card,
  page .detail-page .admin-edit-modal,
  page .detail-page .modal {
    color: #e7f0f1 !important;
    background: #192629 !important;
    border-color: #2d4145 !important;
    box-shadow: none !important;
  }

  page .hall-page .order-title,
  page .center-page .ellipsis,
  page .construction-page .legacy-content,
  page .construction-page .empty-title,
  page .detail-page .panel-title,
  page .detail-page .title,
  page .detail-page .order-action,
  page .detail-page .order-action > view,
  page .detail-page .admin-edit-modal input,
  page .detail-page .admin-edit-modal textarea {
    color: #e7f0f1 !important;
  }

  page .hall-page .text-grey,
  page .center-page .text-grey,
  page .construction-page .text-grey,
  page .detail-page .text-grey,
  page .construction-page .order-meta,
  page .construction-page .visit-time,
  page .construction-page .legacy-content text,
  page .detail-page .info-line .label,
  page .detail-page .collection-note,
  page .detail-page .order-action small {
    color: #a7b9bc !important;
  }

  page .hall-page .hall-filter,
  page .center-page .status-nav,
  page .construction-page .tabs,
  page .construction-page .tab.active,
  page .construction-page .distance-grid,
  page .construction-page .income-grid,
  page .detail-page .distance-grid,
  page .detail-page .income-grid,
  page .detail-page .description,
  page .detail-page .upload-block,
  page .detail-page .picker-box,
  page .detail-page .completion-textarea,
  page .detail-page .modal-body textarea,
