  page .hall-page .hall-filter,
  page .center-page .status-nav,
  page .construction-page .tabs,
  page .detail-page .info-line,
  page .detail-page .panel-title,
  page .detail-page .fee-change-item,
  page .detail-page .merchant-code-row + .merchant-code-row {
    border-color: #2d4145 !important;
  }

  page .hall-page .category-tag:not(.category-tag-all) {
    color: #d5e2e4 !important;
    background: #202e31 !important;
    border-color: #34494d !important;
  }

  page .hall-page .category-tag.bg-cyan,
  page .detail-page .navigation-action,
  page .detail-page .main-action.action-primary {
    color: #fff !important;
    background: #00aebd !important;
  }

  page .hall-page .order-footer,
  page .center-page .footer,
  page .construction-page .card-footer,
  page .construction-page .order-no,
  page .center-page .status-tab,
  page .construction-page .status-tab,
  page .detail-page .info-line,
  page .detail-page .commission-bill > view {
    border-color: #2d4145 !important;
    color: #a7b9bc !important;
  }

  page .construction-page .legacy-icon {
