  page .detail-page .notice.quote-paused,
  page .detail-page .after-sales-resolution,
  page .detail-page .quote-reminder,
  page .detail-page .commission-tip,
  page .detail-page .delay-record,
  page .detail-page .run-empty-status,
  page .detail-page .cancel-explain,
