/* 2026-09-15：无管理工具的管理员订单详情改为单行金额栏，不留空操作区。 */
.detail-page--summary-only.detail-page--summary-only {
  padding-bottom: calc(82rpx + env(safe-area-inset-bottom)) !important;
}

.order-fixed-footer--summary-only.order-fixed-footer--summary-only {
  max-height: calc(82rpx + env(safe-area-inset-bottom)) !important;
  overflow: hidden;
}

.order-fixed-footer--summary-only .order-footer-main {
  height: 76rpx !important;
  align-items: center !important;
  padding: 0 26rpx !important;
}

.order-fixed-footer--summary-only .order-footer-tools {
  display: none !important;
}

.order-fixed-footer--summary-only .order-footer-summary {
  display: flex !important;
  flex: 1 !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100%;
  margin: 0 !important;
  padding: 0 !important;
  border-left: 0 !important;
  text-align: left !important;
}

.order-fixed-footer--summary-only .order-footer-summary .summary-label {
  flex: 1;
  height: auto !important;
  font-size: 24rpx !important;
  line-height: 1.3 !important;
  text-align: left;
}

.order-fixed-footer--summary-only .order-footer-summary .summary-amount {
  flex: none;
  width: auto !important;
  height: auto !important;
  overflow: visible !important;
  font-size: 42rpx !important;
  line-height: 1.2 !important;
}

.order-fixed-footer--summary-only .order-footer-summary .summary-booking {
  display: none !important;
}

/* 2026-09-15：管理员工作台审核是卡片唯一主操作，拉满操作行并保持易点按。 */
.admin-review-button {
  box-sizing: border-box !important;
  display: block !important;
  width: 100% !important;
  height: 78rpx !important;
  margin: 0 !important;
  line-height: 78rpx !important;
  text-align: center !important;
}
