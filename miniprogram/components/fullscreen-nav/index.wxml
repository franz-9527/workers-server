<view class="fullscreen-nav-spacer" style="height:{{totalHeight}}px;"></view>
<view class="fullscreen-nav tone-{{tone}} {{solid ? 'is-solid' : ''}}" style="height:{{totalHeight}}px;padding-top:{{statusBarHeight}}px;">
  <view class="fullscreen-nav-inner" style="height:{{navBarHeight}}px;">
    <view wx:if="{{!hideBack}}" class="fullscreen-nav-back" bindtap="goBack" hover-class="fullscreen-nav-back-hover" aria-label="返回">
      <view class="fullscreen-nav-chevron"></view>
    </view>
    <view wx:if="{{testingApi && (!testingBadgeWithTitle || solid || showTitle || testingTitleOnly) && (!testingBadgeWithTitle || resolvedTitle)}}" class="fullscreen-nav-test">测试站</view>
    <view wx:if="{{(solid || showTitle || (testingApi && testingTitleOnly)) && resolvedTitle}}" class="fullscreen-nav-title">{{resolvedTitle}}</view>
  </view>
</view>
