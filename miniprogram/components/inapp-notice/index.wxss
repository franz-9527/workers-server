:host{position:relative;z-index:1000}
.inapp-notice{position:fixed;left:20rpx;right:20rpx;z-index:1000;box-sizing:border-box;display:flex;align-items:flex-start;gap:12rpx;max-width:900rpx;margin:0 auto;padding:18rpx 14rpx 18rpx 18rpx;border:1rpx solid #dce9e7;border-radius:20rpx;background:#fff;color:#203a38;box-shadow:0 10rpx 38rpx rgba(16,54,48,.16)}
.notice-mark{flex:none;width:48rpx;height:48rpx;margin-top:2rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:#e1f5f0;color:#087b68;font-size:25rpx;font-weight:600}
.kind-health .notice-mark{background:#fff1dc;color:#a9670e}.kind-chat .notice-mark{background:#e4f1ff;color:#2066ad}
.notice-copy{flex:1;min-width:0}.notice-heading{display:flex;align-items:flex-start;gap:12rpx;min-width:0}
.notice-title{display:block;flex:1;min-width:0;font-size:27rpx;font-weight:600;line-height:1.55;white-space:normal;word-break:break-word}
.notice-description{display:block;margin-top:4rpx;font-size:24rpx;line-height:1.55;color:#667f79;white-space:normal;word-break:break-word}
.notice-action,.notice-close{flex:none;box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-height:32px;height:auto;margin:0;border:0;font-size:24rpx;line-height:1.5}
.notice-action{max-width:140rpx;padding:4rpx 12rpx;border-radius:10rpx;background:#e8f5f0;color:#087b68;white-space:normal}
.notice-close{width:32px;padding:0;background:transparent;color:#738c84;font-size:34rpx}
.notice-action::after,.notice-close::after{border:0}
@media(prefers-color-scheme:dark){.inapp-notice{background:#1c2b28;color:#edf5f1;border-color:#3a514b;box-shadow:0 10rpx 38rpx #0006}.notice-description,.notice-close{color:#b0c5bc}.notice-mark{background:#224b40;color:#9be0c8}.kind-health .notice-mark{background:#463820;color:#f3cc83}.kind-chat .notice-mark{background:#243c55;color:#a4cafa}.notice-action{background:#28483d;color:#b1ead3}}
