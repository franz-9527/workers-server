:host{position:relative;z-index:1000}
.inapp-notice{position:fixed;left:20rpx;right:20rpx;z-index:1000;box-sizing:border-box;display:flex;align-items:center;gap:14rpx;max-width:900rpx;margin:0 auto;padding:18rpx 12rpx 18rpx 20rpx;border:1rpx solid #dce9e7;border-radius:22rpx;background:#fff;color:#203a38;box-shadow:0 10rpx 38rpx rgba(16,54,48,.16)}
.notice-mark{flex:none;width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:#e1f5f0;color:#087b68;font-size:25rpx;font-weight:600}
.kind-health .notice-mark{background:#fff1dc;color:#a9670e}.kind-chat .notice-mark{background:#e4f1ff;color:#2066ad}
.notice-copy{flex:1;min-width:0}.notice-title,.notice-description{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.notice-title{font-size:25rpx;font-weight:600;line-height:1.5}.notice-description{margin-top:4rpx;color:#738985;font-size:22rpx;line-height:1.5}
.notice-action,.notice-close{flex:none;box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:auto;min-height:64rpx;height:auto;margin:0;padding:0 12rpx;line-height:1.4;border:0;background:transparent;color:#087b68;font-size:24rpx}
.notice-action::after,.notice-close::after{border:0}.notice-close{padding:0 10rpx;color:#82938f;font-size:38rpx}
@media(prefers-color-scheme:dark){.inapp-notice{background:#1c2b28;color:#edf5f1;border-color:#3a514b;box-shadow:0 10rpx 38rpx #0006}.notice-description,.notice-close{color:#a0b8ae}.notice-mark{background:#224b40;color:#9be0c8}.kind-health .notice-mark{background:#463820;color:#f3cc83}.kind-chat .notice-mark{background:#243c55;color:#a4cafa}.notice-action{color:#9be0c8}}
