@import "../../style/order-modal.wxss";
.panel{margin:20rpx 24rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(15,23,42,.05)}
.title{display:flex;align-items:center;gap:10rpx;font-size:30rpx;font-weight:700;color:#1f2937;margin-bottom:16rpx}.icon{display:inline-flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border-radius:50%;background:#fff7ed;color:#ea580c;font-size:22rpx;font-weight:700}.row{display:flex;justify-content:space-between;gap:24rpx;padding:12rpx 0;font-size:27rpx;color:#475569}.amount{font-weight:700;color:#111827}.status{color:#ea580c}.description{margin-top:12rpx;line-height:1.7;color:#374151;font-size:27rpx;word-break:break-all}.note{margin-top:12rpx;font-size:24rpx;color:#87909a}.hint{margin-top:20rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#f8fafc;color:#64748b;font-size:24rpx;line-height:1.65}.actions{display:flex;gap:16rpx;margin-top:24rpx}.button{flex:1;min-width:0;margin:0;border:0;border-radius:999rpx;font-size:26rpx;height:76rpx;line-height:76rpx;padding:0 20rpx}.button::after{border:0}.reject{background:#fff1f2;color:#be123c}.accept{background:#00b9cb;color:#fff}.neutral{background:#f1f5f9;color:#475569}.danger{background:#e54d42;color:#fff}.mask{position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.46);display:flex;align-items:center;justify-content:center;padding:48rpx;box-sizing:border-box}.modal{width:100%;max-width:680rpx;border-radius:28rpx;padding:32rpx;background:#fff;box-sizing:border-box}.modal-title{font-size:34rpx;font-weight:700;color:#1f2937}.warning{margin-top:18rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#fff7e8;color:#8a5d16;font-size:25rpx;line-height:1.6}.textarea{box-sizing:border-box;width:100%;min-height:190rpx;margin-top:22rpx;padding:20rpx;border:1rpx solid #e5e7eb;border-radius:18rpx;background:#fafafa;font-size:27rpx;color:#1f2937}.modal-actions{display:flex;gap:16rpx;margin-top:24rpx}

@media(prefers-color-scheme:dark){.panel{background:#192629}.title,.amount{color:#e7f0f1}.row,.description{color:#d5e2e4}.note{color:#adbec2}.hint{background:#162225;color:#adbec2}.neutral{background:#263b40;color:#d5e2e4}.reject{background:#42262e;color:#ffb5bf}.danger{background:#bf4541;color:#fff}}
.button{height:auto;min-height:88rpx;line-height:1.45;padding:18rpx 20rpx;white-space:normal;display:flex;align-items:center;justify-content:center}
