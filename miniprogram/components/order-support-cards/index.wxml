<view wx:if="{{items.length}}" class="order-support">
 <view class="order-support-head"><text>遇到问题</text><text wx:if="{{items.length > 3}}" class="order-support-hint">左滑查看更多 <text class="cuIcon-pullleft"></text></text></view>
 <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="order-support-scroll">
  <view class="order-support-track">
   <button wx:for="{{items}}" wx:key="key" class="order-support-card {{item.tone}}" data-key="{{item.key}}" bindtap="select">
    <text class="{{item.icon}} order-support-icon"></text><text class="order-support-title">{{item.title}}</text><text class="order-support-description">{{item.description}}</text>
   </button>
  </view>
 </scroll-view>
</view>
