<view wx:if="{{items.length}}" class="order-support">
 <view class="order-support-head"><text>遇到问题</text><text wx:if="{{items.length > 1}}" class="order-support-hint">左滑查看其他处理</text></view>
 <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="order-support-scroll">
  <view class="order-support-track">
   <view wx:for="{{items}}" wx:key="key" class="order-support-card {{item.tone}}">
    <view class="order-support-title"><text class="{{item.icon}} order-support-icon"></text><text>{{item.title}}</text></view>
    <view class="order-support-description">{{item.description}}</view>
    <button class="order-support-action {{item.tone}}" data-key="{{item.key}}" bindtap="select">{{item.actionText || item.title}}</button>
   </view>
  </view>
 </scroll-view>
</view>
