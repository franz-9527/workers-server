:host{display:block;width:100%;flex-shrink:0}
.order-support{margin:20rpx 0}
.order-support-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:0 24rpx 14rpx;color:#64797f;font-size:26rpx;font-weight:600}
.order-support-hint{color:#93a1a4;font-size:21rpx;font-weight:400}
.order-support-scroll{display:block;width:100%;white-space:nowrap}
.order-support-track{box-sizing:border-box;display:flex;align-items:stretch;width:max-content;gap:16rpx;padding:0 24rpx}
.order-support-card{box-sizing:border-box;display:flex;flex-direction:column;align-items:flex-start;flex:none;width:650rpx;max-width:calc(100vw - 72rpx);min-height:248rpx;padding:28rpx;border-radius:20rpx;background:#fff;color:#526a70;white-space:normal;line-height:1.65}
.order-support-title{display:flex;align-items:center;gap:12rpx;font-size:28rpx;font-weight:600;color:#3d555c}
.order-support-icon{flex:none;color:#d99039;font-size:32rpx}
.order-support-description{flex:1;margin-top:16rpx;font-size:25rpx;line-height:1.65;white-space:normal;word-break:break-word}
.order-support-action{box-sizing:border-box;display:flex;align-items:center;justify-content:center;align-self:flex-start;min-height:68rpx;height:auto;max-width:100%;margin:22rpx 0 0;padding:10rpx 26rpx;border:1rpx solid #e3a955;border-radius:999rpx;background:transparent;color:#bd791f;font-size:25rpx;line-height:1.5;text-align:center;white-space:normal}
.order-support-action::after{border:0}
.order-support-action.cyan{border-color:#68cbd3;color:#008e9c}
.order-support-action.red{border-color:#e3a955;color:#bd791f}
@media(prefers-color-scheme:dark){.order-support-head{color:#bacbd0}.order-support-hint{color:#93a9ae}.order-support-card{background:#192629;color:#b5c9cf}.order-support-title{color:#dbe9ed}.order-support-icon{color:#e6ad65}.order-support-action,.order-support-action.red{border-color:#bd9257;color:#e6bc82}.order-support-action.cyan{border-color:#579da5;color:#82d7e0}}
