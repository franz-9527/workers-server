:host{display:block;flex-shrink:0}
.order-support{margin:20rpx 24rpx;padding:22rpx 0;border-radius:20rpx;background:#fff}
.order-support-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:0 24rpx 18rpx;color:#526a70;font-size:26rpx;font-weight:600}
.order-support-hint{color:#93a1a4;font-size:20rpx;font-weight:400}
.order-support-scroll{width:100%;white-space:nowrap}
.order-support-track{display:inline-flex;align-items:stretch;gap:14rpx;padding:0 24rpx;box-sizing:border-box}
.order-support-card{box-sizing:border-box;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;flex:0 0 210rpx;width:210rpx;min-height:174rpx;height:auto;margin:0;padding:18rpx 16rpx;border:1rpx solid #e3ebed;border-radius:16rpx;background:#f7fafb;color:#385259;text-align:left;font-size:24rpx;line-height:1.5;white-space:normal}
.order-support-card::after{border:0}
.order-support-icon{display:block;margin-bottom:8rpx;color:#dc8d32;font-size:36rpx;line-height:1}
.order-support-card.cyan .order-support-icon{color:#00a3b4}
.order-support-card.red .order-support-icon{color:#d8625b}
.order-support-title{display:block;font-weight:600}
.order-support-description{display:block;margin-top:6rpx;color:#87989c;font-size:20rpx;line-height:1.45}
@media(prefers-color-scheme:dark){.order-support{background:#192629}.order-support-head{color:#c6d6d9}.order-support-hint,.order-support-description{color:#97adb3}.order-support-card{border-color:#344a50;background:#203136;color:#e1edef}.order-support-icon{color:#e6ad65}.order-support-card.cyan .order-support-icon{color:#73d5df}.order-support-card.red .order-support-icon{color:#ee958b}}
