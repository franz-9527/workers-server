:host{display:block;flex-shrink:0}
.subscription-hint{box-sizing:border-box;display:flex;align-items:center;gap:10rpx;margin:10rpx 0;padding:4rpx 14rpx;border-radius:10rpx;background:#f1f6f5;color:#72827e;font-size:24rpx;line-height:1.5}
.subscription-hint-icon{flex:none;color:#739b8f;font-size:26rpx}
.subscription-hint-text{flex:1;min-width:0;white-space:normal;word-break:break-word}
.subscription-hint-actions{display:flex;align-items:center;gap:4rpx;flex:none}
.subscription-hint-action,.subscription-hint-settings{flex:none;display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;min-height:32px;height:auto;margin:0;padding:4rpx 10rpx;border:0;border-radius:6rpx;background:transparent;color:#278a77;font-size:23rpx;line-height:1.5;white-space:nowrap}
.subscription-hint-action::after,.subscription-hint-settings::after{border:0}
.subscription-hint-action[disabled],.subscription-hint-settings[disabled]{background:transparent;color:#8d9e99}
.subscription-hint-settings{color:#7e9390;border-left:1rpx solid #dce6e3;border-radius:0;font-size:22rpx}
@media(prefers-color-scheme:dark){.subscription-hint{background:#1b2825;color:#a3b9b1}.subscription-hint-icon{color:#7eaa9a}.subscription-hint-action{color:#87ceba}.subscription-hint-settings{color:#a3b9b1;border-color:#354d43}.subscription-hint-action[disabled]{color:#6c897d}}
.review-waiting-card{display:flex;align-items:flex-start;gap:18rpx;margin-top:22rpx;padding:22rpx 24rpx;border:1rpx solid #cde9dc;border-radius:22rpx;background:#eef9f3;color:#285844}
.review-waiting-icon{display:flex;flex:none;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:18rpx;background:#d8f1e4;color:#16845e;font-size:30rpx}
.review-waiting-copy{min-width:0;flex:1}
.review-waiting-title,.review-waiting-desc{display:block}
.review-waiting-title{font-size:26rpx;font-weight:700;color:#1b6749}
.review-waiting-desc{margin-top:6rpx;color:#668579;font-size:21rpx;line-height:1.55}
@media(prefers-color-scheme:dark){.review-waiting-card{border-color:#2e5a47;background:#173126;color:#d9eee5}.review-waiting-icon{background:#214735;color:#74d5a9}.review-waiting-title{color:#a7e7ca}.review-waiting-desc{color:#91aa9f}}
