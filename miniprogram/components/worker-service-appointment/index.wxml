<view class="work-stage-card service-appointment {{appointment ? 'is-done' : ''}}">
  <view class="work-stage-head">
    <view class="work-stage-index"><text class="cuIcon-time"></text></view>
    <view class="work-stage-main">
      <view class="work-stage-title">预约上门</view>
      <view class="work-stage-summary">{{summary}}</view>
    </view>
    <view wx:if="{{!pricingBlocked && !pricingGateUnavailable}}" class="service-appointment-actions">
      <button wx:if="{{!appointment}}" class="stage-mini-action service-quick-wait" loading="{{saving}}" disabled="{{saving || pricingGateLoading}}" bindtap="markWaiting">待通知</button>
      <button class="stage-mini-action" disabled="{{saving || pricingGateLoading}}" bindtap="openEditor">{{appointment ? '修改' : '约时间'}}</button>
    </view>
    <view wx:else class="service-appointment-actions">
      <button class="stage-mini-action" disabled="true">{{pricingBlocked ? '暂不可预约' : '暂不可操作'}}</button>
    </view>
  </view>
  <view wx:if="{{pricingBlocked}}" class="work-stage-note">当前订单暂不可预约，请返回订单查看核价或协商处理进度，状态更新后再操作。</view>
  <view wx:elif="{{pricingGateUnavailable}}" class="work-stage-note">暂未能核对当前施工条件，为避免误操作已暂停预约入口，请刷新订单后重试。</view>
  <view wx:elif="{{appointment && appointment.note}}" class="work-stage-note">{{appointment.note}}</view>
</view>

<view class="order-modal order-modal-bottom cu-modal bottom-modal {{editing ? 'show' : ''}}" catchtouchmove="true">
  <view class="order-modal-dialog cu-dialog">
    <view class="order-modal-header cu-bar bg-white">
      <view class="action text-grey" bindtap="closeEditor">取消</view>
      <view class="content text-bold">预约上门</view>
      <view class="action text-cyan" bindtap="save">保存</view>
    </view>
    <scroll-view scroll-y enhanced class="order-modal-body modal-body text-left">
      <view wx:if="{{expectedVisitAt}}" class="appointment-source-tip"><text class="cuIcon-time text-cyan"></text> 客户期望：{{expectedVisitAt}}</view>
      <view wx:if="{{quoteAvailability}}" class="appointment-source-tip"><text class="cuIcon-info text-cyan"></text> 报价时填写：{{quoteAvailability}}</view>
      <checkbox-group bindchange="toggleWait">
        <label class="appointment-wait-option"><checkbox value="wait" checked="{{waitCustomerNotice}}" color="#00b9cb"/>等待客户另行通知</label>
      </checkbox-group>
      <view class="text-grey text-sm margin-top-xs">已联系但客户暂未确定时间时直接勾选；系统会记录你已响应，无需反复进入订单。</view>
      <block wx:if="{{!waitCustomerNotice}}">
        <view wx:if="{{presets.length}}" class="appointment-presets">
          <view class="text-grey text-sm margin-bottom-xs">快捷选择</view>
          <view class="preset-row"><button wx:for="{{presets}}" wx:key="label" class="cu-btn sm round line-cyan preset-button" data-index="{{index}}" bindtap="choosePreset">{{item.label}}</button></view>
        </view>
        <view class="picker-row flex">
          <picker mode="date" value="{{appointmentDate}}" bindchange="pickDate"><view class="picker-box">{{appointmentDate || '选择日期'}}</view></picker>
          <picker mode="time" value="{{appointmentTime}}" bindchange="pickTime"><view class="picker-box">{{appointmentTime || '选择时间'}}</view></picker>
        </view>
      </block>
      <textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" maxlength="500" placeholder="预约备注（选填）" value="{{note}}" bindinput="inputNote"></textarea>
      <view class="text-grey text-sm margin-top">师傅提交后直接生效，无需客户再次确认。</view>
    </scroll-view>
  </view>
</view>
