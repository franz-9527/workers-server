/* 浮动底栏和发布面板共用底部安全区，保持加号的点击区域独立。 */
.tabBar {
  position: fixed;
  z-index: 100;
  left: 22rpx;
  right: 22rpx;
  bottom: 10rpx;
  bottom: calc(10rpx + constant(safe-area-inset-bottom));
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, .88);
  border-radius: 36rpx;
  background-color: rgba(249, 252, 253, .86);
  background-image: linear-gradient(180deg, rgba(255, 255, 255, .38), rgba(234, 244, 246, .16));
  color: #54666b;
  box-shadow: 0 10rpx 34rpx rgba(16, 53, 61, .14), inset 0 1rpx 0 rgba(255, 255, 255, .88);
  -webkit-backdrop-filter: blur(22px) saturate(150%);
  backdrop-filter: blur(22px) saturate(150%);
}

.tabBar .cont {
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  height: 106rpx;
  padding: 5rpx 8rpx;
}

.tabBar .item,
.tabBar .plus {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  margin: 0 2rpx;
  border-radius: 28rpx;
}

.tabBar .item.on {
  background-color: rgba(0, 152, 164, .095);
  color: #006e77;
}

.tabBar .item:active { background-color: rgba(0, 152, 164, .14); }
.tabBar .plus:active { opacity: .78; }

.tabBar .nav-icon-frame {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
}

.tabBar .image-style { width: 50rpx; height: 50rpx; }
.tabBar .plus .nav-icon-frame,
.tabBar .plus .image-style { width: 104rpx; height: 72rpx; }

.tabBar .txt {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.tabBar .on .txt { font-weight: 650; }

.tabBar .tab-notice-badge {
  position: absolute;
  z-index: 1;
  top: -5rpx;
  left: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border: 2rpx solid #f8fcfc;
  border-radius: 20rpx;
  background: #d91f39;
  color: #fff;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(109, 16, 30, .14);
  pointer-events: none;
}

.tabBar .tab-notice-badge.is-dot {
  top: 0;
  left: 37rpx;
  width: 17rpx;
  min-width: 0;
  height: 17rpx;
  padding: 0;
}

.publish-mask { position: fixed; inset: 0; z-index: 99; background: rgba(16, 35, 39, .46); }

.publish-menu {
  position: absolute;
  left: 50%;
  bottom: 150rpx;
  bottom: calc(150rpx + constant(safe-area-inset-bottom));
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  box-sizing: border-box;
  width: 650rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(27, 70, 78, .06);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 22rpx 65rpx rgba(16, 43, 49, .2);
}

.publish-choice {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  transition: background-color .15s ease, transform .15s ease;
}

.publish-choice + .publish-choice { margin-top: 4rpx; }
.publish-choice:active { background: #edf9fa; transform: scale(.99); }

.choice-icon {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 44rpx;
  line-height: 88rpx;
  text-align: center;
}

.choice-icon.order { background: linear-gradient(135deg, #00b9cb, #20a7d0); }
.choice-icon.worker { background: linear-gradient(135deg, #ff9c52, #f47735); }
.choice-title { color: #273d42; font-size: 31rpx; font-weight: 700; }
.choice-desc { margin-top: 7rpx; color: #5f7277; font-size: 23rpx; }

@media (prefers-color-scheme: dark) {
  .tabBar {
    border-color: rgba(217, 246, 250, .16);
    background-color: rgba(19, 28, 32, .88);
    background-image: linear-gradient(180deg, rgba(156, 213, 221, .09), rgba(26, 44, 50, .05));
    color: #b4c6ca;
    box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, .40), inset 0 1rpx 0 rgba(228, 251, 254, .07);
  }

  .tabBar .item.on { background-color: rgba(82, 207, 212, .14); color: #a8edf0; }
  .tabBar .item:active { background-color: rgba(82, 207, 212, .20); }
  .tabBar .tab-notice-badge { border-color: #25383c; box-shadow: none; }
  .publish-mask { background: rgba(0, 0, 0, .56); }
  .publish-menu { border-color: #344a50; background: #202d32; box-shadow: 0 22rpx 65rpx rgba(0, 0, 0, .42); }
  .publish-choice:active { background: #2b4147; }
  .choice-title { color: #edf8f9; }
  .choice-desc { color: #afc2c7; }
}
