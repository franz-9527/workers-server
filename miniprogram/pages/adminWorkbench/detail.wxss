@import "../../style/order-modal.wxss";
page{background:#f4f7f8!important}
.detail-page{
  --page-bg:#f4f7f8;--surface:#fff;--surface-muted:#f5f8f9;--text:#293a3f;--text-secondary:#738084;
  --border:#e2eaec;--primary:#00aebd;--primary-soft:#e8f8fa;--danger:#b6403a;--danger-soft:#fff0ee;
  --warning:#8d6200;--warning-soft:#fff6dc;--info:#33768c;--info-soft:#edf7fb;
  min-height:100vh;padding-bottom:70rpx;padding-bottom:calc(70rpx + constant(safe-area-inset-bottom));padding-bottom:calc(70rpx + env(safe-area-inset-bottom));background:var(--page-bg);color:var(--text)
}
.detail-loading-shell{min-height:100vh}.page-loading{padding:150rpx 20rpx;text-align:center;color:var(--text-secondary)}.spin{display:inline-block;margin-right:8rpx;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.detail-hero{position:relative;padding:0 26rpx 32rpx;overflow:hidden;background:linear-gradient(145deg,#18c5d1 0%,#09a6b3 48%,#007f8b 100%);color:#fff;box-shadow:0 12rpx 32rpx rgba(0,111,122,.14)}
.detail-hero:after{content:"";position:absolute;right:-90rpx;top:54rpx;width:280rpx;height:280rpx;border-radius:50%;background:rgba(255,255,255,.08);pointer-events:none}.hero-top,.hero-no,.hero-phase{position:relative;z-index:1}.hero-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;padding-top:7rpx}.hero-title{min-width:0;flex:1;font-size:34rpx;font-weight:750;overflow-wrap:anywhere}.workflow-tag{flex:none;padding:6rpx 12rpx;border:1rpx solid rgba(255,255,255,.38);border-radius:14rpx;background:rgba(255,255,255,.08);font-size:22rpx}.hero-no{margin-top:9rpx;font-size:22rpx;opacity:.82;overflow-wrap:anywhere}.hero-phase{margin-top:18rpx;font-size:27rpx;font-weight:700}
.section{margin:18rpx 20rpx 0;padding:23rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:20rpx;box-shadow:0 6rpx 22rpx rgba(34,69,75,.05)}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.section-title{font-size:29rpx;font-weight:700}.section-desc{margin-top:5rpx;color:var(--text-secondary);font-size:22rpx;line-height:1.5}.count-badge{min-width:42rpx;padding:5rpx 9rpx;text-align:center;border-radius:13rpx;background:var(--primary-soft);color:#007f8a;font-size:22rpx}
.task-summary-strip{display:flex;gap:12rpx;margin-top:14rpx}.task-summary-strip text{padding:7rpx 11rpx;border:1rpx solid var(--border);border-radius:12rpx;font-size:21rpx}.task-summary-strip .summary-normal{background:var(--primary-soft);border-color:rgba(0,174,189,.20);color:#087b85}.task-summary-strip .summary-exception{background:var(--danger-soft);border-color:rgba(182,64,58,.20);color:var(--danger);font-weight:700}
.empty-card{padding:44rpx 10rpx;text-align:center;color:var(--text-secondary)}.empty-card>text{display:block;margin-bottom:8rpx;font-size:60rpx;color:var(--primary)}.empty-sub{margin-top:6rpx;font-size:21rpx}
.task-group{margin-top:18rpx;padding:15rpx;border:1rpx solid var(--border);border-radius:17rpx;background:var(--surface-muted)}.task-group-operation{border-color:rgba(0,174,189,.20)}.task-group-exception{border-color:rgba(182,64,58,.22)}.task-group-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:1rpx 2rpx 7rpx;font-size:23rpx;font-weight:700}.task-group-head>view{display:flex;align-items:center;gap:7rpx}.task-group-head>text{color:var(--text-secondary);font-size:20rpx;font-weight:500}.task-group-operation .task-group-head>view{color:#087b85}.task-group-exception .task-group-head>view{color:var(--danger)}
.task-card{margin-top:12rpx;padding:19rpx;border:1rpx solid var(--border);border-radius:16rpx;background:var(--surface)}.tone-danger{background:var(--danger-soft);border-color:rgba(182,64,58,.22)}.tone-warning{background:var(--warning-soft);border-color:rgba(141,98,0,.22)}.tone-info{background:var(--info-soft);border-color:rgba(51,118,140,.20)}.task-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}.task-title-row{display:flex;align-items:center;gap:9rpx;flex-wrap:wrap}.task-title{font-size:27rpx;font-weight:700}.task-kind{padding:4rpx 9rpx;border-radius:10rpx;background:rgba(255,255,255,.55);font-size:19rpx}.task-kind.operation{color:#087b85}.task-kind.exception{color:var(--danger);font-weight:700}.task-source{margin-top:5rpx;color:var(--text-secondary);font-size:22rpx;overflow-wrap:anywhere}.priority{flex:none;padding:6rpx 9rpx;border-radius:11rpx;background:rgba(255,255,255,.55);font-size:22rpx;font-weight:700}.task-summary{margin-top:13rpx;font-size:23rpx;line-height:1.6;overflow-wrap:anywhere}.task-flags{display:flex;gap:10rpx;margin-top:12rpx}.task-flags text{padding:5rpx 9rpx;border-radius:10rpx;background:rgba(255,255,255,.52);font-size:22rpx}.attention-note{margin-top:13rpx;padding:12rpx;border-radius:11rpx;background:rgba(255,255,255,.5);font-size:22rpx;line-height:1.5}.task-actions{display:flex;flex-wrap:wrap;gap:11rpx;margin-top:16rpx}
.action-button,.primary-button,.secondary-button,.mini-button,.operation-button{min-height:88rpx;margin:0!important;border-radius:15rpx!important;font-size:23rpx!important}.action-button:after,.primary-button:after,.secondary-button:after,.mini-button:after,.operation-button:after{border:0!important}.action-button{padding:0 20rpx!important}.action-primary,.primary-button{background:var(--primary)!important;color:#fff!important}.action-warning{background:var(--warning-soft)!important;color:var(--warning)!important;border:1rpx solid rgba(141,98,0,.25)!important}.action-danger{background:var(--danger)!important;color:#fff!important}.action-neutral,.secondary-button{background:var(--surface-muted)!important;color:var(--text)!important;border:1rpx solid var(--border)!important}.mini-button{min-height:88rpx!important;padding:0 18rpx!important;background:var(--primary-soft)!important;color:#007f8a!important}
.operation-section{border-color:rgba(0,174,189,.22)}.operation-actions{display:grid;grid-template-columns:1fr 1fr;gap:11rpx;margin-top:17rpx}.operation-button{width:100%!important;background:var(--surface-muted)!important;color:var(--text)!important;border:1rpx solid var(--border)!important}.operation-button.primary{background:var(--primary-soft)!important;color:#007d89!important;border-color:rgba(0,174,189,.25)!important;font-weight:700}.operation-button.compact{min-height:76rpx!important;margin-top:13rpx!important}.operation-note{margin-top:13rpx;color:var(--text-secondary);font-size:21rpx;line-height:1.55}
.pricing-pending-note{margin-top:12rpx;padding:13rpx 15rpx;border-radius:12rpx;background:var(--primary-soft);color:#087b85;font-size:22rpx;line-height:1.55}
.kv-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:16rpx}.kv-grid>view{min-width:0;padding:14rpx;border-radius:13rpx;background:var(--surface-muted);border:1rpx solid var(--border)}.kv-grid text{display:block;overflow-wrap:anywhere}.kv-grid text:first-child{color:var(--text-secondary);font-size:22rpx}.kv-grid text:last-child{margin-top:5rpx;font-size:23rpx}.kv-grid .wide{grid-column:1/-1}
.person-row,.record-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:15rpx;padding:15rpx;border-radius:13rpx;background:var(--surface-muted);border:1rpx solid var(--border)}.person-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:9rpx}.person-name,.record-title{font-size:24rpx;font-weight:700}.person-sub,.record-sub{margin-top:5rpx;color:var(--text-secondary);font-size:22rpx;line-height:1.5;overflow-wrap:anywhere}.money{flex:none;font-size:26rpx;font-weight:700;color:var(--primary)}
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:15rpx}.gallery image{width:100%;height:180rpx;border-radius:12rpx;background:var(--surface-muted)}
.issue-box{margin-top:14rpx;padding:16rpx;border-radius:13rpx;background:var(--surface-muted);border:1rpx solid var(--border)}.danger-text{margin-top:8rpx;color:var(--danger);font-size:22rpx;line-height:1.45}
.timeline-row{position:relative;display:flex;gap:13rpx;padding:15rpx 0;border-bottom:1rpx solid var(--border)}.timeline-row:last-child{border-bottom:0}.timeline-dot{width:14rpx;height:14rpx;flex:none;margin-top:8rpx;border-radius:50%;background:var(--primary)}
.mask{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;padding:32rpx;background:rgba(11,22,24,.62)}.modal{width:100%;max-height:88vh;overflow-y:auto;padding:28rpx;padding-bottom:calc(28rpx + constant(safe-area-inset-bottom));padding-bottom:calc(28rpx + env(safe-area-inset-bottom));border-radius:22rpx;background:var(--surface);color:var(--text)}.modal-title{font-size:31rpx;font-weight:700}.modal-subtitle{margin-top:5rpx;color:var(--text-secondary);font-size:22rpx}.field{margin-top:19rpx}.field-label{display:block;margin-bottom:8rpx;font-size:23rpx;font-weight:600}.field input,.field textarea{width:100%;box-sizing:border-box;padding:16rpx;border:1rpx solid var(--border);border-radius:13rpx;background:var(--surface-muted);color:var(--text);font-size:24rpx}.field input{height:76rpx}.field textarea{height:165rpx}.switch-row,.picker-row{display:flex;align-items:center;justify-content:space-between;margin-top:17rpx;padding:16rpx;border-radius:13rpx;background:var(--surface-muted);border:1rpx solid var(--border);font-size:23rpx}.modal-actions{display:flex;gap:13rpx;margin-top:22rpx}.modal-actions button{flex:1;margin:0!important}
@media (max-width:360px){.operation-actions{grid-template-columns:1fr}.kv-grid{grid-template-columns:1fr}.kv-grid .wide{grid-column:auto}}
@media (prefers-color-scheme:dark){
  page{background:#101718!important}
  .detail-page{--page-bg:#101718;--surface:#192629;--surface-muted:#162225;--text:#e7f0f1;--text-secondary:#a7b9bc;--border:#2d4145;--primary:#00aebd;--primary-soft:#12383d;--danger:#ffaaa4;--danger-soft:#402522;--warning:#f0c86a;--warning-soft:#3a3019;--info:#9bd8eb;--info-soft:#17323a}
  .detail-hero{background:linear-gradient(145deg,#075c64,#073f45);box-shadow:none}.priority,.task-flags text,.attention-note,.task-kind{background:rgba(10,22,24,.28)}.action-primary,.primary-button{color:#061d20!important}.pricing-pending-note,.task-summary-strip .summary-normal,.task-group-operation .task-group-head>view{color:#7bd7de}.operation-button.primary{color:#80e7ee!important}.task-group{background:#142023}
}
.admin-placeholder{color:var(--text-secondary);opacity:.78}

.detail-page .action-button,.detail-page .primary-button,.detail-page .secondary-button,.detail-page .mini-button,.detail-page .operation-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;line-height:1.45;text-align:center;white-space:normal;padding-top:18rpx!important;padding-bottom:18rpx!important}
.detail-page .person-row>view:first-child{min-width:0;flex:1}
.detail-page .person-actions{flex-shrink:0}
@media (max-width:360px){
  .detail-page .person-row{flex-wrap:wrap}
  .detail-page .person-actions{width:100%}
}
@media (prefers-color-scheme:dark){
  .detail-page .mini-button{color:#80e7ee!important}
  .detail-page .action-danger{color:#3b1613!important}
}
.person-row{flex-direction:column;align-items:stretch}.person-row>view{min-width:0;width:100%}.person-name,.person-sub{white-space:normal;word-break:normal;overflow-wrap:break-word}.person-actions{width:100%;justify-content:flex-start}.person-actions .mini-button{flex:none;white-space:nowrap}
