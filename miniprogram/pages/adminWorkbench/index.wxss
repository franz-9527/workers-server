@import "../../style/order-modal.wxss";
@import "./creationTheme.wxss";
page{background:#f6f7f4!important}
.admin-page{
  --page-bg:#f6f7f4;--surface:#fff;--surface-muted:#f8faf8;--text:#26373a;--text-secondary:#6f7f82;
  --border:#e3e9e8;--primary:#00aebd;--primary-soft:#e8f8fa;--warning:#9a6400;--warning-soft:#fff5d8;
  --danger:#b43e39;--danger-soft:#fff0ee;--info:#39758b;--info-soft:#edf7fb;
  min-height:100vh;padding-bottom:70rpx;padding-bottom:calc(70rpx + constant(safe-area-inset-bottom));padding-bottom:calc(70rpx + env(safe-area-inset-bottom));background:var(--page-bg);color:var(--text)
}
.hero{position:relative;padding:0 26rpx 24rpx;overflow:hidden;background:linear-gradient(145deg,#ffe48d 0%,#f4c344 58%,#e9aa1c 100%);color:#493500;box-shadow:0 12rpx 34rpx rgba(120,84,10,.14)}
.hero:after{content:"";position:absolute;right:-86rpx;top:50rpx;width:300rpx;height:300rpx;border-radius:50%;background:rgba(255,255,255,.16);pointer-events:none}.hero-title,.stats{position:relative;z-index:1}
.hero-title{position:relative;z-index:1;padding:8rpx 2rpx 0}.hero-heading{font-size:34rpx;font-weight:750;white-space:nowrap;line-height:1.3}.hero-subtitle{margin-top:4rpx;font-size:22rpx;line-height:1.45;opacity:.8}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9rpx;margin-top:22rpx}.stat{min-width:0;padding:12rpx 4rpx;text-align:center;border:1rpx solid rgba(91,61,0,.10);border-radius:16rpx;background:rgba(255,255,255,.40);backdrop-filter:blur(8px)}
.stat text{display:block;font-size:22rpx}.stat-value{font-size:34rpx!important;font-weight:750;line-height:1.1;margin-bottom:5rpx}
.hero-title-copy{min-width:0}.hero-title-line{display:flex;align-items:center;justify-content:space-between;gap:12rpx;white-space:nowrap}.hero-name{display:flex;align-items:center;flex:none;gap:10rpx;min-width:0;white-space:nowrap}.hero-env-tag{display:inline-flex;align-items:center;flex:none;padding:4rpx 8rpx;border:1rpx solid rgba(100,72,5,.25);border-radius:8rpx;background:rgba(255,255,255,.43);color:#634400;font-size:20rpx;font-weight:700;line-height:1.2;white-space:nowrap}.hero-tool-group{display:flex;align-items:center;flex:none;gap:10rpx}.hero-tool{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:56rpx;height:56rpx;border-radius:13rpx;border:1rpx solid rgba(73,53,0,.16);background:rgba(255,255,255,.28);font-size:29rpx;color:inherit}.hero-tool.is-active{background:rgba(255,255,255,.53);border-color:rgba(116,72,0,.38)}.hero-tool-badge{position:absolute;right:-5rpx;top:-7rpx;display:flex;align-items:center;justify-content:center;min-width:23rpx;height:23rpx;padding:0 2rpx;border-radius:12rpx;background:#9b5100;color:#fff;font-size:15rpx;font-weight:700;line-height:1}

.demo-picker-mask{z-index:81}.demo-picker-modal{max-width:660rpx}.demo-role-list{display:grid;gap:11rpx;margin-top:22rpx}.demo-role-option{display:flex;align-items:center;gap:14rpx;padding:17rpx 16rpx;border:1rpx solid var(--border);border-radius:16rpx;background:var(--surface-muted)}.demo-role-option.selected{border-color:var(--primary);background:var(--primary-soft)}.demo-role-option.disabled{opacity:.42}.demo-role-icon{display:flex;align-items:center;justify-content:center;flex:none;width:54rpx;height:54rpx;border-radius:15rpx;background:var(--surface);color:var(--primary);font-size:27rpx}.demo-role-icon.real{color:#b67a00}.demo-role-copy{min-width:0;flex:1}.demo-role-name{font-size:24rpx;font-weight:700}.demo-role-desc{margin-top:3rpx;color:var(--text-secondary);font-size:19rpx;line-height:1.4}.demo-role-check{flex:none;color:var(--text-secondary);font-size:28rpx}.demo-role-option.selected .demo-role-check{color:var(--primary)}.demo-picker-version{margin-top:16rpx;color:var(--text-secondary);font-size:19rpx;text-align:center}
.demo-workbench-hint{display:flex;align-items:center;gap:13rpx;margin:17rpx 22rpx;padding:20rpx;border:1rpx solid var(--border);border-radius:16rpx;background:var(--surface);color:var(--text-secondary);font-size:23rpx;line-height:1.5}.demo-workbench-hint>view{min-width:0;flex:1}.demo-workbench-hint>.cuIcon-infofill{flex:none;font-size:27rpx;color:var(--warning)}.demo-workbench-hint>.cuIcon-right{flex:none;font-size:23rpx;color:var(--primary)}
.modal-note{margin-top:17rpx;padding:13rpx 15rpx;background:var(--surface-muted);border:1rpx solid var(--border);border-radius:13rpx;color:var(--text-secondary);font-size:21rpx;line-height:1.5}.modal-note.warning{background:var(--warning-soft);border-color:var(--warning);color:var(--warning)}
.workbench-nav{position:relative;z-index:3;display:block;padding:12rpx 20rpx;background:var(--surface);border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border)}
.tab-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4rpx;width:100%;min-width:0}.tab{box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-width:0;height:76rpx;padding:0 4rpx;border-radius:24rpx;color:var(--text-secondary);font-size:24rpx;font-weight:600;line-height:1.3;text-align:center;white-space:nowrap}.tab.active{background:var(--primary-soft);color:#007d89}.tab-pending{justify-content:space-between;padding:0 4rpx 0 7rpx}.tab-pending-label{display:flex;flex:1;align-items:center;justify-content:center;min-width:0;height:100%;font:inherit;white-space:nowrap}.tab-pending-filter{position:relative;display:flex;align-items:center;justify-content:center;flex:none;box-sizing:border-box;width:62rpx;height:66rpx;border-radius:18rpx;color:var(--text-secondary);font-size:25rpx;font-weight:400}.tab-pending-filter.is-filtered,.tab-pending-filter.is-open{color:var(--primary);background:var(--surface)}.tab-filter-dot{position:absolute;top:9rpx;right:8rpx;width:10rpx;height:10rpx;border-radius:50%;background:var(--primary)}
.task-filter-dismiss{position:fixed;inset:0;z-index:20;background:transparent}.task-filter-menu{position:absolute;top:calc(100% + 4rpx);left:18rpx;z-index:21;width:320rpx;max-width:calc(100vw - 36rpx);padding:8rpx;border:1rpx solid var(--border);border-radius:18rpx;background:var(--surface);box-shadow:0 14rpx 35rpx rgba(24,43,47,.16)}
.task-filter-option{display:flex;align-items:center;gap:10rpx;padding:18rpx 15rpx;border-radius:12rpx;color:var(--text);font-size:23rpx}.task-filter-option.selected{background:var(--primary-soft);color:#007d89;font-weight:700}.task-filter-option .task-filter-count{margin-left:auto;color:var(--text-secondary);font-size:20rpx}.task-filter-option .cuIcon-round,.task-filter-option .cuIcon-roundcheckfill{font-size:23rpx;color:var(--primary)}
.scope-chip-row{display:flex;padding:16rpx 22rpx 0}.scope-chip{display:inline-flex;align-items:center;gap:10rpx;padding:9rpx 14rpx;border:1rpx solid var(--primary);border-radius:24rpx;background:var(--primary-soft);color:#007d89;font-size:22rpx}.scope-chip .cuIcon-close{font-size:22rpx}
.workbench-search{display:flex;align-items:center;gap:13rpx;margin:18rpx 22rpx 0;padding:0 18rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:16rpx}.workbench-search>text:first-child{color:var(--text-secondary)}
.workbench-search input{height:78rpx;min-width:0;flex:1;color:var(--text);font-size:25rpx}.search-clear{color:var(--primary);font-size:23rpx}
.queue-note{display:flex;align-items:flex-start;gap:9rpx;margin:11rpx 22rpx 0;padding:11rpx 14rpx;border-radius:13rpx;background:var(--info-soft);color:var(--text-secondary);font-size:21rpx;line-height:1.45}.queue-note>.cuIcon-infofill{color:var(--primary);margin-top:3rpx}

.orders{padding:20rpx 22rpx}.order-card{margin-bottom:18rpx;padding:24rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:20rpx;box-shadow:0 7rpx 24rpx rgba(39,66,70,.06)}.order-card.has-exception{border-color:rgba(180,62,57,.28)}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.order-title{min-width:0;flex:1;font-size:30rpx;font-weight:700;overflow-wrap:anywhere}.weak-tag{flex:none;padding:6rpx 11rpx;border-radius:13rpx;background:var(--surface-muted);border:1rpx solid var(--border);font-size:22rpx;color:var(--text-secondary)}
.order-no{margin-top:8rpx;color:var(--text-secondary);font-size:22rpx;overflow-wrap:anywhere}.card-meta{display:flex;flex-wrap:wrap;gap:9rpx 14rpx;margin-top:14rpx;color:var(--text-secondary);font-size:22rpx}.card-meta text:not(:last-child):after{content:" · "}
.phase-box{display:flex;align-items:flex-start;justify-content:space-between;gap:15rpx;margin-top:18rpx;padding:17rpx;border-radius:15rpx;background:var(--surface-muted);border:1rpx solid var(--border)}.phase-copy{min-width:0;flex:1}.phase-main{font-size:26rpx;font-weight:700}.phase-sub{margin-top:5rpx;color:var(--text-secondary);font-size:22rpx;line-height:1.45}.card-task-summary{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:10rpx}.summary-pill{padding:4rpx 9rpx;border-radius:10rpx;font-size:19rpx}.summary-pill.operation{background:var(--primary-soft);color:#087680}.summary-pill.exception{background:var(--danger-soft);color:var(--danger);font-weight:700}
.priority{flex:none;min-width:54rpx;padding:7rpx 10rpx;text-align:center;border-radius:13rpx;font-size:22rpx;font-weight:700}.priority-P0{background:var(--danger-soft);color:var(--danger)}.priority-P1{background:var(--warning-soft);color:var(--warning)}.priority-P2{background:var(--info-soft);color:var(--info)}
.task-list{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.task-chip{display:flex;align-items:center;gap:8rpx;padding:9rpx 12rpx;border-radius:14rpx;font-size:22rpx;border:1rpx solid var(--border)}.tone-danger{background:var(--danger-soft);color:var(--danger)}.tone-warning{background:var(--warning-soft);color:var(--warning)}.tone-info{background:var(--info-soft);color:var(--info)}.task-mode{font-size:22rpx;opacity:.75}.task-kind{padding:2rpx 7rpx;border-radius:9rpx;font-size:18rpx;background:rgba(255,255,255,.55)}.task-kind.exception{font-weight:700}.task-kind.operation{color:#087680}.task-more{display:flex;align-items:center;padding:9rpx 12rpx;border:1rpx dashed var(--border);border-radius:14rpx;color:var(--text-secondary);font-size:21rpx}
.primary-button,.secondary-button,.load-more{min-height:88rpx;border-radius:16rpx!important;font-size:25rpx!important}.primary-button{width:100%;margin:20rpx 0 0!important;background:var(--primary)!important;color:#fff!important;font-weight:700}.primary-button:after,.secondary-button:after,.load-more:after{border:0!important}.secondary-button{background:var(--surface-muted)!important;color:var(--text)!important;border:1rpx solid var(--border)!important}
.task-badge{padding:7rpx 11rpx;border-radius:13rpx;font-size:22rpx}.empty,.loading{text-align:center;padding:110rpx 24rpx;color:var(--text-secondary)}.empty>text{display:block;margin-bottom:12rpx;font-size:72rpx;color:var(--primary)}.spin{display:inline-block;margin-right:8rpx;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.load-more{width:calc(100% - 44rpx);margin:0 22rpx 26rpx!important;background:var(--surface)!important;color:var(--primary)!important;border:1rpx solid var(--border)!important}
.mask{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;padding:34rpx;background:rgba(15,25,27,.58)}.modal{width:100%;max-height:86vh;overflow-y:auto;padding:28rpx;padding-bottom:calc(28rpx + constant(safe-area-inset-bottom));padding-bottom:calc(28rpx + env(safe-area-inset-bottom));border-radius:22rpx;background:var(--surface);color:var(--text)}.modal-title{font-size:31rpx;font-weight:700}.modal-subtitle{margin-top:6rpx;color:var(--text-secondary);font-size:22rpx}
.decision-options{display:grid;gap:12rpx;margin-top:22rpx}.decision-options label{display:flex;align-items:center;gap:10rpx;padding:18rpx;border-radius:14rpx;background:var(--surface-muted);border:1rpx solid var(--border);font-size:25rpx}.field{margin-top:20rpx}.field-label{display:block;margin-bottom:9rpx;font-size:24rpx;font-weight:600}.field textarea{width:100%;height:160rpx;box-sizing:border-box;padding:17rpx;border:1rpx solid var(--border);border-radius:14rpx;background:var(--surface-muted);color:var(--text);font-size:24rpx}.modal-actions{display:flex;gap:14rpx;margin-top:22rpx}.modal-actions button{flex:1;margin:0!important}.modal-primary{margin:0!important}
@media (prefers-color-scheme:dark){
  page{background:#101718!important}
  .admin-page{--page-bg:#101718;--surface:#192629;--surface-muted:#162225;--text:#e7f0f1;--text-secondary:#a7b9bc;--border:#2d4145;--primary:#00aebd;--primary-soft:#12383d;--warning:#f0c86a;--warning-soft:#3a3019;--danger:#ffaaa4;--danger-soft:#402522;--info:#9bd8eb;--info-soft:#17323a}
  .hero{background:linear-gradient(145deg,#65501d,#493a18);color:#ffe8a4;box-shadow:none}.tab.active{color:#80e7ee}.primary-button{color:#061d20!important}.task-kind{background:rgba(0,0,0,.16)}.task-kind.operation,.summary-pill.operation{color:#80e7ee}
}
.admin-placeholder{color:var(--text-secondary);opacity:.78}
.create-order-quick{box-sizing:border-box;display:flex;align-items:center;gap:12rpx;width:calc(100% - 44rpx);min-height:76rpx;margin:14rpx 22rpx!important;padding:12rpx 18rpx;border:1rpx solid var(--border);border-radius:16rpx;background:var(--surface);color:var(--text);line-height:1.35;text-align:left;box-shadow:0 4rpx 14rpx rgba(30,60,63,.035)}.create-order-quick::after{border:0}.create-order-quick .cuIcon-roundaddfill{flex:none;font-size:32rpx;color:var(--primary)}.create-order-main{flex:none;font-size:25rpx;font-weight:700;white-space:nowrap}.create-order-desc{min-width:0;flex:1;color:var(--text-secondary);font-size:21rpx;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.create-order-quick .cuIcon-right{flex:none;font-size:23rpx;color:var(--text-secondary)}.create-order-quick[disabled]{opacity:.52}

.workbench-error{display:flex;align-items:center;gap:12rpx;margin:14rpx 22rpx;padding:13rpx 15rpx;border-radius:14rpx;color:var(--danger);background:var(--danger-soft);font-size:23rpx;line-height:1.5}.workbench-error>text{min-width:0;flex:1;overflow-wrap:anywhere}.workbench-error button{flex:none;margin:0;padding:7rpx 13rpx;min-height:58rpx;background:var(--surface);border-radius:12rpx;color:var(--text);font-size:22rpx;line-height:1.7}.workbench-error button::after{border:0}

.admin-page .primary-button,.admin-page .secondary-button,.admin-page .load-more{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;padding:18rpx 20rpx;line-height:1.45;text-align:center;white-space:normal}
@media (prefers-color-scheme:dark){.admin-page .scope-chip,.admin-page .task-filter-option.selected{color:#80e7ee}.admin-page .tab-pending-filter.is-filtered,.admin-page .tab-pending-filter.is-open{color:#80e7ee}.hero-env-tag{background:rgba(255,231,164,.16);border-color:rgba(255,231,164,.30);color:#ffe6a0}.hero-tool{background:rgba(255,255,255,.10);border-color:rgba(255,232,164,.25)}.hero-tool.is-active{background:rgba(255,232,164,.20)}.hero-tool-badge{background:#a86806;color:#fff}}

@media (max-width:350px){.hero{padding-left:18rpx;padding-right:18rpx}.hero-name{gap:6rpx}.hero-title-line{gap:6rpx}.hero-heading{font-size:30rpx}.hero-env-tag{font-size:18rpx;padding:4rpx 6rpx}.hero-tool-group{gap:6rpx}.hero-tool{width:50rpx;height:50rpx;font-size:26rpx}.create-order-desc{font-size:19rpx}}
