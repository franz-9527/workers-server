<add-tip text="添加到我的小程序、桌面" duration="5" />

<view id="home" class="home">
  <view style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
    <view class="location" bindtap="chooseLocation">
      <text class="cuIcon-location"></text>
      <text class="text-black">{{location.city || '选择城市'}}</text>
    </view>
  </view>
  <swiper class="card-swiper square-dot" indicator-dots="true" circular="true" autoplay="true" interval="5000" duration="500" bindchange="cardSwiper" indicator-color="#8799a3" indicator-active-color="#0081ff">
    <swiper-item wx:for="{{banner}}" wx:key="index" class="{{cardCur==index?'cur':''}}">
      <view class="swiper-item" bindtap="tapBanner" data-index="{{index}}">
        <image src="{{item.url}}" mode="aspectFill"></image>
      </view>
    </swiper-item>
  </swiper>



<!-- 滚动条：平台协议作为固定公告并入原公告轮播，不再额外占用首页卡片空间。 -->
<swiper class="tips-swiperitem" autoplay="true" vertical="true" circular="true" interval="2000" duration="1000">
  <swiper-item catchtouchmove="false">
    <navigator url="/subpackages/support/agreements/index" hover-class="none">
      <view class="radius-lg bg-orange light">
        <view class="padding-xs text-xl">
          <text class="cuIcon-safe text-orange"></text>
          <text class="text-df"> 平台协议与规则</text>
        </view>
      </view>
    </navigator>
  </swiper-item>
  <block wx:for="{{Headtips}}" wx:key="index">
    <swiper-item catchtouchmove='false' bindtap="tipsClick" data-index="{{index}}">
      <view class="radius-lg bg-orange light" src="{{item.url}}">
        <view class='padding-xs text-xl'>
          <text class='cuIcon-magic text-orange'></text>
          <text class="text-df"> {{item.title}}</text>
        </view>
      </view>
    </swiper-item>
  </block>
</swiper>

<view class="plate-section bg-white">
  <scroll-view class="plate" scroll-x="true" show-scrollbar="false" bindscroll="onNavScroll">
    <view class="plate-track">
      <view wx:for="{{iconList}}" wx:key="id" class="plate-item" bindtap="handleItemClick" data-index="{{index}}">
        <view class="plate-img">
          <image src="{{item.img}}" mode="aspectFit"></image>
        </view>
        <text class="plate-info">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{navCanScroll && !navAtEnd}}" class="plate-edge-fade"></view>
</view>





<!-- 最近师傅 -->
  <view class="cu-bar bg-white solid-bottom">
    <view class="action">
      <!-- <text class="cuIcon-titles text-green"></text> -->
      <text class="cuIcon-titles text-red"></text>
      <text class="text-lg text-bold"> 附近师傅</text>
    </view>
  </view>

  <!-- 定位城市 -->
  <!-- <view style="background-color:#fff;padding:30rpx 25rpx 25rpx 25rpx;"> -->
  <view class="cu-bar bg-white fake">
    <view class="fakeSearchWrapper">
      <view class="fakeSearch" bindtap="chooseLocation">
        <text>地图搜索</text>
      </view>
      <navigator class="fakeSearch" url="/subpackages/discovery/search/index">
        <text>文字搜索</text>
      </navigator>
    </view>
  </view>

  <view class="cu-list menu-avatar bg-white">
    <view class="cu-item solid-bottom" bindtap="goDetail" data-id="{{item._id}}" wx:for="{{lastRecord}}" wx:key="index">
      <view class="cu-avatar round lg" style="background-image:url({{item.image}});"></view>
      <view class="content">
        <!-- <view class="text-grey">【{{item.location.name}}】</view> -->
        <view class="text-grey text-cut">【{{item.workerName}}】{{item.location.district}}{{item.location.name}}</view>
        <view class="text-gray text-sm flex">
          <text class="text-cut">
							<text class="cuIcon-notification text-gray margin-right-xs"></text>{{item.workerType}}
          </text>
        </view>
      </view>
      <view class="action">
        <view class="text-grey text-xs">{{item.time}}</view>
        <view class="cu-tag round bg-grey sm"><text class="cuIcon-location"></text>{{item.distance}}</view>
      </view>
    </view>
  </view>


<!-- 地图展示 -->
  <view class="cu-bar bg-white solid-bottom">
    <view class="action" >
      <text class="cuIcon-titles text-blue"></text>
      <text class="text-lg text-bold"> 师傅地图</text>
      <!-- 添加地图拖动控制开关 -->
      <switch class="margin-lr-xs" checked="{{enableMapDrag}}" bindchange="toggleMapDrag"></switch>
      <text class="text-sm text-grey">允许拖动地图</text>
    </view>
    <!-- 筛选技能 -->
    <view class="action">
      <picker mode="selector" range="{{skillOptions}}" bindchange="skillChange" value="{{currentSkillIndex}}">
        <view class="cuIcon-filter">
          <text class="text-bold margin-left-xs">{{skillOptions[currentSkillIndex]}}</text>
          <text class="cuIcon-triangledownfill"></text>
        </view>
      </picker>
		</view>
  </view>


  <!-- joinCluster="true" 点聚合开发未成功-->
  <!-- app.wxss开启深色模式 layer-style：1深色2经典-->
  <map
    id="homeMap"
    style="width: 100%; height:800rpx"
    latitude="{{location.latitude}}"
    longitude="{{location.longitude}}"
    scale="12"
    markers="{{markers}}"
    bindmarkertap="tapMarker"
    bindcallouttap="tapMarker"
    enable-zoom="true"
    show-scale="true"
    show-location="{{showUserLocation}}"
    enable-scroll="{{enableMapDrag}}"
    bindregionchange="mapRegionChange"
    subkey="32CBZ-FEPK6-POMSA-MCDE2-M2MIK-ZOBK2"
  > 
    <view class="controls">
      <view class="controlsBtn" bindtap="getLocation">
        <image class="img" src="/images/maplocation.png" />
      </view>
    </view>
  </map>
</view>


<!-- 客服+电话 -->
