</view>

<view class="weui-footer">
	<view class="text-gray">Powered By 壁选 © 2013-现在 </view>
</view>

<!-- 流程指引 -->
<view class="">
  <image  class="test_image" mode='widthFix' src="https://776f-worker-real-1301382302.tcb.qcloud.la/public/banner/serve2.png"> </image>
</view>

 <!-- 自定义tab遮挡解决 -->
