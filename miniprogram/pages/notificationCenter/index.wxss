page{background:#f5f7f8;color:#263a3b}
.notice-page{min-height:100vh;box-sizing:border-box}.notice-content-wrap{padding:16rpx 24rpx 60rpx}
.notice-tools{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:24rpx}
.notice-tabs{display:flex;align-items:center;gap:30rpx}.notice-tab{display:flex;align-items:center;gap:10rpx;min-height:72rpx;box-sizing:border-box;font-size:28rpx;color:#899796;border-bottom:4rpx solid transparent}.notice-tab.active{color:#14847d;font-weight:600;border-bottom-color:#14847d}
.count{padding:2rpx 9rpx;border-radius:20rpx;background:#e5eeec;color:#53726a;font-size:20rpx;line-height:1.4}
.settings-button{display:flex;flex:none;align-items:center;justify-content:center;width:68rpx;min-height:68rpx;height:auto;margin:0;padding:0;background:transparent;color:#718681;font-size:34rpx;line-height:1.4;border:0}.settings-button::after{border:0}
.todo-card,.notice-card{display:flex;align-items:flex-start;gap:18rpx;margin-bottom:16rpx;padding:24rpx 20rpx;background:#fff;border:1rpx solid #e8edeb;border-radius:20rpx}
.message-icon{position:relative;display:flex;flex:none;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:18rpx;background:#eaf2f0;color:#4e857a;font-size:32rpx}.message-icon.money{background:#edf5e9;color:#6b9456}.message-icon.worker{background:#fff2df;color:#b18136}.message-icon.after-sale{background:#fff0eb;color:#be7863}
.message-body{flex:1;min-width:0}.message-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.message-title{flex:1;min-width:0;font-size:27rpx;line-height:1.5;font-weight:600;overflow-wrap:anywhere;word-break:break-all}.notice-time,.role-label{flex:none;color:#8b9a96;font-size:21rpx;line-height:1.7}.notice-time{white-space:nowrap}
.message-copy{margin-top:8rpx;color:#657b75;font-size:24rpx;line-height:1.65;overflow-wrap:anywhere;word-break:break-all;white-space:pre-wrap}
.message-detail{margin-top:6rpx;font-size:22rpx;color:#8b9a96;line-height:1.6;overflow-wrap:anywhere}
.todo-action{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #eef2f0;font-size:22rpx;line-height:1.6;color:#14847d}
.notice-meta{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx;margin-top:12rpx}.pending-label{font-size:20rpx;color:#aa762c}.thread-toggle{margin-left:auto;font-size:22rpx;color:#14847d;line-height:1.6}
.order-link{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #eef2f0;color:#14847d;font-size:22rpx;line-height:1.6}.order-no{color:#91a19a;font-size:20rpx;overflow-wrap:anywhere;flex:1;min-width:0}
.unread-dot{position:absolute;right:-2rpx;top:-2rpx;width:13rpx;height:13rpx;border-radius:50%;background:#db6f57;border:3rpx solid #fff}
.thread-timeline{margin-top:18rpx;padding-left:20rpx;border-left:2rpx solid #dce9e3}.timeline-item+.timeline-item{margin-top:22rpx}.timeline-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx;font-size:23rpx;line-height:1.6;color:#64776f}
.date-group{margin:28rpx 8rpx 14rpx;font-size:22rpx;color:#94a29c}.notice-footer,.notice-refresh{padding:22rpx 12rpx;text-align:center;font-size:22rpx;line-height:1.7;color:#9aa8a1}.notice-refresh{color:#548a7c}
.notice-empty{display:flex;flex-direction:column;align-items:center;gap:16rpx;padding:90rpx 36rpx;color:#8b9d93;font-size:24rpx;line-height:1.7;text-align:center}.empty-title{font-size:30rpx;color:#4f6d5f;font-weight:600}
.notice-button,.notice-actions button{box-sizing:border-box;width:auto;max-width:100%;min-height:64rpx;height:auto;margin:12rpx auto;padding:12rpx 22rpx;border:0;border-radius:12rpx;background:#e8f4ef;color:#23866b;font-size:24rpx;line-height:1.5}.notice-button::after,.notice-actions button::after{border:0}.notice-actions{display:flex;justify-content:flex-end}.notice-actions button{margin:0 0 10rpx;padding:8rpx 12rpx;background:transparent}
@media(prefers-color-scheme:dark){page{background:#111a17;color:#e2ece6}.notice-tab,.role-label,.notice-time,.date-group{color:#8ca298}.notice-tab.active{color:#8bd5bb;border-color:#8bd5bb}.count{background:#293d33;color:#a0c6af}.todo-card,.notice-card{background:#1b2922;border-color:#2c3d31}.message-title,.empty-title{color:#e2ece6}.message-copy,.timeline-heading{color:#adc0b2}.message-icon{background:#2d4137;color:#9abfaf}.message-icon.money{background:#31432e;color:#a9c694}.message-icon.worker{background:#463c28;color:#e1bc7c}.message-icon.after-sale{background:#48352d;color:#ddae98}.todo-action,.order-link,.thread-timeline{border-color:#354a3c}.todo-action,.thread-toggle,.order-link,.notice-refresh{color:#94cdb3}.notice-button,.notice-actions button{background:#293f33;color:#a3d4b6}.unread-dot{border-color:#1b2922}.pending-label{color:#dec28b}}
