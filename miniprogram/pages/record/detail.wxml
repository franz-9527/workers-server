  ></image>
  <image 
    src="../../images/phoneAuth.png" 
    class="img-phone-style" 
    bindtap="toggleAuth" 
    style="transform: translateX({{isAuthVisible ? '0' : '36%'}}); transition: transform 0.3s;" 
  ></image>
</view>
