<block wx:if="{{pageLoginReady}}">
<view class="worker-detail-tabs"><view class="worker-detail-tab {{activeDetailTab === 0 ? 'active' : ''}}" data-tab="0" bindtap="switchDetailTab">详情</view><view class="worker-detail-tab {{activeDetailTab === 1 ? 'active' : ''}}" data-tab="1" bindtap="switchDetailTab">评价<text wx:if="{{reviewSummary.review_count}}"> {{reviewSummary.review_count}}</text></view></view>
<view wx:if="{{activeDetailTab === 0}}" class="worker-detail-pane" bindtouchstart="detailTouchStart" bindtouchend="detailTouchEnd">
<!-- 审核结果：师傅本人始终可见；管理员仅查看真实师傅时显示，非真实/导入师傅不在顶部展示审核状态。 -->
<view wx:if="{{detail.reviewStatus && (detail.isMine==1 || (isOrderAdmin && detail.isRealWorker==1))}}" class="worker-review-card {{detail.reviewStatus}}">
  <view class="worker-review-title"><text class="cuIcon-infofill"></text>{{detail.reviewStatusText}}</view>
  <view wx:if="{{detail.reviewReason}}" class="worker-review-reason">处理说明：{{detail.reviewReason}}</view>
</view>
<view>
  <view class="cu-form-group">
    <view class="title">师傅昵称</view>
      <!-- <text user-select="true">{{detail.workerName}}</text>
  </view> -->
    <view class="flex align-center">
      <block wx:if="{{isEditing.workerName}}">
        <input 
          value="{{editForm.workerName}}" 
          data-field="workerName" 
          bindinput="inputChange"
          class="text-right margin-right-xs"
          style="min-width: 200rpx"
        />
        <view class="text-xxl margin-left-sm">
          <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="workerName"></text>
          <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="workerName"></text>
        </view>
      </block>
      <block wx:elif="{{isOrderAdmin}}">
        <text user-select="true" class="margin-right-sm">{{detail.workerName}}</text>
        <text class="cuIcon-edit text-blue" bindtap="editField" data-field="workerName"></text>
      </block>
      <block wx:else>
        <text user-select="true">{{detail.workerName}}</text>
        <text wx:if="{{detail.realNameVerified}}" class="server-realname-tag">已实名</text>
      </block>
    </view>
  </view>
  <view class="cu-form-group" wx:if="{{isOrderAdmin}}">
    <view class="title">资料编号</view>
    <view class="admin-record-identity">
      <text user-select="true">记录：{{id}}</text>
      <text wx:if="{{adminWorkerOpenid}}" user-select="true">_openid：{{adminWorkerOpenid}}</text>
      <text wx:elif="{{adminWorkerIdentityLoaded}}" class="text-grey">_openid：未获取</text>
      <text wx:else class="text-grey">_openid：加载中...</text>
    </view>
  </view>
  <view class="cu-form-group" wx:if="{{isOrderAdmin}}" bindtap="loadAdminSmsStats">
    <view class="title">短信推送</view>
    <view class="admin-sms-stat text-right">
      <text wx:if="{{adminSmsStatsLoading}}" class="text-grey">统计中...</text>
      <block wx:elif="{{adminSmsStats.loaded && adminSmsStats.mobile_available}}">
        <text class="admin-sms-stat__count {{adminSmsStats.reached_threshold ? 'is-limit' : ''}}">{{adminSmsStats.attempt_count}} 次</text>
        <text wx:if="{{adminSmsStats.reached_threshold}}" class="admin-sms-stat__hint">已达历史隐藏阈值</text>
      </block>
      <text wx:elif="{{adminSmsStats.loaded}}" class="text-grey">{{adminSmsStats.message || '暂无可统计数据'}}</text>
      <text wx:else class="text-grey">点击统计</text>
    </view>
  </view>
  <view class="cu-form-group">
    <!-- text-cut 截断文字 -->
    <view class="text-cut title">安装类型</view>
    <!-- <view class="">{{detail.workerType}}</view> -->
    <view class="flex align-center">
      <block wx:if="{{isEditing.workerType}}">
        <input 
          value="{{editForm.workerType}}" 
          data-field="workerType" 
          bindinput="inputChange"
          class="text-right margin-right-xs"
          style="min-width: 200rpx"
        />
        <view class="text-xxl margin-left-sm">
          <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="workerType"></text>
          <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="workerType"></text>
        </view>
      </block>
      <block wx:elif="{{isOrderAdmin}}">
        <view class="margin-right-sm">{{detail.workerType}}</view>
        <text class="cuIcon-edit text-blue" bindtap="editField" data-field="workerType"></text>
      </block>
      <block wx:else>
        <view>{{detail.workerType}}</view>
      </block>
    </view>
	</view>
  <view class="cu-form-group">
    <view class="title" bindtap="showMore">更多技能</view>
    <view class="cuIcon-info flex-twice margin-xs" bindtap="showMore"></view>
      <!-- 2025-4-11<view class="text-right content">
        <text class="{{detail.doEVA != null ? (detail.doEVA ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doEVA != null ? (detail.doEVA ? '✔' : '✘') : '？'}}热胶、</text>
        <text class="{{detail.doCurtain != null ? (detail.doCurtain ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doCurtain != null ? (detail.doCurtain ? '✔' : '✘') : '？'}}窗帘、</text>
        <text class="{{detail.dotArtpaint != null ? (detail.dotArtpaint ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.dotArtpaint != null ? (detail.dotArtpaint ? '✔' : '✘') : '？'}}艺术漆</text>
        <view>
        <text class="{{detail.doWallPaneling != null ? (detail.doWallPaneling ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doWallPaneling != null ? (detail.doWallPaneling ? '✔' : '✘') : '？'}}软硬包、</text>
        <text class="{{detail.doPaint != null ? (detail.doPaint ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doPaint != null ? (detail.doPaint ? '✔' : '✘') : '？'}}油漆、</text>
        <text class="{{detail.doFilm != null ? (detail.doFilm ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doFilm != null ? (detail.doFilm ? '✔' : '✘') : '？'}}玻璃膜</text>
      </view> -->
    <view class="flex align-center">
      <block wx:if="{{isEditing.skills}}">
        <view class="page-section page-section-gap">
          <checkbox-group bindchange="skillChange">
            <view class="flex justify-end">
              <label><checkbox class="round green margin-sm" value="doEVA" checked="{{editForm.skills.doEVA}}"></checkbox>会热胶</label>
              <label><checkbox class="round green margin-sm" value="doCurtain" checked="{{editForm.skills.doCurtain}}"></checkbox>窗帘</label>
              <label><checkbox class="round green margin-sm" value="doWallPaneling" checked="{{editForm.skills.doWallPaneling}}"></checkbox>软硬包</label>
            </view>
            <view class="flex justify-end">
              <label><checkbox class="round green margin-sm" value="dotArtpaint" checked="{{editForm.skills.dotArtpaint}}"></checkbox>艺术漆</label>
              <label><checkbox class="round green margin-sm" value="doPaint" checked="{{editForm.skills.doPaint}}"></checkbox>油漆</label>
              <label><checkbox class="round green margin-sm" value="doFilm" checked="{{editForm.skills.doFilm}}"></checkbox>玻璃膜</label>
            </view>
            <!-- 可以根据需要添加更多自定义技能 -->
          </checkbox-group>
          <view class="text-xxl margin-top-sm">
            <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="skills"></text>
            <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="skills"></text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="text-right content margin-right-sm" style="width: 100%">
          <!-- 兼容旧数据 -->
          <block wx:if="{{!detail.skills}}">
            <text class="{{detail.doEVA != null ? (detail.doEVA ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doEVA != null ? (detail.doEVA ? '✔' : '✘') : '？'}}热胶、</text>
            <text class="{{detail.doPaint != null ? (detail.doPaint ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doPaint != null ? (detail.doPaint ? '✔' : '✘') : '？'}}油漆、</text>
              <text class="{{detail.doFilm != null ? (detail.doFilm ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doFilm != null ? (detail.doFilm ? '✔' : '✘') : '？'}}玻璃膜</text>
            <view>
              <text class="{{detail.doWallPaneling != null ? (detail.doWallPaneling ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doWallPaneling != null ? (detail.doWallPaneling ? '✔' : '✘') : '？'}}软硬包、</text>
                <text class="{{detail.doCurtain != null ? (detail.doCurtain ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.doCurtain != null ? (detail.doCurtain ? '✔' : '✘') : '？'}}窗帘、</text>
                <text class="{{detail.dotArtpaint != null ? (detail.dotArtpaint ? 'text-green' : 'text-red') : 'text-grey'}}">{{detail.dotArtpaint != null ? (detail.dotArtpaint ? '✔' : '✘') : '？'}}艺术漆</text>
            </view>
          </block>
          <!-- 新数据：使用数组方式处理 -->
          <block wx:else>
            <text class="{{detail.skills.doEVA ? 'text-green' : 'text-red'}}">{{detail.skills.doEVA ? '✔' : '✘'}}热胶、</text>
            <text class="{{detail.skills.doPaint ? 'text-green' : 'text-red'}}">{{detail.skills.doPaint ? '✔' : '✘'}}油漆、</text>
            <text class="{{detail.skills.doFilm ? 'text-green' : 'text-red'}}">{{detail.skills.doFilm ? '✔' : '✘'}}玻璃膜</text>
            <view>
              <text class="{{detail.skills.doWallPaneling ? 'text-green' : 'text-red'}}">{{detail.skills.doWallPaneling ? '✔' : '✘'}}软硬包、</text>
              <text class="{{detail.skills.doCurtain ? 'text-green' : 'text-red'}}">{{detail.skills.doCurtain ? '✔' : '✘'}}窗帘、</text>
              <text class="{{detail.skills.dotArtpaint ? 'text-green' : 'text-red'}}">{{detail.skills.dotArtpaint ? '✔' : '✘'}}艺术漆</text>
            </view>
            <!-- 展示其他技能 -->
            <view wx:if="{{detail.skills && Object.keys(detail.skills).length > 6}}">
              <view class="text-green">其他技能：</view>
              <block wx:for="{{Object.keys(detail.skills)}}" wx:key="index">
                <text wx:if="{{item !== 'doEVA' && item !== 'doCurtain' && item !== 'dotArtpaint' && item !== 'doWallPaneling' && item !== 'doPaint' && item !== 'doFilm' && detail.skills[item]}}" class="text-green margin-right-xs">✔{{item}}</text>
              </block>
            </view>
          </block>
        </view>
        <text wx:if="{{isOrderAdmin}}" class="cuIcon-edit text-blue" bindtap="editField" data-field="skills"></text>
      </block>


    </view>
	</view>
  <view class="cu-form-group">
    <view class="title text-cut">地址信息</view>
    <view class="flex align-center flex-wrap justify-end">
      <!-- 城市区域 -->
      <block wx:if="{{isEditing.location_city}}">
        <view class="flex align-center margin-right-sm">
          <text class="text-grey text-sm margin-right-xs">城市:</text>
          <input 
            value="{{editForm.location_city}}" 
            data-field="location_city" 
            bindinput="inputChange"
            class="text-right"
            style="min-width: 120rpx"
            placeholder="城市"
          />
          <text class="margin-lr-xs">-</text>
          <input 
            value="{{editForm.location_district}}" 
            data-field="location_district" 
            bindinput="inputChange"
            class="text-right"
            style="min-width: 120rpx"
            placeholder="区域"
          />
          <view class="text-xxl margin-left-sm">
            <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="location_city"></text>
            <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="location_city"></text>
          </view>
        </view>
      </block>
      <block wx:elif="{{(detail.location.city || detail.location.district) && isOrderAdmin}}">
        <view class="flex align-center margin-right-sm">
          <text class="text-grey text-sm margin-right-xs">城市:</text>
          <view class="margin-right-xs">
            <block wx:if="{{detail.location.district != undefined}}">{{detail.location.city+detail.location.district}}</block>
            <block wx:elif="{{detail.location.city != undefined}}">{{detail.location.city}}</block>
            <block wx:else>未设置</block>
          </view>
          <text class="cuIcon-edit text-blue" bindtap="editField" data-field="location_city"></text>
        </view>
      </block>
      <block wx:elif="{{detail.location.city || detail.location.district}}">
        <view class="flex align-center margin-right-sm">
          <text class="text-grey text-sm margin-right-xs">城市:</text>
          <view>
            <block wx:if="{{detail.location.district != undefined}}">{{detail.location.city+detail.location.district}}</block>
            <block wx:elif="{{detail.location.city != undefined}}">{{detail.location.city}}</block>
          </view>
        </view>
      </block>

      <!-- 地址详情 -->
      <block wx:if="{{isEditing.address}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">定位:</text>
          <input 
            value="{{editForm.address}}" 
            data-field="address" 
            bindinput="inputChange"
            class="text-right"
            style="min-width: 200rpx"
          />
          <view class="text-xxl margin-left-sm">
            <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="address"></text>
            <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="address"></text>
          </view>
        </view>
      </block>
      <block wx:elif="{{isOrderAdmin}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">定位:</text>
          <view class="margin-right-xs" bindtap="showLocation"><text class="cuIcon-locationfill text-orange"></text>{{detail.location.name}}</view>
          <text class="cuIcon-edit text-blue" bindtap="editField" data-field="address"></text>
        </view>
      </block>
      <block wx:else>
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">定位:</text>
          <view bindtap="showLocation"><text class="cuIcon-locationfill text-orange"></text>{{detail.location.name}}</view>
        </view>
      </block>
    </view>
  </view>
  <view class="cu-form-group">
    <view class="text-cut title">上门费用</view>
    <view class="flex align-center flex-wrap justify-end">
      <!-- 小单起步 -->
      <block wx:if="{{isEditing.baseFeeAmount}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">起步价:</text>
          <input 
            value="{{editForm.baseFeeAmount}}" 
            data-field="baseFeeAmount" 
            bindinput="inputChange"
            class="text-right"
            style="min-width: 120rpx"
            placeholder="例如：100元"
          />
          <view class="text-xxl margin-left-sm">
            <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="baseFeeAmount"></text>
            <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="baseFeeAmount"></text>
          </view>
        </view>
      </block>
      <block wx:elif="{{detail.baseFeeAmount && isOrderAdmin}}">
        <view class="flex align-center margin-right-sm">
          <text class="text-grey text-sm margin-right-xs">起步价:</text>
          <text class="margin-right-xs">{{detail.baseFeeAmount}}元</text>
          <text class="cuIcon-edit text-blue" bindtap="editField" data-field="baseFeeAmount"></text>
        </view>
      </block>
      <block wx:elif="{{detail.baseFeeAmount}}">
        <view class="flex align-center margin-right-sm">
          <text class="text-grey text-sm margin-right-xs">起步价:</text>
          <text>{{detail.baseFeeAmount}}元</text>
        </view>
      </block>

      <!-- 测量费 -->
      <block wx:if="{{isEditing.paid}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">测量费:</text>
          <switch class="margin-lr" checked="{{editForm.paid}}" bindchange="switchChange" data-field="paid"></switch>
          <text class="margin-right-sm">{{editForm.paid ? '' : '免费'}}</text>
          <input 
            wx:if="{{editForm.paid}}"
            type="number"
            value="{{editForm.money}}" 
            data-field="money" 
            bindinput="inputChange"
            class="text-right margin-right-xs"
            style="min-width: 100rpx"
            placeholder="输入金额"
          />
          <text wx:if="{{editForm.paid}}">元</text>
          <view class="text-xxl margin-left-sm">
            <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="paid"></text>
            <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="paid"></text>
          </view>
        </view>
      </block>
      <block wx:elif="{{isOrderAdmin}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">测量费:</text>
          <text class="margin-right-sm">{{detail.paid ? detail.money+'元' : '免费'}}</text>
          <text class="cuIcon-edit text-blue" bindtap="editField" data-field="paid"></text>
        </view>
      </block>
      <block wx:else>
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">测量费:</text>
          <text>{{detail.paid ? detail.money+'元' : '免费'}}</text>
        </view>
      </block>
    </view>
  </view>
  
  <view class="cu-form-group" wx:if="{{detail.pay_small != undefined}}">
    <view class="text-cut title">起步价</view>
    <view>{{detail.pay_small+'元'}}</view>
  </view>
  <!-- 收费参考：历史有 pay_fixed 才允许继续编辑该字段；安装工费始终允许管理员补录/修改。 -->
  <view class="cu-form-group" wx:if="{{isOrderAdmin || detail.pay_fixed != undefined || detail.workerPaid}}">
    <view class="text-cut title">收费参考</view>
    <view class="flex align-center pricing-reference">
      <block wx:if="{{isEditing.pricing}}">
        <view class="pricing-reference__editor">
          <view wx:if="{{detail.pay_fixed != undefined}}" class="pricing-reference__row">
            <text class="text-grey text-sm">平台统一定价</text>
            <switch checked="{{editForm.pay_fixed}}" bindchange="switchChange" data-field="pay_fixed"></switch>
          </view>
          <view class="pricing-reference__row">
            <text class="text-grey text-sm">安装工费</text>
            <input value="{{editForm.workerPaid}}" data-field="workerPaid" bindinput="inputChange" class="pricing-reference__input" placeholder="请输入安装工费（可带单位）" />
          </view>
        </view>
        <view class="text-xxl margin-left-sm">
          <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="pricing"></text>
          <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="pricing"></text>
        </view>
      </block>
      <block wx:elif="{{isOrderAdmin}}">
        <view class="text-right content margin-right-sm">
          <navigator wx:if="{{detail.pay_fixed != undefined}}" class="{{detail.pay_fixed ? 'text-green' : 'text-grey'}}" url="/subpackages/web/h5/index?title=bbs50">
            {{detail.pay_fixed ? '✔ 平台统一定价' : '非平台统一定价'}}
          </navigator>
          <view class="{{detail.workerPaid ? '' : 'text-grey'}}">{{detail.workerPaid || '安装工费未填写'}}</view>
        </view>
        <text class="cuIcon-edit text-blue" bindtap="editField" data-field="pricing"></text>
      </block>
      <block wx:else>
        <view class="text-right content">
          <navigator wx:if="{{detail.pay_fixed != undefined}}" class="{{detail.pay_fixed ? 'text-green' : 'text-grey'}}" url="/subpackages/web/h5/index?title=bbs50">
            {{detail.pay_fixed ? '✔ 平台统一定价' : '非平台统一定价'}}
          </navigator>
          <view wx:if="{{detail.workerPaid}}">{{detail.workerPaid}}</view>
        </view>
      </block>
    </view>
  </view>
  <view class="cu-form-group" wx:if="{{detail.pay_oldwall != undefined || isOrderAdmin}}">
    <view class="text-cut title">旧墙处理</view>
    <view class="flex align-center">
      <block wx:if="{{isEditing.pay_oldwall}}">
        <view class="flex align-center">
          <switch class="margin-lr" checked="{{editForm.pay_oldwall}}" bindchange="switchChange" data-field="pay_oldwall"></switch>
          <text class="margin-right-sm">{{editForm.pay_oldwall ? '' : '不接'}}</text>
          <input 
            wx:if="{{editForm.pay_oldwall}}"
            value="{{editForm.pay_oldwall_money}}" 
            data-field="pay_oldwall_money" 
            bindinput="inputChange"
            class="text-right margin-right-xs"
            style="min-width: 200rpx"
            placeholder="视墙面报价"
          />
        </view>
        <view class="text-xxl margin-left-sm">
          <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="pay_oldwall"></text>
          <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="pay_oldwall"></text>
        </view>
      </block>
      <block wx:elif="{{isOrderAdmin}}">
        <view class="margin-right-sm">
          <block wx:if="{{detail.pay_oldwall != undefined}}">
            {{detail.pay_oldwall ? (detail.pay_oldwall_money === '' ? '视墙面报价' : detail.pay_oldwall_money) : '另找油漆工'}}
          </block>
          <block wx:else>未设置</block>
        </view>
        <text class="cuIcon-edit text-blue" bindtap="editField" data-field="pay_oldwall"></text>
      </block>
      <block wx:else>
        <block wx:if="{{detail.pay_oldwall != undefined}}">
          {{detail.pay_oldwall ? (detail.pay_oldwall_money === '' ? '视墙面报价' : detail.pay_oldwall_money) : '另找油漆工'}}
        </block>
        <block wx:else>未设置</block>
      </block>
    </view>
  </view>
  <view class="cu-form-group" wx:if="{{detail.sell != undefined}}">
    <view class="text-cut title">自卖主材</view>
    <view class="cuIcon-info flex-twice margin-xs" bindtap="go51"></view>
    <view class="flex align-center">
      <block wx:if="{{isEditing.sell}}">
        <switch class="margin-left" checked="{{editForm.sell}}" bindchange="switchChange" data-field="sell"></switch>
        <input 
          wx:if="{{editForm.sell}}"
          value="{{editForm.sell_goods}}" 
          data-field="sell_goods" 
          bindinput="inputChange"
          class="text-right margin-right-xs"
          placeholder="请输入销售商品"
        />
        <view class="text-xxl margin-left-sm">
          <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="sell"></text>
          <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="sell"></text>
        </view>
      </block>
      <block wx:elif="{{isOrderAdmin}}">
        <view class="text-right content margin-right-sm">
          <view class="text-green" bindtap="goShop2" wx:if="{{detail.sell == true}}">✔平台帮售-点击购买</view>
          <view>{{detail.sell ? (detail.sell_goods ? detail.sell_goods : '是，墙布、壁画等') : '否，仅施工，仅辅料'}}</view>
        </view>
        <text class="cuIcon-edit text-blue" bindtap="editField" data-field="sell"></text>
      </block>
      <block wx:else>
        <view class="text-right content">
          <view class="text-green" bindtap="goShop2" wx:if="{{detail.sell == true}}">✔平台帮售-点击购买</view>
          <view>{{detail.sell ? (detail.sell_goods ? detail.sell_goods : '是，墙布、壁画等') : '否，仅施工，仅辅料'}}</view>
        </view>
      </block>
    </view>
  </view>
  <view class="cu-form-group" wx:if="{{detail.workerTime || (detail.startDate && isOrderAdmin)}}">
    <view class="title text-cut">时间信息</view>
    <view class="flex align-center flex-wrap justify-end">
      <!-- 入行时间 -->
      <block wx:if="{{isEditing.workerTime}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">入行:</text>
          <input 
            value="{{editForm.workerTime}}" 
            data-field="workerTime" 
            bindinput="inputChange"
            class="text-right"
            style="min-width: 120rpx"
            placeholder="例如：5年"
          />
          <view class="text-xxl margin-left-sm">
            <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="workerTime"></text>
            <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="workerTime"></text>
          </view>
        </view>
      </block>
      <block wx:elif="{{detail.workerTime && isOrderAdmin}}">
        <view class="flex align-center margin-right-sm">
          <text class="text-grey text-sm margin-right-xs">入行:</text>
          <text class="margin-right-xs">{{detail.workerTime}}</text>
          <text class="cuIcon-edit text-blue" bindtap="editField" data-field="workerTime"></text>
        </view>
      </block>
      <block wx:elif="{{detail.workerTime}}">
        <view class="flex align-center margin-right-sm">
          <text class="text-grey text-sm margin-right-xs">入行:</text>
          <text>{{detail.workerTime}}</text>
        </view>
      </block>

      <!-- 发布时间 -->
      <block wx:if="{{isEditing.startDate}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">发布:</text>
          <input 
            value="{{editForm.startDate}}" 
            data-field="startDate" 
            bindinput="inputChange"
            class="text-right"
            style="min-width: 180rpx"
            placeholder="YYYY-MM-DD"
          />
          <view class="text-xxl margin-left-sm">
            <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="startDate"></text>
            <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="startDate"></text>
          </view>
        </view>
      </block>
      <block wx:elif="{{detail.startDate && isOrderAdmin}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">发布:</text>
          <text class="margin-right-xs">{{detail.startDate}}</text>
          <text class="cuIcon-edit text-blue" bindtap="editField" data-field="startDate"></text>
        </view>
      </block>
      <block wx:elif="{{detail.startDate}}">
        <view class="flex align-center">
          <text class="text-grey text-sm margin-right-xs">发布:</text>
          <text>{{detail.startDate}}</text>
        </view>
      </block>
    </view>
    <!-- 至 {{detail.endDate}} *结束日期注释 -->
  </view>
</view>

<view class="cu-bar bg-white margin-top solid-top">
  <view class="action">
    <text class="cuIcon-titles text-green"></text>
    <text class="text-black"> 发布内容</text>
  </view>
</view>
<view class="cu-form-group bg-white solid-bottom">
  <view class="flex align-center" style="width: 100%">
    <block wx:if="{{isEditing.content}}">
      <textarea 
        value="{{editForm.content}}" 
        data-field="content" 
        bindinput="inputChange"
        class="text-black content"
        style="width: 100%; min-height: 100px;"
      ></textarea>
      <view class="flex margin-top text-xxl">
        <text class="cuIcon-roundcheck text-green margin-right-xs" bindtap="saveField" data-field="content"></text>
        <text class="cuIcon-roundclose text-red" bindtap="cancelField" data-field="content"></text>
      </view>
    </block>
    <block wx:else>
      <view class="text-black content margin-right-sm">{{detail.content}}</view>
      <text wx:if="{{isOrderAdmin}}" class="cuIcon-edit text-blue" bindtap="editField" data-field="content"></text>
    </block>
  </view>
</view>
<view class="padding bg-white worker-gallery" wx:if="{{detail.imgList}}">
  <view class="gallery-head"><view><text class="text-bold">师傅图片</text><text class="text-grey text-sm"> {{detail.imgList.length}}/6</text></view><button wx:if="{{detail.isMine==1}}" class="cu-btn sm round line-cyan" catchtap="goEditProfile">编辑资料</button><button wx:elif="{{isOrderAdmin}}" class="cu-btn sm round line-cyan" catchtap="toggleImageManager"><text class="cuIcon-edit"></text> {{imageManaging?'取消管理':'管理图片'}}</button></view>
  <swiper wx:if="{{!imageManaging}}" class="screen-swiper square-dot" indicator-dots="true" circular="true" autoplay="{{!imagePreviewVisible}}" interval="5000" duration="500" current="{{galleryCurrent}}" bindchange="onGalleryChange">
    <swiper-item wx:for="{{detail.imgList}}" wx:key="index" data-index="{{index}}" bindtap="viewImage">
      <image src="{{item}}" mode="aspectFit"></image>
    </swiper-item>
  </swiper>
  <view wx:else class="image-manager" catchtap="noop"><view class="managed-image" wx:for="{{imageDraft}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="editManagedImage"></image><view class="managed-actions"><text class="cuIcon-back" data-index="{{index}}" data-offset="-1" bindtap="moveManagedImage"></text><text class="cuIcon-edit" data-index="{{index}}" bindtap="editManagedImage"></text><text class="cuIcon-right" data-index="{{index}}" data-offset="1" bindtap="moveManagedImage"></text><text class="cuIcon-delete text-red" data-index="{{index}}" bindtap="removeManagedImage"></text></view></view><button wx:if="{{imageDraft.length<6}}" class="image-add" bindtap="chooseManagedImages"><text class="cuIcon-cameraadd"></text><view>添加并编辑</view></button></view>
  <view wx:if="{{imageManaging}}" class="gallery-save"><text class="text-grey text-sm">点图片可裁剪、滤镜、涂鸦；拖动顺序用左右箭头</text><button class="cu-btn bg-cyan text-white round" loading="{{imageBusy}}" bindtap="saveManagedImages">保存图片</button></view>
</view>

<!-- 自定义全屏图片预览：关闭时把最后浏览索引同步回详情轮播。 -->
<view wx:if="{{imagePreviewVisible}}" class="worker-image-preview" catchtouchmove="noop">
  <view class="worker-image-preview__top">
    <text class="worker-image-preview__counter">{{imagePreviewCurrent + 1}} / {{detail.imgList.length}}</text>
    <view class="worker-image-preview__close" catchtap="closeImagePreview" aria-label="关闭图片预览">
      <text class="cuIcon-close"></text>
    </view>
  </view>
  <swiper class="worker-image-preview__swiper" current="{{imagePreviewCurrent}}" bindchange="onImagePreviewChange" circular="{{detail.imgList.length > 1}}">
    <swiper-item wx:for="{{detail.imgList}}" wx:key="index">
      <view class="worker-image-preview__slide" catchtap="noop">
        <image src="{{item}}" mode="aspectFit"></image>
      </view>
    </swiper-item>
  </swiper>
</view>

<view class="padding-xs bg-white">
   <view wx:for="{{DetailPrompt}}" wx:key="index">
	  	<view class="cuIcon-infofill text-xs text-grey"> {{item.text}}</view>
   </view>
	</view>

<view class='margin-top'>
  <view class="flex justify-center">
    <view><button wx:if="{{detail.isMine==1}}" class='margin cu-btn round bg-red shadow lg block' bindtap="delRecord">删除发布</button></view>
    <view><button wx:if="{{isOrderAdmin && detail.reviewStatus}}" class="margin cu-btn round shadow lg admin-review-action {{detail.reviewActionClass}}" bindtap="togglePublished">{{detail.reviewActionText}}</button></view>
    <!-- <view><button wx:if="{{isOrderAdmin && !detail.workerTime}}" class='margin cu-btn round bg-blue shadow lg' bindtap="addWorkerTime">添加入行时间</button></view> -->
  </view>
</view>

<view class="weui-footer margin-top">
	<view class="weui-footer__links">
    <!--跳转客服按钮 bindtap="wxkefu" -->
		<text class="weui-footer__link">若有错误请反馈客服</text>
	</view>
	<text class="text-gray padding-bottom">Powered By 壁选 © 2013-现在</text>
</view>
<!-- 自定义tab遮挡解决 -->
<view style="width: 100%;height: calc(150rpx + env(safe-area-inset-bottom) / 2);"></view>

</view>
<view wx:if="{{activeDetailTab === 1}}" class="worker-reviews-pane" bindtouchstart="detailTouchStart" bindtouchend="detailTouchEnd">
  <view class="worker-rating-summary">
    <view class="worker-rating-overall"><strong>{{reviewSummary.review_count ? reviewSummary.overall_average : '—'}}</strong><text>综合评分</text><small>{{reviewSummary.review_count}} 条订单评价</small></view>
    <view class="worker-rating-dimensions"><view><text>服务态度</text><strong>{{reviewSummary.review_count ? reviewSummary.attitude_average : '—'}}</strong><small>满分 5.0</small></view><view><text>施工手艺</text><strong>{{reviewSummary.review_count ? reviewSummary.craft_average : '—'}}</strong><small>满分 5.0</small></view></view>
  </view>
  <view wx:if="{{reviews.length}}" class="worker-review-list"><view wx:for="{{reviews}}" wx:key="id" class="worker-review-item"><view class="worker-review-meta"><text class="worker-reviewer">{{item.reviewer}}</text><text>{{item.reviewed_at}}</text></view><view class="worker-review-scores"><text>态度 <strong>{{item.attitude_rating}}.0</strong></text><text>手艺 <strong>{{item.craft_rating}}.0</strong></text><text>综合 <strong>{{item.overall_rating}}</strong></text></view><view class="worker-review-content">{{item.content || (item.is_auto ? '系统默认评价' : '本次服务已完成评价')}}</view><view class="worker-review-order"><text wx:if="{{item.is_auto}}" class="worker-review-auto">系统评价</text><text>{{item.order_title || item.order_no}}</text></view></view></view>
  <view wx:elif="{{reviewsLoaded && !reviewsLoading}}" class="worker-review-empty"><text class="cuIcon-favor"></text><view>暂无订单评价</view><small>完成订单并评价后会显示在这里</small></view>
  <view wx:if="{{reviewsLoading}}" class="worker-review-loading"><text class="cuIcon-loading2"></text> 正在读取评价</view>
  <view wx:if="{{reviewsHasMore && !reviewsLoading}}" class="worker-review-more" bindtap="loadMoreReviews">继续加载</view>
</view>
</block>
<view wx:else class="padding-xl margin bg-white radius text-center">
  <view class="text-lg text-bold margin-bottom-sm">登录后查看师傅详情</view>
  <view class="text-grey text-sm margin-bottom">从分享页面进入时，先确认当前账号，再加载师傅资料。</view>
  <button class="cu-btn bg-cyan text-white round" bindtap="showAuthDialog">手机号登录</button>
</view>

