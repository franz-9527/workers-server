<!-- 手机号查看：ColorUI 弹窗骨架 + 业务轻量卡片；关闭收敛到右上角，底部只保留有效操作。 -->
<view class="cu-modal phone-reveal-modal {{phoneRevealDialog.visible ? 'show' : ''}}" bindtap="closePhoneRevealDialog">
  <view class="cu-dialog phone-reveal-dialog" catchtap="stopPhoneRevealDialogTap">
    <view class="phone-reveal-head">
      <view>
        <view class="phone-reveal-title">联系师傅</view>
        <view class="phone-reveal-subtitle">手机号仅用于当前联系</view>
      </view>
      <view class="phone-reveal-close" catchtap="closePhoneRevealDialog" aria-label="关闭">
        <text class="cuIcon-close"></text>
      </view>
    </view>

    <view class="phone-reveal-body">
      <view class="phone-reveal-label">手机号码</view>
      <view class="phone-reveal-number" user-select="true">{{phoneRevealDialog.phone}}</view>
      <view class="phone-reveal-notice">
        <text class="cuIcon-safe"></text>
        <text>{{phoneRevealDialog.notice}}</text>
      </view>
    </view>

    <view class="phone-reveal-actions">
      <button class="cu-btn phone-reveal-action phone-reveal-action--secondary" bindtap="copyPhoneReveal">
        <text class="cuIcon-copy"></text>
        <text>复制号码</text>
      </button>
      <button class="cu-btn phone-reveal-action phone-reveal-action--primary" bindtap="callPhoneReveal">
        <text class="cuIcon-phone"></text>
        <text>拨打电话</text>
      </button>
    </view>
  </view>
</view>

<!-- 底部操作条 -->
<view class="cu-bar bg-white tabbar border shop foot">
  <view class="action" bindtap="goHelp">
    <view class="cuIcon-read">
    </view>帮助
  </view>
  <view wx:if="{{(isOrderAdmin && (!phoneRevealPolicy.loaded || phoneRevealPolicy.can_reveal)) || (!isOrderAdmin && phoneRevealPolicy.can_reveal)}}" class="action" bindtap="makeCall2">
    <view class="cuIcon-mobile"></view>
    <view>查看号码</view>
    <view wx:if="{{phoneRevealPolicy.remaining_24h > 0}}" class="phone-reveal-remain">可看{{phoneRevealPolicy.remaining_24h}}位</view>
  </view>
  <view class="bg-blue submit" bindtap="goOffer">我要下单</view>
  <view class="bg-green submit" bindtap="goShop">一口价</view>
</view>

