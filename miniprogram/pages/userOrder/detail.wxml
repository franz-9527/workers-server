<!-- 2026-08-23：用户订单详情集中完成选价、预约费支付、验收、取消和评价闭环。 -->
<view class="detail-page {{footerToolsAvailable ? '' : 'detail-page--summary-only'}} {{primaryAction ? 'detail-page--has-primary' : ''}}" wx:if="{{!loading}}">
  <view class="hero bg-gradual-cyan text-white"><view class="flex justify-between align-center"><view><view class="text-xxl text-bold">{{order.status_text}}</view><view class="margin-top-xs opacity">{{order.id}}</view></view><text class="cuIcon-form hero-icon"></text></view><button wx:if="{{actions.is_admin}}" class="admin-edit-trigger" bindtap="openAdminEdit"><text class="cuIcon-edit"></text> 编辑订单</button></view>

  <view class="card bg-white" style="order:{{40}}">
    <view data-section="information" bindtap="toggleSection" class="title"><text class="cuIcon-info text-cyan"></text> 订单信息</view><view class="section-toggle-link" data-section="information" bindtap="toggleSection">{{sections.information ? '收起' : '展开查看'}} <text class="{{sections.information ? 'cuIcon-fold' : 'cuIcon-unfold'}}"></text></view><block wx:if="{{sections.information}}">
    <view wx:if="{{order.title}}" class="row"><text>订单标题</text><text class="right">{{order.title}}</text></view>
    <view wx:if="{{order.category_name}}" class="row"><text>服务类目</text><text>{{order.category_name}}</text></view>
    <view wx:if="{{order.quantity_text}}" class="row"><text>数量/面积</text><text>{{order.quantity_text}}</text></view>
    <view wx:if="{{order.wall_height_text}}" class="row"><text>墙面高度</text><text>{{order.wall_height_text}}</text></view>
    <view wx:if="{{order.is_renovation !== null && order.is_renovation !== undefined}}" class="row"><text>拆旧翻新</text><text>{{order.is_renovation ? '是' : '否'}}</text></view>
    <view wx:if="{{!order.is_platform_order && order.expected_fee_text}}" class="row"><text>{{order.expected_fee_type === 'unit' ? '期望单价' : '期望总价'}}</text><text class="text-orange text-bold right">{{order.expected_fee_text}}</text></view>
    <view class="row"><text>下单时间</text><text>{{order.created_at || '—'}}</text></view><view class="row"><text>期望上门</text><text>{{order.expected_visit_at || '接单后电话预约'}}</text></view><view wx:if="{{order.fulfillment_status === 'submitted' && order.auto_accept_at}}" class="row"><text>{{isMeasurementOrder ? '成果自动确认时间' : '自动验收时间'}}</text><text class="text-orange">{{order.auto_accept_at}}</text></view><view class="row"><text>{{isMeasurementOrder ? '服务地址' : '施工地址'}}</text><text class="right">{{order.address}}</text></view><view class="row"><text>对接人</text><text>{{order.contact_name}} {{order.contact_mobile}}</text></view>
    <view wx:if="{{order.description}}" class="description">{{order.description}}</view>
  </block></view>

  <!-- V2.5.0 UX-M2：现场联系人只负责上门沟通；付款/加价/验收等仍属于订单 owner 账号的本人动作。 -->
  <view wx:if="{{order.is_merchant_order && actions.is_owner && !actions.is_admin}}" class="card bg-white merchant-role-card">
    <view class="title"><text class="cuIcon-people text-cyan"></text> 本单角色与确认</view>
    <view class="row"><text>下单方</text><text class="right">当前商家账号</text></view>
    <view class="row"><text>现场对接</text><text class="right">{{order.contact_name}} {{order.contact_mobile}}</text></view>
    <view class="row"><text>付款与确认</text><text class="right">当前下单商家账号</text></view>
    <view class="description">现场对接人仅用于师傅上门联系，不因填写姓名或手机号获得支付、接受加价、验收等账号权限；这些操作仍以当前下单商家账号在本订单可执行的操作为准。师傅手机号继续按平台隐私规则开放。</view>
  </view>

  <!-- V2.5.0：客户价格层由订单详情父页面直接使用本次详情响应，测量组件只负责测量成果，避免平台施工单重复请求详情。 -->
  <platform-order-pricing wx:if="{{platformOrder}}" order-id="{{id}}" pricing="{{platformOrder}}" order-state="{{order}}" viewer-mode="{{actions.is_admin ? 'admin' : 'owner'}}" bindpricingupdated="load"></platform-order-pricing>
  <measurement-order-detail wx:if="{{isMeasurementOrder}}" order-id="{{id}}" show-platform-pricing="{{false}}"></measurement-order-detail>
  <!-- 2026-09-19：测量单抵扣是双方施工报价约定，并非自动退款或抵扣预约费。 -->
  <view wx:if="{{measurementLink}}" class="card bg-white"><view class="title"><text class="cuIcon-info text-cyan"></text> 关联测量单</view><view class="row"><text>测量单号</text><text>{{measurementLink.measurement_id}}</text></view><view class="row"><text>原测量师傅</text><text>{{measurementLink.worker.name}}</text></view><view class="row"><text>测量费抵扣上限</text><text>¥{{measurementLink.measurement_amount_cents / 100}}</text></view><view wx:if="{{measurementLink.agreed_deduction_cents}}" class="row"><text>施工报价已抵扣</text><text>¥{{measurementLink.agreed_deduction_cents / 100}}</text></view><view class="description">默认不自动抵扣。原测量师傅与您沟通后在施工报价中填写实际抵扣额；预约费、尾款和平台服务费均以抵扣后的施工成交价计算。</view><navigator class="cu-btn round line-cyan margin-top-sm" url="/pages/userOrder/detail?id={{measurementLink.measurement_id}}">查看原测量成果</navigator></view>
  <view wx:if="{{!isMeasurementOrder && order.warranty_months}}" class="card bg-white warranty-card"><view class="title"><text class="cuIcon-safe text-cyan"></text> 售后维修保障</view><view class="row"><text>保障期限</text><text>{{order.warranty_months}} 个月</text></view><view class="row"><text>保障截止</text><text>{{order.warranty_expires_at || '—'}}</text></view><view class="description">仅适用于保障期限内、非人为因素造成的维修问题；是否符合保障范围由平台结合现场资料核验。</view><view wx:if="{{order.warranty_note}}" class="text-sm text-grey margin-top-xs">师傅说明：{{order.warranty_note}}</view></view>
  <view wx:if="{{afterSales.length}}" class="card bg-white after-sales-card"><view class="title"><text class="cuIcon-safe text-orange"></text> {{isMeasurementOrder ? '测量售后记录' : '售后维修记录'}}</view><view wx:for="{{afterSales}}" wx:key="id" class="after-sales-item"><view class="row"><text>{{isMeasurementOrder ? '测量售后申请' : (item.type === 'warranty_repair' ? '维修保障申请' : '售后申请')}}</text><text class="text-orange">{{item.status === 'open' || item.status === 'processing' ? (isMeasurementOrder ? '售后处理中' : '维修中') : (item.status === 'resolved' ? '已处理' : (item.status === 'closed' ? '已撤回/关闭' : item.status))}}</text></view><view class="description">{{item.description}}</view><view wx:if="{{item.evidence.length}}" class="evidence-images"><image wx:for="{{item.evidence}}" wx:key="id" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></view><view class="text-sm text-grey margin-top-xs">提交于 {{item.opened_at}}<text wx:if="{{!isMeasurementOrder}}"> · 保障截止 {{item.warranty_expires_at || '—'}}</text></view><view wx:if="{{item.resolution}}" class="text-sm text-grey margin-top-xs">处理结果：{{item.resolution}}</view><view wx:if="{{item.type === 'warranty_repair' && (item.status === 'open' || item.status === 'processing')}}" class="repair-action-row"><button wx:if="{{item.can_withdraw}}" class="cu-btn sm round line-red margin-top-sm" data-id="{{item.id}}" bindtap="withdrawRepair">{{isMeasurementOrder ? '撤回售后' : '撤回维修'}}</button><button wx:if="{{actions.can_request_repair_intervention}}" class="cu-btn sm round line-orange margin-top-sm" data-id="{{item.id}}" bindtap="requestRepairIntervention">申请平台介入</button></view></view></view>
  <order-dispute-panel wx:if="{{dispute}}" dispute="{{dispute}}" actions="{{actions}}" order-id="{{id}}" is-measurement="{{isMeasurementOrder}}" bindchanged="load"></order-dispute-panel>
<order-fulfillment-materials media="{{media}}"></order-fulfillment-materials>
<order-negotiation-panel cases="{{negotiations}}" order-id="{{id}}" bindchanged="load"></order-negotiation-panel>

  <!-- 2026-08-29：管理员要求补资料时，在用户订单内直接展示原因和补充入口。 -->
  <view wx:if="{{actions.can_supplement}}" class="supplement-notice"><view><text class="cuIcon-infofill"></text><view><view class="text-bold">订单资料需要补充</view><view class="supplement-reason">{{order.audit_note || '请按管理员要求补充资料后重新提交'}}</view><view wx:if="{{order.supplement_due_at}}" class="supplement-reason">请在 {{order.supplement_due_at}} 前完成补充；超时订单将按规则自动取消并进入退款处理。</view></view></view><button class="cu-btn round bg-cyan text-white" bindtap="openSupplement">补充资料</button></view>

  <!-- 2026-08-28：订单图片按资料用途分组，管理按钮独立成行，避免标题被挤成竖排。 -->
  <view wx:if="{{productMedia.length || wallMedia.length || beforeMedia.length || completionMedia.length || arrivalMedia.length || actions.is_admin}}" class="card bg-white media-card" style="order:{{60}}">
    <view data-section="media" bindtap="toggleSection" class="media-card-header"><view class="title"><text class="cuIcon-pic text-cyan"></text> 订单图片</view><text class="media-total">共 {{productMedia.length + wallMedia.length + beforeMedia.length + completionMedia.length + arrivalMedia.length}} 张</text></view><view class="section-toggle-link" data-section="media" bindtap="toggleSection">{{sections.media ? '收起' : '展开查看'}} <text class="{{sections.media ? 'cuIcon-fold' : 'cuIcon-unfold'}}"></text></view><block wx:if="{{sections.media}}">
    <view wx:if="{{actions.is_admin}}" class="admin-media-actions"><button class="media-manage-button" data-purpose="product" bindtap="chooseAdminImage"><text class="cuIcon-cameraadd"></text> 添加商品图</button><button class="media-manage-button" data-purpose="wall" bindtap="chooseAdminImage"><text class="cuIcon-cameraadd"></text> 添加现场图</button></view>
    <view wx:if="{{productMedia.length}}" class="media-group"><view class="media-group-title">材料/商品图片 <text>{{productMedia.length}}</text></view><view class="images"><image wx:for="{{productMedia}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></view></view>
    <view wx:if="{{wallMedia.length}}" class="media-group"><view class="media-group-title">现场环境/墙面图片 <text>{{wallMedia.length}}</text></view><view class="images"><image wx:for="{{wallMedia}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></view></view>
    <view wx:if="{{beforeMedia.length}}" class="media-group"><view class="media-group-title">{{isMeasurementOrder ? '现场记录图片' : '施工前图片'}} <text>{{beforeMedia.length}}</text></view><view class="images"><image wx:for="{{beforeMedia}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></view></view>
    <view wx:if="{{completionMedia.length}}" class="media-group"><view class="media-group-title">完工图片 <text>{{completionMedia.length}}</text></view><view class="images"><image wx:for="{{completionMedia}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></view></view>
    <view wx:if="{{arrivalMedia.length}}" class="media-group"><view class="media-group-title">到场异常/空跑证据 <text>{{arrivalMedia.length}}</text></view><view class="text-sm text-grey margin-bottom-sm">以下图片带有提交时的位置和时间水印，用于平台核验。</view><view class="images"><image wx:for="{{arrivalMedia}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></view></view>
    <view wx:if="{{!productMedia.length && !wallMedia.length && !beforeMedia.length && !completionMedia.length && !arrivalMedia.length}}" class="media-empty">暂无订单图片，管理员可在上方直接补充。</view>
  </block></view>

  <!-- V2.5.0：收款凭证是验收/结算证据，单独展示，不混入施工照片。 -->
  <view wx:if="{{!isMeasurementOrder && actions.collection_receipt_count > 0}}" class="card bg-white media-card receipt-evidence-card">
    <view class="media-card-header"><view class="title"><text class="cuIcon-pay text-cyan"></text> 师傅收款凭证</view><text class="media-total">{{actions.collection_receipt_count}} 张</text></view>
    <view class="description">师傅已提交本单线下收款/双方确认凭证。请结合实际付款情况核对；如金额或事实不一致，不要验收，可先与师傅沟通或提交完工争议。</view>
    <view class="images margin-top-sm"><block wx:for="{{media}}" wx:key="id"><image wx:if="{{item.purpose === 'collection_receipt'}}" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></block></view>
  </view>

  <!-- 2026-08-24：预约费支付后的师傅安排、联系方式开放状态和电话预约记录在用户端形成可见闭环。 -->
<view wx:if="{{assignedWorker}}" class="card bg-white worker-contact-card" style="order:{{serviceArchived ? 35 : 6}}"><view class="title"><text class="cuIcon-peoplefill text-cyan"></text> {{order.dispatch_mode === 'single_grab' ? '抢单师傅' : '已安排师傅'}}</view><view wx:if="{{order.dispatch_mode === 'single_grab' && assignedWorker.status === 'offered'}}" class="grab-owner-progress"><text class="cuIcon-time"></text> 师傅已抢单，正在与你沟通并填写报价；报价提交后直接进入施工，无需你再次选择师傅。</view><view wx:if="{{order.dispatch_mode === 'single_grab' && assignedWorker.status === 'accepted' && order.fixed_grab_total}}" class="grab-owner-progress"><text class="cuIcon-roundcheckfill"></text> 师傅已按你的期望总价 {{order.expected_fee_text}} 抢单成交并进入施工。沟通/现场复杂情况如需加价，仍必须由师傅申请并经你确认。</view><view class="row"><text>师傅</text><text class="{{assignedWorker.id ? 'worker-profile-link' : ''}}" data-id="{{assignedWorker.id}}" bindtap="openQuoteWorker">{{assignedWorker.name}}<text wx:if="{{assignedWorker.id}}" class="cuIcon-right"></text> <text class="worker-rating"><text class="cuIcon-favorfill"></text> {{assignedWorker.rating}}（{{assignedWorker.review_count}}条）</text></text></view><view class="row"><text>联系电话</text><view><text>{{assignedWorker.mobile}}</text><text wx:if="{{assignedWorker.can_call}}" class="text-cyan margin-left-sm" bindtap="callWorker">拨打</text></view></view><view wx:if="{{!assignedWorker.contact_revealed}}" class="description privacy-tip"><text class="cuIcon-lock"></text> 请等待师傅联系<text wx:if="{{!workerContactRequest.merchant_customer_service_only && (!serviceArchived || workerContactRequest.context_type === 'repair')}}">，超过 {{workerContactRequest.wait_hours || 2}} 小时未联系可申请公开手机号</text>。</view><view wx:if="{{workerContactRequest && workerContactRequest.status === 'pending'}}" class="contact-request-status">电话公开申请正在等待管理员审核。</view><view wx:if="{{workerContactRequest && workerContactRequest.status === 'rejected'}}" class="contact-request-status">上次申请未通过{{workerContactRequest.review_note ? '：' + workerContactRequest.review_note : ''}}</view><button wx:if="{{workerContactRequest && workerContactRequest.can_request}}" class="cu-btn sm round line-cyan margin-top-sm" bindtap="requestWorkerContactReveal">申请公开手机号</button><view wx:if="{{workerContactRequest && workerContactRequest.merchant_customer_service_only && workerContactRequest.dispute_customer_service_prompt}}" class="description merchant-contact-tip">当前存在争议，如确需核实师傅联系方式，请联系客服协助处理。</view></view>
  <!-- 2026-09-04：商家单只展示一张已审核收款码，不区分微信和支付宝。 -->
  <view wx:if="{{!isMeasurementOrder && merchantCollectionCode}}" class="card bg-white merchant-pay-card"><view class="title"><text class="cuIcon-qr_code text-orange"></text> 商家订单线下尾款</view><view class="merchant-pay-body merchant-code-row" bindtap="previewMerchantCollectionCode"><view><strong>查看师傅收款码</strong><small>已由平台审核，仅用于本订单完工后的线下尾款。</small></view><text class="cuIcon-right"></text></view></view>
  <view wx:if="{{appointment}}" class="card bg-white" style="order:{{serviceArchived ? 36 : 14}}"><view class="title"><text class="cuIcon-time text-cyan"></text> 预约记录</view><view class="row"><text>预约上门</text><text>{{appointment.wait_customer_notice ? '等待客户另行通知' : (appointment.at || '时间待定')}}</text></view><view wx:if="{{appointment.note}}" class="description">{{appointment.note}}</view><view class="text-sm text-grey margin-top-xs">预约由师傅提交，无需再次确认。</view></view><view wx:if="{{repairAppointment}}" class="card bg-white"><view class="title"><text class="cuIcon-repair text-orange"></text> 维修联系记录</view><view class="row"><text>维修安排</text><text>{{repairAppointment.wait_customer_notice ? '等待客户另行通知' : (repairAppointment.at || '时间待定')}}</text></view><view wx:if="{{repairAppointment.note}}" class="description">{{repairAppointment.note}}</view></view>
  <view wx:if="{{!isMeasurementOrder && offlineDelay}}" class="card bg-white"><view class="title"><text class="cuIcon-time text-orange"></text> 尾款延期记录</view><view class="row"><text>线下尾款</text><text>{{offlineDelay.amount_text}}</text></view><view class="row"><text>预计收款</text><text>{{offlineDelay.expected_collect_at || '暂不确定'}}</text></view><view class="description">{{offlineDelay.reason}}</view><view class="text-sm text-grey margin-top-xs">状态：{{offlineDelay.status === 'bad_debt' ? '已标记坏账' : '已登记，平台已知悉'}}</view></view>
  <view wx:if="{{cancelRequest && cancelRequest.reason_code !== 'bilateral_refund_pending' && cancelRequest.reason_code !== 'bilateral_refund_rejected'}}" class="card bg-white cancel-progress-card"><view class="title"><text class="cuIcon-refund text-orange"></text> 退款与取消订单申请</view><view class="row"><text>处理状态</text><text>{{cancelRequest.status === 'pending' ? (cancelRequest.reason_code === 'bilateral_refund_pending' ? '等待对方接受方案' : (cancelRequest.reason_code === 'bilateral_refund_rejected' ? '对方已拒绝，可继续协商' : '等待平台处理')) : (cancelRequest.status === 'approved' ? '已通过' : (cancelRequest.status === 'rejected' ? '已驳回' : cancelRequest.status))}}</text></view><view class="row"><text>申请退款</text><text>{{cancelRequest.refund_text}}</text></view><view class="description">{{cancelRequest.reason}}</view><view class="text-sm text-grey margin-top-xs">提交于 {{cancelRequest.requested_at}}</view></view>
  <view wx:if="{{refundInfo}}" class="card bg-white refund-info-card"><view class="title"><text class="cuIcon-refund text-orange"></text> 退款进度</view><view class="row"><text>退款总额</text><text class="refund-amount">{{refundInfo.amount_text}}</text></view><view wx:if="{{refundInfo.refund_count > 1}}" class="row"><text>原路退款</text><text>{{refundInfo.succeeded_count || 0}} / {{refundInfo.refund_count}} 笔已成功</text></view><view wx:if="{{refundInfo.refund_count > 1}}" class="row"><text>微信已确认</text><text>{{refundInfo.succeeded_text}}</text></view><view class="row"><text>当前状态</text><text>{{refundInfo.status_text}}</text></view><view wx:if="{{refundInfo.succeeded_at}}" class="text-sm text-grey margin-top-xs">全部退款微信确认完成：{{refundInfo.succeeded_at}}</view><view wx:if="{{refundInfo.failure_message}}" class="refund-failure">处理说明：{{refundInfo.failure_message}}</view><view class="refund-hint">{{refundInfo.status === 'succeeded' ? '全部原路退款均已由微信确认，具体入账时间以微信及发卡行处理为准。' : '多笔原支付会分别原路退款；全部完成前订单保持退款处理中。如状态长时间未更新，请联系客服。'}}</view><button wx:if="{{refundInfo.status === 'failed'}}" class="cu-btn sm round line-cyan margin-top-sm" bindtap="qwkefu">联系平台处理</button></view>
  <view wx:if="{{answers.length}}" class="card bg-white" style="order:{{50}}"><view data-section="answers" bindtap="toggleSection" class="title"><text class="cuIcon-list text-cyan"></text> {{isMeasurementOrder ? '下单资料' : '商品与施工资料'}}</view><view class="section-toggle-link" data-section="answers" bindtap="toggleSection">{{sections.answers ? '收起' : '展开查看'}} <text class="{{sections.answers ? 'cuIcon-fold' : 'cuIcon-unfold'}}"></text></view><block wx:if="{{sections.answers}}"><view wx:for="{{answers}}" wx:key="label" class="row"><text>{{item.label}}</text><text class="right">{{item.value}}</text></view></block></view>

  <view wx:if="{{!isMeasurementOrder && order.dispatch_mode === 'single_grab' && !assignedWorker}}" class="card bg-white owner-grab-mode-card"><view class="title"><text class="cuIcon-lightningfill text-orange"></text> 单师傅抢单模式</view><view class="description">{{order.fixed_grab_total ? '你填写了期望总价 ' + order.expected_fee_text + '。首位师傅抢单即成交，无需再报价；沟通/现场复杂情况仍可申请加价，由你确认后生效。' : (order.expected_fee_type === 'unit' && order.expected_fee_text ? '你填写了期望单价：' + order.expected_fee_text + '。该文本不参与金额计算，仅供参考。师傅抢单后会与你沟通并提交施工总价，提交后直接进入施工。' : '师傅抢单成功后会先联系你沟通施工条件和价格，再由该师傅提交施工总价并直接进入施工，不需要你再次从多个报价中选择。')}}</view></view>

  <view wx:if="{{actions.can_notify_nearby_workers}}" class="card bg-white nearby-sms-card">
    <view class="nearby-sms-card-main">
      <view class="nearby-sms-icon"><text class="cuIcon-messagefill"></text></view>
      <view class="nearby-sms-copy"><view class="title">{{order.dispatch_mode === 'single_grab' ? '通知附近师傅抢单' : '通知附近师傅'}}</view><view class="nearby-sms-desc">{{order.dispatch_mode === 'single_grab' ? '付费短信提醒附近师傅查看并抢单；最终确认送达后才扣费。' : '付费短信提醒附近可报价师傅；最终确认送达后才扣费。'}}</view></view>
      <button class="cu-btn round bg-cyan text-white nearby-sms-open" bindtap="openNearbySms">选择师傅</button>
    </view>
    <view class="nearby-sms-tip">短信可能被手机系统拦截或未及时看到；已发送不代表师傅一定{{order.dispatch_mode === 'single_grab' ? '抢单' : '报价'}}。</view>
  </view>

  <view wx:if="{{quotes.length || actions.can_admin_platform_quote}}" class="card bg-white" style="order:{{quotePriority ? 8 : 45}}"><view data-section="quotes" bindtap="toggleSection" class="title flex justify-between align-center"><view><text class="cuIcon-moneybag text-cyan"></text> {{order.dispatch_mode === 'single_grab' ? '抢单师傅报价' : '报价情况'}}</view><button wx:if="{{actions.can_admin_platform_quote}}" class="cu-btn sm round bg-cyan text-white" catchtap="openAdminQuote">{{adminQuoteAmount ? '修改平台报价' : '平台报价'}}</button></view><view class="section-toggle-link" data-section="quotes" bindtap="toggleSection">{{sections.quotes ? '收起' : '展开查看'}} <text class="{{sections.quotes ? 'cuIcon-fold' : 'cuIcon-unfold'}}"></text></view><block wx:if="{{sections.quotes}}">
    <view class="description">请结合订单资料核对总价、服务范围和上门安排；现场新增项目须经你确认。选定师傅后不能直接换人，需要先申请取消并完成协商。</view>
    <view wx:if="{{!quotes.length}}" class="quote-empty">目前还没有师傅或平台报价</view>
    <view wx:for="{{quotes}}" wx:key="id" class="quote {{item.is_selected ? 'quote-selected' : ''}}">
      <view class="flex justify-between align-center"><view class="quote-main"><view class="quote-worker-line text-bold"><text wx:if="{{item.type === 'worker' && item.worker_id}}" class="worker-profile-link" data-id="{{item.worker_id}}" catchtap="openQuoteWorker">{{item.source_text}} <text wx:if="{{item.real_name_verified}}" class="real-name-tag">已实名</text><text class="cuIcon-right"></text></text><text wx:else>{{item.source_text}} <text wx:if="{{item.real_name_verified}}" class="real-name-tag">已实名</text></text><text wx:if="{{item.type === 'worker'}}" class="worker-rating"><text class="cuIcon-favorfill"></text> {{item.rating}}（{{item.review_count}}条）</text><text wx:if="{{item.is_selected}}" class="selected-tag">{{order.dispatch_mode === 'single_grab' ? '抢单后已确认' : '用户已选择'}}</text></view><view wx:if="{{item.type === 'worker'}}" class="text-sm text-grey margin-top-xs">距{{isMeasurementOrder ? '测量' : '施工'}}地址约 {{item.distance_km === null ? '待计算' : item.distance_km + 'km'}}</view></view><view class="price">{{item.amount_text}}</view></view>
      <view wx:if="{{item.included_text}}" class="quote-structured"><text>{{isMeasurementOrder ? '测量包含' : '施工包含'}}</text><text>{{item.included_text}}</text></view><view wx:if="{{item.excluded_text}}" class="quote-structured excluded"><text>{{isMeasurementOrder ? '测量不包含' : '施工不包含'}}</text><text>{{item.excluded_text}}</text></view><view wx:if="{{item.available_text}}" class="quote-structured"><text>可上门时间</text><text>{{item.available_text}}</text></view><view wx:if="{{item.description}}" class="quote-desc">{{item.description}}</view><view class="text-sm text-grey">{{isMeasurementOrder ? ('总测量价已含预约费 ' + item.booking_text + '，选中后仅补剩余差额') : ('预约费 ' + item.booking_text + '，其余完工线下支付')}}</view>
      <!-- 2026-09-15：按订单预约费状态区分按钮，已付订单不会提示再次付款。 -->
      <button wx:if="{{actions.can_select_quote && item.is_selectable}}" class="cu-btn round bg-cyan text-white margin-top-sm" data-index="{{index}}" bindtap="selectQuote">{{isMeasurementOrder ? '选定测量师傅' : (order.payment_status === 'paid' ? '接受报价' : '接受并支付预约费')}}</button>
      <view wx:elif="{{item.status === 'active' && !item.is_selectable}}" class="text-sm text-grey margin-top-sm">当前订单阶段不可选择该报价</view>
    </view>
  </block></view>
  <view wx:if="{{actions.can_pay_order}}" class="pay-remind"><view><text class="cuIcon-pay text-cyan"></text> 订单尚未支付预约费，支付成功后才进入审核</view><button class="cu-btn sm round bg-cyan text-white" bindtap="payOrderBooking">支付预约费</button></view>
  <view wx:if="{{actions.can_pay}}" class="pay-remind"><view><text class="cuIcon-time text-cyan"></text> 已选报价，等待支付</view><button class="cu-btn sm round bg-cyan text-white" bindtap="payExisting">继续支付</button></view>

  <view wx:if="{{changes.length}}" class="card bg-white"><view class="title"><text class="cuIcon-moneybag text-orange"></text> 报价与费用变更</view>
    <view wx:for="{{changes}}" wx:key="id" class="quote">
      <view class="flex justify-between"><view class="text-bold">申请增加 {{item.added_text}}</view><text class="change-status {{item.status}}">{{item.status_text}}</text></view>
      <view class="quote-desc">{{item.reason}}</view><view class="text-sm text-grey">调整后总价 {{item.total_text}} · {{item.submitted_at}}</view>
      <view wx:if="{{item.status === 'rejected'}}" class="change-result rejected"><text class="cuIcon-close"></text> 用户已拒绝本次加价，本单总价未按此次申请调整；请双方继续协商，协商不成可申请退款并结束订单。</view>
      <view wx:elif="{{item.status === 'accepted' && item.payment_status === 'awaiting_payment'}}" class="change-result accepted"><text class="cuIcon-time"></text> 已同意本次测量加费，尚未支付；支付成功后新总价才生效。</view>
      <view wx:elif="{{item.status === 'accepted' && item.payment_status === 'refund_pending'}}" class="change-result rejected"><text class="cuIcon-refund"></text> 本次测量加费未生效，已进入原路退款处理。</view>
      <view wx:elif="{{item.status === 'accepted' && item.payment_status === 'refunded'}}" class="change-result rejected"><text class="cuIcon-refund"></text> 本次测量加费未生效，微信退款已确认。</view>
      <view wx:elif="{{item.status === 'accepted'}}" class="change-result accepted"><text class="cuIcon-check"></text> 用户已同意，本单结算金额已按调整后总价更新。</view>
      <view wx:if="{{item.can_decide}}" class="flex margin-top-sm"><button class="cu-btn sm round line-red flex-sub" data-index="{{index}}" data-decision="rejected" bindtap="decideChange">拒绝</button><button class="cu-btn sm round bg-cyan text-white flex-sub margin-left" data-index="{{index}}" data-decision="accepted" bindtap="decideChange">{{isMeasurementOrder ? '同意并支付' : '同意加价'}}</button></view>
      <button wx:if="{{item.can_pay}}" class="cu-btn sm round bg-cyan text-white margin-top-sm" data-id="{{item.id}}" bindtap="continueMeasurementChangePayment">继续支付 {{item.added_text}}</button>
    </view>
  </view>

  <!-- 2026-10-08：普通消费者同意跑空费后从真实已付预约费池结算，剩余可退预约费原路退款；商家仍走在线支付。 -->
  <order-run-empty-panel wx:if="{{runEmptyClaim && runEmptyClaim.collection_mode === 'booking_offset'}}" claim="{{runEmptyClaim}}" can-decide="{{actions.can_decide_run_empty_claim}}" bindchanged="load"></order-run-empty-panel>
  <view wx:if="{{runEmptyClaim && runEmptyClaim.collection_mode !== 'booking_offset'}}" class="card bg-white run-empty-card"><view class="title"><text class="cuIcon-footprint text-orange"></text> 跑空费协商</view><view class="row"><text>跑空费</text><text class="text-bold">{{runEmptyClaim.amount_text}}</text></view><view class="row"><text>当前状态</text><text class="text-orange">{{runEmptyClaim.status_text}}</text></view><view class="description">{{runEmptyClaim.reason}}</view><view wx:if="{{runEmptyClaim.user_note}}" class="text-sm text-grey margin-top-xs">{{runEmptyClaim.order_source_type === 'merchant' ? '商家说明：' : '处理说明：'}}{{runEmptyClaim.user_note}}</view><view wx:if="{{actions.can_decide_run_empty_claim}}" class="run-empty-actions"><button class="cu-btn round line-red flex-sub" data-decision="rejected" bindtap="decideRunEmptyClaim">不同意，转争议</button><button class="cu-btn round bg-cyan text-white flex-sub" data-decision="accepted" bindtap="decideRunEmptyClaim">{{runEmptyClaim.collection_mode === 'online' ? '确认并支付' : '确认处理'}}</button></view><button wx:if="{{actions.can_pay_run_empty_claim && runEmptyClaim.collection_mode === 'online'}}" class="cu-btn block round bg-cyan text-white margin-top" bindtap="payRunEmptyClaim">微信支付 {{runEmptyClaim.amount_text}}</button><view wx:if="{{runEmptyClaim.collection_mode === 'online'}}" class="text-sm text-grey margin-top-sm">商家订单确认后通过微信支付跑空费；不同意时可提交争议由平台处理。</view><view wx:elif="{{runEmptyClaim.collection_mode === 'manual'}}" class="text-sm text-grey margin-top-sm">本单使用独立资金/履约规则，不自动从普通预约费抵扣；如需处理跑空费用，由平台结合现场证据和双方说明处理。</view></view>

  <view wx:if="{{events.length}}" class="card bg-white"><view class="title"><text class="cuIcon-time text-cyan"></text> 订单时间线</view><view wx:for="{{sections.timeline ? timelineEvents : recentEvents}}" wx:key="time" class="event"><view class="event-dot"></view><view><view>{{item.text}}</view><view class="text-sm text-grey">{{item.time}}</view></view></view><view wx:if="{{timelineEvents.length > 3}}" class="section-toggle-link" data-section="timeline" bindtap="toggleSection">{{sections.timeline ? '收起历史记录' : '查看全部 ' + timelineEvents.length + ' 条记录'}}</view></view>

  <!-- 2026-10-07：主动评价和系统自动评价都明确展示来源，自动评价期限以后台设置为准。 -->
  <view wx:if="{{review}}" class="card bg-white"><view class="title"><text class="cuIcon-favorfill text-orange"></text> 服务评价</view><view class="review-score-display"><view><text>服务态度</text><strong>{{review.attitude_rating || review.rating}}.0</strong></view><view><text>施工手艺</text><strong>{{review.craft_rating || review.rating}}.0</strong></view><view class="overall"><text>综合</text><strong>{{review.overall_rating || review.rating}}</strong></view></view><view class="description">{{review.content || '本次服务已完成评价'}}</view><view wx:if="{{review.media.length}}" class="images margin-top"><image wx:for="{{review.media}}" wx:key="id" src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image></view><view class="text-sm text-grey margin-top-xs">{{review.is_auto ? '系统默认评价' : '用户评价'}} · {{review.reviewed_at}}</view></view>

  <!-- V2.5.0：退款、争议、维修统一收敛为“遇到问题”，已存在案件时优先回看进度。 -->
  <view wx:if="{{hasSecondaryServiceActions}}" class="actions-card bg-white">
    <button wx:if="{{secondaryActions.supplement}}" class="order-action supplement-action" bindtap="openSupplement"><text class="cuIcon-edit"></text><view><view>补充订单资料</view><small>按审核意见补充图片或说明并重新提交</small></view><text class="cuIcon-right"></text></button>
    <button wx:if="{{secondaryActions.accept}}" class="order-action primary-action" bindtap="acceptCompletion"><text class="cuIcon-roundcheckfill"></text><view><view>确认完工验收</view><small>确认施工已完成并进入评价流程</small></view></button>
    <button wx:if="{{secondaryActions.review}}" class="order-action review-action" bindtap="openReview"><text class="cuIcon-favorfill"></text><view><view>评价师傅</view><small>分享本次施工服务体验</small></view></button>
    
  </view>
  <view wx:if="{{hasProblemEntry}}" class="actions-card bg-white problem-actions-card" style="order:1000" data-module="problem"><button wx:if="{{hasProblemEntry}}" class="order-action dispute-action" bindtap="openProblemMenu"><text class="cuIcon-warn"></text><view><view>{{problemEntryLabel}}</view><small>{{problemEntryLabel === '查看问题处理' ? '已有退款、争议或售后记录，优先查看当前处理进度' : '退款、成果异议、维修或需要平台介入时从这里进入'}}</small></view><text class="cuIcon-right"></text></button></view>

  <!-- 2026-10-09：管理员邀请师傅统一复用 admin-worker-assignment，工作台与订单详情不再各自维护邀请弹窗入口。 -->
  <view class="order-fixed-footer {{footerToolsAvailable ? '' : 'order-fixed-footer--summary-only'}}">
    <view class="order-footer-main">
      <view class="order-footer-tools">
        <button wx:if="{{!actions.is_admin}}" class="order-footer-tool" bindtap="qwkefu"><text class="cuIcon-service"></text><view>联系客服</view></button>
        <button wx:if="{{!actions.is_admin}}" class="order-footer-tool" open-type="share"><text class="cuIcon-share"></text><view>分享订单</view></button>
        <button wx:if="{{actions.can_admin_share_ordinary}}" class="order-footer-tool" data-type="ordinary" bindtap="openAdminShare"><text class="cuIcon-share"></text><view>普通分享</view></button>
        <admin-worker-assignment wx:if="{{actions.can_admin_invite_worker}}" order-id="{{id}}" actions="{{actions}}" variant="footer" label="邀请师傅"></admin-worker-assignment>
      </view>
      <view class="order-footer-transaction">
        <button wx:if="{{primaryAction}}" class="order-footer-primary {{primaryAction.style}}" loading="{{cancelSubmitting}}" disabled="{{cancelSubmitting}}" bindtap="runPrimaryAction">{{cancelSubmitting ? '正在提交' : primaryAction.label}}</button>
        <view class="order-footer-summary"><view class="summary-label">{{order.final_amount_cents ? '成交价' : (order.is_platform_order && platformOrder && platformOrder.customer_flow_mode === 'platform_managed' ? '平台托管' : '预约费')}}</view><view class="summary-amount">{{order.final_amount_cents ? order.final_amount_text : (order.is_platform_order && platformOrder && platformOrder.customer_flow_mode === 'platform_managed' ? '无需微信预约费' : order.booking_fee_text)}}</view><view wx:if="{{order.final_amount_cents && !(order.is_platform_order && platformOrder && platformOrder.customer_flow_mode === 'platform_managed')}}" class="summary-booking">已含预约费 {{order.booking_fee_text}}</view><view wx:elif="{{order.final_amount_cents && order.is_platform_order && platformOrder && platformOrder.customer_flow_mode === 'platform_managed'}}" class="summary-booking">平台托管 · 无微信预约费</view></view>
      </view>
    </view>
    <view class="order-footer-safe"></view>
  </view>

  <!-- 2026-08-29：补资料弹窗支持文字修正和原图上传，由服务端统一无损优化。 -->
  <view wx:if="{{showSupplement}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white supplement-modal"><view class="order-modal-heading text-xl text-bold">补充订单资料</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="supplement-requirement"><text class="cuIcon-infofill"></text> 审核意见：{{order.audit_note || '请补充必要的订单资料'}}</view><view class="admin-two"><view class="admin-field"><text>数量/面积</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{supplementQuantity}}" data-field="supplementQuantity" bindinput="supplementFieldInput" placeholder="如 80㎡"/></view><view class="admin-field"><text>墙面高度</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{supplementHeight}}" data-field="supplementHeight" bindinput="supplementFieldInput" placeholder="如 2.8m"/></view></view><view class="admin-field"><text>需求说明</text><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{supplementDescription}}" data-field="supplementDescription" bindinput="supplementFieldInput" maxlength="2000" placeholder="补充需求和现场情况"></textarea></view><view class="supplement-upload-actions"><button data-purpose="product" bindtap="chooseSupplementImages"><text class="cuIcon-cameraadd"></text> 补商品图</button><button data-purpose="wall" bindtap="chooseSupplementImages"><text class="cuIcon-cameraadd"></text> 补现场图</button></view><view wx:if="{{supplementAddedCount}}" class="supplement-uploaded">本次已上传 {{supplementAddedCount}} 张图片</view><view class="admin-field"><text>补充说明（选填）</text><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{supplementNote}}" data-field="supplementNote" bindinput="supplementFieldInput" maxlength="500" placeholder="告诉管理员本次补充了什么"></textarea></view></scroll-view><view class="order-modal-footer flex margin-top"><button class="cu-btn round line-grey flex-sub" bindtap="closeSupplement">取消</button><button class="cu-btn round bg-cyan text-white flex-sub margin-left" loading="{{supplementSaving}}" disabled="{{supplementSaving || supplementUploading}}" bindtap="submitSupplement">重新提交审核</button></view></view></view>

  <view wx:if="{{showNearbySms}}" class="order-modal modal-mask" catchtouchmove="true">
    <view class="order-modal-dialog modal bg-white nearby-sms-modal">
      <view class="order-modal-heading nearby-modal-head"><view><view class="text-xl text-bold">{{order.dispatch_mode === 'single_grab' ? '通知附近师傅抢单' : '通知附近师傅'}}</view><view class="nearby-modal-sub">{{order.dispatch_mode === 'single_grab' ? ('余额 ' + nearbySmsBalanceText + ' · ' + nearbySmsFeeText + ' / 位 · 首位成功抢单者锁单') : ('余额 ' + nearbySmsBalanceText + ' · ' + nearbySmsFeeText + ' / 位 · 还可接收 ' + nearbySmsQuoteSlotsRemaining + ' 个新报价')}}</view></view><text class="cuIcon-close nearby-modal-close" bindtap="closeNearbySms"></text></view>
      <scroll-view scroll-y enhanced class="order-modal-body"><view class="nearby-slots"><text class="cuIcon-people"></text> {{order.dispatch_mode === 'single_grab' ? '可同时短信通知多位师傅，但短信不预留抢单资格；只有首位成功抢单的师傅会锁定订单，其他师傅刷新后将无法再抢。' : ('本单当前还可接收 ' + nearbySmsQuoteSlotsRemaining + ' 位师傅报价；短信邀请人数可以更多，但报价名额满后其余师傅将无法继续报价。')}}</view>
      <view wx:if="{{nearbySmsFallbackNotice}}" class="nearby-fallback"><text class="cuIcon-infofill"></text> {{nearbySmsFallbackNotice}}</view>
      <view wx:if="{{nearbySmsLoading}}" class="nearby-loading"><text class="cuIcon-loading2 spin"></text> 正在查找附近师傅</view>

      <view wx:elif="{{!nearbySmsBatch}}" scroll-y class="nearby-candidate-scroll">
        <view wx:if="{{!nearbySmsCandidates.length}}" class="nearby-empty">当前没有可通知的师傅</view>
        <view wx:for="{{nearbySmsCandidates}}" wx:key="candidate_key" class="nearby-candidate {{item.selectable ? '' : 'disabled'}} {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="toggleNearbySmsCandidate">
          <view class="nearby-check"><text class="{{item.selected ? 'cuIcon-roundcheckfill' : 'cuIcon-round'}}"></text></view>
          <view class="nearby-candidate-main">
            <view class="nearby-candidate-name"><text>{{item.name}}</text><text class="nearby-kind {{item.verified ? 'verified' : 'marked'}}">{{item.kind_text}}</text></view>
            <view class="nearby-candidate-meta"><text>{{item.distance_text}}</text><text wx:if="{{item.verified && item.rating}}">评分 {{item.rating}}</text><text wx:if="{{item.verified && item.completed_orders}}">完工 {{item.completed_orders}} 单</text></view>
            <view wx:if="{{item.notice}}" class="nearby-candidate-note">{{item.notice}}</view>
            <view wx:if="{{item.already_notified}}" class="nearby-already">本单已通知，不能重复收费发送</view>
          </view>
          <view class="nearby-detail-link" data-target="{{item.detail_target}}" catchtap="openNearbyWorker"><text>详情</text><text class="cuIcon-right"></text></view>
        </view>
      </view>

      <view wx:else scroll-y class="nearby-result-scroll">
        <view class="nearby-result-summary"><view class="text-bold">短信任务已创建</view><view>费用先预占，只有最终送达的短信才扣费；失败或送达无法确认会释放预占。</view><view wx:if="{{nearbySmsBatch.invalid_candidate_count > 0}}">有 {{nearbySmsBatch.invalid_candidate_count}} 位候选在提交时已失效，本次未预占、未发送。</view></view>
        <view wx:for="{{nearbySmsBatch.invites}}" wx:key="public_no" class="nearby-result-row">
          <view><view class="text-bold">{{item.worker_name_snapshot}}</view><view class="text-sm text-grey">{{item.delivery_text}}</view><view wx:if="{{item.error_message_safe}}" class="nearby-result-error">{{item.error_message_safe}}</view></view>
          <view class="nearby-billing">{{item.billing_text}}</view>
        </view>
      </view></scroll-view>

      <view wx:if="{{!nearbySmsBatch}}" class="order-modal-footer nearby-modal-footer">
        <view class="nearby-total"><text>已选 {{nearbySmsSelectedCount}} 位<text wx:if="{{nearbySmsMarkedSelectedCount > 0}}"> · 其中 {{nearbySmsMarkedSelectedCount}} 位其他可联系师傅</text></text><strong>{{nearbySmsTotalText}}</strong><small>最多预占 · 失败不收费</small></view>
        <button class="cu-btn round line-grey" bindtap="closeNearbySms">取消</button>
        <button class="cu-btn round bg-cyan text-white" loading="{{nearbySmsSubmitting}}" disabled="{{nearbySmsSubmitting || nearbySmsSelectedCount < 1}}" bindtap="submitNearbySms">确认发送</button>
      </view>
      <view wx:else class="order-modal-footer nearby-modal-footer nearby-modal-footer--result"><button class="cu-btn round bg-cyan text-white" bindtap="closeNearbySms">完成</button></view>
    </view>
  </view>

  <view wx:if="{{showCancel}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white"><view class="order-modal-heading text-xl text-bold">申请退款并取消订单</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="cancel-explain">师傅未出发并同意取消时全额退还可退线上实收。已出发，或已因沟通准备材料、工具、安排时间时，师傅可拒绝；可申请平台介入，按证据核定合理上门或时间补偿，不会自动扣费。</view><view class="cancel-explain"><text class="cuIcon-infofill"></text> 未成交且无履约事实时自动取消退款；已成交先向对方提出方案，接受后执行可自动处理的退款，拒绝或超时后可申请平台介入。</view><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" class="textarea" disabled="{{cancelSubmitting}}" placeholder="请填写退款及取消原因，便于对方协商" maxlength="1000" bindinput="cancelInput"></textarea></scroll-view><view class="order-modal-footer flex"><button class="cu-btn round line-grey flex-sub" disabled="{{cancelSubmitting}}" bindtap="closeCancel">暂不申请</button><button class="cu-btn round bg-red text-white flex-sub margin-left" loading="{{cancelSubmitting}}" disabled="{{cancelSubmitting}}" bindtap="submitCancel">{{cancelSubmitting ? '提交中' : '申请退款'}}</button></view></view></view>
  <view wx:if="{{showDispute}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white"><view class="order-modal-heading text-xl text-bold">{{isMeasurementOrder ? '提交测量成果异议' : '提交完工异议'}}</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="cancel-explain"><text class="cuIcon-infofill"></text> 仅限{{isMeasurementOrder ? '测量成果待确认' : '完工待验收'}}阶段使用。提交后先暂停自动{{isMeasurementOrder ? '确认' : '验收'}}，请优先与师傅沟通；确实无法解决时再申请平台介入。</view><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" class="textarea" placeholder="{{isMeasurementOrder ? '请说明尺寸、图片、漏项或现场异议' : '请说明完工质量、漏项或现场异议'}}" maxlength="2000" value="{{disputeDescription}}" bindinput="disputeInput"></textarea><view class="evidence-images evidence-picker"><view wx:for="{{disputeImages}}" wx:key="id" class="evidence-item"><image src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image><text class="cuIcon-close" data-index="{{index}}" catchtap="removeDisputeImage"></text></view><view wx:if="{{disputeImages.length < 6}}" class="evidence-add" bindtap="chooseDisputeImages"><text class="cuIcon-cameraadd"></text><small>添加证据</small></view></view><view class="text-sm text-grey margin-top-xs">至少上传 1 张现场或完工证据图片。</view></scroll-view><view class="order-modal-footer flex margin-top"><button class="cu-btn round line-grey flex-sub" bindtap="closeDispute">取消</button><button class="cu-btn round bg-red text-white flex-sub margin-left" loading="{{disputeSubmitting}}" disabled="{{disputeSubmitting || disputeUploading}}" bindtap="submitDispute">提交异议</button></view></view></view>
  <view wx:if="{{showRepair}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white"><view class="order-modal-heading text-xl text-bold">{{isMeasurementOrder ? '申请测量售后' : '申请维修保障'}}</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="cancel-explain"><text class="cuIcon-infofill"></text> {{isMeasurementOrder ? '测量成果确认后如发现漏项、尺寸、图片等问题，可提交售后由原测量师傅继续处理。' : '仅限保障期限内、非人为因素造成的问题；保障期限从验收/自动验收起算，平台会根据订单资料和现场情况核验。'}}</view><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" class="textarea" placeholder="{{isMeasurementOrder ? '请说明测量成果存在的具体问题' : '请说明需要维修的具体问题'}}" maxlength="2000" value="{{repairDescription}}" bindinput="repairInput"></textarea><view class="evidence-images evidence-picker"><view wx:for="{{repairImages}}" wx:key="id" class="evidence-item"><image src="{{item.display_url || item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image><text class="cuIcon-close" data-index="{{index}}" catchtap="removeRepairImage"></text></view><view wx:if="{{repairImages.length < 6}}" class="evidence-add" bindtap="chooseRepairImages"><text class="cuIcon-cameraadd"></text><small>添加现场图</small></view></view><view class="text-sm text-grey margin-top-xs">{{isMeasurementOrder ? '可上传测量成果、现场或标注问题图片，帮助师傅和平台核对。' : '可上传维修现场图片，帮助平台判断是否属于非人为原因。'}}</view><checkbox-group wx:if="{{!isMeasurementOrder}}" bindchange="repairConfirmChange"><label class="ack"><checkbox value="non_human" color="#00b9cb"/>我确认本次问题并非人为因素造成</label></checkbox-group></scroll-view><view class="order-modal-footer flex"><button class="cu-btn round line-grey flex-sub" bindtap="closeRepair">暂不申请</button><button class="cu-btn round bg-cyan text-white flex-sub margin-left" loading="{{repairSubmitting}}" disabled="{{repairSubmitting || repairUploading}}" bindtap="submitRepair">提交申请</button></view></view></view>
  <view wx:if="{{showRunEmptyDispute}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white"><view class="order-modal-heading text-xl text-bold">不同意跑空费</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="cancel-explain"><text class="cuIcon-infofill"></text> 请先与师傅沟通。仍无法达成一致时，填写原因后由平台处理争议。</view><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" class="textarea" placeholder="请说明不同意的原因和协商情况" maxlength="500" bindinput="runEmptyDisputeInput"></textarea></scroll-view><view class="order-modal-footer flex"><button class="cu-btn round line-grey flex-sub" bindtap="closeRunEmptyDispute">继续协商</button><button class="cu-btn round bg-red text-white flex-sub margin-left" bindtap="submitRunEmptyDispute">提交争议</button></view></view></view>
  <view wx:if="{{showReview}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white review-modal"><view class="order-modal-heading text-xl text-bold">评价本次服务</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="review-rating-row"><text class="review-rating-label">服务态度</text><view class="stars review-stars"><text wx:for="{{starOptions}}" wx:key="*this" class="cuIcon-favorfill {{reviewAttitudeRating >= item ? 'text-orange' : 'text-gray'}}" data-type="attitude" data-rating="{{item}}" bindtap="reviewRatingChange"></text></view><text class="review-rating-value">{{reviewAttitudeRating}}星</text></view><view class="review-rating-row"><text class="review-rating-label">施工手艺</text><view class="stars review-stars"><text wx:for="{{starOptions}}" wx:key="*this" class="cuIcon-favorfill {{reviewCraftRating >= item ? 'text-orange' : 'text-gray'}}" data-type="craft" data-rating="{{item}}" bindtap="reviewRatingChange"></text></view><text class="review-rating-value">{{reviewCraftRating}}星</text></view><view class="review-template-title">常用评价 <text>可多选</text></view><view class="review-template-list"><view wx:for="{{reviewTemplates}}" wx:key="text" class="review-template {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="toggleReviewTemplate">{{item.text}}</view></view><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" class="textarea review-textarea" value="{{reviewContent}}" placeholder="还可以补充本次服务体验（选填）" maxlength="2000" bindinput="reviewInput"></textarea><view class="review-images"><view wx:for="{{reviewImages}}" wx:key="*this" class="review-image"><image src="{{item}}" mode="aspectFill"></image><text class="cuIcon-close" data-index="{{index}}" catchtap="removeReviewImage"></text></view><view wx:if="{{reviewImages.length < 6}}" class="review-add" bindtap="chooseReviewImages"><text class="cuIcon-cameraadd"></text><small>添加图片</small></view></view></scroll-view><view class="order-modal-footer flex margin-top"><button class="cu-btn round line-grey flex-sub" bindtap="closeReview">取消</button><button class="cu-btn round bg-cyan text-white flex-sub margin-left" bindtap="submitReview">提交评价</button></view></view></view>
  <view wx:if="{{showAdminEdit}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white admin-edit-modal"><view class="order-modal-heading text-xl text-bold">管理员编辑订单资料</view><scroll-view scroll-y class="order-modal-body admin-edit-scroll">
    <view class="admin-field"><text>订单标题</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" maxlength="160" value="{{adminEditTitle}}" bindinput="inputAdminEditTitle" placeholder="订单标题"/></view>
    <view class="admin-two"><view class="admin-field"><text>数量/面积</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{adminEditQuantity}}" data-field="adminEditQuantity" bindinput="adminEditFieldInput" placeholder="如 80㎡"/></view><view class="admin-field"><text>墙面高度</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{adminEditHeight}}" data-field="adminEditHeight" bindinput="adminEditFieldInput" placeholder="如 2.8m"/></view></view>
    <view class="admin-field"><text>是否拆旧翻新</text><radio-group class="admin-radios" bindchange="adminRenovationChange"><label><radio value="1" checked="{{adminEditRenovation === '1'}}" color="#00b9cb"/>是</label><label><radio value="0" checked="{{adminEditRenovation === '0'}}" color="#00b9cb"/>否</label><label><radio value="" checked="{{adminEditRenovation === ''}}" color="#00b9cb"/>未确定</label></radio-group></view>
    <view class="admin-field"><text>期望上门时间</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{adminEditExpected}}" data-field="adminEditExpected" bindinput="adminEditFieldInput" placeholder="YYYY-MM-DD HH:mm，留空则电话预约"/></view>
    <view class="admin-two"><view class="admin-field"><text>城市</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{adminEditCity}}" data-field="adminEditCity" bindinput="adminEditFieldInput"/></view><view class="admin-field"><text>区县</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{adminEditDistrict}}" data-field="adminEditDistrict" bindinput="adminEditFieldInput"/></view></view>
    <view class="admin-field"><text>完整施工地址</text><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{adminEditAddress}}" data-field="adminEditAddress" bindinput="adminEditFieldInput" maxlength="255"/></view>
    <view class="admin-two"><view class="admin-field"><text>对接人</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" value="{{adminEditContactName}}" data-field="adminEditContactName" bindinput="adminEditFieldInput"/></view><view class="admin-field"><text>手机号</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" type="text" value="{{adminEditContactMobile}}" data-field="adminEditContactMobile" bindinput="adminEditFieldInput" placeholder="11位，可加转分机"/></view></view>
    <view class="admin-field"><text>需求说明</text><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" maxlength="2000" value="{{adminEditDescription}}" bindinput="inputAdminEditDescription" placeholder="需求说明"></textarea></view>
  </scroll-view><view class="order-modal-footer flex margin-top"><button class="cu-btn round line-grey flex-sub" bindtap="closeAdminEdit">取消</button><button class="cu-btn round bg-cyan text-white flex-sub margin-left" loading="{{adminSaving}}" disabled="{{adminSaving}}" bindtap="saveAdminEdit">保存修改</button></view></view></view>
  <view wx:if="{{showAdminQuote}}" class="order-modal order-modal-compact modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white"><view class="order-modal-heading text-xl text-bold">{{adminQuoteAmount ? '修改平台报价' : '新增平台报价'}}</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="text-sm text-grey margin-top-xs">用户仍可同时选择师傅报价；一旦选择任一报价，本单停止继续报价。</view><view class="admin-quote-amount"><text>¥</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" type="digit" inputmode="decimal" maxlength="11" value="{{adminQuoteAmount}}" bindinput="inputAdminQuoteAmount" placeholder="施工总价"/></view><textarea cursor-spacing="24" placeholder-class="order-modal-placeholder" class="textarea" maxlength="1000" value="{{adminQuoteDescription}}" bindinput="inputAdminQuoteDescription" placeholder="平台报价说明（选填）"></textarea></scroll-view><view class="order-modal-footer flex"><button class="cu-btn round line-grey flex-sub" bindtap="closeAdminQuote">取消</button><button class="cu-btn round bg-cyan text-white flex-sub margin-left" loading="{{adminQuoteSaving}}" disabled="{{adminQuoteSaving}}" bindtap="saveAdminQuote">保存报价</button></view></view></view>
  <view wx:if="{{showAdminShare}}" class="order-modal modal-mask" catchtouchmove="true"><view class="order-modal-dialog modal bg-white admin-share-modal">
    <view class="order-modal-heading text-xl text-bold">{{adminShareType === 'worker_invite' ? '邀请师傅分享' : '普通订单分享'}}</view><scroll-view scroll-y enhanced class="order-modal-body"><view class="text-sm text-grey margin-top-xs">订单 {{order.id}}</view>
    <view wx:if="{{adminShareType === 'worker_invite'}}" class="share-tip"><text class="cuIcon-infofill"></text> 被分享者登录后如尚未入驻，需先完成正常师傅入驻资料；满足本单领取条件后再进入受邀接单/报价流程。分享前仍可调整本单服务费。</view>
    <view wx:if="{{adminShareType === 'worker_invite' && !adminShareResult}}" class="share-fields"><view><text>平台服务费（%）</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" type="digit" value="{{adminShareRate}}" bindinput="adminShareRateInput"/></view><view><text>有效天数（1-30）</text><input cursor-spacing="24" placeholder-class="order-modal-placeholder" type="number" value="{{adminShareDays}}" bindinput="adminShareDaysInput"/></view></view>
    <view wx:if="{{adminShareResult}}" class="share-result"><image wx:if="{{adminShareResult.code_data_uri}}" src="{{adminShareResult.code_data_uri}}" mode="aspectFit"></image><view wx:else class="share-code-error">小程序码暂未生成，可直接使用微信分享按钮。</view><view>有效期至 {{adminShareResult.expires_at}}</view><button class="cu-btn round bg-cyan text-white" open-type="share">立即微信分享</button></view></scroll-view>
    <view class="order-modal-footer flex margin-top"><button class="cu-btn round line-grey flex-sub" bindtap="closeAdminShare">关闭</button><button wx:if="{{!adminShareResult}}" class="cu-btn round bg-cyan text-white flex-sub margin-left" loading="{{adminShareSaving}}" disabled="{{adminShareSaving}}" bindtap="createAdminShare">生成分享</button></view>
  </view></view>
  <view wx:if="{{confirmingPayment}}" class="confirming"><text class="cuIcon-loading2 spin"></text> 正在向服务器确认微信支付结果</view>
</view>
<view wx:else class="loading text-center text-grey"><text class="cuIcon-loading2 spin"></text> 加载订单</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>
