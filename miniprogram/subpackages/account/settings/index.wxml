<view class="page bg-greyLight settings-page padding-bottom-xl">
  <view class="settings-section">
    <view class="settings-section-title">账号与个人信息</view>
    <view class="cu-list menu card-menu shadow-lg radius settings-card">
      <view class="cu-item arrow settings-item settings-phone-item">
        <view class="content settings-item-copy">
          <view class="settings-item-title">手机号</view>
          <view class="settings-item-desc">用于登录、账号安全与联系核验</view>
        </view>
        <view class="action"><text class="phone-mobile">{{hasMobile ? displayMobile : '未绑定'}}</text></view>
        <button
          style="position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;margin:0;padding:0;opacity:0;z-index:3;"
          disabled="{{phoneLoginBusy}}"
          open-type="getPhoneNumber"
          bindgetphonenumber="getPhoneNumber"
          aria-label="{{hasMobile ? '更换手机号' : '绑定手机号'}}"
        ></button>
      </view>

      <view class="cu-item arrow settings-item" bindtap="goMembership">
        <view class="content settings-item-copy">
          <view class="settings-item-title">会员服务</view>
          <view wx:if="{{vipActive}}" class="settings-item-desc membership-state active">已开通<text wx:if="{{vipEndTime}}"> · 有效至 {{vipEndTime}}</text></view>
          <view wx:elif="{{membershipLegacy}}" class="settings-item-desc membership-state legacy">历史会员 · 兼容保留</view>
          <view wx:else class="settings-item-desc">查看会员服务与权益</view>
        </view>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <view class="settings-section-title">系统权限</view>
    <view class="cu-list menu card-menu shadow-lg radius settings-card">
      <view class="cu-item arrow settings-item" bindtap="openWechatSetting">
        <view class="content settings-item-copy">
          <view class="settings-item-title">微信授权设置</view>
          <view class="permission-status-line">
            <text class="permission-status-text {{wechatPermissionWarning ? 'is-warning' : ''}}">{{wechatPermissionText}}</text>
            <text class="permission-status-divider">·</text>
            <text class="permission-status-text {{locationPermissionEnabled ? '' : 'is-warning'}}">{{locationPermissionText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view id="notification-settings" class="settings-section">
    <view class="settings-section-title">微信订阅通知</view>
    <view class="settings-card subscription-settings-card">
      <view wx:if="{{subscribeLoading}}" class="subscribe-empty">正在读取通知设置…</view>
      <view wx:elif="{{subscribeError}}" class="subscribe-empty" bindtap="retrySubscriptions">{{subscribeError}} · 点击重试</view>
      <block wx:else>
        <view wx:for="{{subscribeGroups}}" wx:key="key" class="subscribe-group {{index === 0 ? 'subscribe-group-first' : ''}}">
          <view class="subscribe-group-head">
            <view class="subscribe-group-copy"><text class="subscribe-group-title">{{item.title}}</text><text class="subscribe-group-desc">{{item.description}}</text></view>
            <button wx:if="{{item.key !== 'optional'}}" class="subscribe-batch-btn" data-audience="{{item.key}}" bindtap="topUpImportant" disabled="{{subscribeBatchBusy || subscribeSceneBusyKey || !item.batchAvailable}}">{{subscribeBatchBusy ? '接收中' : '重要通知 +1'}}</button>
          </view>
          <view wx:for="{{item.items}}" wx:for-item="scene" wx:key="key" class="subscribe-credit-row">
            <view class="subscribe-copy"><view class="subscribe-title-line"><text class="subscribe-title">{{scene.title}}</text></view><text class="subscribe-desc">{{scene.description}}</text></view>
            <view class="subscribe-credit-side"><text class="subscribe-credit {{scene.rejected ? 'warning' : ''}}">{{scene.countText}}</text><button wx:if="{{scene.showAction}}" class="subscribe-mini-btn" data-key="{{scene.key}}" bindtap="topUpScene" disabled="{{subscribeBatchBusy || subscribeSceneBusyKey}}">{{subscribeSceneBusyKey === scene.key ? '接收中' : (scene.needsWechatSetting ? '去设置' : scene.actionText)}}</button></view>
          </view>
        </view>
        <view wx:if="{{!subscribeGroups.length}}" class="subscribe-empty">暂无可开启的微信提醒</view>
      </block>
      <view class="notification-help-toggle" bindtap="toggleNotificationHelp">通知说明与诊断 <text class="{{notificationHelpOpen ? 'cuIcon-fold' : 'cuIcon-unfold'}}"></text></view>
      <view wx:if="{{notificationHelpOpen}}" class="notification-help"><view>每次最多申请3个不同模板。同意一次增加1次提醒，发送后扣减；共用模板的次数同步更新，其他通知可单独开启。</view><view class="notification-help-actions"><button bindtap="openWechatSetting">微信通知设置</button><button bindtap="runSubscribeDiagnostic" disabled="{{subscribeDiagnosticBusy}}">检查通知</button></view></view>
    </view>
  </view>

  <view class="settings-section">
    <view class="settings-section-title">聊天存储</view>
    <view class="cu-list menu card-menu shadow-lg radius settings-card"><view class="cu-item arrow settings-item" bindtap="goChatStorage"><view class="content settings-item-copy"><view class="settings-item-title">管理聊天缓存</view><view class="settings-item-desc">查看占用，按会话或类型清理本设备缓存</view></view></view></view>
  </view>

</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>
