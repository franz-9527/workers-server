<view class="page bg-greyLight settings-page padding-bottom-xl">
  <view class="settings-section">
    <view class="settings-section-title">账号与个人信息</view>
    <view class="cu-list menu card-menu shadow-lg radius settings-card">
      <view class="cu-item arrow settings-item settings-phone-item">
        <view class="content settings-item-copy">
          <view class="settings-item-title">手机号</view>
          <view class="settings-item-desc">用于登录、账号安全与联系核验</view>
        </view>
        <view class="action"><text class="phone-mobile">{{hasMobile ? displayMobile : '未绑定'}}</text></view>
        <button
          style="position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;margin:0;padding:0;opacity:0;z-index:3;"
          disabled="{{phoneLoginBusy}}"
          open-type="getPhoneNumber"
          bindgetphonenumber="getPhoneNumber"
          aria-label="{{hasMobile ? '更换手机号' : '绑定手机号'}}"
        ></button>
      </view>

      <view class="cu-item arrow settings-item" bindtap="goMembership">
        <view class="content settings-item-copy">
          <view class="settings-item-title">会员服务</view>
          <view wx:if="{{vipActive}}" class="settings-item-desc membership-state active">已开通<text wx:if="{{vipEndTime}}"> · 有效至 {{vipEndTime}}</text></view>
          <view wx:elif="{{membershipLegacy}}" class="settings-item-desc membership-state legacy">历史会员 · 兼容保留</view>
          <view wx:else class="settings-item-desc">查看会员服务与权益</view>
        </view>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <view class="settings-section-title">系统权限</view>
    <view class="cu-list menu card-menu shadow-lg radius settings-card">
      <view class="cu-item arrow settings-item" bindtap="openWechatSetting">
        <view class="content settings-item-copy">
          <view class="settings-item-title">微信授权设置</view>
          <view class="permission-status-line">
            <text class="permission-status-text {{wechatPermissionWarning ? 'is-warning' : ''}}">{{wechatPermissionText}}</text>
            <text class="permission-status-divider">·</text>
            <text class="permission-status-text {{locationPermissionEnabled ? '' : 'is-warning'}}">{{locationPermissionText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view id="notification-settings" class="settings-section">
    <view class="settings-section-title">消息通知</view>
    <view class="cu-list menu card-menu shadow-lg radius settings-card subscription-settings-card">
      <view wx:if="{{subscribeLoading}}" class="cu-item settings-state-row"><view class="content text-grey text-sm">正在读取订阅状态…</view></view>
      <view wx:elif="{{subscribeError}}" class="cu-item arrow settings-state-row" bindtap="retrySubscriptions">
        <view class="content">
          <view class="text-red text-sm">{{subscribeError}}</view>
          <view class="text-grey text-xs margin-top-xs">点击重试</view>
        </view>
      </view>

      <block wx:else>
        <view wx:if="{{userSubscribeItems.length}}" class="subscribe-group subscribe-group-first">
          <view class="subscribe-group-head">
            <view class="subscribe-group-copy">
              <view class="subscribe-group-title">用户通知</view>
              <view class="subscribe-group-desc">{{userBatchHint}}</view>
            </view>
            <view wx:if="{{userImportantCount}}" class="subscribe-batch-btn {{subscribeBatchBusy || subscribeSceneBusyKey || !userBatchAvailable ? 'is-disabled' : ''}}" role="button" aria-label="批量接收用户通知" aria-disabled="{{subscribeBatchBusy || subscribeSceneBusyKey || !userBatchAvailable}}" data-audience="user" bindtap="topUpImportant">{{subscribeBatchBusy ? '接收中…' : '批量接收'}}</view>
          </view>

          <view class="subscribe-credit-row" wx:for="{{userSubscribeItems}}" wx:key="key">
            <view class="subscribe-copy">
              <view class="subscribe-title-line"><text class="subscribe-title">{{item.title}}</text><text wx:if="{{item.important}}" class="subscribe-priority-tag">重要</text></view>
              <view class="subscribe-desc">{{item.description}}</view>
            </view>
            <view class="subscribe-credit-side">
              <text class="subscribe-credit {{item.rejected ? 'warning' : ''}}">{{item.countText}}</text>
              <view wx:if="{{item.showAction}}" class="subscribe-mini-btn {{subscribeBatchBusy || subscribeSceneBusyKey ? 'is-disabled' : ''}}" role="button" aria-label="{{item.needsWechatSetting ? '去设置' : item.actionText}}" aria-disabled="{{subscribeBatchBusy || subscribeSceneBusyKey}}" data-key="{{item.key}}" bindtap="topUpScene">{{subscribeSceneBusyKey == item.key ? '接收中…' : (item.needsWechatSetting ? '去设置' : item.actionText)}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{workerSubscribeItems.length}}" class="subscribe-group {{userSubscribeItems.length ? '' : 'subscribe-group-first'}}">
          <view class="subscribe-group-head">
            <view class="subscribe-group-copy">
              <view class="subscribe-group-title">师傅通知</view>
              <view class="subscribe-group-desc">{{workerBatchHint}}</view>
            </view>
            <view wx:if="{{workerImportantCount}}" class="subscribe-batch-btn {{subscribeBatchBusy || subscribeSceneBusyKey || !workerBatchAvailable ? 'is-disabled' : ''}}" role="button" aria-label="批量接收师傅通知" aria-disabled="{{subscribeBatchBusy || subscribeSceneBusyKey || !workerBatchAvailable}}" data-audience="worker" bindtap="topUpImportant">{{subscribeBatchBusy ? '接收中…' : '批量接收'}}</view>
          </view>

          <view class="subscribe-credit-row" wx:for="{{workerSubscribeItems}}" wx:key="key">
            <view class="subscribe-copy">
              <view class="subscribe-title-line"><text class="subscribe-title">{{item.title}}</text><text wx:if="{{item.important}}" class="subscribe-priority-tag">重要</text></view>
              <view class="subscribe-desc">{{item.description}}</view>
            </view>
            <view class="subscribe-credit-side">
              <text class="subscribe-credit {{item.rejected ? 'warning' : ''}}">{{item.countText}}</text>
              <view wx:if="{{item.showAction}}" class="subscribe-mini-btn {{subscribeBatchBusy || subscribeSceneBusyKey ? 'is-disabled' : ''}}" role="button" aria-label="{{item.needsWechatSetting ? '去设置' : item.actionText}}" aria-disabled="{{subscribeBatchBusy || subscribeSceneBusyKey}}" data-key="{{item.key}}" bindtap="topUpScene">{{subscribeSceneBusyKey == item.key ? '接收中…' : (item.needsWechatSetting ? '去设置' : item.actionText)}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{!userSubscribeItems.length && !workerSubscribeItems.length}}" class="subscribe-empty">
          当前暂无已配置的微信订阅通知，站内消息不受影响。
        </view>
      </block>
    </view>
  </view>

  <view class="settings-section">
    <view class="settings-section-title">自助诊断工具</view>
    <view class="cu-list menu card-menu shadow-lg radius settings-card">
      <view class="cu-item arrow settings-item" bindtap="runSubscribeDiagnostic">
        <view class="content settings-item-copy">
          <view class="settings-item-title">订阅消息自诊断</view>
          <view class="settings-item-desc">检查微信权限、模板、剩余次数与服务端发送链路</view>
        </view>
      </view>
    </view>
  </view>

  <view class="settings-tip text-grey text-xs">
    一次性订阅每次同意增加 1 次可发送额度，消息成功发送后扣减 1 次。诊断工具只读取状态，不清理任何本地数据或草稿。
  </view>

  <view class="settings-section"><view class="settings-section-title">聊天存储</view><view class="cu-list menu card-menu shadow-lg radius settings-card"><view class="cu-item arrow settings-item" bindtap="goChatStorage"><view class="content settings-item-copy"><view class="settings-item-title">管理聊天缓存</view><view class="settings-item-desc">查看占用，按会话或类型清理本设备缓存</view></view></view></view></view>
</view>

<inapp-notice custom-nav="{{false}}"></inapp-notice>
