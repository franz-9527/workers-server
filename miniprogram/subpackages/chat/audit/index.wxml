<view class="audit-page"><view class="audit-intro">全部订单会话 · 只读抽检</view><view class="audit-note">抽检不改变双方已读、在线或个人角标。撤回及屏蔽原文需在后台按权限与理由查证。</view>
<view wx:if="{{!enabled}}" class="audit-card">订单聊天尚未开放</view>
<block wx:else><button bindtap="refresh" disabled="{{busy}}">刷新{{conversation ? '会话' : '活动快照'}}</button><view wx:if="{{error}}" class="audit-error" role="alert">{{error}}</view>
<view wx:for="{{rows}}" wx:key="conversation_id" class="audit-card" data-id="{{item.conversation_id}}" bindtap="open"><view>订单 {{item.order_id}}</view><view>会话 {{item.conversation_id}} · {{item.activity_at}}</view></view>
<button wx:if="{{hasMore}}" bindtap="more" disabled="{{busy}}">后续会话</button>
<button wx:if="{{hasReturn}}" bindtap="backPosition" disabled="{{busy}}">返回刚才位置</button>
<button wx:if="{{hasEarlier}}" bindtap="more" disabled="{{busy}}">更早消息</button>
<view wx:for="{{messages}}" wx:key="message_id" class="audit-card"><view class="audit-meta">{{item.sender_id}} · {{item.created_at}}</view>
<button wx:if="{{item.reply}}" data-id="{{item.reply.message_id}}" bindtap="locate" disabled="{{busy}}">{{item.reply.text || '引用已不可查看'}}</button>
<button wx:if="{{item.edited_from}}" data-id="{{item.edited_from.message_id}}" bindtap="locate" disabled="{{busy}}">定位重新编辑来源</button>
<view class="audit-text">{{item.state === 'published' ? (item.text || (item.message_type === 'audio' ? '[语音消息]' : item.message_type === 'video' ? '[视频消息]' : '[图片消息]')) : (item.state === 'recalled' ? '[已撤回]' : '[不可查看]')}}</view>
<button wx:if="{{item.state === 'published' && item.av}}" data-message="{{item.message_id}}" bindtap="media" disabled="{{busy}}">播放{{item.message_type === 'audio' ? '语音' : '视频'}} · {{item.av.duration_ms / 1000}}秒</button>
<view wx:if="{{item.state === 'published' && item.message_type === 'audio' && item.av.transcript}}">{{item.av.transcript}}</view>
<button wx:for="{{item.images}}" wx:for-item="photo" wx:key="item_id" data-message="{{item.message_id}}" data-item="{{photo.item_id}}" bindtap="image" disabled="{{busy}}">按需查看第{{photo.ordinal + 1}}张图片</button></view>
<view wx:if="{{busy}}" class="audit-note">正在读取…</view>
<view wx:if="{{av}}" class="audit-photo"><button bindtap="closeAV">关闭{{av.kind === 'audio' ? '语音' : '视频'}}</button><video wx:if="{{av.kind === 'video'}}" src="{{av.src}}" controls autoplay="{{false}}" object-fit="contain"/></view>
<view wx:if="{{photo}}" class="audit-photo"><button bindtap="closeImage">关闭图片</button><image src="{{photo}}" mode="aspectFit"/></view></block></view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>
