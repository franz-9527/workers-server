<view class="group-page">
 <view wx:if="{{disabled}}">群聊功能暂未开放</view><view wx:elif="{{invalid}}">分享或群信息无效</view>
 <block wx:else>
 <view wx:if="{{loading}}" role="status">正在核对群信息…</view>
 <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button bindtap="refresh">刷新</button></view>
 <button wx:if="{{loginNeeded}}" bindtap="login">登录账号</button>
 <view wx:if="{{preview}}" class="card"><text class="title">受邀加入订单协作群</text><text>请选择群内展示身份。身份标签不授予订单、付款或正式师傅权限。</text>
 <picker range="{{roles}}" range-key="label" value="{{roleIndex}}" bindchange="chooseRole"><view class="selector">{{roles[roleIndex].label}} ▾</view></picker>
 <button disabled="{{busy}}" bindtap="join">{{preview.already_member?'进入已有群聊':'确认加入'}}</button></view>
 <view wx:if="{{group}}" class="card"><text class="title">{{group.title}}</text><text>{{group.members.length}}人 · 普通加入上限{{group.member_limit}}人{{group.state==='readonly'?' · 已转只读':''}}</text>
 <view wx:if="{{group.projection_ready === false}}" role="status">群成员权限正在同步，请稍候…</view><button bindtap="openChat" disabled="{{group.projection_ready === false}}">打开群消息</button><button size="mini" disabled="{{loading}}" bindtap="refresh">刷新群信息</button>
 <view wx:for="{{group.members}}" wx:key="actor_id" class="member"><image src="{{item.avatar}}" mode="aspectFit"/><view><text>{{item.label}} · {{item.name}}</text><text class="hint">{{item.role_source==='invite'?'本人选择的展示身份':'系统确认的成员身份'}}</text></view><button wx:if="{{item.can_remove}}" size="mini" data-id="{{item.actor_id}}" disabled="{{busy}}" bindtap="remove">移除</button></view>
 <block wx:if="{{group.can_invite}}"><button disabled="{{busy}}" bindtap="generate">生成或更新分享邀请</button><text class="hint">重新生成后，旧海报和旧微信分享立即失效。一个有效邀请可供多人加入，群满后暂时不能加入。</text><button disabled="{{busy}}" bindtap="revoke">撤销我的分享邀请</button></block>
 <view wx:if="{{share}}"><button open-type="share">微信分享</button><button disabled="{{busy}}" bindtap="makePoster">生成分享海报</button><text class="hint">有效期至 {{share.expires_at}}</text></view>
 <view wx:if="{{poster}}"><image class="poster" src="{{poster}}" mode="widthFix"/><button bindtap="savePoster">保存海报</button></view>
 <block wx:if="{{group.can_edit_role}}"><picker range="{{roles}}" range-key="label" value="{{roleIndex}}" bindchange="chooseRole"><view class="selector">更正展示身份：{{roles[roleIndex].label}} ▾</view></picker><button disabled="{{busy}}" bindtap="editRole">确认更正展示身份</button></block>
 <button wx:if="{{group.can_leave}}" disabled="{{busy}}" bindtap="leave">退出协作群</button>
 </view><view wx:if="{{events.length}}" class="card"><text class="title">群成员动态</text><view wx:for="{{events}}" wx:key="id" class="event">{{item.label}} · {{item.created_at}}</view></view>
 </block>
 <canvas canvas-id="groupPoster" class="poster-canvas" style="width:600px;height:860px"/>
</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>
