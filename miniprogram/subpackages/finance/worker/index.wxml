<!-- 2026-08-25：账单页采用居住地址页的留白卡片与固定安全区，修复暗黑模式下低对比度。 -->
<view wx:if="{{!loading && errorText}}" class="loading"><text class="cuIcon-warn text-orange"></text><view>{{errorText}}</view></view>
<view class="finance-page" wx:elif="{{!loading}}">
  <view class="finance-hero"><view class="hero-label">可提现余额（元）</view><view class="balance">{{balance.available_text}}</view><view class="hero-foot"><text>冻结 {{balance.frozen_text}}</text><button class="cu-btn round worker-hero-button" bindtap="openWithdraw">申请提现</button></view></view>
  <view class="quick-card"><view class="quick-row" bindtap="goRealName"><view class="quick-icon orange"><text class="cuIcon-profile"></text></view><view class="flex-sub"><view class="text-bold">实名认证</view><view class="text-sm text-grey">仅申请提现前须通过审核</view></view><text class="state {{realName.status}}">{{realNameText}}</text><text class="cuIcon-right text-grey"></text></view><view class="quick-row" bindtap="openAccount"><view class="quick-icon cyan"><text class="cuIcon-pay"></text></view><view class="flex-sub"><view class="text-bold">支付宝收款账号</view><view class="text-sm text-grey">{{account ? account.holder_name_masked + '　' + account.account_masked : '实名认证前也可先绑定'}}</view></view><text class="cuIcon-right text-grey"></text></view>
    <!-- 2026-09-04：微信或支付宝二维码均可，只维护一张收款码。 -->
    <view class="quick-row" bindtap="openCollectionCode"><view class="quick-icon green"><text class="cuIcon-qr_code"></text></view><view class="flex-sub"><view class="text-bold">收款码</view><view class="text-sm text-grey">微信或支付宝均可，仅用于商家单结款</view></view><text class="state {{collectionCode.status}}">{{collectionCode.status_text}}</text><text class="cuIcon-right text-grey"></text></view><view wx:if="{{collectionCode.status === 'rejected' && collectionCode.review_reason}}" class="collection-notice"><text class="cuIcon-warn"></text> {{collectionCode.review_reason}}</view>
    <view wx:if="{{realName.status !== 'approved'}}" class="account-notice"><text class="cuIcon-infofill"></text> 支付宝可以先绑定，实名认证审核通过前不能提现。</view></view>
  <view class="switch-card"><view class="switch-tabs"><view class="{{activeTab === 'bills' ? 'active' : ''}}" data-tab="bills" bindtap="switchTab">待结算</view><view class="{{activeTab === 'balance' ? 'active' : ''}}" data-tab="balance" bindtap="switchTab">余额明细</view><view class="{{activeTab === 'withdrawals' ? 'active' : ''}}" data-tab="withdrawals" bindtap="switchTab">提现记录</view></view></view>
  <view wx:if="{{activeTab === 'bills'}}" class="section"><view class="section-title">平台服务费账单</view><view wx:if="{{!receivables.length}}" class="empty-card"><text class="cuIcon-search"></text><view>暂无待结算服务费</view></view><view wx:for="{{receivables}}" wx:key="public_no" class="bill card"><view class="flex justify-between"><view><view class="text-bold">订单 {{item.order_no}}</view><view class="text-sm text-grey">{{item.public_no}} · <text class="{{item.status === 'overdue' ? 'text-red' : 'worker-text'}}">{{item.status_text}}</text></view><view class="text-sm text-orange margin-top-xs">{{item.stage_text}}</view></view><view class="amount">{{item.unpaid_text}}</view></view><view class="breakdown"><view><text>成交价</text><text>{{item.final_text}}</text></view><view><text>服务费（{{item.rate_text}}，最低{{item.min_text}}）</text><text>{{item.gross_text}}</text></view><view><text>预约费抵扣</text><text>-{{item.offset_text}}</text></view><view wx:if="{{item.amount_paid_cents > 0}}"><text>{{item.is_provisional ? '已提前支付' : '已补缴'}}</text><text>-{{item.paid_text}}</text></view></view><view wx:if="{{item.is_provisional}}" class="warning">验收前仅为预计服务费，正式金额将在用户验收或自动验收后确认；提前支付的金额会按最终账单复核。</view><view wx:if="{{item.status === 'overdue' && !item.is_provisional}}" class="warning">已逾期，结清前不能新报价或接受新指派。</view><view class="bill-foot"><text>缴费期限 {{item.due_at || '待定'}}</text><button wx:if="{{item.unpaid_cents > 0}}" class="cu-btn sm round worker-primary" data-no="{{item.public_no}}" bindtap="payCommission">微信支付</button></view></view><view class="list-foot">{{loadingMore ? '正在加载…' : (billsHasMore ? '上滑加载更多' : (receivables.length ? '已显示全部' : ''))}}</view></view>
  <view wx:elif="{{activeTab === 'balance'}}" class="section"><view class="section-title">余额明细</view><view wx:if="{{!balanceEntries.length}}" class="empty-card small">暂无余额变动</view><view wx:for="{{balanceEntries}}" wx:key="index" class="record card"><view><view class="text-bold">{{item.title}}</view><view class="text-sm text-grey">{{item.description}} · {{item.created_at}}</view></view><view class="amount {{item.available_delta_cents >= 0 ? 'worker-text' : 'text-orange'}}">{{item.delta_text}}</view></view><view class="list-foot">{{loadingMore ? '正在加载…' : (balanceHasMore ? '上滑加载更多' : (balanceEntries.length ? '已显示全部' : ''))}}</view></view>
  <view wx:else class="section"><view class="section-title">提现记录</view><view wx:if="{{!withdrawals.length}}" class="empty-card small">暂无提现记录</view><view wx:for="{{withdrawals}}" wx:key="public_no" class="record card"><view><view class="text-bold">{{item.amount_text}}</view><view class="text-sm text-grey">{{item.submitted_at}} · {{item.public_no}}</view><view wx:if="{{item.review_note}}" class="text-sm text-orange">{{item.review_note}}</view></view><view class="text-right"><view class="worker-text">{{item.status_text}}</view><button wx:if="{{item.status === 'pending'}}" class="cu-btn sm round line-red margin-top-xs" data-no="{{item.public_no}}" bindtap="cancelWithdrawal">撤销</button></view></view><view class="list-foot">{{loadingMore ? '正在加载…' : (withdrawalsHasMore ? '上滑加载更多' : (withdrawals.length ? '已显示全部' : ''))}}</view></view>
  <view wx:if="{{showAccount}}" class="mask"><view class="modal card"><view class="text-xl text-bold">支付宝收款账号</view><view class="tip">可在实名认证前绑定；提现前须完成实名，支付宝姓名需与认证姓名一致。</view><input class="input" placeholder="支付宝实名姓名" bindinput="nameInput"/><input class="input" type="number" maxlength="11" placeholder="支付宝绑定手机号" bindinput="mobileInput"/><view class="flex margin-top"><button class="cu-btn round line-grey flex-sub" bindtap="closeAccount">取消</button><button class="cu-btn round worker-primary flex-sub margin-left" bindtap="saveAccount">保存</button></view></view></view>
  <view wx:if="{{showWithdraw}}" class="mask"><view class="modal card"><view class="text-xl text-bold">申请余额提现</view><view class="tip">可提现 {{balance.available_text}}，平台审核并人工支付宝付款。</view><view class="amount-input"><text>¥</text><input type="digit" value="{{withdrawAmount}}" placeholder="0.00" bindinput="amountInput"/><text class="worker-text" bindtap="withdrawAll">全部</text></view><view class="text-sm text-grey">最低提现 {{minimumText}}</view><view class="flex margin-top"><button class="cu-btn round line-grey flex-sub" bindtap="closeWithdraw">取消</button><button class="cu-btn round worker-primary flex-sub margin-left" bindtap="submitWithdraw">提交审核</button></view></view></view>
</view>
<view wx:else class="loading"><text class="cuIcon-loading2 spin"></text> 加载结算数据</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>
