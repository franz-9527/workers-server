<block wx:if="{{pageLoginReady}}">
<view>
  <view class="cu-form-group">
    <view class="title">门店昵称</view>
    <view class="">{{detail.StoreName}}</view>
  </view>
  <view class="cu-form-group">
    <view class="text title">是否有店</view>
    <view wx:if="{{detail.hasStore != undefined}}">{{detail.hasStore?'是':'否'}}</view>
    <view wx:else>未知</view>
  </view>
  <view class="cu-form-group">
    <view class="text-cut title">墙布类型</view>
    <view class="">{{detail.StoreType}}</view>
  </view>
  <view class="cu-form-group">
    <view class="text title">价位参考</view>
    <view class="cuIcon-info flex-twice margin-xs" bindtap="showMore2"></view>
    <view class="text-right content">
      <navigator class="{{detail.platformSells === undefined? 'text-grey' :  (detail.platformSells?'text-green':'text-red')}}" url="/subpackages/web/h5/index?title=bbs51">{{detail.platformSells === undefined? '✘' : (detail.platformSells? '✔':'✘')}}平台帮售：上门送样+测量</navigator>
      <view wx:if="{{detail.StorePaid != undefined}}">{{detail.StorePaid}}</view>
      <view wx:else>无</view>
    </view>
  </view>
  <view class="cu-form-group">
    <view class="title" bindtap="showMore">更多商品</view>
    <view class="cuIcon-info flex-twice margin-xs" bindtap="showMore"></view>
    <view class="text-right content">
      <text class="{{detail.doEVA === undefined? 'text-gray' :  (detail.doEVA?'text-black':'text-grey')}}">{{detail.doEVA === undefined? '？' : (detail.doEVA? '✔':'✘')}}有热胶、</text>
      <text class="{{detail.doCurtain === undefined? 'text-gray' :  (detail.doCurtain?'text-black':'text-grey')}}">{{detail.doCurtain === undefined? '？' : (detail.doCurtain? '✔':'✘')}}窗帘、</text>
      <text class="{{detail.dotArtpaint === undefined? 'text-gray' :  (detail.dotArtpaint?'text-black':'text-grey')}}">{{detail.dotArtpaint === undefined? '？' : (detail.dotArtpaint? '✔':'✘')}}艺术漆</text>
      <view>
        <text class="{{detail.doWallPaneling === undefined? 'text-gray' :  (detail.doWallPaneling?'text-black':'text-grey')}}">{{detail.doWallPaneling === undefined? '？' : (detail.doWallPaneling? '✔':'✘')}}软硬包、</text>
        <text class="{{detail.doPaint === undefined? 'text-gray' :  (detail.doPaint?'text-black':'text-grey')}}">{{detail.doPaint === undefined? '？' : (detail.doPaint? '✔':'✘')}}油漆、</text>
        <text class="{{detail.doDecorPic === undefined? 'text-gray' :  (detail.doDecorPic?'text-black':'text-grey')}}">{{detail.doDecorPic === undefined? '？' : (detail.doDecorPic? '✔':'✘')}}装饰画</text>
      </view>
    </view>
  </view>
  <view class="cu-form-group">
    <view class="title">上门送样</view>
    <view class="">{{detail.getHome?'支持':'不支持'}}</view>
  </view>
  <view class="cu-form-group">
    <view class="title">商家自送</view>
    <view class="">{{detail.money}}</view>
  </view>
  <view class="cu-form-group">
    <view class="title">城市区域</view>
    <view wx:if="{{detail.location.district != undefined}}">{{detail.location.city+detail.location.district}}</view>
    <view wx:elif="{{detail.location.city != undefined}}">{{detail.location.city}}</view>
    <view wx:else>无</view>
  </view>
  <view class="cu-form-group">
    <view class="title text-cut">地址详情</view>
    <view class="" bindtap="showLocation"><text class="cuIcon-locationfill text-orange"></text>{{detail.location.name}}</view>
  </view>
  <view wx:if="{{storePhonePublicEnabled}}" class="cu-form-group" bindtap="callStorePhone">
    <view class="title">联系电话</view>
    <view wx:if="{{storePhone}}" class="text-cyan"><text class="cuIcon-phone margin-right-xs"></text>{{storePhone}}</view>
    <view wx:elif="{{storePhoneLoading}}" class="text-grey">读取中…</view>
    <view wx:else class="text-grey">暂未登记</view>
  </view>
  <view class="cu-form-group">
    <view class="title">开店时间</view>
    <view wx:if="{{detail.storeTime != undefined}}">{{detail.storeTime}}</view>
    <view wx:else>无</view>
  </view>
  <view class="cu-form-group">
    <view class="title">发布时间</view>
    <view class="">{{detail.StartDate}}</view>
  </view>
</view>

<view class="cu-bar bg-white margin-top solid-top">
  <view class="action">
    <text class="cuIcon-titles text-green"></text>
    <text class="text-black"> 发布内容</text>
  </view>
</view>
<view class="cu-form-group bg-white solid-bottom">
  <view class="text-black content">{{detail.content}}</view>
</view>

<view class="padding bg-white" wx:if="{{detail.imgList}}" bindtap="viewImage">
  <swiper class="screen-swiper square-dot" indicator-dots="true" circular="true" autoplay="true" interval="5000" duration="500">
    <swiper-item wx:for="{{detail.imgList}}" wx:key="index">
      <image src="{{item}}" mode="aspectFit"></image>
    </swiper-item>
  </swiper>
</view>

<view class="padding-xs bg-white">
  <view wx:for="{{DetailPrompt}}" wx:key="index">
    <view class="cuIcon-infofill text-xs text-grey"> {{item.text}}</view>
  </view>
</view>

<view class='margin-top'>
  <button wx:if="{{detail.isMine==1}}" class='margin cu-btn bg-red shadow lg block' bindtap="delRecord">删除发布</button>
  <button class='margin cu-btn bg-blue shadow lg block' bindtap="goShop">我要购买</button>
  <button class='margin cu-btn bg-gradual-green shadow lg block' data-name="shareBtn" open-type="share">分享门店</button> 
  <button wx:if="{{isOrderAdmin}}" class='margin cu-btn bg-yellow shadow lg block' bindtap="togglePublished">{{detail.published ? '已审核' : '未审核'}}</button>
</view>

<view class="weui-footer">
  <view class="weui-footer__links">
    <text class="weui-footer__link">若有错误请反馈客服</text>
  </view>
  <text class="text-gray padding-bottom">Powered By 壁选 © 2013-现在</text>
</view>
<view style="width: 100%;height: calc(150rpx + env(safe-area-inset-bottom) / 2);"></view>

</block>
<view wx:else class="padding-xl margin bg-white radius text-center">
  <view class="text-lg text-bold margin-bottom-sm">登录后查看门店详情</view>
  <view class="text-grey text-sm margin-bottom">从分享页面进入时，先确认当前账号，再加载门店资料。</view>
  <button class="cu-btn bg-cyan text-white round" bindtap="showAuthDialog">手机号登录</button>
</view>

<auth is-show="{{isShowAuth}}" bind:onAuthEvent="onAuthEvent" bind:onAuthClose="onAuthClose"></auth>

<view wx:if="{{pageLoginReady}}">  
  <image src="/images/wxkf.png" class="img-plus-style" bindtap="wxkefu"></image>
  <image src="/images/phoneAuth.png" class="img-plus-style2" bindtap="goAuth"></image>
</view>
<view wx:if="{{pageLoginReady}}" class="cu-bar bg-white tabbar border shop foot">
  <view class="action" bindtap="goHelp">
    <view class="cuIcon-read"></view>帮助
  </view>
  <view wx:if="{{storePhonePublicEnabled && storePhone}}" class="bg-cyan submit" bindtap="callStorePhone">联系门店</view>
  <view wx:else class="bg-blue submit" bindtap="goShop">我要购买</view>
</view>
<inapp-notice custom-nav="{{false}}"></inapp-notice>
