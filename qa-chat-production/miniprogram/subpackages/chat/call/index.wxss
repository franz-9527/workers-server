@import "../../../style/chat-native.wxss";
@import "../../../style/chat-settings.wxss";
page{height:100%}
.call-page{display:flex;flex-direction:column;min-height:100vh;box-sizing:border-box;padding:72rpx 34rpx calc(58rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#27323a 0%,#182126 100%);color:#fff;text-align:center}
.call-person{padding-top:34rpx}.call-avatar{width:184rpx;height:184rpx;border-radius:50%;margin-bottom:28rpx;background:#dbe3e5;border:2rpx solid rgba(255,255,255,.18);box-shadow:0 20rpx 46rpx rgba(0,0,0,.22)}
.call-title{font-size:43rpx;line-height:1.45;font-weight:650;overflow-wrap:anywhere}.call-kind{font-size:27rpx;color:#cbd3d7;line-height:1.5;margin-top:10rpx}
.call-status{font-size:31rpx;line-height:1.6;margin:26rpx 0;color:#f5f7f8}.call-notice,.call-hint{font-size:25rpx;line-height:1.6;color:#efd5aa;margin:14rpx auto;max-width:600rpx}
.call-stage{position:relative}.call-stage.is-audio{flex:1;min-height:100rpx;height:auto}.call-stage.is-video{height:40vh;min-height:300rpx}.call-stage live-player{width:100%;height:100%}.local-video{position:absolute;right:10rpx;top:10rpx;width:180rpx;height:240rpx}.audio-pusher{position:absolute;left:-10px;top:-10px;width:1px;height:1px;opacity:0}
.call-controls{display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:28rpx;margin-top:auto;padding-top:40rpx}.call-control{flex:0 0 136rpx;display:flex;align-items:center;flex-direction:column;gap:18rpx;padding:8rpx 0;margin:0;min-height:166rpx;background:transparent;color:#fff;font-size:26rpx;line-height:1.5}.call-control::after{border:0}.call-control-icon{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;border-radius:50%;background:#465057;box-shadow:0 10rpx 24rpx rgba(0,0,0,.18)}.call-control .chat-icon{width:52rpx;height:52rpx;filter:invert(1)}.call-control.is-selected .call-control-icon{outline:3rpx solid #d1edf1;background:#566c77}.hangup .call-control-icon{background:#e3484f}.hangup .chat-icon{transform:rotate(135deg)}.accept .call-control-icon{background:#19a66c}
.incoming-controls{width:100%;justify-content:space-around;gap:44rpx;padding:54rpx 24rpx 14rpx}.incoming-controls .call-control{flex-basis:164rpx;font-size:29rpx;font-weight:550}.incoming-controls .call-control-icon{width:132rpx;height:132rpx}.incoming-controls .call-control .chat-icon{width:60rpx;height:60rpx}
.call-finished-actions{display:flex;justify-content:center;margin:42rpx 0 auto}.call-return{width:320rpx;min-height:96rpx;margin:0;border-radius:48rpx;background:rgba(255,255,255,.14);border:1rpx solid rgba(255,255,255,.22);color:#fff;font-size:30rpx;font-weight:600;line-height:96rpx}.call-return::after{border:0}.call-return:active{background:rgba(255,255,255,.22)}
.call-page.is-incoming .call-person{padding-top:64rpx}.call-page.is-incoming .call-status{margin-top:18rpx;color:#dce5e8}.call-page.is-incoming .call-stage.is-audio{min-height:70rpx}
.call-page.call-history-page{height:100%;min-height:0;padding:0;background:#ededed;color:#253439;text-align:left}.call-history-scroll{flex:1;height:100%;box-sizing:border-box;padding-top:14rpx}.call-history-page .chat-section{margin-bottom:0}.call-history-row{min-height:112rpx;padding:16rpx 0}.call-history-mark{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;width:64rpx;height:64rpx;border-radius:50%;background:#e0f2f4;color:#087b87;font-size:25rpx}.call-history-more{width:100%}
@media(prefers-color-scheme:dark){.call-page.call-history-page{background:#111;color:#e5eff0}.call-history-page .call-history-mark{background:#1c3a41;color:#a5e5ed}}
